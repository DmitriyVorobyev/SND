&НаКлиенте
&После("ОбновлениеФайловЗавершение")
Процедура Расш1_ОбновлениеФайловЗавершение(Результат, ПараметрыОбновления)
	
	//{[+] ИКТ №20864 (фрагмент ДОБАВЛЕН), Новоселов, 12.08.2026 
	Если НЕ ТипЗнч(Владелец) = Тип("СправочникСсылка.упоЗадания") Тогда  //[+] ИКТ №19162 (строка ДОБАВЛЕНА), Новоселов, 15.07.2026 
		Возврат;
	КонецЕсли;
	
	ДобавитьФайлыДополнительныхВладельцевНаСервере();
	//[+]} ИКТ №20864
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьФайлыДополнительныхВладельцевНаСервере()

	ДополнительныеВладельцы = ПолучитьВладельцевФайлов();
	
	Для Каждого Строка Из ДополнительныеВладельцы Цикл
			
		ВыборкаФайлов = Неопределено;
		
		// Ветвление в зависимости от типа владельца
		Если Строка.ТипВладельцаФайла = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ВыборкаФайлов = ВернутьПрисоединенныеФайлыПроектнаяЗадача(Строка.ВладелецФайла);
			
		ИначеЕсли Строка.ТипВладельцаФайла = Тип("СправочникСсылка.Проекты") Тогда
			ВыборкаФайлов = ВернутьПрисоединенныеФайлыПроект(Строка.ВладелецФайла);
			
		КонецЕсли;
		
		Если ВыборкаФайлов <> Неопределено Тогда
			ДобавитьФайлыВДерево(ВыборкаФайлов, Владелец);
			
		КонецЕсли;
		
		Если Строка.ТипВладельцаФайла = Тип("СправочникСсылка.упоЗадания") Тогда
			ДобавитьФайлыЗаданийВДерево(Строка.ВладелецФайла);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВладельцевФайлов()
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Проект", Владелец.Метаданные())
			И НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "Проект")) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	упоПроектнаяЗадача.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ОтмененныеЗадачи
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|		ПО (упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоПроектнаяЗадача.Ссылка)
		|			И (упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		|ГДЕ
		|	упоПроектнаяЗадача.Проект = &Проект
		|	И упоПроектнаяЗадача.Ссылка <> &ОсновнойВладелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Проект КАК ВладелецФайла,
		|	ТИП(Справочник.Проекты) КАК ТипВладельцаФайла
		|ГДЕ
		|	&Проект <> &ОсновнойВладелец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	упоПроектнаяЗадача.Ссылка,
		|	ТИП(Документ.упоПроектнаяЗадача)
		|ИЗ
		|	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтмененныеЗадачи КАК ВТ_ОтмененныеЗадачи
		|		ПО (ВТ_ОтмененныеЗадачи.Ссылка = упоПроектнаяЗадача.Ссылка)
		|ГДЕ
		|	упоПроектнаяЗадача.Проект = &Проект
		|	И упоПроектнаяЗадача.Ссылка <> &ОсновнойВладелец
		|	И ВТ_ОтмененныеЗадачи.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	упоЗадания.Ссылка,
		|	ТИП(Справочник.упоЗадания)
		|ИЗ
		|	Справочник.упоЗадания КАК упоЗадания
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтмененныеЗадачи КАК ВТ_ОтмененныеЗадачи
		|		ПО (ВТ_ОтмененныеЗадачи.Ссылка = упоЗадания.ОбъектБазы)
		|ГДЕ
		|	упоЗадания.Проект = &Проект
		|	И упоЗадания.Ссылка <> &ОсновнойВладелец
		|	И ВТ_ОтмененныеЗадачи.Ссылка ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ОсновнойВладелец", Владелец);
	Запрос.УстановитьПараметр("Проект",
		?(ТипЗнч(Владелец) = Тип("СправочникСсылка.Проекты"),
			Владелец,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "Проект"))); 
			
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ДобавитьФайлыВДерево(ВыборкаФайлов, Владелец)
	
	Пока ВыборкаФайлов.Следующий() Цикл
		
		Если ВыборкаФайлов.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДеревоФайлов.ПолучитьЭлементы().Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаФайлов);
		НоваяСтрока.ДатаМодификации = ВыборкаФайлов.ДатаИзменения; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВернутьПрисоединенныеФайлыПроектнаяЗадача(ВладелецФайлов)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Ссылка,
		|	Файлы.ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА Файлы.ПометкаУдаления = ИСТИНА
		|			ТОГДА ЕСТЬNULL(Файлы.ИндексКартинки, 2) + 1
		|		ИНАЧЕ ЕСТЬNULL(Файлы.ИндексКартинки, 2)
		|	КОНЕЦ КАК ИндексКартинки,
		|	Файлы.Наименование КАК Наименование,
		|	ВЫРАЗИТЬ(Файлы.Описание КАК СТРОКА(500)) КАК Описание,
		|	Файлы.Автор,
		|	Файлы.ДатаСоздания,
		|	Файлы.Изменил КАК Отредактировал,
		|	ДОБАВИТЬКДАТЕ(Файлы.ДатаМодификацииУниверсальная, СЕКУНДА, &СекундДоМестногоВремени) КАК ДатаИзменения,
		|	ВЫРАЗИТЬ(Файлы.Размер / 1024 КАК ЧИСЛО(10, 0)) КАК Размер,
		|	Файлы.ПодписанЭП,
		|	Файлы.Зашифрован,
		|	ВЫБОР
		|		КОГДА Файлы.ПодписанЭП
		|				И Файлы.Зашифрован
		|			ТОГДА 2
		|		КОГДА Файлы.Зашифрован
		|			ТОГДА 1
		|		КОГДА Файлы.ПодписанЭП
		|			ТОГДА 0
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК НомерКартинкиПодписанЗашифрован,
		|	ВЫБОР
		|		КОГДА НЕ Файлы.Редактирует В (&ПустыеПользователи)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируется,
		|	ВЫБОР
		|		КОГДА Файлы.Редактирует = &ТекущийПользователь
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируетТекущийПользователь,
		|	ВЫБОР
		|		КОГДА НЕ Файлы.Редактирует В (&ПустыеПользователи)
		|				И Файлы.Редактирует <> &ТекущийПользователь
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируетДругойПользователь,
		|	Файлы.Расширение КАК Расширение,
		|	ВЫБОР
		|		КОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись <> НЕОПРЕДЕЛЕНО
		|				И Файлы.Редактирует = НЕОПРЕДЕЛЕНО
		|			ТОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись
		|		ИНАЧЕ Файлы.Редактирует
		|	КОНЕЦ КАК Редактирует,
		|	Файлы.Редактирует КАК РедактируетПользователь,
		|	ЛОЖЬ КАК ЭтоГруппа,
		|	Файлы.Служебный КАК Служебный,
		|	НЕОПРЕДЕЛЕНО КАК ГруппаФайла,
		|	Файлы.ВладелецФайла КАК ВладелецФайла,
		|	Файлы.ХранитьВерсии КАК ХранитьВерсии
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыСинхронизацииФайловСОблачнымСервисом КАК СтатусыСинхронизацииФайловСОблачнымСервисом
		|		ПО Файлы.Ссылка = СтатусыСинхронизацииФайловСОблачнымСервисом.Файл
		|ГДЕ
		|	Файлы.ВладелецФайла = &ВладелецФайлов");
	Запрос.УстановитьПараметр("ВладелецФайлов", ВладелецФайлов);
	Запрос.УстановитьПараметр("СекундДоМестногоВремени",
		МестноеВремя(ТекущаяДатаСеанса(), ЧасовойПоясСеанса()) - ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.АвторизованныйПользователь());

	ПустыеПользователи = Новый Массив;
	ПустыеПользователи.Добавить(Неопределено);
	ПустыеПользователи.Добавить(Справочники.Пользователи.ПустаяСсылка());
	ПустыеПользователи.Добавить(Справочники.ВнешниеПользователи.ПустаяСсылка());
	ПустыеПользователи.Добавить(Справочники.УчетныеЗаписиСинхронизацииФайлов.ПустаяСсылка());

	Запрос.УстановитьПараметр("ПустыеПользователи",  ПустыеПользователи);
	
	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

&НаСервере
