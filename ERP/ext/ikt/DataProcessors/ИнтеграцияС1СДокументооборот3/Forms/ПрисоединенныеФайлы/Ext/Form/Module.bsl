КонецФункции

&НаСервере
Процедура ДобавитьФайлыЗаданийВДерево(ВладелецФайлов)
		
	Правила = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.НайтиСоздатьПодходящиеПравила(
	ВладелецФайлов);
	Если Правила.Количество() > 0 Тогда
		ПравилоИнтеграции = Правила[0];
	Иначе
		Возврат;
	КонецЕсли;
	
	ТипСтроки = ПравилоИнтеграции.ТипОбъектаДО;
	ТипВидаДокумента = ПравилоИнтеграции.ТипВидаДокумента;
	ИдентификаторВидаДокумента = ПравилоИнтеграции.ИдентификаторВидаДокумента;
	ИспользоватьЭлектронныеПодписиИС = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.ИспользоватьЭлектронныеЦифровыеПодписи();
	ВладелецМетаданные = ВладелецФайлов.Метаданные();
	ТипСправочникаСФайлами = ВладелецМетаданные.ПолноеИмя();
	ТипОбъектаМассив = СтрРазделить(ТипСправочникаСФайлами, ".");
	
	Если ТипОбъектаМассив[0] = "Справочник" Тогда
		ПредставлениеТипаВладельца = "справочника";
	ИначеЕсли ТипОбъектаМассив[0] = "Документ" Тогда
		ПредставлениеТипаВладельца = "документа";
	КонецЕсли;
	
	ОбъектДО = РегистрыСведений.ОбъектыИнтегрированныеС1СДокументооборотом.ДанныеОбъектаДОПоВнешнемуОбъекту(ВладелецФайлов);
	Если ОбъектДО = Неопределено И НЕ ЗначениеЗаполнено(ОбъектДО.ID)Тогда
		Возврат;
	КонецЕсли;
	IDСтроки = ОбъектДО.ID;
	ТипСтроки = ОбъектДО.type;
	Если ЗначениеЗаполнено(IDСтроки) Тогда
		ПолучаемыеПоля = Новый Массив;
		ПолучаемыеПоля.Добавить("files");
		ПолучаемыеПоля.Добавить("documentType");
		ПолучаемыеПоля.Добавить("enabledProperties");
		ПолучаемыеПоля.Добавить("htmlView");
		//ПолучаемыеПоля.Добавить("ignoreDeletionMark");
		Прокси = ИнтеграцияС1СДокументооборотБазоваяФункциональностьПовтИсп.ПолучитьПрокси();
		ОбъектXDTO = ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПолучитьОбъект(
			Прокси,
			ТипСтроки,
			IDСтроки,
			ПолучаемыеПоля,
			ПравилоИнтеграции.Ссылка,
			ВладелецФайлов);
		Для Каждого Ф Из ОбъектXDTO.files Цикл
			
			НоваяСтрока	  = ДеревоФайлов.ПолучитьЭлементы().Добавить();
			ОписаниеФайла = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.ОписаниеФайла(Ф.objectID.id);
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеФайла);
			НоваяСтрока.ИндексКартинки = РаботаСФайламиСлужебныйКлиентСервер.ИндексПиктограммыФайла(НоваяСтрока.Расширение);
			Если НоваяСтрока.ПометкаУдаления Тогда
				НоваяСтрока.ИндексКартинки = НоваяСтрока.ИндексКартинки + 2;
			КонецЕсли;
			НоваяСтрока.Отредактировал = ОписаниеФайла.АвторМодификации;
			НоваяСтрока.Тип = "DMFile";

		КонецЦикла;
	КонецЕсли;		

КонецПроцедуры

