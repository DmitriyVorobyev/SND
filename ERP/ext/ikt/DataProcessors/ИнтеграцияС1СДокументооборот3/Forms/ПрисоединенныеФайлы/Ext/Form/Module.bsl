&НаКлиенте
Процедура ИКТ_СкопироватьФайлыИзЗаказаПосле(Команда)
	
	ВладелецПрисоединенныхФайлов = ИКТ_ВернутьЗаказПоставщику(Владелец);	
	
	МодульИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент = Неопределено;
	
	ИспользоватьДОДляХраненияФайловОбъекта =
		РаботаСФайламиСлужебныйКлиент.Используется1СДокументооборотДляХраненияФайловОбъекта(
			ВладелецПрисоединенныхФайлов,
			Неопределено,
			Команда,
			МодульИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент);
			
	Если ИспользоватьДОДляХраненияФайловОбъекта Тогда
						
		МодульИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент");
		ПараметрыОткрытия = МодульИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ПараметрыОткрытияСпискаФайлов();
				
		ПараметрыОткрытия.Вставить("ВладелецФайла", ВладелецПрисоединенныхФайлов);
	
		//ВладелецФормы = ПараметрыОткрытия.ВладелецФормы;
		ПараметрыОткрытия.Удалить("ВладелецФормы");
	
		//Окно = ПараметрыОткрытия.Окно;
		ПараметрыОткрытия.Удалить("Окно");
	
		Если ЗначениеЗаполнено(ПараметрыОткрытия.Уникальность) Тогда
			Уникальность = ПараметрыОткрытия.Уникальность;
		Иначе
			Уникальность = ВладелецПрисоединенныхФайлов;
		КонецЕсли;
		
		ОткрытьФорму(
			"Обработка.ИнтеграцияС1СДокументооборот3.Форма.ИКТ_ВыборФайловДляКопирования",
			ПараметрыОткрытия,
			ВладелецФормы,
			Уникальность,
			,,
			Новый ОписаниеОповещения("ИКТ_ПослеВыбораФайловДляКопирования", ЭтотОбъект), 
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИКТ_ВернутьЗаказПоставщику(Владелец)
		
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "ДокументОснование");
	
КонецФункции

&НаКлиенте
Процедура ИКТ_ПослеВыбораФайловДляКопирования(Результат, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Массив") Тогда		
		Возврат;	
	КонецЕсли;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ИКТ_ПослеВыбораФайловДляКопированияЗавершение", ЭтотОбъект, Результат);
	Если ЗначениеЗаполнено(ID) Тогда // Связанный объект уже известен.
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Неопределено);
	Иначе // Связанный объект следует найти или создать.
		ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.НачатьПоискСвязанногоОбъектаДО(
			Владелец,
			ОписаниеОповещения,,,
			Ложь);
	КонецЕсли;
	
	//ИКТ_СкопироватьФайлыНаСервере(Результат);
	
	ОбновитьСписокФайловКлиент();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИКТ_ПослеВыбораФайловДляКопированияЗавершение(Знач Результат, Знач ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ID = Результат.ID;
		Тип = Результат.type;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ID) Тогда
		Возврат;
	КонецЕсли;
	
	ИКТ_СкопироватьФайлыНаСервере(ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ИКТ_СкопироватьФайлыНаСервере(МассивФайлов)
	
	Для Каждого стр Из МассивФайлов Цикл
		Если НЕ ЗначениеЗаполнено(стр) Тогда
			ПРодолжить;
		КонецЕсли;
		
		АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(
			Неопределено,
			УникальныйИдентификатор);
			
		ОписаниеФайла = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.ОписаниеФайла(
			стр,,
			АдресВременногоХранилищаФайла);
			
		ИКТ_СоздатьИзОригинала(ОписаниеФайла, АдресВременногоХранилищаФайла);	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИКТ_СоздатьИзОригинала(ОписаниеФайла, АдресВременногоХранилищаФайла)
	
	ДанныеФайла = ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиентСервер.ДанныеФайла(
		ОписаниеФайла.Наименование,
		Неопределено,
		"DMFile",
		ОписаниеФайла.Расширение,
		ОписаниеФайла.РольФайлаID);
	ДанныеФайла.Описание = ОписаниеФайла.Описание;
	ДанныеФайла.Размер = ОписаниеФайла.Размер;
	//ДанныеФайла.ДатаМодификации = ОписаниеФайла.ДатаМодификации;
	//ДанныеФайла.ДатаМодификацииУниверсальная = ОписаниеФайла.ДатаМодификацииУниверсальная;
	
	ПараметрыСоздания = ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиентСервер.НовыеПараметрыСозданияФайла(ДанныеФайла);
	ПараметрыСоздания.АдресВременногоХранилищаФайла = АдресВременногоХранилищаФайла;
	ПараметрыСоздания.Владелец = Владелец;
	//ПараметрыСоздания.ЯвляетсяСканКопией = ЯвляетсяОригиналом;
	
	НовыйФайлID = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.СоздатьФайлВДокументообороте(
		ПараметрыСоздания,
		ID,
		Тип,
		Строка(Владелец));
		
КонецПроцедуры
