&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаФайлИзЕРП(ТекущиеДанные)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Файлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	Файлы.Наименование = &Наименование
		|	И Файлы.Автор = &Автор
		|	И Файлы.ДатаСоздания = &ДатаСоздания
		|	И ТИПЗНАЧЕНИЯ(Файлы.ВладелецФайла) В (ТИП(Справочник.упоЗадания), ТИП(Документ.упоПроектнаяЗадача))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Файлы.Ссылка
		|ИЗ
		|	Справочник.ПроектыПрисоединенныеФайлы КАК Файлы
		|ГДЕ
		|	Файлы.Наименование = &Наименование
		|	И Файлы.Автор = &Автор
		|	И Файлы.ДатаСоздания = &ДатаСоздания
		|	И ТИПЗНАЧЕНИЯ(Файлы.ВладелецФайла) = ТИП(Справочник.Проекты)");
	Запрос.УстановитьПараметр("Автор", Справочники.Пользователи.НайтиПоНаименованию(ТекущиеДанные.Автор));
	Запрос.УстановитьПараметр("Наименование", ТекущиеДанные.Наименование);
	Запрос.УстановитьПараметр("ДатаСоздания", ТекущиеДанные.ДатаСоздания);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
		
	Иначе
		
		ОбщегоНазначения.СообщитьПользователю("Не удалось однозначно определить файл в ЕРП");
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОбъектДОПоВнешнемуОбъекту(ВнешнийОбъект)
	
	Возврат РегистрыСведений.ОбъектыИнтегрированныеС1СДокументооборотом.ДанныеОбъектаДОПоВнешнемуОбъекту(ВнешнийОбъект);

КонецФункции

