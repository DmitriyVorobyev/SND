&НаКлиенте
&Вместо("ДеревоФайловПередУдалением")
Процедура Расш1_ДеревоФайловПередУдалением(Элемент, Отказ)
	
	Если НЕ (ТипЗнч(Владелец) = Тип("СправочникСсылка.упоЗадания")) Тогда 
		ПродолжитьВызов(Элемент, Отказ);
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДеревоФайлов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеУдаленияФайлов", ЭтотОбъект);
	
	Если ТекущиеДанные.Тип <> "DMFile" Тогда
		
		Структура = Новый Структура("Автор, Наименование, ДатаСоздания");
		ЗаполнитьЗначенияСвойств(Структура, ТекущиеДанные);
		
		Ссылка = ПолучитьСсылкуНаФайлИзЕРП(Структура);
		Если Ссылка <> Неопределено Тогда
			
			Файлы = Новый Массив;
			Файлы.Добавить(Ссылка);
			
			ДополнительныеПараметры = Новый Структура("Файлы", Файлы);
			ОповещениеВопрос = Новый ОписаниеОповещения("УстановитьПометкуУдаленияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ШаблонВопроса = ?(ТекущиеДанные.ПометкаУдаления,
				НСтр("ru = 'Снять с ""%1"" пометку на удаление?';
					|en = 'Do you want to clear the deletion mark from ""%1""?'"),
				НСтр("ru = 'Пометить ""%1"" на удаление?';
					|en = 'Do you want to mark ""%1"" for deletion?'"));
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, ТекущиеДанные.Наименование);
			ПоказатьВопрос(ОповещениеВопрос, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ВладелецФайла) Тогда
		ОбъектДО = ПолучитьОбъектДОПоВнешнемуОбъекту(ТекущиеДанные.ВладелецФайла);
		Если ОбъектДО = Неопределено Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось получить объект ДО!");
			Возврат;
		КонецЕсли;
		
		ВыделенныеСтроки = Новый Массив;
		ВыделенныеСтроки.Добавить(Элементы.ДеревоФайлов.ТекущаяСтрока);
		
		ВыделенныеФайлы = ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыделенныеФайлы(
			ДеревоФайлов,
			ВыделенныеСтроки);
		ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ПометитьНаУдалениеСнятьПометкуФайлов(
			ВыделенныеФайлы,
			ТекущиеДанные.ПометкаУдаления,
			Оповещение,
			ОбъектДО.ID,
			УникальныйИдентификатор);
			
	Иначе
		ВыделенныеСтроки = Новый Массив;
		ВыделенныеСтроки.Добавить(Элементы.ДеревоФайлов.ТекущаяСтрока);
		
		ВыделенныеФайлы = ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыделенныеФайлы(
			ДеревоФайлов,
			ВыделенныеСтроки);
		ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ПометитьНаУдалениеСнятьПометкуФайлов(
			ВыделенныеФайлы,
			ТекущиеДанные.ПометкаУдаления,
			Оповещение,
			ID,
			УникальныйИдентификатор);
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуУдаленияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УстановитьСнятьПометкуУдаления(ДополнительныеПараметры.Файлы);
	КонецЕсли;
	
	ОбновитьСписокФайловКлиент();
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьСнятьПометкуУдаления(Файлы)
	
	ПометкаУдаления = Неопределено;
	Для каждого ФайлСсылка Из Файлы Цикл
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных();
			ЭлементБлокировки = Блокировка.Добавить(ФайлСсылка.Метаданные().ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлСсылка);
			Блокировка.Заблокировать();

			ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
			Если ПометкаУдаления = Неопределено Тогда
				ПометкаУдаления = Не ФайлОбъект.ПометкаУдаления;
			КонецЕсли;
			ФайлОбъект.УстановитьПометкуУдаления(ПометкаУдаления);

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

