&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	///ИТК Ал_ 24.07.2025
	//Задача № 9296
	
	НовыйЭлемент = Элементы.Добавить("ИКТ_СкопироватьФайлыИзЗаказа", Тип("КнопкаФормы"), Элементы.ПодменюДобавить);
	НовыйЭлемент.ИмяКоманды = "ИКТ_СкопироватьФайлыИзЗаказа";
	
	ВладелецЗРДС = ТипЗнч(Владелец)=Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств");	
	ДокументОснование = Неопределено;
	
	Если ВладелецЗРДС Тогда	
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "ДокументОснование");
	КонецЕсли;
	
	НовыйЭлемент.Видимость = ВладелецЗРДС И ТипЗнч(ДокументОснование)=Тип("ДокументСсылка.ЗаказПоставщику");	
	
	///Ал__ 24.07.2025
	
	//{[+] ИКТ №20864 (фрагмент ДОБАВЛЕН), Новоселов, 12.08.2026
	ДобавитьИзменитьРеквизиты();
	
	УстановитьУсловноеОформление();  //[+] ИКТ №21032 (строка ДОБАВЛЕНА), Новоселов, 20.08.2026 
	
	// Отсекаем все не упошное
	Если НЕ (ТипЗнч(Владелец) = Тип("СправочникСсылка.Проекты")
			ИЛИ ТипЗнч(Владелец) = Тип("ДокументСсылка.упоПроектнаяЗадача")
			ИЛИ ТипЗнч(Владелец) = Тип("СправочникСсылка.упоЗадания")) Тогда 
		Возврат;
	КонецЕсли;
	//[+]} ИКТ №20864
	
	//{[+] ИКТ №20612 (фрагмент ДОБАВЛЕН), Новоселов, 30.07.2026 
	Если (ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.Проекты")
				И Не Пользователи.РолиДоступны("ИКТ_ПросмотрДобавлениеПрисоединенныхФайловПроектов, ИКТ_РедактированиеПрисоединенныхФайловПроектов")) 
			ИЛИ ((ТипЗнч(Параметры.ВладелецФайла) = Тип("ДокументСсылка.упоПроектнаяЗадача")
				ИЛИ ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.упоЗадания"))
					И Не Пользователи.РолиДоступны("ИКТ_ПросмотрДобавлениеПрисоединенныхФайловПроектныхЗадачЗаданий, ИКТ_РедактированиеПрисоединенныхФайловПроектныхЗадачЗаданий")) Тогда
		ВызватьИсключение("Данному пользователю недоступен просмотр файлов проектов");
	КонецЕсли;
	//[+]} ИКТ №20612
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьИзменитьРеквизиты()
	
	//{[+] ИКТ №20864 (фрагмент ДОБАВЛЕН), Новоселов, 12.08.2026 
	ДобавляемыеРеквизиты = Новый Массив;
	
	НовРеквизит = Новый РеквизитФормы(
		"ВладелецФайла",
		Новый ОписаниеТипов(),
		"ДеревоФайлов",
		"Размещение");
	ДобавляемыеРеквизиты.Добавить(НовРеквизит);
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	НовыйЭлемент = Элементы.Вставить("ДеревоФайловВладелецФайла", Тип("ПолеФормы"), Элементы.ДеревоФайлов, Элементы.СписокГруппаИмяОписание);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "ДеревоФайлов.ВладелецФайла";
	НовыйЭлемент.Заголовок = "Размещение";
	
	ДеревоФайловОписание = Элементы.ДеревоФайловОписание;
	Элементы.Переместить(ДеревоФайловОписание, Элементы.ДеревоФайлов);
	ДеревоФайловОписание.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	//[+]} ИКТ №20864

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//{[+] ИКТ №21032 (фрагмент ДОБАВЛЕН), Новоселов, 20.08.2026 Для файлов из документооборота размещение пустое, заполняем строкой "Документооборот"
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоФайлов.ВладелецФайла");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "Документооборот");

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоФайловВладелецФайла");
	//[+]} ИКТ №21032

КонецПроцедуры

