&НаКлиенте
Процедура ОткрытьФайлыПроекта()

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВладелецФайла",						Объект.Проект);
	СтруктураПараметров.Вставить("ВыборГруппИЭлементов",				Неопределено); 
	СтруктураПараметров.Вставить("ВыборДобавлением",					Неопределено);
	СтруктураПараметров.Вставить("ДополнительныеСтруктураПараметров",	Новый Структура);
	СтруктураПараметров.Вставить("ЗаголовокФормы",						"");
	СтруктураПараметров.Вставить("ЗакрыватьПриВыборе",					Неопределено);
	СтруктураПараметров.Вставить("ЗакрыватьПриЗакрытииВладельца",		Неопределено);
	СтруктураПараметров.Вставить("КлючНазначенияИспользования"	 		"");
	СтруктураПараметров.Вставить("КлючПользовательскихНастроек",		Неопределено);
	СтруктураПараметров.Вставить("МножественныйВыбор",					Неопределено);
	СтруктураПараметров.Вставить("Отбор",								Новый Структура);
	СтруктураПараметров.Вставить("ОтображениеТаблицы",					Неопределено);
