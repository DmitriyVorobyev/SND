&НаКлиенте
&ИзменениеИКонтроль("ДеревоЗадачВыбор")
Процедура Расш1_ДеревоЗадачВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекДанные = Элементы.ДеревоЗадач.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяПоля = СтрЗаменить(Поле.Имя, Элемент.Имя, "");
	#Вставка
	Если ИмяПоля = "ИКТ_ЕстьПрисоединенныеФайлы" Тогда
		Ссылка = СоотОбъектаПоИд.Получить(ТекДанные.ИдСтроки);
		Пар = Новый Структура("Ключ, ПерейтиНаФайлы", Ссылка, Истина);
		Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ОткрытьФорму("Документ.упоПроектнаяЗадача.Форма.ФормаДокументаУправляемая",Пар,,,,,Новый ОписаниеОповещения("ПризакрытииФормыФайла", 
			ЭтотОбъект, 
			Пар));
			СтандартнаяОбработка = Ложь;
			
			Возврат;
		КонецЕсли;
	КонецЕсли;
	#КонецВставки

	ДопПараметры = Новый Структура("Валюта", мВалютаУправленческогоУчета);

	Если ТекДанные.ЭтоФантом Тогда

		СтандартнаяОбработка = Ложь;

		Ссылка = СоотОбъектаПоИд.Получить(ТекДанные.ИдСтроки);

		Если ЗначениеЗаполнено(Ссылка) Тогда

			СписокДействий = Новый СписокЗначений;
			СписокДействий.Добавить("ОткрытьЗначение", НСтр("ru = 'Открыть задачу'"));	
			СписокДействий.Добавить("ОткрытьСтруктуру", НСтр("ru = 'Показать задачу в структуре'"));

			тДополнительныеПараметры = Новый Структура("Задача", Ссылка);
			ОписаниеОповещения = Новый ОписаниеОповещения("ДеревоЗадачаВыборФантомаЗавершение", 
			ЭтотОбъект, 
			тДополнительныеПараметры);
			СписокДействий.ПоказатьВыборЭлемента(ОписаниеОповещения, 
			НСтр("ru = 'Выберите действие'"), 
			СписокДействий[0].Значение);

		КонецЕсли;

	ИначеЕсли ИмяПоля = "Связи" Или ИмяПоля = "СвязиПоНомеруСтроки" Тогда

		Если Не ЭлементДоступенДляРедактированияПолнаяПроверка(ТекДанные) Тогда
			СтандартнаяОбработка = Ложь;
			ОткрытьФормуПараметровОбъекта("Связи");
		КонецЕсли;

	ИначеЕсли ИмяПоля = "Последователи" Тогда

		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПараметровОбъекта("Последователи");

	ИначеЕсли ИмяПоля = "СвязиМеждуПроектами"  Тогда

		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПараметровОбъекта("Связи");

	ИначеЕсли Найти(ИмяПоля, "ТрудовыеРесурсыРолиПредварительный") <> 0 Тогда

		СтандартнаяОбработка = Ложь;
		ДопПараметры.Вставить("УровеньПланирования", 
		ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный"));
		ОткрытьФормуПараметровОбъекта("ТрудовыеРесурсыРоли", ДопПараметры);

	ИначеЕсли Найти(ИмяПоля, "ТрудовыеРесурсыРолиОкончательный") <> 0 Тогда	

		СтандартнаяОбработка = Ложь;
		ДопПараметры.Вставить("УровеньПланирования", 
		ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный"));
		ОткрытьФормуПараметровОбъекта("ТрудовыеРесурсыРоли", ДопПараметры);

	ИначеЕсли ИмяПоля = "НазначенныеТрудовыеРесурсы" Тогда	

		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПараметровОбъекта("НазначенныеТрудовыеРесурсы");

	ИначеЕсли ИмяПоля = "ПодчиненныйПроект" Тогда

		Если ЗначениеЗаполнено(ТекДанные.ПодчиненныйПроект) Тогда

			СтандартнаяОбработка = Ложь;

			СписокДействий = Новый СписокЗначений;
			СписокДействий.Добавить("ОткрытьСтруктуру", НСтр("ru = 'Открыть структуру проекта'"));
			СписокДействий.Добавить("ОткрытьЗначение", 	НСтр("ru = 'Открыть проект'"));
			СписокДействий.Добавить("ОчиститьЗначение", НСтр("ru = 'Очистить проект'"));

			тДополнительныеПараметры = Новый Структура;
			тДополнительныеПараметры.Вставить("Проект", ТекДанные.ПодчиненныйПроект);
			тДополнительныеПараметры.Вставить("ТекущиеДанные", ТекДанные);

			ОписаниеОповещения = Новый ОписаниеОповещения("ДеревоЗадачаВыборПодчиненногоПроектаЗавершение", 
			ЭтотОбъект, 
			тДополнительныеПараметры);
			СписокДействий.ПоказатьВыборЭлемента(ОписаниеОповещения, 
			НСтр("ru = 'Выберите действие'"), 
			СписокДействий[0].Значение);

		КонецЕсли;

	ИначеЕсли ИмяПоля = "ПланПотребностейКоличество" Тогда

		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПараметровОбъекта("МатериальныеРесурсы", ДопПараметры);

	ИначеЕсли ИмяПоля = "ПланВыпускаКоличество" Тогда

		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПараметровОбъекта("Субпродукты", ДопПараметры);

	ИначеЕсли ИмяПоля = "ПланБДРДоход" Тогда

		СтандартнаяОбработка = Ложь;
		ДопПараметры.Вставить("НаправлениеДвижения", 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление"));
		ОткрытьФормуПараметровОбъекта("ПланБДРДоход", ДопПараметры);

	ИначеЕсли ИмяПоля = "ПланБДРРасход" Тогда

		СтандартнаяОбработка = Ложь;
		ДопПараметры.Вставить("НаправлениеДвижения", 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата"));
		ОткрытьФормуПараметровОбъекта("ПланБДРРасход", ДопПараметры);

	ИначеЕсли ИмяПоля = "ПланДДСПоступления" Тогда

		СтандартнаяОбработка = Ложь;
		ДопПараметры.Вставить("НаправлениеДвижения", 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление"));
		ОткрытьФормуПараметровОбъекта("ДвиженияДенежныхСредств", ДопПараметры);

	ИначеЕсли ИмяПоля = "ПланДДСВыплаты" Тогда

		СтандартнаяОбработка = Ложь;
		ДопПараметры.Вставить("НаправлениеДвижения", 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата"));
		ОткрытьФормуПараметровОбъекта("ДвиженияДенежныхСредств", ДопПараметры);

	ИначеЕсли ИмяПоля = "ЗаданиеПодразделению" Тогда

		Если ЗначениеЗаполнено(ТекДанные.ЗаданиеПодразделению) Тогда
			СтандартнаяОбработка = Ложь;
			Ссылка = СоотОбъектаПоИд.Получить(ТекДанные.ИдСтроки);
			Если ЗначениеЗаполнено(Ссылка) Тогда
				упоЗаданияКлиент.ОткрытьЗаданияПодразделениюПоЗадаче(ЭтаФорма, Ссылка);
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ИмяПоля = "ПричиныОтклонений" Тогда

		СтандартнаяОбработка = Ложь;
		ОткрытьФормуПараметровОбъекта("ПричиныОтклонений", ДопПараметры);

	Иначе

		ПоискДопСвойства = мКэшЗначений.МассивДопСвойств.Найти(ИмяПоля);
		Если ПоискДопСвойства = Неопределено Тогда 
			Возврат;
		КонецЕсли;

		СтандартнаяОбработка = Ложь;
		Ссылка = СоотОбъектаПоИд.Получить(ТекДанные.ИдСтроки);
		Если ЗначениеЗаполнено(Ссылка) Тогда

			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("Ссылка", Ссылка);

			ОткрытьФорму("ОбщаяФорма.РедактированиеДополнительныхСведений",
			ПараметрыОткрытия, , , , , ,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры
