
&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавитьИзменитьРеквизиты();  //[+] ИКТ №19162 (строка ДОБАВЛЕНА), Новоселов, 18.06.2026
	
	//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Новоселов, 18.06.2026
	Если НЕ (ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.Проекты")
			ИЛИ ТипЗнч(Параметры.ВладелецФайла) = Тип("ДокументСсылка.упоПроектнаяЗадача")
			ИЛИ ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.упоЗадания")) Тогда  //[+] ИКТ №19162 (строка ДОБАВЛЕНА), Новоселов, 15.07.2026 
		Возврат;
	КонецЕсли;
	
	//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 04.08.2026 
	Если (ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.Проекты")
				И Не Пользователи.РолиДоступны("ИКТ_ПросмотрДобавлениеПрисоединенныхФайловПроектов, ИКТ_РедактированиеПрисоединенныхФайловПроектов")) 
			ИЛИ ((ТипЗнч(Параметры.ВладелецФайла) = Тип("ДокументСсылка.упоПроектнаяЗадача")
				ИЛИ ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.упоЗадания"))
					И Не Пользователи.РолиДоступны("ИКТ_ПросмотрДобавлениеПрисоединенныхФайловПроектныхЗадачЗаданий, ИКТ_РедактированиеПрисоединенныхФайловПроектныхЗадачЗаданий")) Тогда
		ВызватьИсключение("Данному пользователю недоступен просмотр файлов проектов");
	КонецЕсли;
	//[+]} ИКТ №20078
	
	Список.ДинамическоеСчитываниеДанных = Ложь;
	Список.ОсновнаяТаблица = Неопределено;
	
	ДополнительныеВладельцыФайлов = Новый ТаблицаЗначений;
	ДополнительныеВладельцыФайлов = ПолучитьВладельцевФайлов();

	Для каждого Строка Из ДополнительныеВладельцыФайлов Цикл
		ДобавитьВСписокЗапрос(Строка.ВладелецФайла, Строка.ТипВладельцаФайла, ДополнительныеВладельцыФайлов.Индекс(Строка));		
	КонецЦикла;
	//[+]} ИКТ №19162
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьИзменитьРеквизиты()
	
	//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Новоселов, 18.06.2026 
	НовыйЭлемент = Элементы.Вставить("СписокВладелецФайла", Тип("ПолеФормы"), Элементы.Список, Элементы.СписокГруппаИмяОписание);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Список.ВладелецФайла";
	НовыйЭлемент.Заголовок = "Размещение";
	//[+]} ИКТ №19162
	
	//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 18.06.2026
	СписокОписание = Элементы.СписокОписание;
	Элементы.Переместить(СписокОписание, Элементы.Список);
	Списокописание.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
	//[+]} ИКТ №20078
	
КонецПроцедуры

//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Новоселов, 18.06.2026 
&НаСервере
Функция ВернутьРазделительПодзапросов()
	
	Возврат
		"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
	
КонецФункции

//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 21.07.2026 Все связанные с проектом владельцы
&НаСервере
Функция ПолучитьВладельцевФайлов()
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Проект", Параметры.ВладелецФайла.Метаданные())
			И НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ВладелецФайла, "Проект")) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	упоПроектнаяЗадача.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ОтмененныеЗадачи
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|		ПО (упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоПроектнаяЗадача.Ссылка)
		|			И (упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		|ГДЕ
		|	упоПроектнаяЗадача.Проект = &Проект
		|	И упоПроектнаяЗадача.Ссылка <> &ОсновнойВладелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	&Проект КАК ВладелецФайла,
		|	ТИП(Справочник.Проекты) КАК ТипВладельцаФайла
		|ГДЕ
		|	&Проект <> &ОсновнойВладелец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	упоПроектнаяЗадача.Ссылка,
		|	ТИП(Документ.упоПроектнаяЗадача)
		|ИЗ
		|	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтмененныеЗадачи КАК ВТ_ОтмененныеЗадачи
		|		ПО (ВТ_ОтмененныеЗадачи.Ссылка = упоПроектнаяЗадача.Ссылка)
		|ГДЕ
		|	упоПроектнаяЗадача.Проект = &Проект
		|	И упоПроектнаяЗадача.Ссылка <> &ОсновнойВладелец
		|	И ВТ_ОтмененныеЗадачи.Ссылка ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	упоЗадания.Ссылка,
		|	ТИП(Справочник.упоЗадания)
		|ИЗ
		|	Справочник.упоЗадания КАК упоЗадания
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтмененныеЗадачи КАК ВТ_ОтмененныеЗадачи
		|		ПО (ВТ_ОтмененныеЗадачи.Ссылка = упоЗадания.ОбъектБазы)
		|ГДЕ
		|	упоЗадания.Проект = &Проект
		|	И упоЗадания.Ссылка <> &ОсновнойВладелец
		|	И ВТ_ОтмененныеЗадачи.Ссылка ЕСТЬ NULL");
	Запрос.УстановитьПараметр("ОсновнойВладелец", Параметры.ВладелецФайла);
	Запрос.УстановитьПараметр("Проект",
		?(ТипЗнч(Параметры.ВладелецФайла) = Тип("СправочникСсылка.Проекты"),
			Параметры.ВладелецФайла,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ВладелецФайла, "Проект")));  // Если основной владелец - Проект, то в параметр устанавливается он же, иначе - Проект из одноименного реквизита владельца
			
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
//[+]} ИКТ №20078

&НаСервере
Процедура ДобавитьВСписокЗапрос(ВладелецФайла, ТипВладельцаФайла, НомерДопЗапроса)
	
	Если ТипВладельцаФайла = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		ТекстДопЗапроса = ВернутьТекстЗапросаПроектнаяЗадача(НомерДопЗапроса);
	ИначеЕсли ТипВладельцаФайла = Тип("СправочникСсылка.упоЗадания") Тогда
		ТекстДопЗапроса = ВернутьТекстЗапросаЗадание(НомерДопЗапроса);
	//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 21.07.2026 Все связанные с проектом владельцы
	ИначеЕсли ТипВладельцаФайла = Тип("СправочникСсылка.Проекты") Тогда
		ТекстДопЗапроса = ВернутьТекстьЗапросаПроект(НомерДопЗапроса);
	//[+]} ИКТ №20078
	КонецЕсли;
	
	Список.ТекстЗапроса = Список.ТекстЗапроса + ВернутьРазделительПодзапросов() + ТекстДопЗапроса;
	Список.Параметры.УстановитьЗначениеПараметра("ВладелецФайлов" + НомерДопЗапроса, ВладелецФайла);
	
КонецПроцедуры

&НаСервере
Функция ВернутьТекстЗапросаПроектнаяЗадача(НомерДопЗапроса)
	
	Возврат СтрШаблон(
		"ВЫБРАТЬ
		|	Файлы%1.Ссылка КАК Ссылка,
		|	Файлы%1.ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА Файлы%1.ПометкаУдаления = ИСТИНА
		|			ТОГДА ЕСТЬNULL(Файлы%1.ИндексКартинки, 2) + 1
		|		ИНАЧЕ ЕСТЬNULL(Файлы%1.ИндексКартинки, 2)
		|	КОНЕЦ КАК ИндексКартинки,
		|	Файлы%1.Наименование КАК Наименование,
		|	ВЫРАЗИТЬ(Файлы%1.Описание КАК СТРОКА(500)) КАК Описание,
		|	Файлы%1.Автор,
		|	Файлы%1.ДатаСоздания,
		|	Файлы%1.Изменил КАК Отредактировал,
		|	ДОБАВИТЬКДАТЕ(Файлы%1.ДатаМодификацииУниверсальная, СЕКУНДА, &СекундДоМестногоВремени) КАК ДатаИзменения,
		|	ВЫРАЗИТЬ(Файлы%1.Размер / 1024 КАК ЧИСЛО(10, 0)) КАК Размер,
		|	Файлы%1.ПодписанЭП,
		|	Файлы%1.Зашифрован,
		|	ВЫБОР
		|		КОГДА Файлы%1.ПодписанЭП
		|				И Файлы%1.Зашифрован
		|			ТОГДА 2
		|		КОГДА Файлы%1.Зашифрован
		|			ТОГДА 1
		|		КОГДА Файлы%1.ПодписанЭП
		|			ТОГДА 0
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК НомерКартинкиПодписанЗашифрован,
		|	ВЫБОР
		|		КОГДА НЕ Файлы%1.Редактирует В (&ПустыеПользователи)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируется,
		|	ВЫБОР
		|		КОГДА Файлы%1.Редактирует = &ТекущийПользователь
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируетТекущийПользователь,
		|	ВЫБОР
		|		КОГДА НЕ Файлы%1.Редактирует В (&ПустыеПользователи)
		|				И Файлы%1.Редактирует <> &ТекущийПользователь
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируетДругойПользователь,
		|	Файлы%1.Расширение КАК Расширение,
		|	ВЫБОР
		|		КОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись <> НЕОПРЕДЕЛЕНО
		|				И Файлы%1.Редактирует = НЕОПРЕДЕЛЕНО
		|			ТОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись
		|		ИНАЧЕ Файлы%1.Редактирует
		|	КОНЕЦ КАК Редактирует,
		|	Файлы%1.Редактирует КАК РедактируетПользователь,
		|	ЛОЖЬ КАК ЭтоГруппа,
		|	Файлы%1.Служебный КАК Служебный,
		|	НЕОПРЕДЕЛЕНО КАК ГруппаФайла,
		|	Файлы%1.ВладелецФайла КАК ВладелецФайла,
		|	Файлы%1.ХранитьВерсии КАК ХранитьВерсии
		|ИЗ
		|	Справочник.Файлы КАК Файлы%1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыСинхронизацииФайловСОблачнымСервисом КАК СтатусыСинхронизацииФайловСОблачнымСервисом
		|		ПО Файлы%1.Ссылка = СтатусыСинхронизацииФайловСОблачнымСервисом.Файл
		|ГДЕ
		|	Файлы%1.ВладелецФайла = &ВладелецФайлов%1", НомерДопЗапроса);
	
КонецФункции

