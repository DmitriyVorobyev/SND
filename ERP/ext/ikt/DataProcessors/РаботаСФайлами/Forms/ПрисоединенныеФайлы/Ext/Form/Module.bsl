//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 21.07.2026 Все связанные с проектом владельцы
Функция ВернутьТекстьЗапросаПроект(НомерДопЗапроса)
	
	Возврат СтрШаблон(
		"ВЫБРАТЬ
		|	Файлы%1.Ссылка КАК Ссылка,
		|	Файлы%1.ПометкаУдаления,
		|	ВЫБОР
		|		КОГДА Файлы%1.ПометкаУдаления = ИСТИНА
		|			ТОГДА ЕСТЬNULL(Файлы%1.ИндексКартинки, 2) + 1
		|		ИНАЧЕ ЕСТЬNULL(Файлы%1.ИндексКартинки, 2)
		|	КОНЕЦ КАК ИндексКартинки,
		|	Файлы%1.Наименование КАК Наименование,
		|	ВЫРАЗИТЬ(Файлы%1.Описание КАК СТРОКА(500)) КАК Описание,
		|	Файлы%1.Автор,
		|	Файлы%1.ДатаСоздания,
		|	Файлы%1.Изменил КАК Отредактировал,
		|	ДОБАВИТЬКДАТЕ(Файлы%1.ДатаМодификацииУниверсальная, СЕКУНДА, &СекундДоМестногоВремени) КАК ДатаИзменения,
		|	ВЫРАЗИТЬ(Файлы%1.Размер / 1024 КАК ЧИСЛО(10, 0)) КАК Размер,
		|	Файлы%1.ПодписанЭП,
		|	Файлы%1.Зашифрован,
		|	ВЫБОР
		|		КОГДА Файлы%1.ПодписанЭП
		|				И Файлы%1.Зашифрован
		|			ТОГДА 2
		|		КОГДА Файлы%1.Зашифрован
		|			ТОГДА 1
		|		КОГДА Файлы%1.ПодписанЭП
		|			ТОГДА 0
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК НомерКартинкиПодписанЗашифрован,
		|	ВЫБОР
		|		КОГДА НЕ Файлы%1.Редактирует В (&ПустыеПользователи)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируется,
		|	ВЫБОР
		|		КОГДА Файлы%1.Редактирует = &ТекущийПользователь
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируетТекущийПользователь,
		|	ВЫБОР
		|		КОГДА НЕ Файлы%1.Редактирует В (&ПустыеПользователи)
		|				И Файлы%1.Редактирует <> &ТекущийПользователь
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ФайлРедактируетДругойПользователь,
		|	Файлы%1.Расширение КАК Расширение,
		|	ВЫБОР
		|		КОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись <> НЕОПРЕДЕЛЕНО
		|				И Файлы%1.Редактирует = НЕОПРЕДЕЛЕНО
		|			ТОГДА СтатусыСинхронизацииФайловСОблачнымСервисом.УчетнаяЗапись
		|		ИНАЧЕ Файлы%1.Редактирует
		|	КОНЕЦ КАК Редактирует,
		|	Файлы%1.Редактирует КАК РедактируетПользователь,
		|	Файлы%1.ЭтоГруппа КАК ЭтоГруппа,
		|	ЛОЖЬ КАК Служебный,
		|	Файлы%1.Родитель КАК ГруппаФайла,
		|	Файлы%1.ВладелецФайла КАК ВладелецФайла,
		|	Файлы%1.ХранитьВерсии КАК ХранитьВерсии
		|ИЗ
		|	Справочник.ПроектыПрисоединенныеФайлы КАК Файлы%1
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыСинхронизацииФайловСОблачнымСервисом КАК СтатусыСинхронизацииФайловСОблачнымСервисом
		|		ПО Файлы%1.Ссылка = СтатусыСинхронизацииФайловСОблачнымСервисом.Файл
		|ГДЕ
		|	Файлы%1.ВладелецФайла = &ВладелецФайлов%1", НомерДопЗапроса);
	
КонецФункции
//[+]} ИКТ №20078

&НаКлиенте
&ИзменениеИКонтроль("ТекущиеДанные")
Функция Расш1_ТекущиеДанные()
	#Удаление
	Если Не СтандартныеПодсистемыКлиент.ЭтоЭлементДинамическогоСписка(Элементы.Список)
		Или Элементы.Список.ТекущиеДанные.ВладелецФайла <> ВладелецФайла Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Элементы.Список.ТекущиеДанные;
	#КонецУдаления
	#Вставка
	//{[*] ИКТ №19162 (фрагмент ИЗМЕНЕН), Новоселов, 19.06.2026
	Если СтандартныеПодсистемыКлиент.ЭтоЭлементДинамическогоСписка(Элементы.Список) Тогда
		Если ТипЗнч(Элементы.Список.ТекущиеДанные.ВладелецФайла) = Тип("ДокументСсылка.упоПроектнаяЗадача")
			ИЛИ ТипЗнч(Элементы.Список.ТекущиеДанные.ВладелецФайла) = Тип("СправочникСсылка.Проекты")
			ИЛИ ТипЗнч(Элементы.Список.ТекущиеДанные.ВладелецФайла) = Тип("СправочникСсылка.упоЗадания")  //[+] ИКТ №19162 (строка ДОБАВЛЕНА), Новоселов, 17.07.2026 
			ИЛИ Элементы.Список.ТекущиеДанные.ВладелецФайла = ВладелецФайла Тогда
			
			Возврат Элементы.Список.ТекущиеДанные;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	//[*]} ИКТ №19162
	#КонецВставки
КонецФункции

&НаКлиенте
Процедура Расш1_СписокВыборПеред(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Новоселов, 19.06.2026 
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("Число") Тогда
		ВыбраннаяСтрока = Элементы.Список.ТекущиеДанные.Ссылка;
	КонецЕсли;
	//[+]} ИКТ №19162
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("УстановитьДоступностьФайловыхКоманд")
Процедура Расш1_УстановитьДоступностьФайловыхКоманд(Результат, ПараметрыВыполнения)
	
	ТекущиеДанные = ТекущиеДанные();
	
	ИменаКоманд = Новый Соответствие;
	Если ТекущиеДанные = Неопределено И Не ФайлыРедактируютсяВОблачномСервисе Тогда
		
		ИменаКоманд.Вставить("Добавить", Истина);
		ИменаКоманд.Вставить("ДобавитьФайлСоСканера", Истина);
		ИменаКоманд.Вставить("ДобавитьФайлПоШаблону", Истина);
		ИменаКоманд.Вставить("ЗагрузитьФайлы", Истина);
		ИменаКоманд.Вставить("ЗагрузитьПапку", Истина);
		
	#Удаление
	ИначеЕсли ТекущиеДанные <> Неопределено И ТипЗнч(Элементы.Список.ТекущаяСтрока) = ТипСправочникаСФайлами Тогда
	#КонецУдаления
	#Вставка
	//{[*] ИКТ №19162 (фрагмент ИЗМЕНЕН), Новоселов, 19.06.2026 
	ИначеЕсли ТекущиеДанные <> Неопределено И ТипЗнч(Элементы.Список.ТекущаяСтрока) = ТипСправочникаСФайлами 
		ИЛИ ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
	//[*]} ИКТ №19162
	#КонецВставки
		
		ВозможностьОсвободитьФайл = РаботаСФайламиСлужебныйКлиент.ВозможностьОсвободитьФайл(
		ТекущиеДанные.Ссылка,
		ТекущиеДанные.ФайлРедактируетТекущийПользователь,
		ТекущиеДанные.РедактируетПользователь);
		
		ИменаКоманд = ДоступныеКоманды(ТекущиеДанные, ФайлыРедактируютсяВОблачномСервисе,
		ВозможностьОсвободитьФайл, ПользователиКлиент.АвторизованныйПользователь());
		#Вставка
		//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Новоселов, 15.07.2026 
		Если ТекущиеДанные.ВладелецФайла <> ВладелецФайла Тогда
			ИменаКоманд["Удалить"] = Ложь;
		КонецЕсли;
		//[+]} ИКТ №19162
		
		//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 28.07.2026 
		Если Не ДоступноРедактированиеФайла(ТипЗнч(ТекущиеДанные.ВладелецФайла), ТекущиеДанные.Автор) Тогда
			
			ИменаКоманд["Редактировать"] = Ложь;
			ИменаКоманд["Занять"] = Ложь;
			ИменаКоманд["ЗакончитьРедактирование"] = Ложь;
			ИменаКоманд["Освободить"] = Ложь;
			ИменаКоманд["ОбновитьИзФайлаНаДиске"] = Ложь;
			
		КонецЕсли;
		//[+]} ИКТ №20078
		#КонецВставки
		
	КонецЕсли;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.ПечатьСоШтампом.Видимость = ДоступнаПечатьСоШтампом
		И (ТекущиеДанные.Расширение = "mxl") ИЛИ (ТекущиеДанные.Расширение = "docx")
		И ТекущиеДанные.ПодписанЭП;
	КонецЕсли;
	
	Для каждого ИмяЭлементаФормы Из ИменаЭлементовКнопокФормы Цикл
		
		ЭлементФормы = Элементы.Найти(ИмяЭлементаФормы);
		Если ИменаКоманд[ЭлементФормы.ИмяКоманды] = Истина Или ИменаКоманд[ЭлементФормы.Имя] = Истина Тогда
			
			Если НЕ ЭлементФормы.Доступность Тогда
				ЭлементФормы.Доступность = Истина;
			КонецЕсли;
			
		ИначеЕсли ЭлементФормы.Доступность Тогда
			ЭлементФормы.Доступность = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ПодключитьОбработчикОжидания("ОбновитьПредпросмотр", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПриОткрытииПосле(Отказ)
	
	//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Макушев, 03.07.2026
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьПодключениеЗавершение", ЭтотОбъект);
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ПроверитьПодключение(
		ОписаниеОповещения,
		ЭтотОбъект,,
		Ложь,
		Истина);
	//[+]} ИКТ №19162
	
КонецПроцедуры

//{[+] ИКТ №19162 (фрагмент ДОБАВЛЕН), Макушев, 03.07.2026
&НаКлиенте
Процедура ПроверитьПодключениеЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = Истина Тогда
		СписокЗаданий = ПолучитьСписокЗаданий(ВладелецФайла);
	Иначе
		Сообщить("Нет подключения к документообороту, файлы, прикрепленные к заданиям не скопированы.")
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗаданий(ВладелецФайла)
	
	ФайлСкопирован = Ложь;
	Результат = Новый Массив();
	ПравилоИнтеграции = Неопределено;
	Если ТипЗнч(ВладелецФайла) = Тип("ДокументСсылка.упоПроектнаяЗадача")
			//{[+] ИКТ №20078 (фрагмент ДОБАВЛЕН), Новоселов, 30.07.2026 Расширил услоние - все владельцы файлов
			Или ТипЗнч(ВладелецФайла) = Тип("СправочникСсылка.Проекты")
			Или ТипЗнч(ВладелецФайла) = Тип("СправочникСсылка.упоЗадания") Тогда
			//[+]} ИКТ №20078
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	упоЗадания.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.упоЗадания КАК упоЗадания
			|ГДЕ
			|	упоЗадания.Проект = &Проект
			|	И упоЗадания.Ссылка <> &ОсновнойВладелец");
		Запрос.УстановитьПараметр("ОсновнойВладелец", ВладелецФайла);
		Запрос.УстановитьПараметр("Проект", ?(ТипЗнч(ВладелецФайла) = Тип("СправочникСсылка.Проекты"), ВладелецФайла, ВладелецФайла.Проект));
		ВыборкаЗаданияПроекта = Запрос.Выполнить().Выбрать();
		Пока ВыборкаЗаданияПроекта.Следующий() Цикл
			Если ПравилоИнтеграции = Неопределено Тогда
				Правила = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.НайтиСоздатьПодходящиеПравила(
				ВыборкаЗаданияПроекта.Ссылка);
				Если Правила.Количество() > 0 Тогда
					ПравилоИнтеграции = Правила[0];
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Тип = ПравилоИнтеграции.ТипОбъектаДО;
			ТипВидаДокумента = ПравилоИнтеграции.ТипВидаДокумента;
			ИдентификаторВидаДокумента = ПравилоИнтеграции.ИдентификаторВидаДокумента;
			ИспользоватьЭлектронныеПодписиИС =
			ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.ИспользоватьЭлектронныеЦифровыеПодписи();
			ВладелецМетаданные = ВыборкаЗаданияПроекта.Ссылка.Метаданные();
			ТипСправочникаСФайлами = ВладелецМетаданные.ПолноеИмя();
			ТипОбъектаМассив = СтрРазделить(ТипСправочникаСФайлами, ".");
			Если ТипОбъектаМассив[0] = "Справочник" Тогда
				ПредставлениеТипаВладельца = "справочника";
			ИначеЕсли ТипОбъектаМассив[0] = "Документ" Тогда
				ПредставлениеТипаВладельца = "документа";
			КонецЕсли;
			ОбъектДО = РегистрыСведений.ОбъектыИнтегрированныеС1СДокументооборотом.ДанныеОбъектаДОПоВнешнемуОбъекту(ВыборкаЗаданияПроекта.Ссылка);
			Если ОбъектДО = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОбъектДО.ID) И ЗначениеЗаполнено(ОбъектДО.type) Тогда
				ID = ОбъектДО.ID;
				Тип = ОбъектДО.type;
			Иначе
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(ID) Тогда
				ПолучаемыеПоля = Новый Массив;
				ПолучаемыеПоля.Добавить("files");
				ПолучаемыеПоля.Добавить("documentType");
				ПолучаемыеПоля.Добавить("enabledProperties");
				ПолучаемыеПоля.Добавить("htmlView");
				ПолучаемыеПоля.Добавить("ignoreDeletionMark");
				Прокси = ИнтеграцияС1СДокументооборотБазоваяФункциональностьПовтИсп.ПолучитьПрокси();
				УстановитьПривилегированныйРежим(Истина);  //[+] ИКТ №20078 (строка ДОБАВЛЕНА), Новоселов, 30.07.2026 
				ОбъектXDTO = ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПолучитьОбъект(
				Прокси,
				Тип,
				ID,
				ПолучаемыеПоля,
				ПравилоИнтеграции.Ссылка,
				ВыборкаЗаданияПроекта.Ссылка);
				Для Каждого Ф Из ОбъектXDTO.files Цикл
					АдресВременногоХранилищаФайла = ПоместитьВоВременноеХранилище(
					Неопределено,
					УникальныйИдентификатор);
					
					ОписаниеФайла = ИнтеграцияС1СДокументооборотБазоваяФункциональностьВызовСервера.ОписаниеФайла(
					Ф.objectID.id,,
					АдресВременногоХранилищаФайла);
					ДанныеФайла = ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиентСервер.ДанныеФайла(
					ОписаниеФайла.Наименование,
					Неопределено,
					"DMFile",
					ОписаниеФайла.Расширение,
					ОписаниеФайла.РольФайлаID);
					ЗаполнитьЗначенияСвойств(ДанныеФайла, ОписаниеФайла);
					ДанныеФайла.Описание = ОписаниеФайла.Описание;
					ДанныеФайла.Размер = ОписаниеФайла.Размер;
					ПараметрыФайла = РаботаСФайламиСлужебныйКлиентСервер.ПараметрыДобавленияФайла();
					ПараметрыФайла.ВладелецФайлов = ОписаниеФайла.ВладелецФайла;  //[*] ИКТ №20078 (строка ИЗМЕНЕНА), Новоселов, 30.07.2026 ПараметрыФайла.ВладелецФайлов = ВладелецФайла;
					ПараметрыФайла.ИмяБезРасширения = Ф.name;
					ПараметрыФайла.РасширениеБезТочки = ОписаниеФайла.Расширение;
					ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
					ПараметрыФайла.ВремяИзмененияУниверсальное = ОписаниеФайла.ДатаМодификации;
					Запрос = Новый Запрос("ВЫБРАТЬ
					                      |	Файлы.Ссылка КАК Ссылка,
					                      |	Файлы.ДатаМодификацииУниверсальная КАК ДатаМодификацииУниверсальная
					                      |ИЗ
					                      |	Справочник.Файлы КАК Файлы
					                      |ГДЕ
					                      |	Файлы.ВладелецФайла = &ВладелецФайла
					                      |	И Файлы.Наименование = &Наименование");
					Запрос.УстановитьПараметр("ВладелецФайла", ОписаниеФайла.ВладелецФайла);  //[*] ИКТ №20078 (строка ИЗМЕНЕНА), Новоселов, 31.07.2026 Запрос.УстановитьПараметр("ВладелецФайла", ВладелецФайла);
					Запрос.УстановитьПараметр("Наименование", Ф.name);
					ВыборкаСуществующиеФайлы = Запрос.Выполнить().Выбрать();
					НовФайл = Неопределено;
					Если Не ВыборкаСуществующиеФайлы.Следующий() Тогда
						ФайлСсылка = РаботаСФайламиСлужебныйВызовСервера.ДобавитьФайл(ПараметрыФайла,
						АдресВременногоХранилищаФайла, "");
						ФайлСкопирован = Истина;
						НовФайл = ФайлСсылка;
					ИначеЕсли ВыборкаСуществующиеФайлы.ДатаМодификацииУниверсальная < ОписаниеФайла.ДатаМодификации или ВыборкаСуществующиеФайлы.ДатаМодификацииУниверсальная < Ф.activeVersion.modificationDate Тогда
						ИнформацияОФайле = Новый Структура;
						ИнформацияОФайле.Вставить("АдресФайлаВоВременномХранилище", АдресВременногоХранилищаФайла);
						ИнформацияОФайле.Вставить("АдресВременногоХранилищаТекста", "");
						ИнформацияОФайле.Вставить("ИмяБезРасширения", Ф.name);
						ИнформацияОФайле.Вставить("ДатаМодификацииУниверсальная", ОписаниеФайла.ДатаМодификации);
						ИнформацияОФайле.Вставить("Расширение", ОписаниеФайла.Расширение);
						ИнформацияОФайле.Вставить("Размер", ОписаниеФайла.Размер);
						//
						ТекФайл = ВыборкаСуществующиеФайлы.Ссылка.ПолучитьОбъект();
						ТекФайл.Наименование = ИнформацияОФайле.ИмяБезРасширения;
						ТекФайл.Расширение = ОписаниеФайла.Расширение;
						ТекФайл.Размер = ОписаниеФайла.Размер;
						ТекФайл.ДатаМодификацииУниверсальная = Ф.activeVersion.modificationDate;
						ТекФайл.ОбменДанными.Загрузка = Истина;
						ТекФайл.Записать();
						ТекВерсия = ВыборкаСуществующиеФайлы.Ссылка.ТекущаяВерсия.ПолучитьОбъект();
						ЗаполнитьЗначенияСвойств(ТекВерсия, ВыборкаСуществующиеФайлы.Ссылка, "Расширение, Наименование, Размер");
						ТекВерсия.НомерВерсии = Ф.activeVersion.number;
						ТекВерсия.ОбменДанными.Загрузка = Истина;
						ТекВерсия.Записать();
						РаботаСФайлами.ОбновитьФайл(ВыборкаСуществующиеФайлы.Ссылка, ИнформацияОФайле);
						//ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИнформацияОФайле.АдресФайлаВоВременномХранилище);
						//Запись = РегистрыСведений.ХранилищеФайлов.СоздатьМенеджерЗаписи();
						//Запись.Файл = ТекВерсия.Ссылка;
						//Запись.Прочитать();
						//
						//Запись.Записать();
						ФайлСкопирован = Истина;
						//НовФайл = Рез.Ссылка;
					КонецЕсли;
					Если Не НовФайл = Неопределено Тогда
						НовФайлО = НовФайл.ПолучитьОбъект();
						НовФайлО.ДатаМодификацииУниверсальная = ОписаниеФайла.ДатаМодификации;
						НовФайлО.ОбменДанными.Загрузка = Истина;
						НовФайлО.Записать();
					КонецЕсли;
				КонецЦикла;
				УстановитьПривилегированныйРежим(Ложь);  //[+] ИКТ №20078 (строка ДОБАВЛЕНА), Новоселов, 30.07.2026 
				Результат.Добавить(Новый Структура("ID, Тип, ВладелецФайла", ID, Тип, ВыборкаЗаданияПроекта.Ссылка));
			КонецЕсли;
		КонецЦикла;
		Если ФайлСкопирован Тогда
			Элементы.Список.Обновить();
		КонецЕсли;
		Возврат Результат;
	Иначе
		Возврат Новый Массив();
	КонецЕсли;
	
КонецФункции // ПолучитьСписокЗаданий()
