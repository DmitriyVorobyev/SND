&НаСервереБезКонтекста
Функция ДоступноРедактированиеФайла(ТипВладельцаФайла, АвторФайла)
	
	Автор = ?(ТипЗнч(АвторФайла) = Тип("Строка"), Справочники.Пользователи.НайтиПоНаименованию(АвторФайла), АвторФайла);
	
	Если Автор = Пользователи.ТекущийПользователь() Тогда
		Возврат Истина;
	ИначеЕсли Автор = Справочники.Пользователи.ПустаяСсылка() Тогда
		Общегоназначения.СообщитьПользователю("Не удалось установить связь автора файла с пользователем системы!");
	КонецЕсли;
	
	Если ТипВладельцаФайла = Тип("СправочникСсылка.Проекты") Тогда
		Возврат Пользователи.РолиДоступны("ИКТ_РедактированиеПрисоединенныхФайловПроектов");
	ИначеЕсли ТипВладельцаФайла = Тип("ДокументСсылка.упоПроектнаяЗадача")
			Или ТипВладельцаФайла = Тип("СправочникСсылка.упоЗадания") Тогда
		Возврат Пользователи.РолиДоступны("ИКТ_РедактированиеПрисоединенныхФайловПроектныхЗадачЗаданий");
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции
