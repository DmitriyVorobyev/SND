&НаКлиенте
&ИзменениеИКонтроль("ВыделенныеСтроки")
Функция Расш1_ВыделенныеСтроки()

	ВыделенныеСтроки = Новый Массив;
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		Если ТипЗнч(ВыделеннаяСтрока) <> Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
			#Удаление
			Если ДанныеСтроки.ВладелецФайла = ВладелецФайла Тогда
				ВыделенныеСтроки.Добавить(ВыделеннаяСтрока);
			КонецЕсли;
			#КонецУдаления			
			#Вставка
			ВыделенныеСтроки.Добавить(?(ТипЗнч(ВыделеннаяСтрока) = Тип("Число"), ДанныеСтроки.Ссылка, ВыделеннаяСтрока));  //[*] ИКТ №19162 (строка ИЗМЕНЕНА), Новоселов, 15.07.2026 
			#КонецВставки
		КонецЕсли;
	КонецЦикла;
	Возврат ВыделенныеСтроки;

КонецФункции

&НаСервереБезКонтекста
&ИзменениеИКонтроль("УстановитьСнятьПометкуУдаления")
Процедура Расш1_УстановитьСнятьПометкуУдаления(Файлы, ВладелецФайла)
	
	#Удаление
	ФайлыВладельца = РаботаСФайламиСлужебный.ОтобратьПрисоединенныеФайлыВладельца(Файлы, ВладелецФайла);

	ПометкаУдаления = Неопределено;
	Для каждого ФайлСсылка Из ФайлыВладельца Цикл
    #КонецУдаления
	#Вставка
	//{[*] ИКТ №20078 (фрагмент ИЗМЕНЕН), Новоселов, 04.08.2026 
	ПометкаУдаления = Неопределено;
	Для каждого ФайлСсылка Из Файлы Цикл
	//[*]} ИКТ №20078
	#КонецВставки
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных();
			ЭлементБлокировки = Блокировка.Добавить(ФайлСсылка.Метаданные().ПолноеИмя());
			ЭлементБлокировки.УстановитьЗначение("Ссылка", ФайлСсылка);
			Блокировка.Заблокировать();

			ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
			Если ПометкаУдаления = Неопределено Тогда
				ПометкаУдаления = Не ФайлОбъект.ПометкаУдаления;
			КонецЕсли;
			ФайлОбъект.УстановитьПометкуУдаления(ПометкаУдаления);

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры