
&НаСервере
Процедура Расш1_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	//{[+] ИКТ №20612 (фрагмент ДОБАВЛЕН), Новоселов, 04.08.2026
	ПользовательНеМожетСоздаватьЗаданияБезПривязкиКПроекту = Не Пользователи.РолиДоступны("ИКТ_СозданиеЗаданияБезПривязкиКПроекту");
	
	Если Элементы.Найти("Создать") <> Неопределено И ПользовательНеМожетСоздаватьЗаданияБезПривязкиКПроекту Тогда
		Элементы.Создать.Доступность = Ложь;
	КонецЕсли;
	Если Элементы.Найти("Скопировать") <> Неопределено И ПользовательНеМожетСоздаватьЗаданияБезПривязкиКПроекту Тогда
		Элементы.Скопировать.Доступность = Ложь;
	КонецЕсли;
	Если Элементы.Найти("Добавить") <> Неопределено И ПользовательНеМожетСоздаватьЗаданияБезПривязкиКПроекту Тогда
		Элементы.Добавить.Доступность = Ложь;
	КонецЕсли;
	Если Элементы.Найти("Копировать") <> Неопределено И ПользовательНеМожетСоздаватьЗаданияБезПривязкиКПроекту Тогда
		Элементы.Копировать.Доступность = Ложь;
	КонецЕсли;
	//[+]} ИКТ №20612
	
КонецПроцедуры
