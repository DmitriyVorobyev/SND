//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
Процедура ПОД_ИКТ_СобытияПроходаСКУД_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	
	СвойстваОтбор = ДанныеXDTO;
	
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") Тогда
		СвойстваОтбор = ДанныеXDTO.КлючевыеСвойства;
	КонецЕсли;
	
	ID_ПроходаОтбор = Неопределено;
	
	СвойстваОтбор.Свойство("ID_ПроходаОтбор", ID_ПроходаОтбор);
	
	ПравилоКонвертацииСотрудники = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Сотрудники_Получение");
	
	ИТК_СобытияПроходаСКУД = РегистрыСведений.ИТК_СобытияПроходаСКУД.СоздатьНаборЗаписей();
	ИТК_СобытияПроходаСКУД.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	Если ЗначениеЗаполнено(ID_ПроходаОтбор) Тогда
		ИТК_СобытияПроходаСКУД.Отбор.ID_Прохода.Установить(Формат(ID_ПроходаОтбор, "ЧГ=0"));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИТК_СобытияПроходаСКУД.Отбор.ID_Прохода.Значение) Тогда
		Возврат;
	КонецЕсли;         
		
	Если ДанныеXDTO.Свойство("Записи")
		И ЗначениеЗаполнено(ДанныеXDTO.Записи) Тогда
	
		Для Каждого СтрокаЗаписи Из ДанныеXDTO.Записи Цикл
			ЗаписьИТК_СобытияПроходаСКУД = ИТК_СобытияПроходаСКУД.Добавить();
			
			ЗаполнитьЗначенияСвойств(ЗаписьИТК_СобытияПроходаСКУД, СтрокаЗаписи, "ID_ТочкиДоступа, internalEmpId, ВремяПрохода, ЗначениеПропуска, Сотрудник, ТипПрохода");
						
			Если ЗначениеЗаполнено(СтрокаЗаписи.Сотрудник) Тогда
				ЗаписьИТК_СобытияПроходаСКУД.Сотрудник = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(СтрокаЗаписи.Сотрудник.Значение, Тип("СправочникСсылка.Сотрудники"), КомпонентыОбмена);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаЗаписи.ТипПрохода) Тогда
				ЗаписьИТК_СобытияПроходаСКУД.ТипПрохода = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ИТК_ТипПроходаТочекДоступа." + СтрокаЗаписи.ТипПрохода.Значение);
			КонецЕсли;
			
			ЗаписьИТК_СобытияПроходаСКУД.ID_Прохода = Формат(СтрокаЗаписи.ID_Прохода, "ЧГ=0");
			
		КонецЦикла;
		
	КонецЕсли;
	
	ИТК_СобытияПроходаСКУД.ОбменДанными.Загрузка = Истина;
	ИТК_СобытияПроходаСКУД.Записать(Истина);

КонецПроцедуры //[+]} ИКТ №16316
