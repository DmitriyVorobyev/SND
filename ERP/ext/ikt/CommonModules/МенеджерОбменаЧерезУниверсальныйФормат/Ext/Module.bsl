			ЗаполнитьЗначенияСвойств(СтрокаЗарплата, СтрокаПолученныеДанныеЗарплата); 
			СтрокаЗарплата.ПериодВзаиморасчетов = ДанныеИБ.ПериодРегистрации;
			
			НайденнаяСтрокаСостав = ДанныеИБ.Состав.Найти(СтрокаПолученныеДанныеЗарплата.ФизическоеЛицо); 
			Если Не ЗначениеЗаполнено(НайденнаяСтрокаСостав) Тогда 
				НоваяСтрокаСостав = ДанныеИБ.Состав.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСостав, СтрокаПолученныеДанныеЗарплата);
			КонецЕсли;
			
			НайденнаяСтрокаФЛ = ДанныеИБ.ФизическиеЛица.Найти(СтрокаПолученныеДанныеЗарплата.ФизическоеЛицо); 
			Если Не ЗначениеЗаполнено(НайденнаяСтрокаФЛ) Тогда 
				НоваяСтрокаФизическиеЛица = ДанныеИБ.ФизическиеЛица.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаФизическиеЛица, СтрокаПолученныеДанныеЗарплата);
			КонецЕсли;
		КонецЦикла;  
		
		ДанныеИБ.КраткийСоставДокумента = ЗарплатаКадры.КраткийСоставСотрудниковПоСпискуФизическихЛиц(ДанныеИБ.ФизическиеЛица.ВыгрузитьКолонку("ФизическоеЛицо"), ДанныеИБ.ПериодРегистрации);

	КонецЕсли;
	
КонецПроцедуры //[+]} ИКТ №16316
#КонецОбласти

