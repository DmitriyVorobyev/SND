	|	ГруппыФинансовогоУчетаНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыФинансовогоУчетаНоменклатуры КАК ГруппыФинансовогоУчетаНоменклатуры
	|ГДЕ
	|	СОКРЛП(ГруппыФинансовогоУчетаНоменклатуры.Наименование) = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование","Товары (41)");
	
	Результат = ОбменДаннымиСлужебный.РезультатЗапросаВСтруктуру(Запрос.Выполнить()).Ссылка;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	Иначе
		Возврат Справочники.ГруппыФинансовогоУчетаНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор("d39414d6-262f-11ee-9227-00155d275002"));
	КонецЕсли;
	
КонецФункции
