&ИзменениеИКонтроль("ОтложеннаяОбработка_ОтчетОРозничныхПродажах")
Процедура ИКТ_ОтложеннаяОбработка_ОтчетОРозничныхПродажах(Объект, КомпонентыОбмена)
	Если НЕ ЗначениеЗаполнено(Объект.ВидЦены) И ЗначениеЗаполнено(Объект.Склад) Тогда
		РозничныйВидЦены = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Склад, "РозничныйВидЦены");
		Если ЗначениеЗаполнено(РозничныйВидЦены) Тогда 
			Объект.ВидЦены = РозничныйВидЦены;
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьТипНалогообложенияПоУмолчанию(Объект);

	Если Объект.ДополнительныеСвойства.Свойство("ТаблЧасти") Тогда
		Для каждого ТЧ Из Объект.ДополнительныеСвойства.ТаблЧасти Цикл
			Если ЗначениеЗаполнено(Объект.ДополнительныеСвойства.ТаблЧасти[ТЧ.Ключ]) Тогда
				Объект[ТЧ.Ключ].Загрузить(Объект.ДополнительныеСвойства.ТаблЧасти[ТЧ.Ключ]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ) Тогда
		ЗаполнитьКассуККМПоВалютеСкладуИОрганизации(Объект, КомпонентыОбмена);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.КассоваяСмена) Тогда
		ДокументыСПодарочнымиСертификатами = КомпонентыОбмена.ПараметрыКонвертации.ДокументыСПодарочнымиСертификатами; // ТаблицаЗначений

		НоваяСтрока = ДокументыСПодарочнымиСертификатами.Добавить();
		НоваяСтрока.ДокументСсылка   = Объект.Ссылка;
		НоваяСтрока.ДатаДокумента    = Объект.Дата;
		НоваяСтрока.ОчередьДокумента = 1;

		ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект, "КассаККМ, Организация, Валюта");
	КонецЕсли;

	ЗаполнитьСтатусыУказанияСерий(Объект, КомпонентыОбмена);

#Удаление
	// Эквайринговый терминал в ТЧ ОплатаПлатежнымиКартами
	ЭквайринговыйТерминал = ЭлементПоУмолчанию(КомпонентыОбмена, "ЭквайринговыйТерминал");

	Для Каждого Строка Из Объект.ОплатаПлатежнымиКартами Цикл
		Если Не ЗначениеЗаполнено(Строка.ЭквайринговыйТерминал) Тогда
			Строка.ЭквайринговыйТерминал = ЭквайринговыйТерминал; 
		КонецЕсли;
	КонецЦикла;
#КонецУдаления

	//++ Локализация
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "АкцизныеМарки") Тогда
		Для каждого Строка Из Объект.АкцизныеМарки Цикл
			Если Не ЗначениеЗаполнено(Строка.АкцизнаяМарка) И НЕ ПустаяСтрока(Строка.КодАкцизнойМарки) Тогда
				Строка.АкцизнаяМарка = Справочники.ШтрихкодыУпаковокТоваров.НайтиПоРеквизиту("ЗначениеШтрихкода", Строка.КодАкцизнойМарки);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//-- Локализация
КонецПроцедуры

&ИзменениеИКонтроль("ПОД_Справочник_ЭквайринговыеТерминалы_Получение_ПриОбработке")
Процедура ИКТ_ПОД_Справочник_ЭквайринговыеТерминалы_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	#Удаление
	Если ДанныеXDTO.Свойство("Номер") И НЕ ЗначениеЗаполнено(ДанныеXDTO.Номер) Тогда
		ОчиститьИспользованиеПКО(ИспользованиеПКО);
	КонецЕсли;
	#КонецУдаления
КонецПроцедуры


&ИзменениеИКонтроль("ПереопределитьПоляПоискаКонтрагентов")
Процедура ИКТ_ПереопределитьПоляПоискаКонтрагентов(КомпонентыОбмена, ДанныеXDTO)
	//  Если контрагент является индивидуальным предпринимателем или физ. лицом, то необходимо переопределить поля поиска,
	//	так как в приложении могут быть записаны два контрагента с одинаковыми ключевыми полями: ИНН + Наименование, но с разным видом ЮрФизЛицо

	ПравилаКонвертацииКонтрагентов = КомпонентыОбмена.ПравилаКонвертацииОбъектов.Найти("Справочник_Контрагенты_Получение", "ИмяПКО");
	Если ПравилаКонвертацииКонтрагентов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КлючевыеСвойства = Неопределено;
	Если Не ДанныеXDTO.Свойство("КлючевыеСвойства", КлючевыеСвойства) Тогда
		КлючевыеСвойства = ДанныеXDTO;
	КонецЕсли;

#Удаление
	Если Не (КлючевыеСвойства.Свойство("ЮридическоеФизическоеЛицо") И 
		КлючевыеСвойства.ЮридическоеФизическоеЛицо.Значение = "ФизическоеЛицо") Тогда

		Возврат;

	КонецЕсли;
#КонецУдаления
#Вставка
//{[+] ИКТ №9642 (фрагмент ДОБАВЛЕН), Селиверстов Д.Н., 03.09.2025 13:00
	Если Не (КлючевыеСвойства.Свойство("ЮридическоеФизическоеЛицо") И 
		КлючевыеСвойства.ЮридическоеФизическоеЛицо = "ФизическоеЛицо") Тогда

		Возврат;

	КонецЕсли;
//[+]} ИКТ №9642
#КонецВставки

	ПоляПоиска = ПравилаКонвертацииКонтрагентов.ПоляПоиска;
	ПоляПоиска.Очистить();

	ИННЗаполнен = КлючевыеСвойства.Свойство("ИНН") И ЗначениеЗаполнено(КлючевыеСвойства.ИНН);

	Если ИННЗаполнен Тогда
		ПоляПоиска.Добавить("ИНН, ЮрФизЛицо");
	Иначе
		ПоляПоиска.Добавить("НаименованиеПолное,ЮрФизЛицо");
		ПоляПоиска.Добавить("Наименование,ЮрФизЛицо");
	КонецЕсли;
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Документ_КорректировкаПоступленияТоваров_Получение_ПриКонвертацииДанныхXDTO")
Процедура ИКТ_ПКО_Документ_КорректировкаПоступленияТоваров_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		УстановитьПравилоДляПКСТабЧасти(КомпонентыОбмена,
		"Документ_КорректировкаПоступленияТоваров_Получение", 
		"Товары", 
		"НомерГТД",
		Ложь,
		"Справочник_НомераГТД_ПолучениеЭлемента");
	КонецЕсли;

	ПолученныеДанные.Проведен    = Истина;
	ПолученныеДанные.Согласован  = Истина;
	ПолученныеДанные.ДатаПлатежа = ПолученныеДанные.Дата;

	ДобавитьВалютуВДопСвойства(ПолученныеДанные, ДанныеXDTO);
	ДобавитьДоговорВДопСвойства(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена);

	ДокументПоступленияДанные = Неопределено;
	ИмяПКО = "";
	ДанныеXDTO.Свойство("ИсправляемыйДокументПоступления", ДокументПоступленияДанные);
	Если ДокументПоступленияДанные = Неопределено Тогда
		ДанныеXDTO.Свойство("ДокументПоступления", ДокументПоступленияДанные);
	КонецЕсли;
	Если ДокументПоступленияДанные <> Неопределено И ТипЗнч(ДокументПоступленияДанные) = Тип("Структура") Тогда
		ТипЗначенияДокумент = ДокументПоступленияДанные.ТипЗначения;
		Если Найти(ТипЗначенияДокумент, "ПоступлениеТоваровУслуг") Тогда // @Non-NLS-1
			ИмяПКО = "Документ_ПоступлениеТоваровУслуг_Получение";
		КонецЕсли; 
	КонецЕсли;
	Если ИмяПКО <> "" Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДокументОснование", Новый Структура("Значение, ИмяПКО",ДокументПоступленияДанные,ИмяПКО));
	КонецЕсли;

	Если ДанныеXDTO.ВидОперации.Значение = "ИсправлениеОшибки" Тогда
		ПолученныеДанные.ВидКорректировки = Перечисления.ХозяйственныеОперации.ИсправлениеОшибок;
	Иначе
		ПолученныеДанные.ВидКорректировки = Перечисления.ХозяйственныеОперации.КорректировкаПоСогласованиюСторон;
	КонецЕсли;
	ПолученныеДанные.ТипКорректировки = Перечисления.ТипыКорректировки.ОбычнаяКорректировка;
	#Область Товары

	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");
	ПравилаЗаполнения.Вставить("Цена",         "Цена");
	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС",     "СуммаНДС");
	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ПравилаЗаполнения.Вставить("КоличествоРНПТ", "КоличествоПоРНПТ");
	КонецЕсли;
	ВерсияФормата17ИВыше = ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.17");
	МассивСтрокТовары = Новый Массив;
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда

		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			Если Не ЗначениеЗаполнено(Строка.Количество) Или Строка.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			#Вставка
			//{[+] ИКТ №11390 (фрагмент ДОБАВЛЕН), Селиверстов Д.Н., 10.09.2025 07:10
			Если Не ЗначениеЗаполнено(Строка.Цена) Тогда
				Строка.Цена = 0;
			КонецЕсли;
			//[+]} ИКТ №11390
			//{[+] ИКТ №11984 (фрагмент ДОБАВЛЕН), Селиверстов Д.Н., 29.09.2025 14:00
			Если Не ЗначениеЗаполнено(Строка.КоличествоДоИзменения) Тогда
				Строка.КоличествоДоИзменения = 0;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.КоличествоДоКорректировки) Тогда
				Строка.КоличествоДоКорректировки = 0;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.КоличествоУпаковок) Тогда
				Строка.КоличествоУпаковок = 0;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.КоличествоУпаковокДоКорректировки) Тогда
				Строка.КоличествоУпаковокДоКорректировки = 0;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.КоличествоУпаковокДоИзменения) Тогда
				Строка.КоличествоУпаковокДоИзменения = 0;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка.СуммаДоИзменения) Тогда
				Строка.СуммаДоИзменения = 0;
			КонецЕсли;  
			Если Не ЗначениеЗаполнено(Строка.ЦенаДоИзменения) Тогда
				Строка.ЦенаДоИзменения = 0;
			КонецЕсли;
			//[+]} ИКТ №11984
			#КонецВставки

			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("Количество") И СтруктураДанныхСтроки.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;

			Если СтруктураДанныхСтроки.Свойство("СтавкаНДС") И ЗначениеЗаполнено(СтруктураДанныхСтроки.СтавкаНДС) Тогда
				СтруктураДанныхСтроки.СтавкаНДС = СправочникПоПеречислениюСтавкиНДС(КомпонентыОбмена, СтруктураДанныхСтроки.СтавкаНДС);
			КонецЕсли;

			Если ЗначениеЗаполнено(Строка.НомерГТД) Тогда
				Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
					СтруктураДанныхСтроки.Вставить("НомерГТД", Строка.НомерГТД);
				Иначе
					СтруктураДанныхСтроки.Вставить("НомерГТД", Новый Структура("НомерГТД, СтранаПроисхождения", Строка.НомерГТД, Строка.СтранаПроисхождения));
				КонецЕсли;
			КонецЕсли;

			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС;
			КонецЕсли;

			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);

			ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации,ВерсияФормата17ИВыше);
			СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("Склад", ПолученныеДанные.Склад);

			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;

	// Услуги добавляем в товары.
	Если ДанныеXDTO.Свойство("Услуги")
		И ЗначениеЗаполнено(ДанныеXDTO.Услуги) Тогда

		Для Каждого Строка Из ДанныеXDTO.Услуги Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
			Если СтруктураДанныхСтроки.Свойство("Количество") И СтруктураДанныхСтроки.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			СуммаСНДС = Строка.Сумма;
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
				СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
			КонецЕсли;

			СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
			ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
			Если ЗначениеЗаполнено(Строка.Содержание) Тогда
				СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
			КонецЕсли;
			СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
			Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
				СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
			КонецЕсли;
			Если НЕ СтруктураДанныхСтроки.Свойство("Количество") ИЛИ СтруктураДанныхСтроки.Количество = Неопределено Тогда
				СтруктураДанныхСтроки.Вставить("Количество", 1); 
			КонецЕсли;	 
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;

	Если МассивСтрокТовары.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Товары", МассивСтрокТовары);
	КонецЕсли;

	#КонецОбласти
	#Область Расхождения
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество",   "Количество");  
	ПравилаЗаполнения.Вставить("Сумма",        "Сумма");  
	ПравилаЗаполнения.Вставить("Цена",         "Цена"); 

	ПравилаЗаполнения.Вставить("СтавкаНДС",    "СтавкаНДС");

	ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС"); 

	Если ЗначениеФО("ИспользоватьХарактеристикиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Характеристика",     "Характеристика");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьСерииНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Серия",              "Серия");
	КонецЕсли;
	Если ЗначениеФО("ИспользоватьУпаковкиНоменклатуры", КомпонентыОбмена) Тогда
		ПравилаЗаполнения.Вставить("Упаковка",           "Упаковка");
		ПравилаЗаполнения.Вставить("КоличествоУпаковок", "КоличествоУпаковок");
	КонецЕсли;
	Если ВерсияФорматаЧислом(КомпонентыОбмена.ВерсияФорматаОбмена) >= ВерсияФорматаЧислом("1.10") Тогда
		ПравилаЗаполнения.Вставить("КоличествоРНПТ", "КоличествоПоРНПТ");
	КонецЕсли;
	МассивСтрокРасхождение = Новый Массив;
	Если ДанныеXDTO.Свойство("Товары")
		И ЗначениеЗаполнено(ДанныеXDTO.Товары) Тогда 
		Для Каждого Строка Из ДанныеXDTO.Товары Цикл
			Если Не ЗначениеЗаполнено(Строка.Количество) И Не ЗначениеЗаполнено(Строка.КоличествоДоИзменения) Тогда
				Продолжить;
			КонецЕсли;  	
			Если Не ЗначениеЗаполнено(Строка.Количество) Тогда
				Строка.Количество = 0;
			КонецЕсли;  

			Если Не ЗначениеЗаполнено(Строка.Сумма) Тогда
				Строка.Сумма = 0;
			КонецЕсли;  

			Если ВерсияФормата17ИВыше И НЕ Строка.СтавкаНДС.Свойство("Ставка") Тогда
				Строка.СтавкаНДС.Вставить("Ставка", "0");
			КонецЕсли; 
			Если ВерсияФормата17ИВыше 
				И ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения) И НЕ Строка.СтавкаНДСДоИзменения.Свойство("Ставка") Тогда
				Строка.СтавкаНДСДоИзменения.Вставить("Ставка", "0");
			КонецЕсли; 

			Если НЕ Строка.ЕстьВДокументеПоступленияРеализации 
				ИЛИ ЗначениеЗаполнено(Строка.СтавкаНДСДоИзменения) И (Не ВерсияФормата17ИВыше И Строка.СтавкаНДС.Значение <> Строка.СтавкаНДСДоИзменения.Значение
				ИЛИ ВерсияФормата17ИВыше И Строка.СтавкаНДС.Ставка <> Строка.СтавкаНДСДоИзменения.Ставка)
				Или НЕ ((Строка.НомерГТД = Неопределено И Строка.НомерГТДДоИзменения = Неопределено)
