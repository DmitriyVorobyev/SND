Процедура ПОД_Справочник_ГрафикРаботыСотрудников_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	Период = ДанныеXDTO.КлючевыеСвойства.Дата;
	МассивСтрок = Новый Массив; 
	
	Если ДанныеXDTO.Свойство("Записи")
		И ЗначениеЗаполнено(ДанныеXDTO.Записи) Тогда
		ПКООрганизация    				= ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Организации_Получение");
		ПКОССотрудник     				= ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Сотрудники_Получение");
		ПКОГрафикиРаботыСотрудников     = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ГрафикиРаботыСотрудников");
		Для каждого Строка Из ДанныеXDTO.Записи Цикл
			СтруктураДанныхСтроки = Новый Структура; 
	
			СтруктураДанныхСтроки.Вставить("ДействуетДо", Строка.ДействуетДо); 
			СтруктураДанныхСтроки.Вставить("Период", Строка.ДатаСобытия);						 
			ГоловнаяОрганизация = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена, 
				Строка.ГоловнаяОрганизация, 
				ПКООрганизация, 
				"ПолучитьСсылку");
	        СтруктураДанныхСтроки.Вставить("ГоловнаяОрганизация", ГоловнаяОрганизация.Ссылка);
				
			ГрафикРаботы = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена, 
				Строка.ГрафикРаботы, 
				ПКОГрафикиРаботыСотрудников, 
				"ПолучитьСсылку");
	        СтруктураДанныхСтроки.Вставить("ГрафикРаботы", ГрафикРаботы.Ссылка);	
				
			Сотрудник = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
				КомпонентыОбмена, 
				Строка.Сотрудник, 
				ПКОССотрудник, 
				"ПолучитьСсылку");
	        СтруктураДанныхСтроки.Вставить("Сотрудник", Сотрудник.Ссылка); 
				
			МассивСтрок.Добавить(СтруктураДанныхСтроки);
			
		КонецЦикла;
			
	КонецЕсли;      
	СсылкаНаДокумент = ДанныеXDTO.КлючевыеСвойства.Ссылка; 
	СтрукутраРеквизитов = Новый Структура;
	СтрукутраРеквизитов.Вставить("Период", Период);
	СтрукутраРеквизитов.Вставить("ГоловнаяОрганизация", ГоловнаяОрганизация);
	СтрукутраРеквизитов.Вставить("СсылкаНаДокумент", СсылкаНаДокумент); 
	СтрукутраРеквизитов.Вставить("УзелКорреспондента", КомпонентыОбмена.УзелКорреспондента); 
	ИмяРегистраКадровыхДанных = "ГрафикРаботыСотрудников";
	ЗаписатьДвиженияКадровогоУчета(МассивСтрок, СтрукутраРеквизитов, ИмяРегистраКадровыхДанных);
	ПолученныеДанные = Неопределено;
КонецПроцедуры

Процедура ДобавитьПКО_РегистрСведений_ГрафикРаботыСотрудников_Получение(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "РегистрСведений_ГрафикРаботыСотрудников_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.РегистрыСведений.ГрафикРаботыСотрудников;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.ГрафикРаботыСотрудников"; //@NON-NLS-1
	ПравилоКонвертации.ВариантИдентификации         = "ПоУникальномуИдентификатору";
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "", "Дата", 1);
	ДобавитьПКС(СвойстваШапки, "", "Номер", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Записи");
	ДобавитьПКС(СвойстваТЧ, "ГрафикРаботы",        "ГрафикиРаботыСотрудников", 1, "Справочник_ГрафикиРаботыСотрудников", ИКТ_ПространствоИмен());
	ДобавитьПКС(СвойстваТЧ, "ГоловнаяОрганизация", "ГоловнаяОрганизация", 1, "Справочник_Организации_Получение");
	ДобавитьПКС(СвойстваТЧ, "ДействуетДо",         "ДействуетДо", 1); 
	ДобавитьПКС(СвойстваТЧ, "ДатаСобытия",         "ДатаСобытия", 1);
	ДобавитьПКС(СвойстваТЧ, "Сотрудник",           "Сотрудник", 1, "Справочник_Сотрудники_Получение");
	
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, ИКТ_ПространствоИмен());

КонецПроцедуры

&ИзменениеИКонтроль("ЗаписатьДвиженияКадровогоУчета")
Процедура ИКТ_ЗаписатьДвиженияКадровогоУчета(МассивСтрок, СтрукутраРеквизитов, ИмяРегистраКадровыхДанных)
	ТаблицаИзменяемыхДанных = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", СтрукутраРеквизитов.УзелКорреспондента);
	Запрос.УстановитьПараметр("Идентификатор", СтрукутраРеквизитов.СсылкаНаДокумент.Значение);
	Запрос.Текст = "ВЫБРАТЬ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
	|ГДЕ
	|	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор = &Идентификатор
	|	И ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Документ = Выборка.Ссылка;
	КонецЕсли;

	КадровыеДанныеСотрудников = РегистрыСведений[ИмяРегистраКадровыхДанных].СоздатьНаборЗаписей(); 
	КадровыеДанныеСотрудников.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);
	Если Документ = Неопределено Тогда
		ДокументОбъект = Документы.ПереносДанных.СоздатьДокумент();
		ДокументОбъект.Дата = КонецДня(СтрукутраРеквизитов.Период);
		ДокументОбъект.Комментарий = "Создан при обмене с ЗУП.";
		ДокументОбъект.ПериодРегистрации = НачалоДня(СтрукутраРеквизитов.Период);
		ДокументОбъект.Организация = СтрукутраРеквизитов.ГоловнаяОрганизация;
		ДокументОбъект.УстановитьНовыйНомер(); 
	Иначеесли ЗначениеЗаполнено(Документ) Тогда  
		ДокументОбъект = Документ.ПолучитьОбъект();
	КонецЕсли;

	Если ДокументОбъект.ТаблицаРегистров.Найти(ИмяРегистраКадровыхДанных, "Имя") = Неопределено Тогда
		ДокументОбъект.ТаблицаРегистров.Добавить().Имя = ИмяРегистраКадровыхДанных;
		ДокументОбъект.Записать();
		СтруктураЗаписи = Новый Структура; 
		СтруктураЗаписи.Вставить("Идентификатор", СтрукутраРеквизитов.СсылкаНаДокумент.Значение);
		СтруктураЗаписи.Вставить("Ссылка", ДокументОбъект.Ссылка); 
		СтруктураЗаписи.Вставить("УзелИнформационнойБазы", СтрукутраРеквизитов.УзелКорреспондента);
		ОбменДаннымиСлужебный.ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "ПубличныеИдентификаторыСинхронизируемыхОбъектов", Истина);
	КонецЕсли;

	КадровыеДанныеСотрудников.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
	Для Каждого Запись Из МассивСтрок Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	КадровыеДанные.Регистратор КАК Регистратор, 
		|	КадровыеДанные.Период КАК Период
		|ИЗ
		|	РегистрКадровыхДанных КАК КадровыеДанные
		|ГДЕ
		|	КадровыеДанные.Сотрудник = &Сотрудник
		|	И КадровыеДанные.Период = &Период
		|	И КадровыеДанные.ФизическоеЛицо = &ФизическоеЛицо
		|	И КадровыеДанные.ГоловнаяОрганизация = &ГоловнаяОрганизация
		|	И КадровыеДанные.Регистратор <> &Регистратор";                     
		#Вставка                         
		//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 29.03.2026)
		Если ИмяРегистраКадровыхДанных = "ГрафикРаботыСотрудников" Тогда 
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	КадровыеДанные.Регистратор КАК Регистратор, 
			|	КадровыеДанные.Период КАК Период
			|ИЗ
			|	РегистрКадровыхДанных КАК КадровыеДанные
			|ГДЕ
			|	КадровыеДанные.Сотрудник = &Сотрудник
			|	И КадровыеДанные.Период = &Период
			|	И КадровыеДанные.ГоловнаяОрганизация = &ГоловнаяОрганизация
			|	И КадровыеДанные.Регистратор <> &Регистратор";
		КонецЕсли;
		//[+]} ИКТ №16316
		#КонецВставки

		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрКадровыхДанных", "РегистрСведений." + строка(ИмяРегистраКадровыхДанных) + ".СрезПоследних");
		Запрос.УстановитьПараметр("ГоловнаяОрганизация", Запись.ГоловнаяОрганизация);
		Запрос.УстановитьПараметр("Период", Запись.Период);
		Запрос.УстановитьПараметр("Сотрудник", Запись.Сотрудник);
		#Удаление
		Запрос.УстановитьПараметр("ФизическоеЛицо", Запись.ФизическоеЛицо);  
		#КонецУдаления
		#Вставка                         
		//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 29.03.2026)
		Если ИмяРегистраКадровыхДанных <> "ГрафикРаботыСотрудников" Тогда 
			Запрос.УстановитьПараметр("ФизическоеЛицо", Запись.ФизическоеЛицо);
		КонецЕсли;
		//[+]} ИКТ №16316
		#КонецВставки
		Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.Ссылка);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка =  РезультатЗапроса.Выгрузить();
		Если РезультатЗапроса.Пустой() Тогда
			ЗаполнитьЗначенияСвойств(КадровыеДанныеСотрудников.Добавить(), Запись);
		КонецЕсли;
	КонецЦикла;
	Попытка
		КадровыеДанныеСотрудников.Записать(Истина);  
	Исключение
	КонецПопытки;
КонецПроцедуры

