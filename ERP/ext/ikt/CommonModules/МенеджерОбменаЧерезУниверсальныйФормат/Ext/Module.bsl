				СтрокаЗарплата = Новый Структура("ИдентификаторСтроки, КВыплате, ФизическоеЛицо, Сотрудник");
				
				ЗаполнитьЗначенияСвойств(СтрокаЗарплата, СтрокаЗарплатаXDTO);
				
				
				Если ЗначениеЗаполнено(СтрокаЗарплатаXDTO.Сотрудник)
					И ТипЗнч(СтрокаЗарплатаXDTO.Сотрудник) = Тип("Структура") Тогда
					СтрокаЗарплата.Сотрудник = ОбменДаннымиXDTOСервер.СсылкаОбъектаПоУИДОбъектаXDTO(СтрокаЗарплатаXDTO.Сотрудник.Значение, Тип("СправочникСсылка.Сотрудники"), КомпонентыОбмена);	
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтрокаЗарплатаXDTO.ФизическоеЛицо)
					И ТипЗнч(СтрокаЗарплатаXDTO.ФизическоеЛицо) = Тип("Структура") Тогда					
					СтрокаЗарплата.ФизическоеЛицо = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, СтрокаЗарплатаXDTO.ФизическоеЛицо, ПравилоКонвертацииФизическиеЛица, "ПолучитьСсылку").Ссылка;
				КонецЕсли;
				
				
				СтрокаЗарплата.КВыплате = СтрокаЗарплатаXDTO.Сумма;
				СтрокаЗарплата.ИдентификаторСтроки = Новый УникальныйИдентификатор(СтрокаЗарплатаXDTO.ИдентификаторСтроки);
				
				НоваяСтрокаЗарплата = ПолученныеДанные.Зарплата.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаЗарплата, СтрокаЗарплата);
				НоваяСтрокаЗарплата.ПериодВзаиморасчетов = ПолученныеДанные.ПериодРегистрации;                                             
				
				НайденнаяСтрокаСостав = ПолученныеДанные.Состав.Найти(НоваяСтрокаЗарплата.ФизическоеЛицо); 
				Если Не ЗначениеЗаполнено(НайденнаяСтрокаСостав) Тогда 
					НоваяСтрокаСостав = ПолученныеДанные.Состав.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаСостав, НоваяСтрокаЗарплата);
				КонецЕсли;
				
				НайденнаяСтрокаФЛ = ПолученныеДанные.ФизическиеЛица.Найти(НоваяСтрокаЗарплата.ФизическоеЛицо); 
				Если Не ЗначениеЗаполнено(НайденнаяСтрокаФЛ) Тогда 
					НоваяСтрокаФизическиеЛица = ПолученныеДанные.ФизическиеЛица.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаФизическиеЛица, НоваяСтрокаЗарплата);
				КонецЕсли;
				
