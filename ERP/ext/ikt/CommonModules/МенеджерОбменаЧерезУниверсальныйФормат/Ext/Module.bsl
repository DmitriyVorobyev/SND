				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);

			ИначеЕсли Строка.Количество <> ?(ЗначениеЗаполнено(Строка.КоличествоДоИзменения), Строка.КоличествоДоИзменения, 0) Или Строка.Сумма <> Строка.СуммаДоИзменения Или Строка.СуммаНДС <> Строка.СуммаНДСДоИзменения Тогда
				СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(Строка, ПравилаЗаполнения);
				Если ЗначениеЗаполнено(Строка.Количество) И ЗначениеЗаполнено(Строка.КоличествоДоИзменения) Тогда
					СтруктураДанныхСтроки.Количество = Строка.Количество - ?(НЕ Строка.КоличествоДоИзменения = Неопределено,Строка.КоличествоДоИзменения, 0);
				КонецЕсли; 
				Если СтруктураДанныхСтроки.Свойство("Сумма") Тогда 
					СуммаДоИзменения = ?(Строка.СуммаДоИзменения = Неопределено, 0, Строка.СуммаДоИзменения);
					СтруктураДанныхСтроки.Сумма = ?(ЗначениеЗаполнено(Строка.Сумма),Строка.Сумма - СуммаДоИзменения, 0);
					СуммаСНДС = Строка.Сумма;
				Иначе
					СуммаСНДС = 0;
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И Строка.СуммаНДСДоИзменения <> Неопределено Тогда
					СтруктураДанныхСтроки.СуммаНДС = Строка.СуммаНДС - ?(ЗначениеЗаполнено(Строка.СуммаНДСДоИзменения), Строка.СуммаНДСДоИзменения, 0); 
				ИначеЕсли СтруктураДанныхСтроки.Свойство("СуммаНДС") тогда
					СтруктураДанныхСтроки.СуммаНДС = 0;	
				КонецЕсли;    
				Если СтруктураДанныхСтроки.Свойство("Цена") Тогда
					СтруктураДанныхСтроки.Цена = Строка.Цена - ?(ЗначениеЗаполнено(Строка.ЦенаДоИзменения),Строка.ЦенаДоИзменения, 0); 
				КонецЕсли;	
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") И НЕ ПолученныеДанные.ЦенаВключаетНДС Тогда
					СуммаСНДС = СуммаСНДС + СтруктураДанныхСтроки.СуммаНДС
				КонецЕсли;

				СтруктураДанныхСтроки.Вставить("СуммаСНДС", СуммаСНДС);
				ОбработатьСтавкуНДСПриПолучении(КомпонентыОбмена, Строка, СтруктураДанныхСтроки, ПолученныеДанные, КомпонентыОбмена.ПараметрыКонвертации, ВерсияФормата17ИВыше);
				Если ЗначениеЗаполнено(Строка.Содержание) Тогда
					СтруктураДанныхСтроки.Вставить("Содержание", Строка.Содержание);
				КонецЕсли;
				СтруктураДанныхСтроки.Вставить("СуммаВзаиморасчетов", Строка.Сумма);
				Если СтруктураДанныхСтроки.Свойство("СуммаНДС") Тогда
					СтруктураДанныхСтроки.Вставить("СуммаНДСВзаиморасчетов", СтруктураДанныхСтроки.СуммаНДС);
				КонецЕсли;
				МассивСтрокРасхождение.Добавить(СтруктураДанныхСтроки);

			Иначе
				// Нет изменений - пропускаем.
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	Если МассивСтрокРасхождение.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Расхождения", МассивСтрокРасхождение);
	КонецЕсли;
	#КонецОбласти
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_НоменклатураПоставщиков_Получение_ПриКонвертацииДанныхXDTO")
Процедура ИКТ_ПКО_Справочник_НоменклатураПоставщиков_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Владелец = Справочники.Партнеры.НеизвестныйПартнер;
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("Владелец") 
		И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.Владелец) Тогда

		Контрагент = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
		ДанныеXDTO.КлючевыеСвойства.Владелец,
		ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Контрагенты_Получение"), 
		"ПолучитьСсылку");

		Если ТипЗнч(Контрагент) = Тип("СправочникОбъект.Контрагенты") Тогда
			Контрагент = Контрагент.Ссылка;
		КонецЕсли;

		ПолученныеДанные.ДополнительныеСвойства.Вставить("Контрагент", Контрагент);

		Если ЗначениеЗаполнено(Контрагент) И ОбщегоНазначения.СсылкаСуществует(Контрагент) Тогда
			Владелец = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(Контрагент);
		КонецЕсли;
	КонецЕсли; 

	ПолученныеДанные.ДополнительныеСвойства.Вставить("Владелец", Владелец);

	Если ДанныеXDTO.КлючевыеСвойства.Свойство("УпаковкаНоменклатуры") 
		И ЗначениеЗаполнено(ДанныеXDTO.КлючевыеСвойства.УпаковкаНоменклатуры) Тогда

		ПравилаЗаполнения = Новый Соответствие;
		ПравилаЗаполнения.Вставить("ЕдиницаИзмерения", "ЕдиницаИзмерения");
		ПравилаЗаполнения.Вставить("Коэффициент", "Коэффициент");
		ПравилаЗаполнения.Вставить("Наименование", "НаименованиеУпаковки");
		ДанныеУпаковки = ДанныеКоллекцииВВидеСтруктуры(ДанныеXDTO.КлючевыеСвойства.УпаковкаНоменклатуры, ПравилаЗаполнения);

		ПолученныеДанные.НаименованиеУпаковки = ДанныеУпаковки.НаименованиеУпаковки;
		#Вставка
		Если Не ДанныеУпаковки.Свойство("Коэффициент") Тогда
			
			ДанныеУпаковки.Вставить("Коэффициент", Неопределено);
			
		КонецЕсли;
		#КонецВставки

		Если НЕ ДанныеУпаковки.Свойство("Коэффициент") ИЛИ 
			(ДанныеУпаковки.Свойство("Коэффициент") И Не ЗначениеЗаполнено(ДанныеУпаковки.Коэффициент)) Тогда
			ПолученныеДанные.КоличествоУпаковок = 1;
			ПолученныеДанные.КоличествоБазовойЕдиницыИзмерения = 1;
		ИначеЕсли ДанныеУпаковки.Свойство("Коэффициент") Тогда
			ПолученныеДанные.КоличествоУпаковок = 1;
			ПолученныеДанные.КоличествоБазовойЕдиницыИзмерения = ДанныеУпаковки.Коэффициент;	
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеУпаковки.ЕдиницаИзмерения) Тогда
			ПравилаЗаполнения = Новый Соответствие;
			ПравилаЗаполнения.Вставить("Код", "КодОКЕИБазовойЕдиницыИзмерения");
			ПравилаЗаполнения.Вставить("Наименование", "НаименованиеБазовойЕдиницыИзмерения");
			ДанныеЕдиницыИзмерения = ДанныеКоллекцииВВидеСтруктуры(ДанныеУпаковки.ЕдиницаИзмерения, ПравилаЗаполнения);

			ЗаполнитьЗначенияСвойств(ПолученныеДанные, ДанныеЕдиницыИзмерения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

