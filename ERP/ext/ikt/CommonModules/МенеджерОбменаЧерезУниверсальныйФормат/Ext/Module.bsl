		НоваяСтрокаЗарплата.КВыплате = ДанныеXDTO.СуммаДокумента;
		
		НоваяСтрокаСостав = ПолученныеДанные.Состав.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаСостав, НоваяСтрокаЗарплата); 
		
		НоваяСтрокаФизическиеЛица = ПолученныеДанные.ФизическиеЛица.Добавить();
		НоваяСтрокаФизическиеЛица.ФизическоеЛицо = СотрудникУУ.ФизическоеЛицо;
		
	Иначе 
		
		Если ДанныеXDTO.Свойство("Зарплата", ЗарплатаXDTO)
