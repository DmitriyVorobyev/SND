Процедура ДобавитьПОД_Справочник_ГрафикРаботыСотрудников_Получение(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_ГрафикРаботыСотрудников_Получение";
	ПравилоОбработки.ОбъектВыборкиФормат     = "Справочник.ГрафикРаботыСотрудников"; //@NON-NLS-1
	ПравилоОбработки.ПриОбработке            = "ПОД_Справочник_ГрафикРаботыСотрудников_Получение_ПриОбработке";
