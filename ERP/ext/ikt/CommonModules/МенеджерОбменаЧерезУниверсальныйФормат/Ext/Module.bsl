//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
Процедура ПКО_Документ_ВедомостьВКассу_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	ПолученныеДанные.Проведен = Истина;
	
	ЗарплатаXDTO = Неопределено;
	ПравилоКонвертацииФизическиеЛица = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ФизическиеЛица_Получение"); 
	ПравилоКонвертацииСотрудники = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Сотрудники_Получение");
	
	ПолученныеДанные.Зарплата.Очистить();
	ПолученныеДанные.Состав.Очистить();
	ПолученныеДанные.ФизическиеЛица.Очистить(); 
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ДанныеXDTO.AdditionalInfo.Свойство("ЭтоУУ") Тогда  
		ИспользоватьЕдиногоСотрудникаУУВВедомостях = ИКТ_ДополнительныеНастройкиСистемы.ПолучитьЗначение("ИспользоватьЕдиногоСотрудникаУУВВедомостях"); 
		ЭтоУУ = ДанныеXDTO.AdditionalInfo.ЭтоУУ И ИспользоватьЕдиногоСотрудникаУУВВедомостях;
	Иначе 
		ЭтоУУ = Ложь;
	КонецЕсли;
	
	Если ЭтоУУ Тогда 
		
		СотрудникУУ = ИКТ_ДополнительныеНастройкиСистемы.ПолучитьЗначение("СотрудникУУ");
		
		НоваяСтрокаЗарплата = ПолученныеДанные.Зарплата.Добавить();
		НоваяСтрокаЗарплата.Сотрудник = СотрудникУУ;
		НоваяСтрокаЗарплата.ФизическоеЛицо = СотрудникУУ.ФизическоеЛицо; 
