&После("ПОД_Документ_ВедомостьНаВыплатуЗарплаты_Получение_ПриОбработке")
Процедура ИКТ_ПОД_Документ_ВедомостьНаВыплатуЗарплаты_Получение_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	
	Если ТипЗнч(ДанныеXDTO.СпособВыплаты) = Тип("Структура") 
		И ДанныеXDTO.СпособВыплаты.Значение = "ЧерезКассу" Тогда 
		ИспользованиеПКО["Документ_ВедомостьВКассу_Получение"] = Истина; 
		ИспользованиеПКО["Документ_ВедомостьВБанк_Получение"] = Ложь;
	ИначеЕсли ТипЗнч(ДанныеXDTO.СпособВыплаты) = Тип("Структура") 
		И ДанныеXDTO.СпособВыплаты.Значение = "ЧерезБанк" Тогда 
		ИспользованиеПКО["Документ_ВедомостьВКассу_Получение"] = Ложь; 
		ИспользованиеПКО["Документ_ВедомостьВБанк_Получение"] = Истина;
	Иначе 
		ИспользованиеПКО["Документ_ВедомостьВКассу_Получение"] = Ложь; 
		ИспользованиеПКО["Документ_ВедомостьВБанк_Получение"] = Ложь;
	КонецЕсли;

КонецПроцедуры //[+]} ИКТ №16316

