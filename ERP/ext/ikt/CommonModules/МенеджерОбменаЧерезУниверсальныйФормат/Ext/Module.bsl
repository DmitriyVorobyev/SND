Функция РодительТоварНаПродажу()
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	СОКРЛП(ВидыНоменклатуры.Наименование) = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование","Товар на продажу");
	
	Результат = ОбменДаннымиСлужебный.РезультатЗапросаВСтруктуру(Запрос.Выполнить()).Ссылка;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	Иначе
		Возврат Справочники.ВидыНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор("399f784f-4667-11ee-80c6-00155d008615"));
	КонецЕсли;
	
КонецФункции

Функция ГруппаФинансовогоУчетаТовары41()
	
