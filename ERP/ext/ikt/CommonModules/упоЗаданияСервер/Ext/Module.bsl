
&После("ЗаписатьВРегистрСтатусЗадания")
Процедура Расш1_ЗаписатьВРегистрСтатусЗадания(пЗадание, пСтатус, пКомментарий, пАвтор)
	
	//{[+] ИКТ №18794 (фрагмент ДОБАВЛЕН), Новоселов, 17.06.2026 
	Если пЗадание.ЭтоОсновноеЗаданиеПроектнойЗадачи 
		И ТипЗнч(пЗадание.ОбъектБазы) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
	
		ПроектнаяЗадача = пЗадание.ОбъектБазы;
		
		// Определяем статус и процент
		Если пСтатус = Перечисления.упоСтатусыЗаданий.Выдано
			ИЛИ пСтатус = Перечисления.упоСтатусыЗаданий.ИКТ_Запланировано Тогда
			СтатусПЗ  = Перечисления.упоСостояниеСтатусаЗадачи.Запланирована;
			ПроцентПЗ = 0;
		ИначеЕсли пСтатус = Перечисления.упоСтатусыЗаданий.Закрыто Тогда
			СтатусПЗ  = Перечисления.упоСостояниеСтатусаЗадачи.Завершена;
			ПроцентПЗ = 100;
		Иначе
			СтатусПЗ  = Перечисления.упоСостояниеСтатусаЗадачи.Выполняется;
			ПроцентПЗ = 50;
		КонецЕсли;
		
		// Обновляем статусы
		ОбновитьДанныеПроектнойЗадачи(
			ПроектнаяЗадача,
			СтатусПЗ,
			"упоСтатусыПроектныхЗадач",
			"Статусы",
			"СтатусЗадачи",
			"ПерезаписатьСтатусыЗадач");
		
		// Обновляем проценты готовности
		ОбновитьДанныеПроектнойЗадачи(
			ПроектнаяЗадача,
			ПроцентПЗ,
			"упоПроцентыГотовностиПроектныхЗадач",
			"ПроцентыГотовности",
			"ПроцентГотовности",
			"ПерезаписатьПроцентГотовности");
			
		Если пСтатус = Перечисления.упоСтатусыЗаданий.Закрыто Тогда	
			ВыдатьСледующееЗадание(ПроектнаяЗадача);
		//{[+] ИКТ №20184 (фрагмент ДОБАВЛЕН), Новоселов, 20.07.2026 
		ИначеЕсли пСтатус = Перечисления.упоСтатусыЗаданий.Выдано Тогда
			ДобавитьОповещения(пЗадание);
		//[+]} ИКТ №20184
		КонецЕсли;
		
	КонецЕсли;
	//[+]} ИКТ №18794
	
КонецПроцедуры

//{[+] ИКТ №18794 (фрагмент ДОБАВЛЕН), Новоселов, 17.06.2026 
Процедура ОбновитьДанныеПроектнойЗадачи(ПроектнаяЗадача, ЗначениеПЗ, ИмяРегистра, ИмяТЧ, ИмяПоляТЧ, ИмяФлага)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Регистр.Регистратор КАК Ссылка
		|ИЗ
		|	РегистрСведений." + ИмяРегистра + " КАК Регистр
		|ГДЕ
		|	Регистр.ПроектнаяЗадача = &ПроектнаяЗадача
		|
		|УПОРЯДОЧИТЬ ПО
		|	Регистр.Период УБЫВ");
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Ссылка) = Тип("ДокументСсылка.упоСохранениеДанныхПроекта") Тогда
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если НЕ ДокументОбъект[ИмяФлага] Тогда
				ДокументОбъект[ИмяФлага] = Истина;
			КонецЕсли;
			
			// Обновляем табличную часть документа
			СтруктураОтбора = Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача);
			МассивСтрок = ДокументОбъект[ИмяТЧ].НайтиСтроки(СтруктураОтбора);
			
			Если МассивСтрок.Количество() = 0 Тогда
				НоваяСтрока = ДокументОбъект[ИмяТЧ].Добавить();
				НоваяСтрока.ПроектнаяЗадача = ПроектнаяЗадача;
				НоваяСтрока[ИмяПоляТЧ] = ЗначениеПЗ;
			КонецЕсли;
			
			Для каждого СтрокаМассива Из МассивСтрок Цикл
				СтрокаМассива[ИмяПоляТЧ] = ЗначениеПЗ;
			КонецЦикла;
		Иначе
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не определен регистратор для автоматической установки статусов задач: %1'", Выборка.Ссылка)));
		КонецЕсли;
			
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		// Обновляем записи регистра сведений
		НаборЗаписей = Вычислить("РегистрыСведений." + ИмяРегистра + ".СоздатьНаборЗаписей()");;
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка);
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
			Если Запись.ПроектнаяЗадача = ПроектнаяЗадача Тогда
				Запись[ИмяПоляТЧ] = ЗначениеПЗ;
			КонецЕсли;
		КонецЦикла;
		
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыдатьСледующееЗадание(ПроектнаяЗадача)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	упоПроектнаяЗадачаПредусловияЗадачи.Ссылка КАК СледующаяЗадача
		|ПОМЕСТИТЬ ВТ_СледующиеПоследовательныеЗадачи
		|ИЗ
		|	Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|ГДЕ
		|	упоПроектнаяЗадачаПредусловияЗадачи.ЗадачаПредшественник = &ПроектнаяЗадача
		|	И упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.ОкончаниеНачало)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СледующиеПоследовательныеЗадачи.СледующаяЗадача КАК СледующаяЗадача,
		|	МАКСИМУМ(упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи <> ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Завершена)) КАК ЕстьНезавершенныеПредшествующиеПоследовательныеЗадачи
		|ПОМЕСТИТЬ ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЗадачи КАК ВТ_СледующиеПоследовательныеЗадачи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|		ПО (упоПроектнаяЗадачаПредусловияЗадачи.Ссылка = ВТ_СледующиеПоследовательныеЗадачи.СледующаяЗадача)
		|			И (упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.ОкончаниеНачало))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК упоСтатусыПроектныхЗадачСрезПоследних
		|		ПО (упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоПроектнаяЗадачаПредусловияЗадачи.ЗадачаПредшественник)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СледующиеПоследовательныеЗадачи.СледующаяЗадача
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче.СледующаяЗадача КАК СледующаяЗадача
		|ПОМЕСТИТЬ ВТ_СледующиеЗадачиГотовыеКВыдаче
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче КАК ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче
		|ГДЕ
		|	НЕ ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче.ЕстьНезавершенныеПредшествующиеПоследовательныеЗадачи
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	упоПроектнаяЗадачаПредусловияЗадачи.Ссылка
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче КАК ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|		ПО (упоПроектнаяЗадачаПредусловияЗадачи.ЗадачаПредшественник = ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче.СледующаяЗадача)
		|			И (упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.НачалоНачало))
		|ГДЕ
		|	НЕ ВТ_СледующиеПоследовательныеЗадачиГотовыеКВыдаче.ЕстьНезавершенныеПредшествующиеПоследовательныеЗадачи
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СледующиеЗадачиГотовыеКВыдаче.СледующаяЗадача КАК СледующаяЗадача,
		|	упоЗадания.Ссылка КАК СледующееЗадание
		|ИЗ
		|	ВТ_СледующиеЗадачиГотовыеКВыдаче КАК ВТ_СледующиеЗадачиГотовыеКВыдаче
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.упоЗадания КАК упоЗадания
		|		ПО ВТ_СледующиеЗадачиГотовыеКВыдаче.СледующаяЗадача = упоЗадания.ОбъектБазы");
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);

	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл			
			Если ТипЗнч(Выборка.СледующееЗадание) = Тип("Null")  // Если у следующей проектной задачи нет задания, то это веха или этап
					И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СледующаяЗадача, "ЭтоМодельПакетаРабот") Тогда  //[+] ИКТ №20758 (строка ДОБАВЛЕНА), Новоселов, 03.09.2026 Может быть так, что у следующих задач нет заданий
	
				ЭтоЭтап = ВыдатьЗаданияСледующихЭтапов(ПроектнаяЗадача);  //[+] ИКТ №18794 (строка ДОБАВЛЕНА), Новоселов, 15.07.2026 У вехи нет дочерних задач, у этапа есть
				Если Не ЭтоЭтап Тогда
					ОбновитьДанныеПроектнойЗадачи(
						Выборка.СледующаяЗадача,
						Перечисления.упоСостояниеСтатусаЗадачи.Завершена,
						"упоСтатусыПроектныхЗадач",
						"Статусы",
						"СтатусЗадачи",
						"ПерезаписатьСтатусыЗадач");
					ОбновитьДанныеПроектнойЗадачи(
						Выборка.СледующаяЗадача,
						100,
						"упоПроцентыГотовностиПроектныхЗадач",
						"ПроцентыГотовности",
						"ПроцентГотовности",
						"ПерезаписатьПроцентГотовности");
						
					ВыдатьСледующееЗадание(Выборка.СледующаяЗадача);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Выборка.СледующееЗадание) <> Тип("Null") Тогда
				ЗаписатьВРегистрСтатусЗадания(Выборка.СледующееЗадание, Перечисления.упоСтатусыЗаданий.Выдано,,);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Успешно = ВыдатьЗаданияСледующихЭтапов(ПроектнаяЗадача.ЗадачаРодитель);  // Если у задачи нет следующих, эта задача последняя в этапе
	КонецЕсли;

КонецПроцедуры

Функция ВыдатьЗаданияСледующихЭтапов(ТекущийЭтап)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	упоПроектнаяЗадача.Ссылка КАК Этап
		|ПОМЕСТИТЬ ВТ_ТекущийЗавершенныйЭтап
		|ИЗ
		|	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК СтатусыПроектныхЗадачСрезПоследних
		|		ПО (СтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоПроектнаяЗадача.Ссылка)
		|			И (СтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Завершена))
		|ГДЕ
		|	упоПроектнаяЗадача.Ссылка = &ТекущийЭтап
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	упоПроектнаяЗадачаПредусловияЗадачи.Ссылка КАК Этап
		|ПОМЕСТИТЬ ВТ_СледующиеПоследовательныеЭтапы
		|ИЗ
		|	ВТ_ТекущийЗавершенныйЭтап КАК ВТ_ТекущийЗавершенныйЭтап
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|		ПО ВТ_ТекущийЗавершенныйЭтап.Этап = упоПроектнаяЗадачаПредусловияЗадачи.ЗадачаПредшественник
		|			И (упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.ОкончаниеНачало))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СледующиеПоследовательныеЭтапы.Этап КАК Этап
		|ПОМЕСТИТЬ ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЭтапы КАК ВТ_СледующиеПоследовательныеЭтапы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|		ПО ВТ_СледующиеПоследовательныеЭтапы.Этап = упоПроектнаяЗадачаПредусловияЗадачи.Ссылка
		|			И (упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.ОкончаниеНачало))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК СтатусыПроектныхЗадачСрезПоследних
		|		ПО (СтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача = ВТ_СледующиеПоследовательныеЭтапы.Этап)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СледующиеПоследовательныеЭтапы.Этап
		|
		|ИМЕЮЩИЕ
		|	НЕ ЕСТЬNULL(МАКСИМУМ(СтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Завершена)), ЛОЖЬ)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту.Этап КАК Этап
		|ПОМЕСТИТЬ ВТ_СледующиеЭтапы
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту КАК ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	упоПроектнаяЗадачаПредусловияЗадачи.Ссылка
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту КАК ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|		ПО ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту.Этап = упоПроектнаяЗадачаПредусловияЗадачи.Ссылка
		|			И (упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.НачалоНачало))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	упоПроектнаяЗадача.Ссылка КАК Задача
		|ПОМЕСТИТЬ ВТ_ЗадачиСледующихЭтаповБезПредусловий
		|ИЗ
		|	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СледующиеЭтапы КАК ВТ_СледующиеЭтапы
		|		ПО (ВТ_СледующиеЭтапы.Этап = упоПроектнаяЗадача.ЗадачаРодитель)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упопроектнаяЗадачаПредусловияЗадачи
		|		ПО (упопроектнаяЗадачаПредусловияЗадачи.Ссылка = упоПроектнаяЗадача.Ссылка)
		|ГДЕ
		|	упопроектнаяЗадачаПредусловияЗадачи.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗадачиСледующихЭтаповБезПредусловий.Задача КАК Задача
		|ПОМЕСТИТЬ ВТ_ЗадачиСледующихЭтаповГотовыеКВыдаче
		|ИЗ
		|	ВТ_ЗадачиСледующихЭтаповБезПредусловий КАК ВТ_ЗадачиСледующихЭтаповБезПредусловий
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	упопроектнаяЗадачаПредусловияЗадачи.ЗадачаПредшественник
		|ИЗ
		|	ВТ_ЗадачиСледующихЭтаповБезПредусловий КАК ВТ_ЗадачиСледующихЭтаповБезПредусловий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упопроектнаяЗадачаПредусловияЗадачи
		|		ПО (упопроектнаяЗадачаПредусловияЗадачи.Ссылка = ВТ_ЗадачиСледующихЭтаповБезПредусловий.Задача)
		|			И (упопроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТИпСвязи.НачалоНачало))
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	упопроектнаяЗадачаПредусловияЗадачи.Ссылка
		|ИЗ
		|	ВТ_ЗадачиСледующихЭтаповБезПредусловий КАК ВТ_ЗадачиСледующихЭтаповБезПредусловий
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упопроектнаяЗадачаПредусловияЗадачи
		|		ПО (упопроектнаяЗадачаПредусловияЗадачи.ЗадачаПредшественник = ВТ_ЗадачиСледующихЭтаповБезПредусловий.Задача)
		|			И (упопроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТИпСвязи.НачалоНачало))
		|
		|ОБЪЕДИНИТЬ
		//{[+] ИКТ №18794 (фрагмент ДОБАВЛЕН), Новоселов, 15.07.2026 Родительский этап завершенной задачи может напрямую идти в следующую задачу, в таком случае задача будет в ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту
		|
		|ВЫБРАТЬ
		|	ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту.Этап
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту КАК ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоЗадания КАК упоЗадания
		|		ПО (упоЗадания.ОбъектБазы = ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту.Этап)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	упоПроектнаяЗадачаПредусловияЗадачи.Ссылка
		|ИЗ
		|	ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту КАК ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача.ПредусловияЗадачи КАК упоПроектнаяЗадачаПредусловияЗадачи
		|		ПО ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту.Этап = упоПроектнаяЗадачаПредусловияЗадачи.Ссылка
		|			И (упоПроектнаяЗадачаПредусловияЗадачи.ТипСвязи = ЗНАЧЕНИЕ(Перечисление.упоТипСвязи.НачалоНачало))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоЗадания КАК упоЗадания
		|		ПО (упоЗадания.ОбъектБазы = ВТ_СледующиеПоследовательныеЭтапыГотовыеКСтарту.Этап)
		//[+]} ИКТ №18794
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗадачиСледующихЭтаповГотовыеКВыдаче.Задача КАК СледующаяЗадача,
		|	упоЗадания.Ссылка КАК СледующееЗадание
		|ИЗ
		|	ВТ_ЗадачиСледующихЭтаповГотовыеКВыдаче КАК ВТ_ЗадачиСледующихЭтаповГотовыеКВыдаче
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.упоЗадания КАК упоЗадания
		|		ПО (упоЗадания.ОбъектБазы = ВТ_ЗадачиСледующихЭтаповГотовыеКВыдаче.Задача)");
	Запрос.УстановитьПараметр("ТекущийЭтап", ТекущийЭтап);
	
	ТекущийЭтоЭтап = Ложь;  //[+] ИКТ №18794 (строка ДОБАВЛЕНА), Новоселов, 15.07.2026
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекущийЭтоЭтап = Истина;		
		Если ТипЗнч(Выборка.СледующееЗадание) = Тип("Null")  // Если у следующей проектной задачи нет задания, то это веха или этап
				И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СледующаяЗадача, "ЭтоМодельПакетаРабот") Тогда  //[+] ИКТ №20758 (строка ДОБАВЛЕНА), Новоселов, 03.09.2026 Может быть так, что у следующих задач нет заданий
				
			ЭтоЭтап = ВыдатьЗаданияСледующихЭтапов(Выборка.СледующаяЗадача);  //[+] ИКТ №18794 (строка ДОБАВЛЕНА), Новоселов, 15.07.2026 У этапов есть дочерние задачи, у вех их нет
			Если Не ЭтоЭтап Тогда
				ОбновитьДанныеПроектнойЗадачи(
					Выборка.СледующаяЗадача,
					Перечисления.упоСостояниеСтатусаЗадачи.Завершена,
					"упоСтатусыПроектныхЗадач",
					"Статусы",
					"СтатусЗадачи",
					"ПерезаписатьСтатусыЗадач");
				ОбновитьДанныеПроектнойЗадачи(
					Выборка.СледующаяЗадача,
					100,
					"упоПроцентыГотовностиПроектныхЗадач",
					"ПроцентыГотовности",
					"ПроцентГотовности",
					"ПерезаписатьПроцентГотовности");
					
				ВыдатьСледующееЗадание(Выборка.СледующаяЗадача);
			КонецЕсли;
				
		ИначеЕсли ТипЗнч(Выборка.СледующееЗадание) <> Тип("Null") Тогда
			ЗаписатьВРегистрСтатусЗадания(Выборка.СледующееЗадание, Перечисления.упоСтатусыЗаданий.Выдано,,);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекущийЭтоЭтап;  //[+] ИКТ №18794 (строка ДОБАВЛЕНА), Новоселов, 15.07.2026 Процедура стала функцией
	
