Процедура ДобавитьОповещения(Ссылка) Экспорт
	
	//{[*] ИКТ №20184 (фрагмент ИЗМЕНЕН), Новоселов, 20.07.2026 Была отправка только исполнителю
	СтатусЗадания = упоЗаданияСервер.ПолучитьСтатусЗадания(Ссылка);
	 
	Если СтатусЗадания = Перечисления.упоСтатусыЗаданий.ИКТ_Запланировано
			Или СтатусЗадания = Перечисления.упоСтатусыЗаданий.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = Новый Структура;
	ЗаполнитьПараметрыОповещения(Параметры, СтатусЗадания = Перечисления.упоСтатусыЗаданий.Выдано);
	
	НедоступныеТранспортыОтправкиОповещений = Новый СписокЗначений;
	НедоступныеТранспортыПроверкаИТС = упоОповещенияВызовСервера.НедоступныеТранспортыОтправкиОповещенийПроверкаИТС();
	НедоступныеТранспортыОтправкиОповещений.ЗагрузитьЗначения(НедоступныеТранспортыПроверкаИТС);
	
	НайденноеЗначение = НедоступныеТранспортыОтправкиОповещений.НайтиПоЗначению(Параметры.Транспорт);
	Если НайденноеЗначение <> Неопределено Тогда
		ШаблонСообщения = НСтр("ru = 'Отправка оповещений через транспорт ""%1"" доступна только при наличии активной подписки ИТС.'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Строка(НайденноеЗначение));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	ОтправлятьОповещениеАвторуИКонтролерам = (СтатусЗадания = Перечисления.упоСтатусыЗаданий.Завершено)
												Или (СтатусЗадания = Перечисления.упоСтатусыЗаданий.Выполняется);
	Запрос = ?(ОтправлятьОповещениеАвторуИКонтролерам, ЗапросПолучателиКураторРПКонтролеры(Ссылка), ЗапросПолучателиИсполнители(Ссылка));	
	//[*]} ИКТ №20184
		
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		ДопПараметры = Новый Структура("СообщениеОбОшибках, Отправить", "", Ложь);
		РезОтправки = упоОповещенияВызовСервера.ДобавитьСообщение(
			Параметры.ВидСобытия, Ссылка, Неопределено, Параметры.ВидПолучателя, Выборка.Получатель, Параметры.Транспорт, ДопПараметры);
		
		Если Не ПустаяСтрока(ДопПараметры.СообщениеОбОшибках) Тогда
			ОбщегоНазначения.СообщитьПользователю(ДопПараметры.СообщениеОбОшибках);
		КонецЕсли;
		
		Если РезОтправки <> Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Сообщение для пользователя %1 было успешно добавлено в очередь.'"), Выборка.Получатель));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//{[+] ИКТ №17652 (фрагмент ДОБАВЛЕН), Новоселов, 04.05.2026
Процедура ЗаполнитьПараметрыОповещения(Параметры, НовоеЗадание)

	Параметры.Вставить("ВидСобытия",	?(НовоеЗадание, Справочники.упоВидыСобытий.НовоеЗадание, Справочники.упоВидыСобытий.НайтиПоНаименованию("Статус задания изменен")));  //[*] ИКТ №20184 (строка ИЗМЕНЕНА), Новоселов, 17.07.2026 Было только новое задание
	Параметры.Вставить("ВидПолучателя",	Справочники.упоВидыПолучателейОповещений.Пользователи);
	Параметры.Вставить("Транспорт",		Справочники.упоТранспортОповещений.Email);
	
	Если Параметры.ВидСобытия = Справочники.упоВидыСобытий.ПустаяСсылка() Тогда
		ОбщегоНазначения.СообщитьПользователю("Письма об изменении статуса не могут быть созданы, т.к. отсутствует соответствующий вид события ""Статус задания изменен"" в справочнике ""Виды событий""!");
	КонецЕсли;

КонецПроцедуры
