//{[+] ИКТ №20758 (фрагмент ДОБАВЛЕН), Новоселов, 08.09.2026 Перенес из ИКТ_ДополнительныеНастройкиСистемы,
// Доработал: присваиваемый статус устанавливался хардкодом, добавил в параметры функции,
// запись в регистр производилась набором записей, исправил на типовую функцию, расширил действие функции аналогично действиям при смене статуса из формы
Процедура УстановитьСтатусЗаданияИзДО(Задание, Статус) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	упоЗаданияСтатусыСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.упоЗаданияСтатусы.СрезПоследних КАК упоЗаданияСтатусыСрезПоследних
		|ГДЕ
		|	упоЗаданияСтатусыСрезПоследних.Задание = &Задание");
	Запрос.УстановитьПараметр("Задание", Задание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Статус = Выборка.Статус Тогда
			Возврат;
		КонецЕсли;
	
		Успешно = упоЗаданияСервер.УстановитьСтатусЗадания(Задание, Статус,, Ложь, Ложь);
		ЗаданиеОбъект = Задание.ПолучитьОбъект();
        Модифицированность = Ложь;
		
		Если Не Успешно Тогда
			Прервать;
		
		КонецЕсли;
		
		Если Задание.ЭтоЗаданиеИсполнителяПроектнойЗадачи 
			И (Статус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Закрыто")
			   Или Статус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Завершено")) Тогда
			   
			ЗаданиеОбъект.ЭтоЗаданиеИсполнителяПроектнойЗадачи = Ложь;
			ЗаданиеОбъект.ЗавершеноЗакрытоВручную = Истина;
			Модифицированность = Истина;
			
		ИначеЕсли Не Задание.ЭтоЗаданиеИсполнителяПроектнойЗадачи И Задание.ЗавершеноЗакрытоВручную
			И (Выборка.Статус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Завершено") 
			   И Статус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Выполняется") 
				Или Выборка.Статус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Закрыто") 
					И Статус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Выдано")) Тогда
			
			ЗаданиеОбъект.ЭтоЗаданиеИсполнителяПроектнойЗадачи = Истина;
			ЗаданиеОбъект.ЗавершеноЗакрытоВручную = Ложь;
			Модифицированность = Истина;		
			
		КонецЕсли;
			
		Если Модифицированность Тогда
			Попытка
				ЗаданиеОбъект.Записать();
			Исключение				
				ЗаписьЖурналаРегистрации(
					"Данные.Изменение",
					УровеньЖурналаРегистрации.Ошибка,
					Справочники.упоЗадания.Метаданные(),
					ЗаданиеОбъект,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;			
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
