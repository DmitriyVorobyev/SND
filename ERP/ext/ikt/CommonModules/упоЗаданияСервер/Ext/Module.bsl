//{[+] ИКТ №20184 (фрагмент ДОБАВЛЕН), Новоселов, 17.07.2026 
Функция ЗапросПолучателиИсполнители(Ссылка)
 	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Получатель
		|ИЗ
		|	Справочник.упоЗадания КАК упоЗадания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО упоЗадания.Исполнитель = Пользователи.упоОсновнойТрудовойРесурс
		|ГДЕ
		|	упоЗадания.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос;
	
КонецФункции

Функция ЗапросПолучателиКураторРПКонтролеры(Ссылка)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Данные.РуководительПроекта КАК Сотрудник
		|ПОМЕСТИТЬ ВТ_Контролеры
		|ИЗ
		|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(, Проект = &Проект) КАК Данные
		|
		|ОБЪЕДИНИТЬ
		|
		//|ВЫБРАТЬ
		//|	Данные.КураторПроекта
		//|ИЗ
		//|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(, Проект = &Проект) КАК Данные
		//|
		//|ОБЪЕДИНИТЬ
		//|
		|ВЫБРАТЬ
		|	упоЗаданияКонтролеры.Контролер
		|ИЗ
		|	Справочник.упоЗадания.Контролеры КАК упоЗаданияКонтролеры
		|ГДЕ
		|	упоЗаданияКонтролеры.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	упоДиспетчерыСистемы.Пользователь КАК Получатель
		|ИЗ
		|	ВТ_Контролеры КАК ВТ_Контролеры
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоДиспетчерыСистемы КАК упоДиспетчерыСистемы
		|		ПО ВТ_Контролеры.Сотрудник = упоДиспетчерыСистемы.Сотрудник");
	Запрос.УстановитьПараметр("Проект", Ссылка.Проект);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос;

КонецФункции

Процедура ПроверкаОпозданийПоЗаданиям() Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	упоЗадания.Ссылка КАК Ссылка,
		|	Пользователи.Ссылка КАК Получатель
		|	
		|ИЗ
		|	Справочник.упоЗадания КАК упоЗадания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоЗаданияСтатусы.СрезПоследних КАК упоЗаданияСтатусыСрезПоследних
		|		ПО (упоЗаданияСтатусыСрезПоследних.Задание = упоЗадания.Ссылка
		|			И упоЗаданияСтатусыСрезПоследних.Статус В (ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Выдано), ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Выполняется)))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
		|		ПО (упоСрокиЗаданий.Задание = упоЗадания.Ссылка)
		|			И упоСрокиЗаданий.ДатаОкончанияПлан <= &ТекущаяДата
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО упоЗадания.Исполнитель = Пользователи.упоОсновнойТрудовойРесурс");
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	ДопПараметры = Новый Структура("СообщениеОбОшибках, Отправить", "", Ложь);
	Транспорт = Справочники.упоТранспортОповещений.Email;
	
	НедоступныеТранспортыОтправкиОповещений = Новый СписокЗначений;
	НедоступныеТранспортыПроверкаИТС = упоОповещенияВызовСервера.НедоступныеТранспортыОтправкиОповещенийПроверкаИТС();
	НедоступныеТранспортыОтправкиОповещений.ЗагрузитьЗначения(НедоступныеТранспортыПроверкаИТС);
	
	НайденноеЗначение = НедоступныеТранспортыОтправкиОповещений.НайтиПоЗначению(Транспорт);
	Если НайденноеЗначение <> Неопределено Тогда
		ШаблонСообщения = НСтр("ru = 'Отправка оповещений через транспорт ""%1"" доступна только при наличии активной подписки ИТС.'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Строка(НайденноеЗначение));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВидПолучателя = Справочники.упоВидыПолучателейОповещений.Пользователи;
	ВидСобытия = Справочники.упоВидыСобытий.НайтиПоНаименованию("Задание просрочено");
	
	СписокОшибок = "";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДопПараметры.СообщениеОбОшибках = "";
		РезОтправки = упоОповещенияВызовСервера.ДобавитьСообщение(
			ВидСобытия, Выборка.Ссылка, Неопределено, ВидПолучателя, Выборка.Получатель, Транспорт, ДопПараметры);
		
		Если Не ПустаяСтрока(ДопПараметры.СообщениеОбОшибках) Тогда
			СписокОшибок = СтрШаблон(
				"%1
				|
				|%2",
				СписокОшибок,
				ДопПараметры.СообщениеОбОшибках);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СписокОшибок) Тогда
		ВызватьИсключение(СписокОшибок);
	КонецЕсли;
	
КонецПроцедуры
