Процедура АвтоматическоеФормированиеТабелей() Экспорт
	
	// каждый раз формируем табель по состоянию на вчера
	ДатаАктуальности = ТекущаяДатаСеанса();
	ПериодРегистрации = НачалоМесяца(НачалоДня(ДатаАктуальности) - 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КадроваяИсторияСотрудников.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.КадроваяИсторияСотрудников КАК КадроваяИсторияСотрудников
	|ГДЕ
	|	НЕ КадроваяИсторияСотрудников.ГоловнаяОрганизация.Предопределенный";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		СформироватьТабель(ПериодРегистрации, ДатаАктуальности, Выборка.Организация);
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьТабель(ПериодРегистрации, ДатаАктуальности, Организация)
	
	// найдем табель        
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Табель.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТабельУчетаРабочегоВремени КАК Табель
	|ГДЕ
	|	НЕ Табель.ПометкаУдаления
	|	И Табель.ПериодРегистрации = &ПериодРегистрации
	|	И Табель.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ПериодРегистрации", ПериодРегистрации);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ДанныеОВремени.Очистить();
		ДокументОбъект.ФизическиеЛица.Очистить();
	Иначе   
