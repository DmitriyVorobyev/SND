		ДокументОбъект.Организация = Организация;
		ДокументОбъект.ДатаНачалаПериода = ПериодРегистрации;
		ДокументОбъект.ДатаОкончанияПериода = КонецМесяца(ПериодРегистрации);
		ДокументОбъект.ПериодВводаДанныхОВремени = Перечисления.ПериодыВводаДанныхОВремени.ТекущийМесяц;
		
	КонецЕсли;
	
	ДокументОбъект.Дата = ДатаАктуальности;
	ДокументОбъект.Комментарий = "Создан автоматически (" + ДатаАктуальности + ")";
		
