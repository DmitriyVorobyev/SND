&НаКлиенте
Процедура ПересчитатьПроцентыЭтапаГрафика() 
	
	Если Объект.ЧастичнаяОплата Тогда
		
		Для Каждого Строка Из Объект.ЭтапыГрафикаОплаты Цикл
			
			Строка.ПроцентПлатежа = СколькоПроцентовЧислоОтЧисла(Строка.СуммаПлатежа,Объект.СуммаДокумента); 
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СколькоПроцентовЧислоОтЧисла(Знач Число, Знач ОтЧисла, Знач ОкруглятьДо = 0) Экспорт

   Если ОтЧисла = 0 Тогда
       Возврат 0;
   КонецЕсли;

   Результат = (Число / ОтЧисла) * 100;

   Если ОкруглятьДо > 0 Тогда
       Результат = Окр(Результат, ОкруглятьДо);
   КонецЕсли;

   Возврат Результат;

КонецФункции
