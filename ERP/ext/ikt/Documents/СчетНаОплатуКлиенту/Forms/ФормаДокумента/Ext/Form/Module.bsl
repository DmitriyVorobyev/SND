&НаКлиентеНаСервереБезКонтекста
&ИзменениеИКонтроль("РассчитатьИтоговыеПоказателиСчетаНаОплатуКлиенту")
Процедура Расш1_РассчитатьИтоговыеПоказателиСчетаНаОплатуКлиенту(Форма)

	ПроцентПлатежейОбщий = 0;
	ПредыдущееЗначениеДаты = Дата(1, 1, 1);
	Форма.НомерСтрокиПолнойОплаты = 0;
	Для Каждого ТекСтрока Из Форма.Объект.ЭтапыГрафикаОплаты Цикл
		ПроцентПлатежейОбщий = ПроцентПлатежейОбщий + ТекСтрока.ПроцентПлатежа;
		#Удаление
		ТекСтрока.ПроцентЗаполненНеВерно = (ПроцентПлатежейОбщий > 100);
		#КонецУдаления
		ТекСтрока.ДатаЗаполненаНеВерно = (ПредыдущееЗначениеДаты > ТекСтрока.ДатаПлатежа);
		ПредыдущееЗначениеДаты = ТекСтрока.ДатаПлатежа;
		Если ПроцентПлатежейОбщий = 100 Тогда
			Форма.НомерСтрокиПолнойОплаты = ТекСтрока.НомерСтроки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
//>>ИКТ_Новоселов_20.01.2026_Задача№13500

//{[+] ИКТ №17954 (фрагмент ДОБАВЛЕН), Новоселов, 27.04.2026 Сумма документа рассчитывается по строкам с типом платежа Оплата
&НаСервере
Процедура ПересчитатьСуммуДокумента()
	
	ЕстьСтрокаОплата = Ложь;
	Объект.СуммаДокумента = 0;
	Для каждого Строка Из Объект.ЭтапыГрафикаОплаты Цикл
		Если Строка.ИКТ_ТипПлатежа = Перечисления.ИКТ_ТипПлатежа.Оплата Тогда
			Объект.СуммаДокумента = Объект.СуммаДокумента + Строка.СуммаПлатежа;
			ЕстьСтрокаОплата = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьСтрокаОплата Тогда
		Объект.СуммаДокумента = Объект.ЭтапыГрафикаОплаты.Итог("СуммаПлатежа");
	КонецЕсли;

КонецПроцедуры

