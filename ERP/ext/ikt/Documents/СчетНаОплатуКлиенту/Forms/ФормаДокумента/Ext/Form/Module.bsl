&НаСервере
Процедура ДобавитьЭлементыНаФорму()
		
	НовыйЭлемент = Элементы.Вставить("ИКТ_РасшифровкаПлатежа", Тип("ПолеФормы"), Элементы.ЭтапыГрафикаОплаты, Элементы.ЭтапыГрафикаОплатыСуммаПлатежа); 
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ЭтапыГрафикаОплаты.ИКТ_РасшифровкаПлатежа";
	
	СписокВыбора = НовыйЭлемент.СписокВыбора;
	СписокВыбора.Добавить("ПроизвольныйТекст","Произвольный текст");
	СписокВыбора.Добавить("ГарантийноеУдержание","Гарантийное удержание");
	СписокВыбора.Добавить("УдержаниеАванса","Удержание аванса");
	СписокВыбора.Добавить("УдержаниеАвансаЗаМатериалы","Удержание аванса за материалы");
	СписокВыбора.Добавить("УдержаниеАвансаЗаРаботы","Удержание аванса за работы");
	СписокВыбора.Добавить("ОплатаВыполненныхРабот","Оплата выполненных работ"); 
    
	НовыйЭлемент.УстановитьДействие("ОбработкаВыбора","ЭтапыГрафикаОплатыСуммаПлатежаОбработкаВыбора");
	
	//<<ИКТ_Новоселов_21.01.2026_Задача№13500 Добавил элемент Тип платежа в ТЧ ЭтапыОплаты
	НовыйЭлемент = Элементы.Вставить("ИКТ_ТипПлатежа", Тип("ПолеФормы"), Элементы.ЭтапыГрафикаОплаты, Элементы.ИКТ_РасшифровкаПлатежа); 
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ЭтапыГрафикаОплаты.ИКТ_ТипПлатежа";
	НовыйЭлемент.Заголовок = "Тип платежа";
	//>>ИКТ_Новоселов_21.01.2026_Задача№13500
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапыГрафикаОплатыСуммаПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)  
	
	ВыбранноеЗначение = ЭтапыГрафикаОплатыСуммаПлатежаОбработкаВыбораНаСервере(ВыбранноеЗначение,Объект.ДокументОснование,Объект.Договор);
		
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЭтапыГрафикаОплатыСуммаПлатежаОбработкаВыбораНаСервере(ВыбранноеЗначение,ДокументОснование,Договор)
	
	НовоеВыбранноеЗначение = "";
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Договор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование,"Договор"); 
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		Договор = Договор;
	Иначе
		Возврат НовоеВыбранноеЗначение;	
	КонецЕсли;	
		
	Если ВыбранноеЗначение = "ПроизвольныйТекст" Тогда
		НовоеВыбранноеЗначение = "";
	ИначеЕсли ВыбранноеЗначение = "ГарантийноеУдержание" Тогда 
		НовоеВыбранноеЗначение = "Гарантийное удержание по договору " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор,"Наименование"); //<=ИКТ_Новоселов_05.02.2026_Задача№13500 Исправлено с "Гарантийный платеж ..."		
	ИначеЕсли ВыбранноеЗначение = "УдержаниеАвансаЗаМатериалы" Тогда
		НовоеВыбранноеЗначение = "Удержание авансового платежа за материалы по договору " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор,"Наименование"); //ИКТ_Пузырев, №12426, Исправил опечатку_17.10.2025
	ИначеЕсли ВыбранноеЗначение = "УдержаниеАвансаЗаРаботы" Тогда
		НовоеВыбранноеЗначение = "Удержание авансового платежа за работы по договору " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор,"Наименование");
	ИначеЕсли ВыбранноеЗначение = "ОплатаВыполненныхРабот" Тогда
		НовоеВыбранноеЗначение = "Оплата за выполнение строительно-монтажных работ по договору " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор,"Наименование");
	ИначеЕсли ВыбранноеЗначение = "УдержаниеАванса" Тогда
		НовоеВыбранноеЗначение = "Удержание авансового платежа по договору " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор,"Наименование");	
	КонецЕсли;
	
	Возврат НовоеВыбранноеЗначение; 
	
КонецФункции

