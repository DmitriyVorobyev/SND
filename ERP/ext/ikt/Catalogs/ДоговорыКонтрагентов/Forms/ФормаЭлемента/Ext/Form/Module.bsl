&НаСервере
Процедура ДобавитьИзменитьРеквизиты()
	
	//{[+] ИКТ №20876 (фрагмент ДОБАВЛЕН), Новоселов, 13.08.2026 
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("ИКТ_Проект", Тип("ПолеФормы"), Элементы.СтраницаОсновное);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ИКТ_Проект";
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "ИКТ_ПроектНачалоВыбора");
	//[+]} ИКТ №20876
	
КонецПроцедуры

