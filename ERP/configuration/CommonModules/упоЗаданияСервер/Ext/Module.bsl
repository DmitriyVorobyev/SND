КонецФункции

Процедура ДобавитьКнопкуИзменитьСтатус(ИмяСтраницы, 
									ТекущийСтатус, 
									Роль, 
									СтрокаДоступныйСтатус, 
									СтруктураПараметров, 
									КнопкиЗакрытия)
	
	Элементы = СтруктураПараметров.Форма.Элементы;
	
	СтраницаДоступныеСтатусы = Элементы.Найти(ИмяСтраницы);
	Если СтраницаДоступныеСтатусы = Неопределено Тогда
		
		СтраницаДоступныеСтатусы = Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), Элементы.ГруппаИзменитьСтатус);
		СтраницаДоступныеСтатусы.Вид = ВидГруппыФормы.Страница;
		НоваяСтрока = СтруктураПараметров.ТаблицаСтраницыДоступныхСтатусов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДоступныйСтатус);
		НоваяСтрока.Роль = Роль;
		НоваяСтрока.ТекущийСтатусСсылка = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий." + ТекущийСтатус);
		НоваяСтрока.ВидЗаданияСсылка = 
			ПредопределенноеЗначение("Справочник.упоВидыЗаданий." + СтрокаДоступныйСтатус.ВидЗадания);
		НоваяСтрока.ИмяСтраницы = ИмяСтраницы;	
		
		ПолеКомментарий = Элементы.Добавить(ИмяСтраницы + "ПолеКомментарий", Тип("ПолеФормы"), СтраницаДоступныеСтатусы);
		ЗаполнитьЗначенияСвойств(ПолеКомментарий, Элементы.ПолеКомментария, , "ВыделенныйТекст");	
		ПолеКомментарий.УстановитьДействие("ПриИзменении", "ПолеКомментарияПриИзменении");
		ПолеКомментарий.УстановитьДействие("АвтоПодбор", "ПолеКомментарияАвтоПодбор");
		
		ДобавитьЭлемент_КоманднаяПанель(Элементы, ИмяСтраницы + "ГруппаКнопок", СтраницаДоступныеСтатусы);
		
	КонецЕсли;	
			
	ИмяНовогоЭлемент = СтрЗаменить(ИмяСтраницы, "Страница", "Кнопка") + СтрокаДоступныйСтатус.НовыйСтатус;
	
	Если Элементы.Найти(ИмяНовогоЭлемент) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЭлементГруппаКнопокСтатусы = ГруппаРядаКнопок(Элементы, ИмяСтраницы, СтраницаДоступныеСтатусы, КнопкиЗакрытия);
	
	Если КнопкиЗакрытия Тогда
			
		ГруппаКнопокИзменитьСтатус = Элементы.Добавить(ИмяНовогоЭлемент + "Группа", 
			Тип("ГруппаФормы"), 
			ЭлементГруппаКнопокСтатусы);
		ГруппаКнопокИзменитьСтатус.Вид = ВидГруппыФормы.ГруппаКнопок;
		ГруппаКнопокИзменитьСтатус.Отображение = ОтображениеГруппыКнопок.Компактное;
		
		ГруппаОсновнойКнопкиЛево = ГруппаКнопокИзменитьСтатус;
		ГруппаОсновнойКнопкиПраво = ГруппаКнопокИзменитьСтатус;
		
	Иначе
		
		ГруппаОсновнойКнопкиЛево = ЭлементГруппаКнопокСтатусы;
		ГруппаОсновнойКнопкиПраво = ЭлементГруппаКнопокСтатусы;
		
	КонецЕсли;	
	
	КнопкаИзменитьСтатус = Элементы.Добавить(ИмяНовогоЭлемент, Тип("КнопкаФормы"), ГруппаОсновнойКнопкиПраво);
	КнопкаИзменитьСтатус.Заголовок = СтрокаДоступныйСтатус.ЗаголовокКоманды;       	
	КнопкаИзменитьСтатус.ИмяКоманды = СтрокаДоступныйСтатус.НовыйСтатус;
	ЦветСтатуса =  СтруктураПараметров.ЦветаСтатусов.Получить(СтрокаДоступныйСтатус.НовыйСтатус);
	Если ЦветСтатуса <> Неопределено Тогда
		КнопкаИзменитьСтатус.ЦветФона = ЦветСтатуса;
	КонецЕсли;
	   
	Если КнопкиЗакрытия Тогда				
		КнопкаИзменитьСтатусИЗакрыть = Элементы.Добавить(ИмяНовогоЭлемент + "ИЗакрыть", 
			Тип("КнопкаФормы"), 
			ГруппаОсновнойКнопкиЛево);
		КнопкаИзменитьСтатусИЗакрыть.Заголовок = НСтр("ru = 'Х'");       	
		КнопкаИзменитьСтатусИЗакрыть.ИмяКоманды = СтрокаДоступныйСтатус.НовыйСтатус + "ИЗакрыть";
		КнопкаИзменитьСтатусИЗакрыть.ЦветФона = КнопкаИзменитьСтатус.ЦветФона;
		КнопкаИзменитьСтатусИЗакрыть.Картинка = БиблиотекаКартинок.Закрыть;
		КнопкаИзменитьСтатусИЗакрыть.Отображение = ОтображениеКнопки.Картинка;
	КонецЕсли;		
	
КонецПроцедуры

// Возвращает группу кнопок, на которой будут размещаться кнопки управления статусом задания. 
// При необходимости создает второй ряд кнопок. Второй ряд кнопок создается только для элемента справочника Задания.
// Для обработки Работа с заданиями второй ряд не создается, т.к. в обработке нет кнопок закрытия 
// (кнопки размещаются более компактно), но при этом есть управления группами выделенных заданий, 
// когда в панели кнопок регулируется видимость уже размещенных в панелях кнопок - 
// в этом случае получаются некрасивые комбинации при первоначальном размещении кнопок в два ряда.
//
// Параметры:
//  Элементы			 - ЭлементыФормы - элементы формы. 
//  ИмяСтраницы			 - Строка - имя страницы, на которой размещяется группа кнопок.
//  ЭлементРодитель		 - ГруппаФормы - элемент - родитель.
//  ДобавлятьВторойРяд	 - Булево - признак необходимости добавления второго ряда.
// 
// Возвращаемое значение:
//   - ЭлементФормы
//
Функция ГруппаРядаКнопок(Элементы, ИмяСтраницы, ЭлементРодитель, ДобавлятьВторойРяд = Ложь)
	
	СуффиксРядКнопок = "";
	
	ИмяГруппаКнопокПервыйРяд = ИмяСтраницы + "ГруппаКнопок";
	
	Если ДобавлятьВторойРяд Тогда
		МаксКоличествоКнопокВРяду = 2;	
		КоличествоПодчиненных = Элементы[ИмяГруппаКнопокПервыйРяд].ПодчиненныеЭлементы.Количество();
		
		Если КоличествоПодчиненных >= МаксКоличествоКнопокВРяду Тогда				
														
			СуффиксРядКнопок = "ВторойРяд";
			
			ДобавитьЭлемент_КоманднаяПанель(Элементы, ИмяГруппаКнопокПервыйРяд + СуффиксРядКнопок, ЭлементРодитель);
			
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Элементы[ИмяГруппаКнопокПервыйРяд + СуффиксРядКнопок];
	
КонецФункции	

Процедура ДобавитьЭлемент_КоманднаяПанель(Элементы, Имя, ЭлементРодитель)
	
	Если Элементы.Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ДоступныеСтатусыГруппаКнопок = Элементы.Добавить(Имя, Тип("ГруппаФормы"), ЭлементРодитель);
	ДоступныеСтатусыГруппаКнопок.Вид 						= ВидГруппыФормы.КоманднаяПанель;
	ДоступныеСтатусыГруппаКнопок.ГоризонтальноеПоложение 	= ГоризонтальноеПоложениеЭлемента.Право;
	
КонецПроцедуры	

