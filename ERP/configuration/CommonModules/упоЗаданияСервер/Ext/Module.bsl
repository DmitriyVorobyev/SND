#Область ПрограммныйИнтерфейс

// Проверяет возможность изменения статуса у Задания.
//
// Параметры:
//  Задание			 - СправочникСсылка.упоЗадания		 - Задание.
//  ТекущийСтатус	 - ПеречислениеСсылка.упоСтатусыЗаданий
//  Статус			 - ПеречислениеСсылка.упоСтатусыЗаданий	 - новый статус.
//  ТекущийСотрудник - СправочникСсылка.упоСотрудники
//  Исполнитель		 - СправочникСсылка.упоТрудовыеРесурсы	 - трудовой ресурс.
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ВозможностьИзмененияСтатуса(Задание, ТекущийСтатус, Статус, ТекущийСотрудник, Исполнитель) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Задание.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование")
		И Задание.ЭтоСогласованиеРодитель Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	СтатусДоступен = Ложь;
	
	ТаблицаДоступныхСтатусов = ПолучитьТаблицуДоступныхСтатусов();
	
	ТаблицаДоступныхСтатусов.Колонки.Добавить("ТекущийСтатусСсылка");
	ТаблицаДоступныхСтатусов.Колонки.Добавить("НовыйСтатусСсылка");
	ТаблицаДоступныхСтатусов.Колонки.Добавить("ВидЗаданияСсылка");
	
	Для Каждого СтрокаДоступныйСтатус Из ТаблицаДоступныхСтатусов Цикл
		
		Если СтрокаДоступныйСтатус.ТекущийСтатус = "" Тогда
			СтрокаДоступныйСтатус.ТекущийСтатусСсылка = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.ПустаяСсылка");
		Иначе	
			СтрокаДоступныйСтатус.ТекущийСтатусСсылка = 
				ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий." + СтрокаДоступныйСтатус.ТекущийСтатус);
		КонецЕсли;	
		СтрокаДоступныйСтатус.НовыйСтатусСсылка = 
			ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий." + СтрокаДоступныйСтатус.НовыйСтатус);
		СтрокаДоступныйСтатус.ВидЗаданияСсылка = 
			ПредопределенноеЗначение("Справочник.упоВидыЗаданий." + СтрокаДоступныйСтатус.ВидЗадания);
		
	КонецЦикла;
		
	СтруктураРолей = ПолучитьСтруктуруРолей(Задание, ТекущийСотрудник, Задание.ПроектнаяЗадача, Исполнитель); 
	
	Отбор = Новый Структура; 
	Отбор.Вставить("ТекущийСтатусСсылка", ТекущийСтатус);
	Отбор.Вставить("НовыйСтатусСсылка", Статус);
	Отбор.Вставить("ВидЗаданияСсылка", Задание.ВидЗадания);
	
	СтатусДоступен = НайтиДоступныеСтатусыДляРолей(Отбор, СтруктураРолей, ТаблицаДоступныхСтатусов);
	
	Если НЕ СтатусДоступен Тогда
		Отбор.Вставить("ТекущийСтатусСсылка", ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.ПустаяСсылка"));
		СтатусДоступен = НайтиДоступныеСтатусыДляРолей(Отбор, СтруктураРолей, ТаблицаДоступныхСтатусов);
	КонецЕсли;
	
	Если НЕ СтатусДоступен Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Изменение статуса на ""%1"" недоступно! Текущий статус задания: ""%2"".'"), 
			Статус, ТекущийСтатус);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
	Возврат СтатусДоступен;
	
КонецФункции

// Процедура устанавливает статус Задания.
//
// Параметры:
//  Задание								 - СправочникСсылка.упоЗадания
//  НовыйСтатус							 - ПеречислениеСсылка.упоСтатусыЗаданий	 - новый статус.
//  Комментарий							 - Строка
//  ПроверятьВозможность				 - Булево
//  ПроверкаНаЭтоЗаданиеИсполнителяПЗ	 - Булево
// 
// Возвращаемое значение:
//  Булево - результат выполнения Успешно/Не успешно.
//
Функция УстановитьСтатусЗадания(Задание, НовыйСтатус, Комментарий = "", ПроверятьВозможность = Истина,
								ПроверкаНаЭтоЗаданиеИсполнителяПЗ = Истина) Экспорт

	Успешно = Ложь;
	
	НачатьТранзакцию();
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.упоЗаданияСтатусы");
	ЭлементБлокировки.УстановитьЗначение("Задание", Задание);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	
	ТекущийСотрудник = ПараметрыСеанса.упоТекущийСотрудник;
	ТекущийСтатус = упоЗаданияСервер.ПолучитьСтатусЗадания(Задание);
	ДанныеЗадания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Задание,
			"Исполнитель, ЭтоСогласованиеРодитель, ВидЗадания, Родитель, ЭтоЗаданиеИсполнителяПроектнойЗадачи, ЗавершеноЗакрытоВручную");
	
	Если ПроверятьВозможность И
		Не упоЗаданияСервер.ВозможностьИзмененияСтатуса(Задание,
			ТекущийСтатус,
			НовыйСтатус,
			ТекущийСотрудник,
			ДанныеЗадания.Исполнитель) Тогда
		
		ОтменитьТранзакцию();
		Возврат Успешно;
		
	КонецЕсли;
	
	Если ПроверкаНаЭтоЗаданиеИсполнителяПЗ Тогда
		
		Если ДанныеЗадания.ЭтоЗаданиеИсполнителяПроектнойЗадачи Тогда
			
			Если НовыйСтатус = Перечисления.упоСтатусыЗаданий.Закрыто Или НовыйСтатус = Перечисления.упоСтатусыЗаданий.Завершено Тогда
				УстановитьЗначенияРеквизитовЗадания(Задание, Ложь, Истина);
			КонецЕсли;
			
		Иначе
			
			Если ДанныеЗадания.ЗавершеноЗакрытоВручную
				И (ТекущийСтатус = Перечисления.упоСтатусыЗаданий.Завершено И НовыйСтатус = Перечисления.упоСтатусыЗаданий.Выполняется
					Или ТекущийСтатус = Перечисления.упоСтатусыЗаданий.Закрыто И НовыйСтатус = Перечисления.упоСтатусыЗаданий.Выдано) Тогда
				
				УстановитьЗначенияРеквизитовЗадания(Задание, Истина, Ложь);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	упоЗаданияСервер.ЗаписатьВРегистрСтатусЗадания(Задание, НовыйСтатус, Комментарий);
	
	Если ДанныеЗадания.ВидЗадания = Справочники.упоВидыЗаданий.Согласование
		И Не ДанныеЗадания.ЭтоСогласованиеРодитель Тогда
		
		упоЗаданияСервер.ЗаписатьРезультатВСогласованиеРодитель(ДанныеЗадания.Родитель, Задание);
		
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	Успешно = Истина;
	
	Возврат Успешно;
	
КонецФункции

// Записывает в регистр статус задания.
//
// Параметры:
//  пЗадание	 - СправочникСсылка.упоЗадания			- Задание.
//  пСтатус		 - ПеречислениеСсылка.упоСтатусыЗаданий - текущий статус.
//  пКомментарий - Строка - комментарий. 
//	пАвтор		 - СправочникСсылка.упоСотрудники - Автор изменения статуса.
//
Процедура ЗаписатьВРегистрСтатусЗадания(пЗадание, пСтатус, пКомментарий = "", пАвтор = Неопределено) Экспорт
	
	Если пСтатус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаНовогоСтатуса = ТекущаяДатаСеанса();
	
	статусыЗадания = РегистрыСведений.упоЗаданияСтатусы.СоздатьНаборЗаписей();
	статусыЗадания.Отбор.Задание.Установить(пЗадание);
	статусыЗадания.Отбор.Период.Установить(ДатаНовогоСтатуса);
	
	новСтрока = статусыЗадания.Добавить();
	новСтрока.Период = ДатаНовогоСтатуса;
	новСтрока.Задание = пЗадание;
	новСтрока.Статус = пСтатус;
	
	Попытка
		статусыЗадания.Записать(Ложь);
	Исключение
		Если ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОшибкаЗаписиЗадания", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.упоЗадания, пЗадание, ПредставлениеОшибки);
		ТекстСообщения = НСтр("ru = 'Произошла ошибка записи статуса. Подробнее см. журнал регистрации.'");
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
	Если пСтатус = Перечисления.упоСтатусыЗаданий.Закрыто 
		Или пСтатус = Перечисления.упоСтатусыЗаданий.Отменено Тогда
		
		упоЗаданияСервер.УдалитьЗаданиеИзВсехОчередей(пЗадание);
		
	КонецЕсли;
	
	Комментарий = Строка(пКомментарий) + 
		?(ПустаяСтрока(пКомментарий), "", "<hr>") + "Статус Задания изменен на """ + Строка(пСтатус) + """";
		
	ПараметрыЗаписи	= ПолучитьСтруктуруПараметровЗаписиКомментыЗаданий(пЗадание, пСтатус, Комментарий, пКомментарий, пАвтор);
		
	ДобавитьЗаписьВРегистрКомментыЗаданий(ПараметрыЗаписи);
	
	упоИнтеграцияПереопределяемый.ПослеЗаписи_СтатусКомментарийЗадания(пЗадание, пСтатус, пКомментарий);
	
КонецПроцедуры

