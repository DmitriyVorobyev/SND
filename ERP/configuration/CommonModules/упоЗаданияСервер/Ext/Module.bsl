Функция НайтиДоступныеСтатусыДляРолей(Отбор, СтруктураРолей, ТаблицаДоступныхСтатусов)

	СтатусДоступен = Ложь;
	
	Если СтруктураРолей.ЯАвтор Тогда
		Отбор.Вставить("Роль", "Автор");
		НайденныеСтроки = ТаблицаДоступныхСтатусов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			СтатусДоступен = Истина;
			Возврат СтатусДоступен;
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураРолей.ЯИсполнитель Тогда
		Отбор.Вставить("Роль", "Исполнитель");
		НайденныеСтроки = ТаблицаДоступныхСтатусов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			СтатусДоступен = Истина;
			Возврат СтатусДоступен;
		КонецЕсли;
	КонецЕсли;

	Возврат СтатусДоступен;

КонецФункции

Процедура УстановитьЗначенияРеквизитовЗадания(Задание, ЭтоЗаданиеИсполнителяПроектнойЗадачи, ЗавершеноЗакрытоВручную)
	
	ЗаданиеОбъект = Задание.ПолучитьОбъект();
	ЗаданиеОбъект.ЭтоЗаданиеИсполнителяПроектнойЗадачи = ЭтоЗаданиеИсполнителяПроектнойЗадачи;
	ЗаданиеОбъект.ЗавершеноЗакрытоВручную = ЗавершеноЗакрытоВручную;
	ЗаданиеОбъект.Записать();
	
КонецПроцедуры

// Получает структуру ролей.
//
// Параметры:
//  Задание			 - СправочникСсылка.упоЗадания	 - задание.
//  Исполнитель		 - СправочникСсылка.упоТрудовыеРесурсы	- трудовой ресурс.
//  ТрудовыеРесурсыСотрудника	 - Массив СправочникСсылка.упоТрудовыеРесурсы	- трудовые ресурсы сотрудника.
//
// Возвращаемое значение:
//  Структура - структура ролей.
//
Функция ПолучитьСтруктуруРолейПоЗаданию(Задание, Исполнитель, ТрудовыеРесурсыСотрудника)
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("ЯИсполнитель", 	Ложь);
	РезультатФункции.Вставить("ЯКонтролер", 	Ложь);
	РезультатФункции.Вставить("ЯАвтор", 		Задание.Пустая());

	Если Не ЗначениеЗаполнено(Задание) Тогда
		Возврат РезультатФункции;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокТрудовыхРесурсовПользователя", ТрудовыеРесурсыСотрудника);
	Запрос.УстановитьПараметр("ТекСотрудник", ПараметрыСеанса.упоТекущийСотрудник);
	Запрос.УстановитьПараметр("Задание", Задание);
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(упоКонтролерыЗаданий.Контролер) КАК Контролер,
		|	упоКонтролерыЗаданий.Ссылка КАК Задание
		|ПОМЕСТИТЬ КоличествоКонтролеровЗадания
		|ИЗ
		|	Справочник.упоЗадания.Контролеры КАК упоКонтролерыЗаданий
		|ГДЕ
		|	упоКонтролерыЗаданий.Ссылка = &Задание
		|	И упоКонтролерыЗаданий.Контролер = &ТекСотрудник
		|
		|СГРУППИРОВАТЬ ПО
		|	упоКонтролерыЗаданий.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СправочникупоЗадания.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА &Исполнитель = НЕОПРЕДЕЛЕНО
		|				И СправочникупоЗадания.Исполнитель В (&СписокТрудовыхРесурсовПользователя)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ВЫБОР
		|				КОГДА &Исполнитель В (&СписокТрудовыхРесурсовПользователя)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|	КОНЕЦ КАК ЯИсполнитель,
		|	ВЫБОР
		|		КОГДА СправочникупоЗадания.АвторСотрудник = &ТекСотрудник
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЯАвтор
		|ПОМЕСТИТЬ АвторИсполнительЗадания
		|ИЗ
		|	Справочник.упоЗадания КАК СправочникупоЗадания
		|ГДЕ
		|	СправочникупоЗадания.Ссылка = &Задание
		|	И НЕ СправочникупоЗадания.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЕСТЬNULL(АвторИсполнительЗадания.ЯИсполнитель, ЛОЖЬ) КАК ЯИсполнитель,
		|	ЕСТЬNULL(АвторИсполнительЗадания.ЯАвтор, ЛОЖЬ) КАК ЯАвтор,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(КоличествоКонтролеровЗадания.Контролер, 0) = 0
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЯКонтролер
		|ИЗ
		|	АвторИсполнительЗадания КАК АвторИсполнительЗадания
		|		ПОЛНОЕ СОЕДИНЕНИЕ КоличествоКонтролеровЗадания КАК КоличествоКонтролеровЗадания
		|		ПО АвторИсполнительЗадания.Ссылка = КоличествоКонтролеровЗадания.Задание";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(РезультатФункции, Выборка);
	КонецЕсли;
	
	Возврат РезультатФункции;
	
КонецФункции

Функция ТекстЗапросаПодчиненныхСогласований()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоЗадания.Ссылка КАК Ссылка,
		|	упоЗадания.Родитель КАК Родитель,
		|	упоЗаданияСтатусыСрезПоследних.Статус КАК Статус
		|ИЗ
		|	Справочник.упоЗадания КАК упоЗадания
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоЗаданияСтатусы.СрезПоследних КАК упоЗаданияСтатусыСрезПоследних
		|		ПО упоЗадания.Ссылка = упоЗаданияСтатусыСрезПоследних.Задание
		|			И (упоЗадания.Родитель = &Родитель)
		|			И (упоЗадания.Ссылка <> &Согласование)
		|			И (упоЗаданияСтатусыСрезПоследних.Статус <> &Статус)";

	Возврат ТекстЗапроса;
	
КонецФункции //

// Формирует структуру параметров записи для РС упоКомментарииЗаданий
//
// Параметры:
//  пЗадание	 - СправочникСсылка.упоЗадания - задание.
//  пСтатус		 - ПеречислениеСсылка.упоСтатусыЗаданий	- статус задания.
//  Комментарий	 - Строка - 
//  пКомментарий - Строка - 
//  пАвтор		 - СправочникСсылка.упоСотрудники - автор изменения статуса.
// 
// Возвращаемое значение:
//   - 
//
Функция ПолучитьСтруктуруПараметровЗаписиКомментыЗаданий(пЗадание, пСтатус, Комментарий = "", пКомментарий = "", пАвтор = Неопределено)
	
	СтруктураПараметров = Новый Структура;
	
	Если пАвтор = Неопределено Тогда 		
		пАвтор = ПараметрыСеанса.упоТекущийСотрудник;		
	КонецЕсли;	
	
	СтруктураПараметров.Вставить("Задание", 				пЗадание);
	СтруктураПараметров.Вставить("Статус",					пСтатус);
	СтруктураПараметров.Вставить("Комментарий", 			Комментарий);
	СтруктураПараметров.Вставить("КомментарийПользователя", пКомментарий);		
	СтруктураПараметров.Вставить("Автор", 					пАвтор);
	
	Возврат СтруктураПараметров;
	
КонецФункции

#КонецОбласти