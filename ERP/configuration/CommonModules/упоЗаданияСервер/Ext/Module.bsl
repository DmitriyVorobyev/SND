	СтрокаСтатусВидаЗадания.Статус = "Выполняется";
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Поручение";
	СтрокаСтатусВидаЗадания.Статус = "Завершено";
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Поручение";
	СтрокаСтатусВидаЗадания.Статус = "Закрыто";
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Поручение";
	СтрокаСтатусВидаЗадания.Статус = "Отменено";
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Поручение";
	СтрокаСтатусВидаЗадания.Статус = "Уточняется";
	
	// Обсуждения.
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Обсуждение";
	СтрокаСтатусВидаЗадания.Статус = "Открыто";
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Обсуждение";
	СтрокаСтатусВидаЗадания.Статус = "Закрыто";
	
	// Согласования.
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
	СтрокаСтатусВидаЗадания.ВидЗадания = "Согласование";
	СтрокаСтатусВидаЗадания.Статус = "НаСогласовании";
	
	СтрокаСтатусВидаЗадания = ТаблицаСтатусовВидовЗаданий.Добавить();
