	НовыйРеквизит.Заголовок = НСтр("ru = 'Основной трудовой ресурс'");
	НовыйРеквизит.СохраняемыеДанные = Истина;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	// ******   Группа формы "Диспетчер"    ***********
	
	НовыйЭлементСворачиваемаяГруппа = СворачиваемаяГруппа(Форма, "Диспетчер", НСтр("ru = 'Диспетчер'"), ЦветЗаголовка);
	
	// ******   Поле формы "СотрудникПоУмолчанию"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("СотрудникПоУмолчанию", Тип("ПолеФормы"), НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "СотрудникПоУмолчанию";
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "СотрудникПоУмолчаниюНачалоВыбора");
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "Подключаемый_упоСотрудникПоУмолчаниюНачалоВыбора");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_упоСотрудникПоУмолчаниюПриИзменении");
	НовыйЭлемент.РедактированиеТекста = Ложь;
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СотрудникПоУмолчаниюДоИзменения", Новый ОписаниеТипов("СправочникСсылка.упоСотрудники")));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	Форма["СотрудникПоУмолчаниюДоИзменения"] = Форма["СотрудникПоУмолчанию"];
	
	// ******   Поле формы "упоОсновнойТрудовойРесурс"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("упоОсновнойТрудовойРесурс", Тип("ПолеФормы"), НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "упоОсновнойТрудовойРесурс";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
