// Добавить элементы контура PM на форму персональных настроек пользователя.
//
// Параметры:
//  Форма     -  - 
//
Процедура ДобавитьЭлементыКонтураPMНаФормуПерсональныхНастроекПользователя(Форма, ТекущийПользователь) Экспорт
	
	Элементы = Форма.Элементы;
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	НовыйРеквизит = Новый РеквизитФормы("упоИмяГруппыСвернутьРазвернуть", Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("упоИменаСворачиваемыхГрупп", Новый ОписаниеТипов("СписокЗначений"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	ЦветЗаголовка = Неопределено;
	Если упоИнтеграцияКлиентСервер.ДоступнаНастройкаСтилей()
		И упоИнтеграцияКлиентСервер.ИспользуетсяСтильОформленияITLand() Тогда
		ЦветЗаголовка = ЦветаСтиля.упоЦветАкцентированияСтильITLand;
	КонецЕсли;
	
	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы")
			И Элемент.Вид = ВидГруппыФормы.ОбычнаяГруппа
			И Элемент.Поведение = ПоведениеОбычнойГруппы.Свертываемая Тогда
			
			Элемент.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.ГиперссылкаЗаголовка;
			Элемент.ШрифтЗаголовка = ШрифтыСтиля.ОбычныйШрифтТекста;
			
		КонецЕсли;
	КонецЦикла;
	
	ГруппаКоманднаяПанель = Элементы.Найти("КоманднаяПанель"); // в EPM 2.5 элемента нет.
	Если ГруппаКоманднаяПанель <> Неопределено Тогда
		ГруппаКоманднаяПанель.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Лево;
		Элементы.Переместить(ГруппаКоманднаяПанель, Форма, Элементы.Группа);
	КонецЕсли;
	
	ДобавитьНастройкиСтруктурыПроекта(Форма, ЦветЗаголовка);
	ДобавитьНастройкиПанельРуководителя(Форма, ЦветЗаголовка);
	ДобавитьНастройкиПанельРуководителяПодразделения(Форма, ЦветЗаголовка);
	ДобавитьНастройкиДиспетчер(Форма, ЦветЗаголовка);
	ДобавитьНастройкиОповещения(Форма, ЦветЗаголовка, ТекущийПользователь);
	ДобавитьНастройкиОтчеты(Форма, ЦветЗаголовка);
	ДобавитьНастройкиРаботаСШаблонами(Форма, ЦветЗаголовка);
	ДобавитьНастройкиЗадания(Форма, ЦветЗаголовка);
	ДобавитьНастройкиПроекты(Форма, ЦветЗаголовка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьНастройкиСтруктурыПроекта(Форма, ЦветЗаголовка)
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	Элементы = Форма.Элементы;
	
	ДобавитьРеквизитФормы("упоФорматСуммВСтруктуреПроектаКакВОтчетах", Новый ОписаниеТипов("Булево"),
		МассивДобавляемыхРеквизитов, Новый Структура("Заголовок, СохраняемыеДанные",
			"Формат сумм в структуре проекта как в отчетах", Истина));
	
	ДобавитьРеквизитФормы("упоФорматСуммВСтруктуреПроекта", Новый ОписаниеТипов("Строка"),
		МассивДобавляемыхРеквизитов, Новый Структура("Заголовок, СохраняемыеДанные",
			"Формат сумм в структуре проекта", Истина));
	
	ДобавитьРеквизитФормы("упоФорматКоличестваВСтруктуреПроектаКакВОтчетах", Новый ОписаниеТипов("Булево"),
		МассивДобавляемыхРеквизитов, Новый Структура("Заголовок, СохраняемыеДанные",
			"Формат количества в структуре проекта как в отчетах", Истина));
	
	ДобавитьРеквизитФормы("упоФорматКоличестваВСтруктуреПроекта", Новый ОписаниеТипов("Строка"),
		МассивДобавляемыхРеквизитов, Новый Структура("Заголовок, СохраняемыеДанные",
			"Формат количества в структуре проекта", Истина));
	
	// Настройки производительности.
	НастройкиПроизводительности = упоСтруктураПроектаКлиентСервер.СписокНастроекПроизводительностиСтруктурыПроекта();
	ПрефиксНастройки = упоИнтеграцияКлиентСервер.ПрефиксПодсистемыPM();
	Для каждого Настройка Из НастройкиПроизводительности Цикл
		ИмяНастройки = ПрефиксНастройки + Настройка.Ключ;
		ЗаголовокНастройки = Настройка.Значение.Наименование;
		
		ДобавитьРеквизитФормы(ИмяНастройки, Новый ОписаниеТипов("Булево"),
			МассивДобавляемыхРеквизитов, Новый Структура("Заголовок, СохраняемыеДанные",
				ЗаголовокНастройки, Истина));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	// ******   Группа формы "СтруктураПроекта"    ***********
	
	НовыйЭлементСворачиваемаяГруппа = СворачиваемаяГруппа(Форма, "СтркутраПроекта", НСтр("ru = 'Структура проекта'"), ЦветЗаголовка);
	
	// ******   Группа формы "ГруппаНастройкиФорматированияСтруктурыПроекта"    ***********
	
	НовыйЭлемент = Элементы.Вставить("ГруппаНастройкиФорматированияСтруктурыПроекта", Тип("ГруппаФормы"),
			НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Настройки форматирования'");
	НовыйЭлемент.ШрифтЗаголовка = ШрифтыСтиля.ОбычныйШрифтТекста;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	НовыйЭлемент.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	
	// ******   Группа формы "ГруппаФорматСуммСтруктурыПроекта"    ***********
	
	НовыйЭлемент = Элементы.Вставить("ГруппаФорматСуммСтруктурыПроекта", Тип("ГруппаФормы"),
			Элементы.ГруппаНастройкиФорматированияСтруктурыПроекта, Неопределено);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Колонки сумм'");
	НовыйЭлемент.ШрифтЗаголовка = ШрифтыСтиля.ОбычныйШрифтТекста;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НовыйЭлемент.Подсказка = НСтр("ru = 'Группа формат сумм'");
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	
	// ******   Группа формы "ГруппаНастройкиПроизводительности"    ***********
	
	НовыйЭлемент = Элементы.Вставить("ГруппаНастройкиПроизводительности", Тип("ГруппаФормы"),
			НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Настройки производительности'");
	НовыйЭлемент.ШрифтЗаголовка = ШрифтыСтиля.ОбычныйШрифтТекста;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	НовыйЭлемент.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	
	// ******   Поле формы "упоФорматСуммВСтруктуреПроектаКакВОтчетах"    ***********
	
	ДобавитьЭлементФлажок(Элементы, 
		Элементы.ГруппаФорматСуммСтруктурыПроекта, 
		"упоФорматСуммВСтруктуреПроектаКакВОтчетах", 
		"упоФорматСуммВСтруктуреПроектаКакВОтчетахПриИзменении",
		НСтр("ru = 'Как в отчетах'"));
	
	// ******   Поле формы "упоФорматСуммВСтруктуреПроекта"    ***********
	
	НовыйЭлемент = Элементы.Вставить("упоФорматСуммВСтруктуреПроекта", Тип("ПолеФормы"),
			Элементы.ГруппаФорматСуммСтруктурыПроекта, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Форматная строка'");
	НовыйЭлемент.ПутьКДанным = "упоФорматСуммВСтруктуреПроекта";
	НовыйЭлемент.КнопкаВыбора = Истина;
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "упоФорматСуммВОтчетахНачалоВыбора");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
	// ******   Группа формы "ГруппаФорматКоличестваСтруктурыПроекта"    ***********
	
	НовыйЭлемент = Элементы.Вставить("ГруппаФорматКоличестваСтруктурыПроекта", Тип("ГруппаФормы"),
			Элементы.ГруппаНастройкиФорматированияСтруктурыПроекта, Неопределено);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Колонки количества'");
	НовыйЭлемент.ШрифтЗаголовка = ШрифтыСтиля.ОбычныйШрифтТекста;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НовыйЭлемент.Подсказка = НСтр("ru = 'Группа формат количества'");
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	
	// ******   Поле формы "упоФорматКоличестваВСтруктуреПроектаКакВОтчетах"    ***********
	
	ДобавитьЭлементФлажок(Элементы, 
		Элементы.ГруппаФорматКоличестваСтруктурыПроекта, 
		"упоФорматКоличестваВСтруктуреПроектаКакВОтчетах", 
		"упоФорматКоличестваВСтруктуреПроектаКакВОтчетахПриИзменении",
		НСтр("ru = 'Как в отчетах'"));
	
	// ******   Поле формы "упоФорматКоличестваВСтруктуреПроекта"    ***********
	
	НовыйЭлемент = Элементы.Вставить("упоФорматКоличестваВСтруктуреПроекта", Тип("ПолеФормы"),
			Элементы.ГруппаФорматКоличестваСтруктурыПроекта, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Форматная строка'");
	НовыйЭлемент.ПутьКДанным = "упоФорматКоличестваВСтруктуреПроекта";
	НовыйЭлемент.КнопкаВыбора = Истина;
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "упоФорматСуммВОтчетахНачалоВыбора");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
	// Элементы группы "Настройки производительности".
	ГруппаЭлемента = Элементы.ГруппаНастройкиПроизводительности;
	ПрефиксНастройки = упоИнтеграцияКлиентСервер.ПрефиксПодсистемыPM();
	ОбработчикДействияПриИзменении = "упоНастройкиПроизводительностиПриИзменении";
	Для каждого Настройка Из НастройкиПроизводительности Цикл
		ИмяНастройки = ПрефиксНастройки + Настройка.Ключ;
		ДобавитьЭлементФлажок(Элементы, ГруппаЭлемента, ИмяНастройки, ОбработчикДействияПриИзменении);
	КонецЦикла;
	
	КомандаВыборСтиляОформления = Форма.Команды.Добавить("упоКомандаНастройкиПроизводительностиПоУмолчанию");
	КомандаВыборСтиляОформления.Действие = "Подключаемый_упоКомандаНастройкиПроизводительностиПоУмолчанию";
	КомандаВыборСтиляОформления.Заголовок = НСтр("ru = 'Заполнить по умолчанию'");
	
	НовыйЭлемент = Форма.Элементы.Добавить("упоНастройкиПроизводительностиПоУмолчанию", Тип("КнопкаФормы"), ГруппаЭлемента);
	НовыйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	НовыйЭлемент.Ширина = 30;
	НовыйЭлемент.ИмяКоманды = "упоКомандаНастройкиПроизводительностиПоУмолчанию";

КонецПроцедуры

Процедура ДобавитьНастройкиПанельРуководителя(Форма, ЦветЗаголовка)
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	// ******   Реквизит формы "ЗагружатьПоказателиПриОткрытииПанелиРуководителя"    ***********.
	
	НовыйРеквизит = Новый РеквизитФормы("ЗагружатьПоказателиПриОткрытииПанелиРуководителя", Новый ОписаниеТипов("Булево"));
	НовыйРеквизит.Заголовок = НСтр("ru = 'Загружать показатели при открытии панели руководителя'");
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	// ******   Группа формы "ПанельРуководителя"    ***********
	
	НовыйЭлементСворачиваемаяГруппа = СворачиваемаяГруппа(Форма, "ПанельРуководителя", НСтр("ru = 'Панель руководителя'"), ЦветЗаголовка);
	
	// ******   Поле формы "ЗагружатьПоказателиПриОткрытииПанелиРуководителя"    ***********.
	
	НовыйЭлемент = Форма.Элементы.Вставить("ЗагружатьПоказателиПриОткрытииПанелиРуководителя", Тип("ПолеФормы"), НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.ПутьКДанным = "ЗагружатьПоказателиПриОткрытииПанелиРуководителя";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
КонецПроцедуры

Процедура ДобавитьНастройкиПанельРуководителяПодразделения(Форма, ЦветЗаголовка)
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	Элементы = Форма.Элементы;
	
	// ******   Реквизит формы "ЗагружатьДанныеПриОткрытииПанелиРуководителяПодразделения"    ***********.
	
	НовыйРеквизит = Новый РеквизитФормы("ЗагружатьДанныеПриОткрытииПанелиРуководителяПодразделения", Новый ОписаниеТипов("Булево"));
	НовыйРеквизит.Заголовок = НСтр("ru = 'Загружать данные при открытии панели руководителя подразделения'");
	НовыйРеквизит.СохраняемыеДанные = Ложь;
