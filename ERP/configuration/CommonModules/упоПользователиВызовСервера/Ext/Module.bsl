Процедура ДобавитьНастройкиЗадания(Форма, ЦветЗаголовка)
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	// ******   Реквизит формы "КоличествоДнейДляЗакрытыхЗаданий"    ***********
	
	НовыйРеквизит = Новый РеквизитФормы("КоличествоДнейДляЗакрытыхЗаданий", Новый ОписаниеТипов("Число"));
	НовыйРеквизит.Заголовок = НСтр("ru = 'Количество дней после закрытия, в течение которых задание будет выводиться в списке'");
	НовыйРеквизит.СохраняемыеДанные = Истина;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	// ******   Реквизит формы "КоличествоДнейДоКонцаСрокаЗадания"    ***********
	
	НовыйРеквизит = Новый РеквизитФормы("КоличествоДнейДоКонцаСрокаЗадания", Новый ОписаниеТипов("Число"));
	НовыйРеквизит.Заголовок = НСтр("ru = 'Количество дней до конца срока Задания'");
	НовыйРеквизит.СохраняемыеДанные = Истина;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	// ******   Группа формы "Задания"    ***********
	
	НовыйЭлементСворачиваемаяГруппа = СворачиваемаяГруппа(Форма, "Задания", НСтр("ru = 'Задания'"), ЦветЗаголовка);
	
	// ******   Поле формы "КоличествоДнейДляЗакрытыхЗаданий"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("КоличествоДнейДляЗакрытыхЗаданий", Тип("ПолеФормы"), НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "КоличествоДнейДляЗакрытыхЗаданий";
	НовыйЭлемент.КнопкаРегулирования = Истина;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
	// ******   Поле формы "КоличествоДнейДоКонцаСрокаЗадания"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("КоличествоДнейДоКонцаСрокаЗадания", Тип("ПолеФормы"), НовыйЭлементСворачиваемаяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Количество дней до конца срока задания'");
	НовыйЭлемент.ПутьКДанным = "КоличествоДнейДоКонцаСрокаЗадания";
	НовыйЭлемент.КнопкаРегулирования = Истина;
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	НовыйЭлемент.РасширеннаяПодсказка.Заголовок = НСтр("ru = 'Задание будет выделено в списке, если до конца срока осталось заданное (или меньшее) количество дней'");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
КонецПроцедуры

Процедура ДобавитьНастройкиПроекты(Форма, ЦветЗаголовка)
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	
	// ******   Реквизит формы "упоУстанавливатьОтборПоПодразделениюВСпискеРолей"    ***********
	
	НовыйРеквизит = Новый РеквизитФормы("упоУстанавливатьОтборПоПодразделениюВСпискеРолей", Новый ОписаниеТипов("Булево"));
	НовыйРеквизит.Заголовок = НСтр("ru = 'Устанавливать отбор по моему подразделению в списке ролей'");
	НовыйРеквизит.СохраняемыеДанные = Истина;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	// ******   Реквизит формы "упоТекущийПроект"    ***********
	
	НовыйРеквизит = Новый РеквизитФормы("упоТекущийПроект", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	НовыйРеквизит.Заголовок = НСтр("ru = 'Текущий проект'");
	НовыйРеквизит.СохраняемыеДанные = Истина;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	// ******   Группа формы "Проекты"    ***********
	
	НовыйЭлементСворачиваемаяГруппа = СворачиваемаяГруппа(Форма, "Проекты", НСтр("ru = 'Проекты'"), ЦветЗаголовка);
	
	// ******   Группа формы "Группа12"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("Группа12", Тип("ГруппаФормы"), НовыйЭлементСворачиваемаяГруппа, Неопределено);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	
	// ******   Поле формы "упоТекущийПроект"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("упоТекущийПроект", Тип("ПолеФормы"), Форма.Элементы.Группа12, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "упоТекущийПроект";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
	Если упоИнтеграцияКлиентСервер.ДоступнаНастройкаСтилей() Тогда
		
		КомандаВыборСтиляОформления = Форма.Команды.Добавить("упоКомандаВыборСтиляОформления");
		КомандаВыборСтиляОформления.Действие = "Подключаемый_упоКомандаВыборСтиляОформления";
		КомандаВыборСтиляОформления.Заголовок = НСтр("ru = 'Выбор стиля оформления'");
		
		НовыйЭлемент = Форма.Элементы.Добавить("упоВыборСтиляОформления", Тип("КнопкаФормы"), Форма.Элементы.Группа2);
		НовыйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НовыйЭлемент.Ширина = 30;
		НовыйЭлемент.ЦветФона = ЦветаСтиля.ДобавленныйРеквизитФон;
		НовыйЭлемент.ИмяКоманды = "упоКомандаВыборСтиляОформления";
		
	КонецЕсли;
	
	// ******   Поле формы "упоУстанавливатьОтборПоПодразделениюВСпискеРолей"    ***********
	
	НовыйЭлемент = Форма.Элементы.Вставить("упоУстанавливатьОтборПоПодразделениюВСпискеРолей", Тип("ПолеФормы"), Форма.Элементы.Группа12, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.ПутьКДанным = "упоУстанавливатьОтборПоПодразделениюВСпискеРолей";
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	НовыйЭлемент.РасширеннаяПодсказка.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Справочник ""%1"" по умолчанию будет открываться с видом списка ""По подразделениям"" 
				|и с установленным отбором по подразделениям, в которых текущий сотрудник является руководителем. 
				|У пользователя сохраняется возможность изменить вид списка и снять отбор.'"),
			Метаданные.Справочники.упоРоли.Синоним);
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "упоРеквизитПриИзменении");
	
КонецПроцедуры

Процедура ДобавитьРеквизитФормы(ИмяРеквизита, ОписаниеТипов, МассивДобавляемыхРеквизитов, ПараметрыДобавления)
	
	Заголовок = Неопределено;
	СохраняемыеДанные = Неопределено;
	
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, ОписаниеТипов);
	Если ПараметрыДобавления.Свойство("Заголовок", Заголовок) Тогда
		НовыйРеквизит.Заголовок = Заголовок;
	КонецЕсли;
	Если ПараметрыДобавления.Свойство("СохраняемыеДанные", СохраняемыеДанные) Тогда
		НовыйРеквизит.СохраняемыеДанные = СохраняемыеДанные;
	КонецЕсли;
	
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
КонецПроцедуры

Процедура ДобавитьЭлементФлажок(Элементы, ГруппаЭлемента, ИмяЭлемента, ОбработчикДействияПриИзменении, Заголовок = "")

	НовыйЭлемент = Элементы.Вставить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаЭлемента, Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.ПутьКДанным = ИмяЭлемента;
	Если ЗначениеЗаполнено(Заголовок) Тогда
		НовыйЭлемент.Заголовок = Заголовок;
	КонецЕсли;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", ОбработчикДействияПриИзменении);

КонецПроцедуры

Функция СворачиваемаяГруппа(Форма, ИмяГруппы, ЗаголовокГруппы, ЦветЗаголовка = Неопределено)
	
	Если ЦветЗаголовка = Неопределено Тогда
		ЦветЗаголовка = ЦветаСтиля.упоЦветАкцентированияСтильПоУмолчанию
	КонецЕсли;
	
	Форма["упоИменаСворачиваемыхГрупп"].Добавить(ИмяГруппы);
	
	НовыйЭлементГруппаЗаголовок = Форма.Элементы.Вставить("ГруппаЗаголовок" + ИмяГруппы, Тип("ГруппаФормы"), Форма.Элементы.Группа, Неопределено);
	НовыйЭлементГруппаЗаголовок.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлементГруппаЗаголовок.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НовыйЭлементГруппаЗаголовок.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	НовыйЭлементГруппаЗаголовок.ОтображатьЗаголовок = Ложь;
	
	НовыйЭлемент = Форма.Элементы.Вставить("ДекорацияЗаголовок" + ИмяГруппы, Тип("ДекорацияФормы"), НовыйЭлементГруппаЗаголовок, Неопределено);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = ЗаголовокГруппы;
	НовыйЭлемент.ЦветТекста = ЦветЗаголовка;
	НовыйЭлемент.Шрифт = ШрифтыСтиля.ОбычныйШрифтТекста;
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "упоСвернутьРазвернутьГруппу");
	
	НовыйЭлементГруппаСворачиваемая = Форма.Элементы.Вставить("СворачиваемаяГруппа" + ИмяГруппы, Тип("ГруппаФормы"), Форма.Элементы.Группа, Неопределено);
	НовыйЭлементГруппаСворачиваемая.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлементГруппаСворачиваемая.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлементГруппаСворачиваемая.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	НовыйЭлементГруппаСворачиваемая.ОтображатьЗаголовок = Ложь;
	
	Возврат НовыйЭлементГруппаСворачиваемая;
	
КонецФункции

#КонецОбласти