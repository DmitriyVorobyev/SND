#Область ПрограммныйИнтерфейс

// Ищет направление деятельности по элементу.
//
// Параметры:
//  СсылкаПоиска - СправочникСсылка.Проект	 - объект, для которого ищется связанный элемент.
// 
// Возвращаемое значение:
//  Структура - данные о найденном связанном объекте.
//
Функция ПолучитьНаправлениеДеятельностиПоЭлементу(СсылкаПоиска) Экспорт
	
	СвязанноеНД = Новый Структура("НаправлениеДеятельностиЭлемент, НаправлениеДеятельностиГруппа");
	
	ЭтоУПФ = упоИнтеграцияВызовСервера.ЭтоУПФ();
	Если ЭтоУПФ Тогда 
		СвязанноеНД.Вставить("ОтключитьСинхронизациюНаименований");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СсылкаПоиска) Тогда
		Возврат СвязанноеНД;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСвязьПроектаСНаправлениемДеятельности.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельностиЭлемент,
	|	упоСвязьПроектаСНаправлениемДеятельности.НаправлениеДеятельностиГруппа КАК НаправлениеДеятельностиГруппа
	|ИЗ
	|	РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности
	|ГДЕ
	|	упоСвязьПроектаСНаправлениемДеятельности.ПроектныйЭлемент = &ПроектныйЭлемент";
	
	Если ЭтоУПФ Тогда 
		ДополнениеТекстаЗапроса = "	, упоСвязьПроектаСНаправлениемДеятельности.ОтключитьСинхронизациюНаименований КАК ОтключитьСинхронизациюНаименований
								  |ИЗ";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИЗ", ДополнениеТекстаЗапроса);
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПроектныйЭлемент", СсылкаПоиска);
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		ЗаполнитьЗначенияСвойств(СвязанноеНД, Выборка);
		
	КонецЕсли;
	
	Возврат СвязанноеНД;
	
КонецФункции

// Ищет направление деятельности по элементу.
//
// Параметры:
//  СсылкаПоиска - ДокументСсылка.упоПроектнаяЗадача - объект, для которого ищется связанный элемент.
// 
// Возвращаемое значение:
//  СправочникСсылка.НаправлениеДеятельности - найденный связанный объект.
//
Функция ПолучитьНаправлениеДеятельностиПоПроектнойЗадачеСУчетомИерархии(СсылкаПоиска) Экспорт
		
	Если Не ЗначениеЗаполнено(СсылкаПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Неопределено;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК Задача1,
	|	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель КАК Задача2,
	|	ЕСТЬNULL(упоСвойстваПроектныхЗадачСрезПоследнихРодителя.ЗадачаРодитель, &ПустаяПЗ) КАК Задача3,
	|	ЕСТЬNULL(упоСвойстваПроектныхЗадачСрезПоследнихРодителяРодителя.ЗадачаРодитель, &ПустаяПЗ) КАК Задача4
	|ПОМЕСТИТЬ Родители
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадачаДокумент) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	|			И (упоВерсииПроекта.Текущая)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследнихРодителя
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследнихРодителяРодителя
	|			ПО (упоСвойстваПроектныхЗадачСрезПоследнихРодителя.ЗадачаРодитель <> &ПустаяПЗ)
	|				И упоСвойстваПроектныхЗадачСрезПоследнихРодителя.ЗадачаРодитель = упоСвойстваПроектныхЗадачСрезПоследнихРодителяРодителя.ПроектнаяЗадача
	|				И упоСвойстваПроектныхЗадачСрезПоследнихРодителя.Версия = упоСвойстваПроектныхЗадачСрезПоследнихРодителяРодителя.Версия
	|				И (НЕ упоСвойстваПроектныхЗадачСрезПоследнихРодителяРодителя.ЗадачаОтменена)
	|		ПО (упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель <> &ПустаяПЗ)
	|			И упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = упоСвойстваПроектныхЗадачСрезПоследнихРодителя.ПроектнаяЗадача
	|			И упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоСвойстваПроектныхЗадачСрезПоследнихРодителя.Версия
	|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследнихРодителя.ЗадачаОтменена)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Родители.Задача1 КАК Задача1,
	|	Родители.Задача2 КАК Задача2,
	|	Родители.Задача3 КАК Задача3,
	|	Родители.Задача4 КАК Задача4,
	|	упоСвязьПроектаСНаправлениемДеятельности1.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельностиЭлемент1,
	|	упоСвязьПроектаСНаправлениемДеятельности2.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельностиЭлемент2,
	|	упоСвязьПроектаСНаправлениемДеятельности3.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельностиЭлемент3,
	|	упоСвязьПроектаСНаправлениемДеятельности4.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельностиЭлемент4
	|ИЗ
	|	Родители КАК Родители
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности1
	|		ПО Родители.Задача1 = упоСвязьПроектаСНаправлениемДеятельности1.ПроектныйЭлементПроектнаяЗадача
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности2
	|		ПО (Родители.Задача2 <> &ПустаяПЗ)
	|			И Родители.Задача2 = упоСвязьПроектаСНаправлениемДеятельности2.ПроектныйЭлементПроектнаяЗадача
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности3
	|		ПО (Родители.Задача3 <> &ПустаяПЗ)
	|			И Родители.Задача3 = упоСвязьПроектаСНаправлениемДеятельности3.ПроектныйЭлементПроектнаяЗадача
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности4
	|		ПО (Родители.Задача4 <> &ПустаяПЗ)
	|			И Родители.Задача4 = упоСвязьПроектаСНаправлениемДеятельности4.ПроектныйЭлементПроектнаяЗадача";	
	
	
	Запрос = Новый Запрос();				   	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПустаяПЗ", Документы.упоПроектнаяЗадача.ПустаяСсылка());
	
	ТекЗадача = СсылкаПоиска;
	
	Пока Истина Цикл
		Запрос.УстановитьПараметр("ПроектнаяЗадачаДокумент", ТекЗадача);
		Выборка = Запрос.Выполнить().Выбрать();	
		Если Не Выборка.Следующий() Тогда
			Возврат Результат;
		КонецЕсли;
		сч = 1;  
		Пока сч <= 4 Цикл
			ТекЗадача = Выборка["Задача" + сч];
			Если Не ЗначениеЗаполнено(ТекЗадача) Тогда
				Возврат Результат;
			КонецЕсли;
			Направление = Выборка["НаправлениеДеятельностиЭлемент" + сч];
			Если ЗначениеЗаполнено(Направление) Тогда
				Результат = Направление;
				Возврат Результат;
			КонецЕсли;
			сч = сч + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Ищет направление деятельности по элементу.
//
// Параметры:
//  СсылкаПоиска - ДокументСсылка.упоПроектнаяЗадача - объект, для которого ищется связанный элемент.
// 
// Возвращаемое значение:
//  СправочникСсылка.НаправлениеДеятельности, Неопределено - найденный связанный объект.
//
Функция ПолучитьНаправлениеДеятельностиПоПроектнойЗадаче(СсылкаПоиска) Экспорт
	
	Если Не ЗначениеЗаполнено(СсылкаПоиска) Тогда
