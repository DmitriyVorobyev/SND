	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСвязьПроектаСНаправлениемДеятельности.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельностиЭлемент
	|ИЗ
	|	РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности
	|ГДЕ
	|	упоСвязьПроектаСНаправлениемДеятельности.ПроектныйЭлементПроектнаяЗадача = &СсылкаПоиска";	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СсылкаПоиска", СсылкаПоиска);
	Запрос.Текст = ТекстЗапроса;
	
