Процедура ЗаполнитьСписокXDTOResource(Параметры, СписокXDTO, ТипВыгрузки)
	
	СписокXDTO.Очистить();
	
	Фабрика = Параметры.Фабрика;
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
	
	// Объекты у нас будут одинаковые, типы тоже, поэтому создадим общее соответствие.
	ДляТиповОбъектXDTO = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
	СоответствиеТиповXDTO = ПолучитьСоответствиеТиповXDTO(Фабрика, ДляТиповОбъектXDTO, ТипОбъекта.Свойства);
	
	// Получить выделенные трудовые ресурсы.
	Выборка = Параметры.ВыделенныеТрудовыеРесурсы.Выбрать();
	
	СписокДобавленныеРесурсы = Новый Массив;
	
	КолонкаРольРесурс = "";
	Если ТипВыгрузки Тогда
		КолонкаРольРесурс = "Ресурс";
	Иначе
		КолонкаРольРесурс = "РольРесурса";
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		Если СписокДобавленныеРесурсы.Найти(Выборка[КолонкаРольРесурс]) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокДобавленныеРесурсы.Добавить(Выборка[КолонкаРольРесурс]);
		
		ОбъектXDTO = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
		
		СоответствиеЗначения1С = ПолучитьСоответствиеЗначения1СResource(Параметры, СоответствиеТиповXDTO, Выборка, ТипВыгрузки);
		
		СоответствиеResourcesUID = ПолучитьСоответствиеЗначенийXDTO(Фабрика, СоответствиеТиповXDTO, СоответствиеЗначения1С);
		
		ЗаполнитьОбъектXDTOЗначениямиXDTO(ОбъектXDTO, СоответствиеResourcesUID);
		
		СписокXDTO.Добавить(ОбъектXDTO);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти