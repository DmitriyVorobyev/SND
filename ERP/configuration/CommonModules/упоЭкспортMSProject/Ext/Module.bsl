Функция ЗапросСостояниеПроекта()
	
	Возврат "
		|ВЫБРАТЬ ПЕРВЫЕ 1 РАЗРЕШЕННЫЕ
		|	РегСтатус.СтатусПроекта,
		|	РегРП.РуководительПроекта
		|	
		|ИЗ
		|	РегистрСведений.упоСтатусыПроектов.СрезПоследних(,
		|		Проект = &Проект
		|	) КАК РегСтатус
		|		
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(,
		|		Проект = &Проект
		|	) КАК РегРП
		|ПО
		|	РегСтатус.Проект = РегРП.Проект
		|";
	
КонецФункции

Функция ПолучитьВсеTasks(Параметры)
	
	ЗапросТекст = ЗапросСписокПроектныхЗадач();
	
	Запрос = Новый Запрос(ЗапросТекст);
	Запрос.УстановитьПараметр("ПустаяДата", Параметры.ПустаяДата);
	Запрос.УстановитьПараметр("ПустаяСтрока", Параметры.ПустаяСтрока);
	Запрос.УстановитьПараметр("ПустаяСсылкаупоПроектнаяЗадача", Документы.упоПроектнаяЗадача.ПустаяСсылка());
	Запрос.УстановитьПараметр("Проект", Параметры.Основнойпроект);
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Параметры.Основнойпроект));
	Запрос.УстановитьПараметр("базВерсия", упоВерсионирование.ПолучитьБазовуюВерсиюПроекта(Параметры.Основнойпроект));
	Запрос.УстановитьПараметр("РуководительПроекта", ПолучитьСвойстваПроекта(Параметры).РуководительПроекта);
	Запрос.УстановитьПараметр("ПустойРуководитель", Справочники.упоСотрудники.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПланированиеПоРолям", Перечисления.упоУровеньПланирования.Предварительный);
		
	ТаблицаTasks = Запрос.Выполнить().Выгрузить();
	ТаблицаTasks.Сортировать("WBS");	
			
	ЗаполнитьДатыСтартаФиниша(Параметры, ТаблицаTasks);
		
	Возврат ТаблицаTasks;
	
КонецФункции

Процедура ЗаполнитьДатыСтартаФиниша(Параметры, ТаблицаTasks)
	
	ТаблицаTasks.Индексы.Добавить("Родитель");
	ТаблицаTasks.Сортировать("WBS Убыв");
	// У подчиненных задач на тот момент могло не быть дат - пытаемся заполнить снова, ища по таблице.
	СтруктураОтбора = Новый Структура("Родитель");
	Для каждого СтрокаЗадача Из ТаблицаTasks Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаЗадача.Start) Тогда
			СтруктураОтбора.Вставить("Родитель",СтрокаЗадача.ПроектнаяЗадача);
			МассивСтрок = ТаблицаTasks.НайтиСтроки(СтруктураОтбора);
			
			Если МассивСтрок.Количество() > 0 Тогда
				
				СамаяМаленькаяДата = Параметры.ПустаяДата;
				СамаяБольшаяДата = Параметры.ПустаяДата;
				
				Для каждого СтрокаМассива Из МассивСтрок Цикл
				   
					Если СамаяМаленькаяДата  = Параметры.ПустаяДата Тогда 
						СамаяМаленькаяДата = СтрокаМассива.Start;
					КонецЕсли;
					Если СамаяМаленькаяДата  > СтрокаМассива.Start Тогда 
						СамаяМаленькаяДата = СтрокаМассива.Start;
					КонецЕсли;
				
					Если СамаяБольшаяДата  = Параметры.ПустаяДата Тогда 
						СамаяБольшаяДата  = СтрокаМассива.Finish;
					КонецЕсли;
					Если СамаяБольшаяДата  < СтрокаМассива.Finish Тогда 
						СамаяБольшаяДата  = СтрокаМассива.Finish;
					КонецЕсли;

				КонецЦикла;
				
				Если СамаяМаленькаяДата <> Параметры.ПустаяДата Тогда 
					СтрокаЗадача.Start = СамаяМаленькаяДата; 
				КонецЕсли; 
				
				Если СамаяБольшаяДата <> Параметры.ПустаяДата Тогда 
					СтрокаЗадача.Finish = СамаяБольшаяДата; 
				КонецЕсли; 
			КонецЕсли;	
        КонецЕсли;
	КонецЦикла;

    ТаблицаTasks.Сортировать("WBS");
	
КонецПроцедуры

Функция ПолучитьСоответствиеЗначения1СTasks(СоответствиеТиповXDTO, СтрокаЗадача)
	
	Соответствие = Новый Соответствие();
	
	// FixedCostAccrual - "2" Пропорционально (по умолчанию); затраты начисляются по мере планирования
	// и поступления сообщений о фактическом выполнении трудозатрат.
	Соответствие.Вставить("FixedCostAccrual",3);
	
	// DurationFormat — это формат длительности, используемый по умолчанию для всех параметров длительности в проекте.
	Соответствие.Вставить("DurationFormat",39);
	
	// CalendarUID - Уникальный идентификатор календаря, используемого в проекте.
	Соответствие.Вставить("CalendarUID",-1);
	
	// Веха
	Соответствие.Вставить("Milestone", 0);
	
	// Указывает, является ли задача суммарной.
	Соответствие.Вставить("Summary", 0);
	
	Соответствие.Вставить("IgnoreResourceCalendar", 1);
	
	// Указывает, будет ли задача планироваться с фиксированным объемом работ.
	Соответствие.Вставить("EffortDriven", 1);
	
	// Указывает, будет ли задача планироваться в режиме "Предварительная оценка". 0 - режим без предварительной оценки.
	Соответствие.Вставить("Estimated", 0);
	
	// Процент выполнения от длительности задачи.
	Соответствие.Вставить("PercentComplete", 0);
	
	// Текущее состояние задачи, выраженное в виде процента выполненных трудозатрат по задаче.
	Соответствие.Вставить("PercentWorkComplete", 0);
	
	// Текущее состояние задачи, выраженное в виде процента выполненных трудозатрат по задаче.
	Соответствие.Вставить("Type", 0);
	
	Для каждого ТекТип Из СоответствиеТиповXDTO Цикл
		
		Попытка
			Соответствие.Вставить(ТекТип.Ключ, СтрокаЗадача[ТекТип.Ключ]);
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Процедура ЗаполнитьСписокXDTOTask(Параметры, СписокXDTO)
	
	СписокXDTO.Очистить(); // В списке обязательно создается один объект, но мы заполняем по-своему.
	
	Фабрика = Параметры.Фабрика;
	
	// Если определен Основной проект - значит для задачи нужно:
	// 1. создавать элементы только с КодомСДР (WBS);
	// 2. обработать связь с предшественниками.
	ЕстьОсновнойПроект = Не (Параметры.ОсновнойПроект = Неопределено);  
	ЕстьТаблицаСвязей = Не (Параметры.ТаблицаСвязейПроекта = Неопределено);
	
	Если Не ЕстьОсновнойПроект Тогда
		Параметры.Задачи.Сортировать("WBS");
	КонецЕсли;
	
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
	ОбъектXDTOTask = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
	СоответствиеТиповXDTO = ПолучитьСоответствиеТиповXDTO(Фабрика, ОбъектXDTOTask, ТипОбъекта.Свойства);
	// В панели показателей не предусмотрена выгрузка процента готовности.
	ЕстьПроцентГотовности = ?(Параметры.Задачи.Колонки.Найти("ПроцентГотовности") = Неопределено, Ложь, Истина);
	
	ВыводимВложенныеЗадачи = 0;
	Для каждого СтрокаЗадача Из Параметры.Задачи Цикл
		
		Если ЕстьОсновнойПроект 
			И НЕ ЗначениеЗаполнено(СтрокаЗадача.WBS) Тогда
			Продолжить; 
		КонецЕсли;
		
		ОбъектXDTOTask = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
		
		СоответствиеЗначения1С = ПолучитьСоответствиеЗначения1СTasks(СоответствиеТиповXDTO, СтрокаЗадача);
		СоответствиеResourcesUID = ПолучитьСоответствиеЗначенийXDTO(Фабрика, СоответствиеТиповXDTO, СоответствиеЗначения1С);
		
		ЗаполнитьОбъектXDTOЗначениямиXDTO(ОбъектXDTOTask, СоответствиеResourcesUID);
		
		ИмяСвойства = "UID";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства], СтрокаЗадача.UID);
		// ID - отвечает за то в какой строке будет стоять задача,
		// например, если  ID = 6 то задачи начнуться с 6-й строки.
		ИмяСвойства = "ID";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства], СтрокаЗадача.ID);
		
		// Заполнить календарь задачи
		Календарь = Параметры.СоответствиеПроектаПЗИКалендаря[СтрокаЗадача.ПроектнаяЗадача];
		УИДКалендаря = Параметры.СоответствиеКалендаряИЕгоУИДа[Календарь];
		Если УИДКалендаря <> Неопределено Тогда
			ОбъектXDTOTask.CalendarUID = УИДКалендаря;
		КонецЕсли;
		
		НулеваяДлительность = СтрокаЗадача.ЭтоВеха;
		
		ИмяСвойства = "Duration";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
			ВычислитьДлительностьMSProject(Параметры,
				СтрокаЗадача.Start,
				СтрокаЗадача.Finish,
				НулеваяДлительность,
				СтрокаЗадача));
		
		Если ЕстьПроцентГотовности Тогда
			Если СтрокаЗадача.ПроцентГотовности <> 0 Тогда
				ИмяСвойства = "ActualStart";
				ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
						ОбъектXDTOTask.Start);
				ИмяСвойства = "ActualDuration";
				ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
						ОбъектXDTOTask.Duration);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаЗадача.РучнойВводСроков И Параметры.ВерсияMSProject >= 15 Тогда
			ИмяСвойства = "Manual";
			ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства], 1);
			ОбъектXDTOTask.ManualStart = ОбъектXDTOTask.Start;
			ОбъектXDTOTask.ManualFinish = СтрокаЗадача.Finish;
			ОбъектXDTOTask.ManualDuration = ОбъектXDTOTask.Duration;
		КонецЕсли;
		
		ИмяСвойства = "OutlineNumber";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства], СтрокаЗадача.WBS);
		// OutlineLevel - Число, определяющее уровень задачи в иерархической структуре проекта.
		ИмяСвойства = "OutlineLevel";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
			СтрЧислоВхождений(СтрокаЗадача.WBS, ".") + 1);
		
		ИмяСвойства = "Notes";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства], СтрокаЗадача.Описание);

		// Summary - флаг, определяющий является ли задача суммирующей.
		ИмяСвойства = "Summary";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
			?(Параметры.СуммирующиеЗадачи.Найти(СтрокаЗадача.ПроектнаяЗадача) = Неопределено, 0, 1));
		
		// DurationFormat.
		ИмяСвойства = "DurationFormat";
		ОбъектXDTOTask[ИмяСвойства] =  СоздатьОбъектXDTO(Фабрика,СоответствиеТиповXDTO[ИмяСвойства],
			?(Параметры.СуммирующиеЗадачи.Найти(СтрокаЗадача.ПроектнаяЗадача) = Неопределено, 39, 53));
		
		// Type.
		ИмяСвойства = "Type";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
			?(Параметры.СуммирующиеЗадачи.Найти(СтрокаЗадача.ПроектнаяЗадача) = Неопределено, 0, 1));
		
		ИмяСвойства = "Name";
		СтрокаЗадача.Name = СокрЛП(СтрокаЗадача.Name);
		СтрокаЗадача.Name = упоФункцииОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыXMLиТабуляцию(СтрокаЗадача.Name);
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
			?(СтрокаЗадача.Name = "", НСтр("ru = '<Не указано>'"), СтрокаЗадача.Name));
		
		Если ЕстьОсновнойПроект Или ЕстьТаблицаСвязей Тогда
			
			Если ЕстьТаблицаСвязей Тогда
				// Создадим предшественника PredecessorLink.
				ЗаполнитьPredecessorLink(Параметры,ОбъектXDTOTask.PredecessorLink,СтрокаЗадача);
			КонецЕсли;
			
			УровеньВСДРДляВехи = ОбъектXDTOTask.OutlineLevel;
			ВыводимВложенныеЗадачи = ОбъектXDTOTask.Summary;
			
		КонецЕсли;
		
		ИмяСвойства = "Milestone";
		ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
			?(СтрокаЗадача.ЭтоВеха, 1, 0));
		
		Если ЕстьПроцентГотовности Тогда
			ИмяСвойства = "PercentComplete";
			ОбъектXDTOTask[ИмяСвойства] = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO[ИмяСвойства],
				Окр(СтрокаЗадача.ПроцентГотовности, 0)); // В MSP целочисленый % готовности.
		КонецЕсли;
			
		СписокXDTO.Добавить(ОбъектXDTOTask);
		
	КонецЦикла;
	
КонецПроцедуры

