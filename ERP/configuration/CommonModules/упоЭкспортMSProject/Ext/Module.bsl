Функция СоздатьЗаполнитьОбъектXDTOCalendars(Параметры, ТипОбъекта)
	
	// Основное значение, по сути это проект который нам нужно наполнить данными из 1с, но в формате,
	// который воспримет MS Project.
	
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Параметры.Фабрика,ТипОбъекта); 
	
	// Нужно заполнить список Calendar.
	ЗаполнитьСписокXDTOCalendar(Параметры,ОбъектXDTO.Calendar);
	
	// Больше свойств у календаря нет, заполнять нечего.
	
	Возврат ОбъектXDTO;
	
КонецФункции

Процедура ЗаполнитьСписокXDTOCalendar(Параметры, СписокXDTO)
	
	СписокXDTO.Очистить();
	
	Фабрика = Параметры.Фабрика;
	
	// Первым делом создаем основной календарь.
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
	
	ЗаполнитьКалендари(СписокXDTO, Параметры, ТипОбъекта);
	
	// Дальше можем заполнять его данными по ресурсам, зная что базовый календарь - ОбъектXDTOCalendar.
	ВыделенныеТрудовыеРесурсы = Параметры.ВыделенныеТрудовыеРесурсы.Выбрать();
	
	ДобавленныеРесурсы = Новый Массив;
	Пока ВыделенныеТрудовыеРесурсы.Следующий() Цикл
		Если ДобавленныеРесурсы.Найти(ВыделенныеТрудовыеРесурсы.Name) <> 0 Тогда
			Продолжить;
		Иначе
			ДобавленныеРесурсы.Добавить(ВыделенныеТрудовыеРесурсы.Name);
		КонецЕсли;
		
		ОбъектXDTO = СоздатьОбъектXDTO(Фабрика,ТипОбъекта); 
		
		// Нужно определить типы в формате XDTO - получаем реквизиты ЗначениеXDTOProject.
		СоответствиеТиповXDTO = ПолучитьСоответствиеТиповXDTO(Фабрика,ОбъектXDTO,ТипОбъекта.Свойства);
		
		// По умолчанию для главного = 1.
		ОбъектXDTO.UID = СоздатьОбъектXDTO(Параметры.Фабрика,СоответствиеТиповXDTO["UID"],Параметры.СчетчикUID);
		Параметры.Вставить("СчетчикUID",Параметры.СчетчикUID+1);
		
		ОбъектXDTO.Name 			= СоздатьОбъектXDTO(Фабрика,СоответствиеТиповXDTO["Name"],ВыделенныеТрудовыеРесурсы.Name);
		// <IsBaseCalendar>0</IsBaseCalendar>   -  Указывает, является ли календарь базовым.
		ОбъектXDTO.IsBaseCalendar	= СоздатьОбъектXDTO(Фабрика,СоответствиеТиповXDTO["IsBaseCalendar"],0);
		// <BaseCalendarUID>1</BaseCalendarUID> -  Уникальный идентификатор базового календаря,
		// от которого зависит данный календарь; используется только для календарей, не являющихся базовыми.
		ОбъектXDTO.BaseCalendarUID 	= СоздатьОбъектXDTO(Фабрика,СоответствиеТиповXDTO["BaseCalendarUID"],1);
		
		СписокXDTO.Добавить(ОбъектXDTO);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьКалендари(СписокXDTO, Параметры, ТипОбъекта)
	
	Для Каждого СвойстваКалендаря Из Параметры.СвойстваКалендарей Цикл		
		ОбъектXDTOCalendar = СоздатьКалендарьXDTOCalendar(Параметры, ТипОбъекта, СвойстваКалендаря.Значение);	
		СписокXDTO.Добавить(ОбъектXDTOCalendar);		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьКалендарьXDTOCalendar(Параметры, ТипОбъекта, ПараметрыКалендаря)
	
	ОбъектXDTO = СоздатьОбъектXDTO(Параметры.Фабрика,ТипОбъекта); 
	
	// Нужно определить типы в формате XDTO - получаем реквизиты ЗначениеXDTOProject.
	СоответствиеТиповXDTO = ПолучитьСоответствиеТиповXDTO(Параметры.Фабрика, ОбъектXDTO, ТипОбъекта.Свойства); 
	СоответствиеResourcesUID = ПолучитьСоответствиеЗначенийXDTO(Параметры.Фабрика, СоответствиеТиповXDTO,
		ПараметрыКалендаря);
	ЗаполнитьОбъектXDTOЗначениямиXDTO(ОбъектXDTO, СоответствиеResourcesUID);
	
	ЗаполнитьСписокXDTOWeekDay(Параметры, ОбъектXDTO.WeekDays.WeekDay, ПараметрыКалендаря);
	ЗаполнитьСписокXDTOExceptions(Параметры, ОбъектXDTO.Exceptions.Exception, ПараметрыКалендаря["ИсключенияКалендаря"]);
		
	Возврат ОбъектXDTO;
	
КонецФункции

Процедура ЗаполнитьСписокXDTOWeekDay(Параметры, СписокXDTO, ПараметрыКалендаря)
	
	СписокXDTO.Очистить();
	
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
	
	Для Каждого Строка Из ПараметрыКалендаря["WorkingTimes"] Цикл
		
		ОбъектXDTOWeekDay = Параметры.Фабрика.Создать(СписокXDTO.ВладеющееСвойство.Тип);	
		ОбъектXDTOWeekDay.DayType = Строка.Ключ;
		ДеньРабочий = 1;
		Если Строка.Значение.Количество() = 0 Тогда
			ДеньРабочий = 0;
		КонецЕсли;
		ОбъектXDTOWeekDay.DayWorking = ДеньРабочий;
		
		Если ДеньРабочий = 1 Тогда
			ОбъектXDTOWeekDay.WorkingTimes = СоздатьЗаполнитьОбъектXDTOWorkingTimes(Параметры,
				ПолучитьТипСвойстваXDTO(ТипОбъекта, "WorkingTimes"), Строка.Значение);
        КонецЕсли;
		
		СписокXDTO.Добавить(ОбъектXDTOWeekDay);
		
	КонецЦикла;
		
	// Добавим границы задач, чтобы проджект мог корректно отбразить заданные в PM сроки.
	Для каждого СтрокаИсключение Из Параметры.ТаблицаИсключенийДат Цикл
		
		ОбъектXDTOWeekDay = Параметры.Фабрика.Создать(СписокXDTO.ВладеющееСвойство.Тип);
		// <DayType>.
		ОбъектXDTOWeekDay.DayType = 0; // Исключение.
		// <DayWorking>.
		ОбъектXDTOWeekDay.DayWorking = 1; 
		Если ОбъектXDTOWeekDay.DayWorking = 1 Тогда
			ОбъектXDTOWeekDay.WorkingTimes = СоздатьЗаполнитьОбъектXDTOWorkingTimes(Параметры,
				ПолучитьТипСвойстваXDTO(ТипОбъекта, "WorkingTimes"));
        КонецЕсли;
		ОбъектXDTOWeekDay.TimePeriod = СоздатьЗаполнитьОбъектXDTOTimePeriod(Параметры, СтрокаИсключение.FromDate,
			СтрокаИсключение.ToDate, ПолучитьТипСвойстваXDTO(ТипОбъекта,"TimePeriod")); 
		
		СписокXDTO.Добавить(ОбъектXDTOWeekDay);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьЗаполнитьОбъектXDTOWorkingTimes(Параметры, ТипОбъекта, WorkingTime = Неопределено)
	
	// Основное значение, по сути это проект который нам нужно наполнить данными из 1с, но в формате,
	// который воспримет MS Project.
	
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Параметры.Фабрика,ТипОбъекта); 
	
	// Нужно заполнить список WorkingTime.
	ЗаполнитьСписокXDTOWorkingTimes(Параметры,ОбъектXDTO.WorkingTime, WorkingTime);
	
	// Больше свойств у календаря нет, заполнять нечего.
	
	Возврат ОбъектXDTO;
	
КонецФункции
 
Процедура ЗаполнитьСписокXDTOWorkingTimes(Параметры, СписокXDTO, WorkingTime)
	
	СписокXDTO.Очистить();

	Фабрика = Параметры.Фабрика;
	
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
	
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Фабрика, ТипОбъекта); 
	
	Если WorkingTime = Неопределено Тогда
	
		// - <WorkingTimes>
		// - <WorkingTime>
		//   <FromTime>09:00:00</FromTime> 
		//   <ToTime>13:00:00</ToTime> 
		//   </WorkingTime>
		// - <WorkingTime>
		//   <FromTime>14:00:00</FromTime> 
		//   <ToTime>18:00:00</ToTime> 
		//   </WorkingTime>
		//   </WorkingTimes>.
	
		ОбъектXDTOWorkingTime = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
		
		ОбъектXDTOWorkingTime.FromTime = '00010101090000';
		ОбъектXDTOWorkingTime.ToTime = '00010101130000';
		СписокXDTO.Добавить(ОбъектXDTOWorkingTime);
		
		ОбъектXDTOWorkingTime = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
		
		ОбъектXDTOWorkingTime.FromTime = '00010101140000';
		ОбъектXDTOWorkingTime.ToTime = '00010101180000';
		СписокXDTO.Добавить(ОбъектXDTOWorkingTime);
		
		Возврат;
		
	КонецЕсли;
	
	ОбъектXDTOWorkingTime = СоздатьОбъектXDTO(Фабрика,ТипОбъекта);
	ОбъектXDTOWorkingTime.FromTime = WorkingTime.FromTime;
	ОбъектXDTOWorkingTime.ToTime = WorkingTime.ToTime;
	СписокXDTO.Добавить(ОбъектXDTOWorkingTime);
	
КонецПроцедуры

Функция СоздатьЗаполнитьОбъектXDTOTimePeriod(Параметры, ДатаНачала, ДатаКонец, ТипОбъекта)
	
	// Основное значение, по сути это проект который нам нужно наполнить данными из 1с, но в формате, 
	// который воспримет MS Project.
	
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Параметры.Фабрика,ТипОбъекта); 
	
	// Нужно заполнить список WorkingTime.
	ЗаполнитьОбъектXDTOTimePeriod(Параметры, ДатаНачала, ДатаКонец, ОбъектXDTO);
	
	// Больше свойств у календаря нет, заполнять нечего.
	
	Возврат ОбъектXDTO;
	
КонецФункции
 
Процедура ЗаполнитьСписокXDTOExceptions(Параметры, СписокXDTO, Исключения)
	
	СписокXDTO.Очистить();

	Фабрика = Параметры.Фабрика;
	
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
		
	Для Каждого Строка Из Исключения Цикл
		
		ОбъектXDTOException = Фабрика.Создать(СписокXDTO.ВладеющееСвойство.Тип);
		// <Type>.
		ОбъектXDTOException.Type = 1; // Исключение.
		// <DayWorking>.		
		ОбъектXDTOException.DayWorking = Строка.DayWorking;
		
		// EnteredByOccurrences.
		ОбъектXDTOException.EnteredByOccurrences = 1;
		// Occurrences.
		ОбъектXDTOException.Occurrences = 1;
				
		Если ОбъектXDTOException.DayWorking = 1 Тогда
			ОбъектXDTOException.WorkingTimes = СоздатьЗаполнитьОбъектXDTOWorkingTimes(Параметры,
			ПолучитьТипСвойстваXDTO(ТипОбъекта, "WorkingTimes"), Строка);
		КонецЕсли;
		ОбъектXDTOException.TimePeriod = СоздатьЗаполнитьОбъектXDTOTimePeriod(Параметры, Строка.НачалоДня,
		Строка.КонецДня, ПолучитьТипСвойстваXDTO(ТипОбъекта, "TimePeriod")); 
		
		СписокXDTO.Добавить(ОбъектXDTOException);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектXDTOTimePeriod(Параметры, ДатаНачала, ДатаКонец, ОбъектXDTO)

	ТипОбъекта = ОбъектXDTO.Тип();
	Фабрика = Параметры.Фабрика;
	
	ОбъектXDTO.FromDate =СоздатьОбъектXDTO(Фабрика,ПолучитьТипСвойстваXDTO(ТипОбъекта,"FromDate"),ДатаНачала);
	ОбъектXDTO.ToDate =СоздатьОбъектXDTO(Фабрика,ПолучитьТипСвойстваXDTO(ТипОбъекта,"ToDate"),ДатаКонец);
	  	 		
КонецПроцедуры

