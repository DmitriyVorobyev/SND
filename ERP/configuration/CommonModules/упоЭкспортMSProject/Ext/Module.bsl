//
// Возвращаемое значение:
//   Выборка – результат запроса.
//
Функция ПолучитьТрудовыеРолиПроектныхЗадач(Параметры)
	
	ЗапросТекст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| 1 КАК Type,
		| ВЫРАЗИТЬ(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс КАК Справочник.упоРоли).Наименование КАК Name,
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача КАК ПроектнаяЗадача,
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача.ЗадачаРодитель КАК Родитель,
		| ВЫРАЗИТЬ(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс КАК Справочник.упоРоли) КАК РольРесурса,
		| ВЫРАЗИТЬ(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс КАК Справочник.упоРоли).Представление КАК Initials,
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.КоличествоЧасов КАК Work
		|ИЗ
		| РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия КАК упоАктуальныеПланыТрудозатратСводноТекущаяВерсия
		|ГДЕ
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача В(&СписокПроектныхЗадач)
		| И упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс ССЫЛКА Справочник.упоРоли
		| И упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.УровеньПланирования = &УровеньПланирования";
	
	Запрос = Новый Запрос(ЗапросТекст);
	Запрос.УстановитьПараметр("СписокПроектныхЗадач", Параметры.СписокПроектныхЗадач);
	Запрос.УстановитьПараметр("УровеньПланирования", Параметры.УровеньПланированияТрудозатрат);
	
	Выборка = Запрос.Выполнить();
	
	Возврат Выборка;
	
