КонецФункции

Процедура ЗаполнитьОбъектXDTOЗначениямиXDTO(ОбъектXDTO, СоответствиеЗначенияXDTO)
	
	Для каждого ТекЭлемент Из СоответствиеЗначенияXDTO Цикл
		
		// Здесь записываются элементы первого уровня, они уже подготовлены.
		
		Если ТекЭлемент.Значение = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбъектXDTO[ТекЭлемент.Ключ] = ТекЭлемент.Значение;
		Исключение
		КонецПопытки
		
	КонецЦикла;
	
КонецПроцедуры

// Получаем Свойства и с помощью фабрики создаем Типы XDTO.
//
Функция ПолучитьСоответствиеТиповXDTO(Фабрика, ОбъектXDTO, Свойства)
	
	Соответствие = Новый Соответствие();
	
	// Свойства - КоллекцияСвойствXDTO.
	Для каждого ТекСвойство Из Свойства Цикл
		Соответствие.Вставить(ТекСвойство.Имя,ТекСвойство.Тип);
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПолучитьСоответствиеЗначенийXDTO(Фабрика, СоответствиеТиповXDTO, СоответствиеЗначения1С)
	
	Соответствие = Новый Соответствие();
	
	Для каждого ТекТип Из СоответствиеТиповXDTO Цикл
		
		Соответствие.Вставить(ТекТип.Ключ, СоздатьОбъектXDTO(Фабрика, ТекТип.Значение, СоответствиеЗначения1С[ТекТип.Ключ]));
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПолучитьТаблицаСвязейПроекта(Параметры, СтруктураДанных)
	
	ТаблицаСвязейПроекта = Неопределено;
	
	Если СтруктураДанных.Свойство("ТаблицаСвязейПроекта") И СтруктураДанных.ТаблицаСвязейПроекта.Количество()>0 Тогда
			
		ТаблицаСвязейПроекта = СтруктураДанных.ТаблицаСвязейПроекта; 
		// Индексация позволит ускорить процедуру НайтиСтроки().
		ТаблицаСвязейПроекта.Индексы.Добавить("КонецСвязи");
		
	Иначе
		
		Если Не (Параметры.ОсновнойПроект = Неопределено) Тогда
			ТаблицаСвязейПроекта = ПостроитьСписокСвязей(Параметры.ОсновнойПроект);
			// Индексация позволит ускорить процедуру НайтиСтроки().
			ТаблицаСвязейПроекта.Индексы.Добавить("КонецСвязи");

		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ТаблицаСвязейПроекта;
	
КонецФункции

Функция ЗаполнитьПостроительОтчетаВыделенныеТрудовыеРесурсы(Параметры)
	
	Построитель = Параметры.ПостроительОтчетаТрудРес;
	Построитель.Текст = "ВЫБРАТЬ ИСТИНА";
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Параметры.ТрудовыеРесурсыПроектныхЗадач.Выгрузить());
	
	Возврат Построитель;
	
КонецФункции

Функция СоздатьЗаполнитьОбъектXDTOProject(Параметры, ТипОбъекта,ТипВыгрузки)
	
	// Основное значение, по сути это проект который нам нужно наполнить данными из 1с, но в формате,
	// который воспримет MS Project.
	
	Фабрика = Параметры.Фабрика;
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Фабрика,ТипОбъекта); 
	ЗаполнитьЭлементыProjectПервогоУровня(ОбъектXDTO,ТипОбъекта,Параметры);
	
	// Calendars - Семейство календарей, связанных с проектом.
	ОбъектXDTO.Calendars			= СоздатьЗаполнитьОбъектXDTOCalendars(Параметры, ПолучитьТипСвойстваXDTO(ТипОбъекта,"Calendars"));
	
	// Tasks - Семейство задач, составляющих проект.
	ОбъектXDTO.Tasks 				= СоздатьЗаполнитьОбъектXDTOTasks(Параметры, ПолучитьТипСвойстваXDTO(ТипОбъекта,"Tasks"));
	
	// Resources - Семейство ресурсов, составляющих проект.
	ОбъектXDTO.Resources  			= СоздатьЗаполнитьОбъектXDTOResources(Параметры, ПолучитьТипСвойстваXDTO(ТипОбъекта,"Resources"),ТипВыгрузки);
	
	// Assignments - Связывает Задачи с ресурсами.
	ОбъектXDTO.Assignments 			= СоздатьЗаполнитьОбъектXDTOAssignments(Параметры, ПолучитьТипСвойстваXDTO(ТипОбъекта,"Assignments"),ТипВыгрузки);
	
	// OutlineCodes - Семейство определений кодов структуры, связанных с проектом;
	// эти коды могут быть сопоставлены скольким угодно проектам.
	ОбъектXDTO.OutlineCodes 		= СоздатьОбъектXDTO(Фабрика,ПолучитьТипСвойстваXDTO(ТипОбъекта,"OutlineCodes"));
	
	// WBSMasks  - Таблица элементов, определяющих маску кода структуры.
	ОбъектXDTO.WBSMasks 			= СоздатьОбъектXDTO(Фабрика,ПолучитьТипСвойстваXDTO(ТипОбъекта,"WBSMasks"));
	
	// ExtendedAttributes - Семейство определений расширенных атрибутов (настраиваемых полей), связанных с проектом.
	ОбъектXDTO.ExtendedAttributes 	= СоздатьОбъектXDTO(Фабрика,ПолучитьТипСвойстваXDTO(ТипОбъекта,"ExtendedAttributes"));
	
	Возврат ОбъектXDTO;
	
КонецФункции

Функция ПолучитьСоответствие1СДляProject(Параметры)
	
	Соответствие = Новый Соответствие();
	
	ЗапросТекст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	              	|	Проекты.Ссылка КАК Ссылка,
	              	|	Проекты.ПометкаУдаления КАК ПометкаУдаления,
	              	|	Проекты.Предопределенный КАК Предопределенный,
	              	|	Проекты.Родитель КАК Родитель,
	              	|	Проекты.Код КАК Код,
	              	|	Проекты.Наименование КАК Наименование,
	              	|	Проекты.Автор КАК Автор,
	              	|	Проекты.АвторИзменений КАК АвторИзменений,
	              	|	Проекты.ДатаМодификации КАК ДатаМодификации,
	              	|	Проекты.Организация КАК Организация,
	              	|	NULL КАК МетодРаспределения,
	              	|	NULL КАК Ответственный,
	              	|	Проекты.Комментарий КАК Комментарий,
	              	|	NULL КАК Описание,
	              	|	Проекты.ПолноеНаименование КАК ПолноеНаименование,
	              	|	Проекты.ПортфельПроектов КАК ПортфельПроектов,
	              	|	Проекты.ПрограммаПроектов КАК ПрограммаПроектов,
	              	|	Проекты.Подразделение КАК Подразделение,
	              	|	NULL КАК СпособРаспределения,
	              	|	Проекты.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу,
	              	|	NULL КАК СхемаСопоставленияОбъектов,
	              	|	NULL КАК СценарийПланирования,
	              	|	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача,
	              	|	Проекты.Представление КАК Представление
	              	|ПОМЕСТИТЬ ТекПроект
	              	|ИЗ
	              	|	Справочник.Проекты КАК Проекты
	              	|ГДЕ
	              	|	Проекты.Ссылка = &Проект
	              	|;
	              	|
	              	|////////////////////////////////////////////////////////////////////////////////
	              	|ВЫБРАТЬ
	              	|	МИНИМУМ(ВложенныйЗапрос.ДатаНачалаПлан) КАК ДатаНачалаПлан,
	              	|	МАКСИМУМ(ВложенныйЗапрос.ДатаЗавершенияПлан) КАК ДатаЗавершенияПлан
	              	|ПОМЕСТИТЬ ПроектныеЗадачиБезРодителя
	              	|ИЗ
	              	|	(ВЫБРАТЬ
	              	|		ЕСТЬNULL(СрокиПЗ.ДатаНачалаПлан, &ПустаяДата) КАК ДатаНачалаПлан,
	              	|		ЕСТЬNULL(СрокиПЗ.ДатаЗавершенияПлан, &ПустаяДата) КАК ДатаЗавершенияПлан
	              	|	ИЗ
	              	|		РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК СрокиПЗ
	              	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	              	|			ПО СрокиПЗ.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	              	|				И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)) КАК ВложенныйЗапрос
	              	|;
	              	|
	              	|////////////////////////////////////////////////////////////////////////////////
	              	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	              	|	ЕСТЬNULL(ТекПроект.Наименование, &ПустаяСтрока) КАК Name,
	              	|	ЕСТЬNULL(ТекПроект.Автор.Наименование, &ПустаяСтрока) КАК Author,
	              	|	ЕСТЬNULL(ТекПроект.Организация.Наименование, &ПустаяСтрока) КАК Company,
	              	|	ЕСТЬNULL(ТекПроект.ПолноеНаименование, &ПустаяСтрока) КАК Title,
	              	|	ЕСТЬNULL(упоРуководителиПроектовСрезПоследних.РуководительПроекта.Наименование, &ПустаяСтрока) КАК Manager,
	              	|	ЕСТЬNULL(ТекПроект.ДатаМодификации, &ПустаяДата) КАК CreationDate,
	              	|	ЕСТЬNULL(ТекПроект.СсылкаНаПроектнуюЗадачу.ОписаниеЗадачи, &ПустаяСтрока) КАК Subject,
	              	|	ЕСТЬNULL(ТекПроект.СсылкаНаПроектнуюЗадачу.Проект.ПортфельПроектов.Наименование, &ПустаяСтрока) КАК Category
	              	|ИЗ
	              	|	ТекПроект КАК ТекПроект,
	              	|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(&ДатаСреза, Проект = &Проект) КАК упоРуководителиПроектовСрезПоследних,
	              	|	ПроектныеЗадачиБезРодителя КАК ПроектныеЗадачиБезРодителя";
	
	Запрос = Новый Запрос(ЗапросТекст);
	
	Запрос.УстановитьПараметр("ДатаСреза",		Параметры.ДатаСреза);
	Запрос.УстановитьПараметр("ПустаяДата",		Параметры.ПустаяДата);
	Запрос.УстановитьПараметр("ПустаяСтрока",	Параметры.ПустаяСтрока);
	Запрос.УстановитьПараметр("Проект",			Параметры.ОсновнойПроект);
	Запрос.УстановитьПараметр("текВерсия",		упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Параметры.ОсновнойПроект));
	
	// <UID/> - Уникальный идентификатор проекта.
	Соответствие.Вставить("UID",0);
	// <CalendarUID/> - Уникальный идентификатор календаря, используемого в проекте - у нас всегда 1.
	Соответствие.Вставить("CalendarUID",1); 
	// FYStartDate - Месяц, с которого начинается финансовый год.
	Соответствие.Вставить("FYStartDate",1); 
	// <MinutesPerDay> Необязательный Количество минут в одном дне по умолчанию.
	Соответствие.Вставить("MinutesPerDay",480); 
	// <MinutesPerWeek> Необязательный Количество минут в одной неделе по умолчанию.
	Соответствие.Вставить("MinutesPerWeek",2400); 
	// <DaysPerMonth> Количество рабочих дней в месяце по умолчанию.
	Соответствие.Вставить("DaysPerMonth",20); 
	// <Revision> Количество операций сохранения проекта.
	Соответствие.Вставить("Revision",0); 
	// <LastSaved> Дата последнего сохранения проекта.
	Соответствие.Вставить("LastSaved",Параметры.ПустаяДата); 
	// <ScheduleFromStart> Указывает, планируется ли проект от даты начала или от даты окончания.
	Соответствие.Вставить("ScheduleFromStart",1); 
	// <CriticalSlackLimit> Число дней, которое может пройти после даты окончания задачи, прежде чем
	// Microsoft Office Project 2003 пометит ее как критическую задачу.
	Соответствие.Вставить("CriticalSlackLimit",0); 
	// <CurrencyDigits/> - Число цифр после десятичной запятой в денежных значениях, отображаемых в Project.
	Соответствие.Вставить("CurrencyDigits",2); 
	// <CurrencySymbol/> - Символ, который представляет тип валюты, используемый в проекте.
	Соответствие.Вставить("CurrencySymbol","р."); 
	// <CurrencySymbolPosition> Местоположение символа валюты по отношению к денежному значению.
	Соответствие.Вставить("CurrencySymbolPosition",1); // После, без пробела (по умолчанию): 0р.
	// <DefaultStartTime> Дата начала, принимаемая по умолчанию для всех новых задач.
	Соответствие.Вставить("DefaultStartTime", '00010101090000'); // 09:00:00.
	// <DefaultFinishTime> Дата окончания, принимаемая по умолчанию для всех новых задач.
	Соответствие.Вставить("DefaultFinishTime", '00010101180000');  // 18:00:00.
	// <ExtendedCreationDate> Дата, используемая для вычислений и для отчетов.
	Соответствие.Вставить("ExtendedCreationDate",'19840101000000');  // 1984-01-01T00:00:00.
	// <DefaultTaskType> Принятый по умолчанию тип новых задач.
	Соответствие.Вставить("DefaultTaskType",0);  
	// <DefaultFixedCostAccrual> Точка отсчета, относительно которой начисляются затраты.
	Соответствие.Вставить("DefaultFixedCostAccrual",3);
	// <DefaultStandardRate>  Стандартная ставка, принимаемая по умолчанию для новых ресурсов.
	Соответствие.Вставить("DefaultStandardRate",0);
	// <DefaultOvertimeRate>  Ставка сверхурочных работ, принимаемая по умолчанию для новых ресурсов.
	Соответствие.Вставить("DefaultOvertimeRate",0);
	// DurationFormat  - Формат длительности, используемый по умолчанию для всех параметров длительности в проекте.
	Соответствие.Вставить("DurationFormat",7); 
	// WorkFormat - Формат длительности, используемый по умолчанию для всех значений длительности рабочих
	// периодов в проекте.
	Соответствие.Вставить("WorkFormat",3); // В днях.
	// <EditableActualCosts> Указывает, выполняет ли Project автоматическое вычисление фактических затрат.
	Соответствие.Вставить("EditableActualCosts",0); 
	// <HonorConstraints/> - Указывает, планирует ли Project задачи согласно их датам ограничений вместо учета
	// зависимостей задач.
	Соответствие.Вставить("HonorConstraints",0);
	// <EarnedValueMethod/> - Способ расчета освоенного объема, используемый по умолчанию.
	Соответствие.Вставить("EarnedValueMethod",0);
	// <InsertedProjectsLikeSummary/> - Указывает, рассматриваются ли вставленные проекты как суммарные задачи,
	// а не как отдельные проекты при расчетах расписания.
	Соответствие.Вставить("InsertedProjectsLikeSummary",1);
	// <MultipleCriticalPaths/> - Указывает, будет ли Project вычислять и отображать критический путь для каждой
	// независимой сети задач в рамках проекта.
	Соответствие.Вставить("MultipleCriticalPaths",1);
	// <NewTasksEffortDriven/>.
	Соответствие.Вставить("NewTasksEffortDriven",1);
	// <NewTasksEstimated/> - Указывает, будут ли для новых задач устанавливаться предварительные оценки длительности.
	Соответствие.Вставить("NewTasksEstimated",1);
	// <SplitsInProgressTasks/>  - Указывает, можно ли прерывать задачи в ходе их выполнения.
	// <SpreadActualCost/>      - Указывает, распределяются ли фактические затраты равномерно вплоть
	// до даты отчета о состоянии.
	Соответствие.Вставить("SpreadActualCost",0);
	// <SpreadPercentComplete/>  - Указывает, распределяется ли процент завершения равномерно вплоть
	// до даты отчета о состоянии.
	Соответствие.Вставить("SpreadPercentComplete",1);
	// <TaskUpdatesResource/> - Указывает, приводит ли обновление задач к обновлению ресурсов.
    Соответствие.Вставить("TaskUpdatesResource",1);
	// <FiscalYearStart/>  - Указывает, используется ли нумерация финансовых годов.
	// <WeekStartDay/>  - День начала недели.
	Соответствие.Вставить("WeekStartDay",1);
	// <MoveCompletedEndsBack/> -    Указывает, будет ли при планировании конец завершенной части задач сдвигаться
	// к дате после даты отчета о состоянии, а раннее начало сдвигаться к дате отчета о состоянии.
	// <MoveRemainingStartsBack/>  - Указывает, будет ли при планировании начало оставшейся части задач сдвигаться
	// к дате после даты отчета о состоянии, а раннее начало сдвигаться к дате отчета о состоянии.
	// <MoveRemainingStartsForward/> - Указывает, будет ли начало оставшейся части задач сдвигаться к дате после
	// даты отчета о состоянии при планировании позднего начала.
	// <MoveCompletedEndsForward/>  - Указывает, будет ли при планировании конец завершенной части задач сдвигаться
	// к дате до даты отчета о состоянии, а позднее начало сдвигаться к дате отчета о состоянии.
	// <BaselineForEarnedValue/>    - Базовый план, используемый для вычисления значений отклонения.
	// <AutoAddNewResourcesAndTasks/>   - Указывает, будут ли новые ресурсы автоматически добавляться в пул ресурсов.
	Соответствие.Вставить("AutoAddNewResourcesAndTasks",1);
	// <StatusDate/>   - Дата, используемая для вычислений и для отчетов.
	Соответствие.Вставить("StatusDate",Параметры.ДатаСреза);
	// <CurrentDate/> - Системная дата, которая генерируется средствами XML.
	// <MicrosoftProjectServerURL/>  - Указывает, был ли проект создан пользователем Microsoft Office Project Server 2003
	// или пользователем Microsoft Windows NT.
	Соответствие.Вставить("MicrosoftProjectServerURL",1);
	// <Autolink/> - Указывает, выполняется ли автоматическое связывание добавленных или перемещенных задач.
	Соответствие.Вставить("Autolink",1);
	// <NewTaskStartDate/> - Дата начала новой задачи, используемая по умолчанию.
	Соответствие.Вставить("NewTaskStartDate",0);
	// <DefaultTaskEVMethod/> - Способ расчета освоенного объема для задач, используемый по умолчанию.
	Соответствие.Вставить("DefaultTaskEVMethod",0);
	// <ProjectExternallyEdited/> - Указывает, изменялся ли проект во внешнем приложении.
	Соответствие.Вставить("ProjectExternallyEdited", 0);
 	// <ActualsInSync/> - Указывает, была ли запись о трудозатратах синхронизирована с проектом.
	Соответствие.Вставить("ActualsInSync",1);
	// <RemoveFileProperties/> - Указывает, следует ли удалить сведения из свойств файла при сохранении.
	Соответствие.Вставить("RemoveFileProperties",0);
	// <AdminProject/> - Указывает, является ли проект административным проектом.
	Соответствие.Вставить("AdminProject",0);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Следующий() Тогда
		
		// <Name/>;
		// <Title/>;
		// <Company/>;
		// <Manager/>;
		// <Author/>;
		// <CreationDate/>;
		// <StartDate/>;
		// <FinishDate/>;
		// <Subject/> - Тема проекта;
		// <Category/>  - в нашем случае - портфель проектов.
		Для каждого Колонка Из Таблица.Колонки Цикл
			Соответствие.Вставить(Колонка.Имя,Выборка[Колонка.Имя]);
		КонецЦикла;
		
	КонецЕсли;
	
	// Вычисляем минимальную дату старта и финиша.
	
	КопияТабЗадачи = Параметры.Задачи.Скопировать();
	Если КопияТабЗадачи.Количество() > 0 Тогда
		Если Не ЗначениеЗаполнено(Соответствие["StartDate"]) Тогда
			КопияТабЗадачи.Сортировать("Start");
			Соответствие.Вставить("StartDate", НачалоДня(КопияТабЗадачи[0].Start));
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(Соответствие["FinishDate"]) Тогда
			КопияТабЗадачи.Сортировать("Finish  Убыв");
			Соответствие.Вставить("FinishDate", КонецДня(КопияТабЗадачи[0].Finish));
		КонецЕсли;	
	КонецЕсли; 
	
	Возврат Соответствие;
	
КонецФункции

