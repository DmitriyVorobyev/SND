		Секунды = ИтогоРабочихСекунд - Часы*3600 - Минуты*60;
		
		ЗначениеMSProject = "PT" + ?(Часы=0, "0", Формат(Часы, "ЧГ=0"))
			+ "H" + ?(Минуты = 0, "0", Формат(Минуты,"ЧГ=0")) + "M" + ?(Секунды = 0, "0", Формат(Секунды, "ЧГ=0")) + "S";
	КонецЕсли;
	
	Возврат ЗначениеMSProject;
	
КонецФункции

Процедура ДобавитьСтрокуВерсииXML(Файл, ИмяФайлаXML, ВыводитьСообщения)

	Файл.Прочитать(ИмяФайлаXML);
	ТекстНачала = "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes"" ?> " + Символы.ПС;
	Файл.УстановитьТекст(ТекстНачала + Файл.ПолучитьТекст());
	Файл.Записать(ИмяФайлаXML);
	
	Если ВыводитьСообщения Тогда
		НСтрока = НСтр("ru = 'Записан файл XML ""Project"": %1'");
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, ИмяФайлаXML);
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

// Сначала создается объект ЧтениеXML и открывается файл XML, расположенный на диске.
// После этого с помощью построителя документа DOM, создается объект ДокументDOM, 
// содержащий данные файла XML. Затем с помощью построителя схемы XML на основе документа 
// DOM создается новый объект СхемаXML, содержащий данные схемы XML. В заключении создается 
// пустой набор схем XML, в который добавляется имеющаяся схема XML, и на основании этого набора
// создается фабрика XDTO.
Функция СоздатьФабрикуXDTOнаОсновеСхемыXSD(ИмяФайлаXSD)
	
	// Создать объект чтения XML по умолчанию.
	ЧтениеXMLСхемаXSD = Новый ЧтениеXML;
	
	// Открыть файл XML.
	ЧтениеXMLСхемаXSD.ОткрытьФайл(ИмяФайлаXSD);
	
	// Создать построитель документа DOM по умолчанию.
	ПостроительDOMСхемаXSD = Новый ПостроительDOM;
	
	// Прочитать файл XML в документ DOM.
	НовыйДокументDOM = ПостроительDOMСхемаXSD.Прочитать(ЧтениеXMLСхемаXSD);
	
	// Создать построитель схемы XML по умолчанию.
	ПостроительСхемыXML = Новый ПостроительСхемXML;
	
	// Получить схему XML из документа DOM.
	НоваяСхемаXML = ПостроительСхемыXML.СоздатьСхемуXML(НовыйДокументDOM);
	
	// Создать набор схем XML по умолчанию.
	НовыйНаборСхемXML = Новый НаборСхемXML;
	
	// Добавить схему XML в набор схем XML.
	НовыйНаборСхемXML.Добавить(НоваяСхемаXML);
	
	// Создать фабрику XDTO на основе набора схем XML.
	НоваяФабрикаXDTO = Новый ФабрикаXDTO(НовыйНаборСхемXML);	
	
	Возврат НоваяФабрикаXDTO;
	
КонецФункции

Функция СоздатьВременныйФайл(Расширение, ИмяФайла = "")
	
	Файл = Неопределено;
	
	Попытка
		
		ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
		Файл =  Новый ТекстовыйДокумент;
		Файл.Записать(ИмяФайла);
		
	Исключение
		
		НСтрока = НСтр("ru = 'Не удалось создать временный файл:
                        |%1'");
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, ОписаниеОшибки());
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	Возврат Файл;
	
КонецФункции

Функция СоздатьCхемаXSDProject(ВыводитьСообщения = Ложь, ВерсияMSProject)
	
	Если ВерсияMSProject >= 15 Тогда
		ИмяМакета = "упоCхемаXSDProject2013_for1c";
	Иначе
		ИмяМакета = "упоCхемаXSDProject_for1c";
	КонецЕсли;
	
	// Загружаем адаптированную схему - тип xsd:boolean заменен на xsd:integer.
    Если Метаданные.ОбщиеМакеты.Найти(ИмяМакета) = Неопределено Тогда 
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'В конфигураторе не найдена схема XSD для печати в MS Project'");
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстCхемаXSDProject = ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст();
	                                      
	ИмяФайла = "";
	Файл = СоздатьВременныйФайл("xsd",ИмяФайла);
	Если Файл = Неопределено Тогда  
		Возврат Неопределено;
	КонецЕсли;	
	
	Файл.УстановитьТекст(ТекстCхемаXSDProject);
	
	Файл.Записать(ИмяФайла);
	
	Если ВыводитьСообщения Тогда 
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Создана схема XSD ""Project"": '") + ИмяФайла;
		Сообщение.Сообщить();
	КонецЕсли;
	
	Возврат ИмяФайла;
	
КонецФункции

Функция ЗапросСписокСвязейПроекта()
	
	// Сразу в запросе будем определять, какой именно тип связи типы следующие:
	//
	// Задача -> Задача.
	//
	// Тип связи будет нужен при построении хитрой диаграммы Ганта
	// (встраивание вех в дерево задач).
	
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	РегСвязи.ПроектнаяЗадача КАК КонецСвязи,
	        |	РегСвязи.ЗадачаПредшественник КАК НачалоСвязи,
	        |	РегСвязи.ТипСвязи КАК ТипСвязиЭлементов,
	        |	РегСвязи.Задержка КАК Задержка,
	        |	ВЫБОР
	        |		КОГДА (ВЫРАЗИТЬ(РегСвязи.ЗадачаПредшественник КАК Документ.упоПроектнаяЗадача)) = РегСвязи.ЗадачаПредшественник
	        |			ТОГДА 1
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК ТипСвязи
	        |ИЗ
	        |	РегистрСведений.упоПредусловияПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК РегСвязи
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК СвойстваПредшественника
	        |		ПО РегСвязи.ЗадачаПредшественник = СвойстваПредшественника.ПроектнаяЗадача
	        |			И (НЕ СвойстваПредшественника.ЗадачаОтменена)
	        |ГДЕ
	        |	РегСвязи.СвязьСуществует
	        |	И НЕ РегСвязи.СвязьМеждуПроектами";    
	
КонецФункции

Функция ПолучитьПараметрыВыгрузки(СтруктураДанных, ИмяФайлаСхемаXSD, ТипВыгрузки)
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("ВерсияMSProject",СтруктураДанных.ВерсияMSProject);
	Если СтруктураДанных.ВерсияMSProject >= 15 Тогда
		Параметры.Вставить("URIПространствоИменMSP", 	"http://schemas.microsoft.com/project");
	Иначе
		Параметры.Вставить("URIПространствоИменMSP", 	"http://schemas.microsoft.com/project/2007");
	КонецЕсли;
	Параметры.Вставить("Фабрика",					СоздатьФабрикуXDTOнаОсновеСхемыXSD(ИмяФайлаСхемаXSD));
	
 	Параметры.Вставить("ТипОбъектаProject",			ПолучитьТипОбъектаProject(Параметры));
	// По умолчанию - Project и Calendar = 0 и 1; — это уникальный идентификатор.
	// Его можно использовать в записи данных для всех его родительских элементов.
	Параметры.Вставить("СчетчикUID",				1); 
	Параметры.Вставить("ПустаяДата",				'00010101');
	Параметры.Вставить("ПустаяСтрока",				"");
	Параметры.Вставить("TasksID",					1); // Это указатель позиции задачи в списке задач.
	Параметры.Вставить("ResourcesID",				1); // Это указатель позиции ресурса в списке ресурсов.
	Параметры.Вставить("СоответствиеTasksUID",		Новый Соответствие);
	Параметры.Вставить("СоответствиеResourcesUID",	Новый Соответствие);
	Параметры.Вставить("ПостроительОтчетаТрудРес",	Новый ПостроительОтчета);
	
	ДатаСреза = ?(СтруктураДанных.Свойство("ДатаСреза"),
		?(ЗначениеЗаполнено(СтруктураДанных.ДатаСреза), СтруктураДанных.ДатаСреза, ТекущаяДатаСеанса()), ТекущаяДатаСеанса());
	
	// Элементы могут придти из структуры или их нужно будет собирать уже здесь.
	Параметры.Вставить("ОсновнойПроект",
		?(СтруктураДанных.Свойство("Проект"), СтруктураДанных.Проект, Неопределено));
	Параметры.Вставить("ТекущаяВерсияОсновногоПроекта", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Параметры.ОсновнойПроект));
	Параметры.Вставить("ДатаСреза",	ДатаСреза);
	Параметры.Вставить("ТаблицаСвязейПроекта", ПолучитьТаблицаСвязейПроекта(Параметры, СтруктураДанных));
	Параметры.Вставить("Задачи", ПолучитьТаблицаЗадач(Параметры, СтруктураДанных));
	Параметры.Вставить("СуммирующиеЗадачи", ПолучитьСуммирующиеЗадачи(Параметры,СтруктураДанных));	
	
	// Нужно для того чтобы проджект давал ставить границы задачи на выходные дни.
	Параметры.Вставить("ТаблицаИсключенийДат", ПолучитьТаблицуИсключенийДат(Параметры,СтруктураДанных));	
	
	Параметры.Вставить("УровеньПланированияТрудозатрат", СтруктураДанных.УровеньПланированияТрудозатрат);
	Если ТипВыгрузки = 2 Тогда
		Параметры.Вставить("СписокПроектныхЗадач", ПолучитьСписокПроектныхЗадач(Параметры.Задачи));
		Параметры.Вставить("ВыделенныеТрудовыеРесурсы",
			?(СтруктураДанных.Свойство("ВыделенныеТрудовыеРесурсы"),
			СтруктураДанных.ВыделенныеТрудовыеРесурсы, ПолучитьПустыеВыделенныеТрудовыеРесурсы(Параметры)));
		Параметры.Вставить("ТрудовыеРесурсыПроектныхЗадач",
			?(СтруктураДанных.Свойство("ТрудовыеРесурсыПроектныхЗадач"),
			СтруктураДанных.ТрудовыеРесурсыПроектныхЗадач, ПолучитьПустыеВыделенныеТрудовыеРесурсы(Параметры)));
	ИначеЕсли ТипВыгрузки = 1 Тогда 
		Параметры.Вставить("СписокПроектныхЗадач", ПолучитьСписокПроектныхЗадач(Параметры.Задачи));	
		Параметры.Вставить("ВыделенныеТрудовыеРесурсы",
			?(СтруктураДанных.Свойство("ВыделенныеТрудовыеРесурсы"),
			СтруктураДанных.ВыделенныеТрудовыеРесурсы, ПолучитьВыделенныеТрудовыеРесурсы(Параметры)));
		Параметры.Вставить("ТрудовыеРесурсыПроектныхЗадач",
			?(СтруктураДанных.Свойство("ТрудовыеРесурсыПроектныхЗадач"),
			СтруктураДанных.ТрудовыеРесурсыПроектныхЗадач, ПолучитьТрудовыеРесурсыПроектныхЗадач(Параметры)));
	Иначе 
		Параметры.Вставить("СписокПроектныхЗадач", ПолучитьСписокПроектныхЗадач(Параметры.Задачи));
		Параметры.Вставить("ВыделенныеТрудовыеРесурсы",
			?(СтруктураДанных.Свойство("ВыделенныеТрудовыеРесурсы"),
			СтруктураДанных.ВыделенныеТрудовыеРесурсы, ПолучитьВыделенныеТрудовыеРоли(Параметры)));
		Параметры.Вставить("ТрудовыеРесурсыПроектныхЗадач",
			?(СтруктураДанных.Свойство("ТрудовыеРесурсыПроектныхЗадач"),
			СтруктураДанных.ТрудовыеРесурсыПроектныхЗадач, ПолучитьТрудовыеРолиПроектныхЗадач(Параметры)));			
	КонецЕсли;
	
	Параметры.Вставить("ПостроительОтчетаТрудРес", ЗаполнитьПостроительОтчетаВыделенныеТрудовыеРесурсы(Параметры));
	
	ЗаполнитьДанныеПоКалендарям(Параметры);
	
	Возврат Параметры;
	
КонецФункции

Процедура ЗаполнитьДанныеПоКалендарям(Параметры)
	
	ДатаНачала = Дата('00010101');
	ДатаОкончания = Дата('00010101');
	Для Каждого Задача Из Параметры.Задачи Цикл
		Если ЗначениеЗаполнено(Задача.Start) Тогда
			Если ЗначениеЗаполнено(ДатаНачала) Тогда				
				ДатаНачала = Мин(Задача.Start, ДатаНачала);
			Иначе
				ДатаНачала = Задача.Start;
			КонецЕсли;
		КонецЕсли;		
		ДатаОкончания = Макс(Задача.Finish, ДатаОкончания);
	КонецЦикла;
	
	// Запросом найдем рабочую неделю, выходные, праздники, сокращенные дни.
	// Выходные, праздники и сокращенные дни должны попасть в исключения
	// Рабочую неделю ищем по максимальному количеству дней недели с одинаковой длительностью
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоВерсииПроекта.Версия КАК Версия
	|ПОМЕСТИТЬ ВерсияПроекта
	|ИЗ
	|	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|ГДЕ
	|	упоВерсииПроекта.Проект = &Проект
	|	И упоВерсииПроекта.Текущая
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоКалендариПроектовСрезПоследних.Проект КАК Проект,
	|	упоКалендариПроектовСрезПоследних.КалендарьПроекта КАК Календарь
	|ПОМЕСТИТЬ КалендарьПроекта
	|ИЗ
	|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК упоКалендариПроектовСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КалендарьПроекта.Проект КАК ПроектИлиПроектнаяЗадача,
	|	КалендарьПроекта.Календарь КАК Календарь,
	|	ЛОЖЬ КАК ДлительностьБезУчетаКалендаряПроекта
	|ПОМЕСТИТЬ КалендариПроектаИПроектныхЗадач
	|ИЗ
	|	КалендарьПроекта КАК КалендарьПроекта
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача,
	|	ВЫБОР
	|		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
	|			ТОГДА КалендарьПроекта.Календарь
	|		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи
	|	КОНЕЦ,
	|	упоСвойстваПроектныхЗадачСрезПоследних.ДлительностьБезУчетаКалендаряПроекта
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	|			,
	|			Версия В
	|					(ВЫБРАТЬ
	|						т.Версия
	|					ИЗ
	|						ВерсияПроекта КАК т)
	|				И ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК упоСвойстваПроектныхЗадачСрезПоследних,
	|	КалендарьПроекта КАК КалендарьПроекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоРабочиеКалендариСрезПоследних.Календарь КАК Календарь,
	|	упоРабочиеКалендариСрезПоследних.День КАК День,
	|	упоРабочиеКалендариСрезПоследних.КоличествоЧасов КАК КоличествоЧасов,
	|	ДЕНЬНЕДЕЛИ(упоРабочиеКалендариСрезПоследних.День) КАК ДеньНедели
	|ПОМЕСТИТЬ КалендариСДнямиНедели
	|ИЗ
	|	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	|			,
	|			День МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаНачала, НЕДЕЛЯ) И КОНЕЦПЕРИОДА(&ДатаОкончания, НЕДЕЛЯ)
	|				И Календарь В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						т.Календарь
	|					ИЗ
	|						КалендариПроектаИПроектныхЗадач КАК т)) КАК упоРабочиеКалендариСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КалендариСДнямиНедели.Календарь КАК Календарь,
	|	КалендариСДнямиНедели.КоличествоЧасов КАК КоличествоЧасов,
	|	КалендариСДнямиНедели.ДеньНедели КАК ДеньНедели,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КалендариСДнямиНедели.День) КАК КоличествоРазличныхДней
	|ПОМЕСТИТЬ КоличествоРазличныхДнейСОдинаковымКоличествомЧасов
	|ИЗ
	|	КалендариСДнямиНедели КАК КалендариСДнямиНедели
	|
	|СГРУППИРОВАТЬ ПО
	|	КалендариСДнямиНедели.Календарь,
	|	КалендариСДнямиНедели.КоличествоЧасов,
	|	КалендариСДнямиНедели.ДеньНедели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь КАК Календарь,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели КАК ДеньНедели,
	|	МАКСИМУМ(КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоРазличныхДней) КАК КоличествоРазличныхДней
	|ПОМЕСТИТЬ ДниНеделиСМаксимальнымКоличествомОдинаковыхЧасовРаботы
	|ИЗ
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов КАК КоличествоРазличныхДнейСОдинаковымКоличествомЧасов
	|
	|СГРУППИРОВАТЬ ПО
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь КАК Календарь,
	|	МАКСИМУМ(КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоЧасов) КАК КоличествоЧасов,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели КАК ДеньНедели,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоРазличныхДней КАК КоличествоРазличныхДней
	|ПОМЕСТИТЬ РабочаяНеделя
	|ИЗ
	|	ДниНеделиСМаксимальнымКоличествомОдинаковыхЧасовРаботы КАК ДниНеделиСМаксимальнымКоличествомОдинаковыхЧасовРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоРазличныхДнейСОдинаковымКоличествомЧасов КАК КоличествоРазличныхДнейСОдинаковымКоличествомЧасов
	|		ПО ДниНеделиСМаксимальнымКоличествомОдинаковыхЧасовРаботы.Календарь = КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь
	|			И ДниНеделиСМаксимальнымКоличествомОдинаковыхЧасовРаботы.ДеньНедели = КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели
	|			И ДниНеделиСМаксимальнымКоличествомОдинаковыхЧасовРаботы.КоличествоРазличныхДней = КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоРазличныхДней
	|
	|СГРУППИРОВАТЬ ПО
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоРазличныхДней
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь КАК Календарь,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоЧасов КАК КоличествоЧасов,
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели КАК ДеньНедели
	|ПОМЕСТИТЬ Исключения
	|ИЗ
	|	КоличествоРазличныхДнейСОдинаковымКоличествомЧасов КАК КоличествоРазличныхДнейСОдинаковымКоличествомЧасов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РабочаяНеделя КАК РабочаяНеделя
	|		ПО КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.Календарь = РабочаяНеделя.Календарь
	|			И КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.ДеньНедели = РабочаяНеделя.ДеньНедели
	|			И КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоРазличныхДней = РабочаяНеделя.КоличествоРазличныхДней
	|			И КоличествоРазличныхДнейСОдинаковымКоличествомЧасов.КоличествоЧасов = РабочаяНеделя.КоличествоЧасов
	|ГДЕ
	|	РабочаяНеделя.Календарь ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Исключения.Календарь КАК Календарь,
	|	Исключения.КоличествоЧасов КАК КоличествоЧасов,
	|	Исключения.ДеньНедели КАК ДеньНедели,
	|	КалендариСДнямиНедели.День КАК День
	|ИЗ
	|	Исключения КАК Исключения
	|		ЛЕВОЕ СОЕДИНЕНИЕ КалендариСДнямиНедели КАК КалендариСДнямиНедели
	|		ПО Исключения.Календарь = КалендариСДнямиНедели.Календарь
	|			И Исключения.КоличествоЧасов = КалендариСДнямиНедели.КоличествоЧасов
	|			И Исключения.ДеньНедели = КалендариСДнямиНедели.ДеньНедели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочаяНеделя.Календарь КАК Календарь,
	|	РабочаяНеделя.КоличествоЧасов КАК КоличествоЧасов,
	|	РабочаяНеделя.ДеньНедели КАК ДеньНедели,
	|	РабочаяНеделя.Календарь.Наименование КАК НаименованиеКалендаря
	|ИЗ
	|	РабочаяНеделя КАК РабочаяНеделя
	|ИТОГИ ПО
	|	Календарь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КалендариПроектаИПроектныхЗадач.ПроектИлиПроектнаяЗадача КАК ПроектИлиПроектнаяЗадача,
	|	КалендариПроектаИПроектныхЗадач.Календарь КАК Календарь,
	|	КалендариПроектаИПроектныхЗадач.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта
	|ИЗ
	|	КалендариПроектаИПроектныхЗадач КАК КалендариПроектаИПроектныхЗадач";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Проект", Параметры.ОсновнойПроект);
	Запрос.УстановитьПараметр("ПроектныеЗадачи", Параметры.СписокПроектныхЗадач);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ИндексПоследнегоЭлемента = РезультатЗапроса.ВГраница();
	
	КалендариПроектаИПЗ = РезультатЗапроса[ИндексПоследнегоЭлемента].Выбрать();
	РабочаяНеделяКалендарей = 
		РезультатЗапроса[ИндексПоследнегоЭлемента - 1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ИсключенияКалендарей = РезультатЗапроса[ИндексПоследнегоЭлемента - 2].Выгрузить();
	
	ЗадачиСДлительностьюБезУчетаКалендаря = Новый Соответствие;
	СоответствиеПроектаПЗИКалендаря = Новый Соответствие;
	Пока КалендариПроектаИПЗ.Следующий() Цикл
		Если КалендариПроектаИПЗ.ДлительностьБезУчетаКалендаряПроекта Тогда
			ЗадачиСДлительностьюБезУчетаКалендаря.Вставить(КалендариПроектаИПЗ.ПроектИлиПроектнаяЗадача);
			Продолжить;
		КонецЕсли;
		СоответствиеПроектаПЗИКалендаря.Вставить(КалендариПроектаИПЗ.ПроектИлиПроектнаяЗадача, 
			КалендариПроектаИПЗ.Календарь);			
	КонецЦикла;
	
	СоответствиеКалендаряИЕгоУИДа = Новый Соответствие;
	
	УИДКалендаря = 1;
	КоличествоСекундВЧасе = 3600;
	СвойстваКалендарей = Новый Соответствие;
	ШаблонНаименования = "%1 (PM)";
	Пока РабочаяНеделяКалендарей.Следующий() Цикл
		Календарь = РабочаяНеделяКалендарей.Календарь;
		
		СвойстваКалендаря = Новый Соответствие;
		СвойстваКалендаря.Вставить("UID" , УИДКалендаря);
		НаименованиеКалендаря = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонНаименования,
			РабочаяНеделяКалендарей.НаименованиеКалендаря);
		СвойстваКалендаря.Вставить("Name" , НаименованиеКалендаря);
		СвойстваКалендаря.Вставить("IsBaseCalendar" , 1);
		СвойстваКалендаря.Вставить("BaseCalendarUID" , -1);
		СоответствиеКалендаряИЕгоУИДа.Вставить(Календарь, УИДКалендаря);
		
		ЗаполнитьДниРабочейНедели(СвойстваКалендаря, РабочаяНеделяКалендарей, КоличествоСекундВЧасе);		
		ЗаполнитьИсключенияКалендаря(СвойстваКалендаря, Календарь, ИсключенияКалендарей, КоличествоСекундВЧасе);		
		
		СвойстваКалендарей.Вставить(Календарь, СвойстваКалендаря);		
		УИДКалендаря = УИДКалендаря + 1;
		
	КонецЦикла;	           	
	
	Если ЗадачиСДлительностьюБезУчетаКалендаря.Количество() > 0 Тогда
		ЗаполнитьКалендарь24Часа(СвойстваКалендарей, СоответствиеКалендаряИЕгоУИДа, СоответствиеПроектаПЗИКалендаря,
			УИДКалендаря, ЗадачиСДлительностьюБезУчетаКалендаря)		
	КонецЕсли;
	
	Параметры.Вставить("СоответствиеПроектаПЗИКалендаря", СоответствиеПроектаПЗИКалендаря);
	Параметры.Вставить("СоответствиеКалендаряИЕгоУИДа", СоответствиеКалендаряИЕгоУИДа);
	Параметры.Вставить("СвойстваКалендарей", СвойстваКалендарей);	
	
КонецПроцедуры

Процедура ЗаполнитьКалендарь24Часа(СвойстваКалендарей, СоответствиеКалендаряИЕгоУИДа, СоответствиеПроектаПЗИКалендаря,
	УИДКалендаря, ЗадачиСДлительностьюБезУчетаКалендаря)
	
	СвойстваКалендаря = Новый Соответствие;
	СвойстваКалендаря.Вставить("UID" , УИДКалендаря); 
	СвойстваКалендаря.Вставить("Name" , НСтр("ru = '24 часа (PM)'"));
	СвойстваКалендаря.Вставить("IsBaseCalendar" , 1);
	СвойстваКалендаря.Вставить("BaseCalendarUID" , -1);
	
	ДниРабНедели = Новый Соответствие;
	Для Итератор = 1 По 7 Цикл
		РабочееВремя = Новый Структура;		 
		РабочееВремя.Вставить("FromTime", '00010101000000');				
		РабочееВремя.Вставить("ToTime",   '00010101000000');					
		ДниРабНедели.Вставить(Итератор, РабочееВремя);
	КонецЦикла;
	СвойстваКалендаря.Вставить("WorkingTimes", ДниРабНедели);
	
	Исключения = Новый Массив;
	СвойстваКалендаря.Вставить("ИсключенияКалендаря", Исключения);
	
	СвойстваКалендарей.Вставить(УИДКалендаря, СвойстваКалендаря);
	СоответствиеКалендаряИЕгоУИДа.Вставить(УИДКалендаря, УИДКалендаря);
	
	Для Каждого Задача Из ЗадачиСДлительностьюБезУчетаКалендаря Цикл
		СоответствиеПроектаПЗИКалендаря.Вставить(Задача.Ключ, УИДКалендаря);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИсключенияКалендаря(СвойстваКалендаря, Календарь, ИсключенияКалендарей, КоличествоСекундВЧасе)
	
	ИсключенияКалендаря = ИсключенияКалендарей.НайтиСтроки(Новый Структура("Календарь", Календарь));		
	Исключения = Новый Массив;
	Для Каждого Строка Из ИсключенияКалендаря Цикл
		
		РабочееВремя = Новый Структура;
		
		Если Строка.КоличествоЧасов = 0 Тогда
			РабочееВремя.Вставить("DayWorking", 0);
		Иначе
			РабочееВремя.Вставить("DayWorking", 1);				
			РабочееВремя.Вставить("FromTime", Строка.День);
			РабочееВремя.Вставить("ToTime", Строка.День + Строка.КоличествоЧасов * КоличествоСекундВЧасе);
		КонецЕсли;
		
		РабочееВремя.Вставить("НачалоДня", Строка.День);
		РабочееВремя.Вставить("КонецДня", КонецДня(Строка.День));
		
		Исключения.Добавить(РабочееВремя);
		
	КонецЦикла;
	
	СвойстваКалендаря.Вставить("ИсключенияКалендаря", Исключения);	
	
КонецПроцедуры

Процедура ЗаполнитьДниРабочейНедели(СвойстваКалендаря, РабочаяНеделяКалендарей, КоличествоСекундВЧасе)
	
	ДниРабНедели = Новый Соответствие;
	РабочаяНеделяКалендаря = РабочаяНеделяКалендарей.Выбрать();
	Пока РабочаяНеделяКалендаря.Следующий() Цикл
		// Неделя должна начинаться с Воскресенья, т.е. Воскресенье это 1 день недели, а не последний(седьмой)
		ДеньНедели = РабочаяНеделяКалендаря.ДеньНедели;
		Если ДеньНедели = 7 Тогда
			ДеньНедели = 0;
		КонецЕсли;	
		ДеньНедели = ДеньНедели + 1;
		РабочееВремя = Новый Структура;		
		Если РабочаяНеделяКалендаря.КоличествоЧасов <> 0 Тогда 
			РабочееВремя.Вставить("FromTime", '00010101000000');				
			РабочееВремя.Вставить("ToTime", '00010101000000' + РабочаяНеделяКалендаря.КоличествоЧасов * КоличествоСекундВЧасе);    
		КонецЕсли;			
		ДниРабНедели.Вставить(ДеньНедели, РабочееВремя);
		
	КонецЦикла;	
	
	СвойстваКалендаря.Вставить("WorkingTimes", ДниРабНедели);
		
КонецПроцедуры

Функция ПолучитьТаблицаЗадач(Параметры, СтруктураДанных)
	
	ТаблицаЗадач = ?(СтруктураДанных.Свойство("Задачи"), СтруктураДанных.Задачи, ПолучитьВсеTasks(Параметры));	
	
	КолонкаСДР = ТаблицаЗадач.Колонки.Найти("КодСДР");
	Если Не КолонкаСДР = Неопределено Тогда КолонкаСДР.Имя = "WBS" КонецЕсли;
	
	КолонкаЗадачаРодитель = ТаблицаЗадач.Колонки.Найти("ЗадачаРодитель");
	Если Не КолонкаЗадачаРодитель = Неопределено Тогда КолонкаЗадачаРодитель.Имя = "Родитель" КонецЕсли;
	
	КолонкаДатаНачалаПлан = ТаблицаЗадач.Колонки.Найти("ДатаНачалаПлан");
	Если Не КолонкаДатаНачалаПлан = Неопределено Тогда КолонкаДатаНачалаПлан.Имя = "Start" КонецЕсли;
	
	КолонкаДатаЗавершенияПлан = ТаблицаЗадач.Колонки.Найти("ДатаЗавершенияПлан");
	Если Не КолонкаДатаЗавершенияПлан = Неопределено Тогда КолонкаДатаЗавершенияПлан.Имя = "Finish" КонецЕсли;
	
	КолонкаСДР = ТаблицаЗадач.Колонки.Найти("НазваниеПроектнойЗадачи");
	Если Не КолонкаСДР = Неопределено Тогда КолонкаСДР.Имя = "Name" КонецЕсли;
	
	КолонкаОписание = ТаблицаЗадач.Колонки.Найти("Описание");
	Если КолонкаОписание = Неопределено Тогда
		МассивТипов = Новый Массив();
		МассивТипов.Добавить(Тип("Строка"));
		ТаблицаЗадач.Колонки.Добавить("Описание",Новый ОписаниеТипов(МассивТипов));
	КонецЕсли;
	
	// Присвоим ID задачам.
	ТаблицаЗадач.Колонки.Добавить("UID");
	ТаблицаЗадач.Колонки.Добавить("ID");
	
	Для каждого СтрокаЗадача Из ТаблицаЗадач Цикл
		
		СтрокаЗадача.UID = Параметры.СчетчикUID;
		// ID - отвечает за то в какой строке будет стоять задача, например если  ID = 6 то задачи начнуться с 6-й строки.
		СтрокаЗадача.ID  = Параметры.TasksID;
		
		Параметры.СоответствиеTasksUID.Вставить(СтрокаЗадача.ПроектнаяЗадача, СтрокаЗадача.ID);	
		
		УвеличитьСчетчикUID(Параметры);
		УвеличитьСчетчикID(Параметры)
		
	КонецЦикла; 
	
	Если СтруктураДанных.Свойство("РучныеСроки") И СтруктураДанных.РучныеСроки Тогда
		ТаблицаЗадач.ЗаполнитьЗначения(Истина, "РучнойВводСроков");	
	КонецЕсли;
	
	Возврат ТаблицаЗадач;
	
КонецФункции

Функция ПолучитьСуммирующиеЗадачи(Параметры,СтруктураДанных)
	
	Если ТипЗнч(Параметры.Задачи) = Тип("ТаблицаЗначений") Тогда
		
		ТаблицаСуммирующихЗадач = Новый ТаблицаЗначений;
		ТаблицаСуммирующихЗадач =  Параметры.Задачи.Скопировать();
		Если Не ТаблицаСуммирующихЗадач.Колонки.Найти("Родитель") = Неопределено    Тогда
			
			ОтборСтрок = Новый Структура("Родитель",Документы.упоПроектнаяЗадача.ПустаяСсылка());
			МассивСтрок = ТаблицаСуммирующихЗадач.НайтиСтроки(ОтборСтрок);
			
			Для каждого СтрокаМассивСтрок Из МассивСтрок  Цикл
				
				   ТаблицаСуммирующихЗадач.Удалить(СтрокаМассивСтрок);
			КонецЦикла; 
			
			ТаблицаСуммирующихЗадач.Свернуть("Родитель");
			
			Возврат ТаблицаСуммирующихЗадач.ВыгрузитьКолонку("Родитель");
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьТаблицуИсключенийДат(Параметры,СтруктураДанных)
	
	ТаблицаИсключенийДат = ?(СтруктураДанных.Свойство("ТаблицаИсключенийДат"), СтруктураДанных.ТаблицаИсключенийДат,
		Новый ТаблицаЗначений);	
	
	ТаблицаИсключенийДат.Колонки.Добавить("FromDate");
	ТаблицаИсключенийДат.Колонки.Добавить("ToDate");
	
	// На текущий момент считаем что выходные у нас это сб. вс.
	// Надо сделать привязку к календарю проекта.
	Для каждого СтрокаЗадача Из Параметры.Задачи Цикл
		
		Если ДеньНедели(СтрокаЗадача.Start) = 6 ИЛИ ДеньНедели(СтрокаЗадача.Start) = 7 Тогда
			
			СтрокаИсключения = ТаблицаИсключенийДат.Добавить();
			СтрокаИсключения.FromDate = НачалоДня(СтрокаЗадача.Start); 
			СтрокаИсключения.ToDate = КонецДня(СтрокаЗадача.Start);
		КонецЕсли;	
		
		Если ДеньНедели(СтрокаЗадача.Finish) = 6 ИЛИ ДеньНедели(СтрокаЗадача.Finish) = 7 Тогда
			
			СтрокаИсключения = ТаблицаИсключенийДат.Добавить();
			СтрокаИсключения.FromDate = НачалоДня(СтрокаЗадача.Finish); 
			СтрокаИсключения.ToDate = КонецДня(СтрокаЗадача.Finish);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ТаблицаИсключенийДат.Свернуть("FromDate,ToDate");
	
	Возврат ТаблицаИсключенийДат 
   
КонецФункции

Функция ПолучитьСписокПроектныхЗадач(ДанныеЗадачи)
	
	Если ТипЗнч(ДанныеЗадачи) = Тип("ТаблицаЗначений") Тогда
		Возврат ?(ДанныеЗадачи.Колонки.Найти("ПроектнаяЗадача") = Неопределено,
			Неопределено, ДанныеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача"));
	КонецЕсли;	
	
КонецФункции

Функция ПолучитьТипОбъектаProject(Параметры)
	
	ПакетProject = Параметры.Фабрика.Пакеты.Получить(Параметры.URIПространствоИменMSP);
	// В СвойствоProject хранится структура и типы, по которым нужно выгрузить.
	СвойствоProject = ПакетProject.КорневыеСвойства.Получить("Project");
	
	Возврат СвойствоProject.Тип;
	
КонецФункции

Функция СоздатьОбъектXDTO(Фабрика, ТипОбъекта, Значение = Неопределено)
	
	Возврат ?(Значение = Неопределено,Фабрика.Создать(ТипОбъекта),Фабрика.Создать(ТипОбъекта,Значение));
	
