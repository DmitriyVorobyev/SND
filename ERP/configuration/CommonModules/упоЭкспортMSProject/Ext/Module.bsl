////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции для экспорта данных в Microsoft Project.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Экспорт в MS Project.
//
// Параметры:
//  НеведомыйОбъект	 - Произвольный	 - объект или структура данных, на основании
//  	которых необходимо выгрузить данные в MSP.
//  УровеньПланированияТрудозатрат  - ПеречислениеСсылка.упоУровеньПланирования, Неопределено
//  ТипВыгрузки                     - Число     - в зависимости от типа формируются параметры выгрузки.
//  ВерсияMSProject                 - Число     - Номер используемой версии MS Project.
//  РучныеСроки                     - Булево    - признак использования ручных сроков.
// 
// Возвращаемое значение:
//  Строка - адрес файла выгрузки во временном хранилище.
//
Функция ЭкспортВMSProject(НеведомыйОбъект, ТипВыгрузки, УровеньПланированияТрудозатрат = Неопределено,
	ВерсияMSProject = 0, РучныеСроки = Ложь) Экспорт
	
	АдресФайлаВыгрузкиВоВременномХранилище = "";
	
	СтруктураДанных = ПолучитьСтруктуруДанных(НеведомыйОбъект, РучныеСроки);
	СтруктураДанных.Вставить("ВерсияMSProject", ВерсияMSProject);
	СтруктураДанных.Вставить("УровеньПланированияТрудозатрат", УровеньПланированияТрудозатрат);
	
	ВыгрузитьДанныеВMSProject(СтруктураДанных, , , ТипВыгрузки, АдресФайлаВыгрузкиВоВременномХранилище);
	
	Возврат АдресФайлаВыгрузкиВоВременномХранилище;
	
КонецФункции

// Функция - Проверить выгрузку
//
// Параметры:
//  Параметры	 - Структура:
//		* ТипВыгрузки - Число - в качестве ресурсов выгрузить роли - 0;
//							    в качестве ресурсов выгрузить исполнителей (трудовые ресурсы) - 1;
//		* ВерсияMSP - Число - версия MS Project для выбора схемы выгрузки данных;
//		* ОткрытьВMSP - Булево - признак необходимости открытия файла в MS Project;
//		* РучныеСроки - Булево - признак установки ручных сроков;
//		* Проект - СправочникСсылка.Проекты - проект, экспорт которого должен осуществиться в MS Project.
// 
// Возвращаемое значение:
//  Булево - признак наличия ошибок. 
//
Функция ПроверитьВыгрузку(Параметры) Экспорт
	
	СтруктураДанных = ПолучитьСтруктуруДанных(Параметры.Проект, Параметры.РучныеСроки);
	СтруктураДанных.Вставить("ВерсияMSProject", Параметры.ВерсияMSP);
	
	Если НЕ ПараметрыСеанса.упоОтключитьПроверкуОграничений
		И НЕ ВыполнитьПроверкуСтруктурыПроекта(СтруктураДанных) Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции	

// Строит общую таблицу связей всех элементов проекта.
//
// Параметры:
//	ОсновнойПроект - СправочникСсылка.Проекты - проект, для которого строится таблица связей.
//
// Возвращаемое значение:
//	ТаблицаЗначений - таблица связей.
//
Функция ПостроитьСписокСвязей(ОсновнойПроект) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = ЗапросСписокСвязейПроекта();
	Запрос.УстановитьПараметр("Проект", ОсновнойПроект);
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ОсновнойПроект));
	
	ТаблицаСвязейПроекта = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСвязейПроекта;	
	
КонецФункции

// Получает структуру данных, необходимых для экспорта проекта в MS Project, в зависимости от типа параметра.
//
// Параметры:
//  ЧерныйЯщик	 - Произвольный	 - объект, на основании которого надо получить структуру данных для экспорта.
//  РучныеСроки	 - Булево		 - признак выгрузки с ручными сроками.
// 
// Возвращаемое значение:
//  Структура - структура данных.
//
Функция ПолучитьСтруктуруДанных(ЧерныйЯщик, РучныеСроки) Экспорт
	
	СтруктураДанных = Новый Структура();
	// Многие таблицы уже есть в переданных объектах.
	
	// Выгружаем проект в различных вариантах вызова.
	Если ТипЗнч(ЧерныйЯщик) = Тип("СправочникОбъект.Проекты") 
		ИЛИ ТипЗнч(ЧерныйЯщик) = Тип("СправочникСсылка.Проекты") Тогда
		
		// Если это главный проект - сразу начинаем печатать иначе нужно сначало получить главный проект.
		
		Если ЗначениеЗаполнено(ЧерныйЯщик.Родитель) Тогда
			СтруктураДанных.Вставить("Проект", ЧерныйЯщик.Ссылка.упоКорневойПроект);
		Иначе
			СтруктураДанных.Вставить("Проект", ЧерныйЯщик.Ссылка);	
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(ЧерныйЯщик) = Тип("СправочникСписок.Проекты") Тогда
		
		СтруктураДанных.Вставить("Проект", ЧерныйЯщик.ТекущиеДанные.Ссылка);
				
	ИначеЕсли (ТипЗнч(ЧерныйЯщик) = Тип("ДокументСсылка.упоПроектнаяЗадача") 
		ИЛИ ТипЗнч(ЧерныйЯщик) = Тип("ДокументОбъект.упоПроектнаяЗадача")) Тогда
		
		СтруктураДанных.Вставить("Проект", ЧерныйЯщик.Проект);
		
	ИначеЕсли ТипЗнч(ЧерныйЯщик) = Тип("ОбработкаОбъект.упоАнализВыполнимостиПроектов") Тогда
		
		ИсходнаяТаблицаОбработки = ЧерныйЯщик.ПроектныеЗадачи.Выгрузить();
		
		мКолонки = Новый Массив;
		Для Каждого Колонка Из ИсходнаяТаблицаОбработки.Колонки Цикл
			Если мКолонки.Количество() > 0 Тогда
				мКолонки.Добавить(", ");
			КонецЕсли;	
			мКолонки.Добавить("ИсходнаяТаблица.");
			мКолонки.Добавить(Колонка.Имя);
		КонецЦикла;
		СтрокаПолей = СтрСоединить(мКолонки);
		
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ * 
				 		|ПОМЕСТИТЬ ИсходнаяТаблица		
				 		|ИЗ &ИсходнаяТаблица КАК ИсходнаяТаблица
				 		|;
				 		|ВЫБРАТЬ РАЗРЕШЕННЫЕ *,
				 		|	СвойстваПроектныхЗадачСрезПоследних.ЭтоВеха КАК ЭтоВеха,
						|	СвойстваПроектныхЗадачСрезПоследних.Длительность КАК Длительность
				 		|ИЗ ИсходнаяТаблица КАК ИсходнаяТаблица
				 		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ) КАК СвойстваПроектныхЗадачСрезПоследних
				 		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
				 		|			ПО СвойстваПроектныхЗадачСрезПоследних.Версия = ВерсииПроекта.Версия
				 		|				И ВерсииПроекта.Текущая
						|				И НЕ СвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
				 		|		ПО ИсходнаяТаблица.ПроектнаяЗадача = СвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "*", СтрокаПолей);
		Запрос.УстановитьПараметр("ИсходнаяТаблица", ИсходнаяТаблицаОбработки);
		ИсходнаяТаблица = Запрос.Выполнить().Выгрузить();
		
		Если НЕ ИсходнаяТаблица.Колонки.Найти("НазваниеПроектнойОперации") = Неопределено Тогда
			ИсходнаяТаблица.Колонки.НазваниеПроектнойОперации.Имя = "Name";
		КонецЕсли;
		
		Если НЕ ИсходнаяТаблица.Колонки.Найти("ДатаНачала") = Неопределено Тогда
			ИсходнаяТаблица.Колонки.ДатаНачала.Имя = "Start";
		КонецЕсли;
		
		Если НЕ ИсходнаяТаблица.Колонки.Найти("ДатаЗавершения") = Неопределено Тогда
			ИсходнаяТаблица.Колонки.ДатаЗавершения.Имя = "Finish";
		КонецЕсли;
		
		Если ИсходнаяТаблица.Колонки.Найти("КодСДР") = Неопределено Тогда
			ИсходнаяТаблица.Колонки.Добавить("КодСДР");
		КонецЕсли;

		Если НЕ ИсходнаяТаблица.Колонки.Найти("ПроектнаяЗадача") = Неопределено Тогда
			ИсходнаяТаблица.Колонки.ПроектнаяЗадача.Имя =  "ПроектнаяЗадача_";
		КонецЕсли;

		// Добавим Код СДР.
		ИсходнаяТаблица.Колонки.Добавить("Родитель");
		ИсходнаяТаблица.Колонки.Добавить("ПроектнаяЗадача");
		ИсходнаяТаблица.Колонки.Добавить("Описание");
       	ИсходнаяТаблица.Колонки.Добавить("РучнойВводСроков");
       	ТаблицаРолей = ИсходнаяТаблица.Скопировать(,"Роль");
		ИсходнаяТаблица.Индексы.Добавить("Роль");
		ТаблицаРолей.Свернуть("Роль");
		СчКодаСДР = 0;
		Для каждого СтрокаТаблицыРолей Из ТаблицаРолей  Цикл
			
			Отбор = Новый Структура("Роль",СтрокаТаблицыРолей.Роль);
			МассивСтрок = ИсходнаяТаблица.НайтиСтроки(Отбор);
			СчКодаСДР = СчКодаСДР+1;
			ИндексЭлементаМассива = 0;
			флагДобавитьСуммирующуюЗадачу = Истина;
			ИтогоStart = Дата('99990101000000');
			ИтогоFinish = Дата('00010101000000');
			Для каждого ЭлементМассивСтрок Из МассивСтрок  Цикл
				
				// Вставим в исходную таблицу групповые строки(суммирующими задачами у нас будут роли).
		        Если флагДобавитьСуммирующуюЗадачу Тогда
					СуммирующаяЗадача = ИсходнаяТаблица.Добавить();
				    ЗаполнитьЗначенияСвойств(СуммирующаяЗадача,ЭлементМассивСтрок);
					СуммирующаяЗадача.Name = СтрокаТаблицыРолей.Роль;
					СуммирующаяЗадача.Родитель = СтрокаТаблицыРолей.Роль;
					СуммирующаяЗадача.ПроектнаяЗадача = СтрокаТаблицыРолей.Роль;
					СуммирующаяЗадача.КодСДР = Строка(СчКодаСДР);
					СуммирующаяЗадача.ПроектнаяОперация = Документы["упоПроектнаяЗадача"].ПустаяСсылка();
					флагДобавитьСуммирующуюЗадачу = НЕ флагДобавитьСуммирующуюЗадачу;
					СуммирующаяЗадача.Описание = "";
					СуммирующаяЗадача.РучнойВводСроков = Истина;
				КонецЕсли; 
		    
				ИтогоStart = Мин(ИтогоStart,ЭлементМассивСтрок.Start);
				ИтогоFinish = Макс(ИтогоFinish,ЭлементМассивСтрок.Finish);
				ИндексЭлементаМассива = ИндексЭлементаМассива+1;
				ЭлементМассивСтрок.КодСДР = Строка(СчКодаСДР)+"."+Строка(ИндексЭлементаМассива);
				ЭлементМассивСтрок.Родитель = СтрокаТаблицыРолей.Роль; 
				ЭлементМассивСтрок.ПроектнаяЗадача =ЭлементМассивСтрок.ПроектнаяЗадача_;
				// Добавим информацию о трудозатратах.
				ЭлементМассивСтрок.Описание = "" + Формат(ЭлементМассивСтрок.ЗагрузкаРесурса, "ЧДЦ=2; ЧРД=.") 
					+ " ч. (" + ЭлементМассивСтрок.Проект + ")";
				ЭлементМассивСтрок.РучнойВводСроков = Истина;
			КонецЦикла;
			
			// Поставим итоговые даты.
			СуммирующаяЗадача.Start = ИтогоStart;
			СуммирующаяЗадача.Finish = ИтогоFinish;
		КонецЦикла; 
		
		СтруктураДанных = Новый Структура("Задачи", ИсходнаяТаблица);
		
	ИначеЕсли ТипЗнч(ЧерныйЯщик) = Тип("ОбработкаОбъект.упоПанельПоказателей") Тогда
		
		ИсходнаяТаблица = Новый ТаблицаЗначений();
		
		ИсходнаяТаблица.Колонки.Добавить("Родитель");
		ИсходнаяТаблица.Колонки.Добавить("ПроектнаяЗадача");
		ИсходнаяТаблица.Колонки.Добавить("Описание");
		ИсходнаяТаблица.Колонки.Добавить("КодСДР");

		ИсходнаяТаблица.Колонки.Добавить("Start");
		ИсходнаяТаблица.Колонки.Добавить("Finish");
		ИсходнаяТаблица.Колонки.Добавить("Name");
		ИсходнаяТаблица.Колонки.Добавить("Проект");
		ИсходнаяТаблица.Колонки.Добавить("СтатусПроекта");
		ИсходнаяТаблица.Колонки.Добавить("СтатусПроектнойЗадачи");
		ИсходнаяТаблица.Колонки.Добавить("ЭтоВеха");
		ИсходнаяТаблица.Колонки.Добавить("ЭтоМодельПакетаРабот");
		ИсходнаяТаблица.Колонки.Добавить("ЭтоПроектнаяЗадача");
		ИсходнаяТаблица.Колонки.Добавить("ПакетРабот");
		ИсходнаяТаблица.Колонки.Добавить("Длительность");
		ИсходнаяТаблица.Колонки.Добавить("РучнойВводСроков");
		
		ТаблицаСвязейПроекта = Новый ТаблицаЗначений();
		ТаблицаСвязейПроекта.Колонки.Добавить("КонецСвязи");
		ТаблицаСвязейПроекта.Колонки.Добавить("НачалоСвязи");
		ТаблицаСвязейПроекта.Колонки.Добавить("ТипСвязиЭлементов");
		ТаблицаСвязейПроекта.Колонки.Добавить("Задержка");
		ТаблицаСвязейПроекта.Колонки.Добавить("ТипСвязи");

		СчКодаСДР = 0;
		ВыгрузитьДеревоПоказателейПроектов(ЧерныйЯщик.ДеревоПоказателейПроектов.Строки, ИсходнаяТаблица, ТаблицаСвязейПроекта);
		ТаблицаСвязейПроекта.Свернуть("КонецСвязи,НачалоСвязи,ТипСвязиЭлементов,Задержка,ТипСвязи");
		
		СтруктураДанных.Вставить("Задачи",ИсходнаяТаблица);
		СтруктураДанных.Вставить("ТаблицаСвязейПроекта",ТаблицаСвязейПроекта);
		
	ИначеЕсли ТипЗнч(ЧерныйЯщик) = Тип("Структура") Тогда
		
		// Можно передать что угодно, но соблюдаем некоторые правила:
		// ОсновнойПроект - "СправочникСсылка.Проекты"
		// ДатаСреза	- "Дата", если дата не передана, то берется ТекущаяДата, используется для выборки из регистров
		// и указания актуальных дат;
		// СписокПроектныхЗадач - "Массив" - проектные задачи выгруженные из тз Задачи;	
		// ВыделенныеТрудовыеРесурсы - "Массив" содержащих трудовые ресурсы выделенные на Проект;
		// ТрудовыеРесурсыПроектныхЗадач - "Массив" содержащих трудовые ресурсы выделенные
		// на ПроектныеЗадачи из СписокПроектныхЗадач;
		// Задачи - "ТаблицаЗначений" - Обязательно нужно выгрузить таблицу задач в слудующей минимальной структуре.
		// Колонки:
		//	"Name" - обязательно строка;
        //	"Start" - обязательно дата;
        //	"Finish" - обязательно дата;
		// ТаблицаСвязейПроекта - "ТаблицаЗначений" - Таблица предшественников, определяющая связи в MSP между задачами;
		// Обязательна следующая структура:
		//	КонецСвязи 			- "ДокументСсылка.ПроектнаяЗадача";
		//  НачалоСвязи 		- "ДокументСсылка.ПроектнаяЗадача";
		//	ЗадачаПредшественник;
		//  ТипСвязи			- "Число";
		//	Задержка.
		
		СтруктураДанных = ЧерныйЯщик;
		
	КонецЕсли;	
	
	Если СтруктураДанных.Свойство("Проект") Тогда
		СтруктураДанных.Вставить("РучныеСроки", РучныеСроки);
	КонецЕсли;	
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ВыгрузитьДеревоПоказателейПроектов(ДеревоЗначений, ИсходнаяТаблица, ТаблицаСвязейПроекта, СчКодаСДРРодитель = "", Родитель = Неопределено)
	
	СчКодаСДР = 0;	
	Для каждого СтрокаТаблицыГруппировок Из ДеревоЗначений  Цикл
		НоваяСтрока = ИсходнаяТаблица.Добавить();
		СчКодаСДР = СчКодаСДР + 1;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыГруппировок);
		
		НоваяСтрока.Родитель = ?(Родитель = Неопределено, Документы.упоПроектнаяЗадача.ПустаяСсылка(), Родитель);
		НоваяСтрока.Name = Строка(СтрокаТаблицыГруппировок.Группировка);
		НоваяСтрока.КодСДР = СчКодаСДРРодитель + ?(СчКодаСДРРодитель = "", "", ".") + СчКодаСДР;
		НоваяСтрока.СтатусПроектнойЗадачи = СтрокаТаблицыГруппировок.СтатусЗадачи;
		НоваяСтрока.Описание = "";
		
		НоваяСтрока.Start = СтрокаТаблицыГруппировок.ДатаНачала_ДГ; //Дата('00010101000000');
		НоваяСтрока.Finish = СтрокаТаблицыГруппировок.ДатаЗавершения_ДГ; //Дата('00010101000000');
		НоваяСтрока.Длительность = Окр((КонецДня(НоваяСтрока.Finish) - НачалоДня(НоваяСтрока.Start) + 1) /3600 , 0); /// (60*60*24)
		НоваяСтрока.РучнойВводСроков = Истина;
		
		НоваяСтрока.ПакетРабот = СтрокаТаблицыГруппировок.ЭтоМодельПакетаРабот Или Не СтрокаТаблицыГруппировок.ЭтоПроектнаяЗадача;
		НоваяСтрока.ПроектнаяЗадача = СтрокаТаблицыГруппировок.Группировка;
		
		Если ТипЗнч(СтрокаТаблицыГруппировок.Группировка) = Тип("СправочникСсылка.Проекты") Тогда
			НоваяСтрока.Проект = СтрокаТаблицыГруппировок.Группировка;
		    Если ЗначениеЗаполнено(СтрокаТаблицыГруппировок.Группировка.СсылкаНаПроектнуюЗадачу) Тогда
				НоваяСтрока.ПроектнаяЗадача = СтрокаТаблицыГруппировок.Группировка.СсылкаНаПроектнуюЗадачу;
				НоваяСтрока.Проект = НоваяСтрока.ПроектнаяЗадача.Проект;
			КонецЕсли;
		КонецЕсли;	
			
		// Обязательна следующая структура:
		//	КонецСвязи 			- "ДокументСсылка.ПроектнаяЗадача";
		//  НачалоСвязи 		- "ДокументСсылка.ПроектнаяЗадача";
		//  ТипСвязи			- "Число";
		//	Задержка.

		Элемент = Неопределено;
		ЭлементПредшественник = Неопределено;
		Для Каждого Связь Из СтрокаТаблицыГруппировок.СвязиВПроектеДГ Цикл
			НоваяСтрокаСвязи = ТаблицаСвязейПроекта.Добавить();
			
			Если Связь.Значение.Свойство("Элемент", Элемент) Тогда
				Если ТипЗнч(Элемент) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
					НоваяСтрокаСвязи.КонецСвязи = Элемент;
				Иначе
					НоваяСтрокаСвязи.КонецСвязи = Элемент.СсылкаНаПроектнуюЗадачу;
				КонецЕсли;
			КонецЕсли;
			Если Связь.Значение.Свойство("ЭлементПредшественник", ЭлементПредшественник) Тогда
				Если ТипЗнч(ЭлементПредшественник) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
					НоваяСтрокаСвязи.НачалоСвязи = ЭлементПредшественник;
				Иначе
					НоваяСтрокаСвязи.НачалоСвязи = ЭлементПредшественник.СсылкаНаПроектнуюЗадачу;
				КонецЕсли;
			КонецЕсли;
			Связь.Значение.Свойство("ТипСвязи", НоваяСтрокаСвязи.ТипСвязиЭлементов);
			Связь.Значение.Свойство("Задержка", НоваяСтрокаСвязи.Задержка);
			НоваяСтрокаСвязи.Задержка = ?(ЗначениеЗаполнено(НоваяСтрокаСвязи.Задержка),НоваяСтрокаСвязи.Задержка,0);
			НоваяСтрокаСвязи.ТипСвязи = ?(ТипЗнч(НоваяСтрокаСвязи.НачалоСвязи) = Тип("ДокументСсылка.упоПроектнаяЗадача"), 1, 0);
		КонецЦикла;
		
		Для Каждого Связь Из СтрокаТаблицыГруппировок.СвязиМеждуПроектамиДГ Цикл
			НоваяСтрокаСвязи = ТаблицаСвязейПроекта.Добавить();
			Если Связь.Значение.Свойство("Элемент", Элемент) Тогда
				Если ТипЗнч(Элемент) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
					НоваяСтрокаСвязи.КонецСвязи = Элемент;
				Иначе
					НоваяСтрокаСвязи.КонецСвязи = Элемент.СсылкаНаПроектнуюЗадачу;
				КонецЕсли;
			КонецЕсли;
			Если Связь.Значение.Свойство("ЭлементПредшественник", ЭлементПредшественник) Тогда
				Если ТипЗнч(ЭлементПредшественник) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
					НоваяСтрокаСвязи.НачалоСвязи = ЭлементПредшественник;
				Иначе
					НоваяСтрокаСвязи.НачалоСвязи = ЭлементПредшественник.СсылкаНаПроектнуюЗадачу;
				КонецЕсли;
			КонецЕсли;
			Связь.Значение.Свойство("ТипСвязи", НоваяСтрокаСвязи.ТипСвязиЭлементов);
			Связь.Значение.Свойство("Задержка", НоваяСтрокаСвязи.Задержка);
			НоваяСтрокаСвязи.Задержка = ?(ЗначениеЗаполнено(НоваяСтрокаСвязи.Задержка),НоваяСтрокаСвязи.Задержка,0);
			НоваяСтрокаСвязи.ТипСвязи = ?(ТипЗнч(НоваяСтрокаСвязи.НачалоСвязи) = Тип("ДокументСсылка.упоПроектнаяЗадача"), 1, 0);
		КонецЦикла;

		Если СтрокаТаблицыГруппировок.Строки.Количество() <> 0 Тогда
			ВыгрузитьДеревоПоказателейПроектов(СтрокаТаблицыГруппировок.Строки, ИсходнаяТаблица, ТаблицаСвязейПроекта, НоваяСтрока.КодСДР, НоваяСтрока.ПроектнаяЗадача);
		КонецЕсли;			
		
	КонецЦикла;
		
КонецПроцедуры

// Получает статус проекта и руководителя проекта.
//
// Параметры:
//  Параметры	 - Структура - структура входных параметров.
//
// Возвращаемое значение:
//	Структура - структура свойств проекта. Свойства:
//		* СтатусПроекта 		- ПеречислениеСсылка.упоСостояниеСтатусаПроекта - статус.
//		* РуководительПроекта 	- СправочникСсылка.упоСотрудники - руководитель.
//
Функция ПолучитьСвойстваПроекта(Параметры) Экспорт
	
	Структура = Новый Структура;
	
	Запрос = Новый Запрос();
	Запрос.Текст = ЗапросСостояниеПроекта();
	Запрос.УстановитьПараметр("Проект", Параметры.Основнойпроект);
		
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Структура.Вставить("СтатусПроекта", Результат.СтатусПроекта);
		Структура.Вставить("РуководительПроекта", Результат.РуководительПроекта);
	Иначе
		Структура.Вставить("СтатусПроекта", Перечисления.упоСостояниеСтатусаПроекта.ПустаяСсылка());
		Структура.Вставить("РуководительПроекта", Справочники.упоСотрудники.ПустаяСсылка());
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

// Формирует xml-файл для загрузки в MS Project. В зависимости от контекста выполнения либо
// вызывает сразу процедуру загрузки сформированного фалйла в MS Project, либо возвращает
// в параметре "АдресФайлаВыгрузкиВоВременномХранилище" адрес файла во внутреннем хранилище.
//
// Параметры:
//  СтруктураДанных  	- Структура - структура данных для формирования файла.
//  Режим	  			- Строка 	- в зависимости от режима осуществляется или загрузка или печать.
//						  Возможные варианты: "ВыгрузитьMSP", "ПредварительныйПросмотрMSP".
//	ВыводитьСообщения	- Булево 	- выводить или нет дополнительные сообщения.
//	ТипВыгрузки			- Число 	- в зависимости от типа формируются параметры выгрузки.
//	АдресФайлаВыгрузкиВоВременномХранилище - Строка - в этом параметре возвращается адрес 
//						  файла выгрузки во врмеменном хранилище (в зависимости от контекста выполнения).
//
// Возвращаемое значение:
//	Неопределено - не возвращает значение.
//
Функция ВыгрузитьДанныеВMSProject(СтруктураДанных,
								  Режим = "ВыгрузитьMSP",
								  ВыводитьСообщения = Ложь,
								  ТипВыгрузки,
								  АдресФайлаВыгрузкиВоВременномХранилище = "") Экспорт

	// Создаем временный файл, в который будем записывать xml данные.
	ИмяФайлаXML = "";
	Файл = СоздатьВременныйФайл("xml", ИмяФайлаXML);
	Если Файл = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	Если ВыводитьСообщения Тогда
		НСтрока = НСтр("ru = 'Создан файл XML ""Project"": %1'");
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, ИмяФайлаXML);
		Сообщение.Сообщить();
	КонецЕсли;
	
	// Создаем XML-схему для элемента <Project> MS Project.
	ИмяФайлаСхемаXSD = СоздатьCхемаXSDProject(ВыводитьСообщения, СтруктураДанных.ВерсияMSProject);
	Если ИмяФайлаСхемаXSD = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Создания фабрики XDTO на основе схемы XML и сопутствующих выгрузки параметров.
	Параметры = ПолучитьПараметрыВыгрузки(СтруктураДанных, ИмяФайлаСхемаXSD, ТипВыгрузки);
	
	ОбъектXDTOProject = СоздатьЗаполнитьОбъектXDTOProject(Параметры,Параметры.ТипОбъектаProject, ТипВыгрузки);
	
	// Создаем объект записи xml документа и открываем файл.
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайлаXML);
	
	// Сериализатор значений в XML на основе XDTO.
	ТекСериализаторXDTO = Новый СериализаторXDTO(Параметры.Фабрика);
	// Записываем переданный XDTO заполненный объект Project в формате xml по схеме MS Project.
	ТекСериализаторXDTO.Фабрика.ЗаписатьXML(ЗаписьXML, ОбъектXDTOProject, "Project");
	
	ЗаписьXML.Закрыть();
	
	// По какой-то причине не записывается стандартная строка xml.
	ДобавитьСтрокуВерсииXML(Файл, ИмяФайлаXML, ВыводитьСообщения);
	
	АдресФайлаВыгрузкиВоВременномХранилище = 
		ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайлаXML), Новый УникальныйИдентификатор());
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЕстьТолькоНеТребующиеИсправленияОшибкиВСрокахЗадач(СтруктураДанных) Экспорт
	
	Если Не СтруктураДанных.Свойство("Проект") Или Не ЗначениеЗаполнено(СтруктураДанных.Проект) Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ОбъектупоПроверкаСтруктурыПроекта = Обработки.упоПроверкаСтруктурыПроекта.Создать();
		
	ОбъектупоПроверкаСтруктурыПроекта.Проект = СтруктураДанных.Проект;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиЗаполненностиДат = Истина;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиСроковЗадач = Истина;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиЗаполненностиДат = Истина;
	
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиСтруктурыЗадач = Истина;
	
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиЗацикливания = Истина;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиПредУсловийЗадач = Истина;	
	
	ТаблицаОшибок = ОбъектупоПроверкаСтруктурыПроекта.ВыполнитьПроверкуСтруктурыПроекта();
	
	Если ТаблицаОшибок = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТаблицаОшибок.Задачи.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТаблицаОшибок.Общие.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеОшибкиНеТребующейИсправления = НСтр("ru = 'у задачи-родителя установлен ручной режим ввода сроков, исправление необязательно'");
	
	Для Каждого СтрокаОшибки Из ТаблицаОшибок.Задачи Цикл
		
		Если СтрНайти(СтрокаОшибки.ЗадачаТекстОшибки, ОписаниеОшибкиНеТребующейИсправления) = 0 Тогда
			Возврат Ложь;	
		КонецЕсли;
			
	КонецЦикла; 	
	
	Возврат Истина;
	
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьПроверкуСтруктурыПроекта(СтруктураДанных)

	// Если свойства проект нет, то и проверить мы ничего не можем.
	Если Не СтруктураДанных.Свойство("Проект") Или Не ЗначениеЗаполнено(СтруктураДанных.Проект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ОбъектупоПроверкаСтруктурыПроекта = Обработки.упоПроверкаСтруктурыПроекта.Создать();
	
	ОбъектупоПроверкаСтруктурыПроекта.Проект = СтруктураДанных.Проект;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиЗаполненностиДат = Истина;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиСроковЗадач = Истина;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиЗаполненностиДат = Истина;
	
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиСтруктурыЗадач = Истина;
	
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиЗацикливания = Истина;
	ОбъектупоПроверкаСтруктурыПроекта.ПризнакПроверкиПредУсловийЗадач = Истина;
	
	ТаблицаОшибок = ОбъектупоПроверкаСтруктурыПроекта.ВыполнитьПроверкуСтруктурыПроекта();
	
	Если Не (ТаблицаОшибок = Неопределено)
		И (ТаблицаОшибок.Задачи.Количество() <> 0 ИЛИ ТаблицаОшибок.Общие.Количество() <> 0) Тогда // Если ошибки есть.
		
		// Выведем таблицу ошибок.
		ТекстСообщения = СтрШаблон(НСтр("ru = 'В проекте ""%1"" обнаружены ошибки:'"), СтруктураДанных.Проект);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ОбъектупоПроверкаСтруктурыПроекта.ВывестиТаблицуОшибок(ТаблицаОшибок);
		Возврат Ложь;
		
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции

