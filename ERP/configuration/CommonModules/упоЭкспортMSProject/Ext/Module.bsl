	Если ТипЗнч(ИтогоРабочихСекунд) = Тип("Число") Тогда // Значение содержит количество сек.
		
		//ИтогоРабочихСекунд = ?(ИтогоРабочихСекунд =0, КоличестворабочихЧасов*3600,ИтогоРабочихСекунд);
		
