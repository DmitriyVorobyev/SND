Функция ПреобразоватьТипСвязиВMSProject(Значение)
	
	// Возвращаемое значение:
	// Тип связи с задачей:
	//	0 ОО (окончание-окончание);
	//	1 ОН (окончание-начало);
	//	2 НО (начало-окончание);
	//	3 НН (начало-начало).
	
	упоТипСвязи = Перечисления.упоТипСвязи;
	
	Если Значение = упоТипСвязи.ОкончаниеОкончание Тогда
		Возврат 0;
	ИначеЕсли Значение = упоТипСвязи.ОкончаниеНачало Тогда
		Возврат 1;
	ИначеЕсли Значение = упоТипСвязи.НачалоОкончание Тогда
		Возврат 2;
	ИначеЕсли Значение = упоТипСвязи.НачалоНачало Тогда
		Возврат 3;
	Иначе
		Возврат 1;
	КонецЕсли;   

КонецФункции

Функция СоздатьЗаполнитьОбъектXDTOAssignments(Параметры, ТипОбъекта, ТипВыгрузки)
	
	// Основное значение, по сути это проект который нам нужно наполнить данными из 1с, но в формате,
	// который воспримет MS Project.
	
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Параметры.Фабрика,ТипОбъекта); 
	
	// Нужно заполнить список.
	ЗаполнитьСписокXDTOAssignment(Параметры,ОбъектXDTO.Assignment,ТипВыгрузки);
	
	// Больше свойств у задач нет, заполнять нечего.
	
	Возврат ОбъектXDTO;
	
КонецФункции

Процедура ЗаполнитьСписокXDTOAssignment(Параметры, СписокXDTO, ТипВыгрузки)
	
	СписокXDTO.Очистить();
	
	Фабрика = Параметры.Фабрика;
	ТипОбъекта = ПолучитьТипСпискаXDTO(СписокXDTO);
	
	ДляСоответствияОбъектXDTO = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
	СоответствиеТиповXDTO = ПолучитьСоответствиеТиповXDTO(Фабрика, ДляСоответствияОбъектXDTO, ТипОбъекта.Свойства);
	
	ИмяПроектнаяЗадача  = "ПроектнаяЗадача"; 
	
	Если ТипВыгрузки Тогда 
		ИмяРесурс = "Ресурс";
	Иначе
		Имяресурс = "РольРесурса";	
	КонецЕсли;
	
	// Нам нужно связать UID Task и UID Resources.
	ПостроительОтчетаТрудРес = Параметры.ПостроительОтчетаТрудРес;
	ПостроительОтчетаТрудРес.Отбор.Добавить(ИмяПроектнаяЗадача);
	Если ТипВыгрузки <> 2 Тогда
		ПостроительОтчетаТрудРес.Отбор.Добавить(ИмяРесурс);
	КонецЕсли;
	
	Для каждого ТекПрЗадача Из Параметры.СоответствиеTasksUID Цикл
		
		// Ищем все ресурсы, которые с ней связаны.
		ПостроительОтчетаТрудРес.Отбор[ИмяПроектнаяЗадача].Установить(ТекПрЗадача.Ключ);
		
		ДанныеПроектнойЗадачи = Параметры.Задачи.Найти(ТекПрЗадача.Значение, "UID");
		Start = ДанныеПроектнойЗадачи.Start;
		Finish = ДанныеПроектнойЗадачи.Finish;
		
		Для каждого ТекРесурс Из Параметры.СоответствиеResourcesUID Цикл
			
			ПостроительОтчетаТрудРес.Отбор[ИмяРесурс].Установить(ТекРесурс.Ключ);
			
			ПостроительОтчетаТрудРес.Выполнить();
			
			Если ПостроительОтчетаТрудРес.Результат.Пустой() Тогда 
				Продолжить;
			КонецЕсли;
			
			Выборка = ПостроительОтчетаТрудРес.Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОбъектXDTO = СоздатьОбъектXDTO(Фабрика, ТипОбъекта);
				
				ОбъектXDTO.UID = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["UID"], Параметры.СчетчикUID);
				УвеличитьСчетчикUID(Параметры);
				
				ОбъектXDTO.TaskUID = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["TaskUID"], ТекПрЗадача.Значение);
				ОбъектXDTO.ResourceUID = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["ResourceUID"], ТекРесурс.Значение);
				
				ОбъектXDTO.Start = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["Start"], Start);
				ОбъектXDTO.Finish = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["Finish"], Finish);
				
				ЗначениеMSProject = ЗначениеТрудозатратВФорматеMSProject(Выборка.Work);
				ОбъектXDTO.Work = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["Work"], ЗначениеMSProject);
				ОбъектXDTO.RemainingWork = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["RemainingWork"], ЗначениеMSProject);
				// Количество выделенных трудовых ресурсов на роль. Заполняем по умолчанию единицей.
				ОбъектXDTO.Units = СоздатьОбъектXDTO(Фабрика, СоответствиеТиповXDTO["Units"], "1");
				//
				
				СписокXDTO.Добавить(ОбъектXDTO);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;		
	
КонецПроцедуры

Функция СоздатьЗаполнитьОбъектXDTOResources(Параметры, ТипОбъекта, ТипВыгрузки)
	
	// Основное значение, по сути это проект который нам нужно наполнить данными из 1с, но в формате,
	// который воспримет MS Project.
	
	// Создаем объектXDTO.
	ОбъектXDTO = СоздатьОбъектXDTO(Параметры.Фабрика, ТипОбъекта); 
	
	// Нужно заполнить список Resource.
	ЗаполнитьСписокXDTOResource(Параметры, ОбъектXDTO.Resource, ТипВыгрузки);
	
	// Больше свойств у объекта нет, заполнять нечего.
	
	Возврат ОбъектXDTO;
	
КонецФункции 

Функция ПолучитьСоответствиеЗначения1СResource(Параметры, СоответствиеТиповXDTO, Выборка, ТипВыгрузки)
	
	Соответствие = Новый Соответствие();
	
	Соответствие.Вставить("UID", Параметры.СчетчикUID);
	Соответствие.Вставить("ID", Параметры.ResourcesID);
	
	Если ТипВыгрузки Тогда  
		Параметры.СоответствиеResourcesUID.Вставить(Выборка.Ресурс, Параметры.СчетчикUID);
	Иначе 
		Параметры.СоответствиеResourcesUID.Вставить(Выборка.РольРесурса, Параметры.СчетчикUID);
	КонецЕсли;
	
	УвеличитьСчетчикUID(Параметры);
	Параметры.Вставить("ResourcesID",Параметры.ResourcesID +1);
	
	Для каждого ТекТип Из СоответствиеТиповXDTO Цикл
		Попытка
			ИмяПоляXML = ТекТип.Ключ;
			ЗначениеПоляИзВыборки = Выборка[ТекТип.Ключ];
			
			Соответствие.Вставить(ИмяПоляXML, ЗначениеПоляИзВыборки);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ЗначениеТрудозатратВФорматеMSProject(Знач КоличествоЧасов)
	
	ЗначениеMSProject = "PT" + ?(КоличествоЧасов = 0, "0", Формат(КоличествоЧасов, "ЧДЦ=0; ЧГ=0")) + "H0M0S";
	Возврат ЗначениеMSProject;
	
КонецФункции

Функция ПолучитьТрудовыеРесурсыПроектныхЗадач(Параметры)
	
	ЗапросТекст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| ВЫРАЗИТЬ(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс КАК Справочник.упоРоли) КАК Роль,
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача КАК ПроектнаяЗадача,
		| СУММА(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.КоличествоЧасов) КАК КоличествоЧасовПлан
		|ПОМЕСТИТЬ ВТ_ПлановыеТрудозатраты
		|ИЗ
		| РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия КАК упоАктуальныеПланыТрудозатратСводноТекущаяВерсия
		|ГДЕ
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача В(&СписокПроектныхЗадач)
		| И упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс ССЫЛКА Справочник.упоРоли
		| И упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.УровеньПланирования = &УровеньПланирования
		|
		|СГРУППИРОВАТЬ ПО
		| ВЫРАЗИТЬ(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс КАК Справочник.упоРоли),
		| упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		| ВыделенныеТрудРес.Ресурс.Наименование КАК Name,
		| 1 КАК Type,
		| ВыделенныеТрудРес.Ресурс.Представление КАК Initials,
		| ВыделенныеТрудРес.ПроектнаяЗадача.ПроектнаяЗадача КАК Родитель,
		| ВыделенныеТрудРес.ПроектнаяЗадача КАК ПроектнаяЗадача,
		| ВыделенныеТрудРес.Ресурс КАК Ресурс,
		| ВыделенныеТрудРес.РольРесурса КАК РольРесурса,
		| ВыделенныеТрудРес.ДоляТрудозатрат КАК ДоляТрудозатрат
		|ПОМЕСТИТЬ ВТ_ВыделенныеТрудовыеРесурсы
		|ИЗ
		| РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(
		|         &ДатаСреза,
		|         Версия = &ТекущаяВерсия
		|             И ПроектнаяЗадача В (&СписокПроектныхЗадач)) КАК ВыделенныеТрудРес
		|ГДЕ
		| ВыделенныеТрудРес.ДоляТрудозатратПоУровнюПланирования = &УровеньПланирования
		|
		|СГРУППИРОВАТЬ ПО
		| ВыделенныеТрудРес.ПроектнаяЗадача,
		| ВыделенныеТрудРес.Ресурс,
		| ВыделенныеТрудРес.Ресурс.Наименование,
		| ВыделенныеТрудРес.Ресурс.Представление,
		| ВыделенныеТрудРес.ПроектнаяЗадача.ПроектнаяЗадача,
		| ВыделенныеТрудРес.РольРесурса,
		| ВыделенныеТрудРес.ДоляТрудозатрат
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		| ВТ_ВыделенныеТрудовыеРесурсы.Name КАК Name,
		| ВТ_ВыделенныеТрудовыеРесурсы.Type КАК Type,
		| ВТ_ВыделенныеТрудовыеРесурсы.Initials КАК Initials,
		| ВТ_ВыделенныеТрудовыеРесурсы.Родитель КАК Родитель,
		| ВТ_ВыделенныеТрудовыеРесурсы.ПроектнаяЗадача КАК ПроектнаяЗадача,
		| ВТ_ВыделенныеТрудовыеРесурсы.Ресурс КАК Ресурс,
		| ЕСТЬNULL(ВТ_ПлановыеТрудозатраты.КоличествоЧасовПлан, 0) * ВТ_ВыделенныеТрудовыеРесурсы.ДоляТрудозатрат / 100 КАК Work
		|ИЗ
		| ВТ_ВыделенныеТрудовыеРесурсы КАК ВТ_ВыделенныеТрудовыеРесурсы
		|     ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПлановыеТрудозатраты КАК ВТ_ПлановыеТрудозатраты
		|     ПО ВТ_ВыделенныеТрудовыеРесурсы.ПроектнаяЗадача = ВТ_ПлановыеТрудозатраты.ПроектнаяЗадача";
	
	Запрос = Новый Запрос(ЗапросТекст);
	Запрос.УстановитьПараметр("ДатаСреза", Параметры.ДатаСреза);
	Запрос.УстановитьПараметр("СписокПроектныхЗадач", Параметры.СписокПроектныхЗадач);
	Запрос.УстановитьПараметр("ТекущаяВерсия", Параметры.ТекущаяВерсияОсновногоПроекта);
	Запрос.УстановитьПараметр("УровеньПланирования", Параметры.УровеньПланированияТрудозатрат);
	
	Выборка = Запрос.Выполнить();
	
	Возврат Выборка;
	
КонецФункции

Функция ПолучитьВыделенныеТрудовыеРесурсы(Параметры)
	
	ЗапросТекст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| ВыделенныеТрудРес.Ресурс.Наименование КАК Name,
		| 1 КАК Type,
		| ВыделенныеТрудРес.Ресурс.Представление КАК Initials,
		| ВыделенныеТрудРес.ПроектнаяЗадача.ПроектнаяЗадача КАК Родитель,
		| ВыделенныеТрудРес.ПроектнаяЗадача КАК ПроектнаяЗадача,
		| ВыделенныеТрудРес.Ресурс КАК Ресурс
		|ИЗ
		| РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(&ДатаСреза, Версия = &ТекущаяВерсия) КАК ВыделенныеТрудРес
		|     ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|     ПО ВыделенныеТрудРес.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|ГДЕ
		| ВыделенныеТрудРес.ДоляТрудозатратПоУровнюПланирования = &УровеньПланирования
		| И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)";
	
	Запрос = Новый Запрос(ЗапросТекст);
	Запрос.УстановитьПараметр("ДатаСреза", Параметры.ДатаСреза);
	Запрос.УстановитьПараметр("Проект", Параметры.ОсновнойПроект);
	Запрос.УстановитьПараметр("ТекущаяВерсия", Параметры.ТекущаяВерсияОсновногоПроекта);
	Запрос.УстановитьПараметр("УровеньПланирования", Параметры.УровеньПланированияТрудозатрат);
	
	Выборка = Запрос.Выполнить();
	
	Возврат Выборка;
	
КонецФункции

