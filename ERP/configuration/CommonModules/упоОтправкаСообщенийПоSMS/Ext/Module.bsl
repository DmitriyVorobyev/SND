////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции работы с отправкой сообщений по e-mail.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает информацию о версии модуля.
// 
// Возвращаемое значение:
//  Структура
//
Функция Информация() Экспорт
	
	Ответ = Новый Структура;
	Ответ.Вставить("ИмяМодуля", НСтр("ru = 'Модуль транспорта подсистемы оповещений для отправки SMS'"));
	Ответ.Вставить("ВерсияМодуля", "2.0");
	
	Возврат Ответ;
	
КонецФункции 

// Отправляет сообщение.
//
// Параметры:
//  ПарОтправки	 - Структура
// 
// Возвращаемое значение:
//  Строка - идентификатор отправленного сообщения. См. РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение
//
Функция ОтправитьСообщение(ПарОтправки) Экспорт
	
	МассивАдресатов = Новый Массив;
	МассивАдресатов.Добавить(ПарОтправки.Кому);
		
	Результат = ОтправкаSMS.ОтправитьSMS(МассивАдресатов, ПарОтправки.Тело);
	
	Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		ВызватьИсключение Результат.ОписаниеОшибки;
	ИначеЕсли Результат.ОтправленныеСообщения.Количество() Тогда
		Возврат Результат.ОтправленныеСообщения[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Получает настройки транспорта.
// 
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьНастройкиТранспорта() Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("ДоступнаТемаСообщения", Ложь);
	Рез.Вставить("ДоступенТекстСообщенияВHTML", Ложь);
	Рез.Вставить("ДоступнаНастройкаДляВидаСобытия", Ложь);
	
	ПарТраспорта = Новый Структура;
	
	Рез.Вставить("ПараметрыТранспорта", ПарТраспорта);
	
	Возврат Рез;
	
КонецФункции

// Выводит на форму дополнительную информацию.
//
// Параметры:
//  Форма	 - УправляемаяФорма
//
Процедура ВыводНаФормуДополнительнойИнформации(Форма) Экспорт
		
	Команда = Форма.Команды.Добавить("ОткрытьНастройкиSMS");
	Команда.Заголовок = "e1cib/app/ОбщаяФорма.НастройкаОтправкиSMS";
	Команда.Действие = "Подключаемый_ОткрытьНавигационнуюСсылкуПоЗаголовкуКоманды";
	
	Элемент = Форма.Элементы.Добавить("ОткрытьНастройкиSMS", Тип("КнопкаФормы"), Форма.Элементы.ГруппаНастроек);
	Элемент.Заголовок = НСтр("ru = 'Настройки отправки SMS'");
	Элемент.Вид = ВидКнопкиФормы.Гиперссылка;
	Элемент.ИмяКоманды = Команда.Имя;
	
	СтрокаЭлемента = Форма.ДобавленныеЭлементы.Добавить();
	СтрокаЭлемента.Имя = Команда.Имя;
	СтрокаЭлемента.Тип = "команда";
	
	СтрокаЭлемента = Форма.ДобавленныеЭлементы.Добавить();
	СтрокаЭлемента.Имя = Элемент.Имя;
	СтрокаЭлемента.Тип = "элемент";
	
КонецПроцедуры

#КонецОбласти