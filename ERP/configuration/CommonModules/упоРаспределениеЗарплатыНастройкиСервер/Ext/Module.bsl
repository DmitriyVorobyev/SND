
#Область ПрограммныйИнтерфейс

// Проверка использования подсистемы "Распределение зарплаты".
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ИспользоватьПодсистему() Экспорт
	
	Возврат ЗначениеНастройкиПодсистемы("ИспользоватьПодсистему");
	
КонецФункции

// Создает структуру для заполнения элемента справочника упоНастройкиРаспределенияЗарплаты по умолчанию.
// 
// Возвращаемое значение:
//  Структура - данные заполнения по умолчанию.
//
Функция ПустыеЗначенияНастройкиПоУмолчанию() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИспользоватьПодсистему", Ложь);
	Результат.Вставить("ИспользоватьСоответствиеНачислений", Ложь);
	Результат.Вставить("ОтражатьНеактируемыеТрудозатраты", Ложь);
	Результат.Вставить("СтатьяРасходовРаспределения", Справочники.СтатьиРасходовЗарплата.ПустаяСсылка());
	Результат.Вставить("ГруппаАрхивНаправленийДеятельности", Справочники.НаправленияДеятельности.ПустаяСсылка());
	Результат.Вставить("УчетВоВнешнейСистеме", Ложь);
	Результат.Вставить("РежимУчетаВзносов", 0);
	Результат.Вставить("СтатьяРасходовВзносов", ПредопределенноеЗначение("ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка"));
	Результат.Вставить("ИспользоватьСогласованныеЧасы", Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЗначениеНастройкиПодсистемы(ИмяНастройки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|    Настройки.%1 КАК Значение 
		|ИЗ
		|    Справочник.упоНастройкиРаспределенияЗарплаты КАК Настройки
		|ГДЕ
		|	Настройки.Ссылка = ЗНАЧЕНИЕ(Справочник.упоНастройкиРаспределенияЗарплаты.НастройкиРаспределениеЗарплатыПоПроектам)
		|   И НЕ Настройки.ПометкаУдаления";
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, ИмяНастройки);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Наименование", ПредопределенноеИмяЭлементаСправочникаНастройки());
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка.Значение;
	Иначе
		Результат = ПустыеЗначенияНастройкиПоУмолчанию()[ИмяНастройки];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяКолонкиНачисленияСоответствияВДокументе() Экспорт
	
	УчетВоВнешнейСистеме = упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("УчетВоВнешнейСистеме");
	ИмяКолонки = ?(УчетВоВнешнейСистеме, "упоНачислениеЗУП", "упоНачислениеERP");
	
	Возврат ИмяКолонки;
	
КонецФункции

Функция ПредопределенноеИмяЭлементаСправочникаНастройки() Экспорт
	
	Возврат "НастройкиРаспределениеЗарплатыПоПроектам";
	
КонецФункции

Функция ПолучитьЗначениеСтатьиРасходаРаспределения() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ЗначениеНастройкиПодсистемы("СтатьяРасходовРаспределения");
	
КонецФункции

Функция ПолучитьЗначениеГруппаАрхив() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ЗначениеНастройкиПодсистемы("ГруппаАрхивНаправленийДеятельности");
	
КонецФункции

Функция ПолучитьСоответствиеНачисленийPM() Экспорт
	
	УчетВоВнешнейСистеме = упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("УчетВоВнешнейСистеме");
	
	Если УчетВоВнешнейСистеме Тогда
		СоответствиеНачислений = ПолучитьСоответствиеНачисленийЗУП_PM();
	Иначе
		СоответствиеНачислений = ПолучитьСоответствиеНачисленийERP_PM();
	КонецЕсли;
	
	Возврат СоответствиеНачислений;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСоответствиеНачисленийERP_PM()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|    Регистр.НачислениеERP КАК НачислениеERP,
		|    Регистр.НачислениеPM КАК НачислениеPM
		|ИЗ
		|    РегистрСведений.упоСоответствиеВидовНачисленийERP_PM КАК Регистр";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.НачислениеERP, Выборка.НачислениеPM);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСоответствиеНачисленийЗУП_PM()
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|    Регистр.НачислениеЗУП КАК НачислениеЗУП,
		|    Регистр.НачислениеPM КАК НачислениеPM
		|ИЗ
		|    РегистрСведений.упоСоответствиеВидовНачисленийЗУП_PM КАК Регистр";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.НачислениеЗУП, Выборка.НачислениеPM);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти