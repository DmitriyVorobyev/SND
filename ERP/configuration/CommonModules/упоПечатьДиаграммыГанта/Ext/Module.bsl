////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции для печати диаграммы Ганта.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Универсальная функция печати диаграммы Ганта.
//
// Параметры:
//  ИсходнаяДиаграмма	- ДиаграммаГанта	- исходная диаграмма.
//  ПечатныйДокумент	- ТабличныйДокумент	- табличный документ, который необходимо распечатать.
//  ПараметрыПечати	 	- Структура	- см.упоПечатьДиаграммыГанта.ПараметрыПечатиПоУмолчанию.
//
// Возвращаемое значение:
//	ТабличныйДокумент - сформированный для печати документ.
//
Функция УниверсальноНапечататьДиаграммуГанта(ИсходнаяДиаграмма,
		ПечатныйДокумент = Неопределено,
		ПараметрыПечати = Неопределено) Экспорт
	
	Если ПечатныйДокумент = Неопределено Тогда
		ВыводимыйДокумент = Новый ТабличныйДокумент;
	Иначе
		ВыводимыйДокумент = ПечатныйДокумент;
	КонецЕсли;
	
	Если ПараметрыПечати = Неопределено Тогда
		ПараметрыПечати = ПараметрыПечатиПоУмолчанию();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыПечати.Заголовок) Тогда
		Отступ = 10;
		ОбластьЗаголовка = ВыводимыйДокумент.Область(1, 1, 1, 1);
		ОбластьЗаголовка.Текст = ПараметрыПечати.Заголовок;
		ОбластьЗаголовка.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , 12, Истина);
	Иначе
		Отступ = 1;
	КонецЕсли;
	
	РисунокДиаграммы = ВыводимыйДокумент.Рисунки.Добавить(ТипРисункаТабличногоДокумента.ДиаграммаГанта);
	РисунокДиаграммы.Имя = "ДиаграммаГанта";
	РисунокДиаграммы.Защита = Ложь;
	РисунокДиаграммы.Верх = Отступ;
	РисунокДиаграммы.Лево = 1;
	
	Если ПараметрыПечати.Формат = "A4" Тогда
		РисунокДиаграммы.Ширина = 297;
		РисунокДиаграммы.Высота = 210;
		ВыводимыйДокумент.РазмерСтраницы = "A4";
		ВыводимыйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ИначеЕсли ПараметрыПечати.Формат = "A3" Тогда
		РисунокДиаграммы.Ширина = 420;
		РисунокДиаграммы.Высота = 297;
		ВыводимыйДокумент.РазмерСтраницы = "A3";
		ВыводимыйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	КонецЕсли;
	
	ТекущаяДиаграмма = РисунокДиаграммы.Объект;
	упоПечатьДиаграммыГантаКлиентСервер.УстановитьПризнакОтображенияТекстаТочек(ТекущаяДиаграмма);
	ТекущаяДиаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
	ТекущаяДиаграмма.УстановитьПолныйИнтервал(ИсходнаяДиаграмма.НачалоПолногоИнтервала,
		ИсходнаяДиаграмма.КонецПолногоИнтервала);
	ТекущаяДиаграмма.ОтображениеИнтервала = ПараметрыПечати.ОтображениеИнтервала;
	ТекущаяДиаграмма.ОбластьПостроения.РазмещениеТекста = ТипРазмещенияТекстаДиаграммыГанта.Переносить;
	ТекущаяДиаграмма.РастягиваниеПоВертикали = РастягиваниеПоВертикалиДиаграммыГанта.РастягиватьСтрокиИДанные;
	
	СтрокаИсключенияПолей = СтрокаИсключенияКопированияСвойствДГ(ИсходнаяДиаграмма);
	
	ЗаполнитьЗначенияСвойств(ТекущаяДиаграмма, ИсходнаяДиаграмма, , СтрокаИсключенияПолей);
	
	СоответствиеСерий = Новый Соответствие;
	СоответствиеИнтервалов = Новый Соответствие;
	
	Связи = Новый Массив;
	
	УниверсальноЗаполнитьИнтервалыФона(ИсходнаяДиаграмма, ТекущаяДиаграмма);
	УниверсальноЗаполнитьШкалу(ИсходнаяДиаграмма, ТекущаяДиаграмма);
	УниверсальноСкопироватьСерии(ИсходнаяДиаграмма, ТекущаяДиаграмма, СоответствиеСерий);
	УниверсальноВывестиТочки(ИсходнаяДиаграмма, ТекущаяДиаграмма, ИсходнаяДиаграмма.Точки, ТекущаяДиаграмма.Точки, Связи,
		СоответствиеСерий, СоответствиеИнтервалов);
	УниверсальноДобавитьСвязи(Связи, СоответствиеИнтервалов);
	
	УсловнаяВысота = УниверсальноПолучитьУсловнуюВысотуДиаграммы(ИсходнаяДиаграмма);
	Если Связи.Количество() > 0 Тогда
		УсловнаяВысота = УсловнаяВысота * 1.25;
	КонецЕсли;
	РисунокДиаграммы.Высота = УсловнаяВысота * 9;
	Для Каждого Элемент Из ИсходнаяДиаграмма.ОбластьПостроения.ШкалаВремени.Элементы Цикл
		Если Элемент.Видимость Тогда
			РисунокДиаграммы.Высота = РисунокДиаграммы.Высота + 20;
		КонецЕсли;
	КонецЦикла;
	Высота = Окр(РисунокДиаграммы.Высота, -1, РежимОкругления.Окр15как20);
	РисунокДиаграммы.Высота = Высота;
	
	ПервыйПроход = Истина;
	РазвернутьСвернутьГруппировки(ТекущаяДиаграмма.Точки, ИсходнаяДиаграмма.Точки,
		ТекущаяДиаграмма, ИсходнаяДиаграмма, ПервыйПроход);
	
	Если НЕ ТекущаяДиаграмма.ОтображатьЛегенду Тогда
		ТекущаяДиаграмма.ОбластьЛегенды.Право = 0;
		ТекущаяДиаграмма.ОбластьПостроения.Право = 1;
	КонецЕсли;
	
	ТекущаяДиаграмма.ПоддержкаМасштаба = ПоддержкаМасштабаДиаграммыГанта.ВсеДанные;
	ТекущаяДиаграмма.АвтоОпределениеПолногоИнтервала = Истина;
	ТекущаяДиаграмма.РастягиваниеПоВертикали = РастягиваниеПоВертикалиДиаграммыГанта.РастягиватьСтрокиИДанные;
	
	ВыводимыйДокумент.АвтоМасштаб = Истина;
	
	Возврат ВыводимыйДокумент;
	
КонецФункции

// Задает набор параметров печати для функции упоПечатьДиаграммыГанта.УниверсальноНапечататьДиаграммуГанта.
//
// Возвращаемое значение:
//	Структура - набор параметров печати.
//
Функция ПараметрыПечатиПоУмолчанию() Экспорт
	
	ПараметрыПечатиДГ = Новый Структура();	
	ПараметрыПечатиДГ.Вставить("Заголовок", "");
	ПараметрыПечатиДГ.Вставить("ОтображениеИнтервала", ОтображениеИнтервалаДиаграммыГанта.Плоский); 
	ПараметрыПечатиДГ.Вставить("Формат", "A4"); // Варианты: "A4"/"A3" (буквы в формате д.б. латинские).
		
	Возврат ПараметрыПечатиДГ;
	
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УниверсальноСкопироватьСерии(ИсходнаяДиаграмма, ТекущаяДиаграмма, пСоответствиеСерий)
	
	Для каждого ИсходнаяСерия Из ИсходнаяДиаграмма.Серии Цикл
		ТекущаяСерия = ТекущаяДиаграмма.Серии.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСерия, ИсходнаяСерия);
		пСоответствиеСерий.Вставить(ИсходнаяСерия, ТекущаяСерия);
	КонецЦикла;
	
КонецФункции 

Функция УниверсальноВывестиТочки(ИсходнаяДиаграмма,
								 ТекущаяДиаграмма,
								 ИсходныеТочки,
								 Точки,
								 пСвязи,
								 пСоответствиеСерий,
								 пСоответствиеИнтервалов)
								 
	// СвойстваТочки: 
	// "ДополнительныйЦвет,Значение,Картинка,ПриоритетЦвета,Расшифровка,Родитель,Текст,Точки,Цвет,ЦветТекста,ЦветФона,Шрифт"
	СвойстваТочки = "ДополнительныйЦвет,Картинка,ПриоритетЦвета,Текст,Цвет,ЦветФона";
	// СвойстваЗначения: "ДополнительныйЦвет,Расшифровка,Редактирование,Серия,Текст,Точка,Цвет,ЦветТекста,ЦветФона"
	СвойстваЗначения = "ДополнительныйЦвет,Текст";	
	// СвойстваИнтервала: "Значение,Конец,Начало,Расшифровка,Текст,Цвет";
	СвойстваИнтервала = "Конец,Начало,Текст,Цвет";
	СвойстваСвязи = "Начало,Конец,ТипСвязи,Цвет"; 
	
	ШрифтАвто = Новый Шрифт;
	ЦветАвто = Новый Цвет;
	
	Для Каждого ИсходнаяТочка Из ИсходныеТочки Цикл
							
		НоваяТочка = Точки.Добавить();	
						
		ЗаполнитьЗначенияСвойств(НоваяТочка, ИсходнаяТочка, СвойстваТочки);		
		// Редко заполняемые поля выводим для ускорения из ЗаполнитьЗначенияСвойств(). 
		// Проверка и присвоение для некоторых делается быстрее заполнения для всех в ЗаполнитьЗначенияСвойств().
		Если Не ИсходнаяТочка.Шрифт = ШрифтАвто Тогда
			НоваяТочка.Шрифт = ИсходнаяТочка.Шрифт;	
		КонецЕсли;	
		Если Не ИсходнаяТочка.ЦветТекста = ЦветАвто Тогда
			НоваяТочка.ЦветТекста = ИсходнаяТочка.ЦветТекста;	
		КонецЕсли;	
		
		Для Каждого КлючЗначение Из пСоответствиеСерий Цикл
			
			ИсходнаяСерия = КлючЗначение.Ключ;
			ТекущаяСерия = КлючЗначение.Значение;
			
			ИсходноеЗначение = ИсходнаяДиаграмма.ПолучитьЗначение(ИсходнаяТочка, ИсходнаяСерия);
			КонечноеЗначение = ТекущаяДиаграмма.ПолучитьЗначение(НоваяТочка, ТекущаяСерия);
			
			ЗаполнитьЗначенияСвойств(КонечноеЗначение, ИсходноеЗначение, СвойстваЗначения);			
			// Редко заполняемые поля выводим для ускорения из ЗаполнитьЗначенияСвойств().
			Если Не ИсходноеЗначение.Цвет = ЦветАвто Тогда
				КонечноеЗначение.Цвет = ИсходноеЗначение.Цвет;	
			КонецЕсли;
			Если Не ИсходноеЗначение.ЦветТекста = ЦветАвто Тогда
				КонечноеЗначение.ЦветТекста = ИсходноеЗначение.ЦветТекста;	
			КонецЕсли;
			Если Не ИсходноеЗначение.ЦветФона = ЦветАвто Тогда
				КонечноеЗначение.ЦветФона = ИсходноеЗначение.ЦветФона;	
			КонецЕсли;	
				
			Для каждого ИсходныйИнтервал Из ИсходноеЗначение Цикл
				
				КонечныйИнтервал = КонечноеЗначение.Добавить();
				ЗаполнитьЗначенияСвойств(КонечныйИнтервал, ИсходныйИнтервал, СвойстваИнтервала);
				
				пСоответствиеИнтервалов.Вставить(ИсходныйИнтервал, КонечныйИнтервал);
				
				Для каждого лСвязь Из ИсходныйИнтервал Цикл					
					Связь = Новый Структура(СвойстваСвязи);
					ЗаполнитьЗначенияСвойств(Связь, лСвязь, СвойстваСвязи);
					пСвязи.Добавить(Связь);
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
				
		// ДГ выводится в режиме просмотра, свернутые группировки вручную не разворачиваются.
		// Поэтому для ускорения работы свернутые группировки не будем детализировать ниже. 
		// Для отображеня "плюсика" в свернутых группировках добавляем одну фейковую строку без заполнения.
		Если ИсходнаяТочка.Точки.Количество() > 0 Тогда
			Если ИсходнаяДиаграмма.РазвернутаТочка(ИсходнаяТочка) Тогда
				УниверсальноВывестиТочки(ИсходнаяДиаграмма, ТекущаяДиаграмма, ИсходнаяТочка.Точки, НоваяТочка.Точки, пСвязи,
					пСоответствиеСерий, пСоответствиеИнтервалов);
			Иначе					
				НоваяТочка.Точки.Добавить(); // Фейковая точка для отображения "плюсика" в свернутых группировках.
			КонецЕсли;	
		КонецЕсли;

	КонецЦикла;
	
КонецФункции 

Функция УниверсальноДобавитьСвязи(пСвязи, пСоответствиеИнтервалов)
	
	Для каждого лСвязь Из пСвязи Цикл
		лНачало = пСоответствиеИнтервалов[лСвязь.Начало];
		лКонец = пСоответствиеИнтервалов[лСвязь.Конец];
		
		Если НЕ лНачало = Неопределено И НЕ лКонец = Неопределено Тогда
			лНовСвязь = лНачало.Добавить(лКонец);
			лНовСвязь.ТипСвязи = лСвязь.ТипСвязи;
			лНовСвязь.Цвет = лСвязь.Цвет;
		КонецЕсли;
	КонецЦикла;	
	
КонецФункции 

Функция УниверсальноЗаполнитьИнтервалыФона(ИсходнаяДиаграмма, ТекущаяДиаграмма)
	
	ТекущиеИнтервалыФона = ТекущаяДиаграмма.ИнтервалыФона;
	Для Каждого ИсходныйИнтервалФона Из ИсходнаяДиаграмма.ИнтервалыФона Цикл
		ТекущийИнтервалФона = ТекущиеИнтервалыФона.Добавить(ИсходныйИнтервалФона.Начало, ИсходныйИнтервалФона.Конец);
		ТекущийИнтервалФона.Цвет = ИсходныйИнтервалФона.Цвет;
	КонецЦикла;	
	
КонецФункции

Функция УниверсальноЗаполнитьШкалу(ИсходнаяДиаграмма, ТекущаяДиаграмма)
	
	СвойстваШкалы = "Видимость,Единица,Кратность,ЛинииДелений,ОтображатьПериодическиеМетки,Формат,ЦветЛиний,ЦветТекста,ЦветФона";
	
	ИсходнаяШкала = ИсходнаяДиаграмма.ОбластьПостроения.ШкалаВремени;
	ТекущаяШкала = ТекущаяДиаграмма.ОбластьПостроения.ШкалаВремени;
	ЗаполнитьЗначенияСвойств(ТекущаяШкала, ИсходнаяШкала);	
	Для Индекс = 0 По ИсходнаяШкала.Элементы.Количество() - 1 Цикл
	    ИсходныйЭлемент = ИсходнаяШкала.Элементы[Индекс];		
		Если Индекс = 0 Тогда
			ТекущийЭлемент = ТекущаяШкала.Элементы[0];
		Иначе
			ТекущийЭлемент = ТекущаяШкала.Элементы.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТекущийЭлемент, ИсходныйЭлемент, СвойстваШкалы);
	КонецЦикла;
	
КонецФункции 

Функция УниверсальноПолучитьУсловнуюВысотуДиаграммы(Диаграмма) 
	
	КоличествоТочек = УниверсальноПолучитьКоличествоТочек(Диаграмма, Диаграмма);
	КоличествоСерий = Диаграмма.Серии.Количество();
	
	МаксимальноеКоличествоСимволовВНазванииЗадач = 1;
	ОпределитьМаксимальноеКоличествоСимволовВНазванииЗадач(Диаграмма, Диаграмма,
		МаксимальноеКоличествоСимволовВНазванииЗадач);
	
	// Найдем коэффициент по формуле "f(L) = (L/МаксДлинаСтроки)^ПодбираемыйПоказатель",
	// которая поможет определить значение в диапазоне от 1 до 4. Именно в этом диапазоне мы можем определить
	// приемлемый коээфициент для растягивания высоты рисунка диаграммы в зависимости от длины текста ПЗ.
	УсловноМаксимальноеКоличествоСимволовВСтроке = 45;
	Степень = Log(4) / Log(256 / УсловноМаксимальноеКоличествоСимволовВСтроке);
	КоэффициентВысотыПоДлинеТекста =
		Pow((МаксимальноеКоличествоСимволовВНазванииЗадач / УсловноМаксимальноеКоличествоСимволовВСтроке), Степень);
	Если КоэффициентВысотыПоДлинеТекста < 1 Тогда
		КоэффициентВысотыПоДлинеТекста = 1;
	КонецЕсли;
	
	Возврат КоличествоТочек * КоличествоСерий * КоэффициентВысотыПоДлинеТекста;
	
КонецФункции

Процедура ОпределитьМаксимальноеКоличествоСимволовВНазванииЗадач(ТочкаДиаграммы, Диаграмма, КоличествоСимволов)
	
	Для Каждого Точка Из ТочкаДиаграммы.Точки Цикл
		КоличествоСимволовТекущаяСтрока = СтрДлина(Точка.Текст);
		Если Диаграмма.РазвернутаТочка(Точка) Тогда
			ОпределитьМаксимальноеКоличествоСимволовВНазванииЗадач(Точка, Диаграмма,
				КоличествоСимволов);
		КонецЕсли;
		
		Если КоличествоСимволовТекущаяСтрока > КоличествоСимволов Тогда
			КоличествоСимволов = КоличествоСимволовТекущаяСтрока;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция УниверсальноПолучитьКоличествоТочек(ТочкаДиаграммы, Диаграмма)
	
	сч = 0;
	Для Каждого Точка Из ТочкаДиаграммы.Точки Цикл
		сч = сч +1;
		Если Диаграмма.РазвернутаТочка(Точка) Тогда
			сч = сч + УниверсальноПолучитьКоличествоТочек(Точка, Диаграмма);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат сч;
	
КонецФункции

Процедура РазвернутьСвернутьГруппировки(ТочкиТекущаяДиаграмма, ТочкиИсходнаяДиаграмма, 
	ТекущаяДиаграмма, ИсходнаяДиаграмма, ПервыйПроход = Ложь)
	
	// Для ускорения обрабатываем только точки с подчиненными. 
	// Точки верхнего уровня разворачиваем полностью в первый проход и дальше только сворачиваем.
	
	Для Каждого ТочкаИсходнаяДиаграмма Из ТочкиИсходнаяДиаграмма Цикл 
		
		Если Не ТочкаИсходнаяДиаграмма.Точки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		ИндексТочкиИсходнаяДиаграмма = ТочкиИсходнаяДиаграмма.Индекс(ТочкаИсходнаяДиаграмма);
		Если ИндексТочкиИсходнаяДиаграмма = -1 Тогда 
			Продолжить;
		КонецЕсли;	
		ТочкаТекущаяДиаграмма = ТочкиТекущаяДиаграмма.Получить(ИндексТочкиИсходнаяДиаграмма);
						
		Если ИсходнаяДиаграмма.РазвернутаТочка(ТочкаИсходнаяДиаграмма) Тогда			
			Если ПервыйПроход Тогда
				ТекущаяДиаграмма.РазвернутьТочку(ТочкаТекущаяДиаграмма, Истина);
			КонецЕсли;	
			РазвернутьСвернутьГруппировки(ТочкаТекущаяДиаграмма.Точки, ТочкаИсходнаяДиаграмма.Точки, ТекущаяДиаграмма, ИсходнаяДиаграмма);
		Иначе
			ТекущаяДиаграмма.СвернутьТочку(ТочкаТекущаяДиаграмма, Ложь);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Функция СтрокаИсключенияКопированияСвойствДГ(ДиаграммаГанта)
		
	// Проверяем на наличие полей серии. В некоторых версиях платформы 8.3.18 эти свойства убирались 
	// и их явное заполнение в исключениях приводило к ошибке.
	
	СтруктураПроверки = Новый Структура("СерияНаОсиТочек", "");
	ЗаполнитьЗначенияСвойств(СтруктураПроверки, ДиаграммаГанта);			
	
	Если упоИнтеграцияКлиентСервер.ДоступныСвойстваДиаграммыДляРасчетаМаксИМинЗначения() Тогда
		СтрокаИсключенияПолей = "АвтоМинимальноеЗначение, ОтображениеИнтервала, АвтоОпределениеПолногоИнтервала";	
	Иначе	
		СтрокаИсключенияПолей = "ОтображениеИнтервала, АвтоОпределениеПолногоИнтервала";	
	КонецЕсли;

	Если СтруктураПроверки.СерияНаОсиТочек <> "" Тогда
		СтрокаИсключенияПолей = СтрокаИсключенияПолей 
			+ ", ИсточникЗначенийОсиТочек, СерияНаОсиТочек, ОбщаяСерияРазмераПузырька";
	КонецЕсли;	

	Возврат СтрокаИсключенияПолей;
	
КонецФункции

#КонецОбласти