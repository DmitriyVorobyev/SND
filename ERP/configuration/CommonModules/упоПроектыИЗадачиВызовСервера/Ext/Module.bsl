// Ищет связь двух объектов.
// 
// Параметры:
//  ТаблицаСвязей – ТаблицаЗначений - содержит связи объектов.
//  ОбъектСвязи   – Произвольный - объект для которого ищется связь.
//  Связь         - Произвольный - искомая связь.
// 
// Возвращаемое значение:
//  Булево - признак связи.
// 
Функция обНайтиСвязь(ТаблицаСвязейВх, Индикатор = Неопределено)

	ТаблицаСвязей = ТаблицаСвязейВх.Скопировать();
	
	ОтборПоСвязи   = Новый Структура;
	ОтборПоОбъекту = Новый Структура;
		
	Пока Истина Цикл
		
		ЭтоПроход = Ложь;
		
		Для Каждого ДанныеСвязи Из ТаблицаСвязей Цикл
			
			ОтборПоСвязи.Вставить("ОбъектСвязи", ДанныеСвязи.Объект);
			НайденныеСвязи = ТаблицаСвязей.НайтиСтроки(ОтборПоСвязи);
			Если НайденныеСвязи.Количество() = 0 Тогда
			ОтборПоОбъекту.Вставить("Объект", ДанныеСвязи.Объект);
				НайденныеСтроки = ТаблицаСвязей.НайтиСтроки(ОтборПоОбъекту);
				Для Каждого ТекСтрока Из НайденныеСтроки Цикл
					ТаблицаСвязей.Удалить(ТекСтрока);
					ЭтоПроход = Истина;
				КонецЦикла;
				
				Прервать; // На следующий проход.
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТаблицаСвязей.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если ЭтоПроход = Ложь Тогда
			Возврат Истина; // Дедлок.
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

// Рекурсивная функция. Проверяет, что одна задача подчинена по иерархии другой задаче.
// 
// Параметры:
//  ТаблицаЗадач – ТаблицаЗначений, содержит связи объектов.
//  Родитель     - СправочникСсылка.ПроектнаяЗадача, проектная задача,
//                 подчинение к которой, проверяется.
//               - СправочникСсылка.Проекты, единичный случай для родительской задачи.
//  Задача       - СправочникСсылка.Проекты, проектная задача,
//                 для которой ищется родительская задача.
// 
// Возвращаемое значение:
//  Булево - Истина, задача являетя родительской.
//              - Ложь, задача не является родительской.
// 
Функция обЭтоРодитель(ТаблицаЗадач, Родитель, Задача)

	Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(Задача) Тогда
		Возврат Ложь; // Дошли до верха.
	КонецЕсли;
	
	Если Задача = Родитель Тогда
		Возврат Истина; // Нашли родителя.
	КонецЕсли;
	
	НайденыйОбъект = ТаблицаЗадач.Найти(Задача, "Задача");
	Если Не НайденыйОбъект = Неопределено Тогда
		Возврат обЭтоРодитель(ТаблицаЗадач, Родитель, НайденыйОбъект.Родитель);
	Иначе
		Возврат Ложь; // Нет родителя (разрыв в иерархии).
	КонецЕсли;
	
КонецФункции

// Рекурсивная функция. Ищет руководителя проектной задачи снизу вверх.
// 
// Параметры:
//  ТаблицаЗадач – ТаблицаЗначений, содержит иерархию проектных задач
//                 и их руководителей.
//  Проект       - СправочникСсылка.Проекты, проект в который входит проектная задача.
//  Задача       - СправочникСсылка.Проекты, проектная задача,
//                 для которой ищется руководитель.
//  Руководитель - СправочникСсылка.упоСотрудники, необязательный параметр, сотрудник по умолчанию.
// 
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено - найденный руководитель проектной задачи.
// 
Функция НайтиРуководителяПроектнойЗадачи(ТаблицаЗадач, Задача, Руководитель = Неопределено)
	
	Возврат упоПроектыИЗадачиСервер.НайтиРуководителяПроектнойЗадачи(ТаблицаЗадач, Задача, Руководитель);
	
КонецФункции

// Функция определяет руководителя проектной задачи.
// Если руководитель проектной задаче не назначен, то возвращается руководитель проекта.
// 
// Параметры:
//  ДанныеДокумента – Структура - содержит полный слепок документа.
// 
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Неопределено - руководитель проектной задачи.
// 
Функция ОпределитьРуководителяПроектнойЗадачи(ДанныеДокумента)

	Проект          = ДанныеДокумента.Проект;
	ПроектнаяЗадача = ДанныеДокумента.ПроектнаяЗадача;
	ЗадачаРодитель  = ДанныеДокумента.ЗадачаРодитель;
	
	// Для начала получим руководителя проекта.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.РуководительПроекта
		|ИЗ
		|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		РуководительПроекта = Результат.Выгрузить()[0].РуководительПроекта;
	КонецЕсли;
	
	массивВозврата = Новый Массив;
	массивВозврата.Добавить(РуководительПроекта);
		
	// Далее получим непосредственного руководителя проектной задачей, если он имеется.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", ПроектнаяЗадача);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.РуководительПроектнойЗадачи
		|ИЗ
		|	РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК Рег
		|ГДЕ
		|	Рег.ПроектнаяЗадача = &Задача";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Руководитель = Результат.Выгрузить()[0].РуководительПроектнойЗадачи;
		Если Не упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(Руководитель) Тогда
			массивВозврата.Добавить(Руководитель);
			Возврат массивВозврата;
		КонецЕсли;
	КонецЕсли;
	
	// Далее получим руководителя вышестоящей проектной задачей, если он имеется.
	
	// Получаем полную иерархию задач проекта и их руководителей.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегСвойства.ПроектнаяЗадача КАК Задача,
		|	РегСвойства.ЗадачаРодитель КАК Родитель,
		|	РегРуководители.РуководительПроектнойЗадачи КАК Руководитель
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК РегСвойства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК РегРуководители
		|		ПО РегСвойства.ПроектнаяЗадача = РегРуководители.ПроектнаяЗадача
		|ГДЕ
		|	НЕ РегСвойства.ЗадачаОтменена";
	
	ТаблицаПроектныхЗадач = Запрос.Выполнить().Выгрузить();
	
	// Рекурсивно ищем руководителя.
	Руководитель = НайтиРуководителяПроектнойЗадачи(ТаблицаПроектныхЗадач, ЗадачаРодитель, РуководительПроекта);
	
	массивВозврата.Добавить(Руководитель);
	
	Возврат массивВозврата;

КонецФункции

Функция ПолучитьДетей(Родитель, Родители, ДетиУбраны)
	Если ДетиУбраны[Родитель] = Неопределено Тогда
		убратьРодителейИзДетей(Родители, Родитель, ДетиУбраны);
	КонецЕсли;
	
	Возврат Родители[Родитель];
КонецФункции

Функция ПолучитьСледующие(Задача, Следующие, СледующиеГотовы, СледующиеБезИерархии, Родители, ДетиУбраны)
	
	Если СледующиеГотовы[Задача] = Неопределено Тогда
		текСледующие = Следующие[Задача];
		Если НЕ текСледующие = Неопределено Тогда
			Для каждого текСледующий Из текСледующие Цикл
				ЗаполнитьСледующие(текСледующий, Задача, СледующиеБезИерархии, Родители, ДетиУбраны);
			КонецЦикла;
		КонецЕсли;
		
		СледующиеГотовы.Вставить(Задача, Истина);
	КонецЕсли;
	
	Возврат СледующиеБезИерархии[Задача];
	
КонецФункции

Процедура ЗаполнитьСледующие(ЭлементПроекта, СвязанныйЭлемент, Следующие, Родители, ДетиУбраны)
	
	детиЭлемента = ПолучитьДетей(ЭлементПроекта, Родители, ДетиУбраны);
	детиСвязанного = ПолучитьДетей(СвязанныйЭлемент, Родители, ДетиУбраны);
	
	Если детиЭлемента = Неопределено И детиСвязанного = Неопределено Тогда
		// Оба элемента связи не являются родителями.
		
		данныеЭлемента = Следующие[СвязанныйЭлемент];
		
		Если данныеЭлемента = Неопределено Тогда
			данныеЭлемента = Новый Соответствие;
		КонецЕсли;
		
		данныеЭлемента.Вставить(ЭлементПроекта, Истина);
		Следующие.Вставить(СвязанныйЭлемент, данныеЭлемента);
		
	ИначеЕсли НЕ детиЭлемента = Неопределено И НЕ детиСвязанного = Неопределено Тогда
		// Оба элемента связи являются родителями.
		
		Для каждого ребенокСвязанного Из детиСвязанного Цикл
			данныеЭлемента = Следующие[ребенокСвязанного.Ключ];
			Если данныеЭлемента = Неопределено Тогда
				данныеЭлемента = Новый Соответствие;
			КонецЕсли;
			
			Для каждого ребенок Из детиЭлемента Цикл
				данныеЭлемента.Вставить(ребенок.Ключ, Истина);
			КонецЦикла;
			
			Следующие.Вставить(ребенокСвязанного.Ключ, данныеЭлемента);
		КонецЦикла;
		
	ИначеЕсли детиЭлемента = Неопределено И НЕ детиСвязанного = Неопределено Тогда
		// Элемент связан с родителем.
		
		Для каждого ребенокСвязанного Из детиСвязанного Цикл
			данныеЭлемента = Следующие[ребенокСвязанного.Ключ];
			Если данныеЭлемента = Неопределено Тогда
				данныеЭлемента = Новый Соответствие;
			КонецЕсли;
			
			данныеЭлемента.Вставить(ЭлементПроекта, Истина);
			Следующие.Вставить(ребенокСвязанного.Ключ, данныеЭлемента);
		КонецЦикла;
		
	ИначеЕсли НЕ детиЭлемента = Неопределено И детиСвязанного = Неопределено Тогда
		// Элемент-родитель связан с элементом.
		
		данныеЭлемента = Следующие[СвязанныйЭлемент];
		Если данныеЭлемента = Неопределено Тогда
			данныеЭлемента = Новый Соответствие;
		КонецЕсли;
		
		Для каждого ребенок Из детиЭлемента Цикл
			данныеЭлемента.Вставить(ребенок.Ключ, Истина);
		КонецЦикла;
		
		Следующие.Вставить(СвязанныйЭлемент, данныеЭлемента);
	КонецЕсли;
	
КонецПроцедуры

// Процедура (рекурсивная) обрабатывает Соответствие, в котором каждому элементу соотнесены
// подчинненные элементы. Процедура устраняет из подчиненных элементов элементы Родители.
//
// Параметры:
//  Родители  	– Соответствие - содержит родителей и их подчиненных элементов:
//					Ключ		- Любая ссылка, элемент проекта, у которого если подчиненные элементы.
//					Значение	- Соответствие, подчиненные по иерархии элементы.
//  Родитель  	– СправочникСсылка, ДокументСсылка - элемент проекта, который обрабатывается на данной итерации.
//  ДетиУбраны – Соответствие - хранит элементы проекта, которые уже были обработаны.
//
Процедура убратьРодителейИзДетей(Родители, Родитель, ДетиУбраны)
	
	Дети = Родители[Родитель];
	Если Дети = Неопределено Тогда
		ДетиУбраны.Вставить(Родитель, Истина);
		Возврат;
	КонецЕсли;
	
	Для каждого кизРебенок Из Дети Цикл
		ребенок = кизРебенок.Ключ;
		Если Не Родители[ребенок] = Неопределено Тогда
			Если ДетиУбраны[ребенок] = Неопределено Тогда
				убратьРодителейИзДетей(Родители, ребенок, ДетиУбраны);
			КонецЕсли;
			Дети.Удалить(ребенок);
			Для каждого новыйРебенок Из Родители[ребенок] Цикл
			    Дети.Вставить(новыйРебенок.Ключ, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Родители.Вставить(Родитель, Дети);
	ДетиУбраны.Вставить(Родитель, Истина);
	
КонецПроцедуры

// Функция проходит в глубину по следующим элементам и ищет элемент.
//
// Параметры:
//  текЭлемент  		– Произвольный - текущий рассматриваемый узел.
//  Следующие  			– Соответствие - содержит все следующие элементы для всех элементов.
//  ПредыдущиеЭлементы  – Соответствие - соответствие, содержащее элементы, которые необходимо найти.
//  ПройденныеПодВетки  – Соответствие - ветки, уже пройденные и проводить не имеет смысла.
//  НайденныйЦикл		– Массив - содержит элементы найденного цикла.
//
// Возвращаемое значение:
//   Булево   – Истина: в ветке найден предыдущий, Ложь: в ветке не найден предыдущий.
//
Функция ИскатьПредыдущиеВВетке(текЭлемент,
							   ПредыдущиеЭлементы,
							   ПройденныеПодВетки,
							   НайденныйЦикл, 
							   Следующие,
							   СледующиеГотовы,
							   СледующиеБезИерархии,
							   Родители,
							   детиУбраны)
							   
	Если НЕ ПредыдущиеЭлементы[текЭлемент] = Неопределено Тогда
		НайденныйЦикл.Добавить(текЭлемент);
		Возврат Истина;
	КонецЕсли;
	
	СледующиеЭлементы = ПолучитьСледующие(текЭлемент, Следующие, СледующиеГотовы, СледующиеБезИерархии, Родители, детиУбраны);
	Если НЕ СледующиеЭлементы = Неопределено Тогда
		Для каждого следующий Из СледующиеЭлементы Цикл
			Если следующий.Ключ = текЭлемент Тогда
				НайденныйЦикл.Добавить(текЭлемент);
				Возврат Истина;
			КонецЕсли;
			Если ПройденныеПодВетки[следующий.Ключ] = Неопределено Тогда
				Если ИскатьПредыдущиеВВетке(следующий.Ключ,
											ПредыдущиеЭлементы,
											ПройденныеПодВетки,
											НайденныйЦикл,
											Следующие,
											СледующиеГотовы, 
											СледующиеБезИерархии,
											Родители,
											детиУбраны) Тогда
					НайденныйЦикл.Добавить(текЭлемент);
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ПройденныеПодВетки.Вставить(текЭлемент, Истина);
	
	Возврат Ложь;
КонецФункции

// Внутренняя процедура. Добавляет в заданную таблицу ошибок, новую ошибку по заданным параметрам.
// 
// Параметры:
//  Таблица             – ТаблицаЗначений - таблица ошибок.
//  Объект              – ДокументСсылка - ссылка на объект проверки в которой обнаружена ошибка.
//  ОбъектПредставление – Строка - представление объекта.
//  ТекстОшибки         – Строка - текст описания ошибки.
// 
// Возвращаемое значение:
//  Структура – содержит обнаруженные ошибки при проверке:
//	 * ВылезаетСрокНачала     - Строка - описание ошибки.
//	 * ВылезаетСрокЗавершения - Строка - описание ошибки.
//	 * ВылезаетКрайнийСрок    - Строка - описание ошибки.
// 
Процедура обДобавитьОшибку(Таблица, Объект = Неопределено, ОбъектПредставление = Неопределено, ИндексКартинки = 0, 
		ТекстОшибки = Неопределено, ДопИнформация = Неопределено)
	
	Если ТекстОшибки = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Нет текста.'");
	КонецЕсли;
	
	Если ДопИнформация <> Неопределено Тогда
		ТекстОшибки = ТекстОшибки + " %1";
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ДопИнформация);
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		НоваяСтрока = Таблица.Задачи.Добавить();
		НоваяСтрока.Задача = Объект;
		НоваяСтрока.ЗадачаПредставление = ОбъектПредставление;
		НоваяСтрока.ЗадачаТекстОшибки = ТекстОшибки;
		НоваяСтрока.ИндексКартинки = ИндексКартинки;
	Иначе
		НоваяСтрока = Таблица.Общие.Добавить();
		НоваяСтрока.ТекстОшибки = ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

// Главная функция. Основной модуль. Проверяет проект на наличие ошибок по заданным условиям,
// и добавляет обнаруженные ошибки в заданную таблицу ошибок.
// 
// Параметры:
//  ТаблицаОшибок       – ТаблицаЗначений - таблица ошибок.
//  СтруктураПроверки   – Структура - содержит параметры (условия) проверки,
//                        настроенные пользователем или системой.
//  ОтключитьИндикатор  – Булево - признак индикации состояния процесса проверки.
// 
// Возвращаемое значение:
//  Булево - Признак успешного проведения проверки.
// 
Функция обПроверитьПроект(ТаблицаОшибок, СтруктураПроверки, ОтключитьИндикатор = Ложь)

	// Разберем входную структуру.
	Проект                         = СтруктураПроверки.Проект;
	ПроверятьСтруктуруЗадач        = СтруктураПроверки.ПроверятьСтруктуруЗадач;
	ПроверятьСрокиЗадач            = СтруктураПроверки.ПроверятьСрокиЗадач;
	ПроверятьЗаполнениеСроковЗадач = СтруктураПроверки.ПроверятьЗаполнениеСроковЗадач;
	ПроверятьПредУсловияЗадач      = СтруктураПроверки.ПроверятьПредУсловияЗадач;
	ПроверятьЗацикливание          = СтруктураПроверки.ПроверятьЗацикливание;
	
	Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(Проект) Тогда
		Возврат Ложь; // Нечего проверять - пустая таблица.
	КонецЕсли;
	
	// ПРЕДВАРИТЕЛЬНАЯ ПОДГОТОВКА ДАННЫХ ДЛЯ КОМПЛЕКСНОЙ ПРОВЕРКИ ПРОЕКТА.
			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("ТекущаяВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
	
	// Получим статус проекта.
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Рег.СтатусПроекта
	|ИЗ
	|	РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		обДобавитьОшибку(ТаблицаОшибок, Документы.упоПроектнаяЗадача.ПустаяСсылка(), "", 0, НСтр("ru = 'Проект не был зарегистрирован'"));
		
		Возврат Истина; // Выходим, так как дальнейшие действия не имеют смысла.
	КонецЕсли;
		
	// Получим все предусловия проектных задач для заданного проекта.
	// Получим полное описание каждой проектной задачи для заданного проекта.
	// Место в иерархии, основные параметры и сроки.
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегСвязиЗадач.ПроектнаяЗадача КАК Объект,
	|	РегСвязиЗадач.ЗадачаПредшественник КАК ОбъектСвязи,
	|	РегСвязиЗадач.ТипСвязи КАК ТипСвязи,
	|	РегСвязиЗадач.Задержка КАК Задержка
	|ИЗ
	|	РегистрСведений.упоПредусловияПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК РегСвязиЗадач
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	|				И (упоВерсииПроекта.Текущая)
	|				И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	|		ПО РегСвязиЗадач.ЗадачаПредшественник = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	|ГДЕ
	|	РегСвязиЗадач.СвязьСуществует
	|	И НЕ РегСвязиЗадач.СвязьМеждуПроектами
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегСвойства.ПроектнаяЗадача КАК Задача,
	|	РегСвойства.ЗадачаРодитель КАК Родитель,
	|	РегСвойства.КрайнийСрок КАК КрайнийСрок,
	|	РегСроки.ДатаНачалаПлан КАК ДатаНачалаПлан,
	|	РегСроки.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
	|	РегСвойства.РучнойВводСроков КАК РучнойВводСроков,
	|	РегСвойства.ЭтоПакетРабот КАК ЭтоПакетРабот,
	|	Проекты.КодСДР + "" "" + Проекты.Наименование КАК НазваниеЗадачи,
	|	ВЫБОР
	|		КОГДА РегСвойства.ЭтоВеха
	|			ТОГДА 4
	|		ИНАЧЕ ВЫБОР
	|				КОГДА РегСвойства.ЭтоМодельПакетаРабот
	|					ТОГДА 3
	|				ИНАЧЕ ВЫБОР
	|						КОГДА НЕ РегСвойства.ЭтоПакетРабот И НЕ РегСвойства.ЭтоМодельПакетаРабот
	|							ТОГДА 0
	|						ИНАЧЕ 1
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ИндексКартинки
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК РегСвойства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК РегСроки
	|		ПО РегСвойства.ПроектнаяЗадача = РегСроки.ПроектнаяЗадача
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО РегСвойства.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	|ГДЕ
	|	НЕ РегСвойства.ЗадачаОтменена
	|
	|УПОРЯДОЧИТЬ ПО
	|	Задача";
	
	РезультатВыполнения = Запрос.ВыполнитьПакет();
	
	ТаблицаСвязейЗадач = РезультатВыполнения[0].Выгрузить();
	ТаблицаЗадач = РезультатВыполнения[1].Выгрузить();
	
	// КОМПЛЕКСНАЯ ПРОВЕРКА ПРОЕКТНЫХ ЗАДАЧ.	
	
	Если ПроверятьСтруктуруЗадач = Истина 
		Или ПроверятьЗаполнениеСроковЗадач = Истина 
		Или ПроверятьСрокиЗадач = Истина 
		Или ПроверятьПредУсловияЗадач Тогда
		
		// Перебираем данные каждой задачи проекта.
		Для Каждого ДанныеЗадачи Из ТаблицаЗадач Цикл
			
			// Сразу получим нужные данные о задаче.
			Задача           = ДанныеЗадачи.Задача;
			НазваниеЗадачи   = ДанныеЗадачи.НазваниеЗадачи;
			Родитель         = ДанныеЗадачи.Родитель;
			ИндексКартинки	 = ДанныеЗадачи.ИндексКартинки;
			
			// Сразу получим нужные данные о сроках задачи.
			ЗадачаДатаНачала     = ?(ДанныеЗадачи.ДатаНачалаПлан = NULL, Неопределено, 
				НачалоДня(ДанныеЗадачи.ДатаНачалаПлан));
			ЗадачаДатаЗавершения = ?(ДанныеЗадачи.ДатаЗавершенияПлан = NULL, Неопределено, 
				НачалоДня(ДанныеЗадачи.ДатаЗавершенияПлан));
			ЗадачаКрайнийСрок    = ДанныеЗадачи.КрайнийСрок;
				
			Если ПроверятьСтруктуруЗадач = Истина Или ПроверятьЗаполнениеСроковЗадач = Истина Или ПроверятьСрокиЗадач = Истина Тогда
		
				// Ищем родительскую задачу.
				ДанныеРодителя = ТаблицаЗадач.Найти(Родитель, "Задача");
				Если Не Родитель.Пустая() Тогда
					Если ДанныеРодителя = Неопределено Тогда
						Если ПроверятьСтруктуруЗадач = Истина Тогда
							обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, НСтр("ru = 'В СДР не найдена задача-родитель'"));
						КонецЕсли; // ПроверятьСтруктуруЗадач.
					Иначе
						Если ПроверятьСтруктуруЗадач = Истина И ДанныеРодителя.ЭтоПакетРабот = Истина Тогда
							обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
								НСтр("ru = 'Задача-родитель является пакетом работ и не может выступать в роли родительской задачи!'"));
						КонецЕсли; // ПроверятьСтруктуруЗадач.
						
						// Сразу получим нужные данные о сроках родительской задачи.
						РодительДатаНачала     = ?(ДанныеРодителя.ДатаНачалаПлан = NULL, Неопределено, 
							НачалоДня(ДанныеРодителя.ДатаНачалаПлан));
						РодительДатаЗавершения = ?(ДанныеРодителя.ДатаЗавершенияПлан = NULL, Неопределено, 
							НачалоДня(ДанныеРодителя.ДатаЗавершенияПлан));
						РодительКрайнийСрок    = ДанныеРодителя.КрайнийСрок;
						
					КонецЕсли;
				КонецЕсли;
				
				// Ищем сроки задачи.
				// Возможно, эта проверка - лишняя.
				Если Не ЗадачаДатаНачала = Неопределено И Не ЗадачаДатаЗавершения = Неопределено Тогда
					// Такое может быть, если нет записи в регистре сроков.
					Если ПроверятьЗаполнениеСроковЗадач = Истина Тогда
						// Проверим сроки на заполненность.
						Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ЗадачаДатаНачала) Тогда
							обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, НСтр("ru = 'Пустая дата начала работ'"));
						КонецЕсли;
						Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ЗадачаДатаЗавершения) Тогда
							обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, НСтр("ru = 'Пустая дата завершения работ'"));
						КонецЕсли;
						// Крайний срок может быть незаполненным по определению.
					КонецЕсли;
						
					// Проверим корректность сроков текущей задачи.
					Если Не упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ЗадачаДатаЗавершения) 
						И ЗадачаДатаЗавершения < ЗадачаДатаНачала Тогда
						обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, НСтр("ru = 'Конфликт между датами начала и завершения работ'"));
					КонецЕсли;

					Если ПроверятьСрокиЗадач = Истина Тогда
						Если Не упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ЗадачаКрайнийСрок) Тогда
							Если ЗадачаКрайнийСрок < ЗадачаДатаНачала Тогда
								обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
									НСтр("ru = 'Конфликт между датой начала работ и крайним сроком'"));
							КонецЕсли;
							Если ЗадачаКрайнийСрок < ЗадачаДатаЗавершения Тогда
								обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
									НСтр("ru = 'Конфликт между датой завершения работ и крайним сроком'"));
							КонецЕсли;
						КонецЕсли;
						
						ВходящиеПараметы = Новый Структура;
						ВходящиеПараметы.Вставить("Родитель", Родитель);
						ВходящиеПараметы.Вставить("ДанныеРодителя", ДанныеРодителя);
						ВходящиеПараметы.Вставить("РодительДатаНачала", РодительДатаНачала);
						ВходящиеПараметы.Вставить("РодительДатаЗавершения", РодительДатаЗавершения);
						ВходящиеПараметы.Вставить("ТаблицаОшибок", ТаблицаОшибок);
						ВходящиеПараметы.Вставить("Задача", Задача);
						ВходящиеПараметы.Вставить("НазваниеЗадачи", НазваниеЗадачи);
						ВходящиеПараметы.Вставить("ЗадачаДатаНачала", ЗадачаДатаНачала);
						ВходящиеПараметы.Вставить("РодительКрайнийСрок", РодительКрайнийСрок);
						ВходящиеПараметы.Вставить("ЗадачаДатаЗавершения", ЗадачаДатаЗавершения);
						ВходящиеПараметы.Вставить("ЗадачаКрайнийСрок", ЗадачаКрайнийСрок);
						ВходящиеПараметы.Вставить("ИндексКартинки", ИндексКартинки);
						ПроверитьСрокиЗадачИЗадачРодителей(ВходящиеПараметы);
						
					КонецЕсли; // ПроверятьСрокиЗадач.
				Иначе
					обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, НСтр("ru = 'Не обнаружены плановые сроки проектной задачи'"));
				КонецЕсли;
				
			КонецЕсли; // Проверки.
			
			Если ПроверятьПредУсловияЗадач = Истина Тогда
				// Ищем предусловия текущей задачи.
				Отбор = Новый Структура("Объект", Задача);
				ПредусловияЗадачи = ТаблицаСвязейЗадач.НайтиСтроки(Отбор);
				
				Для Каждого ПредУсловие Из ПредусловияЗадачи Цикл
					// Сразу получим нужные данные о предшественнике задачи.
					Предшественник = ПредУсловие.ОбъектСвязи;
					
					// Проверим тип предшественника.
					Если ТипЗнч(Предшественник) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
						НазваниеПредшественника = Предшественник.НазваниеПроектнойЗадачи;
						
						// Ищем задачу-предшественника, ее может и не быть.
						ДанныеПредшественника = ТаблицаЗадач.Найти(Предшественник, "Задача");
						Если Не ДанныеПредшественника = Неопределено Тогда
							// Сразу получим нужные данные о сроке завершения задачи-предшественника
							ПредшественникДатаЗавершения = ДанныеПредшественника.ДатаЗавершенияПлан;
							ПредшественникДатаНачала = ДанныеПредшественника.ДатаНачалаПлан;
							
							// Проверим что задача-предшественник не является самой задачей.
							Если Предшественник = Задача Тогда
								СтрокаСообщения = НСтр("ru = 'Задача является предусловием сама для себя'");
								обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, СтрокаСообщения);
							Иначе
								// Проверим задачу-предшественника на родительскую связь.
								Если обЭтоРодитель(ТаблицаЗадач, Предшественник, Задача) Тогда
									СтрокаСообщения = НСтр("ru = 'Предусловие является задачей-родителем'");
									обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, СтрокаСообщения);
								КонецЕсли;
								// Проверим задачу-предшественника на подчиненность.
								Если обЭтоРодитель(ТаблицаЗадач, Задача, Предшественник) Тогда
									СтрокаСообщения = НСтр("ru = 'Предусловие является подчиненной задачей'");
									обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, СтрокаСообщения);
								КонецЕсли;
							КонецЕсли;
							
						Иначе	
							// Не нашли задачу-предшественника вообще.
							СтрокаСообщения = НСтр("ru = 'Предусловие не обнаружено в структуре проекта'");
							обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, СтрокаСообщения);
						КонецЕсли;
						
					Иначе
						// Не определили тип предшественника. 
						СтрокаСообщения = НСтр("ru = 'Неправильный тип объекта-предусловия'");
						обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки, СтрокаСообщения);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли; // ПроверятьПредУсловияЗадач.
			
		КонецЦикла;
		
	КонецЕсли;
			
	Если ПроверятьЗацикливание = Истина Тогда
		
		// Поиск цикличных связей.
		
		// Формируем полную таблицу элементов проекта и связей между ними.
		ТаблицаЭлементов = Новый ТаблицаЗначений;
		ТаблицаЭлементов.Колонки.Добавить("ЭлементПроекта");
		ТаблицаЭлементов.Колонки.Добавить("ЭлементРодитель"); 		
		Для Каждого СтрокаЗадача Из ТаблицаЗадач Цикл     			
			НоваяСтрокаЭлемент = ТаблицаЭлементов.Добавить();
			НоваяСтрокаЭлемент.ЭлементПроекта = СтрокаЗадача.Задача;
			НоваяСтрокаЭлемент.ЭлементРодитель = СтрокаЗадача.Родитель;
		КонецЦикла;    		
	
		ТаблицаСвязейПолная = Новый ТаблицаЗначений;
		ТаблицаСвязейПолная.Колонки.Добавить("ЭлементПроекта");
		ТаблицаСвязейПолная.Колонки.Добавить("СвязанныйЭлемент");		                   
		Для Каждого СтрокаСвязьЗадачи Из ТаблицаСвязейЗадач Цикл
			НоваяСтрокаСвязь = ТаблицаСвязейПолная.Добавить();
			НоваяСтрокаСвязь.ЭлементПроекта = СтрокаСвязьЗадачи.Объект;
			НоваяСтрокаСвязь.СвязанныйЭлемент = СтрокаСвязьЗадачи.ОбъектСвязи;
		КонецЦикла;    		
		
		ТаблицаОшибокПредусловий = Новый ТаблицаЗначений;
		ТаблицаОшибокПредусловий.Колонки.Добавить("ЭлементПроекта");
		ТаблицаОшибокПредусловий.Колонки.Добавить("ЭлементПроектаПредставление");
		ТаблицаОшибокПредусловий.Колонки.Добавить("ТекстОшибки");
		
		упоПроектыИЗадачиСервер.ПроверитьНаЦикличность(ТаблицаЭлементов, ТаблицаСвязейПолная, ТаблицаОшибокПредусловий,
			Документы.упоПроектнаяЗадача.ПустаяСсылка());
		Для Каждого СтрокаОшибкаПредусловия Из ТаблицаОшибокПредусловий Цикл
			Если ТипЗнч(СтрокаОшибкаПредусловия.ЭлементПроекта) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
				СтрокаОшибка = ТаблицаОшибок.Задачи.Добавить();
				СтрокаОшибка.Задача = СтрокаОшибкаПредусловия.ЭлементПроекта;
				СтрокаОшибка.ЗадачаПредставление = СтрокаОшибкаПредусловия.ЭлементПроектаПредставление;
				СтрокаОшибка.ЗадачаТекстОшибки = СтрокаОшибкаПредусловия.ТекстОшибки;
			КонецЕсли;	 			
		КонецЦикла;  
		
	КонецЕсли;
			
	Возврат Истина;
	
КонецФункции

// Рекурсивная функция. Заполняет дерево задач от заданной задачи родителя.
// 
// Параметры:
//  Дерево        – ДеревоЗначений, содержит пустое дерево, актуально при первом вызове,
//                - СтрокаДереваЗначений, содержит ветку дерева для дальнейшего заполнения.
//  ТаблицаЗадач  – ТаблицаЗначений, содержит иерархию проектных задач.
//  Родитель      - СправочникСсылка.Проекты, содержит сам проект, актуально при первом вызове,
//                - ДокументСсылка.упоПроектнаяЗадача, содержитм задачу родителя.
//  ЭтоКорень     - Булево, признак самого верхнего уровня дерева.
// 
// Возвращаемое значение:
//  ДеревоЗначенй – сформированное дерево проектных задач.
//                       Структура колонок: название задачи,
//                       код СДР и ссылка на саму задачу.
// 
Функция обЗаполнитьДерево(Дерево, ТаблицаЗадач, Родитель)
	
	// Формируем отбор по родителю.
	Отбор = Новый Структура("Родитель", Родитель);
	
	// Находим все задачи по заданному родителю.
	НайденныеСтроки = ТаблицаЗадач.НайтиСтроки(Отбор);
	СтартовыйКод = 1; // Начальный код СДР для ствола дерева.
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Ветка = Дерево.Строки.Добавить(); // Добавляем строку к дереву.
		Ветка.НазваниеПроектнойЗадачи = НайденнаяСтрока.НазваниеЗадачи; // Определяем строке название задачи.
		Ветка.КодСДР                  = НайденнаяСтрока.КодСДР; // Определяем код СДР задачу.
		Ветка.ПроектнаяЗадача         = НайденнаяСтрока.Задача; // Определяем строке задачу.
		обЗаполнитьДерево(Ветка, ТаблицаЗадач, Ветка.ПроектнаяЗадача); // Вызываем рекурсию.
	КонецЦикла;
	
КонецФункции

// Рекурсивная функция. Рассчитывает и заполняет заданную таблицу задач кодами СДР по заданным параметрам.
// 
// Параметры:
//  ТаблицаКодовСДР - ТаблицаЗначений - содержит подготовленную таблицу задач для заполнения кодами СДР.
//  ТаблицаЗадач    – ТаблицаЗначений - содержит таблицу иерархии задач.
//  Родитель        – ДокументСсылка.упоПроектнаяЗадача - родительская задача от которой ведется расчет.
//  КодРодителя     – Сторка - код СДР родительской задачи, на конце ".".
//  Замещать        – Булево - если Истина, то спускаемся по иерархии, даже если код СДР не поменялся.
// 
Функция обЗаполнитьКодыСДР(ТаблицаКодовСДР, ТаблицаЗадач, Родитель, КодРодителя = "", Замещать = Ложь, ИскатьДубли = Ложь)
	
	// Формируем отбор по родителю.
	Отбор = Новый Структура("Родитель", Родитель);
	
	// Находим все задачи по заданному родителю.
	НайденныеЗадачи = ТаблицаЗадач.НайтиСтроки(Отбор);
	
	КолвоЦифр = СтрДлина(Строка(НайденныеЗадачи.Количество()));
	форматнаяСтрока = "ЧЦ=" + КолвоЦифр + "; ЧВН=; ЧГ=0";
	
	СтартовыйКод = 1; // Начальный код СДР для ствола дерева.
	Для Каждого НайденнаяЗадача Из НайденныеЗадачи Цикл
		
		Строка = Неопределено;
		ужеБылаЗаполнена = Ложь; ПредКод = "";
		Если ИскатьДубли Тогда
			Строка = ТаблицаКодовСДР.Найти(НайденнаяЗадача.Задача, "ПроектнаяЗадача");
			Если Не Строка = Неопределено Тогда
				ужеБылаЗаполнена = Истина; ПредКод = Строка.КодСДР;
			КонецЕсли;
		КонецЕсли;
		
		Если Строка = Неопределено Тогда
			Строка = ТаблицаКодовСДР.Добавить(); // Добавляем строку.
			Строка.ПроектнаяЗадача 	= НайденнаяЗадача.Задача; // Определяем строке задачу.
		КонецЕсли;
		Строка.КодСДР = Строка(КодРодителя) + Формат(СтартовыйКод, форматнаяСтрока);
		
		СтартовыйКод = СтартовыйКод + 1; // Увеличиваем код СДР на единицу.
		
		Если Не Строка.КодСДР = ?(ужеБылаЗаполнена, ПредКод, НайденнаяЗадача.КодСДР) ИЛИ Замещать Тогда
			// Вызываем рекурсию.
			обЗаполнитьКодыСДР(ТаблицаКодовСДР, ТаблицаЗадач, Строка.ПроектнаяЗадача, Строка.КодСДР + ".", , ИскатьДубли);
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

// Обновляет коды СДР.
//
// Похожий функционал реализован в функции ЗаполнитьКодыСДРвДереве формы обработки упоУпрощенныйВводСтруктурыПроекта,
// а также в упоБиблиотекаШаблоновВызовСервера.РассчитатьКодСДРДляЗадач.
//
// Параметры:
//  ЭлементИнициатор	 - ДокументСсылка.упоПроектнаяЗадача - ссылка на проектную задачу.
//  НовыйРодитель		 - ДокументСсылка.упоПроектнаяЗадача - необязательный. Новый родитель, если параметр задан.
//  СтарыйРодитель		 - ДокументСсылка.упоПроектнаяЗадача - необязательный. Старый родитель.
//  Направление			 - ПеречисленияСсылка.упоНаправлениеДвиженияПоСДР - направление движения по СДР.
//  ЗаписыватьИзменения	 - Булево - признак необходимости записи изменений по кодам в объектах.
//
// Возвращаемое значение:
//	Соответствие - в качестве ключа выступает ссылка, а в качестве значения - новый код СДР.
//
Функция обОбновитьКодСДР(
			Знач ЭлементИнициатор = Неопределено, 
			Знач НовыйРодитель = Неопределено, 
			Знач СтарыйРодитель = Неопределено, 
			Направление = Неопределено, 
			ЗаписыватьИзменения = Ложь) Экспорт 
			
	// Возвращает соответствие ссылка -> КодСДР (новый).
	ТемпИзмененныеКодыСДР = Новый Соответствие;
	ТемпКодыСДР = Новый Соответствие;
	ТемпИерархия = Новый Соответствие;
	
	Если ЭлементИнициатор = Неопределено И НовыйРодитель = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭлементИнициатор = ПолучитьСсылкуНаПроект(ЭлементИнициатор);
	НовыйРодитель = ПолучитьСсылкуНаПроект(НовыйРодитель);
	СтарыйРодитель = ПолучитьСсылкуНаПроект(СтарыйРодитель);
	
	Если Не ЭлементИнициатор = Неопределено И Не ЗначениеЗаполнено(НовыйРодитель) Тогда
		НовыйРодитель = ЭлементИнициатор.Родитель;
	КонецЕсли;
	
	ВерхнийИзРодителей = Неопределено;
	
	Если Направление = Неопределено Тогда
		Направление = Перечисления.упоНаправлениеДвиженияПоСДР.НеПеремещать;
	КонецЕсли;
	
	// Получим иерархию задач по родителям.
	
	Если СтарыйРодитель = НовыйРодитель Тогда
		ЗаполнитьИерархию(СтарыйРодитель, ТемпИерархия, ТемпКодыСДР);
	Иначе
		ЗаполнитьИерархию(СтарыйРодитель, ТемпИерархия, ТемпКодыСДР, НовыйРодитель, ВерхнийИзРодителей);
		Если Не СтарыйРодитель = ВерхнийИзРодителей Или СтарыйРодитель = Неопределено Тогда
			ЗаполнитьИерархию(НовыйРодитель, ТемпИерархия, ТемпКодыСДР, СтарыйРодитель, ВерхнийИзРодителей);
		КонецЕсли;
		
		// Если родители разные (т.е. изменилась иерархия элемента), то надо элемент поставить в конец.
		Если ЗначениеЗаполнено(СтарыйРодитель) И ЗначениеЗаполнено(НовыйРодитель) И ЗначениеЗаполнено(ЭлементИнициатор) Тогда
			ТемпКодыСДР.Вставить(ЭлементИнициатор, "а");
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЭлементИнициатор = Неопределено И ТемпКодыСДР[ЭлементИнициатор] = Неопределено Тогда
		// Значит элемент новый и надо присвоить ему какой-нибудь код СДР.
		ТемпКодыСДР.Вставить(ЭлементИнициатор, "а");
	КонецЕсли;
	
	Если Не ЭлементИнициатор = Неопределено Тогда
		дети = ТемпИерархия[СтарыйРодитель];
		Если НЕ дети = Неопределено Тогда
			дети.Удалить(ЭлементИнициатор);
		КонецЕсли;
		
		дети = ТемпИерархия[НовыйРодитель];
		Если дети = Неопределено Тогда
			дети = Новый Соответствие;
			ТемпИерархия.Вставить(НовыйРодитель, дети);
		КонецЕсли;
		
		дети.Вставить(ЭлементИнициатор, Истина);
	КонецЕсли;
	
	Если ВерхнийИзРодителей = Неопределено Тогда
		ЗаполнитьКодыСДР(СтарыйРодитель, ТемпИерархия, ТемпКодыСДР, ТемпИзмененныеКодыСДР, ЭлементИнициатор, Направление);
		ЗаполнитьКодыСДР(НовыйРодитель , ТемпИерархия, ТемпКодыСДР, ТемпИзмененныеКодыСДР, ЭлементИнициатор, Направление);
	Иначе
		ЗаполнитьКодыСДР(ВерхнийИзРодителей, ТемпИерархия, ТемпКодыСДР, ТемпИзмененныеКодыСДР, ЭлементИнициатор, Направление);
		Если ВерхнийИзРодителей = СтарыйРодитель Тогда
			ЗаполнитьКодыСДР(НовыйРодитель, ТемпИерархия, ТемпКодыСДР, ТемпИзмененныеКодыСДР, ЭлементИнициатор, Направление);
		Иначе
			ЗаполнитьКодыСДР(СтарыйРодитель, ТемпИерархия, ТемпКодыСДР, ТемпИзмененныеКодыСДР, ЭлементИнициатор, Направление);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаписыватьИзменения Тогда
		Для Каждого ТемпЭлемент Из ТемпИзмененныеКодыСДР Цикл
			Попытка
				Обж = ТемпЭлемент.Ключ.ПолучитьОбъект();
				Обж.КодСДР = ТемпЭлемент.Значение;
				Обж.Записать();
			Исключение
				Сообщение = НСтр("ru = 'Неудачная попытка обновления кода СДР для элемента %1 описание ошибки: %2'");
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, ТемпЭлемент.Ключ, ОписаниеОшибки());
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТемпИзмененныеКодыСДР;
	
КонецФункции

Функция ПолучитьСсылкуНаПроект(СсылкаНа)
	
	Если ЗначениеЗаполнено(СсылкаНа) И ТипЗнч(СсылкаНа) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Возврат упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта(СсылкаНа);
	КонецЕсли;
	
	Возврат СсылкаНа;
	
КонецФункции

Процедура ПроверитьСрокиЗадачИЗадачРодителей(ВходящиеПараметы)
	
	Родитель = ВходящиеПараметы.Родитель;
	ДанныеРодителя = ВходящиеПараметы.ДанныеРодителя;
	РодительДатаНачала = ВходящиеПараметы.РодительДатаНачала;
	РодительДатаЗавершения = ВходящиеПараметы.РодительДатаЗавершения;
	ТаблицаОшибок = ВходящиеПараметы.ТаблицаОшибок;
	Задача = ВходящиеПараметы.Задача;
	НазваниеЗадачи = ВходящиеПараметы.НазваниеЗадачи;
	ЗадачаДатаНачала = ВходящиеПараметы.ЗадачаДатаНачала;
	РодительКрайнийСрок = ВходящиеПараметы.РодительКрайнийСрок;
	ЗадачаДатаЗавершения = ВходящиеПараметы.ЗадачаДатаЗавершения;
	ЗадачаКрайнийСрок = ВходящиеПараметы.ЗадачаКрайнийСрок;
	ИндексКартинки = ВходящиеПараметы.ИндексКартинки;

	Если Родитель.Пустая() Или ДанныеРодителя = Неопределено Или РодительДатаНачала = Неопределено
		Или РодительДатаЗавершения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Ищем сроки родительской задачи.
	// Такое может быть, если нет записи в регистре сроков.
	// Проверим, не вылезают ли сроки текущей задачи за сроки задачи родителя.
	Если ДанныеРодителя.РучнойВводСроков Тогда
		ДопИнформация = НСтр("ru = '(у задачи-родителя установлен ручной режим ввода сроков, исправление необязательно)'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗадачаДатаНачала) Тогда
		Если ЗначениеЗаполнено(РодительДатаНачала) И ЗадачаДатаНачала < РодительДатаНачала Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт! Дата начала работ раньше даты начала задачи-родителя'"), ДопИнформация);
		КонецЕсли;
		Если ЗначениеЗаполнено(РодительДатаЗавершения) И ЗадачаДатаНачала > РодительДатаЗавершения Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт! Дата начала работ позже даты завершения задачи-родителя'"), ДопИнформация);
		КонецЕсли;
		Если ЗначениеЗаполнено(РодительКрайнийСрок) И ЗадачаДатаНачала > РодительКрайнийСрок Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт! Дата начала работ позже крайнего срока задачи-родителя'"), ДопИнформация);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаДатаЗавершения) Тогда
		Если ЗначениеЗаполнено(РодительДатаНачала) И ЗадачаДатаЗавершения < РодительДатаНачала Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт! Дата завершения работ раньше даты начала задачи-родителя'"), ДопИнформация);
		КонецЕсли;
		Если ЗначениеЗаполнено(РодительДатаЗавершения) И ЗадачаДатаЗавершения > РодительДатаЗавершения Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт! Дата завершения работ позже даты завершения задачи-родителя'"), ДопИнформация);
		КонецЕсли;
		Если ЗначениеЗаполнено(РодительКрайнийСрок) И ЗадачаДатаЗавершения > РодительКрайнийСрок Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт между датой завершения работ и крайним сроком задачи-родителя'"), ДопИнформация);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаКрайнийСрок) Тогда
		Если ЗначениеЗаполнено(РодительДатаНачала) И ЗадачаКрайнийСрок < РодительДатаНачала Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт между крайним сроком и датой начала задачи-родителя'"), ДопИнформация);
		КонецЕсли;
		Если ЗначениеЗаполнено(РодительКрайнийСрок) И ЗадачаКрайнийСрок > РодительКрайнийСрок Тогда
			обДобавитьОшибку(ТаблицаОшибок, Задача, НазваниеЗадачи, ИндексКартинки,
				НСтр("ru = 'Конфликт между крайним сроком и крайним сроком задачи-родителя'"), ДопИнформация);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПредусловияНовогоШаблонаЗадачи(Объект, Отказ, Заголовок)
	
	Родитель = Объект.Родитель;
	
	Для Каждого ПредУсловие Из Объект.ПредУсловия Цикл
		
		ЗадачаПредшественник = ПредУсловие.ЗадачаПредшественник;		
		Если ЗадачаПредшественник <> Родитель Тогда
			Продолжить;
		КонецЕсли;
		
		ПредставлениеЗадачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗадачаПредшественник, "Наименование");
		
		ПредставлениеТабличнойЧасти = Объект.Метаданные().ТабличныеЧасти["ПредУсловия"].Представление();
		ЗаголовокСообщения = упоСервисныеФункцииВызовСервера.обСформироватьЗаголовокОшибкиВСтрокеТЧ(ПредставлениеТабличнойЧасти, ПредУсловие.НомерСтроки);

		СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
			+ НСтр("ru = '"" является родительской задачей по иерархии.'");
		обСообщитьОбОшибке(ЗаголовокСообщения, Отказ, Заголовок);
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры
		
#КонецОбласти