// Функция получает последние сведения о предусловиях заданной проектной задачи.
//
// Параметры:
//  Задача	 - ДокументСсылка.упоПроектнаяЗадача - ссылка на заданную проектную задачу.
// 
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - таблица предусловий задачи.
//
Функция обПолучитьСписокПредУсловийПроектнойЗадачи(Знач Задача) Экспорт
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Задача);
	
	// Проверим, что заданная задача актуальна.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("ТекВерсия", ТекВерсия);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегПредусловия.ЗадачаПредшественник КАК ЗадачаПредшественник
		|ИЗ
		|	РегистрСведений.упоПредусловияПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &ТекВерсия
		|				И ПроектнаяЗадача = &Задача) КАК РегПредусловия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|				,
		|				Версия = &ТекВерсия
		|					И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|		ПО РегПредусловия.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		|			И (РегПредусловия.СвязьСуществует)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено; // Нет сведений.
	Иначе
		ЗадачиПредшественники = Результат.Выгрузить().ВыгрузитьКолонку("ЗадачаПредшественник");
	КонецЕсли;
	
	// Получаем последние сведения о предусловиях задачи.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("ЗадачиПредшественники", ЗадачиПредшественники);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	&Задача КАК ПроектнаяЗадача,
		|	СвойстваПредшественника.ПроектнаяЗадача КАК Предшественник
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&ЗадачиПредшественники)) КАК СвойстваПредшественника
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроектовПредшественников
		|		ПО СвойстваПредшественника.Версия = упоВерсииПроектовПредшественников.Версия
		|			И (упоВерсииПроектовПредшественников.Текущая)
		|			И (НЕ СвойстваПредшественника.ЗадачаОтменена)";
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить(); // Возвращаем таблицу предусловий.

КонецФункции

// Формирует таблицу предусловий всех задач проекта.
//
// Параметры:
//  Проект	 - СправочникСсыллка.Проекты - собственно проект
// 
// Возвращаемое значение:
//  ТаблицаЗначенй - сформированная таблица предусловий.
//  Структура колонок: Объект, Предшественник.
//
Функция обПодготовитьТаблицуПредусловий(Знач Проект) Экспорт

	// Получим необходимые данные.
	// Получим все предусловия проектных задач для заданного проекта.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
		
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегСвязиЗадач.ПроектнаяЗадача КАК Задача,
		|	РегСвязиЗадач.ЗадачаПредшественник КАК ПредЗадача
		|ИЗ
		|	РегистрСведений.упоПредусловияПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК РегСвязиЗадач
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ) КАК СвойстваПредшественника
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроектовПредшественников
		|			ПО СвойстваПредшественника.Версия = упоВерсииПроектовПредшественников.Версия
		|				И (упоВерсииПроектовПредшественников.Текущая)
		|				И (НЕ СвойстваПредшественника.ЗадачаОтменена)
		|		ПО РегСвязиЗадач.ЗадачаПредшественник = СвойстваПредшественника.ПроектнаяЗадача
		|ГДЕ
		|	РегСвязиЗадач.СвязьСуществует";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// См. упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи
//
Функция ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача, Свойство, ЗначениеПоУмолчанию = Неопределено, Версия = Неопределено) Экспорт
	Возврат упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача, 
		Свойство, ЗначениеПоУмолчанию, Версия)
КонецФункции 

#КонецОбласти

#Область ПолучениеПолныхДанныхСтруктурыПроектаИзБД

