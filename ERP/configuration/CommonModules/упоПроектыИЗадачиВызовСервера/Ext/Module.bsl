#Область ПрограммныйИнтерфейс

#Область ОбработкаСобытийИнтегрированныхОбъектов

// См. упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта
//
Функция НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу = Ложь, ВернутьСоответствие = Ложь) Экспорт
	
	Возврат упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу, ВернутьСоответствие);
	
КонецФункции

// Устарела. См. упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта
//
Функция упоНайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу = Ложь) Экспорт
	Возврат НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу);
КонецФункции

// Устарела. См. упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта
//
Функция обНайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу = Ложь) Экспорт
	Возврат НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу);
КонецФункции

// Устарела. См. упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта
//
Функция обПолучитьСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу = Ложь) Экспорт
	Возврат НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу);
КонецФункции

// Устарела. См. упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта
//
Функция обВернутьСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу = Ложь) Экспорт
	Возврат НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу);
КонецФункции

#КонецОбласти

#Область ПроверкаЦикличностиПЗ

// Проверяет на зацикливание структуры проекта после изменений, внесенных в проектную задачу.
//  Если мы удаляем какие-то предусловия, то на цикличность это не влияет, а вот если добавляем,
//  то надо проверить. Для этого идем по предыдущим вглубь проекта от нашей задачи и проверяем, не
//  попали ли мы уже в пройденную.
//
// Параметры:
//  ДанныеДокумента	 - Структура - содержит полный слепок документа.
//  Отказ			 - Булево	 - содержит признак отказа от операции.
//  Заголовок		 - Строка	 - содержит заголовок всех сообщений.
//
Процедура обПроверитьЗацикливаниеСтруктурыПроектаПослеИзмененийВПроектнойЗадаче(ДанныеДокумента, Отказ, Заголовок) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеДокумента.ПредусловияЗадачи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	Проект          = ДанныеДокумента.Проект;
	ПроектнаяЗадача = ДанныеДокумента.Ссылка;
		
	Если ТипЗнч(ДанныеДокумента.Ссылка) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		ЗадачаРодитель	= ДанныеДокумента.ЗадачаРодитель;
	Иначе
		ЗадачаРодитель	= Документы.упоПроектнаяЗадача.ПустаяСсылка();
	КонецЕсли;
	
	/////////////////////////////
	
	МассивВнешнихПроектов = Новый Массив;
	
	ТаблицаНовыхСвязей = Новый ТаблицаЗначений;
	ТаблицаНовыхСвязей.Колонки.Добавить("ЭлементПроекта");
	ТаблицаНовыхСвязей.Колонки.Добавить("ПроектПредшественника");
	ТаблицаНовыхСвязей.Колонки.Добавить("СвязанныйЭлемент");
	
	ТаблицаНовыхСвойств = Новый ТаблицаЗначений;
	ТаблицаНовыхСвойств.Колонки.Добавить("ЭлементПроекта");
	ТаблицаНовыхСвойств.Колонки.Добавить("ЭлементРодитель");
	ТаблицаНовыхСвойств.Колонки.Добавить("Проект");
	ТаблицаНовыхСвойств.Колонки.Добавить("ПредставлениеЭлемента");
	СтрокаТаблицыНовыхСвойств = ТаблицаНовыхСвойств.Добавить();
	СтрокаТаблицыНовыхСвойств.ЭлементПроекта = ПроектнаяЗадача;
	СтрокаТаблицыНовыхСвойств.ЭлементРодитель = ЗадачаРодитель;
	
	Для Каждого СтрокаПредусловияЗадачи Из ДанныеДокумента.ПредусловияЗадачи Цикл
		
		Если СтрокаПредусловияЗадачи.СвязьМеждуПроектами Тогда
			
			ПроектСвязи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПредусловияЗадачи.ЗадачаПредшественник, "Проект");			
			
			ИндексВМассиве = МассивВнешнихПроектов.Найти(ПроектСвязи);
			Если ИндексВМассиве = Неопределено Тогда
				МассивВнешнихПроектов.Добавить(ПроектСвязи);	
			КонецЕсли;
			
		Иначе
			
			ПроектСвязи = Проект;
			
		КонецЕсли;
		
		НоваяСтрока = ТаблицаНовыхСвязей.Добавить();
		НоваяСтрока.ЭлементПроекта = ПроектнаяЗадача;
		НоваяСтрока.ПроектПредшественника = ПроектСвязи;
		НоваяСтрока.СвязанныйЭлемент = СтрокаПредусловияЗадачи.ЗадачаПредшественник;
				
	КонецЦикла;
	
	//
	
	ДанныеЗадач = Новый Соответствие;
	
	ДанныеЗадачи = Новый Структура;
	ДанныеЗадачи.Вставить("ВнешниеПроекты", МассивВнешнихПроектов);
	ДанныеЗадачи.Вставить("Связи", ТаблицаНовыхСвязей);
	ДанныеЗадачи.Вставить("Свойства", ТаблицаНовыхСвойств);
	
	ДанныеЗадач.Вставить(ПроектнаяЗадача, ДанныеЗадачи);
	
	//
	
	ТаблицаОшибок = упоПроектыИЗадачиСервер.ПроверитьНаЦикличностьПроект(Проект, ДанныеЗадач);
				
	//
		
	Если ТаблицаОшибок.Количество() Тогда
		СтрокаСообщения = упоПроектыИЗадачиСервер.СобратьВТекстОшибкиЦикличностиПроекта(ТаблицаОшибок);
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
	КонецЕсли;
		
КонецПроцедуры

// Проверяет разрешения диспетчера или сотрудника на создание или модификацию проектной задачи.
//
// Параметры:
//  ДанныеДокумента		 - Структура - содержит полный слепок документа.
//  Отказ				 - Булево	 - содержит признак отказа от операции.
//  Заголовок			 - Строка	 - содержит заголовок всех сообщений.
//  ВыводитьСообщение	 - Булево
//
Процедура обПроверитьПолномочияПользователяПроектнойЗадачи(ДанныеДокумента, Отказ, Заголовок = "", ВыводитьСообщение = Истина) Экспорт

	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если упоРазграничениеДоступаВызовСервера.РазграничениеДоступаОтключено() Тогда
		Возврат;
	КонецЕсли;
	
	// Собственно для начала определим руководителя проектной задачи.
	Руководитель = ОпределитьРуководителяПроектнойЗадачи(ДанныеДокумента);
	
	// Если руководителя нет, надо сообщить об этом.
	Если Руководитель = Неопределено Тогда
		СтрокаСообщения = НСтр("ru = 'Не определен руководитель проекта!'");
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		Возврат;
	КонецЕсли;
	
	// Теперь определим список пользователей,
	// через которых управляет системой руководитель проектной задачи.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудники", Руководитель);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	Рег.Пользователь
	               |ИЗ
	               |	РегистрСведений.упоДиспетчерыСистемы.СрезПоследних(, Сотрудник В (&Сотрудники)) КАК Рег
	               |ГДЕ
	               |	Рег.ФлагУправления = ИСТИНА";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда // Нет диспетчеров.
		строкаРуководителей = "";
		
		первыйРаз = Истина;
		Для каждого лОдинРук Из Руководитель Цикл
			Если НЕ первыйРаз Тогда
				строкаРуководителей = строкаРуководителей + ", ";
			КонецЕсли;
			строкаРуководителей = строкаРуководителей + лОдинРук;
		КонецЦикла;
		СтрокаСообщения = НСтр("ru = 'Для руководителей: ""%1"" не определен ни один диспетчер.'");
		СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, строкаРуководителей);
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		
		Возврат;
		
	КонецЕсли;
	
	СписокПользователей = Результат.Выгрузить();
	
	ПользовательНайден = (СписокПользователей.Найти(Пользователи.ТекущийПользователь(), "Пользователь") <> Неопределено);
	
	Если ПользовательНайден Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеЗадачи = упоСервисныеФункцииВызовСервера.обПолучитьСтроковоеПредставление(ДанныеДокумента.ПроектнаяЗадача);
	СтрокаСообщения = НСтр("ru = 'Пользователь ""%1"" не имеет полномочий на выполнение этой операции.'");
	СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());
	обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок, , , ВыводитьСообщение);
	
КонецПроцедуры

// Проверяет допустимость записи проектной задачи при ее создании.
//
// Параметры:
//  ДанныеДокумента	 - Структура - содержит полный слепок документа.
//  Отказ			 - Булево	 - содержит признак отказа от операции.
//  Заголовок		 - Строка	 - содержит заголовок всех сообщений.
//
Процедура обПроверитьДопустимостьПроектнойЗадачи(ДанныеДокумента, Отказ, Заголовок) Экспорт

	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// Следующая проверка только если есть родительская задача.
	Если Не упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ДанныеДокумента.ЗадачаРодитель) Тогда
		// Проверим существование задачи-родителя.
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Задача", ДанныеДокумента.ЗадачаРодитель);
		Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ДанныеДокумента.ЗадачаРодитель.Проект));
			
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегСвойствоЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|	РегСвойствоЗадачи.ЭтоПакетРабот КАК ЭтоПакетРабот,
			|	РегСвойствоЗадачи.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
			|	РегСвойствоЗадачи.НазваниеЗадачи КАК НазваниеЗадачи,
			|	РегСвойствоЗадачи.ЭтоВеха КАК ЭтоВеха
			|ИЗ
			|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
			|			,
			|			ПроектнаяЗадача = &Задача
			|				И Версия = &текВерсия) КАК РегСвойствоЗадачи
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
			|		ПО РегСвойствоЗадачи.Версия = Версии.Версия
			|			И (Версии.Текущая)
			|ГДЕ
			|	НЕ РегСвойствоЗадачи.ЗадачаОтменена";
		
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			
			СтрокаСообщения = НСтр("ru = 'Не найдена задача-родитель! Документ удален или не проведен.'");
			обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
			
		Иначе
			
			ТаблицаДанных = Результат.Выгрузить();
			НазваниеЗадачи = ТаблицаДанных[0].НазваниеЗадачи;
			ЭтоПакетРабот  = ТаблицаДанных[0].ЭтоПакетРабот;
			ЭтоМодельПакетаРабот = ТаблицаДанных[0].ЭтоМодельПакетаРабот;
			ЭтоВеха = ТаблицаДанных[0].ЭтоВеха;
			
			СтрокаСообщения = "";
			Если ЭтоМодельПакетаРабот Тогда
                СтрокаСообщения = НСтр("ru = 'Задача-родитель ""%1"" является моделью пакета работ и не может выступать
				|в роли родительской задачи!'");				
			ИначеЕсли ЭтоПакетРабот Тогда
				СтрокаСообщения = НСтр("ru = 'Задача-родитель ""%1"" является пакетом работ и не может выступать в роли
				|родительской задачи!'");				
			ИначеЕсли ЭтоВеха Тогда
				СтрокаСообщения = НСтр("ru = 'Задача-родитель ""%1"" является вехой и не может выступать в роли родительской задачи!'");				
			КонецЕсли;
			
			Если Не ПустаяСтрока(СтрокаСообщения) Тогда
				СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, СокрЛП(НазваниеЗадачи));
				обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет предусловия проектной задачи на корректность связей (например на зацикливание).
//
// Параметры:
//  ДанныеДокумента	 - Структура - содержит полный слепок документа.
//  Отказ			 - Булево	 - содержит признак отказа от операции.
//  Заголовок		 - Строка	 - содержит заголовок всех сообщений.
//
Процедура обПроверитьПравильностьПредУсловийПроектнойЗадачи(ДанныеДокумента, Отказ, Заголовок) Экспорт

	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеДокумента.ПредусловияЗадачи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Проект          = ДанныеДокумента.Проект;
	ПроектнаяЗадача = ДанныеДокумента.ПроектнаяЗадача;
	
	// Получим последнюю иерархию проектных задач для заданного проекта.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.ПроектнаяЗадача КАК Задача,
		|	Рег.ЗадачаРодитель КАК Родитель,
		|	Рег.НазваниеЗадачи КАК НазваниеЗадачи
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК Рег
		|ГДЕ
		|	НЕ Рег.ЗадачаОтменена";
	
	ТаблицаЗадач = Запрос.Выполнить().Выгрузить();
	
	// Это обязательно:
	// Добавим текущую задачу, т.к. при проведении ее данные автоматически удаляются из регистра,
	// или перепишем текущую задачу, т.к. при изменении у нее записаны старые данные.
	СтрокаЗадачи = ТаблицаЗадач.Найти(ПроектнаяЗадача, "Задача");
	Если СтрокаЗадачи = Неопределено Тогда
		СтрокаЗадачи = ТаблицаЗадач.Добавить();
	КонецЕсли;
	СтрокаЗадачи.Задача           = ДанныеДокумента.ПроектнаяЗадача;
	СтрокаЗадачи.Родитель         = ДанныеДокумента.ЗадачаРодитель;
	СтрокаЗадачи.НазваниеЗадачи   = ДанныеДокумента.НазваниеПроектнойЗадачи;
	
	// Для каждого предшественника будем проверять не зависит ли он прямо или косвенно от текущей задачи.
	
	// Перебираем задачи-предшественники табличной части "ПредусловияЗадачи".
	Для Каждого ПредУсловие Из ДанныеДокумента.ПредусловияЗадачи Цикл
		
		Если ПредУсловие.СвязьМеждуПроектами Тогда
			Продолжить;
		КонецЕсли;
		
		ЗадачаПредшественник = ПредУсловие.ЗадачаПредшественник;
		
		Задача = ТаблицаЗадач.Найти(ЗадачаПредшественник, "Задача");
		Если Не Задача = Неопределено Тогда 
			// Проверим, что задача-предшественник не является текущей задачей.
			Если ЗадачаПредшественник = ПроектнаяЗадача Тогда
				ПредставлениеЗадачи = упоСервисныеФункцииВызовСервера.обПолучитьСтроковоеПредставление(ПредУсловие.ЗадачаПредшественник);
				СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
					+ НСтр("ru = '"" является текущей задачей.'");
				обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
			Иначе
				// Проверим задачу-предшественника на родительскую связь.
				Если обЭтоРодитель(ТаблицаЗадач, ПредУсловие.ЗадачаПредшественник, ПроектнаяЗадача) Тогда
					ПредставлениеЗадачи = упоСервисныеФункцииВызовСервера.обПолучитьСтроковоеПредставление(ПредУсловие.ЗадачаПредшественник);
					СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
						+ НСтр("ru = '"" является родительской задачей по иерархии.'");
					обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
				КонецЕсли;
				// Проверим задачу-предшественника на подчиненность.
				Если обЭтоРодитель(ТаблицаЗадач, ПроектнаяЗадача, ПредУсловие.ЗадачаПредшественник) Тогда
					ПредставлениеЗадачи = упоСервисныеФункцииВызовСервера.обПолучитьСтроковоеПредставление(ПредУсловие.ЗадачаПредшественник);
					СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
						+ НСтр("ru = '"" является подчиненной задачей по иерархии.'");
					обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Не нашли задачу-предшественника. Удалена или не проведена.
			ПредставлениеЗадачи = упоСервисныеФункцииВызовСервера.обПолучитьСтроковоеПредставление(ПредУсловие.ЗадачаПредшественник);
			СтрокаСообщения = НСтр("ru = 'Не найдена задача-предшественник ""'") + ПредставлениеЗадачи + НСтр("ru = '"".'");
			обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область ПроверкаДанныхПриЗаписиСправочникаШаблоныПроектныхЗадач

// Процедура проверяет допустимость записи в ИБ указанный шаблон проектной задачи.
//
// Параметры:
//  Объект		 - СправочникСсылка.упоШаблоныПроектныхЗадач - ссылка на справочник
//  Отказ		 - Булево									 - содержит признак отказа от операции.
//  Заголовок	 - Строка									 - содержит текст заголовока сообщения.
//
Процедура обПроверитьДопустимостьЗаписиШаблонаЗадачи(Объект, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// Получим список всех шаблонов проектных задач и их родителей для текущего шаблона проекта.
	Если Объект.Родитель.ЭтоПакетРабот = Истина Тогда
		СтрокаСообщения = НСтр("ru = 'Шаблон задачи-родителя ""%1"" является пакетом работ и не может выступать в роли
		|родительской задачи!'");
		СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, СокрЛП(Объект.Родитель));
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
	КонецЕсли;
	
КонецПроцедуры

// Процедура проверяет предусловия указанного шаблона проектной задачи.
//
// Параметры:
//  Объект		 - СправочникСсылка.упоШаблоныПроектныхЗадач - шаблон проектной задачи.
//  Отказ		 - Булево									 - содержит признак отказа от операции.
//  Заголовок	 - Строка									 - содержит текст заголовока сообщения.
//
Процедура обПроверитьПредусловияШаблонаЗадачи(Объект, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ШаблонЗадачи  = Объект;
		ПроверитьПредусловияНовогоШаблонаЗадачи(Объект, Отказ, Заголовок);
		Возврат;
	Иначе
		ШаблонЗадачи  = Объект.Ссылка;
	КонецЕсли;
	ШаблонПроекта = Объект.Владелец;
	
	// Получим список всех шаблонов проектных задач и их родителей для текущего шаблона проекта.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", ШаблонПроекта); 
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Спр.Ссылка КАК Задача,
		|	Спр.Представление КАК ПредставлениеЗадачи,
		|	Спр.Родитель,
		|	Спр.Родитель.Представление КАК ПредставлениеРодителя
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач КАК Спр
		|ГДЕ
		|	Спр.Владелец = &Владелец";
	
	Результат = Запрос.Выполнить();
	ТаблицаЗадач = Результат.Выгрузить();
	
	// Отбор по текущему шаблону задачи.
	Отбор = Новый Структура;
	Отбор.Вставить("Задача", ШаблонЗадачи);
	
	// Изменияем данные по данным текущего шаблона задачи.
	МассивСтрок = ТаблицаЗадач.НайтиСтроки(Отбор);
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		ТаблицаЗадач.Удалить(ТекСтрока);
	КонецЦикла;
	
	НовСтрока = ТаблицаЗадач.Добавить();
	НовСтрока.Задача                = ШаблонЗадачи;
	НовСтрока.ПредставлениеЗадачи   = ШаблонЗадачи.Наименование;
	НовСтрока.Родитель              = Объект.Родитель;
	НовСтрока.ПредставлениеРодителя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Родитель, "Наименование");
	
	// Получим список предусловий для всех шаблонов проектных задач для текущего шаблона проекта.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", ШаблонПроекта); 
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТабСпр.Ссылка КАК Объект,
		|	ТабСпр.ЗадачаПредшественник КАК ОбъектСвязи
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач.ПредУсловия КАК ТабСпр
		|ГДЕ
		|	ТабСпр.Ссылка.Владелец = &Владелец
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Спр.Ссылка,
		|	Спр.Родитель
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач КАК Спр
		|ГДЕ
		|	Спр.Владелец = &Владелец";
	
	Результат = Запрос.Выполнить();
	ТаблицаСвязей = Результат.Выгрузить();
	
	// Отбор по текущему шаблону задачи.
	Отбор = Новый Структура;
	Отбор.Вставить("Объект", ШаблонЗадачи);
	
	// Изменияем данные по данным текущего шаблона задачи.
	МассивСтрок = ТаблицаСвязей.НайтиСтроки(Отбор);
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		ТаблицаСвязей.Удалить(ТекСтрока);
	КонецЦикла;
	
	Для Каждого ПредУсловие Из Объект.ПредУсловия Цикл
		НовСтрока = ТаблицаСвязей.Добавить();
		НовСтрока.Объект      = ШаблонЗадачи;
		НовСтрока.ОбъектСвязи = ПредУсловие.ЗадачаПредшественник;
	КонецЦикла;
	
	// Проверяем предусловия текущего шаблона задачи.
	Для Каждого ПредУсловие Из Объект.ПредУсловия Цикл
		ЗадачаПредшественник = ПредУсловие.ЗадачаПредшественник;
		ПредставлениеЗадачи = ПредУсловие.ЗадачаПредшественник.Наименование;

		ПредставлениеТабличнойЧасти = Объект.Метаданные().ТабличныеЧасти["ПредУсловия"].Представление();
		ЗаголовокСообщения = упоСервисныеФункцииВызовСервера.обСформироватьЗаголовокОшибкиВСтрокеТЧ(ПредставлениеТабличнойЧасти, ПредУсловие.НомерСтроки);
		
		ДанныеЗадачи = ТаблицаЗадач.Найти(ПредУсловие.ЗадачаПредшественник, "Задача");
		Если Не ДанныеЗадачи = Неопределено Тогда 
			// Проверим, что задача-предшественник является текущей задачей.
			Если ЗадачаПредшественник = ШаблонЗадачи Тогда
				СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
					+ НСтр("ru = '"" является текущей задачей.'");
				обСообщитьОбОшибке(ЗаголовокСообщения, Отказ, Заголовок);
				обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
			Иначе
				// Проверим задачу-предшественника на родительскую связь.
				Если обЭтоРодитель(ТаблицаЗадач, ПредУсловие.ЗадачаПредшественник, ШаблонЗадачи) Тогда
					СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
						+ НСтр("ru = '"" является родительской задачей по иерархии.'");
					обСообщитьОбОшибке(ЗаголовокСообщения, Отказ, Заголовок);
					обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
				КонецЕсли;
				// Проверим задачу-предшественника на подчиненность.
				Если обЭтоРодитель(ТаблицаЗадач, ШаблонЗадачи, ПредУсловие.ЗадачаПредшественник) Тогда
					СтрокаСообщения = НСтр("ru = 'Задача-предшественник ""'") + ПредставлениеЗадачи 
						+ НСтр("ru = '"" является подчиненной задачей по иерархии.'");
					обСообщитьОбОшибке(ЗаголовокСообщения, Отказ, Заголовок);
					обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
				КонецЕсли;
			КонецЕсли;
		Иначе
			// Не нашли задачу-предшественника. Удалена или не проведена.
			ПредставлениеЗадачи = упоСервисныеФункцииВызовСервера.обПолучитьСтроковоеПредставление(ПредУсловие.ЗадачаПредшественник);
			СтрокаСообщения = НСтр("ru = 'Не найдена задача-предшественник ""'") + ПредставлениеЗадачи + НСтр("ru = '"".'");
			обСообщитьОбОшибке(ЗаголовокСообщения, Отказ, Заголовок);
			обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		КонецЕсли;
	КонецЦикла;
	
	// Проверим на зацикленность связей.
	ЕстьСвязь = обНайтиСвязь(ТаблицаСвязей);
	Если ЕстьСвязь Тогда
		СтрокаСообщения = НСтр("ru = 'Обнаружено зацикливание среди звязей!'");
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

 #Область ПроверкаСтруктурыПроекта
 
