// Функция возвращает банковский календарь проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты
// 
// Возвращаемое значение:
//  СправочникСсылка.упоРабочиеКалендари, Неопределено - нет сведений о календаре на запрашиваемый год.
//
Функция обПолучитьБанковскийКалендарьПроекта(Проект) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА Рег.КалендарьБанковскихДней ЕСТЬ NULL 
		|			ТОГДА Рег.КалендарьПроекта
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Рег.КалендарьБанковскихДней = &ПустойКалендарь
		|					ТОГДА Рег.КалендарьПроекта
		|				ИНАЧЕ Рег.КалендарьБанковскихДней
		|			КОНЕЦ
		|	КОНЕЦ КАК Календарь
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	ПараметрыЗапроса = Новый Структура("Проект,ПустойКалендарь", Проект, Справочники.упоРабочиеКалендари.ПустаяСсылка());
	
	Результат = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
	Если Результат.Пустой() Тогда
		Возврат Неопределено; // Нет сведений.
	КонецЕсли;
	
	Возврат Результат.Выгрузить()[0].Календарь; // Банковский календаря проекта.
	
КонецФункции

// Функция возвращает все календари проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты	 - проект.
// 
// Возвращаемое значение:
//  Структура - содержит календари проекта.
//
Функция обПолучитьКалендариПроекта(Проект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект" , Проект);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Рег.КалендарьПроекта КАК РабочийКалендарь,
		|	ЕСТЬNULL(Рег.КалендарьБанковскихДней, Рег.КалендарьПроекта) КАК БанковскийКалендарь
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Структура("Банковский,Рабочий", Неопределено, Неопределено); // Нет сведений.
	КонецЕсли;
	
	СтрокаПроект = Результат.Выгрузить()[0];
	Возврат Новый Структура("Банковский,Рабочий", СтрокаПроект.БанковскийКалендарь, СтрокаПроект.РабочийКалендарь); 
	
КонецФункции

