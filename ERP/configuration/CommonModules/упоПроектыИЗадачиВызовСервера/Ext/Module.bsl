//  Процедура отображает обнаруженные ошибки при проверке проекта.
//
// Параметры:
//  ТаблицаОшибок	 - ТаблицаЗначений	 - таблица обнаруженных ошибок, при отсутствии ошибок - пустая.
//  Проект			 - СправочникСсылка.Проекты	 - проект, по которому осуществлена проверка.
//
Процедура обОтобразитьСписокОшибок(ТаблицаОшибок, Проект = Неопределено) Экспорт
	
	Обработка = Обработки.упоПроверкаСтруктурыПроекта.Создать();
	
	Если НЕ Проект = Неопределено Тогда
		Обработка.Проект = Проект;
	КонецЕсли; 
	
	Обработка.ВывестиТаблицуОшибок(ТаблицаОшибок);
	
КонецПроцедуры

