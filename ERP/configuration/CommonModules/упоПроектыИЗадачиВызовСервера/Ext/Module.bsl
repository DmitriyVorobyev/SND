#КонецОбласти

// Формирует структуру необходимых данных проекта.
//
// Параметры:
//  Проект				 - СправочникСсылка.Проекты	 - проект.
//  ДатаНачалаПроекта	 - Дата						 - планируемая дата старта проектных работ.
// 
// Возвращаемое значение:
//  ТаблицаЗначенй - сформированная структура данных.
//  Структура полей: Календарь, СтартоваяДата.
//
Функция обПодготовитьСтруктуруДанныхПроекта(Знач Проект, Знач ДатаНачалаПроекта) Экспорт

	// Создаем пустое дерево.
	Данные = Новый Структура;

	// Получим необходимые данные.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.КалендарьПроекта
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
		
	Результат = Запрос.Выполнить();
	
	// Добавляем нужные поля.
	Данные.Вставить("Календарь", 
		?(Результат.Пустой(), Справочники.упоРабочиеКалендари.ПустаяСсылка(), Результат.Выгрузить()[0].КалендарьПроекта));
	Данные.Вставить("ДатаНачалаПроекта", ДатаНачалаПроекта);
	
	Возврат Данные;
	
КонецФункции

// Формирует дерево проектных задач для заданного проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты	 - проект.
// 
// Возвращаемое значение:
//  ДеревоЗначений - сформированное дерево проектных задач.
//  Структура колонок: название задачи,
//  код СДР и ссылка на саму задачу.
//
Функция обСформироватьДеревоПроектныхЗадач(Знач Проект) Экспорт

	// Создаем пустое дерево.
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("НазваниеПроектнойЗадачи", , "Проектная задача");
	Дерево.Колонки.Добавить("КодСДР", , "Код СДР");
	Дерево.Колонки.Добавить("ПроектнаяЗадача", , "Связанный документ");
	
	// Получим последнюю иерархию проектных задач и их коды СДР для заданного проекта.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегСвойства.ПроектнаяЗадача КАК Задача,
		|	РегСвойства.ЗадачаРодитель КАК Родитель,
		|	ВЫБОР
		|		КОГДА РегСвойства.НазваниеЗадачи <> """"
		|			ТОГДА РегСвойства.НазваниеЗадачи
		|		ИНАЧЕ РегСвойства.ПроектнаяЗадача.НазваниеПроектнойЗадачи
		|	КОНЕЦ КАК НазваниеЗадачи,
		|	РегКодыСДР.КодСДР КАК КодСДР
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК РегСвойства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК РегКодыСДР
		|		ПО РегСвойства.ПроектнаяЗадача = РегКодыСДР.СсылкаНаПроектнуюЗадачу
		|			И (НЕ РегКодыСДР.ПометкаУдаления)
		|			И (НЕ РегСвойства.ЗадачаОтменена)
		|
		|УПОРЯДОЧИТЬ ПО
		|	РегСвойства.ПроектнаяЗадача.Дата";
	
	Результат = Запрос.Выполнить();
	
	ТаблицаЗадач = Результат.Выгрузить();
	ТаблицаЗадач.Сортировать("КодСДР");
		
	обЗаполнитьДерево(Дерево, ТаблицаЗадач, Документы.упоПроектнаяЗадача.ПустаяСсылка());
	
	Возврат Дерево;
	
КонецФункции

// Заполняет иерархию.
//
// Параметры:
//  ПараметрРодитель	- СправочникСсылка.Проекты - родитель.
//  ТемпИерархия		- Соответствие				- иерархия.
//  ТемпКодыСДР			- Соответствие 				- список кодов СДР.
//  ПараметрПроверяемыйНаНижний - СправочникСсылка.Проекты - ссылка для проверки на нижний.
//  ВерхнийИзРодителей	 - СправочникСсылка.Проекты - верхний из родителей.
//
// Возвращаемое значение:
//	Неопределено - не возвращает значение.
//
Функция ЗаполнитьИерархию(ПараметрРодитель,
						  ТемпИерархия,
						  ТемпКодыСДР,
						  ПараметрПроверяемыйНаНижний = Неопределено,
						  ВерхнийИзРодителей = Неопределено) Экспорт
						  
	Если ПараметрРодитель = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ПОМЕСТИТЬ АктуальныеЗадачи_ВТ
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК Задачи
	|ГДЕ
	|	НЕ Задачи.ЗадачаОтменена
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПроектнаяЗадача
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.Родитель КАК Родитель,
	|	Проекты.Ссылка КАК Ссылка,
	|	Проекты.КодСДР КАК КодСДР,
	|	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача
	|ИЗ
	|	АктуальныеЗадачи_ВТ КАК АктуальныеЗадачи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО АктуальныеЗадачи.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ЕстьОтборПоРодителю
	|				ТОГДА Проекты.Ссылка В ИЕРАРХИИ (&Родителя)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И НЕ Проекты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Родителя", ПараметрРодитель);
	
	ТекПроект = ?(ПараметрРодитель.ЭтоПроектнаяЗадача,ПараметрРодитель.СсылкаНаПроектнуюЗадачу.Проект,ПараметрРодитель);
    Запрос.УстановитьПараметр("Проект",ТекПроект );
	Запрос.УстановитьПараметр("ЕстьОтборПоРодителю",ЗначениеЗаполнено(ПараметрРодитель));
	Запрос.УстановитьПараметр("ТекущаяВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ТекПроект));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка = ПараметрПроверяемыйНаНижний Тогда
			ВерхнийИзРодителей = ПараметрРодитель;
		КонецЕсли;
		
		дети = ТемпИерархия[Выборка.Родитель];
		Если дети = Неопределено Тогда
			дети = Новый Соответствие;
		КонецЕсли;
		
		дети.Вставить(Выборка.Ссылка, Истина);
		ТемпИерархия.Вставить(Выборка.Родитель, дети);
		
		ТемпКодыСДР.Вставить(Выборка.Ссылка, ?(Выборка.КодСДР = "" И Выборка.ЭтоПроектнаяЗадача, "а", Выборка.КодСДР));
	КонецЦикла;
	
КонецФункции

// Заполняет коды СДР.
//
// Параметры:
//  ПараметрРодитель	 - СправочникСсылка.Проекты - родитель.
//  ТемпИерархия		 - Соответствие - иерархия элементов.
//  ТемпКодыСДР			 - Соответствие - список кодов СДР.
//  ТемпИзмененныеКодыСДР- Соответствие - измененные коды СДР. В качестве ключа выступает ссылка,
//										  а в качестве значения - новый код СДР.
//  ЭлементИнициатор	 - ДокументСсылка.упоПроектнаяЗадача 				- ссылка на элемент-инициатор.
//  Направление			 - ПеречисленияСсылка.упоНаправлениеДвиженияПоСДР 	- направление движения по СДР.
//  КодРодителя			 - Строка		- код СДР родителя.
//  Замещать			 - Булево 		- признак необходимости замещения.
//
// Возвращаемое значение:
//	Неопределено - не возвращает значение.
//
Функция ЗаполнитьКодыСДР(ПараметрРодитель,
						 ТемпИерархия,
						 ТемпКодыСДР,
						 ТемпИзмененныеКодыСДР,
						 ЭлементИнициатор,
						 Направление,
						 КодРодителя = Неопределено,
						 Замещать = Ложь) Экспорт
						 
	Если ПараметрРодитель = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	КоллекцияЭлементов = ТемпИерархия[ПараметрРодитель];
	
	Если КоллекцияЭлементов = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если КодРодителя = Неопределено Тогда
		КодРодителя = ТемпИзмененныеКодыСДР[ПараметрРодитель];
		Если КодРодителя = Неопределено Тогда
			КодРодителя = ТемпКодыСДР[ПараметрРодитель];
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодРодителя) Тогда
			КодРодителя = КодРодителя + ".";
		КонецЕсли;
	КонецЕсли;
	
	КолвоЦифр = СтрДлина(Строка(КоллекцияЭлементов.Количество()));
	форматнаяСтрока = "ЧЦ=" + КолвоЦифр + "; ЧВН=; ЧГ=0";
	
	ТемпТаблицаЭлементов = Новый ТаблицаЗначений;
	ТемпТаблицаЭлементов.Колонки.Добавить("КодСДР");
	ТемпТаблицаЭлементов.Колонки.Добавить("Ссылка");
	
	СдвигаемаяСтрока = Неопределено;
	Для каждого ТемпЭлемент Из КоллекцияЭлементов Цикл
	    новаяСтрока = ТемпТаблицаЭлементов.Добавить();
		новаяСтрока.КодСДР = ТемпКодыСДР[ТемпЭлемент.Ключ];
		новаяСтрока.Ссылка = ТемпЭлемент.Ключ;
		
		Если НЕ ЭлементИнициатор = Неопределено И ЭлементИнициатор = ТемпЭлемент.Ключ Тогда
			СдвигаемаяСтрока = новаяСтрока;
		КонецЕсли;
	КонецЦикла;
	
	ТемпТаблицаЭлементов.Сортировать("КодСДР");
	
	Если НЕ СдвигаемаяСтрока = Неопределено Тогда
		Если Направление = Перечисления.упоНаправлениеДвиженияПоСДР.НаВерхнююСтроку Тогда
			ТемпТаблицаЭлементов.Сдвинуть(СдвигаемаяСтрока, -1 * ТемпТаблицаЭлементов.Индекс(СдвигаемаяСтрока));
		ИначеЕсли Направление = Перечисления.упоНаправлениеДвиженияПоСДР.НаНижнююСтроку Тогда
			ТемпТаблицаЭлементов.Сдвинуть(СдвигаемаяСтрока, ТемпТаблицаЭлементов.Количество() - 1 - ТемпТаблицаЭлементов.Индекс(СдвигаемаяСтрока));
		ИначеЕсли Направление = Перечисления.упоНаправлениеДвиженияПоСДР.НаСтрокуВверх 
			И ТемпТаблицаЭлементов.Индекс(СдвигаемаяСтрока) > 0 Тогда
			ТемпТаблицаЭлементов.Сдвинуть(СдвигаемаяСтрока, -1);
		ИначеЕсли Направление = Перечисления.упоНаправлениеДвиженияПоСДР.НаСтрокуВниз 
			И ТемпТаблицаЭлементов.Индекс(СдвигаемаяСтрока) < ТемпТаблицаЭлементов.Количество() - 1 Тогда	
			ТемпТаблицаЭлементов.Сдвинуть(СдвигаемаяСтрока, 1);
		КонецЕсли;	
	КонецЕсли;
	
	СтартовыйКод = 1; // Начальный код СДР для ствола дерева.
	
	
	Для Каждого ТемпЭлемент Из ТемпТаблицаЭлементов Цикл
		новыйКодСДР = Строка(КодРодителя) + Формат(СтартовыйКод, форматнаяСтрока);
		Если НЕ новыйКодСДР = ТемпЭлемент.КодСДР ИЛИ Замещать Тогда
			ТемпИзмененныеКодыСДР.Вставить(ТемпЭлемент.Ссылка, новыйКодСДР);
			
			упоПроектыИЗадачиВызовСервера.ЗаполнитьКодыСДР(ТемпЭлемент.Ссылка, ТемпИерархия, ТемпКодыСДР, ТемпИзмененныеКодыСДР, ЭлементИнициатор, Направление, новыйКодСДР + ".", Замещать);
		КонецЕсли;
		
		СтартовыйКод = СтартовыйКод + 1; // Увеличиваем код СДР на единицу.
	КонецЦикла;
	
КонецФункции

// См. упоПроектыИЗадачиСервер.УстановитьСтатьюЗатратРесурса
