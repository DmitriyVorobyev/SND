// Функция получает последние сведения о названии заданной проектной задачи.
//
// Параметры:
//  Задача	 - ДокументСсылка.упоПроектнаяЗадача - ссылка на заданную проектную задачу.
// 
// Возвращаемое значение:
//  Строка, Неопределено - название задачи.
//
Функция обПолучитьНазваниеПроектнойЗадачи(Знач Задача) Экспорт

	// Получаем последние сведения о названии задачи.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Рег.НазваниеЗадачи <> """"
		|			ТОГДА Рег.НазваниеЗадачи
		|		ИНАЧЕ Рег.ПроектнаяЗадача.НазваниеПроектнойЗадачи
		|	КОНЕЦ КАК НазваниеЗадачи
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &Задача) КАК Рег
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|	РегистрСведений.упоВерсииПроекта КАК Версии
		|ПО
		|	Рег.Версия = Версии.Версия
		|ГДЕ
		|	Версии.Текущая
		|";
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Возврат Результат.Выгрузить()[0].НазваниеЗадачи; // Возвращаем название задачи.
	Иначе
		Возврат Неопределено; // Нет сведений.
	КонецЕсли;

КонецФункции

