//
Функция ДанныеПроверкиСтруктурыПроекта(Проект, Отказ) Экспорт
	
	Возврат упоПроектыИЗадачиСервер.ДанныеПроверкиСтруктурыПроекта(Проект, Отказ);
	
КонецФункции

// Базовая функция. Проверяет проект на наличие ошибок по заданным параметрам.
//  Подготавливает данные для проверки и выполняет проверку.
//
// Параметры:
//  СтруктураПроверки	 - Структура - содержит параметры проверки, настроенные пользователем или системой.
//  ОтключитьИндикатор	 - Булево	 - признак индикации состояния процесса проверки.
// 
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - таблица обнаруженных ошибок, при отсутствии ошибок - пустая.
//
Функция обКомплекснаяПроверкаСтруктурыПроекта(СтруктураПроверки, ОтключитьИндикатор = Ложь) Экспорт
	
	// Создаем таблицу для хранения списка ошибок.
	ТаблицаОшибок = Новый Структура;
	
	ТаблицаОшибокЗадачи = Новый ТаблицаЗначений;
	ТаблицаОшибокЗадачи.Колонки.Добавить("Задача");
	ТаблицаОшибокЗадачи.Колонки.Добавить("ЗадачаПредставление");
	ТаблицаОшибокЗадачи.Колонки.Добавить("ЗадачаТекстОшибки");
	ТаблицаОшибокЗадачи.Колонки.Добавить("ИндексКартинки");
	
	ТаблицаОшибокОбщие = Новый ТаблицаЗначений;
	ТаблицаОшибокОбщие.Колонки.Добавить("ТекстОшибки");
	
	ТаблицаОшибок.Вставить("Задачи"  , ТаблицаОшибокЗадачи);
	ТаблицаОшибок.Вставить("Общие"   , ТаблицаОшибокОбщие);

	Если обПроверитьПроект(ТаблицаОшибок, СтруктураПроверки, ОтключитьИндикатор) = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТаблицаОшибок;
	
КонецФункции

// Проверяет наличие ошибок в структуре проекта.
//
// Параметры:
//  Проект						 - СправочникСсылка.Проекты - проект. 
//  ДанныеРасшифровкиСообщения	 - Новый Структура - данные для формирования сообщения пользователю 
//  Отказ						 - Булево
// 
// Возвращаемое значение:
//  Булево 
//
Функция ЕстьОшибкиСтруктурыПроекта(Проект, ДанныеРасшифровкиСообщения, Отказ) Экспорт
	
	МассивыСтруктурОшибок = упоПроектыИЗадачиСервер.ДанныеПроверкиСтруктурыПроекта(Проект, Отказ);
	
	Если МассивыСтруктурОшибок.Количество() = 0 Тогда
		Возврат Ложь;	
	КонецЕсли; 
	
	Заголовок = "";	
	ДокументРегистратор = Неопределено;
	ДокументСсылка = Неопределено;

	Если ДанныеРасшифровкиСообщения.Свойство("Заголовок") Тогда
		Заголовок = ДанныеРасшифровкиСообщения.Заголовок	
	КонецЕсли;
	
	Если ДанныеРасшифровкиСообщения.Свойство("ИмяДокумента") Тогда 
		ДокументРегистратор = Метаданные.Документы[ДанныеРасшифровкиСообщения.ИмяДокумента];
	КонецЕсли;
	
	Если ДанныеРасшифровкиСообщения.Свойство("ДокументСсылка") Тогда 
		ДокументСсылка = ДанныеРасшифровкиСообщения.ДокументСсылка;
	КонецЕсли;
	
	ТекстыОшибок = Новый Массив;
	ШаблонТекста = "%1 %2";
	Для каждого МассивСтруктурОшибок Из МассивыСтруктурОшибок Цикл	
		Для каждого ЭлементСтруктуры Из МассивСтруктурОшибок Цикл
			
			Если ЭлементСтруктуры.ВидОшибок = "Задачи" Тогда
				ТекстыОшибок.Добавить(СтрШаблон(ШаблонТекста, 
					ЭлементСтруктуры.ЗадачаПредставление, 
					ЭлементСтруктуры.ЗадачаТекстОшибки));
			Иначе	
	            ТекстыОшибок.Добавить(ЭлементСтруктуры.ТекстОшибки);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	ТекстСообщения = СтрСоединить(ТекстыОшибок, Символы.ПС);
	
	обСообщитьОбОшибке(ТекстСообщения, Отказ, Заголовок);
		
	КомментарийОшибки = СтрШаблон(НСтр("ru = 'Ошибка при проверке структуры проекта: %1.
		|%2'"), Проект, ТекстСообщения); 
	
	ПараметрыОшибки = Новый Структура;
	ПараметрыОшибки.Вставить("Событие", "ОшибкаПриПроверкеСтруктурыПроекта");
	ПараметрыОшибки.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
	ПараметрыОшибки.Вставить("ОбъектМетаданных", ДокументРегистратор);
	ПараметрыОшибки.Вставить("Данные", ДокументСсылка);
	ПараметрыОшибки.Вставить("Комментарий", КомментарийОшибки);
	упоРаботаСДиалогамиСервер.ЗаписатьВЖурналРегистрации(ПараметрыОшибки);

	Возврат Истина;
		
КонецФункции 

#КонецОбласти

