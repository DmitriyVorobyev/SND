#Область ПрограммныйИнтерфейс

// Выводит текст сообщения об ошибке в окно сообщений.
//
// Параметры:
//  ТекстСообщения							 - Строка	 - текст сообщения.
//  Отказ									 - Булево	 - Признак отказа от выполнения операции.
//  Заголовок								 - Строка	 - заголовок окна сообщения.
//  СтруктураПараметровЖурнала				 - Структура - структура параметров для записи информации в журнал регистрации.
//  СтруктураПолейСообщения					 - Структура - Содержит параметры объекта "СообщениеПользователю".
//  ВыводитьСообщенияОбОшибкеПользователю	 - Булево	 - признак необходимости вывода ошибок в интерфейс пользователю.
//
Процедура СообщитьОбОшибке(ТекстСообщения, Отказ = Ложь, Заголовок = "", СтруктураПараметровЖурнала = Неопределено,
	СтруктураПолейСообщения = Неопределено, ВыводитьСообщенияОбОшибкеПользователю = Истина) Экспорт

	Отказ = Истина;
	
#Если ВнешнееСоединение Тогда
	
	Если ЗначениеЗаполнено(Заголовок) Тогда
		ТекстСообщения = Заголовок + Символы.ПС + ТекстСообщения;
		Заголовок = "";
	КонецЕсли;
	
	ВызватьИсключение (ТекстСообщения);
	
#Иначе
	
	Если СтруктураПараметровЖурнала =  Неопределено Тогда
		СтруктураПараметровЖурнала = ПолучитьПустуюСтруктуруПараметровЖурнала();
		СтруктураПараметровЖурнала.Событие = "Ошибка";
		СтруктураПараметровЖурнала.Уровень = ПредопределенноеЗначение("УровеньЖурналаРегистрации.Ошибка");
		СтруктураПараметровЖурнала.Комментарий = ТекстСообщения;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Заголовок) Тогда
		упоРаботаСДиалогамиКлиентСервер.СообщитьПользователю(Заголовок);
		Заголовок = "";
	КонецЕсли;
	
	упоРаботаСДиалогамиКлиентСервер.СообщитьПользователю(ТекстСообщения, , СтруктураПараметровЖурнала, СтруктураПолейСообщения, 
		ВыводитьСообщенияОбОшибкеПользователю);
	
#КонецЕсли
	
КонецПроцедуры

// Выводит текст сообщения в окно сообщений.
//
// Параметры:
//  ТекстСообщения					 - Строка	 - содержит текст сообщения.
//  Статус							 - Неопределено	 - не используется. Определяет вид пиктограммы.
//  СписокПараметровЖурнала			 - Структура	 - сруктура пааметров журнала регистрации.
//  СтруктураПолейСообщения			 - Структура	 - содержит параметры объекта "СообщениеПользователю".
//  ВыводитьСообщениеПользователю	 - Булево		 - признак необходимости вывода ошибок в интерфейс пользователю.
//
Процедура СообщитьПользователю(ТекстСообщения,
					 Статус = Неопределено,
					 СписокПараметровЖурнала = Неопределено,
					 СтруктураПолейСообщения = Неопределено,
					 ВыводитьСообщениеПользователю = Истина) Экспорт
	
	Если ВыводитьСообщениеПользователю Тогда
		
		КлючДанных = Неопределено;
		Поле = "";
		ПутьКДанным = "";
		
		Если СтруктураПолейСообщения <> Неопределено Тогда
			СтруктураПолейСообщения.Свойство("КлючДанных", КлючДанных);	
			СтруктураПолейСообщения.Свойство("Поле", Поле);	
			СтруктураПолейСообщения.Свойство("ПутьКДанным", ПутьКДанным);	
		КонецЕсли;
				
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, КлючДанных, Поле, ПутьКДанным);
						
	КонецЕсли;
	
	Если Не СписокПараметровЖурнала = Неопределено Тогда
		упоРаботаСДиалогамиСервер.ЗаписатьВЖурналРегистрации(СписокПараметровЖурнала);
	КонецЕсли;
	
КонецПроцедуры

// Получает пустую структуру параметров журнала.
// 
// Возвращаемое значение:
//  Структура - пустая структура параметров.
//
Функция ПолучитьПустуюСтруктуруПараметровЖурнала() Экспорт
	
	ПараметрыЖурнала = Новый Структура;
	
	ПараметрыЖурнала.Вставить("Событие", "");  //НСтр("ru = 'Выполняемое событие'");
	ПараметрыЖурнала.Вставить("Уровень", Неопределено); //ПредопределенноеЗначение("УровеньЖурналаРегистрации.Ошибка");
	ПараметрыЖурнала.Вставить("ОбъектМетаданных", Неопределено);  //Метаданные.Документы.ИмяДокумента
	ПараметрыЖурнала.Вставить("Данные", Неопределено); //Ссылка
	ПараметрыЖурнала.Вставить("Комментарий", ""); //ОписаниеОшибки()	
	
	Возврат ПараметрыЖурнала;
	
КонецФункции 

// Получает структуру параметров журнала, заполненную значениями, передаваемыми в параметрах. См.ПолучитьПустуюСтруктуруПараметровЖурнала
//
// Параметры:
//  Событие			 - Строка				 - выполняемое событие
//  Уровень			 - УровеньЖурналаРегистрации - уровень журнала регистрации.
//  Комментарий		 - Строка					 - комментарий журнала регистрации.
//  ОбъектМетаданных - Строка, Неопределено		 - имя документа Метаданные.Документы.ИмяДокумента
//  Данные			 - ЛюбаяСсылка, Неопределено - данные журнала регистрации.
// 
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьСтруктуруПараметровЖурнала(Событие, Уровень, Комментарий, ОбъектМетаданных = Неопределено,
	Данные = Неопределено) Экспорт
	
	Результат = ПолучитьПустуюСтруктуруПараметровЖурнала();
	Результат.Событие = Событие;
	Результат.Уровень = Уровень;
	Результат.Комментарий = Комментарий;
	Результат.ОбъектМетаданных = ОбъектМетаданных;
	Результат.Данные = Данные;
	
	Возврат Результат;
	
КонецФункции 

#КонецОбласти