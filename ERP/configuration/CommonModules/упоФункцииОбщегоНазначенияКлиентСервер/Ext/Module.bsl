#Область ПрограммныйИнтерфейс

// Устарела. см.СтрШаблон.
// Подставляет параметры в строку, находя их по символу %.
//
// Параметры:
//  СтрокаПодстановки	 - Строка - строка, в которую надо осуществить подстановку.
//  Параметр1			 - Строка - параметр 1.
//  Параметр2			 - Строка - необязательный. Параметр 2.
//  Параметр3			 - Строка - необязательный. Параметр 3.
//  Параметр4			 - Строка - необязательный. Параметр 4.
//  Параметр5			 - Строка - необязательный. Параметр 5.
//  Параметр6			 - Строка - необязательный. Параметр 6.
//  Параметр7			 - Строка - необязательный. Параметр 7.
//  Параметр8			 - Строка - необязательный. Параметр 8.
//  Параметр9			 - Строка - необязательный. Параметр 9.
//
// Возвращаемое значение:
//	Строка - строка с подставленными параметрами.
//
Функция ПодставитьПараметрыВСтроку(Знач СтрокаПодстановки,
	Знач Параметр1,	Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
	Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено) Экспорт
	
	Если СтрокаПодстановки = Неопределено ИЛИ СтрДлина(СтрокаПодстановки) = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = "";
	НачПозиция = 1;
	Позиция = 1;
	Пока Позиция <= СтрДлина(СтрокаПодстановки) Цикл
		СимволСтроки = Сред(СтрокаПодстановки, Позиция, 1);
		Если СимволСтроки <> "%" Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Результат = Результат + Сред(СтрокаПодстановки, НачПозиция, Позиция - НачПозиция);
		Позиция = Позиция + 1;
		СимволСтроки = Сред(СтрокаПодстановки, Позиция, 1);
		
		Если СимволСтроки = "%" Тогда
			Позиция = Позиция + 1;
			НачПозиция = Позиция;
			Продолжить;
		КонецЕсли;
		
		Попытка
			НомерПараметра = Число(СимволСтроки);
		Исключение
			ВызватьИсключение НСтр("ru='Входная строка СтрокаПодстановки имеет неверный формат: %'" + СимволСтроки);
		КонецПопытки;
		
		Если СимволСтроки = "1" Тогда
			ЗначениеПараметра = Параметр1;
		ИначеЕсли СимволСтроки = "2" Тогда
			ЗначениеПараметра = Параметр2;
		ИначеЕсли СимволСтроки = "3" Тогда
			ЗначениеПараметра = Параметр3;
		ИначеЕсли СимволСтроки = "4" Тогда
			ЗначениеПараметра = Параметр4;
		ИначеЕсли СимволСтроки = "5" Тогда
			ЗначениеПараметра = Параметр5;
		ИначеЕсли СимволСтроки = "6" Тогда
			ЗначениеПараметра = Параметр6;
		ИначеЕсли СимволСтроки = "7" Тогда
			ЗначениеПараметра = Параметр7;
		ИначеЕсли СимволСтроки = "8" Тогда
			ЗначениеПараметра = Параметр8;
		ИначеЕсли СимволСтроки = "9" Тогда
			ЗначениеПараметра = Параметр9;
		Иначе
			ВызватьИсключение НСтр("ru='Входная строка СтрокаПодстановки имеет неверный формат: %'" + ЗначениеПараметра);
		КонецЕсли;
		Если ЗначениеПараметра = Неопределено Тогда
			ЗначениеПараметра = "";
		Иначе
			ЗначениеПараметра = Строка(ЗначениеПараметра);
		КонецЕсли;
		Результат = Результат + ЗначениеПараметра;
		Позиция = Позиция + 1;
		НачПозиция = Позиция;
	
	КонецЦикла;
	
	Если (НачПозиция <= СтрДлина(СтрокаПодстановки)) Тогда
		Результат = Результат + Сред(СтрокаПодстановки, НачПозиция, СтрДлина(СтрокаПодстановки) - НачПозиция + 1);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, существует ли у объекта свойство.
//
// Параметры:
//  Объект		 - Произвольный - объект, для которого необходимо проверить наличие свойства.
//  ИдСвойства	 - Строка 		- имя свойства.
//
// Возвращаемое значение:
//	Булево - признак наличия свойства у объекта.
//
Функция СуществуетСвойство(Объект, ИдСвойства) Экспорт
	
	Попытка	
		Тест=Объект[ИдСвойства];
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина; 
	
КонецФункции

// Заполняет свойства объекта, если свойство существует.
//
// Параметры:
//  Объект			 - Произвольный	 - объект, для которого необходимо заполнить свойство.
//  ИмяСвойства		 - Строка		 - имя свойства.
//  ЗначениеСвойства - Произвольный	 - значение свойства.
//
Процедура ЗаполнитьСвойствоЕслиЕсть(Объект, ИмяСвойства, ЗначениеСвойства) Экспорт
	
	ДанныеЗаполнения = Новый Структура(ИмяСвойства, ЗначениеСвойства);
	
	ЗаполнитьЗначенияСвойств(Объект, ДанныеЗаполнения);
	
КонецПроцедуры

// Возвращает признак существования заполненного свойства в объекта.
//
// Параметры:
//  Объект			 - Произвольный	 - объект, для которого необходимо определить наличие заполненного свойства.
//  ИмяСвойства		 - Строка		 - имя проверяемого свойства.
// 
// Возвращаемое значение:
//  Булево - признак существования заполненного свойства.
//
Функция СвойствоСуществуетИЗаполнено(Объект, ИмяСвойства) Экспорт
	
	ДанныеЗаполнения = Новый Структура(ИмяСвойства);
	
	ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, Объект);
	
	Возврат ЗначениеЗаполнено(ДанныеЗаполнения[ИмяСвойства]);
	
КонецФункции

// Получает форму, которой принадлежит элемент.
//
// Параметры:
//  Элемент	 - УправляемаяФорма, ЭлементФормы	 - элемент, для которого необходимо получить форму.
// 
// Возвращаемое значение:
//  УправляемаяФорма, Неопределено - в случае провала - неопределено.
//
Функция ПолучитьФормуЭлементаФормы(Элемент) Экспорт
	
	Если ТипЗнч(Элемент) = Тип("УправляемаяФорма") Тогда
		Возврат Элемент;
	Иначе
		Родитель = Ложь;
		Попытка 
			Родитель = Элемент.Родитель;
		Исключение
		КонецПопытки;
		Если Родитель <> Ложь Тогда
			Возврат ПолучитьФормуЭлементаФормы(Родитель);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Возвращает структуру, скопированную из структуры-источника.
//
// Параметры:
//  Структура			 - Структура 	- источник.
//  НадоЗаполнитьЗначение- Булево	 	- признак того, следует ли заполнять значение из параметра ЗначениеЗаполнения.
//  ЗначениеЗаполнения	 - Произвольный	- значение заполнения значения в случае, если НадоЗаполнитьЗначение = Истина.
//
// Возвращаемое значение:
//	Структура - скопированная структура.
//
Функция СкопироватьСтруктуру(Структура, НадоЗаполнитьЗначение = Ложь, ЗначениеЗаполнения = Неопределено) Экспорт
	
	НоваяСтруктура = Новый Структура;
	Для Каждого КлючЗначение Из Структура Цикл
		Если НадоЗаполнитьЗначение Тогда
			Значение = ЗначениеЗаполнения;
		Иначе
			Значение = КлючЗначение.Значение;
		КонецЕсли;
		НоваяСтруктура.Вставить(КлючЗначение.Ключ, Значение);
	КонецЦикла;
	
	Возврат НоваяСтруктура;
	
КонецФункции

// Сверачивает массив.
//
// Параметры:
//  Массив			 - Массив - сворачиваемый массив.
//  УдалитьПустой	 - Булево - признак необходимости удалять пустые элементы массива.
//
// Возвращаемое значение:
//	Массив - свернутый массив.
//
Функция СвернутьМассив(Массив, УдалитьПустой = Ложь) Экспорт 
	
	НовыйМассив = Новый Массив; Соответствие = Новый Соответствие;
	
	Для каждого ЭлементМассива Из Массив Цикл
		Если Не УдалитьПустой ИЛИ ЗначениеЗаполнено(ЭлементМассива) Тогда		
			Соответствие.Вставить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого КлючИЗначение Из Соответствие Цикл
		НовыйМассив.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;	
	Массив = НовыйМассив;
	
	Возврат Массив;
	
КонецФункции

