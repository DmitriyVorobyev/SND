// Устанавливат отбор по полю компоновки компоновщика настроек и возвращает признак успешного завершения.
//
// Параметры:
//  КомпоновщикНастроек		 - КомпоновщикНастроекКомпоновкиДанных	 - модифицируемый компоновщик настроек.
//  ИмяПоля					 - Строка	 - имя поля отбора.
//  Значение				 - Произвольный	 - значение поля отбора.
//  ОтключитьДругиеОтборы	 - Булево	 - признак отключения других отборов.
//  ДобавитьНовый			 - Булево	 - признак добавления нового отбора, если по имени отбор не найден.
//  РодительскоеПоле		 - ПолеКомпоновкиДанных	 - родительская группа отбора.
//  ИерархическийОтбор		 - Булево	 - признак установки иерархического отбора.
// 
// Возвращаемое значение:
//  Булево - признак успешной установки отбора.
//
Функция УстановитьОтборПоПолюКомпоновки(КомпоновщикНастроек, ИмяПоля, Знач Значение, ОтключитьДругиеОтборы = Ложь, 
												ДобавитьНовый = Ложь, РодительскоеПоле = Неопределено, ИерархическийОтбор = Ложь) Экспорт
												
	ОтборУстановлен = Ложь;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		врЗначение = Новый СписокЗначений;
		врЗначение.ЗагрузитьЗначения(Значение);
		Значение = врЗначение;
	КонецЕсли;
	
	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);		
	ЭлементПН = Неопределено;
	ЭлементОтбораНайден = Ложь;
	Для Каждого Элемент Из КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = Поле Тогда
			
			ЭлементОтбораНайден = Истина;	
			ЭлементПН = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(
				Элемент.ИдентификаторПользовательскойНастройки);
			Если ЭлементПН = Неопределено Тогда 
				ЭлементПН = Элемент;
			КонецЕсли;
			ЭлементПН.ПравоеЗначение = Значение;
			ЭлементПН.ВидСравнения = ВидСравненияПоЗначению(ЭлементПН.ПравоеЗначение, ИерархическийОтбор);
			ЭлементПН.Использование = Истина;
			
			ОтборУстановлен = Истина;
			
		КонецЕсли;
		
	КонецЦикла;   
	
	// Если поле доступно для отбора, добавляем отбор в настройки
	Если ДобавитьНовый И НЕ ЭлементОтбораНайден Тогда
		ДоступноеПолеОтбора = Неопределено;
		Если РодительскоеПоле = Неопределено Тогда
			ДоступноеПолеОтбора = КомпоновщикНастроек.Настройки.ДоступныеПоляОтбора.НайтиПоле(Поле);
		Иначе
			РодительскоеДоступноеПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляОтбора.НайтиПоле(РодительскоеПоле);
			Если РодительскоеДоступноеПоле <> Неопределено Тогда
				ДоступноеПолеОтбора = РодительскоеДоступноеПоле.Элементы.Найти(ИмяПоля);
			КонецЕсли; 			
		КонецЕсли;
		Если ДоступноеПолеОтбора <> Неопределено Тогда
			ЭлементПН = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементПН.ЛевоеЗначение = Поле;
			ЭлементПН.ВидСравнения = ВидСравненияПоЗначению(Значение, ИерархическийОтбор);
			ЭлементПН.ПравоеЗначение = Значение;
			ЭлементПН.Использование = Истина;		
			
			ОтборУстановлен = Истина;
			
		КонецЕсли;	
	КонецЕсли;
	
	Если ОтключитьДругиеОтборы Тогда
		ОтключитьВсеОтборыКроме(КомпоновщикНастроек, ЭлементПН);
	КонецЕсли;
	
	Возврат ОтборУстановлен;
	
КонецФункции

// Добавляет указанное количество пробелов к переданной строке.
//
// Параметры:
//  СтрокаТекста		 - Строка - строка текста
//  КоличествоПробелов	 - Число - добавляемоей количество пробелов
// 
// Возвращаемое значение:
//  Строка - строка текста с добавленными пробелами.
//
Функция ДобавитьПробелыКСтроке(СтрокаТекста, КоличествоПробелов) Экспорт
	
	Для Индекс = 0 По КоличествоПробелов - 1 Цикл
		СтрокаТекста = СтрокаТекста + " "; // пробел
	КонецЦикла;
	
	Возврат СтрокаТекста;
	
КонецФункции

// Возвращает разобранный состав имени формы по полному имени формы.
//
// Параметры:
//  ИмяФормы - Строка - полное имя формы.
// 
// Возвращаемое значение:
//  Структура - состав имени формы.
//
Функция СоставИмениФормы(ИмяФормы) Экспорт
	
	СоставИмени = Новый Структура("ТипМетаданных, ВидМетаданных, ИмяФормы");
	
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	Если Не ЗначениеЗаполнено(ЧастиИмени) Тогда
		Возврат ЧастиИмени;
	КонецЕсли;
	
	ИмяТипаМетаданных = ЧастиИмени[0];
	Если ИмяТипаМетаданных = "ОбщаяФорма" Тогда
		СоставИмени.ТипМетаданных = ИмяТипаМетаданных;
		СоставИмени.ВидМетаданных = ИмяТипаМетаданных;
		СоставИмени.ИмяФормы = ЧастиИмени[1];
	Иначе
		СоставИмени.ТипМетаданных = ИмяТипаМетаданных;
		СоставИмени.ВидМетаданных = ЧастиИмени[1];
