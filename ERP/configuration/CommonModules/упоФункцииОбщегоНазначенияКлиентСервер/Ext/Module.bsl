Функция ВидСравненияПоЗначению(Значение, Иерархия) 
	Если ТипЗнч(Значение) = Тип("СписокЗначений") И Значение.Количество() > 1 Тогда   
		Если Иерархия Тогда
			лВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
		Иначе
			лВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;
	Иначе
		Если Иерархия Тогда
			лВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
		Иначе
			лВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		КонецЕсли;
	КонецЕсли;
	Возврат лВидСравнения;
КонецФункции 

Функция ОтключитьВсеОтборыКроме(КомпоновщикНастроек, ЭлементПН)  
	Если КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Количество() > 0 Тогда
		Коллекция = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Иначе
		Коллекция = КомпоновщикНастроек.Настройки.Отбор.Элементы; 
	КонецЕсли;
	Для Каждого Элемент Из Коллекция Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент <> ЭлементПН Тогда
			Элемент.Использование = Ложь;	
		КонецЕсли;
	КонецЦикла;
КонецФункции

Функция ПолучитьМаксМин(флМаксимум = Истина, флПроверкаНаЗначение = Ложь, П1=Неопределено,
						П2=Неопределено,
						П3=Неопределено,
						П4=Неопределено,
						П5=Неопределено,
						П6=Неопределено, 
						П7=Неопределено,
						П8=Неопределено,
