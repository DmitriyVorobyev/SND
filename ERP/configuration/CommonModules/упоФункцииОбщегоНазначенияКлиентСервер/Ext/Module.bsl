// Определяет режим эксплуатации информационной базы: ГРМ (Истина) или нет (Ложь).
// При проверке используется СтрокаСоединенияИнформационнойБазы, которую можно указать явно. 
// Пример адреса https://app123123.1capp.net/MyBase/ru_RU/
//
// Параметры:
//  СтрокаСоединенияИБ - Строка - параметр используется, если
//                 нужно проверить строку соединения не текущей информационной базы.
//
// Возвращаемое значение:
//  Булево - Истина, если база развернута в ГРМ.
//
Функция ИнформационнаяБазаГРМ(Знач СтрокаСоединенияИБ = "") Экспорт
	
	ЭтоБазаГРМ = Ложь;
	
	Если ПустаяСтрока(СтрокаСоединенияИБ) Тогда
		СтрокаСоединенияИБ = СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	СтрокаСоединенияИБ = ВРег(СтрокаСоединенияИБ);
	
	НачалоАдресаГРМ = "HTTPS://APP";
	ПубликацияСодержитАдрес_APP = СтрНайти(СтрокаСоединенияИБ, НачалоАдресаГРМ) = 1;
	Если Не ПубликацияСодержитАдрес_APP Тогда
		Возврат ЭтоБазаГРМ;
	КонецЕсли;
	
	ДоменАдресаГРМ = ".1CAPP.NET/";
	ВхождениеДомена_NET = СтрНайти(СтрокаСоединенияИБ, ДоменАдресаГРМ);
	Если ВхождениеДомена_NET = 0 Тогда
		Возврат ЭтоБазаГРМ; 
	КонецЕсли;
	
	ПозицияИдентификатораГРМ = СтрДлина(НачалоАдресаГРМ) + 1;
	ДлинаДомена = СтрДлина(ДоменАдресаГРМ);
	
	ИдентификаторГРМ = Сред(СтрокаСоединенияИБ, ПозицияИдентификатораГРМ, ВхождениеДомена_NET - ПозицияИдентификатораГРМ);
	
	Попытка
		ИдентификаторГРМЧислом = Число(ИдентификаторГРМ);
		ЭтоБазаГРМ = Истина;
	Исключение
		ЭтоБазаГРМ = Ложь;
	КонецПопытки;
	
	Возврат ЭтоБазаГРМ;
	
КонецФункции

#КонецОбласти

