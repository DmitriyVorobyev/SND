// Возвращает полное или сокращенное наименование месяца по его номеру.
//
// Параметры:
//  НомерМесяца	 - Число 	- номер месяца.
//  Сокращенное	 - Булево 	- признак того, что необходимо вернуть сокращенное наименование.
//
// Возвращаемое значение:
//	Строка - имя месяца.
//
Функция ОпределитьИмяМесяца(НомерМесяца, Сокращенное = Ложь) Экспорт
	Результат = ?(НомерМесяца = 1, ?(Сокращенное, "Янв.", "Январь"), 
				?(НомерМесяца = 2, ?(Сокращенное, "Фев.", "Февраль"), 
				?(НомерМесяца = 3, "Март", 
				?(НомерМесяца = 4, ?(Сокращенное, "Апр.", "Апрель"), 
				?(НомерМесяца = 5, "Май", 
				?(НомерМесяца = 6, "Июнь", 
				?(НомерМесяца = 7, "Июль", 
				?(НомерМесяца = 8, ?(Сокращенное, "Авг.", "Август"), 
				?(НомерМесяца = 9, ?(Сокращенное, "Сент.", "Сентябрь"), 
				?(НомерМесяца = 10, ?(Сокращенное, "Окт.", "Октябрь"), 
				?(НомерМесяца = 11, ?(Сокращенное, "Нояб.", "Ноябрь"), 
				?(НомерМесяца = 12, ?(Сокращенное, "Дек.", "Декабрь"), 
				""))))))))))));
	
	Возврат Результат;
КонецФункции

// Возвращает начало периода по дате (начало дня, недели, месяца, квартала, года).
//
// Параметры:
//  Дата			 - Дата 	- дата, по которой надо вернуть начало периода.
//  Периодичность	 - Строка 	- "день", "неделя", "месяц", "квартал", "год".
//
// Возвращаемое значение:
//	Дата - начало периода.
//
Функция НачалоПериода(Дата, Периодичность) Экспорт
	
	Если НРег(Периодичность) = "день" Тогда
		Возврат НачалоДня(Дата);
	ИначеЕсли НРег(Периодичность) = "неделя" Тогда
		Возврат НачалоНедели(Дата);
	ИначеЕсли НРег(Периодичность) = "месяц" Тогда
		Возврат НачалоМесяца(Дата);
	ИначеЕсли НРег(Периодичность) = "квартал" Тогда
		Возврат НачалоКвартала(Дата);
	ИначеЕсли НРег(Периодичность) = "год" Тогда
		Возврат НачалоГода(Дата);
	Иначе
		Возврат НачалоДня(Дата);
	КонецЕсли;	
	
КонецФункции

// Возвращает конец периода по дате (конец дня, недели, месяца, квартала, года).
//
// Параметры:
//  Дата			 - Дата 	- дата, по которой надо вернуть конец периода.
//  Периодичность	 - Строка 	- "день", "неделя", "месяц", "квартал", "год".
//
// Возвращаемое значение:
//	Дата - конец периода.
//
Функция КонецПериода(Дата, Периодичность) Экспорт
	
	Если НРег(Периодичность) = "день" Тогда
		Возврат КонецДня(Дата);
	ИначеЕсли НРег(Периодичность) = "неделя" Тогда
		Возврат КонецНедели(Дата);
	ИначеЕсли НРег(Периодичность) = "месяц" Тогда
		Возврат КонецМесяца(Дата);
	ИначеЕсли НРег(Периодичность) = "квартал" Тогда
		Возврат КонецКвартала(Дата);
	ИначеЕсли НРег(Периодичность) = "год" Тогда
		Возврат КонецГода(Дата);   
	Иначе
		Возврат КонецДня(Дата);
	КонецЕсли;	
	
КонецФункции

// Добавляет определнное количество указанных периодов к дате.
//
// Параметры:
//  Дата		 - Дата 	- дата, к которой надо добавить период.
//  Период		 - Строка 	- вид периода: "день", "неделя", "месяц", "квартал", "год".
//  Количество	 - Число	- количество добавляемых периодов. Необязательный. По умолчанию = 1.
//
// Возвращаемое значение:
//	Дата - итоговая дата.
//
Функция ДобавитьПериод(Дата, Период, Количество = 1) Экспорт
	
	Результат = Дата;
	
	Если НРег(Период) = "день" Тогда
		Результат = Результат + Количество * 86400;
	ИначеЕсли НРег(Период) = "неделя" Тогда
		Результат = Результат + Количество * 604800
	ИначеЕсли НРег(Период) = "месяц" Тогда
		Результат = ДобавитьМесяц(Результат, Количество);
	ИначеЕсли НРег(Период) = "квартал" Тогда
		Результат = ДобавитьМесяц(Результат, Количество * 3);
	ИначеЕсли НРег(Период) = "год" Тогда
		Результат = ДобавитьМесяц(Результат, Количество * 12);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Получает разность дат в месяцах.
//
// Параметры:
//  Дата1	 - Дата - дата, из которой вычитаем.
//  Дата2	 - Дата	- дата, которую вычитаем.
//
// Возвращаемое значение:
//	Число - количество месяцев.
//
Функция РазностьДатВМесяцах(Дата1, Дата2) Экспорт
	
	РазницаЛет = Год(Дата1)	- Год(Дата2);
	РазницаМесяцев = РазницаЛет * 12 + Месяц(Дата1) - Месяц(Дата2);
	
	Возврат РазницаМесяцев;
	
КонецФункции

// Функция определяет дату и время начала календарной декады для указанной даты.
//
// Параметры:
//  ИсходнаяДата - Дата - исходная дата.
//
// Возвращаемое значение:
//  Дата - вычисленная дата.
//
Функция ПолучитьНачалоДекады(ИсходнаяДата) Экспорт

	ДеньМесяца = День(ИсходнаяДата);

	Если ДеньМесяца <= 10 Тогда
		Результат = НачалоМесяца(ИсходнаяДата);
	ИначеЕсли ДеньМесяца <= 20 Тогда
		Результат = НачалоМесяца(ИсходнаяДата) + 60 * 60 * 24 * 10;
	Иначе
		Результат = НачалоМесяца(ИсходнаяДата) + 60 * 60 * 24 * 20;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Функция определяет дату и время конца календарной декады для указанной даты.
//
// Параметры:
//  ИсходнаяДата - Дата - исходная дата.
//
// Возвращаемое значение:
//  Дата - вычисленная дата.
//
Функция ПолучитьКонецДекады(ИсходнаяДата) Экспорт

	ДеньМесяца = День(ИсходнаяДата);

	Если ДеньМесяца <= 10 Тогда
		Результат = КонецДня(НачалоМесяца(ИсходнаяДата) + 60 * 60 * 24 * 9);
	ИначеЕсли ДеньМесяца <= 20 Тогда
		Результат = КонецДня(НачалоМесяца(ИсходнаяДата) + 60 * 60 * 24 * 19);
	Иначе
		Результат = КонецМесяца(ИсходнаяДата);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Функция определяет дату и время начала полугодия для указанной даты.
//
// Параметры:
//  ИсходнаяДата - Дата - исходная дата.
//
// Возвращаемое значение:
//  Дата - вычисленная дата.
//
Функция ПолучитьНачалоПолугодия(ИсходнаяДата) Экспорт

	Если Месяц(ИсходнаяДата) < 7 Тогда
		Результат = НачалоГода(ИсходнаяДата);
	Иначе
		Результат = ДобавитьМесяц(НачалоГода(ИсходнаяДата), 6);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Функция определяет дату и время конца полугодия для указанной даты.
//
// Параметры:
//  ИсходнаяДата - Дата - исходная дата.
//
// Возвращаемое значение:
//  Дата - вычисленная дата.
//
Функция ПолучитьКонецПолугодия(ИсходнаяДата) Экспорт

	Если Месяц(ИсходнаяДата) < 7 Тогда
		Результат = ДобавитьМесяц(КонецГода(ИсходнаяДата), -6);
	Иначе
		Результат = КонецГода(ИсходнаяДата);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

// Пересчитывает суммы "вверх" от строки по дереву значений.
//
// Параметры:
//  СтруктураКолонокИРазниц	 - Структура - структура колонок и разниц.
//  Строка					 - ДанныеФормыЭлементДерева, ДанныеФормыДерево, СтрокаДереваЗначений, ДеревоЗначений - строка дерева.
//
Процедура ПересчитатьСуммыВВерхПоДереву(СтруктураКолонокИРазниц, Строка) Экспорт
	
	Если Строка <> Неопределено Тогда
				
		Для Каждого КлючЗначение Из СтруктураКолонокИРазниц Цикл
			
			Строка[КлючЗначение.Ключ] = Строка[КлючЗначение.Ключ] - СтруктураКолонокИРазниц[КлючЗначение.Ключ];
			
		КонецЦикла;
		
		ТекТип = Неопределено;
#Если Сервер ИЛИ ТолстыйКлиент Тогда
		Если ТипЗнч(Строка) = Тип("ДеревоЗначений") Тогда
			ТекТип = "ДеревоЗначений";
		ИначеЕсли ТипЗнч(Строка) = Тип("СтрокаДереваЗначений") Тогда
			ТекТип = "СтрокаДереваЗначений";
		КонецЕсли;
#КонецЕсли	
		Если ТипЗнч(Строка) = Тип("ДанныеФормыЭлементДерева") Тогда
			ТекТип = "ДанныеФормыЭлементДерева";
		ИначеЕсли ТипЗнч(Строка) = Тип("ДанныеФормыДерево") Тогда
			ТекТип = "ДанныеФормыДерево";
		КонецЕсли;
		
		Если ТекТип = "СтрокаДереваЗначений" Тогда
			ПересчитатьСуммыВВерхПоДереву(СтруктураКолонокИРазниц, Строка.Родитель)
		ИначеЕсли ТекТип = "ДанныеФормыЭлементДерева" Тогда
			ПересчитатьСуммыВВерхПоДереву(СтруктураКолонокИРазниц, Строка.ПолучитьРодителя())
		КонецЕсли;
		                                            	
	КонецЕсли;
	
КонецПроцедуры

// Функция создает новый объект - копию переданного для объектов типа Структура, ТаблицаЗначений, СписокЗначений.
//
// Параметры:
//  Объект - Структура, ТаблицаЗначений, СписокЗначений, Соответствие - исходный объект.
//
// Возвращаемое значение:
//  Структура, ТаблицаЗначений, СписокЗначений, Соответствие - копия исходного объекта.
//
Функция УниКопироватьОбъект1С(Объект) Экспорт
	
	Если ТипЗнч(Объект)=Тип("Структура") Тогда
        Рез=Новый Структура();
        Для Каждого Эл Из Объект Цикл
            Рез.Вставить(Эл.Ключ, УниКопироватьОбъект1С(Эл.Значение));
		КонецЦикла;
		Возврат Рез;
	КонецЕсли;
	
#Если ТолстыйКлиентОбычноеПриложение ИЛИ Сервер Тогда 
    Если ТипЗнч(Объект)=Тип("ТаблицаЗначений") Тогда
        Возврат Объект.Копировать();
	КонецЕсли;
#КонецЕсли

    Если ТипЗнч(Объект)=Тип("СписокЗначений") Тогда
        Рез=Новый СписокЗначений();
        Для Каждого Эл Из Объект Цикл
            Рез.Добавить(УниКопироватьОбъект1С(Эл.Значение), Эл.Представление, Эл.Пометка, Эл.Картинка);
		КонецЦикла;
		Возврат Рез;
	ИначеЕсли ТипЗнч(Объект)=Тип("Соответствие") Тогда
        Рез=Новый Соответствие();
        Для Каждого Эл Из Объект Цикл
            Рез.Вставить(Эл.Ключ, УниКопироватьОбъект1С(Эл.Значение));
		КонецЦикла;
		Возврат Рез;
    Иначе
        Возврат Объект;
	КонецЕсли;
	
КонецФункции

// Функция преобразует что-то во что-то.
//
// Параметры:
//  Значение - Число - преобразуемое значение.
//  Нотация	 - Число - нотация.
//
// Возвращаемое значение:
//	Число - преобразованное значение.
//
Функция Из_10_В_Любую(Знач Значение=0, Нотация=36) Экспорт
	
	Если Нотация <= 0 Тогда 
		Возврат "";
	КонецЕсли;
	
	Значение = Число(Значение);
	Если Значение<=0 Тогда 
		Возврат "0";
	КонецЕсли;
	
	Значение = Цел(Значение);
	Результат = "";
	Пока Значение > 0 Цикл
		Результат = Сред("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", Значение % Нотация + 1, 1) + Результат;
		Значение = Цел(Значение / ?(Нотация = 0, 1, Нотация)) ;
	КонецЦикла;
	
	Возврат Результат;
	 
КонецФункции

// Функция преобразует что-то во что-то.
//
// Параметры:
//  Значение - Число - преобразуемое значение.
//  Нотация	 - Число - нотация.
//
// Возвращаемое значение:
//	Число - результат.
//
Функция Из_Любой_В_10(Знач Значение="0", Нотация=36) Экспорт
	
	Если Нотация <= 0 Тогда 
		Возврат 0; 
	КонецЕсли;
	
	Значение = СокрЛП(Значение);
	Если Значение = "0" Тогда 
		Возврат 0;
	КонецЕсли;
	
	Результат = 0;
	Длина = СтрДлина(Значение);
	Для Ит = 1 По Длина Цикл
		Коэф = 1;
		Для ИтВлож = 1 По Длина - Ит Цикл 
			Коэф = Коэф * Нотация 
		КонецЦикла;
		Результат = Результат + (Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сред(Значение, Ит, 1)) - 1) * Коэф;
	КонецЦикла;
	
	Возврат Окр(Результат);
	
КонецФункции

// Возвращает числовое значение ставки НДС по значению перечисления.
//
// Параметры:
// 		СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - значение перечисления СтавкиНДС.
//
// Возвращаемое значение:
//	Число - Значение ставки НДС числом.
//
Функция ПолучитьСтавкуНДСЧислом(Знач СтавкаНДС) Экспорт
	
	Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110") Тогда
		Возврат 0.1;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118") Тогда
		Возврат 0.18;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120") Тогда
		Возврат 0.2;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105") Тогда
		Возврат 0.05;
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107") Тогда
		Возврат 0.07;
	// Новые ставки добавляем в конце Если на случай, если код добавлен раньше, чем значение перечисления.
	ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122") Тогда
		Возврат 0.22;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

