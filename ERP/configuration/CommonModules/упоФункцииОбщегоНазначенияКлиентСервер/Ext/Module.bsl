						П10=Неопределено,
						П11=Неопределено,
						П12=Неопределено,
						П13=Неопределено)
	
	МассивЭлементов = Новый Массив;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П1) Тогда МассивЭлементов.Добавить(П1); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П2) Тогда МассивЭлементов.Добавить(П2); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П3) Тогда МассивЭлементов.Добавить(П3); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П4) Тогда МассивЭлементов.Добавить(П4); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П5) Тогда МассивЭлементов.Добавить(П5); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П6) Тогда МассивЭлементов.Добавить(П6); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П7) Тогда МассивЭлементов.Добавить(П7); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П8) Тогда МассивЭлементов.Добавить(П8); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П9) Тогда МассивЭлементов.Добавить(П9); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П10) Тогда МассивЭлементов.Добавить(П10); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П11) Тогда МассивЭлементов.Добавить(П11); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П12) Тогда МассивЭлементов.Добавить(П12); КонецЕсли;
	Если НЕ флПроверкаНаЗначение ИЛИ ЗначениеЗаполнено(П13) Тогда МассивЭлементов.Добавить(П13); КонецЕсли;
	Если МассивЭлементов.Количество() > 0 Тогда
		Результат = МассивЭлементов[0];
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	Для Каждого Элемент Из МассивЭлементов Цикл
		Если флМаксимум Тогда
			Результат = Макс(Результат, Элемент);
		Иначе
			Результат = Мин(Результат, Элемент);
		КонецЕсли;
