	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	Источник = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник;		
	Если ТипЗнч(ВхПараметр) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда      		
		Источник.Параметры[1].Выражение = Новый ВыражениеСхемыЗапроса("Версия = &ТекущаяВерсия И ПроектнаяЗадача = &ПроектнаяЗадача");
		Запрос.УстановитьПараметр("ПроектнаяЗадача", ВхПараметр); 
	ИначеЕсли ТипЗнч(ВхПараметр) = Тип("СписокЗначений") Тогда		
		Источник.Параметры[1].Выражение = Новый ВыражениеСхемыЗапроса("Версия = &ТекущаяВерсия И ПроектнаяЗадача В (&СписокЗадач)");
		Запрос.УстановитьПараметр("СписокЗадач", ВхПараметр.ВыгрузитьЗначения());
	ИначеЕсли ТипЗнч(ВхПараметр) = Тип("Массив") Тогда
		Источник.Параметры[1].Выражение = Новый ВыражениеСхемыЗапроса("Версия = &ТекущаяВерсия И ПроектнаяЗадача В (&СписокЗадач)");
		Запрос.УстановитьПараметр("СписокЗадач", ВхПараметр);
	ИначеЕсли НЕ ТипЗнч(ВхПараметр) = Тип("СправочникСсылка.Проекты") Тогда
		Возврат Неопределено; // некорректные входные данные
	КонецЕсли; 
				
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();	
	
	Результат = Запрос.ВыполнитьПакет();
	ИндексКрайнего = Результат.ВГраница();
	
	// Данные плана доходов расходов.
	Если Не Результат[ИндексКрайнего - 3].Пустой() Тогда
		Выборка = Результат[ИндексКрайнего - 3].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПланаБДР.Добавить(), Выборка);
		КонецЦикла;	
	КонецЕсли;
	// Трансляция мат.затрат.
	Если НЕ Результат[ИндексКрайнего - 2].Пустой() Тогда
		Выборка = Результат[ИндексКрайнего - 2].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПланаБДР.Добавить(), Выборка);
		КонецЦикла;				
	КонецЕсли;	
	// Трансляция доп.затрат.
	Если НЕ Результат[ИндексКрайнего - 1].Пустой() Тогда
		Выборка = Результат[ИндексКрайнего - 1].Выбрать();
		ВалютаУправленческогоУчета = ПараметрыСеанса.упоВалютаУправленческогоУчета;
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ДанныеПланаБДР.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Валюта = ВалютаУправленческогоУчета;
		КонецЦикла;				
	КонецЕсли;	
	// Трансляция объемов.
	Если НЕ Результат[ИндексКрайнего].Пустой() Тогда
		Выборка = Результат[ИндексКрайнего].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПланаБДР.Добавить(), Выборка);
		КонецЦикла;				
	КонецЕсли;
			
	Возврат ДанныеПланаБДР;

