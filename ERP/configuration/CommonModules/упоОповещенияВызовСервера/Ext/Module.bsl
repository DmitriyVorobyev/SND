////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции работы с оповещениями.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область НачальноеЗаполнение

// Заполняет предопределенные данные оповещений.
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция ЗаполнитьПредопределенныеДанныеОповещений(Параметры = Неопределено) Экспорт
	
	// Транспорт ЭП.
	
	Email = Справочники.упоТранспортОповещений.Email.ПолучитьОбъект();		
	Email.ДоступнаТемаСообщения = Истина;	
	Email.ДоступенТекстСообщенияВHTML = Истина;
	Email.ДоступнаНастройкаДляВидаСобытия = Ложь;	
	Email.ИмяМодуляОтправкиСообщений = "упоОтправкаСообщенийПоEmail";
	ПараметрыEmail = Email.Параметры.Получить();
	Если ТипЗнч(ПараметрыEmail) <> Тип("Структура") ИЛИ ПараметрыEmail.Количество() = 0 Тогда
		НастройкиТранспорта = упоОтправкаСообщенийПоEmail.ПолучитьНастройкиТранспорта().ПараметрыТранспорта;
		Email.Параметры =  Новый ХранилищеЗначения(НастройкиТранспорта);
	КонецЕсли;
	Email.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	Email.Записать();
	
	// Транспорт СМС.
	
	SMS = Справочники.упоТранспортОповещений.SMS.ПолучитьОбъект();		
	SMS.ДоступнаТемаСообщения = Ложь;	
	SMS.ДоступенТекстСообщенияВHTML = Ложь;
	SMS.ДоступнаНастройкаДляВидаСобытия = Ложь;
	SMS.ИмяМодуляОтправкиСообщений = "упоОтправкаСообщенийПоSMS";
	ПараметрыSMS = SMS.Параметры.Получить();
	Если ТипЗнч(ПараметрыSMS) <> Тип("Структура") ИЛИ ПараметрыSMS.Количество() = 0 Тогда
		НастройкиТранспорта = упоОтправкаСообщенийПоSMS.ПолучитьНастройкиТранспорта().ПараметрыТранспорта;
		SMS.Параметры =  Новый ХранилищеЗначения(НастройкиТранспорта);
	КонецЕсли;
	SMS.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	SMS.Записать();
	
	// Транспорт Задания.
	
	Задания = Справочники.упоТранспортОповещений.Задания.ПолучитьОбъект();		
	Задания.ДоступнаТемаСообщения = Истина;	
	Задания.ДоступенТекстСообщенияВHTML = Ложь;
	Задания.ДоступнаНастройкаДляВидаСобытия = Истина;
	Задания.ИмяМодуляОтправкиСообщений = "упоОтправкаСообщенийЧерезЗадания";
	ПараметрыЗадания = Задания.Параметры.Получить();
	Если ТипЗнч(ПараметрыЗадания) <> Тип("Структура") ИЛИ ПараметрыЗадания.Количество() = 0 Тогда
		НастройкиТранспорта = упоОтправкаСообщенийЧерезЗадания.ПолучитьНастройкиТранспорта().ПараметрыТранспорта;
		Задания.Параметры =  Новый ХранилищеЗначения(НастройкиТранспорта);
	КонецЕсли;
	Задания.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	Задания.Записать();
	
	// Вид получателя - Пользователи.
	
	обПользователи = Справочники.упоВидыПолучателейОповещений.Пользователи.ПолучитьОбъект();	
	обПользователи.ТаблицаПолучателя = "Справочник.Пользователи";
	обПользователи.АдресаОтправки.Очистить();
	
	// Транспорт для пользователей - СМС.
	
	ТранспортSMS = обПользователи.АдресаОтправки.Добавить();	
	ТранспортSMS.Транспорт = Справочники.упоТранспортОповещений.SMS;
	ТранспортSMS.ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВКонтИнформацииПолучателя;
	ТранспортSMS.ПолеАдреса = "Справочник.Пользователи.Контактная информация.НомерТелефона";
	
	ПолеАдресаСтрукт = Новый Структура;
	ПолеАдресаСтрукт.Вставить("ПолеАдреса", "НомерТелефона");
	ПолеАдресаСтрукт.Вставить("ИмяТаблицы", "Справочник.Пользователи.КонтактнаяИнформация");
	ПолеАдресаСтрукт.Вставить("ПолеУсловия", "Вид");
	ПолеАдресаСтрукт.Вставить("ЗначениеУсловия", Справочники.ВидыКонтактнойИнформации.ТелефонПользователя);
	ПолеАдресаСтрукт.Вставить("ПолеСвязи", "Ссылка");
	ПолеАдресаСтрукт.Вставить("ОписаниеХраненияАдреса", НСтр("ru = 'Номер телефона пользователя'"));
	
	ТранспортSMS.ПолеАдресаХЗ = Новый ХранилищеЗначения(ПолеАдресаСтрукт);
	ТранспортSMS.ОписаниеХраненияАдреса = ПолеАдресаСтрукт.ОписаниеХраненияАдреса;	
	
	// Транспорт для пользователей - ЭП.
	
	ТранспортEMAIL = обПользователи.АдресаОтправки.Добавить();	
	ТранспортEMAIL.Транспорт = Справочники.упоТранспортОповещений.Email;
	ТранспортEMAIL.ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВКонтИнформацииПолучателя;
	ТранспортEMAIL.ПолеАдреса = "Справочник.Пользователи.Контактная информация.Адрес ЭП";
	
	ПолеАдресаСтрукт = Новый Структура;
	ПолеАдресаСтрукт.Вставить("ПолеАдреса", "АдресЭП");
	ПолеАдресаСтрукт.Вставить("ИмяТаблицы", "Справочник.Пользователи.КонтактнаяИнформация");
	ПолеАдресаСтрукт.Вставить("ПолеУсловия", "Вид");
	ПолеАдресаСтрукт.Вставить("ЗначениеУсловия", Справочники.ВидыКонтактнойИнформации.EmailПользователя);	
	ПолеАдресаСтрукт.Вставить("ПолеСвязи", "Ссылка");
	ПолеАдресаСтрукт.Вставить("ОписаниеХраненияАдреса", НСтр("ru = 'Электронная почта пользователя'"));
	
	ТранспортEMAIL.ПолеАдресаХЗ = Новый ХранилищеЗначения(ПолеАдресаСтрукт);
	ТранспортEMAIL.ОписаниеХраненияАдреса = ПолеАдресаСтрукт.ОписаниеХраненияАдреса;	
	
	// Транспорт для пользователей - Задания.
	
	ТранспортЗадания = обПользователи.АдресаОтправки.Добавить();	
	ТранспортЗадания.Транспорт = Справочники.упоТранспортОповещений.Задания;
	ТранспортЗадания.ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВПолучателе;
	ТранспортЗадания.ПолеАдреса = "упоОсновнойТрудовойРесурс";
	
	ТранспортЗадания.ОписаниеХраненияАдреса = НСтр("ru = 'Основной трудовой ресурс пользователя'");	
	
	// Транспорт для пользователей - Telegram.
	
	ТранспортTg = обПользователи.АдресаОтправки.Добавить();
	ТранспортTg.Транспорт = Справочники.упоТранспортОповещений.Telegram;
	ТранспортTg.ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВРегистреСоответствияИД;
	ТранспортTg.ПолеАдреса = "РегистрСведений.упоСоответствиеПользователейTelegram.ИД_ПользователяTelegram";
	
	ТранспортTg.ОписаниеХраненияАдреса = НСтр("ru = 'Идентификатор пользователя в Telegram'");
	
	//
	
	обПользователи.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	обПользователи.Записать();
	
	// Константа "Срок хранения оповещений".
	
	Если Константы.упоСрокХраненияОповещений.Получить() = Неопределено Тогда
		Константы.упоСрокХраненияОповещений.Установить(0);
	КонецЕсли;
	
	// Ограничения - Изменения статусов проектов.
	
	Объект = Справочники.упоОграниченияДоступаКОповещениям.ИзмененияСтатусовПроектов.ПолучитьОбъект();
	Объект.ВидПолучателяОповещений = Справочники.упоВидыПолучателейОповещений.Пользователи;
	Объект.Условие = Перечисления.упоУсловияОграниченияДоступаКОповещениям.ТолькоУказанные;
	Объект.Состав.Очистить();
	Объект.Состав.Добавить().Элемент = УправлениеДоступом.ГруппаДоступаАдминистраторы();
	Объект.Состав.Добавить().Элемент = Справочники.ГруппыДоступа.упоАдминистраторыПроектногоОфиса;
	Объект.Состав.Добавить().Элемент = Справочники.ГруппыДоступа.упоРуководителиПроектногоОфиса;
	Объект.Состав.Добавить().Элемент = Справочники.ГруппыДоступа.упоОповещения_ИзмененияСтатусовПроектов;
	Объект.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	Объект.Записать();
	
	// Правило "Новое задание".
	
	НовоеЗадание = Справочники.упоВидыСобытий.НовоеЗадание.ПолучитьОбъект();
	НовоеЗадание.Используется = Истина;
	НовоеЗадание.СпособОтслеживанияСобытия = Перечисления.упоСпособыОтслеживанияСобытий.ПриЗаписиОбъекта;
	НовоеЗадание.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ЗаписьОбъекта;
	НовоеЗадание.Источник = "Справочник.упоЗадания";
	НовоеЗадание.КоличествоПопытокОтправки = 0;
	НовоеЗадание.Комментарий = "";
	НовоеЗадание.ЛогикаПримененияУсловийРегистрацииСобытия = Перечисления.упоЛогическиеОператоры.НЕ;
	НовоеЗадание.Наименование =	НСтр("ru = 'Новое задание'");
	НовоеЗадание.НеРегистрироватьПовторно =	Истина;
	
	НовоеЗадание.Получатели.Очистить();
	Получатель = НовоеЗадание.Получатели.Добавить();
	Получатель.ВидПолучателя = Справочники.упоВидыПолучателейОповещений.Пользователи;
	Получатель.ДопУсловие = "МасПолучатели = Новый Массив;
                             |Если ЗначениеЗаполнено(Источник.Исполнитель) Тогда
                             |	МасПолучатели = упоОповещенияВызовСервера.ПолучитьДиспетчеровТрудовогоРесурсаПодписанныхНаСобытие(Источник, Источник.Исполнитель); 
                             |	Если МасПолучатели.Количество() Тогда
                             |		Результат = Истина;
                             |	КонецЕсли;
                             |КонецЕсли;";
							 
	НовоеЗадание.Тэги.Очистить();
	Тэг = НовоеЗадание.Тэги.Добавить();
	Тэг.Представление = "СправочникЗадания.ОписаниеЗадания";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.РеквизитОбъекта;
	Тэг.Условие = "Справочник.упоЗадания.ОписаниеЗадания";
	Тэг = НовоеЗадание.Тэги.Добавить();
	Тэг.Представление = "СправочникЗадания.Автор";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.РеквизитОбъекта;
	Тэг.Условие = "Справочник.упоЗадания.АвторСотрудник";
	Тэг = НовоеЗадание.Тэги.Добавить();
	Тэг.Представление = "НавигационнаяСсылка.Ссылка";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.НавигационнаяСсылка;
	Тэг.Условие = "Справочник.упоЗадания.Ссылка";
	
	
	НовоеЗадание.НеРегистрироватьПовторно =	Истина;
	НовоеЗадание.Принудительное	= Ложь;
	НовоеЗадание.СрокХраненияОповещений =	0;
	НовоеЗадание.СрокХраненияСобытий =	0;
	
	ДобавитьТранспортВПредопределенныйВидСобытия(НовоеЗадание);
			
	НовоеЗадание.ШаблонТекста =	НСтр("ru = 'Получено новое задание
                                 |Автор: [СправочникЗадания.Автор]
                                 |[СправочникЗадания.ОписаниеЗадания]'")
								 + Символы.ПС + Символы.ПС + "[НавигационнаяСсылка.Ссылка]";
								 
	ШаблонHTML = Новый ФорматированныйДокумент;		
	ШаблонHTML.Добавить(НовоеЗадание.ШаблонТекста);
	ТекстHTML = "";
	Влож = Неопределено;
	ШаблонHTML.ПолучитьHTML(ТекстHTML, Влож);
	НовоеЗадание.ШаблонТекстаHTML = ТекстHTML;		
	НовоеЗадание.ШаблонТемы	= НСтр("ru = 'Новое задание'");
	НовоеЗадание.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	НовоеЗадание.Записать();
	
	// Назначение на ПЗ
	
	Оповещение = Справочники.упоВидыСобытий.НазначениеНаПЗ.ПолучитьОбъект();
	Оповещение.Используется = Истина;
	Оповещение.СпособОтслеживанияСобытия = Перечисления.упоСпособыОтслеживанияСобытий.ПриЗаписиОбъекта;
	Оповещение.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.Проведение;
	Оповещение.Источник = "Документ.упоНазначениеТрудовыхРесурсовНаПроектнуюЗадачу";
	Оповещение.КоличествоПопытокОтправки = 0;
	Оповещение.Комментарий = "";
	Оповещение.ЛогикаПримененияУсловийРегистрацииСобытия = Перечисления.упоЛогическиеОператоры.НЕ;
	Оповещение.Наименование = НСтр("ru = 'Назначение на проектную задачу'");
	Оповещение.НеРегистрироватьПовторно =	Истина;
	Оповещение.КодОпределенияДопПараметра = "ИсточникДопПараметр = Источник.ВыделяемыеРесурсы.Выгрузить().ВыгрузитьКолонку(""Ресурс"");";
	
	Оповещение.Получатели.Очистить();
	Получатель = Оповещение.Получатели.Добавить();
	Получатель.ВидПолучателя = Справочники.упоВидыПолучателейОповещений.Пользователи;
	Получатель.ДопУсловие = "МасПолучатели = упоОповещенияВызовСервера.ПолучитьДиспетчеровТрудовогоРесурсаПодписанныхНаСобытие(Источник, ИсточникДопПараметр); Результат = Истина;";
							 
	Оповещение.Тэги.Очистить();
	Тэг = Оповещение.Тэги.Добавить();
	Тэг.Представление = "ПроектнаяЗадача";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.ВыполняемыйКод;
	Тэг.Условие = "Результат = упоПроектыИЗадачиВызовСервера.обПолучитьНазваниеПроектнойЗадачи(Источник.ПроектнаяЗадача);";
	Тэг = Оповещение.Тэги.Добавить();
	Тэг.Представление = "НавигационнаяСсылка";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.НавигационнаяСсылка;
	Тэг.Условие = "Ссылка";
	Тэг = Оповещение.Тэги.Добавить();
	Тэг.Представление = "ТрудовойРесурс";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.ВыполняемыйКод;
	Тэг.Условие = "Результат = """" + ИсточникДопПараметр;";	
	Тэг = Оповещение.Тэги.Добавить();
	Тэг.Представление = "Проект";
	Тэг.ТипТэга	= Перечисления.упоТипыТегов.ВыполняемыйКод;
	Тэг.Условие = "Результат = """" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.ПроектнаяЗадача, ""Проект"");";		
	
	Оповещение.НеРегистрироватьПовторно =	Истина;
	Оповещение.Принудительное	= Ложь;
	Оповещение.СрокХраненияОповещений =	0;
	Оповещение.СрокХраненияСобытий =	0;
	
	ДобавитьТранспортВПредопределенныйВидСобытия(Оповещение);
		
	Оповещение.ШаблонТекста =	НСтр("ru = 'Трудовой ресурс ""[ТрудовойРесурс]"" назначен на  	
                                 |проектную задачу ""[ПроектнаяЗадача]"" проекта ""[Проект]"".'")
								 + Символы.ПС + Символы.ПС + "[НавигационнаяСсылка]";
								 
	ШаблонHTML = Новый ФорматированныйДокумент;		
	ШаблонHTML.Добавить(Оповещение.ШаблонТекста);
	ТекстHTML = "";
	Влож = Неопределено;
	ШаблонHTML.ПолучитьHTML(ТекстHTML, Влож);
	Оповещение.ШаблонТекстаHTML = ТекстHTML;		
	Оповещение.ШаблонТемы = НСтр("ru = 'Назначение на проектную задачу'");
	Оповещение.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	Оповещение.Записать();	
	
	// Правила изменения статусов проектов.
	
	ТаблицаПравил = Новый ТаблицаЗначений;
	ТаблицаПравил.Колонки.Добавить("ВидСобытия");
	ТаблицаПравил.Колонки.Добавить("Источник");
	ТаблицаПравил.Колонки.Добавить("Наименование");
	ТаблицаПравил.Колонки.Добавить("Тэги");
	ТаблицаПравил.Колонки.Добавить("ШаблонТекста");
	ТаблицаПравил.Колонки.Добавить("ШаблонТемы");
	
	// Правило "Регистрация проекта".
	
	СтрокаПравил = ТаблицаПравил.Добавить();
	СтрокаПравил.ВидСобытия = "РегистрацияПроекта";
	СтрокаПравил.Источник = "Документ.упоРегистрацияПроекта";
	СтрокаПравил.Наименование = НСтр("ru = 'Регистрация проекта'");
	МассивТэгов = Новый Массив;
	СтруктураТэга = Новый Структура;
	СтруктураТэга.Вставить("Представление", "ДокументРегистрацияпроекта.Проект");
