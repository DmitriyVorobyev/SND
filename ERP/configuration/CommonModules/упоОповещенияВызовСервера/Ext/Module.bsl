//
// Параметры:
//  Источник - Произвольный	 - не используется.
//  Отказ	 - Произвольный	 - не используется.
//
Процедура упоОповещенияПриЗаписиДокумента(Источник, Отказ) Экспорт
	
	
	
КонецПроцедуры

// Отработка регламентного задания.
//
// Параметры:
//  ВидСобытия	 - СправочникСсылка.упоВидыСобытий
//
Процедура упоОбработкаПроизошедшихСобытийСПараметрами(ВидСобытия = Неопределено) Экспорт
	
	Если НЕ упоОповещенияПовтИсп.ИспользоватьОповещения() Тогда
		Возврат;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	КэшПолучателей = Новый Соответствие;
	ТранспортПолучателей = Новый Соответствие;
	НедоступныеТранспортыОтправкиОповещений = НедоступныеТранспортыОтправкиОповещенийПроверкаИТС();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Ссылка КАК ВидПолучателя,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Транспорт КАК Транспорт
	               |ИЗ
	               |	Справочник.упоВидыПолучателейОповещений.АдресаОтправки КАК упоВидыПолучателейОповещенийАдресаОтправки
	               |ГДЕ
	               |	НЕ упоВидыПолучателейОповещенийАдресаОтправки.Транспорт.Ссылка В (&НедоступныеТранспортыОтправкиОповещений)
	               |	И НЕ упоВидыПолучателейОповещенийАдресаОтправки.Транспорт.ПометкаУдаления
	               |	И НЕ упоВидыПолучателейОповещенийАдресаОтправки.Ссылка.ПометкаУдаления
	               |ИТОГИ ПО
	               |	ВидПолучателя";
	Запрос.УстановитьПараметр("НедоступныеТранспортыОтправкиОповещений", НедоступныеТранспортыОтправкиОповещений);
	ВыборкаВиды = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВиды.Следующий() Цикл
		ТранспортПолучателей.Вставить(ВыборкаВиды.ВидПолучателя, Новый Массив);
		Выборка = ВыборкаВиды.Выбрать();
		Пока Выборка.Следующий() Цикл
			текМассив = ТранспортПолучателей.Получить(ВыборкаВиды.ВидПолучателя);
			текМассив.Добавить(Выборка.Транспорт);
		КонецЦикла;
	КонецЦикла;
	
 	ДопПараметры = Новый Структура("Отправить,СообщениеОбОшибках,УИсобытия,Автор",Ложь,"");
	
	Пока Истина Цикл // В цикле получаем порциями по 100 необработанные события, пока есть что обрабатывать.
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ВидСобытия", ВидСобытия);
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
			|	ПроизошедшиеСобытия.Автор КАК Автор,
			|	ПроизошедшиеСобытия.ВидСобытия КАК ВидСобытия,
			|	ПроизошедшиеСобытия.Дата КАК Дата,
			|	ПроизошедшиеСобытия.Источник КАК Источник,
			|	ПроизошедшиеСобытия.ИсточникДопПараметр КАК ИсточникДопПараметр,
			|	ПроизошедшиеСобытия.КонтекстСобытия КАК КонтекстСобытия,
			|	ПроизошедшиеСобытия.Ссылка КАК Ссылка,
			|	ПроизошедшиеСобытия.КоличествоПопытокОбработки КАК КоличествоПопытокОбработки,
			|	ПроизошедшиеСобытия.ПометкаУдаления КАК ПометкаУдаления,
			|	ПроизошедшиеСобытия.ВидСобытия.СрокХраненияСобытий КАК СрокХраненияСобытий,
			|	ПроизошедшиеСобытия.ВидСобытия.Принудительное КАК Принудительное
			|ИЗ
			|	Справочник.упоПроизошедшиеСобытия КАК ПроизошедшиеСобытия
			|ГДЕ
			|	ПроизошедшиеСобытия.Обработано = ЛОЖЬ
			|	И ПроизошедшиеСобытия.КоличествоПопытокОбработки < 3
			|	И НЕ ПроизошедшиеСобытия.ПометкаУдаления
			|	И (&ВидСобытия = НЕОПРЕДЕЛЕНО
			|			ИЛИ ПроизошедшиеСобытия.ВидСобытия = &ВидСобытия)
			|
			|УПОРЯДОЧИТЬ ПО
			|	ПроизошедшиеСобытия.Дата";
					   
		Таблица = Запрос.Выполнить().Выгрузить();	
		Если Таблица.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;	
		
		Для Каждого Строка Из Таблица Цикл
			
			Событие_УИД = Строка.Ссылка.УникальныйИдентификатор();
			
			ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(Строка.ВидСобытия);
			
			ТаблицаПолучателей = ПолучитьТаблицуПолучателейДляПроизошедшегоСобытия(Строка.ВидСобытия, Строка.Источник, 
																						Строка.ИсточникДопПараметр, КэшПолучателей,
																						ПараметрыВыполненияКода);
			
			ДопПараметры.СообщениеОбОшибках = "";
			ДопПараметры.УИсобытия = Событие_УИД;
			ДопПараметры.Автор = Строка.Автор;			
			
			НачатьТранзакцию();			
			
			Попытка
				
				Для Каждого ДанныеПолучателя Из ТаблицаПолучателей Цикл
					
					ТранспортПолучателя = ТранспортПолучателей.Получить(ДанныеПолучателя.ВидПолучателя);
					Если ТранспортПолучателя.Найти(ДанныеПолучателя.Транспорт) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ДобавитьСообщение(Строка.ВидСобытия,
					Строка.Источник,
					Строка.ИсточникДопПараметр,
					ДанныеПолучателя.ВидПолучателя,
					ДанныеПолучателя.Получатель,
					ДанныеПолучателя.Транспорт,
					ДопПараметры,
					ПараметрыВыполненияКода);															
					
				КонецЦикла;	
				
				Объект = Строка.Ссылка.ПолучитьОбъект();
				Объект.Обработано = Истина;
				Объект.Записать();
				
				ЗафиксироватьТранзакцию();			
				
			Исключение
				
				ОтменитьТранзакцию();
				
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(НСтр("ru='Обработка событий'"), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.упоПроизошедшиеСобытия, Строка.Ссылка, СообщениеОбОшибке);
				
				Попытка
					СобытиеОбъект = Строка.Ссылка.ПолучитьОбъект();
					СобытиеОбъект.КоличествоПопытокОбработки = СобытиеОбъект.КоличествоПопытокОбработки + 1;
					СобытиеОбъект.Ошибка = СообщениеОбОшибке; 
					СобытиеОбъект.Записать();
				Исключение 
					СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации(НСтр("ru='Обработка событий'"), УровеньЖурналаРегистрации.Ошибка, 
					Метаданные.Справочники.упоПроизошедшиеСобытия, Строка.Ссылка, СообщениеОбОшибке);
				КонецПопытки;	
				
			КонецПопытки;
			
			Если Не ПустаяСтрока(ДопПараметры.СообщениеОбОшибках) Тогда
				ЗаписьЖурналаРегистрации(НСтр("ru='Обработка событий'"), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.упоПроизошедшиеСобытия, Строка.Ссылка, ДопПараметры.СообщениеОбОшибках);	
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;		
		
	// Удаление уже обработанных бизнес-событий.
	
	// СрокХраненияБизнесСобытий - измеряется в днях.
	СрокХраненияСобытий = Константы.упоСрокХраненияСобытий.Получить(); 
	
	// СрокХраненияБизнесСобытий умножаем на 86400 (сек в сутках) и делим на 10
	// - т.к. с периодом в 1/10 срока хранения делаем очистку.
	ПериодОчистки = СрокХраненияСобытий * 86400 / 10;
	
	ДатаПоследнейОчисткиСобытий = Константы.упоДатаПоследнейОчисткиСобытий.Получить();
	
	НужнаОчистка = Ложь;
	Если ДатаПоследнейОчисткиСобытий = Дата("00010101000000") Тогда
		НужнаОчистка = Истина;
	Иначе
		Если ТекущаяДата() - ДатаПоследнейОчисткиСобытий > ПериодОчистки Тогда
			НужнаОчистка = Истина;
		КонецЕсли;		
	КонецЕсли;	
	
	Если НужнаОчистка Тогда
		
		// СрокХраненияБизнесСобытий умножаем на 86400 (сек в сутках).
		ДатаОтсечения = ТекущаяДата() - СрокХраненияСобытий * 86400; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоПроизошедшиеСобытия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.упоПроизошедшиеСобытия КАК упоПроизошедшиеСобытия
		|ГДЕ
		|	(упоПроизошедшиеСобытия.Обработано = ИСТИНА
		|	И упоПроизошедшиеСобытия.Дата < &ДатаОтсечения) ИЛИ упоПроизошедшиеСобытия.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	упоПроизошедшиеСобытия.Дата";
		
		Запрос.УстановитьПараметр("ДатаОтсечения", ДатаОтсечения);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка);
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.Удалить();
			РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
		КонецЦикла;
		
		Константы.упоДатаПоследнейОчисткиСобытий.Установить(ТекущаяДата());
		
	КонецЕсли;
	
	//
	
	РегЗаданиеРассылки = РегламентныеЗаданияСервер.ПолучитьРегламентноеЗадание(Метаданные.РегламентныеЗадания.упоОтправкаСообщенийИзОчереди);
	РегламентныеЗаданияСлужебный.ВыполнитьРегламентноеЗаданиеВручную(РегЗаданиеРассылки);	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ДобавитьПараметрыВыбораПроектныхЗадачИПроекта(Источник, ЭлементИсточникСсылка) Экспорт

	Если Источник = "Справочник.Проекты" Тогда
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Новый ПараметрВыбора("ВыбиратьЗадачиИПроекты", Истина));
		МассивПараметров.Добавить(Новый ПараметрВыбора("РежимВыбора", Истина));
		ЭлементИсточникСсылка.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);				
	КонецЕсли;	

КонецПроцедуры

Функция НедоступныеТранспортыОтправкиОповещенийПроверкаИТС() Экспорт
	
	НедоступныеТранспорты = Новый Массив;
	
	ДанныеПроверкиДоговораСопровождения = упоФункцииЗащитыСервер.ДанныеПроверкиДоговораСопровождения();
	Если ДанныеПроверкиДоговораСопровождения.УсловияДоговораСопровожденияВыполнены Тогда
		Возврат НедоступныеТранспорты;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   упоТранспортОповещений.Ссылка КАК Ссылка
		|ИЗ
		|   Справочник.упоТранспортОповещений КАК упоТранспортОповещений
		|ГДЕ
		|   упоТранспортОповещений.ИмяМодуляОтправкиСообщений ПОДОБНО &ИмяМодуляОтправкиСообщений";
	
	Запрос.УстановитьПараметр("ИмяМодуляОтправкиСообщений", "упоОтправкаСообщенийПоTelegram");
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НедоступныеТранспорты.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат НедоступныеТранспорты;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область НачальноеЗаполнение

Функция ДобавитьТранспортВПредопределенныйВидСобытия(ВидСобытияОбъект)
	
	ТекущееСостояние = ВидСобытияОбъект.ТранспортОповещений.Выгрузить();
	
	ИспользованиеТранспортаПоУмолчанию = ИспользованиеТранспортаПоУмолчанию();
	
	Для Каждого КлючЗначение Из ИспользованиеТранспортаПоУмолчанию Цикл
		
		Если ТекущееСостояние.Найти(КлючЗначение.Ключ, "Транспорт")= Неопределено Тогда
			Транспорт = ВидСобытияОбъект.ТранспортОповещений.Добавить();
			Транспорт.Используется = КлючЗначение.Значение;
			Транспорт.Транспорт = КлючЗначение.Ключ;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции 

Функция ИспользованиеТранспортаПоУмолчанию()
	
	ИспользованиеТранспортаПоУмолчанию = Новый Соответствие;
	ИспользованиеТранспортаПоУмолчанию.Вставить(Справочники.упоТранспортОповещений.SMS, 		Ложь);
	ИспользованиеТранспортаПоУмолчанию.Вставить(Справочники.упоТранспортОповещений.Email, 		Истина);
	ИспользованиеТранспортаПоУмолчанию.Вставить(Справочники.упоТранспортОповещений.Задания, 	Ложь);
	ИспользованиеТранспортаПоУмолчанию.Вставить(Справочники.упоТранспортОповещений.Telegram, 	Ложь);
	
	Возврат ИспользованиеТранспортаПоУмолчанию;
	
КонецФункции

#КонецОбласти

Функция ОбработкаСобытияДопустима(Источник) 
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Результат = Ложь;
	ИначеЕсли Не упоОповещенияПовтИсп.ИспользоватьОповещения() Тогда
		Результат = Ложь;
	ИначеЕсли Источник.ДополнительныеСвойства.Свойство("упоИгнорироватьОповещения") 
	И Источник.ДополнительныеСвойства.упоИгнорироватьОповещения Тогда 
	 	Результат = Ложь;
	Иначе		
		Результат = Истина;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Процедура ОпределитьВариантИзмененияПередЗаписью(Источник, масВариантыИзменения, пРежимЗаписиДокумента = Неопределено)
	
	Если РежимЗаписиДокумента <> Неопределено Тогда
		
		Если пРежимЗаписиДокумента = РежимЗаписиДокумента.Проведение Тогда
			
			масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.Проведение);
			Если Источник.Ссылка.Пустая() Тогда
				масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ПроведениеНового);			
			Иначе
				масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.Перепроведение);	
			КонецЕсли;
			
		ИначеЕсли пРежимЗаписиДокумента = РежимЗаписиДокумента.ОтменаПроведения Тогда
			
			масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ОтменаПроведения);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПометкаУдаленияДоЗаписи = (НЕ Источник.Ссылка.Пустая()) 
							  И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПометкаУдаления");
	
	Если Источник.ПометкаУдаления И НЕ ПометкаУдаленияДоЗаписи Тогда
		масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ПометкаОбъектаНаУдаление);
	ИначеЕсли НЕ Источник.ПометкаУдаления И ПометкаУдаленияДоЗаписи Тогда
		масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.СнятиеПометкиНаУдалениеСОбъекта);	
	Иначе
		масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьОбъекта);	
		Если Источник.Ссылка.Пустая() Тогда
			масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьНовогоОбъекта);			
		Иначе
			масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьСуществующегоОбъекта);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьВариантИзмененияПередЗаписьюВРегистр(Источник, масВариантыИзменения)
	
	масВариантыИзменения.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьВРегистр);
	
КонецПроцедуры

Процедура ЗарегистрироватьСобытияПриЗаписи(ОбъектИсточник)
	
	УстановитьПривилегированныйРежим(Истина);

	ЭтоРегистр = ОбъектИсточник.ДополнительныеСвойства.Свойство("ЭтоРегистр") И ОбъектИсточник.ДополнительныеСвойства.ЭтоРегистр;
	
	соотвВидыСобытий = Неопределено;
	Если ОбъектИсточник.ДополнительныеСвойства.Свойство("упоВидыСобытий", соотвВидыСобытий) Тогда
		соотвУсловияСобытий = ОбъектИсточник.ДополнительныеСвойства.упоУсловияСобытий;
		Для Каждого Эл Из соотвВидыСобытий Цикл
			
			ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(Эл.Ключ);
			КодОпределенияДопПараметра = ОбъектИсточник.ДополнительныеСвойства.упоКодОпределенияДопПараметров.Получить(Эл.Ключ); 
						
			УсловияСобытия = соотвУсловияСобытий.Получить(Эл.Ключ); 
			
			МассивДопПараметровИсточника = ПолучитьМассивДопПараметровИсточника(Эл.Ключ, КодОпределенияДопПараметра, ОбъектИсточник, 
																											ПараметрыВыполненияКода);
																											
			Для Каждого ИсточникДопПараметр Из МассивДопПараметровИсточника Цикл																								
																											
				Если ПроверитьУсловияРегистрацииСобытияДляОбъекта(ОбъектИсточник, ИсточникДопПараметр, Эл.Ключ, Эл.Значение.ПолноеИмяОбъекта, 
																		Эл.Значение.ЛогикаПримененияУсловий, УсловияСобытия, 
																			ОбъектИсточник.ДополнительныеСвойства, ПараметрыВыполненияКода) Тогда
					
					Если ЭтоРегистр Тогда
						Справочники.упоПроизошедшиеСобытия.ЗарегистрироватьСобытие(Эл.Ключ,, ИсточникДопПараметр, Эл.Значение.ПолноеИмяОбъекта);
					Иначе
						Справочники.упоПроизошедшиеСобытия.ЗарегистрироватьСобытие(Эл.Ключ, ОбъектИсточник.Ссылка, ИсточникДопПараметр);	
					КонецЕсли;
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ВычислитьАдресПолучателя(Получатель, ТаблицаПолучателя, ВидПолучателя, ВариантХраненияПоляАдреса, ПолеАдреса,
	ПолеАдресаХЗ, СообщениеОбОшибках = "")
	
	ТекАдрес = "";
	
	Если ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВПолучателе Тогда
		
		Попытка
			ТекАдрес = Получатель[ПолеАдреса];
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление адреса получателя'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыПолучателейОповещений, ВидПолучателя, СообщениеОбОшибке);
			СообщениеОбОшибках = СообщениеОбОшибках + СообщениеОбОшибке + Символы.ПС;
			ТекАдрес = "";	
		КонецПопытки;
		
	ИначеЕсли ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВКонтИнформацииПолучателя Тогда
		
		ПолеАдресаПараметры = ПолеАдресаХЗ.Получить();
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтИнфо.Адрес КАК Адрес
			|ИЗ
			|	Справочник.Пользователи КАК ТаблицаПолучателя
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтИнфо КАК КонтИнфо
			|		ПО ТаблицаПолучателя.Ссылка = КонтИнфо.Объект
			|ГДЕ
			|	ИСТИНА
			|	И ТаблицаПолучателя.Ссылка = &Получатель
			|	И КонтИнфо.ВидКонтИнфо = &ЗначениеУсловия";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,".Адрес","."+ПолеАдресаПараметры.ПолеАдреса);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Справочник.Пользователи",ТаблицаПолучателя);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РегистрСведений.КонтИнфо",ПолеАдресаПараметры.ИмяТаблицы);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"КонтИнфо.Объект","КонтИнфо." + ПолеАдресаПараметры.ПолеСвязи);
		Если ПолеАдресаПараметры.Свойство("ПолеУсловия") И ЗначениеЗаполнено(ПолеАдресаПараметры.ПолеУсловия) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"КонтИнфо.ВидКонтИнфо","КонтИнфо." + ПолеАдресаПараметры.ПолеУсловия);
			Запрос.УстановитьПараметр("ЗначениеУсловия",ПолеАдресаПараметры.ЗначениеУсловия);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"И КонтИнфо.ВидКонтИнфо = &ЗначениеУсловия","");
		КонецЕсли;
		Запрос.УстановитьПараметр("Получатель",Получатель);
		Запрос.Текст = ТекстЗапроса;
		
		Попытка 
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекАдрес = Выборка.Адрес;	
			КонецЕсли;
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление адреса получателя'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыПолучателейОповещений, ВидПолучателя, СообщениеОбОшибке);
			СообщениеОбОшибках = СообщениеОбОшибках + СообщениеОбОшибке + Символы.ПС;
			ТекАдрес = "";	
		КонецПопытки;
		
	ИначеЕсли ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВКонтИнформацииКонтЛицаПолучателя Тогда	
		
		ПолеАдресаПараметры = ПолеАдресаХЗ.Получить();
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КонтИнфо.Адрес КАК Адрес
			|ИЗ
			|	Справочник.Пользователи КАК ТаблицаПолучателя
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтЛица КАК КонтЛица
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтИнфо КАК КонтИнфо
			|			ПО КонтЛица.Ссылка = КонтИнфо.Объект
			|		ПО ТаблицаПолучателя.Ссылка = КонтЛица.Объект
			|ГДЕ
			|	ИСТИНА
			|	И ТаблицаПолучателя.Ссылка = &Получатель
			|	И КонтЛица.ПометкаУдаления = &ЗначениеУсловияКонтЛицо
			|	И КонтИнфо.ВидКонтИнфо = &ЗначениеУсловия";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,".Адрес","."+ПолеАдресаПараметры.ПолеАдреса);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Справочник.Пользователи",ТаблицаПолучателя);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"РегистрСведений.КонтИнфо",ПолеАдресаПараметры.ИмяТаблицы);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"КонтИнфо.Объект","КонтИнфо." + ПолеАдресаПараметры.ПолеСвязи);
		Если ПолеАдресаПараметры.Свойство("ПолеУсловия") И ЗначениеЗаполнено(ПолеАдресаПараметры.ПолеУсловия) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"КонтИнфо.ВидКонтИнфо","КонтИнфо." + ПолеАдресаПараметры.ПолеУсловия);
			Запрос.УстановитьПараметр("ЗначениеУсловия",ПолеАдресаПараметры.ЗначениеУсловия);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"И КонтИнфо.ВидКонтИнфо = &ЗначениеУсловия","");
		КонецЕсли;
		Запрос.УстановитьПараметр("Получатель",Получатель);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Справочник.КонтЛица",ПолеАдресаПараметры.ИмяТаблицыКонтЛицо);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"КонтЛица.Объект","КонтЛица." + ПолеАдресаПараметры.ПолеСвязиКонтЛицо);
		Если ПолеАдресаПараметры.Свойство("ПолеУсловияКонтЛицо") И ЗначениеЗаполнено(ПолеАдресаПараметры.ПолеУсловияКонтЛицо) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"КонтЛица.ПометкаУдаления","КонтИнфо." + ПолеАдресаПараметры.ПолеУсловияКонтЛицо);
			Запрос.УстановитьПараметр("ЗначениеУсловияКонтЛицо",ПолеАдресаПараметры.ЗначениеУсловияКонтЛицо);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"И КонтЛица.ПометкаУдаления = &ЗначениеУсловияКонтЛицо","");
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		
		Попытка 
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекАдрес = Выборка.Адрес;	
			КонецЕсли;
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление адреса получателя'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыПолучателейОповещений, ВидПолучателя, СообщениеОбОшибке);
			СообщениеОбОшибках = СообщениеОбОшибках + СообщениеОбОшибке + Символы.ПС;
			ТекАдрес = "";	
		КонецПопытки;
		
	ИначеЕсли ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВРегистреСоответствияИД Тогда
		
		ТекАдрес = упоРаботаCTelegram.ИД_ПользователяTelegramПоПользователю1С(Получатель);		
		
	КонецЕсли;
	
	Возврат ТекАдрес;
	
КонецФункции

Процедура ДобавитьВидыСобытийВДопСвойстваОбъекта(Источник, масВариантыИзменения)
	
	ПолноеИмя = Источник.Метаданные().ПолноеИмя();

	СтруктураВариантыИзменения = Новый Структура;
	сч = 1;
	Для Каждого ВариантИзменения Из масВариантыИзменения Цикл
		СтруктураВариантыИзменения.Вставить("п"+сч, ВариантИзменения);	
		сч = сч + 1;
	КонецЦикла;
	
	ВидыСобытийДанные = упоОповещенияПовтИсп.ПолучитьВидыСобытийВДопСвойстваОбъекта(ПолноеИмя, СтруктураВариантыИзменения);
		
	Если ВидыСобытийДанные.упоВидыСобытий.Количество() > 0 Тогда
		Источник.ДополнительныеСвойства.Вставить("упоВидыСобытий", ВидыСобытийДанные.упоВидыСобытий);
		Источник.ДополнительныеСвойства.Вставить("упоКодОпределенияДопПараметров", ВидыСобытийДанные.упоКодОпределенияДопПараметров);
		Источник.ДополнительныеСвойства.Вставить("упоУсловияСобытий", ВидыСобытийДанные.упоУсловияСобытий);	
		Если ВидыСобытийДанные.НужныПредЗначения Тогда
			Источник.ДополнительныеСвойства.Вставить("упоДанныеДоИзменения", ПолучитьДанныеОбъектаПоСсылке(Источник.Ссылка));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеОбъектаПоСсылке(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ * ИЗ "+Ссылка.Метаданные().ПолноеИмя() + " КАК Таблица 
	| ГДЕ Таблица.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Если Таблица.Количество() Тогда
		Результат = Новый Структура;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Результат.Вставить(Колонка.Имя);
		КонецЦикла;		
		ЗаполнитьЗначенияСвойств(Результат, Таблица[0]);
		Возврат Результат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

Функция ПроверитьУсловияРегистрацииСобытияДляОбъекта(ИсточникСсылкаОбъект, ИсточникДопПараметр, ВидСобытия, ПолноеИмяОбъекта,
	ЛогикаПримененияУсловий, УсловияСобытия, ДополнительныеСвойства = Неопределено, ПараметрыВыполненияКода = Неопределено)
	
	Если УсловияСобытия.Количество() = 0 Тогда
		// Уловий нет, событие регистрируется в любом случае.
		Возврат Истина;
	КонецЕсли;
	
	Если ПараметрыВыполненияКода = Неопределено Тогда
		ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(ВидСобытия);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Таб.Ссылка
					|ИЗ
					|	Справочник.Пользователи КАК Таб
					|ГДЕ
					|	Таб.Ссылка = &Ссылка";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Справочник.Пользователи", ПолноеИмяОбъекта);
	
	УсловиеЗапроса = "";
	ТекстСоединений = "";
	Если ЛогикаПримененияУсловий = Перечисления.упоЛогическиеОператоры.И Тогда
		ОператорОбъединения = " и ";
	Иначе
		ОператорОбъединения = " или ";
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Массив;
	Ключи = "Имя,Значение,ЭтоПодобно";
	РезультатыУсловий = Новый Массив;
	
	Попытка
		ИсточникСсылка = ИсточникСсылкаОбъект.Ссылка;
		ОбъектИмеетСсылку = Истина;
	Исключение
		ИсточникСсылка = Неопределено;
		ОбъектИмеетСсылку = Ложь;
	КонецПопытки;;
	
	СчУсловийЗапроса = 0;
	СчИспКода = 0;
	Для Каждого Эл Из УсловияСобытия Цикл
		
		Если Эл.ПроверкаПоКоду Тогда
			
			СчИспКода = СчИспКода + 1;
			
			Результат = Ложь; 
			ПараметрыВозврата = Новый Структура;
			
			Если ДополнительныеСвойства <> Неопределено И ДополнительныеСвойства.Свойство("упоДанныеДоИзменения") Тогда
				ДанныеДоИзменения = ДополнительныеСвойства.упоДанныеДоИзменения;
			Иначе
				ДанныеДоИзменения = Неопределено;
			КонецЕсли;
			
			Попытка
				ВыполнитьКод(Эл.ВыполняемыйКод, Результат, ПараметрыВозврата, ИсточникСсылкаОбъект, 
											ИсточникДопПараметр, ДанныеДоИзменения, ПараметрыВыполненияКода);
			Исключение
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(НСтр("ru='Обработка условий регистрации событий'"), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
				Результат = Ложь;	
			КонецПопытки;
			
			ДобавитьРезультатаВыполненияУсловия(РезультатыУсловий,Результат);
			
		ИначеЕсли Лев(Эл.РеквизитОбъекта,12) = "Вычисляемый." Тогда
			
			Результат = ПроверитьВычисляемыйРеквизитНаУсловие(ПолноеИмяОбъекта,
																Сред(Эл.РеквизитОбъекта,13),
																ВидСобытия,
																Эл.ВидСравнения,
																Эл.ЗначениеУсловия.Получить(),
																ИсточникСсылкаОбъект,
																ИсточникДопПараметр,
																ПараметрыВыполненияКода);
																
			ДобавитьРезультатаВыполненияУсловия(РезультатыУсловий,Результат);
			
			Продолжить;
			
		ИначеЕсли ОбъектИмеетСсылку Тогда
			
			Если Найти(Эл.РеквизитОбъекта,ПолноеИмяОбъекта) = 0 И Найти(Эл.РеквизитОбъекта, "ДополнительныйРеквизит.") = 0 
				И Найти(Эл.РеквизитОбъекта, "ДополнительноеСведение.") = 0 Тогда
				Продолжить;
			КонецЕсли;
					
			СчУсловийЗапроса = СчУсловийЗапроса + 1;
			
			ПарСравнения = упоОповещенияПовтИсп.ПолучитьТекстВидаСравнения(Эл.ВидСравнения);
			ЗначениеУсловия = Эл.ЗначениеУсловия.Получить();
			
			ИмяПараметра = "Параметр" + Формат(СчУсловийЗапроса,"ЧГ=0");
			
			Если Лев(Эл.РеквизитОбъекта,23) = "ДополнительныйРеквизит." Тогда
				ИмяРеквизита = ".Значение";
				ИмяТаблицыПараметра = "Таб_"+ИмяПараметра;
				ТекстСоединений = ТекстСоединений + Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ "+ПолноеИмяОбъекта+".ДополнительныеРеквизиты КАК "
					+ ИмяТаблицыПараметра + Символы.ПС + "ПО " + ИмяТаблицыПараметра+".Ссылка = Таб.Ссылка И " + ИмяТаблицыПараметра
					+ ".Свойство = &Свойство" + ИмяПараметра;
				Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(Сред(Эл.РеквизитОбъекта, 24)));
				ПараметрыЗапроса.Добавить(Новый Структура(Ключи,"Свойство"+ИмяПараметра,Свойство,Ложь));
			ИначеЕсли Лев(Эл.РеквизитОбъекта,23) = "ДополнительноеСведение." Тогда
				ИмяРеквизита = ".Значение";
				ИмяТаблицыПараметра = "Таб_"+ИмяПараметра;
				ТекстСоединений = ТекстСоединений + Символы.ПС + "ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК "
					+ ИмяТаблицыПараметра + Символы.ПС + "ПО " + ИмяТаблицыПараметра + ".Объект = Таб.Ссылка И " + ИмяТаблицыПараметра
					+".Свойство = &Свойство" + ИмяПараметра;
				Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(Сред(Эл.РеквизитОбъекта, 24)));
				ПараметрыЗапроса.Добавить(Новый Структура(Ключи, "Свойство" + ИмяПараметра, Свойство, Ложь));
			Иначе
				ИмяРеквизита = СтрЗаменить(Эл.РеквизитОбъекта, ПолноеИмяОбъекта, "");
				ИмяТаблицыПараметра = "Таб";				
			КонецЕсли;
			
			Если ПарСравнения.ДваЗначения Тогда
				
				ЭтоПодобно = Найти(ПарСравнения.ВидСравненияНач, "Подобно") > 0;
				ИмяПараметра1 = ИмяПараметра + "_1";
				ПараметрыЗапроса.Добавить(Новый Структура(Ключи,ИмяПараметра1,ЗначениеУсловия[0].Значение,ЭтоПодобно));
				ТекУсловие = " ISNULL(" + ИмяТаблицыПараметра + ИмяРеквизита + ", НЕОПРЕДЕЛЕНО)" + ПарСравнения.ВидСравненияНач
					+ "&"+ ИмяПараметра1 + ПарСравнения.ВидСравненияКон;
				
				ЭтоПодобно = Найти(ПарСравнения.ВидСравненияНач2,"Подобно") > 0;
				ИмяПараметра2 = ИмяПараметра+"_2";
				ПараметрыЗапроса.Добавить(Новый Структура(Ключи,ИмяПараметра2,ЗначениеУсловия[1].Значение,ЭтоПодобно));
				ТекУсловие = ТекУсловие + " И ISNULL(" + ИмяТаблицыПараметра + ИмяРеквизита + ", НЕОПРЕДЕЛЕНО)" 
					+ ПарСравнения.ВидСравненияНач2 + "&"+ ИмяПараметра2 + ПарСравнения.ВидСравненияКон2;
				
			Иначе
				
				ЭтоПодобно = Найти(ПарСравнения.ВидСравненияНач,"Подобно") > 0;
				ПараметрыЗапроса.Добавить(Новый Структура(Ключи,ИмяПараметра,ЗначениеУсловия,ЭтоПодобно));
				ТекУсловие = " ISNULL(" + ИмяТаблицыПараметра + ИмяРеквизита + ", НЕОПРЕДЕЛЕНО)"
					+ ПарСравнения.ВидСравненияНач + "&"+ ИмяПараметра + ПарСравнения.ВидСравненияКон;
				
			КонецЕсли;
			
			Если ПарСравнения.ЭтоОтрицание Тогда
				ТекУсловие = " НЕ (" + ТекУсловие + ")";	
			КонецЕсли;
			
			УсловиеЗапроса = УсловиеЗапроса + ?(СчУсловийЗапроса=1,"",ОператорОбъединения) + ТекУсловие; 
			
		Иначе	
			
			Результат = ПроверитьРеквизитНаУсловие(ПолноеИмяОбъекта,
												   Эл.РеквизитОбъекта,
												   ВидСобытия,
												   Эл.ВидСравнения,												   
												   Эл.ЗначениеУсловия.Получить(),
												   ИсточникСсылкаОбъект,
												   ИсточникДопПараметр);
											
			ДобавитьРезультатаВыполненияУсловия(РезультатыУсловий, Результат);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СчУсловийЗапроса > 0 Тогда
		
		Если ЗначениеЗаполнено(ТекстСоединений) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КАК Таб", "КАК Таб" + Символы.ПС + ТекстСоединений);
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + " И (" +УсловиеЗапроса + ")";	
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка",ИсточникСсылка);
		Для Каждого Эл Из ПараметрыЗапроса Цикл
			Если Эл.ЭтоПодобно Тогда
				Запрос.УстановитьПараметр(Эл.Имя,"%"+Эл.Значение+"%");	
			Иначе
				Запрос.УстановитьПараметр(Эл.Имя,Эл.Значение);
			КонецЕсли;
		КонецЦикла;
		РезЗапроса = НЕ Запрос.Выполнить().Пустой();
		
		ДобавитьРезультатаВыполненияУсловия(РезультатыУсловий,РезЗапроса);
		
	КонецЕсли;
	
	Строка = "";
	// Собирается строчка с логическими выражениями, в зависимости от условия.
	Для каждого Эл Из РезультатыУсловий Цикл
		Строка  = Строка + " & " + Эл;
	КонецЦикла;
	
	Строка = Сред(Строка,3);
	Строка = СтрЗаменить(Строка, "&", ОператорОбъединения);
	Если ЛогикаПримененияУсловий = Перечисления.упоЛогическиеОператоры.НЕ Тогда
		Строка = "НЕ (" + Строка + ")";
	КонецЕсли;
	
	Строка = СтрЗаменить(Строка, "Да", "Истина");
	Строка = СтрЗаменить(Строка, "Нет", "Ложь");
	
	Попытка
		ВсеУсловияВыполнены = Вычислить(Строка);
	Исключение
		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru='Обработка условий регистрации событий'"), УровеньЖурналаРегистрации.Ошибка, 
		Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
		ВсеУсловияВыполнены = Ложь;
	КонецПопытки;
	
	Возврат ВсеУсловияВыполнены;
	
КонецФункции

Процедура ДобавитьРезультатаВыполненияУсловия(РезультатыУсловий, Знач Результат)
	РезультатыУсловий.Добавить(Результат);
КонецПроцедуры

Функция ПроверитьВычисляемыйРеквизитНаУсловие(ИмяТаблицы, ИмяРеквизита, ВидСобытия, ВидСравнения, ЗначениеУсловия,
	Источник, ИсточникДопПараметр, ПараметрыВыполненияКода = Неопределено)
	
	Результат = Ложь;
	
	ВыполняемыйКод = упоОповещенияПовтИсп.ПолучитьВыполняемыйКодВычисляемогоРеквизита(ИмяТаблицы, ИмяРеквизита);
	ТипРеквизитаСтрока = упоОповещенияПовтИсп.ПолучитьТипВычисляемогоРеквизита(ИмяТаблицы, ИмяРеквизита);
	Если ПараметрыВыполненияКода = Неопределено Тогда
		ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(ВидСобытия);
	КонецЕсли;
	
	Попытка
		ТипРеквизита = Тип(ТипРеквизитаСтрока);
	Исключение
		ТипРеквизита = Неопределено;	
	КонецПопытки;
		
	Если ЭтоНаборЗаписейРегистра(Источник) Тогда
		Источники = Источник;
	Иначе
		Источники = Новый Массив;
		Источники.Добавить(Источник);
	КонецЕсли;
	
	Для Каждого текИсточник Из Источники Цикл
		ЗначениеРеквизита = Неопределено;
		ПараметрыВозврата = Новый Структура;	
		Попытка
			ВыполнитьКод(ВыполняемыйКод, ЗначениеРеквизита, ПараметрыВозврата, текИсточник, ИсточникДопПараметр,, ПараметрыВыполненияКода);
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Обработка условий регистрации событий'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеРеквизита = Неопределено;	
		КонецПопытки;
		Результат = Результат ИЛИ ПроверкаЗначенияНаУсловие(ЗначениеРеквизита, ВидСравнения, ЗначениеУсловия, ИмяТаблицы);
	КонецЦикла;
				
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивДопПараметровИсточника(ВидСобытия, КодОпределенияДопПараметра, Источник, ПараметрыВыполненияКода)
	
	ИсточникДопПараметр = Неопределено;				
	
	Если ЗначениеЗаполнено(КодОпределенияДопПараметра) Тогда
		Результат = Неопределено;
		Попытка
			ПараметрыВозврата = Новый Структура;
			ВыполнитьКод(КодОпределенияДопПараметра, Неопределено, ПараметрыВозврата, Источник, ИсточникДопПараметр,, ПараметрыВыполненияКода);						
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Определение доп. параметра источника'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ИсточникДопПараметр = Неопределено;	
		КонецПопытки;					
	КонецЕсли;	
	
	Если ТипЗнч(ИсточникДопПараметр) = Тип("Массив") Тогда
		МассивДопПараметровИсточника = ИсточникДопПараметр;
	Иначе
		МассивДопПараметровИсточника = Новый Массив;
		МассивДопПараметровИсточника.Добавить(ИсточникДопПараметр);
	КонецЕсли;
	
	Возврат МассивДопПараметровИсточника;
	
КонецФункции 

Функция ПроверитьРеквизитНаУсловие(ИмяТаблицы, ИмяРеквизита, ВидСобытия, ВидСравнения, ЗначениеУсловия, Источник, ИсточникДопПараметр)
	
	Результат = Ложь;
	
	Попытка
		КраткоеИмяРеквизита = СтрЗаменить(ИмяРеквизита, ИмяТаблицы, "");
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Если ЭтоНаборЗаписейРегистра(Источник) Тогда
		Источники = Источник;
	Иначе
		Источники = Новый Массив;
		Источники.Добавить(Источник);
	КонецЕсли;
	
	Для Каждого текИсточник Из Источники Цикл
		Попытка
			ЗначениеРеквизита = Вычислить("текИсточник"+КраткоеИмяРеквизита);
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Обработка условий регистрации событий'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеРеквизита = Неопределено;	
		КонецПопытки;
		Результат = ПроверкаЗначенияНаУсловие(ЗначениеРеквизита, ВидСравнения, ЗначениеУсловия, ИмяТаблицы);
	КонецЦикла;
				
	Возврат Результат;
	
КонецФункции

Функция ПроверкаЗначенияНаУсловие(ЗначениеРеквизита, ВидСравнения, ЗначениеУсловия, ИмяТаблицы = Неопределено)
	
	Результат = Истина;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	Справочник.Пользователи КАК Таб
	               |ГДЕ
	               |	ИСТИНА";
	
	Если ИмяТаблицы <> Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Справочник.Пользователи",ИмяТаблицы);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"Справочник.Пользователи КАК Таб","");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"ИЗ","");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗначениеРеквизита",ЗначениеРеквизита);
	
	ПарСравнения = упоОповещенияПовтИсп.ПолучитьТекстВидаСравнения(ВидСравнения);
	
	Если ПарСравнения.ДваЗначения Тогда
		
		ЭтоПодобно = Найти(ПарСравнения.ВидСравненияНач,"Подобно") > 0;
		ИмяПараметра1 = "Параметр1";
		Если ЭтоПодобно Тогда
			Запрос.УстановитьПараметр(ИмяПараметра1,"%"+ЗначениеУсловия[0].Значение+"%");	
		Иначе
			Запрос.УстановитьПараметр(ИмяПараметра1,ЗначениеУсловия[0].Значение);
		КонецЕсли;
		
		ЭтоПодобно = Найти(ПарСравнения.ВидСравненияНач2,"Подобно") > 0;
		ИмяПараметра2 = "Параметр2";
		Если ЭтоПодобно Тогда
			Запрос.УстановитьПараметр(ИмяПараметра1, "%" + ЗначениеУсловия[1].Значение + "%");
		Иначе
			Запрос.УстановитьПараметр(ИмяПараметра2, ЗначениеУсловия[1].Значение);
		КонецЕсли;
		
		ТекУсловие = " &ЗначениеРеквизита" + ПарСравнения.ВидСравненияНач + "&"+ ИмяПараметра1 
			+ ПарСравнения.ВидСравненияКон;
		ТекУсловие = ТекУсловие + " И &ЗначениеРеквизита" + ПарСравнения.ВидСравненияНач2 + "&"+ ИмяПараметра2 
			+ ПарСравнения.ВидСравненияКон2;
		
	Иначе
		
		ИмяПараметра1 = "Параметр1";
		Запрос.УстановитьПараметр(ИмяПараметра1,ЗначениеУсловия);
		ТекУсловие = " &ЗначениеРеквизита" + ПарСравнения.ВидСравненияНач + "&"+ ИмяПараметра1 
			+ ПарСравнения.ВидСравненияКон;
		
	КонецЕсли;
	
	Если ПарСравнения.ЭтоОтрицание Тогда
		
		ТекУсловие = " НЕ (" + ТекУсловие + ")";
		
	КонецЕсли;
	
	УсловиеЗапроса = ТекУсловие; 
	
	ТекстЗапроса = ТекстЗапроса + " И (" +УсловиеЗапроса + ")";	
	
	Запрос.Текст = ТекстЗапроса;
	РезЗапроса = Запрос.Выполнить();
	Результат = Не РезЗапроса.Пустой();
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоНаборЗаписейРегистра(Объект)
	Тип = ТипЗнч(Объект);
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
	ИмяМетаданных = ОбъектМетаданных.ПолноеИмя();
	Если Найти(ИмяМетаданных, "РегистрСведений.") 
		ИЛИ Найти(ИмяМетаданных, "РегистрНакопления.") 
		ИЛИ Найти(ИмяМетаданных, "РегистрБухгалтерии.") 
		ИЛИ Найти(ИмяМетаданных, "РегистрРасчета.") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции 

Функция ПолучитьТаблицуПолучателейДляПроизошедшегоСобытия(ВидСобытия, Источник, ИсточникДопПараметр, КэшПолучателей, ПараметрыВыполненияКода)
	
	Если ТипЗнч(КэшПолучателей) = Тип("Соответствие") Тогда
		тзПолучатели = КэшПолучателей.Получить(ВидСобытия);
		Если тзПолучатели <> Неопределено Тогда
			Возврат тзПолучатели;
		КонецЕсли;
	КонецЕсли;
	
	тзПолучатели = Новый ТаблицаЗначений;
	тзПолучатели.Колонки.Добавить("ВидПолучателя");
	тзПолучатели.Колонки.Добавить("Получатель");
	тзПолучатели.Колонки.Добавить("Транспорт");
			
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытийПолучатели.ВидПолучателя,
	               |	упоВидыСобытийПолучатели.ДопУсловие,
	               |	упоВидыСобытийПолучатели.Получатель,
	               |	упоВидыСобытийПолучатели.ВидПолучателя.ТаблицаПолучателя КАК ТаблицаПолучателя,
	               |	упоВидыСобытийПолучатели.ОграничениеДоступа,
	               |	упоВидыСобытийПолучатели.Ссылка.Принудительное КАК Принудительное,
	               |	упоВидыСобытийПолучатели.НомерСтроки,
	               |	ЕСТЬNULL(упоОграниченияДоступаКОповещениям.Условие, НЕОПРЕДЕЛЕНО) КАК УсловиеОграничениеДоступа,
	               |	упоВидыСобытийПолучатели.Ссылка КАК ВидСобытия
	               |ПОМЕСТИТЬ врТаблицаВидаСобытия
	               |ИЗ
	               |	Справочник.упоВидыСобытий.Получатели КАК упоВидыСобытийПолучатели
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.упоОграниченияДоступаКОповещениям КАК упоОграниченияДоступаКОповещениям
	               |		ПО упоВидыСобытийПолучатели.ОграничениеДоступа = упоОграниченияДоступаКОповещениям.Ссылка
	               |ГДЕ
	               |	упоВидыСобытийПолучатели.Ссылка = &ВидСобытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытийТранспортОповещений.Транспорт
	               |ИЗ
	               |	Справочник.упоВидыСобытий.ТранспортОповещений КАК упоВидыСобытийТранспортОповещений
	               |ГДЕ
	               |	упоВидыСобытийТранспортОповещений.Используется
	               |	И упоВидыСобытийТранспортОповещений.Ссылка = &ВидСобытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПодпискиНаОповещения.Получатель,
	               |	упоПодпискиНаОповещения.ВидПолучателя
	               |ИЗ
	               |	РегистрСведений.упоПодпискиНаОповещения КАК упоПодпискиНаОповещения
	               |ГДЕ
	               |	упоПодпискиНаОповещения.ВидСобытия = &ВидСобытия
	               |	И упоПодпискиНаОповещения.Действует
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	врТаблицаВидаСобытия.ВидПолучателя,
	               |	врТаблицаВидаСобытия.ДопУсловие,
	               |	врТаблицаВидаСобытия.Получатель,
	               |	врТаблицаВидаСобытия.ТаблицаПолучателя,
	               |	врТаблицаВидаСобытия.ОграничениеДоступа,
	               |	врТаблицаВидаСобытия.Принудительное,
	               |	врТаблицаВидаСобытия.НомерСтроки,
	               |	врТаблицаВидаСобытия.УсловиеОграничениеДоступа,
	               |	врТаблицаВидаСобытия.ВидСобытия
	               |ИЗ
	               |	врТаблицаВидаСобытия КАК врТаблицаВидаСобытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	врТаблицаВидаСобытия.НомерСтроки,
	               |	упоОграниченияДоступаКОповещениямСостав.Элемент
	               |ПОМЕСТИТЬ врЭлементыОграничений
	               |ИЗ
	               |	Справочник.упоОграниченияДоступаКОповещениям.Состав КАК упоОграниченияДоступаКОповещениямСостав
	               |		ЛЕВОЕ СОЕДИНЕНИЕ врТаблицаВидаСобытия КАК врТаблицаВидаСобытия
	               |		ПО (врТаблицаВидаСобытия.ОграничениеДоступа = упоОграниченияДоступаКОповещениямСостав.Ссылка)
	               |ГДЕ
	               |	врТаблицаВидаСобытия.ОграничениеДоступа <> ЗНАЧЕНИЕ(Справочник.упоОграниченияДоступаКОповещениям.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	врЭлементыОграничений.НомерСтроки,
	               |	врЭлементыОграничений.Элемент КАК Элемент,
	               |	ЕСТЬNULL(СоставыГруппПользователей.Пользователь, ГруппыДоступаПользователи.Пользователь) КАК Пользователь
	               |ПОМЕСТИТЬ врСоставГруппДоступа
	               |ИЗ
	               |	врЭлементыОграничений КАК врЭлементыОграничений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
	               |			ПО ГруппыДоступаПользователи.Пользователь = СоставыГруппПользователей.ГруппаПользователей
	               |		ПО врЭлементыОграничений.Элемент = ГруппыДоступаПользователи.Ссылка
	               |ГДЕ
	               |	врЭлементыОграничений.Элемент ССЫЛКА Справочник.ГруппыДоступа
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	врЭлементыОграничений.НомерСтроки,
	               |	врЭлементыОграничений.Элемент,
	               |	ЕСТЬNULL(врСоставГруппДоступа.Пользователь, врЭлементыОграничений.Элемент) КАК ЭлементОграничения
	               |ИЗ
	               |	врЭлементыОграничений КАК врЭлементыОграничений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ врСоставГруппДоступа КАК врСоставГруппДоступа
	               |		ПО врЭлементыОграничений.Элемент = врСоставГруппДоступа.Элемент";
					   			   
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВидСобытия", ВидСобытия);
	
	РезультатПакета = Запрос.ВыполнитьПакет();

	Транспорт = РезультатПакета[1].Выгрузить(); 
	Подписки = РезультатПакета[2].Выгрузить(); 
	ТаблицаПолучателейВидаСобытия = РезультатПакета[3].Выгрузить();
	ЭлементыОграничений = РезультатПакета[6].Выгрузить();
	
	ЕстьДопУсловия = Ложь;	
	КэшПодписокВидовПолучателей = Новый Соответствие;
	
	Для Каждого СтрокаПолучателейВидаСобытия Из ТаблицаПолучателейВидаСобытия Цикл
				
		МассивПолучателей = Новый Массив;		
		
		Если СтрокаПолучателейВидаСобытия.Принудительное Тогда
			
			Если ЗначениеЗаполнено(СтрокаПолучателейВидаСобытия.Получатель) Тогда	
				МассивПолучателей.Добавить(СтрокаПолучателейВидаСобытия.Получатель);
			Иначе
				МассивПолучателей = упоОповещенияПовтИсп.ПолучитьВсеЭлементыТаблицыПолучателя(СтрокаПолучателейВидаСобытия.ТаблицаПолучателя);
			КонецЕсли;
			
		Иначе
			
			ПодпискиВидаПолучателя = КэшПодписокВидовПолучателей.Получить(СтрокаПолучателейВидаСобытия.ВидПолучателя);
			Если ПодпискиВидаПолучателя = Неопределено Тогда
				ТаблицаПодписокВидаПолучателя = Подписки.Скопировать(Новый Структура("ВидПолучателя", СтрокаПолучателейВидаСобытия.ВидПолучателя));
				ПодпискиВидаПолучателя = ТаблицаПодписокВидаПолучателя.ВыгрузитьКолонку("Получатель");
				КэшПодписокВидовПолучателей.Вставить(СтрокаПолучателейВидаСобытия.ВидПолучателя, ПодпискиВидаПолучателя); 
			КонецЕсли;	
				
			Если ЗначениеЗаполнено(СтрокаПолучателейВидаСобытия.Получатель) Тогда
				Если ПодпискиВидаПолучателя.Найти(СтрокаПолучателейВидаСобытия.Получатель) <> Неопределено Тогда
					МассивПолучателей.Добавить(СтрокаПолучателейВидаСобытия.Получатель);	
				КонецЕсли;
			Иначе
				МассивПолучателей = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ПодпискиВидаПолучателя);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПолучателейВидаСобытия.ДопУсловие) Тогда
			
			Если Не ЗначениеЗаполнено(ПодпискиВидаПолучателя) Тогда
				МассивПолучателей.Очистить();
				Продолжить;				
			КонецЕсли;

			ЕстьДопУсловия = Истина;
			МассивПолучателей = ПроверитьПолучателейНаДопУсловие(СтрокаПолучателейВидаСобытия.ДопУсловие, 
																Источник, ИсточникДопПараметр, МассивПолучателей, ВидСобытия,
																ПараметрыВыполненияКода);
			Индекс = МассивПолучателей.ВГраница();
			Пока Индекс <> -1 Цикл
				Получатель = МассивПолучателей[Индекс];
				Если ПодпискиВидаПолучателя.Найти(Получатель) = Неопределено Тогда
					МассивПолучателей.Удалить(Индекс);
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;
		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаПолучателейВидаСобытия.ОграничениеДоступа) Тогда
			ВсеКроме = СтрокаПолучателейВидаСобытия.УсловиеОграничениеДоступа 
							= Перечисления.упоУсловияОграниченияДоступаКОповещениям.ВсеКромеУказанных;
							
			сч = МассивПолучателей.Количество()-1;
			Отбор = Новый Структура("НомерСтроки", СтрокаПолучателейВидаСобытия.НомерСтроки);
			Пока сч >= 0 Цикл
				Получатель = МассивПолучателей[сч];
				Отбор.Вставить("ЭлементОграничения", Получатель);
				НайденныеОграничения = ЭлементыОграничений.НайтиСтроки(Отбор);
				НайденВОграничениях = НайденныеОграничения.Количество() > 0;
				Если (ВсеКроме И НайденВОграничениях)
				 ИЛИ (Не ВсеКроме И Не НайденВОграничениях) Тогда
					МассивПолучателей.Удалить(сч);	
				КонецЕсли;
				сч = сч - 1;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого Получатель Из МассивПолучателей Цикл
			Для Каждого ДанныеТранспорта Из Транспорт Цикл
				ДанныеПолучателя = тзПолучатели.Добавить();
				ДанныеПолучателя.ВидПолучателя = СтрокаПолучателейВидаСобытия.ВидПолучателя;
				ДанныеПолучателя.Получатель = Получатель;
				ДанныеПолучателя.Транспорт = ДанныеТранспорта.Транспорт;
			КонецЦикла;
		КонецЦикла;	
		
	КонецЦикла;
	
	тзПолучатели.Свернуть("ВидПолучателя, Получатель, Транспорт");
	
	Если Не ЕстьДопУсловия Тогда
		// Кэш заполняем если нет доп. условий
		КэшПолучателей.Вставить(ВидСобытия, тзПолучатели);		
	КонецЕсли;	
	
	Возврат тзПолучатели;	
	
КонецФункции

Функция ПроверитьПолучателейНаДопУсловие(УсловиеКод, Источник, ИсточникДопПараметр, Знач масПолучатели, ВидСобытия, ПараметрыВыполненияКода)
	
	Результат = Ложь; 
	
	Попытка
		Выполнить(УсловиеКод);
	Исключение
		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru='Обработка условия определения получателей события'"), УровеньЖурналаРегистрации.Ошибка, 
		Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
		Результат = Ложь;	
	КонецПопытки;
	
	Если Результат Тогда
		Возврат масПолучатели;
	Иначе
		Возврат Новый Массив;
	КонецЕсли;	
	
КонецФункции

#КонецОбласти
