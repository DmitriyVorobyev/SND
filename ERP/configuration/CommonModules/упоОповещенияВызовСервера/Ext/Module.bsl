// Разбирает имя таблицы.
//
// Параметры:
//  ИмяТаблицыИТабЧасти	 - Строка
//  ИмяТаблицыБезВида	 - Строка
// 
// Возвращаемое значение:
//  Структура - структура с данными таблицы.
//
Функция РазобратьИмяТаблицы(Знач ИмяТаблицыИТабЧасти,ИмяТаблицыБезВида = Ложь) Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("ИмяТаблицы",ИмяТаблицыИТабЧасти);
	Рез.Вставить("ВидТаблицы","");
	Рез.Вставить("ИмяТабЧасти","");
	Рез.Вставить("ЭтоТабЧасть",Ложь);
	
	масПодстроки = Новый Массив;
	Остаток = ИмяТаблицыИТабЧасти;
	
	Поз = Найти(Остаток,".");
	Пока Поз > 0 Цикл
		Подстрока = Лев(Остаток,Поз-1);
		Остаток = Сред(Остаток,Поз+1);
		масПодстроки.Добавить(Подстрока);
		Поз = Найти(Остаток,".");
	КонецЦикла;
	
	Если Не ПустаяСтрока(Остаток) Тогда
		масПодстроки.Добавить(Остаток);		
	КонецЕсли;
	
	Если масПодстроки.Количество() = 2 Тогда
		Рез.ВидТаблицы = масПодстроки[0];
		Рез.ИмяТаблицы = ?(ИмяТаблицыБезВида, масПодстроки[1], масПодстроки[0] + "." + масПодстроки[1]);
	ИначеЕсли масПодстроки.Количество() = 3 Тогда	
		Рез.ВидТаблицы = масПодстроки[0];
		Рез.ИмяТабЧасти = масПодстроки[2];
		Рез.ИмяТаблицы = ?(ИмяТаблицыБезВида, масПодстроки[1], масПодстроки[0] + "." + масПодстроки[1]);
		Рез.ЭтоТабЧасть = Истина;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Разбирает имя реквизита.
//
// Параметры:
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  Структура - структура с данными таблицы.
//
Функция РазобратьИмяРеквизита(Знач ИмяРеквизита) Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("ВидТаблицы", "");
	Рез.Вставить("ИмяТаблицы", "");
	Рез.Вставить("ИмяТабЧасти", "");
	Рез.Вставить("ИмяРеквизита", ИмяРеквизита);
	Рез.Вставить("ЭтоТабЧасть", Ложь);
	
	масПодстроки = Новый Массив;
	Остаток = ИмяРеквизита;
	
	Поз = Найти(Остаток, ".");
	Пока Поз > 0 Цикл
		Подстрока = Лев(Остаток, Поз-1);
		Остаток = Сред(Остаток, Поз+1);
		масПодстроки.Добавить(Подстрока);
		Поз = Найти(Остаток, ".");
	КонецЦикла;
	
	Если Не ПустаяСтрока(Остаток) Тогда
		масПодстроки.Добавить(Остаток);		
	КонецЕсли;
	
	Если масПодстроки.Количество() = 1 Тогда
		Рез.ИмяРеквизита = масПодстроки[0];
	ИначеЕсли масПодстроки.Количество() = 2 Тогда
		Рез.ИмяТаблицы = масПодстроки[0];
		Рез.ИмяРеквизита = масПодстроки[1];
	ИначеЕсли масПодстроки.Количество() = 3 Тогда
		Рез.ВидТаблицы = масПодстроки[0];
		Рез.ИмяТаблицы = масПодстроки[1];
		Рез.ИмяРеквизита = масПодстроки[2];
	ИначеЕсли масПодстроки.Количество() = 4 Тогда
		Рез.ВидТаблицы = масПодстроки[0];
		Рез.ИмяТаблицы = масПодстроки[1];
		Рез.ИмяТабЧасти = масПодстроки[2];
		Рез.ИмяРеквизита = масПодстроки[3];
		Рез.ЭтоТабЧасть = Истина;
	КонецЕсли;
		
	Возврат Рез;
	
КонецФункции

// Раскладывает строку в массив подстрок.
//
// Параметры:
//  Строка					 - Строка
//  Разделитель				 - Строка
//  ПропускатьПустыеСтроки	 - Булево
// 
// Возвращаемое значение:
//  Массив - массив подстрок.
//
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",",
	Знач ПропускатьПустыеСтроки = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	// Для обеспечения обратной совместимости.
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда 
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;
	
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

