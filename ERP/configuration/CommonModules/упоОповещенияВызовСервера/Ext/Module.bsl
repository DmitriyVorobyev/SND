// Добавляет сообщение.
//
// Параметры:
//  ВидСобытия				 - СправочникСсылка.упоВидыСобытий
//  Источник				 - ЛюбаяСсылка
//  ИсточникДопПараметр		 - ЛюбаяСсылка, Булево, Строка, Дата, Число
//  ВидПолучателя			 - СправочникСсылка.упоВидыПолучателейОповещений, Строка
//  Получатель				 - СправочникСсылка, Строка
//  Транспорт				 - СправочникСсылка.упоТранспортОповещений
//  ДопПараметры			 - Структура
//  ПараметрыВыполненияКода	 - Структура
// 
// Возвращаемое значение:
//  Неопределено, Булево - результат.
//
Функция ДобавитьСообщение(ВидСобытия, Источник, ИсточникДопПараметр, ВидПолучателя,
	Получатель, Транспорт, ДопПараметры, ПараметрыВыполненияКода = Неопределено) Экспорт
	
	Если Не ДопПараметры.Свойство("СообщениеОбОшибках") Тогда
		ДопПараметры.Вставить("СообщениеОбОшибках", "");
	КонецЕсли;
	
	Отправить = Неопределено;
	ДопПараметры.Свойство("Отправить", Отправить);
	Если ТипЗнч(Отправить) <> Тип("Булево") Тогда
		Отправить = Истина;
		// Если отправить = Ложь, то помещаем сообщение в очередь.
	КонецЕсли;
	
	ШаблонТекста = "";
	ШаблонТекстаHTML = "";
	ШаблонТемы = "";
	КоличествоПопытокОтправки = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытий.ШаблонТекста,
	               |	упоВидыСобытий.ШаблонТекстаHTML,
	               |	упоВидыСобытий.ШаблонТемы,
	               |	упоВидыСобытий.КоличествоПопытокОтправки
	               |ИЗ
	               |	Справочник.упоВидыСобытий КАК упоВидыСобытий
	               |ГДЕ
	               |	упоВидыСобытий.Ссылка = &ВидСобытия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытийТэги.НомерСтроки,
	               |	упоВидыСобытийТэги.ТипТэга,
	               |	упоВидыСобытийТэги.Значение,
	               |	упоВидыСобытийТэги.Условие,
				   |	упоВидыСобытийТэги.УсловиеХЗ,
	               |	упоВидыСобытийТэги.Представление
	               |ИЗ
	               |	Справочник.упоВидыСобытий.Тэги КАК упоВидыСобытийТэги
	               |ГДЕ
	               |	упоВидыСобытийТэги.Ссылка = &ВидСобытия";
				   
	Запрос.УстановитьПараметр("ВидСобытия", ВидСобытия);
	РезЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ШаблонТекста = Выборка.ШаблонТекста;
		ШаблонТекстаHTML = Выборка.ШаблонТекстаHTML;
		ШаблонТемы = Выборка.ШаблонТемы;
		КоличествоПопытокОтправки = Выборка.КоличествоПопытокОтправки;
		Если КоличествоПопытокОтправки = 0 Тогда
			КоличествоПопытокОтправки = 3;
		КонецЕсли;
	Иначе
		ДопПараметры.СообщениеОбОшибках = ДопПараметры.СообщениеОбОшибках + 
										  НСтр("ru = 'Не удалось получить параметры сообщения'") + Символы.ПС;
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(ВидСобытия);
	
	тзТэги = РезЗапроса[1].Выгрузить();
	Для Каждого СтрТз Из тзТэги Цикл
		
		ИмяТэга = "["+СтрТз.Представление + "]";
		
		Если Найти(ШаблонТекста,ИмяТэга) = 0 
			И Найти(ШаблонТекстаHTML,ИмяТэга) = 0
			И Найти(ШаблонТемы,ИмяТэга) = 0 Тогда
			
			Продолжить;
		КонецЕсли;
		
		РезультатВычисления = упоОповещенияВызовСервера.ВычислитьЗначениеТэга(
														СтрТз.ТипТэга, СтрТз.Условие, 
														СтрТз.УсловиеХЗ, Источник, ИсточникДопПараметр,
														ВидСобытия, ПараметрыВыполненияКода); 
		
		Если ТипЗнч(РезультатВычисления) = Тип("Структура") Тогда
			ЗначениеТэгаТекст = РезультатВычисления.Текст;	
			ЗначениеТэгаHTML = РезультатВычисления.HTML;
		Иначе
			ЗначениеТэгаТекст = РезультатВычисления;	
			ЗначениеТэгаHTML = ЗначениеТэгаТекст;	
		КонецЕсли;
		
		ШаблонТекста = СтрЗаменить(ШаблонТекста, ИмяТэга, ЗначениеТэгаТекст);
		ШаблонТекстаHTML = СтрЗаменить(ШаблонТекстаHTML, ИмяТэга, ЗначениеТэгаHTML);
		ШаблонТемы = СтрЗаменить(ШаблонТемы, ИмяТэга, ЗначениеТэгаТекст);

		
	КонецЦикла;
	
	ДопПараметры.Вставить("ШаблонТекста", ШаблонТекста);
	ДопПараметры.Вставить("ШаблонТекстаHTML", ШаблонТекстаHTML);
	ДопПараметры.Вставить("ШаблонТемы", ШаблонТемы);
	ДопПараметры.Вставить("КоличествоПопытокОтправки", КоличествоПопытокОтправки);
	
	Если Отправить Тогда
		Рез = ОтправитьСообщение(ВидСобытия, Источник, ИсточникДопПараметр, 
									ВидПолучателя, Получатель, Транспорт, ДопПараметры);
	Иначе
		Рез = ПоместитьСообщениеВОчередь(ВидСобытия, Источник, ИсточникДопПараметр, 
									ВидПолучателя, Получатель, Транспорт, ДопПараметры);	
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Отправляет сообщение.
//
// Параметры:
//  ВидСобытия			 - СправочникСсылка.упоВидыСобытий
//  Источник			 - ЛюбаяСсылка
//  ИсточникДопПараметр	 - ЛюбаяСсылка, Булево, Строка, Дата, Число
//  ВидПолучателя		 - СправочникСсылка.упоВидыПолучателейОповещений, Строка
//  Получатель			 - Строка, СправочникСсылка
//  Транспорт			 - СправочникСсылка.упоТранспортОповещений
//  ДопПараметры		 - Структура
//  СообщениеОбОшибке	 - Строка
//  КэшЗначений			 - Соответствие
// 
// Возвращаемое значение:
//  Неопределено, Булево - результат.
//
Функция ОтправитьСообщение(ВидСобытия, Источник, ИсточникДопПараметр, ВидПолучателя, Получатель, Транспорт, 
	ДопПараметры, СообщениеОбОшибке = "", КэшЗначений = Неопределено) Экспорт
	
	СообщениеОбОшибке = "";
	
	Автор = Неопределено;
	ДопПараметры.Свойство("Автор",Автор);
	Если Автор = Неопределено Тогда
		Автор = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	ИдентификаторСобытия = Неопределено;
	ДопПараметры.Свойство("ИдентификаторСобытия", ИдентификаторСобытия);
	ДатаВозникновения = Неопределено;
	
	ДопПараметры.Свойство("ДатаВозникновения", ДатаВозникновения);
	СообщениеОбОшибках = Неопределено;
	
	ДопПараметры.Свойство("СообщениеОбОшибках", СообщениеОбОшибках);
	Если СообщениеОбОшибках = Неопределено Тогда
		СообщениеОбОшибках = "";
	КонецЕсли;
		
	НастройкиТранспорта = ПолучитьНастройкиТранспорта(Транспорт);
	Если НастройкиТранспорта = Неопределено Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не удалось получить параметры транспорта'");
		СообщениеОбОшибках = СообщениеОбОшибках + СообщениеОбОшибке + Символы.ПС;
		ДопПараметры.Вставить("СообщениеОбОшибке", СообщениеОбОшибке);
		ДопПараметры.Вставить("СообщениеОбОшибках", СообщениеОбОшибке);
		Возврат Неопределено;
	КонецЕсли;
		
	ПарОтправки = Новый Структура;
	ПарОтправки.Вставить("ИмяМодуляОтправкиСообщений", НастройкиТранспорта.ИмяМодуляОтправкиСообщений);
	
	Если НастройкиТранспорта.ДоступнаТемаСообщения И ДопПараметры.Свойство("ШаблонТемы") Тогда
		ПарОтправки.Вставить("Тема", ДопПараметры.ШаблонТемы);
	КонецЕсли;
	Если НастройкиТранспорта.ДоступенТекстСообщенияВHTML И Не ПустаяСтрока(ДопПараметры.ШаблонТекстаHTML) Тогда
		ПарОтправки.Вставить("Тело", ДопПараметры.ШаблонТекстаHTML);
		ПарОтправки.Вставить("ТипТекста","HTML");
	Иначе
		ПарОтправки.Вставить("Тело", ДопПараметры.ШаблонТекста);
		ПарОтправки.Вставить("ТипТекста", "ПростойТекст");
	КонецЕсли;
	ПарОтправки.Вставить("Источник", Источник);
	ПарОтправки.Вставить("ИсточникДопПараметр", ИсточникДопПараметр);
	
	ПараметрыТранспорта = Неопределено;
	НастройкиТранспорта.Свойство("ПараметрыТранспорта", ПараметрыТранспорта);
	Если ТипЗнч(ПараметрыТранспорта) = Тип("Структура") Тогда
		Для Каждого Эл Из ПараметрыТранспорта Цикл
			ПарОтправки.Вставить(Эл.Ключ,Эл.Значение);	
		КонецЦикла;
	КонецЕсли; 
	
	АдресПолучателя = упоОповещенияВызовСервера.ОпределитьАдресПолучателя(Получатель,
		ВидПолучателя,
		Транспорт,
		СообщениеОбОшибках);
	ПарОтправки.Вставить("Кому", АдресПолучателя);
	
	Если НастройкиТранспорта.ДоступнаНастройкаДляВидаСобытия Тогда
		НастройкиТранспортовДляВидаСобытия = ПолучитьНастройкиТранспортовДляВидаСобытия(ВидСобытия);
		НастройкиВидаСобытияДляОтправки  = Неопределено;
		Если НЕ НастройкиТранспортовДляВидаСобытия = Неопределено Тогда
			ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(ВидСобытия);		
			промНастройкиВидаСобытияДляОтправки = НастройкиТранспортовДляВидаСобытия.Получить(Транспорт);
			Если промНастройкиВидаСобытияДляОтправки <> Неопределено Тогда
				НастройкиВидаСобытияДляОтправки = Новый Структура;
				Для Каждого КлючЗначение Из промНастройкиВидаСобытияДляОтправки Цикл
					Если НЕ КлючЗначение.Значение.Использование Тогда
						Продолжить;
					КонецЕсли;
					Если КлючЗначение.Значение.Кодом Тогда
						РезультатВычисления = ВычислитьНастройкиТранспортаВидаСобытияДляОтправки(КлючЗначение.Значение.ВыполняемыйКод,
						                                                                        ВидСобытия,
																								Источник, 	
																								ИсточникДопПараметр, 
																								ПараметрыВыполненияКода);
						НастройкиВидаСобытияДляОтправки.Вставить(КлючЗначение.Ключ, РезультатВычисления);																								
					Иначе
						НастройкиВидаСобытияДляОтправки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение.Значение);
					КонецЕсли;
				КонецЦикла; 
			КонецЕсли;
		КонецЕсли;
		Если НастройкиВидаСобытияДляОтправки <> Неопределено Тогда
			ПарОтправки.Вставить("НастройкиВидаСобытия", НастройкиВидаСобытияДляОтправки);
		КонецЕсли;
	
	КонецЕсли;
	
	Попытка
		
		ИсполняемыйМодуль = Вычислить(ПарОтправки.ИмяМодуляОтправкиСообщений);
		ИдентификаторСообщения = ИсполняемыйМодуль.ОтправитьСообщение(ПарОтправки);
		
	Исключение
		
		ИдентификаторСообщения = Неопределено;	
		
		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		СообщениеОбОшибках = СообщениеОбОшибках + СообщениеОбОшибке + Символы.ПС;
		
		ЗаписьЖурналаРегистрации(НСтр("ru='Отправка сообщения'"),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.упоВидыСобытий,
			ВидСобытия,
			СообщениеОбОшибке);
		
	КонецПопытки;
	
	ДопПараметры.Вставить("СообщениеОбОшибке", СообщениеОбОшибке);
	ДопПараметры.Вставить("СообщениеОбОшибках", СообщениеОбОшибках);
	
	Если ЗначениеЗаполнено(ИдентификаторСообщения) Тогда
		
		МЗ = РегистрыСведений.упоОтправленныеСообщения.СоздатьМенеджерЗаписи();
		МЗ.ВидСобытия = ВидСобытия;
		МЗ.Источник = Источник;
		МЗ.ИсточникДопПараметр = ИсточникДопПараметр;
		МЗ.ВидПолучателя = ВидПолучателя;
		МЗ.Получатель = Получатель;
		МЗ.Транспорт = Транспорт;
		МЗ.ИдентификаторСобытия = ИдентификаторСобытия;
		МЗ.Текст = ДопПараметры.ШаблонТекста;
		МЗ.ТекстHTML = ДопПараметры.ШаблонТекстаHTML;
		МЗ.Тема = ДопПараметры.ШаблонТемы;
		МЗ.ДатаОтправки = ТекущаяДатаСеанса();
		МЗ.ДатаВозникновения = ДатаВозникновения;
		МЗ.Получатели = АдресПолучателя;
		МЗ.Автор = Автор;
		МЗ.Идентификатор = ИдентификаторСообщения;
		МЗ.Записать(Истина);
		
		ДопПараметры.Вставить("ДатаОтправки", МЗ.ДатаОтправки);
		
	КонецЕсли;
	
	Возврат ИдентификаторСообщения;
	
КонецФункции

// Помещает сообщение в очередь.
//
// Параметры:
//  ВидСобытия			 - СправочникСсылка.упоВидыСобытий
//  Источник			 - ЛюбаяСсылка
//  ИсточникДопПараметр	 - ЛюбаяСсылка, Булево, Строка, Дата, Число
//  ВидПолучателя		 - СправочникСсылка.упоВидыПолучателейОповещений, Строка
//  Получатель			 - Строка, СправочникСсылка
//  Транспорт			 - СправочникСсылка.упоТранспортОповещений
//  ДопПараметры		 - Структура
// 
// Возвращаемое значение:
//  Булево - результат.
//
Функция ПоместитьСообщениеВОчередь(ВидСобытия, Источник, ИсточникДопПараметр, ВидПолучателя, 
		Получатель, Транспорт, ДопПараметры) Экспорт
	
	УИСобытия = Неопределено;
	Автор = Неопределено;
	КоличествоПопытокОтправки =Неопределено;
	ДопПараметры.Свойство("УИСобытия", УИСобытия);
	ДопПараметры.Свойство("Автор", Автор);
	ДопПараметры.Свойство("КоличествоПопытокОтправки", КоличествоПопытокОтправки);
	Если Автор = Неопределено Тогда
		Автор = Пользователи.ТекущийПользователь();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КоличествоПопытокОтправки) Тогда
		КоличествоПопытокОтправки = 3;
	КонецЕсли;
	
	МЗ = РегистрыСведений.упоОчередьСобытийДляОповещений.СоздатьМенеджерЗаписи();
	МЗ.ВидСобытия = ВидСобытия;
	МЗ.Источник = Источник;
	МЗ.ИсточникДопПараметр = ИсточникДопПараметр;
	МЗ.ВидПолучателя = ВидПолучателя;
	МЗ.Получатель = Получатель;
	МЗ.Транспорт = Транспорт;
	МЗ.ИдентификаторСобытия = УИСобытия;
	МЗ.Текст = ДопПараметры.ШаблонТекста;
	МЗ.ТекстHTML = ДопПараметры.ШаблонТекстаHTML;
	МЗ.Тема = ДопПараметры.ШаблонТемы;
	МЗ.ДатаВозникновения = ТекущаяДатаСеанса();
	МЗ.КоличествоПопытокОтправки = КоличествоПопытокОтправки;
	МЗ.Автор = Автор;
	МЗ.Записать(Истина);
	
	Возврат Истина;
	
КонецФункции

