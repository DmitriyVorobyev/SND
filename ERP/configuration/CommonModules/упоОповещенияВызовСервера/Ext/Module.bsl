// Добавляет элементы подписки.
//
// Параметры:
//  Форма				 - УправляемаяФорма
//  Объект				 - СправочникОбъект, ДокументОбъект
//  ВыбЭлементРодитель	 - СправочникСсылка
//  БезПроверкиПрав		 - Булево	 - признак отсутствия проверки прав.
//
Процедура ДобавитьЭлементыПодписки(Форма, Объект, ВыбЭлементРодитель = Неопределено, БезПроверкиПрав = Ложь) Экспорт
	
	Если НЕ упоОповещенияПовтИсп.ПолучитьИспользоватьСобытия() Тогда
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		Источник = Объект.Ссылка;
	Иначе
		Источник = Объект;
	КонецЕсли;
	
	МД = Источник.Метаданные();
	ПолноеИмяОбъекта = МД.ПолноеИмя();
	
	Если НЕ БезПроверкиПрав И НЕ ПравоДоступа("Изменение", МД) И Не ПравоДоступа("Редактирование", МД) Тогда
		Возврат;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	тзВидыСобытий = упоОповещенияПовтИсп.ПолучитьВидыСобытийДляПодписки(ПолноеИмяОбъекта, Источник);
	Если тзВидыСобытий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МасДобРеквизитов = Новый Массив;
	ИзменяетСохраняемыеДанные = Истина;
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("упоПодпискаНаОповещения", Новый ОписаниеТипов("ТаблицаЗначений"), , ,
		ИзменяетСохраняемыеДанные));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("ВидСобытия", Новый ОписаниеТипов("СправочникСсылка.упоВидыСобытий"),
		"упоПодпискаНаОповещения" ,"Вид события"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("Раздел", Новый ОписаниеТипов("Строка"),"упоПодпискаНаОповещения",
		"Раздел"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("ВидПолучателя",
		Новый ОписаниеТипов("СправочникСсылка.упоВидыПолучателейОповещений"),"упоПодпискаНаОповещения" ,"Вид получателя"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("Действует", Новый ОписаниеТипов("Булево"),"упоПодпискаНаОповещения",
		"Действует"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("Принудительное", Новый ОписаниеТипов("Булево"),
		"упоПодпискаНаОповещения", "Принудительное"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("ИмяЭлемента", Новый ОписаниеТипов("Строка"),
		"упоПодпискаНаОповещения", "ИмяЭлемента"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("ЗаголовокЭлемента", Новый ОписаниеТипов("Строка"),
		"упоПодпискаНаОповещения", "Заголовок элемента"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("Адрес", Новый ОписаниеТипов("Строка"),
		"упоПодпискаНаОповещения", "Адрес"));
	МасДобРеквизитов.Добавить(Новый РеквизитФормы("ХранениеАдреса", Новый ОписаниеТипов("Строка"),
		"упоПодпискаНаОповещения", "Хранение адреса"));

	Форма.ИзменитьРеквизиты(МасДобРеквизитов);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВтВидыСобытий ИЗ &тз КАК тз";
	Запрос.УстановитьПараметр("тз", тзВидыСобытий);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПодпискиНаОповещения.ВидСобытия,
	               |	упоПодпискиНаОповещения.ВидПолучателя,
	               |	упоПодпискиНаОповещения.Действует
	               |ПОМЕСТИТЬ ВтТекущаяПодписка
	               |ИЗ
	               |	РегистрСведений.упоПодпискиНаОповещения КАК упоПодпискиНаОповещения
	               |ГДЕ
	               |	упоПодпискиНаОповещения.Получатель = &Получатель
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВтВидыСобытий.ВидСобытия,
	               |	ВтВидыСобытий.ВидСобытия.Родитель.Наименование КАК Раздел,
	               |	ВтВидыСобытий.ВидСобытия.Наименование КАК ЗаголовокЭлемента,
	               |	""упоПодпискаНаОповещения1000"" КАК ИмяЭлемента,
	               |	ВтВидыСобытий.ВидПолучателя,
				   |	ВтВидыСобытий.Принудительное КАК Принудительное,
				   |	ВЫБОР КОГДА ВтВидыСобытий.Принудительное ТОГДА ИСТИНА ИНАЧЕ
	               |	ЕСТЬNULL(ВтТекущаяПодписка.Действует, ЛОЖЬ) КОНЕЦ КАК Действует
	               |ИЗ
	               |	ВтВидыСобытий КАК ВтВидыСобытий
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВтТекущаяПодписка КАК ВтТекущаяПодписка
	               |		ПО ВтВидыСобытий.ВидСобытия = ВтТекущаяПодписка.ВидСобытия
	               |			И ВтВидыСобытий.ВидПолучателя = ВтТекущаяПодписка.ВидПолучателя	
	               |УПОРЯДОЧИТЬ ПО
	               |	Раздел,
	               |	ЗаголовокЭлемента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Транспорт.Наименование КАК Транспорт,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Транспорт КАК ТранспортСсылка,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ПолеАдреса,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ПолеАдресаХЗ,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ВариантХраненияПоляАдреса,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ОписаниеХраненияАдреса
	               |ИЗ
	               |	Справочник.упоВидыПолучателейОповещений.АдресаОтправки КАК упоВидыПолучателейОповещенийАдресаОтправки
	               |ГДЕ
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Ссылка.ТаблицаПолучателя = &ТаблицаПолучателя
	               |	И НЕ упоВидыПолучателейОповещенийАдресаОтправки.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Получатель", Источник.Ссылка);
	Запрос.УстановитьПараметр("ТаблицаПолучателя", ПолноеИмяОбъекта);
	РезЗапроса = Запрос.ВыполнитьПакет();
	тзПодписки = РезЗапроса[1].Выгрузить();
	Сч = 0;
	ВидПолучателя = Неопределено;
	Для Каждого СтрТз Из тзПодписки Цикл
		
		Сч = Сч + 1;
		НовСтр = Форма.упоПодпискаНаОповещения.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТз);
		НовСтр.ИмяЭлемента = "упоПодпискаНаОповещения" + Формат(Сч,"ЧГ=0");
		ВидПолучателя = СтрТз.ВидПолучателя;
	КонецЦикла;
	
	ЭлементРодитель = Неопределено;
	
	Если ТипЗнч(ВыбЭлементРодитель) = Тип("ГруппаФормы") Тогда
		ЭлементРодитель = Форма.Элементы.Добавить("упоГруппаОповещения", Тип("ГруппаФормы"), ВыбЭлементРодитель);
		ЭлементРодитель.Заголовок = НСтр("ru = 'Подписки на оповещения'");
		ЭлементРодитель.ШрифтЗаголовка = ШрифтыСтиля.ОбычныйШрифтТекста;
		Если ВыбЭлементРодитель.Вид = ВидГруппыФормы.Страницы Тогда			
			ЭлементРодитель.Вид = ВидГруппыФормы.Страница;
		Иначе
			ЭлементРодитель.Вид = ВидГруппыФормы.ОбычнаяГруппа;	
		КонецЕсли;
		ЭлементРодитель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;

	Если ЭлементРодитель = Неопределено Тогда
		ЭлементРодитель = Форма;
	КонецЕсли;
	
	ДекарацияЗаголовокАдресов = Форма.Элементы.Добавить("упоПодсказкаАдреса", Тип("ДекорацияФормы"),ЭлементРодитель);
	ДекарацияЗаголовокАдресов.Заголовок = НСтр("ru = 'Адреса для отправки оповещений:'");
	ДекарацияЗаголовокАдресов.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина);
	
	СчАдресов = 0;
	СообщениеОбОшибках = "";
	ВыборкаАдреса = РезЗапроса[2].Выбрать();
	Пока ВыборкаАдреса.Следующий() Цикл
		
		СчАдресов = СчАдресов + 1;
		
		ТекАдрес = ВычислитьАдресПолучателя(Объект.Ссылка,ПолноеИмяОбъекта,ВидПолучателя,
									ВыборкаАдреса.ВариантХраненияПоляАдреса,ВыборкаАдреса.ПолеАдреса,ВыборкаАдреса.ПолеАдресаХЗ,СообщениеОбОшибках);
										
		Если ПустаяСтрока(ВыборкаАдреса.ОписаниеХраненияАдреса) Тогда
			ХранениеАдреса = НСтр("ru = 'Хранение адреса: '") + ВыборкаАдреса.ПолеАдреса;
		Иначе
			ХранениеАдреса = СокрЛП(ВыборкаАдреса.ОписаниеХраненияАдреса);
		КонецЕсли;
		
		ГруппаАдрес = Форма.Элементы.Добавить("упоГруппаАдресОповещения"+Формат(СчАдресов,"ЧГ=0"), Тип("ГруппаФормы"), ЭлементРодитель);
		ГруппаАдрес.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаАдрес.ОтображатьЗаголовок = Ложь;
		ГруппаАдрес.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаАдрес.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		
		ДекарацияТранспорт = Форма.Элементы.Добавить("упоТранспортОповещения" + Формат(СчАдресов,"ЧГ=0"), Тип("ДекорацияФормы"),ГруппаАдрес);
		ДекарацияТранспорт.Заголовок = СокрЛП(ВыборкаАдреса.Транспорт) + ": ";
				
		ДекарацияАдрес = Форма.Элементы.Добавить("упоАдресОповещения" + Формат(СчАдресов,"ЧГ=0"), Тип("ДекорацияФормы"),ГруппаАдрес);
		ДекарацияАдрес.Заголовок = "" + ТекАдрес + ", ";
		ДекарацияАдрес.ЦветТекста = Новый Цвет(0,0,255);
		
		ДекарацияХранениеАдреса = Форма.Элементы.Добавить("упоХранениеАдресаОповещения" + Формат(СчАдресов,"ЧГ=0"), Тип("ДекорацияФормы"),ГруппаАдрес);
		ДекарацияХранениеАдреса.Заголовок = ХранениеАдреса;
		
	КонецЦикла;

	ТаблицаФормы = Форма.Элементы.Добавить("упоТабВидыСобытий", Тип("ТаблицаФормы"),ЭлементРодитель); 
	//ТаблицаФормы = Форма.Элементы.Добавить("упоТабВидыСобытий", Тип("ТаблицаФормы"),Форма); 
	ТаблицаФормы.ПутьКДанным = "упоПодпискаНаОповещения"; 
	ТаблицаФормы.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет; 
	
	НоваяКолонка = Форма.Элементы.Добавить("Действует", Тип("ПолеФормы"), Форма.Элементы.упоТабВидыСобытий); 
	НоваяКолонка.Заголовок = "Действует"; 
	НоваяКолонка.ПутьКДанным = "упоПодпискаНаОповещения.Действует"; 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеФлажка;

	НоваяКолонка = Форма.Элементы.Добавить("ВидСобытия", Тип("ПолеФормы"), Форма.Элементы.упоТабВидыСобытий); 
	НоваяКолонка.Заголовок = "Событие"; 
	НоваяКолонка.ПутьКДанным = "упоПодпискаНаОповещения.ЗаголовокЭлемента"; 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ТолькоПросмотр = Истина;
	НоваяКолонка.АвтоВысотаЯчейки = Истина;
	
	НоваяКолонка = Форма.Элементы.Добавить("Раздел", Тип("ПолеФормы"), Форма.Элементы.упоТабВидыСобытий); 
	НоваяКолонка.Заголовок = "Раздел"; 
	НоваяКолонка.ПутьКДанным = "упоПодпискаНаОповещения.Раздел"; 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.ТолькоПросмотр = Истина;
	НоваяКолонка.АвтоВысотаЯчейки = Истина;	
	
	НоваяКолонка = Форма.Элементы.Добавить("Принудительное", Тип("ПолеФормы"), Форма.Элементы.упоТабВидыСобытий); 
	НоваяКолонка.Заголовок = "Принудительное"; 
	НоваяКолонка.ПутьКДанным = "упоПодпискаНаОповещения.Принудительное"; 
	НоваяКолонка.Вид = ВидПоляФормы.ПолеФлажка;
	НоваяКолонка.ТолькоПросмотр = Истина;	
	
	НовыйЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	НовыйЭлементУООтбор = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	НовыйЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("упоПодпискаНаОповещения.Принудительное");
	НовыйЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементУООтбор.ПравоеЗначение = Истина;
	
	НовоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("Действует");
	
	// Баг веб-клиента на 8.3.9.2033: программное добавление группы или таблицы в группу или на страницу 
	// вызывает ошибку создания формы, если нет завершающего элемента, добавленного на форму.	
	Если ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент() Тогда
		НадписьВебКлиент = Форма.Элементы.Добавить("упоЭтоВебКлиент", Тип("ДекорацияФормы"));		
		НадписьВебКлиент.Видимость = Ложь;
	КонецЕсли;	
			
КонецПроцедуры 

// Сохраняет подписку.
//
// Параметры:
//  Форма	 - УправляемаяФорма
//  Объект	 - Произвольный	 - объект.
//
Процедура СохранитьПодписку(Форма, Объект) Экспорт

	Если Не упоОповещенияПовтИсп.ПолучитьИспользоватьСобытия() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	РеквизитыФормы = Форма.ПолучитьРеквизиты();
	
	ЕстьРеквизит = Ложь;
	Для Каждого Эл Из РеквизитыФормы Цикл
		Если Эл.Имя = "упоПодпискаНаОповещения" Тогда
			ЕстьРеквизит = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьРеквизит Тогда
		Возврат;
	КонецЕсли;	
	
	ТЗ = Форма.упоПодпискаНаОповещения.Выгрузить(, "ВидСобытия, ВидПолучателя,Действует");
	ТЗ.Колонки.Добавить("Получатель");
	ТЗ.ЗаполнитьЗначения(Объект.Ссылка, "Получатель");
	
	НЗ = РегистрыСведений.упоПодпискиНаОповещения.СоздатьНаборЗаписей();
	НЗ.Отбор.Получатель.Установить(Объект.Ссылка);
	НЗ.Очистить();
	
	НЗ.Загрузить(ТЗ);
	НЗ.Записать(Истина);
	
КонецПроцедуры

// Получает объект ДокументHTML из текста HTML.
//
// Параметры:
//  ТекстHTML	 - Строка
//  Кодировка	 - Строка
// 
// Возвращаемое значение:
//  ДокументHTML - созданный документ HTML.
//
Функция ПолучитьОбъектДокументHTMLИзТекстаHTML(ТекстHTML,Кодировка = Неопределено) Экспорт
	
	Построитель = Новый ПостроительDOM;
	ЧтениеHTML = Новый ЧтениеHTML;
	
	НовыйТекстHTML = ТекстHTML;
	ПозицияОткрытиеXML = Найти(НовыйТекстHTML,"<?xml");
	
	Если ПозицияОткрытиеXML > 0 Тогда
		
		ПозицияЗакрытиеXML = Найти(НовыйТекстHTML,"?>");
		Если ПозицияЗакрытиеXML > 0 Тогда
			
			НовыйТекстHTML = ЛЕВ(НовыйТекстHTML,ПозицияОткрытиеXML - 1) + ПРАВ(НовыйТекстHTML,СтрДлина(НовыйТекстHTML) - ПозицияЗакрытиеXML -1);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Кодировка = Неопределено Тогда
		ЧтениеHTML.УстановитьСтроку(ТекстHTML);
	Иначе
		ЧтениеHTML.УстановитьСтроку(ТекстHTML, Кодировка);
	КонецЕсли;
	
	Возврат Построитель.Прочитать(ЧтениеHTML);
	
КонецФункции

// Заменяет имена картинок в документ HTML на идентификаторы почтовых вложений.
//
// Параметры:
//  ДокументHTML - ДокументHTML - документ HTML в котором будет выполняться замена.
//  ТаблицаСоответствий - ТаблицаЗначений - таблица соответствий имен файлов и идентификаторов.
//
Процедура ЗаменитьИменаКартинокНаИдентификаторыПочтовыхВложенийВHTML(ДокументHTML, ТаблицаСоответствий) Экспорт
	
	Для каждого Картинка Из ДокументHTML.Картинки Цикл
		
		АтрибутИсточникКартинки = Картинка.Атрибуты.ПолучитьИменованныйЭлемент("src");
		
		НайденнаяСтрока = ТаблицаСоответствий.Найти(АтрибутИсточникКартинки.ТекстовоеСодержимое,"ИмяФайла");
		Если НайденнаяСтрока <> Неопределено Тогда
			
			НовыйАтрибутКартинки = АтрибутИсточникКартинки.КлонироватьУзел(Ложь);
			НовыйАтрибутКартинки.ТекстовоеСодержимое = Строка("cid:"+НайденнаяСтрока.ИдентификаторФайлаДляHTML);
			Картинка.Атрибуты.УстановитьИменованныйЭлемент(НовыйАтрибутКартинки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Получает текст HTML из объекта ДокументHTML.
//
// Параметры:
//  ДокументHTML  - ДокументHTML - документ, из которого будет извлекаться текст.
//
// Возвращаемое значение:
//   Строка   - текст HTML.
//
Функция ПолучитьТекстHTMLИзОбъектаДокументHTML(ДокументHTML) Экспорт
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьHTML = Новый ЗаписьHTML;
	ЗаписьHTML.УстановитьСтроку();
	ЗаписьDOM.Записать(ДокументHTML,ЗаписьHTML);
	Возврат ЗаписьHTML.Закрыть();
	
КонецФункции

// Обрабатывает текст HTML для помещения в форматированный документ.
//
// Параметры:
//  Письмо				 - Произвольный - ДокументСсылка.ЭлектронноеПисьмоВходящее,
//  			ДокументСсылка.ЭлектронноеПисьмоИсходящее: письмо для которого будет проведена оценка.
//  ТекстHTML			 - Строка	 - обрабатываемый текст HTML.
//  СтруктураВложений	 - Структура - структура в которую помещаются картинки - вложения письма.
// 
// Возвращаемое значение:
//  Число - оценка размера письма в байтах.
//
Функция ОбработатьТекстHTMLДляФорматированногоДокумента(Письмо, ТекстHTML, СтруктураВложений) Экспорт
	
	Если Не ПустаяСтрока(ТекстHTML) Тогда
		
		ДокументHTML = ПолучитьОбъектДокументHTMLИзТекстаHTML(ТекстHTML);

		Возврат ТекстHTML;
			
	Иначе
		
		Возврат ТекстHTML;
		
	КонецЕсли;
	
КонецФункции

