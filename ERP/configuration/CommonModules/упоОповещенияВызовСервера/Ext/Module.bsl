// Получает диспетчеров трудового ресурса, подписанных на событие.
//
// Параметры:
//  Источник	 - Строка	 - источник вида события.
//  пВхПараметр	 - 			 - СправочникСсылка.упоТрудовыеРесурсы, Массив - трудовой ресурс.
// 
// Возвращаемое значение:
//  Массив - пользователи.
//
Функция ПолучитьДиспетчеровТрудовогоРесурсаПодписанныхНаСобытие(Источник, пВхПараметр) Экспорт
		
	Запрос = Новый Запрос;
        
	Если ТипЗнч(пВхПараметр) = Тип("Массив") Тогда
		вхМассив = Истина;
		Запрос.УстановитьПараметр("МассивРесурсов", пВхПараметр);
	Иначе
		вхМассив = Ложь;
		Запрос.УстановитьПараметр("ТрудовойРесурс", пВхПараметр);
    КонецЕсли;
    
    Запрос.УстановитьПараметр("Источник", Источник.Метаданные().ПолноеИмя());
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   РегТР.Сотрудник КАК Сотрудник
        |ПОМЕСТИТЬ Сотрудники
        |ИЗ
        |   РегистрСведений.упоВладениеРесурсами.СрезПоследних(, Ресурс = &ТрудовойРесурс) КАК РегТР
        |ГДЕ
        |   РегТР.ВладеетРесурсом
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
        |   упоДиспетчерыСистемыСрезПоследних.Пользователь КАК Пользователь,
        |   упоДиспетчерыСистемыСрезПоследних.Сотрудник КАК Сотрудник
        |ПОМЕСТИТЬ ВТ_ДиспетчерыТР
        |ИЗ
        |   РегистрСведений.упоДиспетчерыСистемы.СрезПоследних(
        |           ,
        |           Сотрудник В
        |               (ВЫБРАТЬ
        |                   Сотрудники.Сотрудник
        |               ИЗ
        |                   Сотрудники)) КАК упоДиспетчерыСистемыСрезПоследних
        |ГДЕ
        |   упоДиспетчерыСистемыСрезПоследних.ФлагУправления
        |   И НЕ упоДиспетчерыСистемыСрезПоследних.Пользователь.ПометкаУдаления
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   ВЫРАЗИТЬ(упоПодпискиНаОповещения.Получатель КАК Справочник.Пользователи) КАК Пользователь
        |ИЗ
        |   РегистрСведений.упоПодпискиНаОповещения КАК упоПодпискиНаОповещения
        |ГДЕ
        |   упоПодпискиНаОповещения.ВидСобытия.Источник = &Источник
        |   И упоПодпискиНаОповещения.Получатель В
        |           (ВЫБРАТЬ
        |               ВТ_ДиспетчерыТР.Пользователь КАК Пользователь
        |           ИЗ
        |               ВТ_ДиспетчерыТР КАК ВТ_ДиспетчерыТР)
        |   И упоПодпискиНаОповещения.Действует";
	
	Если вхМассив Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Ресурс = &ТрудовойРесурс", "Ресурс В (&МассивРесурсов)");
	КонецЕсли;
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Если вхМассив Тогда
		Возврат ТаблицаРезультат;
	Иначе
		Возврат ТаблицаРезультат.ВыгрузитьКолонку("Пользователь");
	КонецЕсли;
	
КонецФункции

// Получает список доступных таблиц.
//
// Параметры:
//  Параметры	 - Структура
//  БезТабЧастей - Булево
// 
// Возвращаемое значение:
//  СписокЗначений - список таблиц.
//
Функция ПолучитьСписокДоступныхТаблиц(Параметры = Неопределено, БезТабЧастей = Ложь) Экспорт
	
	масНужныеТипы = Неопределено;
	масНужныеТаблицы = Неопределено;
	масТаблицыИсключения = Неопределено;
	СокрПредставление = Неопределено;
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Параметры.Свойство("масНужныеТипы",масНужныеТипы);
		Параметры.Свойство("масНужныеТаблицы",масНужныеТаблицы);
		Параметры.Свойство("масТаблицыИсключения",масТаблицыИсключения);
		Параметры.Свойство("СокрПредставление",СокрПредставление);
	КонецЕсли;

	Если ТипЗнч(масНужныеТипы) = Тип("Массив") Тогда
		НужныеТипы = СтрСоединить(масНужныеТипы,",");
	Иначе
		НужныеТипы = "";
	КонецЕсли;
	
	Если ТипЗнч(масНужныеТаблицы) = Тип("Массив") Тогда
		НужныеТаблицы = СтрСоединить(масНужныеТаблицы,",");
	Иначе
		НужныеТаблицы = "";
	КонецЕсли;
	
	Если ТипЗнч(масТаблицыИсключения) = Тип("Массив") Тогда
		ТаблицыИсключения = СтрСоединить(масТаблицыИсключения,",");
	Иначе
		ТаблицыИсключения = "";
	КонецЕсли;
	
	Если СокрПредставление = Неопределено Тогда
		СокрПредставление = Ложь;
	КонецЕсли;
	
	Возврат упоОповещенияПовтИсп.ПолучитьСписокДоступныхТаблиц(НужныеТипы,
		НужныеТаблицы,
		ТаблицыИсключения,
		СокрПредставление,
		БезТабЧастей);
	
КонецФункции

