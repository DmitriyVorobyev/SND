// Проверяет, является ли переданный параметр ссылкой.
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипа
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ЭтоОписаниеТипаСсылка(ОписаниеТипа) Экспорт
	
	Рез = Истина;
	
	Если ОписаниеТипа.СодержитТип(Тип("Булево")) Тогда
		Рез = Ложь;
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Число")) Тогда
		Рез = Ложь;
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Дата")) Тогда
		Рез = Ложь;
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Строка")) Тогда
		Рез = Ложь;
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
		Рез = Ложь;
	КонецЕсли;	
		
	Возврат Рез;
		
КонецФункции

// Проверяет, является ли переданный параметр ссылкой.
//
// Параметры:
//  Тип	 - Тип	 - проверяемый тип.
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ЭтотТипСсылка(Тип) Экспорт
	
	Рез = Истина;
	
	Если Тип = Тип("Булево") Тогда
		Рез = Ложь;
	ИначеЕсли Тип = Тип("Число") Тогда
		Рез = Ложь;
	ИначеЕсли Тип = Тип("Дата") Тогда
		Рез = Ложь;
	ИначеЕсли Тип = Тип("Строка") Тогда
		Рез = Ложь;
	ИначеЕсли Тип = Тип("УникальныйИдентификатор") Тогда
		Рез = Ложь;
	КонецЕсли;	
		
	Возврат Рез;
		
КонецФункции

