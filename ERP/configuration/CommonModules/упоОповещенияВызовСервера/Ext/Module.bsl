#Область ОбработчикиРегламентныхЗаданий

// Отработка регламентного задания.
//
// Параметры:
//  ВидСобытия	 - СправочникСсылка.упоВидыСобытий
//
Процедура ОбработкаДетекторовСобытий(ВидСобытия) Экспорт
	
	Если Не упоОповещенияПовтИсп.ИспользоватьОповещения() Тогда
		Возврат;
	КонецЕсли;	
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.упоОбработкаДетекторовСобытий);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидСобытия", ВидСобытия);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытий.Ссылка КАК ВидСобытия,
	               |	упоВидыСобытий.ЛогикаПримененияУсловийРегистрацииСобытия КАК ЛогикаПримененияУсловий,
	               |	упоВидыСобытий.ДетекторСобытия,
	               |	упоВидыСобытий.КодОпределенияДопПараметра
	               |ИЗ
	               |	Справочник.упоВидыСобытий КАК упоВидыСобытий
	               |ГДЕ
	               |	упоВидыСобытий.Ссылка = &ВидСобытия
	               |	И упоВидыСобытий.Используется
	               |	И НЕ упоВидыСобытий.ПометкаУдаления
	               |	И упоВидыСобытий.СпособОтслеживанияСобытия = ЗНАЧЕНИЕ(Перечисление.упоСпособыОтслеживанияСобытий.ПоРасписанию)";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(ВидСобытия);
	
	Пока Выборка.Следующий() Цикл
		
		КодОпределенияДопПараметра = Выборка.КодОпределенияДопПараметра;
		Результат = Ложь; 
		ПараметрыВозврата = Новый Структура;
		
		Источник = Неопределено;
		
		Попытка
	    	ВыполнитьКод(Выборка.ДетекторСобытия, Результат, ПараметрыВозврата, Источник,,, ПараметрыВыполненияКода);
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Обработка детекторов событий'"), УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Справочники.упоВидыСобытий, Выборка.ВидСобытия, СообщениеОбОшибке);
			Результат = Ложь;	
		КонецПопытки;
		
		Если Результат = Истина Тогда
			
			КоличествоСтандартных = 0;
			
			Если ПараметрыВозврата.Свойство("Источник") Тогда
				Источник = ПараметрыВозврата.Источник; 
				КоличествоСтандартных = КоличествоСтандартных + 1;
			КонецЕсли;
			
			Если Источник <> Неопределено Тогда
				Если ТипЗнч(Источник) = Тип("Массив") Тогда
					МассивИсточников = Источник;	
				Иначе
					МассивИсточников = Новый Массив;
					МассивИсточников.Добавить(Источник);
				КонецЕсли;
			Иначе
				МассивИсточников = Новый Массив;
				МассивИсточников.Добавить(Неопределено);
			КонецЕсли;
			
			Если ПараметрыВозврата.Свойство("Автор") Тогда
				Автор = ПараметрыВозврата.Автор;
				КоличествоСтандартных = КоличествоСтандартных + 1;
			Иначе
				Автор = Справочники.Пользователи.ПустаяСсылка();
			КонецЕсли;				
				
			Если ПараметрыВозврата.Количество() > КоличествоСтандартных Тогда
				
				// Тут формируем КонтекстСобытия (XML).
				ИнформацияДляЗаписиXML = Новый ЗаписьXML;
				ИнформацияДляЗаписиXML.УстановитьСтроку();  
				
				НовыйСериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO);  
				НовыйСериализаторXDTO.ЗаписатьXML(ИнформацияДляЗаписиXML, ПараметрыВозврата, НазначениеТипаXML.Явное);  
				
				СтрокаXML = ИнформацияДляЗаписиXML.Закрыть(); 
				КонтекстСобытия = Новый ХранилищеЗначения(СтрокаXML);
				
			Иначе
				
				КонтекстСобытия = Неопределено;
				
			КонецЕсли;				
			
			Для Каждого ИсточникСсылка Из МассивИсточников Цикл			
				
				МассивДопПараметровИсточника = ПолучитьМассивДопПараметровИсточника(Выборка.ВидСобытия,КодОпределенияДопПараметра, 
																								ИсточникСсылка, ПараметрыВыполненияКода);
								
				Для Каждого ИсточникДопПараметр Из МассивДопПараметровИсточника Цикл
					
					ПолноеИмяОбъекта = Неопределено;							
					Регистрируем = Истина;	
					
					Если ЗначениеЗаполнено(ИсточникСсылка) Тогда
						ПолноеИмяОбъекта = ИсточникСсылка.Метаданные().ПолноеИмя();
						УсловияСобытия = Новый Массив;
						Для Каждого СтрТЧ Из Выборка.ВидСобытия.УсловияРегистрацииСобытия Цикл
							Если СтрТЧ.Используется Тогда
								УсловияСобытия.Добавить(Новый Структура("РеквизитОбъекта,ВидСравнения,ЗначениеУсловия,ПроверкаПоКоду,ВыполняемыйКод",
								СтрТЧ.РеквизитОбъекта,
								СтрТЧ.ВидСравнения,
								СтрТЧ.ЗначениеУсловия,
								СтрТЧ.ПроверкаПоКоду,
								СтрТЧ.ВыполняемыйКод));	
							КонецЕсли;
						КонецЦикла;
						
						Если Не ПроверитьУсловияРегистрацииСобытияДляОбъекта(ИсточникСсылка, ИсточникДопПараметр, Выборка.ВидСобытия, ПолноеИмяОбъекта, 
							Выборка.ЛогикаПримененияУсловий, УсловияСобытия,, 
							ПараметрыВыполненияКода) Тогда
							Регистрируем = Ложь;
						КонецЕсли;
						
					КонецЕсли;
					
					Если Регистрируем Тогда
						Справочники.упоПроизошедшиеСобытия.ЗарегистрироватьСобытие(Выборка.ВидСобытия, ИсточникСсылка, ИсточникДопПараметр, ПолноеИмяОбъекта, КонтекстСобытия, Автор);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

// Отработка регламентного задания.
//
Процедура упоОбработкаПроизошедшихСобытий() Экспорт
	
	Если Не упоОповещенияПовтИсп.ИспользоватьОповещения() Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.упоОбработкаПроизошедшихСобытий);
	
	упоОбработкаПроизошедшихСобытийСПараметрами();
	
КонецПроцедуры

// Отработка регламентного задания.
//
Процедура упоОтправкаСообщенийИзОчереди() Экспорт
	
	Если НЕ упоОповещенияПовтИсп.ИспользоватьОповещения() Тогда
		Возврат;
	КонецЕсли;	
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.упоОтправкаСообщенийИзОчереди);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("СообщениеОбОшибках", "");
	
	КэшЗначений = Новый Структура;
	
	НедоступныеТранспортыОтправкиОповещений = НедоступныеТранспортыОтправкиОповещенийПроверкаИТС();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 200
	|	упоОчередьСобытийДляОповещений.ВидСобытия КАК ВидСобытия,
	|	упоОчередьСобытийДляОповещений.Источник КАК Источник,
	|	упоОчередьСобытийДляОповещений.ИсточникДопПараметр КАК ИсточникДопПараметр,
	|	упоОчередьСобытийДляОповещений.ВидПолучателя КАК ВидПолучателя,
	|	упоОчередьСобытийДляОповещений.Получатель КАК Получатель,
	|	упоОчередьСобытийДляОповещений.Транспорт КАК Транспорт,
	|	упоОчередьСобытийДляОповещений.ИдентификаторСобытия КАК ИдентификаторСобытия,
	|	упоОчередьСобытийДляОповещений.ДатаОтправки КАК ДатаОтправки,
	|	упоОчередьСобытийДляОповещений.Текст КАК Текст,
	|	упоОчередьСобытийДляОповещений.ТекстHTML КАК ТекстHTML,
	|	упоОчередьСобытийДляОповещений.Тема КАК Тема,
	|	упоОчередьСобытийДляОповещений.ДатаВозникновения КАК ДатаВозникновения,
	|	упоОчередьСобытийДляОповещений.Автор КАК Автор
	|ИЗ
	|	РегистрСведений.упоОчередьСобытийДляОповещений КАК упоОчередьСобытийДляОповещений
	|ГДЕ
	|	упоОчередьСобытийДляОповещений.ДатаОтправки = &ПустаяДата
	|	И НЕ упоОчередьСобытийДляОповещений.Транспорт.Ссылка В (&НедоступныеТранспортыОтправкиОповещений)
	|	И ВЫБОР
	|			КОГДА упоОчередьСобытийДляОповещений.ДатаВозникновения = &ПустаяДата
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ упоОчередьСобытийДляОповещений.ДатаВозникновения <= &ТекущаяДата
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА упоОчередьСобытийДляОповещений.ДатаАктуальностиОтправки = &ПустаяДата
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ упоОчередьСобытийДляОповещений.ДатаАктуальностиОтправки >= &ТекущаяДата
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА упоОчередьСобытийДляОповещений.КоличествоПопытокОтправки > 0
	|				ТОГДА упоОчередьСобытийДляОповещений.КоличествоПопытокОтправки > упоОчередьСобытийДляОповещений.СчетчикПопытокОтправки
	|			КОГДА упоОчередьСобытийДляОповещений.КоличествоПопытокОтправки = 0
	|				ТОГДА упоОчередьСобытийДляОповещений.СчетчикПопытокОтправки <= 3
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДата());
	Запрос.УстановитьПараметр("НедоступныеТранспортыОтправкиОповещений", НедоступныеТранспортыОтправкиОповещений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		УспешнаяОтправка = Ложь;
		ТекстОшибки = "";
		
		Попытка
			
			ДопПараметры.Вставить("ШаблонТекста", Выборка.Текст);
			ДопПараметры.Вставить("ШаблонТекстаHTML", Выборка.ТекстHTML);
			ДопПараметры.Вставить("ШаблонТемы" ,Выборка.Тема);
			ДопПараметры.Вставить("Автор", Выборка.Автор);
			ДопПараметры.Вставить("ДатаВозникновения", Выборка.ДатаВозникновения);
			ДопПараметры.Вставить("ИдентификаторСобытия", Выборка.ИдентификаторСобытия);
			ДопПараметры.Вставить("ДатаОтправки", Неопределено);
			ДопПараметры.Вставить("СообщениеОбОшибке", "");
			
			ИдентификаторСообщения = ОтправитьСообщение(Выборка.ВидСобытия,
			Выборка.Источник,
			Выборка.ИсточникДопПараметр,
			Выборка.ВидПолучателя,
			Выборка.Получатель,
			Выборка.Транспорт,
			ДопПараметры,
			,
			КэшЗначений);														
			
			УспешнаяОтправка = ЗначениеЗаполнено(ИдентификаторСообщения);
			
			Если УспешнаяОтправка Тогда						
				МЗ = РегистрыСведений.упоОчередьСобытийДляОповещений.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МЗ,Выборка);
				МЗ.Прочитать();
				МЗ.Удалить();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();			     
			
			ТекстОшибки = ДопПараметры.СообщениеОбОшибке;
			
		Исключение
			
			ОтменитьТранзакцию();
			
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Обработка очереди оповещений'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.РегистрыСведений.упоОчередьСобытийДляОповещений, Выборка.ВидСобытия, СообщениеОбОшибке);
			
			ТекстОшибки = СообщениеОбОшибке; 
			
		КонецПопытки;
		
		Если Не УспешнаяОтправка Тогда
			
			Попытка
				МЗ = РегистрыСведений.упоОчередьСобытийДляОповещений.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МЗ, Выборка);
				МЗ.Прочитать();
				МЗ.СчетчикПопытокОтправки = МЗ.СчетчикПопытокОтправки + 1;
				МЗ.ТекстОшибки = ТекстОшибки;
				МЗ.Записать(Истина);
			Исключение 
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(НСтр("ru='Обработка очереди оповещений'"),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.РегистрыСведений.упоОчередьСобытийДляОповещений,
				Выборка.ВидСобытия, СообщениеОбОшибке);
			КонецПопытки;	
			
		КонецЕсли;
		
		Если Не ПустаяСтрока(ДопПараметры.СообщениеОбОшибках) Тогда
			ЗаписьЖурналаРегистрации(НСтр("ru='Обработка очереди оповещений'"),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.упоОчередьСобытийДляОповещений,
			Выборка.ВидСобытия,
			ДопПараметры.СообщениеОбОшибках);	
		КонецЕсли;
		
	КонецЦикла;	
	
	ОчисткаОтправленныхСообщений();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПодписок

// Обработчик оповещения "Перед записью" преподобного справочника.
//
// Параметры:
//  Источник - Произвольный	 - справочник или подобное.
//  Отказ	 - Булево		 - признак отказа от записи.
//
Процедура упоОповещенияПередЗаписьюСправочникаИлиПодобного(Источник, Отказ) Экспорт
	
	Если НЕ ОбработкаСобытияДопустима(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	масВариантыИзменения = Новый Массив;
	
	ОпределитьВариантИзмененияПередЗаписью(Источник, масВариантыИзменения);
	
	ДобавитьВидыСобытийВДопСвойстваОбъекта(Источник, масВариантыИзменения);
	
КонецПроцедуры

// Обработчик оповещения "Перед записью" документа.
//
// Параметры:
//  Источник		 - ДокументСсылка	 	 	 - документ.
//  Отказ			 - Булево			 	 	 - признак отказа от записи.
//  РежимЗаписи		 - РежимЗаписиДокумента	 	 - режим записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - режим проведения документа.
//
Процедура упоОповещенияПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если НЕ ОбработкаСобытияДопустима(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	масВариантыИзменения = Новый Массив;
		
	ОпределитьВариантИзмененияПередЗаписью(Источник, масВариантыИзменения, РежимЗаписи);
	
	ДобавитьВидыСобытийВДопСвойстваОбъекта(Источник, масВариантыИзменения);
	
КонецПроцедуры

// Обработчик оповещения "Перед записью" в регистр.
//
// Параметры:
//  Источник	 - Произвольный	 - источник записи.
//  Отказ		 - Булево		 - признак отказа от записи.
//  Замещение	 - Булево		 - признак замещения записи.
//
Процедура упоОповещенияПередЗаписьюВРегистр(Источник, Отказ, Замещение) Экспорт
	
	Если НЕ ОбработкаСобытияДопустима(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Источник.ДополнительныеСвойства.Вставить("ЭтоРегистр", Истина);
	
	масВариантыИзменения = Новый Массив;
	
	ОпределитьВариантИзмененияПередЗаписьюВРегистр(Источник, масВариантыИзменения);
	
	ДобавитьВидыСобытийВДопСвойстваОбъекта(Источник, масВариантыИзменения);
	
КонецПроцедуры

// Обработчик оповещения "При записи".
//
// Параметры:
//  Источник - Произвольный	 - источник события.
//  Отказ	 - Булево	 	 - признак отказа.
//
Процедура упоОповещенияПриЗаписи(Источник, Отказ) Экспорт
	
	Если НЕ ОбработкаСобытияДопустима(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьСобытияПриЗаписи(Источник);
		
КонецПроцедуры

// Обработчик оповещения "При записи" в регистр.
//
// Параметры:
//  Источник	 - Произвольный	 - источник события.
//  Отказ		 - Булево	 - признак отказа.
//  Замещение	 - Булево	 - признак замещения.
//
Процедура упоОповещенияПриЗаписиВРегистр(Источник, Отказ, Замещение) Экспорт
	
	Если НЕ ОбработкаСобытияДопустима(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗарегистрироватьСобытияПриЗаписи(Источник);
	
КонецПроцедуры

// Обработчик "Перед записью" типовых оповещений.
//
// Параметры:
//  ЭтотОбъект	 - Произвольный	 - объект
//  Отказ		 - Булево		 - признак отказа.
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция ПередЗаписьюТиповыхОповещений(ЭтотОбъект, Отказ) Экспорт
	
	// Временное решение.
	Если ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтотОбъект.Предопределенный 
		И Не (ЭтотОбъект.ДополнительныеСвойства.Свойство("ОбновлениеТиповыхОповещений") 
		И ЭтотОбъект.ДополнительныеСвойства.ОбновлениеТиповыхОповещений) Тогда
		
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Запрещено изменение типовых оповещений!'");
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецФункции

// Обработчик "При создании на сервере" форм типовых оповещений.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма	 - форма.
//  Объект	 - Произвольный	 	 - объект.
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция ПриСозданииНаСервереФормТиповыхОповещений(ЭтаФорма, Объект = Неопределено) Экспорт
	
	Если Найти(ЭтаФорма.ИмяФормы, "упоТранспортОповещений") <> 0 Тогда
		
	ИначеЕсли Объект <> Неопределено И Объект.Предопределенный Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

// Актуализирует регламентные задания детекторов событий.
//
// Параметры:
//  ВидыСобытийДляОбновления -  СправочникСсылка.упоВидыСобытий, Массив из СправочникСсылка.упоВидыСобытий - элемент или список видов событий.
// 
Процедура ОбновитьРегламентныеЗаданияДетекторов(ВидыСобытийДляОбновления) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбновитьВсе = Не ЗначениеЗаполнено(ВидыСобытийДляОбновления);
	Если Не ОбновитьВсе И ТипЗнч(ВидыСобытийДляОбновления) <> Тип("Массив") Тогда
		ВидыСобытийОтбор = Новый Массив;
		ВидыСобытийОтбор.Добавить(ВидыСобытийДляОбновления);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	упоВидыСобытий.Ссылка КАК Ссылка,
	               |	упоВидыСобытий.РасписаниеДетектора КАК РасписаниеДетектора,
	               |	упоВидыСобытий.Используется КАК Используется,
				   |	упоВидыСобытий.ПометкаУдаления КАК ПометкаУдаления,
	               |	упоВидыСобытий.СпособОтслеживанияСобытия КАК СпособОтслеживанияСобытия
	               |ИЗ
	               |	Справочник.упоВидыСобытий КАК упоВидыСобытий
	               |ГДЕ
	               |	%1";
		
	ТекстУсловия = ?(ОбновитьВсе, "ИСТИНА", "упоВидыСобытий.Ссылка В (&ВидыСобытийОтбор)");
	Запрос.Текст = СтрШаблон(ТекстЗапроса, ТекстУсловия);
	Запрос.УстановитьПараметр("ВидыСобытийОтбор", ВидыСобытийОтбор);
	
	ТаблицаАктуальных = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура("Метаданные", Метаданные.РегламентныеЗадания.упоОбработкаДетекторовСобытий);
	ШаблонНаименованияЗадания = НСтр("ru = 'Детектор оповещения: ""%1""'");
	
	Для Каждого СтрокаАктуальных Из ТаблицаАктуальных Цикл
		
		ВидСобытия = СтрокаАктуальных.Ссылка;
		УИ = ВидСобытия.УникальныйИдентификатор();
		
		Отбор.Вставить("Ключ", УИ);
		ЗаданияСобытия = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
		
		Если СтрокаАктуальных.СпособОтслеживанияСобытия = Перечисления.упоСпособыОтслеживанияСобытий.ПоРасписанию
			И Не СтрокаАктуальных.ПометкаУдаления Тогда
			ТребуемоеКоличествоРегЗаданий = 1;
		Иначе
			ТребуемоеКоличествоРегЗаданий = 0;
		КонецЕсли;
		
		Пока ЗаданияСобытия.Количество() > ТребуемоеКоличествоРегЗаданий Цикл
			Задание = ЗаданияСобытия[0];
			ЗаданияСобытия.Удалить(0);
			Задание.Удалить();
		КонецЦикла;
		
		Если ТребуемоеКоличествоРегЗаданий = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаданияСобытия.Количество() > 0 Тогда
			Задание = ЗаданияСобытия[0];
		Иначе
			Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(
				Метаданные.РегламентныеЗадания.упоОбработкаДетекторовСобытий);
		КонецЕсли;
		
		Параметры = Новый Массив;
		Параметры.Добавить(ВидСобытия);		
		
		Расписание = СтрокаАктуальных.РасписаниеДетектора.Получить();
		Если Расписание = Неопределено Тогда
			Расписание = РасписаниеПоУмолчанию();
		КонецЕсли;
		
		Задание.Наименование = СтрШаблон(ШаблонНаименованияЗадания, ВидСобытия);
		Задание.Ключ = УИ;		
		Задание.Параметры = Параметры;
		Задание.Расписание = Расписание;
		Задание.Использование = СтрокаАктуальных.Используется; 
		
		Задание.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Расписание регламентного задания по умолчанию.
// 
// Возвращаемое значение:
//  РасписаниеРегламентногоЗадания - Расписание регламентного задания.
//
Функция РасписаниеПоУмолчанию() Экспорт
	Расписание = Новый РасписаниеРегламентногоЗадания();
	Расписание.ПериодПовтораДней = 1;
	//Расписание.ПериодПовтораВТечениеДня = 3600;
	Возврат Расписание;
КонецФункции 

// Получает массив модулей транспортов.
// 
// Возвращаемое значение:
//  Массив - массив модулей.
//
Функция ПолучитьМассивМодулейТранспортов() Экспорт
	
	МассивМодулей = Новый Массив;
	
	ОбщиеМодули = Метаданные.ОбщиеМодули;
	
	Для каждого Эл Из ОбщиеМодули Цикл
		Если Лев(Эл.Имя, 20) = "упоОтправкаСообщений" Тогда
			МассивМодулей.Добавить(Эл.Имя);	
		КонецЕсли;
	КонецЦикла;	
	
	Возврат МассивМодулей;
	
КонецФункции 

// Включает/выключает вид события.
//
// Параметры:
//  Событие	 - ДокументСсылка, СправоникСсылка	 - событие.
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция ВключитьВыключитьВидСобытия(Событие) Экспорт
	
	обСобытие = Событие.ПолучитьОбъект();	
	обСобытие.Используется = Не обСобытие.Используется;
	обСобытие.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	обСобытие.Записать();
	
КонецФункции

// Очищает отправленные сообщения.
//
Процедура ОчисткаОтправленныхСообщений() Экспорт
	
	Если НЕ упоОповещенияПовтИсп.ИспользоватьОповещения() Тогда
		Возврат;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекДата = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	упоВидыСобытий.Ссылка КАК ВидСобытия,
					|	ВЫБОР
					|		КОГДА ISNULL(упоВидыСобытий.СрокХраненияОповещений, 0) = 0
					|			ТОГДА ISNULL(упоСрокХраненияОповещений.Значение,0)
					|		ИНАЧЕ ISNULL(упоВидыСобытий.СрокХраненияОповещений, 0)
					|	КОНЕЦ КАК СрокХранения,
					|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДатаОтсечения
					|ИЗ
					|	Справочник.упоВидыСобытий КАК упоВидыСобытий,
					|	Константа.упоСрокХраненияОповещений КАК упоСрокХраненияОповещений";
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрТз Из ТЗ Цикл
		СтрТз.ДатаОтсечения = ТекДата - СтрТз.СрокХранения * 86400;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВтСрокиХранения ИЗ &тз КАК тз";
	Запрос.УстановитьПараметр("тз", ТЗ);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 100
					|	упоОтправленныеСообщения.ВидСобытия,
					|	упоОтправленныеСообщения.Источник,
					|	упоОтправленныеСообщения.ИсточникДопПараметр,
					|	упоОтправленныеСообщения.ВидПолучателя,
					|	упоОтправленныеСообщения.Получатель,
					|	упоОтправленныеСообщения.Транспорт,
					|	упоОтправленныеСообщения.ИдентификаторСобытия,
					|	упоОтправленныеСообщения.ДатаОтправки
					|ИЗ
					|	РегистрСведений.упоОтправленныеСообщения КАК упоОтправленныеСообщения
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтСрокиХранения КАК ВтСрокиХранения
					|		ПО упоОтправленныеСообщения.ВидСобытия = ВтСрокиХранения.ВидСобытия
					|ГДЕ
					|	ВЫБОР
					|			КОГДА ВтСрокиХранения.СрокХранения = 0
					|				ТОГДА ЛОЖЬ
					|			ИНАЧЕ упоОтправленныеСообщения.ДатаОтправки < ВтСрокиХранения.ДатаОтсечения
					|		КОНЕЦ";
	
	Пока Истина Цикл // В цикле получаем порциями по 100 необработанные события, пока есть что обрабатывать.
		
		Таблица = Запрос.Выполнить().Выгрузить();	
		Если Таблица.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;	
		
		Для Каждого Строка Из Таблица Цикл
			
			НачатьТранзакцию();
			Попытка
				
				МЗ = РегистрыСведений.упоОтправленныеСообщения.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(МЗ,Строка);
				МЗ.Прочитать();
				МЗ.Удалить();
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				
				ОтменитьТранзакцию();
				
				СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(НСтр("ru='Обработка отправленных сообщений'"),
					УровеньЖурналаРегистрации.Ошибка, 
					Метаданные.РегистрыСведений.упоОтправленныеСообщения,
					Строка.ВидСобытия,
					СообщениеОбОшибке);
				
			КонецПопытки;
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет код.
//
// Параметры:
//  ВыполняемыйКод			 - Строка
//  ТекстУспешногоЗавершения - Строка
//  Источник				 - ЛюбаяСсылка
//  ИсточникДопПараметр		 - ЛюбаяСсылка, Булево, Строка, Дата, Число
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ПроверитьКод(ВыполняемыйКод, ТекстУспешногоЗавершения, Источник = Неопределено, ИсточникДопПараметр = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь; 
	ПараметрыВозврата = Новый Структура;
	
	ДанныеДоИзменения = Неопределено;
	
	ПараметрыВыполненияКода = Новый Структура;
	
	Попытка
		
		Выполнить(ВыполняемыйКод);
		
		ТекстУспешногоЗавершения = НСтр("ru = 'Результат = '") + Строка(Результат) + Символы.ПС;
		
		СтрокаПараметров = "";
		Для Каждого Пара Из ПараметрыВозврата Цикл
			
			Если Не ПустаяСтрока(СтрокаПараметров) Тогда
				СтрокаПараметров = СтрокаПараметров + Символы.ПС;
			КонецЕсли;	
			
			СтрокаПараметров = СтрокаПараметров + Строка(Пара.Ключ) + "=" + Строка(Пара.Значение);
			
		КонецЦикла;	
		
		ТекстУспешногоЗавершения = ТекстУспешногоЗавершения
			+ НСтр("ru = 'ПараметрыВозврата: '")
			+ Символы.ПС
			+ Строка(СтрокаПараметров)
			+ Символы.ПС;
			
		ТекстУспешногоЗавершения = ТекстУспешногоЗавершения
			+ НСтр("ru = 'Источник = '") + Источник;
			
			
		ТекстИсточникДопПараметр = "";
		Если ТипЗнч(ИсточникДопПараметр) = Тип("Массив") Тогда	 
			Для Каждого тДопПараметр Из ИсточникДопПараметр Цикл
				ТекстИсточникДопПараметр = ТекстИсточникДопПараметр + ?(ЗначениеЗаполнено(ТекстИсточникДопПараметр), ", ", "") + тДопПараметр;
			КонецЦикла;
		Иначе
			ТекстИсточникДопПараметр = "" + ИсточникДопПараметр; 
		КонецЕсли;	
		ТекстИсточникДопПараметр = НСтр("ru = 'Источник доп. параметр = '") + ТекстИсточникДопПараметр;	
		
		ТекстУспешногоЗавершения = ТекстУспешногоЗавершения + Символы.ПС + ТекстИсточникДопПараметр; 
			
		Возврат Истина;
		
	Исключение
		
		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = '" + СообщениеОбОшибке + "'");
		Сообщение.Сообщить();
				
		Возврат Ложь;
		
	КонецПопытки;	
	
КонецФункции

// Выполняет код.
//
// Параметры:
//  ВыполняемыйКод			 - Строка
//  Результат				 - Произвольный
//  ПараметрыВозврата		 - Структура
//  Источник				 - Произвольный	 - не используется.
//  ИсточникДопПараметр		 - ЛюбаяСсылка, Булево, Строка, Дата, Число
//  ДанныеДоИзменения		 - Структура
//  ПараметрыВыполненияКода	 - Структура
//
Процедура ВыполнитьКод(ВыполняемыйКод, Результат, ПараметрыВозврата, Источник = Неопределено,
			ИсточникДопПараметр = Неопределено, ДанныеДоИзменения = Неопределено, ПараметрыВыполненияКода) Экспорт
	
	Выполнить(ВыполняемыйКод);
	
КонецПроцедуры

// Вычисляет значение тэга.
//
// Параметры:
//  ТипТэга					 - Перечисления.упоТипыТегов
//  Условие					 - Строка
//  УсловиеХЗ				 - Строка
//  Источник				 - Произвольный
//  ИсточникДопПараметр		 - Произвольный
//  ВидСобытия				 - СправочникСсылка.упоВидыСобытий
//  ПараметрыВыполненияКода	 - Структура
// 
// Возвращаемое значение:
//  Строка - значение тэга.
//
Функция ВычислитьЗначениеТэга(ТипТэга, Условие, УсловиеХЗ, Источник, ИсточникДопПараметр,
										ВидСобытия, ПараметрыВыполненияКода = Неопределено) Экспорт
	
	ЗначениеТэга = "";
	Если ПараметрыВыполненияКода = Неопределено Тогда
		ПараметрыВыполненияКода = ПолучитьПараметрыВыполненияКода(ВидСобытия);
	КонецЕсли;
	
	Если ТипТэга = Перечисления.упоТипыТегов.ВыполняемыйКод Тогда
		
		ПараметрыВозврата = Новый Структура;
		
		Попытка
			ВыполнитьКод(Условие, ЗначениеТэга, ПараметрыВозврата, Источник, ИсточникДопПараметр,, ПараметрыВыполненияКода);
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения тэга'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеТэга = "";	
		КонецПопытки;
		
		Если ЗначениеТэга = Неопределено Тогда
			ЗначениеТэга = "";	
		КонецЕсли;
		
	ИначеЕсли ТипТэга = Перечисления.упоТипыТегов.Константа Тогда
		
		Попытка
			ЗначениеТэга = "" + Константы[Условие].Получить();
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения тэга'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеТэга = "";	
		КонецПопытки;
					
	ИначеЕсли ТипТэга = Перечисления.упоТипыТегов.ВычисляемыйРеквизит Тогда
		
		ПарРеквизита = РазобратьИмяРеквизита(Условие);
		ПолноеИмяТаблицы = ПарРеквизита.ВидТаблицы + "." + ПарРеквизита.ИмяТаблицы;
		ВыполняемыйКод = ПолучитьВыполняемыйКодВычисляемогоРеквизита(ПолноеИмяТаблицы,ПарРеквизита.ИмяРеквизита);
		
		ПараметрыВозврата = Новый Структура;
		
		Попытка
			ВыполнитьКод(ВыполняемыйКод, ЗначениеТэга, ПараметрыВозврата, Источник, ИсточникДопПараметр,, ПараметрыВыполненияКода);
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения тэга'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеТэга = "";	
		КонецПопытки;
		
		Если ТипЗнч(ЗначениеТэга) = Тип("Дата") Тогда
			ЗначениеТэга = Формат(ЗначениеТэга,"ДЛФ=Д");
		ИначеЕсли ТипЗнч(ЗначениеТэга) = Тип("Число") Тогда
			ЗначениеТэга = Формат(ЗначениеТэга,"ЧГ=0");
		КонецЕсли;
		
	ИначеЕсли ТипТэга = Перечисления.упоТипыТегов.РеквизитОбъекта Тогда
		
		ПарРеквизита = РазобратьИмяРеквизита(Условие);
		
		Попытка
			ЗначениеТэга = "" + Источник[ПарРеквизита.ИмяРеквизита];
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения тэга'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеТэга = "";	
		КонецПопытки;
		
	ИначеЕсли ТипТэга = Перечисления.упоТипыТегов.НавигационнаяСсылка Тогда
		
		ПарРеквизита = РазобратьИмяРеквизита(Условие);
		
		АдресБазы = Константы.упоАдресБазыДляНавигационныхСсылок.Получить();
		
		Попытка
			ЗначениеРеквизита = Источник[ПарРеквизита.ИмяРеквизита];
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ЗначениеРеквизита);
			ЗначениеТэга = Новый Структура("Текст, HTML", "", "");
			ЗначениеТэга.Вставить("Текст", НавигационнаяСсылка);
			ЗначениеТэга.Вставить("HTML", "<a href="""+АдресБазы+НавигационнаяСсылка+""">"+НавигационнаяСсылка+"</a>");
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения тэга'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеТэга = "";	
		КонецПопытки;		
		
	ИначеЕсли ТипТэга = Перечисления.упоТипыТегов.ДопРеквизитОбъекта Тогда
		
		ПарРеквизита = УсловиеХЗ.Получить();
		
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	КонтИнфо.Адрес КАК Адрес
						|ИЗ
						|	Справочник.Пользователи КАК ТаблицаПолучателя
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КонтИнфо КАК КонтИнфо
						|		ПО ТаблицаПолучателя.Ссылка = КонтИнфо.Объект
						|ГДЕ
						|	ИСТИНА
						|	И ТаблицаПолучателя.Ссылка = &Получатель
						|	И КонтИнфо.ВидКонтИнфо = &ЗначениеУсловия";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Адрес", "." + ПарРеквизита.ДопРеквПолеЗначения);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Справочник.Пользователи", ПарРеквизита.ИмяТаблицыИсточника);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "РегистрСведений.КонтИнфо", ПарРеквизита.ДопРеквИмяТаблицы);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КонтИнфо.Объект","КонтИнфо." + ПарРеквизита.ДопРеквПолеСвязи);
		Если ПарРеквизита.Свойство("ДопРеквПолеУсловия") И ЗначениеЗаполнено(ПарРеквизита.ДопРеквПолеУсловия) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КонтИнфо.ВидКонтИнфо", "КонтИнфо." + ПарРеквизита.ДопРеквПолеУсловия);
			Запрос.УстановитьПараметр("ЗначениеУсловия", ПарРеквизита.ДопРеквЗначениеУсловия);
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И КонтИнфо.ВидКонтИнфо = &ЗначениеУсловия","");
		КонецЕсли;
		Запрос.УстановитьПараметр("Получатель", Источник);
		Запрос.Текст = ТекстЗапроса;
		
		Попытка
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ЗначениеТэга = "" + Выборка.Адрес;	
			КонецЕсли;
		Исключение
			СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения тэга'"), УровеньЖурналаРегистрации.Ошибка, 
			Метаданные.Справочники.упоВидыСобытий, ВидСобытия, СообщениеОбОшибке);
			ЗначениеТэга = "";	
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ЗначениеТэга;
	
КонецФункции

// Вычисляет значение настройки траспорта вида события для отправки.
//
// Параметры:
//  ТекстКода				 - Строка
//  ВидСобытия				 - СправочникСсылка.упоВидыСобытий
//  Источник				 - Произвольный
//  ИсточникДопПараметр		 - Произвольный
//  ПараметрыВыполненияКода	 - Структура
// 
// Возвращаемое значение:
//  Структура, Неопределено - значение настройки.
//
Функция ВычислитьНастройкиТранспортаВидаСобытияДляОтправки(Знач ТекстКода, 
	Знач ВидСобытия, Знач Источник, Знач ИсточникДопПараметр, ПараметрыВыполненияКода = Неопределено) Экспорт
	
	Результат = Неопределено;
		
	Попытка
		Выполнить(ТекстКода);
	Исключение
		СообщениеОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru='Вычисление значения настройки транспорта для вида события'"), 
								УровеньЖурналаРегистрации.Ошибка, 
								Метаданные.Справочники.упоВидыСобытий, 
								ВидСобытия, 
								СообщениеОбОшибке);
		Результат = Неопределено;	
	КонецПопытки;
		
	Возврат Результат;
	
КонецФункции

// Определяет адрес получателя.
//
// Параметры:
//  Получатель			 - Строка, СправочникСсылка
//  ВидПолучателя		 - СправочникСсылка.упоВидыПолучателейОповещений
//  Транспорт			 - СправочникСсылка.упоТранспортОповещений
//  СообщениеОбОшибках	 - Строка
// 
// Возвращаемое значение:
//  Строка - адрес получателя.
//
Функция ОпределитьАдресПолучателя(Получатель, ВидПолучателя, Транспорт, СообщениеОбОшибках = "") Экспорт
	
	АдресПолучателя = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ВариантХраненияПоляАдреса,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ПолеАдресаХЗ,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Ссылка.ТаблицаПолучателя КАК ТаблицаПолучателя,
	               |	упоВидыПолучателейОповещенийАдресаОтправки.ПолеАдреса
	               |ИЗ
	               |	Справочник.упоВидыПолучателейОповещений.АдресаОтправки КАК упоВидыПолучателейОповещенийАдресаОтправки
	               |ГДЕ
	               |	упоВидыПолучателейОповещенийАдресаОтправки.Ссылка = &ВидПолучателя
	               |	И упоВидыПолучателейОповещенийАдресаОтправки.Транспорт = &Транспорт
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	упоВидыПолучателейОповещенийАдресаОтправки.НомерСтроки";
	Запрос.УстановитьПараметр("ВидПолучателя",ВидПолучателя);
	Запрос.УстановитьПараметр("Транспорт",Транспорт);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекАдрес = ВычислитьАдресПолучателя(Получатель,
			Выборка.ТаблицаПолучателя,
			ВидПолучателя,
			Выборка.ВариантХраненияПоляАдреса,
			Выборка.ПолеАдреса,
			Выборка.ПолеАдресаХЗ,
			СообщениеОбОшибках);
				
		Если ЗначениеЗаполнено(ТекАдрес) Тогда
			АдресПолучателя = ТекАдрес;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат АдресПолучателя;
	
КонецФункции

// Получает настройки транспорта.
//
// Параметры:
//  Транспорт	 - СправочникСсылка.упоТранспортОповещений
// 
// Возвращаемое значение:
//  Структура - настройки.
//
Функция ПолучитьНастройкиТранспорта(Транспорт) Экспорт
	
	Возврат упоОповещенияПовтИсп.ПолучитьНастройкиТранспорта(Транспорт);
	
