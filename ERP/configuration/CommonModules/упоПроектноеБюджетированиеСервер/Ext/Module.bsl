#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

// Обрабатывает запись документов: ставит проведенный документ проектного контура в очередь к отражению.
//
// Параметры:
//  Источник  - ДокументОбъект - первичный документ.
//  Отказ  - Булево - флаг отказа.
//
Процедура ПервичныеДокументыПроектногоБюджетированияПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании") Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;

	Если Источник.Проведен Тогда
		ПоставитьПервичныйДокументВОчередьКОтражению(Источник.Ссылка);
	Иначе
		ПроверитьУстановитьПометкуУдаления(Источник.Ссылка, Источник.ПометкаУдаления)
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает проведение документов: ставит проведенный документ проектного контура в очередь к отражению.
//
// Параметры:
//  Источник  - ДокументОбъект - первичный документ.
//  Отказ  - Булево - флаг отказа.
//  РежимПроведения  - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ПервичныеДокументыПроектногоБюджетированияОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании") Тогда
		Возврат;
	КонецЕсли;
	
	ПоставитьПервичныйДокументВОчередьКОтражению(Источник.Ссылка);
	
КонецПроцедуры

// Обрабатывает отмену проведения документов: удаляет исходный документ проектного контура из очереди к отражению.
//
// Параметры:
//  Источник  - ДокументОбъект - первичный документ.
//  Отказ  - Булево - флаг отказа.
//
Процедура ПервичныеДокументыПроектногоБюджетированияУдалениеПроведения(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументИспользовался = ДокументИспользовалсяВКонтуреПроектнойЭкономики(Источник.Ссылка);
	Если Не ДокументИспользовался Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьПервичныйДокументИзОчередиКОтражению(Источник.Ссылка);
	
КонецПроцедуры

// Проверяет изменение документа-основания в документе отражения факта: при изменении документа-основания формирует 
// дополнительное свойство объекта "ИзмененныйДокументОснование" для передачи ссылки на измененный документа-основания 
// в процедуру ДокументОтражениеВПроектномБюджетированииПриЗаписи(). Ситуация возможна при принудительной ручной очистке
// реквизита ДокументОснование.
//
// Параметры:
//  Источник  - ДокументОбъект.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//  Отказ  - Булево - флаг отказа.
//  РежимЗаписи  - РежимЗаписиДокумента - режим записи документа.
//  РежимПроведения  - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ДокументОтражениеВПроектномБюджетированииПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.Ссылка) Тогда
		
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ДокументОснование");		
		Если ЗначениеЗаполнено(ДокументОснование) И ДокументОснование <> Источник.ДокументОснование Тогда
			Источник.ДополнительныеСвойства.Вставить("ИзмененныйДокументОснование", ДокументОснование);
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

// Проверяет изменение документа-основания в документе отражения факта: при изменении документа-основания проверяет 
// дополнительное свойство объекта "ИзмененныйДокументОснование", установленное в подписке 
// ДокументОтражениеВПроектномБюджетированииПередЗаписью(), и при его заполненности ставит исходный документа-основание
// в очередь к отражению документа.
//
// Параметры:
//  Источник  - ДокументОбъект.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//  Отказ  - Булево - флаг отказа.
//
Процедура ДокументОтражениеВПроектномБюджетированииПриЗаписи(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	// Если ДокументОснование в документе отражение зачищен вручную.
	ИсходныйДокументОснование = Неопределено;
	Если Источник.ДополнительныеСвойства.Свойство("ИзмененныйДокументОснование", ИсходныйДокументОснование) 
		И ИсходныйДокументОснование.Проведен Тогда					
		
		ПоставитьПервичныйДокументВОчередьКОтражению(ИсходныйДокументОснование);
		
	КонецЕсли;	
		
КонецПроцедуры

// Обрабатывает проведение документа отражение факта: изменяет статус отраженного документа-основания.
//
// Параметры:
//  Источник  - ДокументОбъект.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//  Отказ  - Булево - флаг отказа.
//  РежимПроведения  - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ДокументОтражениеВПроектномБюджетированииОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	// Корректность документа отражения проверяется в модуле объекта, 
	// в обработке проведения имеем заполненный документ без ошибок.	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.ДокументОснование) Тогда 
		Возврат 
	КонецЕсли;
	
	Статус = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.Отражено;
	Если Источник.РучнаяКорректировка Тогда
		Статус = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОтраженоВручную;
	КонецЕсли;		
	ИзменитьСтатусПервичногоДокументаВОчередиКОтражению(Источник.ДокументОснование, Статус);			
	ОбновитьОшибкиОтраженияДокумента(Источник.ДокументОснование);
	
КонецПроцедуры

// Обрабатывает отмену проведения документа отражение факта: ставит документ-основание в очередь к отражению.
//
// Параметры:
//  Источник  - ДокументОбъект.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//  Отказ  - Булево - флаг отказа.
//
Процедура ДокументОтражениеВПроектномБюджетированииУдалениеПроведения(Источник, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.ДокументОснование) Тогда 
		Возврат 
	КонецЕсли;
	
	ДополнительныеСвойства = Источник.ДополнительныеСвойства; 
	Если НЕ ДополнительныеСвойства.Свойство("ОтменаПроведенияПоПервичномуДокументу") Тогда	
		ПоставитьПервичныйДокументВОчередьКОтражению(Источник.ДокументОснование, Ложь);	
	КонецЕсли;	
	
КонецПроцедуры

// Обрабатывает движения документов по РС.ОтражениеДокументовВРеглУчете: ставит документ-регистратор, 
// входящий в контур проектного бюджетирования, в очередь к отражению.
//
// Параметры:
//  Источник  - РегистрСведенийНаборЗаписей.ОтражениеДокументовВРеглУчете - набор записей регистра.
//  Отказ  - Булево - флаг отказа.
//  Замещение  - Булево - использование режима замещения при записи регистра.
//
Процедура ОтражениеДокументовВРеглУчетеПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
		
	Для Каждого Запись Из Источник Цикл
		ПоставитьПервичныйДокументВОчередьКОтражению(Запись.Регистратор);						
	КонецЦикла;	
	
КонецПроцедуры

// Обрабатывает движения документов по регистрам накопления 
// во время операции закрытия месяца: ставит документ-регистратор, 
// входящий в контур проектного бюджетирования, в очередь к отражению.
//
// Параметры:
//  Источник  - РегистрНакопленияНаборЗаписей - набор записей регистра.
//  Отказ  - Булево - флаг отказа.
//  Замещение  - Булево - использование режима замещения при записи регистра.
//
Процедура ОтражениеИзмененийРНВПроектномБюджетированииПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьОтражение = 
		ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	Если Не ИспользоватьОтражение Тогда
		Возврат;
	КонецЕсли;
	
	ТипИсточника = ТипЗНЧ(Источник);
	Если ТипИсточника = Тип("РегистрНакопленияНаборЗаписей.упоФактДоходовИРасходовОбороты") Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрЗакрытиеМесяца = упоПроектноеБюджетированиеПовтИсп.ДополнительноеЗначениеПараметраСеанса("ЗакрытиеМесяца");
	Если ПараметрЗакрытиеМесяца = Истина Тогда
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("РегистраторыНабора", Источник.ВыгрузитьКолонку("Регистратор")); 
		Запрос.УстановитьПараметр("СтатусыОтражено", упоПроектноеБюджетированиеПовтИсп.СтатусыОтражения("Отражено"));
		Запрос.Текст = "ВЫБРАТЬ
		               |	упоОтражениеДокументовВПроектномБюджетировании.Документ КАК Документ
		               |ИЗ
		               |	РегистрСведений.упоОтражениеДокументовВПроектномБюджетировании КАК упоОтражениеДокументовВПроектномБюджетировании
		               |ГДЕ
		               |	упоОтражениеДокументовВПроектномБюджетировании.Документ В(&РегистраторыНабора)
		               |	И упоОтражениеДокументовВПроектномБюджетировании.Статус В(&СтатусыОтражено)";
		
		УстановитьПривилегированныйРежим(Истина);
		
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			
			ДокументыКОтражению = Результат.Выгрузить().ВыгрузитьКолонку("Документ");
			ПараметрыЗадания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументыКОтражению);
			
			упоРаботаСОчередямиВызовСервера.ЗапуститьФоновоеЗаданиеКонтекстСервера(
				"упоПроектноеБюджетированиеСервер.ПоставитьПервичныеДокументыВОчередьКОтражениюВФоне",
				ПараметрыЗадания,
				, 
				, 
				Истина);
			
		КонецЕсли;
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПодключаемыеКоманды

// См.ПодключаемыеКомандыПереопределяемый.ПриОпределенииВидовПодключаемыхКоманд. 
//	
Процедура ПриОпределенииВидовПодключаемыхКоманд(ВидыПодключаемыхКоманд) Экспорт
		
	Вид = ВидыПодключаемыхКоманд.Добавить();
    Вид.Имя         = "ПроектноеБюджетирование";    
	Вид.ИмяПодменю  = "ФормаГруппаКомандыФормы";	
    Вид.Заголовок   = НСтр("ru = 'Проектное бюджетирование'");
	
	Вид.Порядок = 50;
	Вид.Картинка = БиблиотекаКартинок.упоИнтерфейсФинансыПроектов16;
	Вид.Отображение = ОтображениеКнопки.Картинка;
	Вид.ВидГруппыФормы = ВидГруппыФормы.Подменю;		
	
КонецПроцедуры

// См.ПодключаемыеКомандыПереопределяемый.ПриОпределенииСоставаНастроекПодключаемыхОбъектов. 
//
Процедура ПриОпределенииСоставаНастроекПодключаемыхОбъектов(НастройкиПрограммногоИнтерфейса) Экспорт
			
	Настройка = НастройкиПрограммногоИнтерфейса.Добавить();
    Настройка.Ключ          = "ДобавитьКомандыПроектногоБюджетирования";
    Настройка.ОписаниеТипов = Новый ОписаниеТипов("Булево");
    Настройка.ВидыПодключаемыхОбъектов = "Обработка";	
	
КонецПроцедуры

// См.ПодключаемыеКомандыПереопределяемый.ПриОпределенииКомандПодключенныхКОбъекту. 
//
Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	Если Не ПравоДоступа("Чтение", Метаданные.Документы.упоОтражениеФактаВПроектномБюджетировании) Тогда
		Возврат;
	КонецЕсли;
	
	ТипПараметра = Новый ОписаниеТипов(упоПроектноеБюджетированиеПовтИсп.ТипыДокументовПроектногоБюджетирования());
	
	Команда = Команды.Добавить();
	Команда.Вид = "ПроектноеБюджетирование";
	Команда.Идентификатор = "ПроектноеБюджетирование";
	Команда.Представление = НСтр("ru = 'Движения проектного бюджетирования'");
	Команда.Важность = "Важное";
	Команда.Порядок = 50;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Картинка;
	Команда.Картинка = БиблиотекаКартинок.упоИнтерфейсФинансыПроектов16;
	Команда.ТипПараметра = ТипПараметра;
	Команда.ФункциональныеОпции = "упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании";
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.МножественныйВыбор = Ложь;
	Команда.Обработчик = "упоПроектноеБюджетированиеКлиент.Подключаемый_ОткрытьФормуОтраженияВПроектномБюджетировании";
	
КонецПроцедуры

#КонецОбласти

#Область ВыполнениеПравила

// Возвращает фактические данные по правилу отражения факта в проектном бюджетировании.
//
// Параметры:
//  Правило  - СправочникСсылка.упоПравилаПолученияФактаДляПроектногоБюджетирования - правило отражения.
//  Параметры  - Структура - параметры выполнения правила отражения.
//  СтатусЗаполнения  - ПеречислениеСсылка.упоСтатусыОтраженияДокументовВПроектномБюджетировании - 
//		статус ошибки отражения документа.
//  ОшибкиПользователю  - Структура - см.ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю().
//
// Возвращаемое значение:
//  Соответствие - результат выполнения правила по разделам бюджетирования:
//		* Ключ - ПеречислениеСсылка.упоРазделыПравилПроектногоБюджетирования - раздел документа отражение факта.
//		* Значение - ТаблицаЗначений - результат выполнения правила.
//
Функция ФактБюджетированияПоПравилу(Правило, Параметры, СтатусЗаполнения = Неопределено, ОшибкиПользователю = Неопределено) Экспорт
	
	ДанныеРезультат = Новый Соответствие;
	
	ДокументОснование = Неопределено;
	Параметры.Свойство("ОтборПоРегистраторам", ДокументОснование);
			
	Если НЕ ПроверитьЗаполнениеПравила(Правило, ДокументОснование, ОшибкиПользователю) Тогда
		СтатусЗаполнения = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОтсутствуютПравилаОтражения;
		Возврат ДанныеРезультат;
	КонецЕсли;	
	
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();		
	Если ЭтоEPM И Правило.ТипПравила = Перечисления.упоТипыПравилПроектногоБюджетирования.Бюджетирование Тогда 
		
		РезультатПравила = ФактПоПравилуПоСтатьямБюджетовERP(Правило, Параметры);																													
		
	Иначе	
		
		Отказ = Истина;
		ТекстОшибки = "";
		МенеджерПравила = Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования;
		СхемаКомпоновкиДанных = МенеджерПравила.СхемаКомпоновкиДанныхПоНастройкам(Правило, Ложь, ТекстОшибки);											
		Если СхемаКомпоновкиДанных = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиПользователю, "", ТекстОшибки, Правило);	
		Иначе	
			НастройкиКомпоновщика = НастройкиКомпоновщикаПравилаСПроверкой(СхемаКомпоновкиДанных, 
																			Правило, 
																			ДокументОснование, 
																			ОшибкиПользователю, 
																			Отказ);
		КонецЕсли;	
		
		Если Отказ Тогда
			СтатусОтражения = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОшибкаОтражения;				 
			Возврат ДанныеРезультат;
		КонецЕсли;
				
		ЗаполнитьРеквизитыПравила(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Правило);		
		ЗаполнитьРесурсыПравила(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Правило);
				
		ПолеПериодИмя = "Период";						
		ДобавитьПолеГруппировкиНастройкиКомпоновщика(НастройкиКомпоновщика, ПолеПериодИмя);
		ДобавитьПолеПорядкаНастройкиКомпоновщика(НастройкиКомпоновщика, ПолеПериодИмя);
		
		ПолеРегистраторИмя = "Регистратор";			
		ДобавитьПолеГруппировкиНастройкиКомпоновщика(НастройкиКомпоновщика, ПолеРегистраторИмя);					
		ДобавитьПоляОтбораПоПараметрам(НастройкиКомпоновщика, ПолеРегистраторИмя, Параметры.ОтборПоРегистраторам);		
		
		УстановитьОтборПоПериоду(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Параметры);
		
		УстановитьОтборИзНастройки(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Правило.НастройкиКомпоновкиДанных.Получить());					
		
		УстановитьОтборНаНулевыеРесурсы(НастройкиКомпоновщика);
					
		ОтключитьВыводОбщихИтоговНастройкиКомпоновщика(НастройкиКомпоновщика);
		
		Попытка
			РезультатПравила = РезультатВыполненияСКДТаблицаЗначений(СхемаКомпоновкиДанных, НастройкиКомпоновщика);
		Исключение
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиПользователю, "", ОписаниеОшибки(), Правило);
			СтатусЗаполнения = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОшибкаОтражения;
			Возврат ДанныеРезультат;
		КонецПопытки;	
		
	КонецЕсли;	
	
	ДанныеРезультат.Вставить(Правило.Раздел, РезультатПравила);		
	
	РезультатПравилаРаспределитьПоПлановымДанным(Правило, РезультатПравила);	
	
	Возврат ДанныеРезультат;
	
КонецФункции

#КонецОбласти

#Область ОтражениеПервичныхДокументов

// Вызывает функцию ВыполнитьОтражениеДокументов() для фонового выполнения.
//
// Параметры:
//  ПараметрыОтражения  - Структура, Неопределено - параметры отражения первичного документа. 
//		Не используется, но является обязательным параметром при вызове через БСП - не удалять.
//  АдресРезультата  - Строка - Адрес временного хранилища для помещения результата. Не используется.
//
Процедура ВыполнитьОтражениеДокументовВФоне(ПараметрыОтражения, АдресРезультата = Неопределено) Экспорт
	
	Результат = ВыполнитьОтражениеДокументов();
	
	Если АдресРезультата <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	КонецЕсли;	
	
КонецПроцедуры // ()

// Вызывает функцию ПоставитьПервичныеДокументыВОчередьКОтражению() для фонового выполнения.
//
// Параметры:
//  ПараметрыОтражения  - Структура, Неопределено - параметры отражения первичного документа.
//  АдресРезультата  - Строка - Адрес временного хранилища для помещения результата. Не используется.
//
Процедура ПоставитьПервичныеДокументыВОчередьКОтражениюВФоне(ПараметрыОтражения, АдресРезультата) Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыОтражения) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыКОтражению = ПараметрыОтражения[0];
	
	ПоставитьПервичныеДокументыВОчередьКОтражению(ДокументыКОтражению);
	
КонецПроцедуры // ()

// Выполняет регистрацию массива документов в очереди к отражению документов в проектном бюджетировании.
//
// Параметры:
//  ДокументыКОтражению  - Массив - документы к постановке в очередь отражения.
//
Процедура ПоставитьПервичныеДокументыВОчередьКОтражению(ДокументыКОтражению) Экспорт
	
	Если ДокументыКОтражению = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого Документ Из ДокументыКОтражению Цикл
		ПоставитьПервичныйДокументВОчередьКОтражению(Документ);	
	КонецЦикла;

КонецПроцедуры // ()

// Устанавливает первичный документ в очередь к отражению, обновляет статус отражения документа, 
// очищает историю ошибок документа.
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка - первичный документ.
//  НеПроверятьДокументОтражение  - Булево - признак безусловной отмены проведения связанного документа отражения.
//
Процедура ПоставитьПервичныйДокументВОчередьКОтражению(ДокументСсылка, НеПроверятьДокументОтражение = Истина) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ упоПроектноеБюджетированиеВызовСервера.ДокументПериодаИспользованияКонтураЭкономики(ДокументСсылка) 
		ИЛИ НЕ ДокументКонтураПроектнойЭкономики(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Статус = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.КОтражению;	
	ОбновитьСтатусОтраженияДокумента(ДокументСсылка, Статус);
	ОбновитьОчередьДокументовКОтражению(ДокументСсылка);
	ОбновитьОшибкиОтраженияДокумента(ДокументСсылка);
	
	Если НеПроверятьДокументОтражение Тогда
		ОтменитьПроведениеСвязанногоДокументаОтражение(ДокументСсылка);
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Вызывает функцию УдалитьПервичныйДокументИзОчередиКОтражению() для фонового выполнения.
//
// Параметры:
//  ДокументыОчереди  - Массив - документы очереди.
//  АдресРезультата  - Строка - Адрес временного хранилища для помещения результата. Не используется.
//
Процедура УдалитьПервичныеДокументыИзОчередиКОтражениюВФоне(ДокументыОчереди, АдресРезультата = Неопределено) Экспорт
				
	Для Каждого Документ Из ДокументыОчереди Цикл
		УдалитьПервичныйДокументИзОчередиКОтражению(Документ);
	КонецЦикла;
			
КонецПроцедуры	

// Изменяет статус отражения первичного документа.
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка - первичный документ.
//  Статус  - ПеречислениеСсылка.упоСтатусыОтраженияДокументовВПроектномБюджетировании - статус.
//  ИдентификаторЗаписи  - УникальныйИдентификатор - идентификатор выполняемой очереди сообщений в фоновом отражении.
//
Процедура ИзменитьСтатусПервичногоДокументаВОчередиКОтражению(ДокументСсылка, Статус, ИдентификаторЗаписи = Неопределено) Экспорт
	
	Если НЕ упоПроектноеБюджетированиеВызовСервера.ДокументПериодаИспользованияКонтураЭкономики(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьСтатусОтраженияДокумента(ДокументСсылка, Статус);
	
	Очистить = упоПроектноеБюджетированиеПовтИсп.СтатусыОтражения("Отражено").Найти(Статус) <> Неопределено;
	ОбновитьОчередьДокументовКОтражению(ДокументСсылка, Очистить, ИдентификаторЗаписи);	
	
	Если НЕ Очистить Тогда
		ОтменитьПроведениеСвязанногоДокументаОтражение(ДокументСсылка);
	КонецЕсли;
	
КонецПроцедуры	

// Изменяет данные об ошибках отражения первичного документа.
//
// Параметры:
//  Документ  - ДокументСсылка - первичный документ.
//  ОшибкиПравил  - ДокументОбъект.упоОтражениеФактаВПроектномБюджетировании.ОшибкиЗаполнения - 
//		ошибки табличной части документа Отражение, которые переносятся в регистр.
//
Процедура ОбновитьОшибкиОтраженияДокумента(Документ, ОшибкиПравил = Неопределено) Экспорт
	
	НЗ = РегистрыСведений.упоОшибкиОтраженияДокументовВПроектномБюджетировании.СоздатьНаборЗаписей();
	НЗ.Отбор.Документ.Установить(Документ);
	НЗ.Прочитать();
	Если НЗ.Количество() > 0 Тогда		
		НЗ.Очистить();
	КонецЕсли;	
	
	Если ОшибкиПравил <> Неопределено Тогда
		Для Каждого ОшибкаПравила Из ОшибкиПравил Цикл
			Запись = НЗ.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ОшибкаПравила);
		    Запись.Документ = Документ;		
		КонецЦикла;
	КонецЕсли;	
	
	Если НЗ.Модифицированность() Тогда
		НЗ.Записать();
	КонецЕсли;	
				
КонецПроцедуры		
 
#КонецОбласти

#Область Прочие

// Обновляет элементы справочника упоПравилаПолученияФактаДляПроектногоБюджетирования 
// с произвольными запросами по предопределенным макетам СКД.
//
// Параметры:
//  ИменаМакетов	 - Строка, Массив, Неопределено - имена макетов, для которых необходимо обновить правила. 
//  Неопределено - обновление правил для всех макетов.
//
Процедура ОбновитьПредопределенныеПравилаПолученияФакта(ИменаМакетов = Неопределено) Экспорт
	
	ОписанияПравил = ОписанияПравил(ИменаМакетов);
	
	ПравилаПолученияФактаИБ = ПравилаПолученияФактаИБ(ОписанияПравил);
	
	Для Каждого ОписаниеПравила Из ОписанияПравил Цикл
		СоздатьОбновитьПравилоПолученияФакта(ОписаниеПравила, ПравилаПолученияФактаИБ);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает имя перечисления в метаданных по значению перечисления.
//
// Параметры:
//  ПеречислениеСсылка  - ПеречислениеСсылка - значение перечисления.
//                 
// Возвращаемое значение:
//   Строка - Имя перечисления.
//
Функция ИмяПеречисленияПоЗначению(ПеречислениеСсылка) Экспорт
	
	ИмяПеречисления = "";
	СинонимПеречисления = Строка(ПеречислениеСсылка);
	
	ЗначенияПеречисления = Метаданные.Перечисления[ПеречислениеСсылка.Метаданные().Имя].ЗначенияПеречисления;
	Для Каждого ЗначениеПеречисления Из ЗначенияПеречисления Цикл
		Если ЗначениеПеречисления.Синоним = СинонимПеречисления Тогда
			ИмяПеречисления = ЗначениеПеречисления.Имя;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ИмяПеречисления;
	
КонецФункции

// Возвращает соответствие аналитики статьи бюджетирования номеру аналитики статьи.
//
// Параметры:
//  СтатьяБюджетов - СправочникСсылка.СтатьиБюджетов - статья бюджетов.
//
// Возвращаемое значение:
//   Соответствие   - Соответствие аналитики статьи бюджетирования номеру статьи.
//
Функция НомераАналитикСтатьиБюджета(СтатьяБюджетов) Экспорт
	
	НомераАналитик = Новый Соответствие;
	
	ШаблонИмени = "ВидАналитики%1";
	
	Для НомерАналитики = 1 По 6 Цикл
		ИмяАналитики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмени, НомерАналитики);
		Аналитика = СтатьяБюджетов[ИмяАналитики];
		Если ЗначениеЗаполнено(Аналитика) Тогда	
			НомераАналитик.Вставить(Аналитика, НомерАналитики);							
	    КонецЕсли;
	КонецЦикла;
	
	Возврат НомераАналитик;
	
КонецФункции	

// Проверяет очередь документов к отражению на наличие документов до даты начала использования контура отражения.
// При нахождении таких документов удаляет их из очереди.
//
Процедура ПроверитьДокументыПериодаИспользованияКонтураОтражения() Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачалоИспользования = Константы.упоНачалоИспользованияОтраженияПервичныхДокументовВПроектномБюджетировании.Получить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ 
	                      |	упоОчередьДокументовКОтражениюВПроектномБюджетировании.Документ КАК Документ
	                      |ИЗ
	                      |	РегистрСведений.упоОчередьДокументовКОтражениюВПроектномБюджетировании КАК упоОчередьДокументовКОтражениюВПроектномБюджетировании
	                      |ГДЕ
	                      |	упоОчередьДокументовКОтражениюВПроектномБюджетировании.ПериодЗаписи < &НачалоИспользования");
	Запрос.УстановитьПараметр("НачалоИспользования", НачалоИспользования);
	Результат = Запрос.Выполнить();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не Результат.Пустой() Тогда
		
		ДокументыКОтражению = Результат.Выгрузить().ВыгрузитьКолонку("Документ");
		
		ПараметрыЗадания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументыКОтражению);
		
		упоРаботаСОчередямиВызовСервера.ЗапуститьФоновоеЗаданиеКонтекстСервера(
			"упоПроектноеБюджетированиеСервер.УдалитьПервичныеДокументыИзОчередиКОтражениюВФоне",
			ПараметрыЗадания,
			,
			,
			Истина);
	КонецЕсли;
	
КонецПроцедуры

// Проверяет наличие ошибок отражения по документу.
//
// Параметры:
//  Документ - ДокументСсылка	 - первичный документ отражения.
// 
// Возвращаемое значение:
//  Булево - наличие ошибок отражения.
//
Функция ЕстьОшибкиОтраженияДокумента(Документ) Экспорт
	
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ИСТИНА
	               |ИЗ
	               |	РегистрСведений.упоОшибкиОтраженияДокументовВПроектномБюджетировании КАК упоОшибкиОтраженияДокументовВПроектномБюджетировании
	               |ГДЕ
	               |	(ВЫРАЗИТЬ(упоОшибкиОтраженияДокументовВПроектномБюджетировании.Документ КАК Документ.%1)) = &Документ";
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, Документ.Метаданные().Имя);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

