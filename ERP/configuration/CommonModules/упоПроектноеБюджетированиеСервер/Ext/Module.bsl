#Область РаспределениеПоПлановымДанным

Процедура РезультатПравилаРаспределитьПоПлановымДанным(Правило, ТаблицаДанных)
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Правило, 
			"РаспределятьПоПлану, РаспределятьПоРасходам, Раздел");
	
	Если Не Реквизиты.РаспределятьПоПлану Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Реквизиты.Раздел = 
		Перечисления.упоРазделыПравилПроектногоБюджетирования.ДоходыРасходы Тогда
		Возврат;
	КонецЕсли;	
			
	ПоляАналитикиБазы = ПоляАналитикиБазыРаспределения(Правило, Реквизиты.РаспределятьПоРасходам);
	Если ПоляАналитикиБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	КолонкиДанных = ТаблицаДанных.Колонки;
	// Дополнение колонок источника отсутствующими полями аналитики.
	Для Каждого ПолеАналитики Из ПоляАналитикиБазы Цикл
		Если КолонкиДанных.Найти(ПолеАналитики) = Неопределено Тогда
			КолонкиДанных.Добавить(ПолеАналитики);	
		КонецЕсли;	
	КонецЦикла;		
	
	ПоляОтбораБазы = Новый Массив;
	Если КолонкиДанных.Найти("ПроектнаяЗадача") <> Неопределено Тогда
		ПоляОтбораБазы.Добавить("ПроектнаяЗадача");
	КонецЕсли;
	
	ЕстьКолонкаСуммаУпр = ТаблицаДанных.Колонки.Найти("СуммаУпр") <> Неопределено;
	ЕстьКолонкаСуммаВалютная = ТаблицаДанных.Колонки.Найти("СуммаВалютная") <> Неопределено;
	ЕстьКолонкаКоличество = ТаблицаДанных.Колонки.Найти("Количество") <> Неопределено;

	ПоляРаспределенияДанных = Новый Массив;
	ПоляРаспределенияДанных.Добавить("Сумма");
	Если ЕстьКолонкаКоличество Тогда
		ПоляРаспределенияДанных.Добавить("Количество");
	КонецЕсли;
	Если ЕстьКолонкаСуммаУпр Тогда
		ПоляРаспределенияДанных.Добавить("СуммаУпр");
	КонецЕсли;
	Если ЕстьКолонкаСуммаВалютная Тогда
		ПоляРаспределенияДанных.Добавить("СуммаВалютная");
	КонецЕсли;
	
	Если ЕстьКолонкаСуммаУпр Тогда
		МеппингПолей = Новый Структура("Сумма, СуммаВалютная", "СуммаУпр", "Сумма");
	ИначеЕсли ЕстьКолонкаСуммаВалютная Тогда
		МеппингПолей = Новый Структура("Сумма, СуммаВалютная", "Сумма", "СуммаВалютная");
	Иначе
		МеппингПолей = Новый Структура("Сумма", "Сумма");
	КонецЕсли;

	МеппингПолей = упоДоходыИРасходыСервер.МеппингПолейИсточникаПоУмолчанию(МеппингПолей);	
		
	МассивЗадач = Новый Массив;	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		ПроектнаяЗадачаСтроки = СтрокаДанных[МеппингПолей.ПроектнаяЗадача];
		Если Не ЗначениеЗаполнено(ПроектнаяЗадачаСтроки) Тогда 
			Продолжить;
		КонецЕсли;				
		Если МассивЗадач.Найти(ПроектнаяЗадачаСтроки) = Неопределено Тогда 
			МассивЗадач.Добавить(ПроектнаяЗадачаСтроки);
		КонецЕсли;	
	КонецЦикла;		
	Если МассивЗадач.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	БазаРаспределения = ПодготовитьБазуРаспределения(МассивЗадач, 
															ПоляОтбораБазы, 
															ПоляАналитикиБазы, 
															Реквизиты.РаспределятьПоРасходам);	
	Если БазаРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;	
			
	упоДоходыИРасходыСервер.РаспределитьТаблицуДанныхПоБазе(ТаблицаДанных, 
															БазаРаспределения, 
															ПоляОтбораБазы, 
															ПоляАналитикиБазы, 
															ПоляРаспределенияДанных, 
															МеппингПолей);
		
КонецПроцедуры

Функция ПодготовитьБазуРаспределения(МассивЗадач, ПоляОтбораБазы, ПоляАналитикиБазы, РаспределятьПоРасходам)
					
	ДоходРасход = ?(РаспределятьПоРасходам, "Расход", "Доход");
	НастройкиОбработкиЗадач = упоДоходыИРасходыСервер.НастройкиОбработкиЗадачПоУмолчанию();
	
	// 1. План доходов/расходов по задачам.
	БазаРаспределения = упоДоходыИРасходыСервер.БазаРаспределения_ДоходыРасходыБезНДС(МассивЗадач, 
																					ПоляОтбораБазы, 
																					ПоляАналитикиБазы,
																					ДоходРасход, 
																					НастройкиОбработкиЗадач);
																				
	// 2. План доходных/расходов объемов по задачам.																			
	Если БазаРаспределения = Неопределено Тогда
		БазаРаспределения = упоДоходыИРасходыСервер.БазаРаспределения_ОбъемыБезНДС(МассивЗадач, 
																					ПоляОтбораБазы, 
																					ПоляАналитикиБазы, 
																					ДоходРасход, 
																					НастройкиОбработкиЗадач);
	КонецЕсли;
	
	// Получение данных по вложенным задачам.
	// 3.  План доходов/расходов по вложенным задачам.
	Если БазаРаспределения = Неопределено Тогда	
		МассивЗадачЗеркала = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(МассивЗадач);
					
		НастройкиОбработкиЗадач.ПроектнаяЗадачаКакСправочник = Истина;
		НастройкиОбработкиЗадач.ПолучитьДанныеВложенныхЗадач = Истина;
		НастройкиОбработкиЗадач.ВернутьПЗКакДокумент = Истина;
		
		БазаРаспределения = упоДоходыИРасходыСервер.БазаРаспределения_ДоходыРасходыБезНДС(МассивЗадачЗеркала, 
																					ПоляОтбораБазы, 
																					ПоляАналитикиБазы,
																					ДоходРасход,
																					НастройкиОбработкиЗадач);
	КонецЕсли;																				
	// 4.  План доходных/расходных объемов по вложенным задачам.
	Если БазаРаспределения = Неопределено Тогда
		БазаРаспределения = упоДоходыИРасходыСервер.БазаРаспределения_ОбъемыБезНДС(МассивЗадачЗеркала, 
																					ПоляОтбораБазы, 
																					ПоляАналитикиБазы,
																					ДоходРасход,
																					НастройкиОбработкиЗадач);
	КонецЕсли;	

	Возврат БазаРаспределения;
	
КонецФункции // ()

Функция ПоляАналитикиБазыРаспределения(Правило, РаспределятьПоРасходам)
			
	// Если заполняется факт расходов, а база распределения - доходы (и наоборот),
	// то из полей исключаем статью (разные типы).		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Правило);
	Запрос.УстановитьПараметр("ИсключаемаяАналитикаДоходовРасходов", ИсключаемаяАналитикаДоходовРасходов());
	ВидЭлемента = ?(РаспределятьПоРасходам, 
					Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход,
					Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход);
	Запрос.УстановитьПараметр("ВидЭлемента", ВидЭлемента);					
						
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СопоставлениеРеквизитов.Реквизит КАК Реквизит,
	               |	СопоставлениеРеквизитов.ЗначениеЗаполнения КАК ЗначениеЗаполнения,
	               |	СопоставлениеРеквизитов.ЗаполнятьПоРаспределению КАК ЗаполнятьПоРаспределению
	               |ПОМЕСТИТЬ втРеквизитыПравила
	               |ИЗ
	               |	Справочник.упоПравилаПолученияФактаДляПроектногоБюджетирования.СопоставлениеРеквизитов КАК СопоставлениеРеквизитов
	               |ГДЕ
	               |	СопоставлениеРеквизитов.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИСТИНА КАК Реквизит
	               |ПОМЕСТИТЬ втИсключаемыеПоляАналитикиДоходовРасходов
	               |ИЗ
	               |	втРеквизитыПравила КАК втРеквизитыПравила
	               |ГДЕ
	               |	втРеквизитыПравила.Реквизит = ""ВидЭлемента""
	               |	И втРеквизитыПравила.ЗначениеЗаполнения = &ВидЭлемента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втРеквизитыПравила.Реквизит КАК Реквизит
	               |ИЗ
	               |	втРеквизитыПравила КАК втРеквизитыПравила
	               |ГДЕ
	               |	втРеквизитыПравила.ЗаполнятьПоРаспределению
	               |	И ВЫБОР
	               |			КОГДА ИСТИНА В
	               |					(ВЫБРАТЬ
	               |						втИсключаемыеПоляАналитикиДоходовРасходов.Реквизит КАК Реквизит
	               |					ИЗ
	               |						втИсключаемыеПоляАналитикиДоходовРасходов КАК втИсключаемыеПоляАналитикиДоходовРасходов)
	               |				ТОГДА НЕ втРеквизитыПравила.Реквизит В (&ИсключаемаяАналитикаДоходовРасходов)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		Возврат Неопределено;
	КонецЕсли;	
	
	ПоляАналитикиБазы = Результат.Выгрузить().ВыгрузитьКолонку("Реквизит");

	Возврат ПоляАналитикиБазы;
	
КонецФункции	

Функция ИсключаемаяАналитикаДоходовРасходов()

	МассивЗначений = Новый Массив;
	МассивЗначений.Добавить("Статья");	
		
	Возврат МассивЗначений;

КонецФункции // ()

#КонецОбласти

#Область ОбновлениеПредустановленныхПравил

// Обновление существующего или создание нового правила получения факта.
// Запись правила происходит в режиме обновления ИБ.
//
// Параметры:
//  ОписаниеПравила - Структура - заданное описание правила.
//  ПравилаПолученияФактаИБ - ТаблицаЗначений - описания сохраненных элементов правил из ИБ.
//
Процедура СоздатьОбновитьПравилоПолученияФакта(ОписаниеПравила, ПравилаПолученияФактаИБ)
	
	ИмяМакета 		= ОписаниеПравила.ИмяМакета;
	Раздел 			= ОписаниеПравила.Раздел;
	ТипыДокументов 	= ОписаниеПравила.ТипыДокументов;
	
	МенеджерПравила = Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования;
	
	СтрокаСНайденнымЭлементом = ПравилаПолученияФактаИБ.Найти(ИмяМакета, "ПредустановленныйКод");
	Если СтрокаСНайденнымЭлементом <> Неопределено Тогда
		ПравилоОбъект = СтрокаСНайденнымЭлементом.Ссылка.ПолучитьОбъект();
		// Для существующих элементов сохраняем пользовательский признак отключения.
		ОписаниеПравила.Вставить("ОтключитьПравило", ПравилоОбъект.ОтключитьПравило);
	Иначе
		ПравилоОбъект = МенеджерПравила.СоздатьЭлемент();
	КонецЕсли;
	
	//
	ПравилоОбъект.Заполнить(Неопределено);
	
	ПравилоОбъект.Раздел = Раздел;
	ПравилоОбъект.ТипПравила = Перечисления.упоТипыПравилПроектногоБюджетирования.ПроизвольныйЗапрос;
	ПравилоОбъект.ФормироватьНаименованиеАвтоматически = Ложь;
	ПравилоОбъект.ПредустановленныйКод = ИмяМакета;
	
	ЗаполнитьЗначенияСвойств(ПравилоОбъект, ОписаниеПравила);
	
	СхемаКомпоновкиДанных = МенеджерПравила.ПолучитьМакет(ИмяМакета);
	
	ЗаполнитьТипыДокументаПравила(ПравилоОбъект, ТипыДокументов);
	
	УстановитьИндивидуальныеНастройкиПравила(ПравилоОбъект, СхемаКомпоновкиДанных);
	
	ЗаполнитьСопоставлениеРеквизитовПравила(ПравилоОбъект, СхемаКомпоновкиДанных);
	ЗаполнитьСхемуИНастройкиКомпоновкиПравила(ПравилоОбъект, СхемаКомпоновкиДанных);
	
	//
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ПравилоОбъект, ,Истина);
	
КонецПроцедуры

Процедура ЗаполнитьВалютуПравилаВСопоставленииРеквизитов(Правило)
	
	// Заполнение валюты: при отключенном многовалютном учете в СКД недоступен 
	// справочник Валюты и реквизит надо заполнять из константы.
	
	СопоставлениеРеквизитов = Правило.СопоставлениеРеквизитов;
	СтрокаВалюта = СопоставлениеРеквизитов.Найти("Валюта", "Реквизит");
	Если СтрокаВалюта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьВалютуИзКонстанты = Истина;
	Если ЗначениеЗаполнено(СтрокаВалюта.ЗначениеЗаполнения) Тогда
		МноговалютныйУчет = упоИнтеграция.ИспользуетсяМноговалютныйУчет();
		Если МноговалютныйУчет Тогда
			ЗаполнитьВалютуИзКонстанты = Ложь;
		Иначе
			СтрокаВалюта.ЗначениеЗаполнения = "";
			СтрокаВалюта.СпособЗаполнения = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаполнитьВалютуИзКонстанты Тогда
		Валюта = ПараметрыСеанса.упоВалютаУправленческогоУчета;
		СтрокаВалюта.ЗначениеЗаполнения = Валюта;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСхемуИНастройкиКомпоновкиПравила(Правило, СхемаКомпоновкиДанных)
	
	Правило.СхемаКомпоновкиДанных = Новый ХранилищеЗначения(СхемаКомпоновкиДанных);
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных);
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	Правило.НастройкиКомпоновкиДанных = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	
КонецПроцедуры

Процедура ЗаполнитьСопоставлениеРеквизитовПравила(Правило, СхемаКомпоновкиДанных)
	
	СопоставлениеРеквизитов = Правило.СопоставлениеРеквизитов;
	НаборыРеквизитовРазделов = ШаблонРеквизитовРазделов(Правило.Раздел);
	
	СопоставлениеРеквизитов.Очистить();
	
	Для Каждого РеквизитРаздела Из НаборыРеквизитовРазделов Цикл
		НоваяСтрока = СопоставлениеРеквизитов.Добавить();
		НоваяСтрока.Реквизит = РеквизитРаздела.ИмяРеквизита;
	КонецЦикла;
	
	ЗаполнитьСопоставлениеРеквизитовРазделаАвтоматически(Правило, СхемаКомпоновкиДанных);
	
	ЗаполнитьВалютуПравилаВСопоставленииРеквизитов(Правило);
	
КонецПроцедуры

Процедура ЗаполнитьТипыДокументаПравила(Правило, ТипыДокументов)
	
	МетаданныеДокументы = Метаданные.Документы;
	ТипыДокументовПравила = Правило.ТипыДокументов;
	
	ТипыДокументовПравила.Очистить();
	
	Для Каждого ТипДокумента Из ТипыДокументов Цикл
		НоваяСтрока = ТипыДокументовПравила.Добавить();
		НоваяСтрока.ТипДокумента = ТипДокумента;
		НоваяСтрока.ТипДокументаСиноним = МетаданныеДокументы[ТипДокумента].Синоним;
	КонецЦикла;
	
КонецПроцедуры

// Установка индивидуальных настроек правила (преимущественно отборов).
//
// Параметры:
//  Правило					 - СправочникОбъект.упоПравилаПолученияФактаДляПроектногоБюджетирования - правило для модификации.
//  СхемаКомпоновкиДанных	 - СхемаКомпоновкиДанных - СКД правила для модификации.
//
Процедура УстановитьИндивидуальныеНастройкиПравила(Правило, СхемаКомпоновкиДанных)
	
	СоздатьОбновитьПравилоУПФ_РасходыУслугиНЗП(Правило, СхемаКомпоновкиДанных);
	
КонецПроцедуры

Процедура СоздатьОбновитьПравилоУПФ_РасходыУслугиНЗП (Правило, СхемаКомпоновки)
	
	Если НЕ Правило.ПредустановленныйКод = "УПФ_РасходыУслугиНЗП" Тогда 
		Возврат;
	КонецЕсли;
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных("СчетУчета.ТипСчета");
	
	ЭлементыОтбора = СхемаКомпоновки.НастройкиПоУмолчанию.Отбор.Элементы;
	ЭлементыОтбора.Очистить();
	
	ЭлементОтбора = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ПолеОтбора;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = 
		ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыСчетов.НезавершенноеПроизводство");
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор;
	
КонецПроцедуры

Функция ШаблонРеквизитовРазделов(Раздел)
	
	ИмяРаздела = упоПроектноеБюджетированиеСервер.ИмяПеречисленияПоЗначению(Раздел);
	
	МетаданныеДокументаОтражения = Метаданные.Документы.упоОтражениеФактаВПроектномБюджетировании;
	РеквизитыРаздела = МетаданныеДокументаОтражения.ТабличныеЧасти[ИмяРаздела].Реквизиты;
	
	ТипыРеквизитов = Новый ТаблицаЗначений;
	ТипыРеквизитов.Колонки.Добавить("ИмяРеквизита", Новый ОписаниеТипов("Строка"));
	ТипыРеквизитов.Колонки.Добавить("ТипРеквизита", Новый ОписаниеТипов("ОписаниеТипов"));
	
	МассивРеквизитыИсключить = Новый Массив;
	МассивРеквизитыИсключить.Добавить("Период");
	МассивРеквизитыИсключить.Добавить("Регистратор");
	МассивРеквизитыИсключить.Добавить("ПравилоОтражения");
	МассивРеквизитыИсключить.Добавить("Сумма");
	МассивРеквизитыИсключить.Добавить("СуммаВалютная");
	
	Если Раздел = Перечисления.упоРазделыПравилПроектногоБюджетирования.ДоходыРасходы Тогда
		МассивРеквизитыИсключить.Добавить("Количество");
	КонецЕсли;
	
	Для Каждого РеквизитРаздела Из РеквизитыРаздела Цикл
		Если МассивРеквизитыИсключить.Найти(РеквизитРаздела.Имя) = Неопределено Тогда
			НоваяСтрока = ТипыРеквизитов.Добавить();
			НоваяСтрока.ИмяРеквизита = РеквизитРаздела.Имя;
			НоваяСтрока.ТипРеквизита = РеквизитРаздела.Тип;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТипыРеквизитов;
	
КонецФункции

Процедура ЗаполнитьСопоставлениеРеквизитовРазделаАвтоматически(Правило, СхемаКомпоновкиДанных = "")
	
	ВыраженияЗаполненияРеквизитов = ПоляСоответствияРеквизитовПоИсточникуДанных(Правило, СхемаКомпоновкиДанных);
	Если ВыраженияЗаполненияРеквизитов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаНастройки Из Правило.СопоставлениеРеквизитов Цикл
		
		Отбор = Новый Структура("Реквизит", СтрокаНастройки.Реквизит);
		НайденныеСтроки = ВыраженияЗаполненияРеквизитов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество()  = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РезультатПоиска = НайденныеСтроки[0];
		Если ЗначениеЗаполнено(РезультатПоиска.Выражение) Тогда
			
			Если РезультатПоиска.Неоднозначно Тогда
				СтрокаНастройки.ЗначениеЗаполнения = "";
			Иначе
				СтрокаНастройки.ЗначениеЗаполнения = РезультатПоиска.Выражение;
			КонецЕсли;
			СтрокаНастройки.СпособЗаполнения = РезультатПоиска.СпособЗаполнения;
			
		Иначе
			СтрокаНастройки.ЗначениеЗаполнения = "";
			СтрокаНастройки.СпособЗаполнения = Ложь;
			НастроитьСопоставлениеРеквизитовНеЗаполняемыхИзСхемыДляУПФ(СтрокаНастройки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НастроитьСопоставлениеРеквизитовНеЗаполняемыхИзСхемыДляУПФ(СтрокаНастройки)
	
	Если НЕ упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаНастройки.Реквизит = "СобствСилы_Субподряд" Тогда
		
		СтрокаНастройки.ЗначениеЗаполнения = Справочники.упоСобственныеСилыСубподряд.СобственныеСилы;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПоляСоответствияРеквизитовПоИсточникуДанных(Правило, СхемаКомпоновкиДанных)
	
	ИсточникиЗаполненияРеквизитов = Новый Соответствие;
	ТипыИсточниковЗаполненияРеквизитов = Новый Соответствие;
	ТипыФинСтатейПоСтатьеБюджета = Новый Соответствие;
	ЗначенияЗаполненияРеквизитов = Новый Соответствие;
		
	КэшТиповРеквизитов = упоПроектноеБюджетированиеПовтИсп.ТипыЗначенийРеквизитовРазделаПравила(Правило.Раздел);		
	ВыраженияЗаполнения = ШаблонТаблицыЗаполнения();					    
   
    Если СхемаКомпоновкиДанных <> Неопределено 
        И СхемаКомпоновкиДанных.НаборыДанных.Количество() <> 0 Тогда
        
        ПоляНабора = СхемаКомпоновкиДанных.НаборыДанных[0].Поля;			
        Для Каждого ПолеНабора Из ПоляНабора Цикл
            Если ТипЗнч(ПолеНабора) = Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных") Тогда
                Продолжить;
            КонецЕсли;
            Если ЗначениеЗаполнено(ПолеНабора.ТипЗначения) Тогда					
                ИсточникиЗаполненияРеквизитов.Вставить(ПолеНабора.ПутьКДанным, ПолеНабора.ТипЗначения);
                ЗначениеДляСохранения = ТипыИсточниковЗаполненияРеквизитов.Получить(ПолеНабора.ТипЗначения);
                Если ЗначениеДляСохранения = Неопределено Тогда
                    ЗначениеДляСохранения = Новый Массив;
                КонецЕсли;
                ЗначениеДляСохранения.Добавить(ПолеНабора.ПутьКДанным);
                ТипыИсточниковЗаполненияРеквизитов.Вставить(ПолеНабора.ТипЗначения, ЗначениеДляСохранения);					
            КонецЕсли;
        КонецЦикла;
        
    КонецЕсли;		
    
	Если ИсточникиЗаполненияРеквизитов.Количество() > 0 Тогда
	
		Для Каждого СтрокаСопоставления Из Правило.СопоставлениеРеквизитов Цикл
						
			ПоляСовпадающихТипов = Новый Массив;
			ПоляСодержащихТипов = Новый Массив;
						
			НоваяСтрока = ВыраженияЗаполнения.Добавить();			
			НоваяСтрока.СпособЗаполнения = Истина;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСопоставления, , "СпособЗаполнения");
			
	    	НоваяСтрока.ТипЗначения = КэшТиповРеквизитов[СтрокаСопоставления.Реквизит];			
			ИсточникЗаполненияАналитики = ТипыИсточниковЗаполненияРеквизитов.Получить(НоваяСтрока.ТипЗначения);
			Если Не ИсточникЗаполненияАналитики = Неопределено Тогда
				ПоляСовпадающихТипов = ИсточникЗаполненияАналитики;
			Иначе
				Для каждого ИсточникЗаполненияРеквизита Из ИсточникиЗаполненияРеквизитов Цикл
					Для каждого Тип Из ИсточникЗаполненияРеквизита.Значение.Типы() Цикл
						Если КэшТиповРеквизитов[СтрокаСопоставления.Реквизит].СодержитТип(Тип) Тогда
							ПоляСодержащихТипов.Добавить(ИсточникЗаполненияРеквизита.Ключ);
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
			ЗначенияСтатей = Новый Массив;
            Если СтрокаСопоставления.Реквизит = "Статья" ИЛИ СтрокаСопоставления.Реквизит = "СтатьяДДС" Тогда
                Для Каждого ТипФинСтатьиПоСтатьеБюджета Из ТипыФинСтатейПоСтатьеБюджета Цикл
                    Если НоваяСтрока.ТипЗначения.СодержитТип(ТипФинСтатьиПоСтатьеБюджета.Ключ) Тогда
                        Для Каждого ЗначениеСтатьи Из ТипФинСтатьиПоСтатьеБюджета.Значение Цикл
                            ЗначенияСтатей.Добавить(ЗначениеСтатьи);
                        КонецЦикла;
                    КонецЕсли;
                КонецЦикла;									
            КонецЕсли;	
                                   
            Если ПоляСовпадающихТипов.Количество() <> 0 Тогда                
                НоваяСтрока.Выражение = ПоляСовпадающихТипов[0];
                НоваяСтрока.Неоднозначно = ПоляСовпадающихТипов.Количество() > 1;	
                
            ИначеЕсли ПоляСодержащихТипов.Количество() <> 0 Тогда
                НоваяСтрока.Выражение = ПоляСодержащихТипов[0];
                НоваяСтрока.Неоднозначно = ПоляСодержащихТипов.Количество() > 1;
                
            ИначеЕсли ЗначенияСтатей.Количество() <> 0 Тогда																				
                НоваяСтрока.СпособЗаполнения = Ложь;
                НоваяСтрока.Выражение = ЗначенияСтатей[0];
                НоваяСтрока.Неоднозначно = ЗначенияСтатей.Количество() > 1;	
            КонецЕсли;            
										
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат ВыраженияЗаполнения;
		
КонецФункции

Функция ШаблонТаблицыЗаполнения()
	
	ТаблицаЗаполнения = Новый ТаблицаЗначений;
	ТаблицаЗаполнения.Колонки.Добавить("Реквизит", Новый ОписаниеТипов("Строка"));
	ТаблицаЗаполнения.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
	
	ТипыВыражения = Новый Массив;
	ТипыВыражения.Добавить("Строка");	
	ТипыВыражения.Добавить("СправочникСсылка.СтатьиДвиженияДенежныхСредств");
	ТипыВыражения.Добавить("СправочникСсылка.упоСтатьиДоходов"); 
	ТипыВыражения.Добавить("СправочникСсылка.упоСтатьиЗатрат");		
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		ТипыВыражения.Добавить("ПланВидовХарактеристикСсылка.АналитикиСтатейБюджетов");
	КонецЕсли;	
	ТаблицаЗаполнения.Колонки.Добавить("Выражение", Новый ОписаниеТипов(ТипыВыражения));
	
	ТаблицаЗаполнения.Колонки.Добавить("СпособЗаполнения", Новый ОписаниеТипов("Булево"));	
	ТаблицаЗаполнения.Колонки.Добавить("Неоднозначно", Новый ОписаниеТипов("Булево"));	
	
	Возврат ТаблицаЗаполнения;
	
КонецФункции

Функция ПравилаПолученияФактаИБ(ОписанияПравил)
	
	МакетыПравил = Новый Массив;
	Для Каждого ОписаниеПравил Из ОписанияПравил Цикл
		МакетыПравил.Добавить(ОписаниеПравил.ИмяМакета);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МакетыПравил", МакетыПравил);
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.ПредустановленныйКод КАК ПредустановленныйКод
	|ИЗ
	|	Справочник.упоПравилаПолученияФактаДляПроектногоБюджетирования КАК Т
	|ГДЕ
	|	Т.ПредустановленныйКод В (&МакетыПравил)";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаПредопределенный = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблицаПредопределенный;

КонецФункции

Функция ОписанияПравил(ИменаМакетов)
	
	Если ТипЗнч(ИменаМакетов) = Тип("Строка") Тогда
		мИменаМакетов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИменаМакетов);
	Иначе
		мИменаМакетов = ИменаМакетов;
	КонецЕсли;
	
	ОписанияПравил = Новый Массив;
	
	ДобавитьОписанияПравил_PM(ОписанияПравил, мИменаМакетов);
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		ДобавитьОписанияПравил_ERP(ОписанияПравил, мИменаМакетов);
	ИначеЕсли упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		ДобавитьОписанияПравил_УПФ(ОписанияПравил, мИменаМакетов);
	КонецЕсли;
	
	Возврат ОписанияПравил;
	
КонецФункции

Процедура ДобавитьОписанияПравил_PM(ОписанияПравил, ИменаМакетов = Неопределено)
	
	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить("упоТабельУчетаРабочегоВремени");
	ТипыДокументов.Добавить("упоРаспределениеРабочегоВремениЗаНеделю");
	
	ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
	ОписаниеПравила.ИмяМакета = "ДоходыРасходы_Трудозатраты";
	ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Трудозатраты'");
	ОписаниеПравила.ОтключитьПравило = Истина;
	ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	
	ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
	ОписаниеПравила.ИмяМакета = "ДоходыРасходы_ТрудозатратыПоСтатьямФОТ";
	ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Трудозатраты по статьям ФОТ'");
	ОписаниеПравила.ОтключитьПравило = Истина;
	ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	
	Если упоИнтеграцияКлиентСервер.ИспользуетсяФункционалСогласованиеТрудозатрат() Тогда
		ТипыДокументов = Новый Массив;
		ТипыДокументов.Добавить("упоСогласованиеТрудозатрат");
		
		ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
		ОписаниеПравила.ИмяМакета = "ДоходыРасходы_СогласованныеТрудозатраты";
		ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Согласованные трудозатраты'");
		ОписаниеПравила.ОтключитьПравило = Истина;
		ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
		
		ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
		ОписаниеПравила.ИмяМакета = "ДоходыРасходы_СогласованныеТрудозатратыПоСтатьямФОТ";
		ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Согласованные трудозатраты по статьям ФОТ'");
		ОписаниеПравила.ОтключитьПравило = Истина;
		ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОписанияПравил_ERP(ОписанияПравил, ИменаМакетов = Неопределено)
	
	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить("ПрочиеДоходыРасходы");
	
	ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
	ОписаниеПравила.ИмяМакета = "ДоходыРасходы_РеклассификацияРасходов_Сумма";
	ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Реклассификация расходов, Сумма'");
	ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	
	ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
	ОписаниеПравила.ИмяМакета = "ДоходыРасходы_РеклассификацияРасходов_СуммаБезНДС";
	ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Реклассификация расходов, СуммаБезНДС'");
	ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	
	ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
	ОписаниеПравила.ИмяМакета = "ДоходыРасходы_РеклассификацияРасходов_СуммаРегл";
	ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Реклассификация расходов, СуммаРегл'");
	ОписаниеПравила.ТипыДокументов = ТипыДокументов;
	ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	
	ОписаниеПравила = ОписаниеПравила_ДоходыРасходы(ТипыДокументов);
	ОписаниеПравила.ИмяМакета = "ДоходыРасходы_РеклассификацияРасходов_СуммаМинусСуммаБезНДС";
	ОписаниеПравила.Наименование = НСтр("ru = 'Произвольный запрос: Реклассификация расходов, Сумма - СуммаБезНДС'");
	ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов);
	
КонецПроцедуры

