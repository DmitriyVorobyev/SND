Процедура ПроверитьУстановитьПометкуУдаления(ПервичныйДокумент, ПометкаУдаления)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПометкаУдаления", ПометкаУдаления);
	ПараметрыОтбора.Вставить("ТекстОтбора", " И Не ДокументОтражения.ПометкаУдаления = &ПометкаУдаления");
	
	ДокументОтражения = Документы.упоОтражениеФактаВПроектномБюджетировании.
		ДокументОтражениеПоДокументуОснованию(ПервичныйДокумент, ПараметрыОтбора);
		
	Если ЗначениеЗаполнено(ДокументОтражения) Тогда
		ДокументОбъект = ДокументОтражения.ПолучитьОбъект();
		ДокументОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
	КонецЕсли;
	
