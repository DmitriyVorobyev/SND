Процедура ДобавитьОписаниеПравилаСПроверкой(ОписанияПравил, ОписаниеПравила, ИменаМакетов)
	
	ДобавитьОписание = Ложь;
	
	Если ИменаМакетов = Неопределено Тогда
		ДобавитьОписание = Истина;
	Иначе
		ДобавитьОписание = ИменаМакетов.Найти(ОписаниеПравила.ИмяМакета) <> Неопределено;
	КонецЕсли;
	
	Если ДобавитьОписание Тогда
		ОписанияПравил.Добавить(ОписаниеПравила);
	КонецЕсли;
	
КонецПроцедуры

Функция ОписаниеПравила_ДоходыРасходы(ТипыДокументов)
	
	ОписаниеПравила = ОписаниеПравила_Шаблон();
	ОписаниеПравила.Вставить("Раздел", Перечисления.упоРазделыПравилПроектногоБюджетирования.ДоходыРасходы);
	ОписаниеПравила.Вставить("ТипыДокументов", ТипыДокументов); 
	
	Возврат ОписаниеПравила;
	
КонецФункции

Функция ОписаниеПравила_ДДС(ТипыДокументов)
	
	ОписаниеПравила = ОписаниеПравила_Шаблон();
	ОписаниеПравила.Вставить("Раздел", Перечисления.упоРазделыПравилПроектногоБюджетирования.ДДС);
	ОписаниеПравила.Вставить("ТипыДокументов", ТипыДокументов);
	
	Возврат ОписаниеПравила;
	
КонецФункции

Функция ОписаниеПравила_Шаблон()
	
	ОписаниеПравила = Новый Структура;
	ОписаниеПравила.Вставить("Раздел", Неопределено);
	ОписаниеПравила.Вставить("ИмяМакета", "");
	ОписаниеПравила.Вставить("Наименование", "");
	ОписаниеПравила.Вставить("ОтключитьПравило", Ложь);
	ОписаниеПравила.Вставить("ТипыДокументов", Неопределено); 
	
	Возврат ОписаниеПравила;
	
КонецФункции

