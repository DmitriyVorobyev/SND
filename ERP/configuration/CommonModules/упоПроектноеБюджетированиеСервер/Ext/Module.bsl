Функция РезультатВыполненияСКДТаблицаЗначений(СхемаКомпоновкиДанных, 
	Знач НастройкиКомпоновщика, 
	ВнешниеНаборыДанных = Неопределено) Экспорт
	
	РезультатВыполнения = Новый ТаблицаЗначений;
	
	УстановитьПривилегированныйРежим(Истина);
		
	НастройкиКД = НастройкиКомпоновщика;
	Если ТипЗнч(НастройкиКомпоновщика) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		НастройкиКД = НастройкиКомпоновщика.ПолучитьНастройки();
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, 
													НастройкиКД,
													,
													,
													Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;	
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
			
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(РезультатВыполнения);
	РезультатВыполнения = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);

	УстановитьПривилегированныйРежим(Ложь);
		
	Возврат РезультатВыполнения;	
	
КонецФункции

Функция КомпоновщикНастроекСхемыКомпоновкиДанных(СхемаКомпоновкиДанных, НастройкиКомпоновки = Неопределено) Экспорт
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));	
	Если НастройкиКомпоновки = Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе	
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
	КонецЕсли;	
	
	Возврат КомпоновщикНастроек;
	
КонецФункции

Функция ДобавитьОтборНастройкиКомпоновщика(НастройкиКомпоновщика, ИмяОтбора, ЗначениеОтбора, ВидСравнения)  Экспорт
	
	ЭлементОтбора = Неопределено;
	
	ПолеОтбора = Новый ПолеКомпоновкиДанных(ИмяОтбора);
	
	Для Каждого Элемент Из НастройкиКомпоновщика.Отбор.Элементы Цикл		
		Если НЕ ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") 
			И Элемент.ЛевоеЗначение = ПолеОтбора Тогда
			ЭлементОтбора = Элемент;
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = НастройкиКомпоновщика.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	КонецЕсли;
		
	ЭлементОтбора.ЛевоеЗначение		= ПолеОтбора;
	ЭлементОтбора.ВидСравнения		= ВидСравнения;
	ЭлементОтбора.ПравоеЗначение	= ЗначениеОтбора;
	ЭлементОтбора.Использование		= Истина;
	
	Возврат ЭлементОтбора;
	
КонецФункции

Процедура ДобавитьСуммовойРесурсСКД(СхемаКомпоновкиДанных, ПутьКДанным, ВыражениеПоля = "Неопределено")
	
	ДобавитьВычисляемоеПолеСКД(СхемаКомпоновкиДанных, ПутьКДанным, ВыражениеПоля);
				
	НовыйРесурс = СхемаКомпоновкиДанных.ПоляИтога.Добавить();
	НовыйРесурс.ПутьКДанным = ПутьКДанным;
	НовыйРесурс.Выражение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("СУММА(%1)", НовыйРесурс.ПутькДанным);
			
КонецПроцедуры

Процедура ДобавитьВычисляемоеПолеСКД(СхемаКомпоновкиДанных, ПутьКДанным, ВыражениеПоля, ТипЗначения = Неопределено)
	
	ВычисляемоеПоле = СхемаКомпоновкиДанных.ВычисляемыеПоля.Добавить();
	
	ВычисляемоеПоле.ПутьКДанным = ПутьКДанным;
	ВычисляемоеПоле.Выражение = ВыражениеПоля;
	Если НЕ ТипЗначения = Неопределено Тогда
		ВычисляемоеПоле.ТипЗначения = ТипЗначения;
	КонецЕсли;
			
КонецПроцедуры

Процедура ДобавитьПараметрСКД(СхемаКомпоновкиДанных, ИмяПараметра, ЗначениеПараметра)
	
	Если СхемаКомпоновкиДанных.Параметры.Найти(ИмяПараметра) = Неопределено Тогда
		
		ЗначенияЗаполнения = Новый Структура("Имя, Значение, ВключатьВДоступныеПоля, Использование, ОграничениеИспользования", 
			ИмяПараметра,
			ЗначениеПараметра,
			ЗначениеПараметра = Неопределено,
			ИспользованиеПараметраКомпоновкиДанных.Всегда,
			Истина);
		
		НовыйПараметр = СхемаКомпоновкиДанных.Параметры.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйПараметр, ЗначенияЗаполнения);
						
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьОтборНаНулевыеРесурсы(НастройкиКомпоновщика)
	
	ДобавитьОтборНастройкиКомпоновщика(НастройкиКомпоновщика, "Сумма", Неопределено, ВидСравненияКомпоновкиДанных.Заполнено);

КонецПроцедуры

Процедура ДобавитьПоляОтбораПоПараметрам(НастройкиКомпоновщика, ИмяОтбора, ЗначенияОтбора)
	
	Если НЕ ЗначениеЗаполнено(ЗначенияОтбора) Тогда
		Возврат;
	КонецЕсли;	
	
	ВидСравненияОтбора = ?(ТипЗНЧ(ЗначенияОтбора) = Тип("Массив"),
		ВидСравненияКомпоновкиДанных.ВСписке, ВидСравненияКомпоновкиДанных.Равно);
	
	ДобавитьОтборНастройкиКомпоновщика(НастройкиКомпоновщика, ИмяОтбора, ЗначенияОтбора, ВидСравненияОтбора);
		
КонецПроцедуры	

Процедура ДобавитьПолеПорядкаНастройкиКомпоновщика(НастройкиКомпоновщика, ИмяПоляПорядка)
	
	НовоеПолеПорядка = НастройкиКомпоновщика.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных")); 
	НовоеПолеПорядка.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляПорядка);
	НовоеПолеПорядка.Использование = Истина;
		
КонецПроцедуры	

Процедура ДобавитьПолеГруппировкиНастройкиКомпоновщика(НастройкиКомпоновщика, ИмяГруппировки)
	
	СтруктураНастройкиКомпоновщика = НастройкиКомпоновщика.Структура;
	
	Если СтруктураНастройкиКомпоновщика.Количество() = 0 Тогда		
		Группировка = СтруктураНастройкиКомпоновщика.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		Группировка.Имя = ИмяГруппировки;
		Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		Группировка.Использование = Истина;
	Иначе
		Группировка = СтруктураНастройкиКомпоновщика[0];
	КонецЕсли;
			
	ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));	
	Если ЗначениеЗаполнено(ИмяГруппировки) Тогда
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяГруппировки);
	КонецЕсли;
	ПолеГруппировки.Использование = Истина;
		
КонецПроцедуры

Процедура ОтключитьВыводОбщихИтоговНастройкиКомпоновщика(НастройкиКомпоновщика) 
		
	НастройкиКомпоновщика.ПараметрыВывода.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ГоризонтальноеРасположениеОбщихИтогов"), 
		РасположениеИтоговКомпоновкиДанных.Нет);
	НастройкиКомпоновщика.ПараметрыВывода.УстановитьЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ВертикальноеРасположениеОбщихИтогов"), 
		РасположениеИтоговКомпоновкиДанных.Нет);
				
КонецПроцедуры

#КонецОбласти

#Область ПолучениеФактическихДанныхПоСтатьеERP

Функция ПолучитьТаблицуФактаПоПравилуERP(Параметры)
	
	МодульБюджетированиеСервер = ОбщегоНазначения.ОбщийМодуль("БюджетированиеСервер");
	
	ПараметрыБюджетирования = МодульБюджетированиеСервер.ШаблонПараметровПолученияФакта();
	ДополнитьПараметрыБюджетирования(ПараметрыБюджетирования, Параметры);
	
	НовыйКомпоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	ФактПоСтатьямБюджетов = МодульБюджетированиеСервер.ФактПоСтатьямБюджетов(
		НовыйКомпоновщик.Настройки, ПараметрыБюджетирования, Ложь, Ложь);
	
	Возврат ФактПоСтатьямБюджетов;
	
КонецФункции

Функция СкопироватьНаборДанных(СхемаКомпоновкиДанных, ИсходныйНаборДанных, ИмяТаблицы, ИмяПоля)
	
	НовыйНабор = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(НовыйНабор, ИсходныйНаборДанных);
	НовыйНабор.Имя = ИмяТаблицы;
	
	Для Каждого ПолеИсходногоНабора Из ИсходныйНаборДанных.Поля Цикл
		НовоеПоле = НовыйНабор.Поля.Добавить(ТипЗНЧ(ПолеИсходногоНабора));
		ЗаполнитьЗначенияСвойств(НовоеПоле, ПолеИсходногоНабора);				
		Если НовоеПоле.Поле <> "ПолеСвязи" Тогда
			НовоеПоле.ПутьКДанным = ИмяПоля;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат НовыйНабор;
	
КонецФункции	

Функция ТипыЗамещаемыхАналитикERP()
	
	ТипыЗамещаемыхАналитик = Новый Соответствие;
	ТипыЗамещаемыхАналитик.Вставить(Тип("СправочникСсылка.СтруктураПредприятия"), "Подразделение1");
	ТипыЗамещаемыхАналитик.Вставить(Тип("СправочникСсылка.Партнеры"), "Контрагент1");
	ТипыЗамещаемыхАналитик.Вставить(Тип("СправочникСсылка.НаправленияДеятельности"), "ПроектнаяЗадача1");
	ТипыЗамещаемыхАналитик.Вставить(Тип("СправочникСсылка.Проекты"), "ПроектнаяЗадача2");
	ТипыЗамещаемыхАналитик.Вставить(Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов"), "Статья1");
	ТипыЗамещаемыхАналитик.Вставить(Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов"), "Статья1");
	ТипыЗамещаемыхАналитик.Вставить(Тип("ПланВидовХарактеристикСсылка.СтатьиАктивовПассивов"), "Статья2");
	
	Возврат ТипыЗамещаемыхАналитик;
	
КонецФункции	

// Выполняет замену типов данных ERP на типы данных PM по макету таблицы меппинга.
//
// Параметры:
//  ТаблицаФакт  - Таблица значений - входящая таблица для автозамены.
//  НомераАналитик  - Соответствие - см. упоПроектноеБюджетированиеСервер.НомераАналитикСтатьиБюджета.
//  Правило  - СправочникСсылка.упоПравилаПроектногоБюджетирования - правило трансляции.
//
Процедура ВыполнитьАвтозаменуАналитикERP(ТаблицаФакт, НомераАналитик, Правило)
		
	КолонкиТаблицы = ТаблицаФакт.Колонки;
	
	// Автозамена имен расчетных колонок.
	КолонкиАвтозамены = Новый Соответствие;
	КолонкиАвтозамены.Вставить("СуммаВВалюте", "СуммаВалютная");
	КолонкиАвтозамены.Вставить("СуммаРегл", "Сумма");
	КолонкиАвтозамены.Вставить("ВалютаХранения", "Валюта");
	
	Для Каждого КолонкаАвтозамены Из КолонкиАвтозамены Цикл
		СуществующаяКолонка = КолонкиТаблицы.Найти(КолонкаАвтозамены.Значение);
		Если СуществующаяКолонка <> Неопределено Тогда
			КолонкиТаблицы.Удалить(СуществующаяКолонка);
		КонецЕсли;
		НайденнаяКолонка = КолонкиТаблицы.Найти(КолонкаАвтозамены.Ключ);
		Если НайденнаяКолонка <> Неопределено И КолонкиТаблицы.Найти(КолонкаАвтозамены.Значение) = Неопределено Тогда
			НайденнаяКолонка.Имя = КолонкаАвтозамены.Значение;
		КонецЕсли;
	КонецЦикла;
	
	РеквизитыСЗаполнениемПоАналитике = Правило.СопоставлениеРеквизитов.НайтиСтроки(
		Новый Структура("СпособЗаполнения", Истина)); 
	Если РеквизитыСЗаполнениемПоАналитике.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Поиск сопоставляемых реквизитов. 
	ТипыЗамещаемыхАналитик = ТипыЗамещаемыхАналитикERP();
	ТипыРеквизитовПравила = упоПроектноеБюджетированиеПовтИсп.ТипыЗначенийРеквизитовРазделаПравила(Правило.Раздел);
	
	ШаблонИмениАналитика = "Аналитика%1";
	АналитикиСопоставления = Новый Соответствие;
	Для Каждого РеквизитСЗаполнениемПоАналитике Из РеквизитыСЗаполнениемПоАналитике Цикл
		
		ИмяРеквизита = РеквизитСЗаполнениемПоАналитике.Реквизит; 
		Аналитика = РеквизитСЗаполнениемПоАналитике.ЗначениеЗаполнения;		
		Если НЕ ЗначениеЗаполнено(Аналитика) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ТипЗначенияРеквизита Из ТипыРеквизитовПравила[ИмяРеквизита].Типы() Цикл
			
			ТипЗначенияАналитики = Аналитика.ТипЗначения;
			Если ТипЗначенияАналитики.СодержитТип(ТипЗначенияРеквизита) Тогда
				Продолжить;
			КонецЕсли;		
			
			Для Каждого ПростойТипЗначенияАналитики Из ТипЗначенияАналитики.Типы() Цикл
				
				ИмяТаблицыМеппинга = ТипыЗамещаемыхАналитик[ПростойТипЗначенияАналитики];
				Если ИмяТаблицыМеппинга <> Неопределено Тогда					
					ИмяАналитики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмениАналитика, 
						НомераАналитик[Аналитика]);			
					ДанныеАналитики = Новый Структура("ИмяРеквизита, ИмяТаблицыМеппинга", 
						ИмяРеквизита, ИмяТаблицыМеппинга);
					АналитикиСопоставления.Вставить(ИмяАналитики, ДанныеАналитики);
				КонецЕсли;
				
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
	СхемаКомпоновкиДанных = Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования.ПолучитьМакет("МеппингАналитикERP");
	ПоляНабораТаблицыФакт = СхемаКомпоновкиДанных.НаборыДанных[0].Поля;
	ВыбранныеПоляСхемыКомпоновки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию.Выбор.Элементы;
	
	Для Каждого КолонкаТаблицы Из КолонкиТаблицы Цикл		
		НовоеПоле = ПоляНабораТаблицыФакт.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));		
		НовоеПоле.Поле = КолонкаТаблицы.Имя;
		НовоеПоле.ПутьКДанным = КолонкаТаблицы.Имя;		
		Если АналитикиСопоставления[КолонкаТаблицы.Имя] = Неопределено Тогда
			НовоеПоле = ВыбранныеПоляСхемыКомпоновки.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));	
			НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(КолонкаТаблицы.Имя);
		КонецЕсли;			
	КонецЦикла;
		
	КомпоновщикНастроек = КомпоновщикНастроекСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);			
	ВыбранныеПоляНастроек = КомпоновщикНастроек.Настройки.Выбор.Элементы;
	 	
	Для Каждого АналитикаСопоставления Из АналитикиСопоставления Цикл
				
		ИмяАналитики = АналитикаСопоставления.Ключ;									
		ИмяПоля = АналитикаСопоставления.Значение.ИмяТаблицыМеппинга;
		ИмяТаблицы = ИмяПоля + ИмяАналитики;			
		ИмяРеквизита = АналитикаСопоставления.Значение.ИмяРеквизита;
		
		СкопироватьНаборДанных(СхемаКомпоновкиДанных, СхемаКомпоновкиДанных.НаборыДанных.Найти(ИмяПоля), ИмяТаблицы, ИмяРеквизита);
		
		НоваяСвязь = СхемаКомпоновкиДанных.СвязиНаборовДанных.Добавить();						
		НоваяСвязь.НаборДанныхИсточник = "ТаблицаФакт";
		НоваяСвязь.НаборДанныхПриемник = ИмяТаблицы;
		НоваяСвязь.ВыражениеИсточник = ИмяАналитики;					
		НоваяСвязь.ВыражениеПриемник = "ПолеСвязи";
		
		ВыбранноеПолеКД = ВыбранныеПоляНастроек.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));													
		ВыбранноеПолеКД.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизита);
		
	КонецЦикла;
	
	ВнешниеНаборыДанных = Новый Структура("ТаблицаФакт", ТаблицаФакт);
	ТаблицаФакт = РезультатВыполненияСКДТаблицаЗначений(СхемаКомпоновкиДанных, 
														КомпоновщикНастроек.Настройки, 
														ВнешниеНаборыДанных);
	
КонецПроцедуры // ()

// Возвращает реквизиты правила, подлежашие автозамене. 
Функция РеквизитыАвтозаменыПравилаПоСтатьямERP(Раздел)
	
	РеквизитыАвтозамены = Новый Соответствие;
	РеквизитыАвтозамены.Вставить("Подразделение", "СправочникСсылка.упоПодразделения");
	РеквизитыАвтозамены.Вставить("Контрагент", "СправочникСсылка.Контрагенты");
	РеквизитыАвтозамены.Вставить("ПроектнаяЗадача", "ДокументСсылка.упоПроектнаяЗадача");	
	Если Раздел = Перечисления.упоРазделыПравилПроектногоБюджетирования.ДоходыРасходы Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить("СправочникСсылка.упоСтатьиЗатрат");
		МассивТипов.Добавить("СправочникСсылка.упоСтатьиДоходов");
		РеквизитыАвтозамены.Вставить("Статья", МассивТипов);
	Иначе
		РеквизитыАвтозамены.Вставить("СтатьяДДС", "СправочникСсылка.СтатьиДвиженияДенежныхСредств");
	КонецЕсли;	
			
	Возврат РеквизитыАвтозамены;
	
КонецФункции	

Процедура ДобавитьОбязательныеКолонкиТаблицыФакта(КолонкиТаблицы, РеквизитыАвтозамены, Раздел)
	
	Для Каждого РеквизитАвтозамены Из РеквизитыАвтозамены Цикл
		Если КолонкиТаблицы.Найти(РеквизитАвтозамены.Ключ) = Неопределено Тогда 
			КолонкиТаблицы.Добавить(РеквизитАвтозамены.Ключ, Новый ОписаниеТипов(РеквизитАвтозамены.Значение));
		КонецЕсли;	
	КонецЦикла;	
	
	Если Раздел = Перечисления.упоРазделыПравилПроектногоБюджетирования.ДДС Тогда	
		ИмяКолонки = "ДатаДвижения"; 
		Если КолонкиТаблицы.Найти(ИмяКолонки) = Неопределено Тогда
			КолонкиТаблицы.Добавить(ИмяКолонки, Новый ОписаниеТипов("Дата"));	
		КонецЕсли;
		ИмяКолонки = "НаправлениеДвижения"; 
		Если КолонкиТаблицы.Найти(ИмяКолонки) = Неопределено Тогда
			КолонкиТаблицы.Добавить(ИмяКолонки, Новый ОписаниеТипов("ПеречислениеСсылка.упоНаправлениеДвиженияДенежныхСредств"));	
		КонецЕсли;			
	Иначе 
		ИмяКолонки = "ВидЭлемента";
		Если КолонкиТаблицы.Найти(ИмяКолонки) = Неопределено Тогда
			КолонкиТаблицы.Добавить(ИмяКолонки, Новый ОписаниеТипов("ПеречислениеСсылка.упоВидЭлементаПланаДоходовИРасходов"));	
		КонецЕсли;		
	КонецЕсли;	
	
КонецПроцедуры	

Функция ФактПоПравилуПоСтатьямБюджетовERP(Правило, Параметры)
		
	ПравилоПолученияФактаПоСтатьямБюджетов = Правило.ПравилоПолученияФактаПоСтатьямБюджетов;
	
	Параметры.Вставить("ПравилоПоСтатьямБюджетов", ПравилоПолученияФактаПоСтатьямБюджетов);
		
	НомераАналитик = НомераАналитикСтатьиБюджета(ПравилоПолученияФактаПоСтатьямБюджетов.СтатьяБюджетов);
	
	ТаблицаФакт = ПолучитьТаблицуФактаПоПравилуERP(Параметры);
	
	Если ТаблицаФакт.Количество() = 0 Тогда
		Возврат ТаблицаФакт;
	КонецЕсли;	
		
	ВыполнитьАвтозаменуАналитикERP(ТаблицаФакт, НомераАналитик, Правило);
	
	КолонкиТаблицы = ТаблицаФакт.Колонки;
	
	РеквизитыАвтозамены = РеквизитыАвтозаменыПравилаПоСтатьямERP(Правило.Раздел);
	
	ДобавитьОбязательныеКолонкиТаблицыФакта(КолонкиТаблицы, РеквизитыАвтозамены, Правило.Раздел);
					
	Для Каждого СтрокаСопоставления Из Правило.СопоставлениеРеквизитов Цикл
			
		Аналитика = СтрокаСопоставления.ЗначениеЗаполнения;		
		Если Не ЗначениеЗаполнено(Аналитика) Тогда
			Продолжить;
		КонецЕсли;	
		
		ЭтоРеквизитАвтозамены = РеквизитыАвтозамены.Получить(СтрокаСопоставления.Реквизит) <> Неопределено; 
		
		Если НЕ СтрокаСопоставления.СпособЗаполнения Тогда			
			Если КолонкиТаблицы.Найти(СтрокаСопоставления.Реквизит) = Неопределено Тогда
				КолонкиТаблицы.Добавить(СтрокаСопоставления.Реквизит);			
			КонецЕсли;	
			ТаблицаФакт.ЗаполнитьЗначения(Аналитика, СтрокаСопоставления.Реквизит);	
		Иначе					
			НомерАналитики = НомераАналитик[Аналитика];
			Если НомерАналитики <> Неопределено Тогда				
				ИмяАналитики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Аналитика%1", НомерАналитики);
				КолонкаТаблицы = КолонкиТаблицы.Найти(ИмяАналитики);
				Если КолонкаТаблицы <> Неопределено Тогда					
					ИмяКолонки = СтрокаСопоставления.Реквизит;
					Если ЭтоРеквизитАвтозамены Тогда
						ИмяКолонки  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1%2", ИмяКолонки, "0"); 
						// Суффикс "0" зарезервирован для полей с заполнением из реквизита.
					КонецЕсли;						
					КолонкаТаблицы.Имя = ИмяКолонки;												
				КонецЕсли;				
			КонецЕсли;			
		КонецЕсли;
		
	КонецЦикла;	
			
	Для Каждого СтрокаФакт Из ТаблицаФакт Цикл
					
		Для Каждого РеквизитАвтозамены Из РеквизитыАвтозамены Цикл						
			// Если ячейка автозамены не заполнена указанным значением - подбираем значение из вариантов по приоритетам.
			Если НЕ ЗначениеЗаполнено(СтрокаФакт[РеквизитАвтозамены.Ключ]) Тогда
				Для НомерАвтозамены = 0 По 2 Цикл
					ИмяКолонкиВарианта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1%2", РеквизитАвтозамены.Ключ, НомерАвтозамены);
					Если КолонкиТаблицы.Найти(ИмяКолонкиВарианта) <> Неопределено 
						И ЗначениеЗаполнено(СтрокаФакт[ИмяКолонкиВарианта]) Тогда
						СтрокаФакт[РеквизитАвтозамены.Ключ] = СтрокаФакт[ИмяКолонкиВарианта];
						Прервать;
					КонецЕсли;									
				КонецЦикла;
			КонецЕсли;	
		КонецЦикла;	
		
		Если Правило.Раздел = Перечисления.упоРазделыПравилПроектногоБюджетирования.ДДС Тогда						
			СтрокаФакт.ДатаДвижения = СтрокаФакт.Период;
			Если ЗначениеЗаполнено(СтрокаФакт.СтатьяДДС) Тогда
				СтрокаФакт.НаправлениеДвижения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаФакт.СтатьяДДС, "упоНаправлениеДвижения");
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(СтрокаФакт.Статья) И НЕ ЗначениеЗаполнено(СтрокаФакт.ВидЭлемента) Тогда
				СтрокаФакт.ВидЭлемента = ?(ТипЗНЧ(СтрокаФакт.Статья) = Тип("СправочникСсылка.упоСтатьиЗатрат"), 
					Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход, 
					Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход);
			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ТаблицаФакт;
	
КонецФункции	

Процедура ДополнитьПараметрыБюджетирования(ПараметрыБюджетирования, ПараметрыЗаполнения)
	
	ПараметрыБюджетирования.Вставить("ВызовИзEPM", Истина);
	ПараметрыБюджетирования.Вставить("ОтборПоРегистраторам");
	ПараметрыБюджетирования.Вставить("ПравилоПоСтатьямБюджетов");
	ПараметрыБюджетирования.ПоРегистратору = Истина;
	ПараметрыБюджетирования.ВозвращатьУпрИРеглСуммы = Истина;
	// Зафиксировано в версии EPM 2.5.10.84, что параметр не используется. Оставлен для совместимости с EPM 2.5.8.
	ПараметрыБюджетирования.Вставить("ВозвращатьСуммуВВалюте", Ложь); 
	ПараметрыБюджетирования.РежимПолученияДанных = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
		"Перечисление.РежимПолученияДанныхБюджетирования.Все");
	
	ЗаполнитьЗначенияСвойств(ПараметрыБюджетирования, ПараметрыЗаполнения);
	
	Период = Новый СтандартныйПериод;
	Период.ДатаНачала = ПараметрыЗаполнения.НачалоПериода;
	Период.ДатаОкончания = ПараметрыЗаполнения.КонецПериода;
	ПараметрыБюджетирования.Вставить("Период", Период);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыБюджетирования.Периодичность) Тогда
		ПараметрыБюджетирования.Периодичность = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
			"Перечисление.Периодичность.День");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция НастройкиКомпоновщикаПравилаСПроверкой(СхемаКомпоновкиДанных, Правило, ДокументОснование, ОшибкиПользователю, Отказ)
			
	НастройкиКомпоновщика = Неопределено;
	ТекстОшибки = "";
	
	Если СхемаКомпоновкиДанных.НаборыДанных.Количество() = 0 Тогда							
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Правило ""%1"": Пустая схема компоновки данных в источнике (нет наборов данных).'"),
			Правило); 			   																	
			
	Иначе		
		
		ПоляНабораДанных = СхемаКомпоновкиДанных.НаборыДанных[0].Поля;						
		Если ПоляНабораДанных.Количество() = 0 Тогда //Пустая схема.
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Правило ""%1"": Пустая схема компоновки данных в источнике (нет полей в наборе данных).'"),
				Правило); 			   																					
			
		ИначеЕсли ПроверитьНаличиеОбязательныхПолейСКД(ПоляНабораДанных, Правило, ДокументОснование, ОшибкиПользователю) Тогда												
			
			Попытка								
				
				НастройкиКомпоновки = Правило.НастройкиКомпоновкиДанных.Получить();
				
				НастройкиКомпоновщика = КомпоновщикНастроекСхемыКомпоновкиДанных(СхемаКомпоновкиДанных, НастройкиКомпоновки).ПолучитьНастройки();			
				Отказ = Ложь;
				
			Исключение				
				
				ТекстОшибки = ОписаниеОшибки();					
				
			КонецПопытки;
			
		КонецЕсли;			
		
	КонецЕсли;	
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиПользователю, "", ТекстОшибки, Правило);		
	КонецЕсли;	
	
	Возврат НастройкиКомпоновщика;
	
КонецФункции

Функция ПроверитьНаличиеОбязательныхПолейСКД(ПоляНабораДанных, Правило, ДокументОснование, ОшибкиПользователю)	
	
	Успешно = Истина;
	
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("Период");
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ОбязательныеПоля.Добавить("Регистратор");
	КонецЕсли;	
	ОбязательныеПоля.Добавить("Сумма");
	
	ТекстОтсутствуетОбязательноеПоле = НСтр("ru = 'В схеме правила ""%1"" отсутствует обязательное поле ""%2"".'");
			
	Для Каждого ОбязательноеПоле Из ОбязательныеПоля Цикл 
		
		Если ПоляНабораДанных.Найти(ОбязательноеПоле) = Неопределено Тогда			
			
			Успешно = Ложь;
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОтсутствуетОбязательноеПоле, 
				Правило, ОбязательноеПоле); 				   														
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиПользователю, "" , ТекстОшибки, Правило, , ТекстОшибки);
			
		КонецЕсли;
		
	КонецЦикла;	
		
	Возврат Успешно;
	
КонецФункции

Функция ПроверитьЗаполнениеПравила(Правило, ДокументОснование, ОшибкиПользователю)
	
	Успешно = ЗначениеЗаполнено(Правило);
	
	Если НЕ Успешно И ЗначениеЗаполнено(ДокументОснование) Тогда
																			
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для типа документов ""%1"" не найдено действующее правило отражения.'"), 
			ДокументОснование.Метаданные().Синоним); 	
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиПользователю, "", ТекстОшибки, Правило);
					    	
	КонецЕсли;	
			
	Возврат Успешно;
	
КонецФункции

Процедура ЗаполнитьРеквизитыПравила(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Правило)  
		
	КэшТиповРеквизитов = упоПроектноеБюджетированиеПовтИсп.ТипыЗначенийРеквизитовРазделаПравила(Правило.Раздел);
				
	ПустоеЗначение = Новый Массив;
	ПустоеЗначение.Добавить(Тип("Неопределено"));
	ПустоеЗначение.Добавить(Тип("Null"));
    ТипПустоеЗначение = Новый ОписаниеТипов(ПустоеЗначение);
			
	Для Каждого СтрокаРеквизита Из Правило.СопоставлениеРеквизитов Цикл
									
		Если НЕ СтрокаРеквизита.СпособЗаполнения Тогда			    				
			ИмяПараметра = СтрокаРеквизита.Реквизит;				
			ДобавитьПараметрСКД(СхемаКомпоновкиДанных, ИмяПараметра, СтрокаРеквизита.ЗначениеЗаполнения);
			Выражение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("&%1", ИмяПараметра);
		Иначе				
			Выражение = СтрокаРеквизита.ЗначениеЗаполнения;
		КонецЕсли;
		    		
		Если ЗначениеЗаполнено(Выражение) Тогда
			ТипЗначения = КэшТиповРеквизитов[СтрокаРеквизита.Реквизит];			
		Иначе
			ТипЗначения = ТипПустоеЗначение;			
			Выражение = ?(ЗначениеЗаполнено(СтрокаРеквизита.Реквизит), "НЕОПРЕДЕЛЕНО", "NULL")
		КонецЕсли;
				
		ДобавитьВычисляемоеПолеСКД(СхемаКомпоновкиДанных, СтрокаРеквизита.Реквизит, Выражение, ТипЗначения);  
				
		ДобавитьПолеГруппировкиНастройкиКомпоновщика(НастройкиКомпоновщика, СтрокаРеквизита.Реквизит); 
				
	КонецЦикла;			
	
КонецПроцедуры

Процедура ЗаполнитьРесурсыПравила(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Правило)
	
	ЕстьКоличество = Правило.Раздел = Перечисления.упоРазделыПравилПроектногоБюджетирования.ДоходыРасходы;
	
	ПоляРесурсов = Новый Массив;
	ПоляРесурсов.Добавить("Сумма");
	
	ПоляНабора = СхемаКомпоновкиДанных.НаборыДанных[0].Поля;
	Если ПоляНабора.Найти("СуммаВалютная") <> Неопределено Тогда
		ПоляРесурсов.Добавить("СуммаВалютная");
	КонецЕсли;		
	Если ЕстьКоличество И ПоляНабора.Найти("Количество") <> Неопределено Тогда
		ПоляРесурсов.Добавить("Количество");
	КонецЕсли;	
			
	Для каждого ИмяПоля Из ПоляРесурсов Цикл					
		
		ДобавитьСуммовойРесурсСКД(СхемаКомпоновкиДанных, ИмяПоля, ИмяПоля);
				
		ВыбранноеПолеКД = НастройкиКомпоновщика.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПолеКД.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
			
	КонецЦикла;
		
КонецПроцедуры	

Процедура УстановитьОтборПоПериоду(СхемаКомпоновкиДанных, НастройкиКомпоновщика, Параметры)
	
	ПоляПериода = Новый Массив;
	ПоляПериода.Добавить("НачалоПериода");
	ПоляПериода.Добавить("КонецПериода");
		
	Для Каждого ПолеПериода Из ПоляПериода Цикл
		Если Параметры.Свойство(ПолеПериода) И ЗначениеЗаполнено(Параметры[ПолеПериода]) Тогда 			
			Если СхемаКомпоновкиДанных.Параметры.Найти(ПолеПериода) <> Неопределено Тогда					
				НастройкиКомпоновщика.ПараметрыДанных.УстановитьЗначениеПараметра(
					Новый ПараметрКомпоновкиДанных(ПолеПериода), 
					Параметры[ПолеПериода]); 				
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры			

Процедура УстановитьОтборИзНастройки(СхемаПриемник, НастройкиПриемник, НастройкиИсточник)
	
	ЭлементыОтбораИсточник = НастройкиИсточник.Отбор.Элементы;
	ЭлементыОтбораПриемник = НастройкиПриемник.Отбор.Элементы;
	
	Для Каждого ЭлементОтбораИсточник Из ЭлементыОтбораИсточник Цикл
		Если ТипЗнч(ЭлементОтбораИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда			
			ДобавитьВОтборГруппуЭлементовРекурсивно(НастройкиПриемник.Отбор, ЭлементОтбораИсточник);		    		
		Иначе			
			ЗаполнитьЗначенияСвойств(ЭлементыОтбораПриемник.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")), 
				ЭлементОтбораИсточник);							
		КонецЕсли;
		
	КонецЦикла;
	
	// Нужно исправить настройки приемника, т.к. в отборе источника могут быть поля, которые недоступны в приемнике.
	// Восстановление настроек так же убирает поля, на которые нет прав на просмотр, чтобы этого не происходило
	// устанавливаем привилегированный режим.
	УстановитьПривилегированныйРежим(Истина);
	КомпоновщикНастроекЗапроса = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроекЗапроса.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаПриемник));
	КомпоновщикНастроекЗапроса.ЗагрузитьНастройки(НастройкиПриемник);
	КомпоновщикНастроекЗапроса.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
	НастройкиПриемник = КомпоновщикНастроекЗапроса.ПолучитьНастройки();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ДобавитьВОтборГруппуЭлементовРекурсивно(ОтборПриемник, ГруппаОтбораИсточник)
	
	НоваяГруппаПриемник = ОтборПриемник.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ЗаполнитьЗначенияСвойств(НоваяГруппаПриемник, ГруппаОтбораИсточник);
	
	Для Каждого ЭлементОтбораИсточник Из ГруппаОтбораИсточник.Элементы Цикл
		Если ТипЗнч(ЭлементОтбораИсточник) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДобавитьВОтборГруппуЭлементовРекурсивно(НоваяГруппаПриемник, ЭлементОтбораИсточник);
		Иначе			
			ЗаполнитьЗначенияСвойств(НоваяГруппаПриемник.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")),
				ЭлементОтбораИсточник);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОтражениеПервичныхДокументов

// Выполняет отражение первичных документов, находящихся в очереди к отражению.
// Является методом регламентного задания упоОтражениеДокументовВПроектномБюджетировании.
//
Функция ВыполнитьОтражениеДокументов() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.упоОтражениеДокументовВПроектномБюджетировании);
	
	ИдентификаторОчереди = Новый УникальныйИдентификатор;
	МенеджерОтражения = Документы.упоОтражениеФактаВПроектномБюджетировании; 
	
	СтатусыОтражения = упоПроектноеБюджетированиеПовтИсп.СтатусыОтражения("ОшибкиОтражения");
	СтатусыОтражения.Добавить(Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.КОтражению);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 100
	                      |	упоОчередьДокументовКОтражениюВПроектномБюджетировании.Документ КАК Документ
	                      |ИЗ
	                      |	РегистрСведений.упоОчередьДокументовКОтражениюВПроектномБюджетировании КАК упоОчередьДокументовКОтражениюВПроектномБюджетировании
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоОтражениеДокументовВПроектномБюджетировании КАК упоОтражениеДокументовВПроектномБюджетировании
	                      |		ПО упоОчередьДокументовКОтражениюВПроектномБюджетировании.Документ = упоОтражениеДокументовВПроектномБюджетировании.Документ
	                      |			И (упоОтражениеДокументовВПроектномБюджетировании.Статус В (&Статус))
	                      |			И (упоОчередьДокументовКОтражениюВПроектномБюджетировании.ИдентификаторЗаписи <> &ИдентификаторОчереди)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	упоОчередьДокументовКОтражениюВПроектномБюджетировании.ПериодЗаписи");
	Запрос.УстановитьПараметр("Статус", СтатусыОтражения);
	Запрос.УстановитьПараметр("ИдентификаторОчереди", ИдентификаторОчереди);
	
	ЕстьДокументы = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пока ЕстьДокументы Цикл
		
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			ЕстьДокументы = Ложь;
		Иначе
			Выборка = Результат.Выбрать();
			
			ОбщееКоличествоДокументов = Выборка.Количество();
			ОбработаноДокументов = 0;
			ПредыдущийПроцент = 0;
			
			Пока Выборка.Следующий() Цикл
				
				НачатьТранзакцию();
				
				Блокировка = Новый БлокировкаДанных;
				ИмяДокумента = Выборка.Документ.Метаданные().Имя;
				ЭлементБлокировки = Блокировка.Добавить("Документ." + ИмяДокумента);
				ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Документ); 
				Блокировка.Заблокировать();
				
				Попытка
					
					МенеджерОтражения.СоздатьЗаполнитьДокументОтражение(Выборка.Документ,,,ИдентификаторОчереди);
					
					ЗафиксироватьТранзакцию();
					
				Исключение
					
					ОтменитьТранзакцию();
					
					Текст = НСтр("ru = 'Ошибка при создании документа отражение: '") 
							+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации(ИмяСобытияОтражениеДляЖР(), 
						УровеньЖурналаРегистрации.Ошибка,
						,
						, 
						Текст);
				КонецПопытки;
				
				ОбработаноДокументов = ОбработаноДокументов + 1;
				Процент = Окр(ОбработаноДокументов / ОбщееКоличествоДокументов * 100);
				ПроцентКратен = (Процент % 3) = 0; 	// Выбрана кратность 3% с целью уменьшить количество обращений для
													// сообщения прогресса (Рекомендация 1С - не более 100 за одну операцию).
													// При этом, у 3 достаточное количество делимых, чтобы отображать прогресс
													// при разном количестве документов с удовлетворительной частотой.
				Если Не (ПредыдущийПроцент = Процент)
					И ПроцентКратен Тогда
					ТекстПрогресса = НСтр("ru = 'Обрабатывается документ: '") + Выборка.Документ;
					ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса); 
					ПредыдущийПроцент = Процент;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура ОбновитьСтатусОтраженияДокумента(Документ, Статус = Неопределено, Очистить = Ложь)
			
	НЗ = РегистрыСведений.упоОтражениеДокументовВПроектномБюджетировании.СоздатьНаборЗаписей();	
	НЗ.ДополнительныеСвойства.Вставить("упоИгнорироватьОповещения", Истина);
	НЗ.Отбор.Документ.Установить(Документ);
	НЗ.Прочитать();
													
	Если НЗ.Количество() > 0 Тогда
		НЗ.Очистить();
	КонецЕсли;	
	
	Если НЕ Очистить Тогда
		Запись = НЗ.Добавить();
		Запись.Документ = Документ;
		Запись.Статус = Статус; 			
	КонецЕсли;	
	
	Если НЗ.Модифицированность() Тогда
		НЗ.Записать();
	КонецЕсли;	
	
КонецПроцедуры

