// Положительные отклонения и отставания (просрочки) выделяются красным, отрицательные (опережения) - заленым.
// Просрочки и опережения закрытых и завершенных задач цветом не выделяются.
//
Процедура ДобавитьУсловноеОформлениеОтклонениеПоСрокам(Форма, ИмяПоказателя, БольшеИлиРавно = Ложь)
	
	Если НЕ КолонкаОтмеченаВСпискеКолонок(Форма.СписокКолонок, ИмяПоказателя) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыУО = Форма.УсловноеОформление.Элементы;
	
	СтатусыЗадачБезРаскраски = Новый СписокЗначений;
	СтатусыЗадачБезРаскраски.Добавить(ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Завершена"));
	СтатусыЗадачБезРаскраски.Добавить(ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта"));
	
	ПолеКомпоновкиПоказатель = Новый ПолеКомпоновкиДанных("ДеревоЗадач" + ИмяПоказателя);
	
	ЭлементУО = ЭлементыУО.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветОтрицательногоОтклоненияУО());
	Если БольшеИлиРавно Тогда
		ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	Иначе
		ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Больше;
	КонецЕсли;
	ДобавитьЭлементОтбора(ЭлементУО, "ДеревоЗадач." + ИмяПоказателя, ВидСравненияОтбора, 0);
	ДобавитьЭлементОтбора(ЭлементУО, "ДеревоЗадач.Статус", ВидСравненияКомпоновкиДанных.НеВСписке, 
		СтатусыЗадачБезРаскраски);
	ОформляемоеПоле 	 		 = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле 		 = ПолеКомпоновкиПоказатель;
	//
	ЭлементУО = ЭлементыУО.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветПоложительногоОтклоненияУО());
	ДобавитьЭлементОтбора(ЭлементУО, "ДеревоЗадач." + ИмяПоказателя, ВидСравненияКомпоновкиДанных.Меньше, 0);
	ДобавитьЭлементОтбора(ЭлементУО, "ДеревоЗадач.Статус", ВидСравненияКомпоновкиДанных.НеВСписке, 
		СтатусыЗадачБезРаскраски);
	ОформляемоеПоле 	 		 = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле 		 = ПолеКомпоновкиПоказатель;
	
	ЭлементУО = ЭлементыУО.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Формат", "ЧДЦ=0");
	ОформляемоеПоле 	 		 = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле 		 = ПолеКомпоновкиПоказатель;

КонецПроцедуры

