	ОтборЭлемента.ЛевоеЗначение	 = 	Новый ПолеКомпоновкиДанных("ДеревоЗадач." + ИмяОсновногоПоказателя);
	Если Наоборот Тогда
		ОтборЭлемента.ВидСравнения	 = 	ВидСравненияКомпоновкиДанных.Больше;
	Иначе
		ОтборЭлемента.ВидСравнения	 = 	ВидСравненияКомпоновкиДанных.Меньше;
	КонецЕсли;
	ОтборЭлемента.ПравоеЗначение = 	Новый ПолеКомпоновкиДанных("ДеревоЗадач." + ИмяПоказателяВерсии);
	ОтборЭлемента = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение	 = 	Новый ПолеКомпоновкиДанных("ВерсияДляПоказателейПоВерсии");
	ОтборЭлемента.ВидСравнения	 = 	ВидСравненияКомпоновкиДанных.Заполнено;	
	Если ПроверкаНаЗаполнение Тогда
		ОтборЭлемента = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение	 = 	Новый ПолеКомпоновкиДанных("ДеревоЗадач." + ИмяПоказателяВерсии);
		ОтборЭлемента.ВидСравнения	 = 	ВидСравненияКомпоновкиДанных.Заполнено;		
	КонецЕсли;
	// Колонка сравнения скрыта.
	ОтборЭлемента.ЛевоеЗначение = 	Новый ПолеКомпоновкиДанных("ДеревоЗадач." + ИмяПоказателяВерсии);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
    ОтборЭлемента.ПравоеЗначение = Неопределено;

	ОформляемоеПоле 	 		 = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле 		 = Новый ПолеКомпоновкиДанных("ДеревоЗадач" + ИмяОсновногоПоказателя);			

