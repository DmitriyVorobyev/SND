
#Область ПрограммныйИнтерфейс

#Область СложныеПоказатели

// Рассчитать сложные показатели в строке.
//
// Параметры:
//  СтрокаДерева - СтрокаДереваЗначений	 - строка дерева задач структуры проекта, в которой производится расчет.
//  Показатели	 - Структура			 - см. СтруктураСложныхПоказателей.
//
Процедура РассчитатьСложныеПоказателиВСтроке(СтрокаДерева, Показатели) Экспорт
	
	Если Показатели.Свойство("ФОТРасчетный") Тогда
		
		Если СтрокаДерева.Статус = 
				ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаЗадачи.Завершена")
			Или СтрокаДерева.Статус = 
				ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта") Тогда
			ПрямыеЗатратыДляРасчетаФОТ = СтрокаДерева.ФактПоСтатьямПрямыхРасходов;
		Иначе
			ПрямыеЗатратыДляРасчетаФОТ = Макс(СтрокаДерева.ПланПоСтатьямПрямыхРасходов, СтрокаДерева.ФактПоСтатьямПрямыхРасходов);
		КонецЕсли;
		
		СтрокаДерева.ФОТРасчетный = (Макс(СтрокаДерева.ДоходПланЗаВычетомСССП, СтрокаДерева.ОбъемыПланЗаВычетомСССП) 
			- ПрямыеЗатратыДляРасчетаФОТ) * Показатели.ПроцентФОТ;
		
		Если СтрокаДерева.ФОТРасчетный < 0 Тогда
			СтрокаДерева.ФОТРасчетный = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Показатели.Свойство("TCPI") Тогда
		СтрокаДерева.TCPI = 0;
		Если СтрокаДерева.РасходПлан <> СтрокаДерева.РасходФакт Тогда
			СтрокаДерева.TCPI = (СтрокаДерева.РасходПлан - СтрокаДерева.EV) 
				/ (СтрокаДерева.РасходПлан - СтрокаДерева.РасходФакт) * 100;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Набор показателей для расчета в структуре.
//
// Параметры:
//  СтруктураВыводимыхКолонок	 - Структура - набор выведенных колонок в структуре проекта.
// 
// Возвращаемое значение:
//  Структура - показатели для расчета.
//
Функция СтруктураСложныхПоказателей(Знач СтруктураВыводимыхКолонок) Экспорт
	
	СложныеПоказатели = Новый Структура;
	Если СтруктураВыводимыхКолонок.Свойство("ФОТРасчетный") Тогда
		СложныеПоказатели.Вставить("ФОТРасчетный");
		ПроцентФОТ = Константы.упоПроцентФОТ.Получить() / 100;
		СложныеПоказатели.Вставить("ПроцентФОТ", ПроцентФОТ);
	КонецЕсли;

	Если СтруктураВыводимыхКолонок.Свойство("TCPI") Тогда
		СложныеПоказатели.Вставить("TCPI");
	КонецЕсли;
	
	Возврат СложныеПоказатели;
	
КонецФункции

#КонецОбласти

