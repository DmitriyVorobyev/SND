КонецФункции

#Область РаботаСМетаданными

// Получить список реквизитов объекта.
//
// Параметры:
//  СсылкаНаОбъект	 - Произвольный - ссылка на объект.
//
// Возвращаемое значение:
//	СписокЗначений - список, где значение элемента - имя реквизита, представление - синоним.
//
Функция ПолучитьСписокРеквизитовОбъекта(СсылкаНаОбъект) Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	
	Если СсылкаНаОбъект <> Неопределено Тогда
		Для Каждого Реквизит Из СсылкаНаОбъект.Метаданные().Реквизиты Цикл
			СписокЗначений.Добавить(Реквизит.Имя, Реквизит.Синоним);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокЗначений;
	
КонецФункции

// Получает список табличных частей объекта.
//
// Параметры:
//  СсылкаНаОбъект	 - Произвольный - ссылка на объект.
//
// Возвращаемое значение:
//	СписокЗначений - список, где значение элемента - имя таличной части, а представление - ее синоним.
//
Функция ПолучитьСписокТабличныхЧастейОбъекта(СсылкаНаОбъект) Экспорт
	
	СписокЗначений = Новый СписокЗначений;
	
	Если СсылкаНаОбъект <> Неопределено Тогда
		Попытка
			Для Каждого ТабличнаяЧасть Из СсылкаНаОбъект.Метаданные().ТабличныеЧасти Цикл
				СписокЗначений.Добавить(ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат СписокЗначений;
	
КонецФункции

// Разбирает строковый путь к объекту метаданных PM и возвращает структуру. 
//
// Параметры:
//  ПутьКДанным	 - Строка - Строковое представление пути к объекту метаданных.
// 
// Возвращаемое значение:
//  Структура - Структура строк пути к объекту метаданных.
//
Функция РазобратьПутьКОбъектуМетаданных(ПутьКДанным) Экспорт 
	
	Структура = Новый Структура;
	
	СоответствиеИмен = Новый Массив();
	СоответствиеИмен.Добавить("ТипОбъекта");
	СоответствиеИмен.Добавить("ВидОбъекта");
	СоответствиеИмен.Добавить("ПутьКДанным");
	СоответствиеИмен.Добавить("ИмяТаблЧасти");
	СоответствиеИмен.Добавить("ИмяРеквизита");
	
	Для индекс = 1 По 3 Цикл
		
		Точка = Найти(ПутьКДанным, ".");
		ТекущееЗначение = Лев(ПутьКДанным, Точка-1);
		Структура.Вставить(СоответствиеИмен[индекс-1], ТекущееЗначение);
		ПутьКДанным = Сред(ПутьКДанным, Точка+1);
		
	КонецЦикла;
	
	ПутьКДанным = СтрЗаменить(ПутьКДанным, "Реквизит.", "");
	
	Если Структура.ПутьКДанным = "ТабличнаяЧасть" Тогда
		
		Для индекс = 4 По 5  Цикл 
			
			Точка = Найти(ПутьКДанным, ".");
			Если Точка = 0 Тогда
				ТекущееЗначение = ПутьКДанным;
			Иначе
				ТекущееЗначение = Лев(ПутьКДанным, Точка-1);
			КонецЕсли;
			
			Структура.Вставить(СоответствиеИмен[индекс-1], ТекущееЗначение);
			ПутьКДанным = Сред(ПутьКДанным,  Точка+1);
			
		КонецЦикла;
		
	Иначе
		
		Структура.Вставить(СоответствиеИмен[3], "");
		Структура.Вставить(СоответствиеИмен[4], ПутьКДанным);
		
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

// Возвращает имя базового типа по переданному значению объекта метаданных.
//  см.ОбщегоНазначения.ИмяБазовогоТипаПоОбъектуМетаданных
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных	 - объект метаданных, по которому необходимо определить ссылочный тип.
// 
// Возвращаемое значение:
//  Строка - имя ссылочного типа по переданному значению объекта метаданных.
//
Функция ИмяСсылочногоТипаПоОбъектуМетаданных(ОбъектМетаданных) Экспорт
	
	Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат "Документ";
		
	ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат "Справочник";
		
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланОбмена";
		
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланВидовХарактеристик";
		
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		Возврат "БизнесПроцесс";
		
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		Возврат "Задача";
		
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланСчетов";
		
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланВидовРасчета";
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

// Возвращает имя базового типа по переданному значению объекта метаданных.
//  см.ОбщегоНазначения.ИмяБазовогоТипаПоОбъектуМетаданных
//
// Параметры:
//  ТипОбъектаМетаданных - ТипОбъектаМетаданных	 - объект метаданных, по которому необходимо определить ссылочный тип.
// 
// Возвращаемое значение:
//  Строка - имя ссылочного типа по переданному значению объекта метаданных.
//
Функция ИмяСсылочногоТипаПоТипуМетаданных(ТипОбъектаМетаданных) Экспорт
	
	Если Метаданные.Документы = ТипОбъектаМетаданных Тогда
		Возврат "Документ";
		
	ИначеЕсли Метаданные.Справочники = ТипОбъектаМетаданных Тогда
		Возврат "Справочник";
		
	ИначеЕсли Метаданные.ПланыОбмена = ТипОбъектаМетаданных Тогда
		Возврат "ПланОбмена";
		
	ИначеЕсли Метаданные.ПланыВидовХарактеристик = ТипОбъектаМетаданных Тогда
		Возврат "ПланВидовХарактеристик";
		
	ИначеЕсли Метаданные.БизнесПроцессы = ТипОбъектаМетаданных Тогда
		Возврат "БизнесПроцесс";
		
	ИначеЕсли Метаданные.Задачи = ТипОбъектаМетаданных Тогда
		Возврат "Задача";
		
	ИначеЕсли Метаданные.ПланыСчетов = ТипОбъектаМетаданных Тогда
		Возврат "ПланСчетов";
		
	ИначеЕсли Метаданные.ПланыВидовРасчета = ТипОбъектаМетаданных Тогда
		Возврат "ПланВидовРасчета";
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
КонецФункции

// Возвращает тип объектов метаданных с исключенными объектами, помеченными в синониме как "(не использовать)" и проч.
//
// Параметры:
//  ПроверяемыеМетаданные	 - Массив, КоллекцияОбъектовМетаданных - метаданные, из состава которых 
//  необходимо исключить помеченные объекты.
// 
// Возвращаемое значение:
//  ОписаниеТипов - описание типа для реквизита формы.
//
Функция ТипыМетаданных_УбратьНеиспользуемые(Знач ПроверяемыеМетаданные = Неопределено) Экспорт
	
	МассивТипов = Новый Массив;
	
	ПроверяемыеВставки = ПроверяемыеВставкиСинонимовОбъектовМетаданныхДляИсключения();
	
	Если ПроверяемыеМетаданные = Неопределено Тогда
		мПроверяемыеМетаданные = Новый Массив;
		мПроверяемыеМетаданные.Добавить(Метаданные.Справочники);
		мПроверяемыеМетаданные.Добавить(Метаданные.Документы);
	ИначеЕсли 
		ТипЗнч(ПроверяемыеМетаданные) = Тип("КоллекцияОбъектовМетаданных") Тогда
		мПроверяемыеМетаданные = Новый Массив;
		мПроверяемыеМетаданные.Добавить(ПроверяемыеМетаданные);
	Иначе
		мПроверяемыеМетаданные = ПроверяемыеМетаданные;
	КонецЕсли;
	
	ШаблонТипа = "%1Ссылка.%2";
	
	Для Каждого ТипМетаданных Из мПроверяемыеМетаданные Цикл
		
		ТипМетаданныхСтрокой = упоФункцииОбщегоНазначенияСервер.ИмяСсылочногоТипаПоТипуМетаданных(ТипМетаданных);
		Если Не ЗначениеЗаполнено(ТипМетаданныхСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ЭлементМетаданных Из ТипМетаданных Цикл
			
			ИспользованиеОбъекта = ИспользованиеОбъектаМетаданныхПоСинониму(ЭлементМетаданных.Синоним, ПроверяемыеВставки);
			
			Если Не ИспользованиеОбъекта Тогда
				Продолжить; // Продолжить
			КонецЕсли;
			
			МассивТипов.Добавить(Тип(СтрШаблон(ШаблонТипа, ТипМетаданныхСтрокой, ЭлементМетаданных.Имя)));
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат МассивТипов;
	
КонецФункции

// Проверяет наличие неиспользуемых фрагментов в синониме элемента метаданных.
// пример: "(не используется)", "(удален)". 
//
// Параметры:
//  СинонимОбъектаМетаданных - Строка - синоним объекта метаданных.
//  ПроверяемыеВставки		 - Соответствие - 
//  	см.упоФункцииОбщегоНазначенияСервер.ПроверяемыеВставкиСинонимовОбъектовМетаданныхДляИсключения.
// 
// Возвращаемое значение:
//  Булево - признак использования.
//
Функция ИспользованиеОбъектаМетаданныхПоСинониму(СинонимОбъектаМетаданных, ПроверяемыеВставки) Экспорт
	
	Для Каждого Вставка Из ПроверяемыеВставки Цикл
		Если Лев(СинонимОбъектаМетаданных, Вставка.Значение) = Вставка.Ключ Тогда
			Возврат Ложь; // Возврат
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // ()

// Возвращает набор фрагментов синонимов метаданных, указывающих, что объект перестал использоваться в конфигурации.
// пример: "(не используется)", "(удален)".
// 
// Возвращаемое значение:
//  Соответствие - набор исключаемых фрагментов.
//
Функция ПроверяемыеВставкиСинонимовОбъектовМетаданныхДляИсключения() Экспорт 
	
	ПроверяемыеВставки = Новый Соответствие;
	ПроверяемыеВставки.Вставить("(не используется)", 0);
	ПроверяемыеВставки.Вставить("(удалить)", 0);
	Для Каждого Вставка Из ПроверяемыеВставки Цикл
		ПроверяемыеВставки.Вставить(Вставка.Ключ, СтрДлина(Вставка.Ключ));
	КонецЦикла;
	
	Возврат ПроверяемыеВставки;
	
КонецФункции

#КонецОбласти

#Область РаботаСЗапросами

// Проверяет корректность запроса и возможность его выполнения.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса.
//  ТекстОшибки	 - Строка - в этот параметр возвращается сообщение об ошибке, если она есть.
//  Показатель	 - СправочникСсылка.упоПоказателиПроектов - показатель, запрос которого проверяется.
//  ЗапретитьРазрешенные - Булево - признак проверки на запрет разрешенных (актуально для показателей).
//
// Возвращаемое значение:
//	Булево - признак успешного выполнения запроса.
//
Функция ПроверитьЗапрос(ТекстЗапроса, ТекстОшибки, Показатель = Неопределено, ЗапретитьРазрешенные = Ложь) Экспорт
	
	ЗапросВыполнен = Ложь;
	ТекстОшибки = "";
	
	МассивОшибок = Новый Массив;
	
	ПостроительОтчета = Новый ПостроительОтчета;
	
	// Проверка запроса построителем.
	
	Попытка
		
		ПостроительОтчета.Текст = ТекстЗапроса;
		ПостроительОтчета.ЗаполнитьНастройки();
		
		ЗапросВыполнен = Истина;
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки();
		Текст = НСтр("ru = 'Ошибка запроса: '") + Сред(ОписаниеОшибки, СтрНайти(ОписаниеОшибки, "(Текст):") + 9);
		МассивОшибок.Добавить(Текст);
		
	КонецПопытки;
	
	// Проверка корректности заполнения полей показателя.
	
	Если Показатель <> Неопределено Тогда
		
		Если СтрНайти(Показатель.ТекстЗапроса, Показатель.ИмяПоляОбъекта) = 0 Тогда
			
			Текст = СтрШаблон(НСтр("ru = 'В запросе не найдено указанное имя поля Проекта ""%1""'"), 
				Показатель.ИмяПоляОбъекта);
			МассивОшибок.Добавить(Текст);
			
			ЗапросВыполнен = Ложь;
			
		КонецЕсли;
		
		Если СтрНайти(Показатель.ТекстЗапроса, Показатель.ИмяПоляЗначения) = 0 Тогда
			
			Текст = СтрШаблон(НСтр("ru = 'В запросе не найдено указанное имя поля Показателя ""%1""'"),
				Показатель.ИмяПоляЗначения);
			МассивОшибок.Добавить(Текст);
			
			ЗапросВыполнен = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗапретитьРазрешенные Тогда
		
		Если СтрНайти(ВРЕГ(ТекстЗапроса), " РАЗРЕШЕННЫЕ ") <> 0 Тогда
			
			Текст = НСтр("ru = 'В запросе нельзя использовать ""РАЗРЕШЕННЫЕ""'");
			МассивОшибок.Добавить(Текст);

			ЗапросВыполнен = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МассивОшибок) Тогда
		ТекстОшибки = СтрСоединить(МассивОшибок, Символы.ПС);
	КонецЕсли;
	
	Возврат ЗапросВыполнен;
	
КонецФункции

// Рекурсивно строит дерево значений.
//
// Параметры:
//  Выборка							 - ВыборкаИзРезультатаЗапроса 			- выборка, на основании которой надо построить дерево.
//  СтрокаДерева					 - ДеревоЗначений, СтрокаДереваЗначений - строимое дерево или добавляемая строка дерева.
//  МассивКолонок					 - Массив 								- массив колонок, на основании которого определяется
//										последний ли это уровень группировки.
//  СтрокаДопРеквизитов				 - Произвольный 						- дополнительные реквизиты. Не используется.
//  ИмяПоляГруппировки				 - Строка								- поле, куда записывается группировка.
//  ИмяПоляДляЗаписиИмениГруппировки - Строка 								- имя поля, куда записывается имя группировки.
//  ОсновноеПолеНижнегоУровня		 - Строка								- имя поля нижнего уровня.
//  СтруктураУровнейСИерархией		 - Произвольный							- необязательный параметр. Не используется.
//
// Возвращаемое значение:
//	Неопределено - не возвращает значение.
//
Функция РекурсивноПостроитьДерево(Выборка,
								  СтрокаДерева,
								  МассивКолонок, 
								  СтрокаДопРеквизитов, 
								  ИмяПоляГруппировки,
								  ИмяПоляДляЗаписиИмениГруппировки,
								  ОсновноеПолеНижнегоУровня, 
								  СтруктураУровнейСИерархией = Неопределено) Экспорт
	
	Если ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Тогда
		
		ПредУровень = -1;
		ПредСтрока = СтрокаДерева;
		
		Пока Выборка.Следующий() Цикл
			
			РазностьУровней = ПредУровень - Выборка.Уровень() + 1;
			НоваяСтрокаДерева = ПоднятьсяНаЧислоУровней(ПредСтрока, РазностьУровней).Строки.Добавить();		
					
			РекурсивноПостроитьДерево(Выборка,
									  НоваяСтрокаДерева,
									  МассивКолонок,
									  СтрокаДопРеквизитов,
									  ИмяПоляГруппировки,
									  ИмяПоляДляЗаписиИмениГруппировки,
									  ОсновноеПолеНижнегоУровня,
									  СтруктураУровнейСИерархией);
						
			ПредУровень = Выборка.Уровень();     
			ПредСтрока = НоваяСтрокаДерева;
			
		КонецЦикла;
		
	Иначе
		
		Группировка = Выборка.Группировка();
		
		ТекИндексГруппировки = МассивКолонок.Найти(Выборка.Группировка());
		
		ЭтоПоследнийУровень = (ТекИндексГруппировки = МассивКолонок.Количество()) ИЛИ Группировка = "";
		
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
		
		СтрокаДерева[ИмяПоляДляЗаписиИмениГруппировки] = Группировка;
		
		Если Не ЭтоПоследнийУровень Тогда
				
			ТекГруппировка = МассивКолонок[ТекИндексГруппировки];
			СтрокаДерева[ИмяПоляГруппировки] = СтрокаДерева[ТекГруппировка];		
			
			ВыборкаНиже = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			 
			ПредУровень = Выборка.Уровень();
			ПредСтрока = СтрокаДерева;
			
			Пока ВыборкаНиже.Следующий() Цикл
								
				РазностьУровней = ПредУровень - ВыборкаНиже.Уровень() + 1;
				НоваяСтрокаДерева = ПоднятьсяНаЧислоУровней(ПредСтрока, РазностьУровней).Строки.Добавить();		 				
				
				РекурсивноПостроитьДерево(ВыборкаНиже,
										  НоваяСтрокаДерева,
										  МассивКолонок,
										  СтрокаДопРеквизитов,
										  ИмяПоляГруппировки,
										  ИмяПоляДляЗаписиИмениГруппировки, 
										  ОсновноеПолеНижнегоУровня,
										  СтруктураУровнейСИерархией);
								
				ПредУровень = ВыборкаНиже.Уровень();   
				ПредСтрока = НоваяСтрокаДерева;
				
			КонецЦикла;
			
		Иначе
			
			СтрокаДерева[ИмяПоляГруппировки] = СтрокаДерева[ОсновноеПолеНижнегоУровня];
			
		КонецЕсли;	        
		
	КонецЕсли;
	
КонецФункции

// Строит соответствие по результату запроса с одноуровневой группировкой по полю группировки.
//
// Параметры:
//  РезультатЗапроса - РезультатЗапроса
//  ИмяПоляИтогов	 - Строка
//  ИмяПоляВыборки	 - Строка
// 
// Возвращаемое значение:
//  Соответствие
//
Функция СоответствиеПоРезультатуЗапросаСОдноуровневойГруппировкой(РезультатЗапроса, ИмяПоляИтогов, ИмяПоляВыборки) Экспорт
	
	РезультатСоответствие = Новый Соответствие; 
	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатСоответствие;
	КонецЕсли;
	
	ВыборкаГруппировка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГруппировка.Следующий() Цикл
		Выборка = ВыборкаГруппировка.Выбрать();
		МассивДеталей = Новый Массив;
		Пока Выборка.Следующий() Цикл
			МассивДеталей.Добавить(Выборка[ИмяПоляВыборки]);
		КонецЦикла;
		РезультатСоответствие.Вставить(ВыборкаГруппировка[ИмяПоляИтогов], МассивДеталей);
	КонецЦикла;
	
	Возврат РезультатСоответствие;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Отладочный метод, позволяющий просмотреть движения документа по регистру.
//
// Параметры:
//  Регистратор	 - ДокументСсылка - документ-регистратор.
//  ИмяРегистра	 - Строка	 - имя регистра движений.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - выгруженная таблица записей регистра.
//
Функция ЗаписиРегистратора(Регистратор, ИмяРегистра) Экспорт
	
	ТаблицаДвижений = упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру(ИмяРегистра);
	Выборка = РегистрыСведений[ИмяРегистра].ВыбратьПоРегистратору(Регистратор);
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДвижений.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат ТаблицаДвижений;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВернутьЗначениеЯчейки(вхТекстЯчейки)
	
	ТекстЯчейкиНРегСокрЛП = НРег(СокрЛП(вхТекстЯчейки));
	Если Не ЗначениеЗаполнено(вхТекстЯчейки) Тогда
		Возврат вхТекстЯчейки;
	ИначеЕсли ТекстЯчейкиНРегСокрЛП = "истина" ИЛИ ТекстЯчейкиНРегСокрЛП = "да" Тогда
		Возврат Истина;
	ИначеЕсли ТекстЯчейкиНРегСокрЛП = "ложь" ИЛИ ТекстЯчейкиНРегСокрЛП = "нет" Тогда
		Возврат Ложь;
	Иначе
		Попытка 
			тЧисло = Число(ТекстЯчейкиНРегСокрЛП);
			Возврат тЧисло;
		Исключение
			Возврат вхТекстЯчейки;
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьВидСравненияИЗначениеПостроителяПоСКД(ОтборСКД)
	
	Результат = Новый Структура("ВидСравнения, Значение");
	Если ОтборСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
		Результат.ВидСравнения = ВидСравнения.НеРавно;
		Результат.Значение = упоПроверкаЗаполненияВызовСервера.обПустоеЗначениеТипа(ТипЗнч(ОтборСКД.ПравоеЗначение));
	ИначеЕсли ОтборСКД.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
		Результат.ВидСравнения = ВидСравнения.Равно;
		Результат.Значение = упоПроверкаЗаполненияВызовСервера.обПустоеЗначениеТипа(ТипЗнч(ОтборСКД.ПравоеЗначение));
	Иначе
		Результат.ВидСравнения = ВидСравнения[СтрЗаменить(""+ОтборСКД.ВидСравнения, " ","")];
		Если ТипЗнч(ОтборСКД.ПравоеЗначение) = Тип("СтандартнаяДатаНачала") Тогда
			Результат.Значение = ОтборСКД.ПравоеЗначение.Дата;
		Иначе
			Результат.Значение = ОтборСКД.ПравоеЗначение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЦветИзСтиляПлатформы(рЦветКакЭлементСтиля)
	
	Попытка
		
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Область(1, 1, 1, 1).ЦветФона = рЦветКакЭлементСтиля;
		ТемпФайл = ПолучитьИмяВременногоФайла("htm");
		ТабДок.Записать(ТемпФайл, ТипФайлаТабличногоДокумента.HTML);
		
		рКодПоиска = "tr.R0 td.R0C0{ background-color:"; // Если 1С изменит формат, эту строку придется поменять.
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ТемпФайл);
		Текст = ТекстДок.ПолучитьТекст();
		Позиция = Найти(Текст, рКодПоиска);
		Если Позиция<>0 Тогда
			Возврат СокрЛП(ВРег(Сред(Текст, Позиция + СтрДлина(рКодПоиска), 8)));
		КонецЕсли;
		
		Возврат "";
		
	Исключение
		
		НСтрока = НСтр("ru = 'ПолучитьЦветИзСтиляПлатформы, ошибка: %1'");
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, ОписаниеОшибки());
		Сообщение.Сообщить();
		
		Возврат "";
		
	КонецПопытки;
	
КонецФункции

Процедура НоваяСтрокаКоллекцииОбъектовМетаданных(Имя, ВводитсяНаОсновании, Таб)
	
	НоваяСтрока = Таб.Добавить();
	НоваяСтрока.Родитель			= Имя;
	НоваяСтрока.ВводитсяНаОсновании = ВводитсяНаОсновании;
	
КонецПроцедуры

Процедура ЗаполнитьФункциональныеОпцииОбъектаМетаданных(ТаблицаОбъектовВводНаОсновании, ФункциональныеОпции,
													 ОбъектМетаданных, ИмяОбъектаМетаданных)
	
	Строка = ТаблицаОбъектовВводНаОсновании.Добавить();
	Строка.ИмяОбъектаМетаданных = ИмяОбъектаМетаданных;
	
	ФункциональныеОпцииОбъектаМетаданных = Новый Массив;
	Для Каждого ФункциональнаяОпция Из ФункциональныеОпции Цикл
		Если ФункциональнаяОпция.Состав.Найти(ОбъектМетаданных) <> Неопределено Тогда
			ФункциональныеОпцииОбъектаМетаданных.Добавить(ФункциональнаяОпция.Имя);
		КонецЕсли;
	КонецЦикла;	
	
	Строка.ФунциональныеОпцииОбъектаМетаданных = ФункциональныеОпцииОбъектаМетаданных;
	
КонецПроцедуры

Процедура ДобавитьВМассивОбщиеПоляРегистраИТаблицы(МассивКолонок, КолонкиТаблицы, ПоляРегистра)
	
	Для Каждого ПолеРегистра Из ПоляРегистра Цикл	
		Если КолонкиТаблицы.Найти(ПолеРегистра.Имя) <> Неопределено Тогда
			МассивКолонок.Добавить(ПолеРегистра.Имя);
		КонецЕсли;	
	КонецЦикла; 
	
КонецПроцедуры	

#КонецОбласти


