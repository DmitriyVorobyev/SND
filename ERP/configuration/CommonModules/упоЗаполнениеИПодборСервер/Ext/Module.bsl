#Область ПрограммныйИнтерфейс

// Получает обязательные реквизиты для выполнения операции заполнения.
//
// Параметры:
//  Объект	 - ДокументОбъект, СправочникОбъект - объект, для которого необходимо получить обязательные реквизиты для
//												  выполнения операции заполнения.
//  ИмяТЧ	 - Строка							- содержит имя табличной части объекта, если параметр не указан, то
//												  структура формируется по шапке объекта.
// 
// Возвращаемое значение:
//  Структура - содержит поля обязательных реквизитов, Ключ поля структуры - реквизит,
//				Значение поля структуры = Неопределено.
//
Функция ПолучитьОбязательныеРеквизитыДляВыполненияОперацииЗаполнить(Знач Объект, ИмяТЧ) Экспорт
	
	Возврат Документы[Объект.Ссылка.Метаданные().Имя].ПолучитьОбязательныеРеквизитыДляВыполненияОперацииЗаполнить(ИмяТЧ);
	
КонецФункции

// Формирует данные для заполнения заданной табличной части.
//
// Параметры:
//  Объект	 - ДокументОбъект, СправочникОбъект - объект, для которого необходимо получить данные табличной части.
//  ИмяТЧ	 - Строка 							- имя табличной части.
//
// Возвращаемое значение:
//	ТаблицаЗначений - готовая таблица значений.
//
Функция ПолучитьДанныеТабличнойЧастиДокумента(Знач Объект, ИмяТЧ) Экспорт
	
	Возврат Документы[Объект.Ссылка.Метаданные().Имя].СформироватьТаблицуДанныхДляОперацииЗаполнить(Объект, ИмяТЧ);
	
КонецФункции

// Возвращает единицу измерения номенклатуры по умолчанию.
//
// Параметры:
//	Номенклатура - СправочникСсылка.Номенклатура - номенклатура.
//
// Возвращаемое значение:
//	СправочникСсылка.УпаковкиЕдиницыИзмерения
//
Функция ПолучитьЕдиницуИзмеренияНоменклатуры(Номенклатура) Экспорт
				
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	КонецЕсли;
	
	ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	
	Если упоИнтеграцияКлиентСервер.ИспользуетсяСинхронизацияЕдиницИзмерения() Тогда
		ЕдиницаИзмерения = упоИнтеграцияУПФСервер.УпаковкаЕдИзмСвязаннаяСКлассификаторомЕдИзм(ЕдиницаИзмерения);
	КонецЕсли;
	
	Возврат ЕдиницаИзмерения;	

КонецФункции 

#КонецОбласти
