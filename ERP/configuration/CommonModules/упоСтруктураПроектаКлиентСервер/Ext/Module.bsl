#Область ПредставлениеКолонок

Функция СформироватьПредставлениеПоДаннымСоответствия(СоответствиеДанныеСтроки, СоответствиеДанныеСтрокиЭтап = Неопределено, ФорматКолонок = "") Экспорт
	
	мСтрок = Новый Массив;
	Если СоответствиеДанныеСтрокиЭтап = Неопределено Тогда
		СоответствиеДанныеСтрокиЭтап = Новый Соответствие;
	КонецЕсли;	
	
	ПоляГруппировки = Новый СписокЗначений;
	Для Каждого СтрокаСоответствия Из СоответствиеДанныеСтроки Цикл
		ПоляГруппировки.Добавить(СтрокаСоответствия.Ключ);
	КонецЦикла;
	Для Каждого СтрокаСоответствия Из СоответствиеДанныеСтрокиЭтап Цикл
		Если ПоляГруппировки.НайтиПоЗначению(СтрокаСоответствия.Ключ) = Неопределено Тогда
			ПоляГруппировки.Добавить(СтрокаСоответствия.Ключ);
		КонецЕсли;	
	КонецЦикла;
	ПоляГруппировки.СортироватьПоЗначению();
	
	Для Каждого Строка Из ПоляГруппировки Цикл
		ЗначениеСтроки = СоответствиеДанныеСтроки.Получить(Строка.Значение);
		ЗначениеЭтап = СоответствиеДанныеСтрокиЭтап.Получить(Строка.Значение);
		Если ЗначениеСтроки = Неопределено Тогда
			ШаблонТекста = "%2 %1";
		ИначеЕсли ЗначениеЭтап = Неопределено Тогда
			ШаблонТекста = "%3 %1";
		Иначе
			ШаблонТекста = "%2 [%3] %1";
		КонецЕсли;	
		ТекстПредставления = СтрШаблон(ШаблонТекста, 
										Строка.Значение, 
										?(ЗначениеЭтап = Неопределено, Неопределено, Формат(ЗначениеЭтап, ФорматКолонок)),
										?(ЗначениеСтроки = Неопределено, Неопределено, Формат(ЗначениеСтроки, ФорматКолонок)));
		мСтрок.Добавить(ТекстПредставления);
	КонецЦикла;
	
	Возврат СтрСоединить(мСтрок, ", ");
	
КонецФункции

#КонецОбласти

#Область НастройкиПроизводительности

Функция СписокНастроекПроизводительностиСтруктурыПроекта() Экспорт
	
	НастройкиПроизводительности = Новый Структура;
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Пересчитывать в фоновом режиме'"), Истина);
	НастройкиПроизводительности.Вставить("ПересчитыватьФоново", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Пересчитывать в две очереди'"), Ложь);
	НастройкиПроизводительности.Вставить("ПересчитыватьФоновоВДвеОчереди", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Не считать расчетные сроки и критический путь'"), Ложь);
	НастройкиПроизводительности.Вставить("НеСчитатьРасчетныеСрокиИКритическийПуть", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Пересчитывать только измененные задачи'"), Ложь);
	НастройкиПроизводительности.Вставить("ПересчитыватьТолькоИзмененныеЗадачи", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Не обновлять после записи'"), Ложь);
	НастройкиПроизводительности.Вставить("НеОбновлятьПослеЗаписи", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Не обновлять после проведения задачи'"), Ложь);
	НастройкиПроизводительности.Вставить("НеОбновлятьПослеПроведенияЗадачи", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Не использовать отмену и повторение действий'"), Ложь);
	НастройкиПроизводительности.Вставить("НеИспользоватьОтменуИПовторениеДействий", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Отключить запоминание и синхронизацию развернутых строк'"), Ложь);
	НастройкиПроизводительности.Вставить("ОтключитьСинхронизациюРазвернутыхСтрок", ЗначенияНастройки);
	
	ЗначенияНастройки = Новый Структура("Наименование, НастройкаПоУмолчанию", 
		НСтр("ru = 'Кешировать показатели'"), Ложь);
	НастройкиПроизводительности.Вставить("КешироватьПоказатели", ЗначенияНастройки);
	
	Возврат НастройкиПроизводительности;
	
КонецФункции

