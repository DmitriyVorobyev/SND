
#Область СлужебныйПрограммныйИнтерфейс

#Область РасчетПроекта

Функция ПолучитьСтруктуруПараметровСтроки(ВсеПараметры = Истина, Сроки = Ложь, РасчетныеСроки = Ложь,
	ЕдиницаИзмерения = Ложь, Длительность = Ложь, ОтклонениеИзменилось = Ложь, Доп = Ложь) Экспорт
	
	Результат = Новый Структура("ИдСтроки, ЭтоФантом");
	
	Если ВсеПараметры ИЛИ Сроки Тогда
		Результат.Вставить("ДатаНачала");	
		Результат.Вставить("ДатаЗавершения");
		Результат.Вставить("ДлительностьКалендарныеДни");
		Результат.Вставить("ОтставаниеОтТекПлана");
	КонецЕсли;
	
	Если ВсеПараметры ИЛИ Длительность Тогда
		Результат.Вставить("Длительность");
		Результат.Вставить("ДлительностьКалендарныеДни");
	КонецЕсли;
	
	Если ВсеПараметры ИЛИ РасчетныеСроки Тогда
		Результат.Вставить("РаннийСтарт");	
		Результат.Вставить("РаннийФиниш");	
		Результат.Вставить("ПозднийСтарт");	
		Результат.Вставить("ПозднийФиниш");	
		Результат.Вставить("КритическийПуть");
		Результат.Вставить("БуферПозднийСтартРаннийСтарт");
		Результат.Вставить("ДлительностьКалендарныеДни");
		Результат.Вставить("ОтставаниеОтТекПлана");
	КонецЕсли;	
	
	Если ВсеПараметры ИЛИ ЕдиницаИзмерения Тогда
		Результат.Вставить("ЕдиницаИзмерения");
	КонецЕсли;
	
	Если ВсеПараметры ИЛИ Доп Тогда
		Результат.Вставить("ИдСтрокиРодителя");	
		Результат.Вставить("ТипЗадачи");	
		Результат.Вставить("РежимВвода");	
		Результат.Вставить("Статус");
		Результат.Вставить("ПроцентГотовности");
		Результат.Вставить("ТрудозатратыТП");
		Результат.Вставить("ТрудозатратыТП_ОкончРоли");
		Результат.Вставить("ДлительностьБезУчетаКалендаряПроекта");
		Результат.Вставить("КалендарьЗадачи"); 
		Результат.Вставить("КодСДР");
		Результат.Вставить("НазваниеЗадачи");
	КонецЕсли;
	
	Если ВсеПараметры ИЛИ ОтклонениеИзменилось Тогда
		Результат.Вставить("ОтклонениеПоОкончанию");
		Результат.Вставить("ОтклонениеПоОкончаниюДП");
		Результат.Вставить("ОтклонениеПоНачалуБП");
		Результат.Вставить("ОтклонениеПоНачалуДП");
		Результат.Вставить("ОтклонениеПоНачалуОтВерсии");
		Результат.Вставить("ОтклонениеПоОкончаниюОтВерсии");
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область МеханизмПередачиИзмененийМеждуСерверомКлиентом

Функция ПреобразоватьСоответствиеСтруктурВМассивМассивов(СоответствиеСтруктур) Экспорт
	
	МассивМассивов = Новый Массив;
	
	Если СоответствиеСтруктур.Количество() = 0 Тогда 
		Возврат МассивМассивов;
	КонецЕсли;
	
	МассивПолей = Новый Массив;	
	Для Каждого КлючЗначениеСоответствия Из СоответствиеСтруктур Цикл
		МассивПолей.Добавить("КлючСоответствия");
		сч = 1;	
		Для Каждого КлючЗначениеСтруктуры Из КлючЗначениеСоответствия.Значение Цикл
			МассивПолей.Добавить(КлючЗначениеСтруктуры.Ключ);
			сч = сч + 1;
		КонецЦикла;
		МассивМассивов.Добавить(МассивПолей);
		Прервать;
	КонецЦикла;
	
	КоличествоПолей = МассивПолей.Количество();
	
	Для Каждого КлючЗначениеСоответствия Из СоответствиеСтруктур Цикл
		МассиТекЗначений = Новый Массив;
		Для сч = 0 По КоличествоПолей-1 Цикл
			ИмяПоля = МассивПолей[сч];	
			Если ИмяПоля = "КлючСоответствия" Тогда
				МассиТекЗначений.Добавить(КлючЗначениеСоответствия.Ключ);
			Иначе
				МассиТекЗначений.Добавить(КлючЗначениеСоответствия.Значение[ИмяПоля]);
			КонецЕсли;
		КонецЦикла;		
		МассивМассивов.Добавить(МассиТекЗначений);
	КонецЦикла;	
	
	Возврат МассивМассивов;
	
КонецФункции

Функция ПреобразоватьМассивМассивовВСоответсвиеСтруктур(МассивМассивов) Экспорт
	
	СоответсвиеСтруктур = Новый Соответствие;
	
	Если МассивМассивов.Количество() = 0 Тогда
		Возврат СоответсвиеСтруктур;
	КонецЕсли;
	
	МассивПолей = МассивМассивов[0];
	
	КоличествоЭлементов = МассивМассивов.Количество();	
	КоличествоПолей = МассивПолей.Количество();
	
	Для сч = 1 По КоличествоЭлементов-1 Цикл		
		Структура = Новый Структура;
		Ключ = Неопределено;
		Массив = МассивМассивов[сч];
		сч_полей = 0;
		Для сч_полей = 0 По КоличествоПолей-1 Цикл
			ИмяПоля = МассивПолей[сч_полей];
			ЗначениеПоля = Массив[сч_полей];
			Если ИмяПоля = "КлючСоответствия" Тогда
				Ключ = ЗначениеПоля;
			Иначе
				Структура.Вставить(ИмяПоля, ЗначениеПоля);
			КонецЕсли;
			СоответсвиеСтруктур.Вставить(Ключ, Структура);
		КонецЦикла;
	КонецЦикла;
	
	Возврат СоответсвиеСтруктур;
	
КонецФункции 

#КонецОбласти

