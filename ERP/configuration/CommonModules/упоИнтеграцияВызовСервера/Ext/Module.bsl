// Получить текущего сотрудника
// 
// Возвращаемое значение:
//  СправочникСсылка - сотрудник текущего пользователя.
//
Функция ПолучитьТекущегоСотрудникаВызовСервера() Экспорт
	
	Если Пользователи.ЭтоСеансВнешнегоПользователя() Тогда
		Возврат Справочники.упоСотрудники.ПустаяСсылка();
	КонецЕсли;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	
	Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Возврат ПараметрыСеанса.упоТекущийСотрудник;
	Иначе
		Возврат Справочники.упоСотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Возвращает признак того, подключено к конфигурации расширение и установлен флаг "Активно"
// Поиск расширения выполняется по полю "Имя"
//
// Параметры:
//  Имя - Строка	 - имя расширения.
//
// Возвращаемое значение:
//   Булево - признак того, что расширение подключено
//
Функция РасширениеПодключено(Имя) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Отбор = Новый Структура("Имя", Имя);
	Массив = РасширенияКонфигурации.Получить(Отбор);
	
	Если Массив.Количество() Тогда        
		Расширение = Массив[0];        
		Если Расширение.Активно Тогда
			Результат = Истина;
		КонецЕсли;    
	КонецЕсли;  
	
	Возврат Результат;
	
КонецФункции

// Вызов сервера для получения функциональной опции.
//
// Параметры:
//  ИмяФункциональнойОпции	 - Строка	 - Имя функциональной опции. 
//  Параметры				 - Структура, Неопределено - Параметры функциональной опции.
// 
// Возвращаемое значение:
//  Произвольный - Значения функциональной опции.
//
Функция ПолучитьФункциональнуюОпциюВызовСервера(ИмяФункциональнойОпции, Параметры = Неопределено) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Возврат ПолучитьФункциональнуюОпцию(ИмяФункциональнойОпции, Параметры);
	
КонецФункции

#Область СвязьПодразделенийИСтруктурыПредприятия

// Находит связанный элемент структуры или подразделенияв регистре интеграции.
//
// Параметры:
//  ЭлементИсточникСвязи	 - СправочникСсылка.упоПодразделения, СправочникСсылка.СтруктураПредприятия,
//  	СправочникСсылка.СтруктурныеЕдиницы
//  ДопИнформацияОбИсточнике - Структура, Неопределено	 - передача доп.информации о связанном элементе:
//  	Наименование и ПометкаУдаления.
// 
// Возвращаемое значение:
//  СправочникСсылка.упоПодразделения, СправочникСсылка.СтруктураПредприятия,
//  СправочникСсылка.СтруктурныеЕдиницы - связанный элемент структурного подразделения.
//
Функция НайтиСвязанныйЭлементСтруктурыИлиПодразделения(ЭлементИсточникСвязи,
	ДопИнформацияОбИсточнике = Неопределено) Экспорт
	
	Если ДопИнформацияОбИсточнике = Неопределено Тогда
		ДопИнформацияОбИсточнике = Новый Структура;
	КонецЕсли;
	
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.упоПодразделения") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.СтруктураПредприятия КАК Ссылка,
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.СтруктураПредприятия.Наименование КАК Наименование,
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.СтруктураПредприятия.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	РегистрСведений.упоСоответствиеПодразделенийИСтруктурыПредприятия КАК упоСоответствиеПодразделенийИСтруктурыПредприятия
		|ГДЕ
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.Подразделение = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение", ЭлементИсточникСвязи);
		
	ИначеЕсли Не ЭтоУПФ И ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.СтруктураПредприятия")
		Или ЭтоУПФ И ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.Подразделение КАК Ссылка,
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.Подразделение.Наименование КАК Наименование,
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.Подразделение.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	РегистрСведений.упоСоответствиеПодразделенийИСтруктурыПредприятия КАК упоСоответствиеПодразделенийИСтруктурыПредприятия
		|ГДЕ
		|	упоСоответствиеПодразделенийИСтруктурыПредприятия.СтруктураПредприятия = &СтруктураПредприятия";
		Запрос.УстановитьПараметр("СтруктураПредприятия", ЭлементИсточникСвязи);
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Функция ""НайтиСвязанныйЭлементСтруктурыИлиПодразделения"":
		|неверный тип параметра ""ЭлементИсточникСвязи"".'");
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Если ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.упоПодразделения") Тогда
			Возврат Справочники.упоПодразделения.ПустаяСсылка();
		ИначеЕсли ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.СтруктураПредприятия") Тогда
			Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
		Иначе
			Возврат Справочники.СтруктурныеЕдиницы.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ДопИнформацияОбИсточнике.Вставить("Наименование", Выборка.Наименование);
	ДопИнформацияОбИсточнике.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
	
	Возврат Выборка.Ссылка;
	
КонецФункции

// Установить у элемента "Список" отображение таблицы список
//
// Параметры:
//  Форма	 - УправляемаяФорма	 - форма.
//
Процедура НастроитьОтображениеСпискаПодразделений(Форма) Экспорт
	
	Параметры = Форма.Параметры;
	Элементы = Форма.Элементы;
	
	Если Элементы.Список.Отображение = ОтображениеТаблицы.Список Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("РесурсПодразделения") Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;	
	КонецЕсли;
	
	Если Параметры.Свойство("РежимОтображенияТаблицы") Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы[Параметры.РежимОтображенияТаблицы];
	КонецЕсли;
	
КонецПроцедуры

