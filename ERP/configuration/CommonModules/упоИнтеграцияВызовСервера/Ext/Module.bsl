// Возвращает признак того, является ли данная конфигурация конфигурацией EPM 2.5.
//
// Параметры:
//  ЭтоEPM	 - Булево	 - признак, что конфигурация интегрирована с ERP.
// 
// Возвращаемое значение:
//  Булево - признак того, что конфигурация - EPM редакции 2.5.
//
Функция ЭтоEPM_2_5(ЭтоEPM = Неопределено) Экспорт
	
	ЭтоEPM_2_5 = Ложь;
		
	Если ЭтоEPM = Неопределено Тогда
		ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
	КонецЕсли;
	
	Если Не ЭтоEPM Тогда
		Возврат ЭтоEPM_2_5;
	КонецЕсли;		
	
	ЭтоERPУХ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоERPУХ();
	
	Если ЭтоERPУХ Тогда
		ЭтоEPM_2_5 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Метаданные.Версия, "3.1.0.0") >= 0;
	Иначе	
		ЭтоEPM_2_5 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Метаданные.Версия, "2.5.0.0") >= 0;
	КонецЕсли;
	
	Возврат ЭтоEPM_2_5;
	
КонецФункции

