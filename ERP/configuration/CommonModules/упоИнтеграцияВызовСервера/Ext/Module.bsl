#Область СвязьСтатейБДР_СправочниковУПО_И_ПВХ_ERP

// Получает связанную статью ДР.
//
// Параметры:
//  Статья			 - СправочникСсылка.СтатьиЗатрат, СправочникСсылка.упоСтатьиДоходов,
//					   ПланВидовХарактеристикСсылка.СтатьиДоходов, ПланВидовХарактеристикСсылка.СтатьиРасходов	 - статья.
//  ДопИнформация	 - Неопределено, Структура	 - дополнительная информация.
// 
// Возвращаемое значение:
//  СправочникСсылка.упоСтатьиДоходов, СправочникСсылка.СтатьиЗатрат - связанная статья.
//
Функция ПолучитьСвязаннуюСтатьюДР(Статья, ДопИнформация = Неопределено) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.НеобходимаСинхронизацияСтатейДР() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Статья) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Неопределено;
	
	ТипВходящейСтатьи = Неопределено;
	
	ТипСтатьи = ТипЗнч(Статья);
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	Если ЭтоУПФ Тогда
		ТипСтатьиУправленческий = ТипСтатьи = Тип("ПланСчетовСсылка.Управленческий");
	    ТипПВХСтатьиДР = Ложь;
	Иначе
		ТипСтатьиУправленческий = Ложь;		
		ТипПВХСтатьиДР = ТипСтатьи = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") 
			Или ТипСтатьи = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов");
	КонецЕсли;		
	
	Если ТипСтатьиУправленческий Или ТипПВХСтатьиДР Тогда
			
			ТипВходящейСтатьи = "Интеграция";
			ТипИсходящейСтатьи = "УПО"; 
		
	ИначеЕсли ТипСтатьи = Тип("СправочникСсылка.упоСтатьиЗатрат") 
		Или ТипСтатьи = Тип("СправочникСсылка.упоСтатьиДоходов") Тогда
		
		ТипВходящейСтатьи = "УПО";
		ТипИсходящейСтатьи = "Интеграция";

	Иначе 
		
		Возврат Результат;
		
	КонецЕсли; 	
					 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	упоСоответствиеСтатейДР.СтатьяУПО,
	|	упоСоответствиеСтатейДР.СтатьяИнтеграция,
	|	упоСоответствиеСтатейДР.%полестатьи%.Наименование КАК Наименование,
	|	упоСоответствиеСтатейДР.%полестатьи%.ПометкаУдаления КАК ПометкаУдаления,
	|	упоСоответствиеСтатейДР.%полестатьи%.Родитель КАК Родитель
	|ИЗ
	|	РегистрСведений.упоСоответствиеСтатейДР КАК упоСоответствиеСтатейДР
	|ГДЕ
	|	упоСоответствиеСтатейДР.%полестатьи% = &Статья";
	
	ПолеСтатьиВх = "Статья" + ТипВходящейСтатьи;		   
	ПолеСтатьиИсх = "Статья" + ТипИсходящейСтатьи;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%полестатьи%", ПолеСтатьиВх);
	Запрос.УстановитьПараметр("Статья", Статья);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат = Выборка[ПолеСтатьиИсх];
		ДопИнформация = Новый Структура("Наименование, ПометкаУдаления, Родитель");
		ЗаполнитьЗначенияСвойств(ДопИнформация, Выборка);			
	КонецЕсли;
			
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СвязьСправочников_упоСценарии_И_Сценарии_ERP

// Находит связанный элемент сценария в регистре интеграции.
//
// Параметры:
//  ЭлементИсточникСвязи	 - СправочникСсылка.упоСценарии, СправочникСсылка.Сценарии
//  ДопИнформацияОбИсточнике - Структура,  Неопределено - передача доп.информации о связанном элементе:
//  	Наименование и ПометкаУдаления.
// 
// Возвращаемое значение:
//  СправочникСсылка.упоСценарии, СправочникСсылка.Сценарии - связанный элемент сценария.
//
Функция НайтиСвязанныйЭлементСценария(ЭлементИсточникСвязи,
	ДопИнформацияОбИсточнике = Неопределено) Экспорт
	
	Если ДопИнформацияОбИсточнике = Неопределено Тогда
		ДопИнформацияОбИсточнике = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.упоСценарии") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСоответствиеСценариев.СценарийERP КАК Ссылка,
		|	упоСоответствиеСценариев.СценарийERP.Наименование КАК Наименование,
		|	упоСоответствиеСценариев.СценарийERP.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	РегистрСведений.упоСоответствиеСценариев КАК упоСоответствиеСценариев
		|ГДЕ
		|	упоСоответствиеСценариев.Сценарий = &Сценарий";
		Запрос.УстановитьПараметр("Сценарий", ЭлементИсточникСвязи);
		
	ИначеЕсли ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.Сценарии") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСоответствиеСценариев.Сценарий КАК Ссылка,
		|	упоСоответствиеСценариев.Сценарий.Наименование КАК Наименование,
		|	упоСоответствиеСценариев.Сценарий.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	РегистрСведений.упоСоответствиеСценариев КАК упоСоответствиеСценариев
		|ГДЕ
		|	упоСоответствиеСценариев.СценарийERP = &СценарийERP";
		Запрос.УстановитьПараметр("СценарийERP", ЭлементИсточникСвязи);
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Функция ""НайтиСвязанныйЭлементСценария"":
		|неверный тип параметра ""ЭлементИсточникСвязи"".'");
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Если ТипЗнч(ЭлементИсточникСвязи) = Тип("СправочникСсылка.упоСценарии") Тогда
			Возврат Справочники.упоСценарии.ПустаяСсылка();
		Иначе
			Возврат Справочники.Сценарии.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ДопИнформацияОбИсточнике.Вставить("Наименование", Выборка.Наименование);
	ДопИнформацияОбИсточнике.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
	
	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбработчикиПодписок

// Обработчик события ОбработкаПолученияФормы для справочников Контрагенты, Договоры.
//
Процедура ОбработкаПолученияФормыКонтрагентыДоговоры(Источник, ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда		
		упоИнтеграцияУПФСервер.ОбработкаПолученияФормыКонтрагентыДоговоры(Источник, ВидФормы);	
	КонецЕсли;
				
КонецПроцедуры

// Обработчик события, возникающий при получения формы подразделения или структуры предприятия.
//
// Параметры:
//  Источник				 - Произвольный - источник события.
//  ВидФормы				 - Строка - вид формы.
//  Параметры				 - Структура - параметры формы.
//  ВыбраннаяФорма			 - Строка, Форма - выбранная форма.
//  ДополнительнаяИнформация - Структура - дополнительная информация открытия формы.
//  СтандартнаяОбработка	 - Булево - признак выполнения стандартной обработки события.
//
Процедура ОбработкаПолученияФормыПодразделенияИСтруктурыПредприятия(Источник, ВидФормы, Параметры, ВыбраннаяФорма,
	ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
		И Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2()
		И Не ЭтоУПФ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТипЗнч(Источник) = Тип("СправочникМенеджер.упоПодразделения") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если ЭтоУПФ Тогда
		ИмяСправочника = "СтруктурныеЕдиницы";
	Иначе
		ИмяСправочника = "СтруктураПредприятия";
	КонецЕсли;
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		ВыбраннаяФорма = "Справочник.%1.ФормаОбъекта";
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВыбраннаяФорма, ИмяСправочника);
		Если Параметры.Свойство("Ключ") Тогда			
			ЭлементСтруктуры = НайтиСвязанныйЭлементСтруктурыИлиПодразделения(Параметры.Ключ);
			Параметры.Вставить("Ключ", ЭлементСтруктуры);
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда 
		ВыбраннаяФорма = "Справочник.%1.ФормаСписка";	
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВыбраннаяФорма, ИмяСправочника);
		Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ЭлементСтруктуры = НайтиСвязанныйЭлементСтруктурыИлиПодразделения(Параметры.ТекущаяСтрока);
			Параметры.Вставить("ТекущаяСтрока", ЭлементСтруктуры);
		КонецЕсли;
		Если ЭтоУПФ Тогда
			упоИнтеграцияУПФСервер.ДобавитьВПараметрыОтборПоТипуСтруктурнойЕдиницы(Параметры);
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаВыбора" Тогда
		
		Если ЭтоУПФ Тогда
			ВыбраннаяФорма = "Справочник.СтруктурныеЕдиницы.ФормаВыбора";
			упоИнтеграцияУПФСервер.ДобавитьВПараметрыОтборПоТипуСтруктурнойЕдиницы(Параметры);
		Иначе
			ВыбраннаяФорма = "Справочник.СтруктураПредприятия.Форма.ФормаВыбора";
		КонецЕсли;
		
		Параметры.Вставить("упоВыборПодразделения", Истина);
		
		Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ЭлементСтруктуры = НайтиСвязанныйЭлементСтруктурыИлиПодразделения(Параметры.ТекущаяСтрока);
			Параметры.Вставить("ТекущаяСтрока", ЭлементСтруктуры);
		КонецЕсли;
		
		Если Параметры.Свойство("Отбор") И Параметры.Свойство("РесурсПодразделения") Тогда
			ДатаАктуальности = Неопределено;
			Параметры.Свойство("ДатаАктуальности", ДатаАктуальности);
			
			МассивПодразделенийРоли = упоРесурсыИРолиСервер.ПолучитьМассивПодразделенийРоли(Параметры.РесурсПодразделения,
																							,
																							ДатаАктуальности);
			Параметры.Отбор.Вставить("Ссылка", МассивПодразделенийРоли);
		КонецЕсли;
		
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Ссылка") Тогда
			
			Если ТипЗнч(Параметры.Отбор.Ссылка) = Тип("Массив") Тогда
				
				ОтборМассив = Новый Массив;
				Для Каждого ЭлементМассива Из Параметры.Отбор.Ссылка Цикл
					
					Если ТипЗнч(ЭлементМассива) = Тип("СправочникСсылка.упоПодразделения") Тогда
						ПодмененныйЭлемент = НайтиСвязанныйЭлементСтруктурыИлиПодразделения(ЭлементМассива);
					Иначе
						ПодмененныйЭлемент = ЭлементМассива;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ПодмененныйЭлемент) Тогда
						ОтборМассив.Добавить(ПодмененныйЭлемент);			
					КонецЕсли;
					
				КонецЦикла;
				
				Параметры.Отбор.Ссылка.Очистить();
				Для Каждого ЭлементОтбор Из ОтборМассив Цикл
					Параметры.Отбор.Ссылка.Добавить(ЭлементОтбор); 
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(Параметры.Отбор.Ссылка) = Тип("СправочникСсылка.упоПодразделения") Тогда
				
				Параметры.Отбор.Ссылка.Очистить();
				
				ПодмененныйЭлемент = НайтиСвязанныйЭлементСтруктурыИлиПодразделения(ЭлементМассива);
				Параметры.Отбор.Ссылка.Добавить(ПодмененныйЭлемент); 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, возникающий при получения формы сценария.
//
// Параметры:
//  Источник				 - Произвольный - источник события.
//  ВидФормы				 - Строка - вид формы.
//  Параметры				 - Структура - параметры формы.
//  ВыбраннаяФорма			 - Строка, Форма - выбранная форма.
//  ДополнительнаяИнформация - Структура - дополнительная информация открытия формы.
//  СтандартнаяОбработка	 - Булево - признак выполнения стандартной обработки события.
//
Процедура ОбработкаПолученияФормыСценария(Источник, ВидФормы, Параметры, ВыбраннаяФорма,
	ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
	Если Не ЭтоEPM Тогда
		Возврат;
	КонецЕсли;
	Если Не ТипЗнч(Источник) = Тип("СправочникМенеджер.упоСценарии") Тогда
		Возврат;
	КонецЕсли;
	// При отключенном бюджетировании недоступен связанный справочник, открываем форму объекта PM.
	ОтключеноБюджетированиеERP = Не упоФункцииОбщегоНазначенияСервер.упоПолучитьФункциональнуюОпцию("ИспользоватьБюджетирование");
	Если ОтключеноБюджетированиеERP Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ИмяСправочника = "Сценарии";
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		ВыбраннаяФорма = "Справочник.%1.ФормаОбъекта";
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВыбраннаяФорма, ИмяСправочника);
		Если Параметры.Свойство("Ключ") Тогда
			ЭлементСтруктуры = НайтиСвязанныйЭлементСценария(Параметры.Ключ);
			Параметры.Вставить("Ключ", ЭлементСтруктуры);
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда 
		ВыбраннаяФорма = "Справочник.%1.ФормаСписка";
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВыбраннаяФорма, ИмяСправочника);
		Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ЭлементСтруктуры = НайтиСвязанныйЭлементСценария(Параметры.ТекущаяСтрока);
			Параметры.Вставить("ТекущаяСтрока", ЭлементСтруктуры);
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаВыбора" Тогда
		Параметры.Вставить("упоВыборСценария", Истина);
		
		ВыбраннаяФорма = "Справочник.%1.Форма.ФормаВыбора";
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВыбраннаяФорма, ИмяСправочника);
		
		Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ЭлементСтруктуры = НайтиСвязанныйЭлементСценария(Параметры.ТекущаяСтрока);
			Параметры.Вставить("ТекущаяСтрока", ЭлементСтруктуры);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Обработчки события, выбызваемый при получении формы статей доходов и расходов.
//
// Параметры:
//  Источник				 - Произвольный - источник события.
//  ВидФормы				 - Строка - вид формы.
//  Параметры				 - Структура - параметры формы.
//  ВыбраннаяФорма			 - Строка, Форма - выбранная форма.
//  ДополнительнаяИнформация - Структура - дополнительная информация открытия формы.
//  СтандартнаяОбработка	 - Булево - признак выполнения стандартной обработки события.
Процедура ОбработкаПолученияФормыСтатейДР(Источник, ВидФормы, Параметры, ВыбраннаяФорма,
	ДополнительнаяИнформация, СтандартнаяОбработка) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.НеобходимаСинхронизацияСтатейДР() Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЭтоСтатьяДоходов = Истина;
	Если ТипЗнч(Источник) = Тип("СправочникМенеджер.упоСтатьиДоходов") Тогда
		ИмяПВХ = "СтатьиДоходов"; 
		ИмяСправочника = "упоСтатьиДоходов";
	Иначе 
		ИмяПВХ = "СтатьиРасходов";
		ИмяСправочника = "упоСтатьиЗатрат";
		ЭтоСтатьяДоходов = Ложь;
	КонецЕсли;
	
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	
	ЭтоФормаВыбора = (ВидФормы = "ФормаВыбора" Или ВидФормы = "ФормаВыбораГруппы");
	
	Если ЭтоУПФ Тогда
		ИмяПВХ = "Управленческий";
		ШаблонВыбраннойФормы = "ПланСчетов.%1.%2";
		ИмяФормыЭлемента = "Форма.ФормаСчета";
		ИмяФормыГруппы = ИмяФормыЭлемента;
	Иначе
		ШаблонВыбраннойФормы = "ПланВидовХарактеристик.%1.%2";
		ИмяФормыЭлемента = "ФормаОбъекта";
		ИмяФормыГруппы = "ФормаГруппы";
		Если ЭтоФормаВыбора Тогда
			ШаблонВыбраннойФормы  = "Справочник."+ИмяСправочника+".Форма.ФормаВыбораСтатьиERP";	
		КонецЕсли;
	КонецЕсли;
	
	Если ВидФормы = "ФормаОбъекта" Тогда
				
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбраннойФормы, ИмяПВХ, ИмяФормыЭлемента);
		
		Если Параметры.Свойство("Ключ") Тогда			
			Статья = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Параметры.Ключ);
			Параметры.Вставить("Ключ", Статья);
		КонецЕсли;
		
	ИначеЕсли ВидФормы = "ФормаГруппы" Тогда
				
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбраннойФормы, ИмяПВХ, ИмяФормыГруппы);
		
		Если Параметры.Свойство("Ключ") Тогда           
			Статья = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Параметры.Ключ);
			Параметры.Вставить("Ключ", Статья);
		КонецЕсли;
		
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда 
				
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбраннойФормы, ИмяПВХ, "ФормаСписка");
		
		Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			Статья = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Параметры.ТекущаяСтрока);
			Параметры.Вставить("ТекущаяСтрока", Статья);
		КонецЕсли;
		
		Если ЭтоУПФ Тогда
			МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУПФСервер");
			ТипыСчетовОтбора = МодульИнтеграции.ТипыСчетовДоходыРасходы_ДляОтбора(ЭтоСтатьяДоходов);
			Параметры.Вставить("Отбор", ТипыСчетовОтбора);
		КонецЕсли;
		
	ИначеЕсли ЭтоФормаВыбора Тогда
		
		ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВыбраннойФормы, ИмяПВХ, "Форма.ФормаВыбора");
		
		Если ЭтоУПФ Тогда
			МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУПФКлиентСервер");
			ИмяПараметра = МодульИнтеграции.ИмяРеквизитаДляОпределенияВыбораСвязанойСтатьи();
			Параметры.Вставить(ИмяПараметра, Истина);
			
			МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУПФСервер");
			ТипыСчетовОтбора = МодульИнтеграции.ТипыСчетовДоходыРасходы_ДляОтбора(ЭтоСтатьяДоходов);
			Параметры.Вставить("Отбор", ТипыСчетовОтбора);
		КонецЕсли;
		
		Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			Статья = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Параметры.ТекущаяСтрока);
			Параметры.Вставить("ТекущаяСтрока", Статья);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Для внутреннего использования.
//
Функция ИтерацияОбновления(ОписаниеПодсистемы, Обработчики) Экспорт
	
	Возврат ОбновлениеИнформационнойБазыСлужебный.ИтерацияОбновления(ОписаниеПодсистемы.Имя, ОписаниеПодсистемы.Версия, 
				Обработчики, ОписаниеПодсистемы.Свойство("ОсновнаяПодсистема")
				И ОписаниеПодсистемы.ОсновнаяПодсистема);	
	
КонецФункции

// Для внутреннего использования.
//
Процедура УстановитьИтерацияОбновлениеОсновнойПодсистемы(ОписаниеПодсистемы, ИтерацияОбновлениеОсновнойПодсистемы, ИтерацияОбновления) Экспорт
	
	Если ОписаниеПодсистемы.Свойство("ОсновнаяПодсистема") И ОписаниеПодсистемы.ОсновнаяПодсистема Тогда	
		ИтерацияОбновлениеОсновнойПодсистемы = ИтерацияОбновления;
	КонецЕсли;
	
КонецПроцедуры

// Для внутреннего использования.
//
Процедура УстановитьФлагОтображенияОписанийПоТекущуюВерсию(Знач ИмяПользователя = Неопределено) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда 
		
		ВерсияОсновнойПодсистемы = упоИнтеграцияКлиентСерверПовтИсп.ПолучитьОписаниеОсновнойПодсистемыКонфигурации().Версия;
		
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбновлениеИБ",
			"ПоследняяВерсияОтображенияИзмененийСистемы", ВерсияОсновнойПодсистемы, , ИмяПользователя);
		
	КонецЕсли;
	
КонецПроцедуры

// Для внутреннего использования.
//
Функция НеобходимоОбновлениеИнформационнойБазы() Экспорт
	
	МассивОписанийПодсистем = упоФункцииБСПСерверПовтИсп.ПолучитьМассивОписанийПодсистемКонфигурации();
	
	Для Каждого ОписаниеПодсистемы Из МассивОписанийПодсистем Цикл
		Если ОбновлениеИнформационнойБазыСлужебный.НеобходимоВыполнитьОбновление(
			  ОписаниеПодсистемы.Версия, ОбновлениеИнформационнойБазыСлужебный.ВерсияИБ(ОписаниеПодсистемы.Имя)) Тогда
			Возврат Истина;
		КонецЕсли;			
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
