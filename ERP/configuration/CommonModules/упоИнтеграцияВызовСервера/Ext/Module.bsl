//   Булево - признак того, что это интегрированная конфигурация.
//
Функция ЭтоИнтегрированнаяКонфигурация() Экспорт
	
	 Возврат ЭтоDev2() 
			Или ЭтоEPM() 
			Или ЭтоУПО() 																 
			Или ЭтоУПФ() 
			Или ЭтоERPУХ();
	
КонецФункции	

// Получает версию конфигурации без слешей.
//
// Параметры:
//  СтрокаВерсии - Строка	 - строка версии.
// 
// Возвращаемое значение:
//  Строка - строка версии.
//
Функция ПолучитьВерсиюКонфигурацииБезСлешей(Знач СтрокаВерсии) Экспорт
	
	ПозицияПервогоСлеша = Найти(СтрокаВерсии, "/");
	
	Если ПозицияПервогоСлеша <> 0 Тогда							
		СтрокаВерсии = Лев(СтрокаВерсии, ПозицияПервогоСлеша - 1);			
	КонецЕсли;

	Возврат СтрокаВерсии;	
	
КонецФункции

