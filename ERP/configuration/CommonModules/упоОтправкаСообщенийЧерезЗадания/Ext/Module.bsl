////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции работы с отправкой сообщений по e-mail.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает информацию по версии модуля.
// 
// Возвращаемое значение:
//  Структура - 
//
Функция Информация() Экспорт
	
	Ответ = Новый Структура;
	Ответ.Вставить("ИмяМодуля", НСтр("ru = 'Модуль транспорта подсистемы оповещений для создания поручений'"));
	Ответ.Вставить("ВерсияМодуля", "2.0");
	
	Возврат Ответ;
	
КонецФункции 

// Отправляет сообщение.
//
// Параметры:
//  ПарОтправки	 - Структура
// 
// Возвращаемое значение:
//  Строка - идентификатор отправленного сообщения. См. РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение
//
Функция ОтправитьСообщение(ПарОтправки) Экспорт
	
	Если Не ЗначениеЗаполнено(ПарОтправки.Кому) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось определить исполнителя. Возможно, для пользователя не указан основной трудовой ресурс.'");
	КонецЕсли;
	
	Если ТипЗнч(ПарОтправки.Источник) = Тип("СправочникСсылка.упоЗадания") Тогда
		ИсточникЯвляетсяОповещением = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПарОтправки.Источник, "ЭтоОповещение");
		
		Если ИсточникЯвляетсяОповещением <> Неопределено И ИсточникЯвляетсяОповещением Тогда
			Возврат Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	АвторСотрудник = ПарОтправки.АвторСотрудник;
	ВидЗадания = Справочники.упоВидыЗаданий.Поручение;
	ВидСогласования = Перечисления.упоВидыСогласований.Параллельное;
	МассивСогласующих = Неопределено;
		
	Если ПарОтправки.Свойство("НастройкиВидаСобытия") Тогда
		НастройкиВидаСобытия = ПарОтправки.НастройкиВидаСобытия;
		Если НастройкиВидаСобытия.Свойство("АвторСотрудник") И ЗначениеЗаполнено(НастройкиВидаСобытия.АвторСотрудник) Тогда
			АвторСотрудник = НастройкиВидаСобытия.АвторСотрудник;	
		КонецЕсли;
		Если НастройкиВидаСобытия.Свойство("ВидЗадания") И ЗначениеЗаполнено(НастройкиВидаСобытия.ВидЗадания) Тогда
			ВидЗадания = НастройкиВидаСобытия.ВидЗадания;	
		КонецЕсли;
		Если НастройкиВидаСобытия.Свойство("ВидСогласования") И ЗначениеЗаполнено(НастройкиВидаСобытия.ВидСогласования) Тогда
			ВидСогласования = НастройкиВидаСобытия.ВидСогласования;	
		КонецЕсли;
		Если НастройкиВидаСобытия.Свойство("МассивСогласующих") 
			И ТипЗнч(НастройкиВидаСобытия.МассивСогласующих) = Тип("Массив") 
			И НастройкиВидаСобытия.МассивСогласующих.Количество() 
			Тогда
			МассивСогласующих = НастройкиВидаСобытия.МассивСогласующих;	
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(АвторСотрудник) Тогда
		ВызватьИсключение НСтр("ru = 'Не удалось определить автора поручений. Возможно, он не указан в параметрах траспорта.'");
	КонецЕсли;
	
	Задание = Справочники.упоЗадания.СоздатьЭлемент();
	Задание.ЭтоОповещение = Истина;
	Задание.АвторСотрудник = АвторСотрудник;
	Задание.Исполнитель = ПарОтправки.Кому;
	Задание.ОписаниеЗадания = ПарОтправки.Тело;
	Если ЗначениеЗаполнено(ПарОтправки.Тема) Тогда
		Задание.Наименование = ПарОтправки.Тема
	Иначе
		Задание.Наименование = ПарОтправки.Тело;
	КонецЕсли;
	Задание.ВидЗадания = ВидЗадания;
	Задание.ВидСогласования = ВидСогласования;
	
	//
	
	ПроектнаяЗадача = Неопределено;
	Проект = Неопределено;
	Портфель = Неопределено;
	ОбъектСсылка = Неопределено;
	
	ТипИсточникДопПараметр = ТипЗнч(ПарОтправки.ИсточникДопПараметр);
	ТипИсточник = ТипЗнч(ПарОтправки.Источник);
	
	Если ЗначениеЗаполнено(ПарОтправки.ИсточникДопПараметр) И ОбщегоНазначения.ЭтоСсылка(ТипИсточникДопПараметр) Тогда
		ОбъектСсылка = ПарОтправки.ИсточникДопПараметр;		
		Если  ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ПроектнаяЗадача = ОбъектСсылка; 	
		ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Проекты") Тогда
			Проект = ОбъектСсылка; 
		ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.упоПортфелиПроектов") Тогда
			Портфель = ОбъектСсылка; 
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПарОтправки.Источник) И ОбщегоНазначения.ЭтоСсылка(ТипИсточник) Тогда
		Если ОбъектСсылка = Неопределено Тогда
			ОбъектСсылка = ПарОтправки.Источник;		
		КонецЕсли;
		Если ПроектнаяЗадача = Неопределено И ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ПроектнаяЗадача = ОбъектСсылка; 	
		ИначеЕсли Проект = Неопределено И ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Проекты") Тогда
			Проект = ОбъектСсылка; 
		ИначеЕсли Портфель = Неопределено И ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.упоПортфелиПроектов") Тогда
			Портфель = ОбъектСсылка; 
		КонецЕсли;
	КонецЕсли;	
	Если Проект = Неопределено И ПроектнаяЗадача <> Неопределено Тогда
		Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "Проект");
	КонецЕсли;
	Если Портфель = Неопределено И Проект <> Неопределено Тогда
		Портфель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проект, "ПортфельПроектов");
	КонецЕсли;
	
	//		

	Если ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		Задание.ПроектнаяЗадача = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(ПроектнаяЗадача);
	КонецЕсли;
	Задание.Проект = Проект;
	Задание.ПортфельПроекта = Портфель;
	Задание.ОбъектБазы = ОбъектСсылка;
	
	//
	
	НачатьТранзакцию();
	
	//
	
	Если ВидЗадания = Справочники.упоВидыЗаданий.Согласование Тогда
		
		Задание.ЭтоСогласованиеРодитель = Истина;
				
		Если МассивСогласующих <> Неопределено И МассивСогласующих.Количество() Тогда
			Для Каждого Согласующий Из МассивСогласующих Цикл
				Задание.СогласующиеЛица.Добавить().СогласующееЛицо = Согласующий;	
			КонецЦикла;
		Иначе
			Задание.СогласующиеЛица.Добавить().СогласующееЛицо = Задание.Исполнитель;
		КонецЕсли;
				
		ДатаНачалаПлан = Дата(1,1,1);
		ДатаОкончанияПлан = Дата(1,1,1);
			
		Если ЗначениеЗаполнено(Задание.ПроектнаяЗадача) Тогда
			СсылкаНаПроектнуюЗадачу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задание.ПроектнаяЗадача, "СсылкаНаПроектнуюЗадачу");
			СтруктураСроки = Документы.упоПроектнаяЗадача.ПолучитьСроки(СсылкаНаПроектнуюЗадачу);
			Если СтруктураСроки <> Неопределено Тогда
				ДатаНачалаПлан = СтруктураСроки.ДатаНачала;
				ДатаОкончанияПлан = СтруктураСроки.ДатаЗавершения;
			КонецЕсли;	
		КонецЕсли;
		
		СтруктураРеквизитов = Новый Структура();
		СтруктураРеквизитов.Вставить("ДатаНачалаПлан", ДатаНачалаПлан);
		СтруктураРеквизитов.Вставить("ДатаОкончанияПлан", ДатаОкончанияПлан);
		
		//
		
		ПодчиненныеСписокИсполнителей  = Новый СписокЗначений;
		
		Если ВидСогласования = Перечисления.упоВидыСогласований.Параллельное Тогда
			Для Каждого СтрокаТЧ Из Задание.СогласующиеЛица Цикл
				ПодчиненныеСписокИсполнителей.Добавить(СтрокаТЧ.СогласующееЛицо);				
			КонецЦикла;
		Иначе
			ПодчиненныеСписокИсполнителей.Добавить(Задание.СогласующиеЛица[0].СогласующееЛицо);			
		КонецЕсли;		
		
	КонецЕсли;
	
	//
	
	Задание.Записать();
	
	//
	
	Если Задание.ВидЗадания = Справочники.упоВидыЗаданий.Обсуждение Тогда
		НовыйСтатус = Перечисления.упоСтатусыЗаданий.Открыто;
	ИначеЕсли Задание.ВидЗадания = Справочники.упоВидыЗаданий.Согласование Тогда	
		НовыйСтатус = Перечисления.упоСтатусыЗаданий.НаСогласовании;
	Иначе
		НовыйСтатус = Перечисления.упоСтатусыЗаданий.Выдано;
	КонецЕсли;
	
	упоЗаданияСервер.ЗаписатьВРегистрСтатусЗадания(Задание.Ссылка, НовыйСтатус, "");
	
	//
	
	Если ВидЗадания = Справочники.упоВидыЗаданий.Согласование Тогда
		
		упоЗаданияСервер.СоздатьПодчиненныеЗаданияКопированиемТекущего(Задание, СтруктураРеквизитов, 
																			ПодчиненныеСписокИсполнителей,
																			Задание.АвторСотрудник);	
		
	КонецЕсли;

	//
	
	ЗафиксироватьТранзакцию();
	
	//
	
	Возврат Задание.Ссылка.УникальныйИдентификатор();
			
КонецФункции

// Получает настройки транспорта.
// 
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьНастройкиТранспорта() Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("ДоступнаТемаСообщения", Истина);
	Рез.Вставить("ДоступенТекстСообщенияВHTML", Ложь);
	Рез.Вставить("ДоступнаНастройкаДляВидаСобытия", Истина);
	
	ПарТраспорта = Новый Структура;
	ПарТраспорта.Вставить("АвторСотрудник", Справочники.упоСотрудники.ПустаяСсылка());
	
	Рез.Вставить("ПараметрыТранспорта", ПарТраспорта);
	
	Возврат Рез;
	
КонецФункции

// Получает настройки транспорта для вида события.
// 
// Возвращаемое значение:
//  Массив
//
Функция ПолучитьНастройкиТранспортаДляВидаСобытия() Экспорт
	
	Рез = Новый Массив;
	
	Настройка = Новый Структура();
	Рез.Добавить(Настройка);
	Настройка.Вставить("КлючНастройки", "АвторСотрудник");
	Настройка.Вставить("ПредставлениеНастройки", НСтр("ru = 'Автор'"));
	Настройка.Вставить("Значение", Справочники.упоСотрудники.ПустаяСсылка());
	Настройка.Вставить("Кодом", Ложь);
	Настройка.Вставить("Использование", Ложь);
	Настройка.Вставить("ВыполняемыйКод", "");
	
	Настройка = Новый Структура();
	Рез.Добавить(Настройка);
	Настройка.Вставить("КлючНастройки", "ВидЗадания");
	Настройка.Вставить("ПредставлениеНастройки", НСтр("ru = 'Вид задания'"));
	Настройка.Вставить("Значение", Справочники.упоВидыЗаданий.Поручение);
	Настройка.Вставить("Кодом", Ложь);
	Настройка.Вставить("Использование", Ложь);
	Настройка.Вставить("ВыполняемыйКод", "");
	
	Настройка = Новый Структура();
	Рез.Добавить(Настройка);
	Настройка.Вставить("КлючНастройки", "ВидСогласования");
	Настройка.Вставить("ПредставлениеНастройки", НСтр("ru = 'Вид согласования'"));
	Настройка.Вставить("Значение", Перечисления.упоВидыСогласований.Параллельное);
	Настройка.Вставить("Кодом", Ложь);
	Настройка.Вставить("Использование", Ложь);
	Настройка.Вставить("ВыполняемыйКод", "");
	
	Настройка = Новый Структура();
	Рез.Добавить(Настройка);
	Настройка.Вставить("КлючНастройки", "МассивСогласующих");
	Настройка.Вставить("ПредставлениеНастройки", НСтр("ru = 'Массив согласующих'"));
	Настройка.Вставить("Значение", "");
	Настройка.Вставить("Кодом", Истина);
	Настройка.Вставить("Использование", Ложь);
	Настройка.Вставить("ВыполняемыйКод", "");
	
	Возврат Рез;
	
КонецФункции

#КонецОбласти