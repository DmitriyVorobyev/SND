#Область ПроверкаЗаполнения

Функция ПараметрыТаблиц_ПроверкаДублей(Объект, Форма, ДопПараметры, Отказ)
	
	ГруппыРазделов = ДопПараметры.ГруппыРазделов;
	КолонкиПоПериодам = ДопПараметры.ГруппыРазделовКолонкиПоПериодам;
	ПредставлениеДляДокумента = ДопПараметры.ПредставлениеДляДокумента;
	
	КолонкаСуммыДДС = Новый Соответствие;
	Если ДопПараметры.Свойство("КолонкаСуммыДДС") Тогда
		КолонкаИсключение = ДопПараметры.КолонкаСуммыДДС;
	Иначе
		КолонкаИсключение = "СуммаВалютная";
	КонецЕсли;
	КолонкаСуммыДДС.Вставить("ДвиженияДенежныхСредств", КолонкаИсключение);
	КолонкаСуммыДДС.Вставить("ПланПоступлений", КолонкаИсключение);
	КолонкаСуммыДДС.Вставить("ПланВыплат", КолонкаИсключение);
	
	ЭтоШаблон = Ложь;
	Если ДопПараметры.Свойство("ЭтоШаблон") Тогда
		ЭтоШаблон = ДопПараметры.ЭтоШаблон;
	КонецЕсли;	
	
	ПараметрыТаблиц = Новый Массив;
	
	Для Каждого РазделНаПроверку Из ГруппыРазделов Цикл
		
		Если Форма.Элементы[РазделНаПроверку.Ключ].Видимость Тогда
			
			ИмяТЧ = РазделНаПроверку.Значение;
			ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ, ПредставлениеДляДокумента);
							
			ПараметрТаблицы = Новый Структура;
			ПараметрТаблицы.Вставить("ТаблицаРаспределения", ИмяТЧ);
			ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ, ПредставлениеДляДокумента);
			ПараметрТаблицы.Вставить("СинонимТаблицыРаспределения", ПредставлениеТаблицы);
			КолонкиИзмеренийТаблицы = КолонкиИзмерений(ИмяТЧ, Форма, ЭтоШаблон);
			ПараметрТаблицы.Вставить("КолонкиИзмерений", КолонкиИзмеренийТаблицы);
			КолонкиСуммТаблицы = КолонкиСумм(ИмяТЧ, Форма, КолонкиПоПериодам, КолонкаСуммыДДС, ЭтоШаблон);
			ПараметрТаблицы.Вставить("КолонкиСумм", КолонкиСуммТаблицы);
			
			ПараметрыТаблиц.Добавить(ПараметрТаблицы);
			
			Если ИмяТЧ = "МатериальныеРесурсы" Тогда
				РесурсыСРазнымиЕдиницами = Новый Массив;
				ЕстьОшибки = ЕстьРазныеЕдиницыИзмерения(Объект, ИмяТЧ, РесурсыСРазнымиЕдиницами);																		
				Если ЕстьОшибки Тогда
					СообщениеТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'В табличной части ""%1"" есть строки с одинаковой номенклатурой, но различными единицами измерения.
						|Необходимо привести единицы измерения одинаковых позиций к одному виду:
						|%2'"),
						ПредставлениеТаблицы, СтрСоединить(РесурсыСРазнымиЕдиницами, Символы.ПС));
					ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст, , , , Отказ);
				КонецЕсли;
			КонецЕсли;			
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат ПараметрыТаблиц;
	
КонецФункции	

Функция ЕстьРазныеЕдиницыИзмерения(Объект, ИмяТаблицы, РесурсыСРазнымиЕдиницами = Неопределено)
	
	ЕстьРазные = Ложь;
	
	ФормироватьМассивОшибок = ТипЗнч(РесурсыСРазнымиЕдиницами) = Тип("Массив");
	
	РесурсыСоответствие = Новый Соответствие;	
	Для Каждого СтрокаТаблицы Из Объект[ИмяТаблицы] Цикл
		Если РесурсыСоответствие[СтрокаТаблицы.Ресурс] = Неопределено Тогда			
			ВидОперацииСоответствие = Новый Соответствие;
			ВидОперацииСоответствие.Вставить(СтрокаТаблицы.ВидОперации, СтрокаТаблицы.ЕдиницаНормирования);
			РесурсыСоответствие.Вставить(СтрокаТаблицы.Ресурс, ВидОперацииСоответствие);
		ИначеЕсли РесурсыСоответствие[СтрокаТаблицы.Ресурс][СтрокаТаблицы.ВидОперации] = Неопределено Тогда
			РесурсыСоответствие[СтрокаТаблицы.Ресурс].Вставить(СтрокаТаблицы.ВидОперации, СтрокаТаблицы.ЕдиницаНормирования);
		Иначе
			Если РесурсыСоответствие[СтрокаТаблицы.Ресурс][СтрокаТаблицы.ВидОперации] <> СтрокаТаблицы.ЕдиницаНормирования Тогда
				ЕстьРазные = Истина;
				Если ФормироватьМассивОшибок И РесурсыСРазнымиЕдиницами.Найти(СтрокаТаблицы.Ресурс) = Неопределено Тогда
					РесурсыСРазнымиЕдиницами.Добавить(СтрокаТаблицы.Ресурс);
				КонецЕсли;					
			КонецЕсли;				
		КонецЕсли;							
	КонецЦикла;
	
	Возврат ЕстьРазные;
	
КонецФункции

Функция КолонкиИзмерений(ИмяТаблицы, Форма, ЭтоШаблон = Ложь)
		
	ВозврКолонкиИзмерений = "";
	Если ИмяТаблицы = "РаспределениеОбъемов" Или ИмяТаблицы = "СубпродуктыПоПодразделениям" Тогда
		ВозврКолонкиИзмерений = "ДатаПривязки, ИндексСтрокиВладельца, 
							|КонтрагентПодрядчик, Подразделение, ПрофильРаспределения, Роль,
							|СобствСилы_Субподряд, СпособПривязки";
		Если Не ЭтоШаблон  Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", ЗаказДоговорПодрядчика, ИсполнительКонтрагент";
		КонецЕсли;
	ИначеЕсли ИмяТаблицы = "РаспределениеПотребностей" Или ИмяТаблицы = "МатериальныеРесурсыПоПодразделениям" Тогда
		ВозврКолонкиИзмерений = "СобствСилы_Субподряд, Роль, Подразделение, ПрофильРаспределения, ДатаПривязки, ИндексСтрокиВладельца,
							|СпособПривязки";
	ИначеЕсли ИмяТаблицы = "РаспределениеРасходов" Или ИмяТаблицы = "ПланРасходовПоПодразделениям" Тогда
		ВозврКолонкиИзмерений = "СобствСилы_Субподряд, Роль, Подразделение, ИндексСтрокиВладельца";
		Если Не ЭтоШаблон  Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", ИсточникПлана";
		КонецЕсли;
		РаспределениеРасходов = Форма.Элементы.Найти("РаспределениеРасходовГруппаОбъемыПоПодразделениям");
		Если РаспределениеРасходов = Неопределено Тогда
			РаспределениеРасходов = Форма.Элементы.Найти("ПланРасходовПоПодразделениямГруппаОбъемы");
		КонецЕсли;
		Если РаспределениеРасходов <> Неопределено И РаспределениеРасходов.Видимость Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", СпособПривязки, ДатаПривязки";
		КонецЕсли;
	ИначеЕсли ИмяТаблицы = "ДополнительныеЗатраты" Тогда
		ВозврКолонкиИзмерений = "СтатьяЗатрат, ВидОперации, Комментарий";
	ИначеЕсли ИмяТаблицы = "РаспределениеДоходов" Или ИмяТаблицы = "ПланДоходовПоПодразделениям" Тогда
		ВозврКолонкиИзмерений = "СобствСилы_Субподряд, Роль, Подразделение, ИндексСтрокиВладельца,
							|КонтрагентПодрядчик";
		Если Не ЭтоШаблон  Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", ЗаказДоговорПодрядчика, ИсполнительКонтрагент";
		КонецЕсли;
		РаспределениеДоходов = Форма.Элементы.Найти("РаспределениеДоходовГруппаОбъемыПоПодразделениям");
		Если РаспределениеДоходов = Неопределено Тогда
			РаспределениеДоходов = Форма.Элементы.Найти("ПланДоходовПоПодразделениямГруппаОбъемы");
		КонецЕсли;
		Если РаспределениеДоходов <> Неопределено И РаспределениеДоходов.Видимость Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", СпособПривязки, ДатаПривязки";
		КонецЕсли;
	ИначеЕсли ИмяТаблицы = "МатериальныеРесурсы" Тогда
		ВозврКолонкиИзмерений = "Ресурс, ЕдиницаНормирования, ВидОперации, СтатьяЗатрат, Валюта, ДатаЗаказа, 
							|ПрофильРаспределения, Контрагент, Договор, СпособПривязкиПотребности, ЗадержкаЗаказа,
							|ДатаПривязки, СпособПривязки, Стоимость";
	ИначеЕсли ИмяТаблицы = "Субпродукты" Тогда
		ВозврКолонкиИзмерений = "Ресурс, ЕдиницаНормирования, СтатьяДоходов, Валюта, ДатаВыпуска, 
							|ПрофильРаспределения, Контрагент, Договор, СпособПривязкиВыпуска, ЗадержкаЗаказа,
							|ДатаПривязки, СпособПривязки, Стоимость";	
	//ИначеЕсли ИмяТаблицы = "ДополнительныеЗатраты" Тогда
	//	ВозврКолонкиИзмерений = "СтатьяЗатрат, ВидОперации, КонтрагентДоходовРасходов, ДоговорДоходовРасходов, СпособПривязкиДоходовРасходов,  
	//						|ПрофильРаспределенияДоходовРасходов, ДатаПривязкиДоходовРасходов, ИндексСтрокРаспределения, Комментарий";
	ИначеЕсли ИмяТаблицы = "РаспределениеДополнительныхЗатрат" Тогда
		ВозврКолонкиИзмерений = "Подразделение, Роль, СобствСилы_Субподряд,  
							|КонтрагентПодрядчик, ИндексСтрокиВладельца";
		Если Не ЭтоШаблон  Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", ЗаказДоговорПодрядчика";
		КонецЕсли;
		Если Форма.Элементы.РаспределениеДополнительныхЗатратГруппаОбъемыПоПодразделениям.Видимость Тогда
			ВозврКолонкиИзмерений = ВозврКолонкиИзмерений + ", СпособПривязки, ДатаПривязки";
		КонецЕсли;
	ИначеЕсли ИмяТаблицы = "Трудозатраты" Тогда
		ВозврКолонкиИзмерений = "Роль, УровеньПланирования";
	ИначеЕсли ИмяТаблицы = "ДвиженияДенежныхСредств" Тогда
		ВозврКолонкиИзмерений = "СтатьяДДС, Контрагент, Договор, НаправлениеДвижения, ВидПлатежа, СпособПривязки, Задержка,
								|Валюта, ДатаПривязки, ПрофильРаспределения, ИсточникПлана";
	ИначеЕсли ИмяТаблицы = "ПланПоступлений" Или ИмяТаблицы = "ПланВыплат" Тогда
		ВозврКолонкиИзмерений = "Статья, Контрагент, ВидПлатежа, СпособПривязки, Задержка, Валюта, ПрофильРаспределения";
	КонецЕсли;
	
	Возврат ВозврКолонкиИзмерений;
	
КонецФункции

Функция ЗанулитьТаблицуПоПериодам(ИмяТаблицы, СтрокаТЧ)
	
	ЗанулитьТаблицуПоПериодам = Ложь;
	
	ЭтоРаспределениеРасходов = ИмяТаблицы = "РаспределениеРасходов" Или ИмяТаблицы = "ПланРасходовПоПодразделениям";
	ЭтоРаспределениеДоходов = ИмяТаблицы = "РаспределениеДоходов" Или ИмяТаблицы = "ПланДоходовПоПодразделениям";
	ЭтоРаспределениеМатЗатрат = ИмяТаблицы = "РаспределениеПотребностей" Или ИмяТаблицы = "МатериальныеРесурсыПоПодразделениям";
	ЭтоРаспределениеДополнительныхЗатрат = ИмяТаблицы = "РаспределениеДополнительныхЗатрат";
	ЭтоРаспределениеОбъемов = ИмяТаблицы = "РаспределениеОбъемов" Или ИмяТаблицы = "СубпродуктыПоПодразделениям";
	
	Если ЭтоРаспределениеРасходов
		Или ЭтоРаспределениеДоходов
		Или ЭтоРаспределениеМатЗатрат
		Или ЭтоРаспределениеДополнительныхЗатрат
		Или ЭтоРаспределениеОбъемов Тогда
			
	ЗанулитьТаблицуПоПериодам = СтрокаТЧ.СпособПривязки <> ПредопределенноеЗначение(
		"Перечисление.упоСпособПривязкиРаспределения.Вручную"); 
		
	КонецЕсли;
	
	Возврат ЗанулитьТаблицуПоПериодам;
	
КонецФункции

Функция КолонкиСумм(ИмяТаблицы, Форма, КолонкиПоПериодам, КолонкаСуммыДДС, ЭтоШаблон = Ложь)
	
	ВозврКолонкиСумм = "";
	МассивСтрок = Новый Массив;
	Если ИмяТаблицы = "МатериальныеРесурсы" Или ИмяТаблицы = "Субпродукты" Тогда
		МассивСтрок.Добавить("Количество, ОбщСтоимость");
		ЭтоПроектнаяПродукция = Форма.ТипПродуктаЧисло = 1;
		Если ИмяТаблицы = "Субпродукты" И ЭтоПроектнаяПродукция Тогда
			МассивСтрок.Добавить("Нормирование, Трудоемкость");
			Если ЭтоШаблон Тогда
				МассивСтрок.Добавить("СкоростьВыполнения, Скорость");			
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли ИмяТаблицы = "ДополнительныеЗатраты" Тогда
		МассивСтрок.Добавить("Стоимость");
	ИначеЕсли ИмяТаблицы = "РаспределениеДополнительныхЗатрат" Тогда
		МассивСтрок.Добавить("Сумма");
		Если Форма.Элементы.РаспределениеДополнительныхЗатратГруппаОбъемыПоПодразделениям.Видимость Тогда
			МассивСтрок.Добавить("СуммаОстаток, СуммаРаспределено");
		КонецЕсли;	
	ИначеЕсли ИмяТаблицы = "РаспределениеОбъемов" Или ИмяТаблицы = "РаспределениеПотребностей"
		Или ИмяТаблицы = "СубпродуктыПоПодразделениям" Или ИмяТаблицы = "МатериальныеРесурсыПоПодразделениям" Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить("Количество, Сумма");
		Если ИмяТаблицы = "РаспределениеОбъемов" Или ИмяТаблицы = "РаспределениеПотребностей" Тогда
			МассивСтрок.Добавить("КоличествоОстаток, СуммаОстаток, КоличествоРаспределено, СуммаРаспределено");			
		Иначе
			МассивСтрок.Добавить("НеРаспределеноКоличество, НеРаспределеноСумма, РаспределеноКоличество, РаспределеноСумма");
		КонецЕсли;
		ЭтоПроектнаяПродукция = Форма.ТипПродуктаЧисло = 1;
		Если (ИмяТаблицы = "РаспределениеОбъемов" Или ИмяТаблицы = "СубпродуктыПоПодразделениям")
			И ЭтоПроектнаяПродукция Тогда
			МассивСтрок.Добавить("Нормирование, Трудоемкость");	
		КонецЕсли;	
	ИначеЕсли ИмяТаблицы = "РаспределениеДоходов" Или ИмяТаблицы = "РаспределениеРасходов"
		Или ИмяТаблицы = "ПланРасходовПоПодразделениям" Или ИмяТаблицы = "ПланДоходовПоПодразделениям" Тогда
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить("Сумма");
		Если ИмяТаблицы = "ПланРасходовПоПодразделениям" Или ИмяТаблицы = "ПланДоходовПоПодразделениям" Тогда
			МассивСтрок.Добавить("НеРаспределеноСумма, РаспределеноСумма");
		ИначеЕсли (ИмяТаблицы = "РаспределениеДоходов" И Форма.Элементы.РаспределениеДоходовГруппаОбъемыПоПодразделениям.Видимость)
				Или (ИмяТаблицы = "РаспределениеРасходов" И Форма.Элементы.РаспределениеРасходовГруппаОбъемыПоПодразделениям.Видимость) Тогда
			МассивСтрок.Добавить("СуммаОстаток, СуммаРаспределено");
		КонецЕсли;
	ИначеЕсли ИмяТаблицы = "ДвиженияДенежныхСредств" Или ИмяТаблицы = "ПланПоступлений"
		Или ИмяТаблицы = "ПланВыплат" Тогда
		ИмяКолонки = КолонкаСуммыДДС[ИмяТаблицы];
		Если ИмяКолонки <> Неопределено Тогда
			МассивСтрок.Добавить(ИмяКолонки);	
		КонецЕсли;
	КонецЕсли;
		
	ВозврКолонкиСумм = СтрСоединить(МассивСтрок, ",");
	
	Возврат ВозврКолонкиСумм;
	
КонецФункции

#КонецОбласти

#Область ПроектнаяПродукция

// Удаляет из массива строки, содержащие шаблоны проектной продукции.
//
// Параметры:
//  СтрокиСубпродуктов - Массив - Массив на основе отбора по табличной части "Субпродукты" 
//
Процедура УдалитьШаблоныПроектнойПродукцииИзСубпродуктов(СтрокиСубпродуктов)
	
	МассивШаблонов = Новый Массив;
	Для Каждого СтрокаТаблицы Из СтрокиСубпродуктов Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Ресурс) Тогда
			МассивШаблонов.Добавить(СтрокаТаблицы.Ресурс);
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(МассивШаблонов) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитШаблон = упоФункцииБСП.ЗначениеРеквизитаОбъектовВызовСервера(МассивШаблонов, "Шаблон");
	
	Индекс = СтрокиСубпродуктов.Количество() - 1;
	Пока Индекс >= 0 Цикл 
		
		СтрокаТаблицы = СтрокиСубпродуктов[Индекс];
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Ресурс) Тогда
			Продолжить;
		КонецЕсли;
		
		Шаблон = РеквизитШаблон.Получить(СтрокаТаблицы.Ресурс);
		Если Шаблон Тогда 
			СтрокиСубпродуктов.Удалить(Индекс);
		КонецЕсли; 
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭлементыДляПроверкиВозможностиРедактированияПроектнойПродукции(ЭтоСтруктураПроекта)
	
	ОбрабатываемыеЭлементы = Новый Массив;
	
	ОбрабатываемыеЭлементы.Добавить("СубпродуктыКоличество");
	ОбрабатываемыеЭлементы.Добавить("СубпродуктыНормирование");
	ОбрабатываемыеЭлементы.Добавить("СубпродуктыКоэффициентСложности");
	ОбрабатываемыеЭлементы.Добавить("СубпродуктыТрудоемкость");
	
	Если ЭтоСтруктураПроекта Тогда
		ИмяТаблицыРаспределения = "СубпродуктыПоПодразделениям";
	Иначе
		ИмяТаблицыРаспределения = "РаспределениеОбъемов";
	КонецЕсли;
	
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "Роль");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "Подразделение");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "Количество");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "ПроцентРаспределения");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "Сумма");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "Нормирование");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "КоэффициентСложности");
	ОбрабатываемыеЭлементы.Добавить(ИмяТаблицыРаспределения + "Трудоемкость");
	
	Возврат ОбрабатываемыеЭлементы;
	
КонецФункции

#КонецОбласти

Функция ПолучитьИмяРеквизитаДляОтбора()

	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		Возврат "Контрагент";
	Иначе
		Возврат "Владелец";
	КонецЕсли;

КонецФункции

Функция ПолучитьСтруктуруПараметровДляДатФакта(ИмяЭлемента)
	
	ДопПараметры = Новый Структура("ПараметрСообщения1, ПараметрСообщения2, ПараметрСообщения3", 
		"", "", "");
	Если ИмяЭлемента = "ПроектныеЗадачиДатаНачалаФакт" Тогда 
		ДопПараметры.Вставить("ПараметрСообщения1", НСтр("ru = 'начала'"));
		ДопПараметры.Вставить("ПараметрСообщения2", НСтр("ru = 'больше'"));
		ДопПараметры.Вставить("ПараметрСообщения3", НСтр("ru = 'завершения'"));
	ИначеЕсли ИмяЭлемента = "ПроектныеЗадачиДатаЗавершенияФакт" Тогда
		ДопПараметры.Вставить("ПараметрСообщения1", НСтр("ru = 'завершения'"));
		ДопПараметры.Вставить("ПараметрСообщения2", НСтр("ru = 'меньше'"));
		ДопПараметры.Вставить("ПараметрСообщения3", НСтр("ru = 'начала'"));		
	ИначеЕсли ИмяЭлемента = "ДеревоЗадачДатаНачалаФакт" Тогда
		ДопПараметры.Вставить("ПараметрСообщения1", НСтр("ru = 'начала'"));
		ДопПараметры.Вставить("ПараметрСообщения2", НСтр("ru = 'больше'"));
		ДопПараметры.Вставить("ПараметрСообщения3", НСтр("ru = 'окончания'"));		
	ИначеЕсли ИмяЭлемента = "ДеревоЗадачДатаЗавершенияФакт" Тогда
		ДопПараметры.Вставить("ПараметрСообщения1", НСтр("ru = 'окончания'"));
		ДопПараметры.Вставить("ПараметрСообщения2", НСтр("ru = 'меньше'"));
		ДопПараметры.Вставить("ПараметрСообщения3", НСтр("ru = 'начала'"));
	КонецЕсли;
	
	Возврат ДопПараметры;
	
КонецФункции

Процедура ИзменитьПроверяемуюДатуПоляИВывестиСообщение(СтрокаТаблицы, Дата, ИмяЭлемента, ДопПараметрыСообщения)
		
	ПараметрСообщения1 = ДопПараметрыСообщения.ПараметрСообщения1; 
	ПараметрСообщения2 = ДопПараметрыСообщения.ПараметрСообщения2;
	ПараметрСообщения3 = ДопПараметрыСообщения.ПараметрСообщения3;
	
	СтрокаТаблицы[ИмяЭлемента] = Дата;
		
	ОбщегоНазначенияКлиент.СообщитьПользователю(
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Фактическая дата %1 не может быть %2 фактической даты %3'"),
	    	ПараметрСообщения1, ПараметрСообщения2, ПараметрСообщения3));	
	
КонецПроцедуры

Процедура УстановитьДанныеСтрокиПоРодителю(СтрокаДляАгрегирования, Объект, ИмяТаблицыВладельца)
		
	Если Не ЗначениеЗаполнено(ИмяТаблицыВладельца) Тогда
		Возврат;
	КонецЕсли;	
	
	ОтборСтрок = Новый Структура("ИндексСтрокРаспределения", СтрокаДляАгрегирования.ИндексСтрокиВладельца);
	НайденныеСтрокиВладелец = Объект[ИмяТаблицыВладельца].НайтиСтроки(ОтборСтрок);
	Если НайденныеСтрокиВладелец.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяКолонкиСпособаПривязки = "СпособПривязки";
	Если ИмяТаблицыВладельца = "ДополнительныеЗатраты" Тогда 
		СоответствиеКолонокПолное = упоРаботаСФормамиКлиентСервер.ПолучитьСтруктуруСоответствияКолонокДляПереносаСтрок("ПланРасходов", ИмяТаблицыВладельца);
		СоответствиеКолонок = СоответствиеКолонокПолное.СоотвКолонокОсновныхТаблиц;
		СтрокаДляАгрегирования.ПрофильРаспределения = НайденныеСтрокиВладелец[0][СоответствиеКолонок.ПрофильРаспределения];
		СтрокаДляАгрегирования.ДатаПривязки = НайденныеСтрокиВладелец[0][СоответствиеКолонок.ДатаПривязки];
		ИмяКолонкиСпособаПривязки = СоответствиеКолонок.СпособПривязки;
	Иначе
		ЗаполнитьЗначенияСвойств(СтрокаДляАгрегирования, НайденныеСтрокиВладелец[0], "ПрофильРаспределения, ДатаПривязки");
	КонецЕсли;
	
	Если ТипЗнч(СтрокаДляАгрегирования.СпособПривязки) = Тип("ПеречислениеСсылка.упоСпособПривязкиРаспределения") Тогда
		Если НайденныеСтрокиВладелец[0][ИмяКолонкиСпособаПривязки] = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения") Тогда
			СтрокаДляАгрегирования.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения");
		ИначеЕсли НайденныеСтрокиВладелец[0][ИмяКолонкиСпособаПривязки] = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.НаДату") Тогда
			СтрокаДляАгрегирования.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.НаДату");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция НужноПереместитьСтроку(ВыделенныеСтроки, ВыделеннаяСтрока, Индекс, Сдвиг)
	
	Если ВыделенныеСтроки.Количество() > 1 И Индекс > 0 
		И (ВыделеннаяСтрока.Значение + Сдвиг) = ВыделенныеСтроки[Индекс - 1].Значение Тогда				
		Возврат Ложь;			
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции

Функция ВеличинаСдвига(ИндексТекущейСтроки, ТабличнаяЧасть, ОтборСтрокЭлемента, НаправлениеСдвига)
		
	Сдвиг = 0;
	
	МаксимальныйИндекс = ТабличнаяЧасть.Количество();
	
	Пока Истина Цикл
		
		Сдвиг = Сдвиг + НаправлениеСдвига;
		
		Если ИндексТекущейСтроки + Сдвиг < 0
			Или ИндексТекущейСтроки + Сдвиг >= МаксимальныйИндекс Тогда
			Возврат 0;
		КонецЕсли;
				
		Если ОтборСтрокЭлемента = Неопределено Тогда
			Прервать;
		КонецЕсли;	
		
		НайденаСтрокаУдовлетворяющаяОтбору = Истина;
		Для Каждого ЭлементОтбора Из ОтборСтрокЭлемента Цикл
			Если ТабличнаяЧасть[ИндексТекущейСтроки + Сдвиг][ЭлементОтбора.Ключ] <> ЭлементОтбора.Значение Тогда
				НайденаСтрокаУдовлетворяющаяОтбору = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НайденаСтрокаУдовлетворяющаяОтбору Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Сдвиг;
	
КонецФункции

Функция ДанныеВыделенныхСтрокТабЧасти(Объект, Форма, ИмяТЧ)
	
	ДанныеВыделенныхСтрок = Новый Массив;
	
	ВыделенныеСтроки = Форма.Элементы[ИмяТЧ].ВыделенныеСтроки;
	Если Не ЗначениеЗаполнено(ВыделенныеСтроки) Тогда
		Возврат ДанныеВыделенныхСтрок;
	КонецЕсли;
	
	ТабЧасть = Объект[ИмяТЧ];
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		Если ВыделеннаяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТекДанные = ТабЧасть.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Если ТекДанные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеВыделенныхСтрок.Добавить(ТекДанные);
	КонецЦикла;
	
	Возврат ДанныеВыделенныхСтрок;
	
КонецФункции

Процедура ПоказатьПредупреждениеДействиеНедоступно()
	
	ПоказатьПредупреждение(,НСтр("ru = 'Действие недоступно для строки группировки списка!'"));
	
КонецПроцедуры

Процедура ОбнулитьРаспределениеПоПериодамСтрокиПланаПроектнойЗадачи(Объект, Форма, СтрокаТаблицы,
			ИмяТаблицыРаспределения, ИмяТаблицыПериоды, ИмяКолонкиИндекса)
	
	упоАналитикаПоПодразделениямКлиент.ОчиститьСтрокиРаспределенияПоПериодам(Форма.Объект, Форма,
		ИмяТаблицыРаспределения, ИмяТаблицыПериоды, ИмяКолонкиИндекса, СтрокаТаблицы);
	
	ЕстьКолонкиСуммы = Истина;
	ЕстьКолонкиКоличество = Истина;
	
	Если ИмяТаблицыРаспределения = "РаспределениеДоходов" Или ИмяТаблицыРаспределения = "РаспределениеРасходов" Или
		ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат" Тогда
		ЕстьКолонкиКоличество = Ложь;
	КонецЕсли;
	
	Если ЕстьКолонкиКоличество Тогда
		СтрокаТаблицы.КоличествоРаспределено = 0;
		СтрокаТаблицы.КоличествоОстаток = 0;
	КонецЕсли;
	
	Если ЕстьКолонкиСуммы Тогда
		СтрокаТаблицы.СуммаРаспределено = 0;
		СтрокаТаблицы.СуммаОстаток = 0;
	КонецЕсли;
	
	КолонкиПериодов = Новый Массив;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "СоответствиеРазделовКолонкиПоПериодам") Тогда
		ЕстьСозданныеКолонкиПериодов = Форма.СоответствиеРазделовКолонкиПоПериодам.Свойство(ИмяТаблицыРаспределения);
		
		Если ЕстьСозданныеКолонкиПериодов Тогда
			ДобавленныеКолонки = Форма.СоответствиеРазделовКолонкиПоПериодам[ИмяТаблицыРаспределения];
			Для Каждого СтрокаКолонки Из ДобавленныеКолонки Цикл
				КолонкиПериодов.Добавить(СтрокаКолонки.Представление);
			КонецЦикла;
		КонецЕсли;
	Иначе // Для шаблона ПЗ.
		ДобавленныеЭлементыПериодов =
			упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(Форма, ИмяТаблицыРаспределения);
		Для Каждого ГруппаКолонокПоПериоду Из ДобавленныеЭлементыПериодов Цикл
			ИмяКолонкиСумма = СтрЗаменить(ГруппаКолонокПоПериоду.Имя, "Группа_", "Сумма_");
			КолонкиПериодов.Добавить(ИмяКолонкиСумма);
			Если ЕстьКолонкиКоличество Тогда
				ИмяКолонкиКоличество = СтрЗаменить(ГруппаКолонокПоПериоду.Имя, "Группа_", "Количество_");
				КолонкиПериодов.Добавить(ИмяКолонкиКоличество);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ИмяКолонки Из КолонкиПериодов Цикл
		// Колонка могла быть удалена из таблицы.
		Попытка
			СтрокаТаблицы[ИмяКолонки] = 0;
			ИмяКолонкиИтогов = "Всего_" + ИмяКолонки;
			Форма[ИмяКолонкиИтогов] = 0;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьКолонкиСуммКолонкамиПоПериодам(МассивИменСуммовыхКолонок, ИмяТаблицы, КолонкиПоПериодам, 
	ЗанулитьТаблицуПоПериодам)
	
	Если Не ЗанулитьТаблицуПоПериодам И КолонкиПоПериодам.Свойство(ИмяТаблицы) Тогда
		Для Каждого Колонка Из КолонкиПоПериодам[ИмяТаблицы] Цикл
			МассивИменСуммовыхКолонок.Добавить(Колонка.Представление);
		КонецЦикла;	
	КонецЕсли;
		
КонецПроцедуры

Процедура ПересчитатьДлительностьПроектнойПродукцииШаблоновПЗ(Субпродукты)
	
	Для каждого Строка Из Субпродукты Цикл
		Если упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(Строка.Ресурс) Тогда
			Строка.Длительность = Строка.Количество * Строка.СкоростьВыполнения;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
