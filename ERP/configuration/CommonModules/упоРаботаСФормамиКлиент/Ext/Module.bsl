		МассивТипов.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "ПланДоходов";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "ПланРасходов_УстановитьОбщийПрофиль" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "ПланРасходов";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "РолиТР_УстановитьОбщийПрофиль" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияТрудозатрат"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "ТрудовыеРесурсы";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "ТрудовыеРесурсыРоли_УстановитьОбщийПрофиль" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияТрудозатрат"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "ТрудовыеРесурсыРоли";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "РаспределениеОбъемовЗаполнитьСССП" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоСобственныеСилыСубподряд"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "РаспределениеОбъемов";
		ИмяКолонки = "СобствСилы_Субподряд";
		
	ИначеЕсли ИмяКоманды = "СубпродуктыПоПодразделениямЗаполнитьСССП" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоСобственныеСилыСубподряд"));
