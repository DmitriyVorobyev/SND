		МассивТиповПеречисление.Добавить(Тип("СправочникСсылка.Контрагенты"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		ИмяТЧ = "МатериальныеРесурсы";
		ИмяКолонки = "Контрагент";
		ДозаполнитьДоговор = Истина;
		
	ИначеЕсли ИмяКоманды = "Субпродукты_СпособПривязки" Тогда
		
		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("ПеречислениеСсылка.упоСпособПривязкиПоставокИСубпродуктов"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "СпособПривязкиВыпуска";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_ЗадержкаЗаказа" Тогда
		
		ОписаниеТиповП = Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "ЗадержкаЗаказа";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_СтатьяДоходов" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоСтатьиДоходов"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "СтатьяДоходов";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_ПрофильРаспределения" Тогда
		
		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_Контрагент" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "Контрагент";
