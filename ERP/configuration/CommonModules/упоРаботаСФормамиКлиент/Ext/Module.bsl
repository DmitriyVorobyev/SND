Функция СтрокаДанныхДляРасчетаНДС(ТекущиеДанные, ИмяКолонкиСумма) Экспорт
	
	СтрокаВладелец = Новый Структура;
	СтрокаВладелец.Вставить("Валюта", ТекущиеДанные.Валюта); 
	СтрокаВладелец.Вставить("Договор", ТекущиеДанные.Договор);
	СтрокаВладелец.Вставить("ИндексСтрокРаспределения", ТекущиеДанные.ИндексСтрокРаспределения);
	Если ТекущиеДанные.Свойство("ИсточникПлана") Тогда
		СтрокаВладелец.Вставить("ИсточникПлана", ТекущиеДанные.ИсточникПлана);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("СпособПривязки") Тогда
		СтрокаВладелец.Вставить("СпособПривязки", упоАналитикаПоПодразделениямКлиентСервер.
			СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода(ТекущиеДанные.СпособПривязки));
		СтрокаВладелец.Вставить("ПрофильРаспределения", ТекущиеДанные.ПрофильРаспределения);
		СтрокаВладелец.Вставить("ДатаПривязки", ТекущиеДанные.ДатаПривязки);
	КонецЕсли;
	СтрокаВладелец.Вставить("Сумма", ТекущиеДанные[ИмяКолонкиСумма]);
	
	Возврат СтрокаВладелец;
	
КонецФункции

Функция ЭтоСтрокаГруппировкиДинамическогоСписка(СтрокаДинамическогоСписка, ПоказатьПредупреждение = Ложь) Экспорт
	
	ЭтоСтрокаГруппировки = ТипЗнч(СтрокаДинамическогоСписка) = Тип("СтрокаГруппировкиДинамическогоСписка");
	
	Если ПоказатьПредупреждение И ЭтоСтрокаГруппировки Тогда
		ПоказатьПредупреждениеДействиеНедоступно();
	КонецЕсли;
	
	Возврат ЭтоСтрокаГруппировки;
	
КонецФункции

#КонецОбласти

