	РезультатЗапроса = Запрос.ВыполнитьПакет();
		
	Если НЕ РезультатЗапроса[4].Пустой() Тогда

		ВывестиСообщениеОНевозможностиРаспределения(РезультатЗапроса[4]);
					
		Возврат Неопределено;
		
	КонецЕсли;	
	
	Если НЕ РезультатЗапроса[5].Пустой() Тогда
		
		Рез = РаспределитьНачисленияФизЛиц(РезультатЗапроса[5], ИсходнаяТаблица);
		
		ИсходнаяТаблица.Очистить();
		
		Для Каждого СтрокаРез Из Рез Цикл
			НоваяСтрока = ИсходнаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРез);
		КонецЦикла;
		
