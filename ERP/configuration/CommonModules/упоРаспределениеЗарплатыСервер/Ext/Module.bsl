Функция ТекстЗапросаВТ_ВсеРабочееВремя(Парам)
	
	ИспользоватьСогласованныеЧасы = Неопределено;
	Если НЕ Парам.Свойство("ИспользоватьСогласованныеЧасы", ИспользоватьСогласованныеЧасы) Тогда
		ИспользоватьСогласованныеЧасы = Ложь;
	КонецЕсли;
	
	Если ИспользоватьСогласованныеЧасы Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(упоИспользованиеРабочегоВремени.День, МЕСЯЦ) КАК ПериодНачислений,
			|	упоИспользованиеРабочегоВремени.Подразделение КАК Подразделение,
			|	упоИспользованиеРабочегоВремени.ТрудовойРесурс.ФизическоеЛицо КАК ФизическоеЛицо,
			|	упоИспользованиеРабочегоВремени.ВидОперации КАК ВидОперацииПМ,
			|	упоИспользованиеРабочегоВремени.ЗадачаПричина КАК ЗадачаПричина,
			|	НЕОПРЕДЕЛЕНО КАК Начисление,
			|	НЕОПРЕДЕЛЕНО КАК СпособОтраженияЗарплатыВБухучете,
			|	СУММА(0) КАК Часы,
			|	ВЫБОР
			|		КОГДА упоИспользованиеРабочегоВремени.ЗадачаПричина ССЫЛКА Справочник.Проекты
			|			ТОГДА упоИспользованиеРабочегоВремени.ЗадачаПричина.упоКорневойПроект
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ КАК Проект
			|ПОМЕСТИТЬ ВсеРабочееВремя
			|ИЗ
			|	РегистрСведений.упоИспользованиеРабочегоВремени КАК упоИспользованиеРабочегоВремени
			|ГДЕ
			|	упоИспользованиеРабочегоВремени.День МЕЖДУ &НачалоПериода И &КонецПериода
			|	И НЕ упоИспользованиеРабочегоВремени.ТрудовойРесурс.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(упоИспользованиеРабочегоВремени.День, МЕСЯЦ),
			|	упоИспользованиеРабочегоВремени.Подразделение,
			|	упоИспользованиеРабочегоВремени.ТрудовойРесурс.ФизическоеЛицо,
			|	упоИспользованиеРабочегоВремени.ВидОперации,
			|	упоИспользованиеРабочегоВремени.ЗадачаПричина,
			|	ВЫБОР
			|		КОГДА упоИспользованиеРабочегоВремени.ЗадачаПричина ССЫЛКА Справочник.Проекты
			|			ТОГДА упоИспользованиеРабочегоВремени.ЗадачаПричина.упоКорневойПроект
			|		ИНАЧЕ НЕОПРЕДЕЛЕНО
			|	КОНЕЦ
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	СогласованныеТрудозатратыЗаПериод.ПериодМесяц,
			|	СогласованныеТрудозатратыЗаПериод.Подразделение,
			|	СогласованныеТрудозатратыЗаПериод.Ресурс.ФизическоеЛицо,
			|	СогласованныеТрудозатратыЗаПериод.ВидОперации,
			|	Проекты.Ссылка,
			|	НЕОПРЕДЕЛЕНО,
			|	НЕОПРЕДЕЛЕНО,
			|	СУММА(СогласованныеТрудозатратыЗаПериод.СогласованныеЧасыОборот),
			|	СогласованныеТрудозатратыЗаПериод.ПроектнаяЗадача.Проект
			|ИЗ
			|	РегистрНакопления.упоСогласованныеТрудозатраты.Обороты(&НачалоПериода, &КонецПериода, Авто, ) КАК СогласованныеТрудозатратыЗаПериод
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
			|		ПО СогласованныеТрудозатратыЗаПериод.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
			|ГДЕ
			|	&ИспользоватьСогласованныеЧасы
			|	И НЕ СогласованныеТрудозатратыЗаПериод.Ресурс.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	СогласованныеТрудозатратыЗаПериод.ПериодМесяц,
			|	СогласованныеТрудозатратыЗаПериод.Подразделение,
			|	СогласованныеТрудозатратыЗаПериод.Ресурс.ФизическоеЛицо,
			|	СогласованныеТрудозатратыЗаПериод.ВидОперации,
			|	СогласованныеТрудозатратыЗаПериод.ПроектнаяЗадача.Проект,
			|	Проекты.Ссылка";
		
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|    НАЧАЛОПЕРИОДА(упоИспользованиеРабочегоВремени.День, МЕСЯЦ) КАК ПериодНачислений,
			|    упоИспользованиеРабочегоВремени.Подразделение КАК Подразделение, 
			|    упоИспользованиеРабочегоВремени.ТрудовойРесурс.ФизическоеЛицо КАК ФизическоеЛицо,
			|    упоИспользованиеРабочегоВремени.ВидОперации КАК ВидОперацииПМ,
			|    упоИспользованиеРабочегоВремени.ЗадачаПричина КАК ЗадачаПричина,
			|    НЕОПРЕДЕЛЕНО КАК Начисление,
			|    НЕОПРЕДЕЛЕНО КАК СпособОтраженияЗарплатыВБухучете,
			|    упоИспользованиеРабочегоВремени.Трудозатраты КАК Часы,
			|    ВЫБОР
			|        КОГДА упоИспользованиеРабочегоВремени.ЗадачаПричина ССЫЛКА Справочник.Проекты
			|            ТОГДА упоИспользованиеРабочегоВремени.ЗадачаПричина.упоКорневойПроект
			|        ИНАЧЕ НЕОПРЕДЕЛЕНО
			|    КОНЕЦ КАК Проект 
			|ПОМЕСТИТЬ ВсеРабочееВремя
			|ИЗ
			|    РегистрСведений.упоИспользованиеРабочегоВремени КАК упоИспользованиеРабочегоВремени
			|ГДЕ
			|    упоИспользованиеРабочегоВремени.День МЕЖДУ &НачалоПериода И &КонецПериода
			|    И НЕ упоИспользованиеРабочегоВремени.ТрудовойРесурс.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
			|";
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьПроектыПериодНачислений(Запрос)
	
	Запрос.Текст = "ВЫБРАТЬ
		|    ВсеРабочееВремя.Проект КАК Проект
		|ИЗ
		|    ВсеРабочееВремя КАК ВсеРабочееВремя
		|ГДЕ
		|    НЕ ВсеРабочееВремя.Проект = НЕОПРЕДЕЛЕНО
		|
		|СГРУППИРОВАТЬ ПО
		|    ВсеРабочееВремя.Проект";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Проект");
	
КонецФункции

Функция РаспределитьНачисленияФизЛиц(РезультатЗапроса, Контейнер)
	
	ИмяКолонкиНачисление = упоРаспределениеЗарплатыНастройкиСервер.ИмяКолонкиНачисленияСоответствияВДокументе();
	
	НачисленнаяЗарплатаИВзносыПоФизлицам = Контейнер.Скопировать();
	
	МассивСуммовыеПоказатели = МассивСуммовыеПоказатели();
	ИмяКолонкиНачисления = упоРаспределениеЗарплатыНастройкиСервер.ИмяКолонкиНачисленияСоответствияВДокументе();
	
	КолонкиДляСуммированияСтрокой = СтрСоединить(МассивСуммовыеПоказатели, ",");
	КолонкиДляСуммирования = Новый Структура(КолонкиДляСуммированияСтрокой);
	
	Выборка_ФизическоеЛицо = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ИД = 0;
	
	Пока Выборка_ФизическоеЛицо.следующий() Цикл
		
		ИД = ИД + 1;
		Выборка_ВидОперации = Выборка_ФизическоеЛицо.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка_ВидОперации.Следующий() Цикл
			
			Выборка_ДатаНачала = Выборка_ВидОперации.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка_ДатаНачала.Следующий() Цикл
				
				Выборка_НачислениеERP_ЗУП = Выборка_ДатаНачала.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				ТаблицаКоэфНачисленияERP_ЗУП = ПолучитьТаблицаКоэфНачисленияERP_ЗУП(Выборка_НачислениеERP_ЗУП, НачисленнаяЗарплатаИВзносыПоФизлицам);
				
				Пока Выборка_НачислениеERP_ЗУП.Следующий() Цикл
					
					КоэффициентыНачисленияERP_ЗУП = ТаблицаКоэфНачисленияERP_ЗУП.Найти(Выборка_НачислениеERP_ЗУП.НачислениеERP_ЗУП, ИмяКолонкиНачисление);
					
					ЧасовВсего = Выборка_НачислениеERP_ЗУП.Часы;
					КоэффициентыРаспределения = Новый Массив;
					МассивСпособОтражения = Новый Массив;
					МассивНачислениеСоответствие = Новый Массив;
					МассивПодразделениеИспользованиеВремени = Новый Массив;
					
					ПараметрыОтбора = Новый Структура("ФизическоеЛицо, Начисление, ДатаНачала");
					ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка_НачислениеERP_ЗУП);
					ПараметрыОтбора.Вставить(ИмяКолонкиНачисления, Выборка_НачислениеERP_ЗУП.НачислениеERP_ЗУП);
					
					Найдено = НачисленнаяЗарплатаИВзносыПоФизлицам.НайтиСтроки(ПараметрыОтбора);
					
					Если Найдено.Количество() Тогда
						
						СтрокаТаблицыКакСтруктура = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Найдено[0]);
						
						Если Найдено.Количество() > 1 Тогда
							Для сч = 1 По Найдено.Количество() - 1 Цикл
								
								Для Каждого СуммовойПоказатель Из КолонкиДляСуммирования Цикл
									СтрокаТаблицыКакСтруктура[СуммовойПоказатель.Ключ] = СтрокаТаблицыКакСтруктура[СуммовойПоказатель.Ключ] + Найдено[сч][СуммовойПоказатель.Ключ];
								КонецЦикла;
								
							КонецЦикла;
						КонецЕсли;
						
						Выборка = Выборка_НачислениеERP_ЗУП.Выбрать();
						Пока Выборка.следующий() Цикл
							МассивСпособОтражения.Добавить(Выборка.СпособОтраженияЗарплатыВБухучете);
							МассивНачислениеСоответствие.Добавить(Выборка.НачислениеСоответствие);
							КоэффициентыРаспределения.Добавить(Выборка.Часы);
							МассивПодразделениеИспользованиеВремени.Добавить(Выборка.ПодразделениеИспользованиеВремени);
						КонецЦикла;
						
						РезультатРаспределения = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(1, КоэффициентыРаспределения, 6);
						
						Если РезультатРаспределения = Неопределено Тогда
							Продолжить;
						КонецЕсли;
						
						Для Каждого СуммовойПоказатель Из КолонкиДляСуммирования Цикл
							КолонкиДляСуммирования[СуммовойПоказатель.Ключ] =
								ОбщегоНазначения.
								РаспределитьСуммуПропорциональноКоэффициентам(
									СтрокаТаблицыКакСтруктура[СуммовойПоказатель.Ключ], РезультатРаспределения, 2);
						КонецЦикла;
						
						КолЭлементов = РезультатРаспределения.Количество() - 1;
						
						Для сч = 0 По КолЭлементов Цикл
							
							НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыКакСтруктура, , КолонкиДляСуммированияСтрокой);
							
							НоваяСтрока.СпособОтраженияЗарплатыВБухучете = МассивСпособОтражения[сч];
							НоваяСтрока.НачислениеСоответствие = МассивНачислениеСоответствие[сч];
							НоваяСтрока.КоэффициентРаспределения = РезультатРаспределения[сч] * КоэффициентыНачисленияERP_ЗУП["КоэфСумма"];
							НоваяСтрока.Часы = КоэффициентыРаспределения[сч] * КоэффициентыНачисленияERP_ЗУП["КоэфСумма"];
							НоваяСтрока.ЧасыВсего = ЧасовВсего * КоэффициентыНачисленияERP_ЗУП["КоэфСумма"];
							НоваяСтрока.ИД = ИД;
							
							Если ЗначениеЗаполнено(МассивПодразделениеИспользованиеВремени[сч]) Тогда
								НоваяСтрока.ПодразделениеИспользованиеВремени = МассивПодразделениеИспользованиеВремени[сч];
							КонецЕсли;
							
							Для Каждого СуммовойПоказатель Из КолонкиДляСуммирования Цикл
								Если СуммовойПоказатель.Значение = Неопределено Тогда
									Продолжить;
								КонецЕсли;
								НоваяСтрока[СуммовойПоказатель.Ключ] = СуммовойПоказатель.Значение[сч];
							КонецЦикла;
							
						КонецЦикла;
						
						сч = Найдено.Количество() - 1;
						Пока сч >= 0 Цикл
							НачисленнаяЗарплатаИВзносыПоФизлицам.Удалить(Найдено[сч]);
							сч = сч - 1;
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НачисленнаяЗарплатаИВзносыПоФизлицам;
	
КонецФункции

Функция ПолучитьТаблицаКоэфНачисленияERP_ЗУП(Выборка, НачисленнаяЗарплатаИВзносыПоФизлицам)
	
	ИмяКолонкиНачисления = упоРаспределениеЗарплатыНастройкиСервер.ИмяКолонкиНачисленияСоответствияВДокументе();
	МассивСуммовыеПоказатели = МассивСуммовыеПоказатели();
	КолонкиДляСуммированияСтрокой = СтрСоединить(МассивСуммовыеПоказатели, ",");
	КолонкиДляСуммирования = Новый Структура(КолонкиДляСуммированияСтрокой);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить(ИмяКолонкиНачисления);
	
	Для Каждого ИмяКолонки Из МассивСуммовыеПоказатели Цикл
		Таблица.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		
		ПараметрыОтбора = Новый Структура("ФизическоеЛицо, Начисление, ДатаНачала");
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка);
		ПараметрыОтбора.Вставить(ИмяКолонкиНачисления, Выборка.НачислениеERP_ЗУП);
		
		Найдено = НачисленнаяЗарплатаИВзносыПоФизлицам.НайтиСтроки(ПараметрыОтбора);
		
		Если Найдено.Количество() Тогда
			Для Каждого СтрокаНайдено Из Найдено Цикл
				НоваяСтрока = Таблица.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНайдено);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Таблица.Свернуть(ИмяКолонкиНачисления, КолонкиДляСуммированияСтрокой);
	Выборка.Сбросить();
	
	Для Каждого ИмяКолонки Из МассивСуммовыеПоказатели Цикл
		Таблица.Колонки.Добавить("Коэф" + ИмяКолонки);
		РаспределяемаяСумма = Таблица.Итог(ИмяКолонки);
		МассивКоэффициенты = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(1, Таблица.ВыгрузитьКолонку(ИмяКолонки), 4);
		
		Если НЕ МассивКоэффициенты = Неопределено Тогда
			Таблица.ЗагрузитьКолонку(МассивКоэффициенты, "Коэф" + ИмяКолонки);
		Иначе
			Таблица.ЗаполнитьЗначения(0, "Коэф" + ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция МассивСуммовыеПоказатели()
	
	МассивКолонок = Новый Массив;
	
	МассивКолонок.Добавить("ПФРДоПредельнойВеличины");
	МассивКолонок.Добавить("ПФРЗаЗанятыхНаПодземныхИВредныхРаботах");
	МассивКолонок.Добавить("ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки");
	МассивКолонок.Добавить("ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка");
	МассивКолонок.Добавить("ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах");
	МассивКолонок.Добавить("ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки");
	МассивКолонок.Добавить("ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка");
	МассивКолонок.Добавить("ПФРНаДоплатуЛетчикам");
	МассивКолонок.Добавить("ПФРНаДоплатуШахтерам");
	МассивКолонок.Добавить("ПФРНакопительная");
	МассивКолонок.Добавить("ПФРПоСуммарномуТарифу");
	МассивКолонок.Добавить("ПФРСПревышения");
	МассивКолонок.Добавить("ПФРСтраховая");
	МассивКолонок.Добавить("Сумма");
	МассивКолонок.Добавить("ТФОМС");
	МассивКолонок.Добавить("ФСС");
	МассивКолонок.Добавить("ФССНесчастныеСлучаи");
	МассивКолонок.Добавить("ФФОМС");
	МассивКолонок.Добавить("ВзносыПоЕдиномуТарифу");
	
	Возврат МассивКолонок;
	
КонецФункции

Функция ТаблицаСвязиЗадачПоПризнакуАктируемости(МассивПроекты)
	
	Т_Результат = Новый ТаблицаЗначений;
	
	Т_Результат.Колонки.Добавить("Родитель", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	Т_Результат.Колонки.Добавить("Потомок", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("ОтражатьНеактируемыеТрудозатраты") Тогда
		Возврат Т_Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", МассивПроекты);
	
	Запрос.Текст = ТекстЗапросаИерархияЗадач();

	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Т_Результат;
	КонецЕсли;
	
	Таблица = РезультатЗапроса.Выгрузить();
	Т_Актируемые = Таблица.СкопироватьКолонки();
	
	КолвоЭлементов = Таблица.Количество() - 1;
	Соответствие = Новый Соответствие;
	
	Для сч = 0 По КолвоЭлементов Цикл
		
		СтрокаТаблицы = Таблица[сч];
		
		Если СтрокаТаблицы.ЭтоАктируемаяЗадача Тогда
			НоваяСтрока = Т_Актируемые.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Родитель) Тогда
			Продолжить;
		КонецЕсли;
		
		ДочерниеЭлементы = Соответствие.Получить(СтрокаТаблицы.Родитель);
		Если ДочерниеЭлементы = Неопределено Тогда
			Соответствие.Вставить(СтрокаТаблицы.Родитель, Новый Массив);
			ДочерниеЭлементы = Соответствие.Получить(СтрокаТаблицы.Родитель);
		КонецЕсли;
		
		ДочерниеЭлементы.Добавить(СтрокаТаблицы);
		
	КонецЦикла;
	
	ПолучитьНеактируемыеЭтапыПроектаВГлубинуДерева(Т_Актируемые, Т_Результат, Соответствие);
	
	Возврат Т_Результат;
	
КонецФункции

Функция ТекстЗапросаИерархияЗадач()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   Проекты.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
    |   Проекты.КодСДР КАК КодСДР,
    |   Проекты.Ссылка КАК СсылкаНаЗеркальныйПроект,
    |   Проекты.упоКорневойПроект КАК КорневойПроект
    |ПОМЕСТИТЬ ВТ_ДопСвойстваПЗ
    |ИЗ
    |   Справочник.Проекты КАК Проекты
    |ГДЕ
    |   Проекты.Ссылка В ИЕРАРХИИ(&Проект)
    |   И Проекты.ЭтоПроектнаяЗадача
    |
    |ИНДЕКСИРОВАТЬ ПО
    |   ПроектнаяЗадача
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   упоВерсииПроекта.Проект КАК Проект,
    |   упоВерсииПроекта.Версия КАК Версия
    |ПОМЕСТИТЬ ВТ_ТекущиеВерсииПроектов
    |ИЗ
    |   РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
    |ГДЕ
    |   упоВерсииПроекта.Проект В(&Проект)
    |   И упоВерсииПроекта.Текущая
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
    |   ПроектныеЗадачи.Версия КАК Версия,
    |   ПроектныеЗадачи.ЗадачаРодитель КАК Родитель,
    |   ПроектныеЗадачи.ПроектнаяЗадача КАК ЗадачаСсылка,
    |   ПроектныеЗадачи.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача,
    |   ПроектныеЗадачи.НазваниеЗадачи КАК НазваниеЗадачи,
    |   ПроектныеЗадачи.ДлительностьМоделиПакетаРабот КАК Длительность,
    |   ПроектныеЗадачи.ЭтоПакетРабот КАК ЭтоПакетРабот,
    |   ПроектныеЗадачи.ЭтоВеха КАК ЭтоВеха,
    |   ПроектныеЗадачи.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот
    |ПОМЕСТИТЬ ВТ_СвойстваПЗ
    |ИЗ
    |   РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
    |           ,
    |           Версия В
    |               (ВЫБРАТЬ
    |                   ВТ_ТекущиеВерсииПроектов.Версия КАК Версия
    |               ИЗ
    |                   ВТ_ТекущиеВерсииПроектов КАК ВТ_ТекущиеВерсииПроектов)) КАК ПроектныеЗадачи
    |ГДЕ
    |   НЕ ПроектныеЗадачи.ЗадачаОтменена
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВТ_ДопСвойстваПЗ.КорневойПроект КАК КорневойПроект,
    |   ВТ_ДопСвойстваПЗ.КодСДР КАК КодСДР,
    |   ВТ_ДопСвойстваПЗ.СсылкаНаЗеркальныйПроект КАК СсылкаНаЗеркальныйПроект,
    |   ВТ_СвойстваПЗ.Родитель КАК Родитель,
    |   ВТ_СвойстваПЗ.ЗадачаСсылка КАК ЗадачаСсылка,
    |   ВТ_СвойстваПЗ.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача,
    |   ВТ_СвойстваПЗ.НазваниеЗадачи КАК НазваниеЗадачи,
    |   ВТ_СвойстваПЗ.Длительность КАК Длительность,
    |   ВТ_СвойстваПЗ.ЭтоПакетРабот КАК ЭтоПакетРабот,
    |   ВТ_СвойстваПЗ.ЭтоВеха КАК ЭтоВеха,
    |   ВТ_СвойстваПЗ.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот
    |ИЗ
    |   ВТ_СвойстваПЗ КАК ВТ_СвойстваПЗ
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДопСвойстваПЗ КАК ВТ_ДопСвойстваПЗ
    |       ПО ВТ_СвойстваПЗ.ЗадачаСсылка = ВТ_ДопСвойстваПЗ.ПроектнаяЗадача
    |
    |УПОРЯДОЧИТЬ ПО
    |   КодСДР";
    
    Возврат ТекстЗапроса;
    
КонецФункции

Процедура ПолучитьНеактируемыеЭтапыПроектаВГлубинуДерева(Дерево, Т_Результат, Соответствие)
	
	Для Каждого СтрокаТаблицы Из Дерево Цикл
		
		Если НЕ СтрокаТаблицы.ЭтоАктируемаяЗадача Тогда
			Продолжить;
		КонецЕсли;
		
		АктируемаяЗадача = СтрокаТаблицы.СсылкаНаЗеркальныйПроект;
		ПолучитьНеактированныеДочерниеЭлементыВГлубину(АктируемаяЗадача, СтрокаТаблицы, Т_Результат, Соответствие);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьНеактированныеДочерниеЭлементыВГлубину(АктируемаяЗадача, СтрокаТаблицы, Т_Результат, Соответствие)
	
	ДочерниеЭлементы = Соответствие.Получить(СтрокаТаблицы.ЗадачаСсылка);
	
	Если ДочерниеЭлементы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПотомок Из ДочерниеЭлементы Цикл
		
		Если НЕ СтрокаПотомок.ЭтоАктируемаяЗадача Тогда
			
			НоваяСтрока = Т_Результат.Добавить();
			НоваяСтрока.Родитель = АктируемаяЗадача;
			НоваяСтрока.Потомок = СтрокаПотомок.СсылкаНаЗеркальныйПроект;
			
			ПолучитьНеактированныеДочерниеЭлементыВГлубину(АктируемаяЗадача, СтрокаПотомок, Т_Результат, Соответствие);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТаблицаСхемаОтраженияНачисленийPM_ERP(ПараметрыВыполнения)
	
