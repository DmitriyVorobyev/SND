
#Область ПрограммныйИнтерфейс

#Область ОбработчикиФормы

// Обработка заполнения объекта Проект.
//
// Параметры:
//  Объект				 - СправочникОбъект.Проекты
//  ДанныеЗаполнения	 - Структура
//  ТекстЗаполнения		 - Строка
//  СтандартнаяОбработка - Булево
//
Процедура ОбъектОбработкаЗаполнения(Объект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.Проекты") Тогда
		
		Объект.упоСтатьяРасходовРаспределенияЗарплаты = упоРаспределениеЗарплатыНастройкиСервер.ПолучитьЗначениеСтатьиРасходаРаспределения();
		
		Если НЕ ЗначениеЗаполнено(Объект.упоСтатьяРасходовРаспределенияЗарплаты) Тогда
			ТекстСообщения = НСтр("ru = 'В параметрах подсистемы РМ, раздел ""Модуль распределения ЗП"", не установлена статья расходов по зарплате.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Если упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("РежимУчетаВзносов") = 1 Тогда
			Объект.упоРежимУчетаВзносов = 1;
			Объект.упоСтатьяРасходовВзносов = упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("СтатьяРасходовВзносов");
		Иначе
			Объект.упоРежимУчетаВзносов = 0;
			Объект.упоСтатьяРасходовВзносов = ПредопределенноеЗначение("ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область ОтражениеЗарплатыВБухУчете

Процедура ДанныеДляОтраженияЗарплатыВБухучете(ДанныеДляОтражения, ПериодРегистрации, РежимЗагрузки, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("НачалоПериода", НачалоМесяца(ПериодРегистрации));
	ПараметрыВыполнения.Вставить("КонецПериода", КонецМесяца(ПериодРегистрации));
	ПараметрыВыполнения.Вставить("ИспользоватьСогласованныеЧасы", 
		упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("ИспользоватьСогласованныеЧасы"));
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		ДополнительныеПараметры.Вставить("НачисленнаяЗарплатаИВзносыБезРаспредения", 
			ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы.Скопировать());
	КонецЕсли;
	
	ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы = РазбитьПоПЗ(ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы, 
		ПараметрыВыполнения, РежимЗагрузки, ДополнительныеПараметры);
	
КонецПроцедуры

Функция ПолучитьДанныеДляОтраженияЗарплатыВБухучете(Организация, ПериодРегистрации, ДополнительныеПараметры = Неопределено) Экспорт
	
	МодульОтражениеЗарплатыВБухучете = ОбщегоНазначения.ОбщийМодуль("ОтражениеЗарплатыВБухучете");
	МодульЗарплатаКадры = ОбщегоНазначения.ОбщийМодуль("ЗарплатаКадры");
	
	ДанныеДляОтражения = МодульОтражениеЗарплатыВБухучете.НоваяСтруктураДанныеДляОтраженияЗарплатыВБухучете();
	
	Если МодульЗарплатаКадры.ИспользоватьСтатьиФинансированияЗарплата() Тогда
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		МодульОтражениеЗарплатыВБухучетеРасширенный = ОбщегоНазначения.ОбщийМодуль("ОтражениеЗарплатыВБухучетеРасширенный");
		
		МодульОтражениеЗарплатыВБухучетеРасширенный.СведенияОБухучетеНачисленийИВзносовПоСтатьямФинансирования(Организация, ПериодРегистрации, МенеджерВременныхТаблиц);
		
		ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы = МодульОтражениеЗарплатыВБухучете.ТаблицаНачисленийИВзносовДляБухучета(МенеджерВременныхТаблиц);
		
	Иначе
		
		МодульОтражениеЗарплатыВУчете = ОбщегоНазначения.ОбщийМодуль("ОтражениеЗарплатыВУчете");
		
		ТаблицаНачислений = МодульОтражениеЗарплатыВУчете.ДанныеДляОтражениеВУчетеНачислений(Организация, ПериодРегистрации);
		ТаблицаВзносов = МодульОтражениеЗарплатыВУчете.ДанныеДляОтражениеВУчетеВзносов(Организация, ПериодРегистрации);
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		МодульОтражениеЗарплатыВБухучете.ДанныеНачисленийИВзносов(Организация, ПериодРегистрации, МенеджерВременныхТаблиц, ТаблицаНачислений, ТаблицаВзносов);
		ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы = МодульОтражениеЗарплатыВБухучете.ТаблицаНачисленийИВзносовДляБухучета(МенеджерВременныхТаблиц);
		
	КонецЕсли;
	
	ДанныеДляОтраженияЗарплатыВБухучете(ДанныеДляОтражения, ПериодРегистрации, ДополнительныеПараметры);
	
	Возврат ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы;
	
КонецФункции

Процедура ЗаполнитьТаблицуНачисленнаяЗарплатаИВзносы(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	Организация = Объект.Организация;
	ПериодРегистрации = Объект.ПериодРегистрации;
	ДокументСсылка = Объект.Ссылка;
	
	СписокТаблиц = Новый СписокЗначений;
	СписокТаблиц.Добавить("НачисленнаяЗарплатаИВзносы");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДокументСсылка", ДокументСсылка);
	СтруктураПараметров.Вставить("Организация", Организация);
	СтруктураПараметров.Вставить("ПериодРегистрации", ПериодРегистрации);
	СтруктураПараметров.Вставить("СписокТаблиц", СписокТаблиц);
	СтруктураПараметров.Вставить("СтрокаСписокТаблиц", "НачисленнаяЗарплатаИВзносы");
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, Форма.УникальныйИдентификатор);
	
	Парам = Новый Структура;
	
	ИмяТаблицыИсточник = "НачисленнаяЗарплатаИВзносыПоФизлицам";
	ВыгружаемыеКолоноки = МассивВыгружаемыхКолонок();
	ТаблицаИсточник = Объект[ИмяТаблицыИсточник].Выгрузить( , СтрСоединить(ВыгружаемыеКолоноки, ","));
	
	ТаблицаИсточник.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаИсточник.Колонки.Добавить("ДатаНачала", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаИсточник.Колонки.Добавить("ПериодПринятияРасходов", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаИсточник.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.ПодразделенияОрганизаций"));
	ТаблицаИсточник.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("СправочникСсылка.СтатьиРасходовЗарплата"));
	ТаблицаИсточник.Колонки.Добавить("СтатьяФинансирования",
		Новый ОписаниеТипов("СправочникСсылка.СтатьиФинансированияЗарплата"));
	
	ТаблицаИсточник.Колонки["ПодразделениеПредприятия"].Имя = "ПодразделениеУчетаЗатрат";
	
	ДанныеДляОтражения = Новый Структура;
	ДанныеДляОтражения.Вставить("НачисленнаяЗарплатаИВзносы", ТаблицаИсточник);
	
	ДополнительныеПараметры = Новый Структура("РежимЗагрузки", 1);
	упоРаспределениеЗарплатыСервер.ДанныеДляОтраженияЗарплатыВБухучете(ДанныеДляОтражения, ПериодРегистрации, 1,
		ДополнительныеПараметры);
		
	Если ДанныеДляОтражения.НачисленнаяЗарплатаИВзносы = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	СвернутьДанныеДляОтраженияЗарплатыВБухучете(ДанныеДляОтражения);
	ЗаполнитьПодразделениеВТаблице(ДанныеДляОтражения, СтруктураПараметров, АдресХранилища);
	ЗаполнениеПослеВыполненияДлительнойОперации(Объект, СписокТаблиц, ДанныеДляОтражения, АдресХранилища);
	
КонецПроцедуры

Процедура ДобавитьТаблицаСхемаОтраженияНачисленийPM_ERPВДопСвойства(Организация, ПериодРегистрации, ДополнительныеСвойства, Отказ) Экспорт
	
	Если Отказ
		ИЛИ НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	ДопПарам = Новый Структура;
	ТаблицаСхемаОтраженияНачисленийPM_ERP = ПолучитьДанныеДляОтраженияЗарплатыВБухучете(Организация, ПериодРегистрации, ДопПарам);
	
	ТаблицаСхемаОтраженияНачисленийPM_ERP.Колонки.Добавить("ДокументОтражения");
	ТаблицаСхемаОтраженияНачисленийPM_ERP.Колонки.Добавить("ПериодРегистрации");
	ТаблицаСхемаОтраженияНачисленийPM_ERP.Колонки.Добавить("Номер");
	
	Номер = 0;
	Для Каждого Строка Из ТаблицаСхемаОтраженияНачисленийPM_ERP Цикл
		Номер = Номер + 1;
		Строка.ПериодРегистрации = ПериодРегистрации;
		Строка.Номер = Номер;
	КонецЦикла;
	
	ДополнительныеСвойства.Вставить("ТаблицаСхемаОтраженияНачисленийPM_ERP", ТаблицаСхемаОтраженияНачисленийPM_ERP);
	
	Если НЕ ДопПарам = Неопределено И ДопПарам.Свойство("НачисленнаяЗарплатаИВзносыБезРаспредения") Тогда
		ДополнительныеСвойства.Вставить("НачисленнаяЗарплатаИВзносыБезРаспредения", ДопПарам.НачисленнаяЗарплатаИВзносыБезРаспредения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьДвижения_упоСхемаОтраженияНачисленийPM_ERP(Ссылка, ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	Таблица = Неопределено;
	
	ПараметрыВыполнения = Новый Структура("Ссылка, ПериодРегистрации", Ссылка, Ссылка.ПериодРегистрации);
	Таблица = ПолучитьТаблицаСхемаОтраженияНачисленийPM_ERP(ПараметрыВыполнения);
	
	Если Отказ ИЛИ Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = Движения.упоСхемаОтраженияНачисленийPM_ERP;
	НаборЗаписей.Записывать = Истина;
	НаборЗаписей.Загрузить(Таблица);
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		Отказ = Истина;
		
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'РаспределениеЗарплаты'"), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ОтражениеЗарплатыВФинансовомУчете, Ссылка, ПредставлениеОшибки);
		
		ТекстСообщения = НСтр("ru = 'Не удалось записать схему отражения начислений. См. Журнал регистрации.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтразитьДвижения_упоНачисленияЗарплатаИВзносы(Ссылка, ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	Если упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("УчетВоВнешнейСистеме") Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Таблица = Неопределено;
	
	Если НЕ ДополнительныеСвойства.Свойство("НачисленнаяЗарплатаИВзносыБезРаспредения", Таблица) Тогда
		Таблица = Новый ТаблицаЗначений;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.упоНачисленияЗарплатаИВзносы.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПериодРегистрации.Установить(Ссылка.ПериодРегистрации);
	
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Если Таблица.Количество() Тогда
		
		Таблица.Колонки.Добавить("ПериодРегистрации");
		Таблица.Колонки.Добавить("Номер");
		
		Таблица.ЗаполнитьЗначения(Ссылка.ПериодРегистрации, "ПериодРегистрации");
		
		сч = 1;
		Для Каждого Строка Из Таблица Цикл
			Строка["Номер"] = сч;
			сч = сч + 1;
		КонецЦикла;
		
		НаборЗаписей.Загрузить(Таблица);
		
	КонецЕсли;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		Отказ = Истина;
		
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'РаспределениеЗарплаты'"), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ОтражениеЗарплатыВФинансовомУчете, Ссылка, ПредставлениеОшибки);
		
		ТекстСообщения = НСтр("ru = 'Не удалось записать начисления зарплаты. См. Журнал регистрации.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьОтчетНаФорму_ОтражениеЗарплатыВФинансовомУчете(Форма) Экспорт
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	
	ИмяПодменюОтчеты = "ПодменюОтчетыСмТакже";
	ЭлементПодменюОтчеты = Элементы.Найти(ИмяПодменюОтчеты);
	
	Если ЭлементПодменюОтчеты <> Неопределено Тогда
		
		МетаОтчет = Метаданные.Отчеты.упоСхемаОтраженияЗарплатыERP_PM;
		
		ИмяКоманды = "ОткрытьОтчет_" + МетаОтчет.Имя;
		
		НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "Подключаемый_" + ИмяКоманды;
		НоваяКоманда.Заголовок = МетаОтчет.Синоним;
		
		НовыйЭлемент = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементПодменюОтчеты);
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		
		ИмяКоманды = "ОткрытьОтчет_" + "упоНачисленияИВзносыВнешние";
		
		НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = "Подключаемый_" + ИмяКоманды;
		НоваяКоманда.Заголовок = "Начисления и взносы из внешней системы";
		
		НовыйЭлемент = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементПодменюОтчеты);
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКомандыНаФорму_ОтражениеЗарплатыВФинансовомУчете(Форма) Экспорт
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	упоИнтеграцияКлиентСервер.ИспользуетсяФункционалЗаказыПоставщикам();
	
	Элементы = Форма.Элементы;
	
	ЭлементПодменюНачисленнаяЗарплатаИВзносы = Элементы.Найти("НачисленнаяЗарплатаИВзносыЗаполнить");
	Если ЭлементПодменюНачисленнаяЗарплатаИВзносы <> Неопределено Тогда
		
		Если Форма.ИмяФормы =
			"Документ.ОтражениеЗарплатыВФинансовомУчете.Форма.ФормаДокумента" Тогда
			
			ИмяКоманды = "упоРаспределитьПоТрудозатратамPM";
			Синоним = "Распределить по трудозатратам PM";
			
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = "Подключаемый_" + ИмяКоманды;
			НоваяКоманда.Заголовок = Синоним;
			НоваяКоманда.ИзменяетСохраняемыеДанные = Истина;
			
			НовыйЭлемент = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементПодменюНачисленнаяЗарплатаИВзносы);
			НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			НовыйЭлемент.ИмяКоманды = ИмяКоманды;
			
			ЭлементПодменю = Элементы.Найти("ФормаГлобальныеКоманды");
			ЭлементВставка = Элементы.Найти("ФормаОбщаяКомандаДополнительныеСведенияКоманднаяПанель");
			Если ЭлементПодменю <> Неопределено И ЭлементВставка <> Неопределено Тогда
				ИмяКоманды = "упоЗагрузитьExcelНачисленнаяЗарплата";
				Синоним = "Загрузить из Excel";
				
				НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
				НоваяКоманда.Действие = "Подключаемый_" + ИмяКоманды;
				НоваяКоманда.Заголовок = Синоним;
				
				НовыйЭлемент = Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементПодменю, ЭлементВставка);
				НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
				НовыйЭлемент.ИмяКоманды = ИмяКоманды;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Форма.ИмяФормы =
			"Документ.ОтражениеЗарплатыВФинансовомУчете.Форма.ФормаСпискаФизическихЛиц" Тогда
			
			ИмяКоманды = "упоЗаполнитьНачисленияPM";
			Синоним = "Заполнить начисления PM";
			
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = "Подключаемый_" + ИмяКоманды;
			НоваяКоманда.Заголовок = Синоним;
			НоваяКоманда.ИзменяетСохраняемыеДанные = Истина;
			
			НовыйЭлемент = Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ЭлементПодменюНачисленнаяЗарплатаИВзносы);
			НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
			НовыйЭлемент.ИмяКоманды = ИмяКоманды;
			
			ИмяКоманды = "упоНастроитьСоответствияНачисленийPM";
			НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = "Подключаемый_" + ИмяКоманды;
			НоваяКоманда.Заголовок = НСтр("ru = 'Настроить соответствия начислений'");
			НоваяКоманда.Отображение = ОтображениеКнопки.КартинкаИТекст;
			НоваяКоманда.Картинка = БиблиотекаКартинок.ПереключитьАктивность;
			НоваяКоманда.ИзменяетСохраняемыеДанные = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

Процедура ЗаполнитьВидОперацииСтрокиТабеля(СтрокаТабеля) Экспорт
	
	Если НЕ упоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему() Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(СтрокаТабеля.Задача);
	
	ЭтоЗаданиеПЗ =
		ТипЗначения = Тип("СправочникСсылка.упоЗадания") И ЗначениеЗаполнено(СтрокаТабеля.ПроектнаяЗадача);
	ЭтоПЗ =
		ТипЗначения = Тип("ДокументСсылка.упоПроектнаяЗадача") И ЗначениеЗаполнено(СтрокаТабеля.ПроектнаяЗадача);
	
	Если НЕ ЗначениеЗаполнено(СтрокаТабеля.Задача) Тогда
		Если НЕ ЗначениеЗаполнено(СтрокаТабеля.ПроектнаяЗадача) Тогда
			Возврат;
		КонецЕсли;
		
		ЭтоПЗ = Истина;
	КонецЕсли;
	
	Если ЭтоПЗ ИЛИ ЭтоЗаданиеПЗ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации КАК ВидОперации
		               |ИЗ
		               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		               |			,
		               |			ПроектнаяЗадача = &Ссылка
		               |				И Версия = &ТекущаяВерсияПроекта) КАК упоСвойстваПроектныхЗадачСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проект = Проекты.Ссылка
		               |ГДЕ
		               |	НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
		               |	И Проекты.Компонент = ЗНАЧЕНИЕ(Перечисление.упоКомпоненты.ОбщефирменнаяДеятельность)";
		
		ТекущаяВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(СтрокаТабеля.ПроектнаяЗадача);
		
		Запрос.УстановитьПараметр("Ссылка", СтрокаТабеля.ПроектнаяЗадача);
		Запрос.УстановитьПараметр("ТекущаяВерсияПроекта", ТекущаяВерсияПроекта);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			СтрокаТабеля.ВидОперации =
				?(ЗначениеЗаполнено(Выборка.ВидОперации),
					Выборка.ВидОперации,
					Справочники.упоВидыОпераций.Явка);
		Иначе
			СтрокаТабеля.ВидОперации = Справочники.упоВидыОпераций.Явка;
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.упоВнепроектныеЗадачи") Тогда
		
		СтрокаТабеля.ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТабеля.Задача, "ВидОперации");
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.упоПричиныПотерьРабочегоВремени") Тогда
		
		СтрокаТабеля.ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТабеля.Задача, "ВидОперации");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСвойствоЭтоНовый(Объект, ДополнительныеСвойства) Экспорт
	
	Если НЕ ДополнительныеСвойства.Свойство("ЭтоНовый") Тогда
		ДополнительныеСвойства.Вставить("ЭтоНовый", Объект.ЭтоНовый());
	КонецЕсли;
	
КонецПроцедуры

Процедура ПереместитьПроектВАрхив(ПроектныйЭлемент, ДополнительныеСвойства, Отказ) Экспорт
	
	ЭтоНовый = Ложь;
	Если НЕ ДополнительныеСвойства.Свойство("ЭтоНовый", ЭтоНовый) Тогда
		ЭтоНовый = Ложь;
	КонецЕсли;
	
	Если Отказ ИЛИ НЕ ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаАрхивНаправленийДеятельности = упоРаспределениеЗарплатыНастройкиСервер.ПолучитьЗначениеГруппаАрхив();
	
	Если НЕ ЗначениеЗаполнено(ГруппаАрхивНаправленийДеятельности) Тогда
		Возврат;
	КонецЕсли;
	
	Результат =
		ОбщегоНазначения
		.ЗначенияРеквизитовОбъекта(ПроектныйЭлемент, "ЭтоПроектнаяЗадача, Родитель, ЭтоАктируемаяЗадача, СсылкаНаПроектнуюЗадачу");
	
	ПроектныйЭлементРодитель = Результат.Родитель;
	ЭтоПроектнаяЗадача = Результат.ЭтоПроектнаяЗадача;
	ЭтоАктируемаяЗадача = Результат.ЭтоАктируемаяЗадача;
	СсылкаНаПроектнуюЗадачу = Результат.СсылкаНаПроектнуюЗадачу;
	
	СтруктураСвязи = упоСвязьПроектаСНаправлениемДеятельности.ПолучитьНаправлениеДеятельностиПоЭлементу(ПроектныйЭлемент);
	СвязанноеНД_Элемент_Ссылка = СтруктураСвязи.НаправлениеДеятельностиЭлемент;
	СвязанноеНД_Группа_Ссылка = СтруктураСвязи.НаправлениеДеятельностиГруппа;
	
	Если Не ЗначениеЗаполнено(СвязанноеНД_Группа_Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	НужноОбновитьСвязь = Ложь;
	
	Если СвязанноеНД_Группа_Ссылка.Родитель <> ГруппаАрхивНаправленийДеятельности Тогда
		НужноОбновитьСвязь = Истина;
		
		Попытка
			СвязанноеНД_Группа_Объект = СвязанноеНД_Группа_Ссылка.ПолучитьОбъект();
			СвязанноеНД_Группа_Объект.Родитель = ГруппаАрхивНаправленийДеятельности;
			СвязанноеНД_Группа_Объект.Записать();
		Исключение
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					Строка(ПроектныйЭлемент),
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ПроектныйЭлемент, , , Отказ);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	Если НужноОбновитьСвязь Тогда
		
		НаборЗаписей = РегистрыСведений.упоСвязьПроектаСНаправлениемДеятельности.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПроектныйЭлемент.Установить(ПроектныйЭлемент);
		Запись = НаборЗаписей.Добавить();
		Запись.ПроектныйЭлемент = ПроектныйЭлемент;
		Запись.НаправлениеДеятельностиЭлемент = СвязанноеНД_Элемент_Ссылка;
		Запись.НаправлениеДеятельностиГруппа = СвязанноеНД_Группа_Ссылка;
		Запись.ПроектныйЭлементПроектнаяЗадача = СсылкаНаПроектнуюЗадачу;
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазбитьПоПЗ(ТаблицаИсточник, ПараметрыВыполнения, РежимЗагрузки, ДополнительныеПараметры = Неопределено)
	
	// Режим загрузки:
	// - 0: на основе данных, полученных типовым механизмом ERP при помощи функции "ОтражениеЗарплатыВБухучетеРасширенный.ДанныеДляОтраженияЗарплатыВБухучете".
	// - 1: на основе таблицы документа.
	
	Таблица = ТаблицаИсточник.Скопировать();
	
	Таблица.Колонки.Добавить("Начисление", Новый ОписаниеТипов("СправочникСсылка.упоНачисленияPM"));
	Таблица.Колонки.Добавить("НачислениеСоответствие");
	Таблица.Колонки.Добавить("КоэффициентРаспределения", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(7, 6)));
	Таблица.Колонки.Добавить("Часы", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	Таблица.Колонки.Добавить("ЧасыВсего", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	Таблица.Колонки.Добавить("ИД", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(10)));
	Таблица.Колонки.Добавить("ПодразделениеИспользованиеВремени", Новый ОписаниеТипов("СправочникСсылка.упоПодразделения"));
	
	Для Каждого Строка Из Таблица Цикл
		Строка["Начисление"] = ?(ЗначениеЗаполнено(Строка["упоНачислениеPM"]), Строка["упоНачислениеPM"], Строка["Начисление"]);
	КонецЦикла;
	
	КолонкиГруппировок = Новый Массив;
	КолонкиСуммирования = Новый Массив;
	
	ТичЧисло = Тип("Число");
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Колонка.ТипЗначения.СодержитТип(ТичЧисло) Тогда
			КолонкиСуммирования.Добавить(Колонка.Имя);
		Иначе
			КолонкиГруппировок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	СтрокаКолонкиГруппировок = СтрСоединить(КолонкиГруппировок, ",");
	СтрокаКолонкиСуммирования = СтрСоединить(КолонкиСуммирования, ",");
	
	Таблица.Свернуть(СтрокаКолонкиГруппировок, СтрокаКолонкиСуммирования);
	
	Таблица = ПолучитьРезультатЗапроса(Таблица, ПараметрыВыполнения, КолонкиГруппировок, КолонкиСуммирования);
	
	Если Таблица <> Неопределено Тогда	
		Таблица.Свернуть(СтрокаКолонкиГруппировок, СтрокаКолонкиСуммирования);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьРезультатЗапроса(ИсходнаяТаблица, ПараметрыЗапроса, КолонкиГруппировок, КолонкиСуммирования)
	
	ИмяКолонкиНачисление = упоРаспределениеЗарплатыНастройкиСервер.ИмяКолонкиНачисленияСоответствияВДокументе();
	
	ТекстГруппировки = "";
	ТекстСуммирования = "";
	ИмяТаблицы = "Т";
	
	КолвоГруппировок = КолонкиГруппировок.Количество() - 1;
	Для сч = 0 По КолвоГруппировок Цикл
		Эл = КолонкиГруппировок[сч];
		Поле = ИмяТаблицы + "." + Эл + " КАК " + Эл + ?(сч = КолвоГруппировок, "", ",");
		ТекстГруппировки = ТекстГруппировки + Поле;
	КонецЦикла;
	
	КолвоСуммирования = КолонкиСуммирования.Количество() - 1;
	Для сч = 0 По КолвоСуммирования Цикл
		Эл = КолонкиСуммирования[сч];
		Поле = ИмяТаблицы + "." + Эл + " КАК " + Эл + ?(сч = КолвоСуммирования, "", ",");
		ТекстСуммирования = ТекстСуммирования + Поле;
	КонецЦикла;
	
	ТекстПолей = ТекстГруппировки + ?(КолонкиСуммирования.Количество(), ",", "") + ТекстСуммирования;
	
	Запрос = Новый Запрос;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Для Каждого Эл Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Эл.Ключ, Эл.Значение);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапросаВТ_ВсеРабочееВремя(Новый Структура("ИспользоватьСогласованныеЧасы", ПараметрыЗапроса.ИспользоватьСогласованныеЧасы));
	Запрос.Выполнить();
	
	МассивПроекты = ПолучитьПроектыПериодНачислений(Запрос);
	Т_ГруппировкаЗадач = ТаблицаСвязиЗадачПоПризнакуАктируемости(МассивПроекты);
	Т_ГруппировкаЗадач.Свернуть("Потомок, Родитель");
	
	Запрос.УстановитьПараметр("Т", ИсходнаяТаблица);
	Запрос.УстановитьПараметр("Т_ГруппировкаЗадач", Т_ГруппировкаЗадач);
	
	Запрос.Текст = "ВЫБРАТЬ
		|    Т_ГруппировкаЗадач.Родитель КАК Родитель,
		|    Т_ГруппировкаЗадач.Потомок КАК Потомок
		|ПОМЕСТИТЬ Т_ГруппировкаЗадач
		|ИЗ
		|    &Т_ГруппировкаЗадач КАК Т_ГруппировкаЗадач
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВсеРабочееВремя.ПериодНачислений КАК ПериодНачислений,
		|    ВсеРабочееВремя.ФизическоеЛицо КАК ФизическоеЛицо,
		|    ВсеРабочееВремя.ВидОперацииПМ КАК ВидОперацииПМ,
		|    ЕСТЬNULL(Т_ГруппировкаЗадач.Родитель, ВсеРабочееВремя.ЗадачаПричина) КАК ЗадачаПричина,
		|    ВсеРабочееВремя.Начисление КАК Начисление,
		|    ВсеРабочееВремя.СпособОтраженияЗарплатыВБухучете КАК СпособОтраженияЗарплатыВБухучете,
		|    ВсеРабочееВремя.Часы КАК Часы,
		|    ВсеРабочееВремя.Проект КАК Проект,     
		|	 ВсеРабочееВремя.Подразделение КАК Подразделение 
		|ПОМЕСТИТЬ ВсеРабочееВремяСгруппированная
		|ИЗ
		|    ВсеРабочееВремя КАК ВсеРабочееВремя
		|        ЛЕВОЕ СОЕДИНЕНИЕ Т_ГруппировкаЗадач КАК Т_ГруппировкаЗадач
		|        ПО ВсеРабочееВремя.ЗадачаПричина = Т_ГруппировкаЗадач.Потомок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВсеРабочееВремяСгруппированная.ПериодНачислений КАК ПериодНачислений,
		|    ВсеРабочееВремяСгруппированная.ФизическоеЛицо КАК ФизическоеЛицо,
		|    ВсеРабочееВремяСгруппированная.ВидОперацииПМ КАК ВидОперацииПМ,
		|    ВсеРабочееВремяСгруппированная.ЗадачаПричина КАК ЗадачаПричина,
		|    ВсеРабочееВремяСгруппированная.Начисление КАК Начисление,
