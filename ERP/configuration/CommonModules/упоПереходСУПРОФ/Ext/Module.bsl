		СоответствиеПолей.Вставить("ВычисляемоеВыражение", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ДополнительныйРеквизитДОID", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ДополнительныйРеквизитДОТип", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("ПВХ_ДополнительныеРеквизитыИСведения_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ДополнительныйРеквизитИС", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Ложь, Истина, Ложь, Ложь);
		СоответствиеПолей.Вставить("ЗначениеРеквизитаИС", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ИмяРеквизитаОбъектаДО", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ИмяРеквизитаОбъектаИС", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Ключевой", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Обновлять", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Перечисление_РежимИзмПровДокДанными1СДО_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("РежимИзмененияДанныхПроведенногоДокумента", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Таблица", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ЭтоДополнительныйРеквизитДО", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ЭтоДополнительныйРеквизитИС", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ЭтоТаблица", СтруктураПараметров);
	
