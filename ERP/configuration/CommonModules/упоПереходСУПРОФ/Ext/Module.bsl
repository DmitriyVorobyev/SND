		СоответствиеПолей.Вставить("ЭтоДополнительныйРеквизитИС", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ЭтоТаблица", СтруктураПараметров);
	
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.ПравилаЗаполненияРеквизитовДО, ПолученныеДанные.ПравилаЗаполненияРеквизитовДО, СоответствиеПолей);
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ПравилаЗаполненияРеквизитовИС") Тогда
		СоответствиеПолей = Новый Соответствие();
	
