Процедура ПКО_Справочник_СтруктураПредприятия_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ = Неопределено Тогда
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Идентификатор") Тогда
			
			Идентификатор = ПолученныеДанные.ДополнительныеСвойства.Идентификатор;
			
			МассивКопируемыхПолей = Новый Массив();
			МассивКопируемыхПолей.Добавить("Наименование");
			МассивКопируемыхПолей.Добавить("Родитель");
			
			ОбработатьСсылкуПоУИД(ПолученныеДанные, Идентификатор, "СтруктураПредприятия", МассивКопируемыхПолей);
		КонецЕсли;
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НеСинхронизироватьСоСтруктураПроекта", Истина);
	Иначе
		ДанныеИБ.ДополнительныеСвойства.Вставить("НеСинхронизироватьСоСтруктураПроекта", Истина);
	КонецЕсли;
	
