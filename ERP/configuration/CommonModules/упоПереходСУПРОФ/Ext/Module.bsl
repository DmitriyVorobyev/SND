Процедура ПКО_Документ_АктВыполненныхРабот_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Услуги") Тогда
		СоответствиеПолей = Новый Соответствие();
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_упоПодразделения_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("упоПодразделение", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_Проекты_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("упоПроектнаяЗадача", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_упоРоли_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("упоРоль", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("ПВХ_СтатьиДоходов_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("упоСтатьяДоходов", СтруктураПараметров);
	
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.Услуги, ПолученныеДанные.Услуги, СоответствиеПолей);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ВидыНоменклатуры_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		ДопИнфо = ПолучитьДополнительныеДанные(ДанныеXDTO, "ТипНоменклатуры");
		Если ДопИнфо.ТипНоменклатуры <> Неопределено Тогда
			ТипНоменклатуры = "Перечисление.ТипыНоменклатуры." + ДопИнфо.ТипНоменклатуры;
			ПолученныеДанные.ТипНоменклатуры = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(ТипНоменклатуры);
		КонецЕсли;
	КонецЕсли;
