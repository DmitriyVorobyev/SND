Процедура ПКО_Справочник_Номенклатура_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("ДополнительныеРеквизиты") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДополнительныеРеквизиты", ДанныеXDTO.ДополнительныеРеквизиты);
	КонецЕсли;
	ДопСвойства = ПолучитьДополнительныеДанные(ДанныеXDTO, "ВидНоменклатуры, ТипНоменклатуры");
	Если ДопСвойства <> Неопределено Тогда
		Если ДопСвойства.ВидНоменклатуры <> Неопределено Тогда
			Ид = Новый УникальныйИдентификатор(ДопСвойства.ВидНоменклатуры);
			ПолученныеДанные.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПолучитьСсылку(Ид);
		КонецЕсли;
		Если ДопСвойства.ТипНоменклатуры <> Неопределено Тогда
			ТипНоменклатуры = "Перечисление.ТипыНоменклатуры." + ДопСвойства.ТипНоменклатуры;
			ПолученныеДанные.ТипНоменклатуры = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(ТипНоменклатуры);
		Иначе
			ПолученныеДанные.ТипНоменклатуры = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
				"Перечисление.ТипыНоменклатуры.Товар");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
