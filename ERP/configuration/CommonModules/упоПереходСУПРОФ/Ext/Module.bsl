#Область Алгоритмы
Процедура ОбработатьДанныеРегистра(КомпонентыОбмена, ВходящиеДанные, НаборЗаписей, Параметры)
	ПараметрыОтбора = Параметры.Получить("ПараметрыОтбора");
	Если ПараметрыОтбора = Неопределено Тогда
		ОбменДаннымиXDTOСервер.ЗаписьЖурналаРегистрацииОбменДанными("Не обнаружены правила распределения отборов для регистра.", КомпонентыОбмена);
		ВызватьИсключение "Возникла ошибка при распределении отборов для регистра. Более подробную информацию смотрите в журнале регистрации.";
	КонецЕсли;
	Параметры.Удалить("ПараметрыОтбора");
	КС = ВходящиеДанные.КлючевыеСвойства;
	
	СтруктураДозаполнения = Новый Структура();
	
	Для Каждого Отбор Из ПараметрыОтбора Цикл
		ИмяПоля = Отбор.Ключ;
		Если КС.Свойство(ИмяПоля) Тогда
			Значение = ПолучитьЗначениеПоПараметрам(КомпонентыОбмена, КС, ПараметрыОтбора, ИмяПоля);
		ИначеЕсли ЗначениеЗаполнено(Отбор.Значение.ФиксированноеЗначение) Тогда
			Значение = Отбор.Значение.ФиксированноеЗначение;
		Иначе
			Продолжить;
		КонецЕсли;
		СтруктураДозаполнения.Вставить(ИмяПоля, Значение);
		Если НаборЗаписей.Отбор.Найти(ИмяПоля) <> Неопределено Тогда
			НаборЗаписей.Отбор[ИмяПоля].Значение = СтруктураДозаполнения[ИмяПоля];
			НаборЗаписей.Отбор[ИмяПоля].Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	НаборЗаписей.Прочитать();
	Если ВходящиеДанные.Свойство("Записи") Тогда
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ВходящиеДанные.Записи, НаборЗаписей, Параметры, СтруктураДозаполнения);
	КонецЕсли;
КонецПроцедуры
Процедура ОбработатьСправочникПроектыПослеЗагрузки(Объект, КомпонентыОбмена, ОбъектМодифицирован)
	упоИерархияИПолномочияСервер.АктуализироватьРуководителейПроектныхЗадачПоИерархии(Объект.Ссылка);
КонецПроцедуры
Процедура ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ВходящиеДанные, ИтоговаяТаблица, Параметры, ФиксированныеЗначения = Неопределено, ОчищатьПередЗаполнением = Истина)
	
	Если ОчищатьПередЗаполнением Тогда
		ИтоговаяТаблица.Очистить();
	КонецЕсли;
	
	Для Каждого ВходящаяСтрока Из ВходящиеДанные Цикл
		ИтоговаяСтрока = ИтоговаяТаблица.Добавить();
		Для Каждого Колонка Из ВходящиеДанные.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Значение = ПолучитьЗначениеПоПараметрам(КомпонентыОбмена, ВходящаяСтрока, Параметры, ИмяКолонки);
			Если Значение <> Неопределено Тогда
				ИтоговаяСтрока[ИмяКолонки] = Значение;
			КонецЕсли;
		КонецЦикла;
		Если ФиксированныеЗначения <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ИтоговаяСтрока, ФиксированныеЗначения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
Функция ОбработатьУИД(Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Результат = Новый УникальныйИдентификатор(Значение);
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции
Функция ОбработатьХранилищеЗначений(Значение)
	ДвоичныеДанные = Base64Значение(Значение);
	Возврат Новый ХранилищеЗначения(ДвоичныеДанные);
КонецФункции
Функция ПолучитьДанныеПоПКО(КомпонентыОбмена, Значение, Правило)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Значение.Свойство("ЭтоПеречисление") И Значение.ЭтоПеречисление Тогда
		Если ТипЗнч(Правило) = Тип("Строка") Тогда
			ПКО = КомпонентыОбмена.ПравилаКонвертацииПредопределенныхДанных.Найти(Правило, "ИмяПКПД");
		Иначе
			ПКО = Правило;
		КонецЕсли;
		Если ПКО = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат ПКО.КонвертацииЗначенийПриПолучении.Получить(Значение.Значение);
		
	КонецЕсли;
	
	Если ТипЗнч(Правило) = Тип("Строка") Тогда
		ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, Правило);
	Иначе
		ПКО = Правило;
	КонецЕсли;
	ТекЗначение = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Значение, ПКО, "ПолучитьСсылку");
	ТекТип = ТипЗнч(ТекЗначение);
	Если Справочники.ТипВсеСсылки().СодержитТип(ТекТип)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТекТип)
		Или Документы.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Возврат ТекЗначение;
	Иначе
		Возврат ТекЗначение.Ссылка;
	КонецЕсли;
	
КонецФункции
Функция ПолучитьДанныеСоставногоТипа(КомпонентыОбмена, Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипПереданногоЗначения = ТипЗнч(Значение);
	
	Если ТипПереданногоЗначения = Тип("Строка")
		Или ТипПереданногоЗначения = Тип("Число")
		Или ТипПереданногоЗначения = Тип("Булево")
		Или ТипПереданногоЗначения = Тип("Дата") Тогда
		ТекЗначение = Значение;
	ИначеЕсли ТипПереданногоЗначения = Тип("Структура") Тогда
		ЭтоПеречисление = Значение.Свойство("ЭтоПеречисление") И Значение.ЭтоПеречисление;
		Если ЭтоПеречисление Тогда
			ИмяТаблицы = "ПравилаКонвертацииПредопределенныхДанных";
			ТипЗначения = Значение.ТипЗначенияXDTO;
			ИменаИскомыхКолонок = "ТипXDTO";
		Иначе
			ИмяТаблицы = "ПравилаКонвертацииОбъектов";
			ТипЗначения = Значение.Ссылка.ТипЗначенияXDTO;
			ИменаИскомыхКолонок = "ТипСсылкиXDTO, ТипXDTO";
		КонецЕсли;
		
		Правило = КомпонентыОбмена[ИмяТаблицы].Найти(ТипЗначения, ИменаИскомыхКолонок);
		Если Правило = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТекЗначение = ПолучитьДанныеПоПКО(КомпонентыОбмена, Значение, Правило);
	Иначе
		ТекЗначение = Неопределено;
	КонецЕсли;
	
	Возврат ТекЗначение;
КонецФункции
Функция ПолучитьЗначениеПоПараметрам(КомпонентыОбмена, ВходящаяСтрока, Параметры, ИмяКолонки)
	Значение = Неопределено;
	СтруктураПараметров = Параметры.Получить(ИмяКолонки);
	Если СтруктураПараметров <> Неопределено Тогда
		Если ЗначениеЗаполнено(СтруктураПараметров.ФиксированноеЗначение) Тогда
			Значение = СтруктураПараметров.ФиксированноеЗначение;
		ИначеЕсли СтруктураПараметров.ПримитивныйТип Тогда
			Значение = ВходящаяСтрока[ИмяКолонки];
		ИначеЕсли ЗначениеЗаполнено(СтруктураПараметров.ИмяПКО) Тогда
			Значение = ПолучитьДанныеПоПКО(КомпонентыОбмена, ВходящаяСтрока[ИмяКолонки], СтруктураПараметров.ИмяПКО);
		ИначеЕсли СтруктураПараметров.СоставнойТип Тогда
			Значение = ПолучитьДанныеСоставногоТипа(КомпонентыОбмена, ВходящаяСтрока[ИмяКолонки]);
		ИначеЕсли СтруктураПараметров.ХЗ Тогда
			Значение = ОбработатьХранилищеЗначений(ВходящаяСтрока[ИмяКолонки]);
		ИначеЕсли СтруктураПараметров.УИД Тогда
			Значение = ОбработатьУИД(ВходящаяСтрока[ИмяКолонки]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Значение;
КонецФункции
Функция ПолучитьПараметрыРаспределения(ИмяПКО = "", ОжидаемыйТип = "", ФиксированноеЗначение = Неопределено)
	ПараметрыРаспределения = Новый Структура();
	
	ПараметрыРаспределения.Вставить("ИмяПКО", ИмяПКО);
	ПараметрыРаспределения.Вставить("ПримитивныйТип", Ложь);
	ПараметрыРаспределения.Вставить("СоставнойТип", Ложь);
	ПараметрыРаспределения.Вставить("УИД", Ложь);
	ПараметрыРаспределения.Вставить("ХЗ", Ложь);
	ПараметрыРаспределения.Вставить("ФиксированноеЗначение", ФиксированноеЗначение);
	
	Если ЗначениеЗаполнено(ОжидаемыйТип) Тогда
		ПараметрыРаспределения[ОжидаемыйТип] = Истина;
	КонецЕсли;
	
	Возврат ПараметрыРаспределения;
КонецФункции
