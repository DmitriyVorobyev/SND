Процедура ПКО_РС_упоИспользованиеРабочегоВремени_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Данные") Тогда
		СоответствиеПолей = Новый Соответствие();
		ПараметрыОтбора = Новый Соответствие();
		СоответствиеПолей.Вставить("ПараметрыОтбора", ПараметрыОтбора);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "ПримитивныйТип");
		ПараметрыОтбора.Вставить("Активность", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Справочник_упоВидыОпераций_Получение");
		СоответствиеПолей.Вставить("ВидОперации", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "ПримитивныйТип");
		СоответствиеПолей.Вставить("День", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Справочник_упоЗадания_Получение");
		СоответствиеПолей.Вставить("Задание", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "СоставнойТип");
		СоответствиеПолей.Вставить("ЗадачаПричина", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "ПримитивныйТип");
		СоответствиеПолей.Вставить("Начало", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "ПримитивныйТип");
		ПараметрыОтбора.Вставить("Период", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Справочник_упоПодразделения_Получение");
		СоответствиеПолей.Вставить("Подразделение", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Документ_упоПроектнаяЗадача_Получение");
		СоответствиеПолей.Вставить("РабочееЗадание", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Перечисление_упоРазделУчетаРабВр_Получение");
		СоответствиеПолей.Вставить("РазделУчета", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "ПримитивныйТип");
		СоответствиеПолей.Вставить("РасшифровкаТрудозатрат", СтруктураПараметров);
		
		Если ПолученныеДанные.ДополнительныеСвойства.Данные.КлючевыеСвойства.Свойство("Регистратор")
			И ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.Данные.КлючевыеСвойства.Регистратор) Тогда
			СтруктураПараметров = ПолучитьПараметрыРаспределения("", "СоставнойТип"); 
		Иначе
			ДокСинх = ПолучитьДокументСинхронизацииФактическихТрудозатрат(ПолученныеДанные.ДополнительныеСвойства.Данные.КлючевыеСвойства.Период);
			СтруктураПараметров = ПолучитьПараметрыРаспределения("", "", ДокСинх);
		КонецЕсли;
		ПараметрыОтбора.Вставить("Регистратор", СтруктураПараметров);
		
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Справочник_упоРоли_Получение");
		СоответствиеПолей.Вставить("РольРесурса", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("Справочник_упоТрудовыеРесурсы_Получение");
		СоответствиеПолей.Вставить("ТрудовойРесурс", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьПараметрыРаспределения("", "ПримитивныйТип");
		СоответствиеПолей.Вставить("Трудозатраты", СтруктураПараметров);
	
		ОбработатьДанныеРегистра(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.Данные,
			ПолученныеДанные, СоответствиеПолей);
		Данные = ПолученныеДанные.Выгрузить(, "ТрудовойРесурс, РазделУчета, ЗадачаПричина, День, РабочееЗадание, РасшифровкаТрудозатрат, Подразделение, РольРесурса, ВидОперации, Задание, Начало, Регистратор, Период, Трудозатраты");
		Данные.Свернуть("ТрудовойРесурс, РазделУчета, ЗадачаПричина, День, РабочееЗадание, РасшифровкаТрудозатрат, Подразделение, РольРесурса, ВидОперации, Задание, Начало, Регистратор, Период", "Трудозатраты");
		ПолученныеДанные.Загрузить(Данные);
	КонецЕсли;
КонецПроцедуры
