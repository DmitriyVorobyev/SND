	Если ДанныеXDTO.Свойство("ДополнительныеРеквизиты") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДополнительныеРеквизиты", ДанныеXDTO.ДополнительныеРеквизиты);
	КонецЕсли;
	
