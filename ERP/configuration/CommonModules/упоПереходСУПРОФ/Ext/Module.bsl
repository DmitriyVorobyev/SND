КонецФункции
Функция ПолучитьДополнительныеДанные(Знач ДанныеXDTO, Знач ИменаПолей)
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo) = Тип("Структура") Тогда
		Результат = Новый Структура;
		ИменаПолей = СтрЗаменить(ИменаПолей, " ", "");
		МассивИмен = СтрРазделить(ИменаПолей, ",");
		Для Каждого ИмяПоля Из МассивИмен Цикл
			Если ДанныеXDTO.AdditionalInfo.Свойство(ИмяПоля) И ЗначениеЗаполнено(ДанныеXDTO.AdditionalInfo[ИмяПоля]) Тогда
				ЗначениеПоля = ДанныеXDTO.AdditionalInfo[ИмяПоля];
			Иначе
				ЗначениеПоля = Неопределено
			КонецЕсли;
			Результат.Вставить(ИмяПоля, ЗначениеПоля);
		КонецЦикла;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
Процедура ОбработатьСсылкуПоУИД(ПолученныеДанные, Идентификатор, ИмяОбъекта, МассивКопируемыхПолей)
	Если СтрНайти(ИмяОбъекта, ".") > 0 Тогда //Задел на документы.
		ОписаниеОбъекта = СтрРазделить(ИмяОбъекта, ".");
		ПолученныеДанныеСсылка = ПланыВидовХарактеристик[ОписаниеОбъекта[1]].ПолучитьСсылку(Идентификатор);
	Иначе
		ПолученныеДанныеСсылка = Справочники[ИмяОбъекта].ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	
	ПолученныеДанныеПоИдентификатору = ПолученныеДанныеСсылка.ПолучитьОбъект();
	Если ПолученныеДанныеПоИдентификатору <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПолученныеДанныеПоИдентификатору, ПолученныеДанные, СтрСоединить(МассивКопируемыхПолей,","));
		ПолученныеДанные = ПолученныеДанныеПоИдентификатору;
	Иначе
		ПолученныеДанные.УстановитьСсылкуНового(ПолученныеДанныеСсылка);
	КонецЕсли;
	ПолученныеДанные.ДополнительныеСвойства.Вставить("Идентификатор", Идентификатор);
КонецПроцедуры
Функция ПолучитьДокументСинхронизацииФактическихТрудозатрат(Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	упоСинхронизацияФактическихТрудозатрат.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихТрудозатрат КАК упоСинхронизацияФактическихТрудозатрат
	               |ГДЕ
	               |	упоСинхронизацияФактическихТрудозатрат.Дата = &Период";
	Запрос.УстановитьПараметр("Период", Период);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
	    ДокСинх = Документы.упоСинхронизацияФактическихТрудозатрат.СоздатьДокумент();
		ДокСинх.Дата = Период;
		ДокСинх.Записать();
		Ссылка = ДокСинх.Ссылка;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Ссылка = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Ссылка;
КонецФункции

Функция ПолучитьИдентификаторПоДаннымXDTO(ДанныеXDTO)
	
	Если ДанныеXDTO.Свойство("КлючевыеСвойства") И
		ДанныеXDTO.КлючевыеСвойства.Свойство("Ссылка") Тогда
		Идентификатор = Новый УникальныйИдентификатор(ДанныеXDTO.КлючевыеСвойства.Ссылка.Значение);
	ИначеЕсли ДанныеXDTO.Свойство("Ссылка") Тогда
		Идентификатор = Новый УникальныйИдентификатор(ДанныеXDTO.Ссылка.Значение);
	Иначе
		Идентификатор = Неопределено;
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции
