Процедура ПКО_Справочник_упоПодразделения_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ДанныеИБ = ПолученныеДанные;
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Идентификатор") Тогда
		Идентификатор = ПолученныеДанные.ДополнительныеСвойства.Идентификатор;
		
		МассивКопируемыхПолей = Новый Массив();
		МассивКопируемыхПолей.Добавить("Наименование");
		МассивКопируемыхПолей.Добавить("Родитель");
		МассивКопируемыхПолей.Добавить("Автор");
		МассивКопируемыхПолей.Добавить("АвторИзменений");
		МассивКопируемыхПолей.Добавить("ДатаМодификации");
		МассивКопируемыхПолей.Добавить("ПолноеНаименование");
		МассивКопируемыхПолей.Добавить("Комментарий");
		МассивКопируемыхПолей.Добавить("НеРаспределятьНакладныеРасходыПоПодразделениямУпр");
		МассивКопируемыхПолей.Добавить("НеРаспределятьНакладныеРасходыПоПодразделениямРегл");
		
		ОбработатьСсылкуПоУИД(ДанныеИБ, Идентификатор, "упоПодразделения", МассивКопируемыхПолей);
		
		Если ДанныеИБ.Ссылка.Пустая() Тогда
			СсылкаУПО = ДанныеИБ.ПолучитьСсылкуНового();
		Иначе
			СсылкаУПО = ДанныеИБ.Ссылка;
		КонецЕслИ;
		
		СтруктураПредприятияСсылка = Справочники.СтруктураПредприятия.ПолучитьСсылку(Идентификатор);
		МенеджерЗаписи = РегистрыСведений.упоСоответствиеПодразделенийИСтруктурыПредприятия.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Подразделение = СсылкаУПО;
		МенеджерЗаписи.СтруктураПредприятия = СтруктураПредприятияСсылка;
		МенеджерЗаписи.Записать();
		
	КонецЕсли;
	
	ДанныеИБ.ДополнительныеСвойства.Вставить("НеСинхронизироватьСоСтруктураПроекта", Истина);
	
	Если ДанныеИБ.ДополнительныеСвойства.Свойство("ДополнительныеРеквизиты") Тогда
