КонецПроцедуры
Процедура ПКО_Справочник_Проекты_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("упоКартинкаПроекта") Тогда
		ПолученныеДанные.упоКартинкаПроекта = ОбработатьХранилищеЗначений(ДанныеXDTO.упоКартинкаПроекта);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ДополнительныеРеквизиты") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ДополнительныеРеквизиты", ДанныеXDTO.ДополнительныеРеквизиты);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("упоОкружениеПроекта") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("упоОкружениеПроекта", ДанныеXDTO.упоОкружениеПроекта);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("упоУчастникиПроекта") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("упоУчастникиПроекта", ДанныеXDTO.упоУчастникиПроекта);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Фазы") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Фазы", ДанныеXDTO.Фазы);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("Компонент") И ЗначениеЗаполнено(ДанныеXDTO.Компонент) Тогда
		ПолученныеДанные.Компонент = ПолучитьДанныеПоПКО(КомпонентыОбмена, ДанныеXDTO.Компонент, "Перечисление_упоКомпоненты_Получение");
	Иначе
		ПолученныеДанные.Компонент = Перечисления.упоКомпоненты.Проект;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ПортфельПроектов") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ПортфельПроектов", ДанныеXDTO.ПортфельПроектов);
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ПрограммаПроектов") Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ПрограммаПроектов", ДанныеXDTO.ПрограммаПроектов);
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Проекты_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ДополнительныеРеквизиты") Тогда
		СоответствиеПолей = Новый Соответствие();
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Ложь, Истина, Ложь, Ложь);
		СоответствиеПолей.Вставить("Значение", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("ПВХ_ДополнительныеРеквизитыИСведения_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Свойство", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ТекстоваяСтрока", СтруктураПараметров);
	
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.ДополнительныеРеквизиты, ПолученныеДанные.ДополнительныеРеквизиты, СоответствиеПолей);
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("упоОкружениеПроекта") Тогда
		СоответствиеПолей = Новый Соответствие();
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Комментарий", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_Контрагенты_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Контрагент", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Ответственный", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_упоРоли_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Роль", СтруктураПараметров);
	
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.упоОкружениеПроекта, ПолученныеДанные.упоОкружениеПроекта, СоответствиеПолей);
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("упоУчастникиПроекта") Тогда
		СоответствиеПолей = Новый Соответствие();
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Комментарий", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_упоСотрудники_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Ответственный", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_упоПодразделения_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Подразделение", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_упоРоли_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Роль", СтруктураПараметров);
	
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.упоУчастникиПроекта, ПолученныеДанные.упоУчастникиПроекта, СоответствиеПолей);
	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Фазы") Тогда
		СоответствиеПолей = Новый Соответствие();
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("Справочник_Проекты_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ВехаЗеркало", СтруктураПараметров);
	
