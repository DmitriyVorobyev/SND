	КонецЕсли;
	
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ДополнительныеРеквизиты") Тогда
		СоответствиеПолей = Новый Соответствие();
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Ложь, Истина, Ложь, Ложь);
		СоответствиеПолей.Вставить("Значение", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("ПВХ_ДополнительныеРеквизитыИСведения_Получение" , Ложь, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("Свойство", СтруктураПараметров);
	
		СтруктураПараметров = ПолучитьСтруктуруПараметровЗаполнения("", Истина, Ложь, Ложь, Ложь);
		СоответствиеПолей.Вставить("ТекстоваяСтрока", СтруктураПараметров);
	
		ОбработатьТаблицуПоПараметрам(КомпонентыОбмена, ПолученныеДанные.ДополнительныеСвойства.ДополнительныеРеквизиты, ПолученныеДанные.ДополнительныеРеквизиты, СоответствиеПолей);
