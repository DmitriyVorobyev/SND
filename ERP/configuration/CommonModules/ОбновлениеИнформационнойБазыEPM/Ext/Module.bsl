//           См. также общий макет ОписаниеИзмененийСистемы.
//
Процедура ПриПодготовкеМакетаОписанияОбновлений(Знач Макет) Экспорт
	
КонецПроцедуры

// Добавляет в список процедуры-обработчики перехода с другой программы (с другим именем конфигурации).
// Например, для перехода между разными, но родственными конфигурациями: базовая -> проф -> корп.
// Вызывается перед началом обновления данных ИБ.
//
// Параметры:
//  Обработчики - ТаблицаЗначений - с колонками:
//    * ПредыдущееИмяКонфигурации - Строка - имя конфигурации, с которой выполняется переход;
//    * Процедура                 - Строка - полное имя процедуры-обработчика перехода с программы
//									ПредыдущееИмяКонфигурации. 
//                                  Например, "ОбновлениеИнформационнойБазыУПП.ЗаполнитьУчетнуюПолитику"
//                                  Обязательно должна быть экспортной.
//
// Пример добавления процедуры-обработчика в список.
//  Обработчик = Обработчики.Добавить();
//  Обработчик.ПредыдущееИмяКонфигурации  = "УправлениеТорговлей";
//  Обработчик.Процедура                  = "ОбновлениеИнформационнойБазыУПП.ЗаполнитьУчетнуюПолитику";
//
Процедура ПриДобавленииОбработчиковПереходаСДругойПрограммы(Обработчики) Экспорт
	
КонецПроцедуры

// Позволяет переопределить режим обновления данных информационной базы.
// Для использования в редких (нештатных) случаях перехода, не предусмотренных в
// стандартной процедуре определения режима обновления.
//
// Параметры:
//   РежимОбновленияДанных - Строка - в обработчике можно присвоить одно из значений:
//              "НачальноеЗаполнение"     - если это первый запуск пустой базы (области данных);
//              "ОбновлениеВерсии"        - если выполняется первый запуск после обновление конфигурации базы данных;
//              "ПереходСДругойПрограммы" - если выполняется первый запуск после обновление конфигурации базы данных, 
//                                          в которой изменилось имя основной конфигурации.
//
//   СтандартнаяОбработка  - Булево - если присвоить Ложь, то стандартная процедура
//                                    определения режима обновления не выполняется, 
//                                    а используется значение РежимОбновленияДанных.
//
Процедура ПриОпределенииРежимаОбновленияДанных(РежимОбновленияДанных, СтандартнаяОбработка) Экспорт
	
КонецПроцедуры

// Вызывается после выполнения всех процедур-обработчиков перехода с другой программы (с другим именем конфигурации),
// и до начала выполнения обновления данных ИБ.
//
// Параметры:
//  ПредыдущееИмяКонфигурации    - Строка - имя конфигурации до перехода.
//  ПредыдущаяВерсияКонфигурации - Строка - имя предыдущей конфигурации (до перехода).
//  Параметры                    - Структура - 
//    * ВыполнитьОбновлениеСВерсии   - Булево - по умолчанию Истина. Если установить Ложь, 
//        то будут выполнена только обязательные обработчики обновления (с версией "*").
//    * ВерсияКонфигурации           - Строка - номер версии после перехода. 
//        По умолчанию, равен значению версии конфигурации в свойствах метаданных.
//        Для того чтобы выполнить, например, все обработчики обновления с версии ПредыдущаяВерсияКонфигурации,
//        следует установить значение параметра в ПредыдущаяВерсияКонфигурации.
//        Для того чтобы выполнить вообще все обработчики обновления, установить значение "0.0.0.1".
//    * ОчиститьСведенияОПредыдущейКонфигурации - Булево - по умолчанию Истина. 
//			Для случаев когда предыдущая конфигурация совпадает по имени с подсистемой текущей конфигурации,
//			следует указать Ложь.
//
Процедура ПриЗавершенииПереходаСДругойПрограммы(Знач ПредыдущееИмяКонфигурации, 
	Знач ПредыдущаяВерсияКонфигурации, Параметры) Экспорт
	
	Параметры.ВерсияКонфигурации = "0.0.0.1"; 	
	
КонецПроцедуры

#Область ОбработчикиОбновленияИнформационнойБазы

// Заполняет пустую ИБ.
// 
// Параметры:
//  Параметры - Произвольный - параметры.
//
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция ЗаполнитьПустуюИБ(Параметры = Неопределено) Экспорт
	
	ВключитьИспользованиеПроектов();
	
	упоИнтеграция.СинхронизироватьВсеПодразделенияИСтруктурыПредприятия();
	упоИнтеграция.СинхронизироватьВсеСтатьиДР();
	упоИнтеграция.СинхронизироватьВсеСценари();
	
КонецФункции

// Включает использование проектов.
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура ВключитьИспользованиеПроектов(Параметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	Константы["ИспользоватьПроекты"].Установить(Истина);
	
КонецПроцедуры 

// Переносит дополнительные реквизиты и свойства.
// 
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура ПеренестиДопРеквизитыИСвойстваВКорректныеНаборы(Параметры = Неопределено) Экспорт 
	
	СтруктураНаборовСвойств = Новый Структура();
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_Встреча", 					   "Документ_Встреча");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_ДоговорыКонтрагентов", 	   "Справочник_ДоговорыКонтрагентов");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_Должности", 				   "Справочник_Должности");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_Файлы", 					   "Справочник_Файлы");
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_ЗапланированноеВзаимодействие", "Документ_ЗапланированноеВзаимодействие");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_Номенклатура", 			   "Справочник_Номенклатура");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_Организации", 				   "Справочник_Организации");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_ПапкиФайлов", 				   "Справочник_ПапкиФайлов");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_ПодразделенияОрганизаций",    "Справочник_ПодразделенияОрганизаций");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_Пользователи", 			   "Справочник_Пользователи");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_Проекты", 					   "Справочник_Проекты");
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_упоРасчетЦеныКонтракта", 	   "Документ_упоРасчетЦеныКонтракта");
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_СообщениеSMS", 				   "Документ_СообщениеSMS");
	СтруктураНаборовСвойств.Вставить("Удалить_Справочник_СценарииОбменовДанными",      "Справочник_СценарииОбменовДанными");
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_упоУтверждениеПланаПроекта",    "Документ_упоУтверждениеПланаПроекта");
	СтруктураНаборовСвойств.Вставить("Удалить1_Справочник_Файлы", 					   "Справочник_Файлы");
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_ЭлектронноеПисьмоВходящее", 	   "Документ_ЭлектронноеПисьмоВходящее");
	СтруктураНаборовСвойств.Вставить("Удалить_Документ_ЭлектронноеПисьмоИсходящее",    "Документ_ЭлектронноеПисьмоИсходящее");
		
	Для Каждого КлючЗначение Из СтруктураНаборовСвойств Цикл
		
		Попытка
			СтарыйНаборСвойств = Справочники.НаборыДополнительныхРеквизитовИСведений[КлючЗначение.Ключ].ПолучитьОбъект();
			НовыйНаборСвойств  = Справочники.НаборыДополнительныхРеквизитовИСведений[КлючЗначение.Значение].ПолучитьОбъект();	
		Исключение
		    Продолжить;
		КонецПопытки;
				
		МассивСвойствДляИсправления = Новый Массив;
		
		Для Каждого СтрокаДопРеквизиты Из СтарыйНаборСвойств.ДополнительныеРеквизиты Цикл
			
			Если МассивСвойствДляИсправления.Найти(СтрокаДопРеквизиты.Свойство) = Неопределено Тогда
				МассивСвойствДляИсправления.Добавить(СтрокаДопРеквизиты.Свойство);				
			КонецЕсли; 
			
			ЗаполнитьЗначенияСвойств(НовыйНаборСвойств.ДополнительныеРеквизиты.Добавить(), СтрокаДопРеквизиты);
			
		КонецЦикла;
		
		Для Каждого СтрокаДопСведения Из СтарыйНаборСвойств.ДополнительныеСведения Цикл
			
			Если МассивСвойствДляИсправления.Найти(СтрокаДопСведения.Свойство) = Неопределено Тогда
				МассивСвойствДляИсправления.Добавить(СтрокаДопСведения.Свойство);				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НовыйНаборСвойств.ДополнительныеСведения.Добавить(), СтрокаДопСведения);
			
		КонецЦикла;
		
		Для Каждого СвойствоСсылка Из МассивСвойствДляИсправления Цикл
			
			СвойствоОбъект = СвойствоСсылка.ПолучитьОбъект();
			СвойствоОбъект.НаборСвойств = НовыйНаборСвойств.Ссылка;
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(СвойствоОбъект);
			
		КонецЦикла; 
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйНаборСвойств);	
		
	КонецЦикла;	
	
КонецПроцедуры

// Заполняет обязательный реквизит договора Статус в договорах контрагентов, 
// созданных документом Регистрация юридических условий договора.
// 
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура ЗаполнитьПолеСтатусВДоговорахРегистрацииЮридическихУсловий(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	упоРегистрацияЮридическихУсловийДоговора.ДоговорВзаиморасчетов КАК ДоговорВзаиморасчетов
	                      |ИЗ
	                      |	Документ.упоРегистрацияЮридическихУсловийДоговора КАК упоРегистрацияЮридическихУсловийДоговора
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	                      |		ПО упоРегистрацияЮридическихУсловийДоговора.ДоговорВзаиморасчетов = ДоговорыКонтрагентов.Ссылка
	                      |			И (ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.ПустаяСсылка))");
	
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.ДоговорВзаиморасчетов.ПолучитьОбъект();
		СправочникОбъект.Статус = 
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.Действует");
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		Исключение
		КонецПопытки;	
	КонецЦикла;	
	
КонецПроцедуры

// Изменяет элементы справочника упоПравилаПолученияФактаДляПроектногоБюджетирования.
// Перебираются все элементы справочника, в которых не заполнен предустановленный код.
// После, в зависимости от использования правила в документе "Отражение прочих доходов и расходов", 
// элементы либо отключаются, либо помечаются на удаление. Затем создаются новые/обновляются текущие элементы.
//
Процедура ОбновитьПравилаПолученияФактаПоМакетам(Параметры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПравилаОтражения.ПравилоОтражения КАК ПравилоОтражения
		|ПОМЕСТИТЬ ВТ_ПравилаОтражения
		|ИЗ
		|	Документ.упоОтражениеФактаВПроектномБюджетировании.ПравилаОтражения КАК ПравилаОтражения
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ПравилаОтражения.Ссылка.ДокументОснование) = ТИП(Документ.ПрочиеДоходыРасходы)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.Ссылка КАК ПравилоОтражения,
		|	НЕ ВТ_ПравилаОтражения.ПравилоОтражения ЕСТЬ NULL КАК ИспользованоПриОтражении,
		|	упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.Ссылка.ОтключитьПравило КАК ОтключитьПравило
		|ИЗ
		|	Справочник.упоПравилаПолученияФактаДляПроектногоБюджетирования.ТипыДокументов КАК упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПравилаОтражения КАК ВТ_ПравилаОтражения
		|		ПО упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.Ссылка = ВТ_ПравилаОтражения.ПравилоОтражения
		|ГДЕ
		|	упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.Ссылка.ТипПравила = ЗНАЧЕНИЕ(Перечисление.упоТипыПравилПроектногоБюджетирования.ПроизвольныйЗапрос)
		|	И упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.ТипДокумента = ""ПрочиеДоходыРасходы""
		|	И упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.Ссылка.ПредустановленныйКод = """"
		|	И НЕ упоПравилаПолученияФактаДляПроектногоБюджетированияТипыДокументов.Ссылка.ПометкаУдаления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл						
			
			Если ВыборкаДетальныеЗаписи.ИспользованоПриОтражении И ВыборкаДетальныеЗаписи.ОтключитьПравило Тогда	
				Продолжить;
			КонецЕсли;	

			ОбъектИБ = ВыборкаДетальныеЗаписи.ПравилоОтражения.ПолучитьОбъект();
			
			Если ВыборкаДетальныеЗаписи.ИспользованоПриОтражении Тогда
				ОбъектИБ.ОтключитьПравило = Истина;	
			Иначе								
				ОбъектИБ.ПометкаУдаления = Истина;
			КонецЕсли;
			
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектИБ);
			Исключение
				ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());	
				ЗаголовокОшибки = НСтр("ru = 'Обработчик обновления. Процедура ОбновитьПравилаПолученияФактаПоМакетам'");
				
				ЗаписьЖурналаРегистрации(ЗаголовокОшибки,
				УровеньЖурналаРегистрации.Ошибка, , ,
				НСтр("ru = 'Во время выполнения операции произошла ошибка.'") + Символы.ПС +
				ПредставлениеОшибки);				
			КонецПопытки;
			
		КонецЦикла;	
	КонецЕсли;
	
	упоПроектноеБюджетированиеСервер.ОбновитьПредопределенныеПравилаПолученияФакта();
		
КонецПроцедуры

Процедура ЗаполнитьСтатусыДоговоровERP(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	               |	ДоговорыКонтрагентов.упоСтатусДоговора КАК упоСтатусДоговора
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Статус = упоИнтеграцияEPMСервер.СтатусERPПоСтатусуPM(Выборка.упоСтатусДоговора);
		Если Не ЗначениеЗаполнено(Статус) Тогда
			Продолжить;
		КонецЕсли;
		
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Статус = Статус;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
