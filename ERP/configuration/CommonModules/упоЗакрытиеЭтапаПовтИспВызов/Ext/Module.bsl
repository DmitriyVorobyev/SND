#Область ПрограммныйИнтерфейс

// Проверка: задача закрыта
//
// Параметры:
//  пЗадача				 - СправочникСсылка.Проекты, ДокументСсылка.упоПроектнаяЗадача
//  ОпределятьПоРодителю - Булево
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ЗадачаЗакрыта(пЗадача, ОпределятьПоРодителю = Ложь, Знач Версия = Неопределено)  Экспорт
	
	Если ОпределятьПоРодителю Тогда
		Возврат ЗадачаЗакрытаОпределениеПоРодителю(пЗадача);
	КонецЕсли;
		
	Результат = Ложь;
	
	Если ТипЗнч(пЗадача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Задача = пЗадача;
	Иначе
		Задача = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(пЗадача);
	КонецЕсли;
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Задача) Тогда
		
		Если Версия = Неопределено Тогда
			Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Задача);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТекВерсия", Версия);
		Запрос.УстановитьПараметр("ПроектнаяЗадача", Задача);
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	Т.ПроектнаяЗадача КАК ПроектнаяЗадача
		               |ИЗ
		               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
		               |			,
		               |			Версия = &ТекВерсия
		               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК Т
		               |ГДЕ
		               |	Т.СтатусЗадачи = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Закрыта)";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Результат = Не РезультатЗапроса.Пустой();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверка: задача - этап верхнего уровня
//
// Параметры:
//  Задача	 - ДокументСсылка.упоПроектнаяЗадача
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ЭтоЭтапВерхнегоУровня(Задача) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЭтоЭтапВерхнегоУровня = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоМодельПакетаРабот,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоПакетРабот,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоВеха,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проект КАК Проект
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |;
	               |				   
				   |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоПроектнаяЗадача.Проект
	               |ПОМЕСТИТЬ Проекты
	               |ИЗ
	               |	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
	               |ГДЕ
	               |	упоПроектнаяЗадача.Ссылка = &ПроектнаяЗадача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	МАКСИМУМ(упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача) КАК ЗадачаВерхнегоУровня,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача) КАК КоличествоЗадачВерхнегоУровня
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача.Проект В
	               |				(ВЫБРАТЬ
	               |					Проекты.Проект
	               |				ИЗ
	               |					Проекты)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |ГДЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)
	               |	И упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи <> ""Неразобранные задачи""";			   
					   
	Запрос.УстановитьПараметр("ПроектнаяЗадача", Задача);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаДанныхПЗ = ПакетЗапросов[0].Выбрать();
	
	Если НЕ ВыборкаДанныхПЗ.Следующий() Тогда
		Возврат РезультатЭтоЭтапВерхнегоУровня;
	КонецЕсли;
	
	ЭтоЭтап = НЕ ВыборкаДанныхПЗ.ЭтоМодельПакетаРабот И НЕ ВыборкаДанныхПЗ.ЭтоПакетРабот И НЕ ВыборкаДанныхПЗ.ЭтоВеха;
	
	Если НЕ ЭтоЭтап Тогда
		Возврат РезультатЭтоЭтапВерхнегоУровня;
	КонецЕсли;
	
	ЭтоВерхнийУровень = Не ЗначениеЗаполнено(ВыборкаДанныхПЗ.ЗадачаРодитель);
	
	Если ЭтоВерхнийУровень Тогда
		
		РезультатЭтоЭтапВерхнегоУровня = Истина;
		
	Иначе
		
		// Возможно, у нас существует корневой этап.
		
		ВыборкаДанныхВерхнегоУровня = ПакетЗапросов[2].Выбрать();
		
		Если ВыборкаДанныхВерхнегоУровня.Следующий() Тогда
			
			Если ВыборкаДанныхВерхнегоУровня.КоличествоЗадачВерхнегоУровня = 1 Тогда
				
				КорневойЭтап = ВыборкаДанныхВерхнегоУровня.ЗадачаВерхнегоУровня;
				
				Если КорневойЭтап = ВыборкаДанныхПЗ.ЗадачаРодитель Тогда
					
					РезультатЭтоЭтапВерхнегоУровня = Истина;
					
				КонецЕсли;
								
			КонецЕсли;						
			
		КонецЕсли;
		
	КонецЕсли;				
	
	Возврат РезультатЭтоЭтапВерхнегоУровня;
	
КонецФункции

// Проверка: задача - этап подчиненного уровня
//
// Параметры:
//  Задача	 - ДокументСсылка.упоПроектнаяЗадача
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ЭтоЭтапВторогоУровня(Задача) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЭтоЭтапВторогоУровня = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоМодельПакетаРабот,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоПакетРабот,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоВеха,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проект КАК Проект,
	               |	упоСвойстваПроектныхЗадачСрезПоследнихРод.ЗадачаРодитель КАК ЗадачаРодительРодителя
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследнихРод
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = упоСвойстваПроектныхЗадачСрезПоследнихРод.ПроектнаяЗадача
	               |			И упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоСвойстваПроектныхЗадачСрезПоследнихРод.Версия";
				   
	Запрос.УстановитьПараметр("ПроектнаяЗадача", Задача);
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ВыборкаДанныхПЗ = ПакетЗапросов[0].Выбрать();
	
	Если НЕ ВыборкаДанныхПЗ.Следующий() Тогда
		Возврат РезультатЭтоЭтапВторогоУровня;
	КонецЕсли;
	
	ЭтоЭтап = НЕ ВыборкаДанныхПЗ.ЭтоМодельПакетаРабот И НЕ ВыборкаДанныхПЗ.ЭтоПакетРабот И НЕ ВыборкаДанныхПЗ.ЭтоВеха;
	
	Если НЕ ЭтоЭтап Тогда
		Возврат РезультатЭтоЭтапВторогоУровня;
	КонецЕсли;
	
	РезультатЭтоЭтапВторогоУровня = ЗначениеЗаполнено(ВыборкаДанныхПЗ.ЗадачаРодитель) 
									И НЕ ЗначениеЗаполнено(ВыборкаДанныхПЗ.ЗадачаРодительРодителя);
	
	Возврат РезультатЭтоЭтапВторогоУровня;

КонецФункции 

// Проверка: переданная версия проекта является текущей.
//
// Параметры:
//  Версия	 - ДокументСсылка.упоВерсияПланаПроекта
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ЭтоТекущаяВерсия(Версия) Экспорт
	
	Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Версия, "Проект");
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	Возврат Версия = ТекВерсия;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗадачаЗакрытаОпределениеПоРодителю(пЗадача, Знач Версия = Неопределено) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Если ТипЗнч(пЗадача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Задача = пЗадача;
	Иначе
		Задача = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(пЗадача);
	КонецЕсли;
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Задача) Тогда
		
		Если Версия = Неопределено Тогда
			Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Задача);
		КонецЕсли;
		
		МассивРодителей = ПолучитьМассивРодителей(Задача, , Версия);
		МассивРодителей.Добавить(Задача);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ 
		               |	упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачи
		               |ИЗ
		               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
		               |			,
		               |			Версия = &ТекВерсия
		               |				И ПроектнаяЗадача В (&МассивЗадач)) КАК упоСтатусыПроектныхЗадачСрезПоследних
		               |ГДЕ
		               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусазадачи.Закрыта)";
		
		Запрос.УстановитьПараметр("ТекВерсия", Версия);
		Запрос.УстановитьПараметр("МассивЗадач", МассивРодителей);
		РезультатЗапроса = Запрос.Выполнить();
		
		Результат = Не РезультатЗапроса.Пустой();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивРодителей(Задача, МассивРодителей = Неопределено, Версия)
	
	// Привилегированный режим в методе вызова.
	
	Если МассивРодителей = Неопределено Тогда
		МассивРодителей = Новый Массив; 
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель КАК ЗадачаРодитель
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &ТекВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних";
	
	Запрос.УстановитьПараметр("ТекВерсия", Версия);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", Задача);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗадачаРодитель = Выборка.ЗадачаРодитель;
	Иначе
		ЗадачаРодитель = Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗадачаРодитель) ИЛИ МассивРодителей.Найти(ЗадачаРодитель) <> Неопределено Тогда
		
		Возврат МассивРодителей;
		
	Иначе
		
		МассивРодителей.Добавить(ЗадачаРодитель);
		Возврат ПолучитьМассивРодителей(ЗадачаРодитель, МассивРодителей, Версия);
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти
