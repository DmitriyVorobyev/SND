// Обработчик события "Обработка заполнения" объекта.
//
// Параметры:
//  Объект				 - Произвольный	 - объект, для которого вызывается событие.
//  ДанныеЗаполнения	 - Произвольный	 - объект-основание.
//  ТекстЗаполнения		 - Строка
//  СтандартнаяОбработка - Булево
//
Процедура ОбъектОбработкаЗаполнения(Объект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.Проекты") Тогда
		
		Объект.СтатьяЗатратПоУмолчанию = Константы.упоСтатьяЗатратПоУмолчанию.Получить();
		Объект.СтатьяДоходовПоУмолчанию = Константы.упоСтатьяДоходовПоУмолчанию.Получить();
		Объект.НатуральныйПоказательДоходовПоУмолчанию = Константы.упоНатуральныйПоказательДоходовПоУмолчанию.Получить();
		Объект.РольДоходовПоУмолчанию = Константы.упоРольДоходовПоУмолчанию.Получить();
		Объект.ПодразделениеДоходовПоУмолчанию = Константы.упоПодразделениеДоходовПоУмолчанию.Получить();
		Объект.РольРасходовПоУмолчанию = Константы.упоРольРасходовПоУмолчанию.Получить();
		Объект.НатуральныйПоказательРасходовПоУмолчанию = Константы.упоНатуральныйПоказательРасходовПоУмолчанию.Получить();
		Объект.ПодразделениеРасходовПоУмолчанию = Константы.упоПодразделениеРасходовПоУмолчанию.Получить();
		Объект.ПрофильДоходовПоУмолчанию = Константы.упоПрофильДоходовПоУмолчанию.Получить();
		Объект.ПрофильРасходовПоУмолчанию = Константы.упоПрофильРасходовПоУмолчанию.Получить();
		
		Объект.СоздаватьЗаданияПриНазначенииРесурсов = Константы.упоСоздаватьЗаданияПриНазначенииРесурсов.Получить();
		
		Объект.упоОсновнойИндикаторПоФазе = Константы.упоОсновнойИндикаторПоФазе.Получить();
		Объект.упоЕдиницаВремениПоУмолчанию = Константы.упоЕдиницаВремениПоУмолчанию.Получить();
		Объект.упоЕдиницаТрудоемкостиПоУмолчанию = Константы.упоЕдиницаТрудоемкостиПоУмолчанию.Получить();
		Объект.ВключитьТрудРесурсыВПланРасходов = Константы.упоВключитьТрудРесурсыВПланРасходов.Получить();
		Объект.ВключитьМатРесурсыВПланРасходов = Константы.упоВключитьМатРесурсыВПланРасходов.Получить();
		Объект.ВключитьДопЗатратыВПланРасходов = Константы.упоВключитьДопЗатратыВПланРасходов.Получить();
		Объект.ВключитьСубпродуктыВПланДоходов = Константы.упоВключитьСубпродуктыВПланДоходов.Получить();
		Объект.упоВключитьПланДоходовВБДДС = Константы.упоВключитьПланДоходовВБДДС.Получить();
		Объект.упоВключитьПланРасходовВБДДС = Константы.упоВключитьПланРасходовВБДДС.Получить();
		Объект.упоСхемаОплатыПоУмолчаниюДоходы = Константы.упоСхемаОплатыПоУмолчаниюДоходы.Получить();
		Объект.упоСхемаОплатыПоУмолчаниюРасходы = Константы.упоСхемаОплатыПоУмолчаниюРасходы.Получить();
		
		Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.упоПрограммыПроектов") Тогда
			Объект.Компонент = Перечисления.упоКомпоненты.ПрограммаПроектов;
			Объект.ПрограммаПроектов = ДанныеЗаполнения;
		ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.упоПортфелиПроектов") Тогда
			Объект.Компонент = Перечисления.упоКомпоненты.ПортфельПроектов;
			Объект.ПортфельПроектов = ДанныеЗаполнения;
			
			СтруктураНастроек = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.ПортфельПроектов);
			ЗаполнитьЗначенияСвойств(Объект, СтруктураНастроек);
		Иначе
			Объект.Компонент = Перечисления.упоКомпоненты.Проект;
		КонецЕсли;
		
		Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект, ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;
	
	Если упоИнтеграцияEPMСервер.ИспользоватьПодсистемуРаспределениеЗарплаты() Тогда
		МодульРаспределениеЗарплатыСервер = ОбщегоНазначения.ОбщийМодуль("упоРаспределениеЗарплатыСервер");
		МодульРаспределениеЗарплатыСервер.ОбъектОбработкаЗаполнения(Объект,
			ДанныеЗаполнения,
			ТекстЗаполнения,
			СтандартнаяОбработка);
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектОбработкаЗаполнения(Объект, ДанныеЗаполнения);
	
КонецПроцедуры

