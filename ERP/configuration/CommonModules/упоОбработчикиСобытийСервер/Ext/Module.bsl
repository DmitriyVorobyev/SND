	НоваяСтрока.ПутьКДанным = "Элементы.РаспределениеДоходов.ТекущиеДанные.КонтрагентПодрядчик";
	НоваяСтрока.ЭлементУ = "РаспределениеДоходовЗаказДоговорПодрядчика";
	
	// Регистрация фактических затрат мат. ресурсов.
	НоваяСтрока = ТаблицаОбъектов.Добавить();
	НоваяСтрока.ТипЗначенияОбъекта = Тип("ДокументСсылка.упоРегистрацияФактическихЗатратМатРесурсов");
	НоваяСтрока.ПутьКДанным = "Элементы.ЗатратыМатРесурсовФакт.ТекущиеДанные.Контрагент";
	НоваяСтрока.ЭлементУ = "ЗатратыМатРесурсовФактДоговор";
	
	// Регистрация фактически выполненного объема.
	НоваяСтрока = ТаблицаОбъектов.Добавить();
	НоваяСтрока.ТипЗначенияОбъекта = Тип("ДокументСсылка.упоРегистрацияФактическиВыполненногоОбъема");
	НоваяСтрока.ПутьКДанным = "Элементы.ДоходныеОбъемы.ТекущиеДанные.Контрагент";
	НоваяСтрока.ЭлементУ = "ДоходныеОбъемыДоговор";
	
	НоваяСтрока = ТаблицаОбъектов.Добавить();
	НоваяСтрока.ТипЗначенияОбъекта = Тип("ДокументСсылка.упоРегистрацияФактическиВыполненногоОбъема");
	НоваяСтрока.ПутьКДанным = "Элементы.РасходныеОбъемы.ТекущиеДанные.Контрагент";
	НоваяСтрока.ЭлементУ = "РасходныеОбъемыДоговор";
	
	НоваяСтрока = ТаблицаОбъектов.Добавить();
	НоваяСтрока.ТипЗначенияОбъекта = Тип("ДокументСсылка.упоРегистрацияФактическиВыполненногоОбъема");
	НоваяСтрока.ПутьКДанным = "Элементы.РаспределениеДоходныхОбъемов.ТекущиеДанные.КонтрагентПодрядчик";
	НоваяСтрока.ЭлементУ = "РаспределениеДоходныхОбъемовЗаказДоговорПодрядчика";
	
	Возврат ТаблицаОбъектов;
	
КонецФункции

Процедура ДобавитьЭлементОтбораНаФорму(ЭтаФорма, ЭлементРодитель, ПоказыватьВидСтравнения = Истина, ИндексОтбора = 0)
	
	Если ЭтаФорма.Элементы.Найти("ОтборПроект") <> Неопределено Тогда
		ЭтаФорма.ОтборПроект = ЭтаФорма.Список.Отбор.Элементы[ИндексОтбора].ПравоеЗначение;
		Возврат;
	КонецЕсли;
	
	НоваяГруппа = ЭтаФорма.Элементы.Вставить("ГруппаПредустановленныйОтборПоПроекту",
			Тип("ГруппаФормы"), ЭлементРодитель.Родитель, ЭлементРодитель);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.РастягиватьПоГоризонтали = Истина;
	
	НовыйПолеОтбора = ЭтаФорма.Элементы.Добавить("ПолеОтборПоПроектуИспользование", Тип("ПолеФормы"), НоваяГруппа);
	НовыйПолеОтбора.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйПолеОтбора.ПутьКДанным = "Список.Отбор[" + ИндексОтбора + "].Использование";
	НовыйПолеОтбора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	
	НовыйПолеОтбора = ЭтаФорма.Элементы.Добавить("ПолеОтборПоПроектуЛевоеЗначение", Тип("ПолеФормы"), НоваяГруппа);
	НовыйПолеОтбора.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйПолеОтбора.ПутьКДанным = "Список.Отбор[" + ИндексОтбора + "].ЛевоеЗначение";
	НовыйПолеОтбора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйПолеОтбора.АвтомаксимальнаяШирина = Ложь;
	НовыйПолеОтбора.МаксимальнаяШирина = 15;
	
	Если ПоказыватьВидСтравнения Тогда
		НовыйПолеОтбора = ЭтаФорма.Элементы.Добавить("ПолеОтборПоПроектуВидСравнения", Тип("ПолеФормы"), НоваяГруппа);
		НовыйПолеОтбора.Вид = ВидПоляФормы.ПолеВвода;
		НовыйПолеОтбора.ПутьКДанным = "Список.Отбор[" + ИндексОтбора + "].ВидСравнения";
		НовыйПолеОтбора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйПолеОтбора.АвтомаксимальнаяШирина = Ложь;
		НовыйПолеОтбора.МаксимальнаяШирина = 15;
	КонецЕсли;
	
	НовыйПолеОтбора = ЭтаФорма.Элементы.Добавить("ПолеОтборПоПроектуПравоеЗначение", Тип("ПолеФормы"), НоваяГруппа);
	НовыйПолеОтбора.Вид = ВидПоляФормы.ПолеВвода;
	НовыйПолеОтбора.ПутьКДанным = "Список.Отбор[" + ИндексОтбора + "].ПравоеЗначение";
	НовыйПолеОтбора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйПолеОтбора.АвтомаксимальнаяШирина = Ложь;
	НовыйПолеОтбора.МаксимальнаяШирина = 40;
	
КонецПроцедуры

#Область ИнтеграцияСППР

Процедура ДобавитьКомандыИнтеграцииССППР(Форма, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НеТребуютсяКомандыИнтеграцииССППР(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры <> Неопределено
		И ДополнительныеПараметры.Свойство("РазмещениеКомандСППР") Тогда
		РазмещениеКоманд = ДополнительныеПараметры.РазмещениеКомандСППР;
	Иначе
		РазмещениеКоманд = ОпределитьРазмещениеКоманд(Форма);
	КонецЕсли;
	
	// В форме отчета команда размещается во всех действиях, иначе ее не видно.
	ТолькоВоВсехДействиях = (Найти(Форма.ИмяФормы, "Отчет.") <> 0);
	
	НомерКоманды = 1;
	Для каждого МестоРазмещенияКоманд Из РазмещениеКоманд Цикл
		ДобавитьКомандуФункциональнойМодели(
			Форма,
			МестоРазмещенияКоманд,
			НомерКоманды,
			ТолькоВоВсехДействиях,
			"Подключаемый_УниверсальныйОбработчикСобытийКлиент");
		
		НомерКоманды = НомерКоманды + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьРазмещениеКоманд(Форма)
	
	РазмещениеКоманд = Новый Массив;
	
	Для каждого ЭлементФормы Из Форма.Элементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("КнопкаФормы")
			И Найти(НРег(ЭлементФормы.Имя), НСтр("ru = 'справка'")) <> 0
			И ЭлементФормы.Родитель <> Неопределено Тогда
			
			РазмещениеКоманд.Добавить(ЭлементФормы.Родитель);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РазмещениеКоманд;
	
КонецФункции

Функция ДобавитьКомандуФункциональнойМодели(Форма, МестоРазмещенияКоманд, НомерКоманды, ТолькоВоВсехДействиях, Действие)
	
	ИмяКоманды = МестоРазмещенияКоманд.Имя + "КомандаСППР" + Формат(НомерКоманды, "ЧГ=0");
	
	КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие = Действие; // Универсальный обработчик.
	КомандаФормы.Заголовок = НСтр("ru = 'Функциональная модель'");
	КомандаФормы.Подсказка = НСтр("ru = 'Функциональная модель'");
	КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
	
	НовыйЭлемент = Форма.Элементы.Добавить(МестоРазмещенияКоманд.Имя + ИмяКоманды, Тип("КнопкаФормы"), МестоРазмещенияКоманд);
	НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.ТолькоВоВсехДействиях = ТолькоВоВсехДействиях;
	НовыйЭлемент.Картинка = БиблиотекаКартинок["ФункциональнаяМодель"];
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	
	Возврат ИмяКоманды;
	
КонецФункции

Функция НеТребуютсяКомандыИнтеграцииССППР(Форма)
	
	Если НЕ упоФункцииОбщегоНазначенияСервер.упоПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюССППР")
		ИЛИ НЕ ПравоДоступа("Просмотр", Метаданные.Обработки["ИнтеграцияССППР"])
		ИЛИ Форма.ИмяФормы = "Обработка.ИнтеграцияССППР.Форма.ФункциональнаяМодель"
		ИЛИ Найти(Форма.ИмяФормы, "Справочник.ЭлементыФинансовыхОтчетов") <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ИзменитьЗаголовкиВводаНаОснованииРегистрацииЮрУсловийДоговора(Элементы)
	
	ЭУСоздатьРегистрациюЮрУсловийНаОсновании = Элементы.Найти("ФормаДокументупоРегистрацияЮридическихУсловийДоговораСоздатьНаОсновании");
	Если НЕ ЭУСоздатьРегистрациюЮрУсловийНаОсновании = Неопределено Тогда
		ЭУСоздатьРегистрациюЮрУсловийНаОсновании.Заголовок = НСтр("ru = 'Дополнительное соглашение'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверкаУпрощеннойФормыПоПравамПользователя(Форма)
	
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	
	Если Справочники.Проекты.ЕстьОграничениеРолейНаПросмотрРедактированиеПроектов() Тогда
		
		Кнопка = Элементы.Найти("ФормаСправочникПроектыОткрытьКарточкуПроекта");
		Если Кнопка <> Неопределено Тогда
			Кнопка.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Кнопка = Элементы.Найти("ФормаИмпортИзMSProject");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Видимость = РольДоступна("упоИмпортИзMSProject");
	КонецЕсли;
	
	Кнопка = Элементы.Найти("ФормаЭкспортВMSProject");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Видимость = РольДоступна("упоЭкспортВMSProject");
	КонецЕсли;
	
	Если Не ПравоДоступа("Чтение", Метаданные.Справочники.упоСотрудники) Тогда
		КолонкаСписка = Элементы.Найти("РуководительПроекта");
		Если КолонкаСписка <> Неопределено Тогда
			КолонкаСписка.Видимость = Ложь;
		КонецЕсли;
		
		КолонкаСписка = Элементы.Найти("КураторПроекта");
		Если КолонкаСписка <> Неопределено Тогда
			КолонкаСписка.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	КолонкаСписка = Элементы.Найти("ПортфельПроектов");
	Если КолонкаСписка <> Неопределено Тогда
		КолонкаСписка.Видимость = ПравоДоступа("Чтение", Метаданные.Справочники.упоПортфелиПроектов);
	КонецЕсли;
	
	КолонкаСписка = Элементы.Найти("ПрограммаПроектов");
	Если КолонкаСписка <> Неопределено Тогда
		КолонкаСписка.Видимость = ПравоДоступа("Чтение", Метаданные.Справочники.упоПрограммыПроектов);
	КонецЕсли;
	
	КолонкаСписка = Элементы.Найти("Подразделение");
	Если КолонкаСписка <> Неопределено Тогда
		КолонкаСписка.Видимость = ПравоДоступа("Чтение", Метаданные.Справочники.упоПодразделения);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПараметрыВыбораДляДопРеквизитаСТипомПроекты(Форма)
	
	ЭлементыФормы = Форма.Элементы;
	
	ОписаниеТиповПроекты = Новый ОписаниеТипов("СправочникСсылка.Проекты");
	
	ШаблонПоискаДополнительныхРеквизитов = "ДополнительныйРеквизитЗначение";
	РеквизитыФормы = Форма.ПолучитьРеквизиты();
	Для каждого Реквизит Из РеквизитыФормы Цикл
		ИмяРеквизита = Реквизит.Имя;
		
		Если СтрНайти(ИмяРеквизита, ШаблонПоискаДополнительныхРеквизитов) <> 0 Тогда
			Если Реквизит.ТипЗначения <> ОписаниеТиповПроекты Тогда
				Продолжить;
			КонецЕсли;
			
			НайденныйЭлемент = ЭлементыФормы.Найти(ИмяРеквизита);
			Если НайденныйЭлемент = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыВыбора = Новый Массив;
			ЗначениеПараметровВыбора = Новый ПараметрВыбора("Отбор.ЭтоГруппа", Ложь);
			ПараметрыВыбора.Добавить(ЗначениеПараметровВыбора);
			НайденныйЭлемент.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработкаФормВебКлиента

Процедура ПолучитьПодчиненныеКнопкиРекурсивно(ГруппаЭлементов, МассивКнопок)
	
	Для Каждого ЭлементГруппы Из ГруппаЭлементов Цикл
		Если ТипЗНЧ(ЭлементГруппы) = Тип("ГруппаФормы") Тогда
			ПолучитьПодчиненныеКнопкиРекурсивно(ЭлементГруппы.ПодчиненныеЭлементы, МассивКнопок);
		ИначеЕсли ТипЗнч(ЭлементГруппы) = Тип("КнопкаФормы") Тогда
			МассивКнопок.Добавить(ЭлементГруппы);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Функция ЭтоИзменениеСтиляДляФормыДокументооборота(Форма)
	
	ЭтоФормаДокументооборота = Ложь;
	Если Форма.ИмяФормы = "Обработка.ИнтеграцияС1СДокументооборот.Форма.СозданиеБизнесПроцесса" Тогда
		ИмяКнопки = "СоздатьПроцесс";
		ЭтоФормаДокументооборота = Истина;
	ИначеЕсли Форма.ИмяФормы = "Обработка.ИнтеграцияС1СДокументооборот.Форма.ВыборТипаПредмета" Тогда
		ИмяКнопки = "КомандаВыбрать";
		ЭтоФормаДокументооборота = Истина;
	КонецЕсли;
	
	Если ЭтоФормаДокументооборота
		И упоИнтеграцияКлиентСервер.ИспользуетсяСтильОформленияITLand() Тогда
		Форма.Элементы[ИмяКнопки].ЦветТекста = ЦветаСтиля.ЦветТекстаКнопки;
	КонецЕсли;
	
	Возврат ЭтоФормаДокументооборота;
	
КонецФункции

Процедура ОбъектПередЗаписью_Проекты(Объект, Отказ)
	
	Если Не ТипЗнч(Объект) = Тип("СправочникОбъект.Проекты") Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНовый = Объект.ЭтоНовый();
	ЭтоПроект = Не Объект.ЭтоПроектнаяЗадача;
	
	Объект.ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый);
	
	Если ЭтоНовый Тогда
		// Если объект новый, тогда он относится к текущей версии проекта.
		Объект.ТекущаяВерсия = Истина;
	КонецЕсли;
	
	Если ЭтоПроект Тогда
		Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
			упоФазыПроектаСервер.ПроверитьИсправитьФазыПроекта(Объект, Отказ);
		КонецЕсли;
		
		Если ЭтоНовый И Не ЗначениеЗаполнено(Объект.упоШифр) Тогда
			Объект.УстановитьНовыйКод();
			Объект.упоШифр = Объект.Код;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбъектПриКопировании_Проекты(Объект, ОбъектКопирования)
	
	Если Не ТипЗнч(Объект) = Тип("СправочникОбъект.Проекты") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		
		Объект.Фазы.Очистить();
		Объект.упоТекущаяФаза = Справочники.упоФазыПроектов.ПустаяСсылка();
		
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		
		ТекущаяДата = ТекущаяДатаСеанса();
		
		Объект.Завершен = Ложь;
		Объект.ПлановаяДатаНачала = ТекущаяДата;
		Объект.ПлановаяДатаОкончания = ТекущаяДата;
		Объект.ДатаНачала = ТекущаяДата;
		Объект.ДатаОкончания = ТекущаяДата;
		
	КонецЕсли;
	
	Объект.упоШифр = "";
	
КонецПроцедуры

Процедура ПослеЗаписиНаСервере_РабочиеКалендари(СостИмени, Форма)
	
	Если Не упоРаботаСФормамиКлиентСервер.ЭтоФормаРабочегоКалендаря(СостИмени) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКалендарь = упоРаботаСФормамиКлиентСервер.ИмяРеквизитаКалендарь(СостИмени);
	ИмяКоманды = упоРаботаСФормамиКлиентСервер.ИмяЭлемента_КомандаОптимизироватьРабочиеКалендари();
	НуженРасчетСдвигов = упоРабочиеКалендариВызовСервера.НуженРасчетСдвигов(Форма.Объект[ИмяРеквизитаКалендарь]);
	
	Форма.Элементы[ИмяКоманды].Видимость = НуженРасчетСдвигов;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_РабочиеКалендари(СостИмени, Форма)
	
	Если Не упоРаботаСФормамиКлиентСервер.ЭтоФормаРабочегоКалендаря(СостИмени) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизитаКалендарь = упоРаботаСФормамиКлиентСервер.ИмяРеквизитаКалендарь(СостИмени);
	НуженРасчетСдвигов = упоРабочиеКалендариВызовСервера.НуженРасчетСдвигов(Форма.Объект[ИмяРеквизитаКалендарь]);
	
	ИмяКоманды = упоРаботаСФормамиКлиентСервер.ИмяЭлемента_КомандаОптимизироватьРабочиеКалендари();
	
	НоваяКомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКомандаФормы.Действие = "Подключаемый_" + ИмяКоманды;
	НоваяКомандаФормы.Заголовок = НСтр("ru = 'Нужна оптимизация расчета сроков'");
	НоваяКомандаФормы.Подсказка = НСтр("ru = 'Рассчитать сдвиги сроков для ускорения алгоритма расчета сроков'");
	
	Элемент_Команда = Форма.Элементы.Добавить(ИмяКоманды,
			Тип("КнопкаФормы"),
			Форма.Элементы.ФормаКоманднаяПанель);
	
	Элемент_Команда.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Элемент_Команда.ЦветТекста = WebЦвета.Красный;
	Элемент_Команда.Шрифт = Новый Шрифт( , , Истина);
	Элемент_Команда.ИмяКоманды = ИмяКоманды;
	Элемент_Команда.Видимость = НуженРасчетСдвигов;
	
КонецПроцедуры

Процедура УстановитьВидимостьКомандВерсионированияДополнительныхРеквизитов(СостИмени, Форма)
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалВерсионированиеДопРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	Если Не СостИмени.ТипМетаданных = "Справочник" Тогда
		Возврат;
	КонецЕсли;

	ПустаяСсылка = Справочники[СостИмени.ВидМетаданных].ПустаяСсылка();
	ТипСсылки = ТипЗнч(ПустаяСсылка);

	ОписаниеТипов_упоВладелецВерсионируемыхСвойств = Метаданные.ОпределяемыеТипы.упоВладелецВерсионируемыхСвойств.Тип;
	Если Не ОписаниеТипов_упоВладелецВерсионируемыхСвойств.СодержитТип(ТипСсылки) Тогда
		Возврат;
	КонецЕсли;

	Элементы = Форма.Элементы;

	Если Элементы.Найти("ФормаупоВерсииДополнительныхРеквизитов") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИспользоватьДополнительныеРеквизиты = Константы.ИспользоватьДополнительныеРеквизитыИСведения.Получить();

	ИмяНабораДополнительныхРеквизитов = СостИмени.ТипМетаданных + "_" + СостИмени.ВидМетаданных;
	ИспользуетсяНаборДополнительныхРеквизитов = 
		Справочники.НаборыДополнительныхРеквизитовИСведений[ИмяНабораДополнительныхРеквизитов].Используется;

	СвойстваОбъекта = УправлениеСвойствами.СвойстваОбъекта(ПустаяСсылка, Истина, Ложь);

	Элементы.ФормаупоВерсииДополнительныхРеквизитов.Видимость = ИспользоватьДополнительныеРеквизиты
																	И ИспользуетсяНаборДополнительныхРеквизитов
																	И ЗначениеЗаполнено(СвойстваОбъекта);

КонецПроцедуры

#КонецОбласти