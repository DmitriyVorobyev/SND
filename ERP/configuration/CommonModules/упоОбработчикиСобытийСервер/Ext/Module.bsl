// Обработчик события, вызываемый при создании объекта на сервере.
//
// Параметры:
//  ЭтаФорма							 - УправляемаяФорма	 - форма, для который вызывается обработчик.
//  ОбъектФормы							 - ДокументОбъект, СправочникОбъект, ОбработкаОбъект, ОтчетОбъект	 - записываемый объект.
//  Отказ								 - Булево	 - признак отказа от выполнения действия.
//  СтандартнаяОбработка				 - Булево	 - признак стандартной обработки.
//  ВыводитьСообщенияОРазграниченииПрав	 - Булево	 - признак необходимости выводить сообщения о разграничении прав,
//  	проверяемых в функции "упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения", пользователю.
//  	По умолчанию сообщения регистрируются только в журнале регистрации.
//  ПроверятьРазграничениеДоступа		 - Булево	 - признак необходимости проверки прав разграничения.
//
Процедура ФормаПриСозданииНаСервере(ЭтаФорма, ОбъектФормы = Неопределено, Отказ, СтандартнаяОбработка,
		ВыводитьСообщенияОРазграниченииПрав = Ложь, ПроверятьРазграничениеДоступа = Истина) Экспорт
	
	СостИмени = упоФункцииОбщегоНазначенияКлиентСервер.СоставИмениФормы(ЭтаФорма.ИмяФормы);
	
	Если ЭтоИзменениеСтиляДляФормыДокументооборота(ЭтаФорма) Тогда
		Возврат;
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		ДобавитьКомандыИнтеграцииССППР(ЭтаФорма);
	КонецЕсли;
	
	Если ПроверятьРазграничениеДоступа И ТипЗнч(ОбъектФормы) = Тип("ДанныеФормыСтруктура") И ОбъектФормы.Свойство("Ссылка") И Не ЭтаФорма.ТолькоПросмотр Тогда
		Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектФормы.Ссылка)) Тогда
			Если НЕ упоУправлениеФормамиСервер.ЭтоНовый(ЭтаФорма) Тогда
				ЭтаФорма.ТолькоПросмотр = упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(ОбъектФормы, , , , ВыводитьСообщенияОРазграниченииПрав);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	упоИнтеграцияEPMСервер.ДобавитьЭлементыФормыКонтрагентов(ЭтаФорма, Отказ);
	
	ЭтоСправочникПроекты = СостИмени.ТипМетаданных = "Справочник" И СостИмени.ВидМетаданных = "Проекты";
	
	ЭтоФормаВыбора = Ложь; 
	Если ЭтаФорма.Параметры.Свойство("РежимВыбора") И ЗначениеЗаполнено(ЭтаФорма.Параметры.РежимВыбора) Тогда
		ЭтоФормаВыбора = ЭтаФорма.Параметры.РежимВыбора;	
	КонецЕсли;

	Если ТипЗнч(ОбъектФормы) = Тип("ДинамическийСписок") И Не ЭтоСправочникПроекты И Не ЭтоФормаВыбора Тогда
		
		Если НЕ СтрЧислоВхождений(ЭтаФорма.ИмяФормы, "Справочник.упоШаблоныПроектныхЗадач") Тогда
			
			ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
			Если ОбъектФормы.Отбор.ДоступныеПоляОтбора.НайтиПоле(ПолеПроект) <> Неопределено Тогда
				
				ИндексОтбора = Неопределено;
				ОтборПоПроекту = Неопределено;
				ПолеКомпоновкиПроект = Новый ПолеКомпоновкиДанных("Проект");
				Для Каждого ЭлементОтбора Из ОбъектФормы.Отбор.Элементы Цикл
					Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиПроект Тогда
						ОтборПоПроекту = ЭлементОтбора;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Использование = Истина;
				Если ЭтаФорма.Параметры.Свойство("Проект") Тогда
					Проект = ЭтаФорма.Параметры.Проект;
				ИначеЕсли ЭтаФорма.Параметры.Свойство("Отбор") И ЭтаФорма.Параметры.Отбор.Свойство("Проект") Тогда
					Проект = ЭтаФорма.Параметры.Отбор.Проект;
				ИначеЕсли ЭтаФорма.Параметры.Свойство("Отбор") И ЭтаФорма.Параметры.Отбор.Свойство("Владелец")
					И ТипЗнч(ЭтаФорма.Параметры.Отбор.Владелец) = Тип("СправочникСсылка.Проекты") Тогда
					Проект = ЭтаФорма.Параметры.Отбор.Владелец;
				Иначе
					Проект = ПараметрыСеанса.упоТекущийПроект;
					Использование = ЗначениеЗаполнено(Проект);
				КонецЕсли;
				Если ЭтаФорма.Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(ЭтаФорма.Параметры.ТекущаяСтрока) Тогда
					Использование = Ложь;
				КонецЕсли;
				
				Если ОтборПоПроекту = Неопределено Тогда
					ОтборПоПроекту = ОбъектФормы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					ОтборПоПроекту.ЛевоеЗначение = ПолеПроект;
				КонецЕсли;
				ОтборПоПроекту.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ОтборПоПроекту.ПравоеЗначение = Проект;
				ОтборПоПроекту.Использование = Использование;
				
				ИндексОтбора = ОбъектФормы.Отбор.Элементы.Индекс(ОтборПоПроекту);
				
				ЭлементРодитель = ЭтаФорма.Элементы.Найти("Список");
				
				Если ЭлементРодитель <> Неопределено Тогда
					ДобавитьЭлементОтбораНаФорму(ЭтаФорма, ЭлементРодитель, , ИндексОтбора);
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			ПолеВладелец = Новый ПолеКомпоновкиДанных("Владелец");
			Если ОбъектФормы.Отбор.ДоступныеПоляОтбора.НайтиПоле(ПолеВладелец) <> Неопределено Тогда
				
				ОтборПоПроекту = ОбъектФормы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ОтборПоПроекту.ЛевоеЗначение = ПолеВладелец;
				ОтборПоПроекту.Использование = Ложь;
				ОтборПоПроекту.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ЭлементРодитель = ЭтаФорма.Элементы.Найти("Список");
				
				ИндексОтбора = ОбъектФормы.Отбор.Элементы.Индекс(ОтборПоПроекту);
				
				Если ЭлементРодитель <> Неопределено Тогда
					ДобавитьЭлементОтбораНаФорму(ЭтаФорма, ЭлементРодитель, Ложь, ИндексОтбора);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ЭтоСправочникПроекты Тогда
		
		ПроверкаУпрощеннойФормыПоПравамПользователя(ЭтаФорма);
		
	КонецЕсли;
	
	Если ТипЗнч(ОбъектФормы) = Тип("ДанныеФормыСтруктура") И ОбъектФормы.Свойство("Ссылка") Тогда
		
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
			Или упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2() Тогда
			
			СписокОбъектовСДоговорамиЕРМ = ПолучитьПолныйСписокОбъектовЕРМ();
			
			ОтборПоТипу = Новый Структура;
			ОтборПоТипу.Вставить("ТипЗначенияОбъекта", ТипЗнч(ОбъектФормы.Ссылка));
			
			НайденныеСтроки = СписокОбъектовСДоговорамиЕРМ.НайтиСтроки(ОтборПоТипу);
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Контрагент", НайденнаяСтрока.ПутьКДанным);
				
				МассивСвязей = Новый Массив;
				МассивСвязей.Добавить(НоваяСвязь);
				НовыеСвязи = Новый ФиксированныйМассив(МассивСвязей);
				Если ЭтаФорма.Элементы.Найти(НайденнаяСтрока.ЭлементУ) <> Неопределено Тогда
					ЭтаФорма.Элементы[НайденнаяСтрока.ЭлементУ].СвязиПараметровВыбора = НовыеСвязи;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СостИмени.ВидМетаданных = "упоРегистрацияЮридическихУсловийДоговора" Тогда
		ИзменитьЗаголовкиВводаНаОснованииРегистрацииЮрУсловийДоговора(ЭтаФорма.Элементы);
	КонецЕсли;
	
	ПриСозданииНаСервере_РабочиеКалендари(СостИмени, ЭтаФорма);
	
	упоИнтеграцияEPMСервер.УстановитьВидимостьЭлементовВРежимеИнтеграции(ЭтаФорма);
	
	УстановитьВидимостьКомандВерсионированияДополнительныхРеквизитов(СостИмени, ЭтаФорма);
	
	Если ТипЗнч(ОбъектФормы) = Тип("ДанныеФормыСтруктура") И ОбъектФормы.Свойство("Ссылка") Тогда
		ИспользуютсяДопРеквизиты = УправлениеСвойствами.ИспользоватьДопРеквизиты(ОбъектФормы.Ссылка);
		Если ИспользуютсяДопРеквизиты Тогда
			УстановитьПараметрыВыбораДляДопРеквизитаСТипомПроекты(ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

