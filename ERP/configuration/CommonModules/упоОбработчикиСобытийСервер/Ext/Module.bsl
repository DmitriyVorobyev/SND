// Обработчик события "Обработка проверки заполнения" объекта.
//
// Параметры:
//  Объект		 - Произвольный	 - объект, для которого вызывается событие.
//  ПроверяемыеРеквизиты		 - Массив	 - массив проверяемых реквизитов.
//  Отказ	 - Булево		 - признак отказа при проверке реквизитов.
//
Процедура ОбъектОбработкаПроверкиЗаполнения(Объект, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Если ТипЗнч(Объект) = Тип("СправочникОбъект.Проекты") Тогда
		Если Объект.ЭтоПроектнаяЗадача Тогда
			ИндексЭлемента = ПроверяемыеРеквизиты.Найти("Компонент");
			Если ИндексЭлемента <> Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(ИндексЭлемента);
			КонецЕсли;
		КонецЕсли;
		
		Если упоИнтеграцияEPMСервер.ИспользоватьПодсистемуРаспределениеЗарплаты() Тогда
			Если Объект["упоРежимУчетаВзносов"] = 1 Тогда
				ПроверяемыеРеквизиты.Добавить("упоСтатьяРасходовВзносов");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработкаФормВебКлиента

// Функция принудительно выставляет признак отображения кнопок только во всех действиях.
// Используется для отрисовки кнопок на панелях форм в веб-клиенте.
//
// Параметры:
//  ГруппаКнопки - ГруппаФормы - содержит группу кнопок, надо которыми производится действие.
//  НомерКнопки - Число - номер кнопки, начиная с которой кнопки отображаются только во всех действиях.
//  ОставитьПоследние - Число - количество последних кнопок, которые необходимо оставить на панели (актуально для справки).
//
Процедура УбратьАвтоКнопкиПринудительно(ГруппаКнопки, НомерКнопки, ОставитьПоследние = 0) Экспорт
	
	МассивКнопок = Новый Массив();
	ПолучитьПодчиненныеКнопкиРекурсивно(ГруппаКнопки.ПодчиненныеЭлементы, МассивКнопок);
	
	ПоследняяКнопка = МассивКнопок.Количество() - 1 - ОставитьПоследние;
	Для сч = НомерКнопки По ПоследняяКнопка Цикл
		МассивКнопок[сч].ТолькоВоВсехДействиях = Истина;
	КонецЦикла;
	
	МассивКнопок = Неопределено;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

