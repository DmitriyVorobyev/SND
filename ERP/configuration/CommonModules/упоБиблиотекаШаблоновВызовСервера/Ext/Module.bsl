// Модуль проверки на факты по проекту.
// 
// Параметры:
//  Проект - СправочникСсылка.Проекты - проект.
// 
// Возвращаемое значение:
//  Булево - признак наличия факта.
// 
Функция ПроверитьПланФактПроекта(Проект)
	
	ЗадачиСписанФакт = упоПроектыИЗадачиСервер.ПолучитьЗадачиСписанФакт(Проект);
	
	ЕстьФактПоПроекту = ЗадачиСписанФакт.Количество() = 0;
	
	Возврат ЕстьФактПоПроекту;
	
КонецФункции

// Модуль очистки проекта.
// 
// Параметры:
//  Проект    - СправочникСсылка.Проекты - проект.
//  Индикатор - Форма - индикатор выполнения процесса (прогресс бар).
// 
// Возвращаемое значение:
//  Булево - признак выполнения операции.
// 
Функция ОчиститьПроект(Проект, Индикатор)
	
	ЭтоФакт = ПроверитьПланФактПроекта(Проект);
	
	Если ЭтоФакт = Истина Тогда
		Возврат Истина;
	КонецЕсли;
			
	Успех = упоПроектыИЗадачиСервер.ОчиститьПроект(Проект);
	
	Возврат Не Успех;
	
КонецФункции

// Модуль записи проектной задачи в реальный проект по данным шаблона проекной задачи.
