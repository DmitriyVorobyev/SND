//  Индикатор           - Форма - индикатор выполнения процесса (прогресс бар).
//  Журнал 				- РегистрСведенийНаборЗаписей - для фиксации связей между объектами.
// 
// Возвращаемое значение:
//  ДокументСсылка.упоПроектнаяЗадача - ссылка на созданную проектную задачу.
// 
Функция ЗаписатьДанныеЗадачиВПроект(Проект, ЗадачаРодитель, ДанныеШаблона, ДанныеШаблонаЗадачи, Индикатор,
	Журнал = Неопределено, Контрагенты = Неопределено)
	
	// Создание и запись новой проектной задачи по заданным параметрам.
	
	// Создадим новую задачу в проекте.
	Задача = Документы.упоПроектнаяЗадача.СоздатьДокумент();
	
	// Заполним необходимые данные.
	ЗаполнитьЗначенияСвойств(Задача, ДанныеШаблонаЗадачи);
	
	Задача.Дата 						= ТекущаяДата();
	Задача.НазваниеПроектнойЗадачи 		= ДанныеШаблонаЗадачи.НазваниеЗадачи;
	Задача.ОбновлятьДатуДокумента 		= Истина;
	Задача.Проект 						= Проект;
	Задача.ЗадачаРодитель 				= ЗадачаРодитель;
		
	Если ДанныеШаблонаЗадачи.РучнойВводСроков И НЕ ЗначениеЗаполнено(ДанныеШаблонаЗадачи.ДатаНачалаПлан) Тогда
		
		Задача.РучнойВводСроков = Ложь;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru = 'У задачи ""%1"" не заполнена плановая дата начала! Режим ввода сроков изменен на автоматический.'");
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение.Текст, Задача.НазваниеПроектнойЗадачи);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	Если ДанныеШаблонаЗадачи.РучнойВводСроков И НЕ ЗначениеЗаполнено(ДанныеШаблонаЗадачи.ДатаЗавершенияПлан) Тогда
		
		Задача.РучнойВводСроков = Ложь;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'У задачи ""%1"" не заполнена плановая дата завершения! Режим ввода сроков изменен на автоматический.'");
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение.Текст, Задача.НазваниеПроектнойЗадачи);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	// Отбор по заданному шаблону задачи.
	Отбор = Новый Структура("Задача", ДанныеШаблонаЗадачи.Задача);
	
	// Определим состав материальных ресуров для новой задачи.
	МатРесурсы = ДанныеШаблона.ТаблицаМатРесурсовЗадач.НайтиСтроки(Отбор);
	Для Каждого МатРесурс Из МатРесурсы Цикл
		
		НоваяСтрока = Задача.МатериальныеРесурсы.Добавить();
		
		НоваяСтрока.Ресурс               = МатРесурс.Ресурс;
		НоваяСтрока.ЕдиницаНормирования  = МатРесурс.ЕдиницаНормирования;
		НоваяСтрока.Количество           = МатРесурс.Количество;
		НоваяСтрока.Стоимость            = МатРесурс.СтоимостьЕд;
		НоваяСтрока.ОбщСтоимость         = МатРесурс.Стоимость;
		НоваяСтрока.ИндексСтрокРаспределения = МатРесурс.ИндексСтрокРаспределения;
		НоваяСтрока.Контрагент        	 = МатРесурс.Контрагент;
		НоваяСтрока.СпособПривязкиПотребности = МатРесурс.СпособПривязкиПотребности;
		НоваяСтрока.ЗадержкаЗаказа       = МатРесурс.ЗадержкаЗаказа;
		НоваяСтрока.Валюта        		 = МатРесурс.Валюта;
		НоваяСтрока.Договор        		 = МатРесурс.Договор;
		НоваяСтрока.СтатьяЗатрат 		 = МатРесурс.СтатьяЗатрат;
		НоваяСтрока.ПрофильРаспределения = МатРесурс.ПрофильРаспределения;
		НоваяСтрока.СпособПривязки       = МатРесурс.СпособПривязки;
		НоваяСтрока.ДатаПривязки         = МатРесурс.ДатаПривязки;
		
	КонецЦикла;
	
	// Определим состав субпродуктов для новой задачи.
	ЭтоЗадачаПроектнойПродукции = ДанныеШаблонаЗадачи.ТипСубпродукта = 
		ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипСубпродукта.ПроектнаяПродукция");
		
	Субпродукты = ДанныеШаблона.ТаблицаСубпродуктовЗадач.НайтиСтроки(Отбор);
	
	Если ЭтоЗадачаПроектнойПродукции Тогда		
		СоответствиеШаблоновПП =  ПолучитьШаблоныППДляСубпродуктов(Субпродукты, ДанныеШаблонаЗадачи.Задача, Ложь);
	КонецЕсли;
	
	Для Каждого Субпродукт Из Субпродукты Цикл
		
		Если УдаленаСтрокаПроектнойПродукции(ЭтоЗадачаПроектнойПродукции, СоответствиеШаблоновПП, Субпродукт, 
			ДанныеШаблона.ТаблицаРаспределениеОбъемовЗадач) Тогда			
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Задача.Субпродукты.Добавить();
		
		НоваяСтрока.Ресурс               = Субпродукт.Ресурс;
		НоваяСтрока.ЕдиницаНормирования  = Субпродукт.ЕдиницаНормирования;
		НоваяСтрока.Количество           = Субпродукт.Количество;
		НоваяСтрока.Стоимость            = Субпродукт.СтоимостьЕд;
		НоваяСтрока.ОбщСтоимость         = Субпродукт.Стоимость;
		НоваяСтрока.ИндексСтрокРаспределения = Субпродукт.ИндексСтрокРаспределения;
		НоваяСтрока.Контрагент        	 = Субпродукт.Контрагент;
		НоваяСтрока.СпособПривязкиВыпуска= Субпродукт.СпособПривязкиВыпуска;
		НоваяСтрока.ЗадержкаЗаказа       = Субпродукт.ЗадержкаЗаказа;
		НоваяСтрока.Скорость       		 = Субпродукт.Скорость;
		НоваяСтрока.Коэффициент    		 = Субпродукт.Коэффициент;
		НоваяСтрока.Валюта        		 = Субпродукт.Валюта;
		НоваяСтрока.Договор        		 = Субпродукт.Договор;
		НоваяСтрока.СтатьяДоходов 		 = Субпродукт.СтатьяДоходов;
		НоваяСтрока.ПрофильРаспределения = Субпродукт.ПрофильРаспределения;
		НоваяСтрока.СпособПривязки       = Субпродукт.СпособПривязки;
		НоваяСтрока.ДатаПривязки         = Субпродукт.ДатаПривязки;
		
		Если ЭтоЗадачаПроектнойПродукции Тогда	
			НоваяСтрока.Нормирование  	 		= Субпродукт.Нормирование;
			НоваяСтрока.Трудоемкость    		= Субпродукт.Трудоемкость;
			НоваяСтрока.КоэффициентСложности  	= Субпродукт.КоэффициентСложности;
			НоваяСтрока.СкоростьВыполнения  	= Субпродукт.СкоростьВыполнения;
		КонецЕсли
		
	КонецЦикла;

	// Определим параметры и трудовые ресурсы для модели пакета работ.
	
	Задача.ДлительностьМоделиПакетаРабот 			= ДанныеШаблонаЗадачи.ДлительностьМоделиПакетаРабот;
	Задача.ЕдиницаНормированияДлительности 			= ДанныеШаблонаЗадачи.ЕдиницаНормированияДлительности;
	Задача.НормаСтоимостиТрудовыхРесурсов 			= ДанныеШаблонаЗадачи.НормаСтоимостиТрудовыхРесурсов;
	Задача.ВнешняяНормаСтоимостиТрудовыхРесурсов 	= ДанныеШаблонаЗадачи.ВнешняяНормаСтоимостиТрудовыхРесурсов;
	Задача.ВидОперации 								= ДанныеШаблонаЗадачи.ВидОперации;
	Задача.МетодРасчетаМоделиПакетаРабот 			= Перечисления.упоМетодРасчетаСроковМоделиПакетаРабот.ПоДлительности;
	Задача.ДлительностьБезУчетаКалендаряПроекта 	= ДанныеШаблонаЗадачи.ДлительностьБезУчетаКалендаряПроекта;
	
	ТрудовыеРесурсы = ДанныеШаблона.ТаблицаТрудовыхРесурсовЗадач.НайтиСтроки(Отбор);
	Для каждого СтрокаРесурс Из ТрудовыеРесурсы Цикл
		
		НоваяСтрока 					 = Задача.ТрудовыеРесурсы.Добавить();
		НоваяСтрока.ЕдиницаНормирования  = СтрокаРесурс.ЕдиницаНормирования;
		НоваяСтрока.УровеньПланирования  = СтрокаРесурс.УровеньПланирования;
		НоваяСтрока.Количество 			 = СтрокаРесурс.Количество;
		НоваяСтрока.ОбщСтоимость 		 = СтрокаРесурс.Стоимость;
		НоваяСтрока.ПрофильРаспределения = СтрокаРесурс.ПрофильРаспределения;
		НоваяСтрока.Ресурс 				 = СтрокаРесурс.Ресурс;
		НоваяСтрока.Подразделение 		 = СтрокаРесурс.Подразделение;
		НоваяСтрока.Стоимость 			 = СтрокаРесурс.СтоимостьЕд;
		НоваяСтрока.Основной 			 = СтрокаРесурс.Основной;
		Если НЕ ДанныеШаблона.ТаблицаТрудовыхРесурсовЗадач.Колонки.Найти("СтоимостьЕдВнешняя") = Неопределено Тогда
			НоваяСтрока.ВнешняяСтоимость = СтрокаРесурс.СтоимостьЕдВнешняя;
		КонецЕсли;
		Если НЕ ДанныеШаблона.ТаблицаТрудовыхРесурсовЗадач.Колонки.Найти("ВнешняяСтоимость") = Неопределено Тогда
			НоваяСтрока.ОбщВнешняяСтоимость = СтрокаРесурс.ВнешняяСтоимость;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ПрофильРаспределения) Тогда
			НоваяСтрока.ПрофильРаспределения = Справочники.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.СпособПривязки) Тогда
			НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;
		КонецЕсли;
		НоваяСтрока.ИсточникПлана = СтрокаРесурс.ИсточникПлана;
	КонецЦикла;
	
	// Определяем дополнительные затраты по проектной задаче.
	
	ДопЗатраты = ДанныеШаблона.ТаблицаДопЗатратЗадач.НайтиСтроки(Отбор);
	Для каждого СтрокаЗатрат Из ДопЗатраты Цикл
		НоваяСтрока 			 = Задача.ДополнительныеЗатраты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗатрат, , "КонтрагентДоходовРасходов");
		
		СтрокаКонтрагент = Контрагенты.Найти(СтрокаЗатрат.КонтрагентДоходовРасходов, "ШаблонКонтрагента");
		Если НЕ СтрокаКонтрагент = Неопределено Тогда
			НоваяСтрока.КонтрагентДоходовРасходов = СтрокаКонтрагент.Контрагент;
		КонецЕсли;
	КонецЦикла; 
	
	// Определяем финансовые планы проектной задачи.
	
	ПрофильПоУмолчанию = Неопределено;
	ВыборкаПрофилей = Справочники.упоПрофилиРаспределенияДоходовИРасходов.Выбрать();
	Если ВыборкаПрофилей.Следующий() Тогда
		ПрофильПоУмолчанию = ВыборкаПрофилей.Ссылка;
	КонецЕсли;
	
	ФинПланы = ДанныеШаблона.ТаблицаФинПлановЗадач.НайтиСтроки(Отбор);
	Для каждого СтрокаФинПлан Из ФинПланы Цикл
		
		// Пробуем найти контрагента.
		Контрагент = Неопределено;
		Договор = Неопределено;
		СтрокаКонтрагент = Контрагенты.Найти(СтрокаФинПлан.Контрагент, "ШаблонКонтрагента");
		Если Не СтрокаКонтрагент = Неопределено Тогда
			Контрагент = СтрокаКонтрагент.Контрагент;
			Договор = СтрокаКонтрагент.Договор;
		КонецЕсли; 
		
		Если СтрокаФинПлан.ВидЭлемента = "Доходы" Или СтрокаФинПлан.ВидЭлемента = "Расходы" Тогда
			
			Если Не ЗначениеЗаполнено(СтрокаФинПлан.Профиль) И Не ЗначениеЗаполнено(ПрофильПоУмолчанию) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаФинПлан.ВидЭлемента = "Доходы" Тогда
				СтрокаФинПланЗадачи = Задача.ПланДоходов.Добавить();
			ИначеЕсли СтрокаФинПлан.ВидЭлемента = "Расходы" Тогда
				СтрокаФинПланЗадачи = Задача.ПланРасходов.Добавить();
				СтрокаФинПланЗадачи.ЭтоРольТрудовогоРесурса = СтрокаФинПлан.ЭтоРольТрудовогоРесурса;
			КонецЕсли; 
			
			СтрокаФинПланЗадачи.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
			Если НЕ ЗначениеЗаполнено(СтрокаФинПлан.Профиль) Тогда
				СтрокаФинПланЗадачи.ПрофильРаспределения = ПрофильПоУмолчанию;
			Иначе
				СтрокаФинПланЗадачи.ПрофильРаспределения = СтрокаФинПлан.Профиль;
			КонецЕсли;
			
			СтрокаФинПланЗадачи.Статья = СтрокаФинПлан.Статья;
			СтрокаФинПланЗадачи.Валюта = СтрокаФинПлан.Валюта;
			СтрокаФинПланЗадачи.Сумма = СтрокаФинПлан.Сумма;
			СтрокаФинПланЗадачи.Контрагент = Контрагент;
			СтрокаФинПланЗадачи.Договор = Договор;
			СтрокаФинПланЗадачи.ИндексСтрокРаспределения = СтрокаФинПлан.ИндексСтрокРаспределения;
			СтрокаФинПланЗадачи.ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы;
			
		ИначеЕсли СтрокаФинПлан.ВидЭлемента = "Поступления" ИЛИ СтрокаФинПлан.ВидЭлемента = "Выплаты" Тогда
			
			// БДДС обязательно требует указания контрагента.
			
			Если Контрагент = Неопределено Тогда
				Продолжить;
			КонецЕсли; 
			
			СтрокаФинПланЗадачи = Задача.ДвиженияДенежныхСредств.Добавить();
			СтрокаФинПланЗадачи.СтатьяДДС = СтрокаФинПлан.Статья;
			СтрокаФинПланЗадачи.Валюта = СтрокаФинПлан.Валюта;
			СтрокаФинПланЗадачи.Сумма = СтрокаФинПлан.Сумма;
			СтрокаФинПланЗадачи.Контрагент = Контрагент;
			СтрокаФинПланЗадачи.Договор = СтрокаКонтрагент.Договор;
			СтрокаФинПланЗадачи.ВидПлатежа = СтрокаФинПлан.ВидПлатежа;
			
			Если СтрокаФинПлан.ВидЭлемента = "Поступления" Тогда
				СтрокаФинПланЗадачи.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление;
			ИначеЕсли СтрокаФинПлан.ВидЭлемента = "Выплаты" Тогда
				СтрокаФинПланЗадачи.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата;
			КонецЕсли; 
			
			Если СтрокаФинПлан.СпособПривязки = Перечисления.упоСпособПривязкиДДС.НаДату Тогда
				СтрокаФинПланЗадачи.СпособПривязки = Перечисления.упоСпособПривязкиДДС.НачалоЗадачи;
			Иначе
				СтрокаФинПланЗадачи.СпособПривязки = СтрокаФинПлан.СпособПривязки; 				
			КонецЕсли;
			СтрокаФинПланЗадачи.Задержка = СтрокаФинПлан.Задержка;
			СтрокаФинПланЗадачи.ПрофильРаспределения = СтрокаФинПлан.Профиль;
			СтрокаФинПланЗадачи.ИсточникПлана = Перечисления.упоИсточникПланаДДС.ДДС;
			
		КонецЕсли; 
		
	КонецЦикла; 
		
	// Получить данные распределения доходов.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеДоходовЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
		
		НоваяСтрока = Задача.РаспределениеДоходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Контрагент = Неопределено;
		СтрокаКонтрагент = Контрагенты.Найти(Строка.КонтрагентПодрядчик, "ШаблонКонтрагента");
		Если Не СтрокаКонтрагент = Неопределено Тогда
			НоваяСтрока.КонтрагентПодрядчик = СтрокаКонтрагент.Контрагент;
		КонецЕсли;
		
	КонецЦикла;
	
	// Получить данные распределения расходов.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеРасходовЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока =  Задача.РаспределениеРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	// Получить данные распределения объемов.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеОбъемовЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
				
		НоваяСтрока =  Задача.РаспределениеОбъемов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Контрагент = Неопределено;
		СтрокаКонтрагент = Контрагенты.Найти(Строка.КонтрагентПодрядчик, "ШаблонКонтрагента");
		Если НЕ СтрокаКонтрагент = Неопределено Тогда
			НоваяСтрока.КонтрагентПодрядчик = СтрокаКонтрагент.Контрагент;
		КонецЕсли;
		
	КонецЦикла;

	// Получить данные распределения потребностей.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеПотребностейЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока =  Задача.РаспределениеПотребностей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	// Получить данные распределения дополнительных затрат.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеДополнительныхЗатратЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока =  Задача.РаспределениеДополнительныхЗатрат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		СтрокаКонтрагент = Контрагенты.Найти(Строка.КонтрагентПодрядчик, "ШаблонКонтрагента");
		Если НЕ СтрокаКонтрагент = Неопределено Тогда
			НоваяСтрока.КонтрагентПодрядчик = СтрокаКонтрагент.Контрагент;
		КонецЕсли;		
	КонецЦикла;
	
	// Получить данные распределение доходов по периодам.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеДоходовПоПериодамЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока =  Задача.РаспределениеДоходовПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	// Получить данные распределение расходов по периодам.
	МассивСтрок = ДанныеШаблона.ТаблицаРаспределениеРасходовПоПериодамЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока =  Задача.РаспределениеРасходовПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	// Получить данные трудовые ресурсы по периодам.
	МассивСтрок = ДанныеШаблона.ТаблицаТрудовыеРесурсыПоПериодамЗадач.НайтиСтроки(Отбор);
	Для Каждого Строка Из МассивСтрок Цикл
		НоваяСтрока =  Задача.ТрудовыеРесурсыПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	// Не надо добавлять лишние строки при записи из шаблона.
	Задача.ДополнительныеСвойства.Вставить("упоНеПроверятьЗаполнятьТабличныеЧастиРаспределений", Истина);
	Задача.ДополнительныеСвойства.Вставить("НеЗеркалировать", Истина);
	Задача.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
	Задача.ДополнительныеСвойства.Вставить("НеПроверятьУдалениеПП", Истина);
	
	// Запишем задачу в БД в режиме проведения.
	Задача.Записать(РежимЗаписиДокумента.Запись);
	
	Если НЕ Журнал = Неопределено Тогда
		ЗаписьЖурнала = Журнал.Добавить();
		ЗаписьЖурнала.ВидОперации = Перечисления.упоОперацияБиблиотекиШаблонов.ЗаписьШаблонаВПроект;
		ЗаписьЖурнала.ОбъектПроекта = Задача.Ссылка;
		ЗаписьЖурнала.ОбъектШаблона = ДанныеШаблонаЗадачи.Задача;
		ЗаписьЖурнала.Пользователь = Пользователи.ТекущийПользователь();
		ЗаписьЖурнала.Период = ТекущаяДата(); 
	КонецЕсли; 
		
	Возврат Задача.Ссылка;
	
КонецФункции

// Базовый модуль импорта данных шаблона проекта в реальный проект.
// 
// Параметры:
//  ПараметрыИмпорта - Структура - содержит настройки пользователя:
//   * Шаблон                     - СправочникСсылка.упоШаблоныПроектов.
//   * Проект                     - СправочникСсылка.Проекты.
//   * Этап                       - ДокументСсылка.упоПроектнаяЗадача.
//   * ОчиститьПроект             - Булево.
//   * СоздатьКорневуюЗадачу      - Булево.
//   * ДатаНачала                 - Дата.
//   * КоэффициентМасштабирования - Число.
//  ДанныеШаблона    - Структура - содержит данные шаблона проекта:
//   * ТаблицаЗадач               - ТаблицаЗначений.
//   * ТаблицаПредУсловийЗадач    - ТаблицаЗначений.
//   * ТаблицаМатРесурсовЗадач    - ТаблицаЗначений.
//  Индикатор        - Форма - индикатор выполнения процесса (прогресс бар).
//  ТекстОшибки      - Строка - заполняется при возникновении ошибки.
// 
// Возвращаемое значение:
//  Булево - признак ошибки.
// 
Функция ЗаписатьДанныеШаблонаВПроект(ПараметрыИмпорта, ДанныеШаблона, Индикатор, ТекстОшибки = "")
	
	ЕстьОшибка = Ложь;
	
	ДополнитьПараметрыИмпортаСвойствамиПроекта(ПараметрыИмпорта);
	
	ДанныеЗаписаныВРасширении = Расширяемый_ЗаписатьДанныеШаблонаВПроект(ЕстьОшибка, 
		ПараметрыИмпорта, ДанныеШаблона, Индикатор, ТекстОшибки);
	Если ДанныеЗаписаныВРасширении Тогда
		Возврат ЕстьОшибка;
	КонецЕсли;
	
	// Здесь будем хранить все импортированные задачи.
	МассивЗадач = Новый Массив;
	
	// Получим входные параметры.
	Проект			= ПараметрыИмпорта.Проект;
	КорневаяЗадача 	= ПараметрыИмпорта.Этап;
	Версия 			= ПараметрыИмпорта.Версия;
	
	КолЭлементов = ДанныеШаблона.ТаблицаЗадач.Количество();
	
	// Если требуется, то создаем дополнительную корневую задачу.
	Если ПараметрыИмпорта.СоздатьКорневуюЗадачу Тогда
		
		НазваниеЗадачи = ПараметрыИмпорта.Шаблон.Наименование;
		
		// Создание и запись корневой проектной задачи.
		
		// Создадим новую задачу в проекте.
		Задача = Документы.упоПроектнаяЗадача.СоздатьДокумент();
		
		// Заполним необходимые данные.
		Задача.Дата                    = ТекущаяДата();
		Задача.НазваниеПроектнойЗадачи = НазваниеЗадачи;
		Задача.Проект                  = Проект;
		
		// Запишем задачу в БД в режиме проведения.
		Задача.ДополнительныеСвойства.Вставить("НеЗеркалировать", Истина);
		Задача.Записать(РежимЗаписиДокумента.Запись); // Лучше запись.
		
		КорневаяЗадача = Задача.Ссылка;
		
		МассивЗадач.Добавить(КорневаяЗадача);
		
	КонецЕсли;
	
	// Массив для хранения задач.
	МассивШаблонаЗадач = Новый Массив;
	// Соответствие шаблонов их задачам/операциям.
	СоответствиеШаблона = Новый Соответствие;
	ОтборПоРодителю = Новый Структура;
	
	// Определим шаблоны задач верхнего уровня,
	// и добавим их в массив шаблона задач.
	ОтборПоРодителю.Вставить("Родитель", Справочники.упоШаблоныПроектныхЗадач.ПустаяСсылка());
	
	ДанныеШаблона.ТаблицаЗадач.Индексы.Добавить("Родитель");
	МассивСтрок = ДанныеШаблона.ТаблицаЗадач.НайтиСтроки(ОтборПоРодителю);
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		МассивШаблонаЗадач.Добавить(ТекСтрока);
	КонецЦикла;
		
	// Далее будем создавать всю ветку задач от корневой задачи.
	
	// Перебираем массив шаблона задач и внутри для каждой текущей задачи ищем ее потомков.
	// Далее каждого потомка текущей задачи добавляем в этот же массив для последующего обхода.
	
	// Зафиксируем в регистре соответствие элементов шаблона и проекта.
	
	Если ПараметрыИмпорта.СохранитьСоответствие Тогда      
		Журнал = РегистрыСведений.упоОперацииБиблиотекиШаблонов.СоздатьНаборЗаписей();
	Иначе
		Журнал = Неопределено;
	КонецЕсли;
	
	ИндексОбхода = 0;
	Для Каждого ДанныеШаблонаЗадачи Из МассивШаблонаЗадач Цикл
		// Определим родительскую задачу для текущей задачи.
		Если ДанныеШаблонаЗадачи.Родитель = Справочники.упоШаблоныПроектныхЗадач.ПустаяСсылка() Тогда
			ЗадачаРодитель = КорневаяЗадача;
		Иначе
			ЗадачаРодитель = СоответствиеШаблона.Получить(ДанныеШаблонаЗадачи.Родитель);
		КонецЕсли;
		
		// Создадим данные текущей задачи.
		Задача = ЗаписатьДанныеЗадачиВПроект(Проект, ЗадачаРодитель, ДанныеШаблона, ДанныеШаблонаЗадачи, Индикатор,
			Журнал, ПараметрыИмпорта.СоответствиеКонтрагентов);
		
		МассивЗадач.Добавить(Задача);
		
		// Создадим соответствие шаблона ее задаче.
		СоответствиеШаблона.Вставить(ДанныеШаблонаЗадачи.Задача, Задача);
		
		// Опеределим и добавим в перебираемый массив потомков для текущего шаблона задачи.
		ОтборПоРодителю.Вставить("Родитель", ДанныеШаблонаЗадачи.Задача);
		
		МассивСтрок = ДанныеШаблона.ТаблицаЗадач.НайтиСтроки(ОтборПоРодителю);
		ИндексПодчиненных = 0;
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			// Подчиненные задачи должы следовать за родителем, 
			// чтобы не нарушался порядок проведения по связям (см.ПровестиЗадачу()).
			ИндексПодчиненных = ИндексПодчиненных + 1;
			МассивШаблонаЗадач.Вставить(ИндексОбхода + ИндексПодчиненных, ТекСтрока);
		КонецЦикла;
		
		ИндексОбхода = ИндексОбхода + 1;
	КонецЦикла;
	
	Если ДанныеШаблона.ДанныеДополнительнойПроектнойЗадачи.Количество() > 0 Тогда
		СоздатьДополнительнуюПроектнуюЗадачу(ДанныеШаблона.ДанныеДополнительнойПроектнойЗадачи, ПараметрыИмпорта, 
			МассивЗадач, КорневаяЗадача);
	КонецЕсли;
		
	ОтборПоЗадаче = Новый Структура;
	
	// Далее будем создавать для каждой задачи ее операции.
	
	Если НЕ Журнал = Неопределено Тогда
		Журнал.Записать(Ложь);
	КонецЕсли;
	
	// Далее будем определять для каждой задачи ее предшественников.
	
	ТаблицаЗадач = Новый ТаблицаЗначений;
	ТаблицаЗадач.Колонки.Добавить("Задача");
	ТаблицаЗадач.Колонки.Добавить("Родитель");
	ТаблицаЗадач.Колонки.Добавить("ЭтоМодельПакетаРабот");
	ТаблицаЗадач.Колонки.Добавить("ЭтоВеха");
	ТаблицаЗадач.Колонки.Добавить("ДатаНачалаПлан");
	ТаблицаЗадач.Колонки.Добавить("ДатаЗавершенияПлан");
	ТаблицаЗадач.Колонки.Добавить("КодСДР");
	
	ТаблицаПредЗадач = Новый ТаблицаЗначений;
	ТаблицаПредЗадач.Колонки.Добавить("Задача");
	ТаблицаПредЗадач.Колонки.Добавить("ПредЗадача");
	ТаблицаПредЗадач.Колонки.Добавить("ТипСвязи");
	ТаблицаПредЗадач.Колонки.Добавить("Задержка");
	
	// Корневая задача не попадала в расчет и поэтому проект не проходил проверку сроков.
	// Лучше добавлять в расчет корневую задачу, если она заполнена. Если не заполнена, то и не добавляем.
	Если ЗначениеЗаполнено(КорневаяЗадача) Тогда
		новаяСтрокаЗадач = ТаблицаЗадач.Добавить();
		новаяСтрокаЗадач.Задача 				= КорневаяЗадача;
		новаяСтрокаЗадач.Родитель 				= Документы.упоПроектнаяЗадача.ПустаяСсылка();
		новаяСтрокаЗадач.ЭтоМодельПакетаРабот 	= Ложь;
		новаяСтрокаЗадач.ЭтоВеха 				= Ложь;
		новаяСтрокаЗадач.ДатаНачалаПлан 		= КорневаяЗадача.ДатаНачалаПлан;
		новаяСтрокаЗадач.ДатаЗавершенияПлан		= КорневаяЗадача.ДатаЗавершенияПлан;
	КонецЕсли;
 
	// Снова перебираем полученный массив шаблона задач.
	Для Каждого ДанныеШаблонаЗадачи Из МассивШаблонаЗадач Цикл
		
		// Получим предшественников для текущего шаблона задачи.
		ОтборПоЗадаче.Вставить("Задача", ДанныеШаблонаЗадачи.Задача);
		
		текСсылка = СоответствиеШаблона[ДанныеШаблонаЗадачи.Задача];
		
		новаяСтрокаЗадач = ТаблицаЗадач.Добавить();
		новаяСтрокаЗадач.Задача 				= текСсылка;
		ПолучаемыеРеквизиты = "ЗадачаРодитель, ЭтоМодельПакетаРабот, ЭтоВеха, ДатаНачалаПлан, ДатаЗавершенияПлан";
		ПолученныеЗначенияПЗ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(текСсылка, ПолучаемыеРеквизиты, Истина);
		ЗаполнитьЗначенияСвойств(новаяСтрокаЗадач, ПолученныеЗначенияПЗ);
		новаяСтрокаЗадач.Родитель = ПолученныеЗначенияПЗ.ЗадачаРодитель;
		
		// Получим задачу по ее шаблону, а по ней ее объект.
		Задача = текСсылка.ПолучитьОбъект();
		
		// Определим предшественников текущей задачи.
		ПредУсловия = ДанныеШаблона.ТаблицаПредУсловийЗадач.НайтиСтроки(ОтборПоЗадаче);
		Для Каждого ПредУсловие Из ПредУсловия Цикл
			предСсылка = СоответствиеШаблона[ПредУсловие.Предшественник];
			
			НоваяСтрока = Задача.ПредУсловияЗадачи.Добавить();
			НоваяСтрока.ЗадачаПредшественник = предСсылка;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПредУсловие);
			
			новаястрокаПред 			= ТаблицаПредЗадач.Добавить();
			новаястрокаПред.Задача 		= текСсылка;
			новаястрокаПред.ПредЗадача 	= предСсылка;
			ЗаполнитьЗначенияСвойств(новаястрокаПред, ПредУсловие, , "Задача");
			новаястрокаПред.Задержка 	= ПредУсловие.ЗадержкаВЧасах;
		КонецЦикла;
		
		Задача.ДополнительныеСвойства.Вставить("упоНеПроверятьЗаполнятьТабличныеЧастиРаспределений", Истина);
		Задача.ДополнительныеСвойства.Вставить("НеЗеркалировать", Истина);
		Задача.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
		Задача.ДополнительныеСвойства.Вставить("НеПроверятьУдалениеПП", Истина);
	
		// Запишем изменения текущей задачи в БД в режиме проведения.
		Задача.Записать(РежимЗаписиДокумента.Запись); // Лучше записать.
		
	КонецЦикла;
	
	ТаблицаЗадач.Индексы.Добавить("Родитель, Задача");
		
	Если ЗначениеЗаполнено(ПараметрыИмпорта.Этап) Тогда
		КодСДРЭтапа = упоПроектыИЗадачиВызовСервера.обПолучитьКодСДРПроектнойЗадачи(ПараметрыИмпорта.Этап);
		КодСДРЭтапа = ?(ЗначениеЗаполнено(КодСДРЭтапа), КодСДРЭтапа + ".", "");
		РассчитатьКодСДРДляЗадач(ТаблицаЗадач, ПараметрыИмпорта.Этап, КодСДРЭтапа, ПараметрыИмпорта.Этап);
	Иначе
		РассчитатьКодСДРДляЗадач(ТаблицаЗадач, Документы.упоПроектнаяЗадача.ПустаяСсылка(), "", Проект);
	КонецЕсли;
	
	// Далее будем определять для каждой операции ее предшественников.
	
	ПараметрыИмпорта.Вставить("ТаблицаЗадач"		, ТаблицаЗадач);
	ПараметрыИмпорта.Вставить("ТаблицаПредЗадач"	, ТаблицаПредЗадач);
	
	ЭтоСозданиеПроектаИзШаблона = Истина;

	Если ПараметрыИмпорта.Свойство("ДатаНачала") И ЗначениеЗаполнено(ПараметрыИмпорта.ДатаНачала) Тогда
		НоваяДатаСтарта = ПараметрыИмпорта.ДатаНачала;
		ДатаНачалаДляЗадачБезСроков = НоваяДатаСтарта; 
	Иначе
		НоваяДатаСтарта = Неопределено;
		ДатаНачалаДляЗадачБезСроков = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(Проект, Истина);
	КонецЕсли;
	
	проведенныеЗадачи 	= Новый Соответствие;
	Если НЕ КорневаяЗадача = ПараметрыИмпорта.Этап Тогда
		ПровестиЗадачу(КорневаяЗадача, проведенныеЗадачи, Индикатор, ДатаНачалаДляЗадачБезСроков, ТаблицаЗадач, КодСДРЭтапа);
	Иначе
		проведенныеЗадачи.Вставить(КорневаяЗадача, Истина);
	КонецЕсли;
	проведенныеЗадачи.Вставить(ПараметрыИмпорта.Этап, Истина);
	
	// Перебираем полученный массив задач.
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкиДляЗаписиПроектныхЗадач(Проект, ТаблицаЗадач);
		Для Каждого ТекСтрокаТаблицы Из ТаблицаЗадач Цикл
			ПровестиЗадачу(ТекСтрокаТаблицы.Задача, проведенныеЗадачи, Индикатор, ДатаНачалаДляЗадачБезСроков,
				ТаблицаЗадач, ТекСтрокаТаблицы.КодСДР);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	ТаблицаДопЗадач = Новый ТаблицаЗначений;
	ТаблицаДопЗадач.Колонки.Добавить("ПроектнаяЗадача");
	ТаблицаДопЗадач.Колонки.Добавить("Родитель");
	ТаблицаДопЗадач.Колонки.Добавить("ЭтоМодельПакетаРабот");
	ТаблицаДопЗадач.Колонки.Добавить("ЭтоВеха");
	ТаблицаДопЗадач.Колонки.Добавить("ДатаНачалаПлан");
	ТаблицаДопЗадач.Колонки.Добавить("ДатаЗавершенияПлан");
	ТаблицаДопЗадач.Колонки.Добавить("КодСДР");
	
	Для Каждого ТекДопЗадача Из МассивЗадач Цикл
		
		ЗадачаВТаблицеЗадач = ТаблицаЗадач.Найти(ТекДопЗадача, "Задача");
		Если ЗадачаВТаблицеЗадач <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		новаяСтрокаЗадач = ТаблицаДопЗадач.Добавить();
		новаяСтрокаЗадач.ПроектнаяЗадача = ТекДопЗадача;
		ПолучаемыеРеквизиты = "ЗадачаРодитель, ЭтоМодельПакетаРабот, ЭтоВеха, ДатаНачалаПлан, ДатаЗавершенияПлан";
		ПолученныеЗначенияПЗ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(текСсылка, ПолучаемыеРеквизиты, Истина);
		ЗаполнитьЗначенияСвойств(новаяСтрокаЗадач, ПолученныеЗначенияПЗ);
		новаяСтрокаЗадач.Родитель = ПолученныеЗначенияПЗ.ЗадачаРодитель;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПараметрыИмпорта.Этап) Тогда
		КодСДРЭтапа = упоПроектыИЗадачиВызовСервера.обПолучитьКодСДРПроектнойЗадачи(ПараметрыИмпорта.Этап);
		КодСДРЭтапа = ?(ЗначениеЗаполнено(КодСДРЭтапа), КодСДРЭтапа + ".", "");
		РассчитатьКодСДРДляЗадач(ТаблицаДопЗадач, ПараметрыИмпорта.Этап, КодСДРЭтапа, ПараметрыИмпорта.Этап);
	Иначе
		РассчитатьКодСДРДляЗадач(ТаблицаДопЗадач, Документы.упоПроектнаяЗадача.ПустаяСсылка(), "", Проект);
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкиДляЗаписиПроектныхЗадач(Проект, ТаблицаДопЗадач);
		Для Каждого ТекДопЗадача Из ТаблицаДопЗадач Цикл
			ПровестиЗадачу(ТекДопЗадача.ПроектнаяЗадача, проведенныеЗадачи, Индикатор, ДатаНачалаДляЗадачБезСроков,
				ТаблицаДопЗадач, ТекДопЗадача.КодСДР);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Попытка
		упоРасчетКалендарныхСроковРедакция3Сервер.АктуализироватьСрокиПроекта(Проект, Истина, НоваяДатаСтарта, Версия);
	Исключение
		ТекстОшибки = ТекстОшибки + ОписаниеОшибки();
		ЕстьОшибка = Истина;
	КонецПопытки;
	
	Возврат ЕстьОшибка;
	
КонецФункции

Функция ДополнитьПараметрыИмпортаСвойствамиПроекта(ПараметрыИмпорта)
	
	Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПараметрыИмпорта.Проект);
	ПараметрыИмпорта.Вставить("Версия", Версия);
	
	Если ЗначениеЗаполнено(ПараметрыИмпорта.Этап) Тогда
		ЭтоПроектСЗадачами = Истина;
	Иначе
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Версия", Версия);
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	упоСвойстваПроектныхЗадачСрезПервых.ПроектнаяЗадача КАК ПроектнаяЗадача
		               |ИЗ
		               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПервых(, Версия = &Версия) КАК упоСвойстваПроектныхЗадачСрезПервых
		               |ГДЕ
		               |	НЕ упоСвойстваПроектныхЗадачСрезПервых.ЗадачаОтменена";
		Результат = Запрос.Выполнить();
		
		ЭтоПроектСЗадачами = Не Результат.Пустой();
	КонецЕсли;
	ПараметрыИмпорта.Вставить("ЭтоПроектСЗадачами", ЭтоПроектСЗадачами);
	
КонецФункции

Процедура УстановитьБлокировкиДляЗаписиПроектныхЗадач(Проект, ПроектныеЗадачи)
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.Проекты");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Проект);
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.упоСвойстваПроектныхЗадач");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ПроектныеЗадачи;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПроектнаяЗадача", "ПроектнаяЗадача");
	
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.упоСрокиПроектныхЗадач");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ПроектныеЗадачи;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ПроектнаяЗадача", "ПроектнаяЗадача");
	
КонецПроцедуры

Процедура ПровестиЗадачу(текЗадача, проведенныеЗадачи, Индикатор, ДатаНачалаДляЗадачБезСроков,
							ТаблицаЗадач, КодСДР)
	
	Если НЕ проведенныеЗадачи[текЗадача] = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Объект текущей задачи.
	Задача = ТекЗадача.ПолучитьОбъект();
	
	ЗадачаРодитель = Задача.ЗадачаРодитель;
	Если ЗначениеЗаполнено(ЗадачаРодитель) И 
		проведенныеЗадачи[ЗадачаРодитель] = Неопределено Тогда
		ПровестиЗадачуСЗаполненнымКодомСДР(ЗадачаРодитель, проведенныеЗадачи, Индикатор, 
			ДатаНачалаДляЗадачБезСроков, ТаблицаЗадач);
	КонецЕсли;
	
	Для каждого предЗадача Из Задача.ПредусловияЗадачи Цикл
		ЗадачаПредшественник = предЗадача.ЗадачаПредшественник;
		Если проведенныеЗадачи[ЗадачаПредшественник] = Неопределено Тогда
			ПровестиЗадачуСЗаполненнымКодомСДР(ЗадачаПредшественник, проведенныеЗадачи, Индикатор, 
				ДатаНачалаДляЗадачБезСроков, ТаблицаЗадач);
		КонецЕсли;
	КонецЦикла;
	
	Задача.ДополнительныеСвойства.Вставить("ИспользоватьРодителяИзДокумента", Истина);
	Задача.ДополнительныеСвойства.Вставить("НеПроверятьВозможностьАктуализацииФинПланов", Истина);
	Если Не Задача.РучнойВводСроков Тогда
		Задача.ДополнительныеСвойства.Вставить("упоНеФормироватьАктуальныеДвижения", Истина);
	КонецЕсли;
	Задача.ДополнительныеСвойства.Вставить("ДанныеВерсииПолучены", Истина);
	Если ЗначениеЗаполнено(КодСДР) Тогда
		Задача.ДополнительныеСвойства.Вставить("ЗаписатьКодСДР", КодСДР);
		Задача.ДополнительныеСвойства.Вставить("НеИзменятьКодСДР", Истина);
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Задача.ДатаНачалаПлан) ИЛИ Не ЗначениеЗаполнено(Задача.ДатаЗавершенияПлан) Тогда
		Задача.ДатаНачалаПлан = ДатаНачалаДляЗадачБезСроков;
		Задача.ДатаЗавершенияПлан = Задача.ДатаНачалаПлан;
		Задача.ДополнительныеСвойства.Вставить("ЗаписатьСроки", Истина);
	КонецЕсли;
	
	Задача.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
	Задача.ДополнительныеСвойства.Вставить("НеПроверятьУдалениеПП", Истина);
	
	Задача.Записать(РежимЗаписиДокумента.Проведение);
	
	проведенныеЗадачи.Вставить(текЗадача, Истина);
	
КонецПроцедуры

Процедура СкорректироватьТаблицуТрудозатратПоРасчетуЦеныКонтракта(ТаблицаТрудовыхРесурсовЗадач, 
																	ДанныеДополнительнойПроектнойЗадачи,
																	РасчетЦеныКонтракта)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоРасчетЦеныКонтрактаТрудозатратыПИРНИР.ВидОперации,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПИРНИР.Специальность,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПИРНИР.КоличествоЧасов,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПИРНИР.СуммаПоВнутреннейСтавке КАК Сумма,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПИРНИР.СуммаПоВнешнейСтавке КАК СуммаВнешняя
	               |ПОМЕСТИТЬ втТрудозатраты
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ТрудозатратыПИРНИР КАК упоРасчетЦеныКонтрактаТрудозатратыПИРНИР
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаТрудозатратыПИРНИР.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаТрудозатратыПНР.ВидОперации,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПНР.Специальность,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПНР.КоличествоЧасов,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПНР.СуммаПоВнутреннейСтавке,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПНР.СуммаПоВнешнейСтавке
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ТрудозатратыПНР КАК упоРасчетЦеныКонтрактаТрудозатратыПНР
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаТрудозатратыПНР.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаТрудозатратыСМР.ВидОперации,
	               |	упоРасчетЦеныКонтрактаТрудозатратыСМР.Специальность,
	               |	упоРасчетЦеныКонтрактаТрудозатратыСМР.КоличествоЧасов,
	               |	упоРасчетЦеныКонтрактаТрудозатратыСМР.СуммаПоВнутреннейСтавке,
	               |	упоРасчетЦеныКонтрактаТрудозатратыСМР.СуммаПоВнешнейСтавке
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ТрудозатратыСМР КАК упоРасчетЦеныКонтрактаТрудозатратыСМР
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаТрудозатратыСМР.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаТрудозатратыПрочие.ВидОперации,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПрочие.Специальность,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПрочие.КоличествоЧасов,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПрочие.СуммаПоВнутреннейСтавке,
	               |	упоРасчетЦеныКонтрактаТрудозатратыПрочие.СуммаПоВнешнейСтавке
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ТрудозатратыПрочие КАК упоРасчетЦеныКонтрактаТрудозатратыПрочие
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаТрудозатратыПрочие.Ссылка = &РасчетЦеныКонтракта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втТрудозатраты.ВидОперации,
	               |	втТрудозатраты.Специальность КАК Ресурс,
	               |	СУММА(втТрудозатраты.КоличествоЧасов) КАК Количество,
	               |	СУММА(втТрудозатраты.Сумма) КАК Стоимость,
	               |	втТрудозатраты.СуммаВнешняя
	               |ИЗ
	               |	втТрудозатраты КАК втТрудозатраты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втТрудозатраты.ВидОперации,
	               |	втТрудозатраты.Специальность,
	               |	втТрудозатраты.СуммаВнешняя";
				   
	Запрос.УстановитьПараметр("РасчетЦеныКонтракта", РасчетЦеныКонтракта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Пропорциональное распределение количества часов и суммы из Расчета цены контракта.
		
		// Отбор по виду операции и роли.
		Отбор = Новый Структура;
		Отбор.Вставить("ВидОперации", Выборка.ВидОперации);
		Отбор.Вставить("Ресурс", Выборка.Ресурс);
		
		МассивСтрокТрудозатратыШаблона = ТаблицаТрудовыхРесурсовЗадач.НайтиСтроки(Отбор);
		
		Если МассивСтрокТрудозатратыШаблона.Количество() = 0 Тогда 
			
			// Данные будут записаны в дополнительную проектную задачу.
			СтруктураДанныеДополнительнойПроектнойЗадачи = ДанныеДополнительнойПроектнойЗадачи.Получить(Выборка.ВидОперации);
			Если СтруктураДанныеДополнительнойПроектнойЗадачи = Неопределено Тогда
				СтруктураДанныеДополнительнойПроектнойЗадачи = СформироватьСтруктуруДанныхДополнительнойПроектнойЗадачи();
				ДанныеДополнительнойПроектнойЗадачи.Вставить(Выборка.ВидОперации, СтруктураДанныеДополнительнойПроектнойЗадачи);
			КонецЕсли;
			Если СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаТрудовыхРесурсовЗадач = Неопределено Тогда
				СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаТрудовыхРесурсовЗадач = ТаблицаТрудовыхРесурсовЗадач.СкопироватьКолонки();
			КонецЕсли;   
			СтрокаТрудозатраты = СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаТрудовыхРесурсовЗадач.Добавить();
			
			// Из Расчета цены контракта надо хватать внешнюю стоимость.
			ИмяКолонкиВнешняяСтоимость = "СуммаВнешняя";
			Если СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаТрудовыхРесурсовЗадач.Колонки.Найти(ИмяКолонкиВнешняяСтоимость) = Неопределено Тогда 
				СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаТрудовыхРесурсовЗадач.Колонки.Добавить(
					ИмяКолонкиВнешняяСтоимость, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой)))
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаТрудозатраты, Выборка);
			
		Иначе	
		
			// Получение коэффициентов для распределения (по количеству часов в шаблоне).
			МассивКоэффициентов = Новый Массив;
			Для Каждого СтрокаТрудозатратыШаблона Из МассивСтрокТрудозатратыШаблона Цикл
				МассивКоэффициентов.Добавить(СтрокаТрудозатратыШаблона.КоличествоЧасов);
			КонецЦикла;
			
			МассивКоличествоЧасов = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Выборка.Количество, 
																								МассивКоэффициентов, 
																								2);
			МассивСумма = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Выборка.Стоимость, 
																								МассивКоэффициентов, 
																								2);
			МассивСуммаВнешняя = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Выборка.СуммаВнешняя, 
																								МассивКоэффициентов, 
																								2);

			// Запись полученных значений в таблицу.
			КоличествоСтрок = МассивСтрокТрудозатратыШаблона.Количество();
			Для Индекс = 0 По КоличествоСтрок - 1 Цикл
				
				КоэффициентЕд = МассивСтрокТрудозатратыШаблона[Индекс].КоэффициентЕд;
				 
				Если КоэффициентЕд = 0 Тогда					
					МассивСтрокТрудозатратыШаблона[Индекс].Количество 		= 0; 
					МассивСтрокТрудозатратыШаблона[Индекс].Стоимость 		= 0;
					МассивСтрокТрудозатратыШаблона[Индекс].ВнешняяСтоимость = 0;
				Иначе
					МассивСтрокТрудозатратыШаблона[Индекс].Количество 		= МассивКоличествоЧасов[Индекс] / КоэффициентЕд;
					МассивСтрокТрудозатратыШаблона[Индекс].Стоимость 		= МассивСумма[Индекс] / КоэффициентЕд;
					МассивСтрокТрудозатратыШаблона[Индекс].ВнешняяСтоимость = МассивСуммаВнешняя[Индекс] / КоэффициентЕд;										
				КонецЕсли;												
											
				Если МассивСтрокТрудозатратыШаблона[Индекс].Количество = 0 Тогда
					МассивСтрокТрудозатратыШаблона[Индекс].СтоимостьЕд 			= 0;
					МассивСтрокТрудозатратыШаблона[Индекс].СтоимостьЕдВнешняя 	= 0;
				Иначе
					МассивСтрокТрудозатратыШаблона[Индекс].СтоимостьЕд = 
						МассивСтрокТрудозатратыШаблона[Индекс].Стоимость / МассивСтрокТрудозатратыШаблона[Индекс].Количество;
					МассивСтрокТрудозатратыШаблона[Индекс].СтоимостьЕдВнешняя = 
						МассивСтрокТрудозатратыШаблона[Индекс].ВнешняяСтоимость / МассивСтрокТрудозатратыШаблона[Индекс].Количество;
				КонецЕсли;			
				
			КонецЦикла;
		КонецЕсли;	
		
	КонецЦикла;
				   
КонецПроцедуры

Процедура СкорректироватьТаблицуДопЗатратПоРасчетуЦеныКонтракта(ТаблицаДопЗатратЗадач, 
																ДанныеДополнительнойПроектнойЗадачи,
																РасчетЦеныКонтракта)

	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПИРНИР.ВидОперации,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПИРНИР.СтатьяЗатрат,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПИРНИР.Сумма
	               |ПОМЕСТИТЬ втДополнительныеЗатраты
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ДополнительныеЗатратыПИРНИР КАК упоРасчетЦеныКонтрактаДополнительныеЗатратыПИРНИР
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПИРНИР.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыОборудование.ВидОперации,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыОборудование.СтатьяЗатрат,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыОборудование.Сумма
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ДополнительныеЗатратыОборудование КАК упоРасчетЦеныКонтрактаДополнительныеЗатратыОборудование
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыОборудование.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПНР.ВидОперации,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПНР.СтатьяЗатрат,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПНР.Сумма
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ДополнительныеЗатратыПНР КАК упоРасчетЦеныКонтрактаДополнительныеЗатратыПНР
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПНР.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыСМР.ВидОперации,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыСМР.СтатьяЗатрат,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыСМР.Сумма
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ДополнительныеЗатратыСМР КАК упоРасчетЦеныКонтрактаДополнительныеЗатратыСМР
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыСМР.Ссылка = &РасчетЦеныКонтракта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПрочие.ВидОперации,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПрочие.СтатьяЗатрат,
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПрочие.Сумма
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ДополнительныеЗатратыПрочие КАК упоРасчетЦеныКонтрактаДополнительныеЗатратыПрочие
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаДополнительныеЗатратыПрочие.Ссылка = &РасчетЦеныКонтракта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДополнительныеЗатраты.ВидОперации,
	               |	втДополнительныеЗатраты.СтатьяЗатрат,
	               |	СУММА(втДополнительныеЗатраты.Сумма) КАК Стоимость
	               |ИЗ
	               |	втДополнительныеЗатраты КАК втДополнительныеЗатраты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втДополнительныеЗатраты.ВидОперации,
	               |	втДополнительныеЗатраты.СтатьяЗатрат";
	
	Запрос.УстановитьПараметр("РасчетЦеныКонтракта", РасчетЦеныКонтракта);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаДопЗатратЗадач.Колонки.Добавить("НеУчитывать");
	ТаблицаДопЗатратЗадач.ЗаполнитьЗначения(Ложь, "НеУчитывать");
	
	// Проходим выборку первый раз - распределяем доп. затраты по видам операции, указанным в табличной части.
	
	Пока Выборка.Следующий() Цикл
		
		// Пропорциональное распределение суммы из Расчета цены контракта.
		
		// Отбор по виду операции и роли.
		Отбор = Новый Структура;
		Отбор.Вставить("ВидОперацииПроектнойЗадачи", Выборка.ВидОперации);
		Отбор.Вставить("ВидОперации", Выборка.ВидОперации);		
		Отбор.Вставить("СтатьяЗатрат", Выборка.СтатьяЗатрат);
		
		МассивСтрокДопЗатратыШаблона = ТаблицаДопЗатратЗадач.НайтиСтроки(Отбор);
		
		Если МассивСтрокДопЗатратыШаблона.Количество() > 0 Тогда
		
			// Получение коэффициентов для распределения (по количеству часов в шаблоне).
			МассивКоэффициентов = Новый Массив;
			Для Каждого СтрокаДопЗатратыШаблона Из МассивСтрокДопЗатратыШаблона Цикл
				МассивКоэффициентов.Добавить(СтрокаДопЗатратыШаблона.Стоимость);
				СтрокаДопЗатратыШаблона.НеУчитывать = Истина;
			КонецЦикла;
			
			МассивСумма = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Выборка.Стоимость, МассивКоэффициентов, 2);

			// Запись полученных значений в таблицу.
			КоличествоСтрок = МассивСтрокДопЗатратыШаблона.Количество();
			Для Индекс = 0 По КоличествоСтрок - 1 Цикл
				МассивСтрокДопЗатратыШаблона[Индекс].Стоимость = МассивСумма[Индекс];
			КонецЦикла; 
		
		КонецЕсли;
		
	КонецЦикла;
	
	Выборка.Сбросить();
	
	// Проходим выборку второй раз и нераспределенные на предыдущем этапе строки распределяем на остальные виды операций.
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ВидОперацииПроектнойЗадачи", Выборка.ВидОперации);
		Отбор.Вставить("ВидОперации", Выборка.ВидОперации);		
		Отбор.Вставить("СтатьяЗатрат", Выборка.СтатьяЗатрат);
		
		МассивСтрокДопЗатратыШаблона = ТаблицаДопЗатратЗадач.НайтиСтроки(Отбор);
		
		Если МассивСтрокДопЗатратыШаблона.Количество() = 0 Тогда
			
			Отбор.Удалить("ВидОперации");
			Отбор.Вставить("НеУчитывать", Ложь);
			
			МассивСтрокДопЗатратыШаблона = ТаблицаДопЗатратЗадач.НайтиСтроки(Отбор);
			
			Если МассивСтрокДопЗатратыШаблона.Количество() = 0 Тогда
				
				// Данные будут записаны в дополнительную проектную задачу.
				СтруктураДанныеДополнительнойПроектнойЗадачи = ДанныеДополнительнойПроектнойЗадачи.Получить(Выборка.ВидОперации);
				Если СтруктураДанныеДополнительнойПроектнойЗадачи = Неопределено Тогда
					СтруктураДанныеДополнительнойПроектнойЗадачи = СформироватьСтруктуруДанныхДополнительнойПроектнойЗадачи();
					ДанныеДополнительнойПроектнойЗадачи.Вставить(Выборка.ВидОперации, СтруктураДанныеДополнительнойПроектнойЗадачи);
				КонецЕсли;
				Если СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаДопЗатратЗадач = Неопределено Тогда
					СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаДопЗатратЗадач = ТаблицаДопЗатратЗадач.СкопироватьКолонки();
				КонецЕсли;
				СтрокаДопЗатраты = СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаДопЗатратЗадач.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДопЗатраты, Выборка);
				
			Иначе			
				
				// Получение коэффициентов для распределения (по количеству часов в шаблоне).
				МассивКоэффициентов = Новый Массив;
				Для Каждого СтрокаДопЗатратыШаблона Из МассивСтрокДопЗатратыШаблона Цикл
					МассивКоэффициентов.Добавить(СтрокаДопЗатратыШаблона.Стоимость);
				КонецЦикла;
				
				МассивСумма = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Выборка.Стоимость, МассивКоэффициентов, 2);

				// Запись полученных значений в таблицу.
				КоличествоСтрок = МассивСтрокДопЗатратыШаблона.Количество();
				Для Индекс = 0 По КоличествоСтрок - 1 Цикл
					МассивСтрокДопЗатратыШаблона[Индекс].Стоимость = МассивСумма[Индекс];
				КонецЦикла;
					
				КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
				   
КонецПроцедуры

Процедура СкорректироватьТаблицуМатериаловПоРасчетуЦеныКонтракта(ТаблицаМатРесурсовЗадач, 
																	ДанныеДополнительнойПроектнойЗадачи,
																	РасчетЦеныКонтракта)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Оборудование КАК Ресурс,
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.ВидОперации КАК ВидОперации,
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Ссылка.Валюта КАК Валюта,
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Оборудование.ЕдиницаИзмерения КАК ЕдиницаНормирования,
	               |	СУММА(упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Количество) КАК Количество,
	               |	СУММА(упоРасчетЦеныКонтрактаОборудованиеПродаваемое.ЦенаЗакупки) КАК Стоимость,
				   |	СУММА(упоРасчетЦеныКонтрактаОборудованиеПродаваемое.СтоимостьЗакупкиCIP) КАК СтоимостьЗакупкиCIP,
	               |	СУММА(упоРасчетЦеныКонтрактаОборудованиеПродаваемое.СуммаТаможенныхПлатежей) КАК СуммаТаможенныхПлатежей
	               |ИЗ
	               |	Документ.упоРасчетЦеныКонтракта.ОборудованиеПродаваемое КАК упоРасчетЦеныКонтрактаОборудованиеПродаваемое
	               |ГДЕ
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Ссылка = &РасчетЦеныКонтракта
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Оборудование,
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Ссылка.Валюта,
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.ВидОперации,
	               |	упоРасчетЦеныКонтрактаОборудованиеПродаваемое.Оборудование.ЕдиницаИзмерения";
				   
	Запрос.УстановитьПараметр("РасчетЦеныКонтракта", РасчетЦеныКонтракта);
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		
		// Проверим заполнение необходимых реквизитов.
		
		Если Не ЗначениеЗаполнено(Выборка.Валюта) Тогда 
			ШаблонСообщения = НСтр("ru = 'Необходимо заполнить значение реквизита ""Валюта"" в документе ""%1"".
				|Разворачивание шаблона прервано.'");	
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, РасчетЦеныКонтракта);			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.ЕдиницаНормирования) Тогда 
			ШаблонСообщения = НСтр("ru = 'Необходимо заполнить значение реквизита ""Единица измерения"" в карточке номенклатуры ""%1"".
				|Разворачивание шаблона прервано.'");	
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, Выборка.Ресурс);			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Стоимость) Тогда 
			ШаблонСообщения = НСтр("ru = 'По номенклатуре ""%1"" в документе ""%2"" не заполнена ""Цена закупки (EXW)"" .
				|Разворачивание шаблона прервано.'");	
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, Выборка.Ресурс, РасчетЦеныКонтракта);			
		КонецЕсли;
		
		// Изменение стоимости оборудования по Расчету цены контракта.
		
		// Отбор по виду операции и роли.
		Отбор = Новый Структура;
		Отбор.Вставить("ВидОперации", Выборка.ВидОперации);
		Отбор.Вставить("Ресурс", Выборка.Ресурс);
		
		МассивСтрокМатРесурсыШаблона = ТаблицаМатРесурсовЗадач.НайтиСтроки(Отбор);
		
		Если МассивСтрокМатРесурсыШаблона.Количество() = 0 Тогда
			
			// Данные будут записаны в дополнительную проектную задачу.
			СтруктураДанныеДополнительнойПроектнойЗадачи = ДанныеДополнительнойПроектнойЗадачи.Получить(Выборка.ВидОперации);
			Если СтруктураДанныеДополнительнойПроектнойЗадачи = Неопределено Тогда
				СтруктураДанныеДополнительнойПроектнойЗадачи = СформироватьСтруктуруДанныхДополнительнойПроектнойЗадачи();
				ДанныеДополнительнойПроектнойЗадачи.Вставить(Выборка.ВидОперации, СтруктураДанныеДополнительнойПроектнойЗадачи);
			КонецЕсли;
			Если СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаМатРесурсовЗадач = Неопределено Тогда
				СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаМатРесурсовЗадач = ТаблицаМатРесурсовЗадач.СкопироватьКолонки();
				СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаМатРесурсовЗадач.Колонки.Добавить("ОбщСтоимость");
			КонецЕсли;
			СтрокаОборудование = СтруктураДанныеДополнительнойПроектнойЗадачи.ТаблицаМатРесурсовЗадач.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОборудование, Выборка);
			СтрокаОборудование.Стоимость = Выборка.Стоимость;
			СтрокаОборудование.ОбщСтоимость = Выборка.Количество * Выборка.Стоимость;
			
			СтрокаОборудование.СпособПривязкиПотребности = 
				ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиПоставокИСубпродуктов.НачалоЗадачи");
			
		Иначе  			

			МассивСтрокМатРесурсыШаблона[0].Количество = Выборка.Количество;			
			//МассивСтрокМатРесурсыШаблона[0].Стоимость = Выборка.СтоимостьЗакупкиCIP + Выборка.СуммаТаможенныхПлатежей;
			МассивСтрокМатРесурсыШаблона[0].СтоимостьЕд = Выборка.Стоимость;
			МассивСтрокМатРесурсыШаблона[0].Стоимость = Выборка.Количество * Выборка.Стоимость;
		
		КонецЕсли;
	
	КонецЦикла;
				   
КонецПроцедуры

Процедура СоздатьДополнительнуюПроектнуюЗадачу(ДанныеДополнительнойПроектнойЗадачи, ПараметрыИмпорта, МассивЗадач,
	КорневаяЗадача)

	ВалютаУправленческогоУчета = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	
	РеквизитыПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыИмпорта.Проект, 
		"ПрофильРасходовПоУмолчанию, СтатьяЗатратПоУмолчанию");
	
	СтатьяЗатратПоУмолчанию = РеквизитыПроекта.СтатьяЗатратПоУмолчанию;
	СпособПривязкиДиРПоУмолчанию = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения; 
	ПрофильДиРПоУмолчанию = РеквизитыПроекта.ПрофильРасходовПоУмолчанию;
	Если Не ЗначениеЗаполнено(ПрофильДиРПоУмолчанию) Тогда 
		ВыборкаПрофилей = Справочники.упоПрофилиРаспределенияДоходовИРасходов.Выбрать();
		Если ВыборкаПрофилей.Следующий() Тогда
			ПрофильДиРПоУмолчанию = ВыборкаПрофилей.Ссылка;
		КонецЕсли;
	КонецЕсли;	
	
	Для Каждого ВидОперации Из ДанныеДополнительнойПроектнойЗадачи Цикл
	
		Задача = Документы.упоПроектнаяЗадача.СоздатьДокумент();
		
		// Свойства задач.
		Задача.Дата 							= ТекущаяДата();
		Задача.НазваниеПроектнойЗадачи 			= ?(ЗначениеЗаполнено(ВидОперации.Ключ), Строка(ВидОперации.Ключ), "Вид операции не заполнен");
		Задача.Проект 							= ПараметрыИмпорта.Проект;
		Задача.ЭтоПакетРабот 					= Истина;
		Задача.ЭтоМодельПакетаРабот 			= Истина;
		Задача.ТипПроектнойЗадачи 				= ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
		Задача.ВидОперации						= ВидОперации.Ключ;
		Задача.МетодРасчетаМоделиПакетаРабот	= ПредопределенноеЗначение("Перечисление.упоМетодРасчетаСроковМоделиПакетаРабот.ПоДлительности");
		Задача.ЕдиницаНормированияДлительности 	= ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.Час");
		Задача.ЗадачаРодитель					= КорневаяЗадача;
		
		// Материальные ресурсы.
		МатРесурсы = ВидОперации.Значение.ТаблицаМатРесурсовЗадач;		
		Если МатРесурсы <> Неопределено Тогда
			Для Каждого СтрокаМатРесурса Из МатРесурсы Цикл
					
				ЗаполнитьЗначенияСвойств(Задача.МатериальныеРесурсы.Добавить(), СтрокаМатРесурса);				
												
				// Трансляция в фин.планы.				
				НоваяСтрока = Задача.ПланРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаМатРесурса);
				НоваяСтрока.Статья = СтрокаМатРесурса.СтатьяЗатрат;
				НоваяСтрока.Сумма = СтрокаМатРесурса.ОбщСтоимость;	
				Если Не ЗначениеЗаполнено(НоваяСтрока.Статья) Тогда
					НоваяСтрока.Статья = СтатьяЗатратПоУмолчанию;
				КонецЕсли;	
				Если Не ЗначениеЗаполнено(НоваяСтрока.СпособПривязки) Тогда
					НоваяСтрока.СпособПривязки = СпособПривязкиДиРПоУмолчанию;
				КонецЕсли;	
				Если Не ЗначениеЗаполнено(НоваяСтрока.ПрофильРаспределения) Тогда
					НоваяСтрока.ПрофильРаспределения = ПрофильДиРПоУмолчанию;
				КонецЕсли;

			КонецЦикла;							
		КонецЕсли;
		
		// Трудозатраты.
		
		МаксимумТрудозатраты = 0;		
		ТрудовыеРесурсы = ВидОперации.Значение.ТаблицаТрудовыхРесурсовЗадач;
		Если ТрудовыеРесурсы <> Неопределено Тогда
			Для Каждого СтрокаРесурс Из ТрудовыеРесурсы Цикл 
				НоваяСтрока = Задача.ТрудовыеРесурсы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРесурс, , "Стоимость");
				НоваяСтрока.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения");
				НоваяСтрока.ПрофильРаспределения = ПредопределенноеЗначение("Справочник.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение");
				НоваяСтрока.ЕдиницаНормирования = ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.Час");
				НоваяСтрока.УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный");
				НоваяСтрока.ОбщСтоимость = СтрокаРесурс.Стоимость;
				НоваяСтрока.Стоимость = ?(НоваяСтрока.Количество <> 0, НоваяСтрока.ОбщСтоимость / НоваяСтрока.Количество, 0);
				НоваяСтрока.ОбщВнешняяСтоимость = СтрокаРесурс.СуммаВнешняя;
				НоваяСтрока.ВнешняяСтоимость = ?(НоваяСтрока.Количество <> 0, НоваяСтрока.ОбщВнешняяСтоимость / НоваяСтрока.Количество, 0);
				МаксимумТрудозатраты = Макс(МаксимумТрудозатраты, НоваяСтрока.Количество);
			КонецЦикла;
		КонецЕсли;
		
		Задача.ДлительностьМоделиПакетаРабот = ?(МаксимумТрудозатраты = 0, 1, МаксимумТрудозатраты);
		
		// Доп.затраты.
			
		ДопЗатраты = ВидОперации.Значение.ТаблицаДопЗатратЗадач;			
		Если ДопЗатраты <> Неопределено Тогда
			Для Каждого СтрокаДопЗатрат Из ДопЗатраты Цикл
								
				ЗаполнитьЗначенияСвойств(Задача.ДополнительныеЗатраты.Добавить(), СтрокаДопЗатрат);
										
				// Трансляция в фин.планы.				
				НоваяСтрока = Задача.ПланРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДопЗатрат);
				НоваяСтрока.Статья = СтрокаДопЗатрат.СтатьяЗатрат;
				НоваяСтрока.Сумма = СтрокаДопЗатрат.Стоимость;
				НоваяСтрока.СпособПривязки = СпособПривязкиДиРПоУмолчанию;
				НоваяСтрока.ПрофильРаспределения = ПрофильДиРПоУмолчанию;
				НоваяСтрока.Валюта = ВалютаУправленческогоУчета;
				
			КонецЦикла;									
			Задача.СпособПривязкиДопЗатрат = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДопЗатрат.КЗавершениюЗадачи");			
		КонецЕсли;
		
		Задача.ДополнительныеСвойства.Вставить("НеЗеркалировать", Истина);
		Задача.Записать(РежимЗаписиДокумента.Запись);
		
		МассивЗадач.Добавить(Задача.Ссылка);
	
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьСтруктуруДанныхДополнительнойПроектнойЗадачи()

	ДанныеДополнительнойПроектнойЗадачи = Новый Структура;
	ДанныеДополнительнойПроектнойЗадачи.Вставить("СоздатьДополнительнуюЗадачу", Ложь);
	ДанныеДополнительнойПроектнойЗадачи.Вставить("ТаблицаТрудовыхРесурсовЗадач");
	ДанныеДополнительнойПроектнойЗадачи.Вставить("ТаблицаМатРесурсовЗадач");
	ДанныеДополнительнойПроектнойЗадачи.Вставить("ТаблицаДопЗатратЗадач");
	
	Возврат ДанныеДополнительнойПроектнойЗадачи;

КонецФункции

Процедура РассчитатьКодСДРДляЗадач(ТаблицаЗадач, Родитель, НачальныйКодСДР, ПроектИлиЭтап = Неопределено) 
	
	Если Не ЗначениеЗаполнено(ТаблицаЗадач) Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПЗ = 0;
	
	ПервыйУровень = ПроектИлиЭтап <> Неопределено;
	
	Если ПервыйУровень Тогда
		
		ЭлементСпрПроекты = ПроектИлиЭтап;
		Если ТипЗнч(ЭлементСпрПроекты) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ЭлементСпрПроекты = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(ЭлементСпрПроекты);
		КонецЕсли;
		
		ПроектныеЗадачиСКодамиСДР = ПолучитьТаблицуПроектныхЗадачСКодамиСДР(ЭлементСпрПроекты);		
		
		ПроектныеЗадачиСКодамиСДР.Индексы.Добавить("Родитель");
		
		Отбор = Новый Структура("Родитель", ЭлементСпрПроекты);		
		НайденныеСтрокиПЗ = ПроектныеЗадачиСКодамиСДР.НайтиСтроки(Отбор);
		
		КоличествоПЗ = НайденныеСтрокиПЗ.Количество();
		
	КонецЕсли;
	
	Отбор = Новый Структура("Родитель", Родитель);
	НайденныеСтроки = ТаблицаЗадач.НайтиСтроки(Отбор);	
	
	// Похожий функционал реализован в функции ЗаполнитьКодыСДРвДереве формы обработки упоУпрощенныйВводСтруктурыПроекта,
	// а также в упоПроектыИЗадачиВызовСервера.обОбновитьКодСДР.
	КоличествоСтрок = КоличествоПЗ + НайденныеСтроки.Количество();	
	ФорматУровня = ПолучитьФорматУровня(КоличествоСтрок);
	
	СледующийНомер = 1;
	
	Если ПервыйУровень Тогда		
		ПересчитатьКодыСДРПроектныхЗадач(ПроектныеЗадачиСКодамиСДР, НайденныеСтрокиПЗ, НачальныйКодСДР, СледующийНомер, ФорматУровня);		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаЗадача = НайденныеСтроки[0].Владелец().Колонки.Найти("Задача");
	Если КолонкаЗадача = Неопределено Тогда
		ИмяКолонкиЗадачи = "ПроектнаяЗадача";
	Иначе
		ИмяКолонкиЗадачи = "Задача";
	КонецЕсли;
	
	Для Каждого Строка Из НайденныеСтроки Цикл
		
		КодСДР = НачальныйКодСДР + Формат(СледующийНомер, ФорматУровня);
		Строка.КодСДР = КодСДР;
		СледующийНомер = СледующийНомер + 1;
		
		РассчитатьКодСДРДляЗадач(ТаблицаЗадач, Строка[ИмяКолонкиЗадачи], КодСДР + ".");
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПровестиЗадачуСЗаполненнымКодомСДР(Задача, проведенныеЗадачи, Индикатор, 
			ДатаНачалаДляЗадачБезСроков, ТаблицаЗадач)

	Отбор = Новый Структура("Задача", Задача);
	НайденныеСтроки = ТаблицаЗадач.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() <> 0 Тогда		
		ПровестиЗадачу(Задача, проведенныеЗадачи, Индикатор, ДатаНачалаДляЗадачБезСроков,
			ТаблицаЗадач, НайденныеСтроки[0].КодСДР);		
	КонецЕсли;
	
КонецПроцедуры
 
Функция ПолучитьТаблицуПроектныхЗадачСКодамиСДР(ПроектИлиПроектнаяЗадача)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Проекты.Ссылка КАК ПроектнаяЗадачаЗеркало,
	|	Проекты.КодСДР КАК КодСДР,
	|	Проекты.Родитель КАК Родитель
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|ГДЕ
	|	Проекты.Родитель В ИЕРАРХИИ(&ПроектИлиПроектнаяЗадача)
	|	И НЕ Проекты.СсылкаНаПроектнуюЗадачу = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)
	|	И НЕ Проекты.ПометкаУдаления
	|	И НЕ Проекты.ЗадачаОтменена
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСДР";
	
	МассивПроектов = Новый Массив;
	МассивПроектов.Добавить(ПроектИлиПроектнаяЗадача);
	
	Запрос.УстановитьПараметр("ПроектИлиПроектнаяЗадача", МассивПроектов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();		

КонецФункции // ()

Процедура ПересчитатьКодыСДРПроектныхЗадач(Таблица, НайденныеСтроки, НачальныйКодСДР, СледующийНомер, ФорматУровня)

	Для Каждого Строка Из НайденныеСтроки Цикл	
		
		НовыйКодСДР = НачальныйКодСДР + Формат(СледующийНомер, ФорматУровня);
		
		Если Строка.КодСДР <> НовыйКодСДР Тогда
			
			ПЗЗеркало = Строка.ПроектнаяЗадачаЗеркало.ПолучитьОбъект();
			ПЗЗеркало.КодСДР = НовыйКодСДР;
			ПЗЗеркало.Записать();
			
			Отбор = Новый Структура("Родитель", Строка.ПроектнаяЗадачаЗеркало);
			НайденныеСтрокиТаблицы = Таблица.НайтиСтроки(Отбор);
			
			ПромежуточныйФорматУровня = ПолучитьФорматУровня(НайденныеСтрокиТаблицы.Количество());		
			
			ПересчитатьКодыСДРПроектныхЗадач(Таблица, НайденныеСтрокиТаблицы, НовыйКодСДР + ".", 1, ПромежуточныйФорматУровня);
			
		КонецЕсли;
		
		СледующийНомер = СледующийНомер + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьФорматУровня(КоличествоСтрок) 
	
	КоличествоЦифр = СтрДлина(Формат(КоличествоСтрок, "ЧГ="));
	
	Возврат "ЧЦ=" + КоличествоЦифр + "; ЧВН=; ЧГ=";	
	
КонецФункции

