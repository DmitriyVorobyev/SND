#Область ПрограммныйИнтерфейс

// Главный модуль экспорта данных из реального проекта в шаблона проекта по заданным параметрам.
// 
// Параметры:
//  ПараметрыЭкспорта - Структура - содержит настройки пользователя:
//		* Проект                - СправочникСсылка.Проекты.
//		* Этап                  - ДокументСсылка.упоПроектнаяЗадача.
//		* НазваниеШаблона       - Строка.
//		* СоздатьКорневуюЗадачу - Булево.
//  ТекстОшибки       - Строка - заполняется при возникновении ошибки.
// 
// Возвращаемое значение:
//  Булево - признак ошибки.
// 
Функция обЭкспортДанныхПроектаВШаблон(ПараметрыЭкспорта, ТекстОшибки = "") Экспорт
	
	ЕстьОшибка = Ложь;
	ОписаниеОшибки = "";
	Индикатор = Неопределено;
	НовыйШаблон = Неопределено;
	
	НачатьТранзакцию();
	Попытка
		ДанныеПроекта = ПолучитьДанныеПроекта(ПараметрыЭкспорта.Проект);
		
		ЗаписатьДанныеПроектаВШаблон(ПараметрыЭкспорта, ДанныеПроекта, Индикатор, НовыйШаблон);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ЕстьОшибка = Истина;
		ОписаниеОшибки = ОписаниеОшибки();
		ОтменитьТранзакцию();
	КонецПопытки;
	
	Возврат Новый Структура("Ошибка, ОписаниеОшибки, Шаблон", ЕстьОшибка, ОписаниеОшибки, НовыйШаблон);
	
КонецФункции

// Главный модуль импорта данных шаблона проекта в реальный проект по заданным параметрам.
// 
// Параметры:
//  ПараметрыИмпорта - Структура, содержит настройки пользователя:
//		* Шаблон                     - СправочникСсылка.упоШаблоныПроектов.
//		* Проект                     - СправочникСсылка.Проекты.
//		* Этап                       - ДокументСсылка.упоПроектнаяЗадача.
//		* ОчиститьПроект             - Булево.
//		* СоздатьКорневуюЗадачу      - Булево.
//		* ДатаНачала                 - Дата.
//		* КоэффициентМасштабирования - Число.
//  ТекстОшибки      - Строка - заполняется при возникновении ошибки.
// 
// Возвращаемое значение:
//  Булево - признак ошибки.
// 
Функция обИмпортДанныхШаблонаВПроект(ПараметрыИмпорта, ТекстОшибки = "") Экспорт
	
	Проект = ПараметрыИмпорта.Проект;
	
	ЕстьОшибка = Ложь;
	ОписаниеОшибки = "";
	Индикатор = Неопределено;
	
	Попытка
		
		ОписаниеОшибки = ПолучитьСообщениеПроверкиСтатусаПроекта(Проект);
		
		Если ОписаниеОшибки <> "" Тогда
			Возврат Новый Структура("Ошибка, ОписаниеОшибки", Истина, ОписаниеОшибки);
		КонецЕсли;
		
		Если ПараметрыИмпорта.ОчиститьПроект = Истина Тогда
			ЕстьОшибка = ОчиститьПроект(Проект, Индикатор);
			Если ЕстьОшибка = Истина Тогда
				
				ОписаниеОшибки = НСтр("ru = 'Невозможно очистить проект. По проекту имеются фактические данные!'");
				
				Возврат Новый Структура("Ошибка, ОписаниеОшибки", Истина, ОписаниеОшибки);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеШаблона = ПолучитьДанныеШаблона(ПараметрыИмпорта);
		
		ЕстьОшибка = ЗаписатьДанныеШаблонаВПроект(ПараметрыИмпорта, ДанныеШаблона, Индикатор, ТекстОшибки);
		
		Если ЕстьОшибка = Истина Тогда
			
			Возврат Новый Структура("Ошибка, ОписаниеОшибки", Истина, ТекстОшибки);
			
		КонецЕсли;
		
	Исключение
		
		ЕстьОшибка = Истина;
		ТекстОшибки = ОписаниеОшибки();
		
	КонецПопытки;
	
	Возврат Новый Структура("Ошибка, ОписаниеОшибки", ЕстьОшибка, ТекстОшибки);
	
КонецФункции

// Проверяет статус проект и если статус Завершен или Проект не зарегистрирован,
// то возвращает соответствующее сообщение
// Параметры:
//	Проект - СправочникСсылка.Проекты - Проверяемый проект.
//
// Возвращаемое значение:
//	Строка - Пустая строка, если проверка статуса прошла успешно.
//
Функция ПолучитьСообщениеПроверкиСтатусаПроекта(Проект) Экспорт
	
	Статус = упоПроектыИЗадачиСервер.ПолучитьСтатусПроекта(Проект);
	
	ТекстОшибки = "";
	Если Статус = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Отказ выполнения операции. Выбранный проект необходимо зарегистрировать!'");
	КонецЕсли;
	
	СтатусЗавершен = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаПроекта.Завершен");
	Если Статус = СтатусЗавершен Тогда
		
		ТекстОшибки = НСтр("ru = 'Отказ выполнения операции. Выбранный проект не может находиться в статусе %1!'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтатусЗавершен);
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЭкспортПроектаВШаблон

// Функция возвращает данные БД по заданному проекту.
// 
// Параметры:
//	Проект - СправочникСсылка.Проекты - проект.
//
// Возвращаемое значение:
//	ТаблицаЗначений - содержит трубуемые данные.
//		ТаблицаЗадач               - ТаблицаЗначений.
//		ТаблицаПредУсловийЗадач    - ТаблицаЗначений.
//		ТаблицаМатРесурсовЗадач    - ТаблицаЗначений.
// 
Функция ПолучитьДанныеПроекта(Проект)
	
	// Создим возвращаемую структуру.
	ДанныеПроекта = Новый Структура;
	ДанныеПроекта.Вставить("Проект", Проект);
	ДанныеПроекта.Вставить("ТаблицаЗадач");
	ДанныеПроекта.Вставить("ТаблицаСроков");
	ДанныеПроекта.Вставить("ТаблицаПредУсловийЗадач");
	ДанныеПроекта.Вставить("ТаблицаМатРесурсовЗадач");
	ДанныеПроекта.Вставить("ТаблицаСубпродуктовЗадач");
	ДанныеПроекта.Вставить("ТаблицаДопЗатратЗадач");
	ДанныеПроекта.Вставить("ТаблицаТрудовыхРесурсовЗадач");
	ДанныеПроекта.Вставить("ТаблицаФинПланыДДС");
	ДанныеПроекта.Вставить("ТаблицаФинПланыДР");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДоходовЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеРасходовЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеОбъемовЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеПотребностейЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДопЗатратЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДоходовПоПериодамЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеРасходовПоПериодамЗадач");
	ДанныеПроекта.Вставить("ТаблицаТрудовыеРесурсыПоПериодамЗадач");
	
	// Каждое поле возвращаемой структры заполняем отобранными данными из БД.
	текВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.УстановитьПараметр("Дата", '00010101');
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("Версия", текВерсия);
	Запрос.УстановитьПараметр("ЕдВремениЧас", Справочники.упоЕдиницыВремени.Час);
	Запрос.УстановитьПараметр("МатериальныйРесурс", Перечисления.упоВидРесурса.Материальный);
	ИсточникПланаБДР = Новый Массив;
	ИсточникПланаБДР.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ПустаяСсылка());
	ИсточникПланаБДР.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	Запрос.УстановитьПараметр("ИсточникПланаБДР", ИсточникПланаБДР);			
	// Получим данные по задачам проекта.
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СвойстваПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	СвойстваПроектныхЗадач.ЗадачаРодитель КАК Родитель,
		|	СвойстваПроектныхЗадач.НазваниеЗадачи КАК НазваниеЗадачи,
		|	СвойстваПроектныхЗадач.ЭтоПакетРабот КАК ЭтоПакетРабот,
		|	СвойстваПроектныхЗадач.ЭтоВеха КАК ЭтоВеха,
		|	СвойстваПроектныхЗадач.НормаСтоимости КАК НормаСтоимости,
		|	СвойстваПроектныхЗадач.ОписаниеЗадачи КАК ОписаниеЗадачи,
		|	СвойстваПроектныхЗадач.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
		|	СвойстваПроектныхЗадач.НормаСтоимостиТрудовыхРесурсов КАК НормаСтоимостиТрудовыхРесурсов,
		|	СвойстваПроектныхЗадач.Длительность КАК Длительность,
		|	СвойстваПроектныхЗадач.СпособПривязкиДопЗатрат КАК СпособПривязкиДопЗатрат,
		|	СвойстваПроектныхЗадач.ВидОперации КАК ВидОперации,
		|	СвойстваПроектныхЗадач.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта,
		|	СвойстваПроектныхЗадач.РучнойВводСроков КАК РучнойВводСроков,
		|	СвойстваПроектныхЗадач.ВключитьСубпродуктыВПланДоходов КАК ВключитьСубпродуктыВПланДоходов,
		|	СвойстваПроектныхЗадач.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
		|	СвойстваПроектныхЗадач.ВключитьТрудРесурсыВПланРасходов КАК ВключитьТрудРесурсыВПланРасходов,
		|	СвойстваПроектныхЗадач.Объект КАК Объект,
		|	СвойстваПроектныхЗадач.КрайнийСрок КАК КрайнийСрок,
		|	СвойстваПроектныхЗадач.МетодРасчетаМоделиПакетаРабот КАК МетодРасчетаМоделиПакетаРабот,
		|	СвойстваПроектныхЗадач.СпособПланированияРасходов КАК СпособПланированияРасходов,
		|	СвойстваПроектныхЗадач.УчестьРучнойВводСроковПриАктуализации КАК УчестьРучнойВводСроковПриАктуализации,
		|	СвойстваПроектныхЗадач.ПланироватьТрудозатратыНаИсполнителей КАК ПланироватьТрудозатратыНаИсполнителей,
		|	СвойстваПроектныхЗадач.ДлительностьМоделиПакетаРабот КАК ДлительностьМоделиПакетаРабот,
		|	СвойстваПроектныхЗадач.ЕдиницаНормированияДлительности КАК ЕдиницаНормированияДлительности,
		|	СвойстваПроектныхЗадач.КодПроектногоДокумента КАК КодПроектногоДокумента,
		|	СвойстваПроектныхЗадач.КритерийРезультата КАК КритерийРезультата,
		|	СвойстваПроектныхЗадач.ОписаниеРезультата КАК ОписаниеРезультата,
		|	СвойстваПроектныхЗадач.КалендарьЗадачи КАК КалендарьЗадачи,
		|	СвойстваПроектныхЗадач.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов,
		|	СвойстваПроектныхЗадач.УровеньПланированияТрудозатратДляБДР КАК УровеньПланированияТрудозатратДляБДР,
		|	СвойстваПроектныхЗадач.ВключитьПланРасходовВБДДС КАК ВключитьПланРасходовВБДДС,
		|	СвойстваПроектныхЗадач.ВключитьПланДоходовВБДДС КАК ВключитьПланДоходовВБДДС,
		|	СвойстваПроектныхЗадач.СхемаОплатыПоУмолчаниюРасходы КАК СхемаОплатыПоУмолчаниюРасходы,
		|	СвойстваПроектныхЗадач.СхемаОплатыПоУмолчаниюДоходы КАК СхемаОплатыПоУмолчаниюДоходы,
		|	СвойстваПроектныхЗадач.НормаСтоимостиОбъемы КАК НормаСтоимостиОбъемы,
		|	СвойстваПроектныхЗадач.ТипСубпродукта КАК ТипСубпродукта,
		|	СвойстваПроектныхЗадач.ТранслироватьЗатратыПоСубпродуктам КАК ТранслироватьЗатратыПоСубпродуктам,
		|	СвойстваПроектныхЗадач.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача,
		|	СвойстваПроектныхЗадач.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов
		|ПОМЕСТИТЬ втЗадачи
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(&Дата, Версия = &Версия) КАК СвойстваПроектныхЗадач
		|ГДЕ
		|	НЕ СвойстваПроектныхЗадач.ЗадачаОтменена
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ПроектнаяЗадача
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КодыСДР.КодСДР КАК КодСДР,
		|	втЗадачи.ПроектнаяЗадача КАК Задача,
		|	втЗадачи.Родитель КАК Родитель,
		|	втЗадачи.НазваниеЗадачи КАК НазваниеЗадачи,
		|	втЗадачи.ЭтоПакетРабот КАК ЭтоПакетРабот,
		|	втЗадачи.ЭтоВеха КАК ЭтоВеха,
		|	втЗадачи.НормаСтоимости КАК НормаСтоимости,
		|	втЗадачи.ОписаниеЗадачи КАК ОписаниеЗадачи,
		|	втЗадачи.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
		|	втЗадачи.НормаСтоимостиТрудовыхРесурсов КАК НормаСтоимостиТрудовыхРесурсов,
		|	втЗадачи.Длительность КАК Длительность,
		|	втЗадачи.СпособПривязкиДопЗатрат КАК СпособПривязкиДопЗатрат,
		|	втЗадачи.ВидОперации КАК ВидОперации,
		|	втЗадачи.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта,
		|	втЗадачи.РучнойВводСроков КАК РучнойВводСроков,
		|	втЗадачи.ВключитьСубпродуктыВПланДоходов КАК ВключитьСубпродуктыВПланДоходов,
		|	втЗадачи.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
		|	втЗадачи.ВключитьТрудРесурсыВПланРасходов КАК ВключитьТрудРесурсыВПланРасходов,
		|	втЗадачи.Объект КАК Объект,
		|	втЗадачи.КрайнийСрок КАК КрайнийСрок,
		|	втЗадачи.МетодРасчетаМоделиПакетаРабот КАК МетодРасчетаМоделиПакетаРабот,
		|	втЗадачи.СпособПланированияРасходов КАК СпособПланированияРасходов,
		|	втЗадачи.УчестьРучнойВводСроковПриАктуализации КАК УчестьРучнойВводСроковПриАктуализации,
		|	втЗадачи.ПланироватьТрудозатратыНаИсполнителей КАК ПланироватьТрудозатратыНаИсполнителей,
		|	втЗадачи.ДлительностьМоделиПакетаРабот КАК ДлительностьМоделиПакетаРабот,
		|	втЗадачи.ЕдиницаНормированияДлительности КАК ЕдиницаНормированияДлительности,
		|	втЗадачи.КодПроектногоДокумента КАК КодПроектногоДокумента,
		|	втЗадачи.КритерийРезультата КАК КритерийРезультата,
		|	втЗадачи.ОписаниеРезультата КАК ОписаниеРезультата,
		|	втЗадачи.КалендарьЗадачи КАК КалендарьЗадачи,
		|	втЗадачи.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов,
		|	втЗадачи.УровеньПланированияТрудозатратДляБДР КАК УровеньПланированияТрудозатратДляБДР,
		|	втЗадачи.ВключитьПланРасходовВБДДС КАК ВключитьПланРасходовВБДДС,
		|	втЗадачи.ВключитьПланДоходовВБДДС КАК ВключитьПланДоходовВБДДС,
		|	втЗадачи.СхемаОплатыПоУмолчаниюРасходы КАК СхемаОплатыПоУмолчаниюРасходы,
		|	втЗадачи.СхемаОплатыПоУмолчаниюДоходы КАК СхемаОплатыПоУмолчаниюДоходы,
		|	втЗадачи.НормаСтоимостиОбъемы КАК НормаСтоимостиОбъемы,
		|	втЗадачи.ТипСубпродукта КАК ТипСубпродукта,
		|	втЗадачи.ТранслироватьЗатратыПоСубпродуктам КАК ТранслироватьЗатратыПоСубпродуктам,
		|	втЗадачи.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача,
		|	втЗадачи.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов
		|ИЗ
		|	втЗадачи КАК втЗадачи
