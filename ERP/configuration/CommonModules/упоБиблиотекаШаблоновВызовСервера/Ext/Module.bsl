Функция ПолучитьШаблоныППДляСубпродуктов(СубпродуктыЗадачи, ПроектнаяЗадача, ЭтоСохранениеВШаблон) 
    
	СоответствиеШаблоновПП = Новый Соответствие; 
	МассивПП = Новый Массив;
	МассивИсключений = Новый Массив;
	
	Для Каждого Субпродукт Из СубпродуктыЗадачи Цикл
		МассивПП.Добавить(Субпродукт.Ресурс);		
	КонецЦикла;
	
	РеквизитыПП = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивПП, "ШаблонПроектнойПродукции, Шаблон");
	
	Для каждого ПроектнаяПродукция Из МассивПП Цикл		
				
		Если ЭтоСохранениеВШаблон Тогда 
			
			Если ЗначениеЗаполнено(РеквизитыПП[ПроектнаяПродукция].ШаблонПроектнойПродукции) Тогда
				СоответствиеШаблоновПП.Вставить(ПроектнаяПродукция, РеквизитыПП[ПроектнаяПродукция].ШаблонПроектнойПродукции);
			Иначе
				МассивИсключений.Добавить(ПроектнаяПродукция);
			КонецЕсли;
			
		Иначе
			
			Если РеквизитыПП[ПроектнаяПродукция].Шаблон Тогда
				СоответствиеШаблоновПП.Вставить(ПроектнаяПродукция, РеквизитыПП[ПроектнаяПродукция].Шаблон);
			Иначе
				МассивИсключений.Добавить(ПроектнаяПродукция);
            КонецЕсли;

		КонецЕсли;
				
	КонецЦикла;
	
	ОбработатьСообщениеИсключений(МассивИсключений, ПроектнаяЗадача, ЭтоСохранениеВШаблон);
	
	Возврат СоответствиеШаблоновПП;
  
КонецФункции

Функция ПредставлениеПроектнойЗадачи(ПроектнаяЗадача)
	
	МассивПЗ = Новый Массив;
	МассивПЗ.Добавить(ПроектнаяЗадача);
	НазванияПроектныхЗадач = упоПроектыИЗадачиСервер.НазванияПроектныхЗадач(МассивПЗ);
	ПредставлениеПЗ = НазванияПроектныхЗадач.Получить(ПроектнаяЗадача);
	
	Возврат ПредставлениеПЗ;

КонецФункции 

Процедура ОбработатьСообщениеИсключений(МассивИсключений, ПроектнаяЗадача, ЭтоСохранениеВШаблон)
	
	Если Не ЗначениеЗаполнено(МассивИсключений) Тогда
		Возврат;	
	КонецЕсли;
	
    Если ЭтоСохранениеВШаблон Тогда
    	
    	ПредставлениеПЗ = ПредставлениеПроектнойЗадачи(ПроектнаяЗадача);
 
    	ТекстСообщения = 
    		СтрШаблон(НСтр("ru = 'В проектной задаче ""%1"" проектная продукция 
    			|%2 
    			|не может быть выгружена по причине: не заполнен реквизит ""Шаблон ПП"".'"),		
    			ПредставлениеПЗ,
    			(СтрСоединить(МассивИсключений, Символы.ПС)));
    	
    Иначе
    	
    	ТекстСообщения =
    		СтрШаблон(НСтр("ru = 'Для проектной задачи ""%1"" проектная продукция 
    			|%2
    			|не развернута по причине: проектная продукция не является шаблоном.'"),
    	        ПроектнаяЗадача.Наименование,
    	        (СтрСоединить(МассивИсключений, Символы.ПС)));
    			    	
    КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

Функция УдаленаСтрокаПроектнойПродукции(ЭтоЗадачаПП, СоответствиеШаблоновПП, Субпродукт, ТаблицаРаспределения)
	
	СтрокаУдалена = Ложь;
	
	Если ЭтоЗадачаПП Тогда
		
		ШаблонПП = СоответствиеШаблоновПП.Получить(Субпродукт.Ресурс);
		
		Если Не ЗначениеЗаполнено(ШаблонПП) Тогда
			
			СтрокиРаспределенияПЗ = ТаблицаРаспределения.НайтиСтроки(Новый Структура("Задача", Субпродукт.Задача));
			СтрокиРаспределения = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПодразделениям(Субпродукт, 
				СтрокиРаспределенияПЗ);
			
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл					
				ТаблицаРаспределения.Удалить(СтрокаРаспределения);
			КонецЦикла;
			
			СтрокаУдалена = Истина;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаУдалена;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьПоДаннымПроектнойПродукции(ДанныеПроекта)
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач.Колонки.Добавить("ПроцентРаспределения", ТипЧисло);
 	ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач.Колонки.Добавить("КоэффициентСложности", ТипЧисло);
 	ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач.Колонки.Добавить("Трудоемкость", ТипЧисло);
	ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач.Колонки.Добавить("Нормирование", ТипЧисло);
		
	СписокСвойств = "ПроцентРаспределения, Количество, КоэффициентСложности, Трудоемкость, Нормирование";
	Для Каждого СтрокаПП Из ДанныеПроекта.ТаблицаСубпродуктовЗадач Цикл
        
        Если Не ТипЗнч(СтрокаПП.Ресурс) = Тип("СправочникСсылка.упоПроектнаяПродукция") Тогда
            Продолжить;	
        КонецЕсли;
        
		Для Каждого СтрокаРоли Из СтрокаПП.Ресурс.РолиТР Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Роль", СтрокаРоли.РольТР);
			ПараметрыОтбора.Вставить("Подразделение", СтрокаРоли.Подразделение);
			ПараметрыОтбора.Вставить("ИндексСтрокиВладельца", СтрокаПП.ИндексСтрокРаспределения);
			ПараметрыОтбора.Вставить("Задача", СтрокаПП.Задача);
			СтрокиРаспределения = ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач.НайтиСтроки(ПараметрыОтбора);
			
			Если СтрокиРаспределения.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокиРаспределения[0], СтрокаРоли, СписокСвойств);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
