		|	ДанныеПлановОбъемовПодразделения.ИндексСтрокиВладельца КАК ИндексСтрокиВладельца
		|ИЗ
		|	РегистрСведений.упоДанныеПлановОбъемовПодразделения.СрезПоследних(
		|			,
		|			Версия = &Версия
		|				И ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Расход)) КАК ДанныеПлановОбъемовПодразделения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадачи КАК втЗадачи
		|		ПО ДанныеПлановОбъемовПодразделения.ПроектнаяЗадача = втЗадачи.ПроектнаяЗадача
		|ГДЕ
		|	(ДанныеПлановОбъемовПодразделения.СуммаВалютная <> 0
		|			ИЛИ ДанныеПлановОбъемовПодразделения.Сумма <> 0
		|			ИЛИ ДанныеПлановОбъемовПодразделения.Количество <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеПлановОбъемовПодразделения.ПроектнаяЗадача,
		|	ДанныеПлановОбъемовПодразделения.ДатаНачисления,
		|	ДанныеПлановОбъемовПодразделения.Подразделение,
		|	ДанныеПлановОбъемовПодразделения.Роль,
		|	ДанныеПлановОбъемовПодразделения.СобствСилы_Субподряд,
		|	ДанныеПлановОбъемовПодразделения.СпособПривязки,
		|	ДанныеПлановОбъемовПодразделения.ПрофильРаспределения,
		|	ДанныеПлановОбъемовПодразделения.ИндексСтрокиВладельца,
		|	ДанныеПлановОбъемовПодразделения.ИндексСтрокРаспределенияПоПериодам";
	
	ДанныеПроекта.Вставить("ТаблицаРаспределениеПотребностейЗадач", Запрос.Выполнить().Выгрузить());
	
	// Получим данные по распределению доходов по периодам проектных задач.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеРаспределенияДоходовПоПериодам.ПроектнаяЗадача КАК Задача,
		|	ДанныеРаспределенияДоходовПоПериодам.ПериодРаспределения КАК Период,
		|	ДанныеРаспределенияДоходовПоПериодам.ИндексСтрокиРаспределениеПоРолям КАК ИндексСтрокиРаспределениеПоРолям,
		|	ДанныеРаспределенияДоходовПоПериодам.ИндексСтрокиРаспределенияДоходов КАК ИндексСтрокиРаспределенияДоходов,
		|	СУММА(ДанныеРаспределенияДоходовПоПериодам.Сумма) КАК Сумма,
		|	СУММА(ДанныеРаспределенияДоходовПоПериодам.Количество) КАК Количество
		|ИЗ
		|	РегистрСведений.упоДанныеРаспределенияДоходовПоПериодам.СрезПоследних(, Версия = &Версия) КАК ДанныеРаспределенияДоходовПоПериодам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадачи КАК втЗадачи
		|		ПО ДанныеРаспределенияДоходовПоПериодам.ПроектнаяЗадача = втЗадачи.ПроектнаяЗадача
		|ГДЕ
		|	(ДанныеРаспределенияДоходовПоПериодам.Сумма <> 0
		|			ИЛИ ДанныеРаспределенияДоходовПоПериодам.Количество <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеРаспределенияДоходовПоПериодам.ПериодРаспределения,
		|	ДанныеРаспределенияДоходовПоПериодам.ПроектнаяЗадача,
		|	ДанныеРаспределенияДоходовПоПериодам.ИндексСтрокиРаспределениеПоРолям,
		|	ДанныеРаспределенияДоходовПоПериодам.ИндексСтрокиРаспределенияДоходов";
	
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДоходовПоПериодамЗадач", Запрос.Выполнить().Выгрузить());
	
	// Получим данные по распределению расходов по периодам проектных задач.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеРаспределенияРасходов.ПроектнаяЗадача КАК Задача,
		|	ДанныеРаспределенияРасходов.ПериодРаспределения КАК Период,
		|	ДанныеРаспределенияРасходов.ИндексСтрокиРаспределениеПоРолям КАК ИндексСтрокиРаспределениеПоРолям,
		|	ДанныеРаспределенияРасходов.ИндексСтрокиРаспределенияРасходов КАК ИндексСтрокиРаспределенияРасходов,
		|	ДанныеРаспределенияРасходов.ИсточникПлана КАК ИсточникПлана,
		|	СУММА(ДанныеРаспределенияРасходов.Сумма) КАК Сумма,
		|	СУММА(ДанныеРаспределенияРасходов.Количество) КАК Количество
		|ИЗ
		|	РегистрСведений.упоДанныеРаспределенияРасходовПоПериодам.СрезПоследних(, Версия = &Версия) КАК ДанныеРаспределенияРасходов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадачи КАК втЗадачи
		|		ПО ДанныеРаспределенияРасходов.ПроектнаяЗадача = втЗадачи.ПроектнаяЗадача
		|ГДЕ
		|	ДанныеРаспределенияРасходов.ИсточникПлана В(&ИсточникПланаБДР)
		|	И (ДанныеРаспределенияРасходов.Сумма <> 0
		|			ИЛИ ДанныеРаспределенияРасходов.Количество <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеРаспределенияРасходов.ПериодРаспределения,
		|	ДанныеРаспределенияРасходов.ПроектнаяЗадача,
		|	ДанныеРаспределенияРасходов.ИндексСтрокиРаспределениеПоРолям,
		|	ДанныеРаспределенияРасходов.ИндексСтрокиРаспределенияРасходов,
		|	ДанныеРаспределенияРасходов.ИсточникПлана";
	
	ДанныеПроекта.Вставить("ТаблицаРаспределениеРасходовПоПериодамЗадач", Запрос.Выполнить().Выгрузить());
	
	// Получим данные трудовые ресурсы по периодам проектных задач.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ПроектнаяЗадача КАК Задача,
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ПериодРаспределения КАК Период,
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ИндексСтрокиРаспределениеПоРолям КАК ИндексСтрокиРаспределениеПоРолям,
		|	СУММА(ДанныеРаспределенияТрудовыхРесурсовПоПериодам.Количество) КАК Количество
		|ИЗ
		|	РегистрСведений.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.СрезПоследних(, Версия = &Версия) КАК ДанныеРаспределенияТрудовыхРесурсовПоПериодам
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадачи КАК втЗадачи
		|		ПО ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ПроектнаяЗадача = втЗадачи.ПроектнаяЗадача
		|ГДЕ
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.Количество <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ПроектнаяЗадача,
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ПериодРаспределения,
		|	ДанныеРаспределенияТрудовыхРесурсовПоПериодам.ИндексСтрокиРаспределениеПоРолям";
	
	ДанныеПроекта.Вставить("ТаблицаТрудовыеРесурсыПоПериодамЗадач", Запрос.Выполнить().Выгрузить());
	
	ЗаполнитьТабличнуюЧастьПоДаннымПроектнойПродукции(ДанныеПроекта);
	
	// Возвращаем полученные данные.
	Возврат ДанныеПроекта;
	
КонецФункции

// Функция рассчитывает количество элементов для записи.
// Используется для индикатора о ходе выполнения процесса.
// 
// Параметры:
//  ПараметрыЭкспорта - Структура, содержит настройки пользователя:
//   * Шаблон                     - СправочникСсылка.упоШаблоныПроектов.
//   * Проект                     - СправочникСсылка.Проекты.
//   * Этап                       - ДокументСсылка.упоПроектнаяЗадача.
//   * ОчиститьПроект             - Булево.
//   * СоздатьКорневуюЗадачу      - Булево.
//   * ДатаНачала                 - Дата.
//   * КоэффициентМасштабирования - Число.
//  ДанныеПроекта     - Структура, содержит данные реального проекта:
//   * ТаблицаЗадач               - ТаблицаЗначений.
//   * ТаблицаПредУсловийЗадач    - ТаблицаЗначений.
//   * ТаблицаМатРесурсовЗадач    - ТаблицаЗначений.
// 
// Возвращаемое значение:
//  Число - количество элементов.
// 
Функция ПолучитьКоличествоЭлементов(ПараметрыЭкспорта, ДанныеПроекта)
	
	КолЭлементов = 0;
	
	// Массив для хранения задач.
	МассивЗадач = Новый Массив;
	
	ОтборПоЗадаче   = Новый Структура("Задача");
	ОтборПоРодителю = Новый Структура("Родитель");
	
	КорневаяЗадача = ПараметрыЭкспорта.Этап;
	
	// Определим корневые задачи.
	Если КорневаяЗадача = Документы.упоПроектнаяЗадача.ПустаяСсылка() Или ПараметрыЭкспорта.СоздатьКорневуюЗадачу = Ложь Тогда
		ОтборПоРодителю.Вставить("Родитель", КорневаяЗадача);
		
		МассивСтрок = ДанныеПроекта.ТаблицаЗадач.НайтиСтроки(ОтборПоРодителю);
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			МассивЗадач.Добавить(ТекСтрока);
		КонецЦикла;
	Иначе
		ТекСтрока = ДанныеПроекта.ТаблицаЗадач.Найти(КорневаяЗадача, "Задача");
		Если Не ТекСтрока = Неопределено Тогда
			МассивЗадач.Добавить(ТекСтрока);
		КонецЕсли;
	КонецЕсли;
	
	// Перебираем массив задач и внутри для каждой текущей задачи ищем ее потомков.
	// Далее каждого потомка текущей задачи добавляем в тот же массив задач для последующего обхода.
	Для Каждого ДанныеЗадачи Из МассивЗадач Цикл
		// Добавим элемент.
		КолЭлементов = КолЭлементов + 1;
		
		// Отбор по текущей задаче.
		ОтборПоЗадаче.Вставить("Задача", ДанныеЗадачи.Задача);
				
		// Отбор по родителю текущей задачи.
		ОтборПоРодителю.Вставить("Родитель", ДанныеЗадачи.Задача);
		
		МассивСтрок = ДанныеПроекта.ТаблицаЗадач.НайтиСтроки(ОтборПоРодителю);
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			МассивЗадач.Добавить(ТекСтрока);
		КонецЦикла;
	КонецЦикла;
	
	Возврат КолЭлементов;
	
КонецФункции

// Модуль записи шаблона проектной задачи по данным реальной проекной задачи.
// 
// Параметры:
//  ШаблонПроекта       - СправочникСсылка.упоШаблоныПроектов.
//  ДанныеПроекта       - Структура, содержит данные проекта:
//   * ТаблицаЗадач               - ТаблицаЗначений.
//   * ТаблицаПредУсловийЗадач    - ТаблицаЗначений.
//   * ТаблицаМатРесурсовЗадач    - ТаблицаЗначений.
//  ДанныеЗадачи        - СтрокаТаблицыЗначений - содержит данные конкретной задачи проекта.
//  СоответствиеШаблона - Соответствие - содержит соответствия задач и созданных по ним шаблонов.
//  Индикатор           - Форма - индикатор выполнения процесса (прогресс бар).
//  Журнал 				- РегистрСведенийНаборЗаписей - для фиксации связи между шаблоном и проектом.
// 
// Возвращаемое значение:
//  ДокументСсылка.упоПроектнаяЗадача - ссылка на созданную проектную задачу.
// 
Функция ЗаписатьДанныеЗадачиВШаблон(ШаблонПроекта, ДанныеПроекта, ДанныеЗадачи, СоответствиеШаблона,
	Индикатор, Журнал = Неопределено, СоответствиеКонтрагентов = Неопределено)
		
	ШаблонЗадачи = Справочники.упоШаблоныПроектныхЗадач.СоздатьЭлемент();
	
	// Отбор по заданной задаче.
	Отбор = Новый Структура("Задача", ДанныеЗадачи.Задача);
	
	// Если есть родительская задача, то получаем к ней соответствующий шаблон.
	Если Не ДанныеЗадачи.Родитель = Документы.упоПроектнаяЗадача.ПустаяСсылка() Тогда
		ШаблонЗадачиРодителя = СоответствиеШаблона.Получить(ДанныеЗадачи.Родитель);
	Иначе
		ШаблонЗадачиРодителя = Неопределено;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ШаблонЗадачи, ДанныеЗадачи);	
	
	ШаблонЗадачи.Наименование   		 = ДанныеЗадачи.НазваниеЗадачи;
	ШаблонЗадачи.НазваниеПроектнойЗадачи = ДанныеЗадачи.НазваниеЗадачи;
	ШаблонЗадачи.ПолноеНаименование      = ДанныеЗадачи.НазваниеЗадачи;
	ШаблонЗадачи.Владелец       		 = ШаблонПроекта;
	ШаблонЗадачи.Родитель       		 = ШаблонЗадачиРодителя;
	
	// Получим сроки задачи.
	СтрокиСроковЗадачи = ДанныеПроекта.ТаблицаСроков.НайтиСтроки(Отбор);
	Для каждого СрокиЗадачи Из СтрокиСроковЗадачи Цикл
		ШаблонЗадачи.ДатаНачалаПлан			 = СрокиЗадачи.ДатаНачалаПлан;
		ШаблонЗадачи.ДатаЗавершенияПлан		 = СрокиЗадачи.ДатаЗавершенияПлан;
	КонецЦикла;
		
	// Получим состав материальных ресуров заданной задачи.
	МатРесурсыЗадачи = ДанныеПроекта.ТаблицаМатРесурсовЗадач.НайтиСтроки(Отбор);
	Для каждого МатРесурс Из МатРесурсыЗадачи Цикл
		НоваяСтрока = ШаблонЗадачи.МатериальныеРесурсы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, МатРесурс);
		НоваяСтрока.Стоимость           = МатРесурс.СтоимостьЕд;
		НоваяСтрока.ОбщСтоимость        = МатРесурс.Стоимость;
	КонецЦикла;
	
	// Получим состав субпродуктов заданной задачи.
	ЭтоЗадачаПроектнойПродукции = ДанныеЗадачи.ТипСубпродукта = 
		ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипСубпродукта.ПроектнаяПродукция");
	
	СубпродуктыЗадачи = ДанныеПроекта.ТаблицаСубпродуктовЗадач.НайтиСтроки(Отбор);

	Если ЭтоЗадачаПроектнойПродукции Тогда		
		СоответствиеШаблоновПП = ПолучитьШаблоныППДляСубпродуктов(СубпродуктыЗадачи, ДанныеЗадачи.Задача, Истина);
	КонецЕсли;

	Для Каждого Субпродукт Из СубпродуктыЗадачи Цикл
				
		Если УдаленаСтрокаПроектнойПродукции(ЭтоЗадачаПроектнойПродукции, СоответствиеШаблоновПП, Субпродукт, 
			ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач) Тогда			
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ШаблонЗадачи.Субпродукты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Субпродукт);
		НоваяСтрока.Стоимость           = Субпродукт.СтоимостьЕд;
		НоваяСтрока.ОбщСтоимость        = Субпродукт.Стоимость;
		
		Если ЭтоЗадачаПроектнойПродукции Тогда			
			НоваяСтрока.Ресурс 			= СоответствиеШаблоновПП.Получить(Субпродукт.Ресурс);					
		КонецЕсли;				
	КонецЦикла;
	
	// Получим трудовые ресурсы и параметры для модели пакета работ.	
	
	ШаблонЗадачи.ДлительностьМоделиПакетаРабот = ДанныеЗадачи.ДлительностьМоделиПакетаРабот;
	ШаблонЗадачи.ЕдиницаНормированияДлительности = ДанныеЗадачи.ЕдиницаНормированияДлительности;
	ШаблонЗадачи.НормаСтоимостиТрудовыхРесурсов = ДанныеЗадачи.НормаСтоимостиТрудовыхРесурсов;
	ШаблонЗадачи.ДлительностьБезУчетаКалендаряПроекта = ДанныеЗадачи.ДлительностьБезУчетаКалендаряПроекта;
	
	ТрудовыеРесурсыЗадачи = ДанныеПроекта.ТаблицаТрудовыхРесурсовЗадач.НайтиСтроки(Отбор);
	Для каждого СтрокаРесурс Из ТрудовыеРесурсыЗадачи Цикл
		НоваяСтрока 					= ШаблонЗадачи.ТрудовыеРесурсы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРесурс);
		НоваяСтрока.ОбщСтоимость 		= СтрокаРесурс.Стоимость;
		НоваяСтрока.Стоимость 			= ?(СтрокаРесурс.Количество > 0, СтрокаРесурс.Стоимость / СтрокаРесурс.Количество, 0);
		НоваяСтрока.ОбщВнешняяСтоимость = СтрокаРесурс.ВнешняяСтоимость;
		НоваяСтрока.ВнешняяСтоимость 	= ?(СтрокаРесурс.Количество > 0, СтрокаРесурс.ВнешняяСтоимость / СтрокаРесурс.Количество, 0);
	КонецЦикла; 
	
	// Получим данные финансовых планов проектной задачи.
	ДанныеБДДС = ДанныеПроекта.ТаблицаФинПланыДДС.НайтиСтроки(Отбор);
	
	Для каждого ФинСтрока Из ДанныеБДДС Цикл
						
		ФинСтрокаШаблона = Неопределено;
		Если ФинСтрока.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата Тогда
			
			ФинСтрокаШаблона = ШаблонЗадачи.ПланВыплат.Добавить();
			
		ИначеЕсли ФинСтрока.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление Тогда
			
			ФинСтрокаШаблона = ШаблонЗадачи.ПланПоступлений.Добавить();
			
		КонецЕсли;
		
		Если ФинСтрокаШаблона = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		ФинСтрокаШаблона.Статья 	= ФинСтрока.СтатьяДДС;
		ФинСтрокаШаблона.ВидПлатежа 	= ФинСтрока.ВидПлатежа;
		ФинСтрокаШаблона.Валюта 	= ФинСтрока.Валюта;
		ФинСтрокаШаблона.Сумма 		= ФинСтрока.Сумма;		
		ФинСтрокаШаблона.Задержка 	= ФинСтрока.Задержка;
		ФинСтрокаШаблона.ПрофильРаспределения = ФинСтрока.ПрофильРаспределения;
		
		Если ФинСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДДС.НаДату Тогда
			ФинСтрокаШаблона.СпособПривязки = Перечисления.упоСпособПривязкиДДС.НачалоЗадачи;
		Иначе
			ФинСтрокаШаблона.СпособПривязки = ФинСтрока.СпособПривязки;
		КонецЕсли;
		
		СтрокаСоответствие = СоответствиеКонтрагентов.Найти(ФинСтрока.Контрагент, "Контрагент");
		Если СтрокаСоответствие <> Неопределено Тогда
			ФинСтрокаШаблона.Контрагент = СтрокаСоответствие.ШаблонКонтрагента;
		КонецЕсли;	
		
		НоваяСтрока =  ШаблонЗадачи.ДвиженияДенежныхСредств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ФинСтрока);
		
	КонецЦикла; 
	
	ПрофильПоУмолчанию = Неопределено;
	ВыборкаПрофилей = Справочники.упоПрофилиРаспределенияДоходовИРасходов.Выбрать();
	Если ВыборкаПрофилей.Следующий() Тогда
		ПрофильПоУмолчанию = ВыборкаПрофилей.Ссылка;
	КонецЕсли;
	
	ДанныеБДР = ДанныеПроекта.ТаблицаФинПланыДР.НайтиСтроки(Отбор);
	
	Для каждого ФинСтрока Из ДанныеБДР Цикл
		
		ФинСтрокаШаблона = Неопределено;
		Если ФинСтрока.ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход Тогда
			ФинСтрокаШаблона = ШаблонЗадачи.ПланДоходов.Добавить();
		ИначеЕсли ФинСтрока.ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход Тогда
			ФинСтрокаШаблона = ШаблонЗадачи.ПланРасходов.Добавить();
		КонецЕсли;
		
		Если ФинСтрокаШаблона = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(ФинСтрокаШаблона, ФинСтрока);
		
		ФинСтрокаШаблона.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
		Если Не ЗначениеЗаполнено(ФинСтрока.ПрофильРаспределения) Тогда
			ФинСтрокаШаблона.ПрофильРаспределения = ПрофильПоУмолчанию;
		Иначе
			ФинСтрокаШаблона.ПрофильРаспределения = ФинСтрока.ПрофильРаспределения;
		КонецЕсли;
		
		СтрокаСоответствие = СоответствиеКонтрагентов.Найти(ФинСтрока.Контрагент, "Контрагент");
		Если СтрокаСоответствие <> Неопределено Тогда
			ФинСтрокаШаблона.Контрагент = СтрокаСоответствие.ШаблонКонтрагента;
		КонецЕсли;
		
	КонецЦикла; 
	
	// Получим дополнительные затраты проектной задачи.
	
	ДопЗатраты = ДанныеПроекта.ТаблицаДопЗатратЗадач.НайтиСтроки(Отбор);
	Для каждого ДопЗатрата Из ДопЗатраты Цикл				
		НоваяСтрока = ШаблонЗадачи.ДополнительныеЗатраты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДопЗатрата, , "КонтрагентДоходовРасходов");
				
		СтрокаСоответствие = СоответствиеКонтрагентов.Найти(ДопЗатрата.КонтрагентДоходовРасходов, "Контрагент");
		Если СтрокаСоответствие <> Неопределено Тогда
			НоваяСтрока.КонтрагентДоходовРасходов = СтрокаСоответствие.ШаблонКонтрагента;	
		КонецЕсли;		
	КонецЦикла; 
		
	РаспределениеДопЗатрат = ДанныеПроекта.ТаблицаРаспределениеДопЗатратЗадач.НайтиСтроки(Отбор);
	Для каждого ДопЗатрата Из РаспределениеДопЗатрат Цикл
				
		НоваяСтрока 			 = ШаблонЗадачи.РаспределениеДополнительныхЗатрат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДопЗатрата, ,"КонтрагентПодрядчик");
		
		СтрокаСоответствие = СоответствиеКонтрагентов.Найти(ДопЗатрата.КонтрагентПодрядчик, "Контрагент");
		Если СтрокаСоответствие <> Неопределено Тогда
			НоваяСтрока.КонтрагентПодрядчик = СтрокаСоответствие.ШаблонКонтрагента;	
		КонецЕсли;
		
	КонецЦикла; 

		
	// Получить данные распределения доходов.
	МассивСтрок = ДанныеПроекта.ТаблицаРаспределениеДоходовЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
						
		НоваяСтрока = ШаблонЗадачи.РаспределениеДоходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		СтрокаСоответствие = СоответствиеКонтрагентов.Найти(Строка.Контрагент, "Контрагент");
		Если СтрокаСоответствие <> Неопределено Тогда
			НоваяСтрока.КонтрагентПодрядчик = СтрокаСоответствие.ШаблонКонтрагента;
		КонецЕсли;	
		
	КонецЦикла;
	
	// Получить данные распределения расходов.
	МассивСтрок = ДанныеПроекта.ТаблицаРаспределениеРасходовЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
		
		НоваяСтрока = ШаблонЗадачи.РаспределениеРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	// Получить данные распределения объемов
	МассивСтрок = ДанныеПроекта.ТаблицаРаспределениеОбъемовЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
				
		НоваяСтрока = ШаблонЗадачи.РаспределениеОбъемов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		СтрокаСоответствие = СоответствиеКонтрагентов.Найти(Строка.Контрагент, "Контрагент");
		Если СтрокаСоответствие <> Неопределено Тогда
			НоваяСтрока.КонтрагентПодрядчик = СтрокаСоответствие.ШаблонКонтрагента;
		КонецЕсли;	
		
	КонецЦикла;
	
	
	// Получить данные распределения потребностей.
	МассивСтрок = ДанныеПроекта.ТаблицаРаспределениеПотребностейЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
		
		НоваяСтрока = ШаблонЗадачи.РаспределениеПотребностей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	// Получить данные распределение доходов по периодам.
	МассивСтрок = ДанныеПроекта.ТаблицаРаспределениеДоходовПоПериодамЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
		
		НоваяСтрока = ШаблонЗадачи.РаспределениеДоходовПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	// Получить данные распределение расходов по периодам.
	МассивСтрок = ДанныеПроекта.ТаблицаРаспределениеРасходовПоПериодамЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
		
		НоваяСтрока = ШаблонЗадачи.РаспределениеРасходовПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	// Получить данные трудовые ресурсы по периодам.
	МассивСтрок = ДанныеПроекта.ТаблицаТрудовыеРесурсыПоПериодамЗадач.НайтиСтроки(Отбор);
	Для каждого Строка Из МассивСтрок Цикл
		
		НоваяСтрока = ШаблонЗадачи.ТрудовыеРесурсыПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	ШаблонЗадачи.Записать();
	
	Если Не Журнал = Неопределено Тогда  		
		
		ЗаписьЖурнала = Журнал.Добавить();
		ЗаписьЖурнала.ВидОперации 	= Перечисления.упоОперацияБиблиотекиШаблонов.ЗаписьПроектаВШаблон;
		ЗаписьЖурнала.ОбъектПроекта = ДанныеЗадачи.Задача;
		ЗаписьЖурнала.ОбъектШаблона = ШаблонЗадачи.Ссылка;
		ЗаписьЖурнала.Пользователь 	= Пользователи.ТекущийПользователь();
		ЗаписьЖурнала.Период 		= ТекущаяДата();
		
	КонецЕсли; 
	
	Возврат ШаблонЗадачи.Ссылка;
	
КонецФункции

// Базовый модуль экспорта данных из реального проекта в шаблона проекта.
// 
// Параметры:
//  ПараметрыЭкспорта - Структура - содержит настройки пользователя:
//   * Шаблон                     - СправочникСсылка.упоШаблоныПроектов.
//   * Проект                     - СправочникСсылка.Проекты.
//   * Этап                       - ДокументСсылка.упоПроектнаяЗадача.
//   * ОчиститьПроект             - Булево.
//   * СоздатьКорневуюЗадачу      - Булево.
//   * ДатаНачала                 - Дата.
//   * КоэффициентМасштабирования - Число.
//  ДанныеПроекта     - Структура - содержит данные реального проекта:
//   * ТаблицаЗадач               - ТаблицаЗначений.
//   * ТаблицаПредУсловийЗадач    - ТаблицаЗначений.
//   * ТаблицаМатРесурсовЗадач    - ТаблицаЗначений.
//  Индикатор         - Форма - индикатор выполнения процесса (прогресс бар).
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
// 
Функция ЗаписатьДанныеПроектаВШаблон(ПараметрыЭкспорта, ДанныеПроекта, Индикатор, НовыйШаблон = Неопределено)
	
	НазваниеШаблона = ПараметрыЭкспорта.НазваниеШаблона;
	КорневаяЗадача = ПараметрыЭкспорта.Этап;
	СопоставлениеКонтрагентов = ПараметрыЭкспорта.СопоставлениеКонтрагентов;
	
	КолЭлементов = ПолучитьКоличествоЭлементов(ПараметрыЭкспорта, ДанныеПроекта);
			
	// Массив для хранения задач.
	СписокЗадач = Новый СписокЗначений();
	// Соответствие для задачи/операции и ее шаблона.
	СоответствиеШаблона = Новый Соответствие;
	Отбор = Новый Структура;
	
	// Создаем шаблон проекта.
	ШаблонПроекта = Справочники.упоШаблоныПроектов.СоздатьЭлемент();
	ШаблонПроекта.Наименование = НазваниеШаблона;
	
	Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ПараметрыЭкспорта.ГруппаШаблонов) Тогда      
		ШаблонПроекта.Родитель = ПараметрыЭкспорта.ГруппаШаблонов;
	КонецЕсли; 
	
	ШаблонПроекта.Записать();
	НовыйШаблон = ШаблонПроекта.Ссылка;
			
	// Определим корневые задачи.
	Если КорневаяЗадача = Документы.упоПроектнаяЗадача.ПустаяСсылка() Или ПараметрыЭкспорта.СоздатьКорневуюЗадачу = Ложь Тогда
		Отбор.Вставить("Родитель", КорневаяЗадача);
		
		МассивСтрок = ДанныеПроекта.ТаблицаЗадач.НайтиСтроки(Отбор);
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			СписокЗадач.Добавить(ТекСтрока, ТекСтрока.КодСДР);
		КонецЦикла;
	Иначе
		ТекСтрока = ДанныеПроекта.ТаблицаЗадач.Найти(КорневаяЗадача, "Задача");
		Если Не ТекСтрока = Неопределено Тогда
			СписокЗадач.Добавить(ТекСтрока, ТекСтрока.КодСДР);
		КонецЕсли;
	КонецЕсли;
	
	// Далее будем записывать всю ветку от корневой задачи, включая корневую задачу если необходимо.
	
	// Перебираем массив задач и внутри для каждой текущей задачи ищем ее потомков.
	// Далее каждого потомка текущей задачи добавляем в тот же массив задач для последующего обхода.
	
	// Зафиксируем в служебном регистре производимые операции.
	Если ПараметрыЭкспорта.СохранитьСоответствие Тогда      
		Журнал = РегистрыСведений.упоОперацииБиблиотекиШаблонов.СоздатьНаборЗаписей();
	Иначе
		Журнал = Неопределено;	
	КонецЕсли; 
	
	СписокЗадач.СортироватьПоПредставлению();
	
	Для Каждого ДанныеЗадачи Из СписокЗадач Цикл
		
		// Запишем данные текущей задачи.
		ШаблонЗадачи = ЗаписатьДанныеЗадачиВШаблон(ШаблонПроекта.Ссылка, ДанныеПроекта, ДанныеЗадачи.Значение,
			СоответствиеШаблона, Индикатор, Журнал, СопоставлениеКонтрагентов);
		
		// Создадим соответствие задачи ее шаблону.
		СоответствиеШаблона.Вставить(ДанныеЗадачи.Значение.Задача, ШаблонЗадачи);
		
		Отбор.Вставить("Родитель", ДанныеЗадачи.Значение.Задача);
		
		МассивСтрок = ДанныеПроекта.ТаблицаЗадач.НайтиСтроки(Отбор);
		СписокСтрок = Новый СписокЗначений();
		
		Для Каждого ТекСтрока Из МассивСтрок Цикл
			СписокСтрок.Добавить(ТекСтрока, ТекСтрока.КодСДР);
		КонецЦикла; 
		
		СписокСтрок.СортироватьПоПредставлению();
		
		Для Каждого ТекСтрока Из СписокСтрок Цикл
			СписокЗадач.Добавить(ТекСтрока.Значение, ТекСтрока.Представление);
		КонецЦикла;
	КонецЦикла;
	
	Если НЕ Журнал = Неопределено Тогда
		Журнал.Записать(Ложь);
	КонецЕсли;
	
	ШаблонПроекта.Записать();
	
	СписокЗадач.СортироватьПоПредставлению();
	
	// Повторно перебираем массив задач, полученный выше.
	// По текущей задачи для связанного с ней шаблона создаем его связи.
	Для Каждого ДанныеЗадачи Из СписокЗадач Цикл
		
		СсылкаНаПЗ = ДанныеЗадачи.Значение.Задача;
		
		Отбор = Новый Структура("Задача", СсылкаНаПЗ);
		ПредУсловияЗадачи = ДанныеПроекта.ТаблицаПредУсловийЗадач.НайтиСтроки(Отбор);
		Если Не ЗначениеЗаполнено(ПредУсловияЗадачи) Тогда
			Продолжить;
		КонецЕсли;
		
		ШаблонЗадачи = СоответствиеШаблона.Получить(СсылкаНаПЗ);
		ШаблонЗадачи = ШаблонЗадачи.ПолучитьОбъект();
		
		Для Каждого ПредУсловие Из ПредУсловияЗадачи Цикл
			// Если выбрана корневая задача, то исключенные задачи не войдут в шаблон.
			ЗадачаПредшественник = СоответствиеШаблона.Получить(ПредУсловие.Предшественник);
			Если Не ЗначениеЗаполнено(ЗадачаПредшественник) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ШаблонЗадачи.ПредУсловия.Добавить();
			НоваяСтрока.ЗадачаПредшественник = ЗадачаПредшественник;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПредУсловие);
			НоваяСтрока.ЗадержкаВЧасах = ПредУсловие.Задержка;
			НоваяСтрока.ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.Час;
			
		КонецЦикла;
		
		ШаблонЗадачи.Записать();
		
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область ИмпортШаблонаВПроект

// Функция возвращает данные БД по заданному шаблону проекта и параметрам пользователя.
// 
// Параметры:
//  ПараметрыИмпорта - Структура - содержит настройки:
//   * Шаблон - СправочникСсылка.упоШаблоныПроектов, СправочникСсылка.упоШаблоныПроектныхЗадач.
//   * ЕдиницаВремениПоУмолчанию - СправочникСсылка.упоЕдиницыВремени.
//   * УстановитьЕдиницуВремениПоУмолчанию - Булево.
//   * ЕдиницаТрудоемкостиПоУмолчанию - СправочникСсылка.упоЕдиницыВремени.
//   * УстановитьЕдиницуТрудоемкостиПоУмолчанию - Булево.
//   * ВключатьПодчиненныеЗадачи - Булево.
//   * РасчетЦеныКонтракта - ДокументСсылка.упоРасчетЦеныКонтракта.
//   * КоэффициентМасштабирования - Число.
// 
// Возвращаемое значение:
//  Структура - содержит трубуемые данные.
//		ТаблицаЗадач               - ТаблицаЗначений.
//		ТаблицаПредУсловийЗадач    - ТаблицаЗначений.
//		ТаблицаМатРесурсовЗадач    - ТаблицаЗначений.
// 
Функция ПолучитьДанныеШаблона(ПараметрыИмпорта) Экспорт
	
	Запрос = Новый Запрос;
	
	// Создим возвращаемую структуру.
	ДанныеПроекта = Новый Структура;
	ДанныеПроекта.Вставить("ТаблицаЗадач");
	ДанныеПроекта.Вставить("ТаблицаПредУсловийЗадач");
	ДанныеПроекта.Вставить("ТаблицаМатРесурсовЗадач");
	ДанныеПроекта.Вставить("ТаблицаСубпродуктовЗадач");
	ДанныеПроекта.Вставить("ТаблицаТрудовыхРесурсовЗадач");
	ДанныеПроекта.Вставить("ТаблицаДопЗатратЗадач");
	ДанныеПроекта.Вставить("ТаблицаФинПлановЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДоходовЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеРасходовЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеОбъемовЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеПотребностейЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДополнительныхЗатрат");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеДоходовПоПериодамЗадач");
	ДанныеПроекта.Вставить("ТаблицаРаспределениеРасходовПоПериодамЗадач");
	ДанныеПроекта.Вставить("ТаблицаТрудовыеРесурсыПоПериодамЗадач");
	
	Если ТипЗнч(ПараметрыИмпорта.Шаблон) = Тип("СправочникСсылка.упоШаблоныПроектныхЗадач") Тогда
		Если ПараметрыИмпорта.Свойство("ВключатьПодчиненныеЗадачи") И ПараметрыИмпорта.ВключатьПодчиненныеЗадачи Тогда
			СтрокаПодмены = ".Ссылка В ИЕРАРХИИ (&ШаблонЗадачи)";	
		Иначе
			СтрокаПодмены = ".Ссылка = &ШаблонЗадачи";
		КонецЕсли;
		Запрос.УстановитьПараметр("ШаблонЗадачи" , ПараметрыИмпорта.Шаблон);
	Иначе
		СтрокаПодмены = "";
		Запрос.УстановитьПараметр("Шаблон" , ПараметрыИмпорта.Шаблон);
	КонецЕсли;	
	
	// Заготовка для дополнительной проектной задачи (при создании на основании Расчета цены контракта).
	ДанныеДополнительнойПроектнойЗадачи = Новый Соответствие;
	
	// Каждое поле возвращаемой структры заполняем отобранными данными из БД.
	
	Запрос.УстановитьПараметр("Коэффициент" , ПараметрыИмпорта.КоэффициентМасштабирования);
	Запрос.УстановитьПараметр("ПустаяЗадача", Справочники.упоШаблоныПроектныхЗадач.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("ЕдиницаВремениПоУмолчанию", ПараметрыИмпорта.ЕдиницаВремениПоУмолчанию);
	Запрос.УстановитьПараметр("ИзменятьЕдиницуВремени", ЗначениеЗаполнено(ПараметрыИмпорта.ЕдиницаВремениПоУмолчанию) И  ПараметрыИмпорта.УстановитьЕдиницуВремениПоУмолчанию);
	
	Запрос.УстановитьПараметр("ЕдиницаТрудоемкостиПоУмолчанию", ПараметрыИмпорта.ЕдиницаТрудоемкостиПоУмолчанию);
	Запрос.УстановитьПараметр("ИзменятьЕдиницуТрудоемкости", ЗначениеЗаполнено(ПараметрыИмпорта.ЕдиницаТрудоемкостиПоУмолчанию) И  ПараметрыИмпорта.УстановитьЕдиницуТрудоемкостиПоУмолчанию);

	КоэффициентЕдиницыВремени = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыИмпорта.ЕдиницаВремениПоУмолчанию, "Коэффициент");
	Если Не ЗначениеЗаполнено(КоэффициентЕдиницыВремени) Тогда
		КоэффициентЕдиницыВремени = 1;
	КонецЕсли;
	Запрос.УстановитьПараметр("КоэффициентЕдиницыВремени", КоэффициентЕдиницыВремени);
	
	ЕдиницаТрудоемкостиПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыИмпорта.ЕдиницаТрудоемкостиПоУмолчанию, "Коэффициент");
	Если Не ЗначениеЗаполнено(ЕдиницаТрудоемкостиПоУмолчанию) Тогда
		ЕдиницаТрудоемкостиПоУмолчанию = 1;
	КонецЕсли;
	Запрос.УстановитьПараметр("КоэффициентЕдиницыТрудоемкости", ЕдиницаТрудоемкостиПоУмолчанию);	
		
	// Получим данные по проектным задачам шаблона.
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпрШПЗ.Ссылка КАК Задача,
		|	СпрШПЗ.Родитель КАК Родитель,
		|	СпрШПЗ.ПолноеНаименование КАК НазваниеЗадачи,
		|	СпрШПЗ.ЭтоПакетРабот КАК ЭтоПакетРабот,
		|	СпрШПЗ.ЭтоВеха КАК ЭтоВеха,
		|	СпрШПЗ.НормаСтоимости КАК НормаСтоимости,
		|	СпрШПЗ.ОписаниеЗадачи КАК ОписаниеЗадачи,
		|	СпрШПЗ.ДатаНачалаПлан КАК ДатаНачалаПлан,
		|	СпрШПЗ.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
		|	СпрШПЗ.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
		|	ВЫБОР
		|		КОГДА СпрШПЗ.ЭтоВеха
		|			ТОГДА СпрШПЗ.ЕдиницаНормированияДлительности
		|		КОГДА &ИзменятьЕдиницуВремени
		|				ИЛИ СпрШПЗ.ЕдиницаНормированияДлительности = ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.ПустаяСсылка)
		|			ТОГДА &ЕдиницаВремениПоУмолчанию
		|		ИНАЧЕ СпрШПЗ.ЕдиницаНормированияДлительности
		|	КОНЕЦ КАК ЕдиницаНормированияДлительности,
		|	СпрШПЗ.ДлительностьМоделиПакетаРабот * &Коэффициент * ВЫБОР
		|		КОГДА &ИзменятьЕдиницуВремени
		|				И НЕ ЕСТЬNULL(СпрШПЗ.ЕдиницаНормированияДлительности, ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.ПустаяСсылка)
		|			ТОГДА СпрШПЗ.ЕдиницаНормированияДлительности.Коэффициент / &КоэффициентЕдиницыВремени
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДлительностьМоделиПакетаРабот,
		|	СпрШПЗ.НормаСтоимостиТрудовыхРесурсов КАК НормаСтоимостиТрудовыхРесурсов,
		|	СпрШПЗ.ВидОперации КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА СпрШПЗ.СпособПривязкиДопЗатрат = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДопЗатрат.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДопЗатрат.КЗавершениюЗадачи)
		|		ИНАЧЕ СпрШПЗ.СпособПривязкиДопЗатрат
		|	КОНЕЦ КАК СпособПривязкиДопЗатрат,
		|	СпрШПЗ.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта,
		|	СпрШПЗ.РучнойВводСроков КАК РучнойВводСроков,
		|	СпрШПЗ.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
		|	СпрШПЗ.ВключитьСубпродуктыВПланДоходов КАК ВключитьСубпродуктыВПланДоходов,
		|	СпрШПЗ.ВключитьТрудРесурсыВПланРасходов КАК ВключитьТрудРесурсыВПланРасходов,
		|	СпрШПЗ.Объект КАК Объект,
		|	СпрШПЗ.КрайнийСрок КАК КрайнийСрок,
		|	СпрШПЗ.МетодРасчетаМоделиПакетаРабот КАК МетодРасчетаМоделиПакетаРабот,
		|	СпрШПЗ.СпособПланированияРасходов КАК СпособПланированияРасходов,
		|	СпрШПЗ.УчестьРучнойВводСроковПриАктуализации КАК УчестьРучнойВводСроковПриАктуализации,
		|	СпрШПЗ.ПланироватьТрудозатратыНаИсполнителей КАК ПланироватьТрудозатратыНаИсполнителей,
		|	СпрШПЗ.КодПроектногоДокумента КАК КодПроектногоДокумента,
		|	СпрШПЗ.ЗапретитьАвтоЗапуск КАК ЗапретитьАвтоЗапуск,
		|	СпрШПЗ.НазваниеОперации КАК НазваниеОперации,
		|	СпрШПЗ.НазваниеПроектнойЗадачи КАК НазваниеПроектнойЗадачи,
		|	СпрШПЗ.НаправлениеДвиженияПоСДР КАК НаправлениеДвиженияПоСДР,
		|	СпрШПЗ.ОбновлятьДатуДокумента КАК ОбновлятьДатуДокумента,
		|	СпрШПЗ.РазрешитьРаннийЗапуск КАК РазрешитьРаннийЗапуск,
		|	СпрШПЗ.ФлагИмпортаMSP КАК ФлагИмпортаMSP,
		|	СпрШПЗ.СтруктураКартинокОписания КАК СтруктураКартинокОписания,
		|	СпрШПЗ.ВключитьЗатратыНаТрудовыеРесурсыВПланРасходов КАК ВключитьЗатратыНаТрудовыеРесурсыВПланРасходов,
		|	СпрШПЗ.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов,
		|	СпрШПЗ.КритерийРезультата КАК КритерийРезультата,
		|	СпрШПЗ.ОписаниеРезультата КАК ОписаниеРезультата,
		|	СпрШПЗ.КалендарьЗадачи КАК КалендарьЗадачи,
		|	СпрШПЗ.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов,
		|	СпрШПЗ.УровеньПланированияТрудозатратДляБДР КАК УровеньПланированияТрудозатратДляБДР,
		|	СпрШПЗ.ВключитьПланДоходовВБДДС КАК ВключитьПланДоходовВБДДС,
		|	СпрШПЗ.ВключитьПланРасходовВБДДС КАК ВключитьПланРасходовВБДДС,
		|	СпрШПЗ.СхемаОплатыПоУмолчаниюРасходы КАК СхемаОплатыПоУмолчаниюРасходы,
		|	СпрШПЗ.СхемаОплатыПоУмолчаниюДоходы КАК СхемаОплатыПоУмолчаниюДоходы,
		|	СпрШПЗ.НормаСтоимостиОбъемы КАК НормаСтоимостиОбъемы,
		|	СпрШПЗ.ТипСубпродукта КАК ТипСубпродукта,
		|	СпрШПЗ.ТранслироватьЗатратыПоСубпродуктам КАК ТранслироватьЗатратыПоСубпродуктам,
		|	СпрШПЗ.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач КАК СпрШПЗ
		|ГДЕ
		|	СпрШПЗ.Владелец = &Шаблон
		|	И НЕ СпрШПЗ.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	СпрШПЗ.Код";
	
	Если ЗначениеЗаполнено(СтрокаПодмены) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".Владелец = &Шаблон", СтрокаПодмены);
	КонецЕсли;
	
	ДанныеПроекта.Вставить("ТаблицаЗадач", Запрос.Выполнить().Выгрузить());
	
	// Получим данные финансовых планов задач.
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ШаблоныПроектныхЗадачПланДоходов.Ссылка КАК Задача,
		|	""Доходы"" КАК ВидЭлемента,
		|	ШаблоныПроектныхЗадачПланДоходов.Статья КАК Статья,
		|	NULL КАК ВидПлатежа,
		|	ШаблоныПроектныхЗадачПланДоходов.Сумма * &Коэффициент КАК Сумма,
		|	ШаблоныПроектныхЗадачПланДоходов.Контрагент КАК Контрагент,
		|	ШаблоныПроектныхЗадачПланДоходов.ПрофильРаспределения КАК Профиль,
		|	ШаблоныПроектныхЗадачПланДоходов.Валюта КАК Валюта,
		|	0 КАК Задержка,
		|	ШаблоныПроектныхЗадачПланДоходов.НомерСтроки КАК НомерСтроки,
		|	ШаблоныПроектныхЗадачПланДоходов.СпособПривязки КАК СпособПривязки,
		|	ШаблоныПроектныхЗадачПланДоходов.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
		|	NULL КАК ЭтоРольТрудовогоРесурса,
		|	NULL КАК Договор
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач.ПланДоходов КАК ШаблоныПроектныхЗадачПланДоходов
		|ГДЕ
		|	ШаблоныПроектныхЗадачПланДоходов.Ссылка.Владелец = &Шаблон
		|	И НЕ ШаблоныПроектныхЗадачПланДоходов.Ссылка.ПометкаУдаления
		|	И ШаблоныПроектныхЗадачПланДоходов.Сумма > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ШаблоныПроектныхЗадачПланРасходов.Ссылка,
		|	""Расходы"",
		|	ШаблоныПроектныхЗадачПланРасходов.Статья,
		|	NULL,
		|	ШаблоныПроектныхЗадачПланРасходов.Сумма * &Коэффициент,
		|	ШаблоныПроектныхЗадачПланРасходов.Контрагент,
		|	ШаблоныПроектныхЗадачПланРасходов.ПрофильРаспределения,
		|	ШаблоныПроектныхЗадачПланРасходов.Валюта,
		|	0,
		|	ШаблоныПроектныхЗадачПланРасходов.НомерСтроки,
		|	ШаблоныПроектныхЗадачПланРасходов.СпособПривязки,
		|	ШаблоныПроектныхЗадачПланРасходов.ИндексСтрокРаспределения,
		|	ШаблоныПроектныхЗадачПланРасходов.ЭтоРольТрудовогоРесурса,
		|	NULL
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач.ПланРасходов КАК ШаблоныПроектныхЗадачПланРасходов
		|ГДЕ
		|	ШаблоныПроектныхЗадачПланРасходов.Ссылка.Владелец = &Шаблон
		|	И НЕ ШаблоныПроектныхЗадачПланРасходов.Ссылка.ПометкаУдаления
		|	И ШаблоныПроектныхЗадачПланРасходов.Сумма > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ШаблоныПроектныхЗадачПланПоступлений.Ссылка,
		|	""Поступления"",
		|	ШаблоныПроектныхЗадачПланПоступлений.Статья,
		|	ШаблоныПроектныхЗадачПланПоступлений.ВидПлатежа,
		|	ШаблоныПроектныхЗадачПланПоступлений.Сумма * &Коэффициент,
		|	ШаблоныПроектныхЗадачПланПоступлений.Контрагент,
		|	ШаблоныПроектныхЗадачПланПоступлений.ПрофильРаспределения,
		|	ШаблоныПроектныхЗадачПланПоступлений.Валюта,
		|	ШаблоныПроектныхЗадачПланПоступлений.Задержка,
		|	ШаблоныПроектныхЗадачПланПоступлений.НомерСтроки,
		|	ШаблоныПроектныхЗадачПланПоступлений.СпособПривязки,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	Справочник.упоШаблоныПроектныхЗадач.ПланПоступлений КАК ШаблоныПроектныхЗадачПланПоступлений
		|ГДЕ
		|	ШаблоныПроектныхЗадачПланПоступлений.Ссылка.Владелец = &Шаблон
		|	И НЕ ШаблоныПроектныхЗадачПланПоступлений.Ссылка.ПометкаУдаления
		|	И ШаблоныПроектныхЗадачПланПоступлений.Сумма > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ШаблоныПроектныхЗадачПланВыплат.Ссылка,
		|	""Выплаты"",
		|	ШаблоныПроектныхЗадачПланВыплат.Статья,
		|	ШаблоныПроектныхЗадачПланВыплат.ВидПлатежа,
		|	ШаблоныПроектныхЗадачПланВыплат.Сумма * &Коэффициент,
		|	ШаблоныПроектныхЗадачПланВыплат.Контрагент,
