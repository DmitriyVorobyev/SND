	// Настройки по умолчанию по проектам.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Проекты.Ссылка
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |ГДЕ
	               |	НЕ Проекты.ПометкаУдаления
	               |	И НЕ Проекты.ЭтоПроектнаяЗадача";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаПроекты = Результат.Выбрать();
	Пока ВыборкаПроекты.Следующий() Цикл
		
		ЗагружаемыеНастройки = Неопределено;
		
		СсылкаНаПроект = ВыборкаПроекты.Ссылка;
		
		// Сначала ищем сохраненную настройку по ИД, если не находим, то ищем по коду.
		МассивСуффиксовКлючейОбъекта = Новый Массив;
		МассивСуффиксовКлючейОбъекта.Добавить("" + СокрЛП(СсылкаНаПроект.УникальныйИдентификатор()));
		МассивСуффиксовКлючейОбъекта.Добавить("" + СокрЛП(СсылкаНаПроект.Код));
		Для каждого СуффиксКлючаОбъекта Из МассивСуффиксовКлючейОбъекта Цикл
			
			КлючОбъекта = "Обработка.упоУпрощенныйВводСтруктурыПроекта" + СокрЛП(СуффиксКлючаОбъекта); // Настройка для конкретного проекта
			Отбор = Новый Структура("КлючОбъекта", КлючОбъекта);
			
			Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
			Пока Выборка.Следующий() Цикл
				РедактироватьНастройкуСтруктурыПроекта(
			Выборка.КлючОбъекта, Выборка.КлючНастроек, Выборка.Настройки, Выборка.Представление, Выборка.Пользователь);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

