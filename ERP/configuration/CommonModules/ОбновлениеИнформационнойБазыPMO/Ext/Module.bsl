	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДоходовИРасходов.СрезПоследних КАК упоАктуальныеПланыДоходовИРасходовСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоАктуальныеПланыДоходовИРасходовСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоАктуальныеПланыДоходовИРасходовСрезПоследних.ПроектнаяЗадача,
	               |	упоВерсииПроекта.Версия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сумма КАК Сумма,
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная КАК СуммаВалютная,
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоВерсииПроектаПодр.Версия
	               |ПОМЕСТИТЬ ДанныеДР_Подразделения
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СрезПоследних КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроектаПодр
	               |		ПО упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Версия = упоВерсииПроектаПодр.Версия
	               |			И (упоВерсииПроектаПодр.Текущая)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеДР.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДанныеДР.Сумма КАК Сумма,
	               |	0 КАК СуммаПодр,
	               |	ДанныеДР.СуммаВалютная КАК СуммаВалютная,
	               |	0 КАК СуммаВалютнаяПодр,
	               |	ДанныеДР.Версия
	               |ПОМЕСТИТЬ ОбъединениеДР
	               |ИЗ
	               |	ДанныеДР КАК ДанныеДР
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ДанныеДР_Подразделения.ПроектнаяЗадача,
	               |	0,
	               |	ДанныеДР_Подразделения.Сумма,
	               |	0,
	               |	ДанныеДР_Подразделения.СуммаВалютная,
	               |	ДанныеДР_Подразделения.Версия
	               |ИЗ
	               |	ДанныеДР_Подразделения КАК ДанныеДР_Подразделения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОбъединениеДР.ПроектнаяЗадача.Проект КАК Проект,
	               |	ОбъединениеДР.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	СУММА(ОбъединениеДР.Сумма) КАК Сумма,
	               |	СУММА(ОбъединениеДР.СуммаПодр) КАК СуммаПодр,
	               |	СУММА(ОбъединениеДР.СуммаВалютная) КАК СуммаВалютная,
	               |	СУММА(ОбъединениеДР.СуммаВалютнаяПодр) КАК СуммаВалютнаяПодр,
	               |	ОбъединениеДР.Версия
	               |ПОМЕСТИТЬ Проблемные
	               |ИЗ
	               |	ОбъединениеДР КАК ОбъединениеДР
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ОбъединениеДР.ПроектнаяЗадача,
	               |	ОбъединениеДР.ПроектнаяЗадача.Проект,
	               |	ОбъединениеДР.Версия
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ОбъединениеДР.СуммаВалютная) <> СУММА(ОбъединениеДР.СуммаВалютнаяПодр)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Проблемные.Проект КАК Проект,
	               |	Проблемные.Проект.КонтрагентДоходов КАК КонтрагентДоходов,
	               |	Проблемные.Проект.ДоговорДоходов КАК ДоговорДоходов,
	               |	Проблемные.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Проблемные.Сумма КАК Сумма,
	               |	Проблемные.СуммаПодр КАК СуммаПодр,
	               |	Проблемные.СуммаВалютная КАК СуммаВалютная,
	               |	Проблемные.СуммаВалютнаяПодр КАК СуммаВалютнаяПодр,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи,
	               |	упоСтатусыПроектовСрезПоследних.СтатусПроекта,
	               |	ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаПлан,
	               |	ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗавершенияПлан,
	               |	Проблемные.Версия
	               |ИЗ
	               |	Проблемные КАК Проблемные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |		ПО Проблемные.ПроектнаяЗадача = упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов.СрезПоследних КАК упоСтатусыПроектовСрезПоследних
	               |		ПО Проблемные.Проект = упоСтатусыПроектовСрезПоследних.Проект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК упоСрокиПроектныхЗадачСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоСрокиПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
	               |		ПО Проблемные.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекСостояние_упоОтключитьПроверкуОграничений = ПараметрыСеанса.упоОтключитьПроверкуОграничений;
	ТекСостояние_упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов = ПараметрыСеанса.упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов;
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = Истина;
	ПараметрыСеанса.упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов = Истина;
	
	Ошибки = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		ЗадачаСсылка = Выборка.ПроектнаяЗадача;
		Проект = Выборка.Проект;
		
		Календарь = упоПроектыИЗадачиВызовСервера.обПолучитьКалендариПроекта(Проект);
		
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
			
		СвойстваПроведения = Новый Структура;
		СвойстваПроведения.Вставить("Проект", Проект);
		СвойстваПроведения.Вставить("Версия", Выборка.Версия);
		СвойстваПроведения.Вставить("ПроектнаяЗадача", ЗадачаСсылка);
		СвойстваПроведения.Вставить("НачДата", Выборка.ДатаНачалаПлан);
		СвойстваПроведения.Вставить("КонДата", Выборка.ДатаЗавершенияПлан);
		СвойстваПроведения.Вставить("Календарь", Календарь);
		СвойстваПроведения.Вставить("КонтрагентЗатрат", Выборка.КонтрагентДоходов);
		СвойстваПроведения.Вставить("ДоговорЗатрат", Выборка.ДоговорДоходов);
		
		упоАналитикаПоПодразделениямСервер.ЗаполнитьОбщиеНастройкиУчетаПоПодразделениям(ЗадачаСсылка, СвойстваПроведения);

		Движения = Новый Структура;
		
		НаборЗаписей = РегистрыСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ЗадачаСсылка);
		
		ТаблицаДвижений = НаборЗаписей.Выгрузить();
		
		Движения.Вставить("упоАктуальныеПланыДоходовИРасходовПодразделения", ТаблицаДвижений);
		
		упоАналитикаПоПодразделениямСервер.ЗаполнитьДвиженияПланДоходовИРасходов(Неопределено,
			Движения,
			СвойстваПроекта,
			СвойстваПроведения,
			Ложь);
		
		ТаблицаДвижений.ЗаполнитьЗначения(Истина, "Активность");
		ТаблицаДвижений.ЗаполнитьЗначения(ТекущаяДата(), "Период");
		ТаблицаДвижений.ЗаполнитьЗначения(ЗадачаСсылка, "Регистратор");
		
		НаборЗаписей.Загрузить(Движения.упоАктуальныеПланыДоходовИРасходовПодразделения);
		
		Попытка
			НаборЗаписей.Записать();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,"",ТекстОшибки,"");
		КонецПопытки;
		
	КонецЦикла;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = ТекСостояние_упоОтключитьПроверкуОграничений;
	ПараметрыСеанса.упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов = ТекСостояние_упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов;
	
КонецФункции 

