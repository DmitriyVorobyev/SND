//  Параметры - Произвольный - параметры.
//
Процедура ОбновитьПредопределенныеПоказателиПроектов(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	упоПоказателиПроектовСостояния.Ссылка
	                      |ИЗ
	                      |	Справочник.упоПоказателиПроектов.Состояния КАК упоПоказателиПроектовСостояния
	                      |ГДЕ
	                      |	упоПоказателиПроектовСостояния.Ссылка.Предопределенный
	                      |	И упоПоказателиПроектовСостояния.Значение = НЕОПРЕДЕЛЕНО
	                      |	И ТИПЗНАЧЕНИЯ(упоПоказателиПроектовСостояния.ЗначениеС) = Тип(Число)");
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПоказательОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Состояния = ПоказательОбъект.Состояния;
			Для Каждого Состояние Из Состояния Цикл
				Если Состояние.Значение = НЕОПРЕДЕЛЕНО Тогда
					Состояние.Значение = 0;
				КонецЕсли;	
			КонецЦикла;	
			ПоказательОбъект.Записать();
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры	

// Функция - Вкл доп реквизиты и свойства для фаз
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
Функция УстановитьПараметрыНабораСвойств_ФазыПроектов(Параметры = Неопределено) Экспорт
	
	упоФункцииБСП.УстановитьИспользованиеНабораСвойств("Справочник_упоФазыПроектов");
	
КонецФункции

// Процедура обновления ИБ для справочника видов контактной информации.
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
// Инструкция.
// Для каждого объекта, владельца КИ, для каждого соответствующего ему вида КИ добавить 
// строчку вида: ОбновитьВидКИ(.....). При этом,
// важен порядок в котором будут осуществляться эти вызовы, чем раньше вызов для вида КИ,
// тем выше этот вид КИ будет располагаться на форме объекта.
//
// Параметры функции УправлениеКонтактнойИнформацией.ОбновитьВидКИ:
// 1. Вид КИ - Ссылка на предопределенный вид КИ.
// 2. Тип КИ - Ссылка на перечисление
// 3. МожноИзменятьСпособРедактирования  - Определяет, можно ли в режиме Предприятие изменить способ редактирования,
//                                         например, для адресов, которые попадают в регл. отчетность, нужно
//                                         запретить возможность изменения.
// 4. РедактированиеТолькоВДиалоге       - Если установить Истина, то будет значение вида КИ можно будет
//                                         редактировать только в форме ввода (имеет смысл только для
//                                         адресов, телефонов и факсов).
// 5. АдресТолькоРоссийский              - Если установить Истина, то для адресов можно будет ввести 
//                                         только российский адрес (имеет смысл только для адресов).
// 6. Порядок                            - Определяет порядок элемента, для сортировки относительно других.
//
//
Процедура ЗаполнитьСвойстваВидовКонтактнойИнформации(Параметры = Неопределено) Экспорт
	
	МенеджерКонтактнойИнформации = Справочники["ВидыКонтактнойИнформации"];
	
	// СтандартныеПодсистемы 
	// СтандартныеПодсистемы.Пользователи
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.EmailПользователя,
		Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты, 	Истина, Ложь, Ложь, 1);
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.ТелефонПользователя,
		Перечисления.ТипыКонтактнойИнформации.Телефон,               	Истина, Ложь, Ложь, 2);
	// Конец СтандартныеПодсистемы.Пользователи 
	
	// Справочник "Контрагенты"
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.ФактАдресКонтрагента,
		Перечисления.ТипыКонтактнойИнформации.Адрес, 					Истина, Ложь, Ложь, 3);
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.ЮрАдресКонтрагента,
		Перечисления.ТипыКонтактнойИнформации.Адрес, 					Истина, Ложь, Ложь, 4);
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.ПочтовыйАдресКонтрагента,
		Перечисления.ТипыКонтактнойИнформации.Адрес, 					Истина, Ложь, Ложь, 5);
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.ТелефонКонтрагента,
		Перечисления.ТипыКонтактнойИнформации.Телефон, 					Истина, Ложь, Ложь, 6);
		
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда	
		КИФаксКонтрагента 	= МенеджерКонтактнойИнформации["ФаксКонтрагента"];
		КИДругаяИнформация 	= МенеджерКонтактнойИнформации["ДругаяИнформацияКонтрагента"];
	Иначе
		КИФаксКонтрагента 	= МенеджерКонтактнойИнформации.ФаксКонтрагенты;
		КИДругаяИнформация 	= МенеджерКонтактнойИнформации.ДругаяИнформацияКонтрагенты;
	КонецЕсли;
	ОбновитьВидКИ(КИФаксКонтрагента,
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Факс"), 
		Истина, Ложь, Ложь, 7);
	ОбновитьВидКИ(МенеджерКонтактнойИнформации.EmailКонтрагента,
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты"),
		Истина, Ложь, Ложь, 8);
	ОбновитьВидКИ(КИДругаяИнформация,
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Другое"), 
		Истина, Ложь, Ложь, 9);
	
КонецПроцедуры

// Обновляет вид контактной информации.
//
// Параметры:
//  ВидКИ 								- Произвольный - вид контактной информации. 
//  Тип									- Произвольный - тип.
//  МожноИзменятьСпособРедактирования	- Булево - изменение способа редактирования.
//  РедактированиеТолькоВДиалоге		- Булево - возможность редактировать вне диалога.
//  АдресТолькоРоссийский				- Булево - российский адрес.
//  Порядок								- Произвольный - порядок.
//
Процедура ОбновитьВидКИ(ВидКИ, Тип, МожноИзменятьСпособРедактирования, РедактированиеТолькоВДиалоге, АдресТолькоРоссийский,	Порядок = Неопределено)

	МодульУправлениеКонтактнойИнформацией = ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформацией");
	
	ПараметрыВида = МодульУправлениеКонтактнойИнформацией.ПараметрыВидаКонтактнойИнформации(Тип);
	ПараметрыВида.Вид = ВидКИ;
	ПараметрыВида.Тип = Тип;
	ПараметрыВида.Порядок = Порядок;	
	ПараметрыВида.МожноИзменятьСпособРедактирования = МожноИзменятьСпособРедактирования;
	ПараметрыВида.РедактированиеТолькоВДиалоге = РедактированиеТолькоВДиалоге;
	ПараметрыВида.ОбязательноеЗаполнение = Ложь;	
	ПараметрыВида.НастройкиПроверки = ?(ТипЗнч(ПараметрыВида.НастройкиПроверки) = Тип("Структура"), ПараметрыВида.НастройкиПроверки,
		Неопределено);
	
	МодульУправлениеКонтактнойИнформацией.УстановитьСвойстваВидаКонтактнойИнформации(ПараметрыВида);
		
КонецПроцедуры

// Заполняет реквизит Контрагент по владельцу.
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура ЗаполнитьРеквизитКонтрагентПоВладельцу(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка,
	|	ДоговорыКонтрагентов.Владелец
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Контрагент = &КонтрагентПустаяСсылка";
	Запрос.УстановитьПараметр("КонтрагентПустаяСсылка", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл 
			
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СправочникОбъект.Контрагент = Выборка.Владелец;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры 

// Создание и обновление показателей из макета обработки упоУстановкаИндикаторов.ДанныеИндикаторов.
//
// Параметры:
//  КодыПоказателейДляОбновления - Массив, Неопределено - выборочные показатели (коды), которые необходимо обновить.
//  ТолькоНовые - Булево - признак принудительного обновления показателей. При значении ЛОЖЬ будут обновлены
//   только те показатели, которые добавлены в макете, но еще не созданы как элементы справочника Показатели.
// 
// Возвращаемое значение:
//  Булево - признак успешного выполнения.
//
Функция СоздатьНовыеПоказателиПроектовИзМакета(КодыПоказателейДляОбновления = Неопределено, ТолькоНовые = Ложь) Экспорт
	
	ЕстьУспех = Истина;
	
	ДанныеИндикаторов = Новый ТаблицаЗначений;
	Состояния = Обработки.упоУстановкаИндикаторов.Создать().Состояния.ВыгрузитьКолонки();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеИндикаторов", ДанныеИндикаторов);
	СтруктураДанных.Вставить("Состояния", Состояния);
	Обработки.упоУстановкаИндикаторов.УстановитьДанныеИндикаторов(СтруктураДанных);
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЗВсеПоказателиИзМакета.Код КАК Код,
	|	ТЗВсеПоказателиИзМакета.Порядок КАК Порядок
	|ПОМЕСТИТЬ ВТВсеПоказателиИзМакета
	|ИЗ
	|	&ТЗВсеПоказателиИзМакета КАК ТЗВсеПоказателиИзМакета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеПоказателиИзМакета.Код КАК Код,
	|	ВсеПоказателиИзМакета.Порядок
	|ИЗ
	|	ВТВсеПоказателиИзМакета КАК ВсеПоказателиИзМакета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.упоПоказателиПроектов КАК ИндикаторыОбъектов
	|		ПО ВсеПоказателиИзМакета.Код = ИндикаторыОбъектов.ПредустановленныйКод
	|// Условие
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВсеПоказателиИзМакета.Порядок";
	
	ЭтоОбновлениеДанных = ЗначениеЗаполнено(КодыПоказателейДляОбновления) 
		И ТипЗнч(КодыПоказателейДляОбновления) = Тип("Массив");
	
	ПолучитьСуществующиеПоказатели = Истина;
	
	Если ЭтоОбновлениеДанных Тогда
		
		Условие = "ГДЕ
		|	ВсеПоказателиИзМакета.Код В (&мсКодовДляОбновления)";
		
		Запрос.УстановитьПараметр("мсКодовДляОбновления", КодыПоказателейДляОбновления);
		
	ИначеЕсли ТолькоНовые Тогда
		
		Условие = "ГДЕ
		|	ИндикаторыОбъектов.Ссылка ЕСТЬ NULL";
		
		ПолучитьСуществующиеПоказатели = Ложь;
		
	КонецЕсли;
	
	Если ПолучитьСуществующиеПоказатели Тогда
		
		ЗапросСуществующихПоказателей = Новый Запрос("Выбрать 
		|Ссылка КАК Индикатор,
		|ПредустановленныйКод КАК КодИндикатора
		|Из Справочник.упоПоказателиПроектов
		|Где Не ПредустановленныйКод = """" И Не ПометкаУдаления");
		
		ТаблицаСуществующих = ЗапросСуществующихПоказателей.Выполнить().Выгрузить();
		
	Иначе
		ТаблицаСуществующих = Неопределено;
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "// Условие", Условие);
	
	Запрос.УстановитьПараметр("ТЗВсеПоказателиИзМакета", ДанныеИндикаторов);
	
	КэшИндикаторов = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЕстьУспех = Обработки.упоУстановкаИндикаторов.УстановитьПоУмолчаниюПоказательПроекта(
				Выборка.Код, КэшИндикаторов, ДанныеИндикаторов, Состояния, ТаблицаСуществующих);
				
		Если Не ЕстьУспех Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьУспех;
	
КонецФункции

// Функция заполняет уровень планирования ролей.
//
Функция ЗаполнитьУровеньПланированияРолей() Экспорт
	
	ПустоеПеречисление = Перечисления.упоУровеньПланирования.ПустаяСсылка();
	СтруктураОтбор = Новый Структура("УровеньПланирования", ПустоеПеречисление);
	
	//
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустойУровеньПланирования", Перечисления.упоУровеньПланирования.ПустаяСсылка());
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоШаблоныПроектныхЗадач.Ссылка,
	               |	упоШаблоныПроектныхЗадач.ПланироватьТрудозатратыНаИсполнителей
	               |ИЗ
	               |	Справочник.упоШаблоныПроектныхЗадач.ТрудовыеРесурсы КАК упоШаблоныПроектныхЗадачТрудовыеРесурсы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоШаблоныПроектныхЗадач КАК упоШаблоныПроектныхЗадач
	               |		ПО упоШаблоныПроектныхЗадачТрудовыеРесурсы.Ссылка = упоШаблоныПроектныхЗадач.Ссылка
	               |ГДЕ
	               |	упоШаблоныПроектныхЗадачТрудовыеРесурсы.УровеньПланирования = &ПустойУровеньПланирования";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		СтрокиТЧ = Объект.ТрудовыеРесурсы.НайтиСтроки(СтруктураОтбор);
		
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			СтрокаТЧ.УровеньПланирования = Перечисления.упоУровеньПланирования.Предварительный;		
			Если Не Объект.ПланироватьТрудозатратыНаИсполнителей Тогда
				НоваяСтрока = Объект.ТрудовыеРесурсы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
				НоваяСтрока.УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;		
			КонецЕсли;
		КонецЦикла;
		
		Объект.ДополнительныеСвойства.Вставить("упоИгнорироватьОповещения", Истина);
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();			
		
	КонецЦикла;
	
	//
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустойУровеньПланирования", ПустоеПеречисление);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоДанныеПлановТрудозатратРолей.Регистратор,
	               |	ЕСТЬNULL(упоСвойстваПроектныхЗадачСрезПоследних.ПланироватьТрудозатратыНаИсполнителей, ИСТИНА) КАК ПланироватьТрудозатратыНаИсполнителей,
	               |	упоДанныеПлановТрудозатратРолей.ПроектнаяЗадача
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей КАК упоДанныеПлановТрудозатратРолей
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ПО упоДанныеПлановТрудозатратРолей.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И упоДанныеПлановТрудозатратРолей.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
	               |ГДЕ
	               |	упоДанныеПлановТрудозатратРолей.УровеньПланирования = &ПустойУровеньПланирования";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Регистратор = Выборка.Регистратор;
		
		Если НЕ ЗначениеЗаполнено(Регистратор) Тогда
			Продолжить;
		КонецЕсли;		
		
		НаборЗаписей = РегистрыСведений.упоДанныеПлановТрудозатратРолей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
		НаборЗаписей.Прочитать();
		ТаблицаНабораЗаписей = НаборЗаписей.Выгрузить();
		
