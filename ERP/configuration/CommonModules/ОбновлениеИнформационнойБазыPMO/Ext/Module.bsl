// Обновляет данные регистра Причины отклонения для работы с новым полем.
// Логика инвертирована: поле Отмена = Истина перезаполняется данными УдалитьАктуально = Ложь.
//
Процедура ОбновитьДанныеРегистраПричинОтклонения() Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПричиныОтклонений() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	упоПричиныОтклонений.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.упоПричиныОтклонений КАК упоПричиныОтклонений
		|ГДЕ
		|	упоПричиныОтклонений.УдалитьАктуально = упоПричиныОтклонений.Отмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Набор = РегистрыСведений.упоПричиныОтклонений.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Выборка.Регистратор);
		Набор.Прочитать();
		Для Каждого Запись Из Набор Цикл
			Запись.Отмена = Не Запись.УдалитьАктуально;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Набор);
		
	КонецЦикла;
	
КонецПроцедуры

#Область ИсправлениеДвиженийОбработкиПереносаПроектныхЗадач

Процедура ИсправитьВерсиюУказанногоРегистра(ИмяРегистра)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	упоПроцентыГотовностиПроектныхЗадач.Регистратор КАК Регистратор,
	               |	упоПроцентыГотовностиПроектныхЗадач.Регистратор.Проект КАК РегистраторПроект,
	               |	упоПроцентыГотовностиПроектныхЗадач.Версия КАК Версия
	               |ПОМЕСТИТЬ ДанныеСПроектомРегистратора
	               |ИЗ
	               |	РегистрСведений.упоПроцентыГотовностиПроектныхЗадач КАК упоПроцентыГотовностиПроектныхЗадач
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта1
	               |		ПО упоПроцентыГотовностиПроектныхЗадач.Версия = упоВерсииПроекта1.Версия
	               |			И (упоВерсииПроекта1.Текущая)
	               |ГДЕ
	               |	НЕ упоПроцентыГотовностиПроектныхЗадач.Регистратор ССЫЛКА Документ.упоПрогнозТрудозатратПоРолям
	               |	И НЕ упоПроцентыГотовностиПроектныхЗадач.Регистратор ССЫЛКА Документ.упоВерсияПланаПроекта
	               |	И упоПроцентыГотовностиПроектныхЗадач.Регистратор.Проект <> упоВерсииПроекта1.Проект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ДанныеСПроектомРегистратора.Регистратор КАК Регистратор,
	               |	упоВерсииПроекта.Версия КАК Версия
	               |ИЗ
	               |	ДанныеСПроектомРегистратора КАК ДанныеСПроектомРегистратора
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО ДанныеСПроектомРегистратора.РегистраторПроект = упоВерсииПроекта.Проект
	               |			И (упоВерсииПроекта.Текущая)";
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
									"НЕ упоПроцентыГотовностиПроектныхЗадач.Регистратор ССЫЛКА Документ.упоПрогнозТрудозатратПоРолям", 
									"ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(ТекстЗапроса, "упоПроцентыГотовностиПроектныхЗадач", ИмяРегистра);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
			
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);		
		НаборЗаписей.Прочитать();
		
		Версия = Выборка.Версия;
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.Версия = Версия;
		КонецЦикла;
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
		НаборЗаписей.ДополнительныеСвойства.Вставить("упоНеПроверятьЗакрытыеЭтапы", Истина);
			
		Попытка	
		
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
		Исключение
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать документ: %Регистратор% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Регистратор%", Выборка.Регистратор);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,,
				Выборка.Регистратор,
				ТекстСообщения);
			
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ОсновнойТекстЗапроса()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоПроцентыГотовностиПроектныхЗадач.Версия КАК Версия,
	               |	упоПроцентыГотовностиПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоПроцентыГотовностиПроектныхЗадач.ПроектнаяЗадача.Проект КАК ПроектПроектнойЗадачи,
	               |	""упоПроцентыГотовностиПроектныхЗадач"" КАК ИмяРегистра
	               |ПОМЕСТИТЬ ПроцентыГотовности
	               |ИЗ
	               |	РегистрСведений.упоПроцентыГотовностиПроектныхЗадач КАК упоПроцентыГотовностиПроектныхЗадач
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПроцентыГотовности.Версия КАК Версия,
	               |	ПроцентыГотовности.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ПроцентыГотовности.ПроектПроектнойЗадачи КАК ПроектПроектнойЗадачи,
	               |	упоВерсииПроекта.Проект КАК ПроектВерсии,
	               |	ПроцентыГотовности.ИмяРегистра КАК ИмяРегистра
	               |ПОМЕСТИТЬ БитыеДвиженияПроцентовГотовности
	               |ИЗ
	               |	ПроцентыГотовности КАК ПроцентыГотовности
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО ПроцентыГотовности.Версия = упоВерсииПроекта.Версия
	               |ГДЕ
	               |	ПроцентыГотовности.ПроектПроектнойЗадачи <> упоВерсииПроекта.Проект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоСтатусыПроектныхЗадач.Версия КАК Версия,
	               |	упоСтатусыПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСтатусыПроектныхЗадач.ПроектнаяЗадача.Проект КАК ПроектПроектнойЗадачи,
	               |	""упоСтатусыПроектныхЗадач"" КАК ИмяРегистра
	               |ПОМЕСТИТЬ СтатусыЗадач
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектныхЗадач КАК упоСтатусыПроектныхЗадач
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СтатусыЗадач.Версия КАК Версия,
	               |	СтатусыЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	СтатусыЗадач.ПроектПроектнойЗадачи КАК ПроектПроектнойЗадачи,
