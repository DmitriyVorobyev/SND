	ОбновлениеИнформационнойБазы.ЗаписатьДанные(МенеджерКонстанты);

КонецПроцедуры

Процедура ЗаполнитьКонстантыОтраженияФактаПервичнымиДокументами() Экспорт
	
	Если Константы.упоОтражатьФактДоходовПервичнымиДокументами.Получить() Тогда
    	Константы.упоОтражатьФактРасходовПервичнымиДокументами.Установить(Истина);
		Если Константы.упоВключатьНДСВФактДоходовПервичныхДокументов.Получить() Тогда
			Константы.упоВключатьНДСВФактРасходовПервичныхДокументов.Установить(Истина);		
		КонецЕсли;
	Иначе
		Константы.упоВключатьНДСВФактДоходовПервичныхДокументов.Установить(Ложь);
	КонецЕсли;	
		
КонецПроцедуры

Процедура ЗаполнитьТипЗадачиуВПрогнозТрудозатратПоРолям() Экспорт
	
	ПолноеИмяОбъекта = "Документ.упоПрогнозТрудозатратПоРолям";
	МетаданныеДокумента = Метаданные.Документы.упоПрогнозТрудозатратПоРолям;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоПрогнозТрудозатратПоРолямДанные.Ссылка КАК Ссылка,
	               |	упоПрогнозТрудозатратПоРолямДанные.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
	               |	ВЫБОР
	               |		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ЭтоВеха
	               |			ТОГДА 5
	               |		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ЭтоМодельПакетаРабот
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК ТипЗадачи
	               |ИЗ
	               |	Документ.упоПрогнозТрудозатратПоРолям.Данные КАК упоПрогнозТрудозатратПоРолямДанные
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
	               |		ПО упоПрогнозТрудозатратПоРолямДанные.ПроектнаяЗадачаЗеркало.СсылкаНаПроектнуюЗадачу = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |ИТОГИ ПО
	               |	ПроектнаяЗадачаЗеркало";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ВыборкаДокумент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДокумент.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			
			ОбъектИзменен = Ложь;
			Выборка = ВыборкаДокумент.Выбрать();
			Пока Выборка.Следующий() Цикл
				НайденнаяСтрока = ДокументОбъект.Данные.Найти(Выборка.ПроектнаяЗадачаЗеркало, "ПроектнаяЗадачаЗеркало");
				Если НайденнаяСтрока <> Неопределено Тогда
					НайденнаяСтрока.ТипЗадачи = Выборка.ТипЗадачи;
					ОбъектИзменен = Истина;
				КонецЕсли;	
			КонецЦикла;
			
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			КонецЕсли;

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать документ: %Регистратор% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				Выборка.Ссылка,
				ТекстСообщения);
			Продолжить;;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьВерсиюВРегистрахВыполнения() Экспорт
	
	// упоПроцентыГотовностиПроектныхЗадач
	ЗаполнитьВерсиюУказанногоРегистра("упоПроцентыГотовностиПроектныхЗадач");
	
