Процедура ПроектноеБюджетирование_ЗаполнитьПризнакЗаполнятьПоРаспределению() Экспорт 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	упоПравилаПолученияФактаДляПроектногоБюджетирования.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.упоПравилаПолученияФактаДляПроектногоБюджетирования КАК упоПравилаПолученияФактаДляПроектногоБюджетирования
	                      |ГДЕ
	                      |	упоПравилаПолученияФактаДляПроектногоБюджетирования.РаспределятьПоПлану
	                      |	И НЕ упоПравилаПолученияФактаДляПроектногоБюджетирования.ПометкаУдаления");
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();	
	Пока Выборка.Следующий() Цикл
		ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		НайденныеСтроки = ПравилоОбъект.СопоставлениеРеквизитов.НайтиСтроки(Новый Структура("Реквизит", "Подразделение"));
		Если НайденныеСтроки.Количество() Тогда
			НайденныеСтроки[0].ЗаполнятьПоРаспределению = Истина;
		КонецЕсли;			
		НайденныеСтроки = ПравилоОбъект.СопоставлениеРеквизитов.НайтиСтроки(Новый Структура("Реквизит", "Статья"));
		Если НайденныеСтроки.Количество() Тогда
			НайденныеСтроки[0].ЗаполнятьПоРаспределению = Истина;
		КонецЕсли;	
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПравилоОбъект);	
		Исключение
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось обработать правило: %1 по причине: %2'"),
				Выборка.Ссылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));						
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,,
				Выборка.Ссылка,
				ТекстСообщения);	
		КонецПопытки;	
	КонецЦикла;	
	
КонецПроцедуры

