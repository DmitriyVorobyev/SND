	ЗаполнитьВерсиюУказанногоРегистра("упоПроцентыГотовностиПроектов", Ложь);
			
КонецПроцедуры

Процедура ЗаполнитьВидЗаданияПодразделениюВЗадания() Экспорт
	
	ПолноеИмяОбъекта = "Справочник.упоЗадания";
	МетаданныеДокумента = Метаданные.Справочники.упоЗадания;
	ВидЗаданияПодразделению = Перечисления.упоВидыЗаданияПодразделению.НаПланирование;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоЗадания.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.упоЗадания КАК упоЗадания
	               |ГДЕ
	               |	упоЗадания.ЭтоЗаданиеПодразделению";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.ВидЗаданияПодразделению = ВидЗаданияПодразделению;
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		Исключение
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать справочник: %1 по причине: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
									Выборка.Ссылка, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				Выборка.Ссылка,
				ТекстСообщения);
		КонецПопытки;	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПредопределенныеПрофилиНастроекПрогнозаТрудозатрат(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	упоПрофилиНастроекПрогнозаТрудозатратПоРолям.Ссылка КАК Ссылка
	                |ИЗ
	                |	Справочник.упоПрофилиНастроекПрогнозаТрудозатратПоРолям КАК упоПрофилиНастроекПрогнозаТрудозатратПоРолям
	                |ГДЕ
	                |	упоПрофилиНастроекПрогнозаТрудозатратПоРолям.Предопределенный
	                |	И упоПрофилиНастроекПрогнозаТрудозатратПоРолям.УровеньПланированияРолей = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СправочникМенеджер = Справочники.упоПрофилиНастроекПрогнозаТрудозатратПоРолям;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка = СправочникМенеджер.ОтчетПодразделения Тогда
			НастройкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			НастройкаОбъект.УровеньПланированияРолей = Перечисления.упоУровеньПланирования.Окончательный;
			НастройкаОбъект.АктуализироватьПланПоФактическимДанным = Истина;
			НастройкаОбъект.ЗаписыватьФактОтчетногоПериода = Истина;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаОбъект);
		ИначеЕсли Выборка.Ссылка = СправочникМенеджер.АктуализацияПлана Тогда
			НастройкаОбъект = Выборка.Ссылка.ПолучитьОбъект();
			НастройкаОбъект.УровеньПланированияРолей = Перечисления.упоУровеньПланирования.Предварительный;
			НастройкаОбъект.АктуализироватьПланПоФактическимДанным = Истина;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НастройкаОбъект);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерезаписатьДокументыСинхронизацииФактическихДоходовИРасходов() Экспорт
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСинхронизацияФактическихДоходовИРасходов.Ссылка КАК Документ
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихДоходовИРасходов КАК упоСинхронизацияФактическихДоходовИРасходов
	               |
