	ПолноеИмяОбъекта = "Справочник.СтатьиДвиженияДенежныхСредств";
	МетаданныеДокумента = Метаданные.Справочники.СтатьиДвиженияДенежныхСредств;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтатьиДвиженияДенежныхСредств.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТ_СтатьиДДС
	               |ИЗ
	               |	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	               |ГДЕ
	               |	СтатьиДвиженияДенежныхСредств.упоНаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПервых.СтатьяДДС КАК СтатьяДДС,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПервых.НаправлениеДвижения КАК НаправлениеДвижения,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПервых.Период КАК Период
	               |ПОМЕСТИТЬ ВТ_НаправленияДвижений
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПервых(
	               |			,
	               |			НаправлениеДвижения <> ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.ПустаяСсылка)
	               |				И СтатьяДДС В
	               |					(ВЫБРАТЬ
	               |						ВТ_СтатьиДДС.Ссылка КАК Ссылка
	               |					ИЗ
	               |						ВТ_СтатьиДДС КАК ВТ_СтатьиДДС)) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПервых
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СтатьиДДС.Ссылка КАК Ссылка,
	               |	ЕСТЬNULL(ВТ_НаправленияДвижений.НаправлениеДвижения, ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата)) КАК НаправлениеДвижения
	               |ИЗ
	               |	ВТ_СтатьиДДС КАК ВТ_СтатьиДДС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НаправленияДвижений КАК ВТ_НаправленияДвижений
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ВТ_НаправленияДвижений.СтатьяДДС КАК СтатьяДДС,
	               |				МИНИМУМ(ВТ_НаправленияДвижений.Период) КАК Период
	               |			ИЗ
	               |				ВТ_НаправленияДвижений КАК ВТ_НаправленияДвижений
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				ВТ_НаправленияДвижений.СтатьяДДС) КАК МинимальныПериод
	               |			ПО ВТ_НаправленияДвижений.СтатьяДДС = МинимальныПериод.СтатьяДДС
	               |				И ВТ_НаправленияДвижений.Период = МинимальныПериод.Период
	               |		ПО ВТ_СтатьиДДС.Ссылка = ВТ_НаправленияДвижений.СтатьяДДС";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.упоНаправлениеДвижения = Выборка.НаправлениеДвижения;
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		Исключение
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать справочник: %1 по причине: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
									Выборка.Ссылка, 
									ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				Выборка.Ссылка,
				ТекстСообщения);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ПерезаполнитьИсточникДанныхУДокументовСинхронизации() Экспорт
	
	КэшИсточников = Новый ТаблицаЗначений;
	КэшИсточников.Колонки.Добавить("Идентификатор");	
	КэшИсточников.Колонки.Добавить("ИсточникДанных");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСинхронизацияФактическихДоходовИРасходов.Ссылка КАК Ссылка,
	               |	упоСинхронизацияФактическихДоходовИРасходов.удалитьИсточникДанных КАК Идентификатор,
	               |	упоСинхронизацияФактическихДоходовИРасходов.удалитьПодключениеКИсточникуДанных КАК Подключение
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихДоходовИРасходов КАК упоСинхронизацияФактическихДоходовИРасходов
	               |ГДЕ
	               |	НЕ упоСинхронизацияФактическихДоходовИРасходов.ПометкаУдаления
	               |	И упоСинхронизацияФактическихДоходовИРасходов.ИсточникДанных = ЗНАЧЕНИЕ(Справочник.упоИсточникиДанных.ПустаяСсылка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоСинхронизацияФактическихДвиженийДенежныхСредств.Ссылка,
	               |	упоСинхронизацияФактическихДвиженийДенежныхСредств.удалитьИсточникДанных,
	               |	упоСинхронизацияФактическихДвиженийДенежныхСредств.удалитьПодключениеКИсточникуДанных
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихДвиженийДенежныхСредств КАК упоСинхронизацияФактическихДвиженийДенежныхСредств
	               |ГДЕ
	               |	НЕ упоСинхронизацияФактическихДвиженийДенежныхСредств.ПометкаУдаления
	               |	И упоСинхронизацияФактическихДвиженийДенежныхСредств.ИсточникДанных = ЗНАЧЕНИЕ(Справочник.упоИсточникиДанных.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		НайденнаяСтрока = КэшИсточников.Найти(Выборка.Идентификатор, "Идентификатор");
		Если Не НайденнаяСтрока = Неопределено Тогда
			ИсточникДанных = НайденнаяСтрока.ИсточникДанных;	
		Иначе
			ИсточникДанных = Справочники.упоИсточникиДанных.ИсточникДанныхПоИдентификатору(Выборка.Идентификатор, Выборка.Подключение, "");
			
			НоваяСтрока = КэшИсточников.Добавить();
			НоваяСтрока.Идентификатор = Выборка.Идентификатор;
			НоваяСтрока.ИсточникДанных = ИсточникДанных; 
		КонецЕсли;		
		ДокОбъект.ИсточникДанных = ИсточникДанных;  
		
		ДокОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьПравилаИнтеграцииС1СДокументооборотом() Экспорт
	
	НеинтегрируемыеРеквизиты = Документы.упоПроектнаяЗадача.НеинтегрируемыеРеквизитыОбъектаИС();
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	СправочникОбъект.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ПравилаИнтеграцииС1СДокументооборотом.ПравилаЗаполненияРеквизитовИС КАК СправочникОбъект
	                      |ГДЕ
	                      |	СправочникОбъект.Ссылка.ТипОбъектаИС = ""Документ.упоПроектнаяЗадача""
	                      |	И СправочникОбъект.ИмяРеквизитаОбъектаИС В(&МассивРеквизитов)");
	Запрос.УстановитьПараметр("МассивРеквизитов", НеинтегрируемыеРеквизиты);
	
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл 
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		МассивУдаляемыхРеквизитов = Новый Массив;
		Для Каждого НеинтегрируемыйРеквизит Из НеинтегрируемыеРеквизиты Цикл
			СтрокаРеквизит = СправочникОбъект.ПравилаЗаполненияРеквизитовИС.Найти(НеинтегрируемыйРеквизит, 
				"ИмяРеквизитаОбъектаИС");
			Если СтрокаРеквизит <> Неопределено Тогда
				МассивУдаляемыхРеквизитов.Добавить(СтрокаРеквизит);	
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого УдаляемыйРеквизит Из МассивУдаляемыхРеквизитов Цикл
			СправочникОбъект.ПравилаЗаполненияРеквизитовИС.Удалить(УдаляемыйРеквизит);	
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);		
	КонецЦикла;	
	
КонецПроцедуры	

