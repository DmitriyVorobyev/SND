Процедура ВыполнитьПереходНаНовыйМеханизмНастроекРаботаСЗаданиями() Экспорт
	
	КлючОбъекта = "Обработка.упоРаботаСЗаданиями";
	
	ПользователиИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	
	Для каждого ПользовательИБ Из ПользователиИБ  Цикл
		
		ОтключитьГруппуЗадания = ХранилищеОбщихНастроек.Загрузить("Обработка.упоРаботаСЗаданиями", "ОтключитьГруппуЗадания",, ПользовательИБ.Имя);
		ОчередьЗадачИсполнителя = ХранилищеОбщихНастроек.Загрузить("Обработка.упоРаботаСЗаданиями", "ОчередьЗадачИсполнителя",, ПользовательИБ.Имя);
		ПоказыватьОбсуждения = ХранилищеОбщихНастроек.Загрузить("Обработка.упоРаботаСЗаданиями", "ПоказыватьОбсуждения",, ПользовательИБ.Имя);
		
		СценарииПоддерживающиеСохранениеНастроек = упоЗаданияСервер.СценарииПоддерживающиеСохранениеНастроек();
		
		НастройкаПоУмолчанию = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, "ПоУмолчанию_НастройкаПоУмолчанию",, ПользовательИБ.Имя);
		Если НастройкаПоУмолчанию <> Неопределено Тогда
			Продолжить;		
		КонецЕсли;
		
		Для каждого Сценарий Из СценарииПоддерживающиеСохранениеНастроек Цикл
			
			КлючНастроек = "НастройкиОбработкиПоСценарию_" + Сценарий + "_ПоУмолчанию";
			
			Если ОтключитьГруппуЗадания <> Неопределено
					Или ОчередьЗадачИсполнителя <> Неопределено
					Или ПоказыватьОбсуждения <> Неопределено Тогда
				
				СтруктураНастроек = упоЗаданияСервер.НоваяСтруктураНастроек();
				СтруктураНастроек.ОтключитьГруппуЗадания = ОтключитьГруппуЗадания = Истина;
				СтруктураНастроек.ОчередьЗадачИсполнителя = ОчередьЗадачИсполнителя = Истина;
				СтруктураНастроек.ПоказыватьОбсуждения = ПоказыватьОбсуждения = Истина;
				
				Если Сценарий = "упоРаботаСЗаданиямиДляИсполнения" 
						Или Сценарий = "упоРаботаСЗаданиямиНаКонтроле"
						Или Сценарий = "упоРаботаСЗаданиямиОтМеня" 
						Или Сценарий = "ВсеПоручения" 
						Или Сценарий = "упоРаботаСЗаданиямиНаПланирование" 
						Или Сценарий = "упоРаботаСЗаданиямиНаПрогноз" Тогда
					СтруктураНастроек.ВидЗадания = Справочники.упоВидыЗаданий.Поручение;	
				КонецЕсли;
				
				Если Сценарий = "ВсеПроектныеРешения" Тогда
					СтруктураНастроек.ВидЗадания = Справочники.упоВидыЗаданий.ПроектноеРешение;	
				КонецЕсли;
				
				ОписаниеНастройки = Новый ОписаниеНастроек();
				ОписаниеНастройки.Представление = "Настройки по умолчанию";
				
				ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, СтруктураНастроек, ОписаниеНастройки, ПользовательИБ.Имя);
				ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, Сценарий + "_НастройкаПоУмолчанию", КлючНастроек,, ПользовательИБ.Имя);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

