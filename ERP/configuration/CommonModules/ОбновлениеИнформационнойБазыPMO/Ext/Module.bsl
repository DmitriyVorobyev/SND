Процедура УдалитьПараметрыПоказателяДоКонцаПроектаНедель(Параметры = Неопределено) Экспорт
		
	ПредустановленныйКод = "ДоКонцаПроектаНедель";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоПоказателиПроектов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
		|ГДЕ
		|	упоПоказателиПроектов.ПредустановленныйКод = &ПредустановленныйКод";
	
	Запрос.УстановитьПараметр("ПредустановленныйКод", ПредустановленныйКод); 
	
	РезультатЗапроса = Запрос.Выполнить();        
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ПоказательСсылка = Выборка.Ссылка;
		ПоказательОбъект = ПоказательСсылка.ПолучитьОбъект();	
		
		ПоказательОбъект.ПараметрыЗапроса = Неопределено;
		ПоказательОбъект.ПараметрыЗапросаПЗ = Неопределено;

		ПоказательОбъект.Записать();

	КонецЕсли;

КонецПроцедуры

