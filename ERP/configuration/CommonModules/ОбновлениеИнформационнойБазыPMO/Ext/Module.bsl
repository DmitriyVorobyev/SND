Функция КорректироватьПоказателиПроектов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоПоказателиПроектов.Ссылка КАК Ссылка,
	               |	упоПоказателиПроектов.Наименование КАК Наименование,
	               |	упоПоказателиПроектов.ПредустановленныйКод КАК ПредустановленныйКод
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	               |ГДЕ
	               |	упоПоказателиПроектов.ПредустановленныйКод В (""ПроцентТрудозатратКоличество"", ""ПроцентТрудозатратСтоимость"")
	               |	И НЕ упоПоказателиПроектов.ПометкаУдаления";
				   
	ТаблицаРедактируемых = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаПоказателя Из ТаблицаРедактируемых Цикл
		
		Если СтрНайти(ВРег(СтрокаПоказателя.Наименование), "НЕ ИСПОЛЬЗУЕТСЯ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПоказательСсылка = СтрокаПоказателя.Ссылка;
		ПоказательОбъект = ПоказательСсылка.ПолучитьОбъект();
		ПоказательОбъект.Наименование = НСтр("ru = '(не используется) '") + ПоказательОбъект.Наименование;
		ПоказательОбъект.ПолноеНаименование = НСтр("ru = '(не используется) '") + ПоказательОбъект.ПолноеНаименование;
		ПредустановленныйКод = ВРег(СокрЛП(СтрокаПоказателя.ПредустановленныйКод));
		Если ПредустановленныйКод = ВРег("ПроцентТрудозатратКоличество") Тогда
			СтрОписание = НСтр("ru = 'Данный показатель устарел и может считаться некорректно.
                                |Вместо него необходимо испольовать показатели ""% Трудозатрат (Количество) предв. уровень"" и ""% Трудозатрат (Количество) оконч. уровень"".'");
		ИначеЕсли ПредустановленныйКод = ВРег("ПроцентТрудозатратСтоимость") Тогда
			СтрОписание = НСтр("ru = 'Данный показатель устарел и может считаться некорректно.
                                |Вместо него необходимо испольовать показатели ""% Трудозатрат (Стоимость) предв. уровень"" и ""% Трудозатрат (Стоимость) оконч. уровень"".'");
		КонецЕсли;
		ПоказательОбъект.ОписаниеПоказателя = СтрОписание;
		ПоказательОбъект.Комментарий = НСтр("ru = 'Данный показатель не использовать.'");
		ПоказательОбъект.Записать();
		
	КонецЦикла;
	
КонецФункции 

Функция ЗаполнитьПолеПодчиненныйПроект() Экспорт
	
	ТекСостояние_упоОтключитьПроверкуОграничений = ПараметрыСеанса.упоОтключитьПроверкуОграничений;
	ТекСостояние_упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов = ПараметрыСеанса.упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов;
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = Истина;
	ПараметрыСеанса.упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов = Истина;
	
	//
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоПроектнаяЗадача.Ссылка,
	               |	упоПроектнаяЗадача.ПодчиненныйПроект
	               |ПОМЕСТИТЬ ПроектныеЗадачи
	               |ИЗ
	               |	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
	               |ГДЕ
	               |	упоПроектнаяЗадача.ПодчиненныйПроект <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСвойстваПроектныхЗадач.Регистратор,
	               |	упоСвойстваПроектныхЗадач.ПроектнаяЗадача,
	               |	ПроектныеЗадачи.ПодчиненныйПроект
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач КАК упоСвойстваПроектныхЗадач
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПроектныеЗадачи КАК ПроектныеЗадачи
	               |		ПО упоСвойстваПроектныхЗадач.ПроектнаяЗадача = ПроектныеЗадачи.Ссылка
	               |ГДЕ
	               |	упоСвойстваПроектныхЗадач.ПодчиненныйПроект = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.упоСвойстваПроектныхЗадач.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		Для Каждого Запись Из НаборЗаписей Цикл
			Если НЕ Запись.ПроектнаяЗадача = Выборка.ПроектнаяЗадача Тогда
				Продолжить;
			КонецЕсли;
			Запись.ПодчиненныйПроект = Выборка.ПодчиненныйПроект;
		КонецЦикла;
		Если НаборЗаписей.Модифицированность() Тогда
			НаборЗаписей.ДополнительныеСвойства.Вставить("упоИгнорироватьОповещения", Истина);
			НаборЗаписей.Записать();
		КонецЕсли;
		Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.упоСохранениеДанныхПроекта") Тогда
			РегистраторОбъект = Выборка.Регистратор.ПолучитьОбъект();
			Для Каждого СтрокаТЧ Из РегистраторОбъект.ПроектныеЗадачи Цикл
				Если НЕ СтрокаТЧ.ПроектнаяЗадача = Выборка.ПроектнаяЗадача Тогда
					Продолжить;
				КонецЕсли;
				СтрокаТЧ.ПодчиненныйПроект = Выборка.ПодчиненныйПроект;	
			КонецЦикла;
			Если РегистраторОбъект.Модифицированность() Тогда
				РегистраторОбъект.ДополнительныеСвойства.Вставить("упоИгнорироватьОповещения", Истина);
				РегистраторОбъект.ДополнительныеСвойства.Вставить("НеОбновлятьДатуДокумента", Истина);
				РегистраторОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = ТекСостояние_упоОтключитьПроверкуОграничений;
	ПараметрыСеанса.упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов = ТекСостояние_упоОтключитьСтрогуюПроверкуЗакрытыхЭтапов;	
	
КонецФункции 

