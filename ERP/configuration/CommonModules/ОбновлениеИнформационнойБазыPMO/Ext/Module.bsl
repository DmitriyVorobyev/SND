	               |ИЗ
	               |	РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности
	               |ГДЕ
	               |	упоСвязьПроектаСНаправлениемДеятельности.ПроектныйЭлемент = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		
		Если ТипЗнч(Выборка.УдалитьПроект) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда		
			ПроектныйЭлемент = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(Выборка.УдалитьПроект);	
			ПроектнаяЗадача = Выборка.УдалитьПроект; 
		Иначе			
			ПроектныйЭлемент = Выборка.УдалитьПроект;	
			ПроектнаяЗадача = Документы.упоПроектнаяЗадача.ПустаяСсылка();
		КонецЕсли;
			
		НаборЗаписей = РегистрыСведений.упоСвязьПроектаСНаправлениемДеятельности.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПроектныйЭлемент.Установить(ПроектныйЭлемент);
		Запись = НаборЗаписей.Добавить();
		Запись.ПроектныйЭлемент = ПроектныйЭлемент; 
		Запись.НаправлениеДеятельностиЭлемент = Выборка.УдалитьНаправлениеДеятельности;
		Запись.НаправлениеДеятельностиГруппа = Выборка.УдалитьНаправлениеДеятельностиРодитель;
		Запись.ПроектныйЭлементПроектнаяЗадача = ПроектнаяЗадача;
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.упоСвязьПроектаСНаправлениемДеятельности.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.УдалитьНаправлениеДеятельности.Установить(Выборка.УдалитьНаправлениеДеятельности);
		НаборЗаписей.Отбор.УдалитьПроект.Установить(Выборка.УдалитьПроект);
		НаборЗаписей.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбновитьВсеНаправленияДеятельности() Экспорт
	упоСвязьПроектаСНаправлениемДеятельности.СинхронизироватьВсеПроектыСНаправлениямиДеятельности();	
КонецПроцедуры

// Добавляет пользователей в группы доступа на основе их ролей.
//
Процедура ДобавитьПользователейВГруппыДоступаВыборПроектныхЗадачКакПроектаНаОсновеИхРолей(Параметры = Неопределено) Экспорт
	
	СтруктураГруппИПрофилей = Новый Структура("упоВыборПроектныхЗадачКакПроекта", "упоВыборПроектныхЗадачКакПроекта");
	
	Для Каждого КлючЗначение Из СтруктураГруппИПрофилей Цикл
		Профиль = Справочники.ГруппыДоступа[КлючЗначение.Ключ].Профиль;
		Если Не ЗначениеЗаполнено(Профиль) Или Профиль.ПометкаУдаления Тогда
			Объект = Справочники.ГруппыДоступа[КлючЗначение.Ключ].ПолучитьОбъект();
			Объект.Профиль = Справочники.ПрофилиГруппДоступа[КлючЗначение.Значение];
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	               |	Пользователи.Ссылка,
	               |	Пользователи.ИдентификаторПользователяИБ
	               |ИЗ
	               |	Справочник.Пользователи КАК Пользователи
	               |ГДЕ
	               |	НЕ Пользователи.ПометкаУдаления
	               |	И Пользователи.Наименование <> ""<Не указан>""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Попытка
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
				Выборка.ИдентификаторПользователяИБ);	
		Исключение
		    ПользовательИБ = Неопределено;
		КонецПопытки;
		
		
		Если ПользовательИБ = Неопределено Тогда
			Продолжить;			
		КонецЕсли;
		
		ВключитьВГруппуДоступа = Ложь;
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
			
			ВключитьВГруппуДоступа = ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеАктовВыполненныхРабот"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеЗаказовКлиентов"]) 
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеЗаказовНаПроизводство"]) 
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеЗаказовНаПроизводство2_2"]) 
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеЗаказовПоставщикам"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеДокументовПоБанку"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеПриобретенийТоваровУслугВозвратовПоставщикам"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеДокументовПоКассе"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеРеализацийТоваровУслуг"]);
		КонецЕсли;

		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2() Тогда
			ВключитьВГруппуДоступа = ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеАктовВыполненныхРабот"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеЗаказовКлиентов"]) 
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["упоДобавлениеИзменениеЗаказаНаПроизводство"]) 
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеЗаказовПоставщикам"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеДокументовПоБанку"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеПриобретенийТоваровУслугВозвратовПоставщикам"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеДокументовПоКассе"])
									Или ПользовательИБ.Роли.Содержит(Метаданные.Роли["ДобавлениеИзменениеРеализацийТоваровУслуг"]);
		КонецЕсли;
			
		Если ВключитьВГруппуДоступа Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.упоДобавлениеИзменениеОбъектовERP) Тогда
			ВключитьПользователяВГруппуДоступа(Выборка.Ссылка, "упоВыборПроектныхЗадачКакПроекта");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоказателиЭффективности(Параметры = Неопределено) Экспорт
	
	ПоказателиМенеджер = Справочники.упоПоказателиПроектов;
	ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.АвтоматическиВДокументеРасчетЭффективности;
	ТипЗаполнения = Перечисления.упоТипИндикатора.Число;
	НаборПоказателей = "IRR,PI,NCF,PBP,NPV";
	
	МассивПоказателей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаборПоказателей);
	Для Каждого Показатель Из МассивПоказателей Цикл	
		ПоказательОбъект = ПоказателиМенеджер[Показатель].ПолучитьОбъект();		
		ПоказательОбъект.ДополнительныеСвойства.Вставить("РазрешитьЗаписьПредопределенных", Истина);
		ПоказательОбъект.ФорматнаяСтрока = "ЧДЦ='2'";
		ПоказательОбъект.ВидЗаполнения = ВидЗаполнения;
		ПоказательОбъект.ТипИндикатора = ТипЗаполнения;
		ПоказательОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТипЮридическихУсловийДоговора() Экспорт
	
	ПолноеИмяОбъекта = "Документ.упоРегистрацияЮридическихУсловийДоговора";
	МетаданныеДокумента = Метаданные.Документы.упоРегистрацияЮридическихУсловийДоговора;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоРегистрацияЮридическихУсловийДоговора.Ссылка КАК Ссылка,
		|	упоРегистрацияЮридическихУсловийДоговора.ЭтоДополнительноеСоглашение КАК ЭтоДополнительноеСоглашение
		|ИЗ
		|	Документ.упоРегистрацияЮридическихУсловийДоговора КАК упоРегистрацияЮридическихУсловийДоговора
		|ГДЕ
		|	НЕ упоРегистрацияЮридическихУсловийДоговора.ПометкаУдаления
		|	И (упоРегистрацияЮридическихУсловийДоговора.ТипЮридическихУсловийДоговора = ЗНАЧЕНИЕ(Перечисление.упоТипыЮридическихУсловийДоговора.ПустаяСсылка)
		|			ИЛИ упоРегистрацияЮридическихУсловийДоговора.Контрагент = ЗНАЧЕНИЕ(Справочник.КОнтрагенты.ПустаяСсылка)
		|			ИЛИ упоРегистрацияЮридическихУсловийДоговора.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|			ИЛИ упоРегистрацияЮридическихУсловийДоговора.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ИЛИ упоРегистрацияЮридическихУсловийДоговора.ВидДоговора = ЗНАЧЕНИЕ(Справочник.упоВидДоговора.ПустаяСсылка))";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецЕсли;
			ОбъектИзменен = Ложь;
			
			Если Не ЗначениеЗаполнено(ДокументОбъект.ТипЮридическихУсловийДоговора) Тогда
				ДокументОбъект.ТипЮридическихУсловийДоговора = Перечисления.упоТипыЮридическихУсловийДоговора.ДоходныйРасходный;
				ОбъектИзменен = Истина;
			КонецЕсли;
			
			Если Выборка.ЭтоДополнительноеСоглашение Тогда
				ДокументОснование = ДокументОбъект.ПолучитьОсновнойРегистраторЮридическихУсловийДоговора(Выборка.Ссылка);
				Если Не ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
					ДокументОбъект.Контрагент = ДокументОснование.Контрагент;
					ОбъектИзменен = Истина;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда
					ДокументОбъект.Организация = ДокументОснование.Организация;
					ОбъектИзменен = Истина;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(ДокументОбъект.Валюта) Тогда
					ДокументОбъект.Валюта = ДокументОснование.Валюта;
					ОбъектИзменен = Истина;
				КонецЕсли;
				Если Не ЗначениеЗаполнено(ДокументОбъект.ВидДоговора) Тогда
					ДокументОбъект.ВидДоговора = ДокументОснование.ВидДоговора;
					ОбъектИзменен = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
			КонецЕсли;

			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать документ: %Регистратор% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеДокумента,
				Выборка.Ссылка,
				ТекстСообщения);
			Продолжить;;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ПерезаполнитьКодИНаименованиеРегистраСведенийупоСписокВыбораПроектов() Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.упоСписокВыбораПроектов;
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("ВЫБРАТЬ" + Символы.ПС);
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		МассивСтрок.Добавить("	РегистрСведенийупоСписокВыбораПроектов.");
		МассивСтрок.Добавить(Измерение.Имя);
		МассивСтрок.Добавить(" КАК ");
		МассивСтрок.Добавить(Измерение.Имя);
		МассивСтрок.Добавить(",");
		МассивСтрок.Добавить(Символы.ПС);
	КонецЦикла;
	
	Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
		Если Ресурс.Имя <> "Код" И Ресурс.Имя <> "Наименование" Тогда			
			МассивСтрок.Добавить("	РегистрСведенийупоСписокВыбораПроектов.");
			МассивСтрок.Добавить(Ресурс.Имя);
			МассивСтрок.Добавить(" КАК ");
			МассивСтрок.Добавить(Ресурс.Имя);
			МассивСтрок.Добавить(",");
			МассивСтрок.Добавить(Символы.ПС);
		КонецЕсли;		
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеРегистра.Реквизиты Цикл 
		МассивСтрок.Добавить("	РегистрСведенийупоСписокВыбораПроектов.");
		МассивСтрок.Добавить(Реквизит.Имя);
		МассивСтрок.Добавить(" КАК ");
		МассивСтрок.Добавить(Реквизит.Имя);
		МассивСтрок.Добавить(",");
		МассивСтрок.Добавить(Символы.ПС);
	КонецЦикла;
	
	МассивСтрок.Добавить(
	"	Проекты.Наименование КАК Наименование,
	|	Проекты.Код КАК Код
	|ИЗ
	|	РегистрСведений.упоСписокВыбораПроектов КАК РегистрСведенийупоСписокВыбораПроектов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО РегистрСведенийупоСписокВыбораПроектов.Ссылка = Проекты.Ссылка
	|			И (РегистрСведенийупоСписокВыбораПроектов.Наименование <> Проекты.Наименование
	|				ИЛИ РегистрСведенийупоСписокВыбораПроектов.Код <> Проекты.Код)");
	
	ТекстЗапроса = СтрСоединить(МассивСтрок);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	НаборЗаписей = РегистрыСведений.упоСписокВыбораПроектов.СоздатьНаборЗаписей();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей.Отбор.Ссылка.Установить(Выборка.Ссылка);
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);		 
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
		НаборЗаписей.Очистить();
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьВыводитьВСводныйСтатусОтчетИНеВыводитьВСтатусОтчетРегупоСвойстваПроектныхЗадач() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	упоСвойстваПроектныхЗадач.Регистратор КАК Регистратор,
	|	упоСвойстваПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач КАК упоСвойстваПроектныхЗадач
	|ГДЕ
	|	НЕ упоСвойстваПроектныхЗадач.ЭтоВеха
	|	И НЕ упоСвойстваПроектныхЗадач.ЭтоМодельПакетаРабот
	|	И НЕ упоСвойстваПроектныхЗадач.ЭтоПакетРабот
	|ИТОГИ ПО
	|	Регистратор";
	
	ЗаполнитьВыбранныйРесурсРегистраупоСвойстваПроектныхЗадач(Запрос, "ВыводитьВСводныйСтатусОтчет");	
		
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	упоСвойстваПроектныхЗадач.Регистратор КАК Регистратор,
	|	упоСвойстваПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач КАК упоСвойстваПроектныхЗадач
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
	|		ПО упоСвойстваПроектныхЗадач.ПроектнаяЗадача = упоПроектнаяЗадача.Ссылка
	|			И (упоПроектнаяЗадача.НеВыводитьВСтатусОтчет)
	|ИТОГИ ПО
	|	Регистратор";
	
	ЗаполнитьВыбранныйРесурсРегистраупоСвойстваПроектныхЗадач(Запрос, "НеВыводитьВСтатусОтчет");
		
КонецПроцедуры

Процедура ЗаполнитьЭтоАктируемаяИВнешняяНормаСтоимостиРегупоСвойстваПроектныхЗадач() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	упоСвойстваПроектныхЗадач.Регистратор КАК Регистратор,
	|	упоСвойстваПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	упоСвойстваПроектныхЗадач.ПроектнаяЗадача.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача,
	|	упоСвойстваПроектныхЗадач.ПроектнаяЗадача.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач КАК упоСвойстваПроектныхЗадач
	|ГДЕ
	|	(упоСвойстваПроектныхЗадач.ПроектнаяЗадача.ЭтоАктируемаяЗадача
	|			ИЛИ упоСвойстваПроектныхЗадач.ПроектнаяЗадача.ВнешняяНормаСтоимостиТрудовыхРесурсов <> ЗНАЧЕНИЕ(Справочник.упоНормыСтоимости.ПустаяСсылка))
	|ИТОГИ ПО
	|	Регистратор";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРегистратор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НаборЗаписей = РегистрыСведений.упоСвойстваПроектныхЗадач.СоздатьНаборЗаписей();
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		НаборЗаписей.Прочитать();
		
		Выборка = ВыборкаРегистратор.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Для Каждого Запись Из НаборЗаписей Цикл
				
				Если Запись.ПроектнаяЗадача <> Выборка.ПроектнаяЗадача Тогда
					Продолжить;
				КонецЕсли;
				
				Запись.ЭтоАктируемаяЗадача = Выборка.ЭтоАктируемаяЗадача;
				Запись.ВнешняяНормаСтоимостиТрудовыхРесурсов = Выборка.ВнешняяНормаСтоимостиТрудовыхРесурсов;
				
			КонецЦикла;	
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбновитьВариантыОтчетовПользователяПоПортфелюПрограмме() Экспорт
	
	СответствиеЗамен = Новый Соответствие;
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("День"), Новый ПолеКомпоновкиДанных("ПериодДень"));	
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("Месяц"), Новый ПолеКомпоновкиДанных("ПериодМесяц"));	
	//
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПрограммыЗеркальныйПроект"), Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПрограммыПортфеляЗеркальныйПроект"));
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПрограммы"), Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПрограммыПортфеля"));
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПодчиненныйПроектЗадачиПрограммы"), Новый ПолеКомпоновкиДанных("ПодчиненныйПроектЗадачиПрограммыПортфеля"));
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПроектПрограммы"), Новый ПолеКомпоновкиДанных("ПроектПрограммыПортфеля"));
 	//
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПортфеляЗеркальныйПроект"), Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПрограммыПортфеляЗеркальныйПроект"));
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПортфеля"), Новый ПолеКомпоновкиДанных("ПроектнаяЗадачаПрограммыПортфеля"));
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПодчиненныйПроектЗадачиПортфеля"), Новый ПолеКомпоновкиДанных("ПодчиненныйПроектЗадачиПрограммыПортфеля"));
	СответствиеЗамен.Вставить(Новый ПолеКомпоновкиДанных("ПроектПортфеля"), Новый ПолеКомпоновкиДанных("ПроектПрограммыПортфеля"));
	
	МассивПользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	Для Каждого ПользовательИБ Из МассивПользователи Цикл
		ОбновитьВариантыОтчетаПользователя("Отчет." + Метаданные.Отчеты.упоПланФактныйАнализПоПортфелю.Имя, СответствиеЗамен, ПользовательИБ.Имя);
		ОбновитьВариантыОтчетаПользователя("Отчет." + Метаданные.Отчеты.упоПланФактныйАнализПоПрограмме.Имя, СответствиеЗамен, ПользовательИБ.Имя);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПредопределеннуюНастройкуРаспределенияБДР() Экспорт
	
	НастройкаОбъект = Справочники.упоНастройкиРаспределенияБДР.Стандартная.ПолучитьОбъект();	
