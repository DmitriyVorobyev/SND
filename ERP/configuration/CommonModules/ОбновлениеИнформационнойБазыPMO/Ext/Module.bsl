Процедура ВключитьВПользовательскиеНастройкиТипПлана(Параметры = Неопределено) Экспорт
	
	ПараметрТипПлана = Новый ПараметрКомпоновкиДанных("ТипПлана");
	МассивПользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
	
	Для Каждого МетаданныеОтчета Из Метаданные.Отчеты Цикл
		
		КлючОбъекта = "Отчет." + МетаданныеОтчета.Имя;
		
		Для Каждого ПользовательИБ Из МассивПользователи Цикл
			
			ИмяПользователя = ПользовательИБ.Имя; 
			Хранилище = ХранилищаНастроек.ХранилищеВариантовОтчетов;
			ВариантыОтчета = Хранилище.ПолучитьСписок(КлючОбъекта, ИмяПользователя);
			ОписаниеНастроек = Новый ОписаниеНастроек;
			
			Для Каждого Вариант Из ВариантыОтчета Цикл
				
				КлючНастроек = Вариант.Значение;
				Настройки = Хранилище.Загрузить(КлючОбъекта, КлючНастроек, ОписаниеНастроек, ИмяПользователя);
				
				Если Настройки = Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				
				ЗначениеПараметра =  Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрТипПлана);
				Если ЗначениеПараметра = Неопределено  Тогда 
					Продолжить;
				КонецЕсли;
				
				ЗначениеПараметра.Использование  = Истина; 
				ЗначениеПараметра.ИдентификаторПользовательскойНастройки = "_ТипПлана_";
				Хранилище.Сохранить(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, ИмяПользователя);
				
			КонецЦикла;	
			
		КонецЦикла;
	
	КонецЦикла;
	
КонецПроцедуры

