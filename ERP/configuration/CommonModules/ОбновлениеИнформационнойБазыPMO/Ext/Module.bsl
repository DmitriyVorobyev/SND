// Перепроводит последние регистраторы по регистру со способом привязки дохода и расхода на дату.
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура ПерепровестиДокументыСохранениеДанныхПроекта(Параметры = Неопределено) Экспорт
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = Истина;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Регистратор
	                      |ИЗ
	                      |	РегистрСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СрезПоследних(, СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)) КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних
	                      |ГДЕ
	                      |	(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Регистратор ССЫЛКА Документ.упоСохранениеДанныхПроекта
	                      |			ИЛИ упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Регистратор ССЫЛКА Документ.упоРасчетКалендарногоПланаПроекта)");
						  
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();		
		Пока Выборка.Следующий() Цикл
		
			ДокументОбъект = Выборка.Регистратор.ПолучитьОбъект();			
			Попытка								
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект, 
													Ложь, 
													Истина, 
													РежимЗаписиДокумента.Проведение);
			Исключение
			КонецПопытки;	
						
		КонецЦикла;	
		
	КонецЕсли;	
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = Ложь;
	
КонецПроцедуры

