	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПроектныеЗадачиДляПравкиДвижений.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ПроектныеЗадачиДляПравкиДвижений.ПроектПроектнойЗадачи КАК Проект,
	               |	ПроектныеЗадачиДляПравкиДвижений.ИмяРегистра КАК ИмяРегистра,
	               |	упоВерсииПроекта.Версия КАК Версия
	               |ИЗ
	               |	ПроектныеЗадачиДляПравкиДвижений КАК ПроектныеЗадачиДляПравкиДвижений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО ПроектныеЗадачиДляПравкиДвижений.ПроектПроектнойЗадачи = упоВерсииПроекта.Проект
	               |			И (упоВерсииПроекта.Текущая)
	               |ИТОГИ ПО
	               |	Проект";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ИсправитьБитыеДвижения(ПрогрессВыполнения)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = ОсновнойТекстЗапроса();
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ИндексПоследнегоЗапроса = РезультатЗапроса.ВГраница();
	
	ДанныеПоСрезуПоследних = РезультатЗапроса[ИндексПоследнегоЗапроса - 1].Выгрузить();
	ДанныеПоСрезуПоследних.Индексы.Добавить("Проект");
	
	ВыборкаПроекты = РезультатЗапроса[ИндексПоследнегоЗапроса].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПрогрессВыполнения.ВсегоОбъектов = ВыборкаПроекты.Количество();
	ПрогрессВыполнения.ОбработаноОбъектов = 0;
	
	Пока ВыборкаПроекты.Следующий() Цикл
		
		Проект = ВыборкаПроекты.Проект;		
		Ошибка = Ложь;
		ТекстОшибки = Неопределено;
		
		НачатьТранзакцию();
		
		Выборка = ВыборкаПроекты.Выбрать();
		Пока Выборка.Следующий() Цикл
			УдалитьДанныеВсехВерсий(Выборка.ПроектнаяЗадача, Выборка.Версия,
				Выборка.ИмяРегистра, Ошибка, ТекстОшибки);
		КонецЦикла;
		
		СоздатьДокументыРА(Проект, ДанныеПоСрезуПоследних, Ошибка, ТекстОшибки);
		
		Если НЕ Ошибка Тогда
			Попытка
				ЗафиксироватьТранзакцию();
			Исключение
				Ошибка = Истина;
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;	
		ИначеЕсли ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Если Ошибка Тогда
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать данные по проекту ""%проект%"" по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%проект%", Проект);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ТекстОшибки);
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,,
				Проект,
				ТекстСообщения);
						
		КонецЕсли;
		
		ПрогрессВыполнения.ОбработаноОбъектов = ПрогрессВыполнения.ОбработаноОбъектов + 1;
		
	КонецЦикла;
		
КонецПроцедуры

Функция УдалитьДанныеВсехВерсий(ПроектнаяЗадачаСсылка, ВерсияПроектаКуда, ИмяРегистра, Ошибка, ТекстОшибки)
	
	Если Ошибка Тогда
		Возврат Неопределено;
	КонецЕсли;
			
	ДвиженияМетаданные = Метаданные.РегистрыСведений[ИмяРегистра];	
	
	ОбработатьЭлементКоллекцииДвижений(ПроектнаяЗадачаСсылка, ДвиженияМетаданные, 
		ВерсияПроектаКуда, Ошибка, ТекстОшибки);
		
КонецФункции

Процедура ОбработатьЭлементКоллекцииДвижений(ПроектнаяЗадачаСсылка, ДвиженияМетаданные, 
	ВерсияПроектаКуда, Ошибка, ТекстОшибки) 
	
	Если Ошибка Тогда
		Возврат;
	КонецЕсли;
	
	ПодчинениеРегистратору = 
		ДвиженияМетаданные.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
		
	Если Не ПодчинениеРегистратору Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРегистра = ДвиженияМетаданные.Имя; 
	
	ИмяПоляЗадачи = "ПроектнаяЗадача";
	
	Если ДвиженияМетаданные.Измерения.Найти(ИмяПоляЗадачи) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(ДвиженияМетаданные) Тогда
		ТипРегистра = "РегистрСведений";
		МенеджерРегистра = РегистрыСведений;
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ДвиженияМетаданные) Тогда
		ТипРегистра = "РегистрНакопления";
		МенеджерРегистра = РегистрыНакопления;
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(ДвиженияМетаданные) Тогда
		ТипРегистра = "РегистрБухгалтерии";
		МенеджерРегистра = РегистрыБухгалтерии;
	КонецЕсли;
	
	ПолеОтбора = "Регистратор";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Регистр."+ПолеОтбора+" КАК "+ПолеОтбора+"
	|ИЗ
	|	"+ТипРегистра+"."+ИмяРегистра+" КАК Регистр
	|ГДЕ
	|	Регистр."+ИмяПоляЗадачи+" = &ПроектнаяЗадача";
	
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадачаСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПолноеИмяОбъекта = ТипРегистра + "." + ИмяРегистра;
	
	Пока Выборка.Следующий() Цикл	
				
		НаборЗаписей = МенеджерРегистра[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор[ПолеОтбора].Установить(Выборка[ПолеОтбора]);		
		
		НаборЗаписей.Прочитать();	
		
		Регистратор = Выборка.Регистратор;
		
		ОтдельнаяОбработка = ОтдельнаяОбработкаНабораЗаписей(Регистратор, НаборЗаписей, ПроектнаяЗадачаСсылка, ИмяПоляЗадачи,
		ВерсияПроектаКуда);
		
		Если Не ОтдельнаяОбработка Тогда			
			УдалитьЗаписиПоПроектнойЗадачи(Регистратор, НаборЗаписей, ПроектнаяЗадачаСсылка, ИмяПоляЗадачи);			
		КонецЕсли;			
		
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
		НаборЗаписей.ДополнительныеСвойства.Вставить("упоУдалениеЛишнихДвиженийВерсии", Истина);			
			
		Попытка	
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
		Исключение
			
			Ошибка = Истина;
			ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат;
			
		КонецПопытки;
			
	КонецЦикла;	
	
КонецПроцедуры

Функция ОтдельнаяОбработкаНабораЗаписей(Регистратор, НаборЗаписей, ПроектнаяЗадачаСсылка, ИмяПоляЗадачи, 
	ВерсияПроектаКуда) 
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат Ложь;
	КонецЕсли;	

	Если ТипЗнч(Регистратор) <> Тип("ДокументСсылка.упоПрогнозТрудозатратПоРолям") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись[ИмяПоляЗадачи] = ПроектнаяЗадачаСсылка Тогда
			Запись.Версия = ВерсияПроектаКуда;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура УдалитьЗаписиПоПроектнойЗадачи(Регистратор, НаборЗаписей, ПроектнаяЗадачаСсылка, ИмяПоляЗадачи) 
		
	МассивЗаписейНаУдаление = Новый Массив;
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись[ИмяПоляЗадачи] = ПроектнаяЗадачаСсылка Тогда
			МассивЗаписейНаУдаление.Добавить(Запись);	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Запись Из МассивЗаписейНаУдаление Цикл
		НаборЗаписей.Удалить(Запись);
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьДокументыРА(Проект, ДанныеПоСрезуПоследних, Ошибка, ТекстОшибки)
	
	ДанныеПоПроектнымЗадачамПроекта = ДанныеПоСрезуПоследних.НайтиСтроки(Новый Структура("Проект", Проект));
	
	Если ДанныеПоПроектнымЗадачамПроекта.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ДокументАктуализации = Документы.упоРучнаяАктуализацияПроекта.СоздатьДокумент();
	ДокументАктуализации.Проект = Проект;
	
	Для Каждого СтрокаДанных Из ДанныеПоПроектнымЗадачамПроекта Цикл
				
		СтрокаТЧ = ДокументАктуализации.ПроектныеЗадачи.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаДанных);
				
	КонецЦикла;
	
	ТекстКомментария = 
		НСтр("ru = 'Создан автоматически обработкой ""%1"" для корректировки движений перенесенных задач.'");
	СинонимОбработки = Метаданные.Обработки.упоПереносПроектныхЗадач.Синоним;
	ТекстКомментария = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстКомментария, СинонимОбработки);
	ДокументАктуализации.Комментарий = ТекстКомментария;
	ДокументАктуализации.Дата = ТекущаяДата();
	ДокументАктуализации.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
	
	Попытка 		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументАктуализации, 
													Ложь, 
													Истина, 
													РежимЗаписиДокумента.Проведение);		
	Исключение
		Ошибка = Истина;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;	
	
КонецПроцедуры

#КонецОбласти

#Область ИменованиеТекущейПодсистемыPM

// В процессе обновления PM Профа было изменено имя подсистемы, этот обработчик восстанавливает имя подсистемы.
// Предназначен для PM Профа.
// 
Процедура ИзменитьИмяПодсистемыКОРПНаПРОФ(Параметры = Неопределено) Экспорт
	
	ЕстьПодсистемаКОРП = ОпределитьЕстьИмяПодсистемыКОРПВРегистреВерсии();
	Если Не ЕстьПодсистемаКОРП Тогда		
		Возврат;
	КонецЕсли;	
	
	ИмяПодсистемыКОРП = ПолучитьИмяПодсистемыPM_КОРП();
	ИмяПодсистемыПРОФ = ПолучитьИмяПодсистемыPM_ПРОФ();
	
	// Удалить, если есть запись с ПРОФом
	МенеджерЗаписи = РегистрыСведений.ВерсииПодсистем.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИмяПодсистемы = ИмяПодсистемыПРОФ;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.Удалить();		
	КонецЕсли;
	
	// Переименовать имя подсистемы КОРП
	МенеджерЗаписи = РегистрыСведений.ВерсииПодсистем.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИмяПодсистемы = ИмяПодсистемыКОРП;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		МенеджерЗаписи.ИмяПодсистемы = ИмяПодсистемыПРОФ;
		МенеджерЗаписи.Записать();
	КонецЕсли;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

Функция ПолучитьИмяПодсистемыPM_КОРП()
	
	Возврат "УправлениеПроектамиКОРП";	
	
КонецФункции

Функция ПолучитьИмяПодсистемыPM_ПРОФ()
	
	Возврат "УправлениеПроектамиПРОФ";	
	
КонецФункции

// Метод предназначен для корректного получения имени текущей подсистемы PM. Т.к. имя подсистемы в регистре
// ВерсииПодсистем было изменено обработчиком обновления ИзменитьИмяПодсистемыКОРПНаПРОФ
//
Функция ПолучитьИмяПодсистемы()
			
	ИмяПодсистемы = ПолучитьИмяПодсистемыPM_КОРП();
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат ИмяПодсистемы;
	КонецЕсли;
	
	ЕстьПодсистемаКОРП = ОпределитьЕстьИмяПодсистемыКОРПВРегистреВерсии();
	Если ЕстьПодсистемаКОРП Тогда
		Возврат ИмяПодсистемы;
	КонецЕсли;
	
	ИмяПодсистемы = ПолучитьИмяПодсистемыPM_ПРОФ();
	Возврат ИмяПодсистемы;
	
КонецФункции

Функция ОпределитьЕстьИмяПодсистемыКОРПВРегистреВерсии()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВерсииПодсистем.ИмяПодсистемы КАК ИмяПодсистемы
		|ИЗ
		|	РегистрСведений.ВерсииПодсистем КАК ВерсииПодсистем
		|ГДЕ
		|	ВерсииПодсистем.ИмяПодсистемы = &ИмяПодсистемы";
	
	ИмяПодсистемы = ПолучитьИмяПодсистемыPM_КОРП();
	Запрос.УстановитьПараметр("ИмяПодсистемы", ИмяПодсистемы);
	
	// ПривилегированныйРежим необходим для запуска и работы УНФ+PM под пользователями с неполными правами, 
	// т.к. этот метод вызывается при запуске конфигурации из МодульУправляемогоПриложения.ПередНачаломРаботыСистемы()
	// и Отчет.упоДинамикаЭкономикиПроекта.Форма.ФормаОтчетаРабочегоСтола.Форма.ПриСозданииНаСервере
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

#КонецОбласти

// см. ПриДобавленииОбработчиковОбновления()
// Выполняется только для конфигурации ERP+PM.
//
Процедура ПриДобавленииОбработчиковОбновления_EPM(Обработчики)
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		Возврат;
	КонецЕсли;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыEPM.ЗаполнитьПустуюИБ";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "*";
	Обработчик.РежимВыполнения = "Монопольно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыEPM.ВключитьИспользованиеПроектов";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "4.0.0.9";
	Обработчик.РежимВыполнения = "Монопольно";
	Обработчик.Процедура = "упоИнтеграция.СинхронизироватьВсеСтатьиДР";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "4.1.2.3";
	Обработчик.РежимВыполнения = "Монопольно";
	Обработчик.Процедура = "упоИнтеграция.СинхронизироватьВсеПодразделенияИСтруктурыПредприятия";
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "4.0.0.20";
	Обработчик.РежимВыполнения = "Монопольно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыEPM.ПеренестиДопРеквизитыИСвойстваВКорректныеНаборы";
	
	Обработчик = Обработчики.Добавить();
