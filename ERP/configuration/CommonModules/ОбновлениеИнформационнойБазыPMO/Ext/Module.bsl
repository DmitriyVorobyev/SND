// Получает версии библиотек и сохраняет в текстовый файл.
//
// Параметры:
//  ИмяФайла - Строка - путь к файлу .txt
// 
// Возвращаемое значение:
//  Строка, Неопределено - текст сообщения с версиями библиотек.
//
Процедура ВерсииБиблиотек(ИмяФайла = "") Экспорт 
	
	ТекстыВерсий = Новый ТаблицаЗначений;
	ТекстыВерсий.Колонки.Добавить("Имя");
	ТекстыВерсий.Колонки.Добавить("Версия");
	ТекстыВерсий.Колонки.Добавить("Длина");
	
	Результат = СтандартныеПодсистемыПовтИсп.ОписанияПодсистем().ПоИменам;
	
	МаксДлина = 0;
	Для Каждого КлючЗначение Из Результат Цикл
		НЗ = ТекстыВерсий.Добавить();
		НЗ.Имя 		= КлючЗначение.Ключ;
		НЗ.Версия 	= КлючЗначение.Значение.Версия;
		НЗ.Длина 	= СтрДлина(НЗ.Имя);
		
		МаксДлина = Макс(НЗ.Длина, МаксДлина);
	КонецЦикла;
	ТекстыВерсий.Сортировать("Имя");
	
	МассивТекстовВерсий = Новый Массив;
	Шаблон = "%1 %2";
	Для Каждого СтрокаТЗ Из ТекстыВерсий Цикл
		КоличествоПробелов = МаксДлина - СтрокаТЗ.Длина;
		ИмяПодсистемы = упоФункцииОбщегоНазначенияКлиентСервер.ДобавитьПробелыКСтроке(
			СтрокаТЗ.Имя, КоличествоПробелов);
		
		ТекстВерсии = СтрШаблон(Шаблон, ИмяПодсистемы, СтрокаТЗ.Версия);
		МассивТекстовВерсий.Добавить(ТекстВерсии);
	КонецЦикла;
	
	ТекстСообщения = СтрСоединить(МассивТекстовВерсий, Символы.ПС);
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		
		Файл = Новый Файл(ИмяФайла);
		Если Файл.Существует() Тогда
			Файл.УстановитьТолькоЧтение(Ложь);
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;
		
		ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
		ЗаписьТекста.Записать(ТекстСообщения);
		ЗаписьТекста.Закрыть();
		
	Иначе
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

