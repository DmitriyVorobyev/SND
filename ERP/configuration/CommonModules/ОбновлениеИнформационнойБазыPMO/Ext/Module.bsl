		|ПОМЕСТИТЬ ВТ_ПроектныеЗадачиСБДДС
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
		|			,
		|			ПроектнаяЗадача В
		|					(ВЫБРАТЬ
		|						ВТ_ПроектныеЗАдачиСБДР.ПроектнаяЗадача
		|					ИЗ
		|						ВТ_ПроектныеЗАдачиСБДР КАК ВТ_ПроектныеЗАдачиСБДР)
		|				И ИсточникПлана В (&ИсточникиПлана)) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|		ПО упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Версия = упоВерсииПроекта.Версия
		|			И (упоВерсииПроекта.Текущая)
		|
		|СГРУППИРОВАТЬ ПО
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Версия,
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ПроектнаяЗадача,
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СвойстваТрансляцииБДРвБДДСПроектныхЗадач.Версия КАК Версия,
		|	СвойстваТрансляцииБДРвБДДСПроектныхЗадач.Проект КАК Проект,
		|	СвойстваТрансляцииБДРвБДДСПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача
		|ПОМЕСТИТЬ ВТ_ЗадачиСТранслированнымБДР
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_ПроектныеЗадачиСБДР.Версия КАК Версия,
		|		ВТ_ПроектныеЗадачиСБДР.Проект КАК Проект,
		|		ВТ_ПроектныеЗадачиСБДР.ПроектнаяЗадача КАК ПроектнаяЗадача
		|	ИЗ
		|		ВТ_ПроектныеЗадачиСБДР КАК ВТ_ПроектныеЗадачиСБДР
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК СвойстваПроектныхЗадач
		|			ПО ВТ_ПроектныеЗадачиСБДР.Версия = СвойстваПроектныхЗадач.Версия
		|				И ВТ_ПроектныеЗадачиСБДР.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
		|				И (СвойстваПроектныхЗадач.ВключитьПланДоходовВБДДС)
		|				И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ
		|		ВТ_ПроектныеЗадачиСБДР.Версия,
		|		ВТ_ПроектныеЗадачиСБДР.Проект,
		|		ВТ_ПроектныеЗадачиСБДР.ПроектнаяЗадача
		|	ИЗ
		|		ВТ_ПроектныеЗадачиСБДР КАК ВТ_ПроектныеЗадачиСБДР
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК СвойстваПроектныхЗадач
		|			ПО ВТ_ПроектныеЗадачиСБДР.Версия = СвойстваПроектныхЗадач.Версия
		|				И ВТ_ПроектныеЗадачиСБДР.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
		|				И (СвойстваПроектныхЗадач.ВключитьПланРасходовВБДДС)
		|				И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)) КАК СвойстваТрансляцииБДРвБДДСПроектныхЗадач
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	БДРиБДДС.Версия КАК Версия,
		|	БДРиБДДС.Проект КАК Проект,
		|	БДРиБДДС.ПроектнаяЗадача КАК ПроектнаяЗадача
		|ПОМЕСТИТЬ ВТ_ЗадачиСНеобходимостьюПовторнойТрансляции
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_ЗадачиСТранслированнымБДР.Версия КАК Версия,
		|		ВТ_ЗадачиСТранслированнымБДР.Проект КАК Проект,
		|		ВТ_ЗадачиСТранслированнымБДР.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|		ВЫБОР
		|			КОГДА ВТ_ПроектныеЗадачиСБДДС.ПроектнаяЗадача ЕСТЬ NULL
		|					ИЛИ ВТ_ПроектныеЗадачиСБДДС.Сумма = 0
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ КАК НужнаПовторнаяТрансляция
		|	ИЗ
		|		ВТ_ЗадачиСТранслированнымБДР КАК ВТ_ЗадачиСТранслированнымБДР
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроектныеЗадачиСБДДС КАК ВТ_ПроектныеЗадачиСБДДС
		|			ПО ВТ_ЗадачиСТранслированнымБДР.Версия = ВТ_ПроектныеЗадачиСБДДС.Версия
		|				И ВТ_ЗадачиСТранслированнымБДР.ПроектнаяЗадача = ВТ_ПроектныеЗадачиСБДДС.ПроектнаяЗадача) КАК БДРиБДДС
		|ГДЕ
		|	БДРиБДДС.НужнаПовторнаяТрансляция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗадачиСНеобходимостьюПовторнойТрансляции.Проект КАК Проект,
		|	ЗадачиСНеобходимостьюПовторнойТрансляции.Версия КАК Версия,
		|	ЗадачиСНеобходимостьюПовторнойТрансляции.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	Сроки.ДатаНачалаПлан КАК ДатаНачалаПлан,
		|	Сроки.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
		|	&ПоляСвойств КАК ПоляСвойств,
		|	СвойстваПроектныхЗадач.ВключитьПланРасходовВБДДС КАК НужноЗановоТранслироватьПланРасходов,
		|	СвойстваПроектныхЗадач.ВключитьПланДоходовВБДДС КАК НужноЗановоТранслироватьПланДоходов
		|ИЗ
		|	ВТ_ЗадачиСНеобходимостьюПовторнойТрансляции КАК ЗадачиСНеобходимостьюПовторнойТрансляции
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, ) КАК Сроки
		|		ПО ЗадачиСНеобходимостьюПовторнойТрансляции.Версия = Сроки.Версия
		|			И ЗадачиСНеобходимостьюПовторнойТрансляции.ПроектнаяЗадача = Сроки.ПроектнаяЗадача
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(, ) КАК СтатусыПроектныхЗадач
		|		ПО ЗадачиСНеобходимостьюПовторнойТрансляции.Версия = СтатусыПроектныхЗадач.Версия
		|			И ЗадачиСНеобходимостьюПовторнойТрансляции.ПроектнаяЗадача = СтатусыПроектныхЗадач.ПроектнаяЗадача
		|			И (НЕ СтатусыПроектныхЗадач.СтатусЗадачи В (&СтатусыПроектныхЗадачИсключения))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов.СрезПоследних(, ) КАК СтатусыПроектов
		|		ПО ЗадачиСНеобходимостьюПовторнойТрансляции.Версия.Проект = СтатусыПроектов.Проект
		|			И (НЕ СтатусыПроектов.СтатусПроекта В (&СтатусыПроектовИсключения))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК СвойстваПроектныхЗадач
		|		ПО ЗадачиСНеобходимостьюПовторнойТрансляции.Версия = СвойстваПроектныхЗадач.Версия
		|			И ЗадачиСНеобходимостьюПовторнойТрансляции.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
		|ИТОГИ ПО
		|	Проект,
		|	Версия";
	
	РесурсыРегистра = Метаданные.РегистрыСведений.упоСвойстваПроектныхЗадач.Ресурсы;
	СтрокиЗапросаСвойств = Новый Массив;
	Для Каждого Ресурс Из РесурсыРегистра Цикл
		СтрокаЗапроса = СтрШаблон("СвойстваПроектныхЗадач.%1", Ресурс.Имя);
		СтрокиЗапросаСвойств.Добавить(СтрокаЗапроса);
	КонецЦикла;
	ТекстСвойства = СтрСоединить(СтрокиЗапросаСвойств, ",");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоляСвойств", ТекстСвойства);
	
	СтатусыПроектовИсключения = Новый Массив;
	СтатусыПроектовИсключения.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Завершен);
	СтатусыПроектныхЗадачИсключения = Новый Массив;
	СтатусыПроектныхЗадачИсключения.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	
	ИсточникиПланаБДДС = Новый Массив;
	ИсточникиПланаБДДС.Добавить(Перечисления.упоИсточникПланаДДС.Доходы);
	ИсточникиПланаБДДС.Добавить(Перечисления.упоИсточникПланаДДС.Расходы);
	ИсточникиПланаБДДС.Добавить(Перечисления.упоИсточникПланаДДС.Трудозатраты);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаРелизаPM", Дата(2025, 11, 7));
	Запрос.УстановитьПараметр("ИсточникиПлана", ИсточникиПланаБДДС);
	Запрос.УстановитьПараметр("СтатусыПроектовИсключения", СтатусыПроектовИсключения);
	Запрос.УстановитьПараметр("СтатусыПроектныхЗадачИсключения", СтатусыПроектныхЗадачИсключения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

