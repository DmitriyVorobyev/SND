	Пока Выборка.Следующий() Цикл
		
		Если СтрНайти(Выборка.ИмяПредопределенныхДанных, "_упо") = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Используется = Истина;
		Если СтруктураИсключений.Свойство(Выборка.ИмяПредопределенныхДанных) Тогда
