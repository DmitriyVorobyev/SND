	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	Пока Выборка.Следующий() Цикл
		РедактироватьНастройкуСтруктурыПроекта(
			Выборка.КлючОбъекта, Выборка.КлючНастроек, Выборка.Настройки, Выборка.Представление, Выборка.Пользователь);
