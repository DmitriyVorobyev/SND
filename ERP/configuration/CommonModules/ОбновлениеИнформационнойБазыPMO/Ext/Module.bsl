Процедура ЗаполнитьПроектСтруктурыВПортфеляхИПрограммах() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоПрограммыПроектов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.упоПрограммыПроектов КАК упоПрограммыПроектов
	               |ГДЕ
	               |	упоПрограммыПроектов.ПроектСтруктуры = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	упоПортфелиПроектов.Ссылка
	               |ИЗ
	               |	Справочник.упоПортфелиПроектов КАК упоПортфелиПроектов
	               |ГДЕ
	               |	упоПортфелиПроектов.ПроектСтруктуры = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)";
				   		
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПортфельПрограмма = Выборка.Ссылка.ПолучитьОбъект();
		ПортфельПрограмма.Записать();
	КонецЦикла;	
	
КонецПроцедуры

Процедура ОбновлениеПользовательскихНастроекОперативнаяЗагрузкаСпециалистов() Экспорт
	
	КлючОбъекта = "Обработка.упоОперативнаяЗагрузкаСпециалистов";
	КлючНастроек = "НастройкиОбработки";
	Отбор = Новый Структура("КлючОбъекта", КлючОбъекта);
	ПолеКомпановкиРуководительПроекта = Новый ПолеКомпоновкиДанных("РуководительПроекта");
	ПолеКомпановкиСтатусЗадачи = Новый ПолеКомпоновкиДанных("СтатусЗадачи");
	ПолеКомпановкиСтатусПроекта = Новый ПолеКомпоновкиДанных("СтатусПроекта");
	
	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	Пока Выборка.Следующий() Цикл
		Если Найти(Выборка.КлючНастроек, КлючНастроек) <> 0 Тогда
			Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, Выборка.КлючНастроек, , Выборка.Пользователь);
			Если ТипЗнч(Настройки) = Тип("Структура") И Настройки.Свойство("СКД_ОтборСпециалистов") Тогда
				мУдалить = Новый Массив;
				ЭлементыОтбораСпециалистов = Настройки.СКД_ОтборЗадач.Отбор.Элементы;	
				Для Каждого ЭлементОтбора Из ЭлементыОтбораСпециалистов Цикл
					Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпановкиРуководительПроекта
						ИЛИ ЭлементОтбора.ЛевоеЗначение = ПолеКомпановкиСтатусЗадачи
						ИЛИ ЭлементОтбора.ЛевоеЗначение = ПолеКомпановкиСтатусПроекта Тогда
						
						мУдалить.Добавить(ЭлементОтбора);
					КонецЕсли;	
				КонецЦикла;
				Для Каждого ЭлементМассива Из мУдалить Цикл
					ЭлементыОтбораСпециалистов.Удалить(ЭлементМассива);
				КонецЦикла;	
				ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, Выборка.КлючНастроек, Настройки, Выборка.Пользователь);
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

