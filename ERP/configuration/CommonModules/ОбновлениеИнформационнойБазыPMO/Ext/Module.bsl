Функция ШаблонТаблицыПроектныхЗадач()
	
	ШаблонТаблицы = Новый ТаблицаЗначений;
	
	ИсточникКолонок = Метаданные.Документы.упоСохранениеДанныхПроекта.ТабличныеЧасти.ПроектныеЗадачи.Реквизиты;
	Для каждого Реквизит Из ИсточникКолонок Цикл
		ШаблонТаблицы.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");
	ШаблонТаблицы.Колонки.Добавить("НужноЗановоТранслироватьПланРасходов", ОписаниеТиповБулево);
	ШаблонТаблицы.Колонки.Добавить("НужноЗановоТранслироватьПланДоходов", ОписаниеТиповБулево);
	
	Возврат ШаблонТаблицы;
	
КонецФункции

Функция ПроектныеЗадачиПоВерсииПроекта(ШаблонТаблицыПроектныхЗадач, ВыборкаПроектныеЗадачи)
	
	ТаблицаПроектныеЗадачи = ШаблонТаблицыПроектныхЗадач.Скопировать();
	Пока ВыборкаПроектныеЗадачи.Следующий() Цикл
		НоваяСтрока = ТаблицаПроектныеЗадачи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПроектныеЗадачи);
	КонецЦикла;
	
	Возврат ТаблицаПроектныеЗадачи;
	
КонецФункции

Процедура ОбновитьДанныеТрансляцииБДРвБДДСПроектныхЗадач()
	
	РезультатЗапроса = ПроектныеЗадачиСПотенциальнойПроблемой();
	ВыборкаПроекты = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ШаблонТаблицыПроектныхЗадач = ШаблонТаблицыПроектныхЗадач();
	
	Пока ВыборкаПроекты.Следующий() Цикл
		ВыборкаВерсииПроекта = ВыборкаПроекты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаВерсииПроекта.Следующий() Цикл
			ВыборкаПроектныеЗадачи = ВыборкаВерсииПроекта.Выбрать();
			
			ЗагружаемаяТаблицаЗадач = ПроектныеЗадачиПоВерсииПроекта(ШаблонТаблицыПроектныхЗадач,
				ВыборкаПроектныеЗадачи);
			
			// Сначала отключим в проблемных задачах признак трансляции БДР в БДДС.
			ОтключитьТрансляцию = Истина;
			СоздатьИЗаполнитьДокументСохраненияДанныхПроекта(ВыборкаВерсииПроекта, ЗагружаемаяТаблицаЗадач,
				ШаблонТаблицыПроектныхЗадач, ОтключитьТрансляцию);
			
			// Вернем признак трансляции обратно.
			ОтключитьТрансляцию = Ложь;
			СоздатьИЗаполнитьДокументСохраненияДанныхПроекта(ВыборкаВерсииПроекта, ЗагружаемаяТаблицаЗадач,
				ШаблонТаблицыПроектныхЗадач, ОтключитьТрансляцию);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьПризнакТрансляцииВЗагружаемойТаблицеЗадач(ТаблицаЗадач, ОтключитьТрансляцию)
	
	Для каждого Строка Из ТаблицаЗадач Цикл
		Если Строка.НужноЗановоТранслироватьПланРасходов Тогда
			Строка.ВключитьПланРасходовВБДДС = Не ОтключитьТрансляцию;
		КонецЕсли;
		
		Если Строка.НужноЗановоТранслироватьПланДоходов Тогда
			Строка.ВключитьПланДоходовВБДДС = Не ОтключитьТрансляцию;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьИЗаполнитьДокументСохраненияДанныхПроекта(ДанныеШапки, ТаблицаЗадач, ШаблонТаблицыПроектныхЗадач, ОтключитьТрансляцию)
	
	ОбновитьПризнакТрансляцииВЗагружаемойТаблицеЗадач(ТаблицаЗадач, ОтключитьТрансляцию);
	
	Если ОтключитьТрансляцию Тогда
		Комментарий = НСтр("ru = 'Исправление ошибки трансляции БДР в БДДС, выключение трансляции.'");
	Иначе
		Комментарий = НСтр("ru = 'Исправление ошибки трансляции БДР в БДДС, включение трансляции.'");
	КонецЕсли;
	
	ДокументСохранения = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
	ДокументСохранения.Проект = ДанныеШапки.Проект;
	ДокументСохранения.Версия = ДанныеШапки.Версия;
	ДокументСохранения.ПерезаписатьВключитьПланДоходовВБДДС = Истина;
	ДокументСохранения.ПерезаписатьВключитьПланРасходовВБДДС= Истина;
	ДокументСохранения.Комментарий = Комментарий;
	
	ДокументСохранения.ПроектныеЗадачи.Загрузить(ТаблицаЗадач);
	
	ДокументСохранения.Дата = ТекущаяДатаСеанса();
	ДокументСохранения.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

