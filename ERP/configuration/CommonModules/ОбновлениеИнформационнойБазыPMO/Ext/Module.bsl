Процедура ОбновитьВидСобытия_НазначениеНаПроектнуюЗадачу(Параметры = Неопределено) Экспорт
	
	ТипТэга = Перечисления.упоТипыТегов.ВыполняемыйКод;
	УсловиеЗамены = "обПолучитьНазваниеПроектнойЗадачи(";
		
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	упоВидыСобытийТэги.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.упоВидыСобытий.Тэги КАК упоВидыСобытийТэги
	                      |ГДЕ
	                      |	упоВидыСобытийТэги.ТипТэга = &ТипТэга	                      
	                      |	И упоВидыСобытийТэги.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", Справочники.упоВидыСобытий.НазначениеНаПЗ);
	Запрос.УстановитьПараметр("ТипТэга", ТипТэга);	
	
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл 
		
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		ЗаписатьОбъект = Ложь;
		
		Для Каждого Тэг Из СправочникОбъект.Тэги Цикл
			Если Тэг.ТипТэга = ТипТэга Тогда
				ПозицияЗамены = СтрНайти(Тэг.Условие, УсловиеЗамены);
				
				Если ПозицияЗамены = 0 Тогда
					Продолжить;
				ИначеЕсли ПозицияЗамены > 1 Тогда
					ПредыдущийСимвол = Сред(Тэг.Условие, ПозицияЗамены - 1, 1);				
					Если ПредыдущийСимвол = "." Тогда // Пользователь вручную исправил код.
						Продолжить;
					КонецЕсли;
				КонецЕсли;	
								
				Тэг.Условие = СтрЗаменить(Тэг.Условие, 
					УсловиеЗамены, 
					"упоПроектыИЗадачиВызовСервера." + УсловиеЗамены);
				
				ЗаписатьОбъект = Истина;
			КонецЕсли;	
		КонецЦикла;
		
		Если ЗаписатьОбъект Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);		
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры	

