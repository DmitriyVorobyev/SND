// Процедура синхронизирует сценарии.
//
Процедура СинхронизироватьСценарии(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
                   |    Сценарии.Ссылка КАК Сценарий
                   |ИЗ
                   |    Справочник.Сценарии КАК Сценарии
                   |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСоответствиеСценариев КАК упоСоответствиеСценариев
                   |        ПО упоСоответствиеСценариев.СценарийERP <> Сценарии.Ссылка";
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда                               
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			упоИнтеграция.СинхронизироватьСценарии(Выборка.Сценарий, Истина);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитШифрПроекта(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Проекты.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |ГДЕ
	               |	Проекты.упоШифр = """"
	               |	И НЕ Проекты.ЭтоПроектнаяЗадача
	               |	И НЕ Проекты.ПометкаУдаления
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Проекты.Ссылка КАК Ссылка,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.КодПроектногоДокумента КАК КодПроектногоДокумента
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |			И (упоСвойстваПроектныхЗадачСрезПоследних.КодПроектногоДокумента <> """")
	               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	               |			И (Проекты.упоШифр = """")";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИндексПоследнего = Результат.ВГраница();
	РезультатПроекты 	= Результат[ИндексПоследнего - 1];
	РезультатПЗ 		= Результат[ИндексПоследнего];
	
	Если Не РезультатПроекты.Пустой() Тогда 
		Выборка = РезультатПроекты.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПроектОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПроектОбъект.упоШифр = ПроектОбъект.Код;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПроектОбъект);
		КонецЦикла;
	КонецЕсли;
	
	Если Не РезультатПЗ.Пустой() Тогда 
		Выборка = РезультатПЗ.Выбрать();
		Пока Выборка.Следующий() Цикл
			ПроектОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПроектОбъект.упоШифр = Выборка.КодПроектногоДокумента;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПроектОбъект);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет добавленную опцию НД УчетРасчетовСПоставщиками в направлениях деятельности, 
// связанных с проектными задачами, для целей отражения в проектном бюджетировании.
//
Процедура ОбновитьОпцииСвязанныхНД(Параметры = Неопределено) Экспорт
	
	// Обновление настроек создания НД.
	
	НастройкиЗаполнения = упоСвязьПроектаСНаправлениемДеятельности.ПолучитьНастройкиЗаполненияСвязанногоНД();
	
	НадоОбновитьНастройки = Не(НастройкиЗаполнения.Свойство("УчетРасчетовСПоставщиками") 
		И НастройкиЗаполнения.УчетРасчетовСПоставщиками);
	
	Если НадоОбновитьНастройки Тогда
		НастройкиЗаполнения.Вставить("УчетРасчетовСПоставщиками", Истина);
		упоСвязьПроектаСНаправлениемДеятельности.СохранитьНастройкиЗаполненияСвязанногоНД(НастройкиЗаполнения);
	КонецЕсли;
	
	// Обновление НД.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоСвязьПроектаСНаправлениемДеятельности.НаправлениеДеятельностиЭлемент КАК Ссылка
		|ИЗ
		|	РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности
		|ГДЕ
		|	НЕ упоСвязьПроектаСНаправлениемДеятельности.НаправлениеДеятельностиЭлемент.УчетРасчетовСПоставщиками";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.УчетРасчетовСПоставщиками = Истина;
		Если Не ЗначениеЗаполнено(СправочникОбъект.НалогообложениеНДС) Тогда
			СправочникОбъект.НалогообложениеНДС  = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		КонецЕсли;
