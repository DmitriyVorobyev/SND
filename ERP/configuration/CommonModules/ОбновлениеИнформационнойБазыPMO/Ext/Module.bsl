			КонецЕсли;
		КонецЦикла;
		
		НаборЗаписей.Загрузить(ТаблицаНабораЗаписей);
		НаборЗаписей.ДополнительныеСвойства.Вставить("упоИгнорироватьОповещения", Истина);
