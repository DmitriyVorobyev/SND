Процедура ОбновитьНастройкиПользователейПанелиПоказателей() Экспорт
	
	КлючОбъекта = "Обработка.упоПанельПоказателей";
	
	СписокПользователей = ПользователиИнформационнойБазы.ПолучитьПользователей();
	
	Для Каждого Пользователь Из СписокПольЗователей Цикл
		
		ИмяПользователя = Пользователь.Имя;
		
		Отбор = Новый Структура("КлючОбъекта", КлючОбъекта);
		Отбор.Вставить("Пользователь", ИмяПользователя());
		
		Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
		
		Пока Выборка.Следующий() Цикл
			
			Если Найти(Выборка.КлючНастроек, "НастройкиОбработки") <> 0 Тогда
				
				Настройка = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, Выборка.КлючНастроек,, ИмяПользователя); 
				
				Если ТипЗнч(Настройка) = Тип("Структура") И Настройка.Свойство("НастройкиКомпоновщика") Тогда
					
					ОписаниеНастройки = ХранилищеОбщихНастроек.ПолучитьОписание(КлючОбъекта, Выборка.КлючНастроек, ИмяПользователя);
					упоПанельПоказателейВызовСервера.ЗаполнитьОтборПоКомпоненту(Настройка.НастройкиКомпоновщика);
					ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, Выборка.КлючНастроек, Настройка, ОписаниеНастройки, ИмяПользователя);
					
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьПроектСтруктуры() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоПрограммыПроектов.Ссылка
		|ИЗ
		|	Справочник.упоПрограммыПроектов КАК упоПрограммыПроектов
		|ГДЕ
		|	упоПрограммыПроектов.ПроектСтруктуры = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СсылкаНаПрограмму = ВыборкаДетальныеЗаписи.Ссылка;
		ПрограммаПроектовОбъект = СсылкаНаПрограмму.ПолучитьОбъект();
		
		НовыйПроект = Справочники.Проекты.СоздатьЭлемент();
		НовыйПроект.Наименование = СсылкаНаПрограмму.Наименование;
		НовыйПроект.ПометкаУдаления = СсылкаНаПрограмму.ПометкаУдаления;
		НовыйПроект.Заполнить(СсылкаНаПрограмму);
		
		НовыйПроект.Записать();    			
		
		ПрограммаПроектовОбъект.ПроектСтруктуры = НовыйПроект.Ссылка;
		ПрограммаПроектовОбъект.Записать();
		
	КонецЦикла;
				
КонецПроцедуры

Процедура ПереносПользователейВНовыеГруппыУдалениеСтарыхРолейИзПрофилей() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГруппыДоступаНовые.Ссылка КАК ГруппаДоступаНовая,
	               |	ПользователиГруппДоступа.Пользователь КАК ПользователиГруппыПользователей,
	               |	Профили.Ссылка КАК ПрофильТекущий,
	               |	РолиПрофилей.Роль КАК РольКакОбъктМД_НаУдалениеИзТекущегоПрофиля
	               |ИЗ
	               |	Справочник.ГруппыДоступа КАК ГруппыДоступа
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ПользователиГруппДоступа
	               |		ПО (ПользователиГруппДоступа.Ссылка = ГруппыДоступа.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа КАК Профили
	               |		ПО ГруппыДоступа.Профиль = Профили.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПрофилиГруппДоступа.Роли КАК РолиПрофилей
	               |		ПО (Профили.Ссылка = РолиПрофилей.Ссылка)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МД.Ссылка КАК Ссылка,
	               |			МД.Имя КАК Имя
	               |		ИЗ
	               |			Справочник.ИдентификаторыОбъектовМетаданных КАК МД
	               |		ГДЕ
	               |			МД.Имя В (""? упоАдминистраторПроектногоОфиса"", ""? упоИсполнительРабот"", ""? упоИсполнительРаботБезФинансов"", ""? упоРуководительПроектногоОфиса"", ""? упоРуководительПроектовПодразделений"", ""? упоРуководительПроектовПодразделенийБезФинансов"", ""? упоФинансистПроектногоОфиса"")
	               |			И МД.ПометкаУдаления) КАК ИскомыеРоли
	               |		ПО (ИскомыеРоли.Ссылка = РолиПрофилей.Роль)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК ГруппыДоступаНовые
	               |		ПО (ГруппыДоступаНовые.Профиль = ВЫБОР
	               |				КОГДА ИскомыеРоли.Имя = ""? упоАдминистраторПроектногоОфиса""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоАдминистраторПроектногоОфиса)
	               |				КОГДА ИскомыеРоли.Имя = ""? упоИсполнительРабот""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоИсполнительРаботБезФинансов)
	               |				КОГДА ИскомыеРоли.Имя = ""? упоИсполнительРаботБезФинансов""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоИсполнительРаботБезФинансов)
	               |				КОГДА ИскомыеРоли.Имя = ""? упоРуководительПроектногоОфиса""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоРуководительПроектногоОфиса)
	               |				КОГДА ИскомыеРоли.Имя = ""? упоРуководительПроектовПодразделений""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоРуководительПроектовПодразделений)
	               |				КОГДА ИскомыеРоли.Имя = ""? упоРуководительПроектовПодразделенийБезФинансов""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоРуководительПроектовПодразделенийБезФинансов)
	               |				КОГДА ИскомыеРоли.Имя = ""? упоФинансистПроектногоОфиса""
	               |					ТОГДА ЗНАЧЕНИЕ(Справочник.ПрофилиГруппДоступа.упоФинансистПроектногоОфиса)
	               |			КОНЕЦ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ГруппыДоступаНовые.Ссылка";
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаКорректируемыхДанных = Результат.Выгрузить();
	
	ГруппыДоступаНовые = ТаблицаКорректируемыхДанных.Скопировать(, "ГруппаДоступаНовая");
	ГруппыДоступаНовые.Свернуть("ГруппаДоступаНовая");
	
	// Соберем объекты, чтоб позже записать.
	МассивНовыхГрупп = Новый Массив;
	
	ЗаписатьИзмененияВНовойГруппе = Ложь;
	Для Каждого СтрТЗ Из ГруппыДоступаНовые Цикл
		
		НоваяГруппа = СтрТЗ.ГруппаДоступаНовая;
		Если НЕ ЗначениеЗаполнено(НоваяГруппа) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяГруппаОбъект = НоваяГруппа.ПолучитьОбъект();
		
		СтруктураОтбораДанныхГруппы = Новый Структура("ГруппаДоступаНовая", НоваяГруппа);
		СтрокиНовойГруппы = ТаблицаКорректируемыхДанных.НайтиСтроки(СтруктураОтбораДанныхГруппы);
		Для Каждого ДанныеГруппы Из СтрокиНовойГруппы Цикл
			
			ПользовательГруппыДоступа = ДанныеГруппы.ПользователиГруппыПользователей;
			
			Если НЕ ЗначениеЗаполнено(ПользовательГруппыДоступа) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НоваяГруппаОбъект.Пользователи.Найти(ПользовательГруппыДоступа) = Неопределено Тогда
				
				НС = НоваяГруппаОбъект.Пользователи.Добавить();
				НС.Пользователь = ПользовательГруппыДоступа;
				
				ЗаписатьИзмененияВНовойГруппе = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
			
		Если МассивНовыхГрупп.Найти(НоваяГруппаОбъект) = Неопределено Тогда
			МассивНовыхГрупп.Добавить(НоваяГруппаОбъект);
		КонецЕсли;
		
	КонецЦикла;
	
	// Удалим из профилей старые роли.
	РедактируемыеПрофили = ТаблицаКорректируемыхДанных.Скопировать(, "ПрофильТекущий");
	РедактируемыеПрофили.Свернуть("ПрофильТекущий");
	
	ПрофилиРоли = ТаблицаКорректируемыхДанных.Скопировать(, "ПрофильТекущий, РольКакОбъктМД_НаУдалениеИзТекущегоПрофиля");
	ПрофилиРоли.Свернуть("ПрофильТекущий, РольКакОбъктМД_НаУдалениеИзТекущегоПрофиля");
	
	МассивПрофилей = Новый Массив;
	
	ЗаписатьИзмененияВПрофилях = Ложь;
	Для Каждого СтрПрофиля Из РедактируемыеПрофили Цикл
		
		ТекПрофильСсылка = СтрПрофиля.ПрофильТекущий;
		Если НЕ ЗначениеЗаполнено(ТекПрофильСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ИскомыеСтрокиСРолямиПрофиля = ПрофилиРоли.НайтиСтроки(Новый Структура("ПрофильТекущий", ТекПрофильСсылка));
				
		ТекПрофильОбъект = ТекПрофильСсылка.ПолучитьОбъект();
		Для Каждого СтрокаПрофиляСРолью Из ИскомыеСтрокиСРолямиПрофиля Цикл
			
			РольПрофиля = СтрокаПрофиляСРолью.РольКакОбъктМД_НаУдалениеИзТекущегоПрофиля;
			Если НЕ ЗначениеЗаполнено(РольПрофиля) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаУдаляемая = ТекПрофильОбъект.Роли.Найти(СтрокаПрофиляСРолью.РольКакОбъктМД_НаУдалениеИзТекущегоПрофиля, "Роль");
			Если СтрокаУдаляемая = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТекПрофильОбъект.Роли.Удалить(СтрокаУдаляемая);
			
			ЗаписатьИзмененияВПрофилях = Истина;
			
		КонецЦикла;
		
		Если МассивПрофилей.Найти(ТекПрофильОбъект) = Неопределено Тогда
			МассивПрофилей.Добавить(ТекПрофильОбъект);
		КонецЕсли;
				
	КонецЦикла;
	
	// Записать в правильном порядке.
	
	Если ЗаписатьИзмененияВПрофилях Тогда 
		Для Каждого ЭлПрофиль Из МассивПрофилей Цикл
			ЭлПрофиль.Записать();
		КонецЦикла;
	КонецЕсли;
	
	Если ЗаписатьИзмененияВНовойГруппе Тогда 
		Для Каждого ЭлГруппа Из МассивНовыхГрупп Цикл
			ЭлГруппа.Записать();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры 

