	               |ГДЕ
	               |	НЕ упоРегистрацияЮридическихУсловийДоговора.ПометкаУдаления
	               |	И упоРегистрацияЮридическихУсловийДоговора.НомерДоговора = """"";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДоговорОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДоговорОбъект.НомерДоговора = ДоговорОбъект.Номер;
		ДоговорОбъект.ДатаДоговора = ДоговорОбъект.Дата;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДоговорОбъект);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьДвиженияДокументаПоРегистру_упоСинхронизацияФактическихТрудозатрат(Параметры = Неопределено) Экспорт
	
	ПустаяЗадачаПричина = Новый Массив;
	ПустаяЗадачаПричина.Добавить(Неопределено);
	ПустаяЗадачаПричина.Добавить(Справочники.упоВнепроектныеЗадачи.ПустаяСсылка());
	ПустаяЗадачаПричина.Добавить(Справочники.Проекты.ПустаяСсылка());
	ПустаяЗадачаПричина.Добавить(Справочники.упоПричиныПотерьРабочегоВремени.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяЗадачаПричина", ПустаяЗадачаПричина);
	Запрос.УстановитьПараметр("РазделУчета", Перечисления.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("РабочееЗадание", Документы.упоПроектнаяЗадача.ПустаяСсылка());
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоИспользованиеРабочегоВремени.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ втРегистраторы
	               |ИЗ
	               |	РегистрСведений.упоИспользованиеРабочегоВремени КАК упоИспользованиеРабочегоВремени
	               |ГДЕ
	               |	упоИспользованиеРабочегоВремени.Регистратор ССЫЛКА Документ.упоСинхронизацияФактическихТрудозатрат
	               |	И упоИспользованиеРабочегоВремени.ЗадачаПричина В(&ПустаяЗадачаПричина)
	               |	И упоИспользованиеРабочегоВремени.РазделУчета = &РазделУчета
	               |	И упоИспользованиеРабочегоВремени.РабочееЗадание <> &РабочееЗадание
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоИспользованиеРабочегоВремени.Период КАК Период,
	               |	упоИспользованиеРабочегоВремени.Регистратор КАК Регистратор,
	               |	упоИспользованиеРабочегоВремени.НомерСтроки КАК НомерСтроки,
	               |	упоИспользованиеРабочегоВремени.Активность КАК Активность,
	               |	упоИспользованиеРабочегоВремени.ТрудовойРесурс КАК ТрудовойРесурс,
	               |	упоИспользованиеРабочегоВремени.РазделУчета КАК РазделУчета,
	               |	ВЫБОР
	               |		КОГДА упоИспользованиеРабочегоВремени.РазделУчета = &РазделУчета
	               |			ТОГДА Проекты.Ссылка
	               |		ИНАЧЕ упоИспользованиеРабочегоВремени.ЗадачаПричина
	               |	КОНЕЦ КАК ЗадачаПричина,
	               |	упоИспользованиеРабочегоВремени.День КАК День,
	               |	упоИспользованиеРабочегоВремени.РабочееЗадание КАК РабочееЗадание,
	               |	упоИспользованиеРабочегоВремени.РасшифровкаТрудозатрат КАК РасшифровкаТрудозатрат,
	               |	упоИспользованиеРабочегоВремени.Подразделение КАК Подразделение,
	               |	упоИспользованиеРабочегоВремени.РольРесурса КАК РольРесурса,
	               |	упоИспользованиеРабочегоВремени.ВидОперации КАК ВидОперации,
	               |	упоИспользованиеРабочегоВремени.Задание КАК Задание,
	               |	упоИспользованиеРабочегоВремени.Начало КАК Начало,
	               |	упоИспользованиеРабочегоВремени.Трудозатраты КАК Трудозатраты
	               |ИЗ
	               |	РегистрСведений.упоИспользованиеРабочегоВремени КАК упоИспользованиеРабочегоВремени
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втРегистраторы КАК втРегистраторы
	               |		ПО упоИспользованиеРабочегоВремени.Регистратор = втРегистраторы.Регистратор
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО упоИспользованиеРабочегоВремени.РабочееЗадание = Проекты.СсылкаНаПроектнуюЗадачу
	               |			И (Проекты.ЭтоПроектнаяЗадача)
	               |ИТОГИ ПО
	               |	Регистратор";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаРегистратор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НЗ = РегистрыСведений.упоИспользованиеРабочегоВремени.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		
		Выборка = ВыборкаРегистратор.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(НЗ.Добавить(), Выборка);
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ);
		
	КонецЦикла;

КонецПроцедуры

