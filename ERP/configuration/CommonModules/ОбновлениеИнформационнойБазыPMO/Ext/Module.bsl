// Заполняет стандартную настройку календаря.
// 
Функция ЗаполнитьСтандартнуюНастройкаКалендаря() Экспорт
	НастройкаКалендаря = Справочники.упоНастройкиКалендарей2.Стандартная.ПолучитьОбъект();
	НастройкаКалендаря.Заполнить(Неопределено);
	НастройкаКалендаря.Записать();
КонецФункции 

Функция СоздатьЗарегистрироватьРабочийКалендарьПоУмолчанию()
	
	СтандартнаяНастройка = Справочники.упоНастройкиКалендарей.СоздатьЭлемент();
	СтандартнаяНастройка.Заполнить(Неопределено);
	СтандартнаяНастройка.Наименование = НСтр("ru = 'Стандартная'");
	СтандартнаяНастройка.ПолноеНаименование = НСтр("ru = 'Стандартная'");
	СтандартнаяНастройка.Записать();
	
	РабочийКалендарь = Справочники.упоРабочиеКалендари.СоздатьЭлемент();
	РабочийКалендарь.Наименование = НСтр("ru = 'Стандартный'");
	РабочийКалендарь.ПолноеНаименование = НСтр("ru = 'Стандартный'");
	РабочийКалендарь.Записать();
	
	ТекДата = ТекущаяДата();
	ТекущийГод = Год(ТекДата);
	НачалоПериода = ТекущийГод - 5;
	КонецПериода = ТекущийГод + 15;
	Для к = НачалоПериода По КонецПериода Цикл
		ДокРегистрацияРабочегоКалендаря = Документы.упоРегистрацияРабочегоКалендаря.СоздатьДокумент();
		ДокРегистрацияРабочегоКалендаря.Дата = ТекДата;
		ДокРегистрацияРабочегоКалендаря.ГодКалендаря = к;
		ДокРегистрацияРабочегоКалендаря.Календарь = РабочийКалендарь.Ссылка;
		ДокРегистрацияРабочегоКалендаря.НастройкаКалендаря = СтандартнаяНастройка.Ссылка;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокРегистрацияРабочегоКалендаря, 
													Ложь, 
													Истина, 
													РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	упоРабочиеКалендариВызовСервера.РассчитатьСмещенияДляКалендаря(РабочийКалендарь.Ссылка);
	
	Возврат РабочийКалендарь.Ссылка;
	
КонецФункции

