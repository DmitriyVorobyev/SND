Процедура ВключитьПользователяВГруппуДоступа(Пользователь, ИмяГруппыДоступа)
	
	ГруппаДоступа = Справочники.ГруппыДоступа[ИмяГруппыДоступа].ПолучитьОбъект();
	
	Если ГруппаДоступа.Пользователи.Найти(Пользователь, "Пользователь") = Неопределено Тогда
		
		НоваяСтрока = ГруппаДоступа.Пользователи.Добавить();
		НоваяСтрока.Пользователь = Пользователь;
		
		ГруппаДоступа.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РедактироватьНастройкуСтруктурыПроекта(КлючОбъекта, КлючНастроек, СтруктураНастроек,
	ПредставлениеНастройки, ИмяПользователя)
	
	Если НЕ ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьИзменение = Ложь;
	
	МассивСписков = Новый Массив;
	Если СтруктураНастроек.Свойство("ПользовательскийПорядокКолонок") 
		И ТипЗнч(СтруктураНастроек.ПользовательскийПорядокКолонок) = Тип("СписокЗначений") Тогда
		МассивСписков.Добавить("ПользовательскийПорядокКолонок");
	КонецЕсли;
	Если СтруктураНастроек.Свойство("СписокКолонок")
		И ТипЗнч(СтруктураНастроек.СписокКолонок) = Тип("СписокЗначений") Тогда
		МассивСписков.Добавить("СписокКолонок");
	КонецЕсли;
	
	
	Для Каждого ИмяСписка Из МассивСписков Цикл
		
		Для Каждого ЭлементСписка Из СтруктураНастроек[ИмяСписка] Цикл
			Если ЭлементСписка.Значение = "ОтлонениеПоОкончанию" Тогда
				ЭлементСписка.Значение = "ОтклонениеПоОкончанию";
				ЕстьИзменение = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЕстьИзменение Тогда
		
		ОписаниеНастройки = Новый ОписаниеНастроек();
		ОписаниеНастройки.Представление = ПредставлениеНастройки; 
		
		ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, СтруктураНастроек, ОписаниеНастройки, ИмяПользователя);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПредопределенныеЗначения_СправочникРоли()
	
	ЗаказчикОбъект = Справочники.упоРоли.Заказчик.ПолучитьОбъект();
	ЗаказчикОбъект.упоВидРесурса = Перечисления.упоВидРесурса.Трудовой;
	ЗаказчикОбъект.Записать();
	
КонецПроцедуры	

Процедура ЗаполнитьВыбранныйРесурсРегистраупоСвойстваПроектныхЗадач(Запрос, ИмяРесурса)
			
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРегистратор = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НаборЗаписей = РегистрыСведений.упоСвойстваПроектныхЗадач.СоздатьНаборЗаписей();	
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		НаборЗаписей.Прочитать();
		Выборка = ВыборкаРегистратор.Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись.ПроектнаяЗадача = Выборка.ПроектнаяЗадача Тогда
					Запись[ИмяРесурса] = Истина;
				КонецЕсли;								
			КонецЦикла;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьВариантыОтчетаПользователя(КлючОбъекта, СответствиеЗамен, ИмяПользователя)
			
	ТипыГрупп = Новый Массив;
	ТипыГрупп.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	ТипыГрупп.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ТипыГрупп.Добавить(Тип("ГруппировкаТаблицыКомпоновкиДанных"));
	ТипыГрупп.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ТипыГрупп.Добавить(Тип("ГруппировкаДиаграммыКомпоновкиДанных"));
		
	мХранилищеВариантов = ХранилищаНастроек.ХранилищеВариантовОтчетов;
		
	ВариантыОтчета = мХранилищеВариантов.ПолучитьСписок(КлючОбъекта, ИмяПользователя);
	
	ОписаниеНастроек = Новый ОписаниеНастроек;
		
	Для Каждого Вариант Из ВариантыОтчета Цикл
		
		КлючНастроек = Вариант.Значение;
		
		Настройки = мХранилищеВариантов.Загрузить(КлючОбъекта, КлючНастроек, ОписаниеНастроек, ИмяПользователя);
		
		Если Настройки = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ВыполнитьЗаменуПолейВНастройкахРекурсивно(Настройки.Выбор.Элементы, СответствиеЗамен, ТипыГрупп);
		ВыполнитьЗаменуПолейВНастройкахРекурсивно(Настройки.Отбор.Элементы, СответствиеЗамен, ТипыГрупп);
		
		Для Каждого ЭлементСтруктуры Из Настройки.Структура Цикл
			Если Тип(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда				
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементСтруктуры.Строки, СответствиеЗамен, ТипыГрупп);	
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементСтруктуры.Колонки, СответствиеЗамен, ТипыГрупп);	
			ИначеЕсли Тип(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") Тогда					
				Коллекция = Новый Массив;
				Коллекция.Добавить(ЭлементСтруктуры);				
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(Коллекция, СответствиеЗамен, ТипыГрупп);
			ИначеЕсли Тип(ЭлементСтруктуры) = Тип("ДиаграммаКомпоновкиДанных") Тогда	
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементСтруктуры.Серии, СответствиеЗамен, ТипыГрупп);		
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементСтруктуры.Точки, СответствиеЗамен, ТипыГрупп);		
			КонецЕсли;	
		КонецЦикла;		
		
		мХранилищеВариантов.Сохранить(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, ИмяПользователя);
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ВыполнитьЗаменуПолейВНастройкахРекурсивно(КоллекцияЭлементов, СответствиеЗамен, ТипыГрупп)
	
	Для Каждого ЭлементВыбор Из КоллекцияЭлементов Цикл 		
		Если ТипыГрупп.Найти(Тип(ЭлементВыбор)) <> Неопределено Тогда
			Если Тип(ЭлементВыбор) = Тип("ГруппировкаТаблицыКомпоновкиДанных") 
				Или Тип(ЭлементВыбор) = Тип("ГруппировкаКомпоновкиДанных") 
				Или Тип(ЭлементВыбор) = Тип("ГруппировкаДиаграммыКомпоновкиДанных")  Тогда
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементВыбор.ПоляГруппировки.Элементы, СответствиеЗамен, ТипыГрупп);	
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементВыбор.Структура, СответствиеЗамен, ТипыГрупп);	
			Иначе	
				ВыполнитьЗаменуПолейВНастройкахРекурсивно(ЭлементВыбор.Элементы, СответствиеЗамен, ТипыГрупп);	
			КонецЕсли;	
		Иначе								
			Если Тип(ЭлементВыбор) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				ПолеЗамены = СответствиеЗамен.Получить(ЭлементВыбор.ЛевоеЗначение);
				Если Не ПолеЗамены = Неопределено Тогда 
					ЭлементВыбор.ЛевоеЗначение = ПолеЗамены;	
				КонецЕсли;	
			Иначе				
				ПолеЗамены = СответствиеЗамен.Получить(ЭлементВыбор.Поле);
				Если Не ПолеЗамены = Неопределено Тогда 
					ЭлементВыбор.Поле = ПолеЗамены;	
				КонецЕсли;					
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
		
КонецПроцедуры	

Процедура ЗаполнитьВерсиюУказанногоРегистра(ИмяРегистра, ПроектИзПЗ = Истина)
	
	Если ПроектИзПЗ Тогда
		ИмяПоляПроекта = "ПроектнаяЗадача.Проект";
	Иначе
		ИмяПоляПроекта = "Проект";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Регистр.Регистратор КАК Регистратор,
	|	Регистр.ИмяПоляПроекта КАК Проект
	|ПОМЕСТИТЬ РегистраторыИПроекты
	|ИЗ
	|	РегистрСведений.ИмяРегистра КАК Регистр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегистраторыИПроекты.Регистратор КАК Регистратор,
	|	упоВерсииПроекта.Версия КАК Версия
	|ИЗ
	|	РегистраторыИПроекты КАК РегистраторыИПроекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|		ПО РегистраторыИПроекты.Проект = упоВерсииПроекта.Проект
	|			И (упоВерсииПроекта.Текущая)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяРегистра", ИмяРегистра);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяПоляПроекта", ИмяПоляПроекта);
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);		
		НаборЗаписей.Прочитать();
		
		Версия = Выборка.Регистратор;
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.Версия = Выборка.Версия;
		КонецЦикла;
		
		НаборЗаписей.ДополнительныеСвойства.Вставить("упоНеПроверятьЗакрытыеЭтапы", Истина);
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать документ: %Регистратор% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Регистратор%", Выборка.Регистратор);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,,
				Выборка.Регистратор,
				ТекстСообщения);	
		КонецПопытки;
	КонецЦикла;	
		
КонецПроцедуры

Процедура РедактироватьНастройкуКолонокСтруктурыПроекта(КлючОбъекта, КлючНастроек, СтруктураНастроек,
	ПредставлениеНастройки, ИмяПользователя)
	
	Если НЕ ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СтруктураНастроек.Свойство("СписокКолонок") 
		Или Не ТипЗнч(СтруктураНастроек.СписокКолонок) = Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ВключитьКолонкуЗаданиеПодразделению = Ложь;
	мУдалить = Новый Массив;
	
	Для Каждого ЭлементСписка Из СтруктураНастроек.СписокКолонок Цикл
		Если ЭлементСписка.Значение = "СтатусЗаданияПодразделению"
			Или ЭлементСписка.Значение = "СтатусЗаданияНаПланирование"
			Или ЭлементСписка.Значение = "СтатусЗаданияНаПрогноз" Тогда
			
			Если ЭлементСписка.Пометка Тогда
				ВключитьКолонкуЗаданиеПодразделению = Истина;
			КонецЕсли;
			мУдалить.Добавить(ЭлементСписка);
		КонецЕсли;	
		Если ЭлементСписка.Значение = "ЗаданиеНаПланирование"
			Или ЭлементСписка.Значение = "ЗаданиеНаПрогноз" Тогда
			мУдалить.Добавить(ЭлементСписка);
		КонецЕсли;
	КонецЦикла;
		
	Для Каждого ЭлементУдалить Из мУдалить Цикл
		СтруктураНастроек.СписокКолонок.Удалить(ЭлементУдалить);
	КонецЦикла;
		
	Если ВключитьКолонкуЗаданиеПодразделению Тогда
		ЭлементСписка = СтруктураНастроек.СписокКолонок.НайтиПоЗначению("ЗаданиеПодразделению");
		Если ЭлементСписка = Неопределено Тогда
			ЭлементСписка = СтруктураНастроек.СписокКолонок.Добавить("ЗаданиеПодразделению", НСтр("ru = 'Задание'") + Символы.ПС + НСтр("ru = 'подразделению'"));
		КонецЕсли;	
		ЭлементСписка.Пометка = Истина;
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ПользовательскийПорядокКолонок") 
		И ТипЗнч(СтруктураНастроек.ПользовательскийПорядокКолонок) = Тип("СписокЗначений") Тогда
		
		мУдалить = Новый Массив;
		Если СтруктураНастроек.ПользовательскийПорядокКолонок.НайтиПоЗначению("ЗаданиеПодразделению") = Неопределено Тогда
			ЗаменаПроведена = Ложь;
		Иначе
			ЗаменаПроведена = Истина;
		КонецЕсли;
		
		Для Каждого ЭлементСписка Из СтруктураНастроек.ПользовательскийПорядокКолонок Цикл
			Если ЭлементСписка.Значение = "СтатусЗаданияПодразделению"
				Или ЭлементСписка.Значение = "СтатусЗаданияНаПланирование"
				Или ЭлементСписка.Значение = "СтатусЗаданияНаПрогноз"
				Или ЭлементСписка.Значение = "ЗаданиеНаПланирование"
				Или ЭлементСписка.Значение = "ЗаданиеНаПрогноз" Тогда
				
				Если Не ЗаменаПроведена Тогда
				 	СтруктураНастроек.ПользовательскийПорядокКолонок.Вставить(
						СтруктураНастроек.ПользовательскийПорядокКолонок.Индекс(ЭлементСписка),
						"ЗаданиеПодразделению",
						ЭлементСписка.Представление);
					ЗаменаПроведена = Истина;
				Иначе
					мУдалить.Добавить(ЭлементСписка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементУдалить Из мУдалить Цикл
			СтруктураНастроек.ПользовательскийПорядокКолонок.Удалить(ЭлементУдалить);
		КонецЦикла;
	
	КонецЕсли;
	
	ОписаниеНастройки = Новый ОписаниеНастроек();
	ОписаниеНастройки.Представление = ПредставлениеНастройки; 	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, СтруктураНастроек, ОписаниеНастройки, ИмяПользователя);
	
КонецПроцедуры

// Заполняет пустой регистр соответствия статусов проектной продукции процентам готовности.
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура ЗаполнитьСоответствиеСтатусовПППроцентамГотовности()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ("ВЫБРАТЬ ПЕРВЫЕ 1
	                |	Таблица.СтатусПП КАК СтатусПП
	                |ИЗ
	                |	РегистрСведений.упоСоответствиеСтатусовПППроцентамГотовности КАК Таблица");
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Возврат; // Возврат
	КонецЕсли;
	
	РегистрыСведений["упоСоответствиеСтатусовПППроцентамГотовности"].ЗаполнитьПоУмолчанию(Истина);
	
