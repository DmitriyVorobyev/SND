Процедура ИсправитьРасписаниеОтраженияТрудозатрат() Экспорт
		
	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.упоОтражениеПлановыхТрудозатратЗадач);
	Расписание = Задание.Расписание;
	
	НужноЗаписать = Ложь;
	
	Если Расписание.ПериодПовтораДней = 0 Тогда
		Расписание.ПериодПовтораДней = 1;
		НужноЗаписать = Истина;		
	КонецЕсли;
	
	Если Расписание.ПериодПовтораВТечениеДня = 0 Тогда
		Расписание.ПериодПовтораВТечениеДня = 60;
		НужноЗаписать = Истина;		
	КонецЕсли;
	
	Если НужноЗаписать Тогда
		Задание.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ИсправитьОписаниеПоказателя() Экспорт
	
	ПроцентВыплат = Справочники.упоПоказателиПроектов.НайтиПоНаименованию("% Выплат");
	Описание = НСтр("ru = 'Вычисляется как отношение фактических выплат к плановым.'");
	Если ЗначениеЗаполнено(ПроцентВыплат) И СокрЛП(ПроцентВыплат.ОписаниеПоказателя) = Описание Тогда
		ПроцентВыплат = ПроцентВыплат.ПолучитьОбъект();
		ПроцентВыплат.ОписаниеПоказателя = НСтр("ru = '% отклонения фактических выплат ДС от плановых.'");
		ПроцентВыплат.Записать();
	КонецЕсли;
	
КонецПроцедуры

