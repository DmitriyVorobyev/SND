Функция ПолучитьИменаРеквизитовДляРаспределенияСуммыЗарплатыПоФактуТрудозатрат() Экспорт

	Возврат "Сотрудник, Сумма, НаправлениеДеятельности, Проект";
	
КонецФункции	

// Устанавливает для формы отчета ПлатежныйКалендарь доступность и состояние отборов по Проекту и Проектной задаче
//  в зависимости от значения реквизита упоОтражатьДанныеПоПроекту
//
// Параметры:
//  Форма  - ФормаКлиентскогоПриложения - Форма отчета ПлатежныйКалендарь
//
Процедура УстановитьСостояниеИДоступностьОтборовИОпций(Форма) Экспорт
	
	Если НЕ ТипЗнч(Форма) = Тип("ФормаКлиентскогоПриложения") ИЛИ
		 НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект") ИЛИ
		 НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "упоОтображатьПроект") ИЛИ
	     НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "упоОтражатьДанныеПоПроекту") ИЛИ
		 НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "упоОтображатьПроектнуюЗадачу") ИЛИ
		 НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "упоОтражатьИерархиюИСтатус") Тогда
		 Возврат;
	КонецЕсли;	 
	
	// Значение и доступность опций  отображения строк "упоОтображатьПроект" и "упоОтображатьПроектнуюЗадачу" зависят от значения опции "упоОтражатьДанныеПоПроекту"
	// Если опция "упоОтражатьДанныеПоПроекту" установлена в значение "Истина" 
	// 	- автоматически устанавливаем в значение "Истина" опции "упоОтображатьПроект" и "упоОтображатьПроектнуюЗадачу"
	// 	и делаем связанные с ними элементы формы недоступными пользователю.
	Форма.Объект.упоОтображатьПроект = ?(Форма.Объект.упоОтражатьДанныеПоПроекту,
										 Истина,
										 Форма.Объект.упоОтображатьПроект);
	ЭлементупоОтображатьПроект = Форма.Элементы.Найти("упоОтображатьПроект");
	Если ЭлементупоОтображатьПроект <> Неопределено Тогда
		ЭлементупоОтображатьПроект.Доступность = НЕ Форма.Объект.упоОтражатьДанныеПоПроекту;
	КонецЕсли; 
	
	Форма.Объект.упоОтображатьПроектнуюЗадачу = ?(Форма.Объект.упоОтражатьДанныеПоПроекту,
										 		  Истина,
										 		  Форма.Объект.упоОтображатьПроектнуюЗадачу);
	ЭлементупоОтображатьПроектнуюЗадачу = Форма.Элементы.Найти("упоОтображатьПроектнуюЗадачу");
	Если ЭлементупоОтображатьПроектнуюЗадачу <> Неопределено Тогда
		ЭлементупоОтображатьПроектнуюЗадачу.Доступность = НЕ Форма.Объект.упоОтражатьДанныеПоПроекту;
	КонецЕсли;
	
	
	ЭлементупоОтражатьИерархиюИСтатус = Форма.Элементы.Найти("упоОтражатьИерархиюИСтатус");
	Если ЭлементупоОтражатьИерархиюИСтатус <> Неопределено Тогда
		ЭлементупоОтражатьИерархиюИСтатус.Доступность = Форма.Объект.упоОтражатьДанныеПоПроекту ИЛИ
														Форма.Объект.упоОтображатьПроектнуюЗадачу;
	КонецЕсли;

	Форма.Объект.упоОтражатьИерархиюИСтатус = ?(ЭлементупоОтражатьИерархиюИСтатус.Доступность,
												Форма.Объект.упоОтражатьИерархиюИСтатус,
												Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти   
	
  
