#Область ПрограммныйИнтерфейс

// Возвращает имя группы, сформированное с учетом имени табличной части
// Например, если передано имя "Расход", то метод вернет строку "упоРасходГруппаПроектнаяЗадачаПроект"
//
// Параметры:
//  ИмяТабличнойЧасти - Строка - Имя таблицы формы
//
Функция ИмяГруппыТЧПоИмениТЧ(ИмяТабличнойЧасти) Экспорт
	
	ШаблонИмени = "упо%1ГруппаПроектнаяЗадачаПроект";
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмени, ИмяТабличнойЧасти);
	Возврат Результат;

КонецФункции    

// Возвращает имя группы для скрытия элемента "Проект"
// Например, если передано имя "Расход", то метод вернет строку "упоРасходГруппаДляСкрытияПроектаУНФа"
//
// Параметры:
//  ИмяТабличнойЧасти - Строка - Имя таблицы формы
//
Функция ИмяГруппыДляСкрытия(ИмяТабличнойЧасти) Экспорт
	
	ШаблонИмени = "упо%1ГруппаДляСкрытияПроектаУНФа";
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмени, ИмяТабличнойЧасти);
	Возврат Результат;

КонецФункции    

