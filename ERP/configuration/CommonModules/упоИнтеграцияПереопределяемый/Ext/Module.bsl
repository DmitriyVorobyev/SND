Функция ПолучитьСтруктуруИменРеквизитовОбъекта(ИмяОбъекта, ИзТабличнойЧасти = Ложь)
	
	СтруктураИменРеквизитов = Новый Структура;
	СтруктураИменРеквизитов.Вставить("ДатаНач", 		"NULL");
	СтруктураИменРеквизитов.Вставить("ДатаКон", 		"NULL");
	СтруктураИменРеквизитов.Вставить("Ответственный", 	"NULL");
	СтруктураИменРеквизитов.Вставить("ВалютаДокумента", "NULL");
	СтруктураИменРеквизитов.Вставить("СуммаДокумента", 	"0");
	СтруктураИменРеквизитов.Вставить("ОбъектРасчетов", 	"НЕОПРЕДЕЛЕНО");
	
	Если ИмяОбъекта = "АктВыполненныхРабот" Тогда
		
		//СтруктураИменРеквизитов.ДатаНач 		= "Объект.Ссылка.ДатаПлатежа";
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Ссылка.Автор";     
		
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
			
			СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.ВалютаДокумента";
			
			Если ИзТабличнойЧасти Тогда
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.Сумма";
			Иначе
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";	
			КонецЕсли;	
			
		Иначе
		
			СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
			СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаСНДС";

		КонецЕсли;
	
	ИначеЕсли ИмяОбъекта = "ЗаказКлиента" Тогда
		
		СтруктураИменРеквизитов.ДатаНач 		= "Объект.ДатаОтгрузки";
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Автор";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Валюта";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";
		
	ИначеЕсли ИмяОбъекта = "ЗаказНаПроизводство" Тогда
		
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Ответственный";
		
	ИначеЕсли ИмяОбъекта = "ЗаказПокупателя" Тогда
		
		СтруктураИменРеквизитов.ДатаНач 		= "Объект.ДатаОтгрузки";
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Автор";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.ВалютаДокумента";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";	
		
	// Для заказа поставщику важен порядок следования условий
	ИначеЕсли ИмяОбъекта = "ЗаказПоставщику" И упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		
		СтруктураИменРеквизитов.ДатаНач 		= "Объект.ДатаПоступления";
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Автор";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.ВалютаДокумента";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";
		
	ИначеЕсли ИмяОбъекта = "ЗаказПоставщику" Тогда
		
		СтруктураИменРеквизитов.ДатаНач 		= "Объект.ДатаПоступления";
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Автор";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Валюта";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";  
		
	ИначеЕсли ИмяОбъекта = "ПоступлениеБезналичныхДенежныхСредств" Тогда
		
		СтруктураИменРеквизитов.ДатаНач 		= "Объект.Ссылка.ДатаВходящегоДокумента";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.Сумма";
		СтруктураИменРеквизитов.ОбъектРасчетов  = "Объект.ОбъектРасчетов.Объект";
				
	ИначеЕсли ИмяОбъекта = "ПриобретениеТоваровУслуг" Тогда
		
		//СтруктураИменРеквизитов.ДатаНач 		= "Объект.Ссылка.ДатаПлатежа";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаСНДС";
		
	ИначеЕсли ИмяОбъекта = "ПриходныйКассовыйОрдер" Тогда
		
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Ссылка.Кассир";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
		СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.Сумма";
		СтруктураИменРеквизитов.ОбъектРасчетов  = "Объект.ОбъектРасчетов.Объект";
		
	ИначеЕсли ИмяОбъекта = "РасходныйКассовыйОрдер" Тогда
		
		Если ИзТабличнойЧасти Тогда
			СтруктураИменРеквизитов.Ответственный 	= "Объект.Ссылка.Кассир";
			СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
			СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.Сумма";
			СтруктураИменРеквизитов.ОбъектРасчетов = "Объект.ЗаявкаНаРасходованиеДенежныхСредств";
		Иначе
			СтруктураИменРеквизитов.Ответственный 	= "Объект.Кассир";
			СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Валюта";
			СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";
		КонецЕсли;
		
	ИначеЕсли ИмяОбъекта = "РеализацияТоваровУслуг" Тогда
		
		//СтруктураИменРеквизитов.ДатаНач 		= "Объект.Ссылка.ДатаПлатежа";
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM_2_5() Тогда
			СтруктураИменРеквизитов.ДатаКон 		= "Объект.Ссылка.Дата";
		Иначе	
			СтруктураИменРеквизитов.ДатаКон 		= "Объект.Ссылка.ДатаРаспоряжения";
		КонецЕсли;	
		СтруктураИменРеквизитов.Ответственный 	= "Объект.Ссылка.Автор";
		СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
		СтруктураИменРеквизитов.СуммаДокумента  = "Объект.СуммаСНДС";
		
	ИначеЕсли ИмяОбъекта = "СписаниеБезналичныхДенежныхСредств" Тогда
		
		Если ИзТабличнойЧасти Тогда
			СтруктураИменРеквизитов.ДатаНач 		= "Объект.Ссылка.ДатаВходящегоДокумента";
			СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.Валюта";
			СтруктураИменРеквизитов.СуммаДокумента  = "Объект.Сумма";
			СтруктураИменРеквизитов.ОбъектРасчетов = "Объект.ОбъектРасчетов.Объект";
		Иначе     
			СтруктураИменРеквизитов.ДатаНач 		= "Объект.ДатаВходящегоДокумента";
			СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Валюта";
			СтруктураИменРеквизитов.СуммаДокумента  = "Объект.СуммаДокумента";
		КонецЕсли;
		
	ИначеЕсли ИмяОбъекта = "ПоступлениеВКассу" ИЛИ
		ИмяОбъекта = "ПоступлениеНаСчет" ИЛИ
		ИмяОбъекта = "РасходИзКассы" ИЛИ 
		ИмяОбъекта = "РасходСоСчета" Тогда
		
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
			
			Если ИзТабличнойЧасти Тогда
				СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.ВалютаДенежныхСредств";
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаПлатежа";	
			Иначе
				СтруктураИменРеквизитов.ВалютаДокумента = "Объект.ВалютаДенежныхСредств";
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";	
			КонецЕсли;
			
		КонецЕсли;	
		
	ИначеЕсли ИмяОбъекта = "РасходнаяНакладная"
		ИЛИ ИмяОбъекта = "ПриходнаяНакладная" Тогда
	
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
			
			Если ИзТабличнойЧасти Тогда
				СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.ВалютаДокумента";
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.Сумма";	
			Иначе
				СтруктураИменРеквизитов.ВалютаДокумента = "Объект.ВалютаДокумента";
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";	
			КонецЕсли;
			
		КонецЕсли;		
		
	ИначеЕсли ИмяОбъекта = "СчетФактураПолученный" Тогда
	
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
			
			Если ИзТабличнойЧасти Тогда
				СтруктураИменРеквизитов.ВалютаДокумента = "Объект.Ссылка.ВалютаДокумента";
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.Ссылка.СуммаДокумента";	
			Иначе
				СтруктураИменРеквизитов.ВалютаДокумента = "Объект.ВалютаДокумента";
				СтруктураИменРеквизитов.СуммаДокумента 	= "Объект.СуммаДокумента";	
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;
	
	Возврат СтруктураИменРеквизитов;
		
КонецФункции

Функция СформироватьШаблонЗапросаСвязанныхДокументов(ИспользоватьТабличнуюЧасть, ТолькоПроведенные)
	
	СтруктураУсловий = ПолучитьСтруктуруДинамическихУсловийЗапроса(ИспользоватьТабличнуюЧасть, ТолькоПроведенные);
	
	МассивТекстаЗапроса = Новый Массив;
	МассивТекстаЗапроса.Добавить("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Объект.Ссылка КАК ДокументЗаказ,
		|	%2 КАК ОбъектРасчетов,
		|	%4 КАК Проект,
		|	%5 КАК ДатаНач,
		|	%6 КАК ДатаКон,
		|	%7 КАК Ответственный,
		|	%8 КАК ВалютаДокумента,
		|	СУММА(%9) КАК СуммаДокумента,
		|   0 КАК СуммаДоход,
		|   0 КАК СуммаРасход 
		|ПОМЕСТИТЬ %1%3
		|ИЗ
		|	Документ.%1");
	МассивТекстаЗапроса.Добавить(СтруктураУсловий.ПутьКТабличнойЧасти);
	МассивТекстаЗапроса.Добавить("%3 КАК Объект
		|ГДЕ
		|	Объект.%4 В(&СписокПроектныхЗадач)
		|	");
	МассивТекстаЗапроса.Добавить(СтруктураУсловий.УсловиеПроведения);
	МассивТекстаЗапроса.Добавить("
		|	
		|СГРУППИРОВАТЬ ПО
		|	Объект.Ссылка,
		|	%2,
		|	Объект.%4");
	ШаблонЗапроса = СтрСоединить(МассивТекстаЗапроса);
	
	Возврат ШаблонЗапроса;
	
КонецФункции

Функция ПолучитьСтруктуруДинамическихУсловийЗапроса(ИспользоватьТабличнуюЧасть, ТолькоПроведенные)
	
	СтруктураУсловий = Новый Структура("ПутьКТабличнойЧасти, УсловиеПроведения", "", "");
	
	СтруктураУсловий.ПутьКТабличнойЧасти = ?(ИспользоватьТабличнуюЧасть, ".", "");
	
	Если ТолькоПроведенные Тогда
		СтруктураУсловий.УсловиеПроведения = ?(ИспользоватьТабличнуюЧасть, "И Объект.Ссылка.Проведен", "И Объект.Проведен");
	КонецЕсли;
	
	Возврат СтруктураУсловий;
	
КонецФункции

#КонецОбласти

