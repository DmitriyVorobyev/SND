Процедура СформироватьЗапросыСвязанныхДокументов(МассивИменСвязанныхОбъектов, МассивТаблицВыборки,
		МассивТекстов, ТолькоПроведенные) Экспорт
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Проекты"));
	ОписаниеТиповПроект = Новый ОписаниеТипов(МассивТипов);
	
	Для Каждого ЭлементСостава Из Метаданные.КритерииОтбора.СвязанныеДокументы.Состав Цикл
		ПолноеИмяЭлементаСостава = ЭлементСостава.ПолноеИмя();
		ЭтоДокументСчетФактура = Ложь;
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
			ЭтоДокументСчетФактура = СтрНачинаетсяС(ПолноеИмяЭлементаСостава, "Документ.СчетФактура");
		КонецЕсли;	
						
		Если ЭлементСостава.Тип = ОписаниеТиповПроект 
			ИЛИ ЭтоДокументСчетФактура Тогда
			СтруктураПутьКДанным = упоФункцииОбщегоНазначенияСервер.РазобратьПутьКОбъектуМетаданных(ЭлементСостава.ПолноеИмя());
			ИспользоватьДанныеТабличнойЧасти = ЗначениеЗаполнено(СтруктураПутьКДанным.ИмяТаблЧасти);
			СтруктураИменРеквизитов = ПолучитьСтруктуруИменРеквизитовОбъекта(СтруктураПутьКДанным.ВидОбъекта,
					ИспользоватьДанныеТабличнойЧасти);
			МассивИменСвязанныхОбъектов.Добавить(СтруктураПутьКДанным.ВидОбъекта);
			ИспользоватьТабличнуюЧасть = СтруктураПутьКДанным.ПутьКДанным = "ТабличнаяЧасть";
			ШаблонЗапроса = СформироватьШаблонЗапросаСвязанныхДокументов(ИспользоватьТабличнуюЧасть, ТолькоПроведенные);
			МассивИмениТаблицыВыборки = Новый Массив;
			МассивИмениТаблицыВыборки.Добавить(СтруктураПутьКДанным.ВидОбъекта);
			Если ИспользоватьДанныеТабличнойЧасти Тогда
				МассивИмениТаблицыВыборки.Добавить(СтруктураПутьКДанным.ИмяТаблЧасти);
			КонецЕсли;
			
			ИмяТаблицыВыборки = СтрСоединить(МассивИмениТаблицыВыборки);
			
			Если МассивТаблицВыборки.Найти(ИмяТаблицыВыборки) = Неопределено Тогда
				ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса,
						СтруктураПутьКДанным.ВидОбъекта,
						СтруктураИменРеквизитов.ОбъектРасчетов,
						СтруктураПутьКДанным.ИмяТаблЧасти,
						СтруктураПутьКДанным.ИмяРеквизита,
						СтруктураИменРеквизитов.ДатаНач,
						СтруктураИменРеквизитов.ДатаКон,
						СтруктураИменРеквизитов.Ответственный,
						СтруктураИменРеквизитов.ВалютаДокумента,
						СтруктураИменРеквизитов.СуммаДокумента);
				МассивТекстов.Добавить(ТекстЗапроса);
				МассивТаблицВыборки.Добавить(ИмяТаблицыВыборки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

