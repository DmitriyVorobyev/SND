#Область ПрограммныйИнтерфейс

// Заменяет значение года в заданной дате на новое.
//
// Параметры:
//  СтараяДата			 - Дата	 - Дата, год которой подлежит замене.
//  НовоеЗначениеГода	 - Число - Год, на который изменяется значение даты
// 
// Возвращаемое значение:
//  Дата - полученная даты с новым значением года.
//
Функция ПолучитьДатуСНовымЗначениеГода(СтараяДата, НовоеЗначениеГода) Экспорт

	РазницаГодов = НовоеЗначениеГода - Год(СтараяДата);
	Возврат ДобавитьМесяц(СтараяДата, РазницаГодов * 12);

КонецФункции

// Функция проверяет количество часов в сутках на корректность
//  и в случае неверного значения ограничевает пользователя правильным диапазоном.
//
// Параметры:
//  КоличествоЧасов	 - Число - заданное пользователем количество часов в сутках.
// 
// Возвращаемое значение:
//  Число - откорректированное количество часов в сутках.
//
Функция КонтролироватьКоличествоЧасовВСутках(Знач КоличествоЧасов) Экспорт

	// Ограничем пользователя правильным количеством часов в сутках.
	Если КоличествоЧасов > 24 Тогда // перебор
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Введены некорректные данные! Количество часов не может быть больше 24.";
		Сообщение.Сообщить();
		Возврат 24;
	ИначеЕсли КоличествоЧасов < 0 Тогда // недобор
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Введены некорректные данные! Количество часов не может быть меньше 0.";
		Сообщение.Сообщить();
		Возврат 0;
	Иначе // все хорошо
		Возврат КоличествоЧасов;
	КонецЕсли;

КонецФункции

// Вызывает оптимизацию календаря и обновляет повторно используемые значения.
//
// Параметры:
//  Календарь	 - СправочникСсылка.упоРабочиеКалендари
// 
// Возвращаемое значение:
//  Булево - проверка необходимости расчета смещений.
//
Функция РассчитатьСмещенияДляКалендаряСПроверкойОбновитьПовторноИспользуемыеЗначения(Календарь) Экспорт
	
	НуженРасчетСдвигов = упоРабочиеКалендариВызовСервера.РассчитатьСмещенияДляКалендаряСПроверкой(Календарь);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат НуженРасчетСдвигов;
	
КонецФункции

#КонецОбласти
