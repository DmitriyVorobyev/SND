// Общие действия обработчика события ОбработкаПроведения модуля документа.
// Возникает при проведении документа.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект - содержит сам объект.
//  Отказ        - Булево - признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента - в данный параметр передается текущий режим проведения.
// 
Процедура обДокументОбъектОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения) Экспорт
	
	Заголовок = обСформироватьЗаголовокОшибкиПриПроведении(ЭтотОбъект);
	
	Если НЕ	(ЭтотОбъект.ДополнительныеСвойства.Свойство("НеПроверятьРазграничениеДоступа")
		И ЭтотОбъект.ДополнительныеСвойства.НеПроверятьРазграничениеДоступа)
		И Не (ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтложенноеПроведение")) Тогда 
		// Вызываем общую процедуру проверки
		упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(ЭтотОбъект, 
																			РежимЗаписиДокумента.Проведение, 
																			Отказ, 
																			Заголовок, 
																			Истина);
	КонецЕсли;
	
	Если Не (ЭтотОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый") И ЭтотОбъект.ДополнительныеСвойства.ЭтоНовый) Тогда
		упоПроведениеДокументовВызовСервера.обУдалитьДвиженияДокумента(Отказ, ЭтотОбъект);
	КонецЕсли;
			
	ПроверитьДокументНаОтмененныеПЗ(ЭтотОбъект, Отказ);
	
	// Получаем полный слепок документа
	ДанныеДокумента = упоПроведениеДокументовВызовСервера.обПолучитьДанныеДокумента(ЭтотОбъект);
		
	// Вызываем общую процедуру проверки
	упоПроведениеДокументовВызовСервера.обПроверитьДанныеДокумента(ЭтотОбъект, ДанныеДокумента, Отказ, РежимПроведения, Заголовок);
	
	// Вызываем универсальный генератор движений по регистрам
	упоПроведениеДокументовВызовСервера.обПровестиДокументПоРегистрам(ЭтотОбъект, ДанныеДокумента, Отказ, РежимПроведения);
		
КонецПроцедуры

// Общие действия обработчика события ОбработкаУдаленияПроведения модуля документа.
// Возникает при отмене проведения документа.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект - содержит сам объект.
//  Отказ        - Булево - признак отмены проведения документа.
// 
Процедура обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ) Экспорт
	
	Представление = СокрЛП(ЭтотОбъект.Ссылка);	
	Заголовок = НСтр("ru = 'Операция отмены проведения документа ""%1"" не выполнена:'");
	Заголовок = СтрЗаменить(Заголовок, "%1", Представление); 	
		
	Если НЕ	(ЭтотОбъект.ДополнительныеСвойства.Свойство("НеПроверятьРазграничениеДоступа")
		И ЭтотОбъект.ДополнительныеСвойства.НеПроверятьРазграничениеДоступа) Тогда 
		// Вызываем общую процедуру проверки.
		упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(ЭтотОбъект, РежимЗаписиДокумента.ОтменаПроведения, Отказ, Заголовок, Истина);
	КонецЕсли;
		
	упоПроведениеДокументовВызовСервера.обУдалитьДвиженияДокумента(Отказ, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

