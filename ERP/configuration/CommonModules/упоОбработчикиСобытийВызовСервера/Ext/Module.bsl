// Обновить пометку удаления у основного проекта программы или портфеля.
//
Процедура СинхронизироватьПометкуУдаления(ПометкаУдаления, ПроектСтруктуры)
	
	Если ПометкаУдаления <> ПроектСтруктуры.ПометкаУдаления Тогда
		ПроектСтруктурыОбъект = ПроектСтруктуры.ПолучитьОбъект();
		ПроектСтруктурыОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьОтмененныеПЗПриКопировании(ЭтотОбъект)
			
	Отбор = Новый Структура("ПроектнаяЗадачаЗеркало");
	
	ОтмененныеПЗ = НайтиОтмененныеПЗ(ЭтотОбъект.Данные.ВыгрузитьКолонку("ПроектнаяЗадачаЗеркало"));
	Для Каждого ОтмененнаяПЗ Из ОтмененныеПЗ Цикл	
		
		Отбор.ПроектнаяЗадачаЗеркало = ОтмененнаяПЗ;
		НайденныеСтроки = ЭтотОбъект.Данные.НайтиСтроки(Отбор);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ЭтотОбъект.Данные.Удалить(НайденнаяСтрока);	
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиОтмененныеПЗ(ПроектныеЗадачи)
	
	ОтмененныеПЗ = Новый Массив;
		
	Если Не ПроектныеЗадачи.Количество() Тогда
		Возврат ОтмененныеПЗ;
	КонецЕсли;	
		
	ЭтоЗеркала = ТипЗнч(ПроектныеЗадачи[0]) = Тип("СправочникСсылка.Проекты");
	
	Если ЭтоЗеркала Тогда
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Проекты.Ссылка КАК ПроектнаяЗадача
		               |ИЗ
		               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		               |			,
		               |			ПроектнаяЗадача В
		               |				(ВЫБРАТЬ
		               |					Проекты.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
		               |				ИЗ
		               |					Справочник.Проекты КАК Проекты
		               |				ГДЕ
		               |					Проекты.Ссылка В (&ПроектныеЗадачи))) КАК упоСвойстваПроектныхЗадачСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		               |			И (упоВерсииПроекта.Текущая)
		               |			И (упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
		               |ИЗ
		               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		               |			И (упоВерсииПроекта.Текущая)
		               |			И (упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ПроектныеЗадачи);
	
	Результат = Запрос.Выполнить();	
	Если Не Результат.Пустой() Тогда
		ОтмененныеПЗ = Результат.Выгрузить().ВыгрузитьКолонку("ПроектнаяЗадача");
	КонецЕсли;	
	
	Возврат ОтмененныеПЗ;
	
КонецФункции	

Процедура ПроверитьДокументНаОтмененныеПЗ(ЭтотОбъект, Отказ) Экспорт
	
	Если ТипЗнч(ЭтотОбъект.Ссылка) = Тип("ДокументСсылка.упоПрогнозТрудозатратПоРолям") 
		Или ТипЗнч(ЭтотОбъект.Ссылка) = Тип("ДокументСсылка.упоПланированиеТрудозатратПоТрудовымРесурсам") Тогда 
		
		ПроектныеЗадачи = ЭтотОбъект.Данные.ВыгрузитьКолонку("ПроектнаяЗадачаЗеркало");
		
	Иначе
		Возврат;
	КонецЕсли;
		
	ОтмененныеПЗ = НайтиОтмененныеПЗ(ПроектныеЗадачи);

	Если Не ОтмененныеПЗ.Количество() Тогда
		Возврат;
	КонецЕсли;	
	
	ЭтоЗеркала = ТипЗнч(ОтмененныеПЗ[0]) = Тип("СправочникСсылка.Проекты");
	
	ШаблонСообщения = НСтр("ru = 'Проектная задача ""%1"" (%2) отменена.'");
	ТекстыОшибок = Новый Массив;
	
	Для Каждого ОтмененнаяПЗ Из ОтмененныеПЗ Цикл
		
		СвязанныйЭлемент = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(ОтмененнаяПЗ);		
		Если ЭтоЗеркала Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
				ОтмененнаяПЗ, СвязанныйЭлемент);
		Иначе
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
				СвязанныйЭлемент, ОтмененнаяПЗ);
		КонецЕсли;					
		ТекстыОшибок.Добавить(ТекстСообщения);		
			
	КонецЦикла;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(ТекстыОшибок, Символы.ПС),,,, Отказ);
	
КонецПроцедуры	

Процедура ОбновитьСтатусыПроектнойПродукцииПриИзмененииСтатусаЗаданий(ЭтотОбъект)
	
	Если Не упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтотОбъект) Тогда
		Задания = ЭтотОбъект.ВыгрузитьКолонку("Задание");
		МодульупоПроектнаяПродукция = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукция");
		МодульупоПроектнаяПродукция.ОбновитьСтатусыПроектнойПродукцииПриИзмененииСтатусаЗаданий(Задания);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

