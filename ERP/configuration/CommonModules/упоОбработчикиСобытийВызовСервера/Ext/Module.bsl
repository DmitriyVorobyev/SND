// Общие действия обработчика события ПередЗаписью модуля справочника.
// Возникает перед выполнением записи элемента справочника.
// Процедура-обработчик вызывается после начала транзакции записи, но до начала записи элемента справочника.
// 
// Параметры: 
//  ЭтотОбъект   - СправочникОбъект - содержит сам объект.
//  Отказ        - Булево - признак отказа от записи элемента.
// 
Процедура обСправочникОбъектПередЗаписью(ЭтотОбъект, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъектМетаданные = ЭтотОбъект.Метаданные();
	ИмяМетаданных = ЭтотОбъектМетаданные.Имя;
	
	Если ЭтотОбъектМетаданные.Реквизиты.Найти("АвторИзменений") <> Неопределено Тогда
		Если ЭтотОбъект.ЭтоНовый() Тогда
			ЭтотОбъект.Автор = Пользователи.ТекущийПользователь();
		КонецЕсли;
		
		ЭтотОбъект.АвторИзменений = Пользователи.ТекущийПользователь();
		ЭтотОбъект.ДатаМодификации = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ИмяМетаданных = "упоПортфелиПроектов" ИЛИ ИмяМетаданных = "упоПрограммыПроектов" Тогда 
		
		ЭтоPM_Проф = упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф();
		
		Если НЕ ЭтотОбъект.ЭтоГруппа И Не ЭтоPM_Проф Тогда
			
			Если Не ЗначениеЗаполнено(ЭтотОбъект.ПроектСтруктуры) Тогда
				
				ЭтотОбъект.ДополнительныеСвойства.Вставить("НужноСоздатьЗеркальныйПроект");
				
				Если ЭтотОбъект.ЭтоНовый() Тогда
					СсылкаНаПортфельПрограмму = ЭтотОбъект.ПолучитьСсылкуНового();
					Если СсылкаНаПортфельПрограмму.Пустая() Тогда
						// Если ссылка установлена ранее, то она будет битая, но не пустая.
						// Если ссылка не была установлена - она будет пустая.
						СсылкаНаПортфельПрограмму = Справочники[ИмяМетаданных].ПолучитьСсылку();
						ЭтотОбъект.УстановитьСсылкуНового(СсылкаНаПортфельПрограмму);
					КонецЕсли;
				Иначе
					СсылкаНаПортфельПрограмму = ЭтотОбъект.Ссылка;
				КонецЕсли;
				
				УстановитьПривилегированныйРежим(Истина);
				НовыйПроект = Справочники.Проекты.СоздатьЭлемент();
				НовыйПроект.Наименование = ЭтотОбъект.Наименование;
				НовыйПроект.Заполнить(СсылкаНаПортфельПрограмму);
				НовыйПроект.Записать();
				УстановитьПривилегированныйРежим(Ложь);
				
				ЭтотОбъект.ПроектСтруктуры = НовыйПроект.Ссылка;
				
			ИначеЕсли НЕ ЭтотОбъект.ЭтоНовый() Тогда
				
				СинхронизироватьПометкуУдаления(ЭтотОбъект.ПометкаУдаления, ЭтотОбъект.ПроектСтруктуры);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

