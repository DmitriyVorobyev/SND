	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия В (&СписокВерсий)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПодчиненныеПроекты КАК ВТ_ПодчиненныеПроекты
	               |			ПО упоВерсииПроекта.Проект = ВТ_ПодчиненныеПроекты.ПодчиненныйПроект
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	               |ГДЕ
	               |	НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
	               |	И Проекты.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ВТ_ПодчиненныеПроекты.ПодчиненнаяПроектнаяЗадача КАК ПодчиненнаяПроектнаяЗадача
	               |			ИЗ
	               |				ВТ_ПодчиненныеПроекты КАК ВТ_ПодчиненныеПроекты
	               |			ГДЕ
	               |				ВТ_ПодчиненныеПроекты.ПодчиненнаяПроектнаяЗадача = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка))
	               |	И ВТ_ПодчиненныеПроекты.ПодчиненнаяПроектнаяЗадача = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗадачиПодчиненных.ПроектнаяЗадача КАК Регистратор,
	               |	ВТ_ЗадачиПодчиненных.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	&ВерсияКорневогоПроекта КАК Версия,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Валюта КАК Валюта,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Контрагент КАК Контрагент,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Договор КАК Договор,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.СтатьяДДС КАК СтатьяДДС,
	               |	&НаправлениеДвижения КАК НаправлениеДвижения,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ВидПлатежа КАК ВидПлатежа,
	               |	ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДДС.НаДату) КАК СпособПривязки,
	               |	NULL КАК Задержка,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ДатаДвижения КАК ДатаПривязки,
	               |	СУММА(упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.СуммаВалютная) КАК СуммаВалютная
	               |ИЗ
	               |	ВТ_ЗадачиПодчиненных КАК ВТ_ЗадачиПодчиненных
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(, НаправлениеДвижения = &НаправлениеДвижения) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних
	               |		ПО ВТ_ЗадачиПодчиненных.ПроектнаяЗадачаПодчиненная = упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ПроектнаяЗадача
	               |			И ВТ_ЗадачиПодчиненных.Версия = упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Версия
	               |ГДЕ
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.СуммаВалютная > 0
				   |	И упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ДатаДвижения >= &ДатаСтартаПроекта
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ЗадачиПодчиненных.ПроектнаяЗадача,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Валюта,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Контрагент,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Договор,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.СтатьяДДС,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ВидПлатежа,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ДатаДвижения,
	               |	ВТ_ЗадачиПодчиненных.ПроектнаяЗадача";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область АктуализацияСроков

Процедура АктуализироватьСрокиИПроцентГотовностиЗадач(КорневойПроект,
		ДокументСохранения,
		ДанныеАктуализации,
		СвойстваПроектныхЗадачСоответствие,
		ЭтоАктуализацияПоРЦК = Ложь)
	
	ДокументСохранения.ПерезаписатьПроцентГотовности = Истина;
	ДокументСохранения.ПерезаписатьСрокиПроекта = Истина;
	
	Для каждого СтрокаДанных Из ДанныеАктуализации Цикл
		
		СтрокаПЗ = ДокументСохранения.ПроектныеЗадачи.Найти(СтрокаДанных.ПроектнаяЗадача);
		Если Не ЗначениеЗаполнено(СтрокаПЗ) Тогда
			СвойстваПроектнойЗадачи = СвойстваПроектныхЗадачСоответствие[СтрокаДанных.ПроектнаяЗадача];
			СтрокаПЗ = ДокументСохранения.ПроектныеЗадачи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПЗ, СвойстваПроектнойЗадачи);
		КонецЕсли;
		
		СтрокаПЗ.РучнойВводСроков = Истина;
		
		// Сроки и проценты готовности.
		СтрокаСроки = ДокументСохранения.Сроки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСроки, СтрокаДанных);
		
		Если Не ЭтоАктуализацияПоРЦК Тогда
			СтрокаСрокиФакт = ДокументСохранения.ФактическиеСроки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСрокиФакт, СтрокаДанных);
			
			СтрокаГотовность = ДокументСохранения.ПроцентыГотовности.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаГотовность, СтрокаДанных);
		КонецЕсли;
		
		// Расчет длительности.
		РабочийКалендарьПрограммы = упоПроектыИЗадачиСервер.ПолучитьКалендарьПроекта(КорневойПроект);
		КалендарьЗадачи = ?(ЗначениеЗаполнено(СтрокаПЗ.КалендарьЗадачи), СтрокаПЗ.КалендарьЗадачи,
				РабочийКалендарьПрограммы);
		
		МаксимальнаяДатаЗавершения = упоРасчетКалендарныхСроковРедакция3Сервер.КалендарныйКонецДня(
				НачалоДня(СтрокаДанных.ДатаЗавершенияПлан), , КалендарьЗадачи, Неопределено, Неопределено);
		
		Если МаксимальнаяДатаЗавершения < СтрокаДанных.ДатаЗавершенияПлан Тогда
			СтрокаДанных.ДатаЗавершенияПлан = МаксимальнаяДатаЗавершения;
		КонецЕсли;
		
		// Для вехи не заполняется длительность и единица времени.
		Если СтрокаПЗ.ЭтоВеха Тогда
			СтрокаСроки.ДатаНачалаПлан = СтрокаСроки.ДатаЗавершенияПлан;
		Иначе
			СтрокаПЗ.ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.РабочийДень;
			
			СтрокаПЗ.ДлительностьМоделиПакетаРабот = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность(
					СтрокаДанных.ДатаНачалаПлан,
					СтрокаДанных.ДатаЗавершенияПлан,
					СтрокаПЗ.ЕдиницаНормированияДлительности,
					СтрокаПЗ.КалендарьЗадачи,
					РабочийКалендарьПрограммы,
					0);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеСроковИГотовностиПоПодчиненным(Проект,
		ДатаСтартаПроекта,
		СписокЗадач = Неопределено,
		Версия = Неопределено,
		ВерсииПодчиненных = Неопределено)
	
	Если Версия = Неопределено Тогда
		Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", Версия);
	Если СписокЗадач = Неопределено Тогда
		Запрос.УстановитьПараметр("ВсеЗадачи", Истина);
		Запрос.УстановитьПараметр("МассивЗадач", Новый Массив);
	Иначе
		Запрос.УстановитьПараметр("ВсеЗадачи", Ложь);
		Запрос.УстановитьПараметр("МассивЗадач", СписокЗадач);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапросаДанныеПоСрокамПодчиненных();
	Если ВерсииПодчиненных = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВерсиям", "И упоВерсииПроекта.Текущая");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВерсиям", "И упоВерсииПроекта.Версия В (&ВерсииПодчиненных)");
		Запрос.УстановитьПараметр("ВерсииПодчиненных", ВерсииПодчиненных);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	МассивСроков = Новый Массив;
	
	Для Каждого СтрокаПЗ Из РезультатЗапроса Цикл
		СтруктураСроков = Новый Структура;
		СтруктураСроков.Вставить("ПроектнаяЗадача", СтрокаПЗ.ПроектнаяЗадача);
		СтруктураСроков.Вставить("ДатаНачалаПлан", СтрокаПЗ.НачалоПроекта);
		СтруктураСроков.Вставить("ДатаЗавершенияПлан", СтрокаПЗ.ЗавершениеПроекта);
		СтруктураСроков.Вставить("ПроцентГотовности", СтрокаПЗ.ПроцентГотовности);
		СтруктураСроков.Вставить("ДатаНачала", СтрокаПЗ.ДатаНачалаФакт);
		СтруктураСроков.Вставить("ДатаЗавершения", СтрокаПЗ.ДатаЗавершенияФакт);
		МассивСроков.Добавить(СтруктураСроков);
	КонецЦикла;
	
	Возврат МассивСроков;
	
КонецФункции

Функция ДанныеСроковПроектныхЗадачПоРЦК(СписокЗадачПоРЦК, СписокДокументовРЦК)
	
	СрокиДокументовРЦК = Новый Соответствие;
	ДанныеСроковПроектныхЗадачПоРЦК = Новый Массив;
	Для каждого ПроектнаяЗадача Из СписокЗадачПоРЦК Цикл
		ДокументРЦК = СписокДокументовРЦК.Получить(ПроектнаяЗадача);
		
		Если Не ЗначениеЗаполнено(ДокументРЦК) Тогда
			Продолжить;
		КонецЕсли;
		
		СрокиДокументаРЦК = СрокиДокументовРЦК.Получить(ДокументРЦК);
		Если СрокиДокументаРЦК = Неопределено Тогда
			СрокиДокументаРЦК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРЦК, "ДатаНачалаРаботПлан, ДатаОкончанияРаботПлан");
			СрокиДокументовРЦК.Вставить(ДокументРЦК, СрокиДокументаРЦК);
		КонецЕсли;
		
		СтруктураДанных = Новый Структура("ПроектнаяЗадача, ДатаНачалаПлан, ДатаЗавершенияПлан", ПроектнаяЗадача,
				СрокиДокументаРЦК.ДатаНачалаРаботПлан, СрокиДокументаРЦК.ДатаОкончанияРаботПлан);
		ДанныеСроковПроектныхЗадачПоРЦК.Добавить(СтруктураДанных);
	КонецЦикла;
	
	Возврат ДанныеСроковПроектныхЗадачПоРЦК;
	
КонецФункции

#КонецОбласти

#Область АктуализацияСтруктурыПоПодчиненнымПроектам

Функция ПолучитьДанныеПоАктируемымЭтапамПодчиненнойЗадачи(Проект, ДатаСтартаПроекта, ПЗПроекта, ДопПараметры)
	
	АктуализироватьПланВыпускаПоДоходам = ДопПараметры.АктуализироватьПланВыпускаПоДоходам;
	ПустаяПроектнаяЗадача = ДопПараметры.ПустаяПроектнаяЗадача;
	СписокВерсий = ДопПараметры.СписокВерсий;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроектныеЗадачиПроектаДоходы();
	
	Если СписокВерсий = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВерсиям", "И упоВерсииПроекта.Текущая");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоВерсиям", "И упоВерсииПроекта.Версия В (&СписокВерсий)");
		Запрос.УстановитьПараметр("СписокВерсий", СписокВерсий);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеПоПроекту = РезультатЗапроса.Выгрузить();
	
	ДанныеПоПроекту.Индексы.Добавить("ЗадачаРодитель");
	
	ДанныеПоАктируемымЭтапам = Новый ТаблицаЗначений;
	ДанныеПоАктируемымЭтапам.Колонки.Добавить("АктируемыйЭтап", Новый ОписаниеТипов("ДокументСсылка.упоПроектнаяЗадача"));
	ДанныеПоАктируемымЭтапам.Колонки.Добавить("БылАктируемыйЭтап", Новый ОписаниеТипов("Булево"));
	ДанныеПоАктируемымЭтапам.Колонки.Добавить("ПроектнаяЗадача",
		Новый ОписаниеТипов("ДокументСсылка.упоПроектнаяЗадача"));
	
	Если ПЗПроекта = Неопределено Тогда
		ЗаполнитьДанныеПоАктируемымЭтапамРекурсивно(ПустаяПроектнаяЗадача, ДанныеПоПроекту, ДанныеПоАктируемымЭтапам, Ложь,
			Неопределено);
	Иначе
		Строка = ДанныеПоАктируемымЭтапам.Добавить();
		Строка.АктируемыйЭтап = ПЗПроекта;
		Строка.БылАктируемыйЭтап = Истина;
		Строка.ПроектнаяЗадача = ПЗПроекта;
		ЗаполнитьДанныеПоАктируемымЭтапамРекурсивно(ПЗПроекта, ДанныеПоПроекту, ДанныеПоАктируемымЭтапам, Истина,
			ПЗПроекта);
	КонецЕсли;
	
	ВерсияПроектаПЗ = Неопределено;
	Если ДанныеПоПроекту.Количество() <> 0 Тогда
		ВерсияПроектаПЗ = ДанныеПоПроекту[0].Версия;
	КонецЕсли;
	
	Данные = ПолучитьДанныеПоЗадачамАктируемыхЭтапов(ДанныеПоАктируемымЭтапам, ДатаСтартаПроекта, ВерсияПроектаПЗ,
			АктуализироватьПланВыпускаПоДоходам);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанныеПоЗадачамАктируемыхЭтапов(ДанныеПоАктируемымЭтапам, ДатаСтартаПроекта, ВерсияПроектаПЗ,
		АктуализироватьПланВыпускаПоДоходам)
	
	ДанныеПоАктирЭтапам = Новый ТаблицаЗначений;
	ДанныеПоАктирЭтапам.Колонки.Добавить("АктируемыйЭтап");
	ДанныеПоАктирЭтапам.Колонки.Добавить("ДанныеАктируемогоЭтапа");
	Если ДанныеПоАктируемымЭтапам.Количество() = 0 Тогда
		Возврат ДанныеПоАктирЭтапам;
	КонецЕсли;
	
	ПЗДляАктуальныхПланов = ПолучитьПроектныеЗадачиДляАктуальныхПланов(ДанныеПоАктируемымЭтапам);
	ПЗДляДанныхПланов = ПолучитьПроектныеЗадачиДляДанныхПланов(ДанныеПоАктируемымЭтапам);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДоходовДляАктуализацииСтруктурыПоПодчиненным();
	
	ИсточникПлана = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы");
	
	ВерсияМассив = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВерсияПроектаПЗ);
	Запрос.УстановитьПараметр("Версии", ВерсияМассив);
	Запрос.УстановитьПараметр("ПроектныеЗадачиАктПланы", ПЗДляАктуальныхПланов);
	Запрос.УстановитьПараметр("ПроектныеЗадачиДанныеПланы", ПЗДляДанныхПланов);
	Запрос.УстановитьПараметр("ДанныеПоАктируемымЭтапам", ДанныеПоАктируемымЭтапам);
	Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
	Запрос.УстановитьПараметр("ИсточникПлана", ИсточникПлана);
	
	Если АктуализироватьПланВыпускаПоДоходам Тогда
		Запрос.УстановитьПараметр("ОтделитьСубпродукты", Истина);
		Запрос.УстановитьПараметр("ИсточникПланаОбъемы", Перечисления.упоИсточникПланаДоходовИРасходов.Объемы);
	Иначе
		Запрос.УстановитьПараметр("ОтделитьСубпродукты", Ложь);
		Запрос.УстановитьПараметр("ИсточникПланаОбъемы", Неопределено);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	КоличествоЗапросов = РезультатЗапроса.ВГраница();
	РаспределениеПоПодразделениям = РезультатЗапроса[КоличествоЗапросов].Выгрузить();
	ДоходыРасходы = РезультатЗапроса[КоличествоЗапросов - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ЗаполнитьДанныеПоАктируемымЭтапамПоПолученнымТаблицам(ДанныеПоАктирЭтапам,
		ДоходыРасходы, РаспределениеПоПодразделениям);
	
	Возврат ДанныеПоАктирЭтапам;
	
КонецФункции

Процедура АктуализироватьДоходыСтруктурыПоПодчиненнымПроектам(ВерсияПроекта, ДокументСохранения, АктуализироватьПланВыпускаПоДоходам,
		СлужебныеКоллекции)
	
	СписокЗадач = Неопределено;
	СписокВерсий = Неопределено;
	
	СлужебныеКоллекции.Свойство("СписокЗадач", СписокЗадач);
	СлужебныеКоллекции.Свойство("СписокВерсий", СписокВерсий);
	
	ДокументСохранения.ПерезаписатьПланДоходов = Истина;
	
	Если СписокЗадач = Неопределено Тогда
		СтрокаЗамены = "ИСТИНА";
	Иначе
		СтрокаЗамены = "ПроектнаяЗадача В (&СписокЗадач)";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапросаПолученияПодчиненныхЗадачДоходы();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборЗадач", СтрокаЗамены);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Версия", ВерсияПроекта);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	ПустаяСсылкаПроекта =
		ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Проекты.ПустаяСсылка");
	Запрос.УстановитьПараметр("ПустаяСсылкаПроекта", ПустаяСсылкаПроекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПодчиненныхЗадач = РезультатЗапроса.Выбрать();
	
	ДопДанные = ПолучитьДопДанныеДляСозданияПЗ(ВерсияПроекта.Проект, ВерсияПроекта);
	ДатаСтартаПроекта = ДопДанные.ДатаСтартаПроекта;
	
	ПустаяПроектнаяЗадача = ОбщегоНазначения.ПредопределенныйЭлемент("Документ.упоПроектнаяЗадача.ПустаяСсылка");
	ТипЗадачиЭтап = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипПроектнойЗадачи.Этап");
	Пока ВыборкаПодчиненныхЗадач.Следующий() Цикл
		
		ПроектнаяЗадача = ВыборкаПодчиненныхЗадач.ПроектнаяЗадача;
		ОбновленныеПЗ = ДопДанные.ОбновленныеПЗ;
		Если ОбновленныеПЗ[ПроектнаяЗадача] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// TODO Вынести получение сроков и отбор по ним в запрос ПолучитьТекстЗапросаПолученияПодчиненныхЗадач
		СрокиПодчиненногоПроекта =
			упоПроектыИЗадачиСервер.ПолучитьПланируемыеСрокиПроекта(ВыборкаПодчиненныхЗадач.ПодчиненныйПроект);
		
		Если СрокиПодчиненногоПроекта.ДатаЗавершенияПлан < ДатаСтартаПроекта Тогда
			Продолжить;
		КонецЕсли;
		
		ПЗПодчиненногоПроекта = Неопределено;
		Если ВыборкаПодчиненныхЗадач.ПодчиненнаяПроектнаяЗадача <> ПустаяСсылкаПроекта Тогда
			ПЗПодчиненногоПроекта = ВыборкаПодчиненныхЗадач.ПодчиненнаяПроектнаяЗадачаДокумент;
			// TODO Вынести получение сроков и отбор по ним в запрос ПолучитьТекстЗапросаПолученияПодчиненныхЗадач
			СрокиПодчиненнойПЗ = упоПроектыИЗадачиСервер.ПолучитьСрокиПроектнойЗадачи(ПЗПодчиненногоПроекта);
			Если СрокиПодчиненнойПЗ.ДатаЗавершенияПлан < ДатаСтартаПроекта Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПЗПодчиненногоПроекта = Неопределено Тогда
			// TODO Сделать изменение типа сразу по всем проектным задачам выборки, через документ сохранения даннах проекта
			ИзменитьТипЗадачи(ПроектнаяЗадача, ТипЗадачиЭтап);
		КонецЕсли;
		
		// TODO Сделать получение данных через транзитивное замыкание, если получиться и вынести из цикла выборки
		ДопПараметры = Новый Структура("АктуализироватьПланВыпускаПоДоходам, ПустаяПроектнаяЗадача, СписокВерсий",
				АктуализироватьПланВыпускаПоДоходам, ПустаяПроектнаяЗадача, СписокВерсий);
		ДанныеПоПЗ = ПолучитьДанныеПоАктируемымЭтапамПодчиненнойЗадачи(ВыборкаПодчиненныхЗадач.ПодчиненныйПроект,
				ДатаСтартаПроекта, ПЗПодчиненногоПроекта, ДопПараметры);
		
		// TODO См. комментарий к переменной ОбновленныеПЗ в методе СоздатьПЗпоДаннымПодчиненнойПЗ,
		// если избавиться от ОбновленныеПЗ, то возможно получить и от этого свойства избавиться
		ДопДанные.ТолькоОбновлениеЗадачи = ПЗПодчиненногоПроекта <> Неопределено;
		
		// TODO Вынести получение данных по проекту из цикла
		СоздатьПЗпоДаннымПодчиненнойПЗ(ДанныеПоПЗ, ДокументСохранения, ПроектнаяЗадача, ДопДанные);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьПЗпоДаннымПодчиненнойПЗ(ДанныеПоПЗ, ДокументСохранения, ПроектнаяЗадачаРодитель, ДопДанные)
	
	Проект = ДопДанные.Проект;
	ВерсияПроекта = ДопДанные.ВерсияПроекта;
	РабочийКалендарьПроекта = ДопДанные.РабочийКалендарьПроекта;
	ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.РабочийДень;
	ТипПроектнойЗадачи = ДопДанные.ТипПроектнойЗадачи;
	ТолькоОбновлениеЗадачи = ДопДанные.ТолькоОбновлениеЗадачи;
	ДатаСтартаПроекта = ДопДанные.ДатаСтартаПроекта;
	// TODO Свойство ОбновленныеПЗ Введено, для того чтобы не обновлять задачи по нескольку раз,
	// так как выборка из АктуализироватьБДР не обеспечивает иерархию проекта, нужно реализовать обход этой проблемы.
	// Эта проблема возникает только при актуализации всего проекта
	ОбновленныеПЗ = ДопДанные.ОбновленныеПЗ;
	
	Если ТолькоОбновлениеЗадачи Тогда
		ДетиПроектнойЗадачиРодителя = ПолучитьДетейЗаданнойЗадачи("", ВерсияПроекта);
	Иначе
		ДетиПроектнойЗадачиРодителя = ПолучитьДетейЗаданнойЗадачи(ПроектнаяЗадачаРодитель, ВерсияПроекта);
	КонецЕсли;
	
	// Кэширование сроков
	АктируемыеЭтапы = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДанныеПоПЗ Цикл
		АктируемыеЭтапы.Добавить(СтрокаТаблицы.АктируемыйЭтап);
	КонецЦикла;
	СрокиАктируемыхЭтапов = упоПроектыИЗадачиСервер.СрокиПроектныхЗадач(АктируемыеЭтапы);
	НазванияАктируемыхЭтапов = упоПроектыИЗадачиСервер.НазванияПроектныхЗадач(АктируемыеЭтапы);
	//
	НайденныеЗадачиЭтапа = Новый Массив;
	Для Каждого СтрокаТаблицы Из ДанныеПоПЗ Цикл
		
		АктируемыйЭтап = СтрокаТаблицы.АктируемыйЭтап;
		ДанныеПоАктируемомуЭтапу = СтрокаТаблицы.ДанныеАктируемогоЭтапа;
		
		СрокиПодчиненнойПЗ = СрокиАктируемыхЭтапов.Получить(АктируемыйЭтап);
		Если СрокиПодчиненнойПЗ.ДатаЗавершенияПлан < ДатаСтартаПроекта Тогда
			НайденнаяСтрока = ДетиПроектнойЗадачиРодителя.Найти(АктируемыйЭтап, "ПодчиненнаяПроектнаяЗадача");
			Если НайденнаяСтрока <> Неопределено Тогда
				ОбновленныеПЗ.Вставить(НайденнаяСтрока.ПроектнаяЗадача, Истина);
				НайденныеЗадачиЭтапа.Добавить(НайденнаяСтрока.ПроектнаяЗадача);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		НовыйДокумент = Ложь;
		
		Если ТолькоОбновлениеЗадачи Тогда
			Если ОбновленныеПЗ[ПроектнаяЗадачаРодитель] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			// TODO Возможно стоит переделать обновление данных табличных честей, через документ сохранения данных проекта
			ПроектнаяЗадачаОб = ПроектнаяЗадачаРодитель.ПолучитьОбъект();
			ПроектнаяЗадачаОб.ПолучитьДанныеВерсии(Неопределено);
			ОбновленныеПЗ.Вставить(ПроектнаяЗадачаРодитель, Истина);
		Иначе
			НайденнаяСтрока = ДетиПроектнойЗадачиРодителя.Найти(АктируемыйЭтап, "ПодчиненнаяПроектнаяЗадача");
			Если НайденнаяСтрока <> Неопределено Тогда
				НайденныеЗадачиЭтапа.Добавить(НайденнаяСтрока.ПроектнаяЗадача);
				Если ОбновленныеПЗ[НайденнаяСтрока.ПроектнаяЗадача] <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				// TODO Возможно стоит переделать обновление данных табличных честей, через документ сохранения данных проекта
				ПроектнаяЗадачаОб = НайденнаяСтрока.ПроектнаяЗадача.ПолучитьОбъект();
				ПроектнаяЗадачаОб.ПолучитьДанныеВерсии(Неопределено);
				ОбновленныеПЗ.Вставить(НайденнаяСтрока.ПроектнаяЗадача, Истина);
			Иначе
				НовыйДокумент = Истина;
				ПроектнаяЗадачаОб = Документы.упоПроектнаяЗадача.СоздатьДокумент();
				ПроектнаяЗадачаОб.ТипПроектнойЗадачи = ТипПроектнойЗадачи;
				// TODO Убрать получение Проекта АктируемогоЭтапа из цикла, добавить поле в таблицу ДанныеПоПЗ
				ПроектнаяЗадачаОб.ПодчиненныйПроект = АктируемыйЭтап.Проект;
				// TODO Убрать получение связанного элемента АктируемогоЭтапа из цикла, добавить поле в таблицу ДанныеПоПЗ
				ПроектнаяЗадачаОб.ПодчиненнаяПроектнаяЗадача =
					упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(АктируемыйЭтап);
				ПроектнаяЗадачаОб.ЗадачаРодитель = ПроектнаяЗадачаРодитель;
				ПроектнаяЗадачаОб.Проект = Проект;
				ПроектнаяЗадачаОб.ЕдиницаНормированияДлительности = ЕдиницаНормированияДлительности;
				// TODO Убрать получение сроков АктируемогоЭтапа из цикла, добавить поле в таблицу ДанныеПоПЗ
				// скопировано из Обработки.упоЗагрузитьИзПодчиненныхПроектов.Форма.Форма
				РасчитатьНовыеСроки(ПроектнаяЗадачаОб, АктируемыйЭтап, ДопДанные);
			КонецЕсли;
		КонецЕсли;
		
		// TODO Убрать получение НазваниеПроектнойЗадачи АктируемогоЭтапа из цикла, добавить поле в таблицу ДанныеПоПЗ
		ПроектнаяЗадачаОб.НазваниеПроектнойЗадачи = НазванияАктируемыхЭтапов[АктируемыйЭтап];
		
		// План доходов
		ПроектнаяЗадачаОб.ВключитьПланДоходовВБДДС = Ложь;
		Если НовыйДокумент Тогда
			ПроектнаяЗадачаоб.ДополнительныеСвойства.Вставить("ДанныеВерсииПолучены", Истина);
			ПроектнаяЗадачаоб.ДополнительныеСвойства.Вставить("ЭтоИнтерактивнаяЗапись", Ложь);
			ПроектнаяЗадачаоб.Дата = ТекущаяДатаСеанса();
			ПроектнаяЗадачаоб.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
		ЗаполнитьДоходыСохранениеПроекта(ПроектнаяЗадачаОб.Ссылка, ДокументСохранения, ДанныеПоАктируемомуЭтапу);
		
	КонецЦикла;
	
	ОтменитьЗадачиЭтапаРодителя(ДетиПроектнойЗадачиРодителя, НайденныеЗадачиЭтапа, Проект, ОбновленныеПЗ);
	
КонецПроцедуры

Процедура ЗаполнитьДоходыСохранениеПроекта(ПроектнаяЗадача, ДокументСохранения, ДанныеПоАктируемомуЭтапу)
	
	ПланДоходов = ДокументСохранения.ПланДоходов;
	ПланДоходовПоПодразделениям = ДокументСохранения.ПланДоходовПоПодразделениям;
	ТаблицаДоходов = ДанныеПоАктируемомуЭтапу.ТаблицаДоходов;
	ТаблицаПланДоходовПоПодразделениям = ДанныеПоАктируемомуЭтапу.ТаблицаРаспределенияДоходов;
	
	Для Каждого Строка Из ТаблицаДоходов Цикл
		СтрокаПланДоходов = ПланДоходов.Добавить();
		СтрокаПланДоходов.ПроектнаяЗадача = ПроектнаяЗадача;
		ЗаполнитьЗначенияСвойств(СтрокаПланДоходов, Строка);
	КонецЦикла;
	
	Для Каждого Строка Из ТаблицаПланДоходовПоПодразделениям Цикл
		СтрокаРаспределенияДоходов = ПланДоходовПоПодразделениям.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаспределенияДоходов, Строка);
		СтрокаРаспределенияДоходов.ПроектнаяЗадача = ПроектнаяЗадача;
		СтрокаРаспределенияДоходов.СпособПривязки = Строка.СпособПривязкиРаспределения;
		СтрокаРаспределенияДоходов.ПрофильРаспределения = Строка.ПрофильРаспределенияРаспределения;
		СтрокаРаспределенияДоходов.ДатаПривязки = Строка.ДатаПривязкиРаспределения;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АктуализацияТрудозатрат

Процедура АктуализироватьТрудозатраты(ВерсияКорневогоПроекта, ДокументСохранения, СлужебныеКоллекции, УровеньПланирования)
	
	СписокЗадач = Неопределено;
	СписокВерсий = Неопределено;
	СвойстваПроектныхЗадачСоответствие = Неопределено;
		
	СлужебныеКоллекции.Свойство("СписокЗадач", СписокЗадач);
	СлужебныеКоллекции.Свойство("СписокВерсий", СписокВерсий);
	СлужебныеКоллекции.Свойство("СвойстваПроектныхЗадачСоответствие", СвойстваПроектныхЗадачСоответствие);
		
	ДокументСохранения.ПерезаписатьТрудовыеРесурсыРоли = Истина;
	
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(ВерсияКорневогоПроекта.Проект, Истина, ВерсияКорневогоПроекта);
	УровеньПланирования = ?(УровеньПланирования = Неопределено, Перечисления.упоУровеньПланирования.ПустаяСсылка(),
			УровеньПланирования);
	
	ТекстЗапроса = ТекстЗапросаТрудозатрат();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
	Запрос.УстановитьПараметр("УровеньПланирования", УровеньПланирования);
	Запрос.УстановитьПараметр("СписокВерсий", СписокВерсий);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	Запрос.УстановитьПараметр("ВерсияКорневогоПроекта", ВерсияКорневогоПроекта);
	Запрос.УстановитьПараметр("КорневойПроект", ВерсияКорневогоПроекта.Проект);
	
	// Данные по подчиненным проектам нужны все, поэтому выполняем в привилегированнои режиме.
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ПроектнаяЗадачаИндекс = МаксимальныеИндексыСтрокРаспределенияПоПериодамТрудозатрат(ВерсияКорневогоПроекта, 
		СписокЗадач);
	
	ЗаполнитьТрудозатратыСохранениеПроекта(ДокументСохранения, РезультатЗапроса, СвойстваПроектныхЗадачСоответствие,
		ПроектнаяЗадачаИндекс);
	
КонецПроцедуры

Процедура ЗаполнитьТрудозатратыСохранениеПроекта(ДокументСохранения, РезультатЗапроса, 
	СвойстваПроектныхЗадачСоответствие, ПроектнаяЗадачаИндекс)
	
	ИндексТрудовыеРесурсы = 7;
	ИндексТрудовыеРесурсыПоПериодам = 8;
	
	Если РезультатЗапроса[ИндексТрудовыеРесурсы].Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтруктура = Новый Структура("ПроектнаяЗадача, Ресурс");
	ТаблицаТрудовыеРесурсыПоПериодам = РезультатЗапроса[ИндексТрудовыеРесурсыПоПериодам].Выгрузить();
	ВыборкаПроектныеЗадачи = РезультатЗапроса[ИндексТрудовыеРесурсы].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПроектныеЗадачи.Следующий() Цикл
		
		МаксимальныйИндекс = ПроектнаяЗадачаИндекс[ВыборкаПроектныеЗадачи.ПроектнаяЗадача];
		Если МаксимальныйИндекс = Неопределено Тогда
			СледующийИндекс = 1;
		Иначе
			СледующийИндекс = МаксимальныйИндекс + 1;
		КонецЕсли;
		
		Выборка = ВыборкаПроектныеЗадачи.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = ДокументСохранения.ТрудовыеРесурсыРоли.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.ИндексСтрокРаспределенияПоПериодам = СледующийИндекс;
			СледующийИндекс = СледующийИндекс + 1;
			
			Если НоваяСтрока.Отмена Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОтборСтруктура, НоваяСтрока);
			НайденныеСтроки = ТаблицаТрудовыеРесурсыПоПериодам.НайтиСтроки(ОтборСтруктура);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НоваяСтрокаПоПериодам = ДокументСохранения.ТрудовыеРесурсыРолиПоПериодам.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПоПериодам, НайденнаяСтрока);
				НоваяСтрокаПоПериодам.ИндексСтрокиРаспределениеПоРолям = НоваяСтрока.ИндексСтрокРаспределенияПоПериодам;
			КонецЦикла;
			
			ПараметрыОтбора = Новый Структура("ПроектнаяЗадача", Выборка.ПроектнаяЗадача);
			СуществующиеЗаписи = ДокументСохранения.ПроектныеЗадачи.НайтиСтроки(ПараметрыОтбора);
			Если ЗначениеЗаполнено(СуществующиеЗаписи) Тогда
				СтрокаИзмененияСвойствПроектнойЗадачи = СуществующиеЗаписи[0];
			Иначе
				СвойстваПроектнойЗадачи = СвойстваПроектныхЗадачСоответствие[Выборка.ПроектнаяЗадача];
				СтрокаИзмененияСвойствПроектнойЗадачи = ДокументСохранения.ПроектныеЗадачи.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаИзмененияСвойствПроектнойЗадачи, СвойстваПроектнойЗадачи);
			КонецЕсли;
			
		    СтрокаИзмененияСвойствПроектнойЗадачи.ВключитьТрудРесурсыВПланРасходов = Ложь;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура АктуализироватьТрудозатратыПоДокументамРЦК(ВерсияПроекта, ДокументСохранения, СписокЗадач,
		СоответсвиеДокументовРЦК, УровеньПланирования) Экспорт
	
	ДокументСохранения.ПерезаписатьТрудовыеРесурсыРоли = Истина;
	
	СпособПривязки = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения");
	ПрофильРаспределения = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение");
	ЕдиницаНормирования = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоЕдиницыВремени.Час");
	
	ЗначенияПоУмолчанию = Новый Структура;
	ЗначенияПоУмолчанию.Вставить("ЕдиницаНормирования", ЕдиницаНормирования);
	ЗначенияПоУмолчанию.Вставить("СпособПривязки", СпособПривязки);
	ЗначенияПоУмолчанию.Вставить("ПрофильРаспределения", ПрофильРаспределения);
	ЗначенияПоУмолчанию.Вставить("Версия", ВерсияПроекта);
	ЗначенияПоУмолчанию.Вставить("УровеньПланирования", УровеньПланирования);
	ЗначенияПоУмолчанию.Вставить("Период", ТекущаяДатаСеанса());
	ЗначенияПоУмолчанию.Вставить("ИсточникПлана", Перечисления.упоИсточникПланаТрудозатратРолей.Трудозатраты);
	
	Для Каждого ПроектнаяЗадача Из СписокЗадач Цикл
		
		ДокументРЦК = СоответсвиеДокументовРЦК.Получить(ПроектнаяЗадача);
		
		Если Не ЗначениеЗаполнено(ДокументРЦК) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияПоУмолчанию.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		
		обДокументРЦК = ДокументРЦК.ПолучитьОбъект();
		
		ТаблицаДанных = Новый ТаблицаЗначений;
		ТаблицаДанных.Колонки.Добавить("Специальность");
		ТаблицаДанных.Колонки.Добавить("Подразделение");
		ТаблицаДанных.Колонки.Добавить("КоличествоЧасов");
		
		Для Каждого СтрокаДокумента Из обДокументРЦК.ТрудозатратыПИРНИР Цикл
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		КонецЦикла;
		
		Для Каждого СтрокаДокумента Из обДокументРЦК.ТрудозатратыПНР Цикл
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		КонецЦикла;
		
		Для Каждого СтрокаДокумента Из обДокументРЦК.ТрудозатратыСМР Цикл
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		КонецЦикла;
		
		Для Каждого СтрокаДокумента Из обДокументРЦК.ТрудозатратыПрочие Цикл
			НоваяСтрока = ТаблицаДанных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		КонецЦикла;
		ТаблицаДанных.Свернуть("Специальность, Подразделение", "КоличествоЧасов");
		
		ЗаполнитьТрудозатратыСохранениеПроектаРЦК(ДокументСохранения, ТаблицаДанных, ЗначенияПоУмолчанию);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТрудозатратыСохранениеПроектаРЦК(ДокументСохранения, ДанныеПоАктируемомуЭтапу, ЗначенияПоУмолчанию)
	
	Для Каждого СтрокаДокумента Из ДанныеПоАктируемомуЭтапу Цикл
		
		СтрокаТрудовыеРесурсы = ДокументСохранения.ТрудовыеРесурсыРоли.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТрудовыеРесурсы, ЗначенияПоУмолчанию);
		СтрокаТрудовыеРесурсы.Ресурс = СтрокаДокумента.Специальность;
		СтрокаТрудовыеРесурсы.Подразделение = СтрокаДокумента.Подразделение;
		СтрокаТрудовыеРесурсы.Количество = СтрокаДокумента.КоличествоЧасов;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АктуализацияСубпродуктов

Процедура АктуализироватьСубпродукты(ВерсияКорневогоПроекта, ДокументСохранения, СлужебныеКоллекции, ТолькоВключенныеВБДР = Ложь)
	
	СписокЗадач = Неопределено;
	СписокВерсий = Неопределено;
	СвойстваПроектныхЗадачСоответствие = Неопределено;
	
	СлужебныеКоллекции.Свойство("СписокЗадач", СписокЗадач);
	СлужебныеКоллекции.Свойство("СписокВерсий", СписокВерсий);
	СлужебныеКоллекции.Свойство("СвойстваПроектныхЗадачСоответствие", СвойстваПроектныхЗадачСоответствие);
	
	Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВерсияКорневогоПроекта, "Проект");
	
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(Проект, Истина, ВерсияКорневогоПроекта);
	СпособПривязкиРаспределение = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиРаспределения.НаДату");
	
	ЗначенияПоУмолчанию = Новый Структура;
	ЗначенияПоУмолчанию.Вставить("Версия", ВерсияКорневогоПроекта);
	ЗначенияПоУмолчанию.Вставить("СпособПривязкиРаспределение", СпособПривязкиРаспределение);
	
	ДокументСохранения.ПерезаписатьСубпродукты = Истина;
	ДокументСохранения.ПерезаписатьВключитьСубпродуктыВПланДоходов = Истина;
	
	Если ТолькоВключенныеВБДР Тогда
		ТекстЗапроса = ТекстЗапросаСубпродуктов();
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
		Запрос.УстановитьПараметр("ИсточникПлана", Перечисления.упоИсточникПланаДоходовИРасходов.Объемы);
		Запрос.УстановитьПараметр("СписокВерсий", СписокВерсий);
		Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
		Запрос.УстановитьПараметр("ВерсияКорневогоПроекта", ВерсияКорневогоПроекта);
	Иначе
		ТекстЗапроса = ТекстЗапросаПланВыпуска();
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
		Запрос.УстановитьПараметр("ВидОбъема", Перечисления.упоВидЭлементаОбъемов.Доход);
		Запрос.УстановитьПараметр("СписокВерсий", СписокВерсий);
		Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
		Запрос.УстановитьПараметр("ВерсияКорневогоПроекта", ВерсияКорневогоПроекта);
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	т_ДанныеПланаВыпуска = Результат.Выгрузить();
	
	м_СписокПроектныхЗадач = т_ДанныеПланаВыпуска.ВыгрузитьКолонку("ПроектнаяЗадача");
	м_СписокПроектныхЗадач = ОбщегоНазначенияКлиентСервер.СвернутьМассив(м_СписокПроектныхЗадач);
	
	Для Каждого ПроектнаяЗадача Из м_СписокПроектныхЗадач Цикл
		
		СвойстваПроектнойЗадачи = СвойстваПроектныхЗадачСоответствие[ПроектнаяЗадача];
		
		ДатаВыпуска = СвойстваПроектнойЗадачи.ДатаЗавершенияПлан;
		
		ЗначенияПоУмолчанию.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		ЗначенияПоУмолчанию.Вставить("ДатаВыпуска", ДатаВыпуска);
		
		СтруктураОтбора = Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача);
		м_ДанныеПланаВыпускаПоЗадаче = т_ДанныеПланаВыпуска.НайтиСтроки(СтруктураОтбора);
		Если м_ДанныеПланаВыпускаПоЗадаче.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуществующиеЗаписиДокумента = ДокументСохранения.ПроектныеЗадачи.НайтиСтроки(СтруктураОтбора);
		Если НЕ ЗначениеЗаполнено(СуществующиеЗаписиДокумента) Тогда
			СтрокаИзмененияСвойствПроектнойЗадачи = ДокументСохранения.ПроектныеЗадачи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИзмененияСвойствПроектнойЗадачи, СвойстваПроектнойЗадачи);
		Иначе
			СтрокаИзмененияСвойствПроектнойЗадачи = СуществующиеЗаписиДокумента[0];
		КонецЕсли;
		
		т_ДанныеПланаВыпускаПоЗадаче = т_ДанныеПланаВыпуска.Скопировать(м_ДанныеПланаВыпускаПоЗадаче);
		
		ЗаполнитьСубпродуктыСохранениеПроекта(ПроектнаяЗадача, ДокументСохранения, ЗначенияПоУмолчанию, 
			т_ДанныеПланаВыпускаПоЗадаче);
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСубпродуктыСохранениеПроекта(ПроектнаяЗадача, ДокументСохранения, ЗначенияПоУмолчанию, 
	т_ДанныеПланаВыпускаПоЗадаче)
	
	т_ГруппыПланаВыпускаПоЗадаче = т_ДанныеПланаВыпускаПоЗадаче.Скопировать();
	т_ГруппыПланаВыпускаПоЗадаче.Свернуть("Регистратор,
		|ПроектнаяЗадача,
		| Версия,
		| Ресурс,
		| ЕдиницаНормирования,
		| Валюта",
		" Количество,
		| ОбщСтоимость");
	
	ИндексСтроки = 1;
	
	Для Каждого СтрокаГруппировки Из т_ГруппыПланаВыпускаПоЗадаче Цикл
		
		//Не должно быть строк группировки с нулевым количеством, но на всякий случай проверим
		Если СтрокаГруппировки.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		//Заполним субпродукты
		СтрокаСубпродукты = ДокументСохранения.Субпродукты.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаСубпродукты, СтрокаГруппировки);
		ЗаполнитьЗначенияСвойств(СтрокаСубпродукты, ЗначенияПоУмолчанию);
		
		СтрокаСубпродукты.ИндексСтрокРаспределения = ИндексСтроки;
		СтрокаСубпродукты.Стоимость = СтрокаСубпродукты.ОбщСтоимость / СтрокаСубпродукты.Количество;
		
		//Заполним субпродукты по подразделениям
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Регистратор", 		СтрокаГруппировки.Регистратор);
		СтруктураОтбора.Вставить("ПроектнаяЗадача", 	СтрокаГруппировки.ПроектнаяЗадача);
		СтруктураОтбора.Вставить("Версия", 				СтрокаГруппировки.Версия);
		СтруктураОтбора.Вставить("Ресурс", 				СтрокаГруппировки.Ресурс);
		СтруктураОтбора.Вставить("ЕдиницаНормирования", СтрокаГруппировки.ЕдиницаНормирования);
		СтруктураОтбора.Вставить("Валюта", 				СтрокаГруппировки.Валюта);
		
		м_ДанныеРаспределения = т_ДанныеПланаВыпускаПоЗадаче.НайтиСтроки(СтруктураОтбора);
		
		Для Каждого СтрокаРаспределения Из м_ДанныеРаспределения Цикл
			СтрокаСубпродуктыПоПодразделениям = ДокументСохранения.СубпродуктыПоПодразделениям.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаСубпродуктыПоПодразделениям, СтрокаРаспределения);
			ЗаполнитьЗначенияСвойств(СтрокаСубпродуктыПоПодразделениям, ЗначенияПоУмолчанию);
			
			СтрокаСубпродуктыПоПодразделениям.ИндексСтрокиВладельца = ИндексСтроки;
			СтрокаСубпродуктыПоПодразделениям.СпособПривязки = ЗначенияПоУмолчанию.СпособПривязкиРаспределение;
			СтрокаСубпродуктыПоПодразделениям.ДатаПривязки = СтрокаРаспределения.ДатаПривязкиРаспределение;
			СтрокаСубпродуктыПоПодразделениям.Сумма = СтрокаРаспределения.ОбщСтоимость;
		КонецЦикла;
		
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура АктуализироватьСубпродуктыПоДокументамРЦК(ВерсияПроекта, ДокументСохранения, СлужебныеКоллекции,
		СоответсвиеДокументовРЦК, ПараметрыАктуализации) Экспорт
	
	ДокументСохранения.ПерезаписатьСубпродукты = Истина;
	
	СписокЗадач = Неопределено;
	СвойстваПроектныхЗадачСоответствие = Неопределено;
	
	СлужебныеКоллекции.Свойство("СписокЗадач", СписокЗадач);
	СлужебныеКоллекции.Свойство("СвойстваПроектныхЗадачСоответствие", СвойстваПроектныхЗадачСоответствие);
	
	АктуализироватьСубпродукты = Ложь;
	Если ПараметрыАктуализации.Свойство("АктуализироватьПланВыпускаПоДоходам") Тогда
		АктуализироватьСубпродукты = ПараметрыАктуализации.АктуализироватьПланВыпускаПоДоходам;
	КонецЕсли;
	
	Если Не АктуализироватьСубпродукты Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВерсияПроекта.Проект, "СтатьяДоходовПоУмолчанию, РольДоходовПоУмолчанию, ПодразделениеДоходовПоУмолчанию");
	СпособПривязки = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиДоходаРасхода.НаДату");
	СобственныеСилы = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");
	СпособПривязкиРаспределение = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиРаспределения.НаДату");
	ИсточникПланаОбъемы = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы");
	
	ЗначенияПоУмолчанию = Новый Структура;
	ЗначенияПоУмолчанию.Вставить("ВидОбъема", ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЭлементаОбъемов.Доход"));
	ЗначенияПоУмолчанию.Вставить("СпособПривязки", СпособПривязки);
	ЗначенияПоУмолчанию.Вставить("СпособПривязкиРаспределение", СпособПривязкиРаспределение);
	ЗначенияПоУмолчанию.Вставить("СтатьяДоходов", ДанныеПроекта.СтатьяДоходовПоУмолчанию);
	ЗначенияПоУмолчанию.Вставить("Роль", ДанныеПроекта.РольДоходовПоУмолчанию);
	ЗначенияПоУмолчанию.Вставить("Подразделение", ДанныеПроекта.ПодразделениеДоходовПоУмолчанию);
	ЗначенияПоУмолчанию.Вставить("СпособПривязкиДоходов", СпособПривязки);
	ЗначенияПоУмолчанию.Вставить("СобствСилы_Субподряд", СобственныеСилы);
	
	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("Версия", ВерсияПроекта);
	ДанныеШапки.Вставить("Период", ТекущаяДатаСеанса());
	
	Для Каждого ПроектнаяЗадача Из СписокЗадач Цикл
		
		ДокументРЦК = СоответсвиеДокументовРЦК.Получить(ПроектнаяЗадача);
		ДанныеШапки.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		
		Если Не ЗначениеЗаполнено(ДокументРЦК) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияПоУмолчанию.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		
		обДокументРЦК = ДокументРЦК.ПолучитьОбъект();
		
		ДанныеШапки.Вставить("Валюта", обДокументРЦК.Валюта);
		
		ОперацияОборудование = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоВидыОпераций.Оборудование");
		СтрокиРасчета = обДокументРЦК.ПараметрыРасчета.НайтиСтроки(Новый Структура("ВидОперации", ОперацияОборудование));
		
		Если СтрокиРасчета.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаКонтрактаОборудования = СтрокиРасчета[0].СуммаКонтракта + (СтрокиРасчета[0].СуммаКонтракта * (обДокументРЦК.ПоправкаНаИнфляцию / 100));
		МассивСуммОборудования = Новый Массив;
		Для Каждого СтрокаОборудования Из обДокументРЦК.ОборудованиеПродаваемое Цикл
			МассивСуммОборудования.Добавить(СтрокаОборудования.СтоимостьПродажиCIP + СтрокаОборудования.СуммаТаможенныхПлатежей);
		КонецЦикла;
		
		ДатаПривязки = СтрокиРасчета[0].ДатаАктирования;
		ЗначенияПоУмолчанию.Вставить("ДатаПривязки", ДатаПривязки);
		
		МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СуммаКонтрактаОборудования, МассивСуммОборудования);
		
		ДанныеЗаполнения = Новый Структура("ОборудованиеПродаваемое, МассивРаспределенныхСумм", обДокументРЦК.ОборудованиеПродаваемое, МассивРаспределенныхСумм);
		
		СвойстваПроектнойЗадачи = СвойстваПроектныхЗадачСоответствие[ПроектнаяЗадача];
		СтрокаИзмененияСвойствПроектнойЗадачи = ДокументСохранения.ПроектныеЗадачи.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаИзмененияСвойствПроектнойЗадачи, СвойстваПроектнойЗадачи);
		СтрокаИзмененияСвойствПроектнойЗадачи.ВключитьСубпродуктыВПланДоходов = Истина;
		
		ЗаполнитьСубпродуктыСохранениеПроектаРЦК(ДокументСохранения, ДанныеЗаполнения, ДанныеШапки, ЗначенияПоУмолчанию);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСубпродуктыСохранениеПроектаРЦК(ДокументСохранения, ДанныеПоАктируемомуЭтапу, ДанныеШапки, ЗначенияПоУмолчанию)
	
	Индекс = 0;
	ИндексРаспределения = 1;
	
	ОборудованиеПродаваемое = ДанныеПоАктируемомуЭтапу.ОборудованиеПродаваемое;
	МассивРаспределенныхСумм = ДанныеПоАктируемомуЭтапу.МассивРаспределенныхСумм;
	
	Для Каждого СтрокаОборудования Из ОборудованиеПродаваемое Цикл
		
		НоваяСтрока = ДокументСохранения.Субпродукты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеШапки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияПоУмолчанию);
		НоваяСтрока.Ресурс = СтрокаОборудования.Оборудование;
		НоваяСтрока.ЕдиницаНормирования =
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.Ресурс, "ЕдиницаИзмерения");
		НоваяСтрока.ДатаВыпуска = ЗначенияПоУмолчанию.ДатаПривязки;
		НоваяСтрока.Количество = ?(СтрокаОборудования.Количество = 0, 1, СтрокаОборудования.Количество);
		НоваяСтрока.ОбщСтоимость = МассивРаспределенныхСумм[Индекс];
		НоваяСтрока.Стоимость = НоваяСтрока.ОбщСтоимость / НоваяСтрока.Количество;
		НоваяСтрока.ИндексСтрокРаспределения = ИндексРаспределения;
		
		НоваяСтрокаРаспредления = ДокументСохранения.СубпродуктыПоПодразделениям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспредления, ДанныеШапки);
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспредления, ЗначенияПоУмолчанию);
		НоваяСтрокаРаспредления.СпособПривязки = ЗначенияПоУмолчанию.СпособПривязкиРаспределение;
		НоваяСтрокаРаспредления.ИндексСтрокиВладельца = ИндексРаспределения;
		НоваяСтрокаРаспредления.Сумма = НоваяСтрока.ОбщСтоимость;
		НоваяСтрокаРаспредления.Количество = НоваяСтрока.Количество;
		
		Индекс = Индекс + 1;
		ИндексРаспределения = ИндексРаспределения + 1;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АктуализацияПланаДоходовРасходов

Процедура АктуализироватьПланДоходовРасходов(НаправлениеБДР, ВерсияКорневогоПроекта, ДокументСохранения, СлужебныеКоллекции)
	
	СписокЗадач = Неопределено;
	СписокВерсий = Неопределено;
	СвойстваПроектныхЗадачСоответствие = Неопределено;
	
	СлужебныеКоллекции.Свойство("СписокЗадач", СписокЗадач);
	СлужебныеКоллекции.Свойство("СписокВерсий", СписокВерсий);
	СлужебныеКоллекции.Свойство("СвойстваПроектныхЗадачСоответствие", СвойстваПроектныхЗадачСоответствие);
	
	ДокументСохранения.ПерезаписатьПланРасходов = Истина;
	
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(ВерсияКорневогоПроекта.Проект, Истина, ВерсияКорневогоПроекта);
	
	МассивИсточникПлана = Новый Массив;
	МассивИсточникПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	МассивИсточникПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.Объемы);
	МассивИсточникПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты);
	МассивИсточникПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.Трудозатраты);
	МассивИсточникПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ПустаяСсылка());
	
	ТекстЗапроса = ТекстЗапросаПланДоходовРасходов();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
	Запрос.УстановитьПараметр("ВидЭлемента", НаправлениеБДР);
	Запрос.УстановитьПараметр("ИсточникПлана", МассивИсточникПлана);
	Запрос.УстановитьПараметр("СписокВерсий", СписокВерсий);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	Запрос.УстановитьПараметр("ВерсияКорневогоПроекта", ВерсияКорневогоПроекта);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаРезультат = Результат[3].Выгрузить();
	ТаблицаРезультатПодразделения = Результат[4].Выгрузить();
	
	СписокПроектныхЗадач = ТаблицаРезультат.ВыгрузитьКолонку("ПроектнаяЗадача");
	СписокПроектныхЗадач = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокПроектныхЗадач);
	
	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("Версия", ВерсияКорневогоПроекта);
	ДанныеШапки.Вставить("Период", ТекущаяДатаСеанса());
	ДанныеШапки.Вставить("ПериодАгрегации", Перечисления.упоПериодыАгрегацииЗатрат.ПустаяСсылка());
	
	Для Каждого ПроектнаяЗадача Из СписокПроектныхЗадач Цикл
		
		ДанныеШапки.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		
		ПараметрыОтбора = Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача);
		ДанныеДляЗаписи = ТаблицаРезультат.НайтиСтроки(ПараметрыОтбора);
		
		Если ДанныеДляЗаписи.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуществующиеЗаписи = ДокументСохранения.ПроектныеЗадачи.НайтиСтроки(ПараметрыОтбора);
		Если ЗначениеЗаполнено(СуществующиеЗаписи) Тогда
			ВыключитьОпцииТрансляции(СуществующиеЗаписи[0], НаправлениеБДР, Истина, Ложь);
		Иначе	
			СвойстваПроектнойЗадачи = СвойстваПроектныхЗадачСоответствие[ПроектнаяЗадача];
			СтрокаИзмененияСвойствПроектнойЗадачи = ДокументСохранения.ПроектныеЗадачи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИзмененияСвойствПроектнойЗадачи, СвойстваПроектнойЗадачи);
			ВыключитьОпцииТрансляции(СтрокаИзмененияСвойствПроектнойЗадачи, НаправлениеБДР, Истина, Ложь);
		КонецЕсли;
		
		ЗаполнитьПланДоходовРасходовСохранениеПроекта(НаправлениеБДР, ПроектнаяЗадача, ДокументСохранения, ДанныеШапки, ДанныеДляЗаписи, ТаблицаРезультатПодразделения);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПланДоходовРасходовСохранениеПроекта(НаправлениеБДР,
		ПроектнаяЗадача,
		ДокументСохранения,
		ДанныеШапки,
		ДанныеДляЗаписи,
		ТаблицаРезультатПодразделения)
	
	Если НаправлениеБДР = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход Тогда
		ОсновнаяТЧ = "ПланДоходов";
		ТЧРаспределения = "ПланДоходовПоПодразделениям";
	Иначе
		ОсновнаяТЧ = "ПланРасходов";
		ТЧРаспределения = "ПланРасходовПоПодразделениям";
	КонецЕсли;
	
	ИндексРаспределения = 1;
	
	Для Каждого СтрокаДляЗаписи Из ДанныеДляЗаписи Цикл
		
		НоваяСтрока = ДокументСохранения[ОсновнаяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДляЗаписи);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеШапки);
		НоваяСтрока.ИндексСтрокРаспределения = ИндексРаспределения;
		
		ПараметрыОтбора = Новый Структура("ПроектнаяЗадача, СпособПривязки, ПрофильРаспределения",
				НоваяСтрока.ПроектнаяЗадача, НоваяСтрока.СпособПривязки, НоваяСтрока.ПрофильРаспределения);
		
		ПараметрыОтбора.Вставить("ДатаПривязки", СтрокаДляЗаписи.ДатаПривязки);
		ПараметрыОтбора.Вставить("Статья", СтрокаДляЗаписи.Статья);
		ПараметрыОтбора.Вставить("Контрагент", СтрокаДляЗаписи.Контрагент);
		ПараметрыОтбора.Вставить("Договор", СтрокаДляЗаписи.Договор);
		
		МассивРаспределенных = ТаблицаРезультатПодразделения.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаРаспределения Из МассивРаспределенных Цикл
			НоваяСтрокаРаспредления = ДокументСохранения[ТЧРаспределения].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспредления, ДанныеШапки);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспредления, СтрокаРаспределения);
			НоваяСтрокаРаспредления.ИндексСтрокиВладельца = ИндексРаспределения;
		КонецЦикла;
		
		ИндексРаспределения = ИндексРаспределения + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура АктуализироватьПланДоходовПоДокументамРЦК(ВерсияПроекта, ДокументСохранения, СписокЗадач,
		СоответсвиеДокументовРЦК, ПараметрыАктуализации) Экспорт
	
	ДокументСохранения.ПерезаписатьПланДоходов = Истина;
	
	СпособПривязки = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиДоходаРасхода.НаДату");
	СпособоПривязкиРаспределение = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиРаспределения.НаДату");
	ДанныеПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВерсияПроекта.Проект, "СтатьяДоходовПоУмолчанию, РольДоходовПоУмолчанию, ПодразделениеДоходовПоУмолчанию");
	ИсточникПлана = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы");
	ИсточникПланаОбъемы = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы");
	СобственныеСилы = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");
	
	ОтделятьСубпродукты = Ложь;
	Если ПараметрыАктуализации.Свойство("АктуализироватьПланВыпускаПоДоходам") Тогда
		ОтделятьСубпродукты = ПараметрыАктуализации.АктуализироватьПланВыпускаПоДоходам;
	КонецЕсли;
	ДокументСохранения.ПерезаписатьВключитьСубпродуктыВПланДоходов = ОтделятьСубпродукты;
	
	ОперацияОборудование = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоВидыОпераций.Оборудование");
	
	ЗначенияПоУмолчанию = Новый Структура;
	ЗначенияПоУмолчанию.Вставить("СпособПривязки", СпособПривязки);
	ЗначенияПоУмолчанию.Вставить("СпособПривязкиРаспределение", СпособоПривязкиРаспределение);
	ЗначенияПоУмолчанию.Вставить("Статья", ДанныеПроекта.СтатьяДоходовПоУмолчанию);
	ЗначенияПоУмолчанию.Вставить("ЭтоСубпродуктИлиПотребность", Ложь);
	ЗначенияПоУмолчанию.Вставить("Подразделение", ДанныеПроекта.ПодразделениеДоходовПоУмолчанию);
	ЗначенияПоУмолчанию.Вставить("Роль", ДанныеПроекта.РольДоходовПоУмолчанию);
	ЗначенияПоУмолчанию.Вставить("ИсточникПлана", ИсточникПлана);
	ЗначенияПоУмолчанию.Вставить("СобствСилы_Субподряд", СобственныеСилы);
	
	Для Каждого ПроектнаяЗадача Из СписокЗадач Цикл
		
		ДокументРЦК = СоответсвиеДокументовРЦК.Получить(ПроектнаяЗадача);
		
		Если Не ЗначениеЗаполнено(ДокументРЦК) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначенияПоУмолчанию.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		
		// TODO: переделать получение данных документа РЦК на запрос.
		обДокументРЦК = ДокументРЦК.ПолучитьОбъект();
		ЗначенияПоУмолчанию.Вставить("Валюта", обДокументРЦК.Валюта);
		ЗначенияПоУмолчанию.Вставить("ПоправкаНаИнфляцию", обДокументРЦК.ПоправкаНаИнфляцию);
		
		ДанныеПоРасчетам = обДокументРЦК.ПараметрыРасчета.Выгрузить();
		
		Если ОтделятьСубпродукты Тогда
			Для Каждого СтрокаРасчетов Из ДанныеПоРасчетам Цикл
				Если СтрокаРасчетов.ВидОперации = ОперацияОборудование Тогда
					ДанныеПоРасчетам.Удалить(СтрокаРасчетов);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ДанныеПоРасчетам.Колонки.Удалить("ВидОперации");
		СуммыПоДатамАктирования = ДанныеПоРасчетам.СкопироватьКолонки("СуммаКонтракта, ДатаАктирования");
		
		Для Каждого СтрокаРасчетов Из ДанныеПоРасчетам Цикл
			НоваяСтрока = СуммыПоДатамАктирования.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчетов);
		КонецЦикла;
		
		СуммыПоДатамАктирования.Свернуть("ДатаАктирования", "СуммаКонтракта");
		
		ЗаполнитьБДРСохранениеПроектаРЦК(ДокументСохранения, СуммыПоДатамАктирования, ЗначенияПоУмолчанию);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьБДРСохранениеПроектаРЦК(ДокументСохранения, ДанныеПоАктируемомуЭтапу, ЗначенияПоУмолчанию)
	
	ИндексРаспределения = 1;
	
	Для Каждого СтрокаРасчетов Из ДанныеПоАктируемомуЭтапу Цикл
		
		Если СтрокаРасчетов.СуммаКонтракта = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументСохранения.ПланДоходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияПоУмолчанию);
		НоваяСтрока.ДатаПривязки = СтрокаРасчетов.ДатаАктирования;
		НоваяСтрока.Сумма = СтрокаРасчетов.СуммаКонтракта + (СтрокаРасчетов.СуммаКонтракта * (ЗначенияПоУмолчанию.ПоправкаНаИнфляцию / 100));
		НоваяСтрока.ИндексСтрокРаспределения = ИндексРаспределения;
		
		НоваяСтрокаРаспределения = ДокументСохранения.ПланДоходовПоПодразделениям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, ЗначенияПоУмолчанию);
		НоваяСтрокаРаспределения.Сумма = НоваяСтрока.Сумма;
		НоваяСтрокаРаспределения.СпособПривязки = ЗначенияПоУмолчанию.СпособПривязкиРаспределение;
		НоваяСтрокаРаспределения.ДатаПривязки = НоваяСтрока.ДатаПривязки;
		НоваяСтрокаРаспределения.ИндексСтрокиВладельца = ИндексРаспределения;
		
		ИндексРаспределения = ИндексРаспределения + 1;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АктуалиацияПланаПоступленийДС

Процедура АктуализироватьПланПоступленийВыплатДС(ВерсияКорневогоПроекта, ДокументСохранения, СлужебныеКоллекции, НаправлениеДвижения, ВидЭлемента)
	
	СписокЗадач = Неопределено;
	СписокВерсий = Неопределено;
	СвойстваПроектныхЗадачСоответствие = Неопределено;
	
	СлужебныеКоллекции.Свойство("СписокЗадач", СписокЗадач);
	СлужебныеКоллекции.Свойство("СписокВерсий", СписокВерсий);
	СлужебныеКоллекции.Свойство("СвойстваПроектныхЗадачСоответствие", СвойстваПроектныхЗадачСоответствие);
	
	ДокументСохранения.ПерезаписатьДвиженияДенежныхСредств = Истина;
	
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(ВерсияКорневогоПроекта.Проект, Истина, ВерсияКорневогоПроекта);
	
	ТекстЗапроса = ТекстЗапросаПланДДС();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаСтартаПроекта", ДатаСтартаПроекта);
	Запрос.УстановитьПараметр("ИсточникПлана", Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	Запрос.УстановитьПараметр("СписокВерсий", СписокВерсий);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	Запрос.УстановитьПараметр("ВерсияКорневогоПроекта", ВерсияКорневогоПроекта);
	Запрос.УстановитьПараметр("НаправлениеДвижения", НаправлениеДвижения);
	Запрос.УстановитьПараметр("ВидЭлемента", ВидЭлемента);
	
	Результат = Запрос.Выполнить();
	
	ТаблицаРезультат = Результат.Выгрузить();
	
	СписокПроектныхЗадач = ТаблицаРезультат.ВыгрузитьКолонку("ПроектнаяЗадача");
	СписокПроектныхЗадач = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокПроектныхЗадач);
	
	ДанныеШапки = Новый Структура;
	ДанныеШапки.Вставить("Версия", ВерсияКорневогоПроекта);
	ДанныеШапки.Вставить("Период", ТекущаяДатаСеанса());
	
	Для Каждого ПроектнаяЗадача Из СписокПроектныхЗадач Цикл
		
		ДанныеШапки.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
		
		ПараметрыОтбора = Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача);
		ДанныеДляЗаписи = ТаблицаРезультат.НайтиСтроки(ПараметрыОтбора);
		
		Если ДанныеДляЗаписи.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуществующиеЗаписи = ДокументСохранения.ПроектныеЗадачи.НайтиСтроки(ПараметрыОтбора);
		Если ЗначениеЗаполнено(СуществующиеЗаписи) Тогда
			ВыключитьОпцииТрансляции(СуществующиеЗаписи[0], ВидЭлемента, Ложь, Истина);
		Иначе
			СвойстваПроектнойЗадачи = СвойстваПроектныхЗадачСоответствие[ПроектнаяЗадача];
			СтрокаИзмененияСвойствПроектнойЗадачи = ДокументСохранения.ПроектныеЗадачи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИзмененияСвойствПроектнойЗадачи, СвойстваПроектнойЗадачи);
			ВыключитьОпцииТрансляции(СтрокаИзмененияСвойствПроектнойЗадачи, ВидЭлемента, Ложь, Истина);
		КонецЕсли;
		
		ЗаполнитьПланДДС(ПроектнаяЗадача, ДокументСохранения, ДанныеШапки, ДанныеДляЗаписи);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПланДДС(ПроектнаяЗадача, ДокументСохранения, ДанныеШапки, ДанныеДляЗаписи)
	
	ИндексРаспределения = 1;
	
	Для Каждого СтрокаДляЗаписи Из ДанныеДляЗаписи Цикл
		
		НоваяСтрока = ДокументСохранения.ДвиженияДенежныхСредств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеШапки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДляЗаписи);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

Процедура ВыключитьОпцииТрансляции(СтрокаИзмененияСвойствПроектнойЗадачи, ВидЭлемента, ОтключитьТрансляциюБДР = Ложь,
	ОтключитьТрансляциюБДДС = Ложь)
	
	ЭтоДоход = ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход;
	ЭтоРасход = ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход; 
	
	Если ОтключитьТрансляциюБДР И ЭтоДоход Тогда	
		СтрокаИзмененияСвойствПроектнойЗадачи.ВключитьСубпродуктыВПланДоходов = Ложь;				
	ИначеЕсли ОтключитьТрансляциюБДР И ЭтоРасход Тогда	
		СтрокаИзмененияСвойствПроектнойЗадачи.ВключитьМатРесурсыВПланРасходов = Ложь;
	КонецЕсли;	
	
	Если ОтключитьТрансляциюБДДС И ЭтоДоход Тогда
		СтрокаИзмененияСвойствПроектнойЗадачи.ВключитьПланДоходовВБДДС = Ложь;
	ИначеЕсли ОтключитьТрансляциюБДДС И ЭтоРасход Тогда
		СтрокаИзмененияСвойствПроектнойЗадачи.ВключитьПланРасходовВБДДС = Ложь;
	КонецЕсли;

КонецПроцедуры

Функция МаксимальныеИндексыСтрокРаспределенияПоПериодамТрудозатрат(ВерсияКорневогоПроекта, СписокЗадач)
	
	ПроектнаяЗадачаИндекс = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", ВерсияКорневогоПроекта);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	МАКСИМУМ(упоДанныеПлановТрудозатратРолейСрезПоследних.ИндексСтрокРаспределения) КАК МаксимальныйИндекс
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача В (&СписокЗадач)
	               |				И Версия = &Версия) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	               |ГДЕ
	               |	(упоДанныеПлановТрудозатратРолейСрезПоследних.Количество <> 0
	               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.ОбщСтоимость <> 0
	               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.ОбщВнешняяСтоимость <> 0)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл			
			ПроектнаяЗадачаИндекс.Вставить(Выборка.ПроектнаяЗадача, Выборка.МаксимальныйИндекс);
		КонецЦикла;	
	КонецЕсли;	
		
	Возврат	ПроектнаяЗадачаИндекс;
		
КонецФункции

#КонецОбласти
