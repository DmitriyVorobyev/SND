Функция ТекстЗапросаЗадачиСПодчиненными()
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненныйПроект КАК Проект,
		|   упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК СуществующаяПроектнаяЗадача
		|ИЗ
		|   РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|           ,
		|           Версия = &Версия
		|               И ПодчиненныйПроект В (&ПодчиненныеПроекты)
		|               И ПроектнаяЗадача.Проект = &КорневойПроект) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|       ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		|       ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
		|ГДЕ
		|   НЕ Проекты.ЗадачаОтменена";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаДанныеПЗДляОчистки()
	
	// 0, 2 - данные объемов, распределение по подразделениям.
	// 4, 5 - трудозатраты, трудозатраты по периодам.
	// 6, 8, 9 - план доходов, распределение по подразделениям, распределение по периодам.
	// 10, 12, 13 - план расходов, распределение по подразделениям, распределение по периодам.
	// 14 - план ДДС, поступление.
	// 15 - план ДДС, выплата.
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                   |    Субпродукты.ПроектнаяЗадача КАК ПроектнаяЗадача,
                   |    Субпродукты.Номенклатура КАК Ресурс,
                   |    Субпродукты.Контрагент КАК Контрагент,
                   |    Субпродукты.Договор КАК Договор,
                   |    Субпродукты.ЕдиницаИзмерения КАК ЕдиницаНормирования,
                   |    Субпродукты.СпособПривязки КАК СпособПривязкиВыпуска,
                   |    Субпродукты.ЗадержкаЗаказа КАК ЗадержкаЗаказа,
                   |    Субпродукты.ДатаВыпуска КАК ДатаВыпуска,
                   |    Субпродукты.Валюта КАК Валюта,
                   |    Субпродукты.Цена КАК Стоимость,
                   |    Субпродукты.Скорость КАК Скорость,
                   |    Субпродукты.Основной КАК Основной,
                   |    0 КАК Количество,
                   |    Субпродукты.Коэффициент КАК Коэффициент,
                   |    0 КАК ОбщСтоимость,
                   |    Субпродукты.СтатьяДоходов КАК СтатьяДоходов,
                   |    Субпродукты.ПрофильРаспределения КАК ПрофильРаспределения,
                   |    Субпродукты.СпособПривязкиДоходов КАК СпособПривязки,
                   |    Субпродукты.ДатаПривязки КАК ДатаПривязки,
                   |    Субпродукты.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
                   |    Субпродукты.Комментарий КАК Комментарий,
                   |    ИСТИНА КАК Отмена,
                   |    ИСТИНА КАК ИзменениеРаспределения
                   |ИЗ
                   |    РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
                   |            ,
                   |            ПроектнаяЗадача В (&СписокЗадач)
                   |                И Версия = &текВерсия) КАК Субпродукты
                   |ГДЕ
                   |    (Субпродукты.Количество <> 0
                   |            ИЛИ Субпродукты.Сумма <> 0
                   |            ИЛИ Субпродукты.СуммаВалютная <> 0)
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |    Субпродукты.НомерСтроки
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ РАЗРЕШЕННЫЕ
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.НомерСтроки КАК НомерСтроки,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.ВидОбъема КАК ВидОбъема,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.Подразделение КАК Подразделение,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.Роль КАК Роль,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.СпособПривязки КАК СпособПривязки,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.ПрофильРаспределения КАК ПрофильРаспределения,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.ДатаНачисления КАК ДатаНачисления,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.ИндексСтрокиВладельца КАК ИндексСтрокиВладельца,
                   |    упоДанныеПлановОбъемовПодразделенияСрезПоследних.ИндексСтрокРаспределенияПоПериодам КАК ИндексСтрокРаспределенияПоПериодам,
                   |    0 КАК СуммаВалютная,
                   |    0 КАК Количество,
                   |    ИСТИНА КАК Отмена
                   |ПОМЕСТИТЬ ВТ_ПланОбъемовПодразделения
                   |ИЗ
                   |    РегистрСведений.упоДанныеПлановОбъемовПодразделения.СрезПоследних(
                   |            ,
                   |            Версия = &текВерсия
                   |                И ПроектнаяЗадача В (&СписокЗадач)) КАК упоДанныеПлановОбъемовПодразделенияСрезПоследних
                   |ГДЕ
                   |    (упоДанныеПлановОбъемовПодразделенияСрезПоследних.СуммаВалютная <> 0
                   |            ИЛИ упоДанныеПлановОбъемовПодразделенияСрезПоследних.Сумма <> 0
                   |            ИЛИ упоДанныеПлановОбъемовПодразделенияСрезПоследних.Количество <> 0)
                   |;
                   |
                   |////////////////////////////////////////////////////////////////////////////////
