#Область ПрограммныйИнтерфейс

// Выполнить изменение данных программы
//
// Параметры:
//  ПараметрыФормыНастроек                          - Структура:
//  * УровеньПланирования                           - ПеречислениеСсылка.упоУровеньПланирования
//  * АктуализироватьПланВыплатДС                   - Булево
//  * АктуализироватьПланВыпускаПоДоходам           - Булево
//  * АктуализироватьПланДоходов                    - Булево
//  * АктуализироватьПланПоступленийДС              - Булево
//  * АктуализироватьПланРасходов                   - Булево
//  * АктуализироватьТрудозатраты                   - Булево
//  * ВерсияПроекта                                 - ДокументСсылка.упоВерсияПланаПроекта
//  * ДатаСтартаПроекта                             - Дата - нужна для расчета сроков новых ПЗ в структуре программы.
//  * ЗадачиАктуализации                            - Массив
//  * ЗадачиАктуализацииРЦК                         - Массив
//  * МассивВерсий                                  - Массив
//  * МассивРЦК                                     - Соответствие - соответствие проектной задачи (с заполненным подчиненным проектом) и её документа РЦК.
//  * Проект                                        - СправочникСсылка.Проекты
//  * ТекущаяВерсия                                 - ДокументСсылка.упоВерсияПланаПроекта
//  * ПроектнаяЗадачаПриемник                       - ДокументСсылка.упоПроектнаяЗадача
//  * ПроектнаяЗадачаПриемникПерспективныхОбъемов   - ДокументСсылка.упоПроектнаяЗадача
//  * РабочийКалендарьПроекта                       - СправочникСсылка.упоРабочиеКалендари
//  * РодителиЗадач                                 - Соответствие
//  * СписокОтменяемыхЗадач                         - Массив
Процедура ВыполнитьИзменениеДанныхПрограммы(ПараметрыАктуализации) Экспорт
	
	ПроектнаяЗадачаПриемник = Неопределено;
	ПроектнаяЗадачаПриемникПерспективныхОбъемов = Неопределено;
	ЗадачиАктуализации = Неопределено;
	ПараметрыАктуализации.Свойство("ПроектнаяЗадачаПриемник", ПроектнаяЗадачаПриемник);
	ПараметрыАктуализации.Свойство("ЗадачиАктуализации", ЗадачиАктуализации);
	ПараметрыАктуализации.Свойство("ПроектнаяЗадачаПриемникПерспективныхОбъемов", ПроектнаяЗадачаПриемникПерспективныхОбъемов);
	
	ЗадачиАктуализации = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ЗадачиАктуализации);
	
	ВерсияКорневогоПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПараметрыАктуализации.Проект);
	
	НачатьТранзакцию();
	
	Попытка
		Если ПараметрыАктуализации.Свойство("СписокОтменяемыхЗадач") Тогда
			ОтменитьПроектныеЗадачиПриАктуализации(ПараметрыАктуализации.Проект, ПараметрыАктуализации.ТекущаяВерсия,
				ПараметрыАктуализации.СписокОтменяемыхЗадач);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПроектнаяЗадачаПриемник) И ЗначениеЗаполнено(ЗадачиАктуализации) Тогда
			АктуализируемыеЗадачи =
				ПолучитьСоздатьАктуализируемыеЗадачиИИзменитьТипЗадачиПриемника(ПроектнаяЗадачаПриемник,
					ЗадачиАктуализации, ПараметрыАктуализации, ПараметрыАктуализации.РодителиЗадач);
			
			АктуализироватьДанныеПрограммыПроектов(ВерсияКорневогоПроекта,
				АктуализируемыеЗадачи, ПараметрыАктуализации);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПроектнаяЗадачаПриемникПерспективныхОбъемов) Тогда
			АктуализироватьДанныеПрограммыПроектовПоРЦК(ВерсияКорневогоПроекта, ПроектнаяЗадачаПриемникПерспективныхОбъемов,
				ПараметрыАктуализации);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		СообщениеОшибки = ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Актуализация программы по проектам'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Во время выполнения действия произошла неизвестная ошибка.'") + Символы.ПС +
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение(СообщениеОшибки);
	КонецПопытки;
	
КонецПроцедуры

// Актуализировать данные структуры по подчиненным проектам. Актуализируются сроки и план доходов.
//
// Параметры:
//  ВерсияПрограммы - ДокументСсылка.упоВерсияПланаПроекта - Версия актуализируемой программы.
//  ПараметрыАктуализации - Структура:
//      * АктуализироватьПланДоходов - Булево
//  СписокЗадач - Массив Из ДокументСсылка.упоПроектнаяЗадача - Задачи актуализируемой программы.
//
Процедура АктуализироватьСтруктуруПоПодчиненнымПроектам(ВерсияПрограммы, ПараметрыАктуализации, СписокЗадач) Экспорт
	
	ДокументСохранения = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
	ДокументСохранения.Проект = ВерсияПрограммы.Проект;
	ДокументСохранения.Комментарий = НСтр("ru = 'Документ создан автоматически при актуализации данных по подчиненным проектам.'", "ru");
	
	АктуализироватьПланДоходов = Неопределено;
	ПараметрыАктуализации.Свойство("АктуализироватьПланДоходов", АктуализироватьПланДоходов);
	АктуализироватьПланДоходов = ?(АктуализироватьПланДоходов = Неопределено, Ложь, АктуализироватьПланДоходов);
	
	ПараметрыОчистки = Новый Структура;
	ПараметрыОчистки.Вставить("ОчищатьПланДоходов", АктуализироватьПланДоходов);
	
	ОчиститьДанныеПроектныхЗадач(ВерсияПрограммы, СписокЗадач, ПараметрыОчистки);
	
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы,
			СписокЗадач);
	СлужебныеКоллекции = Новый Структура("СписокЗадач, СвойстваПроектныхЗадачСоответствие", СписокЗадач, СвойстваПроектныхЗадачСоответствие);
	
	АктуализироватьДоходыСтруктурыПоПодчиненнымПроектам(ВерсияПрограммы, ДокументСохранения, Ложь, СлужебныеКоллекции);
	
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(ВерсияПрограммы.Проект, Истина, ВерсияПрограммы);
	ДанныеПоПодчиненным = ПолучитьДанныеСроковИГотовностиПоПодчиненным(ВерсияПрограммы.Проект, ДатаСтартаПроекта, СписокЗадач,
			ВерсияПрограммы);
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы);
	АктуализироватьСрокиИПроцентГотовностиЗадач(ВерсияПрограммы.Проект, ДокументСохранения, ДанныеПоПодчиненным, СвойстваПроектныхЗадачСоответствие);
	
	ЕстьДанныеДляЗаписи = ПроверитьНаличиеДанныхВДокументеСохраненияДанныхПроекта(ДокументСохранения);
	
	Если Не ЕстьДанныеДляЗаписи Тогда
		Возврат;
	КонецЕсли;
	
	ДокументСохранения.Дата = ТекущаяДатаСеанса();
	ДокументСохранения.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Структура параметров актуализации по умолчанию
//
// Возвращаемое значение:
//  ПараметрыАктуализации - Структура:
//  * АктуализироватьБДР - Булево
//  * АктуализироватьТрудозатраты - Булево
//  * АктуализироватьПланВыпускаПоДоходам - Булево
//  * УровеньПланирования - ПеречислениеСсылка.упоУровеньПланирования
//
Функция СтруктураПараметровАктуализацииПоУмолчанию() Экспорт
	
	ПараметрыАктуализации = Новый Структура();
	ПараметрыАктуализации.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Предварительный);
	ПараметрыАктуализации.Вставить("АктуализироватьБДР", Ложь);
	ПараметрыАктуализации.Вставить("АктуализироватьТрудозатраты", Ложь);
	ПараметрыАктуализации.Вставить("АктуализироватьПланВыпускаПоДоходам", Ложь);
	ПараметрыАктуализации.Вставить("АктуализироватьПланРасходов", Ложь);
	ПараметрыАктуализации.Вставить("АктуализироватьПланПоступленийДС", Ложь);
	ПараметрыАктуализации.Вставить("АктуализироватьПланВыплатДС", Ложь);
	
	Возврат ПараметрыАктуализации;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Получить, создать актуализируемые задачи и изменить тип задачи-приемника.
//
// Параметры:
//  ПроектнаяЗадачаПриемник - ДокументСсылка.упоПроектнаяЗадача
//  ВыбранныеЗадачи - Массив Из СправочникСсылка.Проекты - источники данных для актуализации.
//  ДопПараметры - Структура:
//  * Проект - СправочникСсылка.Проекты - актуализируемая программа.
//  РодителиЗадач - Соответствие
//
// Возвращаемое значение:
//  Массив - Существующие и созданные задачи актуализируемой структуры проекта.
//
Функция ПолучитьСоздатьАктуализируемыеЗадачиИИзменитьТипЗадачиПриемника(ПроектнаяЗадачаПриемник, ВыбранныеЗадачи, ДопПараметры, РодителиЗадач) Экспорт
	
	ИзменитьТипЗадачиКудаЭтап(ПроектнаяЗадачаПриемник);
	
	Возврат ПолучитьАктуализируемыеЗадачиИЗаполнитьДопПараметры(ПроектнаяЗадачаПриемник, ВыбранныеЗадачи, ДопПараметры, РодителиЗадач);
	
КонецФункции

Процедура ОчиститьДанныеПроектныхЗадач(ВерсияПрограммы, СписокЗадач, ПараметрыОчистки = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(СписокЗадач) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОчистки = Неопределено Тогда
		ПараметрыОчистки = Новый Структура;
	КонецЕсли;
	
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы, СписокЗадач);
	
	УровеньПланированияТрудозатрат = Неопределено;
	ПараметрыОчистки.Свойство("УровеньПланированияТрудозатрат", УровеньПланированияТрудозатрат);
	УровеньПланированияТрудозатрат = ?(УровеньПланированияТрудозатрат = Неопределено, Перечисления.упоУровеньПланирования.ПустаяСсылка(),
			УровеньПланированияТрудозатрат);
	ОчищатьТрудовыеРесурсы = ПараметрыОчистки.Свойство("ОчищатьТрудовыеРесурсы") И ПараметрыОчистки.ОчищатьТрудовыеРесурсы;
	ОчищатьПланДоходов = ПараметрыОчистки.Свойство("ОчищатьПланДоходов") И ПараметрыОчистки.ОчищатьПланДоходов;;
	ОчищатьСубпродукты = ПараметрыОчистки.Свойство("ОчищатьСубпродукты") И ПараметрыОчистки.ОчищатьСубпродукты;
	ОчищатьПланРасходов = ПараметрыОчистки.Свойство("ОчищатьПланРасходов") И ПараметрыОчистки.ОчищатьПланРасходов;
	ОчищатьПланПоступленийДС = ПараметрыОчистки.Свойство("ОчищатьПланПоступленийДС") И ПараметрыОчистки.ОчищатьПланПоступленийДС;
	ОчищатьПланВыплатДС = ПараметрыОчистки.Свойство("ОчищатьПланВыплатДС") И ПараметрыОчистки.ОчищатьПланВыплатДС;
	
	НетПлановДляОчистки = Не ОчищатьТрудовыеРесурсы И Не ОчищатьПланДоходов И Не ОчищатьСубпродукты И Не ОчищатьПланРасходов И Не ОчищатьПланПоступленийДС
		И Не ОчищатьПланВыплатДС;
	Если НетПлановДляОчистки Тогда
		Возврат;
	КонецЕсли;
	
	ДокументСохранения = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
	ДокументСохранения.Проект = ВерсияПрограммы.Проект;
	ДокументСохранения.Комментарий = НСтр("ru = 'Документ создан автоматически при актуализации данных по подчиненным проектам. Очистка данных'", "ru");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("текВерсия", ВерсияПрограммы);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	Запрос.УстановитьПараметр("УровеньПланированияТрудозатрат", УровеньПланированияТрудозатрат);
	
	ТекстЗапроса = ТекстЗапросаДанныеПЗДляОчистки();
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если ОчищатьТрудовыеРесурсы Тогда
		СоответствиеТЧТрудозатраты = Новый Соответствие();
		СоответствиеТЧТрудозатраты.Вставить("ТрудовыеРесурсыРоли", РезультатЗапроса[4].Выгрузить());
		СоответствиеТЧТрудозатраты.Вставить("ТрудовыеРесурсыРолиПоПериодам", РезультатЗапроса[5].Выгрузить());
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьТрудовыеРесурсыРоли",
			СоответствиеТЧТрудозатраты);
	КонецЕсли;
	
	Если ОчищатьПланДоходов Тогда
		СоответствиеТЧПланДоходов = Новый Соответствие();
		СоответствиеТЧПланДоходов.Вставить("ПланДоходов", РезультатЗапроса[6].Выгрузить());
		СоответствиеТЧПланДоходов.Вставить("ПланДоходовПоПодразделениям", РезультатЗапроса[8].Выгрузить());
		СоответствиеТЧПланДоходов.Вставить("ПланДоходовПоПериодам", РезультатЗапроса[9].Выгрузить());
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьПланДоходов", СоответствиеТЧПланДоходов);
	КонецЕсли;
	
	Если ОчищатьСубпродукты Тогда
		// Очистим выборочно данные трансляции ролей проектной продукции.
		Запрос.Текст = ТекстЗапросаДанныеТрансляцииТрудозатратПоПроектнойПродукции();
		ДанныеТрансляцииТрудозатратИзСубпродуктов = Запрос.ВыполнитьПакет();
		ТрудовыеРесурсыРоли = ДанныеТрансляцииТрудозатратИзСубпродуктов[1].Выгрузить();
		ТрудовыеРесурсыРолиПоПериодам = ДанныеТрансляцииТрудозатратИзСубпродуктов[2].Выгрузить();
		
		СоответствиеТЧТрудозатраты = Новый Соответствие();
		СоответствиеТЧТрудозатраты.Вставить("ТрудовыеРесурсыРоли", ТрудовыеРесурсыРоли);
		СоответствиеТЧТрудозатраты.Вставить("ТрудовыеРесурсыРолиПоПериодам", ТрудовыеРесурсыРолиПоПериодам);
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьТрудовыеРесурсыРоли", СоответствиеТЧТрудозатраты);
		
		// Отключим трансляцию затрат из субпродуктов и установим тип "Номенклатура".
		Для каждого ДанныеСвойств Из СвойстваПроектныхЗадачСоответствие Цикл
			СвойстваПроектнойЗадачи = ДанныеСвойств.Значение;
			
			СтрокаСвойствПЗВДокументеСДП = ДокументСохранения.ПроектныеЗадачи.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСвойствПЗВДокументеСДП, СвойстваПроектнойЗадачи);
			СтрокаСвойствПЗВДокументеСДП.ТранслироватьЗатратыПоСубпродуктам = Ложь;
			СтрокаСвойствПЗВДокументеСДП.ВключитьСубпродуктыВПланДоходов = Ложь;
			СтрокаСвойствПЗВДокументеСДП.ТипСубпродукта = Перечисления.упоТипСубпродукта.Номенклатура;
		КонецЦикла;
		
		// Очистим план выпуска.
		СоответствиеТЧОбъемы = Новый Соответствие();
		СоответствиеТЧОбъемы.Вставить("Субпродукты", РезультатЗапроса[0].Выгрузить());
		СоответствиеТЧОбъемы.Вставить("СубпродуктыПоПодразделениям", РезультатЗапроса[2].Выгрузить());
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьСубпродукты", СоответствиеТЧОбъемы);
	КонецЕсли;
	
	Если ОчищатьПланРасходов Тогда
		СоответствиеТЧПланРасходов = Новый Соответствие();
		СоответствиеТЧПланРасходов.Вставить("ПланРасходов", РезультатЗапроса[10].Выгрузить());
		СоответствиеТЧПланРасходов.Вставить("ПланРасходовПоПодразделениям", РезультатЗапроса[12].Выгрузить());
		СоответствиеТЧПланРасходов.Вставить("ПланРасходовПоПериодам", РезультатЗапроса[13].Выгрузить());
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьПланРасходов", СоответствиеТЧПланРасходов);
	КонецЕсли;
	
	Если ОчищатьПланПоступленийДС Тогда
		СоответствиеТЧПланПоступленийДС = Новый Соответствие();
		СоответствиеТЧПланПоступленийДС.Вставить("ДвиженияДенежныхСредств", РезультатЗапроса[14].Выгрузить());
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьДвиженияДенежныхСредств", СоответствиеТЧПланПоступленийДС);
	КонецЕсли;
	
	Если ОчищатьПланВыплатДС Тогда
		СоответствиеТЧПланВыплатДС = Новый Соответствие();
		СоответствиеТЧПланВыплатДС.Вставить("ДвиженияДенежныхСредств", РезультатЗапроса[15].Выгрузить());
		ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, "ПерезаписатьДвиженияДенежныхСредств", СоответствиеТЧПланВыплатДС);
	КонецЕсли;
	
	ЕстьДанныеДляЗаписи = ПроверитьНаличиеДанныхВДокументеСохраненияДанныхПроекта(ДокументСохранения);
	
	Если Не ЕстьДанныеДляЗаписи Тогда
		Возврат;
	КонецЕсли;
			
	ДокументСохранения.Дата = ТекущаяДатаСеанса();
	ДокументСохранения.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура УбратьНедоступныеКАктуализацииПоПодчиненнымПроектамЗадачи(ПроектныеЗадачи, Проект) Экспорт
	
	ВыводитьСообщениеОбОшибке = Истина;
	ПроектныеОпции = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	ЗапретитьРПЗИзменятьСрокиЧужихЗадач = ПроектныеОпции.ЗапретитьРПЗИзменятьСрокиЧужихЗадач;
	
	СтруктураСроковПроектныхЗадач = ТекущиеСрокиИСрокиПоПодчиненномуПроектуПроектнойЗадачи(ПроектныеЗадачи, Проект);
	
	// Данных для актуализации на дату старта проекта нет.
	Если Не ЗначениеЗаполнено(СтруктураСроковПроектныхЗадач) Тогда
		Возврат;
	КонецЕсли;
	
	ИндексПоследнего = ПроектныеЗадачи.ВГраница();
	Пока ИндексПоследнего <> -1 Цикл
		ПроектнаяЗадача = ПроектныеЗадачи[ИндексПоследнего];
		
		// Проверим доступность по статусам.
		ЕстьОграниченияИзмененияТекущейЗадачи = упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(
				ПроектнаяЗадача, "Форма", , , Истина);
		Если ЕстьОграниченияИзмененияТекущейЗадачи Тогда
			ПроектныеЗадачи.Удалить(ИндексПоследнего);
			ИндексПоследнего = ИндексПоследнего - 1;
			Продолжить;
		КонецЕсли;
		
		// Проверим на доступность изменения сроков вышестоящих задач.
		Если Не ЗапретитьРПЗИзменятьСрокиЧужихЗадач Тогда
			ИндексПоследнего = ИндексПоследнего - 1;
			Продолжить;
		КонецЕсли;
		
		СрокиПроектнойЗадачи = СтруктураСроковПроектныхЗадач.Получить(ПроектнаяЗадача);
		Если СрокиПроектнойЗадачи = Неопределено Тогда
			ИндексПоследнего = ИндексПоследнего + 1;
			Продолжить;
		КонецЕсли;
		
		СрокиИзменились = СрокиПроектнойЗадачи.ДатаНачала <> СрокиПроектнойЗадачи.ДатаНачалаПодчиненного
			Или СрокиПроектнойЗадачи.ДатаЗавершения <> СрокиПроектнойЗадачи.ДатаЗавершенияПодчиненного;
		Если Не СрокиИзменились Тогда
			ИндексПоследнего = ИндексПоследнего - 1;
			Продолжить;
		КонецЕсли;
		
		НельзяИзменятьСрокиРодителя = Ложь;
		ПроверитьДоступностьИзмененияСроковПроектнойЗадачи(ПроектнаяЗадача, НельзяИзменятьСрокиРодителя, ВыводитьСообщениеОбОшибке);
		Если НельзяИзменятьСрокиРодителя Тогда
			ПроектныеЗадачи.Удалить(ИндексПоследнего);
		КонецЕсли;
		
		ИндексПоследнего = ИндексПоследнего - 1;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, доступна ли задача для актуализации программы по проектам.
//
// Параметры:
//  ПроектнаяЗадача                 - ДокументСсылка.упоПроектнаяЗадача
//  Проект                          - СправочникСсылка.Проекты
//  ИсточникДанныхДляАктуализации   - ДокументСсылка.упоВерсияПланаПроекта, ДокументСсылка.упоРасчетЦеныКонтракта
//  ЗапрещеноИзменятьСроки          - Булево - признак, рассчитывающийся в форме структуры проекта.
//  Отказ                           - Булево
//
Процедура ЗадачаДоступнаДляАктуализацииПрограммыПоПроектам(ПроектнаяЗадача,
		Проект,
		ИсточникДанныхДляАктуализации,
		ЗапрещеноИзменятьСроки,
		Отказ = Ложь) Экспорт
	
	// Если задача новая в списке на актуализацию, то выполним одну проверку на запрет изменения сроков.
	Если Не ЗначениеЗаполнено(ПроектнаяЗадача) И ЗапрещеноИзменятьСроки Тогда
		Отказ = Истина;
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		Отказ = Ложь;
		Возврат;
	КонецЕсли;
	
	// Сначала проверим, является ли текущий пользователь РПЗ.
	упоПроектыИЗадачиВызовСервера.обПроверитьПолномочияПользователяПроектнойЗадачи(ПроектнаяЗадача,
		Отказ, "", Ложь);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Теперь проверим разграничение по статусу.
	упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(
		ПроектнаяЗадача, , Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Наконец, узнаем, не влияет ли текущая задача на сроки родителя.
	Если Не ЗапрещеноИзменятьСроки Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсточникДанныхДляАктуализации) Тогда
		Возврат;
	КонецЕсли;
	
	ПроектныеЗадачи = Новый Массив;
	ПроектныеЗадачи.Добавить(ПроектнаяЗадача);
	ЭтоРЦК = ТипЗнч(ИсточникДанныхДляАктуализации) = Тип("ДокументСсылка.упоРасчетЦеныКонтракта");
	Если ЭтоРЦК Тогда
		ВерсииПодчиненныхИлиРЦК = Новый Соответствие;
		ВерсииПодчиненныхИлиРЦК.Вставить(ПроектнаяЗадача, ИсточникДанныхДляАктуализации);
	Иначе
		ВерсииПодчиненныхИлиРЦК = Новый Массив;
		ВерсииПодчиненныхИлиРЦК.Добавить(ИсточникДанныхДляАктуализации);
	КонецЕсли;
	
	СтруктураСроковПроектныхЗадач = ТекущиеСрокиИСрокиПоПодчиненномуПроектуПроектнойЗадачи(ПроектныеЗадачи, Проект,
		ВерсииПодчиненныхИлиРЦК, ЭтоРЦК);
	СрокиПроектнойЗадачи = СтруктураСроковПроектныхЗадач.Получить(ПроектнаяЗадача);
	Если СрокиПроектнойЗадачи = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СрокиИзменились = СрокиПроектнойЗадачи.ДатаНачала <> СрокиПроектнойЗадачи.ДатаНачалаПодчиненного
		Или СрокиПроектнойЗадачи.ДатаЗавершения <> СрокиПроектнойЗадачи.ДатаЗавершенияПодчиненного;
	Если Не СрокиИзменились Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьДоступностьИзмененияСроковПроектнойЗадачи(ПроектнаяЗадача, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Актуализировать данные программы проектов.
//
// Параметры:
//  ВерсияПрограммы - ДокументСсылка.упоВерсияПланаПроекта - Версия актуализируемой программы.
//  СписокЗадач - Массив Из ДокументСсылка.упоПроектнаяЗадача - Задачи актуализируемой программы.
//  СписокВерсий - Массив Из ДокументСсылка.упоВерсияПланаПроекта - Версии подчиненных проектов.
//  ПараметрыАктуализации - Структура:
//  * АктуализироватьБДР - Булево
//  * АктуализироватьТрудозатраты - Булево
//  * АктуализироватьПланВыпускаПоДоходам - Булево
//  * УровеньПланирования - ПеречислениеСсылка.упоУровеньПланирования
//
Процедура АктуализироватьДанныеПрограммыПроектов(ВерсияПрограммы, СписокЗадач, ПараметрыАктуализации)
	
	// Получим доп. параметры и проверим их заполнение.
	МассивВерсий = Неопределено;
	УровеньПланированияТрудозатрат = Неопределено;
	АктуализироватьПланДоходов = Неопределено;
	АктуализироватьПланВыпускаПоДоходам = Неопределено;
	АктуализироватьПланРасходов = Неопределено;
	АктуализироватьПланПоступленийДС = Неопределено;
	АктуализироватьПланВыплатДС = Неопределено;
	АктуализироватьТрудозатраты = Неопределено;
	АктуализироватьПланВыпуска = Неопределено;
	
	ПараметрыАктуализации.Свойство("МассивВерсий", МассивВерсий);
	ПараметрыАктуализации.Свойство("УровеньПланирования", УровеньПланированияТрудозатрат);
	ПараметрыАктуализации.Свойство("АктуализироватьПланДоходов", АктуализироватьПланДоходов);
	ПараметрыАктуализации.Свойство("АктуализироватьТрудозатраты", АктуализироватьТрудозатраты);
	ПараметрыАктуализации.Свойство("АктуализироватьПланВыпускаПоДоходам", АктуализироватьПланВыпускаПоДоходам);
	ПараметрыАктуализации.Свойство("АктуализироватьПланРасходов", АктуализироватьПланРасходов);
	ПараметрыАктуализации.Свойство("АктуализироватьПланПоступленийДС", АктуализироватьПланПоступленийДС);
	ПараметрыАктуализации.Свойство("АктуализироватьПланВыплатДС", АктуализироватьПланВыплатДС);
	ПараметрыАктуализации.Свойство("АктуализироватьПланВыпуска", АктуализироватьПланВыпуска);
	
	// Если параметры не были указаны, то устанавливаем их в Ложь.
	АктуализироватьПланДоходов = ?(АктуализироватьПланДоходов = Неопределено, Ложь, АктуализироватьПланДоходов);
	АктуализироватьПланВыпускаПоДоходам = ?(АктуализироватьПланВыпускаПоДоходам = Неопределено, Ложь, АктуализироватьПланВыпускаПоДоходам);
	АктуализироватьПланРасходов = ?(АктуализироватьПланРасходов = Неопределено, Ложь, АктуализироватьПланРасходов);
	АктуализироватьПланПоступленийДС = ?(АктуализироватьПланПоступленийДС = Неопределено, Ложь, АктуализироватьПланПоступленийДС);
	АктуализироватьПланВыплатДС = ?(АктуализироватьПланВыплатДС = Неопределено, Ложь, АктуализироватьПланВыплатДС);
	АктуализироватьТрудозатраты = ?(АктуализироватьТрудозатраты = Неопределено, Ложь, АктуализироватьТрудозатраты);
	АктуализироватьПланВыпуска = ?(АктуализироватьПланВыпуска = Неопределено, Ложь, АктуализироватьПланВыпуска);
	МассивВерсий = ?(МассивВерсий = Неопределено, Новый Массив, МассивВерсий);
	
	ПараметрыОчистки = Новый Структура;
	ПараметрыОчистки.Вставить("УровеньПланированияТрудозатрат", УровеньПланированияТрудозатрат);
	ПараметрыОчистки.Вставить("ОчищатьПланДоходов", АктуализироватьПланДоходов);
	ПараметрыОчистки.Вставить("ОчищатьСубпродукты", АктуализироватьПланВыпускаПоДоходам Или АктуализироватьПланВыпуска);
	ПараметрыОчистки.Вставить("ОчищатьТрудовыеРесурсы", АктуализироватьТрудозатраты);
	ПараметрыОчистки.Вставить("ОчищатьПланРасходов", АктуализироватьПланРасходов);
	ПараметрыОчистки.Вставить("ОчищатьПланПоступленийДС", АктуализироватьПланПоступленийДС);
	ПараметрыОчистки.Вставить("ОчищатьПланВыплатДС", АктуализироватьПланВыплатДС);
	
	ОчиститьДанныеПроектныхЗадач(ВерсияПрограммы, СписокЗадач, ПараметрыОчистки);
	
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(ВерсияПрограммы.Проект, Истина, ВерсияПрограммы);
	СрокиИПроцентГотовностиПодчиненныхПроектов = ПолучитьДанныеСроковИГотовностиПоПодчиненным(ВерсияПрограммы.Проект,
		ДатаСтартаПроекта, СписокЗадач, ВерсияПрограммы, МассивВерсий);
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы, СписокЗадач);
	СлужебныеКоллекции = Новый Структура("СписокЗадач, СписокВерсий, СвойстваПроектныхЗадачСоответствие", СписокЗадач,
			МассивВерсий, СвойстваПроектныхЗадачСоответствие);
	
	ДокументСохранения = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
	ДокументСохранения.Проект = ВерсияПрограммы.Проект;
	ДокументСохранения.Комментарий = НСтр("ru = 'Документ создан автоматически при актуализации данных программы по подчиненным проектам.'", "ru");
	
	Если АктуализироватьПланДоходов Тогда
		НаправлениеБДР = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход;
		АктуализироватьПланДоходовРасходов(НаправлениеБДР, ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции);
	КонецЕсли;
	
	Если АктуализироватьПланВыпускаПоДоходам Тогда
		АктуализироватьСубпродукты(ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции, Истина);
	КонецЕсли;
	
	Если АктуализироватьПланРасходов Тогда
		НаправлениеБДР = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход;
		АктуализироватьПланДоходовРасходов(НаправлениеБДР, ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции);
	КонецЕсли;
	
	Если АктуализироватьПланПоступленийДС Тогда
		НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление;
		ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход;
		АктуализироватьПланПоступленийВыплатДС(ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции, НаправлениеДвижения, ВидЭлемента);
	КонецЕсли;
	
	Если АктуализироватьПланВыплатДС Тогда
		НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата;
		ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход;
		АктуализироватьПланПоступленийВыплатДС(ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции, НаправлениеДвижения, ВидЭлемента);
	КонецЕсли;
	
	Если АктуализироватьТрудозатраты Тогда
		АктуализироватьТрудозатраты(ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции, УровеньПланированияТрудозатрат);
	КонецЕсли;
	
	Если АктуализироватьПланВыпуска Тогда
		АктуализироватьСубпродукты(ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции);
	КонецЕсли;
	
	// Актуализировать сроки.
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы);
	АктуализироватьСрокиИПроцентГотовностиЗадач(ВерсияПрограммы.Проект, ДокументСохранения, СрокиИПроцентГотовностиПодчиненныхПроектов, СвойстваПроектныхЗадачСоответствие);
	
	ЕстьДанныеДляЗаписи = ПроверитьНаличиеДанныхВДокументеСохраненияДанныхПроекта(ДокументСохранения);
	
	Если Не ЕстьДанныеДляЗаписи Тогда
		Возврат;
	КонецЕсли;
		
	ДокументСохранения.Дата = ТекущаяДатаСеанса();
	ДокументСохранения.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

// Актуализировать данные программы проектов по документам "Расчет цены контракта".
//
// Параметры:
//  ВерсияПрограммы			 - ДокументСсылка.упоВерсияПланаПроекта	 - Версия актуализируемой проекта-программы.
//  АктуализируемыйЭтап		 - ДокументСсылка.упоПроектнаяЗадача
//  ДанныеДляАктуализации	 - Структура
//  ДопПараметрыАктуализации - Структура
//
Процедура АктуализироватьДанныеПрограммыПроектовПоРЦК(ВерсияПрограммы, АктуализируемыйЭтап, ДанныеДляАктуализации)
	
	СписокПроектовРЦК = Неопределено;
	СписокДокументовРЦК = Неопределено;
	ДанныеДляАктуализации.Свойство("СписокПроектовРЦК", СписокПроектовРЦК);
	ДанныеДляАктуализации.Свойство("СписокДокументовРЦК", СписокДокументовРЦК);
	
	Если Не ЗначениеЗаполнено(СписокПроектовРЦК) Или Не ЗначениеЗаполнено(СписокДокументовРЦК) Тогда
		Возврат;
	КонецЕсли;
	
	РодителиЗадач = Неопределено;
	ДанныеДляАктуализации.Свойство("РодителиЗадач", РодителиЗадач);
	// Если параметры не были указаны, то устанавливаем инициализируем их как пустые массивы.
	РодителиЗадач = ?(РодителиЗадач = Неопределено, Новый Массив, РодителиЗадач);
	
	ДокументСохранения = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
	ДокументСохранения.Проект = ВерсияПрограммы.Проект;
	ДокументСохранения.Комментарий = НСтр("ru = 'Документ создан автоматически при актуализации данных по подчиненным проектам (РЦК).'", "ru");
	
	ПараметрыОчистки = Новый Структура;
	ПараметрыОчистки.Вставить("УровеньПланированияТрудозатрат", ДанныеДляАктуализации.УровеньПланирования);
	ПараметрыОчистки.Вставить("ОчищатьТрудовыеРесурсы", ДанныеДляАктуализации.АктуализироватьТрудозатраты);
	ПараметрыОчистки.Вставить("ОчищатьПланДоходов", ДанныеДляАктуализации.АктуализироватьПланДоходов);
	ПараметрыОчистки.Вставить("ОчищатьСубпродукты", ДанныеДляАктуализации.АктуализироватьПланВыпускаПоДоходам);
	
	ИзменитьТипЗадачиКудаЭтап(АктуализируемыйЭтап);
	
	СписокЗадачПоРЦК = ПолучитьАктуализируемыеЗадачиПоДокументамРЦК(АктуализируемыйЭтап, СписокПроектовРЦК,
			СписокДокументовРЦК, ДанныеДляАктуализации, РодителиЗадач);
	
	ОчиститьДанныеПроектныхЗадач(ВерсияПрограммы, СписокЗадачПоРЦК, ПараметрыОчистки);
	
	СлужебныеКоллекции = Новый Структура("СписокЗадач, СвойстваПроектныхЗадачСоответствие");
	СлужебныеКоллекции.Вставить("СписокЗадач", СписокЗадачПоРЦК);
	
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы,
			СписокЗадачПоРЦК);
	СлужебныеКоллекции.Вставить("СвойстваПроектныхЗадачСоответствие", СвойстваПроектныхЗадачСоответствие);
	
	Если Не ЗначениеЗаполнено(СписокЗадачПоРЦК) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеДляАктуализации.АктуализироватьТрудозатраты Тогда
		АктуализироватьТрудозатратыПоДокументамРЦК(ВерсияПрограммы, ДокументСохранения, СписокЗадачПоРЦК,
			СписокДокументовРЦК, ДанныеДляАктуализации.УровеньПланирования);
	КонецЕсли;
	
	Если ДанныеДляАктуализации.АктуализироватьПланДоходов Тогда
		АктуализироватьПланДоходовПоДокументамРЦК(ВерсияПрограммы, ДокументСохранения, СписокЗадачПоРЦК,
			СписокДокументовРЦК, ДанныеДляАктуализации);
	КонецЕсли;
	
	Если ДанныеДляАктуализации.АктуализироватьПланВыпускаПоДоходам Тогда
		АктуализироватьСубпродуктыПоДокументамРЦК(ВерсияПрограммы, ДокументСохранения, СлужебныеКоллекции,
			СписокДокументовРЦК, ДанныеДляАктуализации);
	КонецЕсли;
	
	ДанныеСроковПроектныхЗадач = ДанныеСроковПроектныхЗадачПоРЦК(СписокЗадачПоРЦК, СписокДокументовРЦК);
	СвойстваПроектныхЗадачСоответствие =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ВерсияПрограммы);
	АктуализироватьСрокиИПроцентГотовностиЗадач(ВерсияПрограммы.Проект, ДокументСохранения, ДанныеСроковПроектныхЗадач,
		СвойстваПроектныхЗадачСоответствие, Истина);
	
	ЕстьДанныеДляЗаписи = ПроверитьНаличиеДанныхВДокументеСохраненияДанныхПроекта(ДокументСохранения);
	
	Если Не ЕстьДанныеДляЗаписи Тогда
		Возврат;
	КонецЕсли;
	
	ДокументСохранения.Дата = ТекущаяДатаСеанса();
	ДокументСохранения.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ОтменитьПроектныеЗадачиПриАктуализации(Проект, ТекущаяВерсия, СписокПроектныхЗадач)
	
	Если Не ЗначениеЗаполнено(СписокПроектныхЗадач) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &ТекущаяВерсия
		|				И ПроектнаяЗадача В (&СписокПроектныхЗадач)) КАК упоСвойстваПроектныхЗадачСрезПоследних";
	
	Запрос.УстановитьПараметр("СписокПроектныхЗадач", СписокПроектныхЗадач);
	Запрос.УстановитьПараметр("ТекущаяВерсия", ТекущаяВерсия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДокументСохранение = Документы.упоСохранениеДанныхПроекта.ПолучитьОбъектДляСохраненияДанныхПроекта(Проект);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока = ДокументСохранение.ПроектныеЗадачи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи); 
		НоваяСтрока.ЗадачаОтменена = Истина;
	КонецЦикла;
	
	ДокументСохранение.Комментарий = нСтр("ru='Создан автоматически при актуализации программы проекта.'", "ru");
	
	Попытка
		ДокументСохранение.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(нСтр("ru='Актуализация программы проектов.'", "ru"), УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнениеТЧДокументаСохраненияДляОчистки(ДокументСохранения, ИмяСвойстваПерезаписать, СоответствиеТЧ)
	
	ДокументСохранения[ИмяСвойстваПерезаписать] = Истина;
	
	Для каждого ТЧ Из СоответствиеТЧ Цикл
		Для каждого Строка Из ТЧ.Значение Цикл
			НоваяСтрока = ДокументСохранения[ТЧ.Ключ].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьНаличиеДанныхВДокументеСохраненияДанныхПроекта(ДокументСохранения)
	
	ТабЧастиСДП = Метаданные.Документы.упоСохранениеДанныхПроекта.ТабличныеЧасти;
	
	ЕстьДанныеДляЗаписи = Ложь;
	
	Для каждого Таблица Из ТабЧастиСДП Цикл
		Если ЗначениеЗаполнено(ДокументСохранения[Таблица.Имя]) Тогда
			ЕстьДанныеДляЗаписи = Истина;
			Возврат ЕстьДанныеДляЗаписи;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьДанныеДляЗаписи;
	
КонецФункции

Процедура ПроверитьДоступностьИзмененияСроковПроектнойЗадачи(ПроектнаяЗадача, Отказ = Ложь, ВыводитьСообщение = Ложь)
	
	ЗадачаРодитель = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача, "ЗадачаРодитель");
	Если ЗначениеЗаполнено(ЗадачаРодитель) Тогда
		ПроверитьДоступностьИзмененияСроковПроектнойЗадачи(ЗадачаРодитель, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	НазваниеПроектнойЗадачи = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача, "НазваниеЗадачи");
	ТекстСообщения = НСтр("ru = 'Невозможно актуализировать выбранные элементы по подчиненным, т.к. установлен запрет на изменение сроков чужих задач
			|(обнаружено вероятное изменение сроков задачи ""%1"").'");
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НазваниеПроектнойЗадачи);
	упоПроектыИЗадачиВызовСервера.обПроверитьПолномочияПользователяПроектнойЗадачи(ПроектнаяЗадача,
		Отказ, ТекстСообщения, ВыводитьСообщение);
	
КонецПроцедуры

Функция ТекущиеСрокиИСрокиПоПодчиненномуПроектуПроектнойЗадачи(ПроектныеЗадачи, Проект, ВерсииПодчиненныхИлиРЦК = Неопределено, ЭтоРЦК = Ложь)
	
	СтруктураТекущихСроковИСроковПоПодчиненным = Новый Соответствие;
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(Проект, Истина);
	ТекущаяВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	СрокиПроектныхЗадач =
		упоАктуализацияПроектаВызовСервера.СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ТекущаяВерсияПроекта,
			ПроектныеЗадачи);
	Если ЭтоРЦК Тогда
		СрокиПоПодчиненным = ДанныеСроковПроектныхЗадачПоРЦК(ПроектныеЗадачи, ВерсииПодчиненныхИлиРЦК);
	Иначе
		СрокиПоПодчиненным = ПолучитьДанныеСроковИГотовностиПоПодчиненным(Проект, ДатаСтартаПроекта,
			ПроектныеЗадачи, , ВерсииПодчиненныхИлиРЦК);
	КонецЕсли;
	
	Для каждого ДанныеПодчиненного Из СрокиПоПодчиненным Цикл
		СвойстваПроектнойЗадачи = СрокиПроектныхЗадач[ДанныеПодчиненного.ПроектнаяЗадача];
		
		Сроки = Новый Структура("ДатаНачала, ДатаЗавершения, ДатаНачалаПодчиненного, ДатаЗавершенияПодчиненного");
		Сроки.Вставить("ДатаНачала", СвойстваПроектнойЗадачи.ДатаНачалаПлан);
		Сроки.Вставить("ДатаЗавершения", СвойстваПроектнойЗадачи.ДатаЗавершенияПлан);
		Сроки.Вставить("ДатаНачалаПодчиненного", ДанныеПодчиненного.ДатаНачалаПлан);
		Сроки.Вставить("ДатаЗавершенияПодчиненного", ДанныеПодчиненного.ДатаЗавершенияПлан);
		
		СтруктураТекущихСроковИСроковПоПодчиненным.Вставить(ДанныеПодчиненного.ПроектнаяЗадача, Сроки);
	КонецЦикла;
	
	Возврат СтруктураТекущихСроковИСроковПоПодчиненным;
	
КонецФункции

#Область СозданиеИзменениеАктуализируемыхЗадач

Процедура ИзменитьРодителяПроектнойЗадачи(ВерсияПроекта, ПроектнаяЗадача, РодительПроектнойЗадачи)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &Версия
		|				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних";
	
	Запрос.УстановитьПараметр("Версия", ВерсияПроекта);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	Если ВыборкаДетальныеЗаписи.ЗадачаРодитель = РодительПроектнойЗадачи Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.упоСвойстваПроектныхЗадач.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(ПроектнаяЗадача);
	НоваяЗапись = НаборЗаписей.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
	НоваяЗапись.Период = ТекущаяДатаСеанса();
	НоваяЗапись.ЗадачаРодитель = РодительПроектнойЗадачи;
	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	упоПроектыИЗадачиСервер.СоздатьОбновитьСвязанныйЭлементСправочникаПроекты(ПроектнаяЗадача.ПолучитьОбъект());
	
КонецПроцедуры

Процедура ИзменитьТипЗадачи(ПроектнаяЗадача, ТипЗадачиЭтап)
	
	ПроектнаяЗадачаОб = ПроектнаяЗадача.ПолучитьОбъект();
	ПроектнаяЗадачаОб.ПолучитьДанныеВерсии(Неопределено);
	ПроектнаяЗадачаОб.ТипПроектнойЗадачи = ТипЗадачиЭтап;
	ПроектнаяЗадачаОб.РучнойВводСроков = Истина;
	
	ЗаписатьПроектнуюЗадачу(ПроектнаяЗадачаОб);
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоАктируемымЭтапамПоПолученнымТаблицам(ДанныеПоАктирЭтапам, ДоходыРасходы,
		РаспределениеПоПодразделениям)
	
	РеквизитыПоиска = "АктируемыйЭтап, Статья, ВидЭлемента, Контрагент, Договор, СпособПривязки, ДатаПривязки, Валюта, 
		|ИсточникПлана, ПрофильРаспределения";
	
	РаспределениеПоПодразделениям.Индексы.Добавить(РеквизитыПоиска);
	
	Отбор = Новый Структура(РеквизитыПоиска);
	ГруппировкаПоАктируемомуЭтапу = ДоходыРасходы.Строки;
	
	// Чтобы два раза не делать поиск по таблице РаспределениеПоПодразделениям, сразу заполним Индекс распределения
	Для Каждого СтрокаДерева Из ГруппировкаПоАктируемомуЭтапу Цикл
		
		ИндексРаспределения = 1;
		ТаблицаДоходов = ПолучитьПустуюТаблицуПоКолонкамЗаданногоПараметра(ДоходыРасходы);
		ТаблицаРаспределенияДоходов = ПолучитьПустуюТаблицуПоКолонкамЗаданногоПараметра(РаспределениеПоПодразделениям);
		Для Каждого Строка Из СтрокаДерева.Строки Цикл
			
			ЗаполнитьЗначенияСвойств(Отбор, Строка);
			
			НайденныеСтроки = РаспределениеПоПодразделениям.НайтиСтроки(Отбор);
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НайденнаяСтрока.ИндексСтрокиВладельца = ИндексРаспределения;
				СтрокаРаспределения = ТаблицаРаспределенияДоходов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, НайденнаяСтрока);
			КонецЦикла;
			Строка.ИндексСтрокРаспределения = ИндексРаспределения;
			
			СтрокаДоходовРасходов = ТаблицаДоходов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДоходовРасходов, Строка);
			
			ИндексРаспределения = ИндексРаспределения + 1;
			
		КонецЦикла;
		
		ДанныеАктируемогоЭтапа = Новый Структура;
		ДанныеАктируемогоЭтапа.Вставить("ТаблицаДоходов", ТаблицаДоходов);
		ДанныеАктируемогоЭтапа.Вставить("ТаблицаРаспределенияДоходов", ТаблицаРаспределенияДоходов);
		СтрокаТаблицы = ДанныеПоАктирЭтапам.Добавить();
		СтрокаТаблицы.АктируемыйЭтап = СтрокаДерева.АктируемыйЭтап;
		СтрокаТаблицы.ДанныеАктируемогоЭтапа = ДанныеАктируемогоЭтапа;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоАктируемымЭтапамРекурсивно(ПроектнаяЗадача, ДанныеПоПроекту, ДанныеПоАктируемымЭтапам,
		БылАктируемыйЭтап, ПервыйАктируемыйЭтап)
	
	Отбор = Новый Структура("ЗадачаРодитель", ПроектнаяЗадача);
	ЗадачиТекущегоУровня = ДанныеПоПроекту.НайтиСтроки(Отбор);
	
	Для Каждого Строка Из ЗадачиТекущегоУровня Цикл
		
		Если БылАктируемыйЭтап Тогда
			
			СтрокаДанныхАктЭтапов = ДанныеПоАктируемымЭтапам.Добавить();
			СтрокаДанныхАктЭтапов.АктируемыйЭтап = ПервыйАктируемыйЭтап;
			СтрокаДанныхАктЭтапов.БылАктируемыйЭтап = БылАктируемыйЭтап;
			СтрокаДанныхАктЭтапов.ПроектнаяЗадача = Строка.ПроектнаяЗадача;
			
			ЗаполнитьДанныеПоАктируемымЭтапамРекурсивно(Строка.ПроектнаяЗадача, ДанныеПоПроекту, ДанныеПоАктируемымЭтапам,
				БылАктируемыйЭтап, ПервыйАктируемыйЭтап);
			
		Иначе
			
			Если Строка.ЭтоАктируемаяЗадача Тогда
				
				ЗаполнитьДанныеПоАктируемымЭтапамРекурсивно(Строка.ПроектнаяЗадача, ДанныеПоПроекту, ДанныеПоАктируемымЭтапам,
					Истина, Строка.ПроектнаяЗадача);
				
				СтрокаДанныхАктЭтапов = ДанныеПоАктируемымЭтапам.Добавить();
				СтрокаДанныхАктЭтапов.АктируемыйЭтап = Строка.ПроектнаяЗадача;
				СтрокаДанныхАктЭтапов.БылАктируемыйЭтап = Истина;
				СтрокаДанныхАктЭтапов.ПроектнаяЗадача = Строка.ПроектнаяЗадача;
				
			Иначе
				
				ЗаполнитьДанныеПоАктируемымЭтапамРекурсивно(Строка.ПроектнаяЗадача, ДанныеПоПроекту, ДанныеПоАктируемымЭтапам,
					БылАктируемыйЭтап, ПервыйАктируемыйЭтап);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДопДанныеДляСозданияПЗ(Проект, ВерсияПроекта)
	
	РабочийКалендарьПроекта = Проект.ПолучитьОбъект().ПолучитьРабочийКалендарь();
	ЕдиницаНормированияДлительности = ПолучитьЕдиницаНормированияДлительности(Проект);
	ТипПроектнойЗадачи = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
	ДатаСтартаПроекта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(Проект, Истина, ВерсияПроекта);
	
	ДопДанные = Новый Структура;
	ДопДанные.Вставить("Проект", Проект);
	ДопДанные.Вставить("ВерсияПроекта", ВерсияПроекта);
	ДопДанные.Вставить("РабочийКалендарьПроекта", РабочийКалендарьПроекта);
	ДопДанные.Вставить("ЕдиницаНормированияДлительности", ЕдиницаНормированияДлительности);
	ДопДанные.Вставить("ТипПроектнойЗадачи", ТипПроектнойЗадачи);
	ДопДанные.Вставить("ОбновленныеПЗ", Новый Соответствие);
	ДопДанные.Вставить("ТолькоОбновлениеЗадачи", Ложь);
	ДопДанные.Вставить("ДатаСтартаПроекта", ДатаСтартаПроекта);
	
	Возврат ДопДанные;
	
КонецФункции

Функция ПолучитьДетейЗаданнойЗадачи(ЗадачаРодитель, Версия)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненнаяПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПодчиненнаяПроектнаяЗадача
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|ГДЕ
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = &ЗадачаРодитель
		|	И НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
		|	И НЕ упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненнаяПроектнаяЗадача.СсылкаНаПроектнуюЗадачу ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ЗадачаРодитель", ЗадачаРодитель);
	Запрос.УстановитьПараметр("Версия", Версия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Таблица = РезультатЗапроса.Выгрузить();
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьЕдиницаНормированияДлительности(Проект)
	
	// Единица измерения скопировано из Обработки.упоЗагрузитьИзПодчиненныхПроектов.Форма.Форма
	ЗначенияРеквизитов = упоФункцииБСП.ПолучитьЗначенияРеквизитов(Проект, "упоЕдиницаВремениПоУмолчанию");
	
	Если ЗначенияРеквизитов.Количество() <> 0 Тогда
		ЕдиницаНормированияДлительности = ЗначенияРеквизитов.упоЕдиницаВремениПоУмолчанию;
	Иначе
		ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.Час;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЕдиницаНормированияДлительности) Тогда
		ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.Час;
	КонецЕсли;
	
	Возврат ЕдиницаНормированияДлительности;
	
КонецФункции

Функция ПолучитьПроектныеЗадачиДляАктуальныхПланов(ДанныеПоАктируемымЭтапам)
	
	ПроектныеЗадачи = Новый Массив;
	Для Каждого Строка Из ДанныеПоАктируемымЭтапам Цикл
		Если Строка.БылАктируемыйЭтап Тогда
			ПроектныеЗадачи.Добавить(Строка.ПроектнаяЗадача);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПроектныеЗадачи;
	
КонецФункции

Функция ПолучитьПроектныеЗадачиДляДанныхПланов(ДанныеПоАктируемымЭтапам)
	
	ПроектныеЗадачи = Новый Массив;
	Для Каждого Строка Из ДанныеПоАктируемымЭтапам Цикл
		Если Не Строка.БылАктируемыйЭтап Тогда
			ПроектныеЗадачи.Добавить(Строка.АктируемыйЭтап);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПроектныеЗадачи;
	
КонецФункции

Функция ПолучитьПустуюТаблицуПоКолонкамЗаданногоПараметра(Параметр)
	
	Таблица = Новый ТаблицаЗначений;
	Для Каждого КолонкаПараметра Из Параметр.Колонки Цикл
		КолонкиТаблицы = Таблица.Колонки;
		КолонкаТаблицы = КолонкиТаблицы.Добавить();
		ЗаполнитьЗначенияСвойств(КолонкаТаблицы, КолонкаПараметра);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура РасчитатьНовыеСроки(ПроектнаяЗадачаОб, АктируемыйЭтап, ДопДанные)
	
	РабочийКалендарьПроекта = ДопДанные.РабочийКалендарьПроекта;
	ДатаСтартаПроекта = ДопДанные.ДатаСтартаПроекта;
	
	ПроектнаяЗадачаОб.РучнойВводСроков = Истина;
	
	СрокиАктируемогоЭтапа = упоПроектыИЗадачиСервер.ПолучитьСрокиПроектнойЗадачи(АктируемыйЭтап);
	Если СрокиАктируемогоЭтапа.ДатаНачалаПлан <= ДатаСтартаПроекта Тогда
		ПроектнаяЗадачаОб.ДатаНачалаПлан = ДатаСтартаПроекта;
	Иначе
		ПроектнаяЗадачаОб.ДатаНачалаПлан = СрокиАктируемогоЭтапа.ДатаНачалаПлан;
	КонецЕсли;
	
	ПроектнаяЗадачаОб.ДатаЗавершенияПлан = СрокиАктируемогоЭтапа.ДатаЗавершенияПлан;
	
	ПроектнаяЗадачаОб.ДлительностьМоделиПакетаРабот = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность(
			ПроектнаяЗадачаОб.ДатаНачалаПлан, ПроектнаяЗадачаОб.ДатаЗавершенияПлан,
			ПроектнаяЗадачаОб.ЕдиницаНормированияДлительности, ПроектнаяЗадачаОб.КалендарьЗадачи, РабочийКалендарьПроекта,
			Ложь,
			Новый Соответствие);
	
КонецПроцедуры

Процедура ОтменитьЗадачиЭтапаРодителя(ДетиПроектнойЗадачиРодителя, НайденныеЗадачиЭтапа, Проект, ОбновленныеПЗ)
	
	ТекущиеЗадачи = ДетиПроектнойЗадачиРодителя.ВыгрузитьКолонку("ПроектнаяЗадача");
	
	УдаляемыеЗадачи = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ТекущиеЗадачи, НайденныеЗадачиЭтапа);
	УдаляемыеЗадачи = ОбщегоНазначенияКлиентСервер.СвернутьМассив(УдаляемыеЗадачи);
	
	Если УдаляемыеЗадачи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого УдаляемаяЗадача Из УдаляемыеЗадачи Цикл
		ОбновленныеПЗ.Вставить(УдаляемаяЗадача, Истина);
	КонецЦикла;
	
	ОтменитьУдаляемыеЗадачи(УдаляемыеЗадачи, Проект);
	
КонецПроцедуры

Процедура ОтменитьУдаляемыеЗадачи(УдаляемыеЗадачи, Проект)
	
	ДокументСохранения = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
	ДокументСохранения.Дата = ТекущаяДатаСеанса();
	ДокументСохранения.Проект = Проект;
	
	ПроектныеЗадачи = ДокументСохранения.ПроектныеЗадачи;
	Для Каждого УдаляемаяЗадача Из УдаляемыеЗадачи Цикл
		
		Если Не ЗначениеЗаполнено(УдаляемаяЗадача) Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = ПроектныеЗадачи.Добавить();
		Строка.ПроектнаяЗадача = УдаляемаяЗадача;
		Строка.ЗадачаОтменена = Истина;
		
	КонецЦикла;
	
	ДокументСохранения.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ЗаписатьПроектнуюЗадачу(ПроектнаяЗадачаОб)
	
	Попытка
		ПроектнаяЗадачаОб.Дата = ТекущаяДатаСеанса();
		ПроектнаяЗадачаОб.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

#Область ПолучениеСпискаАктуализируемыхЗадач

Функция ПолучитьАктуализируемыеЗадачиИЗаполнитьДопПараметры(ПроектнаяЗадачаПриемник, ВыбранныеПроекты, ДопПараметры, РодителиЗадач)
	// Ищем существующие, создаём новые.
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЗадачиСПодчиненными();
	
	ТекущаяВерсия = ДопПараметры.ТекущаяВерсия;
	
	Запрос.УстановитьПараметр("Версия", ТекущаяВерсия);
	Запрос.УстановитьПараметр("КорневойПроект", ДопПараметры.Проект);
	Запрос.УстановитьПараметр("ПодчиненныеПроекты", ВыбранныеПроекты);
	
	РезультатЗапроса = Запрос.Выполнить();
	СуществующиеПЗ = РезультатЗапроса.Выгрузить();
	
	ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.РабочийДень;
	ДопПараметры.Вставить("ЕдиницаНормированияДлительности", ЕдиницаНормированияДлительности);
	ТипПроектнойЗадачи = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
	ДопПараметры.Вставить("ТипПроектнойЗадачи", ТипПроектнойЗадачи);
	ДопПараметры.Вставить("ЗадачаРодитель", ПроектнаяЗадачаПриемник);
	
	// TODO передавать через доппараметры
	ПроектныеОпции = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ДопПараметры.Проект);
	ДопПараметры.Вставить("НормаСтоимостиТрудовыхРесурсов", ПроектныеОпции.НормаСтоимостиТрудовыхРесурсов);
	ДопПараметры.Вставить("ВнешняяНормаСтоимостиТрудовыхРесурсов", ПроектныеОпции.ВнешняяНормаСтоимостиТрудовыхРесурсов);
	
	АктуализируемыеЗадачи = Новый Массив;
	
	Для Каждого Проект Из ВыбранныеПроекты Цикл
		СтрокаПЗ = СуществующиеПЗ.Найти(Проект);
		
		Если СтрокаПЗ = Неопределено Тогда
			ЗадачаКуда = РодителиЗадач.Получить(Проект);
			Если ЗадачаКуда <> Неопределено Тогда
				ДопПараметры.Вставить("ЗадачаРодитель", ЗадачаКуда);
			КонецЕсли;
			
			СозданнаяЗадача = ПолучитьСсылкуСозданнойПЗ(Проект, ДопПараметры);
			Если ЗначениеЗаполнено(СозданнаяЗадача) Тогда
				АктуализируемыеЗадачи.Добавить(СозданнаяЗадача);
			КонецЕсли;
		Иначе
			ЗадачаКуда = РодителиЗадач.Получить(Проект);
			Если ЗадачаКуда <> Неопределено Тогда
				ДопПараметры.Вставить("ЗадачаРодитель", ЗадачаКуда);
			КонецЕсли;
			
			ИзменитьРодителяПроектнойЗадачи(ДопПараметры.ТекущаяВерсия, СтрокаПЗ.СуществующаяПроектнаяЗадача, ЗадачаКуда);
			АктуализируемыеЗадачи.Добавить(СтрокаПЗ.СуществующаяПроектнаяЗадача);
		КонецЕсли;
	КонецЦикла;
	
	Возврат АктуализируемыеЗадачи;
	
КонецФункции

Функция ПолучитьСсылкуСозданнойПЗ(ВыбранныйПроект, ДопПараметры)
	
	ТипПроектнойЗадачи = ДопПараметры.ТипПроектнойЗадачи;
	ЗадачаРодитель = ДопПараметры.ЗадачаРодитель;
	Проект = ДопПараметры.Проект;
	
	ЕдиницаНормированияДлительности = Неопределено;
	ДопПараметры.Свойство("ЕдиницаНормированияДлительности", ЕдиницаНормированияДлительности);
	Если Не ЗначениеЗаполнено(ЕдиницаНормированияДлительности) Тогда
		ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.РабочийДень;
	КонецЕсли;
	
	ПроектнаяЗадачаОб = Документы.упоПроектнаяЗадача.СоздатьДокумент();
	
	Если ВыбранныйПроект <> Неопределено Тогда
		ПроектнаяЗадачаОб.ПодчиненныйПроект = ВыбранныйПроект.Ссылка;
		ПроектнаяЗадачаОб.НазваниеПроектнойЗадачи = ВыбранныйПроект.Наименование;
	Иначе
		ПроектнаяЗадачаОб.НазваниеПроектнойЗадачи = ДопПараметры.НазваниеПроектнойЗадачи;
	КонецЕсли;
	
	ПроектнаяЗадачаОб.ТипПроектнойЗадачи = ТипПроектнойЗадачи;
	ПроектнаяЗадачаОб.ЗадачаРодитель = ЗадачаРодитель;
	ПроектнаяЗадачаОб.Проект = Проект;
	ПроектнаяЗадачаОб.ЕдиницаНормированияДлительности = ЕдиницаНормированияДлительности;
	ПроектнаяЗадачаОб.РучнойВводСроков = Истина;
	
	Если ДопПараметры.Свойство("ДатаНачалаПлан") И ДопПараметры.Свойство("ДатаЗавершенияПлан") Тогда
		РассчитатьДлительность(ПроектнаяЗадачаОб, ДопПараметры);
	Иначе
		РасчитатьНовыеСрокиСозданнойПЗ(ПроектнаяЗадачаОб, ЕдиницаНормированияДлительности, ДопПараметры);
	КонецЕсли;
	
	ДопПараметры.Свойство("РасчетЦеныКонтракта", ПроектнаяЗадачаОб.РасчетЦеныКонтракта);
	
	ЗаписатьПроектнуюЗадачу(ПроектнаяЗадачаОб);
	
	Возврат ПроектнаяЗадачаОб.Ссылка;
	
КонецФункции

Процедура РасчитатьНовыеСрокиСозданнойПЗ(ПроектнаяЗадачаОб, ЕдиницаНормированияДлительности, ДопПараметры)
	
	РабочийКалендарьПроекта = ДопПараметры.РабочийКалендарьПроекта;
	ДатаНачалаПлан = ДопПараметры.ДатаСтартаПроекта;
	
	Длительность = 1;
	КоличествоЧасовВМесяце = 160;
	ДлительностьВЧасах = Длительность * КоличествоЧасовВМесяце;
	КоэффициентЕдиницыНормирования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаНормированияДлительности, "Коэффициент");
	ДлительностьЗадачи = ДлительностьВЧасах / ?(КоэффициентЕдиницыНормирования = 0, 1, КоэффициентЕдиницыНормирования);
	
	ПроектнаяЗадачаОб.ДатаНачалаПлан = ДатаНачалаПлан;
	ПроектнаяЗадачаОб.ДлительностьМоделиПакетаРабот = ДлительностьЗадачи;
	ПроектнаяЗадачаОб.ДатаЗавершенияПлан = упоРабочиеКалендариВызовСервера.обПолучитьКонецПериода(РабочийКалендарьПроекта,
			ДатаНачалаПлан, ДлительностьВЧасах);
	
КонецПроцедуры

Процедура РассчитатьДлительность(ПроектнаяЗадачаОб, ДопПараметры)
	
	РабочийКалендарьПроекта = ДопПараметры.РабочийКалендарьПроекта;
	ДатаНачала = ДопПараметры.ДатаНачалаПлан;
	ДатаЗавершения = ДопПараметры.ДатаЗавершенияПлан;
	
	РабочийКалендарь =
		упоРабочиеКалендариВызовСервера.ПолучитьРабочийКалендарьНаПериод(РабочийКалендарьПроекта, ДатаНачала, ДатаЗавершения, Истина);
	
	Если РабочийКалендарь <> Неопределено Тогда
		КоличествоДней = РабочийКалендарь.Количество();
	Иначе
		КоличествоДней = 1;
	КонецЕсли;
	
	ПроектнаяЗадачаОб.ДатаНачалаПлан = ДатаНачала;
	ПроектнаяЗадачаОб.ДлительностьМоделиПакетаРабот = КоличествоДней;
	ПроектнаяЗадачаОб.ДатаЗавершенияПлан = ДатаЗавершения;
	
КонецПроцедуры

Процедура ИзменитьТипЗадачиКудаЭтап(ПроектнаяЗадача)
	
	ТипЗадачи = упоПроектыИЗадачиСервер.ПолучитьТипПроектнойЗадачи(ПроектнаяЗадача);
	ТипЗадачиЭтап = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипПроектнойЗадачи.Этап");
	Если ТипЗадачи <> ТипЗадачиЭтап Тогда
		ИзменитьТипЗадачи(ПроектнаяЗадача, ТипЗадачиЭтап);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьАктуализируемыеЗадачиПоДокументамРЦК(ПроектнаяЗадачаКуда, ВыбранныеПроекты, СписокДокументовРЦК, ДопПараметры, РодителиЗадач)
	
	АктуализируемыеЗадачи = Новый Массив;
	ТипПроектнойЗадачи = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
	
	Для Каждого Проект Из ВыбранныеПроекты Цикл
		
		ДокРЦК = СписокДокументовРЦК.Получить(Проект);
		
		ТипДанных = ТипЗнч(Проект);
		Если ТипДанных = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			РодительКуда = РодителиЗадач.Получить(ДокРЦК);
			Если РодительКуда <> Неопределено Тогда
				ИзменитьРодителяПроектнойЗадачи(ДопПараметры.ТекущаяВерсия, Проект, РодительКуда)
			КонецЕсли;
			АктуализируемыеЗадачи.Добавить(Проект);
			СписокДокументовРЦК.Вставить(Проект, ДокРЦК);
		Иначе
			Если ДокРЦК <> Неопределено Тогда
				ДанныеРЦК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокРЦК, "ДатаНачалаРаботПлан, ДатаОкончанияРаботПлан, ПредметКонкурса");
				ДопПараметры.Вставить("ДатаНачалаПлан", ДанныеРЦК.ДатаНачалаРаботПлан);
				ДопПараметры.Вставить("ДатаЗавершенияПлан", ДанныеРЦК.ДатаОкончанияРаботПлан);
				ДопПараметры.Вставить("НазваниеПроектнойЗадачи", ДанныеРЦК.ПредметКонкурса);
				ДопПараметры.Вставить("РасчетЦеныКонтракта", ДокРЦК);
				ЗадачаРодитель = РодителиЗадач.Получить(ДокРЦК);
				Если ЗадачаРодитель = Неопределено Тогда
					ЗадачаРодитель = ПроектнаяЗадачаКуда;
				КонецЕсли;
				ДопПараметры.Вставить("ЗадачаРодитель", ЗадачаРодитель);
				ДопПараметры.Вставить("ТипПроектнойЗадачи", ТипПроектнойЗадачи);
			КонецЕсли;
			
			ПодчиненныйПроект = Неопределено;
			Если ТипДанных = Тип("СправочникСсылка.Проекты") Тогда
				ПодчиненныйПроект = Проект;
			КонецЕсли;
			СозданнаяЗадача = ПолучитьСсылкуСозданнойПЗ(ПодчиненныйПроект, ДопПараметры);
			Если ЗначениеЗаполнено(СозданнаяЗадача) Тогда
				АктуализируемыеЗадачи.Добавить(СозданнаяЗадача);
				СписокДокументовРЦК.Вставить(СозданнаяЗадача, ДокРЦК);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат АктуализируемыеЗадачи;
	
КонецФункции

