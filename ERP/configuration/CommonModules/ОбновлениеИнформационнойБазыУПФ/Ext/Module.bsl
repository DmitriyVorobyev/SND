	Обработчик.Версия = "*";
	Обработчик.РежимВыполнения = "Монопольно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыУПФ.ПереносТиповыхПрофилейГруппДоступаВПапкуУправлениеПроектами"; 

