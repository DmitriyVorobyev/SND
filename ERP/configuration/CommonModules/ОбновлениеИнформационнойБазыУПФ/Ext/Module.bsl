#Область СлужебныйПрограммныйИнтерфейс

// Перенос типовых профилей групп доступа РМ в папку "Управление проектами"
Процедура ПереносТиповыхПрофилейГруппДоступаВПапкуУправлениеПроектами(Параметры = Неопределено) Экспорт
	
	МассивПрофилейГруппДоступа = Новый Массив;
	РодительСсылка = Справочники.ПрофилиГруппДоступа.упоУправлениеПроектами; 
	
	СтруктураГруппИПрофилей = упоИнтеграция.ПолучитьСтруктуруТиповыхГруппИПрофилей();
	
	Для Каждого КлючЗначение Из СтруктураГруппИПрофилей Цикл
		МассивПрофилейГруппДоступа.Добавить(СтруктураГруппИПрофилей[КлючЗначение.Ключ]);	
	КонецЦикла;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("СписокТиповыхПрофилей", МассивПрофилейГруппДоступа);
	Запрос.УстановитьПараметр("Родитель", РодительСсылка);
  	Запрос.Текст = 	"ВЫБРАТЬ
  	               	|	ПрофилиГруппДоступа.Ссылка КАК Ссылка
  	               	|ИЗ
  	               	|	Справочник.ПрофилиГруппДоступа КАК ПрофилиГруппДоступа
  	               	|ГДЕ
  	               	|	ПрофилиГруппДоступа.ИмяПредопределенныхДанных В(&СписокТиповыхПрофилей)
  	               	|	И ПрофилиГруппДоступа.Предопределенный
  	               	|	И НЕ ПрофилиГруппДоступа.ЭтоГруппа
  	               	|	И ПрофилиГруппДоступа.Родитель <> &Родитель";    
	
	Результат = Запрос.Выполнить();	
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;                   
		
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Родитель = РодительСсылка;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

// Перенос данных документа "Заказ поставзику" из реквизита "упоПроектнаяЗадача" в реквизит "Проект"
Процедура ПереносДанныхДокументаЗаказПоставщкуИзРеквизитаУпоПроектнаяЗадачаВПроект(Параметры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
					|	ЗаказПоставщику.Ссылка КАК Ссылка,
					|	ЗаказПоставщику.упоПроектнаяЗадача КАК упоПроектнаяЗадача
					|ИЗ
					|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
					|ГДЕ
					|	ЗаказПоставщику.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)";

	РезультатЗапроса = Запрос.Выполнить();	 
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.Проект = Выборка.упоПроектнаяЗадача;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
	КонецЦикла;
	
КонецПроцедуры

// Установка варианта отображения сообщений об ошибке, отличающегося от значения по умолчанию.
Процедура УстановитьВариантОтображенияСообщенийОбОшибках(Параметры = Неопределено) Экспорт
	
	ОбщиеНастройкиОбработкиОшибок = ОбработкаОшибок.ПолучитьОбщиеНастройки();
	ОбщиеНастройкиОбработкиОшибок.ВариантОтображенияСообщения = 
		ВариантОтображенияСообщенияОбОшибке.КраткоеПредставлениеОшибки;
	ОбработкаОшибок.УстановитьОбщиеНастройки(ОбщиеНастройкиОбработкиОшибок);
	
КонецПроцедуры

// Установка в предопределенную группу доступа "упоРаботаСПроектамиДополнительный"
// профиля группы доступа "упоРаботаСПроектамиДополнительный"
Процедура ДобавитьВДополнительнуюГруппуДоступаПрофиль(Параметры = Неопределено) Экспорт
	
	СправочникОбъект = Справочники.ГруппыДоступа["упоРаботаСПроектамиДополнительный"].ПолучитьОбъект();
	СправочникОбъект.Профиль = Справочники.ПрофилиГруппДоступа["упоРаботаСПроектамиДополнительный"];
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
	
КонецПроцедуры

// Установка признака "Используется" у предопределенных дополнительных реквизитов подсистемы РМ
Процедура ВключитьИспользованиеПредопределенныхДополнительныхРеквизитов(Параметры = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ
					|	НаборыДополнительныхРеквизитовИСведений.Ссылка КАК Ссылка,
					|	НаборыДополнительныхРеквизитовИСведений.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
					|ИЗ
					|	Справочник.НаборыДополнительныхРеквизитовИСведений КАК НаборыДополнительныхРеквизитовИСведений
					|ГДЕ
					|	НаборыДополнительныхРеквизитовИСведений.Предопределенный";     
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Предопределенные наборы доп. реквизитов для объектов, которых нет в РМ Проф
	СтруктураИсключений = Новый Структура;          

	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		СтруктураИсключений.Вставить("Справочник_упоВидДоговора");  
		СтруктураИсключений.Вставить("Документ_упоСогласованиеТрудозатрат");
		СтруктураИсключений.Вставить("Документ_упоРегистрацияЮридическихУсловийДоговора");
		СтруктураИсключений.Вставить("Справочник_упоРискиПроектов");
		СтруктураИсключений.Вставить("Справочник_упоШаблоныРисковПроектов");
		СтруктураИсключений.Вставить("Документ_упоЗаявкаНаПроект");
		СтруктураИсключений.Вставить("Справочник_упоПравилаЗаполненияПараметров");
		СтруктураИсключений.Вставить("Справочник_упоПравилаФормированияНаименованийДоговоров");
		СтруктураИсключений.Вставить("Справочник_упоПроектнаяПродукция");
		СтруктураИсключений.Вставить("Документ_упоРасчетИтоговогоБаллаПроектов");
		СтруктураИсключений.Вставить("Документ_упоРасчетЦеныКонтракта");
		СтруктураИсключений.Вставить("Документ_упоРегистрацияПоказателейЭффективностиПроекта");
		СтруктураИсключений.Вставить("Справочник_упоСвязиОбъектовСистемыИФайлов");
		СтруктураИсключений.Вставить("Документ_упоСоответствиеСтратегическимЦелям");
		СтруктураИсключений.Вставить("Справочник_упоПрофилиНастроекПрогнозаТрудозатратПоРолям");
		СтруктураИсключений.Вставить("Справочник_упоСтатусыОбъектов");
		СтруктураИсключений.Вставить("Справочник_упоФазыПроектов");
		СтруктураИсключений.Вставить("Документ_упоФормированиеБизнесПлана");
		СтруктураИсключений.Вставить("Справочник_упоЭтапыДоговоров");   
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если СтрНайти(Выборка.ИмяПредопределенныхДанных, "_упо") = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		Используется = Истина;
		
		Если СтруктураИсключений.Свойство(Выборка.ИмяПредопределенныхДанных) Тогда
			Используется = Ложь;	
		КонецЕсли;
		
		СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СправочникОбъект.Используется = Используется;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СправочникОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

