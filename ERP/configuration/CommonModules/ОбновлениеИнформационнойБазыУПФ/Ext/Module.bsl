	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыУПФ.ОбновитьПредопределенныеПравилаПолученияФакта_309137";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("73a3e17c-1f77-40cc-9bed-82db03b5c83e");
