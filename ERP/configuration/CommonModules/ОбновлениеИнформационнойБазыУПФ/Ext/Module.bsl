	Обработчик.НачальноеЗаполнение = Ложь;
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыУПФ.ОбновитьПредопределенныеПравилаПолученияФакта_302179";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("7b76b09e-c572-4b44-8159-cbe6222e7ea8");
	Обработчик.Комментарий = 
		НСтр("ru = 'Обновление правил получения факта проектного бюджетирования из поставляемых макетов.'");
	
	Обработчик = Обработчики.Добавить();
	Обработчик.НачальноеЗаполнение = Истина;
	Обработчик.Версия = "3.0.5.191";
	Обработчик.РежимВыполнения = "Монопольно";
	Обработчик.Процедура = "ОбновлениеИнформационнойБазыУПФ.ДобавитьВДополнительнуюГруппуДоступаПрофиль";
	
	Обработчик = Обработчики.Добавить();
