			СтруктСоотОснКол.Вставить("Договор", "ДоговорДоходовРасходов");
			
		Иначе
			
			// Колонка таблицы-приемника / колонка таблицы-источника.
			СтруктСоотОснКол = СтруктураСоответствияКолонок.СоотвКолонокОсновныхТаблиц;
			СтруктСоотОснКол.Вставить("Статья", "СтатьяЗатрат");
