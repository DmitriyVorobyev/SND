Процедура ДобавитьТекстОшибки(Параметры, Отказ, СтрокаПлана, НомерСтроки, МассивОшибок)

	ТекстСообщения = Параметры.ТекстСообщения;
	СинонимДатыПривязки = Параметры.СинонимДатыПривязки;
	СинонимПрофиляРаспределения = Параметры.СинонимПрофиляРаспределения;
	СпособПривязкиНаДату = Параметры.СпособПривязкиНаДату;
	СпособПривязкиПоПрофилюРаспределения = Параметры.СпособПривязкиПоПрофилюРаспределения;
	ТекстВкладкаФинПланы = Параметры.ТекстВкладкаФинПланы;
	ИмяПлана = Параметры.ИмяПлана;
	
	Если СтрокаПлана.СпособПривязки = СпособПривязкиНаДату 
		И НЕ ЗначениеЗаполнено(СтрокаПлана.ДатаПривязки) Тогда
		Отказ = Истина;
		ТекстОшибки = СтрШаблон(ТекстСообщения, СинонимДатыПривязки, НомерСтроки, 
			ТекстВкладкаФинПланы, ИмяПлана);
		МассивОшибок.Добавить(СокрЛ(ТекстОшибки));
	ИначеЕсли СтрокаПлана.СпособПривязки = СпособПривязкиПоПрофилюРаспределения 
		И НЕ ЗначениеЗаполнено(СтрокаПлана.ПрофильРаспределения) Тогда
		Отказ = Истина;
		ТекстОшибки = СтрШаблон(ТекстСообщения, СинонимПрофиляРаспределения,НомерСтроки, 
			ТекстВкладкаФинПланы, ИмяПлана); 
		МассивОшибок.Добавить(СокрЛ(ТекстОшибки));
	КонецЕсли;
	
КонецПроцедуры  

#КонецОбласти