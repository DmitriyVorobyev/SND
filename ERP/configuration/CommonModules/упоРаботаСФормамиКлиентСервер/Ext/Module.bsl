Функция ОбновитьДанныеСвязаннойСтрокиОсновнойТаблицы(Объект, ИсходнаяСтрока, СвязаннаяТаблица, ТаблицаИсточник) Экспорт 
		
	СтруктураОтбора = Новый Структура("ИсточникПлана, ИндексСтрокРаспределенияИсходнойТЧ", 
		упоРаботаСФормамиКлиентСервер.ИсточникПланаПоТаблице(ТаблицаИсточник), ИсходнаяСтрока.ИндексСтрокРаспределения);
					
	НайденныеСтроки = Объект[СвязаннаяТаблица].НайтиСтроки(СтруктураОтбора);
	
	СтрокиНайдены = Не НайденныеСтроки.Количество() = 0; 
	
	Если СтрокиНайдены Тогда
		
		СтруктураСоответствияКолонок = ПолучитьСтруктуруСоответствияКолонокДляПереносаСтрок(СвязаннаяТаблица, ТаблицаИсточник);
		
		Для Каждого СтрокаДляОбновления Из НайденныеСтроки Цикл
		
			// Перенос значений в соотв. колонки основной таблицы.
			Для Каждого КИЗ Из СтруктураСоответствияКолонок.СоотвКолонокОсновныхТаблиц Цикл
				СтрокаДляОбновления[КИЗ.Ключ] = ИсходнаяСтрока[КИЗ.Значение];
			КонецЦикла; 
			
		КонецЦикла;

	КонецЕсли;
		
	Возврат СтрокиНайдены;
	
КонецФункции

Процедура НастройкаРаспределенияБДР_УстановитьДоступностьВидимостьЭлементовФормы(ЭтаФорма, Объект) Экспорт
	
	Элементы = ЭтаФорма.Элементы;
	
	Элементы.СтавкаНДС.Доступность = Объект.ФлагВыделитьНДСДоходов 
										Или Объект.ФлагВыделитьНДСРасходов;	
	
	Элементы.ОтборСтатьиНДС.Доступность = Объект.ФлагВыделитьНДСРасходов;				
	Элементы.УчестьРасходы_ОтборСССП.Доступность = Объект.ФлагУчестьРасходы;	
	Элементы.РаспределитьПоТрудозатратам_ИсключитьСССП.Доступность = Объект.ФлагРаспределитьПоТрудозатратам;
	Элементы.СпособРаспределенияДоходовПоРасходам.Доступность = Объект.ФлагУчестьРасходы;
	
	Элементы.РаспределитьПланВыпускаТранслированныйНаДоход.Доступность = Объект.ФлагУчестьРасходы 
																			Или Объект.ФлагРаспределитьПоТрудозатратам;
																			
   	Элементы.ФлагРаспределитьПоТрудозатратам.Доступность =
		Объект.СпособРаспределенияДоходовПоРасходам <> ПредопределенноеЗначение("Перечисление.упоСпособыРаспределенияРасходовВОбработкеРаспределенияБДР.Пропорционально")
			Или Не Объект.ФлагУчестьРасходы;

КонецПроцедуры

Функция СообщениеДляБДРТрудозатратыИзменены(ИспользоватьОтложенноеОтражениеПлановыхТрудозатратЗадач, 
	СообщениеДляДокументаПЗ = Истина) Экспорт
	
	ТекстСообщения = 	НСтр("ru = 'ВНИМАНИЕ! Изменились расходы по трудовым ресурсам, включенным в БДР. '") +
						НСтр("ru = 'После %1 данные плана расходов будут обновлены.'"); 
		
	Если ИспользоватьОтложенноеОтражениеПлановыхТрудозатратЗадач Тогда
		ТекстУточнения = НСтр("ru = 'выполнения регламентного задания по отражению трудозатрат'"); 
	ИначеЕсли СообщениеДляДокументаПЗ Тогда
		ТекстУточнения = НСтр("ru = 'проведения задачи'");
	Иначе
		ТекстУточнения = НСтр("ru = 'записи структуры проекта'");
	КонецЕсли;					
		
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,	ТекстУточнения);	
	
КонецФункции

Функция ПараметрыПривязкиСтрокиРаспределенияПоСтрокеВладельцу(СтрокаВладелец,
	ИмяКолонкиСпособПривязки = "СпособПривязки",
	ИмяКолонкиПрофиль = "ПрофильРаспределения",
	ИмяКолонкиДата = "ДатаПривязки") Экспорт 
	
	ПараметрыПривязки = Новый Структура;
	ПараметрыПривязки.Вставить("СпособПривязки", 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.ПустаяСсылка"));
	ПараметрыПривязки.Вставить("ПрофильРаспределения", 
		ПредопределенноеЗначение("Справочник.упоПрофилиРаспределенияДоходовИРасходов.ПустаяСсылка"));
	ПараметрыПривязки.Вставить("ДатаПривязки", Дата(1, 1, 1));
		
	Если СтрокаВладелец[ИмяКолонкиСпособПривязки] = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения")
		Или СтрокаВладелец[ИмяКолонкиСпособПривязки] = 
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения") Тогда
				
		ПараметрыПривязки.СпособПривязки = 
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения");
		ПараметрыПривязки.ПрофильРаспределения = СтрокаВладелец[ИмяКолонкиПрофиль];
				
	ИначеЕсли СтрокаВладелец[ИмяКолонкиСпособПривязки] = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.НаДату")
		Или СтрокаВладелец[ИмяКолонкиСпособПривязки] = 
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.НаДату") Тогда
		
		ПараметрыПривязки.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.НаДату");
		ПараметрыПривязки.ДатаПривязки = СтрокаВладелец[ИмяКолонкиДата];
		
	ИначеЕсли СтрокаВладелец[ИмяКолонкиСпособПривязки] = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
				
		ПараметрыПривязки.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную");			
		
	КонецЕсли;		
	
	Возврат ПараметрыПривязки;
	
КонецФункции

Функция ЭтоВызовЗадачиИзСтруктурыПроекта(Форма) Экспорт
	
	ВызовИзСтруктуры = Ложь;
	
	Если Форма.ИмяФормы = "Обработка.упоУпрощенныйВводСтруктурыПроекта.Форма.ФормаЗадачи" Тогда
		ВызовИзСтруктуры = Истина;
	КонецЕсли;
	
	Возврат ВызовИзСтруктуры;
	
КонецФункции

