// Проверяет, является ли проектной продукцией проверяемый объект.
//
// Параметры:
//  ПроверяемыйОбъект	 - СправочникСсылка - проверяемый объект.
// 
// Возвращаемое значение:
//  Булево - результат проверки
//
Функция ЭтоПроектнаяПродукция(ПроверяемыйОбъект) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоПП = ТипЗнч(ПроверяемыйОбъект) = Тип("СправочникСсылка.упоПроектнаяПродукция");
	
	Возврат ЭтоПП;
	
КонецФункции

// Возвращает тип субпродукта перечисление по номеру переключателя на форме.
//
// Параметры:
//  Номер	 - Число - номер переключателя на форме.
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.упоТипСубпродукта - тип субпродукта.
//
Функция ТипСубпродуктаПеречислениеПоНомеру(Номер) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.Номенклатура");
	КонецЕсли;
	
	Если Номер = 1 Тогда
		ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция");
	Иначе
		ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.Номенклатура");
	КонецЕсли;
		
	Возврат ТипСубпродукта;
	
КонецФункции

// Возвращает номер типа субпродукта по перечислению для отображения переключателя на форме.
//
// Параметры:
//  ТипСубпродукта	 - ПеречислениеСсылка.упоТипСубпродукта - тип субпродукта.
// 
// Возвращаемое значение:
//  Число - номер для переключателя на форме.
//
Функция НомерТипаСубпродуктаПоПеречислению(ТипСубпродукта) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
		Номер = 1;
	Иначе
		Номер = 0;
	КонецЕсли;
		
	Возврат Номер;
	
КонецФункции

