// Проверка: функциональность проектного бюджетирования доступна.
// 
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ФункционалПроектногоБюджетированияДоступен() Экспорт
	
	ФункционалДоступен = Истина;
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() 
		И Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		ФункционалДоступен = Ложь;
	КонецЕсли; 
	
	Возврат ФункционалДоступен;
	
КонецФункции

