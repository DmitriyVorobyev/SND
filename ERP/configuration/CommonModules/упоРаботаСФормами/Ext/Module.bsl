////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции для работы с формами.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Проверяет соответствие контрагента и договора в строке табличной части.
//
// Параметры:
//  Форма			 - Форма, УправляемаяФорма 	- форма, на которую вынесена табличная часть.
//  ТабличнаяЧасть	 - Строка 					- имя табличной части, которую нужно проверить.
//
Процедура ПроверитьДоговор(Форма, ТабличнаяЧасть) Экспорт

	ТекДанные = Форма.ЭлементыФормы[ТабличнаяЧасть].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ТекДанные.Контрагент) Тогда
		ТекДанные.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	Иначе
		Если НЕ ТекДанные.Договор.Контрагент = ТекДанные.Контрагент Тогда
			ТекДанные.Договор = ТекДанные.Контрагент.упоОсновнойДоговорКонтрагента;
			ПриИзмененииДоговора(Форма, ТабличнаяЧасть);
		КонецЕсли; 
	КонецЕсли; 

КонецПроцедуры
 
// Устанавливает валюту в строке табличной части.
//
// Параметры:
//  Форма		 - Форма, УправляемаяФорма 	- форма, на которую выведена табличная часть.
//  имяТаблицы	 - Строка 					- имя табличной части на форме.
//  строкаТЧ	 - ДанныеФормыСтруктура, ДанныеФормыЭлементКоллекции, ДанныеФормыЭлементДерева - строка,
//					в которой надо установить валюту.
//
Процедура ПриИзмененииДоговора(Форма, имяТаблицы, строкаТЧ = Неопределено) Экспорт
	
	Если строкаТЧ = Неопределено Тогда
		текСтрока = Форма.ЭлементыФормы[имяТаблицы].ТекущиеДанные;
	Иначе
		текСтрока = строкаТЧ;
	КонецЕсли;
	
	Если текСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(текСтрока.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	имяРеквизитаВалютыДоговора = упоУправлениеДоговорамиКлиентСервер.ИмяРеквизитаВалютыДоговора();
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("текСтрока",текСтрока);
	ДопПараметры.Вставить("имяРеквизитаВалютыДоговора",имяРеквизитаВалютыДоговора);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриИзмененииДоговораЗавершение",ЭтотОбъект,ДопПараметры); 
	
	Если НЕ текСтрока.Договор[имяРеквизитаВалютыДоговора] = текСтрока.Валюта Тогда
		Если имяТаблицы = "ПланДоходов" 
			ИЛИ имяТаблицы = "ПланРасходов" 
			ИЛИ имяТаблицы = "Субпродукты"
			ИЛИ имяТаблицы = "МатериальныеРесурсы" Тогда
			Ответ = КодВозвратаДиалога.Да;
		Иначе
			ПоказатьВопрос(ОписаниеОповещения,"Валюта договора не соотвествует валюте в строке. Изменить валюту строки?",
				РежимДиалогаВопрос.ДаНет);
			Возврат;
		КонецЕсли;
		
		ПриИзмененииДоговораЗавершение(КодВозвратаДиалога.Да,ДопПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

// Получает массив единиц нормирования длительности.
//
// Возвращаемое значение:
//	Массив - коллекция элементов с типом СправочникСсылка.упоЕдиницыВремени.
//
Функция ПолучитьМассивЕдиницНормированияДлительности() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоЕдиницыВремени.Ссылка
	               |ИЗ
	               |	Справочник.упоЕдиницыВремени КАК упоЕдиницыВремени
	               |ГДЕ
	               |	НЕ упоЕдиницыВремени.ПометкаУдаления";
 
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриИзмененииДоговораЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДопПараметры.текСтрока.Валюта = текСтрока.Договор[ДопПараметры.имяРеквизитаВалютыДоговора];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
