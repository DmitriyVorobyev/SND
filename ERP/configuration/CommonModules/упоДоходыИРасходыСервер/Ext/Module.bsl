// Возвращает настройки обработки задач.
//
// Возвращаемое значение:
//   Структура - настройки обработки.
//
Функция НастройкиОбработкиЗадачПоУмолчанию() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("ПроектнаяЗадачаКакСправочник", Ложь);
	Настройки.Вставить("ПолучитьДанныеВложенныхЗадач", Ложь);
	Настройки.Вставить("ВернутьПЗКакДокумент", Ложь);
	
	Возврат Настройки;
	
КонецФункции	

// Распределяет таблицу данных пропорционально таблице базы по переданным отборам и аналитикам.
//
// Параметры:
//  ТаблицаДанныхРаспределения  - ТаблицаЗначений, ТабличнаяЧасть - распределяемая таблица.
//  ТаблицаБазыРаспределения  - ТаблицаЗначений - таблица базы распределения.
//  ПоляОтбораБазы  - Массив - поля поиска данных в таблице распределения.
//  ПоляАналитикиБазы  - Массив - разрезы аналитики, в которых собирается база распределения.
//  РесурсыРаспределения  - Массив - числовые значения, которые необходимо распределить.
//  МеппингПолейБазы  - Структура - соответствие полей таблицы ТаблицаДанныхРаспределения  
//                полям таблицы ТаблицаБазыРаспределения.
//
Процедура РаспределитьТаблицуДанныхПоБазе(ТаблицаДанныхРаспределения, ТаблицаБазыРаспределения, 
		ПоляОтбораБазы, ПоляАналитикиБазы, РесурсыРаспределения, МеппингПолейБазы) Экспорт 
			
	КлючПоискаБазы = СтрСоединить(ПоляОтбораБазы, ",");		
	Отбор = Новый Структура(КлючПоискаБазы);		
	ОбработанныеСтроки = Новый Массив;	
	
	Сч = ТаблицаДанныхРаспределения.Количество();
	Пока Сч > 0 Цикл
	    Сч = Сч - 1;
		
		СтрокаДанных = ТаблицаДанныхРаспределения[Сч];
			
		Для Каждого ПолеОтбора Из ПоляОтбораБазы Цикл							
			Отбор[ПолеОтбора] = СтрокаДанных[МеппингПолейБазы[ПолеОтбора]];
		КонецЦикла;
		
		БазаРаспределения = ТаблицаБазыРаспределения.НайтиСтроки(Отбор);		
		Если БазаРаспределения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		МассивСумм = Новый Массив;		
		Для Каждого СтрокаРаспределения Из БазаРаспределения Цикл
			МассивСумм.Добавить(СтрокаРаспределения.Сумма);
		КонецЦикла;	
					
		МассивыРаспределенияРесурсов = Новый Структура;
		Для Каждого РесурсРаспределения Из РесурсыРаспределения Цикл
			СуммыРаспределения = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
																СтрокаДанных[РесурсРаспределения], 
																МассивСумм, 
																2);
			МассивыРаспределенияРесурсов.Вставить(РесурсРаспределения, СуммыРаспределения);	
		КонецЦикла;	
		
		ОбработанныеСтроки.Добавить(СтрокаДанных);
		
		Сч1 = 0;
		Для Каждого СтрокаБазыРаспределения Из БазаРаспределения Цикл
			НоваяСтрока = ТаблицаДанныхРаспределения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);										
			Для Каждого ПолеАналитики Из ПоляАналитикиБазы Цикл
				НоваяСтрока[МеппингПолейБазы[ПолеАналитики]] = СтрокаБазыРаспределения[ПолеАналитики];			
			КонецЦикла;				
			Для Каждого МассивРаспределенияРесурса Из МассивыРаспределенияРесурсов Цикл
				НоваяСтрока[МассивРаспределенияРесурса.Ключ] = 
					?(МассивРаспределенияРесурса.Значение = Неопределено, 0, МассивРаспределенияРесурса.Значение[Сч1]);
			КонецЦикла;				
			Сч1 = Сч1 + 1;
		КонецЦикла;	
				
	КонецЦикла;	
	
	Для Каждого ОбработаннаяСтрока Из ОбработанныеСтроки Цикл 
		ТаблицаДанныхРаспределения.Удалить(ОбработаннаяСтрока);
	КонецЦикла;		
	
КонецПроцедуры	

// <Описание функции>
//
// Параметры:
//  МеппингПолейИсточника  - Структура - соответствие полей таблицы ТаблицаДанныхРаспределения  
//                полям таблицы ТаблицаБазыРаспределения.
//
// Возвращаемое значение:
//   Структура  - дополненное по умолчанию соответствие полей таблицы ТаблицаДанныхРаспределения  
//                полям таблицы ТаблицаБазыРаспределения.
//
Функция МеппингПолейИсточникаПоУмолчанию(МеппингПолейИсточника) Экспорт
	
	Если МеппингПолейИсточника = Неопределено Тогда
		МеппингПолейИсточника = Новый Структура;
	КонецЕсли;	
	
	МетаданныеФакта = Метаданные.РегистрыНакопления.упоФактДоходовИРасходовОбороты;
	
	Для Каждого ИзмерениеФакта Из МетаданныеФакта.Измерения Цикл 		
		Если Не МеппингПолейИсточника.Свойство(ИзмерениеФакта.Имя) Тогда
			МеппингПолейИсточника.Вставить(ИзмерениеФакта.Имя, ИзмерениеФакта.Имя);
		КонецЕсли;		
	КонецЦикла; 					
	
	Для Каждого РесурсФакта Из МетаданныеФакта.Ресурсы Цикл 		
		Если Не МеппингПолейИсточника.Свойство(РесурсФакта.Имя) Тогда
			МеппингПолейИсточника.Вставить(РесурсФакта.Имя, РесурсФакта.Имя);
		КонецЕсли;		
	КонецЦикла; 
				
	Возврат МеппингПолейИсточника;
	
КонецФункции // ()

