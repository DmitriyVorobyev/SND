// Получает ставку НДС из договора, настройки распределения БДР проекта или параметров PM.
//
// Параметры:
//  Договор	 - СправочникСсылка.ДоговорыКонтрагентов	 - договор.
//  Проект	 - СправочникСсылка.Проекты	 - проект.
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.СтавкиНДС - ставка НДС по договору.
//
Функция ЗначениеСтавкиНДС(Договор, Проект) Экспорт
	
	СтавкаНДС = Неопределено;
	
	Если ЗначениеЗаполнено(Договор) Тогда
		СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "СтавкаНДС");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) И ЗначениеЗаполнено(Проект) Тогда
		СтавкаНДС = ЗначениеСтавкиНДСИзНастройкиРаспределенияБДРПроекта(Проект);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		СтавкаНДС = Константы.упоСтавкаНДСПоУмолчанию.Получить();
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
