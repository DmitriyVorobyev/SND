#Область ПрограммныйИнтерфейс

// Распределяет общую сумму дохода/расхода по периодам в соответствии с заданным профилем.
//
// Параметры:
//  Профиль					 - СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов	 - заданный профиль распределения.
//  ДатаНач					 - Дата														 - начало общего периода.
//  ДатаКон					 - Дата														 - окончание общего периода.
//  Сумма					 - Число													 - сумма, которую нужно распределить.
//  РаспределяетсяКоличество - Булево													 - признак распределения количества.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - результат расчета.
//
Функция РаспределитьДоходыИРасходыПоПрофилю(Профиль, ДатаНач, ДатаКон, Сумма = 0, РаспределяетсяКоличество = Ложь) Экспорт

	Если РаспределяетсяКоличество Тогда
		ИмяКолонкиРаспределения = "Количество";
	Иначе 
		ИмяКолонкиРаспределения = "Сумма";
	КонецЕсли;
	
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("Период");
	Результат.Колонки.Добавить(ИмяКолонкиРаспределения);
	
	// Способ распределения зависит от настроек профиля.
	
	Если Профиль.СпособРаспределения = Перечисления.упоСпособРаспределенияДоходовИРасходов.ПоДатамНачалаИЗавершения Тогда
		
		// Простой способ, необходимо только вычислить задержки.
		
		СекундыВДне = 86400;
		Для каждого СтрокаПрофиль Из Профиль.РаспределениеПоДатам Цикл        
			
			// Рассчитываем задержку.
			
			Задержка = СтрокаПрофиль.Задержка * СекундыВДне;			
			
			// Записываем данные в выходную таблицу.
			
			СтрокаРезультат = Результат.Добавить();
			
			Если СтрокаПрофиль.СпособПривязки = Перечисления.упоСпособПривязкиДоходовИРасходов.НачалоЗадачи Тогда
				СтрокаРезультат.Период = НачалоДня(ДатаНач) + Задержка;
			ИначеЕсли СтрокаПрофиль.СпособПривязки = Перечисления.упоСпособПривязкиДоходовИРасходов.ЗавершениеЗадачи Тогда
				СтрокаРезультат.Период = НачалоДня(ДатаКон) + Задержка;
			Иначе
				Продолжить; // Нештатная ситуация.
			КонецЕсли; 
			
			Проценты = 100;
			СтрокаРезультат[ИмяКолонкиРаспределения] = Сумма * (СтрокаПрофиль.ДоляСуммы / Проценты);
					
		КонецЦикла; 
		
	ИначеЕсли Профиль.СпособРаспределения = Перечисления.упоСпособРаспределенияДоходовИРасходов.РавномерноПоМесяцам Тогда
		
		// Более сложный способ расчета - необходимо равномерно разложить сумму по месяцам.					
		СписокПериодов = СписокПериодов(ДатаНач, ДатаКон, Профиль.ТолькоПолныеМесяцы);
		
		// Список периодов построен, распределяем сумму.		
		РаспределитьСуммуПоПериодам(Результат, Сумма, СписокПериодов, Профиль.СпособПривязкиКМесяцу, РаспределяетсяКоличество);
				
	КонецЕсли; 
	
	КолонкиСуммы = Новый Соответствие;
	КолонкиСуммы.Вставить(ИмяКолонкиРаспределения, Истина);	
	
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(Результат, КолонкиСуммы);
	
	Возврат Результат;	

КонецФункции

// Собирает план БДР из плана доходов и плана расходов.
//
// Параметры:
//  ПланДоходов			 - ТаблицаЗначений	 - таблица доходов.
//  ПланРасходов		 - ТаблицаЗначений	 - таблица расходов.
//  ВключатьТрудозатраты - Булево	 - признак включения трудозатрат.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - сводная таблица БДР.
//
Функция СводнаяТаблицаДоходыРасходы(ПланДоходов, ПланРасходов, ВключатьТрудозатраты = Ложь) Экспорт
	
	ДанныеПланаБДР = ШаблонТаблицыБДР();
	
	Если ПланДоходов <> Неопределено Тогда
		Для Каждого СтрокаДоход Из ПланДоходов Цикл
			СтрокаПлана = ДанныеПланаБДР.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПлана, СтрокаДоход);
			СтрокаПлана.ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход;
		КонецЦикла;
	КонецЕсли;
	
	Если ПланРасходов <> Неопределено Тогда
		Для каждого СтрокаДокумента Из ПланРасходов Цикл
			// Трудозатраты включаются в план расходов только при отражении трудозатрат.
			Если Не ВключатьТрудозатраты
				И СтрокаДокумента.ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.Трудозатраты Тогда
				Продолжить;
			КонецЕсли;
			СтрокаПлана = ДанныеПланаБДР.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПлана, СтрокаДокумента);
			СтрокаПлана.ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ДанныеПланаБДР;
	
КонецФункции

// Возвращает данные доходов/расходов указанной проектной задачи из регистра упоДанныеПлановДоходовИРасходов.
//
// Параметры:
//  ПроектнаяЗадача    - Документ.упоПроектнаяЗадача
//  ПолучитьДоходы     - Булево
//  ПолучитьРасходы    - Булево
//
// Возвращаемое значение:
//  ДанныеБДР - см. упоДоходыИРасходыСервер.ШаблонТаблицыБДР
//  Неопределено
//
Функция ДанныеДоходовРасходовИзБазы(ПроектнаяЗадача, ПолучитьДоходы, ПолучитьРасходы) Экспорт
	
	Если Не ПолучитьДоходы И Не ПолучитьРасходы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеПланаБДР = ШаблонТаблицыБДР();
	
	Если ПроектнаяЗадача = Неопределено Тогда
		Возврат ДанныеПланаБДР;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    РегПлан.Статья КАК Статья,
		|    РегПлан.ПрофильРаспределения КАК ПрофильРаспределения,
		|    РегПлан.Сумма КАК Сумма,
		|    РегПлан.Контрагент КАК Контрагент,
		|    РегПлан.Договор КАК Договор,
		|    РегПлан.СпособПривязки КАК СпособПривязки,
		|    РегПлан.ДатаПривязки КАК ДатаПривязки,
		|    РегПлан.Валюта КАК Валюта,
		|    ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ПустаяСсылка) КАК ИсточникПлана,
		|    РегПлан.ВидЭлемента КАК ВидЭлемента
		|ИЗ
		|    РегистрСведений.упоДанныеПлановДоходовИРасходов.СрезПоследних(
		|            ,
		|            Версия = &ТекущаяВерсия
		|                И ПроектнаяЗадача = &ПЗ
		|                И ИСТИНА) КАК РегПлан
		|ГДЕ
		|    РегПлан.Сумма <> 0";
	
	ОтборПоНаправлениюДвижения = "ВидЭлемента = &НаправлениеДвиженияСредств";
	Если ПолучитьДоходы Тогда
		НаправлениеДвиженияСредств = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход;
	Иначе
		НаправлениеДвиженияСредств = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПЗ", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ТекущаяВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача));
	
	Если (ПолучитьДоходы Или ПолучитьРасходы) И Не (ПолучитьДоходы И ПолучитьРасходы) Тогда
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ИСТИНА", ОтборПоНаправлениюДвижения);
		Запрос.УстановитьПараметр("НаправлениеДвиженияСредств", НаправлениеДвиженияСредств);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ДанныеПланаБДР;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ДанныеПланаБДР.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Возврат ДанныеПланаБДР;
	
КонецФункции

#Область РаспределениеПоПодразделениям

// В строках распределения РаспределениеРасходов/РаспределениеДоходов создается строка, 
// СС/СП = Справочники.упоСобственныеСилыСубподряд.НДС с расчетом суммы от строки-владельца ПланРасходов/ПланДоходов.
// Суммы оставшихся строк распределения пропорционально уменьшаются.
//
// Параметры:
//  Объект  - ДокументОбъект.упоПроектнаяЗадача, Структура - ПЗ, структура ТЧ ПЗ.
//  СтрокаОсновнойТаблицы  - Структура - строка-владелец строк распределения.
//  ИмяОсновнойТаблицы  - Строка - "ПланРасходов"/"ПланДоходов"
//  СтрокиРаспределения	 - Массив, Неопределено - текущие строки таблицы распределения
//  НастройкиРаспределения	- Структура, Неопределено 
//
Процедура ВыделитьНДСВРаспределении(Объект, 
									СтрокаОсновнойТаблицы, 
									ИмяОсновнойТаблицы, 
									СтрокиРаспределения = Неопределено, 
									НастройкиРаспределения = Неопределено) Экспорт
									
	СтруктураИменТаблицРеквизитов = ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы);								
	
	Если СтруктураИменТаблицРеквизитов = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяТаблицыРаспределения = СтруктураИменТаблицРеквизитов.ИмяТаблицыРаспределения;
	ИмяТаблицыПоПериодам 	= СтруктураИменТаблицРеквизитов.ИмяТаблицыПоПериодам;
	ИмяИндексаПоПериодам 	= СтруктураИменТаблицРеквизитов.ИмяИндексаПоПериодам;
			
	СССП_ПоУмолчанию = ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");	
	СССП_НДС = ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.НДС");
																
	СуммаБезНДС = 0;	
	СуммаНДС = 0; 	
	МассивСумм = Новый Массив;
	СтрокаНДС = Неопределено;
	СтрокаНеНДС = Неопределено;			
	
	Если СтрокиРаспределения = Неопределено Тогда
		СтрокиРаспределения = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПодразделениям(СтрокаОсновнойТаблицы, 
			Объект[ИмяТаблицыРаспределения]);
	КонецЕсли;
	
	Если НастройкиРаспределения = Неопределено Тогда
		НастройкиРаспределения = НастройкиРаспределенияПоУмолчанию();
	КонецЕсли;	
	
	СтавкаНДСПроцент = СтавкаНДСПроцентЧисломПоСтрокеДР(СтрокаОсновнойТаблицы, НастройкиРаспределения);
		
	//
	
	сч = СтрокиРаспределения.Количество() - 1;
	Пока сч >= 0 Цикл
		СтрокаРаспределения = СтрокиРаспределения[сч];			
		Если СтрокаРаспределения.СобствСилы_Субподряд = СССП_НДС Тогда			
			СуммаНДС = СуммаНДС + СтрокаРаспределения.Сумма;
			СтрокаНДС = СтрокаРаспределения;
			СтрокиРаспределения.Удалить(сч);
		Иначе									
			СуммаБезНДС = СуммаБезНДС + СтрокаРаспределения.Сумма;
			СтрокаНеНДС = СтрокаРаспределения;
			МассивСумм.Вставить(0, СтрокаРаспределения.Сумма);			
		КонецЕсли;				
		сч = сч - 1;
	КонецЦикла;
			
	СуммаСтроки = СтрокаОсновнойТаблицы.Сумма;
			
	ДолжнаБытьСуммаНДС = Окр(СуммаСтроки * СтавкаНДСПроцент / (1 + СтавкаНДСПроцент), 2);
	
	Если ДолжнаБытьСуммаНДС = СуммаНДС Тогда
		Возврат; // Возврат.
	КонецЕсли;
	
	Если СтрокаНеНДС = Неопределено Тогда		
		МассивСумм.Добавить(СуммаСтроки);	
	КонецЕсли;		
	
	НужноРаспределитьНаСтроки = СуммаСтроки - ДолжнаБытьСуммаНДС;	
	РаспределенныеСуммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(НужноРаспределитьНаСтроки, 
																						МассивСумм, 
																						2);
																							
	Если РаспределенныеСуммы = Неопределено Тогда
		Возврат;
	КонецЕсли;
																							
	сч = 0;																					
	Для Каждого РаспределеннаяСумма Из РаспределенныеСуммы Цикл
		СтрокаРаспределения = СтрокиРаспределения[сч];	
		СтрокаРаспределения.Сумма = РаспределеннаяСумма;
		сч = сч + 1;	
	КонецЦикла;																				
																							
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ИсточникПлана", Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	ДанныеЗаполнения.Вставить("ИндексСтрокиВладельца", СтрокаОсновнойТаблицы.ИндексСтрокРаспределения);
	ДанныеЗаполнения.Вставить("СССП_ПоУмолчанию", СССП_ПоУмолчанию);
	ДанныеЗаполнения.Вставить("СССП_НДС", СССП_НДС);
	ДанныеЗаполнения.Вставить("СуммаНДС", ДолжнаБытьСуммаНДС);
	ДанныеЗаполнения.Вставить("СуммаНеНДС", СуммаСтроки);
	
	СпособПривязки = Неопределено;
	ПрофильРаспределения = Неопределено;
	ДатаПривязки = Неопределено;
	
	СтрокаОсновнойТаблицы.Свойство("СпособПривязки", СпособПривязки);
	СтрокаОсновнойТаблицы.Свойство("ПрофильРаспределения", ПрофильРаспределения);
	СтрокаОсновнойТаблицы.Свойство("ДатаПривязки", ДатаПривязки);
	
	Если ЗначениеЗаполнено(СпособПривязки) Тогда
		ДанныеЗаполнения.Вставить("СпособПривязки", СтрокаОсновнойТаблицы.СпособПривязки);
	КонецЕсли;
	Если ЗначениеЗаполнено(СпособПривязки) Тогда
		ДанныеЗаполнения.Вставить("ПрофильРаспределения", СтрокаОсновнойТаблицы.ПрофильРаспределения);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаПривязки) Тогда
		ДанныеЗаполнения.Вставить("ДатаПривязки", СтрокаОсновнойТаблицы.ДатаПривязки);
	КонецЕсли;
	

	ДобавитьСтрокиНДСПриОтсутствии(Объект, 
									СтрокиРаспределения, 
									СтрокаНеНДС, 
									СтрокаНДС, 
									ИмяТаблицыРаспределения, 
									НастройкиРаспределения, 
									ДанныеЗаполнения);
		
	// Периоды в таблице распределения располагаются при вызове из структуры.
	ПериодыВТаблицеРаспределения = НастройкиРаспределения.Свойство("ПериодыВТаблицеРаспределения") 
									И НастройкиРаспределения.ПериодыВТаблицеРаспределения;
									
	ПлановыеДанные = НастройкиРаспределения.Свойство("ПлановыеДанные") 
									И НастройкиРаспределения.ПлановыеДанные;								
			
КонецПроцедуры	

// В строках распределения РаспределениеРасходов/РаспределениеДоходов убирается строка, 
// СС/СП = Справочники.упоСобственныеСилыСубподряд.НДС.
// Суммы оставшихся строк распределения пропорционально увеличиваются.
//
// Параметры:
//  Объект  - ДокументОбъект.упоПроектнаяЗадача, Структура - ПЗ, структура ТЧ ПЗ.
//  СтрокаОсновнойТаблицы  - СтрокаТаблицыЗначений, СтрокаТабличнойЧасти - строка-владелец строк распределения.
//  ИмяОсновнойТаблицы  - Строка - "ПланРасходов"/"ПланДоходов"
//  СтрокиРаспределения	 - Массив, Неопределено - текущие строки таблицы распределения
//  НастройкиРаспределения	- Структура, Неопределено 
//
Процедура УбратьНДСИзРаспределения(Объект, 
								СтрокаОсновнойТаблицы, 
								ИмяОсновнойТаблицы, 
								СтрокиРаспределения = Неопределено, 
								НастройкиРаспределения = Неопределено) Экспорт
	
	Если ИмяОсновнойТаблицы = "ПланРасходов" Тогда
		ИмяТаблицыРаспределения = "РаспределениеРасходов";
		ИмяТаблицыПоПериодам = "РаспределениеРасходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределенияРасходов";
	ИначеЕсли ИмяОсновнойТаблицы = "ПланДоходов" Тогда
		ИмяТаблицыРаспределения = "РаспределениеДоходов";
		ИмяТаблицыПоПериодам = "РаспределениеДоходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределенияДоходов";
	ИначеЕсли ИмяОсновнойТаблицы = "МатериальныеРесурсы" Тогда
		ИмяТаблицыРаспределения = "РаспределениеПотребностей";
		ИмяТаблицыПоПериодам = "РаспределениеРасходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределениеПоРолям";
	ИначеЕсли ИмяОсновнойТаблицы = "ДополнительныеЗатраты" Тогда
		ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат";
		ИмяТаблицыПоПериодам = "РаспределениеРасходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределениеПоРолям";  
	Иначе
		Возврат;
	КонецЕсли;	
		
	СССП_НДС = ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.НДС");
																	
	СуммаНДС = 0; 	
	МассивСумм = Новый Массив;	
		
	Если СтрокиРаспределения = Неопределено Тогда
		СтрокиРаспределения = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПодразделениям(СтрокаОсновнойТаблицы, 
			Объект[ИмяТаблицыРаспределения]);
	КонецЕсли;
	
	Если НастройкиРаспределения = Неопределено Тогда
		НастройкиРаспределения = НастройкиРаспределенияПоУмолчанию();
	КонецЕсли;		
	
	// Периоды в таблице распределения располагаются при вызове из структуры.
	ПериодыВТаблицеРаспределения = НастройкиРаспределения.Свойство("ПериодыВТаблицеРаспределения") 
									И НастройкиРаспределения.ПериодыВТаблицеРаспределения;
	
	сч = СтрокиРаспределения.Количество() - 1;
	Пока сч >= 0 Цикл
		СтрокаРаспределения = СтрокиРаспределения[сч];			
		Если СтрокаРаспределения.СобствСилы_Субподряд = СССП_НДС Тогда			
			СуммаНДС = СуммаНДС + СтрокаРаспределения.Сумма;											
			СтрокиРаспределения.Удалить(сч);
			Если ПериодыВТаблицеРаспределения Тогда
				Объект[ИмяТаблицыРаспределения].Удалить(СтрокаРаспределения);
			Иначе
				упоПроектыИЗадачиОбщие.УдалитьСтрокуРаспределенияПоПодразделениям(СтрокаРаспределения, 
					Объект[ИмяТаблицыРаспределения], Объект[ИмяТаблицыПоПериодам], ИмяИндексаПоПериодам); 
			КонецЕсли;	
		Иначе									
			МассивСумм.Вставить(0, СтрокаРаспределения.Сумма);			
		КонецЕсли;				
		сч = сч - 1;
	КонецЦикла;
		
	Если СуммаНДС = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	СуммыДляДобавления = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СуммаНДС, МассивСумм, 2);		
	
	ПлановыеДанные = НастройкиРаспределения.Свойство("ПлановыеДанные") 
									И НастройкиРаспределения.ПлановыеДанные;
	
	УчестьНДСВСтрокахРаспределения(Объект, 
									ИмяТаблицыПоПериодам, 
									ИмяИндексаПоПериодам, 
									СуммыДляДобавления, 
									СтрокиРаспределения, 
									ПериодыВТаблицеРаспределения,
									ПлановыеДанные);
		
КонецПроцедуры	

// Возвращает таблицу из регистра упоАктуальныеПланыВыполненияОбъемов с разрезами указанных аналитик,
//  проиндексированную по полям отбора.
//
// Параметры:
//  МассивЗадач				 - Массив					 - (ДокументСсылка.упоПроектнаяЗадача, СправочникСсылка.Проекты) - проектные задачи,
//  					по которым собирается база распределения.
//  ПоляОтбораБазы			 - Массив					 - (Строка) - поля, по которым индексируется база распределения,
//  					и по которым в дальнейшем будет производиться поиск базы.
//  ПоляАналитикиБазы		 - Массив					 - поля - разрезы аналитики распределения, которые будут заполнены в таблице данных
//  					по базе распределения.
//  ВидОбъема				 - Строка					 - "Доход"/"Расход" - вид базы распределения, влияет на отбор в регистре.
//  НастройкиОбработкиЗадач	 - Неопределено, Структура	 - состав см. НастройкиОбработкиЗадачПоУмолчанию(),
//  	определяет настройку модификации запроса.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - база распределения.
//
Функция БазаРаспределения_ОбъемыБезНДС(МассивЗадач, ПоляОтбораБазы, ПоляАналитикиБазы,  
	Знач ВидОбъема = "Доход", НастройкиОбработкиЗадач = Неопределено) Экспорт			
	
	Если НастройкиОбработкиЗадач = Неопределено Тогда
		НастройкиОбработкиЗадач = НастройкиОбработкиЗадачПоУмолчанию();
	КонецЕсли;	
	
	ЧастиЗапроса = Новый Массив;
		
	ТекстЗадачи = ТекстЗапросаПроекты(НастройкиОбработкиЗадач);	
	Если ЗначениеЗаполнено(ТекстЗадачи) Тогда
		ЧастиЗапроса.Добавить(ТекстЗадачи);
	КонецЕсли;	

	ТекстДанные = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	втЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТаблицаБазы.Подразделение КАК Подразделение,
	               |	СУММА(ТаблицаБазы.Сумма) КАК Сумма
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыВыполненияОбъемов.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача В
	               |					(ВЫБРАТЬ
	               |						втЗадачи.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
	               |					ИЗ
	               |						втЗадачи КАК втЗадачи)
	               |				И ВидОбъема = &ВидОбъема
	               |				И СобствСилы_Субподряд <> &СССП_НДС) КАК ТаблицаБазы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО ТаблицаБазы.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадачи КАК втЗадачи
	               |		ПО ТаблицаБазы.ПроектнаяЗадача = втЗадачи.СсылкаНаПроектнуюЗадачу
	               |ГДЕ
	               |	(ТаблицаБазы.Сумма <> 0
	               |			ИЛИ ТаблицаБазы.СуммаВалютная <> 0
	               |			ИЛИ ТаблицаБазы.Количество <> 0)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаБазы.Подразделение,
	               |	втЗадачи.ПроектнаяЗадача";
						
	ТекстДанные = ИзменитьТекстЗапросаРаспределенияПоНастройкам(ТекстДанные, 
																ПоляОтбораБазы, 
																ПоляАналитикиБазы, 
																НастройкиОбработкиЗадач);
	ЧастиЗапроса.Добавить(ТекстДанные);

	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, ";");
		
	Запрос = Новый Запрос(ТекстЗапроса);	
	ВидОбъема = ?(ВидОбъема = "Доход", 
				Перечисления.упоВидЭлементаОбъемов.Доход, 
				Перечисления.упоВидЭлементаОбъемов.Расход);
	Запрос.УстановитьПараметр("ВидОбъема", ВидОбъема);
	Запрос.УстановитьПараметр("МассивПроектныхЗадач", МассивЗадач);
	Запрос.УстановитьПараметр("СССП_НДС", Справочники.упоСобственныеСилыСубподряд.НДС);			
		
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	БазаРаспределения = Результат.Выгрузить();	
	КлючПоиска = СтрСоединить(ПоляОтбораБазы, ",");
	БазаРаспределения.Индексы.Добавить(КлючПоиска);
	
	Возврат БазаРаспределения;
	
КонецФункции	

// Возвращает таблицу из регистра упоАктуальныеПланыДоходовИРасходовПодразделения с разрезами указанных аналитик,
