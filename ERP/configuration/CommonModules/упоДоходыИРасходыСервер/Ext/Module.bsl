Функция СтавкаНДСПроцентЧисломПоСтрокеДР(СтрокаОсновнойТаблицы, НастройкиРаспределения) Экспорт
	
	Если ЗначениеЗаполнено(СтрокаОсновнойТаблицы.Договор) Тогда
		СтавкаНДСПроцент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОсновнойТаблицы.Договор, "СтавкаНДС");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(СтавкаНДСПроцент) Тогда
		СтавкаНДСПроцент = НастройкиРаспределения.СтавкаНДС;
	КонецЕсли;
	
	Если ТипЗнч(СтавкаНДСПроцент) = Тип("СправочникСсылка.СтавкиНДС") Тогда
		РеквизитПеречисления = "ПеречислениеСтавкаНДС";
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта(РеквизитПеречисления, СтавкаНДСПроцент.Метаданные()) Тогда
			СтавкаНДСПроцент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтавкаНДСПроцент, РеквизитПеречисления);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(СтавкаНДСПроцент) = Тип("ПеречислениеСсылка.СтавкиНДС") Тогда
		СтавкаНДСПроцентЧислом = упоФункцииОбщегоНазначенияКлиентСервер.ПолучитьСтавкуНДСЧислом(СтавкаНДСПроцент);
	ИначеЕсли ТипЗнч(СтавкаНДСПроцент) = Тип("Число") Тогда 
		СтавкаНДСПроцентЧислом = СтавкаНДСПроцент;
	Иначе
		СтавкаНДСПроцентЧислом = Неопределено;
	КонецЕсли;
	
	Если СтавкаНДСПроцентЧислом = Неопределено Тогда
		ТекстыСообщения = Новый Массив;
		ТекстыСообщения.Добавить(НСтр("ru = 'Не найдена ставка НДС для расчета суммы НДС.'"));
		Если ЗначениеЗаполнено(СтрокаОсновнойТаблицы.Договор) Тогда
			ТекстыСообщения.Добавить(НСтр("ru = 'Проверьте, что в договоре заполнены необходимые реквизиты.'"));
		КонецЕсли;
		ТекстИсключения = СтрСоединить(ТекстыСообщения, Символы.ПС);
		ВызватьИсключение(ТекстИсключения, КатегорияОшибки.ОшибкаХранимыхДанных);
	КонецЕсли;
	
	Возврат СтавкаНДСПроцентЧислом;
	
КонецФункции

Функция ИзменитьТекстЗапросаРаспределенияПоНастройкам(ТекстЗапроса, 
														ПоляОтбораБазы, 
														ПоляАналитикиБазы,
														НастройкиОбработкиЗадач)
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ВыбираемыеПоля 	= СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля;	
	Группировка 	= СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Группировка;
	
	Для Каждого ПолеОтбораБазы Из ПоляОтбораБазы Цикл
		Если ПолеОтбораБазы = "ПроектнаяЗадача" Тогда
			Продолжить;
		КонецЕсли;	
		ДобавляемоеПоле = "ТаблицаБазы." + ПолеОтбораБазы;	
		ВыбираемыеПоля.Добавить(ДобавляемоеПоле);	
		Группировка.Добавить(ДобавляемоеПоле);
	КонецЦикла;	
	
	ЕстьСтатья = Ложь;
	Для Каждого ПолеАналитикиБазы Из ПоляАналитикиБазы Цикл
		Если ПолеАналитикиБазы = "Подразделение" Тогда
			Продолжить;
		КонецЕсли;	
		
		ДобавляемоеПоле = "ТаблицаБазы." + ПолеАналитикиБазы;			
		
		ВыбираемыеПоля.Добавить(ДобавляемоеПоле);	
		Группировка.Добавить(ДобавляемоеПоле);
		
		КолонкиПакета = СхемаЗапроса.ПакетЗапросов[0].Колонки;		
		ИндексКолонки = КолонкиПакета.Количество() - 1;
		КолонкиПакета[ИндексКолонки].Псевдоним = ПолеАналитикиБазы;
	КонецЦикла;	
	
	// Если нет статьи - убираем из запроса таблицу сопоставления упоСоответствиеСтатейДР.
	Если Не ЕстьСтатья Тогда
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники.Удалить(3);
	КонецЕсли;	
	
	// Если в таблице данных ПЗ представлены как документы - убираем данные Справочник.Проекты.
	Если Не НастройкиОбработкиЗадач.ПроектнаяЗадачаКакСправочник Тогда						
		
		ВыбираемыеПоля[0] = Новый ВыражениеСхемыЗапроса("ТаблицаБазы.ПроектнаяЗадача");
		
		// Замена выражения в параметрах виртуальной таблицы.
		УсловиеОтбора = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[1].Выражение;
		НаборУсловий = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(УсловиеОтбора, "И ", , Истина);
		КоличествоУсловий = НаборУсловий.Количество();
		Сч = 0;
		ЗаменяемоеУсловие = "ПроектнаяЗадача";			
		Пока Сч < КоличествоУсловий Цикл 	
			Если Лев(НаборУсловий[Сч], СтрДлина(ЗаменяемоеУсловие)) = ЗаменяемоеУсловие Тогда
				НаборУсловий[Сч] = "ПроектнаяЗадача В (&МассивПроектныхЗадач)";
				Прервать;
			КонецЕсли;	
			Сч = Сч + 1;
		КонецЦикла;	
			
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[1].Выражение = 
			Новый ВыражениеСхемыЗапроса(СтрСоединить(НаборУсловий, " И "));
			
		// Удаление таблицы соединения со справочником Проекты.	
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники.Удалить(2);
		
	КонецЕсли;			
	
	Возврат СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецФункции	

Функция ТекстЗапросаПроекты(НастройкиОбработкиЗадач)
	
	ТекстЗапроса = "";
	
	Если Не НастройкиОбработкиЗадач.ПроектнаяЗадачаКакСправочник Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	Если НастройкиОбработкиЗадач.ПолучитьДанныеВложенныхЗадач Тогда
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Проекты.Ссылка КАК Ребенок,
		               |	Проекты.Родитель КАК Родитель
		               |ПОМЕСТИТЬ ВТ_ВложенныеПЗ
		               |ИЗ
		               |	Справочник.Проекты КАК Проекты
		               |ГДЕ
		               |	Проекты.Ссылка В ИЕРАРХИИ(&МассивПроектныхЗадач)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	Проекты.Ссылка,
		               |	Проекты.Ссылка
		               |ИЗ
		               |	Справочник.Проекты КАК Проекты
		               |ГДЕ
		               |	Проекты.Ссылка В(&МассивПроектныхЗадач)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаПроекты.Родитель.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		               |	ТаблицаПроекты.Ребенок.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
		               |ПОМЕСТИТЬ втЗадачи
		               |ИЗ
		               |	ВТ_ВложенныеПЗ КАК ТаблицаПроекты
		               |ГДЕ
		               |	ТаблицаПроекты.Родитель В(&МассивПроектныхЗадач)
		               |	И НЕ ТаблицаПроекты.Родитель = ТаблицаПроекты.Ребенок";
		
		Если Не НастройкиОбработкиЗадач.ВернутьПЗКакДокумент Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
										"ТаблицаПроекты.Родитель.СсылкаНаПроектнуюЗадачу", 
										"ТаблицаПроекты.Родитель"); 	
		КонецЕсли;	
		
		упоПроектыИЗадачиСервер.ВставитьВТекстЗапросаПодчиненныеЗадачи(ТекстЗапроса, "ВТ_ВложенныеПЗ");
		
	Иначе	
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТаблицаПроекты.Ссылка КАК ПроектнаяЗадача,
		               |	ТаблицаПроекты.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
		               |ПОМЕСТИТЬ втЗадачи
		               |ИЗ
		               |	Справочник.Проекты КАК ТаблицаПроекты
		               |ГДЕ
		               |	ТаблицаПроекты.Ссылка В(&МассивПроектныхЗадач)";
	КонецЕсли;	

	Возврат ТекстЗапроса;
	
КонецФункции	

Процедура ЗаполнитьСпособПривязкиПрофильВСтрокеРаспределения(Строка, ИмяТаблицы, СтруктураСвойствПоУмолчанию)
			
	Если ИмяТаблицы = "РаспределениеДоходов" 
		Или ИмяТаблицы = "РаспределениеОбъемов" Тогда
				
		Строка.СпособПривязки = ОбщегоНазначения.ПредопределенныйЭлемент(
			"Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения");
		Строка.ПрофильРаспределения = СтруктураСвойствПоУмолчанию.ПрофильДоходовПоУмолчанию;
		
	КонецЕсли;
	
	Если ИмяТаблицы = "РаспределениеРасходов"
		Или ИмяТаблицы = "РаспределениеПотребностей" Тогда
				
		Строка.СпособПривязки = ОбщегоНазначения.ПредопределенныйЭлемент(
			"Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения");
		Строка.ПрофильРаспределения = СтруктураСвойствПоУмолчанию.ПрофильРасходовПоУмолчанию;	
		
	КонецЕсли;	
		
КонецПроцедуры

Функция СписокПериодов(ДатаНач, ДатаКон, ТолькоПолныеМесяцы)
	
	СписокПериодов = Новый Массив();
						
	Если Год(ДатаНач) = Год(ДатаКон) И Месяц(ДатаНач) = Месяц(ДатаКон) Тогда
		
		// Самый простой случай, когда общий период укладывается в один месяц.
		
		СписокПериодов.Добавить(ДатаНач);
		
	Иначе	
		
		// Более сложный случай, нужно строить список месяцев.
		
		СписокПериодов.Добавить(ДатаНач);
		ТекДата = ДатаНач;
		СписокПостроен = Ложь;
		
		Пока Не СписокПостроен Цикл   
			
			НовыйПериод = ДобавитьМесяц(ТекДата, 1);
			Если НовыйПериод < ДатаКон Тогда
				СписокПериодов.Добавить(НовыйПериод);
			ИначеЕсли НовыйПериод = ДатаКон Тогда
				СписокПериодов.Добавить(НовыйПериод);
				СписокПостроен = Истина;
			Иначе
				Если Год(НовыйПериод) = Год(ДатаКон) И Месяц(НовыйПериод) = Месяц(ДатаКон) Тогда
					СписокПериодов.Добавить(ДатаКон);
				КонецЕсли; 	
				СписокПостроен = Истина;
			КонецЕсли; 
			
			ТекДата = НовыйПериод;
			
		КонецЦикла;           			
		
		УдалитьНеполныеМесяцыИзСпискаПериодов(СписокПериодов, ДатаНач, ДатаКон, ТолькоПолныеМесяцы);

	КонецЕсли;
	
	Возврат СписокПериодов;
	
КонецФункции

// В случае, если была задана опция "только полные месяцы", список
// нужно просмотреть на предмет неполных месяцев.
//
Процедура УдалитьНеполныеМесяцыИзСпискаПериодов(СписокПериодов, ДатаНач, ДатаКон, ТолькоПолныеМесяцы)
		
	Если Не ТолькоПолныеМесяцы Тогда
		Возврат;
	КонецЕсли;	
	
	// Неполными могут быть либо первый, либо последний.
	
	Если НачалоДня(ДатаНач) > НачалоДня(НачалоМесяца(ДатаНач)) Тогда
		СписокПериодов.Удалить(0);
	КонецЕсли; 
	
	Если СписокПериодов.Количество() > 0 Тогда
		Если НачалоДня(ДатаКон) < НачалоДня(КонецМесяца(ДатаКон)) Тогда
			СписокПериодов.Удалить(СписокПериодов.Количество() - 1);	
		КонецЕсли; 
	КонецЕсли; 
	
	// Если в общем периоде нет ни одного полного месяца, возвращаем даты начала и окончания.
	
	Если СписокПериодов.Количество() = 0 Тогда
		СписокПериодов.Добавить(ДатаНач);
		СписокПериодов.Добавить(ДатаКон);
	КонецЕсли; 		
	
КонецПроцедуры	

Процедура РаспределитьСуммуПоПериодам(Результат, Сумма, СписокПериодов, СпособПривязкиКМесяцу, РаспределяетсяКоличество)
	
	Если СписокПериодов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если РаспределяетсяКоличество Тогда
		Разрядность = 3;
		ИмяКолонкиРаспределения = "Количество";
	Иначе
		Разрядность = 2;
		ИмяКолонкиРаспределения = "Сумма";
	КонецЕсли;	
	
	ДоляСуммы = Окр(Сумма / СписокПериодов.Количество(), Разрядность);
	Если Сумма <> 0 И ДоляСуммы = 0 Тогда
		Если РаспределяетсяКоличество Тогда
			ДоляСуммы = 0.001;
		Иначе
			ДоляСуммы = 0.01;
		КонецЕсли;	
	КонецЕсли;
	
	Итог = Результат.Итог(ИмяКолонкиРаспределения);
	ОстатокРаспределения = Сумма;
	Для Счетчик = 0 По СписокПериодов.Количество() - 1 Цикл   
		
		СтрокаРезультат = Результат.Добавить();
		
		Если СпособПривязкиКМесяцу = 
			Перечисления.упоСпособПривязкиДоходовИРасходовКМесяцу.НачалоМесяца Тогда
			СтрокаРезультат.Период = НачалоМесяца(СписокПериодов[Счетчик]);
		ИначеЕсли СпособПривязкиКМесяцу = 
			Перечисления.упоСпособПривязкиДоходовИРасходовКМесяцу.ЗавершениеМесяца Тогда
			СтрокаРезультат.Период = КонецМесяца(СписокПериодов[Счетчик]);
		Иначе
			// Нештатная ситуация.
			Результат.Удалить(СтрокаРезультат);
			Продолжить;
		КонецЕсли; 
		
		// Не забываем учесть погрешности деления и округления.
		Если ОстатокРаспределения > 0 Тогда
			СтрокаРезультат[ИмяКолонкиРаспределения] = Мин(ДоляСуммы, ОстатокРаспределения);
		Иначе
			Продолжить;
		КонецЕсли;  
		Итог = Итог + СтрокаРезультат[ИмяКолонкиРаспределения];
		ОстатокРаспределения = Сумма - Итог;
		
	КонецЦикла; 		
	
	Если Не СтрокаРезультат = Неопределено 
		И Не ОстатокРаспределения = 0 Тогда
		СтрокаРезультат[ИмяКолонкиРаспределения] = СтрокаРезультат[ИмяКолонкиРаспределения] + ОстатокРаспределения;
	КонецЕсли;	
	
КонецПроцедуры

Процедура УчестьНДСВСтрокахРаспределения(Объект, 
										ИмяТаблицыПоПериодам, 
										ИмяИндексаПоПериодам, 
										СуммыДляДобавления, 
										СтрокиРаспределения, 
										ПериодыВТаблицеРаспределения,
										ПлановыеДанные) 
		
	сч = 0;
	Для Каждого СуммаДляДобавления Из СуммыДляДобавления Цикл
		
		СтрокаРаспределения = СтрокиРаспределения[сч];	
		
		СтрокаРаспределения.Сумма = СтрокаРаспределения.Сумма + СуммаДляДобавления;
		
		// В фактических данных таблицы периодов нет.
		Если Не ПлановыеДанные Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ПериодыВТаблицеРаспределения Тогда			
			СчДоб = Объект.ТаблицаДобавленныеКолонки.Количество() - 1; 
			Пока СчДоб >= 0 Цикл
				СтрокаКолонки = Объект.ТаблицаДобавленныеКолонки[СчДоб];
				
				Если ЗначениеЗаполнено(СтрокаРаспределения[СтрокаКолонки.ИмяКолонкиСумма]) Тогда
					СтрокаРаспределения[СтрокаКолонки.ИмяКолонкиСумма] = СтрокаРаспределения[СтрокаКолонки.ИмяКолонкиСумма] 
																		+ СуммаДляДобавления;
					Прервать;
				КонецЕсли;					
				СчДоб = СчДоб - 1;																			
			КонецЦикла;									
		Иначе	
			СтрокиПоПериодам = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПериодам(СтрокаРаспределения, 
																							Объект[ИмяТаблицыПоПериодам], 
																							ИмяИндексаПоПериодам);					
			Если СтрокиПоПериодам.Количество() Тогда
				ПоследнееЗначение = СтрокиПоПериодам[СтрокиПоПериодам.Количество() - 1];
				ПоследнееЗначение.Сумма = ПоследнееЗначение.Сумма + СуммаДляДобавления;
			КонецЕсли;
		КонецЕсли;	
		
		сч = сч + 1;
	КонецЦикла;

КонецПроцедуры	

Процедура ДобавитьСтрокиНДСПриОтсутствии(Объект, 
										СтрокиРаспределения, 
										СтрокаНеНДС, 
										СтрокаНДС, 
										ИмяТаблицыРаспределения, 
										НастройкиРаспределения, 
										ДанныеЗаполнения)
					
	Если СтрокаНеНДС = Неопределено Или СтрокаНДС = Неопределено Тогда
		Если НастройкиРаспределения.Свойство("Проект") Тогда
			Проект = НастройкиРаспределения.Проект;
		Иначе
			Проект = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.Проекты.ПустаяСсылка");	
		КонецЕсли;
		СтруктураСвойствПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект);		
		
		ПлановыеДанные = НастройкиРаспределения.Свойство("ПлановыеДанные") 
									И НастройкиРаспределения.ПлановыеДанные;
	КонецЕсли;
	
	Если СтрокаНеНДС = Неопределено Тогда		
		СтрокаНеНДС = Объект[ИмяТаблицыРаспределения].Добавить();
		// Заполняются ИндексСтрокиВладельца И ИсточникПлана (при наличии).
		ЗаполнитьЗначенияСвойств(СтрокаНеНДС, ДанныеЗаполнения); 
		СтрокаНеНДС.СобствСилы_Субподряд 	= ДанныеЗаполнения.СССП_ПоУмолчанию;				
		СтрокаНеНДС.Сумма 					= ДанныеЗаполнения.СуммаНеНДС;
		Если ПлановыеДанные Тогда
			ЗаполнитьСпособПривязкиПрофильВСтрокеРаспределения(СтрокаНеНДС, 
																ИмяТаблицыРаспределения, 
																СтруктураСвойствПоУмолчанию);		
		КонецЕсли;	
		СтрокиРаспределения.Добавить(СтрокаНеНДС); 		
	КонецЕсли;
	
	Если СтрокаНДС = Неопределено Тогда
		СтрокаНДС = Объект[ИмяТаблицыРаспределения].Добавить();
		// Заполняются ИндексСтрокиВладельца И ИсточникПлана (при наличии).
		ЗаполнитьЗначенияСвойств(СтрокаНДС, ДанныеЗаполнения); 
		СтрокаНДС.СобствСилы_Субподряд = ДанныеЗаполнения.СССП_НДС;				
	КонецЕсли;
	
	СтрокиНДС = Объект[ИмяТаблицыРаспределения].НайтиСтроки(Новый Структура("СобствСилы_Субподряд, ИндексСтрокиВладельца", 
		ДанныеЗаполнения.СССП_НДС, ДанныеЗаполнения.ИндексСтрокиВладельца)); 
	
	Если СтрокиНДС.Количество() > 1 Тогда	
		Для Каждого СтрокаНДС Из СтрокиНДС Цикл
			Объект[ИмяТаблицыРаспределения].Удалить(СтрокаНДС);			
		КонецЦикла;
		СтрокаНДС = Объект[ИмяТаблицыРаспределения].Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаНДС, ДанныеЗаполнения); 
		СтрокаНДС.СобствСилы_Субподряд = ДанныеЗаполнения.СССП_НДС;	
	КонецЕсли;
	
	СтрокаНДС.Сумма = ДанныеЗаполнения.СуммаНДС;
	
КонецПроцедуры	

Функция ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы)			
	
	Если ИмяОсновнойТаблицы = "ПланРасходов" 
		Или ИмяОсновнойТаблицы = "Расходы" Тогда
		ИмяТаблицыРаспределения = "РаспределениеРасходов";
		ИмяТаблицыПоПериодам = "РаспределениеРасходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределенияРасходов";
	ИначеЕсли ИмяОсновнойТаблицы = "ПланДоходов"
		Или ИмяОсновнойТаблицы = "Доходы" Тогда
		ИмяТаблицыРаспределения = "РаспределениеДоходов";
		ИмяТаблицыПоПериодам = "РаспределениеДоходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределенияДоходов";
	ИначеЕсли ИмяОсновнойТаблицы = "Субпродукты" Тогда
		ИмяТаблицыРаспределения = "РаспределениеОбъемов";
		ИмяТаблицыПоПериодам = "РаспределениеДоходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределениеПоРолям";		
	ИначеЕсли ИмяОсновнойТаблицы = "МатериальныеРесурсы" Тогда
		ИмяТаблицыРаспределения = "РаспределениеПотребностей";
		ИмяТаблицыПоПериодам = "РаспределениеРасходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокиРаспределениеПоРолям";
	ИначеЕсли ИмяОсновнойТаблицы = "ДоходныеОбъемы" Тогда
		ИмяТаблицыРаспределения = "РаспределениеДоходныхОбъемов";
		ИмяТаблицыПоПериодам = "";
		ИмяИндексаПоПериодам = "";
	ИначеЕсли ИмяОсновнойТаблицы = "РасходныеОбъемы" Тогда
		ИмяТаблицыРаспределения = "РаспределениеРасходныхОбъемов";
		ИмяТаблицыПоПериодам = "";
		ИмяИндексаПоПериодам = "";
	ИначеЕсли ИмяОсновнойТаблицы = "ЗатратыМатРесурсовФакт" Тогда
		ИмяТаблицыРаспределения = "РаспределениеЗатрат";
		ИмяТаблицыПоПериодам = "";
		ИмяИндексаПоПериодам = "";
	ИначеЕсли ИмяОсновнойТаблицы = "ДополнительныеЗатраты" Тогда
		ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат";
		ИмяТаблицыПоПериодам = "РаспределениеРасходовПоПериодам";
		ИмяИндексаПоПериодам = "ИндексСтрокРаспределенияПоПериодам";	
	Иначе
		Возврат Неопределено;
	КонецЕсли;	

	Результат = Новый Структура;
	Результат.Вставить("ИмяТаблицыРаспределения", 	ИмяТаблицыРаспределения);
	Результат.Вставить("ИмяТаблицыПоПериодам", 		ИмяТаблицыПоПериодам);
	Результат.Вставить("ИмяИндексаПоПериодам", 		ИмяИндексаПоПериодам);
	
	Возврат Результат;
	
КонецФункции	

Функция ЗначениеСтавкиНДСИзНастройкиРаспределенияБДРПроекта(Проект)
	
	СтавкаНДС = Неопределено;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоНастройкиРаспределенияБДР.СтавкаНДС КАК СтавкаНДС
	               |ИЗ
	               |	РегистрСведений.упоНастройкаАналитикиВРазрезеПодразделений КАК упоНастройкаАналитикиВРазрезеПодразделений
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоНастройкиРаспределенияБДР КАК упоНастройкиРаспределенияБДР
	               |		ПО упоНастройкаАналитикиВРазрезеПодразделений.НастройкаРаспределенияБДР = упоНастройкиРаспределенияБДР.Ссылка
	               |			И (упоНастройкаАналитикиВРазрезеПодразделений.Объект = &Проект)";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтавкаНДС = Выборка.СтавкаНДС;
	КонецЕсли;
	
	Возврат СтавкаНДС;
	
КонецФункции

#КонецОбласти