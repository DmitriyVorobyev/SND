Процедура ДобавитьВМассив(Массив, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;	
	
	Поиск = Массив.Найти(Значение);
	Если Поиск = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
		
