	|			И (упоВерсииПроекта.Текущая)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоФактДоходовИРасходовОборотыОбороты.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	упоФактДоходовИРасходовОборотыОбороты.Подразделение КАК Подразделение,
	|	упоФактДоходовИРасходовОборотыОбороты.СуммаОборот КАК Сумма
	|ПОМЕСТИТЬ ВТ_Факт
	|ИЗ
	|	РегистрНакопления.упоФактДоходовИРасходовОбороты.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			ВидЭлемента = &ВидРасхода
	|				И Статья В
	|					(ВЫБРАТЬ
	|						ВТ_ПрямыеСтатьи.Статья
	|					ИЗ
	|						ВТ_ПрямыеСтатьи КАК ВТ_ПрямыеСтатьи)
	|				И НЕ СобствСилы_Субподряд = &НДС) КАК упоФактДоходовИРасходовОборотыОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПЗы КАК ПЗы
	|		ПО упоФактДоходовИРасходовОборотыОбороты.ПроектнаяЗадача = ПЗы.ПроектнаяЗадача
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_Факт.Сумма) КАК Сумма,
	|	ВТ_Факт.Подразделение КАК Подразделение,
	|	ВТ_Факт.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	ВТ_Факт КАК ВТ_Факт
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Факт.Подразделение,
	|	ВТ_Факт.ПроектнаяЗадача";
	
КонецФункции

