// Удаляет имя реквизита "Валюта" из массива ПроверяемыеРеквизиты.
//
// Параметры:
//  ПроверяемыеРеквизиты - Массив
//
Процедура УдалитьЭлементВалютаИзПроверяемыхРеквизитов(ПроверяемыеРеквизиты) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	ИндексВалюты = ПроверяемыеРеквизиты.Найти("Валюта");
	Если ИндексВалюты <> Неопределено Тогда
		ПроверяемыеРеквизиты.Удалить(ИндексВалюты);
	КонецЕсли;
	
КонецПроцедуры

