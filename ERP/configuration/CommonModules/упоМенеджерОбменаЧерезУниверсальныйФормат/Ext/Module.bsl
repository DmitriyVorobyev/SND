Процедура ПКО_Контрагенты_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.КлючевыеСвойства.Свойство("ЮридическоеФизическоеЛицо") Тогда
		ЗначениеСвойства = ДанныеXDTO.КлючевыеСвойства.ЮридическоеФизическоеЛицо.Значение;
		Если ЗначениеСвойства = "ФизическоеЛицо" Тогда
			ПолученныеДанные.ВидКонтрагента = "ИндивидуальныйПредприниматель";
		ИначеЕсли ЗначениеСвойства = "ЮридическоеЛицо" Тогда
			ПолученныеДанные.ВидКонтрагента = "ЮрЛицо";
		Иначе
			ПолученныеДанные.ВидКонтрагента = "ЮрЛицо";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Подразделения_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		Если ДанныеXDTO.AdditionalInfo.Свойство("Организация") Тогда
			Если ДанныеXDTO.AdditionalInfo.Организация.Свойство("УникальныйИдентификатор") Тогда
				ПолученныеДанные.Владелец = Справочники.Организации.ПолучитьСсылку(ДанныеXDTO.AdditionalInfo.Организация.УникальныйИдентификатор);
			ИначеЕсли ДанныеXDTO.AdditionalInfo.Организация.Свойство("Наименование") Тогда
				ПолученныеДанные.Владелец = Справочники.Организации.НайтиПоНаименованию(ДанныеXDTO.AdditionalInfo.Организация.Наименование);
			КонецЕсли;
		КонецЕсли;
		Если ДанныеXDTO.AdditionalInfo.Свойство("КодВПрограмме") Тогда
			ПолученныеДанные.Код = ДанныеXDTO.AdditionalInfo.КодВПрограмме;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Подразделения_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ДанныеИБ <> Неопределено Тогда
		Если ЗначениеЗаполнено(ПолученныеДанные.Код) Тогда
			ДанныеИБ.Код = ПолученныеДанные.Код;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_ДоговорыКонтрагентов_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("ВидДоговора", "Прочее");
КонецПроцедуры
Процедура ПКО_Справочник_Контрагенты_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если ДанныеИБ.ВидКонтрагента = "ЮрЛицо" Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("ЮридическоеФизическоеЛицо", "ЮридическоеЛицо");
	ИначеЕсли ДанныеИБ.ВидКонтрагента = "ИндивидуальныйПредприниматель" Тогда
		ДанныеXDTO.КлючевыеСвойства.Вставить("ЮридическоеФизическоеЛицо", "ФизическоеЛицо");
	КонецЕсли;
КонецПроцедуры
Процедура ПКО_Справочник_Организации_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("ЮридическоеФизическоеЛицо", "ЮридическоеЛицо");
КонецПроцедуры
Процедура ПКО_Справочник_Номенклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ДанныеXDTO.Вставить("Артикул", ДанныеИБ.Код);
	ДанныеXDTO.Вставить("ТипНоменклатуры", "Товар");
	ДанныеXDTO.Вставить("НаименованиеПолное", ДанныеИБ.Наименование);
	Если Не ЗначениеЗаполнено(ДанныеИБ.ЕдиницаИзмерения) Тогда
		ЕдиницаПоУмолчанию = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт", Истина);
		ДанныеXDTO.Вставить("ЕдиницаИзмерения", ЕдиницаПоУмолчанию);
	Иначе
		ДанныеXDTO.Вставить("ЕдиницаИзмерения", ДанныеИБ.ЕдиницаИзмерения);
	КонецЕсли;
	
КонецПроцедуры

