		ДобавитьПКО_СтатьиРасходов_Отправка(ПравилаКонвертации);
	ИначеЕсли НаправлениеОбмена = "Получение" Тогда
		ДобавитьПКО_Валюты(ПравилаКонвертации);
		ДобавитьПКО_ДоговорыКонтрагентов(ПравилаКонвертации);
		ДобавитьПКО_Контрагенты(ПравилаКонвертации);
		ДобавитьПКО_КонтрагентыГруппа(ПравилаКонвертации);
		ДобавитьПКО_Организации(ПравилаКонвертации);
