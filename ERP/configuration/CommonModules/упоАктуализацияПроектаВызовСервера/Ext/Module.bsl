Функция АктуализацияФинансовыхПлановПроектаПоПодразделениям_ПерезаписьАктуальныхПланов(ДокументОбъект, ДанныеДокумента, СоответствиеСроковЗадач, 
	Движения, МВТ, Отказ) 
	
	СвойстваПроведения = Новый Структура;
	СвойстваПроведения.Вставить("текВерсия", 	ДанныеДокумента.ТекущаяВерсияПроекта);
	СвойстваПроведения.Вставить("МВТ", 			МВТ);
	
	упоАналитикаПоПодразделениямСервер.АктуализацияДанныхДоходовРасходов(ДокументОбъект, ДанныеДокумента, 
		СоответствиеСроковЗадач, СоответствиеСроковЗадач, 
		Движения.упоАктуальныеПланыДоходовИРасходовПодразделения, СвойстваПроведения, Отказ);
	
	упоАналитикаПоПодразделениямСервер.АктуализацияПлановыхОбъемов(ДокументОбъект, ДанныеДокумента,
		СоответствиеСроковЗадач, СоответствиеСроковЗадач, 
		Движения.упоАктуальныеПланыВыполненияОбъемов, СвойстваПроведения, Отказ);
	
КонецФункции

Функция АктуализацияФинансовыхПлановПроектаПоПодразделениям_ПолныйПересчет(ДанныеДокумента, СоответствиеСроковЗадач, 
	Движения, МассивЗадач, Отказ) 
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ДанныеДокумента.Проект);
	
	СтрокаПараметрыКонтрагентовПроекта = "КонтрагентДоходов, КонтрагентЗатрат, ДоговорДоходов, ДоговорЗатрат";
	ПараметрыПроекта = упоФункцииБСП.ЗначенияРеквизитовОбъектаВызовСервера(ДанныеДокумента.Проект, 
		СтрокаПараметрыКонтрагентовПроекта);
	
	СвойстваПроведения = Новый Структура(СтрокаПараметрыКонтрагентовПроекта);
	ЗаполнитьЗначенияСвойств(СвойстваПроведения, ПараметрыПроекта);
	
	СвойстваПроведения.Вставить("Проект", 			ДанныеДокумента.Проект);
	СвойстваПроведения.Вставить("Версия", 			ДанныеДокумента.ТекущаяВерсияПроекта);
	СвойстваПроведения.Вставить("ПроектнаяЗадача", 	МассивЗадач);
	СвойстваПроведения.Вставить("СрокиЗадач", 		СоответствиеСроковЗадач);
	
	упоАналитикаПоПодразделениямСервер.ЗаполнитьОбщиеНастройкиУчетаПоПодразделениям(ДанныеДокумента.Ссылка, 
		СвойстваПроведения);
	
	ДанныеДляАктуализацииПоПодразделениям = Новый Структура;
	ДанныеДляАктуализацииПоПодразделениям.Вставить("упоАктуальныеПланыДоходовИРасходовПодразделения", 
		Движения.упоАктуальныеПланыДоходовИРасходовПодразделения); 
	ДанныеДляАктуализацииПоПодразделениям.Вставить("упоАктуальныеПланыВыполненияОбъемов", 
		Движения.упоАктуальныеПланыВыполненияОбъемов); 
	
	упоАналитикаПоПодразделениямСервер.ПодготовитьТаблицыДвижений(ДанныеДокумента.Ссылка,
		ДанныеДляАктуализацииПоПодразделениям,
		СвойстваПроекта,
		СвойстваПроведения,
		Отказ);
	
КонецФункции

Функция ПроверитьИнициализироватьМенеджерВТ(МассивЗадач, ТекВерсия, МВТ = Неопределено)
	
	Если МВТ <> Неопределено Тогда
		Возврат МВТ;
	КонецЕсли;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	ТекстОтбораПоЗадачам = ?(МассивЗадач = Неопределено, "", " И ПроектнаяЗадача В (&ПроектныеЗадачи)");
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Т.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ ВТ_ПроектныеЗадачи
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &Версия" + ТекстОтбораПоЗадачам + ") КАК Т
	               |ГДЕ
	               |	НЕ Т.ЗадачаОтменена
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПроектнаяЗадача";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("Версия", ТекВерсия);
	Запрос.УстановитьПараметр("ПроектныеЗадачи", МассивЗадач);
	
	Запрос.Выполнить();
	
	Возврат МВТ;
	
КонецФункции

Процедура ОбновитьДатуПривязкиДанныхДДС(ДанныеПланаДДС, ДанныеДокумента, ЭтоПроектнаяЗадача)
	
	Если Не ЗначениеЗаполнено(ДанныеПланаДДС) Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЭтоПроектнаяЗадача Тогда
		ПроектныеЗадачи = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеДокумента.ПроектнаяЗадача);
	Иначе
		ПроектныеЗадачи = Новый Массив;
		Для Каждого СтрокаДДС Из ДанныеПланаДДС Цикл
			ПроектныеЗадачи.Добавить(СтрокаДДС.ПроектнаяЗадача);
		КонецЦикла;
	КонецЕсли;
	Проект = ДанныеДокумента.Проект;
	
	СрокиЗадачСоответствие = упоДвиженияДенежныхСредствСервер.СрокиПроектныхЗадачДляРасчетаДДС(Проект, ПроектныеЗадачи);
	
	Для каждого СтрокаДДС Из ДанныеПланаДДС Цикл
		
		Если ЭтоПроектнаяЗадача Тогда
			ПроектнаяЗадача = ДанныеДокумента.ПроектнаяЗадача;
		Иначе
			ПроектнаяЗадача = СтрокаДДС.ПроектнаяЗадача;
		КонецЕсли;
		
		Сроки = СрокиЗадачСоответствие.Получить(ПроектнаяЗадача);
		
		Календарь = упоПроектыИЗадачиСервер.КалендарьПоИерархииОбъектовДДС(ПроектнаяЗадача);
		упоПроектыИЗадачиОбщие.ОбновитьДатуПривязкиВСтроке(Сроки, Календарь, СтрокаДДС);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуДвиженийДДС(ТаблицаДвиженийБДДС, ДанныеПланаДДС, ДанныеДокумента, ЭтоПроектнаяЗадача,
	ЭтоДанныеСФинансамиИТрансляцией)
	
	ВалютаУпр = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	
	// Для данных с финансами и трансляцией не нужно очищать таблицу движений БДДС полностью, т.к. она уже была 
	// предварительно заполнена данными актуализации по срокам. Удаляем только нужные задачи во избажании дублирования.	
	Если ЭтоДанныеСФинансамиИТрансляцией Тогда
		
		ЗадачиСТрансляцией = ДанныеПланаДДС.Скопировать(, "ПроектнаяЗадача");
		ЗадачиСТрансляцией.Свернуть("ПроектнаяЗадача");
		
		Для каждого ЗадачаСТрансляцией Из ЗадачиСТрансляцией Цикл
			СтруктураОтбора = Новый Структура("ПроектнаяЗадача", ЗадачаСТрансляцией.ПроектнаяЗадача);
			УдаляемыеСтроки = ТаблицаДвиженийБДДС.НайтиСтроки(СтруктураОтбора);
			Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
				ТаблицаДвиженийБДДС.Удалить(УдаляемаяСтрока);
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		ТаблицаДвиженийБДДС.Очистить();
	КонецЕсли;
	
	Для Каждого СтрокаДДС Из ДанныеПланаДДС Цикл
		
		НоваяСтрока = ТаблицаДвиженийБДДС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДДС);
		Если ЭтоПроектнаяЗадача Тогда
			ПроектнаяЗадача = ДанныеДокумента.ПроектнаяЗадача;
			НоваяСтрока.Сумма = упоМодульВалютногоУчета.ПересчитатьСумму(СтрокаДДС.Сумма,
				СтрокаДДС.Валюта, ВалютаУпр, ПроектнаяЗадача.Дата);
			НоваяСтрока.СуммаВалютная = СтрокаДДС.Сумма;
		Иначе
			ПроектнаяЗадача = НоваяСтрока.ПроектнаяЗадача;
		КонецЕсли;
		НоваяСтрока.ПроектнаяЗадача = ПроектнаяЗадача;
		НоваяСтрока.Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача);
		
	КонецЦикла;
	
КонецПроцедуры

// Функция получает схемы оплаты для списка проектных задач. 
//
// Параметры:
//  ТаблицаДвиженийБДР - ТаблицаЗначений.
//  ДанныеДокумента - Структура.
//
Функция СхемыОплатыТаблицыДвиженийБДР(ТаблицаДвиженийБДР, ДанныеДокумента)
	
	СоответствиеСхемОплаты = Новый Соответствие;
	
	КопияТаблицаДвижений = ТаблицаДвиженийБДР.Скопировать();
	КопияТаблицаДвижений.Свернуть("ПроектнаяЗадача");
	
	ПроектныеЗадачи = КопияТаблицаДвижений.ВыгрузитьКолонку("ПроектнаяЗадача");	
	СвойстваПроектныхЗадач = упоПроектыИЗадачиСервер.ПолучитьСвойстваПроектныхЗадач(ПроектныеЗадачи, 
		"СхемаОплатыПоУмолчаниюДоходы, СхемаОплатыПоУмолчаниюРасходы");  	
		
	ИсточникНастроекВДокументе = ДанныеДокумента.Свойство("ПроектныеЗадачи") И
		(ДанныеДокумента.ПерезаписатьСхемаОплатыПоУмолчаниюДоходы
		Или ДанныеДокумента.ПерезаписатьСхемаОплатыПоУмолчаниюРасходы);
	
	Для каждого СтрокаДвиженияБДР Из КопияТаблицаДвижений Цикл
		
		ПроектнаяЗадача = СтрокаДвиженияБДР.ПроектнаяЗадача;
		
		Если ИсточникНастроекВДокументе Тогда
			СтрокаДокумента = ДанныеДокумента.ПроектныеЗадачи.Найти(ПроектнаяЗадача, "ПроектнаяЗадача");
		Иначе
			СтрокаДокумента = Неопределено;
		КонецЕсли;
		
		СхемаОплатыДоходыРасходы = Новый Структура;
		Если ЗначениеЗаполнено(СтрокаДокумента) Тогда
			СхемаОплатыДоходыРасходы.Вставить("СхемаОплатыПоУмолчаниюДоходы", СтрокаДокумента.СхемаОплатыПоУмолчаниюДоходы);
			СхемаОплатыДоходыРасходы.Вставить("СхемаОплатыПоУмолчаниюРасходы", СтрокаДокумента.СхемаОплатыПоУмолчаниюРасходы);
		Иначе 
			СвойстваЗадачи = СвойстваПроектныхЗадач.Получить(ПроектнаяЗадача);
			СхемаОплатыДоходыРасходы.Вставить("СхемаОплатыПоУмолчаниюДоходы", СвойстваЗадачи.СхемаОплатыПоУмолчаниюДоходы);
			СхемаОплатыДоходыРасходы.Вставить("СхемаОплатыПоУмолчаниюРасходы", СвойстваЗадачи.СхемаОплатыПоУмолчаниюРасходы);
		КонецЕсли;
		
		СоответствиеСхемОплаты.Вставить(ПроектнаяЗадача, СхемаОплатыДоходыРасходы);
		
	КонецЦикла;
	
	Возврат СоответствиеСхемОплаты;
	
КонецФункции

Функция ТекстЗапросаСвойстваЗадачДляИзмененияВДокументеСохранениеДанныхПроекта()
	
	ТекстЗапросаСвойства = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Свойства.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	Сроки.ДатаНачалаПлан КАК ДатаНачалаПлан,
		|	Сроки.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
		|	&ПоляСвойств
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &текВерсия
		|				И (&ВсеЗадачи ИЛИ ПроектнаяЗадача В (&СписокЗадач))) КАК Свойства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
		|				,
		|				Версия = &текВерсия) КАК Сроки
		|		ПО Свойства.Версия = Сроки.Версия
		|			И Свойства.ПроектнаяЗадача = Сроки.ПроектнаяЗадача";
	
	РесурсыРегистра = Метаданные.РегистрыСведений.упоСвойстваПроектныхЗадач.Ресурсы;
	СтрокиЗапросаСвойств = Новый Массив;
	Для Каждого Ресурс Из РесурсыРегистра Цикл
		СтрокаЗапроса = СтрШаблон("свойства.%1", Ресурс.Имя);
		СтрокиЗапросаСвойств.Добавить(СтрокаЗапроса);
	КонецЦикла;
	ТекстСвойства = СтрСоединить(СтрокиЗапросаСвойств, ",");
	
	ТекстЗапросаСвойства = СтрЗаменить(ТекстЗапросаСвойства, "&ПоляСвойств", ТекстСвойства);
	
	Возврат ТекстЗапросаСвойства;
	
КонецФункции

Функция АктуализируемыеПроектныеЗадачиПоОпцииТрансляции(ИмяОпцииТрансляции, ТекущаяВерсияПроекта)
	
	АктуализируемыеПроектныеЗадачи = Новый Соответствие;
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
		|ИЗ
		|   РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсияПроекта) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|ГДЕ
		|   НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
		|   И упоСвойстваПроектныхЗадачСрезПоследних.%1";
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, ИмяОпцииТрансляции);
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТекущаяВерсияПроекта", ТекущаяВерсияПроекта);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ПроектныеЗадачи = РезультатЗапроса.ВыгрузитьКолонку("ПроектнаяЗадача");
	Если Не ПроектныеЗадачи.Количество() Тогда
		Возврат АктуализируемыеПроектныеЗадачи;
	КонецЕсли;
	АктуализируемыеПроектныеЗадачи = СвойстваПроектныхЗадачДляИзмененияВДокументеСохранениеДанныхПроекта(ТекущаяВерсияПроекта,
		ПроектныеЗадачи);
	
	Возврат АктуализируемыеПроектныеЗадачи;
	
КонецФункции

Функция НаименованиеОпцииТрансляцииПоИмениМетаданных(ИмяОпцииТрансляции)
	
	Если ИмяОпцииТрансляции = "ВключитьСубпродуктыВПланДоходов" Тогда
		НаименованиеОпцииТрансляции = """Включить субпродукты в план доходов""";
	ИначеЕсли ИмяОпцииТрансляции = "ВключитьМатРесурсыВПланРасходов" Тогда
		НаименованиеОпцииТрансляции = """Включить материальные ресурсы в план расходов""";
	ИначеЕсли ИмяОпцииТрансляции = "ВключитьТрудРесурсыВПланРасходов" Тогда
		НаименованиеОпцииТрансляции = """Включить трудовые ресурсы в план расходов""";
	ИначеЕсли ИмяОпцииТрансляции = "ВключитьДопЗатратыВПланРасходов" Тогда
		НаименованиеОпцииТрансляции = """Включить дополнительные затраты в план расходов""";
	ИначеЕсли ИмяОпцииТрансляции = "ВключитьПланДоходовВБДДС" Тогда
		НаименованиеОпцииТрансляции = """Включить план доходов в план ДДС""";
	ИначеЕсли ИмяОпцииТрансляции = "ВключитьПланРасходовВБДДС" Тогда
		НаименованиеОпцииТрансляции = """Включить план расходов в план ДДС""";
	Иначе
		НаименованиеОпцииТрансляции = "";
	КонецЕсли;
	
	Возврат НаименованиеОпцииТрансляции;
	
КонецФункции

#КонецОбласти