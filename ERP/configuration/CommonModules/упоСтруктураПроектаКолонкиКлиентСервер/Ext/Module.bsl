Функция ПолучитьМассивАбсолютныхОтклонений() Экспорт
	
	МассивКолонокВыполнимости = Новый Массив;
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Значение1, Значение2",
		"ОтклонениеПоОкончанию", "ДатаЗавершенияБазовый", "ДатаЗавершения"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Значение1, Значение2",
		"ОтклонениеПоОкончаниюДП", "ДатаЗавершенияДоговорной", "ДатаЗавершения"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Значение1, Значение2",
		"ОтклонениеПоНачалуБП", "ДатаНачалаБазовый", "ДатаНачала"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Значение1, Значение2",
		"ОтклонениеПоНачалуДП", "ДатаНачалаДоговорной", "ДатаНачала"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Значение1, Значение2",
		"ОтклонениеПоНачалуОтВерсии", "ДатаНачалаВерсия", "ДатаНачала"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Значение1, Значение2",
		"ОтклонениеПоОкончаниюОтВерсии", "ДатаЗавершенияВерсия", "ДатаЗавершения"));
	
	Возврат МассивКолонокВыполнимости;	
	
КонецФункции

