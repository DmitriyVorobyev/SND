            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
            
            Если СтруктураВыводимыхДопКолонок.Свойство("ДоходПланБазовый") Тогда     
                ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДоходПланБазовый", имяВТ, СтруктураКолонокИтогов);
            КонецЕсли;		
            
            Если СтруктураВыводимыхДопКолонок.Свойство("РасходПланБазовый") Тогда     				
                ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "РасходПланБазовый", имяВТ, СтруктураКолонокИтогов);
            КонецЕсли;				
        КонецЕсли;
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ДоходПланВерсия") 
            ИЛИ СтруктураВыводимыхДопКолонок.Свойство("РасходПланВерсия") Тогда
            
            имяВТ = "ВТ_ДР_Версия";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Доход_", "ДоходПланВерсия"); 
            СоответствиеДляЗамены.Вставить("_Расход_", "РасходПланВерсия");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
            
            Если СтруктураВыводимыхДопКолонок.Свойство("ДоходПланВерсия") Тогда     
                ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДоходПланВерсия", имяВТ, СтруктураКолонокИтогов);
            КонецЕсли;		
            
            Если СтруктураВыводимыхДопКолонок.Свойство("РасходПланВерсия") Тогда     				
