	НовыйЭлементСписка = СписокИзменяемыхРеквизитов.Добавить();
	НовыйЭлементСписка.Представление = "ДвиженияДенежныхСредств";	
	
	// РуководителиПроектныхЗадач	
	НовыйЭлементСписка = СписокИзменяемыхРеквизитов.Добавить();
	НовыйЭлементСписка.Представление = "РуководителиПроектныхЗадач";
	СписокЭлементовТаблицы = Новый СписокЗначений();
	НовыйЭлементСписка.Значение = СписокЭлементовТаблицы;
	СписокЭлементовТаблицы.Добавить("РуководительПЗ", "РуководительПроектнойЗадачи");
	
	// ПрогнозныеСрокиПроектныхЗадач
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
	
		НовыйЭлементСписка = СписокИзменяемыхРеквизитов.Добавить();
		НовыйЭлементСписка.Представление = "ПрогнозныеСрокиПроектныхЗадач";
		СписокЭлементовТаблицы = Новый СписокЗначений();
		НовыйЭлементСписка.Значение = СписокЭлементовТаблицы;
		СписокЭлементовТаблицы.Добавить("ДатаНачалаПрогноз", "ДатаНачалаПрогноз");
		СписокЭлементовТаблицы.Добавить("ДатаЗавершенияПрогноз", "ДатаЗавершенияПрогноз");
		СписокЭлементовТаблицы.Добавить("СтатусСроков", "СтатусСроков");
	
	КонецЕсли;
	
	Возврат СписокИзменяемыхРеквизитов;
	
КонецФункции
	
#КонецЕсли
	
#КонецОбласти

#Область РасчетОтклоненийПриРасчетеИтогов

Функция НужноСчитатьОтклоненияПриРасчетеИтогов(СписокКолонок) Экспорт
	
	Результат = Новый Структура;
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("МесяцНачалаПоПредварительномуУровнюРолейОтклонение");
	МассивКолонок.Добавить("МесяцОкончанияПоПредварительномуУровнюРолейОтклонение");
	МассивКолонок.Добавить("МесяцНачалаПоПредварительномуУровнюРолей");
	МассивКолонок.Добавить("МесяцОкончанияПоПредварительномуУровнюРолей");
	Результат.Вставить("НужноСчитатьОтклонениеСроковПоПредварительномуУровню", 
		ИспользуетсяКолонкаИзМассива(СписокКолонок, МассивКолонок));
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("МесяцНачалаПоОкончательномуУровнюРолейОтклонение");
	МассивКолонок.Добавить("МесяцОкончанияПоОкончательномуУровнюРолейОтклонение");
	МассивКолонок.Добавить("МесяцНачалаПоОкончательномуУровнюРолей");
	МассивКолонок.Добавить("МесяцОкончанияПоОкончательномуУровнюРолей");
	Результат.Вставить("НужноСчитатьОтклонениеСроковПоОкончательномуУровню", 
		ИспользуетсяКолонкаИзМассива(СписокКолонок, МассивКолонок));
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("НачалоРаботТР");
	МассивКолонок.Добавить("ОкончаниеРаботТР");
	МассивКолонок.Добавить("НачалоРаботТРОтклонение");
	МассивКолонок.Добавить("ОкончаниеРаботТРОтклонение");
	Результат.Вставить("НужноСчитатьОтклонениеСроковПоТР", 
		ИспользуетсяКолонкаИзМассива(СписокКолонок, МассивКолонок));
	
	Возврат Результат;
	
КонецФункции

Процедура ПосчитатьОтклонениеСроков(НужноСчитатьОтклонения, СтрокаДерева) Экспорт
	
	Если НужноСчитатьОтклонения.НужноСчитатьОтклонениеСроковПоПредварительномуУровню Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.МесяцНачалаПоПредварительномуУровнюРолей) Тогда
			СтрокаДерева.МесяцНачалаПоПредварительномуУровнюРолейОтклонение = 
				упоФункцииОбщегоНазначенияКлиентСервер.РазностьДатВМесяцах(СтрокаДерева.МесяцНачалаПоПредварительномуУровнюРолей, СтрокаДерева.ДатаНачала);
		Иначе
			СтрокаДерева.МесяцНачалаПоПредварительномуУровнюРолейОтклонение = 0;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДерева.МесяцОкончанияПоПредварительномуУровнюРолей) Тогда
			СтрокаДерева.МесяцОкончанияПоПредварительномуУровнюРолейОтклонение = 
				упоФункцииОбщегоНазначенияКлиентСервер.РазностьДатВМесяцах(СтрокаДерева.МесяцОкончанияПоПредварительномуУровнюРолей, СтрокаДерева.ДатаЗавершения);
		Иначе
			СтрокаДерева.МесяцОкончанияПоПредварительномуУровнюРолейОтклонение = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НужноСчитатьОтклонения.НужноСчитатьОтклонениеСроковПоОкончательномуУровню Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.МесяцНачалаПоОкончательномуУровнюРолей) Тогда
			СтрокаДерева.МесяцНачалаПоОкончательномуУровнюРолейОтклонение = 
				упоФункцииОбщегоНазначенияКлиентСервер.РазностьДатВМесяцах(СтрокаДерева.МесяцНачалаПоОкончательномуУровнюРолей, СтрокаДерева.ДатаНачала);
		Иначе
			СтрокаДерева.МесяцНачалаПоОкончательномуУровнюРолейОтклонение = 0;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДерева.МесяцОкончанияПоОкончательномуУровнюРолей) Тогда
			СтрокаДерева.МесяцОкончанияПоОкончательномуУровнюРолейОтклонение = 
				упоФункцииОбщегоНазначенияКлиентСервер.РазностьДатВМесяцах(СтрокаДерева.МесяцОкончанияПоОкончательномуУровнюРолей, СтрокаДерева.ДатаЗавершения);
		Иначе
			СтрокаДерева.МесяцОкончанияПоОкончательномуУровнюРолейОтклонение = 0;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НужноСчитатьОтклонения.НужноСчитатьОтклонениеСроковПоТР Тогда
		
		Если ЗначениеЗаполнено(СтрокаДерева.НачалоРаботТР) Тогда
			СтрокаДерева.НачалоРаботТРОтклонение = Цел((НачалоДня(СтрокаДерева.НачалоРаботТР) - НачалоДня(СтрокаДерева.ДатаНачала)) / (24*3600));
		Иначе
			СтрокаДерева.НачалоРаботТРОтклонение = 0;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДерева.ОкончаниеРаботТР) Тогда
			СтрокаДерева.ОкончаниеРаботТРОтклонение = Цел((НачалоДня(СтрокаДерева.ОкончаниеРаботТР) - НачалоДня(СтрокаДерева.ДатаЗавершения)) / (24*3600));
		Иначе
			СтрокаДерева.ОкончаниеРаботТРОтклонение = 0;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РасчетЗначенийОсобыхКолонок

#Если Сервер ИЛИ ВнешнееСоединение ИЛИ ТолстыйКлиент Тогда

Процедура РассчитатьАбсолютныеОтклонения(ДеревоЗначений, СтруктураВыводимыхКолонок,
													РабочийКалендарьПроекта, МенеджерыВременныхТаблиц) Экспорт
	
	Для Каждого Строка Из ДеревоЗначений.Строки Цикл
		РассчитатьАбсолютныеОтклонения(Строка, СтруктураВыводимыхКолонок, РабочийКалендарьПроекта, МенеджерыВременныхТаблиц);	
	КонецЦикла;
	
	Если ТипЗнч(ДеревоЗначений) = Тип("СтрокаДереваЗначений") Тогда
		РассчитатьАбсолютныеОтклоненияВСтроке(ДеревоЗначений, Истина, СтруктураВыводимыхКолонок, РабочийКалендарьПроекта, МенеджерыВременныхТаблиц, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаДерева, ПересчитыватьБуфер,
								СтруктураВыводимыхКолонок, РабочийКалендарьПроекта, 
								МенеджерыВременныхТаблиц, ОтклонениеИзменилось, 
								ЕдиницаВремениПоУмолчанию = Неопределено) Экспорт
								
	Если ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмерения) Тогда
		ЕдиницаИзмерения = СтрокаДерева.ЕдиницаИзмерения;
	Иначе
		ЕдиницаИзмерения = ЕдиницаВремениПоУмолчанию;		
	КонецЕсли; 								
								
	Если НЕ (ПересчитыватьБуфер И ЗначениеЗаполнено(ЕдиницаИзмерения)) Тогда
		Возврат;
	КонецЕсли;
	
	МассивАбсОтклонений = упоСтруктураПроектаКолонкиКлиентСервер.ПолучитьМассивАбсолютныхОтклонений();
	Для Каждого СтруктураВыполнимости Из МассивАбсОтклонений Цикл
		
		Значение1 = СтруктураВыполнимости.Значение1;
		Значение2 = СтруктураВыполнимости.Значение2;
		Результат = СтруктураВыполнимости.Результат;
		
		Если СтруктураВыводимыхКолонок.Свойство(Результат) 
			И СтруктураВыводимыхКолонок.Свойство(Значение1) 
			И СтруктураВыводимыхКолонок.Свойство(Значение2) Тогда
			
			Если ЗначениеЗаполнено(СтрокаДерева[Значение1])
				И ЗначениеЗаполнено(СтрокаДерева[Значение2]) Тогда
				
				РезультатДо = СтрокаДерева[Результат];
				
				Если Результат = "ОтклонениеПоОкончанию" 
					Или Результат = "ОтклонениеПоОкончаниюДП" 
					Или Результат = "ОтклонениеПоНачалуБП" 
					Или Результат = "ОтклонениеПоНачалуДП"
					Или Результат = "ОтклонениеПоНачалуОтВерсии"
					Или Результат = "ОтклонениеПоОкончаниюОтВерсии"Тогда
					
					Дата1 = НачалоДня(СтрокаДерева[Значение2]);
					Дата2 = НачалоДня(СтрокаДерева[Значение1]);
					
					Если Дата1 = Дата2 Тогда
						СтрокаДерева[Результат] = 0;
					Иначе
						ЗнакОтклонения = -1;
						
						Если Дата2 < Дата1 Тогда
							ТемпДата = Неопределено;
							ТемпДата = Дата2;
							Дата2 = Дата1;
							Дата1 = ТемпДата;
							ЗнакОтклонения = 1;
						КонецЕсли;	
						
						СтрокаДерева[Результат] = ЗнакОтклонения * упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность
						(Дата1, Дата2,
							ЕдиницаИзмерения, СтрокаДерева.КалендарьЗадачи, РабочийКалендарьПроекта, 
							СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта,
							МенеджерыВременныхТаблиц);
					КонецЕсли;
					
				Иначе
					
					СтрокаДерева[Результат] = СтрокаДерева[Значение2] - СтрокаДерева[Значение1];
					
				КонецЕсли;
				
				Если Не ОтклонениеИзменилось Тогда
					ОтклонениеИзменилось = РезультатДо <> СтрокаДерева[Результат];
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли
		
	КонецЦикла;
		
КонецПроцедуры

Процедура РассчитатьСтатусСроков(СтрокаДерева, ПересчитыватьСтатусСроков, НачалоТекущегоДня, ЭтоВеха) Экспорт
	
	Если Не ПересчитыватьСтатусСроков Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаДерева.ПроцентГотовности = 100 Тогда
		
		СтрокаДерева.СтатусСроков = ПредопределенноеЗначение("Перечисление.упоСтатусОтчетыСтатусыСроков.Выполнено");
		
	ИначеЕсли НачалоДня(СтрокаДерева.ДатаНачала) > НачалоТекущегоДня Тогда
		
		СтрокаДерева.СтатусСроков = ПредопределенноеЗначение("Перечисление.упоСтатусОтчетыСтатусыСроков.План");
		
	Иначе
		
		Если ЭтоВеха И НачалоТекущегоДня >= СтрокаДерева.ДатаЗавершения Тогда
				
			СтрокаДерева.СтатусСроков = ПредопределенноеЗначение("Перечисление.упоСтатусОтчетыСтатусыСроков.Задержка");	
			Возврат;
			
		КонецЕсли;
		
		Если СтрокаДерева.Длительность = 0 Тогда
			Возврат;
		КонецЕсли;
		
		РПВ = (1 + (СтрокаДерева.ОтставаниеОтТекПлана / СтрокаДерева.Длительность)) * 100;
		
		Если РПВ - СтрокаДерева.ПроцентГотовности > 25 Тогда 
			
		 	СтрокаДерева.СтатусСроков = ПредопределенноеЗначение("Перечисление.упоСтатусОтчетыСтатусыСроков.Срыв");
			
		ИначеЕсли РПВ <= СтрокаДерева.ПроцентГотовности Тогда
			
			СтрокаДерева.СтатусСроков = ПредопределенноеЗначение("Перечисление.упоСтатусОтчетыСтатусыСроков.ПоГрафику");
			
		Иначе
			
			СтрокаДерева.СтатусСроков = ПредопределенноеЗначение("Перечисление.упоСтатусОтчетыСтатусыСроков.Задержка");
			
		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры

Функция РассчитатьОтклонениеПоДлительностиОтПоДатам(СтрокаДерева,
	КолонкаДатаНачала, 
	КолонкаДатаЗавершения, 
	ПараметрыРасчета, 
	МенеджерыВременныхТаблиц = Неопределено) Экспорт
	
	ЕдиницаВремениПоУмолчанию = ПараметрыРасчета.ЕдиницаВремениПоУмолчанию;
	РабочийКалендарьПроекта = ПараметрыРасчета.РабочийКалендарьПроекта;
	
	ЗадачаКРасчетуПоСтатусуИАктируемости = ЭтоЗадачаКРасчетуПоСтатусуИАктируемости(СтрокаДерева, ПараметрыРасчета);
	ЗадачаКРасчетуПоДатеНачала = ЗначениеЗаполнено(СтрокаДерева[КолонкаДатаНачала]);
	
	НуженРасчет = ЗадачаКРасчетуПоСтатусуИАктируемости 
		И ЗадачаКРасчетуПоДатеНачала;
	
	Если Не НуженРасчет Тогда
		Возврат 0; // Возврат
	КонецЕсли;
		
	Если ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмерения) Тогда
		ЕдИзм = СтрокаДерева.ЕдиницаИзмерения;
	Иначе 
		ЕдИзм = ЕдиницаВремениПоУмолчанию;
	КонецЕсли;
	
	ДлительностьПоВерсии = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность(
		СтрокаДерева[КолонкаДатаНачала], 
		СтрокаДерева[КолонкаДатаЗавершения], 
		ЕдИзм, 
		СтрокаДерева.КалендарьЗадачи, 
		РабочийКалендарьПроекта, 
		СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта,
		МенеджерыВременныхТаблиц);
		
	Возврат СтрокаДерева.Длительность - ДлительностьПоВерсии;
	
КонецФункции

Функция РассчитатьДлительностьКалендарныеДни(СтрокаДерева, ПересчитыватьДлительностьКалендарныеДни) Экспорт
	
	Если ПересчитыватьДлительностьКалендарныеДни 
		И ЗначениеЗаполнено(СтрокаДерева.ДатаЗавершения) 
		И ЗначениеЗаполнено(СтрокаДерева.ДатаНачала) Тогда
		
		СтрокаДерева.ДлительностьКалендарныеДни = 1 +((НачалоДня(СтрокаДерева.ДатаЗавершения) - НачалоДня(СтрокаДерева.ДатаНачала)) / 86400);
		
	КонецЕсли; 	
	
КонецФункции

Процедура РассчитатьБуферПозднийСтартРаннийСтарт(СтрокаДерева, ПересчитыватьБуфер, РабочийКалендарьПроекта, МенеджерыВременныхТаблиц) Экспорт
	
	Если ПересчитыватьБуфер И ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмерения) 
		И ЗначениеЗаполнено(СтрокаДерева.ПозднийСтарт) И ЗначениеЗаполнено(СтрокаДерева.РаннийСтарт) Тогда
		
		ПозднийСтартРасчет = СтрокаДерева.ПозднийСтарт;
		РаннийСтартРасчет = СтрокаДерева.РаннийСтарт;
		
		СтрокаДерева.БуферПозднийСтартРаннийСтарт = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность(
			РаннийСтартРасчет, ПозднийСтартРасчет, СтрокаДерева.ЕдиницаИзмерения, СтрокаДерева.КалендарьЗадачи, 
			РабочийКалендарьПроекта, СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта,
			МенеджерыВременныхТаблиц);
		
	КонецЕсли;	
		
КонецПроцедуры

Процедура РассчитатьОтставаниеОтТекПлана(СтрокаДерева, ПересчитыватьОтставаниеОтТекПлана, РабочийКалендарьПроекта,
	МенеджерыВременныхТаблиц, ЕдиницаВремениПоУмолчанию, НачалоТекущегоДня) Экспорт
	
	Если Не ПересчитыватьОтставаниеОтТекПлана Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("ЕдиницаВремениПоУмолчанию", ЕдиницаВремениПоУмолчанию);
	ПараметрыРасчета.Вставить("НачалоТекущегоДня", НачалоТекущегоДня);
	ПараметрыРасчета.Вставить("РабочийКалендарьПроекта", РабочийКалендарьПроекта);
	ПараметрыРасчета.Вставить("ТолькоАктируемые", Ложь);
	
	РассчитатьОтставаниеОтПлана(СтрокаДерева, "ОтставаниеОтТекПлана", "ДатаЗавершения", 
		ПараметрыРасчета, МенеджерыВременныхТаблиц);
	
КонецПроцедуры

Процедура РассчитатьОтставаниеОтПлана(СтрокаДерева, 
	ИмяКолонкиОтставание, 
	ИмяКолонкиДатаЗавершения,
	ПараметрыРасчета, 
	МенеджерыВременныхТаблиц) Экспорт
	
	ЕдиницаВремениПоУмолчанию = ПараметрыРасчета.ЕдиницаВремениПоУмолчанию;
	НачалоТекущегоДня = ПараметрыРасчета.НачалоТекущегоДня;
	РабочийКалендарьПроекта = ПараметрыРасчета.РабочийКалендарьПроекта;
	
	ЗадачаКРасчетуПоСтатусуИАктируемости = ЭтоЗадачаКРасчетуПоСтатусуИАктируемости(СтрокаДерева, ПараметрыРасчета);
	ЗадачаКРасчетуПоДатеЗавершения = ЗначениеЗаполнено(СтрокаДерева[ИмяКолонкиДатаЗавершения]) 
		И НачалоДня(СтрокаДерева[ИмяКолонкиДатаЗавершения]) <> НачалоТекущегоДня;
	
	НуженРасчет = ЗадачаКРасчетуПоСтатусуИАктируемости 
		И ЗадачаКРасчетуПоДатеЗавершения;
		
	Если Не НуженРасчет Тогда
		СтрокаДерева[ИмяКолонкиОтставание] = 0;
		Возврат; // Возврат
	КонецЕсли;
	
	Если СтрокаДерева[ИмяКолонкиДатаЗавершения] > НачалоТекущегоДня Тогда
		ЗнакОтклонения = -1;
		СуткиВСекундах = 86400; // 24ч
		ДатаНачала = НачалоТекущегоДня + СуткиВСекундах;
		ДатаЗавершения = СтрокаДерева[ИмяКолонкиДатаЗавершения];
	Иначе
		ЗнакОтклонения = 1;
		ДатаНачала = НачалоДня(СтрокаДерева[ИмяКолонкиДатаЗавершения]);
		ДатаЗавершения = НачалоТекущегоДня;
	КонецЕсли;
	
	ЕдИзм = ?(ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмерения), СтрокаДерева.ЕдиницаИзмерения, ЕдиницаВремениПоУмолчанию);
	
	Длительность = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность(
			ДатаНачала, 
			ДатаЗавершения, 
			ЕдИзм, 
			СтрокаДерева.КалендарьЗадачи, 
			РабочийКалендарьПроекта, 
			СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта,
			МенеджерыВременныхТаблиц);
	
	СтрокаДерева[ИмяКолонкиОтставание] = ЗнакОтклонения * Длительность;
	
КонецПроцедуры

Функция ВыведенныеКолонкиОтставания(СтруктураВыводимыхКолонок, СравниватьСПоказателямиПоВерсии) Экспорт
	
	ВыведенныеКолонки = Новый Массив;
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить(СтруктураКолонкиОтставание("ОтставаниеОтТекПлана", "ДатаЗавершения"));
	Если СравниватьСПоказателямиПоВерсии Тогда
		ИменаКолонок.Добавить(СтруктураКолонкиОтставание("ОтставаниеОтВерсии", "ДатаЗавершенияВерсия"));
	КонецЕсли;
	ИменаКолонок.Добавить(СтруктураКолонкиОтклонениеОтставаниеОтБП("ОтставаниеОтБазПлана"));
	ИменаКолонок.Добавить(СтруктураКолонкиОтклонениеОтставаниеОтДП("ОтставаниеОтДогПлана"));
	ИменаКолонок.Добавить(СтруктураКолонкиОтклонениеОтставаниеОтДП("ОтставаниеОтДогПланаАкт", Истина));
	
	Для Каждого Колонка Из ИменаКолонок Цикл
		Если СтруктураВыводимыхКолонок.Свойство(Колонка.ИмяКолонки) Тогда
			ВыведенныеКолонки.Добавить(Колонка);
		КонецЕсли;
	КонецЦикла;

	Возврат ВыведенныеКолонки;
	
КонецФункции

Функция ВыведенныеКолонкиОтклонения(СтруктураВыводимыхКолонок) Экспорт
	
	ВыведенныеКолонки = Новый Массив;
	
	ИменаКолонок = Новый Массив;
	ИменаКолонок.Добавить(СтруктураКолонкиОтклонениеОтставаниеОтБП("ОтклонениеПоДлительностиОтБазПлана"));
	ИменаКолонок.Добавить(СтруктураКолонкиОтклонениеОтставаниеОтДП("ОтклонениеПоДлительностиОтДогПлана"));
	ИменаКолонок.Добавить(СтруктураКолонкиОтклонениеОтставаниеОтДП("ОтклонениеПоДлительностиОтДогПланаАкт", Истина));

	Для Каждого Колонка Из ИменаКолонок Цикл
		Если СтруктураВыводимыхКолонок.Свойство(Колонка.ИмяКолонки) Тогда
			ВыведенныеКолонки.Добавить(Колонка);
		КонецЕсли;
	КонецЦикла;

	Возврат ВыведенныеКолонки;
	
КонецФункции

Функция СтруктураКолонкиОтклонениеОтставаниеОтДП(ИмяКолонкиОтставаниеОтклонение, ТолькоАктируемые = Ложь) Экспорт
	
	Возврат СтруктураКолонкиОтставание(ИмяКолонкиОтставаниеОтклонение, 
		"ДатаЗавершенияДоговорной", "ДатаНачалаДоговорной", ТолькоАктируемые);
	
КонецФункции

Функция СтруктураКолонкиОтклонениеОтставаниеОтБП(ИмяКолонкиОтставаниеОтклонение) Экспорт
	
	Возврат СтруктураКолонкиОтставание(ИмяКолонкиОтставаниеОтклонение, 
		"ДатаЗавершенияБазовый", "ДатаНачалаБазовый");
	
КонецФункции

Функция СтруктураКолонкиОтставание(ИмяКолонки, ИмяКолонкиДатаЗавершения, ИмяКолонкиДатаНачала = "", ТолькоАктируемые = Ложь)
	
	СтруктураКолонки = Новый Структура;
	СтруктураКолонки.Вставить("ИмяКолонки", 				ИмяКолонки);
	СтруктураКолонки.Вставить("ИмяКолонкиДатаЗавершения", 	ИмяКолонкиДатаЗавершения);
	СтруктураКолонки.Вставить("ИмяКолонкиДатаНачала", 		ИмяКолонкиДатаНачала);
	СтруктураКолонки.Вставить("ТолькоАктируемые", 			ТолькоАктируемые);
	
	Возврат СтруктураКолонки;
	
КонецФункции

Функция ЭтоЗадачаКРасчетуПоСтатусуИАктируемости(СтрокаДерева, ПараметрыРасчета)
	
	ЗадачаКРасчетуПоСтатусу = 
		Не (СтрокаДерева.Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Завершена")
			Или СтрокаДерева.Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта"));
	ЗадачаКРасчетуПоАктируемости = Не ПараметрыРасчета.ТолькоАктируемые Или СтрокаДерева.ЭтоАктируемаяЗадача;
	
	НуженРасчет = ЗадачаКРасчетуПоСтатусу 
		И ЗадачаКРасчетуПоАктируемости;
		
	Возврат НуженРасчет;
		
КонецФункции

#КонецЕсли

#КонецОбласти

#Область ДополнениеТекстаЗапросаПолученияДанныхДляСтруктура

Функция ДобавитьПоказателиВЗапрос(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, пТекстПостроителя, пПараметры) Экспорт
	
	Если СтруктураВыводимыхДопКолонок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнитьСтруктуруКолонокЗависимостями(СтруктураВыводимыхДопКолонок);
	
	ДополнитьСтруктуруКолонокИтогов(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов);
	
	ТекстыЗамены = Новый Структура;
	ТекстыЗамены.Вставить("ПоказателиВИтоговойВыборкеДляПЗ", "");
	ТекстыЗамены.Вставить("ПоказателиВИтоговойВыборкеНеПЗ", "");
	ТекстыЗамены.Вставить("ТекстыЗапросов", "");
	ТекстыЗамены.Вставить("СоединенияТаблицДопПоказателей", "");
	
	ДоступностьФинИнфо = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	
	ДоступКФинИнфеОтсутствует = ДоступностьФинИнфо = "Отсутствует";
	ДоступнаФинИнформация = Не ДоступКФинИнфеОтсутствует;
	
	Если ДоступнаФинИнформация Тогда
		ДобавитьПоказателиВЗапрос_ДоходРасход(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены);
		ДобавитьПоказателиВЗапрос_ПоступленияВыплаты(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены);
		ДобавитьПоказателиВЗапрос_СтруктураСтоимости(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены);
		ДобавитьПоказателиВЗапрос_ФОТ(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены);
		ДобавитьПоказателиВЗапрос_ПрямыеРасходы(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены);
	КонецЕсли;
	ДобавитьПоказателиВЗапрос_Объемы(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены, ДоступнаФинИнформация);
	ДобавитьПоказателиВЗапрос_ОбъемыV(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены, ДоступнаФинИнформация);
	ДобавитьПоказателиВЗапрос_ОбъемыV_Р(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены, ДоступнаФинИнформация);
	ДобавитьПоказателиВЗапрос_ДатаНачалаОкончания(СтруктураВыводимыхДопКолонок, ТекстыЗамены, пПараметры);
	ДобавитьПоказателиВЗапрос_Трудозатраты(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены, пПараметры);
	ДобавитьПоказателиВЗапрос_Результат(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_ОсновноеЗадание(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_ЗаданияПодразделениям(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_ОсновнаяРоль(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_КоличествоРолей(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_КоличествоИсполнителей(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_ФактическиеСроки(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	ДобавитьПоказателиВЗапрос_СрокиПоЗагрузкеРолей(СтруктураВыводимыхДопКолонок, ТекстыЗамены, пПараметры);       
	ДобавитьПоказателиВЗапрос_СрокиПоЗагрузкеТР(СтруктураВыводимыхДопКолонок, ТекстыЗамены, пПараметры);       
	ДобавитьПоказателиВЗапрос_ПрогнозныеСрокиПроектныхЗадач(СтруктураВыводимыхДопКолонок, ТекстыЗамены);
	
	// Процедура для добавления текста запроса по новым показателям из расширения
	ДобавитьПоказателиВЗапрос_Переопределяемый(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены, пПараметры);
	
	Если ЗначениеЗаполнено(ТекстыЗамены.ТекстыЗапросов) Тогда
		
		ТекстыЗамены.ТекстыЗапросов  = ТекстыЗамены.ТекстыЗапросов + " ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ ";
		ТекстыЗамены.СоединенияТаблицДопПоказателей = "ПО ПЗы.Ссылка = ВР_ДопДанные.Ссылка " + Символы.ПС 
			+ ТекстыЗамены.СоединенияТаблицДопПоказателей; 	
		ТекстПостроителя = пТекстПостроителя;
		ТекстПостроителя = СтрЗаменить(ТекстПостроителя, "ВР_ДопДанные.Ссылка КАК ВР_ДопДанныеСсылка",
		ТекстыЗамены.ПоказателиВИтоговойВыборкеДляПЗ);
		Если ЗначениеЗаполнено(ТекстыЗамены.ПоказателиВИтоговойВыборкеНеПЗ) Тогда
			ТекстПостроителя = СтрЗаменить(ТекстПостроителя, """Доп""", ТекстыЗамены.ПоказателиВИтоговойВыборкеНеПЗ);
		КонецЕсли;
		ТекстПостроителя = СтрЗаменить(ТекстПостроителя, "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ", ТекстыЗамены.ТекстыЗапросов);
		ТекстПостроителя = СтрЗаменить(ТекстПостроителя, "ПО ПЗы.Ссылка = ВР_ДопДанные.Ссылка",
															ТекстыЗамены.СоединенияТаблицДопПоказателей);
		пТекстПостроителя = ТекстПостроителя;
		
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьПоказателиВЗапрос_Трудозатраты(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
																					Знач ТекстыЗамены, пПараметры)
    
	Перем МассивПоказателей, ТекстЗапроса;	
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ТрудозатратыТП") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ТрудозатратыБП") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ТрудозатратыВерсия") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТаблицаПоказателя.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	СУММА(ТаблицаПоказателя.КоличествоЧасов) КАК _Трудозатраты_
		               |ПОМЕСТИТЬ _ВТ_
		               |ИЗ
		               |	РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия КАК ТаблицаПоказателя
		               |ГДЕ
		               |	ТаблицаПоказателя.Проект = &Проект
		               |	И ТаблицаПоказателя.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Предварительный)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТаблицаПоказателя.ПроектнаяЗадача";
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ТрудозатратыТП") Тогда
			
			имяВТ = "ВТ_ТрудозатратыТП";
			
			СоответствиеДляЗамены = Новый Соответствие;
			Если пПараметры.ТекущаяВерсияПроектаВСистеме <> пПараметры.текВерсия Тогда
				СоответствиеДляЗамены.Вставить("упоАктуальныеПланыТрудозатратСводноТекущаяВерсия", "упоАктуальныеПланыТрудозатратСводноВерсии");
				СоответствиеДляЗамены.Вставить("ТаблицаПоказателя.Проект = &Проект", "ТаблицаПоказателя.Версия = &текВерсия");
			КонецЕсли; 
			СоответствиеДляЗамены.Вставить("_Трудозатраты_", "ТрудозатратыТП");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			
			ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
																			"ТрудозатратыТП", имяВТ, СтруктураКолонокИтогов);
			
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ТрудозатратыБП") Тогда
			
			имяВТ = "ВТ_ТрудозатратыБП";
			
			СоответствиеДляЗамены = Новый Соответствие;
			Если пПараметры.ТекущаяВерсияПроектаВСистеме <> пПараметры.БазоваяВерсия Тогда
				СоответствиеДляЗамены.Вставить("упоАктуальныеПланыТрудозатратСводноТекущаяВерсия", "упоАктуальныеПланыТрудозатратСводноВерсии");
				СоответствиеДляЗамены.Вставить("ТаблицаПоказателя.Проект = &Проект", "ТаблицаПоказателя.Версия = &БазоваяВерсия");
			КонецЕсли;
			СоответствиеДляЗамены.Вставить("_Трудозатраты_", "ТрудозатратыБП");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			
			ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
																			"ТрудозатратыБП", имяВТ, СтруктураКолонокИтогов);
			
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ТрудозатратыВерсия") Тогда
			
			имяВТ = "ВТ_ТрудозатратыВерсия";
			
			СоответствиеДляЗамены = Новый Соответствие;
			Если пПараметры.ТекущаяВерсияПроектаВСистеме <> пПараметры.выбВерсия Тогда
