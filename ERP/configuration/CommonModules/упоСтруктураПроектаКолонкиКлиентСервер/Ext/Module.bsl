#Область ПрограммныеКолонки

Функция ПолучитьСоответствиеПрограммныхКолонок(УчитыватьТрудозатратыПриРасчетеГотовности = Истина,
	ДопИнформация = Ложь) Экспорт
	
	СоответствиеКолонок = Новый Соответствие;
	СоответствиеКолонок.Вставить("_ДопИнформация", Новый Структура("ПорядокДобавления", Новый Массив));
	
	ОпцииДоступности = ОпцииДоступностиКолонок();
	ОпцииДоступности.Вставить("УчитыватьТрудозатратыПриРасчетеГотовности", УчитыватьТрудозатратыПриРасчетеГотовности);
	
	ОписанияТипов = ОписанияЧастыхТиповКолонок();
	ОписанияФорматов = ОписанияФорматовКолонок();
	
	ШаблонСПереносом = "%1" + Символы.ПС + "%2";
	
	//
	
	ДополнитьГруппу_Основные(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДополнитьГруппу_Сроки(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДополнитьГруппу_РасчетСроков(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДополнитьГруппу_Дополнительные(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	//
	
	ДобавитьГруппу_ТрудовыеРесурсыРоли(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_НазначенныеРесурсы(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_Объемы(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_ОбъемыДоходов(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_ОбъемыРасходов(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
		
	ДобавитьГруппу_Доходы(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_Поступления(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_Расходы(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_Выплаты(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_ФОТ(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
		
	ДобавитьГруппу_ПрогнозныеСроки(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_Трудозатраты(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_СтруктураСтоимости(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
	
	ДобавитьГруппу_ОсвоенныеОбъемы(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, 
		ШаблонСПереносом);
		
	// Процедура добавления колонок для новых показателей из расширения.
	ДобавитьКолонкуПрограммноПереопределяемый(СоответствиеКолонок, УчитыватьТрудозатратыПриРасчетеГотовности, 
		ДопИнформация);
	
	Если Не ДопИнформация Тогда
		СоответствиеКолонок.Удалить("_ДопИнформация");
	КонецЕсли;
	
	Возврат СоответствиеКолонок;
	
КонецФункции

Функция ОписанияФорматовКолонок()
	
	ФорматКолонокСумм = упоПользователиВызовСервера.ФорматКолонокИзНастроекПользователя("упоФорматСуммВСтруктуреПроекта", Истина);
	ФорматКолонокКоличества = упоПользователиВызовСервера.ФорматКолонокИзНастроекПользователя("упоФорматКоличестваВСтруктуреПроекта", Ложь);
	ОписанияФорматов = Новый Структура;
	ОписанияФорматов.Вставить("ФорматКолонокСумм", 			ФорматКолонокСумм);
	ОписанияФорматов.Вставить("ФорматКолонокКоличества", 	ФорматКолонокКоличества);
	ОписанияФорматов.Вставить("ФорматНуля", 				"ЧН=' '");
	
	Возврат ОписанияФорматов;
	
КонецФункции

Функция ОписанияЧастыхТиповКолонок()
	
	ОписанияТипов = Новый Структура;
	ОписанияТипов.Вставить("ТипЧисло15_2", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	ОписанияТипов.Вставить("ТипЧисло10_0", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	ОписанияТипов.Вставить("ТипЧисло3_0", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	ОписанияТипов.Вставить("ТипДатаБезВремени", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	Возврат ОписанияТипов;
	
КонецФункции

Функция ОпцииДоступностиКолонок()
	
	ДоступностьФинИнфо = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	ДоступКФинИнфоОтсутствует 	= ДоступностьФинИнфо = "Отсутствует";
	ДоступнаФинИнформация 		= Не ДоступКФинИнфоОтсутствует;
	ДоступКФинИнфоПросмотр 		= ДоступностьФинИнфо = "Просмотр";
	ДоступНаРедактированиеКолонок = ДоступнаФинИнформация И Не ДоступКФинИнфоПросмотр;
	
	ЭтоPM_Проф = упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф();
	
	ОпцииДоступности = Новый Структура;
	ОпцииДоступности.Вставить("ЭтоPM_Проф", ЭтоPM_Проф);
	ОпцииДоступности.Вставить("ДоступКФинИнфоОтсутствует", ДоступКФинИнфоОтсутствует);
	ОпцииДоступности.Вставить("ДоступнаФинИнформация", ДоступнаФинИнформация);
	ОпцииДоступности.Вставить("ДоступКФинИнфоПросмотр", ДоступКФинИнфоПросмотр);
	ОпцииДоступности.Вставить("ДоступНаРедактированиеКолонок", ДоступНаРедактированиеКолонок);
	
	Возврат ОпцииДоступности;
	
КонецФункции

Процедура ДополнитьГруппу_Основные(СоответствиеКолонок, ОпцииДоступности, ОписанияТипов, ОписанияФорматов, ШаблонСПереносом)
	
	ИмяГруппы = "Основные";
	
	ДобавитьПараметрыПрограммнойКолонки(СоответствиеКолонок, "КодПроектногоДокумента", НСтр("ru = 'Код ПД'"),, 
		Ложь, 6, ИмяГруппы, "КодСДР", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(25)),, Ложь);
		
	ДобавитьПараметрыПрограммнойКолонки(СоответствиеКолонок, "Последователи", НСтр("ru = 'Последователи'"),, 
		Ложь, 12, ИмяГруппы, "Связи", Новый ОписаниеТипов("Строка"),, Ложь);

КонецПроцедуры

