			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланV") Тогда
            
            имяВТ = "ВТ_ОбъемыПлан_V";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
			СоответствиеДляЗамены.Вставить("_ОбъемыV_", "ОбъемыПланV");
			СоответствиеДляЗамены.Вставить("_ОбъемыКоличествоV_", "ОбъемыКоличествоПланV");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланV") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПланV");
			КонецЕсли;
