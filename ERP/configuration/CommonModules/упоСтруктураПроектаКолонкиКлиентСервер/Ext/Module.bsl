            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовыйV") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПланБазовыйV");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовыйV") Тогда
