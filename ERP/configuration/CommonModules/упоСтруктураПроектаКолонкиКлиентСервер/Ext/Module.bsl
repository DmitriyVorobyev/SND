        ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ОбъемПланТ",
			СтруктураКолонокИтогов);
		
	КонецЕсли;
		
	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемВыполнимостьТ") И ДоступнаФинИнформация Тогда
        ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ОбъемВыполнимостьТ", "", , """""");
    КонецЕсли;	
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ВыполнимостьОбъемыV") И ДоступнаФинИнформация Тогда
