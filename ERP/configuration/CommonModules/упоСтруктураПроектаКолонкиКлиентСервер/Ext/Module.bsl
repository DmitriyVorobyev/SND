Процедура ДобавитьПоказателиВЗапрос_ДатаНачалаОкончания(Знач СтруктураВыводимыхДопКолонок, 
	Знач ТекстыЗамены, 
	пПараметры)
	
	Перем ТекстЗапроса;
	
	СравниватьСПоказателямиПоВерсии = пПараметры.Свойство("СравниватьСПоказателямиПоВерсии") 
		И пПараметры.СравниватьСПоказателямиПоВерсии;
	
	ЕстьПоказатели_ДатаНачалаОкончания = СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаБазовый")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияБазовый")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаВерсия")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияВерсия")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаДоговорной")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияДоговорной")
		ИЛИ СравниватьСПоказателямиПоВерсии;
	
	Если Не ЕстьПоказатели_ДатаНачалаОкончания Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	Таблица.ДатаНачалаПлан КАК _ДатаНачала_,
		|	Таблица.ДатаЗавершенияПлан КАК _ДатаЗавершения_
		|ПОМЕСТИТЬ _ВТ_
		|ИЗ
		|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &_Версия_) КАК Таблица";
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаБазовый")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияБазовый") Тогда
		
		имяВТ = "ВТ_СрокиПЗ_Базовый";
		
		СоответствиеДляЗамены = Новый Соответствие;
		СоответствиеДляЗамены.Вставить("_ДатаНачала_", "ДатаНачалаБазовый");
		СоответствиеДляЗамены.Вставить("_ДатаЗавершения_", "ДатаЗавершенияБазовый");
		СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
		СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены,
			ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаБазовый") Тогда
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДатаНачалаБазовый", имяВТ, , "ДатаВремя(1, 1, 1)");
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияБазовый") Тогда
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДатаЗавершенияБазовый", имяВТ, , "ДатаВремя(1, 1, 1)");
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаДоговорной")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияДоговорной") Тогда
		
		имяВТ = "ВТ_СрокиПЗ_Договорной";
		
		СоответствиеДляЗамены = Новый Соответствие;
		СоответствиеДляЗамены.Вставить("_ДатаНачала_", "ДатаНачалаДоговорной");
		СоответствиеДляЗамены.Вставить("_ДатаЗавершения_", "ДатаЗавершенияДоговорной");
		СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
		СоответствиеДляЗамены.Вставить("_Версия_", "ДоговорнаяВерсия");
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены,
			ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаДоговорной") Тогда
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДатаНачалаДоговорной", имяВТ, , "ДатаВремя(1, 1, 1)");
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияДоговорной") Тогда
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДатаЗавершенияДоговорной", имяВТ, , "ДатаВремя(1, 1, 1)");
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаВерсия")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияВерсия") 
		ИЛИ СравниватьСПоказателямиПоВерсии Тогда
		
		имяВТ = "ВТ_СрокиПЗ_Версия";
		
		СоответствиеДляЗамены = Новый Соответствие;
		СоответствиеДляЗамены.Вставить("_ДатаНачала_", "ДатаНачалаВерсия");
		СоответствиеДляЗамены.Вставить("_ДатаЗавершения_", "ДатаЗавершенияВерсия");
		СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
		СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены,
			ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаВерсия") ИЛИ СравниватьСПоказателямиПоВерсии Тогда
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДатаНачалаВерсия", имяВТ, , "ДатаВремя(1, 1, 1)");
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияВерсия") ИЛИ СравниватьСПоказателямиПоВерсии Тогда
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДатаЗавершенияВерсия", имяВТ, , "ДатаВремя(1, 1, 1)");
		КонецЕсли;
	КонецЕсли;
	
