КонецПроцедуры

#КонецОбласти

Функция КолонкаОтмеченаВСпискеКолонок(СписокКолонок, ИмяКолонки) Экспорт
	Колонка = СписокКолонок.НайтиПоЗначению(ИмяКолонки);		
	Если Колонка = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Колонка.Пометка;
	КонецЕсли;
КонецФункции

#КонецОбласти

Функция ИспользуетсяКолонкаИзМассива(СписокКолонок, МассивКолонок)
	
	Для Каждого ИмяКолонки Из МассивКолонок Цикл
		Колонка = СписокКолонок.НайтиПоЗначению(ИмяКолонки);
		Если Колонка <> Неопределено И Колонка.Пометка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#Область ДополнениеТекстаЗапросаПолученияДанныхДляСтруктураСлужебная

// Экспорт функции для использования в расширении
Функция ВыполнитьПодменуВТекстеЗапроса(Знач СоответствиеДляЗамены, Знач ТекстЗапроса) Экспорт
	
	Для каждого ЭлементПодмены Из СоответствиеДляЗамены Цикл
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ЭлементПодмены.Ключ, ЭлементПодмены.Значение);
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Экспорт функции для использования в расширении
Функция ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапросаПоказателя, ИмяПоказателя = Неопределено,
	ИмяТаблицы = Неопределено, СтруктураКолонокИтогов = Неопределено, ПустоеЗначение = "0") Экспорт
	
	// Обрабатываем ситуацию, когда в запросе несколько колонок - ресурсов.
	
	Если ТипЗнч(ИмяПоказателя) = Тип("Строка") Тогда
		
		МассивИменПоказателей = Новый Массив;
		МассивИменПоказателей.Добавить(ИмяПоказателя);
		
	ИначеЕсли ТипЗнч(ИмяПоказателя) = Тип("Массив") Тогда
		
		МассивИменПоказателей = ИмяПоказателя;
		
	Иначе 
		
		МассивИменПоказателей = Новый Массив;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстЗапросаПоказателя) И ЗначениеЗаполнено(ИмяТаблицы) Тогда
		
		ТекстСоединения = "ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяТаблицы + " КАК " + ИмяТаблицы + " ПО "+ИмяТаблицы + ".ПроектнаяЗадача = ПЗы.Ссылка";
		
		Если Найти(ТекстыЗамены.СоединенияТаблицДопПоказателей, ТекстСоединения) = 0 Тогда
			ТекстыЗамены.ТекстыЗапросов = ТекстыЗамены.ТекстыЗапросов + ТекстЗапросаПоказателя + Символы.ПС + ";" + Символы.ПС;		
			ТекстыЗамены.СоединенияТаблицДопПоказателей = ТекстыЗамены.СоединенияТаблицДопПоказателей + Символы.ПС + ТекстСоединения;
		КонецЕсли;
	КонецЕсли;
	
	МассивКолонокИсключаемыхИзРасчетаИтогов = ПолучитьМассивКолонокИсключаемыхИзРасчетаИтогов();
	
	Для Каждого СтрокаПоказатель Из МассивИменПоказателей Цикл		
		
		Если ЗначениеЗаполнено(СтрокаПоказатель) Тогда
			Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
				Поле = " ISNULL("+ИмяТаблицы+"."+СтрокаПоказатель+", "+ПустоеЗначение+")";
			Иначе
				Поле = "(" + ПустоеЗначение + ")";
			КонецЕсли;
			ТекстыЗамены.ПоказателиВИтоговойВыборкеДляПЗ = ТекстыЗамены.ПоказателиВИтоговойВыборкеДляПЗ 
				+ ?(ЗначениеЗаполнено(ТекстыЗамены.ПоказателиВИтоговойВыборкеДляПЗ), ", ", "") + Поле + " КАК " + СтрокаПоказатель;
			ТекстыЗамены.ПоказателиВИтоговойВыборкеНеПЗ = ТекстыЗамены.ПоказателиВИтоговойВыборкеНеПЗ 
				+ ?(ЗначениеЗаполнено(ТекстыЗамены.ПоказателиВИтоговойВыборкеНеПЗ), ", ", "") + ПустоеЗначение;
		КонецЕсли; 	
		
		Если СтруктураКолонокИтогов <> Неопределено И ЗначениеЗаполнено(СтрокаПоказатель) 
			И МассивКолонокИсключаемыхИзРасчетаИтогов.Найти(СтрокаПоказатель) = Неопределено Тогда
			
			СтруктураКолонокИтогов.Вставить(СтрокаПоказатель);
			
		КонецЕсли; 
		
	КонецЦикла;
		
КонецФункции

Функция ДополнитьСтруктуруКолонокЗависимостями(СтруктураКолонок, СтруктураЗависимостей = Неопределено, КолонкиУжеОбошли = Неопределено) Экспорт
	
	Если СтруктураЗависимостей = Неопределено Тогда
		СтруктураЗависимостей = ПолучитьСтруктуруЗависимостей();
		КолонкиУжеОбошли = Новый Массив;
	КонецЕсли;
	
	КопияСтруктураКолонок = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураКолонок);
	Для Каждого КлючЗначение Из КопияСтруктураКолонок Цикл
		ЗначениеСтруктурыЗависимостей = Неопределено;
		Если СтруктураЗависимостей.Свойство(КлючЗначение.Ключ, ЗначениеСтруктурыЗависимостей) Тогда
			Если КолонкиУжеОбошли.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
				Продолжить;
			Иначе
				КолонкиУжеОбошли.Добавить(КлючЗначение.Ключ);
			КонецЕсли;
			СтруктураПодч = Новый Структура(ЗначениеСтруктурыЗависимостей);
			ДополнитьСтруктуруКолонокЗависимостями(СтруктураПодч, СтруктураЗависимостей, КолонкиУжеОбошли);
			Для Каждого КлючЗначениеПодч Из СтруктураПодч Цикл
				Если Не СтруктураКолонок.Свойство(КлючЗначениеПодч.Ключ) Тогда
					СтруктураКолонок.Вставить(КлючЗначениеПодч.Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

#КонецОбласти

#Область ПрограммныеКолонкиСлужебная

Процедура ДобавитьПодсказкуПрограммнойКолонке(СоответствиеКолонок, ИмяКолонки, ТекстПодсказки)
	
	ДанныеКолонки = СоответствиеКолонок.Получить(ИмяКолонки);
	ДанныеКолонки.Вставить("Подсказка", ТекстПодсказки);
	СоответствиеКолонок.Вставить(ИмяКолонки, ДанныеКолонки);
	
КонецПроцедуры

Процедура ДобавитьСтандартнуюКолонкуВыполнимости(СоответствиеКолонок, Имя, Представление, ИмяГруппы, ПослеЭлемента = "^")
	
	ДобавитьПараметрыПрограммнойКолонки(СоответствиеКолонок, Имя, Представление,, 
														Ложь, 4, ИмяГруппы, ПослеЭлемента,  Новый ОписаниеТипов("Строка, Число", Новый КвалификаторыЧисла(10, 0)),, Ложь);	
														
КонецПроцедуры

Процедура ДобавитьСтандартнуюЧисловуюКолонку(СоответствиеКолонок, Имя, Представление, ИмяГруппы, Обязательна = Ложь, ПослеЭлемента = "^", Редактирование = Ложь, Формат = "")
	
	ДобавитьПараметрыПрограммнойКолонки(СоответствиеКолонок, Имя, Представление,, 
		Ложь, 9, ИмяГруппы, ПослеЭлемента,  Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)),, Редактирование,,, Обязательна, Формат);

														
КонецПроцедуры   

Процедура ДобавитьСтандартнуюКолонкуДаты(СоответствиеКолонок, Имя, Представление, ИмяГруппы, ПослеЭлемента = "^")
	
	ДобавитьПараметрыПрограммнойКолонки(СоответствиеКолонок, Имя, Представление,, 
														Ложь, 10, ИмяГруппы, ПослеЭлемента,  Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)),, Ложь,,,, "ДФ=dd.MM.yyyy");
													
КонецПроцедуры

Процедура ДобавитьПараметрыПрограммнойКолонки(СоответствиеКолонок, Имя, Представление, БезОтображения = Ложь, ЭтоГруппа = Истина, ШиринаЭлемента = 0, ГруппаПоУмолчанию = "", ПослеЭлемента = "^",
											ОписаниеТипов = Неопределено, Зависимости = Неопределено, Редактирование = Ложь, ХранитьДанныеБазы = Ложь, 
											ВидимаПоУмолчанию = Ложь, Обязательна = Ложь, Формат = "", ЭтоПолеВвода = Истина, СобытияИзменений = Ложь)
											
	ПараметрыКолонки = Новый Структура("Имя, Представление, БезОтображения, ЭтоГруппа, ГруппаПоУмолчанию, ПослеЭлемента, ОписаниеТипов"
					+ ", Зависимости, Редактирование, ХранитьДанныеБазы, ВидимаПоУмолчанию, Обязательна, ШиринаЭлемента"
					+ ", Формат, ЭтоПолеВвода, СобытияИзменений",  
					Имя, Представление, БезОтображения, ЭтоГруппа, ГруппаПоУмолчанию, ПослеЭлемента, ОписаниеТипов,
					Зависимости, Редактирование, ХранитьДанныеБазы, ВидимаПоУмолчанию, Обязательна, ШиринаЭлемента,
					Формат, ЭтоПолеВвода, СобытияИзменений);		 					
					
	СоответствиеКолонок.Вставить(Имя, ПараметрыКолонки);					
	ДопИнформация = СоответствиеКолонок.Получить("_ДопИнформация");
	ДопИнформация.ПорядокДобавления.Добавить(Имя);	
	
	Если ПослеЭлемента = "^" Тогда
		ПараметрыКолонки.Вставить("ПослеЭлемента", ДопИнформация.ПорядокДобавления[ДопИнформация.ПорядокДобавления.Количество()-2]);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

