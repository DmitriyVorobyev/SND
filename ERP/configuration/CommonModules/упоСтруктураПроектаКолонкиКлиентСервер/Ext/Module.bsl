			СоответствиеДляЗамены.Вставить("_Доход_", "ДоходПлан"); 
			СоответствиеДляЗамены.Вставить("_Расход_", "РасходПлан");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
			
			ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ДоходПлан") Тогда     
