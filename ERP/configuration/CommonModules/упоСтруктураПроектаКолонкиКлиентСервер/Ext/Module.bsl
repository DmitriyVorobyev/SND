		СоответствиеДляЗамены.Вставить("_ОбъемыКоличествоПланVчас_", "ОбъемыКоличествоПланVчас");
		СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
		
		МассивПоказателей = Новый Массив;
		МассивПоказателей.Добавить("ОбъемыКоличествоПланVчас");
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
		МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
		
    КонецЕсли;
	
    Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФактV") Тогда   		
        
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоФактВыполненияОбъемовОборотыОбороты.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	СУММА(упоФактВыполненияОбъемовОборотыОбороты.СуммаВалютнаяОборот) КАК ОбъемыФактV,
		|	СУММА(упоФактВыполненияОбъемовОборотыОбороты.КоличествоОборот) КАК ОбъемыКоличествоФактV
		|ПОМЕСТИТЬ ВТ_ОбъемыФакт_V
		|ИЗ
		|	РегистрНакопления.упоФактВыполненияОбъемовОбороты.Обороты(
		|			,
		|			,
		|			,
		|			ПроектнаяЗадача.Проект = &Проект
		|				И ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Доход)) КАК упоФактВыполненияОбъемовОборотыОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	упоФактВыполненияОбъемовОборотыОбороты.ПроектнаяЗадача";		
        МассивПоказателей = Новый Массив;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФактV") И ДоступнаФинИнформация Тогда
			МассивПоказателей.Добавить("ОбъемыФактV");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоФактV") Тогда
			МассивПоказателей.Добавить("ОбъемыКоличествоФактV");
		КонецЕсли;
        ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ОбъемыФакт_V",
			СтруктураКолонокИтогов); 
        
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемПланТ") И ДоступнаФинИнформация Тогда   		
        
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Сумма) КАК ОбъемПланТ,
		|	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Количество) КАК ОбъемПланТКоличество
		|ПОМЕСТИТЬ ВТ_ОбъемПланТ
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыВыполненияОбъемов.СрезПоследних(
		|			,
		|			Версия = &ТекВерсия
		|				И ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Доход)) КАК упоАктуальныеПланыВыполненияОбъемовСрезПоследних
		|ГДЕ ДатаНачисления <= &КонецТекДня 
