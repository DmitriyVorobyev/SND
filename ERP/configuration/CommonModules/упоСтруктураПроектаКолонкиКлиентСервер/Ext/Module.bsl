			КонецЕсли;
            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсияV")
			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсияV") Тогда
            
            имяВТ = "ВТ_ОбъемыПлан_ВерсияV";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
            СоответствиеДляЗамены.Вставить("_ОбъемыV_", "ОбъемыПланВерсияV");
            СоответствиеДляЗамены.Вставить("_ОбъемыКоличествоV_", "ОбъемыКоличествоПланВерсияV");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсияV") И ДоступнаФинИнформация Тогда
