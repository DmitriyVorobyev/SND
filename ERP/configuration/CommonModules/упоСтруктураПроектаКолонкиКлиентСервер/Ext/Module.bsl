        КонецЕсли;
        
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ДоходФакт")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("РасходФакт") Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(Таблица.ВидЭлемента, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход)
			|				ТОГДА Таблица.СуммаОборот
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК ДоходФакт,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(Таблица.ВидЭлемента, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
			|				ТОГДА Таблица.СуммаОборот
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК РасходФакт
			|ПОМЕСТИТЬ ВТ_ДР_Факт
			|ИЗ
			|	РегистрНакопления.упоФактДоходовИРасходовОбороты.Обороты(, , , ПроектнаяЗадача.Проект = &Проект) КАК Таблица
			|
			|СГРУППИРОВАТЬ ПО
			|	Таблица.ПроектнаяЗадача";
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, , "ВТ_ДР_Факт");
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ДоходФакт") Тогда     
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ДоходФакт", "ВТ_ДР_Факт", СтруктураКолонокИтогов);
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("РасходФакт") Тогда     			
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "РасходФакт", "ВТ_ДР_Факт", СтруктураКолонокИтогов);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("РасходПланТ") Тогда   		
        
        ТекстЗапроса = 
