Процедура ДобавитьПоказателиВЗапрос_ОбъемыV_Р(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
	Знач ТекстыЗамены, ДоступнаФинИнформация)
    
    Перем имяВТ, МассивПоказателей, СоответствиеДляЗамены, ТекстЗапроса;
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланV_Р")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовыйV_Р")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсияV_Р") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланV_Р") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовыйV_Р") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсияV_Р")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоФактV_Р") Тогда
        
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Сумма) КАК _ОбъемыV_Р_,
		|	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Количество) КАК _ОбъемыКоличествоV_Р_
		|ПОМЕСТИТЬ _ВТ_
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыВыполненияОбъемов.СрезПоследних(
		|			,
		|			Версия = &_Версия_
		|				И ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Расход)) КАК упоАктуальныеПланыВыполненияОбъемовСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача";
        
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланV_Р")
			Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланV_Р") Тогда
            
            имяВТ = "ВТ_ОбъемыПлан_V_Р";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
            СоответствиеДляЗамены.Вставить("_ОбъемыV_Р_", "ОбъемыПланV_Р");
            СоответствиеДляЗамены.Вставить("_ОбъемыКоличествоV_Р_", "ОбъемыКоличествоПланV_Р");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланV_Р") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПланV_Р");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланV_Р") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПланV_Р");
			КонецЕсли;
            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовыйV_Р")
			Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовыйV_Р") Тогда
            
            имяВТ = "ВТ_ОбъемыПлан_БазовыйV_Р";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
            СоответствиеДляЗамены.Вставить("_ОбъемыV_Р_", "ОбъемыПланБазовыйV_Р");
            СоответствиеДляЗамены.Вставить("_ОбъемыКоличествоV_Р_", "ОбъемыКоличествоПланБазовыйV_Р");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовыйV_Р") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПланБазовыйV_Р");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовыйV_Р") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПланБазовыйV_Р");
			КонецЕсли;

            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсияV_Р")
			Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсияV_Р") Тогда
            
            имяВТ = "ВТ_ОбъемыПлан_ВерсияV_Р";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
            СоответствиеДляЗамены.Вставить("_ОбъемыV_Р_", "ОбъемыПланВерсияV_Р");
            СоответствиеДляЗамены.Вставить("_ОбъемыКоличествоV_Р_", "ОбъемыКоличествоПланВерсияV_Р");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсияV_Р") Тогда
            	МассивПоказателей.Добавить("ОбъемыПланВерсияV_Р");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсияV_Р") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПланВерсияV_Р");
			КонецЕсли;
            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
    КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФактV_Р") 
		Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоФактV_Р") Тогда   		
        
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоФактВыполненияОбъемовОборотыОбороты.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	СУММА(упоФактВыполненияОбъемовОборотыОбороты.СуммаВалютнаяОборот) КАК ОбъемыФактV_Р,
		|	СУММА(упоФактВыполненияОбъемовОборотыОбороты.КоличествоОборот) КАК ОбъемыКоличествоФактV_Р
		|ПОМЕСТИТЬ ВТ_ОбъемыФакт_V_Р
		|ИЗ
		|	РегистрНакопления.упоФактВыполненияОбъемовОбороты.Обороты(
		|			,
		|			,
		|			,
		|			ПроектнаяЗадача.Проект = &Проект
		|				И ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Расход)) КАК упоФактВыполненияОбъемовОборотыОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	упоФактВыполненияОбъемовОборотыОбороты.ПроектнаяЗадача";		
        МассивПоказателей = Новый Массив;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФактV_Р") И ДоступнаФинИнформация Тогда
			МассивПоказателей.Добавить("ОбъемыФактV_Р");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоФактV_Р") Тогда
			МассивПоказателей.Добавить("ОбъемыКоличествоФактV_Р");
		КонецЕсли;
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ОбъемыФакт_V_Р",
		СтруктураКолонокИтогов); 
        
    КонецЕсли;	
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ВыполнимостьОбъемыV_Р") И ДоступнаФинИнформация Тогда
        ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыполнимостьОбъемыV_Р", "", , """""");
    КонецЕсли;

