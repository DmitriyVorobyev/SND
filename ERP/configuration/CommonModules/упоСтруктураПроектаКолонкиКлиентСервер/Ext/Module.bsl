		               |	СУММА(упоФактВыполненияОбъемовОбороты.Сумма) КАК ОбъемыФактРезервПрочие
		               |ПОМЕСТИТЬ ВТ_ОбъемыФактРезервПрочие
		               |ИЗ
		               |	РегистрНакопления.упоФактВыполненияОбъемовОбороты КАК упоФактВыполненияОбъемовОбороты
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСССПИсключаемыеИзФОТ КАК упоСССПИсключаемыеИзФОТ
		               |		ПО упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд = упоСССПИсключаемыеИзФОТ.СобствСилы_Субподряд
		               |ГДЕ
		               |	упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд <> ЗНАЧЕНИЕ(Справочник.упоСобственныеСилыСубподряд.РК)
		               |	И упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд <> ЗНАЧЕНИЕ(Справочник.упоСобственныеСилыСубподряд.РПО)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	упоФактВыполненияОбъемовОбороты.ПроектнаяЗадача";	
		
		имяВТ = "ВТ_ОбъемыФактРезервПрочие";
		
		МассивПоказателей = Новый Массив;
		МассивПоказателей.Добавить("ОбъемыФактРезервПрочие");
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
		
	КонецЕсли;		
		
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_Результат(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены)
	
    Перем ТекстЗапроса;
    
    Если СтруктураВыводимыхДопКолонок.Свойство("Результат") Тогда		
        
        ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                       |	упоДанныеПлановВыпускаСубпродуктовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
                       |	упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Номенклатура КАК Номенклатура,
                       |	упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Комментарий КАК Комментарий
                       |ПОМЕСТИТЬ ОсновныеРезультатыПолныеДанные
                       |ИЗ
                       |	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
                       |			,
                       |			Версия = &_Версия_
                       |				И Основной) КАК упоДанныеПлановВыпускаСубпродуктовСрезПоследних
                       |;
                       |
                       |////////////////////////////////////////////////////////////////////////////////
                       |ВЫБРАТЬ
                       |	ОсновныеРезультатыПолныеДанные.ПроектнаяЗадача КАК ПроектнаяЗадача,
                       |	МАКСИМУМ(ВЫБОР
                       |			КОГДА ЕСТЬNULL(ОсновныеРезультатыПолныеДанные.Комментарий, """") <> """"
                       |				ТОГДА ЕСТЬNULL(ОсновныеРезультатыПолныеДанные.Комментарий, """")
                       |			ИНАЧЕ ЕСТЬNULL(ОсновныеРезультатыПолныеДанные.Номенклатура, НЕОПРЕДЕЛЕНО)
                       |		КОНЕЦ) КАК Результат
                       |ПОМЕСТИТЬ ВТ_Результат
                       |ИЗ
                       |	ОсновныеРезультатыПолныеДанные КАК ОсновныеРезультатыПолныеДанные
                       |
                       |СГРУППИРОВАТЬ ПО
                       |	ОсновныеРезультатыПолныеДанные.ПроектнаяЗадача";	
					   
		СоответствиеДляЗамены = Новый Соответствие;
        СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");			   
					   
        ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), "Результат", "ВТ_Результат",,"""""");
        
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ОсновноеЗадание(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены)
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ОсновноеЗадание") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("СтатусОсновногоЗадания")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("Исполнитель") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	МАКСИМУМ(упоЗадания.Ссылка) КАК ОсновноеЗадание,
		               |	упоЗадания.ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
		               |ПОМЕСТИТЬ ОсновныеЗадания
		               |ИЗ
		               |	Справочник.упоЗадания КАК упоЗадания
		               |ГДЕ
		               |	НЕ упоЗадания.ПометкаУдаления
		               |	И упоЗадания.ЭтоОсновноеЗаданиеПроектнойЗадачи
		               |	И упоЗадания.ВидЗадания = ЗНАЧЕНИЕ(Справочник.упоВидыЗаданий.Поручение)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	упоЗадания.ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ОсновноеЗадание
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоЗаданияСтатусыСрезПоследних.Задание КАК Задание,
		               |	упоЗаданияСтатусыСрезПоследних.Статус
		               |ПОМЕСТИТЬ СтатусыЗаданий
		               |ИЗ
		               |	РегистрСведений.упоЗаданияСтатусы.СрезПоследних(
		               |			,
		               |			Задание В
		               |				(ВЫБРАТЬ
		               |					ОсновныеЗадания.ОсновноеЗадание
		               |				ИЗ
		               |					ОсновныеЗадания КАК ОсновныеЗадания)) КАК упоЗаданияСтатусыСрезПоследних
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	Задание
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ОсновныеЗадания.ОсновноеЗадание,
		               |	ОсновныеЗадания.ОсновноеЗадание.Исполнитель КАК Исполнитель,
		               |	ОсновныеЗадания.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		               |	СтатусыЗаданий.Статус КАК СтатусОсновногоЗадания
		               |ПОМЕСТИТЬ ВТ_ОсновноеЗадание
		               |ИЗ
		               |	ОсновныеЗадания КАК ОсновныеЗадания
		               |		ЛЕВОЕ СОЕДИНЕНИЕ СтатусыЗаданий КАК СтатусыЗаданий
		               |		ПО ОсновныеЗадания.ОсновноеЗадание = СтатусыЗаданий.Задание
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	ПроектнаяЗадача";
		
		МассивПоказателей = Новый Массив;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОсновноеЗадание") Тогда
			МассивПоказателей.Добавить("ОсновноеЗадание");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("Исполнитель") Тогда
			МассивПоказателей.Добавить("Исполнитель");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("СтатусОсновногоЗадания") Тогда
			МассивПоказателей.Добавить("СтатусОсновногоЗадания");
		КонецЕсли;	
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ОсновноеЗадание");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ЗаданияПодразделениям(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены)
		
	Если Не СтруктураВыводимыхДопКолонок.Свойство("ЗаданиеПодразделению") Тогда
		Возврат;
	КонецЕсли;	
		
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоЗаданияСтатусыСрезПоследних.Задание КАК Задание,
	               |	упоЗаданияСтатусыСрезПоследних.Статус КАК Статус,
	               |	упоЗаданияСтатусыСрезПоследних.Задание.ВидЗаданияПодразделению КАК ВидЗаданияПодразделению,
	               |	упоЗаданияСтатусыСрезПоследних.Задание.ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ЗаданиеПроектнаяЗадача,
	               |	ВЫБОР
	               |		КОГДА упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Выдано)
	               |			ТОГДА 1
	               |		КОГДА упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Уточняется)
	               |			ТОГДА 2
	               |		КОГДА упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Выполняется)
	               |			ТОГДА 3
	               |		КОГДА упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Завершено)
	               |			ТОГДА 4
	               |		КОГДА упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Закрыто)
	               |			ТОГДА 5
	               |		КОГДА упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Отменено)
	               |			ТОГДА 6
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПолеСортировки
	               |ПОМЕСТИТЬ ВсеСтатусыЗаданийПодразделению
	               |ИЗ
	               |	РегистрСведений.упоЗаданияСтатусы.СрезПоследних(
	               |			,
	               |			Задание.ЭтоЗаданиеПодразделению
	               |				И Задание.Проект = &Проект
	               |				И НЕ Задание.ПометкаУдаления) КАК упоЗаданияСтатусыСрезПоследних
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Задание
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МинимальноеЗадание.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВсеСтатусыЗаданийПодразделению.Статус КАК СтатусЗаданияПодразделению,
	               |	ВсеСтатусыЗаданийПодразделению.ВидЗаданияПодразделению КАК ВидЗаданияПодразделению,
	               |	МинимальноеЗадание.ЗаданиеПодразделениюСсылка КАК ЗаданиеПодразделениюСсылка
	               |ПОМЕСТИТЬ ВТ_ЗаданияПодразделению
	               |ИЗ
	               |	ВсеСтатусыЗаданийПодразделению КАК ВсеСтатусыЗаданийПодразделению
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МинимальныйСтатус.ЗаданиеПроектнаяЗадача КАК ПроектнаяЗадача,
	               |			МИНИМУМ(ВсеСтатусыЗаданийПодразделению.Задание) КАК ЗаданиеПодразделениюСсылка
	               |		ИЗ
	               |			ВсеСтатусыЗаданийПодразделению КАК ВсеСтатусыЗаданийПодразделению
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |					ВсеСтатусыЗаданийПодразделению.ЗаданиеПроектнаяЗадача КАК ЗаданиеПроектнаяЗадача,
	               |					МИНИМУМ(ВсеСтатусыЗаданийПодразделению.ПолеСортировки) КАК ПолеСортировки
	               |				ИЗ
	               |					ВсеСтатусыЗаданийПодразделению КАК ВсеСтатусыЗаданийПодразделению
	               |				
	               |				СГРУППИРОВАТЬ ПО
	               |					ВсеСтатусыЗаданийПодразделению.ЗаданиеПроектнаяЗадача) КАК МинимальныйСтатус
	               |				ПО ВсеСтатусыЗаданийПодразделению.ЗаданиеПроектнаяЗадача = МинимальныйСтатус.ЗаданиеПроектнаяЗадача
	               |					И ВсеСтатусыЗаданийПодразделению.ПолеСортировки = МинимальныйСтатус.ПолеСортировки
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			МинимальныйСтатус.ЗаданиеПроектнаяЗадача) КАК МинимальноеЗадание
	               |		ПО ВсеСтатусыЗаданийПодразделению.ЗаданиеПроектнаяЗадача = МинимальноеЗадание.ПроектнаяЗадача
	               |			И ВсеСтатусыЗаданийПодразделению.Задание = МинимальноеЗадание.ЗаданиеПодразделениюСсылка";
		
		
	МассивПоказателей = Новый Массив;		
	МассивПоказателей.Добавить("СтатусЗаданияПодразделению");
	МассивПоказателей.Добавить("ВидЗаданияПодразделению");
	МассивПоказателей.Добавить("ЗаданиеПодразделениюСсылка");
	
	ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ЗаданияПодразделению");
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ОсновнаяРоль(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены)
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ОсновнаяРоль") ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ПодразделениеОсновнойРоли") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача,
		               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Подразделение КАК ПодразделениеОсновнойРоли,
		               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Ресурс КАК ОсновнаяРоль
		               |ПОМЕСТИТЬ ВТ_ОсновнаяРоль
		               |ИЗ
		               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(, Версия = &_Версия_) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
		               |ГДЕ
		               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Основной
		               |	И (упоДанныеПлановТрудозатратРолейСрезПоследних.Количество <> 0
		               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.ОбщСтоимость <> 0
		               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.ОбщВнешняяСтоимость <> 0)";
	
		СоответствиеДляЗамены = Новый Соответствие;
        СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");			   
					   
        ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), "ОсновнаяРоль", "ВТ_ОсновнаяРоль");
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ПодразделениеОсновнойРоли", "ВТ_ОсновнаяРоль");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_СрокиПоЗагрузкеРолей(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены, пПараметры)
	
	Если НЕ (СтруктураВыводимыхДопКолонок.Свойство("МесяцНачалаПоПредварительномуУровнюРолей") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("МесяцОкончанияПоПредварительномуУровнюРолей")  
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("МесяцНачалаПоОкончательномуУровнюРолей") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("МесяцОкончанияПоОкончательномуУровнюРолей")) 
		Тогда
			Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаСроковПоЗагрузке.Операция КАК ПроектнаяЗадача,
	               |	МАКСИМУМ(ТаблицаСроковПоЗагрузке.День) КАК Окончание,
	               |	МИНИМУМ(ТаблицаСроковПоЗагрузке.День) КАК Начало
	               |ПОМЕСТИТЬ _ВР_Пром1_
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК ТаблицаСроковПоЗагрузке
	               |ГДЕ
	               |	ТаблицаСроковПоЗагрузке.УровеньПланирования = &УровеньПланирования
	               |	И ТаблицаСроковПоЗагрузке.Проект = &Проект
	               |	И ТаблицаСроковПоЗагрузке.Ресурс ССЫЛКА Справочник.упоРоли
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаСроковПоЗагрузке.Операция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ВР_Пром1_.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	НАЧАЛОПЕРИОДА(_ВР_Пром1_.Окончание, МЕСЯЦ) КАК _ПоказательОкончания_,
	               |	НАЧАЛОПЕРИОДА(_ВР_Пром1_.Начало, МЕСЯЦ) КАК _ПоказательНачала_
	               |ПОМЕСТИТЬ _ВР_Пром2_
	               |ИЗ
	               |	_ВР_Пром1_ КАК _ВР_Пром1_";
	
	Если СтруктураВыводимыхДопКолонок.Свойство("МесяцНачалаПоПредварительномуУровнюРолей") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("МесяцОкончанияПоПредварительномуУровнюРолей") Тогда
		
		СоответствиеДляЗамены = Новый Соответствие;
		Если пПараметры.ТекущаяВерсияПроектаВСистеме <> пПараметры.текВерсия Тогда
			СоответствиеДляЗамены.Вставить("упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия", "упоАктуальныеПланыТрудозатратПоДнямВерсии");
			СоответствиеДляЗамены.Вставить("ТаблицаСроковПоЗагрузке.Проект = &Проект", "ТаблицаСроковПоЗагрузке.Версия = &текВерсия");
		КонецЕсли;
		СоответствиеДляЗамены.Вставить("_ВР_Пром1_", "ВР_Пром1_Предварительный"); 
		СоответствиеДляЗамены.Вставить("_ВР_Пром2_", "ВТ_СрокиПоПредварительномуУровню");
		СоответствиеДляЗамены.Вставить("_ПоказательНачала_", "МесяцНачалаПоПредварительномуУровнюРолей");  
		СоответствиеДляЗамены.Вставить("_ПоказательОкончания_", "МесяцОкончанияПоПредварительномуУровнюРолей");
		СоответствиеДляЗамены.Вставить("&УровеньПланирования", "Значение(Перечисление.упоУровеньПланирования.Предварительный)");
            
		ПравильныйТекстЗапроса = ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса);				
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ПравильныйТекстЗапроса, "МесяцНачалаПоПредварительномуУровнюРолей", "ВТ_СрокиПоПредварительномуУровню");
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "МесяцОкончанияПоПредварительномуУровнюРолей", "ВТ_СрокиПоПредварительномуУровню");
		
	КонецЕсли;
	
	
	Если СтруктураВыводимыхДопКолонок.Свойство("МесяцНачалаПоОкончательномуУровнюРолей") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("МесяцОкончанияПоОкончательномуУровнюРолей") Тогда
		
		СоответствиеДляЗамены = Новый Соответствие;
		Если пПараметры.ТекущаяВерсияПроектаВСистеме <> пПараметры.текВерсия Тогда
			СоответствиеДляЗамены.Вставить("упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия", "упоАктуальныеПланыТрудозатратПоДнямВерсии");
			СоответствиеДляЗамены.Вставить("ТаблицаСроковПоЗагрузке.Проект = &Проект", "ТаблицаСроковПоЗагрузке.Версия = &текВерсия");
		КонецЕсли;
		СоответствиеДляЗамены.Вставить("_ВР_Пром1_", "ВР_Пром1_Окончательный"); 
		СоответствиеДляЗамены.Вставить("_ВР_Пром2_", "ВТ_СрокиПоОкончательномуУровню");
		СоответствиеДляЗамены.Вставить("_ПоказательНачала_", "МесяцНачалаПоОкончательномуУровнюРолей");  
		СоответствиеДляЗамены.Вставить("_ПоказательОкончания_", "МесяцОкончанияПоОкончательномуУровнюРолей");
		СоответствиеДляЗамены.Вставить("&УровеньПланирования", "Значение(Перечисление.упоУровеньПланирования.Окончательный)");

		ПравильныйТекстЗапроса = ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса);				
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ПравильныйТекстЗапроса, "МесяцНачалаПоОкончательномуУровнюРолей", "ВТ_СрокиПоОкончательномуУровню");
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "МесяцОкончанияПоОкончательномуУровнюРолей", "ВТ_СрокиПоОкончательномуУровню");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_СрокиПоЗагрузкеТР(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены, пПараметры)
	
	Если НЕ (СтруктураВыводимыхДопКолонок.Свойство("НачалоРаботТР") 
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОкончаниеРаботТР"))  
		Тогда
			Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаСроковПоЗагрузке.Операция КАК ПроектнаяЗадача,
	               |	МАКСИМУМ(ТаблицаСроковПоЗагрузке.День) КАК Окончание,
	               |	МИНИМУМ(ТаблицаСроковПоЗагрузке.День) КАК Начало
	               |ПОМЕСТИТЬ _ВР_Пром1_
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК ТаблицаСроковПоЗагрузке
	               |ГДЕ
				   |	ТаблицаСроковПоЗагрузке.Проект = &Проект
	               |	И ТаблицаСроковПоЗагрузке.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)	               
	               |	И ТаблицаСроковПоЗагрузке.Ресурс ССЫЛКА Справочник.упоТрудовыеРесурсы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаСроковПоЗагрузке.Операция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	_ВР_Пром1_.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	НАЧАЛОПЕРИОДА(_ВР_Пром1_.Окончание, ДЕНЬ) КАК _ПоказательОкончания_,
	               |	НАЧАЛОПЕРИОДА(_ВР_Пром1_.Начало, ДЕНЬ) КАК _ПоказательНачала_
	               |ПОМЕСТИТЬ _ВР_Пром2_
	               |ИЗ
	               |	_ВР_Пром1_ КАК _ВР_Пром1_";
	
	
	СоответствиеДляЗамены = Новый Соответствие;
	Если пПараметры.ТекущаяВерсияПроектаВСистеме <> пПараметры.текВерсия Тогда
		СоответствиеДляЗамены.Вставить("упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия", "упоАктуальныеПланыТрудозатратПоДнямВерсии");
		СоответствиеДляЗамены.Вставить("ТаблицаСроковПоЗагрузке.Проект = &Проект", "ТаблицаСроковПоЗагрузке.Версия = &текВерсия");
	КонецЕсли;	
	СоответствиеДляЗамены.Вставить("_ВР_Пром1_", "ВР_Пром1_ТР"); 
	СоответствиеДляЗамены.Вставить("_ВР_Пром2_", "ВТ_СрокиПоТР");
	СоответствиеДляЗамены.Вставить("_ПоказательНачала_", "НачалоРаботТР");  
	СоответствиеДляЗамены.Вставить("_ПоказательОкончания_", "ОкончаниеРаботТР");
        
	ПравильныйТекстЗапроса = ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса);				
	
	ДобавитьПоказательВЗапрос(ТекстыЗамены, ПравильныйТекстЗапроса, "НачалоРаботТР", "ВТ_СрокиПоТР");
	ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ОкончаниеРаботТР", "ВТ_СрокиПоТР");
		
КонецПроцедуры

