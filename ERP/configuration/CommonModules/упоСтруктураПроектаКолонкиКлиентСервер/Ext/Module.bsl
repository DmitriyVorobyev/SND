Процедура ДобавитьПоказателиВЗапрос_ФактическиеСроки(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены)
    
	Перем ТекстЗапроса;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаФакт")
		Или СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияФакт") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.ПроектнаяЗадача,
		|	Таблица.ДатаНачала КАК ДатаНачалаФакт,
		|	Таблица.ДатаЗавершения КАК ДатаЗавершенияФакт
		|ПОМЕСТИТЬ ВТ_ФактическиеСроки
		|ИЗ
		|	РегистрСведений.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &текВерсия) КАК Таблица
		| ";	
		
		МассивПоказателей = Новый Массив;
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаФакт") Тогда
			МассивПоказателей.Добавить("ДатаНачалаФакт");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияФакт") Тогда
			МассивПоказателей.Добавить("ДатаЗавершенияФакт");
		КонецЕсли;
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ФактическиеСроки", , "ДАТАВРЕМЯ(1, 1, 1)");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ПрогнозныеСрокиПроектныхЗадач(Знач СтруктураВыводимыхДопКолонок, Знач ТекстыЗамены)
    
	Перем ТекстЗапроса;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;	
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаПрогноз")
		Или СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияПрогноз")
		Или СтруктураВыводимыхДопКолонок.Свойство("СтатусСроков") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.ПроектнаяЗадача,
		|	Таблица.ДатаНачалаПрогноз КАК ДатаНачалаПрогноз,
		|	Таблица.ДатаЗавершенияПрогноз КАК ДатаЗавершенияПрогноз,
		|	Таблица.СтатусСроков КАК СтатусСроков
		|ПОМЕСТИТЬ ВТ_СтатусСроков
		|ИЗ
		|	РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &текВерсия) КАК Таблица
		| ";	
		
		МассивПоказателей = Новый Массив;
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаНачалаПрогноз") Тогда
			МассивПоказателей.Добавить("ДатаНачалаПрогноз");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("ДатаЗавершенияПрогноз") Тогда
			МассивПоказателей.Добавить("ДатаЗавершенияПрогноз");
		КонецЕсли;
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_СтатусСроков", , "ДАТАВРЕМЯ(1, 1, 1)");
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, "СтатусСроков", "ВТ_СтатусСроков", , "Неопределено");
		
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_Переопределяемый(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов, ТекстыЗамены, пПараметры)
		
КонецПроцедуры

Процедура ДополнитьСтруктуруКолонокИтогов(СтруктураВыводимыхДопКолонок, СтруктураКолонокИтогов)
	
	// Добавляем в итоги расчетные показатели, которые после построчного расчета
