		ДобавитьСтандартнуюЧисловуюКолонку(СоответствиеКолонок, "ОбъемыПланБазовый", Заголовок, 
			ИмяГруппы,, "^",, ФорматКолонокСумм);
		
		Заголовок = СтрШаблон(ШаблонСПереносом, НСтр("ru = 'Объемы'") + Символы.ПС + НСтр("ru = 'по версии'"));
