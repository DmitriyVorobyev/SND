Функция ПолучитьМассивКолонокВыполнимости(СтруктураВыводимыхДопКолонок = Неопределено) Экспорт
	
	МассивКолонокВыполнимости = Новый Массив;
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьДоход", "ДоходФакт", "ДоходПлан"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьРасход", "РасходФакт", "РасходПлан"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьПоступления", "ПоступленияФакт", "ПоступленияПлан"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьФОТ", "ФОТФакт", "ФОТПлан"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьФОТРасчетный", "ФОТФакт", "ФОТРасчетный"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьОбъемы", "ОбъемыФакт", "ОбъемыПлан"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьВыплаты", "ВыплатыФакт", "ВыплатыПлан"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьКоличествоОбъемы", "ОбъемыКоличествоФакт", "ОбъемыКоличествоПлан"));	 
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьТрудозатраты", "ТрудозатратыФ", "ТрудозатратыТП"));	
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьТрудозатратыОкончТР", "ТрудозатратыФ", "ТрудозатратыТП_ОкончТР"));	
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьТрудозатратыОкончРоли", "ТрудозатратыФ", "ТрудозатратыТП_ОкончРоли"));			
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьКоличествоОбъемыV", "ОбъемыКоличествоФактV", "ОбъемыКоличествоПланV"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьОбъемыV", "ОбъемыФактV", "ОбъемыПланV"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ТрудозатратыФОбъемыПланV", "ТрудозатратыФ", "ОбъемыКоличествоПланVчас"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"РасходВыполнимостьТ", "РасходФакт", "РасходПланТ"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ОбъемВыполнимостьТ", "ОбъемыФактV", "ОбъемПланТ"));		
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьОбъемыV_Р", "ОбъемыФактV_Р", "ОбъемыПланV_Р"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"ВыполнимостьКоличествоОбъемыV_Р", "ОбъемыКоличествоФактV_Р", "ОбъемыКоличествоПланV_Р"));
	
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"CPI", "EV", "РасходФакт"));
	МассивКолонокВыполнимости.Добавить(Новый Структура("Результат, Числитель, Знаменатель",
		"SPI", "EV", "РасходПланТ"));
		
	Если СтруктураВыводимыхДопКолонок <> Неопределено Тогда
		сч = МассивКолонокВыполнимости.Количество() - 1;
		Пока сч >= 0 Цикл
			Колонка = МассивКолонокВыполнимости[сч];
			Если НЕ СтруктураВыводимыхДопКолонок.Свойство(Колонка.Результат) Тогда
				МассивКолонокВыполнимости.Удалить(сч);		
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивКолонокВыполнимости;	
	
КонецФункции

Функция ПолучитьМассивКолонокРазности(СтруктураВыводимыхДопКолонок = Неопределено) Экспорт
	
	МассивКолонокРазности = Новый Массив;
	МассивКолонокРазности.Добавить(Новый Структура("Результат, ПервыйЧлен, ВторойЧлен",
											"ТрудозатратыТП_ОтклонениеТРотОкончРоли", "ТрудозатратыТП_ОкончТР", "ТрудозатратыТП_ОкончРоли"));
			
	Если СтруктураВыводимыхДопКолонок <> Неопределено Тогда
		сч = МассивКолонокРазности.Количество() - 1;
		Пока сч >= 0 Цикл
			Колонка = МассивКолонокРазности[сч];
			Если НЕ СтруктураВыводимыхДопКолонок.Свойство(Колонка.Результат) Тогда
				МассивКолонокРазности.Удалить(сч);		
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивКолонокРазности;	
	
КонецФункции

