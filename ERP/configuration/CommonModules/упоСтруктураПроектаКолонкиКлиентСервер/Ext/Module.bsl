	ДобавитьСтандартнуюКолонкуВыполнимости(СоответствиеКолонок, "ВыполнимостьКоличествоОбъемыV", Заголовок, ИмяГруппы, "^");
	
	Заголовок = СтрШаблон(ШаблонСПереносом, НСтр("ru = 'Норма стоимости'"), НСтр("ru = 'объемов'"));
