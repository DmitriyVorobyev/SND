            	МассивПоказателей.Добавить("ОбъемыКоличествоПланV");
			КонецЕсли;
            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовыйV")
			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовыйV") Тогда
            
