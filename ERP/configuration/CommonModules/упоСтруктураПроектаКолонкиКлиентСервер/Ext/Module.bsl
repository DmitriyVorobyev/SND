		|	упоФактВыполненияОбъемовОбороты.ПроектнаяЗадача";	
		
		имяВТ = "ВТ_ОбъемыФактЗаВычетомСССП";
		
		МассивПоказателей = Новый Массив;
		МассивПоказателей.Добавить("ОбъемыФактЗаВычетомСССП");
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
		
	КонецЕсли;	

	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФактРезервРПО") 
			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФактРезервРК") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоФактВыполненияОбъемовОбороты.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	СУММА(ВЫБОР
		               |			КОГДА упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд = ЗНАЧЕНИЕ(Справочник.упоСобственныеСилыСубподряд.РК)
		               |				ТОГДА упоФактВыполненияОбъемовОбороты.Сумма
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ОбъемыФактРезервРК,
		               |	СУММА(ВЫБОР
		               |			КОГДА упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд = ЗНАЧЕНИЕ(Справочник.упоСобственныеСилыСубподряд.РПО)
		               |				ТОГДА упоФактВыполненияОбъемовОбороты.Сумма
		               |			ИНАЧЕ 0
		               |		КОНЕЦ) КАК ОбъемыФактРезервРПО
		               |ПОМЕСТИТЬ _ВТ_
		               |ИЗ
		               |	РегистрНакопления.упоФактВыполненияОбъемовОбороты КАК упоФактВыполненияОбъемовОбороты
		               |		ГДЕ упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд = ЗНАЧЕНИЕ(Справочник.упоСобственныеСилыСубподряд.РПО) ИЛИ упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд = ЗНАЧЕНИЕ(Справочник.упоСобственныеСилыСубподряд.РК)
		               |СГРУППИРОВАТЬ ПО
		               |	упоФактВыполненияОбъемовОбороты.ПроектнаяЗадача";	
		
		имяВТ = "ВТ_ОбъемыФактРезервРК_РПО";
				
