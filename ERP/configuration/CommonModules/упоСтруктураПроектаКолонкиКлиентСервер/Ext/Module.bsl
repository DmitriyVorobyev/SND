			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсияV") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПланВерсияV");
			КонецЕсли;
            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
