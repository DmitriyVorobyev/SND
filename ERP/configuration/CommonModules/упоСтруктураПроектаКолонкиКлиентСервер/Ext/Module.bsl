Функция КолонкаДоступна(ИмяКолонки, КолонкиПроверки, ОтключитьПроверку)
		
	Если ОтключитьПроверку Тогда
		Результат = Истина;
	Иначе
		Результат = КолонкиПроверки.Получить(ИмяКолонки) <> Неопределено;
	КонецЕсли;	
	
	Возврат Результат; 
	
