        КонецЕсли;
        
    КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланVчас") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Количество) КАК ОбъемыКоличествоПланVчас
		|ПОМЕСТИТЬ _ВТ_
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыВыполненияОбъемов.СрезПоследних(
		|			,
		|			Версия = &_Версия_
		|				И ЕдиницаИзмерения = &ЕдиницаИзмеренияЧас) КАК упоАктуальныеПланыВыполненияОбъемовСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача";
		
		
		имяВТ = "ВТ_ОбъемыКоличествоVчас";
		
		СоответствиеДляЗамены = Новый Соответствие;
