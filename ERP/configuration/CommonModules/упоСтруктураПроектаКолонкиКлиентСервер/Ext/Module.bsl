Процедура ДобавитьПоказателиВЗапрос_ПрямыеРасходы(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
	Знач ТекстыЗамены)
    
    Перем имяВТ, СоответствиеДляЗамены, ТекстЗапроса;
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ПланПоСтатьямПрямыхРасходов")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ПланПоСтатьямПрямыхРасходовБазовый")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ПланПоСтатьямПрямыхРасходовВерсия") Тогда   	
        
        ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                       |	упоАктуальныеПланыДоходовИРасходовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
                       |	СУММА(упоАктуальныеПланыДоходовИРасходовСрезПоследних.Сумма) КАК _ПланПоСтатьямПрямыхРасходов_
                       |ПОМЕСТИТЬ _ВТ_
                       |ИЗ
                       |	РегистрСведений.упоАктуальныеПланыДоходовИРасходов.СрезПоследних(, Версия = &_Версия_) КАК упоАктуальныеПланыДоходовИРасходовСрезПоследних
                       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатьиПрямыхРасходов КАК упоСтатьиПрямыхРасходов
                       |		ПО упоАктуальныеПланыДоходовИРасходовСрезПоследних.Статья = упоСтатьиПрямыхРасходов.Статья
                       |			И (упоАктуальныеПланыДоходовИРасходовСрезПоследних.Сумма <> 0)
                       |
                       |СГРУППИРОВАТЬ ПО
                       |	упоАктуальныеПланыДоходовИРасходовСрезПоследних.ПроектнаяЗадача";
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ПланПоСтатьямПрямыхРасходов") Тогда
            
            имяВТ = "ВТ_ПланПоСтатьямПрямыхРасходов";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
            СоответствиеДляЗамены.Вставить("_ПланПоСтатьямПрямыхРасходов_", "ПланПоСтатьямПрямыхРасходов");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				"ПланПоСтатьямПрямыхРасходов", имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ПланПоСтатьямПрямыхРасходовБазовый") Тогда
            
            имяВТ = "ВТ_ПланПоСтатьямПрямыхРасходовБазовый";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
            СоответствиеДляЗамены.Вставить("_ПланПоСтатьямПрямыхРасходов_", "ПланПоСтатьямПрямыхРасходовБазовый");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				"ПланПоСтатьямПрямыхРасходовБазовый", имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ПланПоСтатьямПрямыхРасходовВерсия") Тогда
            
            имяВТ = "ВТ_ПланПоСтатьямПрямыхРасходовВерсия";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
            СоответствиеДляЗамены.Вставить("_ПланПоСтатьямПрямыхРасходов_", "ПланПоСтатьямПрямыхРасходовВерсия");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				"ПланПоСтатьямПрямыхРасходовВерсия", имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
    КонецЕсли;

	Если СтруктураВыводимыхДопКолонок.Свойство("ФактПоСтатьямПрямыхРасходов") Тогда   	
        
        ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                       |	упоФактДоходовИРасходовПоДням.ПроектнаяЗадача КАК ПроектнаяЗадача,
                       |	СУММА(упоФактДоходовИРасходовПоДням.Сумма) КАК ФактПоСтатьямПрямыхРасходов
                       |ПОМЕСТИТЬ ВТ_ФактПоСтатьямПрямыхРасходов
                       |ИЗ
                       |	РегистрСведений.упоФактДоходовИРасходовПоДням КАК упоФактДоходовИРасходовПоДням
                       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатьиПрямыхРасходов КАК упоСтатьиПрямыхРасходов
                       |		ПО упоФактДоходовИРасходовПоДням.Статья = упоСтатьиПрямыхРасходов.Статья
                       |			И (упоФактДоходовИРасходовПоДням.Сумма <> 0)
                       |
                       |СГРУППИРОВАТЬ ПО
                       |	упоФактДоходовИРасходовПоДням.ПроектнаяЗадача";
        
        МассивПоказателей = Новый Массив;
		МассивПоказателей.Добавить("ФактПоСтатьямПрямыхРасходов");
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ФактПоСтатьямПрямыхРасходов", СтруктураКолонокИтогов);
                
    КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ФОТ(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
	Знач ТекстыЗамены)
    
    Перем имяВТ, СоответствиеДляЗамены, ТекстЗапроса;
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ФОТПлан")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ФОТПланБазовый") 
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ФОТПланВерсия") Тогда   	
        
        ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	упоАктуальныеПланыДоходовИРасходовСрезПоследних.ПроектнаяЗадача,
	        |	СУММА(упоАктуальныеПланыДоходовИРасходовСрезПоследних.Сумма) КАК _ФОТ_
	        |ПОМЕСТИТЬ _ВТ_
	        |ИЗ
	        |	РегистрСведений.упоАктуальныеПланыДоходовИРасходов.СрезПоследних(, Версия = &_Версия_) КАК упоАктуальныеПланыДоходовИРасходовСрезПоследних
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатьиФОТ КАК упоСтатьиФОТ
	        |		ПО упоАктуальныеПланыДоходовИРасходовСрезПоследних.Статья = упоСтатьиФОТ.Статья
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	упоАктуальныеПланыДоходовИРасходовСрезПоследних.ПроектнаяЗадача";
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ФОТПлан") Тогда
            
            имяВТ = "ВТ_ФОТПлан";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
            СоответствиеДляЗамены.Вставить("_ФОТ_", "ФОТПлан");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), "ФОТПлан", имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ФОТПланБазовый") Тогда
            
            имяВТ = "ВТ_ФОТПланБазовый";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
            СоответствиеДляЗамены.Вставить("_ФОТ_", "ФОТПланБазовый");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				"ФОТПланБазовый", имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
        Если СтруктураВыводимыхДопКолонок.Свойство("ФОТПланВерсия") Тогда
            
            имяВТ = "ВТ_ФОТПланВерсия";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
            СоответствиеДляЗамены.Вставить("_ФОТ_", "ФОТПланВерсия");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				"ФОТПланВерсия", имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
    КонецЕсли;
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ФОТФактПоБДР") Тогда   	
        
        ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	упоФактДоходовИРасходовПоДням.ПроектнаяЗадача,
	        |	СУММА(упоФактДоходовИРасходовПоДням.Сумма) КАК ФОТФактПоБДР
	        |ПОМЕСТИТЬ ВТ_ФОТФактПоБДР
	        |ИЗ
	        |	РегистрСведений.упоФактДоходовИРасходовПоДням КАК упоФактДоходовИРасходовПоДням
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатьиФОТ КАК упоСтатьиФОТ
	        |		ПО упоФактДоходовИРасходовПоДням.Статья = упоСтатьиФОТ.Статья
	        |ГДЕ упоФактДоходовИРасходовПоДням.ПроектнаяЗадача.Проект = &Проект
	        |СГРУППИРОВАТЬ ПО
	        |	упоФактДоходовИРасходовПоДням.ПроектнаяЗадача";
        ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, "ФОТФактПоБДР", "ВТ_ФОТФактПоБДР",
			СтруктураКолонокИтогов);
        
    КонецЕсли;		
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ФОТФактПоТабелю") Тогда   	
        
        ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	ВЫБОР
	        |		КОГДА упоФактТрудозатратПоДням.Операция ССЫЛКА Документ.упоПроектнаяЗадача
	        |			ТОГДА упоФактТрудозатратПоДням.Операция
	        |		ИНАЧЕ упоФактТрудозатратПоДням.Операция.ПроектнаяЗадача
	        |	КОНЕЦ КАК ПроектнаяЗадача,
	        |	СУММА(упоФактТрудозатратПоДням.Стоимость) КАК ФОТФактПоТабелю
	        |ПОМЕСТИТЬ ВТ_ФОТФактПоТабелю
	        |ИЗ
	        |	РегистрСведений.упоФактТрудозатратПоДням КАК упоФактТрудозатратПоДням
	        |ГДЕ
	        |	упоФактТрудозатратПоДням.День >= &ТекДата
	        |	И упоФактТрудозатратПоДням.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВЫБОР
	        |		КОГДА упоФактТрудозатратПоДням.Операция ССЫЛКА Документ.упоПроектнаяЗадача
	        |			ТОГДА упоФактТрудозатратПоДням.Операция
	        |		ИНАЧЕ упоФактТрудозатратПоДням.Операция.ПроектнаяЗадача
	        |	КОНЕЦ";
        ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, "ФОТФактПоТабелю", "ВТ_ФОТФактПоТабелю",
			СтруктураКолонокИтогов);
        
    КонецЕсли;	
    
    Если СтруктураВыводимыхДопКолонок.Свойство("ФОТФакт") Тогда   	
        
        ТекстЗапроса ="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	ФактФОТпоБДР.ПроектнаяЗадача,
	        |	ФактФОТпоБДР.ФОТФактПоБДР КАК Сумма
	        |ПОМЕСТИТЬ ВТ_ФОТФактРазгр
	        |ИЗ
	        |	ВТ_ФОТФактПоБДР КАК ФактФОТпоБДР
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ФактФОТпоЧасам.ПроектнаяЗадача,
	        |	ФактФОТпоЧасам.ФОТФактПоТабелю
	        |ИЗ
	        |	ВТ_ФОТФактПоТабелю КАК ФактФОТпоЧасам
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	ВТ_ФОТФактРазгр.ПроектнаяЗадача,
	        |	СУММА(ВТ_ФОТФактРазгр.Сумма) КАК ФОТФакт
	        |ПОМЕСТИТЬ ВТ_ФОТФакт
	        |ИЗ
	        |	ВТ_ФОТФактРазгр КАК ВТ_ФОТФактРазгр
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_ФОТФактРазгр.ПроектнаяЗадача";
        ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, "ФОТФакт", "ВТ_ФОТФакт", СтруктураКолонокИтогов);			
        
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ВыполнимостьФОТ") Тогда
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыполнимостьФОТ", "", , """""");
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ВыполнимостьФОТРасчетный") Тогда
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыполнимостьФОТРасчетный", "", , """""");
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ФОТРасчетный") Тогда
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ФОТРасчетный", "", СтруктураКолонокИтогов);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_Объемы(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
	Знач ТекстыЗамены, ДоступнаФинИнформация)
    
    Перем имяВТ, МассивПоказателей, СоответствиеДляЗамены, ТекстЗапроса;
    
	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПлан")
	    Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПлан") 	
		Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовый") 
		Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсия") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|	СУММА(Таблица.Сумма) КАК _Объемы_,
			|	СУММА(Таблица.Количество) КАК _ОбъемыКоличество_
			|ПОМЕСТИТЬ _ВТ_
			|ИЗ
			|	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(, Версия = &_Версия_) КАК Таблица
			|
			|СГРУППИРОВАТЬ ПО
			|	Таблица.ПроектнаяЗадача
			|";	
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПлан")
			Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПлан") Тогда
			
			имяВТ = "ВТ_ОбъемыПлан";
			
			СоответствиеДляЗамены = Новый Соответствие;
			СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
			СоответствиеДляЗамены.Вставить("_Объемы_", "ОбъемыПлан");
			СоответствиеДляЗамены.Вставить("_ОбъемыКоличество_", "ОбъемыКоличествоПлан");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			
			МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПлан") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПлан");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПлан") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПлан");
			КонецЕсли;
			ДобавитьПоказательВЗапрос(ТекстыЗамены,
			ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
			
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовый") 
			Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовый") Тогда
            
            имяВТ = "ВТ_ОбъемыПланБазовый";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
            СоответствиеДляЗамены.Вставить("_Объемы_", "ОбъемыПланБазовый");
            СоответствиеДляЗамены.Вставить("_ОбъемыКоличество_", "ОбъемыКоличествоПланБазовый");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланБазовый") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПланБазовый");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланБазовый") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПланБазовый");
			КонецЕсли;

            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсия") 
			Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсия") Тогда
            
            имяВТ = "ВТ_ОбъемыПланВерсия";
            
            СоответствиеДляЗамены = Новый Соответствие;
            СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
            СоответствиеДляЗамены.Вставить("_Объемы_", "ОбъемыПланВерсия");
            СоответствиеДляЗамены.Вставить("_ОбъемыКоличество_", "ОбъемыКоличествоПланВерсия");
            СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
            
            МассивПоказателей = Новый Массив;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыПланВерсия") И ДоступнаФинИнформация Тогда
            	МассивПоказателей.Добавить("ОбъемыПланВерсия");
			КонецЕсли;
			Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоПланВерсия") Тогда
            	МассивПоказателей.Добавить("ОбъемыКоличествоПланВерсия");
			КонецЕсли;
            ДобавитьПоказательВЗапрос(ТекстыЗамены, ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса),
				МассивПоказателей, имяВТ, СтруктураКолонокИтогов);
            
        КонецЕсли;
        
    КонецЕсли;			
    
	Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФакт") 
		Или СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоФакт") Тогда 
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	СУММА(Таблица.Сумма) КАК ОбъемыФакт,
		               |	СУММА(Таблица.Количество) КАК ОбъемыКоличествоФакт
		               |ПОМЕСТИТЬ ВТ_ОбъемыФакт
		               |ИЗ
		               |	РегистрСведений.упоФактВыполненияОбъемовПоДням КАК Таблица
		               |ГДЕ Таблица.Проект = &Проект
		               |СГРУППИРОВАТЬ ПО
		               |	Таблица.ПроектнаяЗадача";
        МассивПоказателей = Новый Массив;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыФакт") И ДоступнаФинИнформация Тогда
			МассивПоказателей.Добавить("ОбъемыФакт");
		КонецЕсли;
		Если СтруктураВыводимыхДопКолонок.Свойство("ОбъемыКоличествоФакт") Тогда
			МассивПоказателей.Добавить("ОбъемыКоличествоФакт");
		КонецЕсли;
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, МассивПоказателей, "ВТ_ОбъемыФакт", СтруктураКолонокИтогов);
        
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ВыполнимостьОбъемы") И ДоступнаФинИнформация Тогда
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыполнимостьОбъемы", "", , """""");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ПоступленияВыплаты(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
	Знач ТекстыЗамены)
	
	Перем имяВТ, СоответствиеДляЗамены, ТекстЗапроса;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПлан")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПлан")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПланБазовый")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПланБазовый")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПланВерсия")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПланВерсия") Тогда     
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|	СУММА(ВЫБОР
			|			КОГДА Таблица.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление)
			|				ТОГДА Таблица.Сумма
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК _Поступления_,
			|	СУММА(ВЫБОР
			|			КОГДА Таблица.НаправлениеДвижения = ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата)
			|				ТОГДА Таблица.Сумма
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК _Выплаты_
			|ПОМЕСТИТЬ _ВТ_
			|ИЗ
			|	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
			|			,
			|			Версия = &_Версия_) КАК Таблица
			|
			|СГРУППИРОВАТЬ ПО
			|	Таблица.ПроектнаяЗадача";
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПлан") 
			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПлан") Тогда
			
			имяВТ = "ВТ_ВыплатыПоступленияПлан";
			
			СоответствиеДляЗамены = Новый Соответствие;
			СоответствиеДляЗамены.Вставить("_Поступления_", "ПоступленияПлан"); 
			СоответствиеДляЗамены.Вставить("_Выплаты_", "ВыплатыПлан");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			СоответствиеДляЗамены.Вставить("_Версия_", "ТекВерсия");
			
			ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПлан") Тогда     
				ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ПоступленияПлан", имяВТ, СтруктураКолонокИтогов);
			КонецЕсли;		
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПлан") Тогда     				
				ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыплатыПлан", имяВТ, СтруктураКолонокИтогов);
			КонецЕсли;				
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПланБазовый") 
			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПланБазовый") Тогда
			
			имяВТ = "ВТ_ВыплатыПоступленияПланБазовый";
			
			СоответствиеДляЗамены = Новый Соответствие;
			СоответствиеДляЗамены.Вставить("_Поступления_", "ПоступленияПланБазовый"); 
			СоответствиеДляЗамены.Вставить("_Выплаты_", "ВыплатыПланБазовый");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			СоответствиеДляЗамены.Вставить("_Версия_", "БазоваяВерсия");
			
			ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПланБазовый") Тогда     
				ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ПоступленияПланБазовый", имяВТ, СтруктураКолонокИтогов);
			КонецЕсли;		
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПланБазовый") Тогда     				
				ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыплатыПланБазовый", имяВТ, СтруктураКолонокИтогов);
			КонецЕсли;				
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПланВерсия") 
			ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПланВерсия") Тогда
			
			имяВТ = "ВТ_ВыплатыПоступленияПланВерсия";
			
			СоответствиеДляЗамены = Новый Соответствие;
			СоответствиеДляЗамены.Вставить("_Поступления_", "ПоступленияПланВерсия"); 
			СоответствиеДляЗамены.Вставить("_Выплаты_", "ВыплатыПланВерсия");
			СоответствиеДляЗамены.Вставить("_ВТ_", имяВТ);
			СоответствиеДляЗамены.Вставить("_Версия_", "выбВерсия");
			
			ДобавитьПоказательВЗапрос(ТекстыЗамены,
				ВыполнитьПодменуВТекстеЗапроса(СоответствиеДляЗамены, ТекстЗапроса), , имяВТ);
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияПланВерсия") Тогда     
				ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ПоступленияПланВерсия", имяВТ, СтруктураКолонокИтогов);
			КонецЕсли;		
			
			Если СтруктураВыводимыхДопКолонок.Свойство("ВыплатыПланВерсия") Тогда     				
				ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыплатыПланВерсия", имяВТ, СтруктураКолонокИтогов);
			КонецЕсли;				
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияФакт")
		ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ВыплатыФакт") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(Таблица.НаправлениеДвижения, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление)
			|				ТОГДА Таблица.Сумма
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК ПоступленияФакт,
			|	СУММА(ВЫБОР
			|			КОГДА ЕСТЬNULL(Таблица.НаправлениеДвижения, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата)
			|				ТОГДА Таблица.Сумма
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК ВыплатыФакт
			|ПОМЕСТИТЬ ВТ_ВыплатыПоступленияФакт
			|ИЗ
			|	РегистрСведений.упоФактДвиженийДенежныхСредств КАК Таблица
			|ГДЕ Таблица.ПроектнаяЗадача.Проект = &Проект
			|СГРУППИРОВАТЬ ПО
			|	Таблица.ПроектнаяЗадача";
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, , "ВТ_ВыплатыПоступленияФакт");
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ПоступленияФакт") Тогда     
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ПоступленияФакт", "ВТ_ВыплатыПоступленияФакт",
				СтруктураКолонокИтогов);
		КонецЕсли;
		
		Если СтруктураВыводимыхДопКолонок.Свойство("ВыплатыФакт") Тогда     			
			ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыплатыФакт", "ВТ_ВыплатыПоступленияФакт",
				СтруктураКолонокИтогов);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("ВыполнимостьПоступления") Тогда
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "ВыполнимостьПоступления", "", , """""");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПоказателиВЗапрос_ДоходРасход(Знач СтруктураВыводимыхДопКолонок, Знач СтруктураКолонокИтогов,
	Знач ТекстыЗамены)
    
    Перем имяВТ, СоответствиеДляЗамены, ТекстЗапроса;
	
	Если СтруктураВыводимыхДопКолонок.Свойство("СуммаСанкций") ИЛИ СтруктураВыводимыхДопКолонок.Свойство("КоличествоДнейПросрочки") Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ДогупоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача,
		               |	ДогупоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан КАК ДатаЗавершенияПоДоговору,
		               |	ТекупоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан КАК ДатаЗавершенияПоТекПлан,
		               |	ТекупоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проект,
		               |	ВЫБОР
		               |		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
		               |			ТОГДА упоКалендариПроектовСрезПоследних.КалендарьПроекта
		               |		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи
		               |	КОНЕЦ КАК КалендарьПроекта,
		               |	упоСвойстваПроектныхЗадачСрезПоследних.СуммаСанкцийЗаДеньЗадержки
		               |ПОМЕСТИТЬ СрокиПросрочки
		               |ИЗ
		               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК ТекупоСрокиПроектныхЗадачСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &ДоговорнаяВерсия) КАК ДогупоСрокиПроектныхЗадачСрезПоследних
		               |		ПО ТекупоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача = ДогупоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоКалендариПроектов.СрезПоследних КАК упоКалендариПроектовСрезПоследних
		               |		ПО ТекупоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проект = упоКалендариПроектовСрезПоследних.Проект
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
		               |		ПО ТекупоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		               |ГДЕ
		               |	ДогупоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан < ТекупоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	СрокиПросрочки.ПроектнаяЗадача,
		               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ упоРабочиеКалендариСрезПоследних.День) КАК КоличествоДнейПросрочки,
		               |	МАКСИМУМ(СрокиПросрочки.СуммаСанкцийЗаДеньЗадержки) * КОЛИЧЕСТВО(РАЗЛИЧНЫЕ упоРабочиеКалендариСрезПоследних.День) КАК СуммаСанкций
		               |ПОМЕСТИТЬ ВТ_СуммаСанкций
		               |ИЗ
		               |	СрокиПросрочки КАК СрокиПросрочки
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоРабочиеКалендари.СрезПоследних КАК упоРабочиеКалендариСрезПоследних
		               |		ПО СрокиПросрочки.КалендарьПроекта = упоРабочиеКалендариСрезПоследних.Календарь
		               |ГДЕ
		               |	упоРабочиеКалендариСрезПоследних.День <= СрокиПросрочки.ДатаЗавершенияПоТекПлан
		               |	И упоРабочиеКалендариСрезПоследних.День > СрокиПросрочки.ДатаЗавершенияПоДоговору
		               |	И упоРабочиеКалендариСрезПоследних.КоличествоЧасов <> 0
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	СрокиПросрочки.ПроектнаяЗадача";
					   
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, ТекстЗапроса, , "ВТ_СуммаСанкций");
		    
		Если СтруктураВыводимыхДопКолонок.Свойство("СуммаСанкций") Тогда     
		      ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "СуммаСанкций", "ВТ_СуммаСанкций", СтруктураКолонокИтогов);
		КонецЕсли;	
		
		ДобавитьПоказательВЗапрос(ТекстыЗамены, "", "КоличествоДнейПросрочки", "ВТ_СуммаСанкций");
			
	КонецЕсли;
	
    Если СтруктураВыводимыхДопКолонок.Свойство("ДоходПлан") 
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("РасходПлан") 
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДоходПланБазовый")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("РасходПланБазовый") 
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("ДоходПланВерсия")
        ИЛИ СтруктураВыводимыхДопКолонок.Свойство("РасходПланВерсия") Тогда
        		
		ТекстЗапроса = 
	        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	упоАктуальныеПланыДоходовИРасходовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	        |	СУММА(ВЫБОР
	        |			КОГДА ЕСТЬNULL(упоАктуальныеПланыДоходовИРасходовСрезПоследних.ВидЭлемента, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход)
	        |				ТОГДА упоАктуальныеПланыДоходовИРасходовСрезПоследних.Сумма
	        |			ИНАЧЕ 0
	        |		КОНЕЦ) КАК _Доход_,
	        |	СУММА(ВЫБОР
	        |			КОГДА ЕСТЬNULL(упоАктуальныеПланыДоходовИРасходовСрезПоследних.ВидЭлемента, ЛОЖЬ) = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
	        |				ТОГДА упоАктуальныеПланыДоходовИРасходовСрезПоследних.Сумма
