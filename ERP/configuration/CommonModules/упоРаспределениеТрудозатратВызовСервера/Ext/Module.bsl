Функция ТаблицаСтоимостиТрудозатратПоДнямСУчетомПериодаНормСтоимости(ПроектнаяЗадача, УровеньПланированияТрудозатрат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|   ПланТрудозатратПоДнямТекущаяВерсия.Ресурс КАК Роль,
		|   ПланТрудозатратПоДнямТекущаяВерсия.Подразделение КАК Подразделение,
		|   ПланТрудозатратПоДнямТекущаяВерсия.День КАК Период,
		|   ПланТрудозатратПоДнямТекущаяВерсия.Стоимость КАК Стоимость
		|ИЗ
		|   РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК ПланТрудозатратПоДнямТекущаяВерсия
		|ГДЕ
		|   ПланТрудозатратПоДнямТекущаяВерсия.Операция = &ПроектнаяЗадача
		|   И ТИПЗНАЧЕНИЯ(ПланТрудозатратПоДнямТекущаяВерсия.Ресурс) = ТИП(Справочник.упоРоли)
		|   И ПланТрудозатратПоДнямТекущаяВерсия.УровеньПланирования = &УровеньПланирования";
	
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("УровеньПланирования", УровеньПланированияТрудозатрат);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ЗаполнитьПланРасходовТрудовымиРесурсами(ТаблицаПланРасходов,
		ТаблицаРаспределениеПоСтатьям,
		ТаблицаТрудозатратПоДням,
		ЗначенияПоУмолчанию)
	
	ВалютаУпрУчета = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	
	СтатьиБезЗаполненногоСпособаПривязки = Новый Соответствие;
	
	Для Каждого СтрокаРаспределенияПоСтатьям Из ТаблицаРаспределениеПоСтатьям Цикл
		НоваяСтрока = ТаблицаПланРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределенияПоСтатьям);
		НоваяСтрока.Валюта = ВалютаУпрУчета;
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.СпособПривязки) Тогда
			НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
			НоваяСтрока.ПрофильРаспределения = ЗначенияПоУмолчанию.ПрофильРасходовПоУмолчанию;
			Если СтатьиБезЗаполненногоСпособаПривязки.Получить(СтрокаРаспределенияПоСтатьям.Роль) = Неопределено Тогда
				СтатьиБезЗаполненногоСпособаПривязки.Вставить(СтрокаРаспределенияПоСтатьям.Роль, НоваяСтрока.Статья);
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаРаспределенияПоСтатьям.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно Тогда
			НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.НаДату;
			НоваяСтрока.ДатаПривязки = СтрокаРаспределенияПоСтатьям.Период;
			НоваяСтрока.ПериодАгрегации = Перечисления.упоПериодыАгрегацииЗатрат.ПустаяСсылка();
		КонецЕсли;
	КонецЦикла;
	
	СообщитьОбОтсутствииСпособаПривязкиВСтатье(СтатьиБезЗаполненногоСпособаПривязки);
	
КонецПроцедуры

Процедура ЗаполнитьПланРасходовТрудовымиРесурсамиПоПериодамСводно(ДатыПроектнойЗадачи,
	ТаблицаРаспределеняПоСтатьям, ТаблицаПланРасходов, СтатьиБезЗаполненногоСпособаПривязки)
	
	ВалютаУпрУчета = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	
	СвернутьТаблицуПоПериодуАгрегацииДляЗаполненияПланаРасходов(ТаблицаРаспределеняПоСтатьям,
		ДатыПроектнойЗадачи.ДатаЗавершенияПлан);
	
	Для Каждого СтрокаРаспределения Из ТаблицаРаспределеняПоСтатьям Цикл
		НоваяСтрока = ТаблицаПланРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределения);
		НоваяСтрока.Валюта = ВалютаУпрУчета;
		НоваяСтрока.Сумма = СтрокаРаспределения.Сумма;
		
		НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.НаДату;
		НоваяСтрока.ДатаПривязки = СтрокаРаспределения.Период;
		НоваяСтрока.ПериодАгрегации = Перечисления.упоПериодыАгрегацииЗатрат.ПустаяСсылка();
	КонецЦикла;
	
КонецПроцедуры

Процедура СвернутьТаблицуПоПериодуАгрегацииДляЗаполненияПланаРасходов(ТаблицаРаспределениеПоСтатьям,
		ДатаЗавершенияПроектнойЗадачиПлан)
	
	ДатаЗавершенияПроектнойЗадачиПлан = НачалоДня(ДатаЗавершенияПроектнойЗадачиПлан);
	
	ПараметрыОтбора = Новый Структура("СпособПривязки", Перечисления.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно);
	СтрокиСПравиломПоПериодамСводно = ТаблицаРаспределениеПоСтатьям.НайтиСтроки(ПараметрыОтбора);
	Если СтрокиСПравиломПоПериодамСводно.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого НайденнаяСтрока Из СтрокиСПравиломПоПериодамСводно Цикл
		Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.Период) Тогда
			Продолжить;
		КонецЕсли;
		АгрегированныйПериод = НачалоДня(КонецПериодаАгрегации(НайденнаяСтрока.Период, НайденнаяСтрока.ПериодАгрегации));
		НайденнаяСтрока.Период = Мин(АгрегированныйПериод, ДатаЗавершенияПроектнойЗадачиПлан);
	КонецЦикла;
	
	ГруппыКолонок = КолонкиДляСверткиТаблицыТрудозатратДляЗаполненияПланаРасходов();
	СтрокаКолонокДляГруппировки = ГруппыКолонок.КолонкиГруппировок;
	СтрокаКолонокДляСуммирования = ГруппыКолонок.КолонкиСуммирования;
	
	ТаблицаРаспределениеПоСтатьям.Свернуть(СтрокаКолонокДляГруппировки, СтрокаКолонокДляСуммирования);
	
КонецПроцедуры

Функция КолонкиДляСверткиТаблицыТрудозатратДляЗаполненияПланаРасходов()
	
	ГруппыКолонок = Новый Структура;
	
	КолонкиГруппировки = Новый Массив;
	КолонкиГруппировки.Добавить("Роль");
	КолонкиГруппировки.Добавить("Подразделение");
	КолонкиГруппировки.Добавить("Статья");
	КолонкиГруппировки.Добавить("СпособПривязки");
	КолонкиГруппировки.Добавить("ПрофильРаспределения");
	КолонкиГруппировки.Добавить("ПериодАгрегации");
	КолонкиГруппировки.Добавить("Период");
	КолонкиГруппировки.Добавить("Контрагент");
	КолонкиГруппировки.Добавить("Договор");
	СтрокаКолонокДляГруппировки = СтрСоединить(КолонкиГруппировки, ",");
	ГруппыКолонок.Вставить("КолонкиГруппировок", СтрокаКолонокДляГруппировки);
	
	КолонкиДляСуммирования = Новый Массив;
	КолонкиДляСуммирования.Добавить("Сумма");
	СтрокаКолонокДляСуммирования = СтрСоединить(КолонкиДляСуммирования, ",");
	ГруппыКолонок.Вставить("КолонкиСуммирования", СтрокаКолонокДляСуммирования);
	
	Возврат ГруппыКолонок;
	
КонецФункции

Процедура СвернутьТрудовыеРесурсыТЧ(ТрудовыеРесурсыТЧ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЧ", ТрудовыеРесурсыТЧ);
	
	Если ТрудовыеРесурсыТЧ.Колонки.Найти("Версия") = Неопределено Тогда
		Запрос.Текст = ТекстЗапросаСворачиванияТрудовыхРесурсовИзПроектнойЗадачи(); 
	Иначе
		Запрос.Текст = ТекстЗапросаСворачиванияТрудовыхРесурсовИзСтруктуры();
	КонецЕсли;	
	
	ТрудовыеРесурсыТЧ = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Функция ТекстЗапросаСворачиванияТрудовыхРесурсовИзСтруктуры()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТЧ.Ресурс КАК Ресурс,
	               |	ТЧ.Количество КАК Количество,
	               |	ТЧ.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	ТЧ.Стоимость КАК Стоимость,
	               |	ТЧ.ОбщСтоимость КАК ОбщСтоимость,
	               |	ТЧ.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ТЧ.Подразделение КАК Подразделение,
	               |	ТЧ.ВнешняяСтоимость КАК ВнешняяСтоимость,
	               |	ТЧ.ОбщВнешняяСтоимость КАК ОбщВнешняяСтоимость,
	               |	ТЧ.СпособПривязки КАК СпособПривязки,
	               |	ТЧ.ИндексСтрокРаспределенияПоПериодам КАК ИндексСтрокРаспределенияПоПериодам,
	               |	ТЧ.УровеньПланирования КАК УровеньПланирования,
	               |	ТЧ.Версия КАК Версия,
	               |	ТЧ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТЧ.ИсточникПлана КАК ИсточникПлана
	               |ПОМЕСТИТЬ ТЧ
	               |ИЗ
	               |	&ТЧ КАК ТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧ.Ресурс КАК Ресурс,
	               |	СУММА(ТЧ.Количество) КАК Количество,
	               |	ТЧ.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	МАКСИМУМ(ТЧ.Стоимость) КАК Стоимость,
	               |	СУММА(ТЧ.ОбщСтоимость) КАК ОбщСтоимость,
	               |	ТЧ.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ТЧ.Подразделение КАК Подразделение,
	               |	МАКСИМУМ(ТЧ.ВнешняяСтоимость) КАК ВнешняяСтоимость,
	               |	СУММА(ТЧ.ОбщВнешняяСтоимость) КАК ОбщВнешняяСтоимость,
	               |	ТЧ.СпособПривязки КАК СпособПривязки,
	               |	МИНИМУМ(ТЧ.ИндексСтрокРаспределенияПоПериодам) КАК ИндексСтрокРаспределенияПоПериодам,
	               |	ТЧ.УровеньПланирования КАК УровеньПланирования,
	               |	ТЧ.Версия КАК Версия,
	               |	ТЧ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТЧ.ИсточникПлана КАК ИсточникПлана
	               |ИЗ
	               |	ТЧ КАК ТЧ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТЧ.Ресурс,
	               |	ТЧ.ЕдиницаНормирования,
	               |	ТЧ.ПрофильРаспределения,
	               |	ТЧ.Подразделение,
	               |	ТЧ.СпособПривязки,
	               |	ТЧ.УровеньПланирования,
	               |	ТЧ.Версия,
	               |	ТЧ.ПроектнаяЗадача,
	               |	ТЧ.ИсточникПлана";
	
	Возврат ТекстЗапроса;
	
КонецФункции 

Функция ТекстЗапросаСворачиванияТрудовыхРесурсовИзПроектнойЗадачи()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТЧ.Ресурс КАК Ресурс,
	               |	ТЧ.Количество КАК Количество,
	               |	ТЧ.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	ТЧ.Стоимость КАК Стоимость,
	               |	ТЧ.ОбщСтоимость КАК ОбщСтоимость,
	               |	ТЧ.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ТЧ.Подразделение КАК Подразделение,
	               |	ТЧ.ВнешняяСтоимость КАК ВнешняяСтоимость,
	               |	ТЧ.ОбщВнешняяСтоимость КАК ОбщВнешняяСтоимость,
	               |	ТЧ.СпособПривязки КАК СпособПривязки,
	               |	ТЧ.ИндексСтрокРаспределенияПоПериодам КАК ИндексСтрокРаспределенияПоПериодам,
	               |	ТЧ.УровеньПланирования КАК УровеньПланирования,
	               |	ТЧ.ИсточникПлана КАК ИсточникПлана
	               |ПОМЕСТИТЬ ТЧ
	               |ИЗ
	               |	&ТЧ КАК ТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТЧ.Ресурс КАК Ресурс,
	               |	СУММА(ТЧ.Количество) КАК Количество,
	               |	ТЧ.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	МАКСИМУМ(ТЧ.Стоимость) КАК Стоимость,
	               |	СУММА(ТЧ.ОбщСтоимость) КАК ОбщСтоимость,
	               |	ТЧ.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ТЧ.Подразделение КАК Подразделение,
	               |	МАКСИМУМ(ТЧ.ВнешняяСтоимость) КАК ВнешняяСтоимость,
	               |	СУММА(ТЧ.ОбщВнешняяСтоимость) КАК ОбщВнешняяСтоимость,
	               |	ТЧ.СпособПривязки КАК СпособПривязки,
