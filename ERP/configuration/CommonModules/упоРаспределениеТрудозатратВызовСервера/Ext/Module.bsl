			НСтр("ru = 'Ошибка чтения признака использования распределения трудозатрат по дням. Обратитесь к администратору.'");
	КонецПопытки;
	
	Возврат Не Результат.Пустой();
	
КонецФункции

Функция ПараметрыДопФункциональности()
	
	ПараметрыДопФункциональности = Новый Структура;
