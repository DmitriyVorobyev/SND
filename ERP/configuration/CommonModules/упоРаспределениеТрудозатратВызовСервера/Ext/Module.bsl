	Возврат Запрос;
	
КонецФункции

// Добавляет текст запроса по поручениям и устанавливает необходимые параметры.
//
// Параметры:
//	Запрос	- Запрос.
//	Отказ	- Булево - признак отказа.
Процедура ДополнитьЗапросПроектныеЗадачиИПоручения(Запрос, СтруктураПараметров, Отказ)
	
	ВариантРаспределения = Константы.упоВариантРаспределенияРабочегоВремени.Получить();
	
	ПравилоЗаполнения = Константы.упоПравилоРаспределенияРабочегоВремениНаЗаданияИПроектныеЗадачи.Получить();
	Если ПравилоЗаполнения = Перечисления.упоПравилаРаспределенияРабочегоВремениНаЗаданияИПроектныеЗадачи.НеРаспределятьНаЗадачиПоКоторымЕстьЗадания Тогда
		ИсключитьЗадачиСЗаданиями = Истина;
	Иначе
		ИсключитьЗадачиСЗаданиями = Ложь;
	КонецЕсли;
	
	Если ВариантРаспределения = Перечисления.упоВариантыРаспределенияРабочегоВремени.ПоЗаданиямИПроектнымЗадачам Тогда
		
		ДобавитьВЗапросВременнуюТаблицуПоручения(Запрос, СтруктураПараметров);
		ДополнитьТекстЗапросаПоручения(Запрос.Текст, Истина);
		Запрос.Текст = Запрос.Текст + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|";
		ДополнитьТекстЗапросаПроектныеЗадачи(Запрос.Текст, Ложь, ИсключитьЗадачиСЗаданиями);
		
	ИначеЕсли ВариантРаспределения = Перечисления.упоВариантыРаспределенияРабочегоВремени.ТолькоПоЗаданиям Тогда
		ДобавитьВЗапросВременнуюТаблицуПоручения(Запрос, СтруктураПараметров);
		ДополнитьТекстЗапросаПоручения(Запрос.Текст, Истина);
		
	ИначеЕсли ВариантРаспределения = Перечисления.упоВариантыРаспределенияРабочегоВремени.ТолькоПоПроектнымЗадачам Тогда
		ДополнитьТекстЗапросаПроектныеЗадачи(Запрос.Текст, Истина);
		
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru = 'Не задано значение константы ""Вариант распределения рабочего времени""!'");
		Сообщение.Сообщить();
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Отражение

Процедура лОтразитьПлановыеТрудозатратыЗадачи(Предмет,
									   		НезаписанныеСрокиЗадач = Неопределено,
											НезаписанныеДанныеЗадач = Неопределено,
											ДвиженияДокумента = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//
	
	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Если Не ЗначениеЗаполнено(Предмет) Тогда
			Возврат;
		КонецЕсли;
		МассивЗадач = Новый Массив;
		МассивЗадач.Добавить(Предмет);
	ИначеЕсли ТипЗнч(Предмет) = Тип("Массив") Тогда
		МассивЗадач = Предмет;
	Иначе
		ВызватьИсключение НСтр("ru = 'Некорректный тип задачи для отражения плановых трудозатрат.'");
	КонецЕсли;
	
	//
	
	МассивНаборовЗаписей = Новый Массив;
	СоответствиеДанныхПроектов = Новый Соответствие;
	ЕстьУчетПериодаРегистрацииНормСтоимости = Ложь;
	ПроектыСНастройкойУчетПериодаРегистрации = Новый Массив;
	
	//
	
	НаборЗаписей_упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия 
		= РегистрыСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.СоздатьНаборЗаписей();
	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям_Пустая 
		= НаборЗаписей_упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Выгрузить();
	
	//
	
	Если НезаписанныеДанныеЗадач = Неопределено Тогда
		СтруктураНеобходимыхДанных = 
			Новый Структура("ДанныеЗадачи, ТрудовыеРесурсыТЧ, ТрудовыеРесурсыПоПериодам, ПланРасходовТЧ");
		ТаблицаДанных = 
			упоПроектыИЗадачиВызовСервера.обПолучитьДанныеПроектнойЗадачи(МассивЗадач, СтруктураНеобходимыхДанных);
		КоллекцияДанныхЗадач = ТаблицаДанных;
	Иначе
		КоллекцияДанныхЗадач = МассивЗадач;
	КонецЕсли;
	
	СоответствиеСтруктурНастроекПроектов = Новый Соответствие;
	МассивЗадачДляРасчетаНормыПоПериодам = Новый Массив;
	МассивЗадачДляРасчетаНормыСрезПоследних = Новый Массив;
	НезаписанныеТрудовыеРесурсы = Новый Массив;
	Для Каждого ТекЗадача Из КоллекцияДанныхЗадач Цикл
		
		Если НезаписанныеДанныеЗадач = Неопределено Тогда
			
			ПроектЗадачи = ТекЗадача.ДанныеЗадачи.Проект;
			ПроектнаяЗадача = ТекЗадача.ДанныеЗадачи.Ссылка;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
				НезаписанныеТрудовыеРесурсы, 
				ТекЗадача.ДанныеЗадачи.ТрудовыеРесурсыТЧ.ВыгрузитьКолонку("Ресурс"), 
				Истина);
				
		Иначе
				
			ДанныеЗадачи = НезаписанныеДанныеЗадач.Получить(ТекЗадача);
			ПроектЗадачи = ДанныеЗадачи.Проект;
			ПроектнаяЗадача = ТекЗадача;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
				НезаписанныеТрудовыеРесурсы, 
				ДанныеЗадачи.ТрудовыеРесурсы.ВыгрузитьКолонку("Ресурс"),
				Истина);
				
		КонецЕсли;
			
		СтруктураНастроекПроекта = СоответствиеСтруктурНастроекПроектов.Получить(ПроектЗадачи);
		Если СтруктураНастроекПроекта = Неопределено Тогда
			СтруктураНастроекПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ПроектЗадачи);
			СоответствиеСтруктурНастроекПроектов.Вставить(ПроектЗадачи, СтруктураНастроекПроекта);
			Если СтруктураНастроекПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
				ЕстьУчетПериодаРегистрацииНормСтоимости = Истина;
				ПроектыСНастройкойУчетПериодаРегистрации.Добавить(ПроектЗадачи);
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураНастроекПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
			МассивЗадачДляРасчетаНормыПоПериодам.Добавить(ПроектнаяЗадача);
		Иначе
			МассивЗадачДляРасчетаНормыСрезПоследних.Добавить(ПроектнаяЗадача);
		КонецЕсли;
				
	КонецЦикла;
	
	Результат = ТаблицыСтоимости(МассивЗадачДляРасчетаНормыСрезПоследних, 
		МассивЗадачДляРасчетаНормыПоПериодам, 
		НезаписанныеТрудовыеРесурсы);
	ТаблицаСтоимостиПоНорме 			= Результат.ТаблицаСтоимостиПоНорме;
	ТаблицаСтоимостиПоНормеПоПериодам 	= Результат.ТаблицаСтоимостиПоНормеПоПериодам;

	ДанныеЗаполнения = Новый Структура("Период, ВидОбъема, ВидЭлемента, ИсточникПлана", 
		  ТекущаяДатаСеанса(), 
		  Перечисления.упоВидЭлементаОбъемов.Расход, 
		  Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход,
		  Перечисления.упоИсточникПланаДоходовИРасходов.Трудозатраты);
	упоДанныеПлановТрудозатратРолейИтоговая = Неопределено;
	
	// Кешируем шаблоны таблиц и вспомогательные данные.
	ДанныеШаблоновТрансляции = Новый Структура;
	ДанныеШаблоновТрансляции.Вставить("Тип_ВидЭлементаПланаДоходовИРасходов", 
		Новый ОписаниеТипов("ПеречислениеСсылка.упоВидЭлементаПланаДоходовИРасходов"));
	ДанныеШаблоновТрансляции.Вставить("ШаблоныАктуализацииДДССформированы", Ложь);
	ДанныеШаблоновТрансляции.Вставить("ШаблонПланаДДС");
	ДанныеШаблоновТрансляции.Вставить("ШаблонАктуальныеПланыДДС");
	ДанныеШаблоновТрансляции.Вставить("ШаблонТаблицыРасходов");
	
	ПараметрыДопФункциональности = ПараметрыДопФункциональности();
	
	// Основной цикл обработки.
	
	Для Каждого ТекЗадача Из КоллекцияДанныхЗадач Цикл
		
		Если НезаписанныеДанныеЗадач = Неопределено Тогда;
			
			ДанныеЗадачи = ТекЗадача.ДанныеЗадачи;
			
			ПроектнаяЗадача = ДанныеЗадачи.Ссылка;
			ДатаНач = ДанныеЗадачи.Сроки.НачалоПлан;
			ДатаКон = ДанныеЗадачи.Сроки.ЗавершениеПлан;
			
			ТрудовыеРесурсыТЧ = ДанныеЗадачи.ТрудовыеРесурсыТЧ.Скопировать();
			
		Иначе
			
			ДанныеЗадачи = НезаписанныеДанныеЗадач.Получить(ТекЗадача);
			
			ПроектнаяЗадача = ТекЗадача;
			ДатаНач = ДанныеЗадачи.ДатаНачалаПлан;
			ДатаКон = ДанныеЗадачи.ДатаЗавершенияПлан;
			
			ТрудовыеРесурсыТЧ = ДанныеЗадачи.ТрудовыеРесурсы.Скопировать()
			
		КонецЕсли;
		
		ПроектЗадачи 							= ДанныеЗадачи.Проект;
		КалендарьЗадачи 						= ДанныеЗадачи.КалендарьЗадачи;
		ВидОперации 							= ДанныеЗадачи.ВидОперации;
		ТрудовыеРесурсыПоПериодам 				= ДанныеЗадачи.ТрудовыеРесурсыПоПериодам;
		ПланироватьТрудозатратыНаИсполнителей 	= ДанныеЗадачи.ПланироватьТрудозатратыНаИсполнителей;
		НормаСтоимостиТрудовыхРесурсов 			= ДанныеЗадачи.НормаСтоимостиТрудовыхРесурсов;
		ВнешняяНормаСтоимостиТрудовыхРесурсов 	= ДанныеЗадачи.ВнешняяНормаСтоимостиТрудовыхРесурсов;
		ВключитьПланРасходовВБДДС 				= ДанныеЗадачи.ВключитьПланРасходовВБДДС;
		ВключитьТрудРесурсыВПланРасходов 		= ДанныеЗадачи.ВключитьТрудРесурсыВПланРасходов;
		ТекущаяВерсияПроекта 					= ДанныеЗадачи.ТекущаяВерсияПроекта;
		УровеньПланированияТрудозатратДляБДР 	= ДанныеЗадачи.УровеньПланированияТрудозатратДляБДР;
		
		//
		
		Если НезаписанныеСрокиЗадач <> Неопределено Тогда
			СрокиЗадачи = НезаписанныеСрокиЗадач[ПроектнаяЗадача];
			Если СрокиЗадачи <> Неопределено Тогда
				ДатаНач = СрокиЗадачи.Результат.ДатаНачала;
				ДатаКон = СрокиЗадачи.Результат.ДатаЗавершения;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДатаНач) Или 
			Не ЗначениеЗаполнено(ДатаКон) Тогда
			Продолжить; // Продолжить
		КонецЕсли;
		
		//
		
		ДанныеПроекта = СоответствиеДанныхПроектов.Получить(ПроектЗадачи);
		Если ДанныеПроекта = Неопределено Тогда
			ДанныеПроекта = Новый Структура;
			ДанныеПроекта.Вставить("Календарь", упоПроектыИЗадачиСервер.ПолучитьКалендарьПроекта(ПроектЗадачи));
			СоответствиеДанныхПроектов.Вставить(ПроектЗадачи, ДанныеПроекта);
		КонецЕсли;
		
		СвойстваЗадачи = Новый Структура;
		СвойстваЗадачи.Вставить("ПроектнаяЗадача", 							ПроектнаяЗадача);
		СвойстваЗадачи.Вставить("ТекущаяВерсия",							ТекущаяВерсияПроекта);
		СвойстваЗадачи.Вставить("ДатаНач", 									ДатаНач);
		СвойстваЗадачи.Вставить("ДатаКон", 									ДатаКон);
		СвойстваЗадачи.Вставить("ВключитьТрудРесурсыВПланРасходов", 		ВключитьТрудРесурсыВПланРасходов);
		СвойстваЗадачи.Вставить("ВключитьПланРасходовВБДДС", 				ВключитьПланРасходовВБДДС);
		СвойстваЗадачи.Вставить("ПланироватьТрудозатратыНаИсполнителей", 	ПланироватьТрудозатратыНаИсполнителей);
		СвойстваЗадачи.Вставить("НормаСтоимостиТрудовыхРесурсов", 			НормаСтоимостиТрудовыхРесурсов);
		СвойстваЗадачи.Вставить("ВнешняяНормаСтоимостиТрудовыхРесурсов", 	ВнешняяНормаСтоимостиТрудовыхРесурсов);
		СвойстваЗадачи.Вставить("Проект", 									ПроектЗадачи);
		Если ЗначениеЗаполнено(КалендарьЗадачи) Тогда
			СвойстваЗадачи.Вставить("Календарь", КалендарьЗадачи);
		Иначе
			СвойстваЗадачи.Вставить("Календарь", ДанныеПроекта.Календарь);
		КонецЕсли;
		
		ТрудовыеРесурсыТЧИсходная = ТрудовыеРесурсыТЧ.Скопировать();
				
		// Когда в трудовых ресурсах появится колонка ПП - сворачивание можно будет убрать
		СвернутьТрудовыеРесурсыТЧ(ТрудовыеРесурсыТЧ);
		
		ИндексыБылоСтало = ИндексыСтрокРаспределенияПоПериодамДоИПослеСворачивания(ТрудовыеРесурсыТЧИсходная, 
			ТрудовыеРесурсыТЧ);

		ТрудозатратыПоДням = ПолучитьТрудозатратыПоДням(СвойстваЗадачи,
				ТрудовыеРесурсыТЧ,
				ТрудовыеРесурсыПоПериодам,
				ПараметрыДопФункциональности,
				ИндексыБылоСтало);
			
		Если ТрудозатратыПоДням = Неопределено Тогда 
			Продолжить; // Продолжить
		КонецЕсли;
		
		//
		
		Если ВключитьТрудРесурсыВПланРасходов Тогда
			
			ДанныеЗаполнения.Вставить("Версия", ТекущаяВерсияПроекта);
			ДанныеЗаполнения.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
			
			ПроверитьСформироватьШаблоныТрансляции(ДанныеШаблоновТрансляции);
			СводнаяТаблицаПланРасходов = ДанныеШаблоновТрансляции.ШаблонТаблицыРасходов.СкопироватьКолонки();
			
			СтартовыйИндекс =
				упоАналитикаПоПодразделениямКлиентСервер.
				ПолучитьИндексСтрокРаспределенияНовойСтроки(ДанныеЗадачи.ПланРасходов);
			
			ОтразитьТрудовыеРесурсыВПланеРасходов(ПроектЗадачи,
				ТрудовыеРесурсыТЧ,
				СводнаяТаблицаПланРасходов,
				УровеньПланированияТрудозатратДляБДР,
				СтартовыйИндекс);
			
			ПоляОтбора = Новый Массив;
			ПоляОтбора.Добавить("Ресурс");
			ПоляОтбора.Добавить("Подразделение");
			ПоляОтбора.Добавить("УровеньПланирования");
			
			СводнаяТаблицаПланРасходов.Индексы.Добавить(СтрСоединить(ПоляОтбора, ","));
			
			ОтборРесурсПодразделение = Новый Структура;
			Для Каждого ПолеОтбора Из ПоляОтбора Цикл
				ОтборРесурсПодразделение.Вставить(ПолеОтбора);
			КонецЦикла;
			
			ДетальнаяТаблицаПланРасходов = СводнаяТаблицаПланРасходов.СкопироватьКолонки();
			
		КонецЕсли;
		
		//
		
		упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям = 
			упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям_Пустая.Скопировать();
			
		СтруктураНастроекПроекта = СоответствиеСтруктурНастроекПроектов.Получить(ПроектЗадачи);
					  
		ПараметрыРаспределения = Новый Структура("ДатаНачала, ДатаЗавершения, естьВалютнаясумма", ДатаНач, ДатаКон, Ложь); 
		
		Для каждого СтрокаРесурс Из ТрудозатратыПоДням.Строки Цикл	
			
			Если ТипЗнч(СтрокаРесурс.Ресурс) = Тип("СправочникСсылка.упоТрудовыеРесурсы") Тогда
				
				Если Не СтруктураНастроекПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда 
					
					СтрокаНормы = Неопределено;
					
					СтоимостьЧаса = ПолучитьСтоимостьЧасаРесурса(ТаблицаСтоимостиПоНорме, 
						СтрокаРесурс, НормаСтоимостиТрудовыхРесурсов, СтрокаНормы, Ложь);

					СтоимостьЧасаВнешняя = ПолучитьСтоимостьЧасаРесурса(ТаблицаСтоимостиПоНорме, 
						СтрокаРесурс, ВнешняяНормаСтоимостиТрудовыхРесурсов, СтрокаНормы, Ложь) ;
																							
				КонецЕсли;
				
			КонецЕсли;	
			
			Если СтруктураНастроекПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
				
				СтрокиНорм = Неопределено;
				СтрокиВнешнихНорм = Неопределено;
				
				СтоимостьЧаса = ПолучитьСтоимостьЧасаРесурса(ТаблицаСтоимостиПоНормеПоПериодам, 
						СтрокаРесурс, НормаСтоимостиТрудовыхРесурсов, СтрокиНорм, Истина);

				СтоимостьЧасаВнешняя = ПолучитьСтоимостьЧасаРесурса(ТаблицаСтоимостиПоНормеПоПериодам, 
						СтрокаРесурс, ВнешняяНормаСтоимостиТрудовыхРесурсов, СтрокиВнешнихНорм, Истина);
				
				ДатаИзмененияНормы = Дата(1, 1, 1);	

				ДатаИзмененияВнешнийНормы = Дата(1, 1, 1);
											
			КонецЕсли;

			Если ВключитьТрудРесурсыВПланРасходов Тогда
				
				ЗаполнитьЗначенияСвойств(ОтборРесурсПодразделение, СтрокаРесурс);
				ПрофилиРесурсаБДР = СводнаяТаблицаПланРасходов.НайтиСтроки(ОтборРесурсПодразделение);
				
				ПериодыАгрегации = Новый Соответствие;
				СчКолонок = 1;
				Для Каждого ПрофильРасходовРесурса Из ПрофилиРесурсаБДР Цикл
					Если ПрофильРасходовРесурса.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно
						И ПериодыАгрегации[ПрофильРасходовРесурса.ПериодАгрегации] = Неопределено Тогда
						ПериодыАгрегации.Вставить(ПрофильРасходовРесурса.ПериодАгрегации, "КолонкаПериода_" + СчКолонок);
						СчКолонок = СчКолонок + 1;
					КонецЕсли;	
				КонецЦикла;	
				
				ЕстьСводныеПрофили  = ПериодыАгрегации.Количество() > 0;
				Если ЕстьСводныеПрофили Тогда
					ТаблицаПоДням = ШаблонТаблицыПоДням(ПериодыАгрегации);
				КонецЕсли;
				
				ОбщаяСуммаРесурса = 0;
				ОбщаяВнешСуммаРесурса = 0;
				
			КонецЕсли;
			
			ДатаОкончанияПроектнойЗадачиПлан = СвойстваЗадачи.ДатаКон;
			Для каждого СтрокаДень Из СтрокаРесурс.Строки Цикл
				
				Если СтруктураНастроекПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда 
					
					Если СтрокиНорм.Количество() Тогда
						// Найдем стоимость по норме трудового ресурса в текущий день.
						Если ДатаИзмененияНормы <= НачалоДня(СтрокаДень.День) Тогда
							СтоимостьЧаса = НайтиСтоимостьПоНормеЗаДень(СтрокиНорм, НачалоДня(СтрокаДень.День), ДатаИзмененияНормы);
						КонецЕсли;
					КонецЕсли;
					
					Если СтрокиВнешнихНорм.Количество() Тогда
						// Найдем стоимость по норме трудового ресурса в текущий день.
						Если ДатаИзмененияВнешнийНормы <= НачалоДня(СтрокаДень.День)  Тогда
							СтоимостьЧасаВнешняя = НайтиСтоимостьПоНормеЗаДень(СтрокиВнешнихНорм, 
								НачалоДня(СтрокаДень.День), 
								ДатаИзмененияВнешнийНормы);
						КонецЕсли;
					КонецЕсли;
					
					СтрокаДень.Стоимость = СтоимостьЧаса * СтрокаДень.Трудозатраты;
					СтрокаДень.ВнешняяСтоимость = СтоимостьЧасаВнешняя * СтрокаДень.Трудозатраты;

				КонецЕсли;
						
				Если Не ПланироватьТрудозатратыНаИсполнителей Тогда
					
					Движение = упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям.Добавить();
					Движение.Проект = ПроектЗадачи;
					Движение.Операция = ПроектнаяЗадача;
					Движение.Ресурс = СтрокаРесурс.Ресурс;
					Движение.Подразделение = СтрокаРесурс.Подразделение;
					Движение.День = СтрокаДень.День;
					Движение.ИсточникПлана = СтрокаРесурс.ИсточникПлана;
					Движение.УровеньПланирования = СтрокаРесурс.УровеньПланирования;
					Движение.Трудозатраты = СтрокаДень.Трудозатраты;
					Движение.Стоимость = СтрокаДень.Стоимость;
					Движение.ВнешняяСтоимость = СтрокаДень.ВнешняяСтоимость;
					
				Иначе
					
					// А для таких проектных задач в данных оперативного планирования
					// фигурируют трудовые ресурсы, назначенные на выполнение задачи.
					
					Движение = упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям.Добавить();
					Движение.Проект = ПроектЗадачи;
					Движение.Операция = ПроектнаяЗадача;
					Движение.Ресурс = СтрокаРесурс.Ресурс;
					Движение.Подразделение = СтрокаРесурс.Подразделение;
					Движение.Роль = СтрокаРесурс.Роль;
					Движение.День = СтрокаДень.День;
					Движение.ИсточникПлана = СтрокаРесурс.ИсточникПлана;
					Движение.УровеньПланирования = СтрокаРесурс.УровеньПланирования;
					Движение.Трудозатраты = СтрокаДень.Трудозатраты;

					Если ТипЗнч(СтрокаРесурс.Ресурс) = Тип("СправочникСсылка.упоТрудовыеРесурсы") Тогда
						
						Движение.Стоимость = СтоимостьЧаса * Движение.Трудозатраты;
						Движение.ВнешняяСтоимость = СтоимостьЧасаВнешняя * Движение.Трудозатраты;
						
					Иначе
						
						Движение.Стоимость = СтрокаДень.Стоимость;
						Движение.ВнешняяСтоимость = СтрокаДень.ВнешняяСтоимость;
						
					КонецЕсли;				
					
				КонецЕсли;
				
				Если ВключитьТрудРесурсыВПланРасходов Тогда
					
					ОбщаяСуммаРесурса = ОбщаяСуммаРесурса + Движение.Стоимость;
					ОбщаяВнешСуммаРесурса = ОбщаяВнешСуммаРесурса + Движение.ВнешняяСтоимость;
					
					Если ЕстьСводныеПрофили Тогда
						НоваяСтрока = ТаблицаПоДням.Добавить();
						НоваяСтрока.Сумма = Движение.Стоимость;
						
						Для Каждого ПериодАгрегации Из ПериодыАгрегации Цикл
							ДатаПривязки = Мин(ДатаОкончанияПроектнойЗадачиПлан,
								КонецПериодаАгрегации(СтрокаДень.День, ПериодАгрегации.Ключ));
							НоваяСтрока[ПериодАгрегации.Значение] = ДатаПривязки;
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;

			Если ВключитьТрудРесурсыВПланРасходов Тогда
				
				СкорректироватьРазницуОкругленияСтоимостиТрудозатратПриТрансляцииВРасходы(СтрокаРесурс, 
					Движение, 
					ОбщаяСуммаРесурса, 
					ОбщаяВнешСуммаРесурса, 
					СтруктураНастроекПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат);
					
				Для Каждого ПрофильРасходаРесурса Из ПрофилиРесурсаБДР Цикл
					
					СуммаРаспределения = ОбщаяСуммаРесурса * ПрофильРасходаРесурса.ДоляСуммы / 100;
					
					Если ПрофильРасходаРесурса.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно Тогда
						
						КолонкаПериода = ПериодыАгрегации[ПрофильРасходаРесурса.ПериодАгрегации]; 
						Если ПериодыАгрегации.Количество() = 1 Тогда 
							ТаблицаДни = ТаблицаПоДням;
						Иначе
							ТаблицаДни = ТаблицаПоДням.Скопировать(, "Сумма," + КолонкаПериода);
						КонецЕсли;
						ТаблицаДни.Свернуть(КолонкаПериода, "Сумма");
						
						МассивКоэффициентов = ТаблицаДни.ВыгрузитьКолонку("Сумма");
						МассивСумм = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
							СуммаРаспределения, МассивКоэффициентов);
						
						КоличествоЭлементов = ?(МассивСумм = Неопределено, -1, МассивСумм.ВГраница());
						Для Сч = 0 По КоличествоЭлементов Цикл
							НоваяСтрока = ДетальнаяТаблицаПланРасходов.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, ПрофильРасходаРесурса, , "Сумма");
							НоваяСтрока.ДатаНачисления = ТаблицаДни[Сч][КолонкаПериода];
							НоваяСтрока.СуммаВалютная = МассивСумм[Сч];
						КонецЦикла;
					
					Иначе
						
						ПрофильРасходаРесурса.Сумма = СуммаРаспределения;
						упоАктуализацияПроектаВызовСервера.РаспределитьСуммуСтрокиБДР(ДетальнаяТаблицаПланРасходов, ПрофильРасходаРесурса, 
							ПараметрыРаспределения, ДанныеЗаполнения);
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		//
		
		упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям.Свернуть("Проект, Операция, УровеньПланирования, Ресурс, Роль,
		 |Подразделение, День, ИсточникПлана", "Трудозатраты, Стоимость, ВнешняяСтоимость"); 
		
		упоАктуальныеПланыТрудозатратСводноТекущаяВерсия = упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям.Скопировать();
		
		СконвертироватьТаблицуПоДнямВТаблицуПлановыхЗатратТрудовыхРесурсов(упоАктуальныеПланыТрудозатратСводноТекущаяВерсия, 
																								ПроектнаяЗадача, 
																								ВидОперации);
																														
		//
			
		НаборЗаписей_упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия = 
			РегистрыСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.СоздатьНаборЗаписей();
		НаборЗаписей_упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Отбор.Операция.Установить(ПроектнаяЗадача);
		НаборЗаписей_упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Загрузить(
			упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсиям);
		
		НаборЗаписей_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия = 
			РегистрыСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.СоздатьНаборЗаписей();
		НаборЗаписей_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Отбор.ПроектнаяЗадача.Установить(ПроектнаяЗадача);
		НаборЗаписей_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Загрузить(
			упоАктуальныеПланыТрудозатратСводноТекущаяВерсия);
			
		// Заполнить стоимости в РС упоДанныеПлановТрудозатратРолей.
		Если ЕстьУчетПериодаРегистрацииНормСтоимости Тогда
			РассчитатьСтоимости_УчетПериодаРегистрацииНормСтоимости(ДвиженияДокумента, 
				упоДанныеПлановТрудозатратРолейИтоговая, 
				упоАктуальныеПланыТрудозатратСводноТекущаяВерсия, 
				ТрудовыеРесурсыТЧ, 
				ДанныеЗаполнения);
		КонецЕсли;
			
		//
		
		МассивНаборовЗаписей.Добавить(НаборЗаписей_упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия);
		МассивНаборовЗаписей.Добавить(НаборЗаписей_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия);
		
		//

		ПодготовитьНаборыЗаписей_ТрансляцияТрудРесурсов(СвойстваЗадачи, 
			ДетальнаяТаблицаПланРасходов, 
			ДвиженияДокумента, 
			МассивНаборовЗаписей, 
			СтруктураНастроекПроекта, 
			ДанныеЗаполнения, 
			ДанныеШаблоновТрансляции);
		
	КонецЦикла; // ТекЗадача Из КоллекцияДанныхЗадач
	
	Если ЕстьУчетПериодаРегистрацииНормСтоимости Тогда
		ПодготовитьНаборыЗаписей_УчетПериодаРегистрацииНормСтоимости(упоДанныеПлановТрудозатратРолейИтоговая, 
			МассивНаборовЗаписей, 
			ПроектыСНастройкойУчетПериодаРегистрации);
	КонецЕсли;
	
	НачатьТранзакцию();
	
	КоличествоЗаписей = МассивНаборовЗаписей.ВГраница();
	Для Сч = 0 По КоличествоЗаписей Цикл
		МассивНаборовЗаписей[Сч].Записать();
		МассивНаборовЗаписей[Сч] = Неопределено;
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура СкорректироватьРазницуОкругленияСтоимостиТрудозатратПриТрансляцииВРасходы(СтрокаРесурс, 
	Движение, 
	ОбщаяСуммаРесурса, 
	ОбщаяВнешСуммаРесурса, 
	УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат) 
	
	// При опции УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат = Истина изменение сроков задачи 
	//   может приводить к изменению общей суммы роли, т.к. общая сумма рассчитывается из дневных ставок 
	//   и период изменения ставки может добавиться или выпасть из новых сроков задачи. 
	// При опции УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат = Ложь изменение сроков задачи 
	//   не приводит к изменению общей стоимости, поэтому мы должны сделать корректировку округления, 
	//   которая сбрасывается на последний период расчета.
	Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
		Возврат;
	КонецЕсли;
	
	// Затраты трудовых ресурсов не транслируются в БДР.
	Если ТипЗнч(СтрокаРесурс.Ресурс) = Тип("СправочникСсылка.упоТрудовыеРесурсы") Тогда
		Возврат;
	КонецЕсли;
	
	// Нижняя ветка условия необходима для "добивания" общей стоимости роли (ТР исключаем) в указанный период
	// после распределения этой суммы по параметрам в движения.
	// ЗначениеЗаполнено(СтрокаРесурс.Стоимость) - означает, что было распределение по доли трудозатрат.
	// В этом случае сравниваем общую стоимость и если есть разница, "кидаем" эту разницу на последнюю дату/движение.
	
	// Стоимость
	Если ЗначениеЗаполнено(СтрокаРесурс.Стоимость) И ОбщаяСуммаРесурса <> СтрокаРесурс.Стоимость Тогда
		Разница = СтрокаРесурс.Стоимость - ОбщаяСуммаРесурса;
		Движение.Стоимость = Движение.Стоимость + Разница;
		ОбщаяСуммаРесурса = СтрокаРесурс.Стоимость;
	КонецЕсли;
	// Внешняя стоимость
	Если ЗначениеЗаполнено(СтрокаРесурс.ВнешняяСтоимость) И ОбщаяВнешСуммаРесурса <> СтрокаРесурс.ВнешняяСтоимость Тогда
		Разница = СтрокаРесурс.ВнешняяСтоимость - ОбщаяВнешСуммаРесурса;
		Движение.ВнешняяСтоимость = Движение.ВнешняяСтоимость + Разница;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПараметрОтраженияСИсключением(Предмет)
	
	ТипПредмет = ТипЗнч(Предмет);
	Если ТипПредмет = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Возврат;
	КонецЕсли;
	Если ТипПредмет = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ВызватьИсключение НСтр("ru = 'Некорректный параметр: ожидается проектная задача.'");
	
КонецПроцедуры

// Заполнить стоимости в РС упоДанныеПлановТрудозатратРолей.
Процедура РассчитатьСтоимости_УчетПериодаРегистрацииНормСтоимости(ДвиженияДокумента, 
	упоДанныеПлановТрудозатратРолейИтоговая, 
	упоАктуальныеПланыТрудозатратСводноТекущаяВерсия, 
	ТрудовыеРесурсыТЧ, 
	ДанныеЗаполнения)
	
	ДобавитьВМассивНаборовЗаписей = Истина;
	Если ДвиженияДокумента <> Неопределено И ДвиженияДокумента.Свойство("упоДанныеПлановТрудозатратРолей") Тогда
		упоДанныеПлановТрудозатратРолей = ДвиженияДокумента.упоДанныеПлановТрудозатратРолей;
		ДобавитьВМассивНаборовЗаписей = Ложь;
	Иначе
		упоДанныеПлановТрудозатратРолей = ТрудовыеРесурсыТЧ.Скопировать();
		упоДанныеПлановТрудозатратРолей.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
		упоДанныеПлановТрудозатратРолей.ЗаполнитьЗначения(ДанныеЗаполнения.Период, "Период");
		КолонкаИндексСтрокРаспределенияПоПериодам
			= упоДанныеПлановТрудозатратРолей.Колонки.Найти("ИндексСтрокРаспределенияПоПериодам");
		КолонкаИндексСтрокРаспределения = упоДанныеПлановТрудозатратРолей.Колонки.Найти("ИндексСтрокРаспределения");
		Если КолонкаИндексСтрокРаспределенияПоПериодам <> Неопределено
			И КолонкаИндексСтрокРаспределения = Неопределено Тогда
			КолонкаИндексСтрокРаспределенияПоПериодам.Имя = "ИндексСтрокРаспределения";
		КонецЕсли;
	КонецЕсли;
	
	Отбор = Новый Структура("УровеньПланирования, Ресурс, Подразделение");
	Для Каждого СтрокаТЧ Из упоДанныеПлановТрудозатратРолей Цикл
		
		Если СтрокаТЧ.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор.УровеньПланирования = СтрокаТЧ.УровеньПланирования;
		Отбор.Ресурс = СтрокаТЧ.Ресурс;
		Отбор.Подразделение = СтрокаТЧ.Подразделение;
		
		СтрокиупоАктуальныеПланыТрудозатратСводноТекущаяВерсия =
			упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.НайтиСтроки(Отбор);
		ОбщСтоимость = 0;
		ОбщВнешняяСтоимость = 0;
		Для Каждого СтрокаСтоимости Из СтрокиупоАктуальныеПланыТрудозатратСводноТекущаяВерсия Цикл
			ОбщСтоимость = ОбщСтоимость + СтрокаСтоимости.Стоимость;
			ОбщВнешняяСтоимость = ОбщВнешняяСтоимость + СтрокаСтоимости.СтоимостьВнешняя;
		КонецЦикла;
		СтрокиупоДанныеПлановТрудозатратРолей = упоДанныеПлановТрудозатратРолей.НайтиСтроки(Отбор);
		ОбщееКоличествоЧасов = 0;
		Если СтрокиупоДанныеПлановТрудозатратРолей.Количество() > 0 Тогда
			Для Каждого СтрокаСтоимости Из СтрокиупоДанныеПлановТрудозатратРолей Цикл
				ОбщееКоличествоЧасов = ОбщееКоличествоЧасов
					+ (СтрокаСтоимости.ЕдиницаНормирования.Коэффициент * СтрокаСтоимости.Количество);
			КонецЦикла;
		КонецЕсли;
		
		Если ОбщееКоличествоЧасов <> 0 Тогда
			СтрокаТЧ.ОбщСтоимость = ОбщСтоимость / ОбщееКоличествоЧасов
				* (СтрокаТЧ.ЕдиницаНормирования.Коэффициент * СтрокаТЧ.Количество);
			СтрокаТЧ.ОбщВнешняяСтоимость = ОбщВнешняяСтоимость / ОбщееКоличествоЧасов
				* (СтрокаТЧ.ЕдиницаНормирования.Коэффициент * СтрокаТЧ.Количество);
		Иначе
			СтрокаТЧ.ОбщСтоимость = ОбщСтоимость;
			СтрокаТЧ.ОбщВнешняяСтоимость = ОбщВнешняяСтоимость;
		КонецЕсли;
		
		СтрокаТЧ.Стоимость = СтрокаТЧ.ОбщСтоимость / СтрокаТЧ.Количество;
		СтрокаТЧ.ВнешняяСтоимость = СтрокаТЧ.ОбщВнешняяСтоимость / СтрокаТЧ.Количество;
		
	КонецЦикла;
	
	Если ДобавитьВМассивНаборовЗаписей Тогда
		Если упоДанныеПлановТрудозатратРолейИтоговая = Неопределено Тогда
			упоДанныеПлановТрудозатратРолейИтоговая = упоДанныеПлановТрудозатратРолей.Скопировать();
		Иначе
			Для Каждого Строка Из упоДанныеПлановТрудозатратРолей Цикл
				НоваяСтрока = упоДанныеПлановТрудозатратРолейИтоговая.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ТаблицыСтоимости(МассивЗадачДляРасчетаНормыСрезПоследних,
		МассивЗадачДляРасчетаНормыПоПериодам,
		НезаписанныеТрудовыеРесурсы)
	
	Результат = Новый Структура("ТаблицаСтоимостиПоНорме, ТаблицаСтоимостиПоНормеПоПериодам");
	
	Запрос = Новый Запрос;
	Если МассивЗадачДляРасчетаНормыСрезПоследних.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("Ссылка", МассивЗадачДляРасчетаНормыСрезПоследних); 
		Запрос.УстановитьПараметр("НезаписанныеТрудовыеРесурсы", НезаписанныеТрудовыеРесурсы);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Рег.Ресурс,
			|	Рег.Норма,
			|	Рег.ЕдиницаНормирования.Коэффициент КАК КоэфПоНорме,
			|	Рег.ЕдСтоимость КАК СтоимостьЗаЕдиницуПоНорме,
			|	ВЫБОР
			|		КОГДА ВЫРАЗИТЬ(Рег.ЕдиницаНормирования КАК Справочник.упоЕдиницыВремени) ЕСТЬ NULL 
			|			ТОГДА 0
			|		ИНАЧЕ ВЫБОР
			|				КОГДА Рег.ЕдиницаНормирования ЕСТЬ NULL 
			|					ТОГДА 0
			|				ИНАЧЕ ВЫБОР
			|						КОГДА Рег.ЕдиницаНормирования.Коэффициент > 0
			|							ТОГДА Рег.ЕдСтоимость / Рег.ЕдиницаНормирования.Коэффициент
			|						ИНАЧЕ 0
			|					КОНЕЦ
			|			КОНЕЦ
			|	КОНЕЦ КАК СтоимостьЧаса
			|ИЗ
			|	РегистрСведений.упоНормыСтоимостиРесурсов.СрезПоследних(
			|			,
			|			Ресурс В
			|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|					ВыделенныеТрудовыеРесурсы.Ресурс
			|				ИЗ
			|					РегистрСведений.упоВыделенныеТрудовыеРесурсы КАК ВыделенныеТрудовыеРесурсы
			|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
			|						ПО
			|							упоВерсииПроекта.Версия = ВыделенныеТрудовыеРесурсы.Версия И упоВерсииПроекта.Текущая
			|				ГДЕ
			|					ВыделенныеТрудовыеРесурсы.ПроектнаяЗадача В (&Ссылка))
			|			ИЛИ Ресурс В (&НезаписанныеТрудовыеРесурсы)) КАК Рег";
		
		Результат.ТаблицаСтоимостиПоНорме = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Если МассивЗадачДляРасчетаНормыПоПериодам.Количество() > 0 Тогда
		
		Запрос.УстановитьПараметр("Ссылка", МассивЗадачДляРасчетаНормыПоПериодам);
		Запрос.УстановитьПараметр("НезаписанныеТрудовыеРесурсы", НезаписанныеТрудовыеРесурсы);
		Запрос.УстановитьПараметр("МаксимальнаяДата", Дата(3999, 12, 31));
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(Рег.Период, ДЕНЬ) КАК ПериодНачала,
			|	Рег.Ресурс КАК Ресурс,
			|	Рег.Норма КАК Норма,
			|	Рег.ЕдиницаНормирования.Коэффициент КАК КоэфПоНорме,
			|	Рег.ЕдСтоимость КАК СтоимостьЗаЕдиницуПоНорме,
			|	ВЫБОР
			|		КОГДА ВЫРАЗИТЬ(Рег.ЕдиницаНормирования КАК Справочник.упоЕдиницыВремени) ЕСТЬ NULL
			|			ТОГДА 0
			|		ИНАЧЕ ВЫБОР
			|				КОГДА Рег.ЕдиницаНормирования ЕСТЬ NULL
			|					ТОГДА 0
			|				ИНАЧЕ ВЫБОР
			|						КОГДА Рег.ЕдиницаНормирования.Коэффициент > 0
			|							ТОГДА Рег.ЕдСтоимость / Рег.ЕдиницаНормирования.Коэффициент
			|						ИНАЧЕ 0
			|					КОНЕЦ
			|			КОНЕЦ
			|	КОНЕЦ КАК СтоимостьЧаса
			|ПОМЕСТИТЬ ВТ_Рег
			|ИЗ
			|	РегистрСведений.упоНормыСтоимостиРесурсов КАК Рег
			|ГДЕ
			|	Рег.Ресурс В
			|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|				ВыделенныеТрудовыеРесурсы.Ресурс
			|			ИЗ
			|				РегистрСведений.упоВыделенныеТрудовыеРесурсы КАК ВыделенныеТрудовыеРесурсы
			|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
			|					ПО
			|						упоВерсииПроекта.Версия = ВыделенныеТрудовыеРесурсы.Версия
			|							И упоВерсииПроекта.Текущая
			|			ГДЕ
			|				ВыделенныеТрудовыеРесурсы.ПроектнаяЗадача В (&Ссылка))
			|	ИЛИ Рег.Ресурс В (&НезаписанныеТрудовыеРесурсы)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_Рег.ПериодНачала КАК ПериодНачала,
			|	ВТ_Рег.Ресурс КАК Ресурс,
			|	ВТ_Рег.Норма КАК Норма,
			|	ВТ_Рег.КоэфПоНорме КАК КоэфПоНорме,
			|	ВТ_Рег.СтоимостьЗаЕдиницуПоНорме КАК СтоимостьЗаЕдиницуПоНорме,
			|	ВТ_Рег.СтоимостьЧаса КАК СтоимостьЧаса,
			|	МИНИМУМ(ЕСТЬNULL(ВТ_Рег1.ПериодНачала, &МаксимальнаяДата)) КАК ПериодОкончания
			|ИЗ
			|	ВТ_Рег КАК ВТ_Рег
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Рег КАК ВТ_Рег1
			|		ПО ВТ_Рег.Ресурс = ВТ_Рег1.Ресурс
			|			И (ВТ_Рег1.Норма = ВТ_Рег.Норма)
			|			И ВТ_Рег.ПериодНачала < ВТ_Рег1.ПериодНачала
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТ_Рег.ПериодНачала,
			|	ВТ_Рег.Ресурс,
			|	ВТ_Рег.Норма,
			|	ВТ_Рег.КоэфПоНорме,
			|	ВТ_Рег.СтоимостьЗаЕдиницуПоНорме,
			|	ВТ_Рег.СтоимостьЧаса";
		
		Результат.ТаблицаСтоимостиПоНормеПоПериодам = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьСформироватьШаблоныТрансляции(ДанныеШаблоновТрансляции)
	
	Если ДанныеШаблоновТрансляции.ШаблоныАктуализацииДДССформированы Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеШаблоновТрансляции.ШаблонПланаДДС = упоДвиженияДенежныхСредствСервер.ШаблонПланаДДС();
	ДанныеШаблоновТрансляции.ШаблонАктуальныеПланыДДС =
		упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру("упоАктуальныеПланыДвиженийДенежныхСредств");
	ДанныеШаблоновТрансляции.ШаблонТаблицыРасходов = ШаблонТаблицыРасходов();
	
	ДанныеШаблоновТрансляции.ШаблоныАктуализацииДДССформированы = Истина;
	
КонецПроцедуры

Процедура ПодготовитьНаборыЗаписей_ТрансляцияТрудРесурсов(СвойстваЗадачи,
		ДетальнаяТаблицаПланРасходов,
		ДвиженияДокумента,
		МассивНаборовЗаписей,
		СтруктураНастроекПроекта,
		ДанныеЗаполнения,
		ДанныеШаблоновТрансляции)
	
	Если Не СвойстваЗадачи.ВключитьТрудРесурсыВПланРасходов Тогда
		Возврат;
	КонецЕсли;
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ДетальнаяТаблицаПланРасходов, , Ложь);
	
	ДетальнаяТаблицаПланРасходов.Колонки.Ресурс.Имя = "Роль";
	
	СоздатьНаборЗаписейПоТаблице(ДетальнаяТаблицаПланРасходов, "упоДанныеПлановДоходовИРасходов",
		ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения);
	СоздатьНаборЗаписейПоТаблице(ДетальнаяТаблицаПланРасходов, "упоАктуальныеПланыДоходовИРасходов",
		ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения, Истина);
	
	// Расширенная аналитика по подразделениям.
	СоздатьНаборЗаписейПоТаблице(ДетальнаяТаблицаПланРасходов, "упоДанныеПлановДоходовИРасходовПодразделения",
		ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения);
	СоздатьНаборЗаписейПоТаблице(ДетальнаяТаблицаПланРасходов, "упоАктуальныеПланыДоходовИРасходовПодразделения",
		ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения);
	
	// Включение в план объемов.
	Если СтруктураНастроекПроекта.РасходыПоПодразделениям И СтруктураНастроекПроекта.РасходыПоОбъемам
		И Не СтруктураНастроекПроекта.РасходыПоНатуральнымПоказателям Тогда
		
		СоздатьНаборЗаписейПоТаблице(ДетальнаяТаблицаПланРасходов, "упоАктуальныеПланыВыполненияОбъемов",
			ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения);
	Иначе
		
		// Обнуление записей трансляции трудозатрат, если опции проектной модели изменились.
		СоздатьНаборЗаписейПоТаблице(Неопределено, "упоАктуальныеПланыВыполненияОбъемов",
			ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения, Истина);
		
	КонецЕсли;
	
	// Включение в план ДДС.
	Если СвойстваЗадачи.ВключитьПланРасходовВБДДС Тогда
		
		ПроверитьСформироватьШаблоныТрансляции(ДанныеШаблоновТрансляции);
		
		ТаблицаПланДДС = ДанныеШаблоновТрансляции.ШаблонПланаДДС.СкопироватьКолонки();
		ТаблицаДвиженийБДДС = ДанныеШаблоновТрансляции.ШаблонАктуальныеПланыДДС.СкопироватьКолонки();
		
		ТаблицаЗадач = ТаблицаЗадачи(СвойстваЗадачи.ПроектнаяЗадача, СвойстваЗадачи.ДатаНач, СвойстваЗадачи.ДатаКон);
		
		ДетальнаяТаблицаПланРасходов.Колонки.Добавить("ВидЭлемента", ДанныеШаблоновТрансляции.Тип_ВидЭлементаПланаДоходовИРасходов);
		ДетальнаяТаблицаПланРасходов.ЗаполнитьЗначения(Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход, "ВидЭлемента");
		
		ДополнитьДанныеПланаДДСДаннымиПланаБДР(ТаблицаПланДДС, ДетальнаяТаблицаПланРасходов, СвойстваЗадачи.ПроектнаяЗадача,
			СвойстваЗадачи.Проект);
		
		упоДвиженияДенежныхСредствСервер.ЗаполнитьТаблицуБДДСПоДаннымПланаДДС(ТаблицаДвиженийБДДС, ТаблицаПланДДС,
			ТаблицаЗадач, СвойстваЗадачи.ПроектнаяЗадача, Истина);
		
		// Переопределение данных заполнения.
		ДанныеЗаполнения.ИсточникПлана = Перечисления.упоИсточникПланаДДС.Трудозатраты;
		
		СоздатьНаборЗаписейПоТаблице(ТаблицаДвиженийБДДС, "упоАктуальныеПланыДвиженийДенежныхСредств",
			ДвиженияДокумента, МассивНаборовЗаписей, ДанныеЗаполнения, Истина);
		
		ДанныеЗаполнения.ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.Трудозатраты;
		
	КонецЕсли;
	
КонецПроцедуры

// Обновляет данные средней стоимости в последних регистраторах для корректного отображения в данных табличных частей 
// проектной задачи. Перезаписывается весь набор записей регистраторов; при этом обновляются строки, полностью 
// совпадающие по аналитике, а также по количеству.
//
Процедура ПодготовитьНаборыЗаписей_УчетПериодаРегистрацииНормСтоимости(упоДанныеПлановТрудозатратРолейИтоговая, 
	МассивНаборовЗаписей, 
	ПроектыСНастройкойУчетПериодаРегистрации)
	
	Если упоДанныеПлановТрудозатратРолейИтоговая = Неопределено Тогда
		Возврат; // Нет учета по периодам регистрации.
	КонецЕсли;
	
	ВерсииПроектовСУчетомПериодаРегистрации = ВерсииПроектов(ПроектыСНастройкойУчетПериодаРегистрации);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДанныеПлановТрудозатратРолей", упоДанныеПлановТрудозатратРолейИтоговая);
	Запрос.УстановитьПараметр("ВерсииПроектов", ВерсииПроектовСУчетомПериодаРегистрации);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДанныеПлановТрудозатратРолей.Период КАК Период,
	               |	ДанныеПлановТрудозатратРолей.Версия КАК Версия,
	               |	ДанныеПлановТрудозатратРолей.УровеньПланирования КАК УровеньПланирования,
	               |	ДанныеПлановТрудозатратРолей.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДанныеПлановТрудозатратРолей.Ресурс КАК Ресурс,
	               |	ДанныеПлановТрудозатратРолей.Подразделение КАК Подразделение,
	               |	ДанныеПлановТрудозатратРолей.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	ДанныеПлановТрудозатратРолей.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ДанныеПлановТрудозатратРолей.СпособПривязки КАК СпособПривязки,
	               |	ДанныеПлановТрудозатратРолей.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
	               |	ДанныеПлановТрудозатратРолей.Количество КАК Количество,
	               |	ДанныеПлановТрудозатратРолей.Стоимость КАК Стоимость,
	               |	ДанныеПлановТрудозатратРолей.ОбщСтоимость КАК ОбщСтоимость,
	               |	ДанныеПлановТрудозатратРолей.ВнешняяСтоимость КАК ВнешняяСтоимость,
	               |	ДанныеПлановТрудозатратРолей.ОбщВнешняяСтоимость КАК ОбщВнешняяСтоимость,
	               |	ДанныеПлановТрудозатратРолей.ИсточникПлана КАК ИсточникПлана
	               |ПОМЕСТИТЬ втТаблицаРасчета
	               |ИЗ
	               |	&ДанныеПлановТрудозатратРолей КАК ДанныеПлановТрудозатратРолей
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втТаблицаРасчета.Период КАК Период,
	               |	втТаблицаРасчета.Версия КАК Версия,
	               |	втТаблицаРасчета.УровеньПланирования КАК УровеньПланирования,
	               |	втТаблицаРасчета.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	втТаблицаРасчета.Ресурс КАК Ресурс,
	               |	втТаблицаРасчета.Подразделение КАК Подразделение,
	               |	втТаблицаРасчета.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	втТаблицаРасчета.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	втТаблицаРасчета.СпособПривязки КАК СпособПривязки,
	               |	втТаблицаРасчета.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
	               |	втТаблицаРасчета.Количество КАК Количество,
	               |	втТаблицаРасчета.Стоимость КАК Стоимость,
	               |	втТаблицаРасчета.ОбщСтоимость КАК ОбщСтоимость,
	               |	втТаблицаРасчета.ВнешняяСтоимость КАК ВнешняяСтоимость,
	               |	втТаблицаРасчета.ОбщВнешняяСтоимость КАК ОбщВнешняяСтоимость,
	               |	втТаблицаРасчета.ИсточникПлана КАК ИсточникПлана,
	               |	втТаблицаРасчета.Версия В (&ВерсииПроектов) КАК УчетПериодаРегистрации
	               |ПОМЕСТИТЬ вт
	               |ИЗ
	               |	втТаблицаРасчета КАК втТаблицаРасчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Регистратор КАК Регистратор,
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Версия КАК Версия
	               |ПОМЕСТИТЬ вт_КрайниеРегистраторы
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	               |			,
	               |			(Версия, УровеньПланирования, ПроектнаяЗадача, Ресурс, Подразделение, ЕдиницаНормирования, ПрофильРаспределения, СпособПривязки, ИндексСтрокРаспределения, ИсточникПлана) В
	               |				(ВЫБРАТЬ
	               |					вт.Версия КАК Версия,
	               |					вт.УровеньПланирования КАК УровеньПланирования,
	               |					вт.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |					вт.Ресурс КАК Ресурс,
	               |					вт.Подразделение КАК Подразделение,
	               |					вт.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |					вт.ПрофильРаспределения КАК ПрофильРаспределения,
	               |					вт.СпособПривязки КАК СпособПривязки,
	               |					вт.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
	               |					вт.ИсточникПлана КАК ИсточникПлана
	               |				ИЗ
	               |					вт КАК вт)) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоДанныеПлановТрудозатратРолей.Регистратор КАК Регистратор,
	               |	упоДанныеПлановТрудозатратРолей.Период КАК Период,
	               |	упоДанныеПлановТрудозатратРолей.Версия КАК Версия,
	               |	упоДанныеПлановТрудозатратРолей.УровеньПланирования КАК УровеньПланирования,
	               |	упоДанныеПлановТрудозатратРолей.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоДанныеПлановТрудозатратРолей.Ресурс КАК Ресурс,
	               |	упоДанныеПлановТрудозатратРолей.Подразделение КАК Подразделение,
	               |	упоДанныеПлановТрудозатратРолей.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	упоДанныеПлановТрудозатратРолей.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	упоДанныеПлановТрудозатратРолей.СпособПривязки КАК СпособПривязки,
	               |	упоДанныеПлановТрудозатратРолей.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
	               |	упоДанныеПлановТрудозатратРолей.Основной КАК Основной,
	               |	упоДанныеПлановТрудозатратРолей.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА упоДанныеПлановТрудозатратРолей.УчетПериодаРегистрации
	               |				И упоДанныеПлановТрудозатратРолей.Количество = ЕСТЬNULL(вт.Количество, 0)
	               |			ТОГДА ЕСТЬNULL(вт.Стоимость, 0)
	               |		ИНАЧЕ упоДанныеПлановТрудозатратРолей.Стоимость
	               |	КОНЕЦ КАК Стоимость,
	               |	ВЫБОР
	               |		КОГДА упоДанныеПлановТрудозатратРолей.УчетПериодаРегистрации
	               |				И упоДанныеПлановТрудозатратРолей.Количество = ЕСТЬNULL(вт.Количество, 0)
	               |			ТОГДА ЕСТЬNULL(вт.ОбщСтоимость, 0)
	               |		ИНАЧЕ упоДанныеПлановТрудозатратРолей.ОбщСтоимость
	               |	КОНЕЦ КАК ОбщСтоимость,
	               |	ВЫБОР
	               |		КОГДА упоДанныеПлановТрудозатратРолей.УчетПериодаРегистрации
	               |				И упоДанныеПлановТрудозатратРолей.Количество = ЕСТЬNULL(вт.Количество, 0)
	               |			ТОГДА ЕСТЬNULL(вт.ВнешняяСтоимость, 0)
	               |		ИНАЧЕ упоДанныеПлановТрудозатратРолей.ВнешняяСтоимость
	               |	КОНЕЦ КАК ВнешняяСтоимость,
	               |	ВЫБОР
	               |		КОГДА упоДанныеПлановТрудозатратРолей.УчетПериодаРегистрации
	               |				И упоДанныеПлановТрудозатратРолей.Количество = ЕСТЬNULL(вт.Количество, 0)
	               |			ТОГДА ЕСТЬNULL(вт.ОбщВнешняяСтоимость, 0)
	               |		ИНАЧЕ упоДанныеПлановТрудозатратРолей.ОбщВнешняяСтоимость
	               |	КОНЕЦ КАК ОбщВнешняяСтоимость,
	               |	упоДанныеПлановТрудозатратРолей.ИсточникПлана КАК ИсточникПлана
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		упоДанныеПлановТрудозатратРолей.Регистратор КАК Регистратор,
	               |		упоДанныеПлановТрудозатратРолей.Период КАК Период,
	               |		упоДанныеПлановТрудозатратРолей.Версия КАК Версия,
	               |		упоДанныеПлановТрудозатратРолей.УровеньПланирования КАК УровеньПланирования,
	               |		упоДанныеПлановТрудозатратРолей.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |		упоДанныеПлановТрудозатратРолей.Ресурс КАК Ресурс,
	               |		упоДанныеПлановТрудозатратРолей.Подразделение КАК Подразделение,
	               |		упоДанныеПлановТрудозатратРолей.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |		упоДанныеПлановТрудозатратРолей.ПрофильРаспределения КАК ПрофильРаспределения,
	               |		упоДанныеПлановТрудозатратРолей.СпособПривязки КАК СпособПривязки,
	               |		упоДанныеПлановТрудозатратРолей.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
	               |		упоДанныеПлановТрудозатратРолей.Основной КАК Основной,
	               |		упоДанныеПлановТрудозатратРолей.Количество КАК Количество,
	               |		упоДанныеПлановТрудозатратРолей.Стоимость КАК Стоимость,
	               |		упоДанныеПлановТрудозатратРолей.ОбщСтоимость КАК ОбщСтоимость,
	               |		упоДанныеПлановТрудозатратРолей.ВнешняяСтоимость КАК ВнешняяСтоимость,
	               |		упоДанныеПлановТрудозатратРолей.ОбщВнешняяСтоимость КАК ОбщВнешняяСтоимость,
	               |		упоДанныеПлановТрудозатратРолей.ИсточникПлана КАК ИсточникПлана,
	               |		упоДанныеПлановТрудозатратРолей.Версия В (&ВерсииПроектов) КАК УчетПериодаРегистрации
	               |	ИЗ
	               |		РегистрСведений.упоДанныеПлановТрудозатратРолей КАК упоДанныеПлановТрудозатратРолей
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ вт_КрайниеРегистраторы КАК вт
	               |			ПО упоДанныеПлановТрудозатратРолей.Регистратор = вт.Регистратор
	               |				И упоДанныеПлановТрудозатратРолей.Версия = вт.Версия) КАК упоДанныеПлановТрудозатратРолей
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт КАК вт
	               |		ПО упоДанныеПлановТрудозатратРолей.Версия = вт.Версия
	               |			И упоДанныеПлановТрудозатратРолей.УровеньПланирования = вт.УровеньПланирования
	               |			И упоДанныеПлановТрудозатратРолей.ПроектнаяЗадача = вт.ПроектнаяЗадача
	               |			И упоДанныеПлановТрудозатратРолей.Ресурс = вт.Ресурс
	               |			И упоДанныеПлановТрудозатратРолей.Подразделение = вт.Подразделение
	               |			И упоДанныеПлановТрудозатратРолей.ЕдиницаНормирования = вт.ЕдиницаНормирования
	               |			И упоДанныеПлановТрудозатратРолей.ПрофильРаспределения = вт.ПрофильРаспределения
	               |			И упоДанныеПлановТрудозатратРолей.СпособПривязки = вт.СпособПривязки
	               |			И упоДанныеПлановТрудозатратРолей.ИндексСтрокРаспределения = вт.ИндексСтрокРаспределения
	               |			И упоДанныеПлановТрудозатратРолей.ИсточникПлана = вт.ИсточникПлана
	               |ИТОГИ ПО
	               |	Регистратор";
	
	ВыборкаРегистратор = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		Выборка = ВыборкаРегистратор.Выбрать();
		
		НаборЗаписей_упоДанныеПлановТрудозатратРолей =
			РегистрыСведений.упоДанныеПлановТрудозатратРолей.СоздатьНаборЗаписей();
		НаборЗаписей_упоДанныеПлановТрудозатратРолей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		Пока Выборка.Следующий() Цикл
			НоваяЗапись = НаборЗаписей_упоДанныеПлановТрудозатратРолей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
		КонецЦикла;
		
		МассивНаборовЗаписей.Добавить(НаборЗаписей_упоДанныеПлановТрудозатратРолей);
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСтоимостьПоНормеЗаДень(СтрокиНорм, День, ДатаИзменения = Неопределено) Экспорт
	
	Результат = 0;
	
	Для Каждого СтрокаНормы Из СтрокиНорм Цикл
		
		Если СтрокаНормы.ПериодНачала <= День И День < СтрокаНормы.ПериодОкончания Тогда
			Результат = СтрокаНормы.СтоимостьЧаса;
            Если НЕ ДатаИзменения = Неопределено Тогда
                ДатаИзменения = СтрокаНормы.ПериодОкончания;
            КонецЕсли;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СвернутьЗатратыТрудовыхРесурсов(ТаблицаДвижений)
	
	Измерения_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия = "";
	Для Каждого Измерение Из Метаданные.РегистрыСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Измерения Цикл
		Измерения_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия = Измерения_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия
											+ ?(ЗначениеЗаполнено(Измерения_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия), ", ", "") + Измерение.Имя;
	КонецЦикла;
	
	ТаблицаДвижений.Свернуть(Измерения_упоАктуальныеПланыТрудозатратСводноТекущаяВерсия, "СтоимостьВнешняя, Стоимость, КоличествоЧасов");				
	
