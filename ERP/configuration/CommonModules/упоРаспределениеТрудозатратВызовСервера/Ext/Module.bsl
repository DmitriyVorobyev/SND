////////////////////////////////////////////////////////////////////////////////
// Распределение трудозатрат по профилям и перерасчеты трудозатрат.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ПолучениеПлановыхТрудозатрат

// Получает из ИБ список рабочих заданий по текущему исполнителю и датам.
//
// Параметры:
//  ТрудовойРесурс	 - СправочникСсылка.упоТрудовыеРесурсы
//  НачалоПериода	 - Дата
//  КонецПериода	 - Дата
// 
// Возвращаемое значение:
//  ТаблицаЗначений - найденные рабочие задания.
//
Функция ПолучитьРабочиеЗадания(ТрудовойРесурс, НачалоПериода, КонецПериода) Экспорт 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТрудовойРесурс", 			ТрудовойРесурс);
	СтруктураПараметров.Вставить("НачалоПериода", 		НачалоПериода);
	СтруктураПараметров.Вставить("КонецПериода", 		КонецПериода);
	
	Запрос = ПолучитьЗапросРабочиеЗадания(СтруктураПараметров);
	
	Отказ = Ложь;
	ДополнитьЗапросПроектныеЗадачиИПоручения(Запрос, СтруктураПараметров, Отказ);

	Если Отказ Тогда
		Возврат Неопределено;
	Иначе
		РезультатЗапроса = Запрос.Выполнить();
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
КонецФункции

// Получает таблицу трудозатрат за неделю.
//
// Параметры:
//  ТаблицаРабочиеЗадания	 - ТаблицаЗначений	 - таблица, в которую будут записаны данные о трудозатратах.
//  СтруктураПараметров		 - Структура		 - Ключи:
//  		* ТрудовойРесурс - СправочникСсылка.упоТрудовыеРесурсы.
//  		* ДеньНачалаНедели - Дата.
//  		* ДеньКонецНедели - Дата.
//
Процедура ПолучитьТаблицуРабочихЗаданийЗаНеделюПоОперативнойЗагрузке(ТаблицаРабочиеЗадания, СтруктураПараметров) Экспорт

	Запрос = ПолучитьЗапросРабочиеЗадания(СтруктураПараметров);
	
	Запрос.Текст = Запрос.Текст + "
		|;
		|
		|//////////////////////////////////////////////////////////////////////////////////////////////////
		|"
		
		+ "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача.Проект КАК Проект,
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача КАК РабочееЗадание,
		  |	НАЧАЛОПЕРИОДА(упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя, ДЕНЬ) КАК День,
		  |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя) КАК Трудозатраты,
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Роль КАК Роль
		  |ПОМЕСТИТЬ втОперативнаяЗагрузка
		  |ИЗ
		  |	РегистрСведений.упоОперативнаяЗагрузкаСпециалистов.СрезПоследних(
		  |			,
		  |			ТрудовойРесурс = &Исполнитель
		  |				И ДатаВремя >= &ДатаНачала
		  |				И ДатаВремя <= &ДатаЗавершения) КАК упоОперативнаяЗагрузкаСпециалистовСрезПоследних
		  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		  |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		  |			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		  |				И (упоВерсииПроекта.Текущая)
		  |				И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		  |		ПО упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		  |ГДЕ
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Занят
		  |	И НЕ упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача.Проект.ПометкаУдаления
		  |
		  |СГРУППИРОВАТЬ ПО
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача,
		  |	НАЧАЛОПЕРИОДА(упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя, ДЕНЬ),
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача.Проект,
		  |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Роль
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		  |	упоВерсииПроекта.Версия КАК Версия
		  |ПОМЕСТИТЬ втТекущаяВерсия
		  |ИЗ
		  |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		  |ГДЕ
		  |	упоВерсииПроекта.Текущая
		  |
		  |ИНДЕКСИРОВАТЬ ПО
		  |	Версия
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		  |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		  |	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК НазваниеЗадачи
		  |ПОМЕСТИТЬ втСвойстваПроектныхЗадач
		  |ИЗ
		  |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		  |			,
		  |			ПроектнаяЗадача В
		  |					(ВЫБРАТЬ
		  |						втОперативнаяЗагрузка.РабочееЗадание
		  |					ИЗ
		  |						втОперативнаяЗагрузка КАК втОперативнаяЗагрузка
		  |			
		  |					ОБЪЕДИНИТЬ ВСЕ
		  |			
		  |					ВЫБРАТЬ
		  |						ВременнаяТаблица_РабочиеЗадания.РабочееЗадание
		  |					ИЗ
		  |						ВременнаяТаблица_РабочиеЗадания КАК ВременнаяТаблица_РабочиеЗадания)
		  |				И Версия В
		  |					(ВЫБРАТЬ
		  |						втТекущаяВерсия.Версия
		  |					ИЗ
		  |						втТекущаяВерсия КАК втТекущаяВерсия)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		  |
		  |ИНДЕКСИРОВАТЬ ПО
		  |	ПроектнаяЗадача
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |ВЫБРАТЬ
		  |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РабочееЗадание КАК ПроектнаяЗадача,
		  |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса КАК Роль,
		  |	МАКСИМУМ(упоВыделенныеТрудовыеРесурсыСрезПоследних.Подразделение) КАК Подразделение
		  |ПОМЕСТИТЬ втПодразделения
		  |ИЗ
		  |	ВременнаяТаблица_РабочиеЗадания КАК упоВыделенныеТрудовыеРесурсыСрезПоследних
		  |
		  |СГРУППИРОВАТЬ ПО
		  |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РабочееЗадание,
		  |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса
		  |
		  |ИНДЕКСИРОВАТЬ ПО
		  |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РабочееЗадание,
		  |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		  |	втОперативнаяЗагрузка.Проект КАК Проект,
		  |	втОперативнаяЗагрузка.РабочееЗадание КАК РабочееЗадание,
		  |	втОперативнаяЗагрузка.День КАК День,
		  |	втОперативнаяЗагрузка.Трудозатраты КАК Трудозатраты,
		  |	втОперативнаяЗагрузка.Роль КАК РольРесурса,
		  |	ИСТИНА КАК ЭтоПроектнаяЗадача,
		  |	3 КАК ТипЗадачи,
		  |	ЕСТЬNULL(втПодразделения.Подразделение, ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)) КАК Подразделение,
		  |	"""" КАК Наименование,
		  |	ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачалаПлан,
		  |	ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗавершенияПлан
		  |ПОМЕСТИТЬ втРабочиеЗаданияВсеДанные
		  |ИЗ
		  |	втОперативнаяЗагрузка КАК втОперативнаяЗагрузка
		  |		ЛЕВОЕ СОЕДИНЕНИЕ втПодразделения КАК втПодразделения
		  |		ПО втОперативнаяЗагрузка.РабочееЗадание = втПодразделения.ПроектнаяЗадача
		  |			И втОперативнаяЗагрузка.Роль = втПодразделения.Роль
		  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
		  |				,
		  |				Версия В
		  |					(ВЫБРАТЬ
		  |						втТекущаяВерсия.Версия
		  |					ИЗ
		  |						втТекущаяВерсия КАК втТекущаяВерсия)) КАК упоСрокиПроектныхЗадачСрезПоследних
		  |		ПО втОперативнаяЗагрузка.РабочееЗадание = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		  |			И втОперативнаяЗагрузка.День >= упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан
		  |			И втОперативнаяЗагрузка.День <= упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан
		  |
		  |ОБЪЕДИНИТЬ ВСЕ
		  |
		  |ВЫБРАТЬ
		  |	ВременнаяТаблица_РабочиеЗадания.Проект,
		  |	ВременнаяТаблица_РабочиеЗадания.РабочееЗадание,
		  |	ДАТАВРЕМЯ(1, 1, 1),
		  |	0,
		  |	ВременнаяТаблица_РабочиеЗадания.РольРесурса,
		  |	ВременнаяТаблица_РабочиеЗадания.ЭтоПроектнаяЗадача,
		  |	ВЫБОР
		  |		КОГДА ВременнаяТаблица_РабочиеЗадания.ЭтоПроектнаяЗадача
		  |			ТОГДА 3
		  |		ИНАЧЕ 2
		  |	КОНЕЦ,
		  |	ВременнаяТаблица_РабочиеЗадания.Подразделение,
		  |	"""",
		  |	ВременнаяТаблица_РабочиеЗадания.ДатаНачала,
		  |	ВременнаяТаблица_РабочиеЗадания.ДатаЗавершения
		  |ИЗ
		  |	ВременнаяТаблица_РабочиеЗадания КАК ВременнаяТаблица_РабочиеЗадания
		  |ГДЕ
		  |	НЕ ВременнаяТаблица_РабочиеЗадания.РабочееЗадание В
		  |				(ВЫБРАТЬ
		  |					втОперативнаяЗагрузка.РабочееЗадание
		  |				ИЗ
		  |					втОперативнаяЗагрузка КАК втОперативнаяЗагрузка)
		  |
		  |ИНДЕКСИРОВАТЬ ПО
		  |	РабочееЗадание
		  |;
		  |
		  |////////////////////////////////////////////////////////////////////////////////
		  |ВЫБРАТЬ
		  |	втРабочиеЗаданияВсеДанные.Проект КАК Проект,
		  |	втРабочиеЗаданияВсеДанные.РабочееЗадание КАК РабочееЗадание,
		  |	втРабочиеЗаданияВсеДанные.День КАК День,
		  |	втРабочиеЗаданияВсеДанные.Трудозатраты КАК Трудозатраты,
		  |	втРабочиеЗаданияВсеДанные.РольРесурса КАК РольРесурса,
		  |	втРабочиеЗаданияВсеДанные.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача,
		  |	втРабочиеЗаданияВсеДанные.ТипЗадачи КАК ТипЗадачи,
		  |	втРабочиеЗаданияВсеДанные.Подразделение КАК Подразделение,
		  |	ВЫБОР
		  |		КОГДА втРабочиеЗаданияВсеДанные.РабочееЗадание ССЫЛКА Документ.упоПроектнаяЗадача
		  |			ТОГДА втСвойстваПроектныхЗадач.НазваниеЗадачи
		  |		ИНАЧЕ втРабочиеЗаданияВсеДанные.Наименование
		  |	КОНЕЦ КАК Наименование,
		  |	втРабочиеЗаданияВсеДанные.ДатаНачалаПлан КАК ДатаНачала,
		  |	втРабочиеЗаданияВсеДанные.ДатаЗавершенияПлан КАК ДатаОкончания
		  |ИЗ
		  |	втРабочиеЗаданияВсеДанные КАК втРабочиеЗаданияВсеДанные
		  |		ЛЕВОЕ СОЕДИНЕНИЕ втСвойстваПроектныхЗадач КАК втСвойстваПроектныхЗадач
		  |		ПО втРабочиеЗаданияВсеДанные.РабочееЗадание = втСвойстваПроектныхЗадач.ПроектнаяЗадача
		  |ИТОГИ
		  |	МАКСИМУМ(Проект),
		  |	МАКСИМУМ(РольРесурса),
		  |	МАКСИМУМ(ЭтоПроектнаяЗадача),
		  |	МАКСИМУМ(ТипЗадачи),
		  |	МАКСИМУМ(Подразделение),
		  |	МАКСИМУМ(Наименование),
		  |	МАКСИМУМ(ДатаНачала),
		  |	МАКСИМУМ(ДатаОкончания)
		  |ПО
		  |	РабочееЗадание";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
	
		ВыборкаПроектнаяЗадача = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		СоответствиеДниНедели = Новый Соответствие;
		СоответствиеДниНедели.Вставить(1, "Понедельник");
		СоответствиеДниНедели.Вставить(2, "Вторник");
		СоответствиеДниНедели.Вставить(3, "Среда");
		СоответствиеДниНедели.Вставить(4, "Четверг");
		СоответствиеДниНедели.Вставить(5, "Пятница");
		СоответствиеДниНедели.Вставить(6, "Суббота");
		СоответствиеДниНедели.Вставить(7, "Воскресенье");	
		
		Пока ВыборкаПроектнаяЗадача.Следующий() Цикл
			
			СтрокаПроектнаяЗадача = ТаблицаРабочиеЗадания.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПроектнаяЗадача, ВыборкаПроектнаяЗадача);
			
			Выборка = ВыборкаПроектнаяЗадача.Выбрать(); 					
			
			ИтогоПоСтроке = 0;
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.Трудозатраты) Тогда
					ИмяКолонки = СоответствиеДниНедели.Получить(ДеньНедели(Выборка.День));
					СтрокаПроектнаяЗадача[ИмяКолонки] = Выборка.Трудозатраты;	
					ИтогоПоСтроке = ИтогоПоСтроке + Выборка.Трудозатраты;
				КонецЕсли;	
			КонецЦикла;
			
			СтрокаПроектнаяЗадача.ИтогоПоСтроке = ИтогоПоСтроке;
			
		КонецЦикла;
		
	КонецЕсли;


КонецПроцедуры

// Формирует таблицу из проектных задач, рабочих заданий и поручений.
//
// Параметры:
//  Форма			 - УправляемаяФорма	 - форма документа Распределение рабочего времени за неделю.
//  ТЧРабочиеЗадания - ТаблицаЗначений	 - таблица, повторяющая табличную часть Рабочие задания.
//  МРабочиеЗадания	 - ТаблицаЗначений
//  ДанныеДокумента	 - Структура.
//
Процедура ЗаполнитьРабочиеЗадания(Форма, ТЧРабочиеЗадания, МРабочиеЗадания, ДанныеДокумента) Экспорт

	РасшифровкаТрудозатрат 	= ДанныеДокумента.РасшифровкаТрудозатрат;
	ТрудовойРесурс 			= ДанныеДокумента.ТрудовойРесурс;
	ДеньНачалаНедели 		= ДанныеДокумента.ДеньНачалаНедели;
	ДеньКонецНедели 		= ДанныеДокумента.ДеньКонецНедели;
	
	ТЧРабочиеЗадания.Колонки.Добавить("НаименованиеЗадачи");
	ТЧРабочиеЗадания.Индексы.Добавить("РабочееЗадание");
	ТЧРабочиеЗадания.Индексы.Добавить("НаименованиеЗадачи");
	
	// Прежде, чем обновлять табличную часть, необходимо учесть
	// заданный пользователем режим автозаполнения.
	
	Если Константы.упоРазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам.Получить()
		И ТЧРабочиеЗадания.Количество() > 0 Тогда
		
		// Необходимо проверить табличную часть на наличие уже закрытых рабочих заданий
		// и проектных задач.
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоПроектнаяЗадача.Ссылка КАК ПроектнаяЗадача,
		               |	упоПроектнаяЗадача.Проект КАК Проект
		               |ПОМЕСТИТЬ ПроектныеЗадачи
		               |ИЗ
		               |	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		               |ГДЕ
		               |	упоПроектнаяЗадача.Ссылка В(&СписокДокументов)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	упоВерсииПроекта.Версия КАК Версия
		               |ПОМЕСТИТЬ ПроектныеЗадачиСТекущимиВерсиями
		               |ИЗ
		               |	ПроектныеЗадачи КАК ПроектныеЗадачи
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		               |		ПО ПроектныеЗадачи.Проект = упоВерсииПроекта.Проект
		               |ГДЕ
		               |	упоВерсииПроекта.Текущая
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	РегПЗ.ПроектнаяЗадача КАК ДокСсылка
		               |ИЗ
		               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
		               |			,
		               |			(Версия, ПроектнаяЗадача) В
		               |				(ВЫБРАТЬ
		               |					ПроектныеЗадачиСТекущимиВерсиями.Версия,
		               |					ПроектныеЗадачиСТекущимиВерсиями.ПроектнаяЗадача
		               |				ИЗ
		               |					ПроектныеЗадачиСТекущимиВерсиями)) КАК РегПЗ
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		               |				,
		               |				(Версия, ПроектнаяЗадача) В
		               |					(ВЫБРАТЬ
		               |						ПроектныеЗадачиСТекущимиВерсиями.Версия,
		               |						ПроектныеЗадачиСТекущимиВерсиями.ПроектнаяЗадача
		               |					ИЗ
		               |						ПроектныеЗадачиСТекущимиВерсиями)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		               |		ПО РегПЗ.Версия = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		               |			И РегПЗ.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		               |ГДЕ
		               |	(РегПЗ.СтатусЗадачи = &ЗадачаЗавершена
		               |			ИЛИ РегПЗ.СтатусЗадачи = &ЗадачаЗакрыта)";
		
		
		ПараметрыЗапроса = Новый Структура();
		ПараметрыЗапроса.Вставить("СписокДокументов", ТЧРабочиеЗадания.ВыгрузитьКолонку("РабочееЗадание"));
		ПараметрыЗапроса.Вставить("ЗадачаЗавершена", Перечисления.упоСостояниеСтатусаЗадачи.Завершена);
		ПараметрыЗапроса.Вставить("ЗадачаЗакрыта", Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
		ТаблицаЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса).Выгрузить();
		
		СтрокиУдалить = Новый Массив();
		Для каждого СтрокаЗадача Из ТЧРабочиеЗадания Цикл
			Если НЕ ТаблицаЗапроса.Найти(СтрокаЗадача.РабочееЗадание, "ДокСсылка") = Неопределено Тогда
				СтрокиУдалить.Добавить(СтрокаЗадача);
			КонецЕсли; 
		КонецЦикла; 
		
		Для каждого СтрокаУдалить Из СтрокиУдалить Цикл
			ТЧРабочиеЗадания.Удалить(СтрокаУдалить);
		КонецЦикла; 

	КонецЕсли; 	
	
	// Теперь перегоняем данные, введенные пользователем, в кэш.
	
	Для каждого СтрокаЗадача Из ТЧРабочиеЗадания Цикл

		СтрокиКэш = МРабочиеЗадания.НайтиСтроки(Новый Структура("РабочееЗадание, Задание", СтрокаЗадача.РабочееЗадание, СтрокаЗадача.Задание));
		
		Если СтрокиКэш.Количество() = 0 Тогда

			СтрокаКэш = МРабочиеЗадания.Добавить();
		Иначе
			СтрокаКэш = СтрокиКэш[0];
		КонецЕсли; 
		
		ЗаполнитьЗначенияСвойств(СтрокаКэш, СтрокаЗадача);
		
	КонецЦикла; 
		
	Если Не ЗначениеЗаполнено(ДеньНачалаНедели) Тогда
		ТЧРабочиеЗадания.Очистить();
	КонецЕсли; 	

	// Удаляем те задания, которые не вписались в срок, и 
	// добавляем новые, если они есть.
	
	ТаблицаЗапроса = ПолучитьРабочиеЗадания(ТрудовойРесурс, ДеньНачалаНедели, ДеньКонецНедели);
	
	Если ТаблицаЗапроса = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтрокиУдалить = Новый Массив();
	
	Для каждого СтрокаЗадача Из ТЧРабочиеЗадания Цикл

		СтрокиЗапроса = ТаблицаЗапроса.НайтиСтроки(Новый Структура("РабочееЗадание, РольРесурса, Задание",
			СтрокаЗадача.РабочееЗадание, СтрокаЗадача.РольРесурса, СтрокаЗадача.Задание));

		Если СтрокиЗапроса.Количество() = 0 Тогда
			СтрокиУдалить.Добавить(СтрокаЗадача);	
		КонецЕсли;
		
	КонецЦикла; 
	
	Для каждого СтрокаУдалить Из СтрокиУдалить Цикл
		
		// Удаляем также строки из ТЧ расшифровки.

		СтрокиРасшифровки = РасшифровкаТрудозатрат.НайтиСтроки(Новый Структура("РабочееЗадание, РольРесурса, Задание",
			СтрокаУдалить.РабочееЗадание, СтрокаУдалить.РольРесурса, СтрокаУдалить.Задание));
		Для каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
			РасшифровкаТрудозатрат.Удалить(СтрокаРасшифровки);
		КонецЦикла; 
		
		ТЧРабочиеЗадания.Удалить(СтрокаУдалить);
	КонецЦикла; 
	
	Для каждого СтрокаЗапроса Из ТаблицаЗапроса Цикл

		 СтрокиЗадач = ТЧРабочиеЗадания.НайтиСтроки(Новый Структура("РабочееЗадание, РольРесурса, Задание", 
		 	СтрокаЗапроса.РабочееЗадание, СтрокаЗапроса.РольРесурса, СтрокаЗапроса.Задание));

		 Если СтрокиЗадач.Количество() = 0 Тогда		
			 СтрокаЗадача = ТЧРабочиеЗадания.Добавить();
			 
			 // Если данные есть в кэше, забираем их оттуда.

			 СтрокиКэша = МРабочиеЗадания.НайтиСтроки(Новый Структура("РабочееЗадание, РольРесурса, Задание",
			 	СтрокаЗапроса.РабочееЗадание, СтрокаЗапроса.РольРесурса, СтрокаЗапроса.Задание));


			 Если НЕ СтрокиКэша.Количество() = 0 Тогда	
				 СтрокаКэш = СтрокиКэша[0]; 
				 ЗаполнитьЗначенияСвойств(СтрокаЗадача, СтрокаКэш);
				 				 
				 // В документах, которые заполнялись в редакции 1, могла остаться пустая роль
				 // и/или пустой проект.
				 
				 Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаЗадача.РольРесурса) Тогда
					СтрокаЗадача.РольРесурса = СтрокаЗапроса.РольРесурса;
					СтрокаЗадача.Проект = СтрокаЗапроса.ЭтоПроектнаяЗадача;
				КонецЕсли; 		

				Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаЗадача.Подразделение) Тогда
					СтрокаЗадача.Подразделение = СтрокаЗапроса.Подразделение;
				КонецЕсли;
			
				Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаЗадача.Проект) Тогда
					СтрокаЗадача.Проект = СтрокаЗапроса.Проект;
				КонецЕсли; 		
				
			Иначе
				ЗаполнитьЗначенияСвойств(СтрокаЗадача, СтрокаЗапроса);
			КонецЕсли; 			
		Иначе
			
			// В документах, которые заполнялись в редакции 1, могла остаться пустая роль
			// и/или пустой проект.
			
			СтрокаЗадача = СтрокиЗадач[0];
			
			Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаЗадача.РольРесурса) Тогда
				СтрокаЗадача.РольРесурса = СтрокаЗапроса.РольРесурса;
				СтрокаЗадача.ЭтоПроектнаяЗадача = СтрокаЗапроса.ЭтоПроектнаяЗадача;
			КонецЕсли; 		

			Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаЗадача.Подразделение) Тогда
				СтрокаЗадача.Подразделение = СтрокаЗапроса.Подразделение;
			КонецЕсли;
			
			Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаЗадача.Проект) Тогда
				СтрокаЗадача.Проект = СтрокаЗапроса.Проект;
			КонецЕсли; 		

		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Формирует таблицу из внепроектных задач.
//
// Параметры:
//  ТрудовойРесурс	 - СправочникСсылка.упоТрудовыеРесурсы.
//  ДеньНачалаНедели - Дата.
//  ДеньКонецНедели	 - Дата.
// 
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ЗаполнитьВнепроектныеЗадачи(ТрудовойРесурс, ДеньНачалаНедели, ДеньКонецНедели) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    СправочникупоЗадания.Код КАК Код,
		|    СправочникупоЗадания.Наименование КАК Наименование,
		|    СправочникупоЗадания.Автор КАК Автор,
		|    СправочникупоЗадания.АвторИзменений КАК АвторИзменений,
		|    СправочникупоЗадания.ДатаМодификации КАК ДатаМодификации,
		|    СправочникупоЗадания.ОписаниеЗадания КАК ОписаниеЗадания,
		|    упоСрокиЗаданий.ДатаНачалаПлан КАК ДатаНачалаПлан,
		|    упоСрокиЗаданий.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
		|    СправочникупоЗадания.Ссылка КАК Задача,
		|    СправочникупоЗадания.Роль КАК Роль,
		|    СправочникупоЗадания.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ОсновнаяТаблица
		|ИЗ
		|    РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоЗадания КАК СправочникупоЗадания
		|        ПО упоСрокиЗаданий.Задание = СправочникупоЗадания.Ссылка
		|ГДЕ
		|    СправочникупоЗадания.ВидЗадания = ЗНАЧЕНИЕ(Справочник.упоВидыЗаданий.Поручение)
		|    И СправочникупоЗадания.ПроектнаяЗадача = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
		|    И НЕ СправочникупоЗадания.ПометкаУдаления
		|    И упоСрокиЗаданий.ДатаНачалаПлан <= &ДатаОкончанияПлан
		|    И ВЫБОР
		|            КОГДА упоСрокиЗаданий.ДатаОкончанияПлан = ДАТАВРЕМЯ(1, 1, 1)
		|                ТОГДА ДАТАВРЕМЯ(3999, 1, 1)
		|            ИНАЧЕ упоСрокиЗаданий.ДатаОкончанияПлан
		|        КОНЕЦ >= &ДатаНачалаПлан
		|    И СправочникупоЗадания.Исполнитель = &Исполнитель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    ОсновнаяТаблица.Код КАК Код,
		|    ОсновнаяТаблица.Наименование КАК Наименование,
		|    ОсновнаяТаблица.Автор КАК Автор,
		|    ОсновнаяТаблица.АвторИзменений КАК АвторИзменений,
		|    ОсновнаяТаблица.ДатаМодификации КАК ДатаМодификации,
		|    ОсновнаяТаблица.ОписаниеЗадания КАК ОписаниеЗадания,
		|    ОсновнаяТаблица.ДатаНачалаПлан КАК ДатаНачалаПлан,
		|    ОсновнаяТаблица.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
		|    ОсновнаяТаблица.Задача КАК Задача,
		|    ОсновнаяТаблица.Роль КАК Роль,
		|    ОсновнаяТаблица.Подразделение КАК Подразделение
		|ИЗ
		|    ОсновнаяТаблица КАК ОсновнаяТаблица
		|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоЗаданияСтатусы.СрезПоследних КАК упоЗаданияСтатусыСрезПоследних
		|        ПО ОсновнаяТаблица.Задача = упоЗаданияСтатусыСрезПоследних.Задание
		|ГДЕ
		|    (ОсновнаяТаблица.ДатаНачалаПлан <> ДАТАВРЕМЯ(1, 1, 1)
		|            ИЛИ ОсновнаяТаблица.ДатаОкончанияПлан <> ДАТАВРЕМЯ(1, 1, 1)
		|            ИЛИ ЕСТЬNULL(упоЗаданияСтатусыСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.ПустаяССылка)) <> ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Завершено))
		|
		|УПОРЯДОЧИТЬ ПО
		|    ДатаНачалаПлан,
		|    Наименование";
	
	Запрос.УстановитьПараметр("Исполнитель", ТрудовойРесурс);
	Запрос.УстановитьПараметр("ДатаНачалаПлан", ДеньНачалаНедели);
	Запрос.УстановитьПараметр("ДатаОкончанияПлан", ДеньКонецНедели);
	
	ТаблицаВнепроектныеЗадачи = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаВнепроектныеЗадачи;
	
КонецФункции

// Выводит сообщение пользователю .
//
// Параметры:
//	РезультатЗапроса 		- Результат выполнения запроса
//	ТрудовойРесурс 			- Справочник.упоТрудовыеРесурсы
Процедура СообщитьОбОшибкахПроверкиПриПроведении(РезультатЗапроса, ТрудовойРесурс) Экспорт
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтрокиСообщения = Новый Массив;
	ТекстСообщения = НСтр("ru = 'По трудовому ресурсу %1 обнаружено превышение допустимого количества списываемых за день часов (в системе включено 24 часовое ограничение):
	|
	|'");	
	СтрокиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТрудовойРесурс));
	ШаблонТекстаЕдЧисло = НСтр("ru = 'На %1 уже списано %2 документом: '");
	ШаблонТекста = НСтр("ru = 'На %1 уже списано %2. По документам: '");
	ШаблонСписано = НСтр("ru = ' списано %1'");
	ШаблонСписанияПревышения = НСтр("ru = 'Текущим документом списывается %1, превышение на %2.'");
	Пока Выборка.СледующийПоЗначениюПоля("День") Цикл
		
		ШаблонТекстаСообщения = ?(Выборка.КоличествоРегистраторов = 1, ШаблонТекстаЕдЧисло, ШаблонТекста);
		СтрокиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,
																						 Формат(Выборка.День, "ДФ=dd.MM.yyyy"),
																						 Выборка.ТрудозатратыТекущие));																						 
		ТекстСписанияПревышения	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСписанияПревышения,
			Выборка.ТрудозатратыДокументаВДень, Выборка.Превышение);																			 
		Пока Выборка.СледующийПоЗначениюПоля("Регистратор") Цикл
			СтрокиСообщения.Добавить(Выборка.Регистратор);
			Если Выборка.КоличествоРегистраторов > 1 Тогда
				СтрокиСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСписано, Выборка.Трудозатраты));
			КонецЕсли;
			СтрокиСообщения.Добавить("; ");
		КонецЦикла;
		
		СтрокиСообщения.Удалить(СтрокиСообщения.Количество() - 1);
		
		СтрокиСообщения.Добавить(Символы.ПС);		
		СтрокиСообщения.Добавить(ТекстСписанияПревышения);
		СтрокиСообщения.Добавить(Символы.ПС);
		СтрокиСообщения.Добавить(Символы.ПС);
		
	КонецЦикла;
		
	ТекстСообщения = СокрП(СтрСоединить(СтрокиСообщения));
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

// Возвращает время начала дня.
// 
// Возвращаемое значение:
//  Дата
//
Функция ПолучитьВремяНачалаДня() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	ВремяНачалаРабочегоДня = Константы.упоВремяНачалаРабочегоДня.Получить();	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не ЗначениеЗаполнено(ВремяНачалаРабочегоДня) Тогда
		ВремяНачалаРабочегоДня = Дата("00010101090000"); //09:00:00
	КонецЕсли;
	
	Возврат ВремяНачалаРабочегоДня;
	
КонецФункции

// Возвращает таблицу трудовых ресурсов с выбранным уровнем планирования.
//
// Параметры:
//  ИсходнаяТаблицаТрудовыхРесурсов		 - ТаблицаЗначений
//  КолонкаСтоимости					 - Строка
//  УровеньПланированияТрудозатратДляБДР - Перечисление.упоУровеньПланированияТрудозатратДляБДР, Перечисление.упоУровеньПланирования
// 
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаТрудовыхРесурсовПоУровням(ИсходнаяТаблицаТрудовыхРесурсов, КолонкаСтоимости, УровеньПланированияТрудозатратДляБДР = Неопределено) Экспорт
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапросаТрудовыеРесурсыПоУровнямПланирования(КолонкаСтоимости));
	
	КоличествоПолей = СхемаЗапроса.ПакетЗапросов[0].Колонки.Количество();
	
	ПоляВыбора = Новый Структура;
	ПоляВыбора.Вставить("ЕдиницаНормирования", "ЕдиницаНормирования");
	
	Сч = 0;
	Для Каждого ПолеВыбора Из ПоляВыбора Цикл
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Добавить("ТаблицаТрудовыеРесурсы." + ПолеВыбора.Ключ);
		СхемаЗапроса.ПакетЗапросов[0].Колонки[КоличествоПолей + Сч].Псевдоним = ПолеВыбора.Значение;
		СхемаЗапроса.ПакетЗапросов[2].Операторы[0].ВыбираемыеПоля.Добавить("ТаблицаТрудовыеРесурсы." + ПолеВыбора.Значение);
		Сч = Сч + 1;
	КонецЦикла;
	
	СхемаЗапроса.ПакетЗапросов[2].Операторы[0].Отбор[0] = Новый ВыражениеСхемыЗапроса(
			"	ВЫБОР
			|		КОГДА &ВыбранУровеньПланирования
			|			ТОГДА ТаблицаТрудовыеРесурсы.УровеньПланирования = &УровеньПланирования
			|		КОГДА 1 В
			|				(ВЫБРАТЬ
			|					ВТДанныеОкончательногоУровня.Поле1
			|				ИЗ
			|					ВТДанныеОкончательногоУровня)
			|			ТОГДА ТаблицаТрудовыеРесурсы.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
			|		ИНАЧЕ ТаблицаТрудовыеРесурсы.УровеньПланирования <> ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
			|	КОНЕЦ");
	
	Если ТипЗнч(УровеньПланированияТрудозатратДляБДР)
		= Тип("ПеречислениеСсылка.упоУровеньПланированияТрудозатратДляБДР") Тогда
		УровеньПланирования = УровеньПланированияПоУровнюПланированияТрудозатратДляБДР(УровеньПланированияТрудозатратДляБДР);
	Иначе
		УровеньПланирования = УровеньПланированияТрудозатратДляБДР;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаТрудовыеРесурсы", ИсходнаяТаблицаТрудовыхРесурсов);
	Запрос.УстановитьПараметр("ВыбранУровеньПланирования", ЗначениеЗаполнено(УровеньПланирования));
	Запрос.УстановитьПараметр("УровеньПланирования", УровеньПланирования);
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Получает поручения.
//
// Параметры:
//  ДатаНачала 		- Дата - Дата начала.
//  ДатаОкончания 	- Дата - Дата окончания. 
//  Ресурс 			- СправочникСсылка.упоТрудовыеРесурсы - трудовой ресурс.
//
// Возвращаемое значение:
//  ТаблицаЗначений	- найденные рабочие задания.
//
Функция ПолучитьИЗаполнитьПоручения(ДатаНачала, ДатаОкончания, Ресурс) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникупоЗадания.Код КАК Код,
	|	СправочникупоЗадания.Наименование КАК Наименование,
	|	СправочникупоЗадания.Автор КАК Автор,
	|	СправочникупоЗадания.АвторИзменений КАК АвторИзменений,
	|	СправочникупоЗадания.ДатаМодификации КАК ДатаМодификации,
	|	СправочникупоЗадания.ОписаниеЗадания КАК ОписаниеЗадания,
	|	упоСрокиЗаданий.ДатаНачалаПлан КАК ДатаНачалаПлан,
	|	упоСрокиЗаданий.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
	|	СправочникупоЗадания.Ссылка КАК Задача
	|ПОМЕСТИТЬ ОсновнаяТаблица
	|ИЗ
	|	РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоЗадания КАК СправочникупоЗадания
	|		ПО упоСрокиЗаданий.Задание = СправочникупоЗадания.Ссылка
	|ГДЕ
	|	СправочникупоЗадания.ВидЗадания = ЗНАЧЕНИЕ(Справочник.упоВидыЗаданий.Поручение)
	|	И СправочникупоЗадания.ПроектнаяЗадача = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	|	И НЕ СправочникупоЗадания.ПометкаУдаления
	|	И упоСрокиЗаданий.ДатаНачалаПлан <= &ДатаОкончанияПлан
	|	И ВЫБОР
	|			КОГДА упоСрокиЗаданий.ДатаОкончанияПлан = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ДАТАВРЕМЯ(3999, 1, 1)
	|			ИНАЧЕ упоСрокиЗаданий.ДатаОкончанияПлан
	|		КОНЕЦ >= &ДатаНачалаПлан
	|	И СправочникупоЗадания.Исполнитель = &Исполнитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновнаяТаблица.Код КАК Код,
	|	ОсновнаяТаблица.Наименование КАК Наименование,
	|	ОсновнаяТаблица.Автор КАК Автор,
	|	ОсновнаяТаблица.АвторИзменений КАК АвторИзменений,
	|	ОсновнаяТаблица.ДатаМодификации КАК ДатаМодификации,
	|	ОсновнаяТаблица.ОписаниеЗадания КАК ОписаниеЗадания,
	|	ОсновнаяТаблица.ДатаНачалаПлан КАК ДатаНачалаПлан,
	|	ОсновнаяТаблица.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
	|	ОсновнаяТаблица.Задача КАК Задача
	|ИЗ
	|	ОсновнаяТаблица КАК ОсновнаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоЗаданияСтатусы.СрезПоследних КАК упоЗаданияСтатусыСрезПоследних
	|		ПО ОсновнаяТаблица.Задача = упоЗаданияСтатусыСрезПоследних.Задание
	|ГДЕ
	|	(ОсновнаяТаблица.ДатаНачалаПлан <> ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ОсновнаяТаблица.ДатаОкончанияПлан <> ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕСТЬNULL(упоЗаданияСтатусыСрезПоследних.Статус, ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.ПустаяССылка)) <> ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Завершено))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачалаПлан,
	|	Наименование";
	
	Запрос.УстановитьПараметр("ДатаНачалаПлан", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончанияПлан", ДатаОкончания);
	Запрос.УстановитьПараметр("Исполнитель", Ресурс);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	Возврат РезультатЗапроса.Выгрузить();	
	
КонецФункции

#КонецОбласти

#Область ОтражениеПлановыхТрудозатрат

// Вызывает отложенное или оперативное отражение плановых трудозатрат в зависимости от настройки системы.
//
// Параметры:
//  Предмет					 - ДокументСсылка.упоПроектнаяЗадача, Массив - предмет отражения - одна или несколько проектных задач.
//  Источник				 - ДокументСсылка - документ-источник изменений в плановых трудозатратах 
// 		(см. регистраторы регистра упоДанныеПлановТрудозатратРолей).
//  НезаписанныеСрокиЗадач	 - Соответствие
//  НезаписанныеДанныеЗадач	 - Соответствие
//  ДвиженияДокумента		 - Движения
//
Процедура ОтразитьПлановыеТрудозатратыЗадачи(Предмет, Источник, 
	НезаписанныеСрокиЗадач = Неопределено, 
	НезаписанныеДанныеЗадач = Неопределено,
	ДвиженияДокумента = Неопределено) Экспорт
	
	ПроверитьПараметрОтраженияСИсключением(Предмет);

	Если упоРаботаСОчередямиВызовСервера.ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат() Тогда
		
		ДобавитьВОчередьОтраженияПлановыхТрудозатратЗадач(Предмет, Источник);
		
	Иначе
		
		лОтразитьПлановыеТрудозатратыЗадачи(Предмет, НезаписанныеСрокиЗадач, НезаписанныеДанныеЗадач, ДвиженияДокумента);
		
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает проведение документов "Регистрация стоимости ресурса" и "Регистрация стоимости ресурсов".
// Ставим проектные задачи, в которых запланированы трудозатраты по роли или трудовому ресурсу, в очередь
// к отражению или актуализируем трудозатраты сразу, в зависимости от опции 
// "ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат". Попадают только те задачи, в проекте которых указано
// "УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат" или задана константа в параметрах РМ,
// задача не отменена, задача не в статусе "Закрыта" или "Завершена" и период изменения стоимости ресурса
// попадает в сроки задачи.
//
// Параметры:                    
//  Источник  - ДокументОбъект - документ "Регистрация стоимости ресурса" или "Регистрация стоимости ресурсов".
//  Отказ  - Булево - флаг отказа.
//  РежимПроведения  - РежимПроведенияДокумента - режим проведения документа.
//
Процедура РегистрацияСтоимостиРесурсовОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ОтразитьТрудозатратыПриИзмененииНормСтоимости(Источник, Отказ);
	
КонецПроцедуры

// Обрабатывает отмену проведения документов "Регистрация стоимости ресурса" и "Регистрация стоимости ресурсов".
// Ставим проектные задачи, в которых запланированы трудозатраты по роли или трудовому ресурсу, в очередь
// к отражению или актуализируем трудозатраты сразу, в зависимости от опции 
// "ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат". Попадают только те задачи, в проекте которых указано
// "УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат" или задана константа в параметрах РМ,
// задача не отменена, задача не в статусе "Закрыта" или "Завершена" и период изменения стоимости ресурса
// попадает в сроки задачи.
//
// Параметры:
//  Источник  - ДокументОбъект - документ "Регистрация стоимости ресурса" или "Регистрация стоимости ресурсов".
//  Отказ  - Булево - флаг отказа.
//
Процедура РегистрацияСтоимостиРесурсовУдалениеПроведения(Источник, Отказ) Экспорт
	
	ОтразитьТрудозатратыПриИзмененииНормСтоимости(Источник, Отказ);
	
КонецПроцедуры

#КонецОбласти

// См. ПолучитьТаблицыРаспределенияТрудозатрат
//
Функция ПолучитьТаблицыРаспределенияТрудозатратПрокси(ВхДанные) Экспорт
	
	Если ТипЗнч(ВхДанные) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.СвернутьМассив(ВхДанные);
		Возврат ПолучитьТаблицыРаспределенияТрудозатрат(ВхДанные);
	Иначе
		Возврат упоРаспределениеТрудозатратПовтИспВыз.ПолучитьТаблицыРаспределенияТрудозатрат(ВхДанные);
	КонецЕсли;
		
КонецФункции

// Строит таблицы распределения трудозатрат по профилям.
//
// Параметры:
//  ВхДанные - СправочникСсылка.упоПрофилиРаспределенияТрудозатрат, Массив	 - одиночный профиль распределения или массив,
//  	в случае, если нужно получить для нескольких профилей сразу.
// 
// Возвращаемое значение:
//  ТаблицаЗначений, ДеревоЗначений - сформированные таблицы.
//
Функция ПолучитьТаблицыРаспределенияТрудозатрат(ВхДанные) Экспорт
	
	// Разбираем входные данные и формируем структуру результата.
	
	ЭтоМассив = Неопределено;
	
	Результат = Новый ДеревоЗначений();
	Результат.Колонки.Добавить("Профиль");
	Результат.Колонки.Добавить("Загрузка");
	Результат.Колонки.Добавить("Трудозатраты");
	
	Если ТипЗнч(ВхДанные) = Тип("СправочникСсылка.упоПрофилиРаспределенияТрудозатрат") Тогда
		
		ЭтоМассив = Ложь; 		
		НоваяСтрока = Результат.Строки.Добавить();
		НоваяСтрока.Профиль = ВхДанные;
		
	ИначеЕсли ТипЗнч(ВхДанные) = Тип("Массив") Тогда
		
		// На всякий случай "свернем" массив, т.к. в исходных данных могли прийти дублирующеся элементы.
		
		НоваяТаблица = Новый ТаблицаЗначений();
		НоваяТаблица.Колонки.Добавить("Профиль");
		
		Для Счетчик = 1 По ВхДанные.Количество() Цикл
			НоваяТаблица.Добавить();
		КонецЦикла; 
		
		НоваяТаблица.ЗагрузитьКолонку(ВхДанные, "Профиль");
		НоваяТаблица.Свернуть("Профиль");
		
		ЭтоМассив = Истина;
		Для Счетчик = 1 По ВхДанные.Количество() Цикл
			Результат.Строки.Добавить();		
		КонецЦикла; 		
		Результат.Строки.ЗагрузитьКолонку(НоваяТаблица.ВыгрузитьКолонку("Профиль"), "Профиль");
		
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабПрофиль.Трудозатраты,
	|	ТабПрофиль.Загрузка,
	|	ТабПрофиль.Ссылка КАК Профиль
	|ИЗ
	|	Справочник.упоПрофилиРаспределенияТрудозатрат.ТаблицаРаспределения КАК ТабПрофиль
	|ГДЕ
	|	ТабПрофиль.Ссылка В(&СписокПрофилей)
	|	И ТабПрофиль.Ссылка.СпособРаспределения = Значение(Перечисление.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределения)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТабПрофиль.Трудозатраты,
	|	ТабПрофиль.ДоляПериода,
	|	ТабПрофиль.Ссылка КАК Профиль
	|ИЗ
	|	Справочник.упоПрофилиРаспределенияТрудозатрат.ТаблицаРаспределенияПоПериоду КАК ТабПрофиль
	|ГДЕ
	|	ТабПрофиль.Ссылка В(&СписокПрофилей)
	|	И ТабПрофиль.Ссылка.СпособРаспределения = Значение(Перечисление.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределенияСПериодами)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	100,
	|	СпрПрофиль.ЗагрузкаДляЛинейногоРаспределения,
	|	СпрПрофиль.Ссылка
	|ИЗ
	|	Справочник.упоПрофилиРаспределенияТрудозатрат КАК СпрПрофиль
	|ГДЕ
	|	СпрПрофиль.Ссылка В(&СписокПрофилей)
	|	И СпрПрофиль.СпособРаспределения = Значение(Перечисление.упоСпособРаспределенияТрудозатрат.РавномерноПоДням)";
	
	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("СписокПрофилей", ВхДанные);
	
	РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаДанных = Результат.Строки.Найти(Выборка.Профиль, "Профиль");
		Если НЕ СтрокаДанных = Неопределено Тогда
			СтрокаРезультат = СтрокаДанных.Строки.Добавить();
			СтрокаРезультат.Загрузка = Выборка.Загрузка;
			СтрокаРезультат.Трудозатраты = Выборка.Трудозатраты;
		КонецЕсли; 		
	КонецЦикла; 
	
	Если ЭтоМассив Тогда
		Возврат Результат;		
	Иначе
		Возврат Результат.Строки[0].Строки;
	КонецЕсли; 
	
КонецФункции

// Производит распределение трудозатрат в соответствии с
//  заданными профилями распределения.
//
// Параметры:
//  ТрудовыеРесурсы	 - ТаблицаЗначений - ресурсы, трудозатраты и профили для распределения.
//  Календарь		 - Справочник.упоРабочиеКалендари, Справочник.Проекты	 - календарь
//  	для определения рабочих дней и часов; проект - в этом случае
//  	календарь определяется по регистру сведений.
//  ДатаНачала		 - Дата - начало периода распределения.
//  ДатаЗавершения	 - Дата - завершение периода распределения.
//  ВывестиСообщение - Булево - флаг вывода сообщения
//  	в случае, если календарь не найден.
// 
// Возвращаемое значение:
//  ДеревоЗначений, Неопределено - данные распределения трудозатрат по дням.
//
Функция РаспределитьТрудозатратыПоПрофилям(Знач ТрудовыеРесурсы, Знач Календарь, ДатаНачала,
	ДатаЗавершения = Неопределено, ВывестиСообщение = Истина) Экспорт

	// Данные рабочих календарей будем кэшировать по мере расчета.
	
	РабочийКалендарь = ПолучитьРабочийКалендарь(Календарь);
	Если РабочийКалендарь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	// Получаем данные профилей распределения, всех сразу.
	
	МассивПрофилейРаспределения = ТрудовыеРесурсы.ВыгрузитьКолонку("ПрофильРаспределения");
	
	ДанныеПрофилей = ПолучитьТаблицыРаспределенияТрудозатрат(МассивПрофилейРаспределения);
	
	// Работать будем не с переданной таблицей (это может быть и табличная
	// часть документа), а с собственной копией.
	ДанныеТрудозатрат = ПодготовитьТаблицуДанныеТрудозатрат(ТрудовыеРесурсы);
	
	// Поддерживаются два вида расчета:
	// 1) Задана только дата начала, дата завершения пустая.
	//    В этом случае рабочие дни и количество рабочих часов
	//    берется из рабочего календаря. Результатом расчета,
	//    помимо таблиц распределения, является дата завершения.
	// 2) Заданы и дата начала, и дата завершения. Смысл расчета
	//    состоит в том, чтобы "запихнуть" указанные трудозатраты
	//    в указанный период. При этом для любого трудового ресурса
	//    возможно сколь угодно большое превышение начисленных часов
	//    над количеством часов, которые были заданы в календаре.
	
	ОбратныйРасчет = НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ДатаЗавершения);
	
	ДанныеПериода = Новый Структура();
	
	Если ОбратныйРасчет Тогда
		// Вычисляем общее количество рабочих дней, которые содержатся
		// в заданном периоде.
		ДанныеПериода = упоРабочиеКалендариВызовСервера.обКоличествоРабочихДнейИЧасовВПериоде(РабочийКалендарь, ДатаНачала, ДатаЗавершения);		
	КонецЕсли; 
	
	// Рассчитаем данные для колонок ТЗ ДанныеТрудозатрат, например, таких как
	// "ПерегрузкаРесурса", "КоличествоЧасовПериода" и др.
	ДополнитьТаблицуДанныеТрудозатрат(ДанныеТрудозатрат, ДанныеПериода, ДанныеПрофилей, ОбратныйРасчет);
	
	// Данные, которые буду возвращены данной функцией.
	ТрудозатратыПоПрофилям = Неопределено;
	
	// Подготавливаем начальные данные рабочих календарей.
	ДанныеКалендаря = Новый Структура();
	Если ЗаполнитьДанныеКалендаря(ДанныеКалендаря, РабочийКалендарь, ДатаНачала, ДатаЗавершения,
		ВывестиСообщение, ОбратныйРасчет) Тогда
		
		// Строим общую таблицу исходных данных с учетом настроек профилей распределения.
		ДанныеРаспределения = ПолучитьДанныеРаспределения(ДанныеПрофилей, ДанныеТрудозатрат, ОбратныйРасчет);
		
		// Получим данные расчета или Неопределено в случае неудачи.
		ТрудозатратыПоПрофилям = ПолучитьДанныеРасчетаТрудозатратПоПрофилям(ДатаНачала, ДатаЗавершения, РабочийКалендарь, 
			ДанныеКалендаря, ДанныеТрудозатрат, ДанныеРаспределения, ОбратныйРасчет, ВывестиСообщение);
		
	КонецЕсли;
		
	Возврат ТрудозатратыПоПрофилям;	

КонецФункции

// Возвращает ссылку на профиль распределения, найденный по проценту загрузки.
//
// Параметры:
//  ПроцентЗагрузки	 - Число – процент загрузки.
// 
// Возвращаемое значение:
//  Справочник.упоПрофилиРаспределенияТрудозатрат - ссылка на профиль распределения.
//
Функция НайтиПрофильРаспределенияПоПроценту(ПроцентЗагрузки) Экспорт
	
	// Предполагаем, что процент означает, равномерную загрузку.
	// Равномерная загрузка на период.
	
	// Процент должен быть целым числом от 1 до 100.
	ПриведенныйПроцент = Цел(ПроцентЗагрузки);
	Если ПриведенныйПроцент < 1 Тогда
		ПриведенныйПроцент = 1;
	КонецЕсли;
	Если ПриведенныйПроцент > 100 Тогда
		ПриведенныйПроцент = 100;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Табл.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.упоПрофилиРаспределенияТрудозатрат.ТаблицаРаспределенияПоПериоду КАК Табл
	               |ГДЕ
	               |	Табл.Ссылка.ЗагруженИзMSP
	               |	И Табл.ДоляПериода = 100
	               |	И Табл.Трудозатраты = &Трудозатраты
	               |	И Табл.Ссылка.СпособРаспределения = ЗНАЧЕНИЕ(Перечисление.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределенияСПериодами)
	               |	И НЕ Табл.Ссылка.ПометкаУдаления";
	Запрос.УстановитьПараметр("Трудозатраты", ПриведенныйПроцент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// Раз мы зашли сюда, то надо создать профиль распределения.
	НовыйПрофиль = Справочники.упоПрофилиРаспределенияТрудозатрат.СоздатьЭлемент();
	НовыйПрофиль.СпособРаспределения = Перечисления.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределенияСПериодами;
	НовыйПрофиль.Наименование = НСтр("ru = 'Равномерно '") + Строка(ПриведенныйПроцент) 
		+ НСтр("ru = '% по 100% периоду (из MS Project)'");
	НовыйПрофиль.ЗагруженИзMSP = Истина;
	
	НоваяСтрокаРаспределения = НовыйПрофиль.ТаблицаРаспределенияПоПериоду.Добавить();
	НоваяСтрокаРаспределения.ДоляПериода = 100;
	НоваяСтрокаРаспределения.Трудозатраты = ПриведенныйПроцент;
	
	НовыйПрофиль.Комментарий = НСтр("ru = 'Создан автоматически при импорте из MS Project'");
	НовыйПрофиль.Записать();
	
	Возврат НовыйПрофиль.Ссылка;
	
КонецФункции

// Проверяет возможность списания фактических трудозатрат 
// по задачам в статусе "Завершена" или "Закрыта" и заданиям в статусе "Закрыто"
//
// Параметры:
//	ПроектныеЗадачи - Массив - Проектные задачи для проверки.		 
//	Задания - Массив - Задания для проверки.		 
//  Отказ	- Булево - признак отказа.
//
Процедура ПроверитьВозможностьСписанияФактическихЗатратПоЗакрытымЗадачам(ПроектныеЗадачи, 
	Задания, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачи
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСтатусыПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |ГДЕ
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи В(&СтатусыЗадачи)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоЗаданияСтатусыСрезПоследних.Задание КАК Задание,
	               |	упоЗаданияСтатусыСрезПоследних.Статус КАК СтатусЗадания,
	               |	упоЗаданияСтатусыСрезПоследних.Задание.Представление КАК ЗаданиеПредставление
	               |ИЗ
	               |	РегистрСведений.упоЗаданияСтатусы.СрезПоследних(, Задание В (&Задания)) КАК упоЗаданияСтатусыСрезПоследних
	               |ГДЕ
	               |	упоЗаданияСтатусыСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыЗаданий.Закрыто)"; 
	
	СтатусыЗадачи = Новый Массив;
	СтатусыЗадачи.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Завершена);
	СтатусыЗадачи.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	
	Запрос.УстановитьПараметр("СтатусыЗадачи", СтатусыЗадачи);
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ПроектныеЗадачи);
	Запрос.УстановитьПараметр("Задания", Задания);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[0].Пустой()
		И РезультатЗапроса[1].Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если Не РезультатЗапроса[0].Пустой() Тогда
		ШаблонТекста = НСтр("ru = 'По проектной задаче %1 нельзя вносить изменения фактических трудозатрат, т.к. она находится в статусе %2.'");
		Выборка = РезультатЗапроса[0].Выбрать();
		Пока Выборка.Следующий() Цикл   
			ИмяЗадачи = упоПроектыИЗадачиСервер.НазваниеПроектнойЗадачи(Выборка.ПроектнаяЗадача, Истина);
			ТекстСообщения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
								ШаблонТекста,
								ИмяЗадачи,
								Выборка.СтатусЗадачи);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
	КонецЕсли;	
	
	Если Не РезультатЗапроса[1].Пустой() Тогда
		ШаблонТекста = НСтр("ru = 'По заданию ""%1"" нельзя вносить изменения фактических трудозатрат, т.к. оно находится в статусе %2.'");
		Выборка = РезультатЗапроса[1].Выбрать();
		Пока Выборка.Следующий() Цикл   
			ТекстСообщения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
								ШаблонТекста,
								Выборка.Задание,
								Выборка.СтатусЗадания);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
	КонецЕсли;	
		
КонецПроцедуры	

// Проверяет возможность списания фактических трудозатрат 
// по задачам проекта в статусе "Остановлен"
//
// Параметры:
//	ДанныеПроверки - ТаблицаЗначений - проектные задачи для проверки.
//	Сотрудник - Справочник.упоСтрудники - сотрудник, который списывает фактические трудозатраты.
//  Отказ	- Булево - признак отказа.
//
Процедура ПроверитьВозможностьСписанияФактическихЗатратПоОстановленнымПроектам(ДанныеПроверки, 
	Сотрудник, Отказ) Экспорт

	ПроверитьВозможностьСписанияФактическихЗатратПоПроектамСУчетомСтатуса(ДанныеПроверки,
		Сотрудник,
		"Остановлен",
		Отказ);
	
КонецПроцедуры

// Проверяет возможность списания фактических трудозатрат 
// по задачам проекта в заданных статусах.
//
// Параметры:
//	ДанныеПроверки - ТаблицаЗначений - проектные задачи для проверки.
//	Сотрудник - Справочник.упоСтрудники - сотрудник, который списывает фактические трудозатраты.
//	СтрокаСтатусов - Строка - статусы проекта.
//  Отказ	- Булево - признак отказа.
//
Процедура ПроверитьВозможностьСписанияФактическихЗатратПоПроектамСУчетомСтатуса(ДанныеПроверки, 
	Сотрудник, СтрокаСтатусов, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
		
	Запрос = Новый Запрос; 
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ДанныеПроверки.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДанныеПроверки.Проект КАК Проект,
	               |	ДанныеПроверки.ДатаСтатуса КАК ДатаПроверкиСтатуса
	               |ПОМЕСТИТЬ Данные
	               |ИЗ
	               |	&ДанныеПроверки КАК ДанныеПроверки
	               |ГДЕ
	               |	ДанныеПроверки.ДатаСтатуса <> ДАТАВРЕМЯ(1, 1, 1)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Данные.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Данные.Проект КАК Проект,
	               |	Данные.ДатаПроверкиСтатуса КАК ДатаПроверкиСтатуса,
	               |	МАКСИМУМ(упоСтатусыПроектов.Период) КАК ПериодСтатусаПроектаНаДату
	               |ПОМЕСТИТЬ ВТ_СтатусыПроектаНаДатуПроверки
	               |ИЗ
	               |	Данные КАК Данные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов КАК упоСтатусыПроектов
	               |		ПО Данные.Проект = упоСтатусыПроектов.Проект
	               |ГДЕ
	               |	НачалоПериода(упоСтатусыПроектов.Период) <= Данные.ДатаПроверкиСтатуса
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Данные.ПроектнаяЗадача,
	               |	Данные.Проект,
	               |	Данные.ДатаПроверкиСтатуса
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Данные.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Данные.Проект КАК Проект,
	               |	Данные.ДатаПроверкиСтатуса КАК ДатаПроверкиСтатуса,
	               |	ЕСТЬNULL(упоСтатусыПроектов.СтатусПроекта, ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Запланирован)) КАК СтатусПроекта
	               |ПОМЕСТИТЬ ВТ_СтатусПроектовНаДатуИтоговая
	               |ИЗ
	               |	Данные КАК Данные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыПроектаНаДатуПроверки КАК ВТ_СтатусыПроектаНаДатуПроверки
	               |		ПО Данные.ПроектнаяЗадача = ВТ_СтатусыПроектаНаДатуПроверки.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов КАК упоСтатусыПроектов
	               |		ПО (ВТ_СтатусыПроектаНаДатуПроверки.Проект = упоСтатусыПроектов.Проект)
	               |			И (ВТ_СтатусыПроектаНаДатуПроверки.ПериодСтатусаПроектаНаДату = упоСтатусыПроектов.Период)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_СтатусПроектовНаДатуИтоговая.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВТ_СтатусПроектовНаДатуИтоговая.Проект КАК Проект,
	               |	ВТ_СтатусПроектовНаДатуИтоговая.СтатусПроекта КАК СтатусПроекта
	               |ПОМЕСТИТЬ ВТ_ПроектыСОтборомПоСтатусам
	               |ИЗ
	               |	ВТ_СтатусПроектовНаДатуИтоговая КАК ВТ_СтатусПроектовНаДатуИтоговая
	               |ГДЕ
	               |	ВТ_СтатусПроектовНаДатуИтоговая.СтатусПроекта В(&Статусы)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ПроектыСОтборомПоСтатусам.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВТ_ПроектыСОтборомПоСтатусам.Проект КАК Проект,
	               |	ВТ_ПроектыСОтборомПоСтатусам.СтатусПроекта КАК СтатусПроекта
	               |ИЗ
	               |	ВТ_ПроектыСОтборомПоСтатусам КАК ВТ_ПроектыСОтборомПоСтатусам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних КАК упоРуководителиПроектов
	               |		ПО ВТ_ПроектыСОтборомПоСтатусам.Проект = упоРуководителиПроектов.Проект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоНастройкаАналитикиВРазрезеПодразделений КАК упоНастройкаАналитикиВРазрезеПодразделений
	               |		ПО ВТ_ПроектыСОтборомПоСтатусам.Проект = упоНастройкаАналитикиВРазрезеПодразделений.Объект";
	
	Статусы = Новый Массив;
	
	Если СтрокаСтатусов = "Остановлен" Тогда
		Статусы.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Остановлен);
		
		ТекстУсловия = "
			|ГДЕ
			|	(НЕ упоНастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен
			|			ИЛИ упоНастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен
			|				И упоРуководителиПроектов.РуководительПроекта <> &Сотрудник)";
		
	ИначеЕсли СтрокаСтатусов = "ЗапланированУтвержден" Тогда
		Статусы.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Запланирован);
		Статусы.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Утвержден);
		
		ТекстУсловия = "
			|ГДЕ
			|	(НЕ упоНастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусахЗапланированУтвержден)";
		
	Иначе
		ТекстИсключения = НСтр("ru = 'Передана строка статусов, для которой не предусмотрена обработка.'");
		ВызватьИсключение(ТекстИсключения);
		
	КонецЕсли;
	
	ЧастиТекстаЗапроса = Новый Массив;
	ЧастиТекстаЗапроса.Добавить(ТекстЗапроса);
	ЧастиТекстаЗапроса.Добавить(ТекстУсловия);
	
	Запрос.Текст = СтрСоединить(ЧастиТекстаЗапроса, Символы.ПС);	
	Запрос.УстановитьПараметр("ДанныеПроверки", ДанныеПроверки);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Запрос.Параметры.Вставить("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ШаблонТекста = НСтр("ru = 'По проектной задаче %1 нельзя вносить изменения фактических трудозатрат, т.к. проект находится в статусе ""%2"".'");
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ИмяЗадачи = упоПроектыИЗадачиСервер.НазваниеПроектнойЗадачи(Выборка.ПроектнаяЗадача, Истина);
		ТекстСообщения = СтрШаблон(ШаблонТекста, ИмяЗадачи, Выборка.СтатусПроекта);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
	
КонецПроцедуры

// Получить таблицу распределения по периодам сводно
//
// Параметры:
//  ПериодАгрегации - ПеречислениеСсылка.упоПериодыАгрегацииЗатрат	 -  период агрегации
//  Дата		 - Дата	 		- дата периода
//  Сумма		 - Число	 	- сумма
// 
// Возвращаемое значение:
//  ТаблицаЗначений - таблица результат
//
Функция ПолучитьТаблицуРаспределенияПоПериодамСводно(ПериодАгрегации, Дата, Сумма) Экспорт 
	
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("Период");
	Результат.Колонки.Добавить("Сумма");
	
	НоваяСтрока = Результат.Добавить();
	НоваяСтрока.Период = КонецПериодаАгрегации(Дата, ПериодАгрегации);
	НоваяСтрока.Сумма = Сумма;
	
	Возврат Результат;
	
КонецФункции

// Заполняет план расходов по трудовым ресурсам.
// Вызывается интерактивно по команде заполнения в формах проектной задачи.
//
// Параметры:
//  Проект                                  - СправочникСсылка.Проекты
//  ПроектнаяЗадача                         - ДокументСсылка.упоПроектнаяЗадача
//  ТаблицаТрудовыеРесурсы                  - ТаблицаЗначений
//  ТаблицаТрудовыеРесурсыПоПериодам        - ТаблицаЗначений
//  ТаблицаПланРасходов                     - ТаблицаЗначений
//  ТаблицаРаспределениеРасходов            - ТаблицаЗначений, ДанныеФормыКоллекция
//  СтартовыйИндекс                         - Число - стартовый индекс распределения строк плана расходов.
//  СвернутьПоСтатьям                       - Булево - определяет, сворачивать ли основную ТЧ плана расходов по статьям.
//  УчитыватьПериодРегистрацииНормСтоимости - Булево
//
Процедура ЗаполнитьПланРасходовПоТрудовымРесурсам(Проект, ПроектнаяЗадача,
		ТаблицаТрудовыеРесурсы,
		ТаблицаТрудовыеРесурсыПоПериодам,
		ТаблицаПланРасходов,
		ТаблицаРаспределениеРасходов,
		СтартовыйИндекс = Неопределено,
		СвернутьПоСтатьям = Истина,
		УчитыватьПериодРегистрацииНормСтоимости = Ложь) Экспорт
	
	ЗначенияПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект);
	ДатыПроектнойЗадачи = упоПроектыИЗадачиСервер.ПолучитьСрокиПроектнойЗадачи(ПроектнаяЗадача);
	ВнутренняяНормаСтоимости = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача,
			"НормаСтоимостиТрудовыхРесурсов");
	
	Если НЕ ЗначениеЗаполнено(ВнутренняяНормаСтоимости) Тогда
		ТекстСообщения = НСтр("ru = 'В настройках задачи %1 не указана внутренняя норма стоимости трудовых ресурсов.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаТрудовыеРесурсыДляЗаполненияПланаРасходов());
	Если УчитыватьПериодРегистрацииНормСтоимости Тогда
		ПараметрыОтбора = Новый Структура("УровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
		ЕстьДанныеОкончательногоУровняПланирования = ЗначениеЗаполнено(ТаблицаТрудовыеРесурсы.НайтиСтроки(ПараметрыОтбора));
		УровеньПланированияТрудозатрат = ?(ЕстьДанныеОкончательногоУровняПланирования,
				Перечисления.упоУровеньПланирования.Окончательный, Перечисления.упоУровеньПланирования.Предварительный);
		
		ТаблицаТрудозатратПоДням = ТаблицаСтоимостиТрудозатратПоДнямСУчетомПериодаНормСтоимости(ПроектнаяЗадача,
				УровеньПланированияТрудозатрат);
	Иначе
		ТаблицаТрудозатратПоДням = ТаблицаТрудозатратПоДнямДляРучногоЗаполненияПланаРасходов(Проект,
				ПроектнаяЗадача, ТаблицаТрудовыеРесурсы, ТаблицаТрудовыеРесурсыПоПериодам);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТрудозатратыПоДням", ТаблицаТрудозатратПоДням);
	
	ТаблицаРаспределениеПоСтатьям = Запрос.Выполнить().Выгрузить();
	СвернутьТаблицуПоПериодуАгрегацииДляЗаполненияПланаРасходов(ТаблицаРаспределениеПоСтатьям,
		ДатыПроектнойЗадачи.ДатаЗавершенияПлан);
	
	ЗаполнитьПланРасходовТрудовымиРесурсами(ТаблицаПланРасходов, ТаблицаРаспределениеПоСтатьям,
		ТаблицаТрудозатратПоДням, ЗначенияПоУмолчанию);
	Если СвернутьПоСтатьям Тогда
		ТаблицаПланРасходов.Свернуть("Статья, Валюта, ИндексСтрокРаспределения, ПрофильРаспределения, СпособПривязки,
			| ИсточникПлана, ПериодАгрегации, ДатаПривязки, Контрагент, Договор", "Сумма");
	КонецЕсли;
	
	//Заполнение распределения.
	ЗаполнитьРаспределениеПланаРасходовЗаполненногоПоТрудовымРесурсам(СтартовыйИндекс, Проект, ЗначенияПоУмолчанию,
		ТаблицаПланРасходов, ТаблицаРаспределениеРасходов, ТаблицаРаспределениеПоСтатьям, СвернутьПоСтатьям);
	
КонецПроцедуры

// Проверяет возможность списания фактических трудозатрат за период
// по задачам проекта в статусе остановлен.
//
// Параметры:
//	ДанныеПроверки	- ТаблицаЗначений - проектные задачи для проверки.
//	НачалоПериода	- Дата - дата начала периода.
//	КонецПериода	- Дата - дата конца периода.
//  Отказ			- Булево - признак отказа.
//
Процедура ПроверитьВозможностьСписанияФактическихЗатратПоОстановленнымПроектамЗаПериод(ДанныеПроверки,
	НачалоПериода, КонецПериода, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
		|	ДанныеПроверки.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	ДанныеПроверки.Проект КАК Проект
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	&ДанныеПроверки КАК ДанныеПроверки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Данные.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	Данные.Проект КАК Проект
		|ПОМЕСТИТЬ ВТ_ПроектыОстановленыНаНачалоПериода
		|ИЗ
		|	Данные КАК Данные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов.СрезПоследних(&НачалоПериода, ) КАК упоСтатусыПроектовСрезПоследних
		|		ПО Данные.Проект = упоСтатусыПроектовСрезПоследних.Проект
		|ГДЕ
		|	упоСтатусыПроектовСрезПоследних.СтатусПроекта = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Остановлен)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Данные.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	Данные.Проект КАК Проект,
		|	упоСтатусыПроектов.СтатусПроекта КАК СтатусПроекта,
		|	МАКСИМУМ(упоСтатусыПроектов.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_ПроектыОстановленыВТечениеПериода
		|ИЗ
		|	Данные КАК Данные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов КАК упоСтатусыПроектов
		|		ПО Данные.Проект = упоСтатусыПроектов.Проект
		|ГДЕ
		|	упоСтатусыПроектов.СтатусПроекта = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Остановлен)
		|	И упоСтатусыПроектов.Период >= &НачалоПериода
		|	И упоСтатусыПроектов.Период <= &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	Данные.ПроектнаяЗадача,
		|	Данные.Проект,
		|	упоСтатусыПроектов.СтатусПроекта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПроектыОстановленыВТечениеПериода.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	ВТ_ПроектыОстановленыВТечениеПериода.Проект КАК Проект
		|ПОМЕСТИТЬ ВТ_ПроектыОстановлены
		|ИЗ
		|	ВТ_ПроектыОстановленыВТечениеПериода КАК ВТ_ПроектыОстановленыВТечениеПериода
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ПроектыОстановленыНаНачалоПериода.ПроектнаяЗадача,
		|	ВТ_ПроектыОстановленыНаНачалоПериода.Проект
		|ИЗ
		|	ВТ_ПроектыОстановленыНаНачалоПериода КАК ВТ_ПроектыОстановленыНаНачалоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ПроектыОстановлены.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	упоРуководителиПроектов.РуководительПроекта КАК РуководительПроекта,
		|	упоСвойстваПЗ.НазваниеЗадачи КАК НазваниеЗадачи
		|ИЗ
		|	ВТ_ПроектыОстановлены КАК ВТ_ПроектыОстановлены
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних(, ) КАК упоРуководителиПроектов
		|		ПО ВТ_ПроектыОстановлены.Проект = упоРуководителиПроектов.Проект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоНастройкаАналитикиВРазрезеПодразделений КАК упоНастройкаАналитикиВРазрезеПодразделений
		|		ПО ВТ_ПроектыОстановлены.Проект = упоНастройкаАналитикиВРазрезеПодразделений.Объект
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПЗ
		|		ПО ВТ_ПроектыОстановлены.ПроектнаяЗадача = упоСвойстваПЗ.ПроектнаяЗадача
		|ГДЕ
		|	(НЕ упоНастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен
		|			ИЛИ упоНастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен
		|				И НЕ упоРуководителиПроектов.РуководительПроекта В (&СписокСотрудников))";
	
	СписокСотрудниковДиспетчера = упоИерархияИПолномочияВызовСервера.обПолучитьСписокСотрудниковДиспетчера(
		ПараметрыСеанса.ТекущийПользователь);

	Запрос.УстановитьПараметр("ДанныеПроверки", ДанныеПроверки);
	Запрос.УстановитьПараметр("СписокСотрудников", СписокСотрудниковДиспетчера);
	Запрос.УстановитьПараметр("НачалоПериода", КонецДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
			
	НазванияПроектныхЗадач = Новый Массив;	
		
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл 
		НазванияПроектныхЗадач.Добавить(Выборка.НазваниеЗадачи);
	КонецЦикла;	
		
	Если ЗначениеЗаполнено(НазванияПроектныхЗадач) Тогда				

		Отказ = Истина;
		
		ШаблонСообщения = НСтр("ru = 'Проект находился в статусе ""Остановлен"" в заданном отчетном периоде, '")
			+ НСтр("ru = 'нельзя списывать фактические трудозатраты по задачам:
        	|%1'");

		ПроектныеЗадачиСтрокой = СтрСоединить(НазванияПроектныхЗадач, Символы.ПС);
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПроектныеЗадачиСтрокой);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура упоОтражениеПлановыхТрудозатратЗадач() Экспорт
		
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.упоОтражениеПлановыхТрудозатратЗадач);
	
	ОбработатьПорциюОтраженияПлановыхТрудозатратЗадач();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПолучениеРабочихЗаданий

Процедура ДобавитьВЗапросВременнуюТаблицуПоручения(Запрос, СтруктураПараметров)

	ТекстЗапроса = "
	|;
	|
	|//////////////////////////////////////////////////////////////////////
	|
	|"
	+ "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
      | упоРолиТрудовыхРесурсовСрезПоследних.Роль КАК Роль,
      | ЕСТЬNULL(упоСоставПодразделенийСрезПоследних.Подразделение, ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)) КАК Подразделение,
      | упоРолиТрудовыхРесурсовСрезПоследних.Ресурс КАК Ресурс
      |ПОМЕСТИТЬ втРольРесурса
      |ИЗ
      | РегистрСведений.упоРолиТрудовыхРесурсов.СрезПоследних(, Ресурс = &Исполнитель) КАК упоРолиТрудовыхРесурсовСрезПоследних
      |     ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСоставПодразделений.СрезПоследних КАК упоСоставПодразделенийСрезПоследних
      |     ПО упоРолиТрудовыхРесурсовСрезПоследних.Роль = упоСоставПодразделенийСрезПоследних.Роль
      |         И (упоСоставПодразделенийСрезПоследних.ВходитВСостав)
      |ГДЕ
      | упоРолиТрудовыхРесурсовСрезПоследних.РольНазначена
      |
      |УПОРЯДОЧИТЬ ПО
      |	упоРолиТрудовыхРесурсовСрезПоследних.Период УБЫВ
      |;
      |
      |////////////////////////////////////////////////////////////////////////////////
      |ВЫБРАТЬ РАЗРЕШЕННЫЕ
      | упоЗадания.ПроектнаяЗадача КАК РабочееЗадание,
      | упоЗадания.Задание КАК Задание,
      | упоЗадания.Проект КАК Проект,
      | упоЗадания.ДатаНачала КАК ДатаНачала,
      | ВЫБОР
      |     КОГДА НЕ ОстановленныеПроектыСПравомНаСписание.Проект ЕСТЬ NULL
      |         ТОГДА упоЗадания.ДатаОкончания
      |     КОГДА упоЗадания.ДатаОкончания >= ВТ_ДатыОстановкиПроектов.Период
      |         ТОГДА ВТ_ДатыОстановкиПроектов.Период
      |     ИНАЧЕ упоЗадания.ДатаОкончания
      | КОНЕЦ КАК ДатаОкончания,
      | ИСТИНА КАК ЭтоПроектнаяЗадача,
      | ВЫБОР
      |     КОГДА упоЗадания.Роль = ЗНАЧЕНИЕ(Справочник.упоРоли.ПустаяСсылка)
      |         ТОГДА ЕСТЬNULL(ВременнаяТаблица_РабочиеЗадания.РольРесурса, втРольРесурса.Роль)
	  |     ИНАЧЕ упоЗадания.Роль
      | КОНЕЦ КАК РольРесурса,
      | ВЫБОР
      |     КОГДА упоЗадания.Подразделение = ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)
      |         ТОГДА ЕСТЬNULL(ВременнаяТаблица_РабочиеЗадания.Подразделение, втРольРесурса.Подразделение)
	  |     ИНАЧЕ упоЗадания.Подразделение
      | КОНЕЦ КАК Подразделение
      |ПОМЕСТИТЬ втЗадания
      |ИЗ
      | втОткрытыеПоручения КАК упоЗадания
      |     ЛЕВОЕ СОЕДИНЕНИЕ ВременнаяТаблица_РабочиеЗадания КАК ВременнаяТаблица_РабочиеЗадания
      |     ПО упоЗадания.ПроектнаяЗадача = ВременнаяТаблица_РабочиеЗадания.РабочееЗадание
      |     ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК СтатусыПроектныхЗадач
      |         ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
      |         ПО СтатусыПроектныхЗадач.Версия = упоВерсииПроекта.Версия
      |             И (упоВерсииПроекта.Текущая)
      |         ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
      |         ПО СтатусыПроектныхЗадач.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
      |             И СтатусыПроектныхЗадач.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
      |             И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
      |     ПО упоЗадания.ПроектнаяЗадача = СтатусыПроектныхЗадач.ПроектнаяЗадача
      |     ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов.СрезПоследних КАК СтатусыПроектов
      |     ПО упоЗадания.Проект = СтатусыПроектов.Проект
      |     ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстановленныеПроектыСПравомНаСписание КАК ОстановленныеПроектыСПравомНаСписание
      |     ПО упоЗадания.Проект = ОстановленныеПроектыСПравомНаСписание.Проект
      |     ЛЕВОЕ СОЕДИНЕНИЕ втРольРесурса КАК втРольРесурса
      |     ПО (ИСТИНА)
      |     ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатыОстановкиПроектов КАК ВТ_ДатыОстановкиПроектов
      |     ПО упоЗадания.Проект = ВТ_ДатыОстановкиПроектов.Проект
      |ГДЕ
      | СтатусыПроектныхЗадач.СтатусЗадачи В(&СписокСтатусовПЗ)
      | И (СтатусыПроектов.СтатусПроекта В (&СписокСтатусовПроектов)
      |         ИЛИ НЕ ОстановленныеПроектыСПравомНаСписание.Проект ЕСТЬ NULL)";	
	
	Запрос.Текст = Запрос.Текст + ТекстЗапроса;

КонецПроцедуры

Процедура ДополнитьТекстЗапросаПроектныеЗадачи(ТекстЗапроса, ВставитьРазделитель, ИсключитьЗадачиСЗаданиями = Ложь)

	Если ВставитьРазделитель Тогда
		ВставитьРазделитьВТекстЗапроса(ТекстЗапроса);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ВЫБРАТЬ
	|	ВременнаяТаблица_РабочиеЗадания.РабочееЗадание,
	|   ЗНАЧЕНИЕ(Справочник.упоЗадания.ПустаяСсылка) КАК Задание,
	|	ВременнаяТаблица_РабочиеЗадания.Проект,
	|	ВременнаяТаблица_РабочиеЗадания.ДатаНачала,
	|	ВременнаяТаблица_РабочиеЗадания.ДатаЗавершения КАК ДатаОкончания,
	|	ВременнаяТаблица_РабочиеЗадания.ЭтоПроектнаяЗадача,
	|	ВременнаяТаблица_РабочиеЗадания.РольРесурса,
	|	ВременнаяТаблица_РабочиеЗадания.Подразделение
	|ИЗ
	|	ВременнаяТаблица_РабочиеЗадания КАК ВременнаяТаблица_РабочиеЗадания";
	
	Если ИсключитьЗадачиСЗаданиями Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	ВременнаяТаблица_РабочиеЗадания.РабочееЗадание НЕ В (ВЫБРАТЬ 
		|															втЗадания.РабочееЗадание
		|														ИЗ
		|															втЗадания КАК втЗадания
		|														ГДЕ
		|															втЗадания.Задание.ЭтоЗаданиеИсполнителяПроектнойЗадачи)
		|";
		
	КонецЕсли;

КонецПроцедуры

Процедура ДополнитьТекстЗапросаПоручения(ТекстЗапроса, ВставитьРазделитель)
	
	Если ВставитьРазделитель Тогда
		ВставитьРазделитьВТекстЗапроса(ТекстЗапроса);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
		|ВЫБРАТЬ
		|	втЗадания.РабочееЗадание,
		|	втЗадания.Задание,
		|	втЗадания.Проект,
		|	втЗадания.ДатаНачала,
		|	втЗадания.ДатаОкончания,
		|	втЗадания.ЭтоПроектнаяЗадача,
		|	втЗадания.РольРесурса,
		|	втЗадания.Подразделение
		|ИЗ
		|	втЗадания КАК втЗадания";
	
КонецПроцедуры

Процедура ВставитьРазделитьВТекстЗапроса(ТекстЗапроса)

	ТекстЗапроса = ТекстЗапроса + "
		|;
		|////////////////////////////////////////////////////////////////////
		|";	

КонецПроцедуры

// Получает запрос по рабочим заданиям трудового ресурса за период.
//
// Параметры:
//  СтруктураПараметров - Структура - Ключи:
//				   * ТрудовойРесурс.
//				   * НачалоПериода.
//				   * КонецПериода.
// 
Функция ПолучитьЗапросРабочиеЗадания(СтруктураПараметров) 
	
	СписокСтатусовПЗ = Новый Массив();
	СписокСтатусовПЗ.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаЗадачи.Запланирована"));
	СписокСтатусовПЗ.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаЗадачи.Выполняется"));
	
	СписокСтатусовПроектовНаТекущуюДату = Новый Массив();
	СписокСтатусовПроектовНаТекущуюДату.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаПроекта.Запланирован"));
	СписокСтатусовПроектовНаТекущуюДату.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаПроекта.Выполняется"));
	СписокСтатусовПроектовНаТекущуюДату.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаПроекта.Утвержден"));
	СписокСтатусовПроектовНаТекущуюДату.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаПроекта.Остановлен"));
	
	СписокСтатусовЗаданий = Новый Массив();
	СписокСтатусовЗаданий.Добавить(Перечисления.упоСтатусыЗаданий.Выдано);
	СписокСтатусовЗаданий.Добавить(Перечисления.упоСтатусыЗаданий.Выполняется);	
	СписокСтатусовЗаданий.Добавить(Перечисления.упоСтатусыЗаданий.Уточняется);
	СписокСтатусовЗаданий.Добавить(Перечисления.упоСтатусыЗаданий.Завершено);

	Если Константы.упоРазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам.Получить() Тогда
		СписокСтатусовПЗ.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаЗадачи.Завершена"));
		СписокСтатусовЗаданий.Добавить(Перечисления.упоСтатусыЗаданий.Закрыто);
		Если Не Константы.упоСтрогийКонтрольИзмененияЗакрытыхЭтапов.Получить() Тогда
			СписокСтатусовПЗ.Добавить(ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта"));
		КонецЕсли;	
	КонецЕсли;
		
	временныеТаблицы = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = временныеТаблицы;
	
	Запрос.Параметры.Вставить("Исполнитель"		, СтруктураПараметров.ТрудовойРесурс);
	Запрос.Параметры.Вставить("ДатаНачала"		, СтруктураПараметров.НачалоПериода);
	Запрос.Параметры.Вставить("ДатаЗавершения"	, КонецДня(СтруктураПараметров.КонецПериода));
	Запрос.Параметры.Вставить("СписокСтатусовПЗ", СписокСтатусовПЗ);
	Запрос.Параметры.Вставить("СписокСтатусовПроектов", СписокСтатусовПроектовНаТекущуюДату);
	Запрос.Параметры.Вставить("ПустаяПроектнаяЗадача", Документы.упоПроектнаяЗадача.ПустаяСсылка());
	Запрос.Параметры.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
	Запрос.Параметры.Вставить("СотрудникТрудовогоРесурса", 
		упоРесурсыИРолиВызовСервера.обПолучитьТекущегоВладельцаРесурса(СтруктураПараметров.ТрудовойРесурс));
	Запрос.УстановитьПараметр("ПустойПроект", Справочники.Проекты.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВидЗаданияПоручение", Справочники.упоВидыЗаданий.Поручение);	
	Запрос.УстановитьПараметр("СписокСтатусовЗаданий", СписокСтатусовЗаданий);	
		
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	упоФактТрудозатратПоДням.Операция КАК Операция
	|ПОМЕСТИТЬ ВТ_ЗадачиСФактом
	|ИЗ
	|	РегистрСведений.упоФактТрудозатратПоДням КАК упоФактТрудозатратПоДням
	|ГДЕ
	|	упоФактТрудозатратПоДням.Ресурс = &Исполнитель
	|	И упоФактТрудозатратПоДням.УровеньПланирования = &УровеньПланирования
	|	И упоФактТрудозатратПоДням.День >= &ДатаНачала
	|	И упоФактТрудозатратПоДням.День <= &ДатаЗавершения
	|	И упоФактТрудозатратПоДням.Трудозатраты <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РесурсыПроекта.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	РесурсыПроекта.РольРесурса КАК РольРесурса,
	|	РесурсыПроекта.Подразделение КАК Подразделение,
	|	РесурсыПроекта.Проект КАК Проект,
	|	Версии.Версия КАК ТекущаяВерсия
	|ПОМЕСТИТЬ ВТ_НазначенныеПЗДоОтбораПоОтмененным
	|ИЗ
	|	РегистрСведений.упоВерсииПроекта КАК Версии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(
	|				,
	|				Ресурс = &Исполнитель
	|					И НЕ ПроектнаяЗадача = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)) КАК РесурсыПроекта
	|		ПО (РесурсыПроекта.Версия = Версии.Версия)
	|			И (Версии.Текущая)
	|			И (РесурсыПроекта.РесурсВыделен)
	|ГДЕ
	|	НЕ Версии.Проект.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_НазначенныеПЗДоОтбораПоОтмененным.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	ВТ_НазначенныеПЗДоОтбораПоОтмененным.РольРесурса КАК РольРесурса,
	|	ВТ_НазначенныеПЗДоОтбораПоОтмененным.Подразделение КАК Подразделение,
	|	ВТ_НазначенныеПЗДоОтбораПоОтмененным.Проект КАК Проект,
	|	ВТ_НазначенныеПЗДоОтбораПоОтмененным.ТекущаяВерсия КАК ТекущаяВерсия
	|ПОМЕСТИТЬ ВТ_НазначенныеПЗ
	|ИЗ
	|	ВТ_НазначенныеПЗДоОтбораПоОтмененным КАК ВТ_НазначенныеПЗДоОтбораПоОтмененным
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	|				,
	|				(Версия, ПроектнаяЗадача) В
	|					(ВЫБРАТЬ
	|						ВТ_НазначенныеПЗДоОтбораПоОтмененным.ТекущаяВерсия,
	|						ВТ_НазначенныеПЗДоОтбораПоОтмененным.ПроектнаяЗадача
	|					ИЗ
	|						ВТ_НазначенныеПЗДоОтбораПоОтмененным)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ПО ВТ_НазначенныеПЗДоОтбораПоОтмененным.ТекущаяВерсия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
	|			И ВТ_НазначенныеПЗДоОтбораПоОтмененным.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_НазначенныеПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	ВТ_НазначенныеПЗ.РольРесурса КАК РольРесурса,
	|	ВТ_НазначенныеПЗ.Подразделение КАК Подразделение,
	|	ВТ_НазначенныеПЗ.Проект КАК Проект,
	|	ВТ_НазначенныеПЗ.ТекущаяВерсия КАК ТекущаяВерсия,
	|	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан КАК ДатаНачалаПлан,
	|	упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан
	|ПОМЕСТИТЬ ВТ_НазначенныеЗадачиСоСроками
	|ИЗ
	|	ВТ_НазначенныеПЗ КАК ВТ_НазначенныеПЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
	|				,
	|				(Версия, ПроектнаяЗадача) В
	|					(ВЫБРАТЬ
	|						ВТ_НазначенныеПЗ.ТекущаяВерсия,
	|						ВТ_НазначенныеПЗ.ПроектнаяЗадача
	|					ИЗ
	|						ВТ_НазначенныеПЗ)) КАК упоСрокиПроектныхЗадачСрезПоследних
	|		ПО ВТ_НазначенныеПЗ.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	|			И ВТ_НазначенныеПЗ.ТекущаяВерсия = упоСрокиПроектныхЗадачСрезПоследних.Версия
	|			И (упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан <= &ДатаЗавершения)
	|			И (упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан >= &ДатаНачала)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоЗадания.ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
	|	упоЗадания.Проект КАК Проект,
	|	упоЗадания.Ссылка КАК Задание,
	|	упоЗадания.Роль КАК Роль,
	|	упоЗадания.Подразделение КАК Подразделение,
	|	упоСрокиЗаданий.ДатаНачалаПлан КАК ДатаНачала,
	|	упоСрокиЗаданий.ДатаОкончанияПлан КАК ДатаОкончания
	|ПОМЕСТИТЬ втОткрытыеПоручения
	|ИЗ
	|	Справочник.упоЗадания КАК упоЗадания
