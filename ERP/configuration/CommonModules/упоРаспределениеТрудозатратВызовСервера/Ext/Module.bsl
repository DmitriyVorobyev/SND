Функция СконвертироватьТаблицуПоДнямВТаблицуПлановыхЗатратТрудовыхРесурсов(ТаблицаПоДням, ПроектнаяЗадача, ВидОперации) 
		
	ТаблицаПоДням.Колонки.Трудозатраты.Имя = "КоличествоЧасов";
	ТаблицаПоДням.Колонки.Операция.Имя = "ПроектнаяЗадача";
	ТаблицаПоДням.Колонки.ВнешняяСтоимость.Имя = "СтоимостьВнешняя";

	ТаблицаПоДням.Колонки.Добавить("ВидОперации", Новый ОписаниеТипов("СправочникСсылка.упоВидыОпераций"));
	ТаблицаПоДням.Колонки.Добавить("Обнуление", Новый ОписаниеТипов("Булево"));
	
	ТаблицаПоДням.ЗаполнитьЗначения(ВидОперации, "ВидОперации");
	
	СвернутьЗатратыТрудовыхРесурсов(ТаблицаПоДням);   
	
КонецФункции

// Создает набор записей указанного регистра по таблице доходов и расходов.
//
// Параметры:
//  ИсходнаяТаблицаДвижений - ТаблицаЗначений - таблица, в которую будут записаны данные о трудозатратах.
//  ИмяРегистра - Строка - имя регистра, по которому записываются движения.
//  ДанныеДвижений - Структура - подготовленные к проведению движения ПЗ, если отражение вызвано 
//		непосредственно из документа ПЗ.
//  МассивНаборовЗаписей - Массив - массив наборов записей регистров, которые будут записаны при отражении.
//  ДанныеЗаполнения - Структура - данные заполнения строк.
//  ИспользоватьЗануление - Булево - признак необходимости использования зануления для регистра. 
//  ВАЖНО: Зануление не используется для регистров, содержащих данные ТЧ ПЗ, а также для регистров, где
//	записи трансляции трудозатрат модифицируются только от имени ПЗ.
//
Процедура СоздатьНаборЗаписейПоТаблице(ИсходнаяТаблицаДвижений, ИмяРегистра,  
	ДанныеДвижений, МассивНаборовЗаписей, ДанныеЗаполнения, ИспользоватьЗануление = Ложь)
	
	ЭтоДвиженияПЗ = НЕ ДанныеДвижений = Неопределено;
			
	Если ЭтоДвиженияПЗ Тогда		
		НаборЗаписей = ДанныеДвижений[ИмяРегистра];
	Иначе
		// Если ранее была загрузка данных из версии в проект, необходимо прежде очистить записи с регистратором по версии.
		РегистраторОтбор = ДанныеЗаполнения.Версия;
		ИмяИзмерения = "ПроектнаяЗадача";
		ИзмерениеОтбор = ДанныеЗаполнения.ПроектнаяЗадача;
		УдалитьЗаписиРегистраПоОтбору(ИмяРегистра, РегистраторОтбор, ИзмерениеОтбор, ИмяИзмерения);
		
		РегистраторОтбор = ДанныеЗаполнения.ПроектнаяЗадача;
		ИмяИзмерения = "ИсточникПлана";
		ИзмерениеОтбор = ДанныеЗаполнения.ИсточникПлана;
		УдалитьЗаписиРегистраПоОтбору(ИмяРегистра, РегистраторОтбор, ИзмерениеОтбор, ИмяИзмерения);
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ДанныеЗаполнения.ПроектнаяЗадача);
		НаборЗаписей.Прочитать();
	КонецЕсли;
	
	ТолькоЗануление = ИсходнаяТаблицаДвижений = Неопределено И ИспользоватьЗануление = Истина;
	
	Если НЕ ТолькоЗануление Тогда
		
		ТаблицаДвижений = ИсходнаяТаблицаДвижений.Скопировать();		
		
		РеквизитКакИзмерение = Ложь;
		
		Если ИмяРегистра = "упоДанныеПлановДоходовИРасходовПодразделения" Тогда
			ТаблицаДвижений.ЗаполнитьЗначения(Неопределено, "ДатаНачисления");	
			РеквизитКакИзмерение = Истина;
		КонецЕсли;	
		
		упоФункцииОбщегоНазначенияСервер.СвернутьТаблицуДвижений(ТаблицаДвижений, ИмяРегистра, РеквизитКакИзмерение);							
									
		// Записи добавляются в исходный набор, в котором могут быть добавлены
		// записи обычного плана БДР (ИсточникПлана <> Трудозатраты).
		Для Каждого Движение Из ТаблицаДвижений Цикл
			НоваяЗапись = НаборЗаписей.Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяЗапись, Движение);	
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ДанныеЗаполнения);		
			НоваяЗапись.Регистратор = ДанныеЗаполнения.ПроектнаяЗадача;
		КонецЦикла;	
		
	КонецЕсли;	
	
	// Зануление регистра.
	Если ИспользоватьЗануление Тогда				
		ДанныеОбработки = Новый Структура ("Регистратор, Период, МассивЗадач, ИмяРегистра",
			ДанныеЗаполнения.ПроектнаяЗадача, ДанныеЗаполнения.Период, ДанныеЗаполнения.ПроектнаяЗадача, ИмяРегистра);
		упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(НаборЗаписей, ДанныеОбработки,,,
			"Версия = &Версия И ИсточникПлана = &ИсточникПлана", 
			Новый Структура("Версия, ИсточникПлана", ДанныеЗаполнения.Версия, ДанныеЗаполнения.ИсточникПлана), 
			Ложь);	
	КонецЕсли;					
					
	Если НЕ ЭтоДвиженияПЗ Тогда
		МассивНаборовЗаписей.Добавить(НаборЗаписей);
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьЗаписиРегистраПоОтбору(ИмяРегистра, РегистраторОтбор, ИзмерениеОтбор, ИмяИзмерения = "")
	
	ЗаписиКУдалению = Новый Массив;
	
	НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(РегистраторОтбор);
	НаборЗаписей.Прочитать();
	Если Не НаборЗаписей.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяИзмерения) Тогда
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		Если ЗаписьНабора[ИмяИзмерения] = ИзмерениеОтбор Тогда
			ЗаписиКУдалению.Добавить(ЗаписьНабора);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЗаписьКУдалению Из ЗаписиКУдалению Цикл
		НаборЗаписей.Удалить(ЗаписьКУдалению);
	КонецЦикла;
	
	Если ЗаписиКУдалению.Количество() Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаРаспределениеПоСтатьямДляСводнойТаблицы()
	
	ТекстЗапроса = "ВЫБРАТЬ
		|	ТЗ.Ресурс КАК Ресурс,
		|	ТЗ.ОбщСтоимость КАК Стоимость,
		|	ТЗ.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ТЗ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ.Ресурс КАК Ресурс,
		|	ТЗ.Подразделение КАК Подразделение,
		|	ЕСТЬNULL(упоРаспределениеРесурсовПоСтатьямЗатрат.СтатьяЗатрат, ЗНАЧЕНИЕ(Справочник.упоСтатьиЗатрат.ПустаяСсылка)) КАК Статья,
		|	СУММА(ВЫБОР
		|			КОГДА упоРаспределениеРесурсовПоСтатьямЗатрат.ДоляСуммы ЕСТЬ NULL
		|				ТОГДА ТЗ.Стоимость
		|			ИНАЧЕ ТЗ.Стоимость * (упоРаспределениеРесурсовПоСтатьямЗатрат.ДоляСуммы / 100)
		|		КОНЕЦ) КАК Сумма,
		|	упоСтатьиЗатрат.СпособПривязкиРасходовТрудозатраты КАК СпособПривязки,
		|	ВЫБОР
		|		КОГДА упоСтатьиЗатрат.СпособПривязкиРасходовТрудозатраты = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения)
		|			ТОГДА упоСтатьиЗатрат.ПрофильРаспределенияРасходовТрудозатраты
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.упоПрофилиРаспределенияДоходовИРасходов.ПустаяСсылка)
		|	КОНЕЦ КАК ПрофильРаспределения,
		|	ВЫБОР
		|		КОГДА упоСтатьиЗатрат.СпособПривязкиРасходовТрудозатраты = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно)
		|			ТОГДА упоСтатьиЗатрат.ПериодАгрегацииРасходовТрудозатраты
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоПериодыАгрегацииЗатрат.ПустаяСсылка)
		|	КОНЕЦ КАК ПериодАгрегации,
		|	упоСтатьиЗатрат.КонтрагентРасходовТрудозатраты КАК Контрагент,
		|	упоСтатьиЗатрат.ДоговорРасходовТрудозатраты КАК Договор,
		|	ЕСТЬNULL(упоРаспределениеРесурсовПоСтатьямЗатрат.ДоляСуммы, 0) КАК ДоляСуммы
		|ИЗ
		|	ТЗ КАК ТЗ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРаспределениеРесурсовПоСтатьямЗатрат КАК упоРаспределениеРесурсовПоСтатьямЗатрат
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.упоСтатьиЗатрат КАК упоСтатьиЗатрат
		|			ПО упоРаспределениеРесурсовПоСтатьямЗатрат.СтатьяЗатрат = упоСтатьиЗатрат.Ссылка
		|		ПО ТЗ.Ресурс = упоРаспределениеРесурсовПоСтатьямЗатрат.Ресурс
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЗ.Ресурс,
		|	ТЗ.Подразделение,
		|	упоСтатьиЗатрат.СпособПривязкиРасходовТрудозатраты,
		|	упоСтатьиЗатрат.КонтрагентРасходовТрудозатраты,
		|	упоСтатьиЗатрат.ДоговорРасходовТрудозатраты,
		|	ЕСТЬNULL(упоРаспределениеРесурсовПоСтатьямЗатрат.СтатьяЗатрат, ЗНАЧЕНИЕ(Справочник.упоСтатьиЗатрат.ПустаяСсылка)),
		|	ВЫБОР
		|		КОГДА упоСтатьиЗатрат.СпособПривязкиРасходовТрудозатраты = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения)
		|			ТОГДА упоСтатьиЗатрат.ПрофильРаспределенияРасходовТрудозатраты
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.упоПрофилиРаспределенияДоходовИРасходов.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА упоСтатьиЗатрат.СпособПривязкиРасходовТрудозатраты = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно)
		|			ТОГДА упоСтатьиЗатрат.ПериодАгрегацииРасходовТрудозатраты
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоПериодыАгрегацииЗатрат.ПустаяСсылка)
		|	КОНЕЦ,
		|	ЕСТЬNULL(упоРаспределениеРесурсовПоСтатьямЗатрат.ДоляСуммы, 0)";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Добавить("ТЗ.ЕдиницаНормирования");
	
	СхемаЗапроса.ПакетЗапросов[0].Операторы[0].ВыбираемыеПоля.Добавить("ТЗ.УровеньПланирования");
	СхемаЗапроса.ПакетЗапросов[1].Операторы[0].ВыбираемыеПоля.Добавить("ТЗ.УровеньПланирования");
	
	Возврат СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецФункции

Функция ТекстЗапросаТрудовыеРесурсыПоУровнямПланирования(КолонкаСтоимости) Экспорт
	
	ТекстЗапроса = СтрЗаменить("ВЫБРАТЬ РАЗРЕШЕННЫЕ
				               |	ТаблицаТрудовыеРесурсы.Ресурс,
				               |	ТаблицаТрудовыеРесурсы.Подразделение,
				               |	ТаблицаТрудовыеРесурсы.УровеньПланирования,
				               |	ТаблицаТрудовыеРесурсы.Количество,
				               |	ТаблицаТрудовыеРесурсы.%КолонкаСтоимости%
				               |ПОМЕСТИТЬ ВТТаблицаТрудовыеРесурсы
				               |ИЗ
				               |	&ТаблицаТрудовыеРесурсы КАК ТаблицаТрудовыеРесурсы
				               |;
				               |
				               |////////////////////////////////////////////////////////////////////////////////
				               |ВЫБРАТЬ ПЕРВЫЕ 1
				               |	1 КАК Поле1
				               |ПОМЕСТИТЬ ВТДанныеОкончательногоУровня
				               |ИЗ
				               |	ВТТаблицаТрудовыеРесурсы КАК ТаблицаТрудовыеРесурсы
				               |ГДЕ
				               |	ТаблицаТрудовыеРесурсы.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
				               |	И ТаблицаТрудовыеРесурсы.Количество <> 0
				               |;
				               |
				               |////////////////////////////////////////////////////////////////////////////////
				               |ВЫБРАТЬ
				               |	ТаблицаТрудовыеРесурсы.Ресурс,
				               |	ТаблицаТрудовыеРесурсы.Подразделение,
							   |	ТаблицаТрудовыеРесурсы.УровеньПланирования,
				               |	СУММА(ТаблицаТрудовыеРесурсы.Количество) КАК Количество,
				               |	СУММА(ТаблицаТрудовыеРесурсы.%КолонкаСтоимости%) КАК %КолонкаСтоимости%
				               |ИЗ
				               |	ВТТаблицаТрудовыеРесурсы КАК ТаблицаТрудовыеРесурсы
				               |ГДЕ
				               |	ВЫБОР
				               |			КОГДА 1 В
				               |					(ВЫБРАТЬ
				               |						ВТДанныеОкончательногоУровня.Поле1
				               |					ИЗ
				               |						ВТДанныеОкончательногоУровня)
				               |				ТОГДА ТаблицаТрудовыеРесурсы.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
				               |			ИНАЧЕ ТаблицаТрудовыеРесурсы.УровеньПланирования <> ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
				               |		КОНЕЦ
				               |
				               |СГРУППИРОВАТЬ ПО
				               |	ТаблицаТрудовыеРесурсы.Ресурс,
				               |	ТаблицаТрудовыеРесурсы.Подразделение,
							   |	ТаблицаТрудовыеРесурсы.УровеньПланирования",
							   "%КолонкаСтоимости%", КолонкаСтоимости);
	Возврат ТекстЗапроса;
	
КонецФункции

// Заполняет план расходов по трудовым ресурсам при фоновом отражении затрат в БДР.
//
// Параметры:
//  Проект - СправочникСсылка.Проекты - проект ПЗ, указывается при заполнении из формы ПЗ.
//  ТаблицаТрудовыеРесурсы	- ТаблицаЗначенией - Табличная часть ТрудовыеРесурсы документа упоПроектнаяЗадача.
//  ТаблицаПланРасходов	- ТаблицаЗначений - Состав колонок см. ШаблонТаблицыРасходов().
//  УровеньПланированияТрудозатратДляБДР - ПеречислениеСсылка.упоУровеньПланированияТрудозатратДляБДР - отбор уровня
//      трудозатрат, которые пойдут в БДР,
//  	указывается при заполнении из отражения трудозатрат.
//
Процедура ОтразитьТрудовыеРесурсыВПланеРасходов(Проект, ТаблицаТрудовыеРесурсы, ТаблицаПланРасходов,
		УровеньПланированияТрудозатратДляБДР = Неопределено,
		Знач СтартовыйИндекс = 0) Экспорт
	
	ВалютаУпрУчета = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	ЗначенияПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект);
	
	ДобавленныеСтрокиПланаРасходов = Новый Массив;
	
	КолонкаСтоимость = "ОбщСтоимость";
	ТаблицаТрудовыеРесурсыПоУровням = ТаблицаТрудовыхРесурсовПоУровням(ТаблицаТрудовыеРесурсы, КолонкаСтоимость,
			УровеньПланированияТрудозатратДляБДР);
	
	ТекстЗапроса = ТекстЗапросаРаспределениеПоСтатьямДляСводнойТаблицы();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТрудовыеРесурсыПоУровням);
	
	ТаблицаРаспределениеПоСтатьям = Запрос.Выполнить().Выгрузить();
		
	Для Каждого СтрокаРаспределенияПоСтатьям Из ТаблицаРаспределениеПоСтатьям Цикл
		
		НоваяСтрока = ТаблицаПланРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаспределенияПоСтатьям);
		НоваяСтрока.Валюта = ВалютаУпрУчета;
		
		НоваяСтрока.СобствСилы_Субподряд = упоАналитикаПоПодразделениямСервер.СССП_Роли(СтрокаРаспределенияПоСтатьям.Ресурс);
		Если Не ЗначениеЗаполнено(НоваяСтрока.СпособПривязки) Тогда
			НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
			НоваяСтрока.ПрофильРаспределения = ЗначенияПоУмолчанию.ПрофильРасходовПоУмолчанию;
		КонецЕсли;
		
    КонецЦикла;
    
	// Установим индекс строк распределения в разрезе статей.
	ТаблицаРаспределениеПоСтатьямКопия = ТаблицаРаспределениеПоСтатьям.Скопировать();
	ТаблицаРаспределениеПоСтатьямКопия.Свернуть("Статья");
	СтатьиЗатрат = ТаблицаРаспределениеПоСтатьямКопия.ВыгрузитьКолонку("Статья");
	
	ИндексСтрокРаспределения = СтартовыйИндекс;
	Для каждого Статья Из СтатьиЗатрат Цикл
		
		ПараметрыОтбора = Новый Структура("Статья", Статья);
		НайденныеСтроки = ТаблицаПланРасходов.НайтиСтроки(ПараметрыОтбора);
		
		Если Не НайденныеСтроки.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Строка.ИндексСтрокРаспределения = ИндексСтрокРаспределения;
			Строка.ИндексСтрокиВладельца = ИндексСтрокРаспределения;
		КонецЦикла;
		
		ИндексСтрокРаспределения = ИндексСтрокРаспределения + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция УровеньПланированияПоУровнюПланированияТрудозатратДляБДР(УровеньПланированияТрудозатратДляБДР)
	
	УровеньПланирования = Неопределено;
	
	Если УровеньПланированияТрудозатратДляБДР = Перечисления.упоУровеньПланированияТрудозатратДляБДР.ОкончательныйПоРолям Тогда
		УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;	
	ИначеЕсли УровеньПланированияТрудозатратДляБДР = Перечисления.упоУровеньПланированияТрудозатратДляБДР.ПредварительныйПоРолям Тогда
		УровеньПланирования = Перечисления.упоУровеньПланирования.Предварительный;		
	КонецЕсли;
	
	Возврат УровеньПланирования;
	
КонецФункции	

Функция ШаблонТаблицыРасходов()
	
	ТабЧасти = Метаданные.Документы.упоПроектнаяЗадача.ТабличныеЧасти;
	
	Таблица = Новый ТаблицаЗначений;
	КолонкиТаблицы = Таблица.Колонки;
		
	Для Каждого Реквизит Из ТабЧасти.ПланРасходов.Реквизиты Цикл				
		ПроверитьДобавитьКолонку(КолонкиТаблицы, Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
		
	КолонкиТаблицы.Добавить("ДоляСуммы");
	КолонкиТаблицы.Добавить("Ресурс");
	КолонкиТаблицы.Добавить("Подразделение");
	КолонкиТаблицы.Добавить("УровеньПланирования");
	КолонкиТаблицы.Добавить("СобствСилы_Субподряд");	
	КолонкиТаблицы.Добавить("ДатаНачисления");	
	КолонкиТаблицы.Добавить("ЕдиницаНормирования");
	КолонкиТаблицы.Добавить("ИндексСтрокиВладельца");	
	КолонкиТаблицы.Добавить("СуммаВалютная");	
	
	Возврат Таблица;	
	
КонецФункции

Функция ШаблонТаблицыПоДням(ПериодыАгрегации)
	
	Таблица = Новый ТаблицаЗначений;
	Для Каждого ПериодАгрегации Из ПериодыАгрегации Цикл
		Таблица.Колонки.Добавить(ПериодАгрегации.Значение, Новый ОписаниеТипов("Дата"));
	КонецЦикла;
	Таблица.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	
	Возврат Таблица;
	
КонецФункции

Функция ТаблицаЗадачи(ПроектнаяЗадача, ДатаНач, ДатаКон)
	
	ТаблицаЗадач = Новый ТаблицаЗначений;
	ТаблицаЗадач.Колонки.Добавить("Задача");
	ТаблицаЗадач.Колонки.Добавить("ДатаНачала");
	ТаблицаЗадач.Колонки.Добавить("ДатаЗавершения");
	
	НоваяСтрока = ТаблицаЗадач.Добавить();
	НоваяСтрока.Задача = ПроектнаяЗадача;
	НоваяСтрока.ДатаНачала = ДатаНач;
	НоваяСтрока.ДатаЗавершения = ДатаКон;	
	
	Возврат ТаблицаЗадач;
	
КонецФункции	

Процедура ПроверитьДобавитьКолонку(КолонкиТаблицы, ИмяКолонки, ТипКолонки = Неопределено)
	Если КолонкиТаблицы.Найти(ИмяКолонки) = Неопределено Тогда
		КолонкиТаблицы.Добавить(ИмяКолонки, ТипКолонки);
	КонецЕсли;			
КонецПроцедуры	

Функция КонецПериодаАгрегации(Дата, Знач ВидПериодаАгрегации)
	
	МенеджерАгрегации = Перечисления.упоПериодыАгрегацииЗатрат;
	
	Если НЕ ЗначениеЗаполнено(ВидПериодаАгрегации) Тогда
		ВидПериодаАгрегации = МенеджерАгрегации.Месяц;
	КонецЕсли;
			
	Если ВидПериодаАгрегации = МенеджерАгрегации.Год Тогда
		КонецПериода = КонецГода(Дата);
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.Полугодие Тогда		
		НомерМесяца = Месяц(Дата);
		Если НомерМесяца > 6 Тогда
			КонецПериода = КонецГода(Дата);
		Иначе
			КонецПериода = Дата(Год(Дата), 6, 30);
		КонецЕсли;	
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.Квартал Тогда
		КонецПериода = КонецКвартала(Дата);
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.Месяц Тогда
		КонецПериода = КонецМесяца(Дата);
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.ДвеНедели Тогда
		НомерДня = День(Дата);
		Если НомерДня > 14 Тогда
			КонецПериода = КонецМесяца(Дата);
		Иначе
			КонецПериода = Дата(Год(Дата), Месяц(Дата), 14);
		КонецЕсли;	
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.Декада Тогда
		НомерДня = День(Дата);
		Если НомерДня > 20 Тогда
			КонецПериода = КонецМесяца(Дата);
		ИначеЕсли НомерДня > 10 Тогда
			КонецПериода = Дата(Год(Дата), Месяц(Дата), 20);
		Иначе
			КонецПериода = Дата(Год(Дата), Месяц(Дата), 10);
		КонецЕсли;	
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.Неделя Тогда
		НомерДня = День(Дата);
		Если НомерДня > 21 Тогда
			КонецПериода = КонецМесяца(Дата);		
		ИначеЕсли НомерДня > 14 Тогда
			КонецПериода = Дата(Год(Дата), Месяц(Дата), 21);	
		ИначеЕсли НомерДня > 7 Тогда
			КонецПериода = Дата(Год(Дата), Месяц(Дата), 14);		
		Иначе	
			КонецПериода = Дата(Год(Дата), Месяц(Дата), 7);
		КонецЕсли;
	ИначеЕсли ВидПериодаАгрегации = МенеджерАгрегации.День Тогда
		КонецПериода = Дата;	
	КонецЕсли;	
	
	КонецПериода = КонецДня(КонецПериода);
	
	Возврат КонецПериода;
	
КонецФункции

Процедура ДополнитьДанныеПланаДДСДаннымиПланаБДР(ТаблицаДДС, ТаблицаБДР, ПроектнаяЗадача, Проект)
	
	СхемаОплатыПЗ_Доходы = Неопределено;
	СхемаОплатыПЗ_Расходы = Неопределено;
	ПолучитьСхемыОплатыПроектнойЗадачи(ПроектнаяЗадача, СхемаОплатыПЗ_Доходы, СхемаОплатыПЗ_Расходы);
	
	ПараметрыРасчетаДДС = упоДвиженияДенежныхСредствКлиентСервер.ПараметрыРасчетаДДСПоБДР(ПроектнаяЗадача, Проект,,
		СхемаОплатыПЗ_Доходы, СхемаОплатыПЗ_Расходы,, Истина);
	
	упоДвиженияДенежныхСредствСервер.ДополнитьДанныеПланаДДСДаннымиПланаБДР(ТаблицаДДС, ТаблицаБДР, ПараметрыРасчетаДДС);
	
КонецПроцедуры

Процедура ПолучитьСхемыОплатыПроектнойЗадачи(ПроектнаяЗадача, СхемаОплатыПЗ_Доходы, СхемаОплатыПЗ_Расходы)

	Если ПроектнаяЗадача = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СвойстваПЗ = "СхемаОплатыПоУмолчаниюДоходы, СхемаОплатыПоУмолчаниюРасходы"; 
	
	СхемыОплатыПЗ = упоПроектыИЗадачиСервер.ПолучитьСвойстваПроектнойЗадачи(ПроектнаяЗадача, СвойстваПЗ);
	
	СхемаОплатыПЗ_Доходы = СхемыОплатыПЗ.СхемаОплатыПоУмолчаниюДоходы;
	СхемаОплатыПЗ_Расходы = СхемыОплатыПЗ.СхемаОплатыПоУмолчаниюРасходы;
	
КонецПроцедуры

Функция ВерсииПроектов(Проекты)
	
	ВерсииПроектов = Новый Массив;
	
	Если Не ЗначениеЗаполнено(Проекты) Тогда
		Возврат ВерсииПроектов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проекты", Проекты);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВерсииПроекта.Версия КАК Версия
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	упоВерсииПроекта.Проект В (&Проекты)";
	
	Результат = Запрос.Выполнить();
	Версии = Результат.Выгрузить().ВыгрузитьКолонку("Версия");
	
	Возврат Версии;
	
КонецФункции

Процедура ДобавитьРесурс(Массив, Ресурс)
	
	Если ТипЗнч(Ресурс) = Тип("СправочникСсылка.упоТрудовыеРесурсы") 
		Или ТипЗнч(Ресурс) = Тип("СправочникСсылка.упоРоли") Тогда
		Массив.Добавить(Ресурс);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьТрудозатратыПриИзмененииНормСтоимости(ДокументРегистрация, Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументРегистрация.ДополнительныеСвойства.Свойство("ОтключитьАвтоматическоеОтражениеТрудозатрат") Тогда
		Возврат;
	КонецЕсли;
	
	Ресурсы = РесурсыДокументаРегистрация(ДокументРегистрация);
	Если Не ЗначениеЗаполнено(Ресурсы)Тогда
		Возврат;
	КонецЕсли;
	
	ПроектныеЗадачи = ПроектныеЗадачиРесурсовНаДатуРегистрацииНормыСтоимости(Ресурсы, ДокументРегистрация.Дата);
	Если Не ЗначениеЗаполнено(ПроектныеЗадачи) Тогда
		Возврат;
	КонецЕсли;
	
	// Принудительная запись движений для получения актуальных норм стоимости при отражении внутри транзакции проведения.
	ДокументРегистрация.Движения.упоНормыСтоимостиРесурсов.Записать();
	
	ОтразитьПлановыеТрудозатратыЗадачи(ПроектныеЗадачи, ДокументРегистрация.Ссылка);
	
КонецПроцедуры

Функция РесурсыДокументаРегистрация(ДокументРегистрация)
	
	МассивРесурсов = Новый Массив;
	
	Если ТипЗнч(ДокументРегистрация.Ссылка) = Тип("ДокументСсылка.упоРегистрацияСтоимостиРесурса") Тогда
		ДобавитьРесурс(МассивРесурсов, ДокументРегистрация.Ресурс);
	ИначеЕсли ТипЗнч(ДокументРегистрация.Ссылка) = Тип("ДокументСсылка.упоРегистрацияСтоимостиРесурсов") Тогда
		Для Каждого Строка Из ДокументРегистрация.РегистрируемыеРесурсы Цикл
			ДобавитьРесурс(МассивРесурсов, Строка.Ресурс);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивРесурсов;
	
КонецФункции

Функция ПроектныеЗадачиРесурсовНаДатуРегистрацииНормыСтоимости(Ресурсы, Дата)
	
	ПроектныеЗадачи = Новый Массив;
	
	СтатусыИсключения = Новый Массив;
	СтатусыИсключения.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Завершена);
	СтатусыИсключения.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивРесурсов", Ресурсы);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивСтатусов", СтатусыИсключения);
	
	// Запрос выполняется в рамках проведения документов в привилегированном режиме при проведении.
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоТрудозатратыПлан.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ ВТ_ПЗТР
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия КАК упоТрудозатратыПлан
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоНастройкаАналитикиВРазрезеПодразделений КАК упоНастройкаАналитикиВРазрезеПодразделений
	               |		ПО упоТрудозатратыПлан.Проект = упоНастройкаАналитикиВРазрезеПодразделений.Объект
	               |			И (упоНастройкаАналитикиВРазрезеПодразделений.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат)
	               |ГДЕ
	               |	упоТрудозатратыПлан.Ресурс В(&МассивРесурсов)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоТрудозатратыПлан.ПроектнаяЗадача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоВерсииПроекта.Версия КАК Версия,
	               |	упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ ВТ_Сроки
	               |ИЗ
	               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, ) КАК упоСрокиПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСрокиПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПЗТР КАК ВТ_ПЗТР
	               |		ПО упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача = ВТ_ПЗТР.ПроектнаяЗадача
	               |ГДЕ
	               |	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан <= &Дата
	               |	И упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан >= &Дата
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСтатусыПроектныхЗадачСрезПоследних.Версия КАК Версия,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ ВТ_Статусы
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
	               |			,
	               |			(Версия, ПроектнаяЗадача) В
	               |				(ВЫБРАТЬ
	               |					ВТ_Сроки.Версия КАК Версия,
	               |					ВТ_Сроки.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |				ИЗ
	               |					ВТ_Сроки КАК ВТ_Сроки)) КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |ГДЕ
	               |	НЕ упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи В (&МассивСтатусов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			(Версия, ПроектнаяЗадача) В
	               |				(ВЫБРАТЬ
	               |					ВТ_Статусы.Версия КАК Версия,
	               |					ВТ_Статусы.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |				ИЗ
	               |					ВТ_Статусы КАК ВТ_Статусы)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |ГДЕ
	               |	НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		ПроектныеЗадачи = Результат.Выгрузить().ВыгрузитьКолонку("ПроектнаяЗадача");
	КонецЕсли;
	
	Возврат ПроектныеЗадачи;
	
КонецФункции

Функция ПолучитьСтоимостьЧасаРесурса(ТаблицаСтоимостиПоНорме, СтрокаРесурс, НормаСтоимостиТрудовыхРесурсов,
		СтрокиНорм = Неопределено, УчитыватьПериодРегистрацииНормСтоимости)
	
	// Для полученных ресурсов получим единицу стоимости по норме.
	СтрокиНорм = ТаблицаСтоимостиПоНорме.НайтиСтроки(Новый Структура("Ресурс, Норма",
		СтрокаРесурс.Ресурс, НормаСтоимостиТрудовыхРесурсов));
	
	// Когда ТР назначен, но его норма стоимости не внесена, берем норму стоимости из его роли.
	Если Не ЗначениеЗаполнено(СтрокиНорм) Тогда								
		СтрокиНорм = ТаблицаСтоимостиПоНорме.НайтиСтроки(Новый Структура("Ресурс, Норма",
			СтрокаРесурс.Роль, НормаСтоимостиТрудовыхРесурсов)); 
	КонецЕсли;
		
	Если УчитыватьПериодРегистрацииНормСтоимости Тогда
		СтоимостьЧаса = 0;
	Иначе
		Если СтрокиНорм.Количество() Тогда
			// Пересчитаем стоимость по норме трудового ресурса.
			СтоимостьЧаса = СтрокиНорм[0].СтоимостьЧаса;
		Иначе
			// Если норма не зарегистрирована, пишем 0.
			СтоимостьЧаса = 0;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат СтоимостьЧаса;
	
КонецФункции

#КонецОбласти

#Область РаспределениеРесурсовПоДням

// Получает дерево трудозатрат ресурсов по дням.
//
// Параметры:
//  ТаблицаРесурсов  - ТаблицаЗначений - Таблица распределяемых ресурсов.
//                 
//  СтруктураПараметров  - Структура - Ключи: 
//                 * ДанныеДокумента - Структура.
//                 * Календарь - СправочникСсылка.упоРабочиеКалендари.
//                 * НачДата - Дата.
//                 * КонДата - Дата.
// Возвращаемое значение:
//  ДеревоЗначений.
//
Функция ПолучитьТрудозатратыПоДням(СвойстваЗадачи,
		ТрудовыеРесурсы_Роли,
		ТрудовыеРесурсыПоПериодам,
		ПараметрыРаспределения,
		ИндексыБылоСтало = Неопределено)
	
	Если Не ЗначениеЗаполнено(ТрудовыеРесурсы_Роли) Тогда
		Возврат СоздатьДеревоДанныеРасчета();
	КонецЕсли;
	
	ОбщаяТаблицаРесурсов = ДобавитьНазначенныеТрудовыеРесурсы(СвойстваЗадачи, ТрудовыеРесурсы_Роли);
	
	Если Не ЗначениеЗаполнено(ОбщаяТаблицаРесурсов) Тогда
		Возврат СоздатьДеревоДанныеРасчета();
	КонецЕсли;
	
	ТрудозатратыПоДням = РаспределитьПоДолеТрудозатрат_ПоПрофилям(ОбщаяТаблицаРесурсов,
		СвойстваЗадачи.Календарь, СвойстваЗадачи.ДатаНач, СвойстваЗадачи.ДатаКон);
	
	Если Не ЗначениеЗаполнено(ТрудозатратыПоДням) Тогда
		Возврат СоздатьДеревоДанныеРасчета();
	КонецЕсли;
	
	РаспределитьПоДолеТрудозатрат_ПоМесяцам(ОбщаяТаблицаРесурсов,
		ТрудовыеРесурсыПоПериодам,
		СвойстваЗадачи.Календарь,
		СвойстваЗадачи.ДатаНач,
		СвойстваЗадачи.ДатаКон,
		ТрудозатратыПоДням,
		ИндексыБылоСтало);
	
	Если ПараметрыРаспределения.ИспользуетсяРаспределениеРесурсовПоДням Тогда
		РаспределитьПоРучномуРаспределениюТР(СвойстваЗадачи.ПроектнаяЗадача, 
			ТрудовыеРесурсы_Роли, ОбщаяТаблицаРесурсов, ТрудозатратыПоДням);
	КонецЕсли;
		
	Если ПараметрыРаспределения.ИспользуетсяОперЗагрузка Тогда
		РаспределитьПоОперативнойЗагрузке(СвойстваЗадачи.ПроектнаяЗадача, 
			СвойстваЗадачи.ТекущаяВерсия, ОбщаяТаблицаРесурсов, ТрудозатратыПоДням);
	КонецЕсли;
	
	Возврат ТрудозатратыПоДням;
	
КонецФункции

// Перестраивает таблицу трудовых ресурсов для распределения трудозатрат
// в зависимости от режима, указанного в проектной задаче.
//
// Параметры:
//  ПроектнаяЗадача	– ДокументСсылка.упоПроектнаяЗадача. 
//  ТрудовыеРесурсы	– ТаблицаЗначений - исходная таблица
//					  трудовых ресурсов и профилей.
//
// Возвращаемое значение:
//   ТаблицаЗначений	- подготовленная таблица.
//
Функция ДобавитьНазначенныеТрудовыеРесурсы(СвойстваЗадачи, ТрудовыеРесурсы_Роли)
	
	ТрудовыеРесурсы_Роли.Колонки.Добавить("ВариантРаспределения",
		Новый ОписаниеТипов("ПеречислениеСсылка.упоВариантыРаспределенияТрудозатрат"));
	ТрудовыеРесурсы_Роли.Колонки.Добавить("Роль",
		Новый ОписаниеТипов("СправочникСсылка.упоРоли"));
	ТрудовыеРесурсы_Роли.ЗаполнитьЗначения(Перечисления.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат,
		"ВариантРаспределения");
	ТрудовыеРесурсы_Роли.Колонки.Добавить("ДоляТрудозатрат",
		Новый ОписаниеТипов("Число"));
	
	Если Не СвойстваЗадачи.ПланироватьТрудозатратыНаИсполнителей Тогда
		Возврат ТрудовыеРесурсы_Роли;
	КонецЕсли;
	
	// Получаем текущих исполнителей, назначенных на выполнение проектной задачи.
	
	ТекстЗапроса = ТекстНормыСтоимостиТекущихИсполнителейПЗ();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", СвойстваЗадачи.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваЗадачи.ТекущаяВерсия);
	Запрос.УстановитьПараметр("ВариантПоДолеТрудозатрат",
		Перечисления.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат);
	Запрос.УстановитьПараметр("НормаСтоимости", СвойстваЗадачи.НормаСтоимостиТрудовыхРесурсов);
	Запрос.УстановитьПараметр("НормаСтоимостиВнешняя", СвойстваЗадачи.ВнешняяНормаСтоимостиТрудовыхРесурсов);
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	ИндексПоследнего = РезультатПакета.ВГраница();
	
	НазначенныеТрудовыеРесурсы_ВнутрНорма = РезультатПакета[ИндексПоследнего - 1].Выгрузить();
	НазначенныеТрудовыеРесурсы_ВнешнНорма = РезультатПакета[ИндексПоследнего].Выгрузить();
	
	// Готовим таблицу для результата.
	
	ТаблицаРезультат = ТрудовыеРесурсы_Роли.СкопироватьКолонки();
	ТаблицаРезультат.Колонки.Удалить("Ресурс");
	ТаблицаРезультат.Колонки.Добавить("Ресурс",
		Новый ОписаниеТипов("СправочникСсылка.упоРоли, СправочникСсылка.упоТрудовыеРесурсы"));
	
	ОтборПоНорме = Новый Структура("РольРесурса, Подразделение");
	
	ОтборПоУровнюПланирования = Новый Структура("Ресурс, Подразделение, УровеньПланирования");
	ОтборПоУровнюПланирования.УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
	
	Для каждого СтрокаТР Из ТрудовыеРесурсы_Роли Цикл
		
		СтрокаРезультат = ТаблицаРезультат.Добавить();
		СтрокаРезультат.УровеньПланирования = СтрокаТР.УровеньПланирования;
		ЗаполнитьЗначенияСвойств(СтрокаРезультат, СтрокаТР);
		
		ОтборПоНорме.РольРесурса = СтрокаТР.Ресурс;
		ОтборПоНорме.Подразделение = СтрокаТР.Подразделение;
		
		ОтборПоУровнюПланирования.Ресурс = СтрокаТР.Ресурс;
		ОтборПоУровнюПланирования.Подразделение = СтрокаТР.Подразделение;
		ЕстьОкончательныйУровеньПоРоли = ТрудовыеРесурсы_Роли.НайтиСтроки(ОтборПоУровнюПланирования).Количество() <> 0;
		
		РассчитатьТаблицуРесурсовПоНормам(ТаблицаРезультат,
			НазначенныеТрудовыеРесурсы_ВнутрНорма,
			ОтборПоНорме,
			СтрокаТР,
			ЕстьОкончательныйУровеньПоРоли);
		
		РассчитатьТаблицуРесурсовПоНормам(ТаблицаРезультат,
			НазначенныеТрудовыеРесурсы_ВнешнНорма,
			ОтборПоНорме,
			СтрокаТР,
			ЕстьОкончательныйУровеньПоРоли,
			Истина);
		
	КонецЦикла;
	
	СуммовыеКолонки = Новый Соответствие();
	СуммовыеКолонки.Вставить("Количество", 			Истина);
	СуммовыеКолонки.Вставить("Стоимость", 			Истина);
	СуммовыеКолонки.Вставить("ОбщСтоимость", 		Истина);
	СуммовыеКолонки.Вставить("ВнешняяСтоимость", 	Истина);
	СуммовыеКолонки.Вставить("ОбщВнешняяСтоимость", Истина);
	
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ТаблицаРезультат, СуммовыеКолонки);
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура РассчитатьТаблицуРесурсовПоНормам(ТаблицаРезультат,
		ТаблицаНормыНазначенныхРесурсов,
		ОтборПоНорме,
		СтрокаТР,
		ЕстьОкончательныйУровеньПоРоли,
		ЭтоВнешняяСтоимость = Ложь)
	
	СтрокиЗапроса = ТаблицаНормыНазначенныхРесурсов.НайтиСтроки(ОтборПоНорме);
	
	Если СтрокиЗапроса.Количество() = 0 Тогда
		Возврат; // Никто не был назначен на выполнение роли.
	КонецЕсли;
	
	ШаблонИсключения = "%1,%2";
	Если ЭтоВнешняяСтоимость Тогда
		ИмяКолонкиСтоимость 		= "ВнешняяСтоимость";
		ИмяКолонкиОбщаяСтоимость 	= "ОбщВнешняяСтоимость";
		СвойстваИсключенияЗаполнения = СтрШаблон(ШаблонИсключения, "Стоимость", "ОбщСтоимость");
	Иначе
		ИмяКолонкиСтоимость 		= "Стоимость";
		ИмяКолонкиОбщаяСтоимость 	= "ОбщСтоимость";
		СвойстваИсключенияЗаполнения = СтрШаблон(ШаблонИсключения, "ВнешняяСтоимость", "ОбщВнешняяСтоимость");
	КонецЕсли;
	
	ОкончательныйУровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
	
	// На одну роль может быть назначено несколько исполнителей в этом
	// случае трудозатраты распределяются согласно заданными долям.
	
	Для Каждого СтрокаЗапроса Из СтрокиЗапроса Цикл
		
		ПропуститьОбработкуСтроки = Не НужнаОбработкаСтроки(СтрокаЗапроса,
				ЕстьОкончательныйУровеньПоРоли,
				СтрокаТР.УровеньПланирования);
		
		Если ПропуститьОбработкуСтроки Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультат = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезультат, СтрокаТР, , СвойстваИсключенияЗаполнения);
		СтрокаРезультат.Ресурс 						= СтрокаЗапроса.Ресурс;
		СтрокаРезультат.ВариантРаспределения 		= СтрокаЗапроса.ВариантРаспределения;
		СтрокаРезультат.Роль 						= СтрокаТР.Ресурс;
		СтрокаРезультат.Подразделение 				= СтрокаТР.Подразделение;
		СтрокаРезультат.ДоляТрудозатрат 		    = СтрокаЗапроса.ДоляТрудозатрат;    
		СтрокаРезультат.УровеньПланирования 		= ОкончательныйУровеньПланирования;
		СтрокаРезультат[ИмяКолонкиОбщаяСтоимость] 	= СтрокаЗапроса.ЕдСтоимость * СтрокаТР.Количество;
		СтрокаРезультат[ИмяКолонкиСтоимость] 		= СтрокаЗапроса.ЕдСтоимость;
		
		Если Не СтрокаЗапроса.ДоляТрудозатрат = 100 Тогда
			
			// Необходимо уменьшить плановые трудозатраты в соответствии с заданной долей.
			
			Коэффициент = СтрокаЗапроса.ДоляТрудозатрат / 100;
			
			СтрокаРезультат.Количество = Окр(СтрокаРезультат.Количество * Коэффициент, 2);
			СтрокаРезультат[ИмяКолонкиОбщаяСтоимость] = 
				Окр(СтрокаРезультат.Количество * СтрокаРезультат[ИмяКолонкиСтоимость], 2);
			
		КонецЕсли;
		
		Если ЭтоВнешняяСтоимость Тогда
			СтрокаРезультат.Количество = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстНормыСтоимостиТекущихИсполнителейПЗ()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Исполнители.Ресурс КАК Ресурс,
	               |	Исполнители.РольРесурса КАК РольРесурса,
	               |	Исполнители.ДоляТрудозатрат КАК ДоляТрудозатрат,
	               |	Исполнители.Подразделение КАК Подразделение,
	               |	Исполнители.ВариантРаспределения КАК ВариантРаспределения,
	               |	Исполнители.ДоляТрудозатратПоУровнюПланирования КАК ДоляТрудозатратПоУровнюПланирования,
	               |	НЕ(Исполнители.ДоляТрудозатрат = 0
	               |			И Исполнители.ВариантРаспределения = &ВариантПоДолеТрудозатрат) КАК РаспределениеКорректно
	               |ПОМЕСТИТЬ втИсполнители
	               |ИЗ
	               |	РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(
	               |			,
	               |			Версия = &ТекущаяВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК Исполнители
	               |ГДЕ
	               |	Исполнители.РесурсВыделен
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ресурс
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоНормыСтоимостиРесурсов.Ресурс КАК Ресурс,
	               |	упоНормыСтоимостиРесурсов.ЕдСтоимость КАК ЕдСтоимость,
	               |	упоНормыСтоимостиРесурсов.ЕдиницаНормирования КАК ЕдиницаНормирования,
	               |	упоНормыСтоимостиРесурсов.Норма КАК Норма
	               |ПОМЕСТИТЬ втНормыИсполнителей
	               |ИЗ
	               |	РегистрСведений.упоНормыСтоимостиРесурсов.СрезПоследних(
	               |			,
	               |			Ресурс В
	               |					(ВЫБРАТЬ
	               |						втИсполнители.Ресурс
	               |					ИЗ
	               |						втИсполнители
	               |					ГДЕ
	               |						втИсполнители.РаспределениеКорректно)
	               |				И Норма В (&НормаСтоимости, &НормаСтоимостиВнешняя)) КАК упоНормыСтоимостиРесурсов
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ресурс
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втИсполнители.Ресурс КАК Ресурс,
	               |	втИсполнители.РольРесурса КАК РольРесурса,
	               |	втИсполнители.ДоляТрудозатрат КАК ДоляТрудозатрат,
	               |	втИсполнители.Подразделение КАК Подразделение,
	               |	втИсполнители.ВариантРаспределения КАК ВариантРаспределения,
	               |	ЕСТЬNULL(втНормыИсполнителей.ЕдСтоимость, 0) КАК ЕдСтоимость,
	               |	ЕСТЬNULL(втНормыИсполнителей.ЕдиницаНормирования, НЕОПРЕДЕЛЕНО) КАК ЕдиницаНормирования,
	               |	втИсполнители.ДоляТрудозатратПоУровнюПланирования КАК ДоляТрудозатратПоУровнюПланирования
	               |ИЗ
	               |	втИсполнители КАК втИсполнители
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втНормыИсполнителей КАК втНормыИсполнителей
	               |		ПО втИсполнители.Ресурс = втНормыИсполнителей.Ресурс
	               |			И (втНормыИсполнителей.Норма = &НормаСтоимости)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втИсполнители.Ресурс КАК Ресурс,
	               |	втИсполнители.РольРесурса КАК РольРесурса,
	               |	втИсполнители.ДоляТрудозатрат КАК ДоляТрудозатрат,
	               |	втИсполнители.Подразделение КАК Подразделение,
	               |	втИсполнители.ВариантРаспределения КАК ВариантРаспределения,
	               |	ЕСТЬNULL(втНормыИсполнителей.ЕдСтоимость, 0) КАК ЕдСтоимость,
	               |	ЕСТЬNULL(втНормыИсполнителей.ЕдиницаНормирования, НЕОПРЕДЕЛЕНО) КАК ЕдиницаНормирования,
	               |	втИсполнители.ДоляТрудозатратПоУровнюПланирования КАК ДоляТрудозатратПоУровнюПланирования
	               |ИЗ
	               |	втИсполнители КАК втИсполнители
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втНормыИсполнителей КАК втНормыИсполнителей
	               |		ПО втИсполнители.Ресурс = втНормыИсполнителей.Ресурс
	               |			И (втНормыИсполнителей.Норма = &НормаСтоимостиВнешняя)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция НужнаОбработкаСтроки(СтрокаЗапроса, ЕстьОкончательныйУровеньПоРоли, УровеньПланированияПоРоли)
	
	НужнаОбработкаСтроки = Истина;
	
	ВариантРаспределения = СтрокаЗапроса.ВариантРаспределения;
	
	Если ВариантРаспределения = Перечисления.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат Тогда
		
		Если УровеньПланированияПоРоли <> СтрокаЗапроса.ДоляТрудозатратПоУровнюПланирования Тогда
			НужнаОбработкаСтроки = Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаЗапроса.ДоляТрудозатрат) Тогда
			НужнаОбработкаСтроки = Ложь;
		КонецЕсли;
		
	ИначеЕсли ВариантРаспределения = Перечисления.упоВариантыРаспределенияТрудозатрат.РучноеРаспределение 
		Или ВариантРаспределения = Перечисления.упоВариантыРаспределенияТрудозатрат.ПоОперативнойЗагрузке Тогда
		
		Если ЕстьОкончательныйУровеньПоРоли
			И УровеньПланированияПоРоли <> Перечисления.упоУровеньПланирования.Окончательный Тогда
			НужнаОбработкаСтроки = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НужнаОбработкаСтроки;
	
КонецФункции

Процедура РаспределитьПоОперативнойЗагрузке(ПроектнаяЗадача, Версия, ОбщаяТаблицаРесурсов, ТрудозатратыПоДням)
	
	Отбор = Новый Структура("ВариантРаспределения", Перечисления.упоВариантыРаспределенияТрудозатрат.ПоОперативнойЗагрузке);
	СтрокиПоОперативнойЗагрузке = ОбщаяТаблицаРесурсов.НайтиСтроки(Отбор);
	МассивИсполнителей = Новый Массив;
	Для Каждого СтрокаРесурсыПоОперативнойЗагрузке Из СтрокиПоОперативнойЗагрузке Цикл
		МассивИсполнителей.Добавить(СтрокаРесурсыПоОперативнойЗагрузке.Ресурс);
	КонецЦикла;
	
	РезультатТрудозатратыОперЗагрузка = ПолучитьДанныеОперативнойЗагрузкиИсполнителейПроектнойЗадачи(ПроектнаяЗадача, Версия, МассивИсполнителей);
	
	ВыборкаРесурс = РезультатТрудозатратыОперЗагрузка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРесурс.Следующий() Цикл
	
		ВыборкаРоль = ВыборкаРесурс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРоль.Следующий() Цикл
	
			ВыборкаПодразделение = ВыборкаРоль.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПодразделение.Следующий() Цикл
				
				СтрокаТрудозатратыПоДнямТрудовойРесурс = ТрудозатратыПоДням.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТрудозатратыПоДнямТрудовойРесурс, ВыборкаПодразделение);
				СтрокаТрудозатратыПоДнямТрудовойРесурс.УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
				
				ВыборкаДень = ВыборкаПодразделение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаДень.Следующий() Цикл
					СтрокаТрудозатратыПоДнямДень = СтрокаТрудозатратыПоДнямТрудовойРесурс.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТрудозатратыПоДнямДень, ВыборкаДень);
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьПоРучномуРаспределениюТР(ПроектнаяЗадача, ТрудовыеРесурсы_Роли, ОбщаяТаблицаРесурсов, ТрудозатратыПоДням)
	
	Отбор = Новый Структура("ВариантРаспределения", Перечисления.упоВариантыРаспределенияТрудозатрат.РучноеРаспределение);
	СтрокиРучноеРаспределение = ОбщаяТаблицаРесурсов.НайтиСтроки(Отбор);
	МассивИсполнителейРучногоРаспределения = Новый Массив;
	Для Каждого СтрокаРесурсыРучноеРаспределение Из СтрокиРучноеРаспределение Цикл
		МассивИсполнителейРучногоРаспределения.Добавить(СтрокаРесурсыРучноеРаспределение.Ресурс);
	КонецЦикла;
	
	МассивРолей = ТрудовыеРесурсы_Роли.ВыгрузитьКолонку("Ресурс");
	
	РезультатТрудозатратыРучноеРаспределение = ПолучитьДанныеРучногоРаспределенияТрудозатратТРПроектнойЗадачи(
		ПроектнаяЗадача, 
		МассивРолей, 
		МассивИсполнителейРучногоРаспределения);
	
	ВыборкаРесурс = РезультатТрудозатратыРучноеРаспределение.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРесурс.Следующий() Цикл
		
		СтрокаТрудозатратыПоДнямТрудовойРесурс = ТрудозатратыПоДням.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТрудозатратыПоДнямТрудовойРесурс, ВыборкаРесурс);
		СтрокаТрудозатратыПоДнямТрудовойРесурс.УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
		
		ВыборкаДень = ВыборкаРесурс.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДень.Следующий() Цикл
			СтрокаТрудозатратыПоДнямДень = СтрокаТрудозатратыПоДнямТрудовойРесурс.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТрудозатратыПоДнямДень, ВыборкаДень);
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Функция РаспределитьПоДолеТрудозатрат_ПоПрофилям(ОбщаяТаблицаРесурсов, Календарь, НачДата, КонДата) 
	
	ОтборСтрок = Новый Структура("ВариантРаспределения",  
						Перечисления.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат);
						
	ОтобранныеСтроки = ОбщаяТаблицаРесурсов.НайтиСтроки(ОтборСтрок);
	
	СтрокиПоПрофилю = Новый Массив;
	
	Для Каждого СтрокаПоДоле Из ОтобранныеСтроки Цикл
		Если СтрокаПоДоле.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаПоДоле.СпособПривязки) Тогда
			СтрокиПоПрофилю.Добавить(СтрокаПоДоле);
		КонецЕсли;
	КонецЦикла;
						
	ТаблицаРесурсовДляРаспределения = ОбщаяТаблицаРесурсов.Скопировать(СтрокиПоПрофилю);
		
	ТрудозатратыПоДням = РаспределитьТрудозатратыПоПрофилям(ТаблицаРесурсовДляРаспределения,
															Календарь,
															НачДата,
															КонДата);
															
	Возврат ТрудозатратыПоДням;					
	
КонецФункции

Процедура РаспределитьПоДолеТрудозатрат_ПоМесяцам(ОбщаяТаблицаРесурсов, ТрудовыеРесурсыПоПериодам, Календарь, НачДата,
	КонДата, ТрудозатратыПоДням, ИндексыБылоСтало) 
	
	ОтборСтрок = Новый Структура("СпособПривязки, ВариантРаспределения", 
		Перечисления.упоСпособПривязкиРаспределения.Вручную, 
		Перечисления.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат);
	ТемпТаблицаРесурсовДляРаспределенияСРучнойПривязкой = ОбщаяТаблицаРесурсов.Скопировать(ОтборСтрок);
	
	// Создадим ТЗ ТаблицаРесурсовДляРаспределенияСРучнойПривязкой и соберем в нее данные распределения
	// с учетом ручной привязки по месяцам. Далее дополним полученным результатом ТЗ ТрудозатратыПоДням.
	ТаблицаРесурсовДляРаспределенияСРучнойПривязкой = НоваяТаблицаРесурсовСРучнойПривязкой(ОбщаяТаблицаРесурсов);
	
	ДанныеПолногоПериода = ДанныеПолногоПериода(НачДата, КонДата);
	
	РаспределеныВсеСуммыЦикла = Ложь;
	
	Если ЗначениеЗаполнено(ИндексыБылоСтало) Тогда	
		ПересчитатьИндексыТрудовыхРесурсовПоПериодам(ТрудовыеРесурсыПоПериодам, ИндексыБылоСтало); 
	КонецЕсли;

	// Заполняем ТЗ ТаблицаРесурсовДляРаспределенияСРучнойПривязкой.
	Для каждого СтрокаТемпТаблицы Из ТемпТаблицаРесурсовДляРаспределенияСРучнойПривязкой Цикл
		
		ОтборСтрок = Новый Структура("ИндексСтрокиРаспределениеПоРолям", 
			СтрокаТемпТаблицы.ИндексСтрокРаспределенияПоПериодам);
		ИскомыеСтроки = ТрудовыеРесурсыПоПериодам.НайтиСтроки(ОтборСтрок);
		ДанныеРаспределенияПоПериодамДляСтрокиТемпТаблицы = ТрудовыеРесурсыПоПериодам.Скопировать(ИскомыеСтроки);
		ДанныеРаспределенияПоПериодамДляСтрокиТемпТаблицы.Сортировать("Период Возр");
		
		СуммаКРаспределению = СтрокаТемпТаблицы.ОбщСтоимость;
		СуммаВнешняяКРаспределению = СтрокаТемпТаблицы.ОбщВнешняяСтоимость;
		КоличествоКРаспределению = СтрокаТемпТаблицы.Количество;
		
		Для каждого СтрокаДанныеРаспределения Из ДанныеРаспределенияПоПериодамДляСтрокиТемпТаблицы Цикл
			
			НС = ТаблицаРесурсовДляРаспределенияСРучнойПривязкой.Добавить();
			ЗаполнитьЗначенияСвойств(НС, СтрокаТемпТаблицы, , "Количество, ОбщСтоимость, ОбщВнешняяСтоимость");
			
			ДоляТрудозатрат = СтрокаТемпТаблицы.ДоляТрудозатрат; 
			ДоляТрудозатрат = ?(ДоляТрудозатрат = Неопределено Или ДоляТрудозатрат = 0, 100, ДоляТрудозатрат);
			
			КоличествоРаспределенияЗаПериод = Окр(СтрокаДанныеРаспределения.Количество * (ДоляТрудозатрат / 100), 2);
			
			Если КоличествоКРаспределению > КоличествоРаспределенияЗаПериод Тогда
				НС.Количество = КоличествоРаспределенияЗаПериод;
			Иначе
				НС.Количество = КоличествоКРаспределению;
			КонецЕсли;
			
			Если НС.Количество >= КоличествоКРаспределению Тогда
				НС.ОбщСтоимость = СуммаКРаспределению;
				НС.ОбщВнешняяСтоимость = СуммаВнешняяКРаспределению;
			Иначе
				Если СтрокаТемпТаблицы.Количество <> 0 Тогда
					НС.ОбщСтоимость = Окр(СтрокаТемпТаблицы.ОбщСтоимость/СтрокаТемпТаблицы.Количество * НС.Количество, 2);
					НС.ОбщВнешняяСтоимость = Окр(СтрокаТемпТаблицы.ОбщВнешняяСтоимость/СтрокаТемпТаблицы.Количество * НС.Количество, 2);
				Иначе
					НС.ОбщСтоимость = 0;
					НС.ОбщВнешняяСтоимость = 0;
				КонецЕсли;
			КонецЕсли;
			
			СуммаКРаспределению = СуммаКРаспределению - НС.ОбщСтоимость;
			СуммаВнешняяКРаспределению = СуммаВнешняяКРаспределению - НС.ОбщВнешняяСтоимость;
			КоличествоКРаспределению = КоличествоКРаспределению - НС.Количество;
			
			ПериодМесяц = НачалоКонецМесяцаВнутриПериода(СтрокаДанныеРаспределения.Период, ДанныеПолногоПериода);
			
			ТемпТрудозатратыПоДням = РаспределитьТрудозатратыПоПрофилям(ТаблицаРесурсовДляРаспределенияСРучнойПривязкой,
				Календарь,
				ПериодМесяц.ДатаНачала,
				КонецДня(ПериодМесяц.ДатаОкончания));
			
			// Дополним дерево ТрудозатратыПоДням полученными данными.
			Для каждого СтрокаТрудозатратыПоДням Из ТемпТрудозатратыПоДням.Строки Цикл
				
				ПараметрыОтбора = Новый Структура("Ресурс, Подразделение, УровеньПланирования, ИсточникПлана", 
					СтрокаТрудозатратыПоДням.Ресурс, 
					СтрокаТрудозатратыПоДням.Подразделение, 
					СтрокаТрудозатратыПоДням.УровеньПланирования,
					СтрокаТрудозатратыПоДням.ИсточникПлана);
				ТемпИскомыеСтроки = ТрудозатратыПоДням.Строки.НайтиСтроки(ПараметрыОтбора);
				Если ТемпИскомыеСтроки.Количество() = 0 Тогда
					СтрокаТрудозатратыПоДнямТрудовойРесурс = ТрудозатратыПоДням.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТрудозатратыПоДнямТрудовойРесурс, СтрокаТрудозатратыПоДням);
					СтрокаТрудозатратыПоДнямТрудовойРесурс.Стоимость = СтрокаТемпТаблицы.ОбщСтоимость;
					СтрокаТрудозатратыПоДнямТрудовойРесурс.ВнешняяСтоимость = СтрокаТемпТаблицы.ОбщВнешняяСтоимость;
					РаспределеныВсеСуммыЦикла = Истина;
				Иначе
					СтрокаТрудозатратыПоДнямТрудовойРесурс = ТемпИскомыеСтроки[0];
					СтрокаТрудозатратыПоДнямТрудовойРесурс.Трудозатраты = СтрокаТрудозатратыПоДнямТрудовойРесурс.Трудозатраты 
						+ СтрокаТрудозатратыПоДням.Трудозатраты;
					Если Не РаспределеныВсеСуммыЦикла Тогда
						СтрокаТрудозатратыПоДнямТрудовойРесурс.Стоимость = СтрокаТрудозатратыПоДнямТрудовойРесурс.Стоимость
							+ СтрокаТрудозатратыПоДням.Стоимость;
						СтрокаТрудозатратыПоДнямТрудовойРесурс.ВнешняяСтоимость = СтрокаТрудозатратыПоДнямТрудовойРесурс.ВнешняяСтоимость 
							+ СтрокаТрудозатратыПоДням.ВнешняяСтоимость;
					КонецЕсли;
					// Смущает следующая строка.
					СтрокаТрудозатратыПоДнямТрудовойРесурс.День = 
						Макс(СтрокаТрудозатратыПоДнямТрудовойРесурс.День, СтрокаТрудозатратыПоДням.День);
				КонецЕсли;
				
				Для каждого СтрокаДень Из СтрокаТрудозатратыПоДням.Строки Цикл
					СтрокаТрудозатратыПоДнямДень = СтрокаТрудозатратыПоДнямТрудовойРесурс.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТрудозатратыПоДнямДень, СтрокаДень);
				КонецЦикла;
				
			КонецЦикла;
			
			ТаблицаРесурсовДляРаспределенияСРучнойПривязкой.Очистить();
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяТаблицаРесурсовСРучнойПривязкой(ОбщаяТаблицаРесурсов)
	
	ТаблицаРесурсовДляРаспределенияСРучнойПривязкой = ОбщаяТаблицаРесурсов.СкопироватьКолонки();
	ТаблицаРесурсовДляРаспределенияСРучнойПривязкой.Колонки.Удалить("Количество");
	ТаблицаРесурсовДляРаспределенияСРучнойПривязкой.Колонки.Добавить("Количество", 
		Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15, 5)));
		
	Возврат ТаблицаРесурсовДляРаспределенияСРучнойПривязкой;
	
КонецФункции

Функция ДанныеПолногоПериода(НачДата, КонДата)
	
	Результат = Новый Структура;
	Результат.Вставить("НачДата", НачДата);
	Результат.Вставить("КонДата", КонДата);
	Результат.Вставить("НачалоМесяцаПериод", НачалоМесяца(НачДата));
	Результат.Вставить("КонецМесяцаПериод", КонецМесяца(КонДата));
	
	Возврат Результат;
	
КонецФункции

Функция НачалоКонецМесяцаВнутриПериода(МесяцРаспределения, ДанныеПолногоПериода)
	
	// см.ДанныеПолногоПериода()
	НачалоПолногоПериода = ДанныеПолногоПериода.НачДата;
	КонецПолногоПериода = ДанныеПолногоПериода.КонДата;
	НачалоМесяцаПериод = ДанныеПолногоПериода.НачалоМесяцаПериод;
	КонецМесяцаПериод = ДанныеПолногоПериода.КонецМесяцаПериод;
	
	НачалоМесяцаСтрокаРаспределения = НачалоМесяца(МесяцРаспределения);
	КонецМесяцаСтрокаРаспределения = КонецМесяца(МесяцРаспределения);
	
	Если НачалоМесяцаСтрокаРаспределения = НачалоМесяцаПериод Тогда
		НачДатаПериода = Макс(НачалоМесяцаСтрокаРаспределения, НачалоПолногоПериода);
	Иначе
		НачДатаПериода = НачалоМесяцаСтрокаРаспределения;
	КонецЕсли;
	
	Если КонецМесяцаСтрокаРаспределения = КонецМесяцаПериод Тогда 
		КонДатаПериода = Мин(КонецПолногоПериода, КонецМесяца(НачДатаПериода));
	Иначе
		КонДатаПериода = КонецМесяца(НачДатаПериода);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаНачала", НачДатаПериода);
	Результат.Вставить("ДатаОкончания", КонДатаПериода);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеРучногоРаспределенияТрудозатратТРПроектнойЗадачи(ПроектнаяЗадача, МассивРолей, МассивИсполнителей)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних.Ресурс КАК Ресурс,
	               |	упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних.Роль,
	               |	упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних.Дата КАК День,
	               |	упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних.Подразделение КАК Подразделение,
	               |	упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних.Трудозатраты
	               |ИЗ
	               |	РегистрСведений.упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДням.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача = &ПроектнаяЗадача
	               |				И Роль В (&МассивРолей)
	               |				И Ресурс В (&МассивИсполнителей)) КАК упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних
	               |ГДЕ
	               |	упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДнямСрезПоследних.Трудозатраты <> 0
	               |ИТОГИ
	               |	МАКСИМУМ(Роль),
	               |	МАКСИМУМ(Подразделение)
	               |ПО
	               |	Ресурс";
	 
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("МассивРолей", МассивРолей);
	Запрос.УстановитьПараметр("МассивИсполнителей", МассивИсполнителей);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ПолучитьДанныеОперативнойЗагрузкиИсполнителейПроектнойЗадачи(ПроектнаяЗадача, Версия, МассивИсполнителей)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Ресурс КАК Ресурс,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Подразделение КАК Подразделение,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса КАК Роль
	               |ПОМЕСТИТЬ втВыделенныеРесурсы
	               |ИЗ
	               |	РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(
	               |			,
	               |			Версия = &ТекВерсия
	               |				И Ресурс В (&МассивИсполнителей)
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоВыделенныеТрудовыеРесурсыСрезПоследних
	               |ГДЕ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РесурсВыделен
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ресурс
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ТрудовойРесурс КАК Ресурс,
	               |	НАЧАЛОПЕРИОДА(упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя, ДЕНЬ) КАК День,
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя) КАК Трудозатраты,
	               |	втВыделенныеРесурсы.Подразделение КАК Подразделение,
	               |	втВыделенныеРесурсы.Роль КАК Роль
	               |ИЗ
	               |	РегистрСведений.упоОперативнаяЗагрузкаСпециалистов.СрезПоследних(, ТрудовойРесурс В (&МассивИсполнителей)) КАК упоОперативнаяЗагрузкаСпециалистовСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втВыделенныеРесурсы КАК втВыделенныеРесурсы
	               |		ПО упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ТрудовойРесурс = втВыделенныеРесурсы.Ресурс
	               |ГДЕ
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача = &ПроектнаяЗадача
	               |	И упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Занят
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ТрудовойРесурс,
	               |	НАЧАЛОПЕРИОДА(упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя, ДЕНЬ),
	               |	втВыделенныеРесурсы.Подразделение,
	               |	втВыделенныеРесурсы.Роль
	               |ИТОГИ ПО
	               |	Ресурс,
	               |	Роль,
	               |	Подразделение";
	
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ТекВерсия", Версия);
	Запрос.УстановитьПараметр("МассивИсполнителей", МассивИсполнителей);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

// Создает дерево данных расчета.
// 
// Возвращаемое значение:
//  ДеревоЗначений - дерево с данными.
//
Функция СоздатьДеревоДанныеРасчета()
	
	ДанныеРасчета = Новый ДеревоЗначений();
	
	ДанныеРасчета.Колонки.Добавить("Ресурс",
		Новый ОписаниеТипов("СправочникСсылка.упоТрудовыеРесурсы, СправочникСсылка.упоРоли"));
	ДанныеРасчета.Колонки.Добавить("Роль",
		Новый ОписаниеТипов("СправочникСсылка.упоРоли"));
	ДанныеРасчета.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.упоПодразделения"));
	ДанныеРасчета.Колонки.Добавить("УровеньПланирования", Новый ОписаниеТипов("ПеречислениеСсылка.упоУровеньПланирования"));
	ДанныеРасчета.Колонки.Добавить("ИсточникПлана",
		Новый ОписаниеТипов("ПеречислениеСсылка.упоИсточникПланаТрудозатратРолей"));
	
	// На уровне ресурса - дата завершения работ в целом, на уровне дня - рабочий день.
	ДанныеРасчета.Колонки.Добавить("День", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата))); 
	   
	// На уровне ресурса - общая длительность работ по календарю проекта,
	// на уровне дня - трудозатраты на конкретный день.
	ДанныеРасчета.Колонки.Добавить("Трудозатраты", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный))); 
												   
	ДанныеРасчета.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)));
												
	ДанныеРасчета.Колонки.Добавить("ВнешняяСтоимость", Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный)));												
	
	Возврат ДанныеРасчета;
	
КонецФункции

Функция ШаблонТаблицыТрудозатратПоДнямДляЗаполненияПланаРасходов()
	
	ТаблицаТрудозатратПоДням = Новый ТаблицаЗначений;
	ТаблицаТрудозатратПоДням.Колонки.Добавить("Роль", Новый ОписаниеТипов("СправочникСсылка.упоРоли"));
	ТаблицаТрудозатратПоДням.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.упоПодразделения"));
	ТаблицаТрудозатратПоДням.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	ТаблицаТрудозатратПоДням.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	
	Возврат ТаблицаТрудозатратПоДням;
	
КонецФункции

#КонецОбласти

#Область ОчередьОтраженияПлановыхТрудозатрат

Процедура ОбработатьПорциюОтраженияПлановыхТрудозатратЗадач(ПроектныеЗадачи = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВсеЗадачи = ПроектныеЗадачи = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВсеЗадачи", ВсеЗадачи);
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ПроектныеЗадачи);
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 2000
	               |	упоОчередьОтраженияПлановыхТрудозатратЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоОчередьОтраженияПлановыхТрудозатратЗадач.НомерПопытки КАК НомерПопытки,
	               |	упоОчередьОтраженияПлановыхТрудозатратЗадач.ДатаВМиллиСекундах КАК ДатаВМиллиСекундах
	               |ИЗ
	               |	РегистрСведений.упоОчередьОтраженияПлановыхТрудозатратЗадач КАК упоОчередьОтраженияПлановыхТрудозатратЗадач
	               |ГДЕ
	               |	НЕ упоОчередьОтраженияПлановыхТрудозатратЗадач.Ошибка
	               |	И (&ВсеЗадачи
	               |			ИЛИ упоОчередьОтраженияПлановыхТрудозатратЗадач.ПроектнаяЗадача В (&ПроектныеЗадачи))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерПопытки,
	               |	упоОчередьОтраженияПлановыхТрудозатратЗадач.ДатаВМиллиСекундах";
	
	Если Не ВсеЗадачи Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПЕРВЫЕ 2000", "");	
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
				   	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Попытка 
			лОтразитьПлановыеТрудозатратыЗадачи(Выборка.ПроектнаяЗадача);
			УдалитьИзОчередиОтраженияПлановыхТрудозатратЗадач(Выборка.ПроектнаяЗадача, Выборка.ДатаВМиллиСекундах);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
			ЗаписатьОшибкуВОчередьОтраженияПлановыхТрудозатратЗадач(Выборка.ПроектнаяЗадача, 
																	ОписаниеОшибки, Выборка.НомерПопытки + 1);
			ВызватьИсключение ОписаниеОшибки;
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВОчередьОтраженияПлановыхТрудозатратЗадач(Предмет, Источник = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Дата = ТекущаяДата();
	ДатаВМиллиСекундах = ТекущаяУниверсальнаяДатаВМиллисекундах() + (ТекущаяДата() - ТекущаяУниверсальнаяДата());
		
	Если ТипЗнч(Предмет) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		МассивЗадач = Новый Массив;
		МассивЗадач.Добавить(Предмет);
				
	ИначеЕсли ТипЗнч(Предмет) = Тип("Массив") Тогда
		
		МассивЗадач = Предмет;
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Неправильный параметр'");
		
	КонецЕсли;	
	
	Для Каждого ПроектнаяЗадача Из МассивЗадач Цикл
		
		НаборЗаписей = РегистрыСведений.упоОчередьОтраженияПлановыхТрудозатратЗадач.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПроектнаяЗадача.Установить(ПроектнаяЗадача);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() <> 0 Тогда
			ЗаписиТолькоСОшибками = Истина;
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Не Запись.Ошибка Тогда
					ЗаписиТолькоСОшибками = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ЗаписиТолькоСОшибками Тогда
				Продолжить;
			Иначе
				НаборЗаписей.Очистить();
			КонецЕсли;		
		КонецЕсли;
		
		Запись = НаборЗаписей.Добавить();	
		ЗаполнитьНовуюЗаписьВОчереди(Запись, Источник, ПроектнаяЗадача, Дата, ДатаВМиллиСекундах);
		НаборЗаписей.Записать();
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ЗаполнитьНовуюЗаписьВОчереди(Запись, Источник, ПроектнаяЗадача,  
														Дата, ДатаВМиллиСекундах)
										
	Запись.ПроектнаяЗадача = ПроектнаяЗадача;										
	Запись.Источник = Источник;	
	Запись.Дата = Дата;
	Запись.ДатаВМиллиСекундах = ДатаВМиллиСекундах;
	Запись.Ошибка = Ложь;
	Запись.ОписаниеОшибки = "";
	
КонецПроцедуры

Функция ЗаписатьОшибкуВОчередьОтраженияПлановыхТрудозатратЗадач(ПроектнаяЗадача, ОписаниеОшибки, НомерПопытки) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.упоОчередьОтраженияПлановыхТрудозатратЗадач.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПроектнаяЗадача.Установить(ПроектнаяЗадача);
	НаборЗаписей.Прочитать();
	
	Запись = НаборЗаписей[0];
	
	Запись.Ошибка = НомерПопытки > 4;
	Запись.ОписаниеОшибки = "" + ТекущаяДата() + ": " + ОписаниеОшибки;
	Запись.НомерПопытки = НомерПопытки;
	
	НаборЗаписей.Записать();
	
КонецФункции 

Функция УдалитьИзОчередиОтраженияПлановыхТрудозатратЗадач(ПроектнаяЗадача, ПредыдущаяДатаВМиллиСекундах = Неопределено) 
	
	УстановитьПривилегированныйРежим(Истина);
    
    Если НЕ ПредыдущаяДатаВМиллиСекундах = Неопределено 
        И ОчередьОбновилась(ПроектнаяЗадача, ПредыдущаяДатаВМиллиСекундах) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
	НаборЗаписей =  РегистрыСведений.упоОчередьОтраженияПлановыхТрудозатратЗадач.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПроектнаяЗадача.Установить(ПроектнаяЗадача);
	НаборЗаписей.Записать();
	
КонецФункции 

Функция ОчередьОбновилась(ПроектнаяЗадача, ПредыдущаяДатаВМиллиСекундах)

    Результат = Ложь; 
        
    Запрос = Новый Запрос("ВЫБРАТЬ
    |   упоОчередьОтраженияПлановыхТрудозатратЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
    |   упоОчередьОтраженияПлановыхТрудозатратЗадач.ДатаВМиллиСекундах КАК ДатаВМиллиСекундах
    |ИЗ
    |   РегистрСведений.упоОчередьОтраженияПлановыхТрудозатратЗадач КАК упоОчередьОтраженияПлановыхТрудозатратЗадач
    |ГДЕ
    |   упоОчередьОтраженияПлановыхТрудозатратЗадач.ПроектнаяЗадача = &ПроектнаяЗадача
    |   И НЕ упоОчередьОтраженияПлановыхТрудозатратЗадач.Ошибка
    |   И упоОчередьОтраженияПлановыхТрудозатратЗадач.ДатаВМиллиСекундах > &ПредыдущаяДатаВМиллиСекундах");
    
    Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);    
    Запрос.УстановитьПараметр("ПредыдущаяДатаВМиллиСекундах", ПредыдущаяДатаВМиллиСекундах);    
    
    РезультатЗапроса = Запрос.Выполнить();
        
	Возврат НЕ РезультатЗапроса.Пустой();

КонецФункции // ОчередьОбновилась()

#КонецОбласти

#Область РаспределениеТрудозатратПоПрофилям

Функция ПодготовитьТаблицуДанныеТрудозатрат(ТрудовыеРесурсы)
	
	Если ТипЗнч(ТрудовыеРесурсы) = Тип("ТаблицаЗначений") Тогда
		ДанныеТрудозатрат = ТрудовыеРесурсы.Скопировать();
	Иначе
		ДанныеТрудозатрат = ТрудовыеРесурсы.Выгрузить();
	КонецЕсли; 
	
	// Дополним таблицу служебными колонками, они будут нужны для обратного расчета.
	
	ДанныеТрудозатрат.Колонки.Добавить("ПерегрузкаРесурса", Новый ОписаниеТипов("Булево"));
	ДанныеТрудозатрат.Колонки.Добавить("Трудозатраты");
	ДанныеТрудозатрат.Колонки.Добавить("КоличествоЧасовПериода");
	ДанныеТрудозатрат.Колонки.Добавить("СтоимостьЧаса");
	ДанныеТрудозатрат.Колонки.Добавить("ВнешняяСтоимостьЧаса");
	
	Возврат ДанныеТрудозатрат;
	
КонецФункции

Процедура ДополнитьТаблицуДанныеТрудозатрат(ДанныеТрудозатрат, ДанныеПериода, ДанныеПрофилей, ОбратныйРасчет)
	
	Для каждого СтрокаДанных Из ДанныеТрудозатрат Цикл
		
		// Теперь для каждого из трудовых ресурсов нужно пересчитать трудозатраты
		// в часы, а также сверить плановые трудозатраты
		// с максимальным количеством рабочих часов за период и оценить
		// вероятность "плановой перегрузки".
		
		СтрокаДанных.Трудозатраты = Окр(СтрокаДанных.Количество * СтрокаДанных.ЕдиницаНормирования.Коэффициент, 2);
		
		// Поскольку нужно будет считать распределение не 
		// только трудозатрат, но и стоимости, вычислим для
		// каждого трудового ресурса стоимость часа.
		
		СтрокаДанных.СтоимостьЧаса = 
			?(НЕ СтрокаДанных.Трудозатраты = 0, Окр(СтрокаДанных.ОбщСтоимость / СтрокаДанных.Трудозатраты, 2), 0);
			
		// TODO в некоторые моменты ОбщВнешняяСтоимость прилетает как Неопределено, вызывая ошибку
		// Истоки ошибки найти пока не удалось, поэтому пока принудительная инициализация.
		Если СтрокаДанных.ОбщВнешняяСтоимость = Неопределено Тогда
			СтрокаДанных.ОбщВнешняяСтоимость = 0;
		КонецЕсли;
		
		СтрокаДанных.ВнешняяСтоимостьЧаса = ?(НЕ СтрокаДанных.Трудозатраты = 0,
			Окр(СтрокаДанных.ОбщВнешняяСтоимость / СтрокаДанных.Трудозатраты, 2), 0);
		
		Если СтрокаДанных.ПрофильРаспределения.СпособРаспределения = 
			Перечисления.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределенияСПериодами 
			И ОбратныйРасчет Тогда
			
			СтрокаДанных.КоличествоЧасовПериода = ДанныеПериода.КоличествоЧасов;
			
		Иначе
				
			Если НЕ ОбратныйРасчет Тогда
				
				СтрокаДанных.ПерегрузкаРесурса = Ложь;
				СтрокаДанных.КоличествоЧасовПериода = 0;
				
			Иначе			
				
				// Необходимо определить максимальное количество рабочих
				// часов, которое можно распределить по периоду с
				// учетом заданного профиля распределения.
				
				// Вначале простая проверка на общее количество часов.
				
				СтрокаПрофиль = ДанныеПрофилей.Строки.Найти(СтрокаДанных.ПрофильРаспределения, "Профиль");
				Если НЕ СтрокаПрофиль = Неопределено Тогда
					
					МаксимальноеКоличествоЧасов = ДанныеПериода.КоличествоЧасов;
					ВозможноеКоличествоЧасов = 0;
					
					Для каждого СтрокаТаблицыПрофиля Из СтрокаПрофиль.Строки Цикл
				    	ДоляТрудозатрат = (МаксимальноеКоличествоЧасов * СтрокаТаблицыПрофиля.Трудозатраты) / 100;
						КоличествоЧасовПериода = (ДоляТрудозатрат * СтрокаТаблицыПрофиля.Загрузка) / 100;
						ВозможноеКоличествоЧасов = ВозможноеКоличествоЧасов + КоличествоЧасовПериода;
					КонецЦикла;
					
				Иначе
					
					ВозможноеКоличествоЧасов = ДанныеПериода.КоличествоЧасов;
					
				КонецЕсли; 
				
				// Простая проверка показывает, что по заданному профилю
				// невозможно распределить заданное количество часов.
				
				Если ВозможноеКоличествоЧасов < СтрокаДанных.Трудозатраты 
					ИЛИ ВозможноеКоличествоЧасов = 0 ИЛИ ДанныеПериода.КоличествоДней = 0 Тогда
					
					СтрокаДанных.ПерегрузкаРесурса = Истина;
					СтрокаДанных.КоличествоЧасовПериода = ДанныеПериода.КоличествоЧасов;	
					
				Иначе
				
					// Но такая проверка еще не дает гарантии правильного распределения
					// при обратном расчете - проблема в том, что каждая строка профиля
					// распределения "занимает" минимум один день. И после обсчета
					// каждой из строк количество оставшихся дней (и, как следствие, количество
					// оставшихся рабочих часов) уменьшается, причем не пропорционально, а в
					// соответствие с полем "Загрузка" профиля распределения.
					
					// Поэтому запускаем более сложную проверку, которая попробует
					// определить вероятность "плановой перегрузки" с учетом вышеизложенного.
					
					// В качестве граничного условия принимаем, что количество рабочих часов
					// в рабочем дне в рамках одного рабочего календаря будет, как правило,
					// одинаковым, поэтому не тратим время и ресурсы на перебор календаря,
					// а работаем с "виртуальным" календарем.
					
					КоличествоЧасовЗаДень = ДанныеПериода.КоличествоЧасов / ДанныеПериода.КоличествоДней;			
					ОсталосьДнейПериода = ДанныеПериода.КоличествоДней;
					
					Для каждого СтрокаТаблицыПрофиля Из СтрокаПрофиль.Строки Цикл
						
						ДоляТрудозатрат = (СтрокаДанных.Трудозатраты * СтрокаТаблицыПрофиля.Трудозатраты) / 100;
						КоличествоЧасов = (КоличествоЧасовЗаДень * СтрокаТаблицыПрофиля.Загрузка) / 100;
						
						Если КоличествоЧасов = 0 Тогда
							Продолжить; // На всякий случай.
						КонецЕсли; 
						
						НужноСписатьДней = Окр(ДоляТрудозатрат / КоличествоЧасов, 0);
						НужноСписатьДней = ?(НужноСписатьДней < 1, 1, НужноСписатьДней);
						
						ОсталосьДнейПериода = ОсталосьДнейПериода - НужноСписатьДней;
						
						Если ОсталосьДнейПериода < 0 Тогда
							СтрокаДанных.ПерегрузкаРесурса = Истина;
							СтрокаДанных.КоличествоЧасовПериода = ДанныеПериода.КоличествоЧасов;
						КонецЕсли; 		
						
					КонецЦикла;
				
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; // Для каждого СтрокаДанных Из ДанныеТрудозатрат Цикл.
	
КонецПроцедуры

Функция ЗаполнитьКэшПериода(ДатаНачала, ДатаОкончания, ДанныеТрудозатрат)
	
	КэшПериода = Новый ТаблицаЗначений();
	КэшПериода.Колонки.Добавить("Ресурс");
	КэшПериода.Колонки.Добавить("Роль", Новый ОписаниеТипов("СправочникСсылка.упоРоли"));
	КэшПериода.Колонки.Добавить("УровеньПланирования");
	КэшПериода.Колонки.Добавить("Подразделение");
	КэшПериода.Колонки.Добавить("КонецПериода");
	КэшПериода.Колонки.Добавить("ИсточникПлана");

	Для каждого СтрокаДанных Из ДанныеТрудозатрат Цикл
		НоваяСтрока = КэшПериода.Добавить();
		НоваяСтрока.КонецПериода = НачалоДня(ДатаНачала) - 86400;
	КонецЦикла; 
	КэшПериода.ЗагрузитьКолонку(ДанныеТрудозатрат.ВыгрузитьКолонку("Ресурс"), "Ресурс");
	КэшПериода.ЗагрузитьКолонку(ДанныеТрудозатрат.ВыгрузитьКолонку("Роль"), "Роль");
	КэшПериода.ЗагрузитьКолонку(ДанныеТрудозатрат.ВыгрузитьКолонку("Подразделение"), "Подразделение");
	КэшПериода.ЗагрузитьКолонку(ДанныеТрудозатрат.ВыгрузитьКолонку("УровеньПланирования"), "УровеньПланирования");
    КэшПериода.ЗагрузитьКолонку(ДанныеТрудозатрат.ВыгрузитьКолонку("ИсточникПлана"), "ИсточникПлана");

	Возврат КэшПериода;
	
КонецФункции

Функция ЗаполнитьДанныеКалендаря(ДанныеКалендаря, РабочийКалендарь, ДатаНачала, ДатаЗавершения,
	ВывестиСообщение, ОбратныйРасчет)
	
	Отказ = Ложь;
	
	Если НЕ ДобавитьКалендарьНаГод(РабочийКалендарь, ДатаНачала, ДанныеКалендаря, ВывестиСообщение) Тогда
		
		Отказ = Истина;
		
	КонецЕсли; 
	
	Если (НЕ Отказ) И (ОбратныйРасчет И НЕ Год(ДатаНачала) >= Год(ДатаЗавершения)) Тогда
		
		Для Счетчик = 1 По Год(ДатаЗавершения) - Год(ДатаНачала) Цикл
			
			Если НЕ ДобавитьКалендарьНаГод(РабочийКалендарь, ДобавитьМесяц(ДатаНачала, 12 * Счетчик),
				ДанныеКалендаря, ВывестиСообщение) Тогда
				
				Отказ = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат (Отказ = Ложь);
	
КонецФункции

Функция ПолучитьДанныеРаспределения(ДанныеПрофилей, ДанныеТрудозатрат, ОбратныйРасчет)
	
	// Строим общую таблицу исходных данных с учетом настроек профилей распределения.
	
	ДанныеРаспределения = Новый ТаблицаЗначений();
	ДанныеРаспределения.Колонки.Добавить("Ресурс");
	ДанныеРаспределения.Колонки.Добавить("Роль", Новый ОписаниеТипов("СправочникСсылка.упоРоли"));
	ДанныеРаспределения.Колонки.Добавить("Подразделение");
	ДанныеРаспределения.Колонки.Добавить("УровеньПланирования");
	ДанныеРаспределения.Колонки.Добавить("Трудозатраты");
	ДанныеРаспределения.Колонки.Добавить("ПерегрузкаРесурса", Новый ОписаниеТипов("Булево"));
	ДанныеРаспределения.Колонки.Добавить("Загрузка");
	ДанныеРаспределения.Колонки.Добавить("ПоДругомуМетоду", Новый ОписаниеТипов("Булево"));
	ДанныеРаспределения.Колонки.Добавить("ТрудозатратыВЧас");
	ДанныеРаспределения.Колонки.Добавить("ИсточникПлана");
	
	Для каждого СтрокаДанных Из ДанныеТрудозатрат Цикл
		
		СтрокаПрофиль = ДанныеПрофилей.Строки.Найти(СтрокаДанных.ПрофильРаспределения, "Профиль");
		Если СтрокаПрофиль = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Если СтрокаДанных.ПрофильРаспределения.СпособРаспределения =
			Перечисления.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределенияСПериодами 
			И ОбратныйРасчет Тогда
			
			НачисленоТрудозатрат = 0;
			НачисленоЧасов = 0;
			Счетчик = 0;
			
			Для каждого СтрокаТаблицыПрофиля Из СтрокаПрофиль.Строки Цикл
				
				НоваяСтрока = ДанныеРаспределения.Добавить();
				НоваяСтрока.Ресурс = СтрокаДанных.Ресурс;
				НоваяСтрока.Роль = СтрокаДанных.Роль;
				НоваяСтрока.УровеньПланирования = СтрокаДанных.УровеньПланирования;
				НоваяСтрока.Подразделение = СтрокаДанных.Подразделение;
				НоваяСтрока.ИсточникПлана = СтрокаДанных.ИсточникПлана;

				// При расчете долей необходимо сразу учитывать погрешности округления.
				
				Счетчик = Счетчик + 1;
				
				Если НЕ Счетчик = СтрокаПрофиль.Строки.Количество() Тогда				
					КоличествоЧасовПериода = СтрокаДанных.КоличествоЧасовПериода * СтрокаТаблицыПрофиля.Загрузка / 100;
					НачисленоЧасов = НачисленоЧасов + КоличествоЧасовПериода;
					
					ДоляТрудозатрат = Окр((СтрокаДанных.Трудозатраты * СтрокаТаблицыПрофиля.Трудозатраты) / 100, 2);
					НачисленоТрудозатрат = НачисленоТрудозатрат + ДоляТрудозатрат;
				Иначе
					ДоляТрудозатрат = СтрокаДанных.Трудозатраты - НачисленоТрудозатрат;
					КоличествоЧасовПериода = СтрокаДанных.КоличествоЧасовПериода - НачисленоЧасов;
				КонецЕсли;
				
				НоваяСтрока.Трудозатраты = ДоляТрудозатрат;
				НоваяСтрока.ТрудозатратыВЧас = ?(ЗначениеЗаполнено(КоличествоЧасовПериода),
					ДоляТрудозатрат / КоличествоЧасовПериода, 0); // Показатель трудозатраты в час.
				НоваяСтрока.Загрузка = КоличествоЧасовПериода;
				
				НоваяСтрока.ПоДругомуМетоду = Истина;
				
			КонецЦикла;
			
		Иначе
		
			// В случае обратного расчета и "плановой перегрузки" ресурса
			// использовать профиль уже не имеет особого смысла, поэтому
			// перестраиваем его под равномерную загрузку.
			
			Если ОбратныйРасчет И СтрокаДанных.ПерегрузкаРесурса Тогда
				
				// В случае, когда количество периодов в профиле
				// превышает количество рабочих дней в периоде.
					
				НоваяСтрока = ДанныеРаспределения.Добавить();
				НоваяСтрока.Ресурс = СтрокаДанных.Ресурс;
				НоваяСтрока.Роль = СтрокаДанных.Роль;
				НоваяСтрока.Подразделение = СтрокаДанных.Подразделение;
				НоваяСтрока.УровеньПланирования = СтрокаДанных.УровеньПланирования;
				НоваяСтрока.ПерегрузкаРесурса = СтрокаДанных.ПерегрузкаРесурса;
				НоваяСтрока.Трудозатраты = СтрокаДанных.Трудозатраты;
				НоваяСтрока.ИсточникПлана = СтрокаДанных.ИсточникПлана;

				Если СтрокаДанных.КоличествоЧасовПериода = 0 Тогда
					НоваяСтрока.Загрузка = 100;
				Иначе
					НоваяСтрока.Загрузка = (СтрокаДанных.Трудозатраты / СтрокаДанных.КоличествоЧасовПериода) * 100;
				КонецЕсли; 
							
			Иначе
				
				// Во всех остальных случаях производится распределение
				// в соответствии с данными профиля.
				
				НачисленоТрудозатрат = 0;
				Счетчик = 0;
				
				Для каждого СтрокаТаблицыПрофиля Из СтрокаПрофиль.Строки Цикл
					
					НоваяСтрока = ДанныеРаспределения.Добавить();
					НоваяСтрока.Ресурс = СтрокаДанных.Ресурс;
					НоваяСтрока.Роль = СтрокаДанных.Роль;
					НоваяСтрока.УровеньПланирования = СтрокаДанных.УровеньПланирования;
					НоваяСтрока.Подразделение = СтрокаДанных.Подразделение;
					НоваяСтрока.ПерегрузкаРесурса = СтрокаДанных.ПерегрузкаРесурса;
					НоваяСтрока.Загрузка = СтрокаТаблицыПрофиля.Загрузка;
					НоваяСтрока.ИсточникПлана = СтрокаДанных.ИсточникПлана;
					
					// При расчете долей необходимо сразу учитывать погрешности округления.
					
					Счетчик = Счетчик + 1;
					
					Если НЕ Счетчик = СтрокаПрофиль.Строки.Количество() Тогда				
						ДоляТрудозатрат = Окр((СтрокаДанных.Трудозатраты * СтрокаТаблицыПрофиля.Трудозатраты) / 100, 2);
						НоваяСтрока.Трудозатраты = ДоляТрудозатрат;
						НачисленоТрудозатрат = НачисленоТрудозатрат + ДоляТрудозатрат;
					Иначе
						НоваяСтрока.Трудозатраты = СтрокаДанных.Трудозатраты - НачисленоТрудозатрат;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
		
		 КонецЕсли;
		
	 КонецЦикла;
	 
	 Возврат ДанныеРаспределения;
	
КонецФункции

Функция ПолучитьДанныеРасчетаТрудозатратПоПрофилям(ДатаНачала, ДатаЗавершения, РабочийКалендарь,
	ДанныеКалендаря, ДанныеТрудозатрат, ДанныеРаспределения, ОбратныйРасчет, ВывестиСообщение)
	
	// Приступаем непосредственно к распределению трудозатрат.
	
	// Готовим структуру выходных данных.
	ДанныеРасчета = СоздатьДеревоДанныеРасчета();
	
	// Порядок строк исходной таблицы получился следующим:
	// ресурс_1 - период_1
	// ресурс_1 - период_2 
	// ресурс_1 - ...
	// ресурс_1 - период_М
	// ресурс_2 - период_1
	// ...
	// Это значит, что нет необходимости как-то выстраивать строки,
	// а достаточно просто идти по таблице прямым перебором.
	
	// "Даты перехода" между периодами для каждого трудового ресурса
	// будем кэшировать в отдельной таблице.
	КэшПериода = ЗаполнитьКэшПериода(ДатаНачала, ДатаЗавершения, ДанныеТрудозатрат);
	
	// Проходим по таблице исходных данных прямым перебором и рассчитываем трудозатраты.
	// Поправок на обратный расчет не делаем - эти поправки были внесены выше, при
	// расчете коэффициентов "плановой перегрузки".
	СтрокаПредыдущегоРасчета = Неопределено;
	
	РабочихЧасовВсего = 0;	
	
	Для каждого СтрокаДанныхРаспределения Из ДанныеРаспределения Цикл
		
		СтруктураОтбора = Новый Структура("Ресурс, Подразделение, УровеньПланирования, Роль, ИсточникПлана",
												СтрокаДанныхРаспределения.Ресурс, 
												СтрокаДанныхРаспределения.Подразделение, 
												СтрокаДанныхРаспределения.УровеньПланирования, 
												СтрокаДанныхРаспределения.Роль,
												СтрокаДанныхРаспределения.ИсточникПлана);
			
		масСтрокаДереваРесурс = ДанныеРасчета.Строки.НайтиСтроки(СтруктураОтбора);
		Если масСтрокаДереваРесурс.Количество() = 0 Тогда
			СтрокаДереваРесурс = ДанныеРасчета.Строки.Добавить();
			СтрокаДереваРесурс.Ресурс = СтрокаДанныхРаспределения.Ресурс;
			СтрокаДереваРесурс.УровеньПланирования = СтрокаДанныхРаспределения.УровеньПланирования;
			СтрокаДереваРесурс.Подразделение = СтрокаДанныхРаспределения.Подразделение;
			СтрокаДереваРесурс.Роль = СтрокаДанныхРаспределения.Роль;
			СтрокаДереваРесурс.ИсточникПлана = СтрокаДанныхРаспределения.ИсточникПлана;
		Иначе
			СтрокаДереваРесурс = масСтрокаДереваРесурс[0];
		КонецЕсли; 
		
		СтрокиДанныхТрудозатрат = ДанныеТрудозатрат.НайтиСтроки(СтруктураОтбора);
		Если СтрокиДанныхТрудозатрат.Количество() = 0 Тогда
			Продолжить; // Проверка на всякий случай, такого не должно быть в принципе.
		Иначе
			СтрокаДанныхТрудозатрат = СтрокиДанныхТрудозатрат[0];
		КонецЕсли;
		
		СтрокаДереваРесурс.Стоимость = СтрокаДереваРесурс.Стоимость + СтрокаДанныхТрудозатрат.ОбщСтоимость;
		СтрокаДереваРесурс.ВнешняяСтоимость = СтрокаДереваРесурс.ВнешняяСтоимость 
			+ СтрокаДанныхТрудозатрат.ОбщВнешняяСтоимость;
				
		СтрокиКэшПериода = КэшПериода.НайтиСтроки(СтруктураОтбора);
		Если СтрокиКэшПериода.Количество() = 0 Тогда
			Продолжить; // Проверка на всякий случай, такого не должно быть в принципе.
		Иначе
			СтрокаКэшПериода = СтрокиКэшПериода[0];
		КонецЕсли;			
		
		ТекДата = СтрокаКэшПериода.КонецПериода;
			
		Если Не СтрокаДанныхРаспределения.ПоДругомуМетоду = Неопределено И СтрокаДанныхРаспределения.ПоДругомуМетоду Тогда
			
			ОсталосьРаспределить = СтрокаДанныхРаспределения.Загрузка;
			
			НачисленоСтоимости = 0;
			НачисленоВнешнейСтоимости = 0;
			РаспределеноТрудозатрат = 0;
			СтоимостьПериода = СтрокаДанныхТрудозатрат.ОбщСтоимость;
			ВнешняяСтоимостьПериода = СтрокаДанныхТрудозатрат.ОбщВнешняяСтоимость;
			
			СтрокаРасчета = Неопределено;		
			Пока ОсталосьРаспределить > 0 Цикл

				ТекДата = ТекДата + 86400;	
							
				СтрокаДень = НайтиДеньКалендаря(РабочийКалендарь, ТекДата, ДанныеКалендаря, ВывестиСообщение);
				
				Если СтрокаДень = Неопределено Тогда
					Возврат Неопределено;
				КонецЕсли; 
				
				ДобавитьТрудозатраты = Ложь;
				ДлительностьПоКалендарю = 0;
				
				Если ОбратныйРасчет И НачалоДня(СтрокаДень.День) = НачалоДня(ДатаЗавершения) Тогда			
				
					Если Не СтрокаДень.КоличествоЧасов = 0 ИЛИ СтрокаРасчета = Неопределено Тогда
						
						Если Не СтрокаПредыдущегоРасчета = Неопределено 
							И (СтрокаПредыдущегоРасчета.Ресурс = СтрокаДереваРесурс.Ресурс
							И СтрокаПредыдущегоРасчета.Подразделение = СтрокаДереваРесурс.Подразделение
							И СтрокаПредыдущегоРасчета.УровеньПланирования = СтрокаДереваРесурс.УровеньПланирования)Тогда
							
							СтрокаРасчета = СтрокаПредыдущегоРасчета.СтрокаРасчета;
							ДлительностьПоКалендарю = СтрокаПредыдущегоРасчета.КоличествоЧасов;
							СтрокаПредыдущегоРасчета = Неопределено;
							ДобавитьТрудозатраты = Истина;
							
						Иначе
							
							СтрокаРасчета = СтрокаДереваРесурс.Строки.Добавить();
							СтрокаРасчета.День = СтрокаДень.День;
							ДлительностьПоКалендарю = СтрокаДень.КоличествоЧасов;
							
						КонецЕсли;
						
					КонецЕсли; 
									
					РабочихЧасовНужно = ОсталосьРаспределить * СтрокаДанныхРаспределения.ТрудозатратыВЧас;
					ОсталосьРаспределить = 0;
					
				ИначеЕсли Не СтрокаДень.КоличествоЧасов = 0 Тогда
					
					// В остальных случаях (нормальный расчет)
					// пропускаем дни с нулевым количеством рабочих часов.
					
					Если Не СтрокаПредыдущегоРасчета = Неопределено 
						И (СтрокаПредыдущегоРасчета.Ресурс = СтрокаДереваРесурс.Ресурс
						И СтрокаПредыдущегоРасчета.Подразделение = СтрокаДереваРесурс.Подразделение 
						И СтрокаПредыдущегоРасчета.УровеньПланирования = СтрокаДереваРесурс.УровеньПланирования)Тогда
						
						СтрокаРасчета = СтрокаПредыдущегоРасчета.СтрокаРасчета;
						ДлительностьПоКалендарю = СтрокаПредыдущегоРасчета.КоличествоЧасов;
						РабочихЧасовВсего = СтрокаПредыдущегоРасчета.КоличествоЧасов;
						
						СтрокаПредыдущегоРасчета = Неопределено;
						ДобавитьТрудозатраты = Истина;
						
					Иначе
						
						СтрокаРасчета = СтрокаДереваРесурс.Строки.Добавить();
						СтрокаРасчета.День = СтрокаДень.День;
						ДлительностьПоКалендарю = СтрокаДень.КоличествоЧасов;
						РабочихЧасовВсего = СтрокаДень.КоличествоЧасов;
						
					КонецЕсли;
					
					Если РабочихЧасовВсего > ОсталосьРаспределить Тогда
						РабочихЧасовВсего = ОсталосьРаспределить;
					КонецЕсли; 
					
					РабочихЧасовНужно = РабочихЧасовВсего * СтрокаДанныхРаспределения.ТрудозатратыВЧас;
					ОсталосьРаспределить = ОсталосьРаспределить - РабочихЧасовВсего;
					
				Иначе
					
					Продолжить;
					
				КонецЕсли; 
				
				СтоимостьНачислить = Окр(РабочихЧасовНужно * СтрокаДанныхТрудозатрат.СтоимостьЧаса, 2);
				НачисленоСтоимости = НачисленоСтоимости + СтоимостьНачислить;
				ВнешняяСтоимостьНачислить = Окр(РабочихЧасовНужно * СтрокаДанныхТрудозатрат.ВнешняяСтоимостьЧаса, 2);
				НачисленоВнешнейСтоимости = НачисленоВнешнейСтоимости + ВнешняяСтоимостьНачислить;
				
				Если РаспределеноТрудозатрат + Окр(РабочихЧасовНужно, 2) > СтрокаДанныхРаспределения.Трудозатраты Тогда
					РабочихЧасовНужно = СтрокаДанныхРаспределения.Трудозатраты - РаспределеноТрудозатрат;
				КонецЕсли;
				
				Если ДобавитьТрудозатраты Тогда
					СтрокаРасчета.Трудозатраты = СтрокаРасчета.Трудозатраты + РабочихЧасовНужно;
					СтрокаРасчета.Стоимость = СтрокаРасчета.Стоимость + СтоимостьНачислить;
					СтрокаРасчета.ВнешняяСтоимость = СтрокаРасчета.ВнешняяСтоимость + ВнешняяСтоимостьНачислить;
				Иначе
					СтрокаРасчета.Трудозатраты = РабочихЧасовНужно;
					СтрокаРасчета.Стоимость = СтоимостьНачислить;
					СтрокаРасчета.ВнешняяСтоимость = ВнешняяСтоимостьНачислить;
				КонецЕсли;
				
				РаспределеноТрудозатрат = РаспределеноТрудозатрат + Окр(РабочихЧасовНужно, 2);
				
				// На верхнем уровне дерева собираем данные по трудовому ресурсу в целом,
				// но при этом там нас интересуют общая длительность (только по рабочему 
				// календарю, без учета процентов загрузки и коэффициентов перегрузки)
				// и дата завершения работ трудовым ресурсом в целом по задаче.
				
				Если Не ЗначениеЗаполнено(СтрокаДереваРесурс.День) Тогда
					СтрокаДереваРесурс.День = СтрокаРасчета.День;
				Иначе
					СтрокаДереваРесурс.День = упоСервисныеФункцииВызовСервера.обМакс(СтрокаРасчета.День, СтрокаДереваРесурс.День);	
				КонецЕсли; 
				
				ТрудозатратыРесурса = СтрокаРасчета.Трудозатраты;
				
				Если Не ЗначениеЗаполнено(СтрокаДереваРесурс.Трудозатраты) Тогда
					СтрокаДереваРесурс.Трудозатраты = ТрудозатратыРесурса;
				Иначе
					СтрокаДереваРесурс.Трудозатраты = СтрокаДереваРесурс.Трудозатраты + ТрудозатратыРесурса;
				КонецЕсли; 
				
			КонецЦикла;
			
			Если НЕ СтрокаРасчета = Неопределено Тогда
			
				Если НЕ (РабочихЧасовВсего = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДлительностьПоКалендарю)) 
					И ДлительностьПоКалендарю > РабочихЧасовВсего Тогда
					
					СтрокаКэшПериода.КонецПериода = НачалоДня(СтрокаРасчета.День) - 86400;
					
					СтрокаПредыдущегоРасчета = Новый Структура("СтрокаРасчета, КоличествоЧасов, Ресурс, Подразделение, УровеньПланирования",
						СтрокаРасчета,
						ДлительностьПоКалендарю - РабочихЧасовВсего,
						СтрокаДереваРесурс.Ресурс,
						СтрокаДереваРесурс.Подразделение,
						СтрокаДереваРесурс.УровеньПланирования);
					
				Иначе
					
					СтрокаКэшПериода.КонецПериода = НачалоДня(СтрокаРасчета.День);
					
					СтрокаПредыдущегоРасчета = Неопределено;
					
				КонецЕсли;
				
				Если НЕ СтоимостьПериода = НачисленоСтоимости Тогда
					СтрокаРасчета.Стоимость = СтрокаРасчета.Стоимость + (СтоимостьПериода - НачисленоСтоимости);
				КонецЕсли;
				
				Если НЕ ВнешняяСтоимостьПериода = НачисленоВнешнейСтоимости Тогда
					СтрокаРасчета.ВнешняяСтоимость = СтрокаРасчета.ВнешняяСтоимость 
						+ (ВнешняяСтоимостьПериода - НачисленоВнешнейСтоимости);
				КонецЕсли;
				
				Если НЕ СтрокаДанныхРаспределения.Трудозатраты = РаспределеноТрудозатрат Тогда
					СтрокаРасчета.Трудозатраты = СтрокаРасчета.Трудозатраты 
						+ (СтрокаДанныхРаспределения.Трудозатраты - РаспределеноТрудозатрат);
				КонецЕсли; 
			КонецЕсли;
			
		 Иначе
		
			ОсталосьРаспределить = СтрокаДанныхРаспределения.Трудозатраты;
			НачисленоСтоимости = 0;
			НачисленоВнешнейСтоимости = 0;
			СтоимостьПериода = Окр(СтрокаДанныхТрудозатрат.СтоимостьЧаса * СтрокаДанныхРаспределения.Трудозатраты, 2);
			ВнешняяСтоимостьПериода = Окр(СтрокаДанныхТрудозатрат.ВнешняяСтоимостьЧаса 
				* СтрокаДанныхРаспределения.Трудозатраты, 2);
			
			Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(ОсталосьРаспределить) Тогда
				
				Продолжить; // Проверка на всякий случай, такого не должно быть в принципе.
				
			КонецЕсли; 
			
			// Перебираем таблицу дней и распределяем трудозатраты по рабочим дням с учетом
			// процента загрузки (определяется настройкой профиля) и видом расчета (в случае
			// обратного расчета используем коэффициенты "плановой перегрузки", если они есть).
			
			СтрокаРасчета = Неопределено;		
			
			Пока ОсталосьРаспределить > 0 Цикл

				ТекДата = ТекДата + 86400;	
							
				СтрокаДень = НайтиДеньКалендаря(РабочийКалендарь, ТекДата, ДанныеКалендаря, ВывестиСообщение);
				
				Если СтрокаДень = Неопределено Тогда
					
					Возврат Неопределено;
					
				КонецЕсли; 
				
				// Может получиться следующая ситуация: по каким-то причинам (например, накапливание
				// погрешности округления на больших периодах) при обратном расчете мы выйдем
				// за установленную дату завершения периода. В этой ситуации поступаем следующим
				// образом: списываем весь остаток трудозатрат на последнюю дату периода
				// (дату завершения) и заканчиваем расчет. 
				
				// Если же это окажется нерабочий день, то допишем остаток трудозатрат к предыдущему
				// рабочему дню.
				
				ДлительностьПоКалендарю = 0;
				ЭтоПоследнийДень = Ложь;
				
				Если ОбратныйРасчет И НачалоДня(СтрокаДень.День) = НачалоДня(ДатаЗавершения) Тогда			
				
					Если НЕ СтрокаДень.КоличествоЧасов = 0 ИЛИ СтрокаРасчета = Неопределено Тогда
						СтрокаРасчета = СтрокаДереваРесурс.Строки.Добавить();				
						СтрокаРасчета.День = СтрокаДень.День;					
					КонецЕсли; 
									
					КорректировочнаяСуммаТрудозатраты = 0;
					КорректировочнаяСуммаСтоимость = 0;
					КорректировочнаяСуммаВнешняяСтоимость = 0;
					
					Если ОсталосьРаспределить > 0 // Еще осталось, что распределить - скорее всего, это погрешность.
						И (СтрокаДень.КоличествоЧасов = 0) // И этот последний календарный день периода - не рабочий день.
						И (Не СтрокаРасчета = Неопределено) // И есть данные за ПРЕДЫДУЩИЙ РАБОЧИЙ день.
						И (Не НачалоДня(СтрокаДень.День) = НачалоДня(СтрокаРасчета.День)) Тогда
						// И дата последнего календарного дня периода не равна последней рабочей дате периода.
						
						// Тогда данные последнего рабочего дня не должны затираться данными погрешности,
						// а должны дополнять их. Т.е. данные последнего рабочего дня периода = данные периода + погрешность расчетов,
						// а не просто погрешность расчетов.
						
						КорректировочнаяСуммаТрудозатраты = СтрокаРасчета.Трудозатраты;
						КорректировочнаяСуммаСтоимость = СтрокаРасчета.Стоимость;
						КорректировочнаяСуммаВнешняяСтоимость = СтрокаРасчета.ВнешняяСтоимость;
						
					КонецЕсли;
					
					РабочихЧасовНужно = КорректировочнаяСуммаТрудозатраты + ОсталосьРаспределить;
					СтоимостьНачислить = КорректировочнаяСуммаСтоимость + Окр(ОсталосьРаспределить * СтрокаДанныхТрудозатрат.СтоимостьЧаса, 2);
					ВнешняяСтоимостьНачислить = КорректировочнаяСуммаВнешняяСтоимость + Окр(ОсталосьРаспределить * СтрокаДанныхТрудозатрат.ВнешняяСтоимостьЧаса, 2);
					
					ДлительностьПоКалендарю = СтрокаДень.КоличествоЧасов;
					
					ОсталосьРаспределить = 0;
					НачисленоСтоимости = НачисленоСтоимости + СтоимостьНачислить - КорректировочнаяСуммаСтоимость;
					НачисленоВнешнейСтоимости = НачисленоВнешнейСтоимости + ВнешняяСтоимостьНачислить - КорректировочнаяСуммаВнешняяСтоимость;
					ЭтоПоследнийДень = Истина;
					
				ИначеЕсли НЕ СтрокаДень.КоличествоЧасов = 0 Тогда
					
					// В остальных случаях (нормальный расчет)
					// пропускаем дни с нулевым количеством рабочих часов.
					
					СтрокаРасчета = СтрокаДереваРесурс.Строки.Добавить();
					СтрокаРасчета.День = СтрокаДень.День;
					ДлительностьПоКалендарю = СтрокаДень.КоличествоЧасов;
					
					РабочихЧасовВсего = СтрокаДень.КоличествоЧасов;
					Если Не СтрокаДанныхРаспределения.ПоДругомуМетоду = Неопределено И СтрокаДанныхРаспределения.ПоДругомуМетоду Тогда
						РабочихЧасовНужно = РабочихЧасовВсего * СтрокаДанныхРаспределения.ТрудозатратыВЧас;
					Иначе
						РабочихЧасовНужно = Окр((РабочихЧасовВсего * СтрокаДанныхРаспределения.Загрузка) / 100, 2);
					КонецЕсли;
					
					Если РабочихЧасовНужно > ОсталосьРаспределить Тогда
						РабочихЧасовНужно = ОсталосьРаспределить;
						ЭтоПоследнийДень = Истина;
					КонецЕсли; 
					
					СтоимостьНачислить = Окр(РабочихЧасовНужно * СтрокаДанныхТрудозатрат.СтоимостьЧаса, 2);
					ВнешняяСтоимостьНачислить = Окр(РабочихЧасовНужно * СтрокаДанныхТрудозатрат.ВнешняяСтоимостьЧаса, 2);
					ОсталосьРаспределить = ОсталосьРаспределить - РабочихЧасовНужно;
					НачисленоСтоимости = НачисленоСтоимости + СтоимостьНачислить;
					НачисленоВнешнейСтоимости = НачисленоВнешнейСтоимости + ВнешняяСтоимостьНачислить;
					
				Иначе
					
					Продолжить;
					
				КонецЕсли; 
				
				СтрокаРасчета.Трудозатраты = РабочихЧасовНужно;
				СтрокаРасчета.Стоимость = СтоимостьНачислить;
				СтрокаРасчета.ВнешняяСтоимость = ВнешняяСтоимостьНачислить;
				
				// На верхнем уровне дерева собираем данные по трудовому ресурсу в целом,
				// но при этом там нас интересуют общая длительность (только по рабочему 
				// календарю, без учета процентов загрузки и коэффициентов перегрузки)
				// и дата завершения работ трудовым ресурсом в целом по задаче.
				
				Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаДереваРесурс.День) Тогда
					СтрокаДереваРесурс.День = СтрокаРасчета.День;
				Иначе
					СтрокаДереваРесурс.День = упоСервисныеФункцииВызовСервера.обМакс(СтрокаРасчета.День, СтрокаДереваРесурс.День);	
				КонецЕсли; 
				
				ТрудозатратыРесурса = ?(ЭтоПоследнийДень, СтрокаРасчета.Трудозатраты, СтрокаДень.КоличествоЧасов);
				
				Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаДереваРесурс.Трудозатраты) Тогда
					СтрокаДереваРесурс.Трудозатраты = ТрудозатратыРесурса;
				Иначе
					СтрокаДереваРесурс.Трудозатраты = СтрокаДереваРесурс.Трудозатраты + ТрудозатратыРесурса;
				КонецЕсли; 
				
			КонецЦикла; 		
			
			// Обновляем данные в кэше "переходов между периодами" и учитываем погрешности
			// округления при расчетах стоимости трудозатрат .
			
			Если Не СтрокаРасчета = Неопределено Тогда
				
				СтрокаКэшПериода.КонецПериода = НачалоДня(СтрокаРасчета.День);
			
				Если НЕ СтоимостьПериода = НачисленоСтоимости Тогда
					СтрокаРасчета.Стоимость = СтрокаРасчета.Стоимость + (СтоимостьПериода - НачисленоСтоимости);
				КонецЕсли; 
				
				Если НЕ ВнешняяСтоимостьПериода = НачисленоВнешнейСтоимости Тогда
					СтрокаРасчета.ВнешняяСтоимость = СтрокаРасчета.ВнешняяСтоимость 
						+ (ВнешняяСтоимостьПериода - НачисленоВнешнейСтоимости);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат ДанныеРасчета;
	
КонецФункции

// Ищет строку, соответствующую заданному дню, в таблице рабочего
// календаря. В случае необходимости выполняет "переход" на следующий
// год.
//
// Параметры:
//	 РабочийКалендарь	- Справочник.упоРабочиеКалендари.
//   ДатаГода			- Дата, в пределах нужного года.
//   ДанныеКалендаря	- Структура, куда добавить данные.
//	 ВывестиСообщение	- Булево, флаг вывода сообщения
//						в случае, если календарь не найден.
//
// Возвращаемое значение:
//   СтрокаТаблицаЗначений, Неопределено – строка таблицы рабочих дней и часов.
//
Функция НайтиДеньКалендаря(РабочийКалендарь, ДатаГода, ДанныеКалендаря, ВывестиСообщение = Истина)

	// Получаем таблицу рабочего календаря на нужный год.
		
	ТаблицаДней = ПолучитьТаблицуРабочихДней(РабочийКалендарь, ДатаГода, ДанныеКалендаря, ВывестиСообщение);
	Если ТаблицаДней = Неопределено Тогда
		Возврат Неопределено; // Нет данных рабочего календаря.
	КонецЕсли; 
	
	СтрокаДень = ТаблицаДней.Найти(ДатаГода, "День"); 			
	Если СтрокаДень = Неопределено Тогда			
		
		// По каким-то причинам даты в календаре не оказалось
		// этого не должно произойти, проверка на всякий случай.
		
		Сообщение = НСтр("ru = 'Не удалось найти в рабочем календаре на %1 год дату %2.
                          |Результаты расчетов могут оказатся некорректными.'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение,
			Формат(Год(ДатаГода), "ЧГ=0"), Формат(ДатаГода, "ДФ=dd.MM.yyyy"));
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
			
		Возврат Неопределено;
		
	Иначе
		
		Возврат СтрокаДень;
		
	КонецЕсли; 	

КонецФункции

// Возвращает таблицу рабочих дней указанного года, при этом
// выполняем все операции по поиску и проверке.
//
// Параметры:
//	 РабочийКалендарь	- Справочник.упоРабочиеКалендари.
//   ДатаГода			- Дата, в пределах нужного года.
//   ДанныеКалендаря	- Структура, куда добавить данные.
//	 ВывестиСообщение	- Булево, флаг вывода сообщения
//						в случае, если календарь не найден.
//
// Возвращаемое значение:
//   ТаблицаЗначений, Неопределено	– таблица рабочих дней и часов.
//
Функция ПолучитьТаблицуРабочихДней(РабочийКалендарь, ДатаГода, ДанныеКалендаря, ВывестиСообщение = Истина)

	ИмяГода = "год_" + Формат(ДатаГода, "ДФ=yyyy");
	ТаблицаКалендаря = Неопределено;
	
	ТаблицаНайдена = ДанныеКалендаря.Свойство(ИмяГода, ТаблицаКалендаря);
	
	Если НЕ ТаблицаНайдена Тогда
		
		// Искомая дата в календаре отсутствует, попробуем добавить
		// в календарь недостающий год.
		
		Если НЕ ДобавитьКалендарьНаГод(РабочийКалендарь, ДатаГода, ДанныеКалендаря, ВывестиСообщение) Тогда
			Возврат Неопределено; // Нет данных по календарю.
		КонецЕсли; 
		
		Если НЕ ДанныеКалендаря.Свойство(ИмяГода, ТаблицаКалендаря) Тогда
			
			Если ВывестиСообщение Тогда
				Сообщение = НСтр("ru = 'Не удалось получить рабочий календарь на %1 год. Результаты расчетов могут оказатся некорректными.'");
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, СтрЗаменить(ИмяГода, "год_", ""));
				ОбщегоНазначения.СообщитьПользователю(Сообщение);
			КонецЕсли;
				
			Возврат Неопределено; // Проверка на всякий случай, такого не должно быть.
			
		КонецЕсли; 
		
	КонецЕсли; 	
	
	Возврат ТаблицаКалендаря;
	
КонецФункции

// Добавляет в структуру данных рабочего календаря рабочие
// дни указанного года.
//
// Параметры
//	 РабочийКалендарь	- Справочник.упоРабочиеКалендари.
//   ДатаГода			- Дата, в пределах нужного года.
//   ДанныеКалендаря	- Структура, куда добавить данные.
//	 ВывестиСообщение	- Булево, флаг вывода сообщения
//						в случае, если календарь не найден.
//
// Возвращаемое значение:
//   Булево		– результат операции (найдены данные года, или нет).
//
Функция ДобавитьКалендарьНаГод(РабочийКалендарь, ДатаГода, ДанныеКалендаря, ВывестиСообщение = Истина)

	ИмяГода = "год_" + Формат(Год(ДатаГода), "ЧГ=0");
	КалендарьГода = упоРабочиеКалендариВызовСервера.обПолучитьРабочийКалендарь(РабочийКалендарь, ДатаГода);
	
	Если Не КалендарьГода = Неопределено Тогда
		ДанныеКалендаря.Вставить(ИмяГода, КалендарьГода);
	ИначеЕсли ВывестиСообщение Тогда
		Сообщение = 
			НСтр("ru = 'Не удалось получить рабочий календарь на %1 год. Результаты расчетов могут оказатся некорректными.'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, СтрЗаменить(ИмяГода, "год_", ""));
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
	КонецЕсли; 
	
	Возврат (Не КалендарьГода = Неопределено);

КонецФункции

Функция ПолучитьРабочийКалендарь(Календарь)
	
	РабочийКалендарь = Неопределено;
	
	Если ТипЗнч(Календарь) = Тип("СправочникСсылка.Проекты") Тогда
		
		Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(Календарь) Тогда
			ОбъектРабочийКалендарь = Календарь.ПолучитьОбъект();
			РабочийКалендарь = ОбъектРабочийКалендарь.ПолучитьРабочийКалендарь();
		КонецЕсли; 
		
	Иначе
		
		РабочийКалендарь = Календарь;
		
	КонецЕсли;
	
	Возврат РабочийКалендарь;
	
КонецФункции

#КонецОбласти

Функция ТаблицаТрудозатратПоДнямДляРучногоЗаполненияПланаРасходов(Проект, ПроектнаяЗадача, ТаблицаТрудовыеРесурсы,
																ТаблицаТрудовыеРесурсыПоПериодам) Экспорт
	
	СрокиПроектнойЗадачи = упоПроектыИЗадачиСервер.ПолучитьСрокиПроектнойЗадачи(ПроектнаяЗадача);
	Календарь = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача,
			"КалендарьЗадачи");
	Если Не ЗначениеЗаполнено(Календарь) Тогда
		Календарь = упоПроектыИЗадачиСервер.ПолучитьКалендарьПроекта(Проект);
	КонецЕсли;
	НормаСтоимостиТрудовыхРесурсов = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача,
			"НормаСтоимостиТрудовыхРесурсов");
	ВнешняяНормаСтоимостиТрудовыхРесурсов = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача,
			"ВнешняяНормаСтоимостиТрудовыхРесурсов");
	
	ПараметрыОтбора = Новый Структура("УровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
	ЕстьДанныеОкончательногоУровняПланирования = ЗначениеЗаполнено(ТаблицаТрудовыеРесурсы.НайтиСтроки(ПараметрыОтбора));
	УровеньПланированияДляЗаполненияПланаРасходов = ?(ЕстьДанныеОкончательногоУровняПланирования,
		Перечисления.упоУровеньПланирования.Окончательный, Перечисления.упоУровеньПланирования.Предварительный);
	
	СвойстваЗадачи = Новый Структура;
	СвойстваЗадачи.Вставить("Проект", Проект);
	СвойстваЗадачи.Вставить("ПроектнаяЗадача", ПроектнаяЗадача);
	СвойстваЗадачи.Вставить("ТекущаяВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
	СвойстваЗадачи.Вставить("ДатаНач", СрокиПроектнойЗадачи.ДатаНачалаПлан);
	СвойстваЗадачи.Вставить("ДатаКон", СрокиПроектнойЗадачи.ДатаЗавершенияПлан);
	СвойстваЗадачи.Вставить("ВключитьТрудРесурсыВПланРасходов", Ложь);
	СвойстваЗадачи.Вставить("ВключитьПланРасходовВБДДС", Ложь);
	СвойстваЗадачи.Вставить("ПланироватьТрудозатратыНаИсполнителей", Ложь);
	СвойстваЗадачи.Вставить("НормаСтоимостиТрудовыхРесурсов", НормаСтоимостиТрудовыхРесурсов);
	СвойстваЗадачи.Вставить("ВнешняяНормаСтоимостиТрудовыхРесурсов", ВнешняяНормаСтоимостиТрудовыхРесурсов);
	СвойстваЗадачи.Вставить("Календарь", Календарь);
	
	ПараметрыДопФункциональности = ПараметрыДопФункциональности();
	
	ДеревоТрудозатратПоДням = ПолучитьТрудозатратыПоДням(СвойстваЗадачи, 
		ТаблицаТрудовыеРесурсы, ТаблицаТрудовыеРесурсыПоПериодам, ПараметрыДопФункциональности);
	ТаблицаТрудозатратПоДням = ШаблонТаблицыТрудозатратПоДнямДляЗаполненияПланаРасходов();
	
	Для каждого СтрокаРоли Из ДеревоТрудозатратПоДням.Строки Цикл
		Если СтрокаРоли.УровеньПланирования <> УровеньПланированияДляЗаполненияПланаРасходов Тогда
			Продолжить;
		КонецЕсли;
		
		Роль = СтрокаРоли.Ресурс;
		Подразделение = СтрокаРоли.Подразделение;
		
		Для каждого ДетальныеДанныеРаспределения Из СтрокаРоли.Строки Цикл
			НоваяСтрока = ТаблицаТрудозатратПоДням.Добавить();
			НоваяСтрока.Роль = Роль;
			НоваяСтрока.Подразделение = Подразделение;
			НоваяСтрока.Период = ДетальныеДанныеРаспределения.День;
			НоваяСтрока.Стоимость = ДетальныеДанныеРаспределения.Стоимость;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаТрудозатратПоДням;
	
КонецФункции

Функция ИспользуетсяОперЗагрузка()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	упоОперативнаяЗагрузкаСпециалистов.ТрудовойРесурс КАК ТрудовойРесурс
		|ИЗ
		|	РегистрСведений.упоОперативнаяЗагрузкаСпециалистов КАК упоОперативнаяЗагрузкаСпециалистов");
		
		Результат = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Чтение записей регистра ""упоОперативнаяЗагрузкаСпециалистов""'"),
			УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Во время выполнения действия произошла неизвестная ошибка.'") + Символы.ПС +
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение
			НСтр("ru = 'Ошибка чтения признака использования оперативной загрузки. Обратитесь к администратору.'");
	КонецПопытки;
	
	Возврат Не Результат.Пустой();
	
КонецФункции

