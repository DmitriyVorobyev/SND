// Обработчик события, вызываемый на клиенте во всех созданных формах при вызове метода Оповестить. 
//
// Параметры:
//  ЭтаФорма	 - УправляемаяФорма - форма, для который вызывается обработчик.
//  ОбъектФормы	 - ДокументОбъект, СправочникОбъект, ОбработкаОбъект, ОтчетОбъект - основной реквизит формы.
//  ИмяСобытия	 - Строка - имя события, может быть использовано для идентификации сообщений принимающими их формами.
//  Параметр	 - Произвольный - параметр сообщения. Могут быть переданы любые необходимые данные.
//  Источник	 - Произвольный - источник события. Например, в качестве источника может быть указана другая форма.
//
Процедура ФормаОбработкаОповещения(ЭтаФорма, ОбъектФормы = Неопределено, ИмяСобытия, Параметр, Источник) Экспорт
	
	ФормаМодифицирована = ЭтаФорма.Модифицированность;
	
	Если ИмяСобытия = "ИзменениеТекущегоПроекта" Тогда
		упоФункцииОбщегоНазначенияКлиентСервер.ЗаполнитьСвойствоЕслиЕсть(ЭтаФорма, "упоТекущийПроект", Параметр);
	КонецЕсли;
	
	Если ИмяСобытия = "ПроверитьРедактированиеПроекта" Тогда
		
		Если Не ФормаМодифицирована Тогда
			Возврат; // Возврат
		КонецЕсли;
		
		ФормаСодержитДанныеПроекта = ФормаСодержитДанныеПроекта(ОбъектФормы, Параметр.Проект);
		
		Если ФормаСодержитДанныеПроекта Тогда 
			Параметр.КоличествоФормКЗаписи = Параметр.КоличествоФормКЗаписи + 1;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ЗаписатьИзмененияПроекта" Тогда
		
		Если Не ФормаМодифицирована Тогда
			Возврат; // Возврат
		КонецЕсли;
		
		ФормаСодержитДанныеПроекта = ФормаСодержитДанныеПроекта(ОбъектФормы, Параметр.Проект);
		
		Если ФормаСодержитДанныеПроекта Тогда 
			ИзмененияДанныхФормыЗаписаны = Истина;
			Попытка
				ИзмененияДанныхФормыЗаписаны = ЭтаФорма.Записать();
			Исключение
				ИзмененияДанныхФормыЗаписаны = Ложь;
			КонецПопытки;
			Параметр.ВсеИзмененияЗаписаны = Параметр.ВсеИзмененияЗаписаны И ИзмененияДанныхФормыЗаписаны;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "упоРегистрацияКалендаря" Тогда
		
		Если ОбъектФормы = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		СостИмени = упоФункцииОбщегоНазначенияКлиентСервер.СоставИмениФормы(ЭтаФорма.ИмяФормы);
		
		Если Не упоРаботаСФормамиКлиентСервер.ЭтоФормаРабочегоКалендаря(СостИмени) Тогда
			Возврат;
		КонецЕсли;
		
		ИмяРеквизитаКалендарь = упоРаботаСФормамиКлиентСервер.ИмяРеквизитаКалендарь(СостИмени);
		Календарь = ОбъектФормы[ИмяРеквизитаКалендарь];
		Если Параметр = Календарь Тогда
			ИмяКоманды = упоРаботаСФормамиКлиентСервер.ИмяЭлемента_КомандаОптимизироватьРабочиеКалендари();
			НуженРасчетСдвигов = упоРабочиеКалендариВызовСервера.НуженРасчетСдвигов(Календарь);
			ЭтаФорма.Элементы[ИмяКоманды].Видимость = НуженРасчетСдвигов;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

