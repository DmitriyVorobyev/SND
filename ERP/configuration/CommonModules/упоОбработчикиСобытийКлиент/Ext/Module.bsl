// Универсальный обработчик событий формы на клиенте.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма	 - форма, для который вызывается обработчик.
//  П1		 - Произвольный		 - не используется, зарезервирован.
//  П2		 - Произвольный		 - не используется, зарезервирован.
//  П3		 - Произвольный		 - не используется, зарезервирован.
//  П4		 - Произвольный		 - не используется, зарезервирован.
//  П5		 - Произвольный		 - не используется, зарезервирован.
//  П6		 - Произвольный		 - не используется, зарезервирован.
//  П7		 - Произвольный		 - не используется, зарезервирован.
//  П8		 - Произвольный		 - не используется, зарезервирован.
//
Процедура ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма,
	П1, П2, П3, П4, П5, П6, П7 = Неопределено, П8 = Неопределено) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда 
		
		Если ТипЗнч(П1) = Тип("КомандаФормы") И Найти(П1.Имя, "КомандаСППР") <> Неопределено Тогда
			МодульИнтеграцияССППРКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтеграцияССППРКлиент");
			МодульИнтеграцияССППРКлиент.ВыполнитьКомандуИнтеграцииССППР(ЭтаФорма, П1, Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

