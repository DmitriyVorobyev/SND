// Обработчик события, вызываемый на клиенте при открытии формы до показа окна пользователю. 
//
// Параметры:
//  ЭтаФорма			 - УправляемаяФорма - форма, для который вызывается обработчик.
//  ОбъектФормы			 - ДокументОбъект, СправочникОбъект, ОбработкаОбъект, ОтчетОбъект - основной реквизит формы.
//  СброситьЗаголовок	 - Булево - признак необходимости сбросить заголовок формы.
// 
Процедура ФормаПриОткрытии(ЭтаФорма, ОбъектФормы = Неопределено, СброситьЗаголовок = Истина) Экспорт	
	
	мУстановитьТекущуюСтраницуСДанными = Ложь;
	
	Если ЭтаФорма.ИмяФормы = "Документ.упоРегистрацияФактическиВыполненногоОбъема.Форма.ФормаДокументаУправляемая" 
		Или ЭтаФорма.ИмяФормы = "Документ.упоСинхронизацияФактическиВыполненныхОбъемов.Форма.ФормаДокументаУправляемая" Тогда	
		
		мУстановитьТекущуюСтраницуСДанными = Истина;
		ПроверяемыеДанные = Новый Структура("ПерваяТаблица, ВтораяТаблица, СтраницаВторойТаблицы",
											ОбъектФормы.ДоходныеОбъемы, 
											ОбъектФормы.РасходныеОбъемы, 
											ЭтаФорма.Элементы.ГруппаРасходныеОбъемы);
											
	ИначеЕсли ЭтаФорма.ИмяФормы = "Документ.упоРегистрацияФактическихДоходовИРасходов.Форма.ФормаДокументаУправляемая"										
		Или ЭтаФорма.ИмяФормы = "Документ.упоСинхронизацияФактическихДоходовИРасходов.Форма.ФормаДокумента" Тогда	
		
		мУстановитьТекущуюСтраницуСДанными = Истина;
		ПроверяемыеДанные = Новый Структура("ПерваяТаблица, ВтораяТаблица, СтраницаВторойТаблицы",
											ОбъектФормы.Доходы, 
											ОбъектФормы.Расходы, 
											ЭтаФорма.Элементы.СтраницаРасходы);
																						
	КонецЕсли;	
	
	Если мУстановитьТекущуюСтраницуСДанными Тогда
		УстановитьТекущуюСтраницуСДанными(ПроверяемыеДанные.ПерваяТаблица, 
											ПроверяемыеДанные.ВтораяТаблица, 
											ПроверяемыеДанные.СтраницаВторойТаблицы);
	КонецЕсли;										
		
КонецПроцедуры 

