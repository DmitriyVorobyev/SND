#Область СлужебныеПроцедурыИФункции

Процедура ВызватьОповещениеОбИзменении(ЭтаФорма)
	
	РегистраторыОповещения = Новый Массив;
	РегистраторыОповещения.Добавить("упоРегистрацияРолейТрудовогоРесурса");
	РегистраторыОповещения.Добавить("упоРегистрацияСтоимостиРесурса");
	РегистраторыОповещения.Добавить("упоРегистрацияСтоимостиРесурсов");
	РегистраторыОповещения.Добавить("упоСмещениеРолейТрудовогоРесурса");
	РегистраторыОповещения.Добавить("упоИзменениеСоставаПодразделения");
	РегистраторыОповещения.Добавить("упоРегистрацияСоставаПодразделения");
	
	Для Каждого РегистраторОповещения Из  РегистраторыОповещения Цикл
		Если НЕ Найти(ЭтаФорма.ИмяФормы, РегистраторОповещения) = 0 Тогда
			ОповеститьОбИзменении(ЭтаФорма.Объект.Ссылка);	
			Прервать;
		КонецЕсли;		
	КонецЦикла;	
	
КонецПроцедуры

// Переключает текущую страницу на форме на вторую, если в таблице первой страницы нет данных, 
// а в таблице второй страницы данные есть.
//
// Параметры:
//  ПерваяТаблица	 - ДанныеФормыКоллекция - таблица формы - источник данных для первой страницы.
//  ВтораяТаблица	 - ДанныеФормыКоллекция - таблица формы - источник данных для второй страницы.
//  СтраницаВторойТаблицы - ЭлементФормы - страница второй таблицы.
//
Процедура УстановитьТекущуюСтраницуСДанными(ПерваяТаблица, ВтораяТаблица, СтраницаВторойТаблицы)
	
	Если ВтораяТаблица.Количество() > 0 
		И ПерваяТаблица.Количество() = 0 Тогда		
		
		Если СтраницаВторойТаблицы.Родитель <> Неопределено Тогда
			СтраницаВторойТаблицы.Родитель.ТекущаяСтраница = СтраницаВторойТаблицы;
		КонецЕсли;	
	КонецЕсли;
		
КонецПроцедуры	

Функция СвойствоСуществуетИЗаполнено(Объект, ИмяСвойства)

	Возврат упоФункцииОбщегоНазначенияКлиентСервер.СвойствоСуществуетИЗаполнено(Объект, ИмяСвойства);
	
КонецФункции

Функция ФормаСодержитДанныеПроекта(Объект, ПроверяемыйПроект)
	
	ЕстьЗаполненныйРеквизитПроект = СвойствоСуществуетИЗаполнено(Объект, "Проект");
	ЕстьЗаполненныйРеквизитСсылка = СвойствоСуществуетИЗаполнено(Объект, "Ссылка");
	
	ФормаСодержитДанныеПроекта = (ЕстьЗаполненныйРеквизитПроект И Объект.Проект = ПроверяемыйПроект)
		Или (ЕстьЗаполненныйРеквизитСсылка И Объект.Ссылка = ПроверяемыйПроект);
		
	Возврат ФормаСодержитДанныеПроекта;
		
КонецФункции

#КонецОбласти
