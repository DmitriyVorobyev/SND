// Обработчик события, вызываемый на клиенте перед выполнением записи объекта из формы.
//
// Параметры:
//  ЭтаФорма		 - УправляемаяФорма - форма, для который вызывается обработчик. 
//  Отказ			 - Булево - признак отказа от записи.
//  ПараметрыЗаписи	 - Структура - структура, содержащая параметры записи.
//
Процедура ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи = Неопределено) Экспорт
	
	ОчиститьСообщения();
	
	Если ПараметрыЗаписи.Свойство("РежимЗаписи") И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Если ТипЗнч(ЭтаФорма.Объект.Ссылка) = Тип("ДокументСсылка.упоУтверждениеПланаПроекта") Тогда
			
			Проект = ЭтаФорма.Объект.Проект;
			// Проверка корректности заполнения данных проекта.
			МассивыСтруктурОшибок = упоПроектыИЗадачиВызовСервера.ДанныеПроверкиСтруктурыПроекта(Проект, Отказ);
			Если ТипЗнч(МассивыСтруктурОшибок) = Тип("Массив") И Отказ Тогда
				
				СтруктураПараметров = Новый Структура();
				СтруктураПараметров.Вставить("МассивыСтруктурОшибок", МассивыСтруктурОшибок);
				СтруктураПараметров.Вставить("Проект", Проект);
				
				ОткрытьФорму("Обработка.упоПроверкаСтруктурыПроекта.Форма.ФормаСпискаОшибокУправляемая", СтруктураПараметров);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ОценкаПроизводительностиКлиент.НачатьЗамерВремени(, "Интерактивная.ПроведениеДокумента:"+ТипЗнч(ЭтаФорма.Объект.Ссылка));
		
	КонецЕсли;
	
КонецПроцедуры 

