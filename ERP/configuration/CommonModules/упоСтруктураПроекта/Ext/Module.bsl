#Область СлужебныйПрограммныйИнтерфейс

#Область ПрочиеПроцедурыФункции

Функция ОчиститьЕдИзмеренияДляВехи(СтрокаДерева, ЕдИзмеренияИзмениласть) Экспорт
	
	Если СтрокаДерева.ТипЗадачи % 6 = 3 Или СтрокаДерева.ТипЗадачи % 6 = 5 Тогда
		Если ЗначениеЗаполнено(СтрокаДерева.ЕдиницаИзмерения) Тогда
			СтрокаДерева.ЕдиницаИзмерения = Неопределено;
			ЕдИзмеренияИзмениласть = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьКритическийПуть(СтрокаДерева) Экспорт
	
	РС = СтрокаДерева.РаннийСтарт;	
	ПС = СтрокаДерева.ПозднийСтарт;
	РФ = СтрокаДерева.РаннийФиниш;
	ПФ = СтрокаДерева.ПозднийФиниш;
	
	Если (НачалоДня(РС) >= НачалоДня(ПС)) Или (НачалоДня(РФ) >= НачалоДня(ПФ)) Тогда
		СтрокаДерева.КритическийПуть = Истина;
	Иначе
		СтрокаДерева.КритическийПуть = Ложь;
	КонецЕсли;	
	
КонецФункции

Процедура ОпределитьКритическийПутьВДеревеДанных(Ветка) Экспорт
	
	Для Каждого Строка Из Ветка.Строки Цикл
		ОпределитьКритическийПуть(Строка);
		ОпределитьКритическийПутьВДеревеДанных(Строка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПересчетДлительностиПриПересчетеСроков(СтрокаДерева, ДатаИВремяНачала, ДатаИВремяЗавершения,
								ДлительностьИзменилась, РабочийКалендарьПроекта, МенеджерыВременныхТаблиц, 
								ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей = Ложь, ДанныеКалендарей = Неопределено,
								ИспользоватьТаблицыКалендарей = Ложь, ТаблицыКалендарей = Неопределено, ОшибкиПредупреждения = Неопределено) Экспорт
								
	Если ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей Тогда							
		
		НоваяДлительность = упоРасчетКалендарныхСроковРедакция4Сервер.РассчитатьДлительность(
			ДатаИВремяНачала, ДатаИВремяЗавершения,
			СтрокаДерева.ЕдиницаИзмерения, СтрокаДерева.КалендарьЗадачи, РабочийКалендарьПроекта, 
			СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта,
			ДанныеКалендарей);
		
	ИначеЕсли ИспользоватьТаблицыКалендарей Тогда
		
		НоваяДлительность = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительностьПоТаблицамКалендарей(
			ДатаИВремяНачала, ДатаИВремяЗавершения,
			СтрокаДерева.ЕдиницаИзмерения, СтрокаДерева.КалендарьЗадачи, РабочийКалендарьПроекта, 
			СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта, ТаблицыКалендарей, ОшибкиПредупреждения);
			
		Если НоваяДлительность = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		НоваяДлительность = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьДлительность(
			ДатаИВремяНачала, ДатаИВремяЗавершения,
			СтрокаДерева.ЕдиницаИзмерения, СтрокаДерева.КалендарьЗадачи, РабочийКалендарьПроекта, 
			СтрокаДерева.ДлительностьБезУчетаКалендаряПроекта,
			МенеджерыВременныхТаблиц);
		
	КонецЕсли;
	
	Если НоваяДлительность <> СтрокаДерева.Длительность Тогда
		СтрокаДерева.Длительность = НоваяДлительность;		
		ДлительностьИзменилась = Истина;
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область РасчетПроекта

Функция Пересчитать(Знач Данные, Знач СтруктураИзмДанных, Знач ДатаОтсчета,
	Знач РабочийКалендарьПроекта, Знач СтруктураДопПараметровПересчета, 
	Знач НастройкаУровняПланированияПриРасчетеГотовностиПроектов = Неопределено) Экспорт
	
	упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Начало функции.");											
		
	ПересчитыватьСроки = СтруктураДопПараметровПересчета.ПересчитыватьСроки;
	УчитыватьТрудозатратыПриРасчетеГотовности = СтруктураДопПараметровПересчета.УчитыватьТрудозатратыПриРасчетеГотовности;
	ИспДлитВместоПустТрудЗатДляРасчГотовности = СтруктураДопПараметровПересчета.ИспДлитВместоПустТрудЗатДляРасчГотовности;
	НеСчитатьРасчетныеСрокиИКритическийПуть = СтруктураДопПараметровПересчета.Свойство("НеСчитатьРасчетныеСрокиИКритическийПуть") И СтруктураДопПараметровПересчета.НеСчитатьРасчетныеСрокиИКритическийПуть;
	ПересчитыватьГотовность = СтруктураДопПараметровПересчета.ПересчитыватьГотовность;
	ПересчитыватьТолькоИзмененныеЗадачи = СтруктураДопПараметровПересчета.ПересчитыватьТолькоИзмененныеЗадачи;
	
	КэшироватьКалендариВХранилище = Истина;
	
	ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей = 
					СтруктураДопПараметровПересчета.ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей;
					
	ИспользоватьПолныйКалендарь = СтруктураДопПараметровПересчета.Свойство("ИспользоватьПолныйКалендарь") И СтруктураДопПараметровПересчета.ИспользоватьПолныйКалендарь;
	
	РезультатФункции = Новый Структура;
	РезультатФункции.Вставить("МассивОшибок", Новый Массив);
	РезультатФункции.Вставить("Данные", Данные);
	РезультатФункции.Вставить("ТаймштампВызоваХранилища", ТекущаяДата());
		
	МенеджерыВременныхТаблиц = Новый Соответствие;	
		
	ТаблицаЭлементов = Данные.ТаблицаЭлементов; 
		
	ЭлементыПоИд = Данные.ЭлементыПоИд;
	Предшественники = Данные.Предшественники;
	
	Если ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей Тогда
		ДанныеКалендарей = Данные.ДанныеКалендарей;	
	ИначеЕсли КэшироватьКалендариВХранилище Тогда
		ТаблицыКалендарей = Данные.ТаблицыКалендарей;	
	КонецЕсли;
	
	//
	
	упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Перед разбором соответствий и обновлением таблиц.");
	
	МассивИзмСтрокДерева = СтруктураИзмДанных.МассивМассивовСтрокДерева;
	ИдУдаленныхСтрок = СтруктураИзмДанных.ИдУдаленныхСтрок;
	СоответствиеИзмененныхПредшественников = СтруктураИзмДанных.СоответствиеИзмененныхПредшественников;
	
	ИзенилисьСвязи = СоответствиеИзмененныхПредшественников.Количество() <> 0;
	УдаленыЭлементы = ИдУдаленныхСтрок.Количество() <> 0; 
	
	НужнаПроверкаЗацикливания = ИзенилисьСвязи ИЛИ СтруктураДопПараметровПересчета.ПервыйПересчетПоПроекту; 
	
	НужноПересчитатьПорядокЭлементов = СтруктураДопПараметровПересчета.Свойство("НужноПересчитатьПорядокЭлементов") 
										И СтруктураДопПараметровПересчета.НужноПересчитатьПорядокЭлементов;
	НужноПересчитатьПорядокЭлементов = НужноПересчитатьПорядокЭлементов ИЛИ УдаленыЭлементы 
										ИЛИ ИзенилисьСвязи ИЛИ СтруктураДопПараметровПересчета.ПервыйПересчетПоПроекту;	
	
	МассивУдаляемыхЭлементовТаблицы = Новый Массив;
	Для Каждого Ид Из ИдУдаленныхСтрок Цикл	
		ИндексЭлемента = ЭлементыПоИд.Получить(Ид);
		Если ИндексЭлемента <> Неопределено Тогда 
			Элемент = ТаблицаЭлементов[ИндексЭлемента];
			Если Элемент <> Неопределено Тогда
				МассивУдаляемыхЭлементовТаблицы.Добавить(Элемент);							
			КонецЕсли;                               
		КонецЕсли;
	КонецЦикла;
	Для Каждого УдаляемыеЭлемент Из МассивУдаляемыхЭлементовТаблицы Цикл
		ТаблицаЭлементов.Удалить(УдаляемыеЭлемент);	
	КонецЦикла;
	Если МассивУдаляемыхЭлементовТаблицы.Количество() Тогда
		ЭлементыПоИд.Очистить();
		Для Каждого Элемент Из ТаблицаЭлементов Цикл  
			ЭлементыПоИд.Вставить(Элемент.ИдСтроки, ТаблицаЭлементов.Индекс(Элемент));
		КонецЦикла;
	КонецЕсли;
	
	ИндексыСтрокСИзмененнымКалендарем = Новый Массив;
	СоответствиеИзмененныхСтрокДерева = упоСтруктураПроектаКлиентСервер.ПреобразоватьМассивМассивовВСоответсвиеСтруктур(МассивИзмСтрокДерева);
	Для Каждого КлючЗначение Из СоответствиеИзмененныхСтрокДерева Цикл
		КодСтрокиРодителя =  упоСтруктураПроекта.КодЭлементаПоИдСтроки(КлючЗначение.Значение.ИдСтрокиРодителя);
		ИзменилсяРодитель = Ложь;
		ДобавленЭлемент = Ложь;
		УЭтапаИзмененоСвойствоИсключение = Ложь;
		упоСтруктураПроекта.ОбновитьЭлементРасчета(КлючЗначение.Значение, КодСтрокиРодителя, ТаблицаЭлементов, ЭлементыПоИд,
																		ИндексыСтрокСИзмененнымКалендарем, , , 
																		НастройкаУровняПланированияПриРасчетеГотовностиПроектов, 
																		ИзменилсяРодитель, ДобавленЭлемент, УЭтапаИзмененоСвойствоИсключение); 		
		НужнаПроверкаЗацикливания = НужнаПроверкаЗацикливания ИЛИ ИзменилсяРодитель; 
		НужноПересчитатьПорядокЭлементов = НужноПересчитатьПорядокЭлементов ИЛИ ИзменилсяРодитель ИЛИ ДобавленЭлемент ИЛИ УЭтапаИзмененоСвойствоИсключение;
	КонецЦикла;	
	
	Для Каждого КлючЗначение Из СоответствиеИзмененныхПредшественников Цикл
		Предшественники.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);			
	КонецЦикла;
	
	Если ПересчитыватьСроки Тогда
		
		ТаблицаИсключений = упоСтруктураПроекта.ПолучитьТаблицуИсключенийПоТаблицеЭлементов(ТаблицаЭлементов);
		СвязиЭлементов =  упоСтруктураПроекта.ПодготовитьТаблицуСвязей(Предшественники, ТаблицаЭлементов, ЭлементыПоИд);	
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: После разбора соответствий и обновлением таблиц.");
		
		//
		
		Если НужнаПроверкаЗацикливания Тогда
			
			упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Перед проверкой зацикливания.");
			
			упоСтруктураПроекта.ПроверкаПредУсловий(ТаблицаЭлементов, СвязиЭлементов, РезультатФункции.МассивОшибок); 		
			
			упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: После проверки зацикливания.");
			
		КонецЕсли;
		
	КонецЕсли;
	
	//
	
	Если ПересчитыватьГотовность И Не РезультатФункции.МассивОшибок.Количество() Тогда
		
		ТипБулево = Новый ОписаниеТипов("Булево");
		ТипЧисло = Новый ОписаниеТипов("Число");     
		
		РезультатФункции.Вставить("СоответствиеИзмененныхГотовностей", Новый Соответствие);
		
		КолонкиДляРасчетаПроцентов = "КодСДР, ЭлементПроекта, ЭлементРодитель, 
									|Длительность, ДлительностьЧас, 
									|ПроцентГотовности, Статус, ТрудозатратыРП";
		ТаблицаДляРасчетаПроцентов = ТаблицаЭлементов.Скопировать(, КолонкиДляРасчетаПроцентов);
		ТаблицаДляРасчетаПроцентов.Колонки.ЭлементПроекта.Имя = "Задача";
		ТаблицаДляРасчетаПроцентов.Колонки.ЭлементРодитель.Имя = "Родитель";
		ТаблицаДляРасчетаПроцентов.Колонки.ПроцентГотовности.Имя = "Готовность";
		ТаблицаДляРасчетаПроцентов.Колонки.ТрудозатратыРП.Имя = "Трудозатраты";
			
		
		ТаблицаДляРасчетаПроцентов.Колонки.Добавить("ВыпДЗ", ТипЧисло);
		ТаблицаДляРасчетаПроцентов.Колонки.Добавить("ОбщДЗ", ТипЧисло);
		ТаблицаДляРасчетаПроцентов.Колонки.Добавить("НомерИсходнойСтроки", ТипЧисло);
					
		//
				
		сч = 0;
		Для Каждого СтрокаДляРасчета Из ТаблицаДляРасчетаПроцентов Цикл
			СтрокаДляРасчета.НомерИсходнойСтроки = сч;
			СтрокаДляРасчета.Длительность = СтрокаДляРасчета.ДлительностьЧас;
			сч = сч + 1;
		КонецЦикла;
		
		ТаблицаДляРасчетаПроцентов.Сортировать("КодСДР");
					
		//
		
		упоАктуализацияПроектаВызовСервера.РассчитатьГотовностьЗадачПоВходящимДанным(ТаблицаДляРасчетаПроцентов, 
			УчитыватьТрудозатратыПриРасчетеГотовности, 
			ИспДлитВместоПустТрудЗатДляРасчГотовности,
			Истина);
		
		сч = ТаблицаДляРасчетаПроцентов.Количество()-1;
		Пока сч >= 0 Цикл
			СтрокаРасчета = ТаблицаДляРасчетаПроцентов[сч];
			НомерИсходнойСтроки = СтрокаРасчета.НомерИсходнойСтроки;
			НоваяГотовность = упоАктуализацияПроектаВызовСервера.ОкруглениеРасчетнойГотовности(СтрокаРасчета.Готовность);
			СтрокаТЗ = ТаблицаЭлементов[НомерИсходнойСтроки];
			Если НоваяГотовность <> СтрокаТЗ.ПроцентГотовности Тогда
				РезультатФункции.СоответствиеИзмененныхГотовностей.Вставить(СтрокаРасчета.Задача, НоваяГотовность);	
				СтрокаТЗ.ПроцентГотовности = НоваяГотовность;
				СтрокаТЗ.Статус = упоПроектыИЗадачиОбщие.ПолучитьСтатусЗадачиПоПроцентуГотовности(НоваяГотовность, СтрокаТЗ.Статус); 
			КонецЕсли;			
			сч = сч -1;	
		КонецЦикла;
				
	КонецЕсли;
	
	//
	
	Если ПересчитыватьСроки И Не РезультатФункции.МассивОшибок.Количество() Тогда
		
		ПараметрыПроекта = Новый Структура;
		ПараметрыПроекта.Вставить("РабочийКалендарь", 	РабочийКалендарьПроекта);
		ПараметрыПроекта.Вставить("РасчетнаяДата", 		ДатаОтсчета);
		ПараметрыПроекта.Вставить("ОбратныйРасчет", 	Ложь);
		
		Если НеСчитатьРасчетныеСрокиИКритическийПуть Тогда
			
			ПараметрыПроекта.Вставить("ТолькоПервыйПроход", Истина);
			
			Если ПересчитыватьТолькоИзмененныеЗадачи 
				И Не НужноПересчитатьПорядокЭлементов Тогда
				ВставитьПараметрИндексНачалаРасчетаВРядеЭлементов(СоответствиеИзмененныхСтрокДерева, Данные, ПараметрыПроекта);			
			КонецЕсли; 
			
		КонецЕсли;
			
		ОшибкиПредупреждения = Неопределено;
		
		// Третья версия алгоритма расчета предполагает немного другой алгоритм при
		// расчете раннего старта ПЗ с ручным вводом сроков.
		ВерсияАлгоритмаРасчета = 3;
		НачалоТекущегоДня = НачалоДня(ТекущаяДатаСеанса());
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Перед переименованием колонок (1 раз).");
		
		ТаблицаЭлементов.Колонки.Длительность.Имя = "ДлительностьЕд";
		ТаблицаЭлементов.Колонки.ДлительностьЧас.Имя = "Длительность";
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Перед вызовом алгоритма расчета сроков.");
		
		Если ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей Тогда
			ПараметрыПроекта.Вставить("ДанныеКалендарей", ДанныеКалендарей);
			РассчитанныеСроки = упоРасчетКалендарныхСроковРедакция4Сервер.РассчитатьСрокиЗадачEx(
																	ТаблицаЭлементов, 
																	ТаблицаИсключений, 
																	СвязиЭлементов, 
																	ПараметрыПроекта, 
																	ОшибкиПредупреждения,
																	ВерсияАлгоритмаРасчета);
		Иначе	
			Если КэшироватьКалендариВХранилище Тогда
				ПараметрыПроекта.Вставить("ТаблицыКалендарей", ТаблицыКалендарей);		
			КонецЕсли;
			Если Данные.Свойство("РядЭлементов") И Не НужноПересчитатьПорядокЭлементов Тогда
				ПараметрыПроекта.Вставить("РядЭлементов", Данные.РядЭлементов);
			Иначе
				ПараметрыПроекта.Вставить("РядЭлементов", Неопределено);			
			КонецЕсли;
			РассчитанныеСроки = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьСрокиЗадачEx(
																	ТаблицаЭлементов, 
																	ТаблицаИсключений, 
																	СвязиЭлементов, 
																	ПараметрыПроекта, 
																	ОшибкиПредупреждения,
																	ВерсияАлгоритмаРасчета);
		КонецЕсли;
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: После вызова алгоритма расчета сроков.");
		
		ТаблицаЭлементов.Колонки.Длительность.Имя = "ДлительностьЧас";
		ТаблицаЭлементов.Колонки.ДлительностьЕд.Имя = "Длительность";		
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: После переименования колонок (2 раз).");
		
		// Если вместо структуры тип РассчитанныеСроки - дата, то была ошибка в вычислениях.
		// Предполагаем, что это возможно только в случае, когда не зарегистрирован календарь
		// на определенный год. Год смотрим в переменной РассчитанныеСроки.
		Если ТипЗнч(РассчитанныеСроки) = Тип("Дата") Тогда
			
			ДополнитьРезультатФункцииОшибками(РезультатФункции, ОшибкиПредупреждения, ТаблицаЭлементов);
			
		КонецЕсли;
		
		//	
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Перед обработкой результатов расчета.");
		
		Если Не ТипЗнч(РассчитанныеСроки) = Тип("Дата") И Не РассчитанныеСроки = Неопределено Тогда      		
			
			ПересчитыватьСтатусСроков = СтруктураДопПараметровПересчета.ПересчитыватьСтатусСроков;
			
			МассивПолейРасчетныхСроков = Новый Массив;
			Если Не НеСчитатьРасчетныеСрокиИКритическийПуть Тогда
				МассивПолейРасчетныхСроков.Добавить("РаннийСтарт");
				МассивПолейРасчетныхСроков.Добавить("ПозднийСтарт");
				МассивПолейРасчетныхСроков.Добавить("РаннийФиниш");
				МассивПолейРасчетныхСроков.Добавить("ПозднийФиниш");
			КонецЕсли;
			
			МассивПолейСроков = Новый Массив;
			МассивПолейСроков.Добавить("ДатаНачала");
			МассивПолейСроков.Добавить("ДатаЗавершения");
			
			СоответствиеСтатусовСроков = Новый Соответствие;
			
			МассивПересчСтрок = Новый Массив;
			
			Для Каждого СтрокаРасчета Из РассчитанныеСроки Цикл
				
				Если ПересчитыватьТолькоИзмененныеЗадачи
					И СтрокаРасчета.Значение.Свойство("СрокиНеРассчитывались") Тогда			
				КонецЕсли; 
				
				ПередатьИзменение = Ложь;
				СрокЗадачиИзменился = Ложь;			
				РасчетныеСрокиИзменились = Ложь;
				ДлительностьИзменилась = Ложь;
				ЕдИзмеренияИзменилась = Ложь;
				ОтклонениеИзменилось = Ложь;
				ПринудительноПередатьСрокиИДлительность = Ложь;
				
				ИдСтроки = упоСтруктураПроекта.ИдСтрокиПоКодуЭлемента(СтрокаРасчета.Ключ);
				ИндексСтрокиЭлемента = ЭлементыПоИд.Получить(ИдСтроки); 
				СтрокаЭлемента = ТаблицаЭлементов[ИндексСтрокиЭлемента];
				
				Если СтрокаЭлемента.ЭтоФантом Тогда
					Продолжить;
				КонецЕсли;	
				
				ЭтоВеха = СтрокаЭлемента.ТипЗадачи % 6 = 5;
				ЭтоЭтап = СтрокаЭлемента.ТипЗадачи % 6 = 1;
				
				ИзменялсяКалендарь = ИндексыСтрокСИзмененнымКалендарем.Найти(ИндексСтрокиЭлемента) <> Неопределено; 
				
				Для Каждого Поле Из МассивПолейСроков Цикл
					Если СтрокаРасчета.Значение.Результат[Поле] <> СтрокаЭлемента[Поле] Тогда
						СтрокаЭлемента[Поле] = СтрокаРасчета.Значение.Результат[Поле];
						СрокЗадачиИзменился = Истина
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого Поле Из МассивПолейРасчетныхСроков Цикл
					Если СтрокаРасчета.Значение.Результат[Поле] <> СтрокаЭлемента[Поле] Тогда
						СтрокаЭлемента[Поле] = СтрокаРасчета.Значение.Результат[Поле];
						РасчетныеСрокиИзменились = Истина
					КонецЕсли;
				КонецЦикла;
				
				Если РасчетныеСрокиИзменились Тогда
					упоСтруктураПроекта.ОпределитьКритическийПуть(СтрокаЭлемента);									
				КонецЕсли;
				
				// Пересчитывает длительность 
				Если (ЭтоЭтап И СрокЗадачиИзменился) 
					// ^для этапов при изменении сроков 
					ИЛИ (Не ЭтоВеха И СтрокаЭлемента.РежимВвода = 0 И ИзменялсяКалендарь) 
					// ^для всех кроме вех при ручных сроках и изменении календаря
					ИЛИ (Не ЭтоВеха И (СтрокаЭлемента.РежимВвода = 0 ИЛИ ЭтоЭтап) 
					И СтруктураДопПараметровПересчета.ПересчитатьДлительностиЗадач) 
					// ^для всех кроме вех при ручных сроках \ всех этапов и команде пересчета всех
					ИЛИ (ЭтоЭтап И СоответствиеИзмененныхСтрокДерева.Получить(ИдСтроки) <> Неопределено)
					// ^для незакрытых и незавершенных задач с ручными сроками - кейс изменения НСИ
					ИЛИ СтрокаЭлемента.НуженПересчетДлительности = Истина Тогда
					
					ОшибкиПредупрежденияПересчетаДлительности = Неопределено;
					упоСтруктураПроекта.ПересчетДлительностиПриПересчетеСроков(СтрокаЭлемента, 
																				СтрокаЭлемента.ДатаНачала, 
																				СтрокаЭлемента.ДатаЗавершения,
																				ДлительностьИзменилась, 
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц,
																				ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей, 
																				ДанныеКалендарей,
																				КэшироватьКалендариВХранилище, 
																				ТаблицыКалендарей,
																				ОшибкиПредупрежденияПересчетаДлительности);
																				
					ДополнитьРезультатФункцииОшибками(РезультатФункции, ОшибкиПредупрежденияПересчетаДлительности, ТаблицаЭлементов);
					
				КонецЕсли;
				
				упоСтруктураПроекта.ОчиститьЕдИзмеренияДляВехи(СтрокаЭлемента, ЕдИзмеренияИзменилась);
				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьБуферПозднийСтартРаннийСтарт(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьБуфер, 
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц);
				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтклонениеПоОкончанию, 
																				упоСтруктураПроектаКолонкиКлиентСервер.СтруктураВыводимыхКолонокОтклонения(),
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц, 
																				ОтклонениеИзменилось, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию);
																	
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтклонениеПоОкончаниюДП, 
																				упоСтруктураПроектаКолонкиКлиентСервер.СтруктураВыводимыхКолонокОтклоненияДП(),	
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц, 
																				ОтклонениеИзменилось, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию);
																				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтклонениеПоНачалуБП, 
																				упоСтруктураПроектаКолонкиКлиентСервер.СтруктураВыводимыхКолонокОтклоненияПоНачалуБП(),	
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц, 
																				ОтклонениеИзменилось, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию);
																				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтклонениеПоНачалуДП, 
																				упоСтруктураПроектаКолонкиКлиентСервер.СтруктураВыводимыхКолонокОтклоненияПоНачалуДП(),	
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц, 
																				ОтклонениеИзменилось, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию);
																				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтклонениеПоНачалуОтВерсии, 
																				упоСтруктураПроектаКолонкиКлиентСервер.СтруктураВыводимыхКолонокОтклоненияПоНачалуОтВерсии(),	
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц, 
																				ОтклонениеИзменилось, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию);

				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьАбсолютныеОтклоненияВСтроке(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтклонениеПоОкончаниюОтВерсии, 
																				упоСтруктураПроектаКолонкиКлиентСервер.СтруктураВыводимыхКолонокОтклоненияПоОкончаниюОтВерсии(),	
																				РабочийКалендарьПроекта, 
																				МенеджерыВременныхТаблиц, 
																				ОтклонениеИзменилось, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию);
																				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьДлительностьКалендарныеДни(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьДлительностьКалендарныеДни);
				
				упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьОтставаниеОтТекПлана(СтрокаЭлемента, 
																				СтруктураДопПараметровПересчета.ПересчитыватьОтставаниеОтТекПлана, 
																				РабочийКалендарьПроекта,
																				МенеджерыВременныхТаблиц, 
																				СтруктураДопПараметровПересчета.ЕдиницаВремениПоУмолчанию, 
																				НачалоТекущегоДня);
																																	
				СтрокаИзмененаПоРезультатамПересчета = СрокЗадачиИзменился 
														ИЛИ РасчетныеСрокиИзменились
														ИЛИ ЕдИзмеренияИзменилась 
														ИЛИ ДлительностьИзменилась 
														ИЛИ ОтклонениеИзменилось;
														
				ПередатьИзменение = СтрокаИзмененаПоРезультатамПересчета 
														ИЛИ ПринудительноПередатьСрокиИДлительность 
														ИЛИ ПересчитыватьСтатусСроков;													
														
				Если ПередатьИзменение Тогда   
					ДанныеСтроки = СоздатьСтруктуруСтрокиДляПередачиНаКлиент(ИдСтроки, 
																				СтрокаЭлемента, 
																				ПринудительноПередатьСрокиИДлительность, 
																				СрокЗадачиИзменился, 
																				РасчетныеСрокиИзменились, 
																				ЕдИзмеренияИзменилась, 
																				ДлительностьИзменилась, 
																				ОтклонениеИзменилось);
					МассивПересчСтрок.Добавить(ДанныеСтроки);
				КонецЕсли;
				
				Если ПересчитыватьСтатусСроков Тогда
					упоСтруктураПроектаКолонкиКлиентСервер.РассчитатьСтатусСроков(СтрокаЭлемента, 
																				ПересчитыватьСтатусСроков, 
																				НачалоТекущегоДня, 
																				ЭтоВеха);
					СоответствиеСтатусовСроков.Вставить(ИдСтроки, СтрокаЭлемента.СтатусСроков);
				КонецЕсли;
				
			КонецЦикла; 
			
			РезультатФункции.Вставить("МассивИзмененныхСтрок", МассивПересчСтрок);
			Если ПересчитыватьСтатусСроков Тогда
				РезультатФункции.Вставить("СтатусыСроков", СоответствиеСтатусовСроков);
			КонецЕсли;
			
		КонецЕсли;		
		
		упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: После обработки результатов расчета.");
		
	КонецЕсли;
	
	//
		
	Данные.Вставить("ТаблицаЭлементов", ТаблицаЭлементов); 
	Данные.Вставить("Предшественники", Предшественники); 
	Данные.Вставить("ЭлементыПоИд", ЭлементыПоИд);
	Если ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей Тогда
		Данные.Вставить("ДанныеКалендарей", ДанныеКалендарей);
	ИначеЕсли КэшироватьКалендариВХранилище Тогда
		Данные.Вставить("ТаблицыКалендарей", ТаблицыКалендарей);
	КонецЕсли;
	Если Не ИспользоватьАлгоритмРасчетаСроковПоНастройкеКалендарей 
		И ПараметрыПроекта <> Неопределено 
		И ПараметрыПроекта.Свойство("РядЭлементов") Тогда
		Данные.Вставить("РядЭлементов", ПараметрыПроекта.РядЭлементов);
	КонецЕсли;
	
	Если ТаблицаЭлементов.Количество() = 0 Тогда
		ДатаНачалаПроекта = ДатаОтсчета;
		ДатаЗавершенияПроекта = ДатаОтсчета;
	Иначе
		тзДаты = ТаблицаЭлементов.Скопировать(Новый Структура("ЭтоФантом", Ложь), "ДатаНачала, ДатаЗавершения");
		тзДаты.Сортировать("ДатаНачала");
		ДатаНачалаПроекта = тзДаты[0].ДатаНачала;
		тзДаты.Сортировать("ДатаЗавершения Убыв");
		ДатаЗавершенияПроекта = тзДаты[0].ДатаЗавершения;
	КонецЕсли;		
	
	РезультатФункции.Вставить("ДатаНачалаПроекта", ДатаНачалаПроекта); 
	РезультатФункции.Вставить("ДатаЗавершенияПроекта", ДатаЗавершенияПроекта);
	
	упоОтладкаКлиентСервер.ФиксВремя("упоСтруктураПроекта.ПересчитатьСроки: Конец функции.");											
		
	Возврат РезультатФункции;	
		
КонецФункции

Функция СоздатьСтруктуруСтрокиДляПередачиНаКлиент(ИдСтроки, СтрокаЭлемента, ПринудительноПередатьСрокиИДлительность = Истина, СрокЗадачиИзменился = Ложь, 
						РасчетныеСрокиИзменились = Ложь, ЕдИзмеренияИзменилась = Ложь, ДлительностьИзменилась = Ложь, ОтклонениеИзменилось = Ложь) Экспорт
	
							
	ДанныеСтроки = упоСтруктураПроектаКлиентСервер.ПолучитьСтруктуруПараметровСтроки(
																Ложь, 
																СрокЗадачиИзменился ИЛИ ПринудительноПередатьСрокиИДлительность, 
																РасчетныеСрокиИзменились ИЛИ ПринудительноПередатьСрокиИДлительность, 
																ЕдИзмеренияИзменилась ИЛИ ПринудительноПередатьСрокиИДлительность, 
																ДлительностьИзменилась ИЛИ ПринудительноПередатьСрокиИДлительность, 
																ОтклонениеИзменилось ИЛИ ПринудительноПередатьСрокиИДлительность);
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаЭлемента);
	ДанныеСтроки.ИдСтроки = ИдСтроки;	
	
	Возврат ДанныеСтроки;
	
КонецФункции 

Функция ИдСтрокиПоКодуЭлемента(Элемент) Экспорт
	Возврат Число(Элемент);
КонецФункции

Функция КодЭлементаПоИдСтроки(ИдСтроки) Экспорт
	Если ИдСтроки = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Формат(ИдСтроки, "ЧН=; ЧГ=");
	КонецЕсли;
КонецФункции

Процедура ОбновитьЭлементРасчета(СтрокаДанных, КодРодителя, ТаблицаЭлементов, ЭлементыПоИд,
													ИндексыСтрокСИзмененнымКалендарем = Неопределено,
													СтрокаСвойств = "", 
													СтрокаИсключаемыхСвойств = "",
													НастройкаУровняПланированияПриРасчетеГотовностиПроектов = Неопределено,
													ИзменилсяРодитель = Неопределено,
													ДобавленНовыйЭлемент = Неопределено,
													УЭтапаИзмененоСвойствоИсключение = Неопределено) Экспорт	
													
	ДобавленНовыйЭлемент = Ложь;														
	ИзменилсяРодитель = Ложь;													
	Элемент = Неопределено;
	
	ИндексЭлемента = ЭлементыПоИд.Получить(СтрокаДанных.ИдСтроки);
	
	Если ИндексЭлемента <> Неопределено Тогда
		Элемент = ТаблицаЭлементов[ИндексЭлемента];
	КонецЕсли;
	
	Если Элемент = Неопределено Тогда
		Элемент = ТаблицаЭлементов.Добавить();
		ДобавленНовыйЭлемент = Истина;
	КонецЕсли;
	
	//
	
	ИндексСтроки = ТаблицаЭлементов.Индекс(Элемент);
	
	Если ИндексыСтрокСИзмененнымКалендарем <> Неопределено 
		И Элемент.КалендарьЗадачи <> СтрокаДанных.КалендарьЗадачи Тогда
		ИндексыСтрокСИзмененнымКалендарем.Добавить(ИндексСтроки);
	КонецЕсли;
	
	//
	
	ТипЗадачиДоОбновления = Элемент.ТипЗадачи;
	ЭтоИсключениеДоОбновления = Элемент.ЭтоИсключение;
	
	//
	
	Если СтрокаСвойств = "" Тогда
		ЗаполнитьЗначенияСвойств(Элемент, СтрокаДанных,, СтрокаИсключаемыхСвойств);
	Иначе	
		ЗаполнитьЗначенияСвойств(Элемент, СтрокаДанных, СтрокаСвойств, СтрокаИсключаемыхСвойств);
	КонецЕсли;
		
	//
	
	Элемент.ЭлементПроекта = КодЭлементаПоИдСтроки(СтрокаДанных.ИдСтроки);
	Элемент.НазваниеПЗ = СтрокаДанных.НазваниеЗадачи;

	Если НастройкаУровняПланированияПриРасчетеГотовностиПроектов = Перечисления.упоУровеньПланирования.Окончательный Тогда
		Элемент.ТрудозатратыРП = СтрокаДанных.ТрудозатратыТП_ОкончРоли;
		Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
			Если СтрокаДанных.Свойство("ТрудовыеРесурсыРолиОкончательныйКоличество") Тогда
				Элемент.ТрудозатратыРП = СтрокаДанных.ТрудовыеРесурсыРолиОкончательныйКоличество;	
			КонецЕсли;
		КонецЕсли;
	Иначе
		Элемент.ТрудозатратыРП = СтрокаДанных.ТрудозатратыТП;
		Если ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
			Если СтрокаДанных.Свойство("ТрудовыеРесурсыРолиПредварительныйКоличество") Тогда
				Элемент.ТрудозатратыРП = СтрокаДанных.ТрудовыеРесурсыРолиПредварительныйКоличество
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//
	
	ЗаполнитьСвойстваЭлементаРасчетаСФиксСроками(Элемент);
	
	//
	
	УЭтапаИзмененоСвойствоИсключение = (ТипЗадачиДоОбновления % 6 = 1) И (Элемент.ЭтоИсключение <> ЭтоИсключениеДоОбновления);
	
	//
	
	Элемент.ЭтоФантом = СтрокаДанных.ЭтоФантом;
	
	Если Не Элемент.ЭтоФантом Тогда
		Если Элемент.ЭлементРодитель <> КодРодителя Тогда
			Элемент.ЭлементРодитель = КодРодителя;
			ИзменилсяРодитель = Истина;
		КонецЕсли;
	Иначе
		Элемент.ЭлементРодитель = Неопределено;
	КонецЕсли;
		
	//
	
	Если ЗначениеЗаполнено(Элемент.ЕдиницаИзмерения) Тогда
		
		КоэффициентЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент.ЕдиницаИзмерения, "Коэффициент");		
		Элемент.ДлительностьЧас = Окр(Элемент.Длительность * КоэффициентЕдиницаИзмерения);

	ИначеЕсли Не ЗначениеЗаполнено(Элемент.Длительность) Тогда
		Элемент.ДлительностьЧас = 0;
	Иначе
		Элемент.ДлительностьЧас = 0;
	КонецЕсли;		
	
	//
	
	Элемент.ИдСтроки = СтрокаДанных.ИдСтроки;
	ЭлементыПоИд.Вставить(СтрокаДанных.ИдСтроки, ИндексСтроки);
	
КонецПроцедуры

Функция ПолучитьНовуюТаблицуЭлементовДляРасчета(ТолькоНеобходимыеДляРасчетаКолонки = Ложь) Экспорт
	
	Возврат упоРасчетКалендарныхСроковРедакция3Сервер.ПолучитьНовуюТаблицуЭлементовДляРасчета();

КонецФункции

Функция ПолучитьТаблицуИсключенийПоТаблицеЭлементов(ТаблицаЭлементов) Экспорт
	
	Возврат упоРасчетКалендарныхСроковРедакция3Сервер.ПолучитьТаблицуИсключенийПоТаблицеЭлементов(ТаблицаЭлементов);
		
КонецФункции

Функция ПодготовитьТаблицуСвязей(Предшественники, ТаблицаЭлементов, ЭлементыПоИд) Экспорт
	
	СвязиЭлементов = упоРасчетКалендарныхСроковРедакция3Сервер.ПолучитьНовуюТаблицуСвязейДляРасчета();
	
	Для каждого КиЗ Из Предшественники Цикл
		
		// В коллекции могут оказаться элементы с пустым ключом. Вероятно, это отмененные задачи,
		// ошибочно попавшие в соответствие "Предшественники". Такие элементы пропускаем.
		Если Не ЗначениеЗаполнено(КиЗ.Значение) Или КиЗ.Ключ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого пред Из КиЗ.Значение Цикл
			
			Если Не ЗначениеЗаполнено(пред.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			Если пред.Ключ = "ПорядокПредшественников" Тогда
				Продолжить;
			КонецЕсли;			
			
			ИндексОткуда = ЭлементыПоИд[пред.Ключ];
			Откуда = ТаблицаЭлементов[ИндексОткуда];
			
			ИндексКуда = ЭлементыПоИд[КиЗ.Ключ];
			Куда = ТаблицаЭлементов[ИндексКуда];
			
			Если Откуда = Неопределено Или Куда = Неопределено Тогда
				Продолжить; // Искомых интервалов в дереве почему-то не оказалось
			КонецЕсли; 
			
			Связь = СвязиЭлементов.Добавить();
			Связь.ЭлементПроекта 				= Куда.ЭлементПроекта;
			//Связь.ЭлементПроекта 				= Куда.ПЗ;
			Связь.НазваниеПЗ 					= Куда.НазваниеПЗ;
			Связь.КодСДР 						= Куда.КодСДР;
			//Связь.СвязанныйЭлемент 			= Откуда.ПЗ;
			Связь.СвязанныйЭлементНазваниеПЗ 	= Откуда.НазваниеПЗ;
			Связь.СвязанныйЭлемент 				= Откуда.ЭлементПроекта;
			
			Связь.СвязанныйЭлементКодСДР 		= Откуда.КодСДР;
			Связь.ТипСвязи 						= упоСтруктураПроектаКлиентСервер.ПолучитьТипСвязиУПОпоСтроке(пред.Значение.ТипСвязи);
			//Связь.Задержка 						= пред.Значение.Задержка;
			Если пред.Значение.Свойство("ЗадержкаВЧасах") Тогда
				Связь.Задержка 						= пред.Значение.ЗадержкаВЧасах;
			Иначе
				Связь.Задержка 						= пред.Значение.Задержка;
			КонецЕсли;
			
			Связь.СвязьМеждуПроектами 			= пред.Значение.СвязьМеждуПроектами;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СвязиЭлементов;
	
КонецФункции

Функция ПроверкаПредУсловий(пТаблицаЭлементов, пТаблицаСвязейЗадачВех, пМассивОшибок) Экспорт
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("ЭлементПроекта");
	ТаблицаОшибок.Колонки.Добавить("ЭлементПроектаПредставление");
	ТаблицаОшибок.Колонки.Добавить("ТекстОшибки");
	
	ТаблицаСвязей = пТаблицаСвязейЗадачВех.Скопировать();
		
	упоПроектыИЗадачиСервер.ПроверитьНаЦикличность(пТаблицаЭлементов, ТаблицаСвязей, ТаблицаОшибок);
	
	Для Каждого СтрокаОшибки Из ТаблицаОшибок Цикл
		пМассивОшибок.Добавить(Новый Структура("ЭлементПроекта, ТекстОшибки", СтрокаОшибки.ЭлементПроекта, СтрокаОшибки.ТекстОшибки));
	КонецЦикла;
	
	Возврат ТаблицаОшибок;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаПроектаВСтруктуру

// Формирует текст запроса для получения всех элементов проекта и их свойств.
//
// Параметры:
//  СтруктураВыводимыхКолонок - Структура.
//  СтруктураКолонокИтогов - Структура.
//  ДопПараметрыПоказателей - Структура.
//  ДобавитьПоказатели - Булево - если Истина, то в запрос будут добавлены показатели.
//  ПоТекущейВерсии - Булево
//
Функция ПолучитьТекстЗапросаЭлементыПроекта(СтруктураВыводимыхКолонок = Неопределено,
	СтруктураКолонокИтогов = Неопределено,
	ДопПараметрыПоказателей = Неопределено,
	ДобавитьПоказатели = Ложь, 
	ПоТекущейВерсии = Истина) Экспорт
	
	ТекстыЗапроса = Новый Массив;
	
	// Свойства
	ПсевдонимТаблицы = "ПЗы";
	ПоляЗапросаСвойства = ПоляЗапросаСвойства(ПсевдонимТаблицы);
	ТекстСвойства = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	&текВерсия КАК Версия,
	                |	%2.ПроектнаяЗадача КАК Ссылка,
	                |	%2.ЗадачаРодитель,
	                |	%2.ДлительностьМоделиПакетаРабот,
	                |	%2.ЕдиницаНормированияДлительности,
	                |	%1
	                |ПОМЕСТИТЬ %2
	                |ИЗ
	                |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК %2
	                |ГДЕ
	                |	НЕ %2.ЗадачаОтменена
	                |
	                |ИНДЕКСИРОВАТЬ ПО
	                |	Версия,
	                |	Ссылка";
	ТекстыЗапроса.Добавить(ТекстСвойства);
	
	// Код СДР по версии
	Если ПоТекущейВерсии Тогда
		ТекстЗапросаКодыСДР = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	&текВерсия КАК Версия,
		                      |	Проекты.СсылкаНаПроектнуюЗадачу КАК Ссылка,
		                      |	Проекты.КодСДР КАК КодСДР,
		                      |	Проекты.Ссылка КАК СсылкаНаЗеркальныйПроект,
		                      |	Проекты.упоКорневойПроект КАК Проект
		                      |ПОМЕСТИТЬ КодыСДР
		                      |ИЗ
		                      |	%2 КАК Т
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		                      |		ПО Т.Ссылка = Проекты.СсылкаНаПроектнуюЗадачу";
	Иначе
		ТекстЗапросаКодыСДР = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	&текВерсия КАК Версия,
		                      |	Проекты.СсылкаНаПроектнуюЗадачу КАК Ссылка,
		                      |	упоКодыСДРСрезПоследних.КодСДР КАК КодСДР,
		                      |	упоКодыСДРСрезПоследних.ПроектнаяЗадача КАК СсылкаНаЗеркальныйПроект,
		                      |	Проекты.упоКорневойПроект КАК Проект
		                      |ПОМЕСТИТЬ КодыСДР
		                      |ИЗ
		                      |	РегистрСведений.упоКодыСДР.СрезПоследних(, Версия = &текВерсия) КАК упоКодыСДРСрезПоследних
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		                      |		ПО упоКодыСДРСрезПоследних.ПроектнаяЗадача = Проекты.Ссылка"
	КонецЕсли;
	ТекстыЗапроса.Добавить(ТекстЗапросаКодыСДР);
	
	// Заготовка временной таблицы для добавления показателей.
	ТекстДобавленияПоказателей = "ВЫБРАТЬ
	                             |	Т.Ссылка
	                             |ПОМЕСТИТЬ ВР_ДопДанные
	                             |ИЗ
	                             |	%2 КАК Т";
	ТекстыЗапроса.Добавить(ТекстДобавленияПоказателей);
	
	// Добавление доп. данных
	// "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ" - конструкция для замены в показателях, РАЗЛИЧНЫЕ не убирать.
	ТекстВсеДанные = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	%2.Ссылка КАК ЗадачаСсылка,
	               |	%2.ЗадачаРодитель КАК Родитель,
	               |	%2.ДлительностьМоделиПакетаРабот КАК Длительность,
	               |	%2.ЕдиницаНормированияДлительности КАК ЕдиницаИзмерения,
	               |	%1,
	               |	ВР_ДопДанные.Ссылка КАК ВР_ДопДанныеСсылка,
	               |	ЕСТЬNULL(СрокиПЗ.ДатаНачалаПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачала,
	               |	ЕСТЬNULL(СрокиПЗ.ДатаЗавершенияПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗавершения,
	               |	ЕСТЬNULL(упоРасчетныеСрокиПроектныхЗадачСрезПоследних.ДатаРаннегоСтарта, ДАТАВРЕМЯ(1, 1, 1)) КАК РаннийСтарт,
	               |	ЕСТЬNULL(упоРасчетныеСрокиПроектныхЗадачСрезПоследних.ДатаРаннегоФиниша, ДАТАВРЕМЯ(1, 1, 1)) КАК РаннийФиниш,
	               |	ЕСТЬNULL(упоРасчетныеСрокиПроектныхЗадачСрезПоследних.ДатаПозднегоСтарта, ДАТАВРЕМЯ(1, 1, 1)) КАК ПозднийСтарт,
	               |	ЕСТЬNULL(упоРасчетныеСрокиПроектныхЗадачСрезПоследних.ДатаПозднегоФиниша, ДАТАВРЕМЯ(1, 1, 1)) КАК ПозднийФиниш,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК Статус,
	               |	ЕСТЬNULL(упоПроцентыГотовностиПроектныхЗадачСрезПоследних.ПроцентГотовности, 0) КАК ПроцентГотовности,
	               |	ЕСТЬNULL(РуководителиПЗ.РуководительПроектнойЗадачи, упоРуководителиПроектовСрезПоследних.РуководительПроекта) КАК РуководительПЗ,
	               |	КодыСДР.КодСДР КАК КодСДР,
	               |	ВЫБОР
	               |		КОГДА &ОтключитьРазграничениеДоступаКПроектнымДокументам
	               |			ТОГДА ЛОЖЬ
	               |		КОГДА упоРуководителиПроектовСрезПоследних.РуководительПроекта В (&СписокСотрудниковДиспетчера)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ НЕ ЕСТЬNULL(РуководителиПЗ.РуководительПроектнойЗадачи, ЗНАЧЕНИЕ(Справочник.упоСотрудники.ПустаяСсылка)) В (&СписокСотрудниковДиспетчера)
	               |	КОНЕЦ КАК ЭтоЧужаяЗадача
	               |ПОМЕСТИТЬ ВсеДанные
	               |ИЗ
	               |	%2 КАК %2
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыСДР КАК КодыСДР
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних КАК упоРуководителиПроектовСрезПоследних
	               |			ПО КодыСДР.Проект = упоРуководителиПроектовСрезПоследних.Проект
	               |		ПО %2.Ссылка = КодыСДР.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК СрокиПЗ
	               |		ПО (%2.Версия = СрокиПЗ.Версия 
	               |			И %2.Ссылка = СрокиПЗ.ПроектнаяЗадача)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК РуководителиПЗ
	               |		ПО %2.Ссылка = РуководителиПЗ.ПроектнаяЗадача
	               |			И НЕ РуководителиПЗ.РуководительПроектнойЗадачи = ЗНАЧЕНИЕ(Справочник.упоСотрудники.ПустаяСсылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |		ПО (%2.Версия = упоСтатусыПроектныхЗадачСрезПоследних.Версия 
	               |			И %2.Ссылка = упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРасчетныеСрокиПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК упоРасчетныеСрокиПроектныхЗадачСрезПоследних
	               |		ПО (%2.Версия = упоРасчетныеСрокиПроектныхЗадачСрезПоследних.Версия 
	               |			И %2.Ссылка = упоРасчетныеСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК упоПроцентыГотовностиПроектныхЗадачСрезПоследних
	               |		ПО (%2.Версия = упоПроцентыГотовностиПроектныхЗадачСрезПоследних.Версия 
	               |			И %2.Ссылка = упоПроцентыГотовностиПроектныхЗадачСрезПоследних.ПроектнаяЗадача)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВР_ДопДанные КАК ВР_ДопДанные
	               |		ПО %2.Ссылка = ВР_ДопДанные.Ссылка";
	ТекстыЗапроса.Добавить(ТекстВсеДанные);
	
	Разделитель = ОбщегоНазначения.РазделительПакетаЗапросов();
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, Разделитель);
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, 
		ПоляЗапросаСвойства, 
		ПсевдонимТаблицы);
	
	Если ДобавитьПоказатели Тогда
		упоСтруктураПроектаКолонкиКлиентСервер.ДобавитьПоказателиВЗапрос(СтруктураВыводимыхКолонок, СтруктураКолонокИтогов, ТекстЗапроса, ДопПараметрыПоказателей);
	КонецЕсли;
	
	Шаблон = "%1; 
	|%2";
	ТекстЗапроса = СтрШаблон(Шаблон, 
		ТекстЗапроса,
		ТекстЗапросаУпорядочитьПоКодуСДР());
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Формирует текст запроса для диаграммы Ганта.
//
Функция ПолучитьТекстЗапросаДляДиаграммы(ПоТекущейВерсии = Истина) Экспорт
	
	ТекстыЗапроса = Новый Массив;
	
	// Свойства
	ТекстСвойства = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	СвойстваПЗ.ЗадачаРодитель КАК ЗадачаРодитель,
	                |	СвойстваПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	                |	СвойстваПЗ.НазваниеЗадачи КАК НазваниеЗадачи,
	                |	СвойстваПЗ.Длительность КАК Длительность,
	                |	СвойстваПЗ.ЭтоПакетРабот КАК ЭтоПакетРабот,
	                |	СвойстваПЗ.ЭтоВеха КАК ЭтоВеха,
	                |	СвойстваПЗ.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
	                |	СвойстваПЗ.РучнойВводСроков КАК РучнойВводСроков,
	                |	СвойстваПЗ.ЕдиницаНормированияДлительности КАК ЕдиницаНормированияДлительности,
	                |	СвойстваПЗ.ВидОперации КАК ВидОперации
	                |ПОМЕСТИТЬ СвойстваПЗ
	                |ИЗ
	                |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК СвойстваПЗ
	                |ГДЕ
	                |	НЕ СвойстваПЗ.ЗадачаОтменена
	                |
	                |ИНДЕКСИРОВАТЬ ПО
	                |	ПроектнаяЗадача";
	ТекстыЗапроса.Добавить(ТекстСвойства);
	
	// Код СДР по версии
	Если ПоТекущейВерсии Тогда
		ТекстЗапросаКодыСДР = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	Проекты.СсылкаНаПроектнуюЗадачу КАК Ссылка,
		                      |	Проекты.КодСДР КАК КодСДР
		                      |ПОМЕСТИТЬ КодыСДР
		                      |ИЗ
		                      |	СвойстваПЗ КАК Т
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		                      |		ПО Т.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу";
	Иначе
		ТекстЗапросаКодыСДР = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	Проекты.СсылкаНаПроектнуюЗадачу КАК Ссылка,
		                      |	упоКодыСДРСрезПоследних.КодСДР КАК КодСДР
		                      |ПОМЕСТИТЬ КодыСДР
		                      |ИЗ
		                      |	РегистрСведений.упоКодыСДР.СрезПоследних(, Версия = &текВерсия) КАК упоКодыСДРСрезПоследних
		                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		                      |		ПО упоКодыСДРСрезПоследних.ПроектнаяЗадача = Проекты.Ссылка"
	КонецЕсли;
	ТекстыЗапроса.Добавить(ТекстЗапросаКодыСДР);
	
	ТекстЗапросаВсеДанные = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                        |	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
	                        |	Таблица.ПроцентГотовности КАК ПроцентГотовности
	                        |ПОМЕСТИТЬ ВТПроцентыГотовностиПЗы
	                        |ИЗ
	                        |	РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК Таблица
	                        |;
	                        |
	                        |////////////////////////////////////////////////////////////////////////////////
	                        |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                        |	0 КАК ТипЗадачи,
	                        |	СвойстваПЗ.ЗадачаРодитель КАК Родитель,
	                        |	СвойстваПЗ.ПроектнаяЗадача КАК ЗадачаСсылка,
	                        |	СвойстваПЗ.НазваниеЗадачи КАК НазваниеЗадачи,
	                        |	СвойстваПЗ.Длительность КАК Длительность,
	                        |	СвойстваПЗ.ЭтоПакетРабот КАК ЭтоПакетРабот,
	                        |	СвойстваПЗ.ЭтоВеха КАК ЭтоВеха,
	                        |	СвойстваПЗ.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
	                        |	СвойстваПЗ.РучнойВводСроков КАК РучнойВводСроков,
	                        |	СрокиПЗ.ДатаНачалаПлан КАК ДатаНачала,
	                        |	СрокиПЗ.ДатаЗавершенияПлан КАК ДатаЗавершения,
	                        |	NULL КАК РуководительПЗ,
	                        |	КодыСДР.КодСДР КАК КодСДР,
	                        |	СвойстваПЗ.ЕдиницаНормированияДлительности КАК ЕдиницаИзмерения,
	                        |	СтатусыПЗ.СтатусЗадачи КАК Статус,
	                        |	СвойстваПЗ.ВидОперации КАК ВидОперации,
	                        |	ЕСТЬNULL(ПроцентыГотовности.ПроцентГотовности, 0) КАК ПроцентГотовности
	                        |ПОМЕСТИТЬ ВсеДанные
	                        |ИЗ
	                        |	СвойстваПЗ КАК СвойстваПЗ
	                        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК СрокиПЗ
	                        |		ПО СвойстваПЗ.ПроектнаяЗадача = СрокиПЗ.ПроектнаяЗадача
	                        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТПроцентыГотовностиПЗы КАК ПроцентыГотовности
	                        |		ПО СвойстваПЗ.ПроектнаяЗадача = ПроцентыГотовности.ПроектнаяЗадача
	                        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(, Версия = &текВерсия) КАК СтатусыПЗ
	                        |		ПО СвойстваПЗ.ПроектнаяЗадача = СтатусыПЗ.ПроектнаяЗадача
	                        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КодыСДР КАК КодыСДР
	                        |		ПО СвойстваПЗ.ПроектнаяЗадача = КодыСДР.Ссылка
	                        |ГДЕ
	                        |	НЕ СвойстваПЗ.ПроектнаяЗадача ЕСТЬ NULL";
	ТекстыЗапроса.Добавить(ТекстЗапросаВсеДанные);
	
	ТекстыЗапроса.Добавить(ТекстЗапросаУпорядочитьПоКодуСДР());
	
	Разделитель = ОбщегоНазначения.РазделительПакетаЗапросов();
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, Разделитель);
	
	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

Функция ВыполнитьВФоне(Знач ИдентификаторФормы, Знач ИмяЭкспортнойПроцедуры, Знач Параметры) Экспорт
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, ИдентификаторФормы);
	
	Результат = Новый Структура;
	Результат.Вставить("АдресХранилища",       АдресХранилища);
	Результат.Вставить("ЗаданиеВыполнено",     Ложь);
	Результат.Вставить("ИдентификаторЗадания", Неопределено);
		
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(Параметры);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);
			
	Если ОбщегоНазначенияКлиентСервер.РежимОтладки() Тогда
		
		ПараметрыСтрока = "";
		Если ПараметрыЭкспортнойПроцедуры <> Неопределено И ПараметрыЭкспортнойПроцедуры.Количество() > 0 Тогда
			Для Индекс = 0 По ПараметрыЭкспортнойПроцедуры.ВГраница() Цикл 
				ПараметрыСтрока = ПараметрыСтрока + "ПараметрыЭкспортнойПроцедуры[" + Индекс + "],";
			КонецЦикла;
			ПараметрыСтрока = Сред(ПараметрыСтрока, 1, СтрДлина(ПараметрыСтрока) - 1);
		КонецЕсли;
		
		Выполнить ИмяЭкспортнойПроцедуры + "(" + ПараметрыСтрока + ")";
		
		Результат.ЗаданиеВыполнено = Истина;
		
	Иначе
		
		Задание = ФоновыеЗадания.Выполнить(ИмяЭкспортнойПроцедуры, ПараметрыЭкспортнойПроцедуры);
		
		Результат.ЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор);
		Результат.ИдентификаторЗадания = Задание.УникальныйИдентификатор;
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РасчетПроекта

Процедура ВставитьПараметрИндексНачалаРасчетаВРядеЭлементов(СоответствиеИзмененныхСтрокДерева, Данные, ПараметрыПроекта)
	
	МинимальныйИндекс = 0;
	
	Если ЗначениеЗаполнено(СоответствиеИзмененныхСтрокДерева)
		И Данные.Свойство("РядЭлементов") Тогда
		
		МассивРядЭлементов = Данные.РядЭлементов;
		КоличествоЭлементовРяда = МассивРядЭлементов.Количество(); 
		
		МинимальныйИндекс = КоличествоЭлементовРяда;
		
		Для Каждого ИзмененныйЭлемент Из СоответствиеИзмененныхСтрокДерева Цикл
			
			ИзмененныйЭлементКлючСтрокой = Формат(ИзмененныйЭлемент.Ключ, "ЧГ=");
			
			ЭлементВРяде = МассивРядЭлементов.Найти(ИзмененныйЭлементКлючСтрокой);
			
			Если ЭлементВРяде = Неопределено Тогда
				Продолжить;		
			КонецЕсли; 
			
			МинимальныйИндекс = Мин(ЭлементВРяде, МинимальныйИндекс);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если МинимальныйИндекс > 0 И МинимальныйИндекс <> КоличествоЭлементовРяда Тогда
		ПараметрыПроекта.Вставить("ИндексНачалаРасчета", МинимальныйИндекс);		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ДополнитьРезультатФункцииОшибками(РезультатФункции, ОшибкиПредупреждения, ТаблицаЭлементов)
	
	Если ОшибкиПредупреждения = Неопределено 
			Или ОшибкиПредупреждения.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли; 
	
	СоответствиеНаименований = Новый Соответствие;
	Для Каждого СтрокаПЗ Из ТаблицаЭлементов Цикл
		НаименованиеЭлемента = Новый Массив;
		НаименованиеЭлемента.Добавить(СтрокаПЗ.КодСДР);
		НаименованиеЭлемента.Добавить(" ");
		НаименованиеЭлемента.Добавить(СтрокаПЗ.НазваниеПЗ);
		НаименованиеЭлемента = СтрСоединить(НаименованиеЭлемента);
		СоответствиеНаименований.Вставить(СтрокаПЗ.ЭлементПроекта, НаименованиеЭлемента); 
	КонецЦикла;
	
	ТекстОшибки = "";
	ТекстОшибки = упоРасчетКалендарныхСроковРедакция3Сервер.СобратьСообщениеОбОшибке(ТекстОшибки, 
																						ОшибкиПредупреждения, СоответствиеНаименований);
	
	РезультатФункции.МассивОшибок.Добавить(Новый Структура("ИмяОшибки, ТекстОшибки", "Ошибка", ТекстОшибки));
	
	Для Каждого СтрокаОшибок Из ОшибкиПредупреждения Цикл 
		Если Не СтрокаОшибок.ИмяОшибки = "НеЗарегистрированКалендарь" Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеОшибки = Новый Структура("ТипОшибки, ТекстОшибки, ИмяОшибки, ДопПараметр1, ДопПараметр2");
		ЗаполнитьЗначенияСвойств(ОписаниеОшибки, СтрокаОшибок);
		РезультатФункции.МассивОшибок.Добавить(ОписаниеОшибки);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет свойства ЭтоИсключение и НуженПересчетДлительности для элементов с фиксированными сроками.
//
// Параметры:
//  СтрокаЭлементаРасчета	 - СтрокаТаблицыЗначений - элемент расчета.
//
Процедура ЗаполнитьСвойстваЭлементаРасчетаСФиксСроками(СтрокаЭлементаРасчета)
	
	СтатусЗавершенаЗакрыта = 
		СтрокаЭлементаРасчета.Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Завершена")
		ИЛИ СтрокаЭлементаРасчета.Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта");
		
	РучнойВводСроков = СтрокаЭлементаРасчета.РежимВвода = 0;
	
	Если РучнойВводСроков Или СтатусЗавершенаЗакрыта Или СтрокаЭлементаРасчета.ЭтоФантом Тогда
		СтрокаЭлементаРасчета.ЭтоИсключение = Истина;
	Иначе
		СтрокаЭлементаРасчета.ЭтоИсключение = Ложь;
	КонецЕсли;
	
	Если РучнойВводСроков И Не СтатусЗавершенаЗакрыта Тогда
		СтрокаЭлементаРасчета.НуженПересчетДлительности = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СоздатьНаОсновании

Процедура ДобавитьКомандуИЭлемент(Форма, ИмяКоманды, Действие, ИмяЭлемента, СоответствиеИмениИРодителя,
								  ОбъектМетаданных, Картинка = Неопределено)
								  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Действие = Действие;			
	
	Для Каждого Соответствие Из СоответствиеИмениИРодителя Цикл
		
		НовыйЭлемент = Форма.Элементы.Добавить(Соответствие.ИмяЭлемента, Тип("КнопкаФормы"), Соответствие.Родитель); 
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НовыйЭлемент.ИмяКоманды = ИмяКоманды;		
		НовыйЭлемент.Заголовок = ОбъектМетаданных.Синоним;
		
		Если Картинка <> Неопределено Тогда
			НовыйЭлемент.Картинка = Картинка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НайтиИУдалитьСтрокуТаблицы(Таблица, СтрокаПоиска)
	
	НайденнаяСтрока = Таблица.Найти(СтрокаПоиска);
	Если НайденнаяСтрока <> Неопределено Тогда
		Таблица.Удалить(НайденнаяСтрока);	
	КонецЕсли;

КонецПроцедуры	

Процедура ДобавитьКомандыСоздатьНаОснованииИнтеграцияС1СДокументооборот(Форма, ДополнениеКИмениКоманды,
		СоответствиеРодителяИЭлементаПеремещения, ДополнитьТаблицуКоманд, ИмяЭлементаМетаупоПЗ)
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЭлектроннуюПочту1СДокументооборота") Тогда
		
		ДобавитьКомандуИнтеграцияС1СДокументооборот(Форма, "КомандаСоздатьНаОснованииИнтеграцияС1СДокументооборотСоздатьПисьмо",
			ДополнениеКИмениКоманды,
			СоответствиеРодителяИЭлементаПеремещения,
			Метаданные.ОбщиеКоманды.ИнтеграцияС1СДокументооборотСоздатьПисьмо,
			ДополнитьТаблицуКоманд,
			ИмяЭлементаМетаупоПЗ);
		
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПроцессыИЗадачи1СДокументооборота") Тогда
		
		ДобавитьКомандуИнтеграцияС1СДокументооборот(Форма, "КомандаСоздатьНаОснованииИнтеграцияС1СДокументооборотСоздатьБизнесПроцесс",
			ДополнениеКИмениКоманды,
			СоответствиеРодителяИЭлементаПеремещения,
			Метаданные.ОбщиеКоманды.ИнтеграцияС1СДокументооборотСоздатьБизнесПроцесс,
			ДополнитьТаблицуКоманд,
			ИмяЭлементаМетаупоПЗ);
		
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОбработкуОбъектов1СДокументооборота") Тогда
		
		ДобавитьКомандуИнтеграцияС1СДокументооборот(Форма, "КомандаСоздатьНаОснованииИнтеграцияС1СДокументооборотНачатьОбработку",
			ДополнениеКИмениКоманды,
			СоответствиеРодителяИЭлементаПеремещения,
			Метаданные.ОбщиеКоманды.ИнтеграцияС1СДокументооборотНачатьОбработку,
			ДополнитьТаблицуКоманд,
			ИмяЭлементаМетаупоПЗ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКомандуИнтеграцияС1СДокументооборот(Форма, ИмяКоманды, ДополнениеКИмениКоманды,
		СоответствиеРодителяИЭлементаПеремещения, ОбщаяКоманда, ДополнитьТаблицуКоманд,  ИмяЭлементаМетаупоПЗ)
	
	НовоеИмяКоманды = ИмяКоманды + ДополнениеКИмениКоманды;
		
	СоответствиеИмениИРодителяИЭлементаПеремещения = Новый Массив;	
	Если СоответствиеРодителяИЭлементаПеремещения.Количество() > 1 Тогда 		
		Итератор = 1;
		Для Каждого Элемент Из СоответствиеРодителяИЭлементаПеремещения Цикл
			СоответствиеИмениИРодителяИЭлементаПеремещения.Добавить(Новый Структура("ИмяЭлемента, Родитель, ЭлементДляПеремещения",
				НовоеИмяКоманды + Итератор, Элемент.Родитель, Элемент.ЭлементДляПеремещения));
			Итератор = Итератор + 1;
		КонецЦикла;
	Иначе		
		Для Каждого Элемент Из СоответствиеРодителяИЭлементаПеремещения Цикл
			СоответствиеИмениИРодителяИЭлементаПеремещения.Добавить(Новый Структура("ИмяЭлемента, Родитель, ЭлементДляПеремещения",
				НовоеИмяКоманды, Элемент.Родитель, Элемент.ЭлементДляПеремещения));
		КонецЦикла;		
	КонецЕсли;
	
	ДополнитьТаблицуКомандНаФорме(Форма, ДополнитьТаблицуКоманд, ИмяЭлементаМетаупоПЗ,
		СоответствиеИмениИРодителяИЭлементаПеремещения);
	
	ДобавитьКомандуИЭлемент(Форма, НовоеИмяКоманды, "КомандаСоздатьНаОсновании" + ДополнениеКИмениКоманды, НовоеИмяКоманды,
							СоответствиеИмениИРодителяИЭлементаПеремещения, ОбщаяКоманда);
							
	Элементы = Форма.Элементы;						
	 		
	Для Каждого Соответствие Из СоответствиеИмениИРодителяИЭлементаПеремещения Цикл
		Элементы.Переместить(Элементы[Соответствие.ИмяЭлемента], Соответствие.Родитель, Соответствие.ЭлементДляПеремещения);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьТаблицуКомандНаФорме(Форма, ДополнитьТаблицуКоманд, ИмяЭлементаМетаупоПЗ, СоответствиеСИменемЭлемента)
	
	Если Не ДополнитьТаблицуКоманд Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого Соответствие Из СоответствиеСИменемЭлемента Цикл
		Если ИмяЭлементаМетаупоПЗ Тогда			
			НоваяСтрока = Форма.КомандыСоздатьНаОсновании.Добавить();
			НоваяСтрока.Предназначение = "ПроектнаяЗадача";
			НоваяСтрока.ИмяКоманды = Соответствие.ИмяЭлемента;
		Иначе 			
			НоваяСтрока = Форма.КомандыСоздатьНаОсновании.Добавить();
			НоваяСтрока.Предназначение = "Проект";
			НоваяСтрока.ИмяКоманды = Соответствие.ИмяЭлемента;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

Процедура ВыполнитьСохранениеНастройкиПроизводительности(ИмяНастройки, Значение)
	
	ИмяОбъекта = упоСтруктураПроектаКлиентСервер.ИмяОбъектаХранящегоНастройкиПроизводительностиСтруктурыПроекта();
	ХранилищеОбщихНастроек.Сохранить(ИмяОбъекта, ИмяНастройки, Значение);
	
КонецПроцедуры

Функция НастройкиПроизводительностиСтруктурыПроекта()
	
	ЗначенияНастроек = Новый Структура;
	НастройкиПроизводительности = упоСтруктураПроектаКлиентСервер.СписокНастроекПроизводительностиСтруктурыПроекта();
	ИмяОбъектаХранящегоНастройки = 
		упоСтруктураПроектаКлиентСервер.ИмяОбъектаХранящегоНастройкиПроизводительностиСтруктурыПроекта();
		
	Для каждого Настройка Из НастройкиПроизводительности Цикл
		ИмяНастройки = Настройка.Ключ;
		
		ЗначениеНастройки = ХранилищеОбщихНастроек.Загрузить(ИмяОбъектаХранящегоНастройки, ИмяНастройки);
			
		Если Не ЗначениеЗаполнено(ЗначениеНастройки) Тогда
			ЗначениеНастройки = НастройкиПроизводительности[ИмяНастройки].НастройкаПоУмолчанию;
		КонецЕсли;
					
		ЗначенияНастроек.Вставить(ИмяНастройки, ЗначениеНастройки);
	КонецЦикла;
	
	Возврат ЗначенияНастроек;
	
КонецФункции

