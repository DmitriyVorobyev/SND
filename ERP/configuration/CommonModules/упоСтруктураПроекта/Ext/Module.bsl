#Область ПрограммныйИнтерфейс

// Переименовать колонки в сохраненных настройках структуры.
//
// Параметры:
//  СтруктураПереименования	 - Структура
//
Процедура ПереименоватьКолонкиВСохраненныхНастройкахСтруктуры(СтруктураПереименования) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	КлючОбъектаНачинаетсяС = "Обработка.упоУпрощенныйВводСтруктурыПроекта";
	
	Настройки = Новый ТаблицаЗначений;
	Настройки.Колонки.Добавить("КлючОбъекта", Новый ОписаниеТипов("Строка"));
	Настройки.Колонки.Добавить("КлючНастроек", Новый ОписаниеТипов("Строка"));
	Настройки.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("Строка"));
	Настройки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	
	//
	
	Отбор = Новый Структура();
	
	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	Пока Выборка.Следующий() Цикл
		Если Не Лев(Выборка.КлючОбъекта, СтрДлина(КлючОбъектаНачинаетсяС)) = КлючОбъектаНачинаетсяС Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Настройки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	//
	
	Для Каждого Настройка Из Настройки Цикл		
		
		ДанныеНастройки = ХранилищеОбщихНастроек.Загрузить(Настройка.КлючОбъекта, Настройка.КлючНастроек,, Настройка.Пользователь);
		
		Если Не ТипЗнч(ДанныеНастройки) = Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписатьНастройку = Ложь;
		
		Если ДанныеНастройки.Свойство("СписокКолонок") Тогда
			
			Для Каждого ЭлементСписка Из ДанныеНастройки.СписокКолонок Цикл
				Если СтруктураПереименования.Свойство(ЭлементСписка.Значение) Тогда
					ЭлементСписка.Значение = СтруктураПереименования[ЭлементСписка.Значение];
					ЗаписатьНастройку = Истина;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ДанныеНастройки.Свойство("ПользовательскийПорядокКолонок") Тогда
			
			Для Каждого ЭлементСписка Из ДанныеНастройки.ПользовательскийПорядокКолонок Цикл
				Если ЗначениеЗаполнено(ЭлементСписка.Значение) И СтруктураПереименования.Свойство(ЭлементСписка.Значение) Тогда
					ЭлементСписка.Значение = СтруктураПереименования[ЭлементСписка.Значение];
					ЗаписатьНастройку = Истина;
				КонецЕсли;
				Если ЗначениеЗаполнено(ЭлементСписка.Представление) И СтруктураПереименования.Свойство(ЭлементСписка.Представление) Тогда
					ЭлементСписка.Представление = СтруктураПереименования[ЭлементСписка.Представление];
					ЗаписатьНастройку = Истина;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗаписатьНастройку Тогда
			
			ХранилищеОбщихНастроек.Сохранить(Настройка.КлючОбъекта,  Настройка.КлючНастроек, ДанныеНастройки, Настройка.Представление, Настройка.Пользователь);
			
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

// Возвращает сохраненные настройки структуры всех пользователей.
// 
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ПолучитьТаблицуВсехНастроекСтруктуры() Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	КлючОбъектаНачинаетсяС = "Обработка.упоУпрощенныйВводСтруктурыПроекта";
	
	ТаблицаНастройки = Новый ТаблицаЗначений;
	ТаблицаНастройки.Колонки.Добавить("КлючОбъекта", Новый ОписаниеТипов("Строка"));
	ТаблицаНастройки.Колонки.Добавить("КлючНастроек", Новый ОписаниеТипов("Строка"));
	ТаблицаНастройки.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("Строка"));
	ТаблицаНастройки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаНастройки.Колонки.Добавить("Настройки");
	
	//
	
	Отбор = Новый Структура();
	
	Выборка = ХранилищеОбщихНастроек.Выбрать(Отбор);
	Пока Выборка.Следующий() Цикл
		Если Не Лев(Выборка.КлючОбъекта, СтрДлина(КлючОбъектаНачинаетсяС)) = КлючОбъектаНачинаетсяС Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаНастройки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	//
	
	Возврат ТаблицаНастройки;
	
КонецФункции

// Сохраняет или дополняет настройку для всех пользователей.
//
// Параметры:
//  СтруктураНастроек	- Структура
//  ПолностьюЗаменить	- Булево	 - признак полной перезаписи всех настроек
//  	или частичной замены по ключам входящей структуры настроек.
//
Процедура УстановитьДляВсехНастройку(СтруктураНастроек, ПолностьюЗаменить = Ложь) Экспорт
	
	ТаблицаНастроек = ПолучитьТаблицуВсехНастроекСтруктуры();
	
	Для Каждого СтрокаНастройки Из ТаблицаНастроек Цикл
		
		Если ТипЗнч(СтрокаНастройки.Настройки) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПолностьюЗаменить Тогда
			СтрокаНастройки.Настройки = СтруктураНастроек;
		Иначе
			Для Каждого КлючЗначение Из СтруктураНастроек Цикл
				СтрокаНастройки.Настройки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение); 	
			КонецЦикла;
		КонецЕсли;	
		
		ХранилищеОбщихНастроек.Сохранить(СтрокаНастройки.КлючОбъекта,  СтрокаНастройки.КлючНастроек, 
							СтрокаНастройки.Настройки, СтрокаНастройки.Представление, СтрокаНастройки.Пользователь);
		
	КонецЦикла;
	
КонецПроцедуры

#Область СоздатьНаОсновании

// Добавляет команды создать на основании на форму.
//
// Параметры:
//  Форма									 - УправляемаяФорма
//  ХранилищеВводНаОсновании				 - ТаблицаЗначений
//  ИмяЭлементаМетаданных					 - Строка
//  СоответствиеРодителяИЭлементаПеремещения - Массив
//  ДополнениеКИмениЭлемента				 - Строка
//  ДополнитьТаблицуКоманд					 - Булево
//
Процедура ДобавитьКомандыСозданияНаОсновании(Форма, ХранилищеВводНаОсновании, ИмяЭлементаМетаданных,
											СоответствиеРодителяИЭлементаПеремещения, ДополнениеКИмениЭлемента = "", ДополнитьТаблицуКоманд = Ложь) Экспорт
																						
	СтрокаДанных = ХранилищеВводНаОсновании.Найти(ИмяЭлементаМетаданных);
	Если Не СтрокаДанных = Неопределено Тогда
		ТаблицаОбъектовВводНаОсновании = СтрокаДанных.ТаблицаОбъектовВводНаОсновании;
	Иначе
		ТаблицаОбъектовВводНаОсновании = Новый ТаблицаЗначений;
	КонецЕсли;
	
	ИмяЭлементаМетаупоПЗ = ИмяЭлементаМетаданных = "Документ.упоПроектнаяЗадача";
	
	ДобавитьКомандыСоздатьНаОснованииИнтеграцияС1СДокументооборот(Форма, ДополнениеКИмениЭлемента, СоответствиеРодителяИЭлементаПеремещения,
		ДополнитьТаблицуКоманд, ИмяЭлементаМетаупоПЗ);
	
	Если ИмяЭлементаМетаупоПЗ Тогда
	
		Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияУПФ") Тогда		
			МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУПФСервер");
			МодульИнтеграции.ДобавитьКомандыСозданияНаОсновании(ТаблицаОбъектовВводНаОсновании);
		КонецЕсли;
		
		Строка = ТаблицаОбъектовВводНаОсновании.Найти("Документ.упоЗакрытиеЭтапа");
		Если Строка <> Неопределено Тогда
			ИндексСтроки = ТаблицаОбъектовВводНаОсновании.Индекс(Строка);
			КоличествоСтрокДоПоследнейСтроки = ТаблицаОбъектовВводНаОсновании.Количество() - ИндексСтроки - 1;
			ТаблицаОбъектовВводНаОсновании.Сдвинуть(Строка, КоличествоСтрокДоПоследнейСтроки);
		КонецЕсли;
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоПланированиеТрудозатратПоТрудовымРесурсам");
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоПрогнозТрудозатратПоРолям");
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоСтатусОтчетПоПроекту");
	Иначе
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоАктуализацияПроекта");
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоПроектнаяЗадача");
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоРасчетКалендарногоПланаПроекта");
		НайтиИУдалитьСтрокуТаблицы(ТаблицаОбъектовВводНаОсновании, "Документ.упоРегистрацияПроекта");		
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаОбъектовВводНаОсновании Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Строка.ИмяОбъектаМетаданных);
		Если ОбъектМетаданных = Неопределено Или Метаданные.ОбщиеКоманды.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОграничениеНаДобавление = Ложь;
		Попытка
			ЕстьОграничениеНаДобавление = Не ПравоДоступа("Добавление", ОбъектМетаданных);
		Исключение
			// Никак не обрабатываем. Проверяем только те объекты, на которые можно установить право "Добавление".
		КонецПопытки;
		
		Если ЕстьОграничениеНаДобавление Тогда
			Продолжить;
		КонецЕсли;
		
		НетОграниченийФункциональныхОпции = Строка.ФунциональныеОпцииОбъектаМетаданных.Количество() = 0;
		Для Каждого ИмяФункциональнойОпции Из Строка.ФунциональныеОпцииОбъектаМетаданных Цикл
			ЗначениеФунциональнойОпции = ПолучитьФункциональнуюОпцию(ИмяФункциональнойОпции);
			
			Если ТипЗнч(ЗначениеФунциональнойОпции) = Тип("Булево") И ЗначениеФунциональнойОпции Тогда
				НетОграниченийФункциональныхОпции = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не НетОграниченийФункциональныхОпции Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяЭлемента = ОбъектМетаданных.Имя + ДополнениеКИмениЭлемента;
		
		ТекстСоздать = ?(ДополнениеКИмениЭлемента = "", "Создать_", "СоздатьДляПроекта_");
		
		ИмяКоманды = ТекстСоздать + СтрЗаменить(Строка.ИмяОбъектаМетаданных, ".", "_"); 
		
		СоответствиеИмениИРодителя = Новый Массив;
		Если СоответствиеРодителяИЭлементаПеремещения.Количество() > 1 Тогда
			Итератор = 1;
			Для Каждого Элемент Из СоответствиеРодителяИЭлементаПеремещения Цикл
				СоответствиеИмениИРодителя.Добавить(Новый Структура("ИмяЭлемента, Родитель",
					ИмяЭлемента + Итератор, Элемент.Родитель));
				Итератор = Итератор + 1;
			КонецЦикла;
		Иначе
			Для Каждого Элемент Из СоответствиеРодителяИЭлементаПеремещения Цикл
				СоответствиеИмениИРодителя.Добавить(Новый Структура("ИмяЭлемента, Родитель", ИмяЭлемента, Элемент.Родитель));
			КонецЦикла;					
		КонецЕсли;
		
		ДополнитьТаблицуКомандНаФорме(Форма, ДополнитьТаблицуКоманд, ИмяЭлементаМетаупоПЗ,
			СоответствиеИмениИРодителя);	
		
		Если Строка.ИмяОбъектаМетаданных <> "Документ.упоИзменениеРуководителяПроектнойЗадачи" Тогда
			ДобавитьКомандуИЭлемент(Форма, ИмяКоманды, "КомандаСоздатьНаОсновании" + ДополнениеКИмениЭлемента, ИмяЭлемента,
									СоответствиеИмениИРодителя, ОбъектМетаданных);
		Иначе
			ДобавитьКомандуИЭлемент(Форма, ИмяКоманды, "КомандаСоздатьНаОсновании" + ДополнениеКИмениЭлемента, ИмяЭлемента,
									СоответствиеИмениИРодителя, ОбъектМетаданных, БиблиотекаКартинок.упоИзменитьРуководителяЗадачи);
		КонецЕсли;
				
	КонецЦикла;

КонецПроцедуры	

// Возвращает параметра для добавления команд создать на основании
// 
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьСтруктуруРодителяИЭлементаПеремещения() Экспорт
	
	Возврат Новый Структура("Родитель, ЭлементДляПеремещения");
	
КонецФункции

