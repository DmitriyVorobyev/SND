
#Область ПрограммныйИнтерфейс

// Объединенная функция расчета смещения и проверки итогового результата.
//
// Параметры:
//  Календарь	 - СправочникСсылка.упоРабочиеКалендари - рабочий календарь.
// 
// Возвращаемое значение:
//  Булево - проверка результата пересчета.
//
Функция РассчитатьСмещенияДляКалендаряСПроверкой(Календарь) Экспорт 
	
	РассчитатьСмещенияДляКалендаря(Календарь);
	
	НуженРасчетСдвигов = НуженРасчетСдвигов(Календарь);
	
	Возврат НуженРасчетСдвигов;
	
КонецФункции

// Функция возвращает рабочий календарь на год, количество рабочих часов в дне.
//
// Параметры:
//  Календарь		 - СправочникСсылка.упоРабочиеКалендари	 - запрашиваемый календарь.
//  ТолькоРабочиеДни - Булево	 - флаг указывает на необходимость извлечь данные
//  	только по рабочим дням (ненулевое количество рабочих часов).
//  Смещения		 - Булево	 - флаг указывает на необходимость получать смещения.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: День (Дата), КоличествоЧасов (Число).
//  Неопределено – нет сведений о календаре на запрашиваемый год.
//
Функция ПолучитьПолныйРабочийКалендарь(Календарь, ТолькоРабочиеДни = Ложь, Смещения = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Календарь) Тогда      
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь" , Календарь);
	Запрос.Текст = упоРабочиеКалендариСерверПовтИспСеанс.ПолучитьТекстЗапросаРабочегоКалендаря(Ложь, ТолькоРабочиеДни, Смещения);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено; // нет сведений
	КонецЕсли;
	
	ТаблицаДней = Результат.Выгрузить();
	ТаблицаДней.Индексы.Добавить("День");
	
	Возврат ТаблицаДней; 
	
КонецФункции

// Функция возвращает текст запроса рабочего календаря.
//
// Параметры:
//  ОтборПоПериоду    	- Булево - флаг указыват на необходимость отбора по периоду.
//  ТолькоРабочиеДни    - Булево - флаг указыват на необходимость извлечь данные
//						только по рабочим дням (ненулевое количество рабочих часов).
//  Смещения    		- Булево - флаг указыват на необходимость получать смещения.
//  
// Возвращаемое значение:
//	Строка - Текст запроса.
//
Функция ПолучитьТекстЗапросаРабочегоКалендаря(ОтборПоПериоду = Ложь, ТолькоРабочиеДни = Ложь, Смещения = Ложь) Экспорт
		
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Рег.День КАК День,
	               |	Рег.КоличествоЧасов КАК КоличествоЧасов
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	               |			,
	               |			Календарь = &Календарь
	               |				И (День МЕЖДУ &НачПериода И &КонПериода)) КАК Рег";
	
	Если Не ОтборПоПериоду Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И (День МЕЖДУ &НачПериода И &КонПериода)", "");	
	КонецЕсли;
		
	Если Смещения Тогда
		МассивСтрок = Новый Массив;
		Для Каждого Ресурс Из Метаданные.РегистрыСведений.упоРабочиеКалендари.Ресурсы Цикл
			МассивСтрок.Добавить(Ресурс.Имя);	
		КонецЦикла;
		СтрокаСмещений = СтрСоединить(МассивСтрок, ", ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Рег.КоличествоЧасов КАК КоличествоЧасов", СтрокаСмещений); 
	КонецЕсли;
	
	Если ТолькоРабочиеДни Тогда
		ТекстЗапроса = ТекстЗапроса+ Символы.ПС + "ГДЕ Рег.КоличествоЧасов <> 0";		
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО День";

	Возврат ТекстЗапроса;
	
КонецФункции 

// Функция возвращает рабочий календарь на год, количество рабочих часов в дне.
//
// Параметры:
//  Календарь		 - СправочникСсылка.упоРабочиеКалендари	 - запрашиваемый календарь.
//  ГодКалендаря	 - Дата		 - день на год, кот. возвращается календарь.
//  ТолькоРабочиеДни - Булево	 - флаг указыват на необходимость извлечь данные
//  	только по рабочим дням (ненулевое количество рабочих часов).
//  Смещения		 - Булево	 - флаг указыват на необходимость получать смещения.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: День (Дата), КоличествоЧасов (Число).
//  Неопределено – нет сведений о календаре на запрашиваемый год.
//
Функция ПолучитьРабочийКалендарь(Календарь, ГодКалендаря, ТолькоРабочиеДни = Ложь, Смещения = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ГодКалендаря) ИЛИ Не ЗначениеЗаполнено(Календарь) Тогда      
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь" , Календарь);
	Запрос.УстановитьПараметр("НачПериода", НачалоГода(ГодКалендаря));
	Запрос.УстановитьПараметр("КонПериода", КонецГода(ГодКалендаря));
	Запрос.Текст = упоРабочиеКалендариСерверПовтИспСеанс.ПолучитьТекстЗапросаРабочегоКалендаря(Истина, ТолькоРабочиеДни, Смещения);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено; // нет сведений
	КонецЕсли;
	
	ТаблицаДней = Результат.Выгрузить();
	ТаблицаДней.Индексы.Добавить("День");
	
	Возврат ТаблицаДней; 
	
КонецФункции

// Функция возвращает рабочий календарь на период, количество рабочих часов в дне.
//
// Параметры:
//  Календарь		 - СправочникСсылка.упоРабочиеКалендари	 - запрашиваемый календарь.
//  НачПериода		 - Дата									 - дата начала периода.
//  КонПериода		 - Дата									 - дата завершения периода.
//  ТолькоРабочиеДни - Булево								 - флаг указыват на необходимость извлечь данные
//  								только по рабочим дням (ненулевое количество рабочих часов).
//  Смещения		 - Булево								 - флаг указыват на необходимость получать смещения.
// 
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - структура колонок:
//  * День - Дата
//  * КоличествоЧасов - Число
//
Функция ПолучитьРабочийКалендарьНаПериод(Календарь, НачПериода, КонПериода, ТолькоРабочиеДни = Ложь, Смещения = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь" , Календарь);
	Запрос.УстановитьПараметр("НачПериода", НачалоДня(НачПериода));
	Запрос.УстановитьПараметр("КонПериода", НачалоДня(КонПериода));
	Запрос.Текст = упоРабочиеКалендариСерверПовтИспСеанс.ПолучитьТекстЗапросаРабочегоКалендаря(Истина, ТолькоРабочиеДни, Смещения);
		
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат Неопределено; // нет сведений
	КонецЕсли;
	
	Возврат Результат.Выгрузить(); // таблица календаря на год
	
КонецФункции

#Область ОбработчикиРегламентныхЗаданий

// Обработчик регламентного задания расчета календарных сдвигов
// РегламентныеЗадания.упоОптимизацияРабочихКалендарей.
//
Процедура РассчитатьКалендарныеСдвигиПоЗаданию() Экспорт
	
	РЗ_ОптимизацияРабочихКалендарей = Метаданные.РегламентныеЗадания.упоОптимизацияРабочихКалендарей;
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(РЗ_ОптимизацияРабочихКалендарей);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|   упоРабочиеКалендари.Ссылка КАК Ссылка
	|ИЗ
	|   Справочник.упоРабочиеКалендари КАК упоРабочиеКалендари";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НужноРассчитатьСдвиги = НуженРасчетСдвигов(ВыборкаДетальныеЗаписи.Ссылка);
		Если НужноРассчитатьСдвиги Тогда
			РассчитатьСмещенияДляКалендаря(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура РассчитатьСмещенияДляКалендаря(Календарь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивЧасов = ПолучитьМассивЧасовСмещенийДляКалендаря(Календарь);
	
	ДоКонкретногоВремени = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь", Календарь);
	Запрос.Текст = "ВЫБРАТЬ
	|	упоРабочиеКалендариСрезПоследних.День КАК День,
	|	упоРабочиеКалендариСрезПоследних.Календарь КАК Календарь,
	|	упоРабочиеКалендариСрезПоследних.КоличествоЧасов КАК КоличествоЧасов,
	|	упоРабочиеКалендариСрезПоследних.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.упоРабочиеКалендари.СрезПоследних КАК упоРабочиеКалендариСрезПоследних
	|ГДЕ
	|	упоРабочиеКалендариСрезПоследних.Календарь = &Календарь
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";
	
	Таблица = Запрос.Выполнить().Выгрузить();		
	
	счКолонок = 1;
	Для Каждого КоличествоЧасов Из МассивЧасов Цикл
		Таблица.Колонки.Добавить("Вперед" + Формат(счКолонок, "ЧН=; ЧГ=") + "Часы");
		Таблица.Колонки.Добавить("Вперед" + Формат(счКолонок, "ЧН=; ЧГ=") + "Дата");
		Таблица.Колонки.Добавить("Назад" + Формат(счКолонок, "ЧН=; ЧГ=") + "Часы");
		Таблица.Колонки.Добавить("Назад" + Формат(счКолонок, "ЧН=; ЧГ=") + "Дата");
		счКолонок = счКолонок + 1;
	КонецЦикла;
	
	ТаблицаРегистраторов = Таблица.Скопировать(, "Регистратор");
	ТаблицаРегистраторов.Свернуть("Регистратор");
	МассивРегистраторов = ТаблицаРегистраторов.ВыгрузитьКолонку("Регистратор");
	
	СделатьПроходПоТаблицеРасчетаСмещений(Таблица, МассивЧасов, 1, ДоКонкретногоВремени);
	СделатьПроходПоТаблицеРасчетаСмещений(Таблица, МассивЧасов, -1, ДоКонкретногоВремени);
	
	Для Каждого Регистратор Из МассивРегистраторов Цикл
		ТаблицаРегистратора = Таблица.Скопировать(Новый Структура("Регистратор", Регистратор));
		ТаблицаРегистратора.Колонки.Добавить("Период");
		ТаблицаРегистратора.Колонки.Добавить("Активность");
		ТаблицаРегистратора.ЗаполнитьЗначения(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Регистратор, "Дата"), "Период");
		ТаблицаРегистратора.ЗаполнитьЗначения(Истина, "Активность");
		НаборЗаписей = РегистрыСведений.упоРабочиеКалендари.СоздатьНаборЗаписей();
		НаборЗаписей.Загрузить(ТаблицаРегистратора);
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьСмещенияДляВсехКалендарей() Экспорт
	
	Выборка = Справочники.упоРабочиеКалендари.Выбрать();
	Пока Выборка.Следующий() Цикл
		РассчитатьСмещенияДляКалендаря(Выборка.Ссылка);	
	КонецЦикла;
		
КонецПроцедуры

Процедура УдалитьДанныеСмещенийДляКалендаря(Календарь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивПолей = Новый Массив;
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.упоРабочиеКалендари.Ресурсы Цикл
		Если Ресурс.Имя = "КоличествоЧасов" Тогда 
			Продолжить;
		КонецЕсли;
		МассивПолей.Добавить(Ресурс.Имя);
	КонецЦикла;
	СтрокаПолей = СтрСоединить(МассивПолей, ", ");
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь", Календарь);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоРабочиеКалендариСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних КАК упоРабочиеКалендариСрезПоследних
	               |ГДЕ
	               |	упоРабочиеКалендариСрезПоследних.Календарь = &Календарь
	               |	И упоРабочиеКалендариСрезПоследних.Вперед1Часы <> 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НаборЗаписей = РегистрыСведений.упоРабочиеКалендари.СоздатьНаборЗаписей();
	
	Пока Выборка.Следующий() Цикл
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		НаборЗаписей.Прочитать();
		Таблица = НаборЗаписей.Выгрузить();
		Таблица.ЗаполнитьЗначения(Неопределено, СтрокаПолей);
		НаборЗаписей.Загрузить(Таблица);
		НаборЗаписей.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция НуженРасчетСдвигов(Календарь) Экспорт
	
	Если Не ЗначениеЗаполнено(Календарь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Календарь", Календарь);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	упоРабочиеКалендариСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних КАК упоРабочиеКалендариСрезПоследних
	               |ГДЕ
	               |	упоРабочиеКалендариСрезПоследних.Календарь = &Календарь
	               |	И упоРабочиеКалендариСрезПоследних.Вперед1Часы <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	упоРабочиеКалендариСрезПоследних.Регистратор КАК Регистратор
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних КАК упоРабочиеКалендариСрезПоследних
	               |ГДЕ
	               |	упоРабочиеКалендариСрезПоследних.Календарь = &Календарь";
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	СдвигиРассчитаны = Не РезультатПакета[0].Пустой();
	СуществуетЗапись = Не РезультатПакета[1].Пустой();
	
	Возврат СуществуетЗапись И Не СдвигиРассчитаны;
	
КонецФункции

// Функция возвращает момент времени документа.
// 
// Параметры:
//  ДокументОбъект - ДокумнетОбъект - собственно, документ.
// 
// Возвращаемое значение:
//  Дата, МоментВремени - '00010101', если документ новый; МоментВремени, если документ уже записан.
// 
Функция обПолучитьМоментВремениДокумента(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат '00010101'; // актуальная дата
	Иначе
		Возврат ДокументОбъект.МоментВремени(); // момент времени документа
	КонецЕсли;

КонецФункции

// Функция проверяет количество часов в сутках на корректность
// и в случае неверного значения ограничевает пользователя правильным диапазоном.
//
// Параметры:
//  КоличествоЧасов – Число - заданное пользователем количество часов в сутках.
//  
// Возвращаемое значение:
//   Число – откорректированное количество часов в сутках.
//
Функция обКонтролироватьКоличествоЧасовВСутках(Знач КоличествоЧасов) Экспорт

	// Ограничем пользователя правильным количеством часов в сутках.
	Если КоличествоЧасов > 24 Тогда // перебор
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Введены некорректные данные! Количество часов не может быть больше 24.";
		Сообщение.Сообщить();
		Возврат 24;
	ИначеЕсли КоличествоЧасов < 0 Тогда // недобор
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Введены некорректные данные! Количество часов не может быть меньше 0.";
		Сообщение.Сообщить();
		Возврат 0;
	Иначе // все хорошо
		Возврат КоличествоЧасов;
	КонецЕсли;

КонецФункции

// Функция пересчитывает количество из заданной единицы времени в часы
//
// Параметры:
//  Значение  – Число - значение заданной ед. времени.
//  ЕдВремени - СправочникСсылка.упоЕдиницыВремени - ссылка на заданную ед. времени.
//  
// Возвращаемое значение:
//   Число – пересчитанное количество заданной ед. времени в часы.
//
Функция обПересчитатьЕдВремениВЧасы(Значение, ЕдВремени) Экспорт
	
	Если Справочники.упоЕдиницыВремени.Час.Коэффициент <> 0 Тогда
		ЕдиницаИзмеренияЧас	= Справочники.упоЕдиницыВремени.Час;
		КоэффициентЕдиницаИзмеренияЧас = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмеренияЧас, "Коэффициент");	
		Возврат Окр(ЕдВремени.Коэффициент * Значение / КоэффициентЕдиницаИзмеренияЧас);
	Иначе
		Возврат 0; // на всякий пожарный.
	КонецЕсли;
	
КонецФункции

// Функция пересчитывает количество часов в заданную единицу времени
//
// Параметры:
//  Значение  – Число - значение в часах
//  ЕдВремени - СправочникСсылка.упоЕдиницыВремени - ссылка на заданную ед. времени.
//  
// Возвращаемое значение:
//   Число – пересчитанное количество заданной ед. времени в часы.
//
Функция обПересчитатьЕдВремениИзЧасов(Значение, ЕдВремени) Экспорт
	
	Если ЕдВремени.Коэффициент <> 0 Тогда
		ЕдиницаИзмеренияЧас	= Справочники.упоЕдиницыВремени.Час;
		КоэффициентЕдиницаИзмеренияЧас = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмеренияЧас, "Коэффициент");	
		Возврат  (Значение / ЕдВремени.Коэффициент) * КоэффициентЕдиницаИзмеренияЧас;
	Иначе
		Возврат 0; // на всякий пожарный.
	КонецЕсли;
	
КонецФункции

