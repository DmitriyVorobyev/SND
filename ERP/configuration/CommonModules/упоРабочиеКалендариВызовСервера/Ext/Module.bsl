// Функция добавляет к заданной дате заданное количество часов по заданному календарю.
// Внутри функция использует, подаваемый на вход, кэш данных дней календаря.
// При отсутствии необходимых данных, функция сама добавляет их в заданный кэш.
// 
// Параметры:
//  Календарь       – СправочникСсылка.упоРабочиеКалендари - рабочий календарь.
//  ДанныеКалендаря - ТаблицаЗначений - кэш данных календаря.
//  Дата            – Дата  дата к которой прибавляются часы.
//  КолЧасов        – Число - количество прибавляемых часов.
// 
// Возвращаемое значение:
//  Дата, новая дата, полученная в результате расчета.
//  Неопределено, нет календаря на запрашиваемый год.
// 
Функция обДобавитьКДатеПоКалендарю(Календарь, ДанныеКалендаря, Дата, Знач КолЧасов) Экспорт
	
	ДлинаСуток = 24 * 60 * 60;
	
	НоваяДата = Дата;
	
	Пока КолЧасов > 0 Цикл
	
		День = НачалоДня(НоваяДата);
		
		ДанныеДня = ДанныеКалендаря.Найти(День, "День");
		
		Если ДанныеДня = Неопределено Тогда
			
			ТаблицаКалендаря = упоРабочиеКалендариВызовСервера.обПолучитьРабочийКалендарь(Календарь, НачалоГода(День));
				
			Если ТаблицаКалендаря = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
				
			Для Каждого СтрокаТаблицы Из ТаблицаКалендаря Цикл
				НоваяСтрока = ДанныеКалендаря.Добавить();
				НоваяСтрока.День            = СтрокаТаблицы.День;
				НоваяСтрока.КоличествоЧасов = СтрокаТаблицы.КоличествоЧасов;
			КонецЦикла;
		
			ДанныеДня = ДанныеКалендаря.Найти(День, "День");
			
			Если ДанныеДня = Неопределено Тогда 
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
		КолЧасовДня = ДанныеДня.КоличествоЧасов;
		
		Если КолЧасов > КолЧасовДня Тогда
			НоваяДата = НоваяДата + ДлинаСуток; // следующий день
			
			КолЧасов = КолЧасов - КолЧасовДня;
		Иначе
			КолЧасов = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат День;
	
КонецФункции

// Заменяет значение года в заданной дате на новое.
// 
// Параметры:
//  Дата – Дата - Дата, год которой подлежит замене.
//  Год  – Число- Год на который, изменяется значение даты.
//
// Возвращаемое значение:
//  Дата - полученная даты с новымзначение года.
// 
Функция обПолучитьДатуСНовымЗначениеГода(СтараяДата, НовоеЗначениеГода) Экспорт

	РазницаГодов = НовоеЗначениеГода - Год(СтараяДата);
	Возврат ДобавитьМесяц(СтараяДата, РазницаГодов * 12);

КонецФункции

// Функция возвращает дату завершения периода по заданной дате начала периода,
// по заданной длительности периода в часах, по заданному календарю.
//
// Параметры:
//  Календарь    – СправочникСсылка.упоРабочиеКалендари - запрашиваемый календарь.
//  НачПериода   – Дата - дата начала периода.
//  Длительность – Число - количество часов в периоде.
//  
// Возвращаемое значение:
//   Дата – дата завершения периода.
//   Неопределено – нет сведений о календаре на некоторый год в заданном периоде.
//
Функция обПолучитьКонецПериода(Календарь, НачПериода, Длительность) Экспорт
	
	ДлинаСуток = 24 * 60 * 60;
	
	День       = НачалоДня(НачПериода);
	ТекПериод  = '00010101';
	
	КолЧасов = Длительность;
	
	Пока КолЧасов > 0 Цикл
	
		Если ТекПериод <> НачалоГода(День) Тогда
			
			ТекПериод = НачалоГода(День);
			
			ТаблицаКалендаря = упоРабочиеКалендариВызовСервера.обПолучитьРабочийКалендарь(Календарь, ТекПериод);
			
			Если ТаблицаКалендаря = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
		
		КонецЕсли;
		
		СтрокаКалендаря = ТаблицаКалендаря.Найти(День, "День");
		
		Если Не СтрокаКалендаря = Неопределено Тогда 
			КолЧасовДня = СтрокаКалендаря.КоличествоЧасов;
		Иначе		
			КолЧасовДня = 0;
		КонецЕсли;
		
		Если КолЧасов > КолЧасовДня Тогда
			День = День + ДлинаСуток; // следующий день
			
			КолЧасов = КолЧасов - КолЧасовДня;
		Иначе
			День = День + КолЧасов * 60 * 60;
			КолЧасов = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат День;
	
КонецФункции

// Сервисная функция, добавляет к заданной дате один полный день.
// 
// Параметры:
//  Дата – Дата, дата к которой прибавляются сутки.
// 
// Возвращаемое значение:
//  Дата, новая дата, полученная в результате расчета.
// 
Функция обДобавитьДень(Дата) Экспорт
	
	Возврат Дата + 60 * 60 * 24;
	
КонецФункции

// Рассчитывает количество рабочих дней и рабочих часов по 
// указанному рабочему календарю за период.
//
// Параметры:
//  РабочийКалендарь  – Справочник.упоРабочиеКалендари - собственно календарь.
//  ДатаНачала		  – Дата - начало периода.
//  ДатаКонца		  – Дата - конец периода.
//
// Возвращаемое значение:
//   Структура   – содержит поля с количеством часов и дней.
//
Функция обКоличествоРабочихДнейИЧасовВПериоде(РабочийКалендарь, ДатаНачала, ДатаКонца) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("КоличествоДней", 0);
	Результат.Вставить("КоличествоЧасов", 0);
	
	КолСекундВЧасе = 3600;

	КолЧасовПоКалендарю_ДатаКонца = КоличествоРабочихЧасовВДне(РабочийКалендарь, ДатаКонца);
		
	Если НачалоДня(ДатаНачала) = НачалоДня(ДатаКонца) Тогда 
		
		Если КолЧасовПоКалендарю_ДатаКонца <> 0 Тогда
			Результат.КоличествоЧасов = (ДатаКонца - НачалоДня(ДатаКонца)) / КолСекундВЧасе;
			Результат.КоличествоДней = Результат.КоличествоЧасов / КолЧасовПоКалендарю_ДатаКонца;
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
	КонецДняДоДатыЗавершения = НачалоДня(ДатаКонца)-1; 
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	РегКалендарь.Календарь КАК РабочийКалендарь,
	               |	СУММА(РегКалендарь.КоличествоЧасов) КАК КоличествоЧасов,
	               |	КОЛИЧЕСТВО(РегКалендарь.День) КАК КоличествоДней
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	               |			,
	               |			Календарь = &РабочийКалендарь
	               |				И (День МЕЖДУ &ДатаНачала И &ДатаКонца)) КАК РегКалендарь
	               |ГДЕ
	               |	РегКалендарь.КоличествоЧасов > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РегКалендарь.Календарь";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("РабочийКалендарь", РабочийКалендарь);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДняДоДатыЗавершения);	
			
	Если КолЧасовПоКалендарю_ДатаКонца = 0 Тогда
		ЧасыКДобавлению = 0;
	Иначе
		ЧасыКДобавлению = Окр((ДатаКонца - НачалоДня(ДатаКонца)) / КолСекундВЧасе, 2);
	КонецЕсли;
	
	Если ЧасыКДобавлению > КолЧасовПоКалендарю_ДатаКонца Тогда
		ЧасыКДобавлению = КолЧасовПоКалендарю_ДатаКонца;	
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ЕдиницаИзмеренияДень = Справочники.упоЕдиницыВремени.РабочийДень;
	КоэффициентЕдиницаИзмеренияДень	 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЕдиницаИзмеренияДень, "Коэффициент");
	
	Если КоэффициентЕдиницаИзмеренияДень = 0 Тогда
		ТекстИсключения = НСтр("ru = 'Не установлен коэффициент предопределенной единицы времени ""Рабочий день"".'");		
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
	Если РезультатЗапроса.Пустой() Тогда
		Результат.КоличествоДней = ЧасыКДобавлению / КоэффициентЕдиницаИзмеренияДень;
		Результат.КоличествоЧасов = ЧасыКДобавлению;	
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Результат.КоличествоДней = Выборка.КоличествоДней + ЧасыКДобавлению / КоэффициентЕдиницаИзмеренияДень;
		Результат.КоличествоЧасов = Выборка.КоличествоЧасов + ЧасыКДобавлению;		
	КонецЕсли;	 
	
	Возврат Результат;
	
КонецФункции
 
// Функция распределяет некое числовое значение по профилу с учетом календаря.
//
// Параметры:
//	Значение 				- Число 		– некое значение, которое необходимо распределить по периоду.
//	ПрофильРаспределения 	- Неизвестно	– описаниеПараметра.
//	Календарь 				- СправочникСсылка.упоРабочиеКалендари – календарь.
//	ДатаНачала 				- Дата			– начало периода.
//	ДатаЗавершения 			- Дата 			– конец периода.
//
// Возвращаемое значение:
//	ТаблицаЗначений – таблица, где по каждому дню выполнено распределение числового значения. Колонки:
//		* День			- Дата  - день
//		* Количество 	- Число - количество.
//
Функция обРаспределитьПоПрофилю(Знач Значение,
								Знач Календарь,
								ДатаНачала,
								ДатаЗавершения,
								ПрофильРаспределения = Неопределено) Экспорт 
								
	РезультатРаспределения = Новый ТаблицаЗначений;
	РезультатРаспределения.Колонки.Добавить("День");
	
	КЧ = Новый КвалификаторыЧисла(15,2);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);

	РезультатРаспределения.Колонки.Добавить("Количество", ОписаниеТиповЧ);
	Ошибки = Неопределено;
	
	Если ПрофильРаспределения = Неопределено Тогда // выполним равномерное распределение
		
		новСтрока = Неопределено;
		
		ДанныеПериода = упоРабочиеКалендариВызовСервера.обКоличествоРабочихДнейИЧасовВПериоде(Календарь, ДатаНачала, ДатаЗавершения);
		ОбщееКоличествоЧасов = ДанныеПериода.КоличествоЧасов;
		
		ТаблицаКалендаря = упоРабочиеКалендариСерверПовтИспВыз.ПолучитьРабочийКалендарь(Календарь, ДатаНачала, Ложь, Ложь);
		Если ТаблицаКалендаря = Неопределено Тогда
			Возврат Новый ТаблицаЗначений;
		КонецЕсли;
		
		строкадня = ТаблицаКалендаря.Найти(НачалоДня(ДатаНачала), "День");
		индексСтроки = ТаблицаКалендаря.Индекс(строкадня);
		
		ОстатокКРаспределению = Значение;
		
		Пока строкадня.День <= ДатаЗавершения И (ОстатокКРаспределению >0) Цикл
			Если строкадня.КоличествоЧасов > 0 Тогда
				новСтрока = РезультатРаспределения.Добавить();
				новСтрока.День = строкадня.День;
				КоличествоКРаспределению = Мин(Значение / ОбщееКоличествоЧасов * строкадня.КоличествоЧасов,ОстатокКРаспределению);
				
				новСтрока.Количество = КоличествоКРаспределению;
				
				ОстатокКРаспределению = ОстатокКРаспределению - новСтрока.Количество;
			КонецЕсли;
			
			индексСтроки = индексСтроки + 1;
			Если индексСтроки > ТаблицаКалендаря.Количество() - 1 Тогда
				сохрДень = строкадня.День;
				Если НЕ упоРасчетКалендарныхСроковРедакция3Сервер.временноУвеличитьКалендарь(ТаблицаКалендаря,
					ДобавитьМесяц(строкадня.День, 1), Календарь, Ошибки) Тогда
					
					Возврат Новый ТаблицаЗначений;
					
				КонецЕсли;
				
				строкадня = ТаблицаКалендаря.Найти(сохрДень, "День");
				Если строкадня = Неопределено Тогда
					Возврат Новый ТаблицаЗначений;
				КонецЕсли;
				индексСтроки = ТаблицаКалендаря.Индекс(строкадня) + 1;
			КонецЕсли;
			строкаДня = ТаблицаКалендаря.Получить(индексСтроки);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОстатокКРаспределению) И ЗначениеЗаполнено(новСтрока) Тогда
			новСтрока.Количество = новСтрока.Количество + ОстатокКРаспределению;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатРаспределения;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьМассивЧасовСмещенийДляКалендаря(Календарь)
	
	СписокЧасов = Новый Массив;
	
	СписокЧасов.Добавить(40);	
	СписокЧасов.Добавить(80);	
	СписокЧасов.Добавить(160);	
	СписокЧасов.Добавить(320);	
	
	Возврат СписокЧасов;

КонецФункции 

Процедура СделатьПроходПоТаблицеРасчетаСмещений(Таблица, МассивЧасов, Направление = 1, ДоКонкретногоВремени) 
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиВОбработке = Новый Массив;
	
	Если Направление = 1 Тогда
		Префикс = "Вперед";
		ТекИндекс = 0; 
		КонечныйИндекс = Таблица.Количество();
	Иначе
		Префикс = "Назад";
		ТекИндекс = Таблица.Количество() - 1;
		КонечныйИндекс = -1;
	КонецЕсли;
	
	
	Пока ТекИндекс <> КонечныйИндекс Цикл	
		
		СтрокаТаблицы = Таблица[ТекИндекс];
		
		Если НЕ СтрокаТаблицы.КоличествоЧасов = 0 Тогда
			
			УдалитьИзОбработки = Новый Массив;
			
			счОбработка = СтрокиВОбработке.ВГраница();
			
			Пока счОбработка >= 0 Цикл
				
				ДанныеСтроки = СтрокиВОбработке[счОбработка]; 
				
				Если СтрокаТаблицы.КоличествоЧасов >= ДанныеСтроки.Часы Тогда
					
					Если ДоКонкретногоВремени Тогда
						КоличествоЧасов = ДанныеСтроки.ВсегоЧасов;
						Если Направление = 1 Тогда
							НужнаяДата = СтрокаТаблицы.День + 3600 * ДанныеСтроки.Часы;  
						Иначе
							НужнаяДата = СтрокаТаблицы.День + 3600 * (СтрокаТаблицы.КоличествоЧасов - ДанныеСтроки.Часы);
						КонецЕсли;
					Иначе  
						НужнаяДата = СтрокаТаблицы.День; 
						Если Направление = 1 Тогда						 
							КоличествоЧасов = ДанныеСтроки.ВсегоЧасов - ДанныеСтроки.Часы;  
						Иначе
							КоличествоЧасов = ДанныеСтроки.ВсегоЧасов + (СтрокаТаблицы.КоличествоЧасов - ДанныеСтроки.Часы);
						КонецЕсли;
					КонецЕсли;
					
					ДанныеСтроки.Строка[Префикс + Формат(ДанныеСтроки.НомерПоля, "ЧН=; ЧГ=") + "Дата"] = НужнаяДата;
					ДанныеСтроки.Строка[Префикс + Формат(ДанныеСтроки.НомерПоля, "ЧН=; ЧГ=") + "Часы"] = КоличествоЧасов;
					
					СтрокиВОбработке.Удалить(счОбработка);
					
				Иначе
					
					ДанныеСтроки.Часы = ДанныеСтроки.Часы - СтрокаТаблицы.КоличествоЧасов;	
					
				КонецЕсли;
				
				счОбработка = счОбработка - 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
		счКолонок = 1;
		Для Каждого КоличествоЧасов Из МассивЧасов Цикл
			Если Направление = 1 Тогда
				СтрокиВОбработке.Добавить(Новый Структура("Строка, Часы, ВсегоЧасов, НомерПоля", СтрокаТаблицы, КоличествоЧасов - СтрокаТаблицы.КоличествоЧасов, КоличествоЧасов, счКолонок));	
			Иначе
				СтрокиВОбработке.Добавить(Новый Структура("Строка, Часы, ВсегоЧасов, НомерПоля", СтрокаТаблицы, КоличествоЧасов, КоличествоЧасов, счКолонок));	
			КонецЕсли;
			счКолонок = счКолонок + 1;
		КонецЦикла;
		
		ТекИндекс = ТекИндекс + Направление;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КоличествоРабочихЧасовВДне(РабочийКалендарь, Дата)
		
	ТекстЗапроса = "ВЫБРАТЬ
	               |	РегКалендарь.КоличествоЧасов КАК КоличествоЧасов
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	               |			,
	               |			Календарь = &РабочийКалендарь
	               |				И День = &Дата) КАК РегКалендарь";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("Дата", НачалоДня(Дата));
    Запрос.УстановитьПараметр("РабочийКалендарь", РабочийКалендарь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой()Тогда
		КоличествоРабЧасов = 0;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		КоличествоРабЧасов = Выборка.КоличествоЧасов;
	КонецЕсли;
	
	Возврат КоличествоРабЧасов;
	
КонецФункции

#КонецОбласти
