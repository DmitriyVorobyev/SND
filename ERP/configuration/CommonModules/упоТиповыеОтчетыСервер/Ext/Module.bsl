	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
								
		ДобавитьПолеКомпоновки(НаборИерархия, 
								"ДатаНачалаПрогноз", 
								"ДатаНачалаПрогноз", 
								,
								,
								,
								,
								Оформление,
								НСтр("ru = 'Дата начала, прогноз'"));
								
		ДобавитьПолеКомпоновки(НаборИерархия, 
								"ДатаЗавершенияПрогноз", 
								"ДатаЗавершенияПрогноз", 
								,
								,
								,
								,
								Оформление,
								НСтр("ru = 'Дата завершения, прогноз'"));     
								
	КонецЕсли;
	
	ТекстЗапросаСрокиИерархия = СхемаЗапроса.ПолучитьТекстЗапроса();
	НаборИерархия.Запрос = ТекстЗапросаСрокиИерархия;
	
КонецПроцедуры

Процедура ДополнитьСКДСрокиПоВерсии(СКД, СрокиПоВерсиям, ИмяОсновногоНабораДанных, СтруктураНастроек,
		ПроверятьИспользованиеПолей, КомпоновщикНастроек)
	
	ОсновнойНабор = СКД.НаборыДанных.Найти(ИмяОсновногоНабораДанных);
	НаборИерархия = СКД.НаборыДанных.Найти("Иерархия");
	
	ИспользуютсяПрогнозныеСроки = упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков();
	
	Для НомерВерсии = 1 По СрокиПоВерсиям Цикл
		НомерВерсииСтрокой = Строка(НомерВерсии);
		ИмяПоляДатаНачалаПоВерсии = "ДатаНачалаПоВерсии" + НомерВерсииСтрокой;
		ИмяПоляДатаЗавершенияПоВерсии = "ДатаЗавершенияПоВерсии" + НомерВерсииСтрокой;
		ИмяПоляДатаНачалаПрогнозПоВерсии = "ДатаНачалаПрогнозПоВерсии" + НомерВерсииСтрокой;
		ИмяПоляДатаЗавершенияПрогнозПоВерсии = "ДатаЗавершенияПрогнозПоВерсии" + НомерВерсииСтрокой;
		
		Если ПроверятьИспользованиеПолей Тогда
			Если КомпоновщикНастроек = Неопределено Тогда
				Возврат;
			КонецЕсли;
			Если НЕ ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, ИмяПоляДатаНачалаПоВерсии)
				И НЕ ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, ИмяПоляДатаЗавершенияПоВерсии)
				И НЕ ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, ИмяПоляДатаНачалаПрогнозПоВерсии)
				И НЕ ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, ИмяПоляДатаЗавершенияПрогнозПоВерсии) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		// Добавим сроки по версии в основной набор данных.
		ДобавитьСрокиПоВерсииВОсновнойНаборДанных(ОсновнойНабор, НомерВерсииСтрокой, СтруктураНастроек, ИспользуютсяПрогнозныеСроки);
		
		// Добавим сроки по версии в набор данных "Иерархия".
		ДобавитьСрокиПоВерсииВНаборДанныхИерархия(НаборИерархия, НомерВерсииСтрокой, СтруктураНастроек, ИспользуютсяПрогнозныеСроки);
		
		Группировки = Новый Массив;
		Группировки.Добавить("ПроектнаяЗадача");
		Группировки.Добавить("ПроектнаяЗадача Иерархия");
		ДобавитьПолеРесурса(СКД, ИмяПоляДатаНачалаПоВерсии, ИмяПоляДатаНачалаПоВерсии, Группировки);
		ДобавитьПолеРесурса(СКД, ИмяПоляДатаЗавершенияПоВерсии, ИмяПоляДатаЗавершенияПоВерсии, Группировки);
		Если ИспользуютсяПрогнозныеСроки Тогда
			ДобавитьПолеРесурса(СКД, ИмяПоляДатаНачалаПрогнозПоВерсии, ИмяПоляДатаНачалаПрогнозПоВерсии, Группировки);
			ДобавитьПолеРесурса(СКД, ИмяПоляДатаЗавершенияПрогнозПоВерсии, ИмяПоляДатаЗавершенияПрогнозПоВерсии, Группировки);
		КонецЕсли;
		
		// Отключим вывод дат в общих итогах.
		Группировки = Новый Массив;
		Группировки.Добавить("ОбщийИтог");
		ДобавитьПолеРесурса(СКД, "0", ИмяПоляДатаНачалаПоВерсии, Группировки);
		ДобавитьПолеРесурса(СКД, "0", ИмяПоляДатаЗавершенияПоВерсии, Группировки);
		Если ИспользуютсяПрогнозныеСроки Тогда
			ДобавитьПолеРесурса(СКД, "0", ИмяПоляДатаНачалаПрогнозПоВерсии, Группировки);
			ДобавитьПолеРесурса(СКД, "0", ИмяПоляДатаЗавершенияПрогнозПоВерсии, Группировки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСрокиПоВерсииВОсновнойНаборДанных(ОсновнойНабор, НомерВерсииСтрокой, СтруктураНастроек, ИспользуютсяПрогнозныеСроки)
	
	// Получим шаблон запроса версий.
	ТекстЗапросаВерсии = ТекстЗапросаВерсииПоНомеру();
	ТекстЗапросаВерсии = СтрЗаменить(ТекстЗапросаВерсии, "_Номер", НомерВерсииСтрокой);
	
	ТекстЗапросаОсновногоНабораДанных = ОсновнойНабор.Запрос;
	СхемаЗапросаОсновнойНабор = Новый СхемаЗапроса;
	СхемаЗапросаОсновнойНабор.УстановитьТекстЗапроса(ТекстЗапросаОсновногоНабораДанных);
	
	ПакетЗапросаОсновногоНабораИтоговый =
		СхемаЗапросаОсновнойНабор.ПакетЗапросов[СхемаЗапросаОсновнойНабор.ПакетЗапросов.Количество() - 1];
	ОператорОсновногоПакетаЗапроса = ПакетЗапросаОсновногоНабораИтоговый.Операторы[0];
	
	ИмяТаблицыСрокиПоВерсии = "СрокиПЗПоВерсии" + НомерВерсииСтрокой;
	ИмяТаблицыПрогнозныеСрокиПоВерсии = "ПрогнозныеСрокиПЗПоВерсии" + НомерВерсииСтрокой;
	ИмяВременнойТаблицыВерсии = "ВТ_Версии" + НомерВерсииСтрокой;
	
	ИмяТаблицыСрокиПоВерсии = "СрокиПЗПоВерсии" + НомерВерсииСтрокой;
	ИмяТаблицыПрогнозныеСрокиПоВерсии = "ПрогнозныеСрокиПЗПоВерсии" + НомерВерсииСтрокой;
	ИмяВременнойТаблицыВерсии = "ВТ_Версии" + НомерВерсииСтрокой;
	
	ИмяПоляДатаНачалаПоВерсии = "ДатаНачалаПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыНачалаПоВерсии = СтрШаблон(НСтр("ru = 'Дата начала по версии %1'"), НомерВерсииСтрокой);
	ИмяПоляДатаЗавершенияПоВерсии = "ДатаЗавершенияПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыЗавершенияПоВерсии = СтрШаблон(НСтр("ru = 'Дата завершения по версии %1'"), НомерВерсииСтрокой);
	
	ИмяПоляДатаНачалаПрогнозПоВерсии = "ДатаНачалаПрогнозПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыНачалаПрогнозПоВерсии = СтрШаблон(НСтр("ru = 'Дата начала, прогноз по версии %1'"), НомерВерсииСтрокой);
	ИмяПоляДатаЗавершенияПрогнозПоВерсии = "ДатаЗавершенияПрогнозПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыЗавершенияПрогнозПоВерсии = СтрШаблон(НСтр("ru = 'Дата завершения, прогноз по версии %1'"), НомерВерсииСтрокой);
	
	ВременнаяТаблицаВерсииПоНомеру = СхемаЗапросаОсновнойНабор.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
	ВременнаяТаблицаВерсииПоНомеру.УстановитьТекстЗапроса(ТекстЗапросаВерсии);
	ВременнаяТаблицаВерсииПоНомеру.ТаблицаДляПомещения = ИмяВременнойТаблицыВерсии;
	СхемаЗапросаОсновнойНабор.ПакетЗапросов.Сдвинуть(ВременнаяТаблицаВерсииПоНомеру, -1);
	
	ИсточникСрокиПЗПоВерсии = ОператорОсновногоПакетаЗапроса.Источники.Добавить(
			"РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних",
			ИмяТаблицыСрокиПоВерсии);
	ИсточникСрокиПЗПоВерсии.Источник.Параметры[0].Выражение =
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникСрокиПЗПоВерсии.Источник.Параметры[1].Выражение =
		Новый ВыражениеСхемыЗапроса(СтрШаблон("Версия В
				|     (ВЫБРАТЬ
				|     %1.Версия КАК Версия
				|     ИЗ
				|     %1 КАК %1) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}", ИмяВременнойТаблицыВерсии));
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1 = %2.ПроектнаяЗадача",
			СтруктураНастроек.ИмяПоляПЗДляСвязиСОсновнымНабором,
			ИмяТаблицыСрокиПоВерсии);
	Соединение = ОператорОсновногоПакетаЗапроса.Источники[0].Соединения.Добавить(ИмяТаблицыСрокиПоВерсии, УсловиеСоединения);
	
	ВыбранноеПоле = ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Добавить(ИмяТаблицыСрокиПоВерсии + ".ДатаНачалаПлан");
	ПакетЗапросаОсновногоНабораИтоговый.Колонки[ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Количество() - 1].Псевдоним =
		ИмяПоляДатаНачалаПоВерсии;
	ВыбранноеПоле = ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Добавить(ИмяТаблицыСрокиПоВерсии + ".ДатаЗавершенияПлан");
	ПакетЗапросаОсновногоНабораИтоговый.Колонки[ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Количество() - 1].Псевдоним =
		ИмяПоляДатаЗавершенияПоВерсии;
	
	Если ИспользуютсяПрогнозныеСроки Тогда
		ИсточникПрогнозныеСрокиПЗ = ОператорОсновногоПакетаЗапроса.Источники.Добавить(
				"РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних",
				ИмяТаблицыПрогнозныеСрокиПоВерсии);
		ИсточникПрогнозныеСрокиПЗ.Источник.Параметры[0].Выражение =
			Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
		ИсточникПрогнозныеСрокиПЗ.Источник.Параметры[1].Выражение =
			Новый ВыражениеСхемыЗапроса(СтрШаблон("Версия В
					|     (ВЫБРАТЬ
					|     %1.Версия КАК Версия
					|     ИЗ
					|     %1 КАК %1) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}", ИмяВременнойТаблицыВерсии));
		// Соединим левым соединением с таблицей СрокиПЗ, т.к. плановые сроки есть всегда.
		УсловиеСоединения = СтрШаблон("%1.ПроектнаяЗадача = %2.ПроектнаяЗадача
				|  И %1.Версия = %2.Версия", ИмяТаблицыСрокиПоВерсии, ИмяТаблицыПрогнозныеСрокиПоВерсии);
		Соединение = ИсточникСрокиПЗПоВерсии.Соединения.Добавить(ИмяТаблицыПрогнозныеСрокиПоВерсии, УсловиеСоединения);
		
		ВыбранноеПоле = ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Добавить(
				ИмяТаблицыПрогнозныеСрокиПоВерсии + ".ДатаНачалаПрогноз");
		ПакетЗапросаОсновногоНабораИтоговый.Колонки[ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Количество() - 1].Псевдоним =
			ИмяПоляДатаНачалаПрогнозПоВерсии;
		ВыбранноеПоле = ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Добавить(
				ИмяТаблицыПрогнозныеСрокиПоВерсии + ".ДатаЗавершенияПрогноз");
		ПакетЗапросаОсновногоНабораИтоговый.Колонки[ОператорОсновногоПакетаЗапроса.ВыбираемыеПоля.Количество() - 1].Псевдоним =
			ИмяПоляДатаЗавершенияПрогнозПоВерсии;
	КонецЕсли;
	
	Если НЕ ОсновнойНабор.АвтоЗаполнениеДоступныхПолей Тогда
		ПакетЗапросаОсновногоНабораИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(ИмяПоляДатаНачалаПоВерсии);
		ПакетЗапросаОсновногоНабораИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(ИмяПоляДатаЗавершенияПоВерсии);
		
		Если ИспользуютсяПрогнозныеСроки Тогда
			ПакетЗапросаОсновногоНабораИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(ИмяПоляДатаНачалаПрогнозПоВерсии);
			ПакетЗапросаОсновногоНабораИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(ИмяПоляДатаЗавершенияПрогнозПоВерсии);
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапросаСДобавленнымиСрокамиПоВерсии = СхемаЗапросаОсновнойНабор.ПолучитьТекстЗапроса();
	ОсновнойНабор.Запрос = ТекстЗапросаСДобавленнымиСрокамиПоВерсии;
	
	Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, ФорматПериодаДень());
	
	ДобавитьПолеКомпоновки(ОсновнойНабор,
		ИмяПоляДатаНачалаПоВерсии,
		ИмяПоляДатаНачалаПоВерсии,
		,
		,
		,
		,
		Оформление,
		СинонимПоляДатыНачалаПоВерсии);
	
	ДобавитьПолеКомпоновки(ОсновнойНабор,
		ИмяПоляДатаЗавершенияПоВерсии,
		ИмяПоляДатаЗавершенияПоВерсии,
		,
		,
		,
		,
		Оформление,
		СинонимПоляДатыЗавершенияПоВерсии);
	
	Если ИспользуютсяПрогнозныеСроки Тогда
		ДобавитьПолеКомпоновки(ОсновнойНабор,
			ИмяПоляДатаНачалаПрогнозПоВерсии,
			ИмяПоляДатаНачалаПрогнозПоВерсии,
			,
			,
			,
			,
			Оформление,
			СинонимПоляДатыНачалаПрогнозПоВерсии);
		
		ДобавитьПолеКомпоновки(ОсновнойНабор,
			ИмяПоляДатаЗавершенияПрогнозПоВерсии,
			ИмяПоляДатаЗавершенияПрогнозПоВерсии,
			,
			,
			,
			,
			Оформление,
			СинонимПоляДатыЗавершенияПрогнозПоВерсии);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСрокиПоВерсииВНаборДанныхИерархия(НаборИерархия, НомерВерсииСтрокой, СтруктураНастроек, ИспользуютсяПрогнозныеСроки)
	
	// Получим шаблон запроса версий.
	ТекстЗапросаВерсии = ТекстЗапросаВерсииПоНомеру();
	ТекстЗапросаВерсии = СтрЗаменить(ТекстЗапросаВерсии, "_Номер", НомерВерсииСтрокой);
	
	ТекстЗапросаНабораДанныхИерархия = НаборИерархия.Запрос;
	СхемаЗапросаНаборДанныхИерархия = Новый СхемаЗапроса;
	СхемаЗапросаНаборДанныхИерархия.УстановитьТекстЗапроса(ТекстЗапросаНабораДанныхИерархия);
	
	ИмяТаблицыСрокиПоВерсии = "СрокиПЗПоВерсии" + НомерВерсииСтрокой;
	ИмяТаблицыПрогнозныеСрокиПоВерсии = "ПрогнозныеСрокиПЗПоВерсии" + НомерВерсииСтрокой;
	ИмяВременнойТаблицыВерсии = "ВТ_Версии" + НомерВерсииСтрокой;
	
	ИмяПоляДатаНачалаПоВерсии = "ДатаНачалаПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыНачалаПоВерсии = СтрШаблон(НСтр("ru = 'Дата начала по версии %1'"), НомерВерсииСтрокой);
	ИмяПоляДатаЗавершенияПоВерсии = "ДатаЗавершенияПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыЗавершенияПоВерсии = СтрШаблон(НСтр("ru = 'Дата завершения по версии %1'"), НомерВерсииСтрокой);
	
	ИмяПоляДатаНачалаПрогнозПоВерсии = "ДатаНачалаПрогнозПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыНачалаПрогнозПоВерсии = СтрШаблон(НСтр("ru = 'Дата начала, прогноз по версии %1'"), НомерВерсииСтрокой);
	ИмяПоляДатаЗавершенияПрогнозПоВерсии = "ДатаЗавершенияПрогнозПоВерсии" + НомерВерсииСтрокой;
	СинонимПоляДатыЗавершенияПрогнозПоВерсии = СтрШаблон(НСтр("ru = 'Дата завершения, прогноз по версии %1'"), НомерВерсииСтрокой);
	
	// Поместим данные иерархии во временную таблицу, если не помещены.
	ПакетИерархия = СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов[1];
	ИмяИсточника = "ВТ_Иерархия";
	Если ПакетИерархия.ТаблицаДляПомещения = "" Тогда
		ПакетИерархия.ТаблицаДляПомещения = ИмяИсточника;
		ПакетЗапросаИерархияИтоговый = СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		ОператорПакетаЗапросаИерархия = ПакетЗапросаИерархияИтоговый.Операторы[0];
		ОператорПакетаЗапросаИерархия.Источники.Добавить(ИмяИсточника, ИмяИсточника);
		Для Каждого Колонка Из ПакетИерархия.Колонки Цикл
			ИмяПоля = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2",
					ИмяИсточника,
					Колонка.Псевдоним);
			ВыбранноеПоле = ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Добавить(ИмяПоля);
		КонецЦикла;
	Иначе
		ПакетЗапросаИерархияИтоговый = СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов[
			СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Количество() - 1];
		ОператорПакетаЗапросаИерархия = ПакетЗапросаИерархияИтоговый.Операторы[0];
	КонецЕсли;
	
	ВременнаяТаблицаВерсииПоНомеру = СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
	ВременнаяТаблицаВерсииПоНомеру.УстановитьТекстЗапроса(ТекстЗапросаВерсии);
	ВременнаяТаблицаВерсииПоНомеру.ТаблицаДляПомещения = ИмяВременнойТаблицыВерсии;
	СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Сдвинуть(ВременнаяТаблицаВерсииПоНомеру, -1);
	
	ИмяТаблицыСрокиПоВерсииПроект = "ВТ_СрокиПроекта" + НомерВерсииСтрокой;
	ПакетСрокиПроекта = СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
	СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Сдвинуть(ПакетСрокиПроекта, -1);
	ТекстЗапросаСрокиПроекта = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    ВерсииПроекта.Проект КАК СсылкаНаПроект,
		|    МИНИМУМ(ПлановыеСроки.ДатаНачалаПлан) КАК ДатаНачала,
		|    МАКСИМУМ(ПлановыеСроки.ДатаЗавершенияПлан) КАК ДатаЗавершения
		|ИЗ
		|    РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2},
		|            Версия В
		|                (ВЫБРАТЬ
		|                    %1.Версия КАК Версия
		|                ИЗ
		|                    %1 КАК %1) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК ПлановыеСроки
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК СвойстваПроектныхЗадач
		|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
		|            ПО СвойстваПроектныхЗадач.Версия = ВерсииПроекта.Версия
		|        ПО ПлановыеСроки.Версия = СвойстваПроектныхЗадач.Версия
		|            И ПлановыеСроки.Версия = СвойстваПроектныхЗадач.Версия
		|            И ПлановыеСроки.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
		|            И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)
		|{ГДЕ
		|    ВерсииПроекта.Проект.* КАК СсылкаНаПроект}
		|
		|СГРУППИРОВАТЬ ПО
		|    ВерсииПроекта.Проект";
	ТекстЗапросаСрокиПроекта = СтрШаблон(ТекстЗапросаСрокиПроекта, ИмяВременнойТаблицыВерсии);
	ПакетСрокиПроекта.УстановитьТекстЗапроса(ТекстЗапросаСрокиПроекта);
	ПакетСрокиПроекта.ТаблицаДляПомещения = ИмяТаблицыСрокиПоВерсииПроект;
	
	Если ИспользуютсяПрогнозныеСроки Тогда
		ИмяТаблицыПрогнозныеСрокиПоВерсииПроект = "ВТ_СрокиПроектаПрогноз" + НомерВерсииСтрокой;
		
		ПакетПрогнозныеСрокиПроекта = СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		СхемаЗапросаНаборДанныхИерархия.ПакетЗапросов.Сдвинуть(ПакетПрогнозныеСрокиПроекта, -1);
		ТекстЗапросаПрогнозныеСрокиПроекта = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|    ВерсииПроекта.Проект КАК СсылкаНаПроект,
			|    МИНИМУМ(ПрогнозныеСроки.ДатаНачалаПрогноз) КАК ДатаНачалаПрогноз,
			|    МАКСИМУМ(ПрогнозныеСроки.ДатаЗавершенияПрогноз) КАК ДатаЗавершенияПрогноз
			|ИЗ
			|    РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних КАК ПрогнозныеСроки
			|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК СвойстваПроектныхЗадач
			|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
			|            ПО СвойстваПроектныхЗадач.Версия = ВерсииПроекта.Версия
			|            И ВерсииПроекта.Версия В
			|                (ВЫБРАТЬ
			|                    %1.Версия КАК Версия
			|                ИЗ
			|                    %1 КАК %1)
			|        ПО ПрогнозныеСроки.Версия = СвойстваПроектныхЗадач.Версия
			|            И ПрогнозныеСроки.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
			|            И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)
			|ГДЕ
			|    (ПрогнозныеСроки.ДатаНачалаПрогноз <> ДАТАВРЕМЯ(1, 1, 1)
			|            ИЛИ ПрогнозныеСроки.ДатаЗавершенияПрогноз <> ДАТАВРЕМЯ(1, 1, 1))
			|
			|СГРУППИРОВАТЬ ПО
			|    ВерсииПроекта.Проект";
		
		ТекстЗапросаПрогнозныеСрокиПроекта = СтрШаблон(ТекстЗапросаПрогнозныеСрокиПроекта, ИмяВременнойТаблицыВерсии);
		ПакетПрогнозныеСрокиПроекта.УстановитьТекстЗапроса(ТекстЗапросаПрогнозныеСрокиПроекта);
		ПакетПрогнозныеСрокиПроекта.ТаблицаДляПомещения = ИмяТаблицыПрогнозныеСрокиПоВерсииПроект;
	КонецЕсли;
	
	// Соединяем сроки ПЗ по версии.
	ИсточникСрокиПоВерсииПЗИерархия = ОператорПакетаЗапросаИерархия.Источники.Добавить(
			"РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних",
			ИмяТаблицыСрокиПоВерсии);
	ИсточникСрокиПоВерсииПЗИерархия.Источник.Параметры[0].Выражение =
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникСрокиПоВерсииПЗИерархия.Источник.Параметры[1].Выражение =
		Новый ВыражениеСхемыЗапроса(СтрШаблон("Версия В
				|     (ВЫБРАТЬ
				|     %1.Версия КАК Версия
				|     ИЗ
				|     %1 КАК %1) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}", ИмяВременнойТаблицыВерсии));
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1.СсылкаНаПроектнуюЗадачу = %2.ПроектнаяЗадача",
			ИмяИсточника, ИмяТаблицыСрокиПоВерсии);
	Соединение = ОператорПакетаЗапросаИерархия.Источники[0].Соединения.Добавить(ИмяТаблицыСрокиПоВерсии, УсловиеСоединения);
	
	Если ИспользуютсяПрогнозныеСроки Тогда
		ИсточникПрогнозныеСрокиПЗИерархия = ОператорПакетаЗапросаИерархия.Источники.Добавить(
				"РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних",
				ИмяТаблицыПрогнозныеСрокиПоВерсии);
		ИсточникПрогнозныеСрокиПЗИерархия.Источник.Параметры[0].Выражение =
			Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
		ИсточникПрогнозныеСрокиПЗИерархия.Источник.Параметры[1].Выражение =
			Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
		// Соединим левым соединением с таблицей СрокиПЗ, т.к. плановые сроки есть всегда.
		УсловиеСоединения = СтрШаблон("%1.ПроектнаяЗадача = %2.ПроектнаяЗадача
				|  И %1.Версия = %2.Версия", ИмяТаблицыСрокиПоВерсии, ИмяТаблицыПрогнозныеСрокиПоВерсии);
		Соединение = ИсточникСрокиПоВерсииПЗИерархия.Соединения.Добавить(ИмяТаблицыПрогнозныеСрокиПоВерсии, УсловиеСоединения);
	КонецЕсли;
	
	// Соединяем сроки проекта.
	ИсточникСрокиПроектИерархия = ОператорПакетаЗапросаИерархия.Источники.Добавить(
			ИмяТаблицыСрокиПоВерсииПроект,
			ИмяТаблицыСрокиПоВерсииПроект);
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1.ПроектнаяЗадача = %2.СсылкаНаПроект",
			ИмяИсточника, ИмяТаблицыСрокиПоВерсииПроект);
	Соединение = ОператорПакетаЗапросаИерархия.Источники[0].Соединения.Добавить(ИмяТаблицыСрокиПоВерсииПроект, УсловиеСоединения);
	
	ШаблонВыбранноеПоле = "ВЫБОР
		|	КОГДА %1.ЭтоПроектнаяЗадача
		|		ТОГДА ЕСТЬNULL(%2.ДатаНачалаПлан, 0)
		|	ИНАЧЕ ЕСТЬNULL(%3.ДатаНачала, 0)
		|КОНЕЦ";
	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонВыбранноеПоле,
			ИмяИсточника,
			ИмяТаблицыСрокиПоВерсии,
			ИмяТаблицыСрокиПоВерсииПроект);
	ВыбранноеПоле = ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросаИерархияИтоговый.Колонки[ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Количество() - 1].Псевдоним =
		ИмяПоляДатаНачалаПоВерсии;
	
	ШаблонВыбранноеПоле = "ВЫБОР
		|	КОГДА %1.ЭтоПроектнаяЗадача
		|		ТОГДА ЕСТЬNULL(%2.ДатаЗавершенияПлан, 0)
		|	ИНАЧЕ ЕСТЬNULL(%3.ДатаЗавершения, 0)
		|КОНЕЦ";
	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонВыбранноеПоле,
			ИмяИсточника,
			ИмяТаблицыСрокиПоВерсии,
			ИмяТаблицыСрокиПоВерсииПроект);
	ВыбранноеПоле = ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросаИерархияИтоговый.Колонки[ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Количество() - 1].Псевдоним =
		ИмяПоляДатаЗавершенияПоВерсии;
	
	Если ИспользуютсяПрогнозныеСроки Тогда
		ИсточникСрокиПроектИерархия = ОператорПакетаЗапросаИерархия.Источники.Добавить(
				ИмяТаблицыПрогнозныеСрокиПоВерсииПроект,
				ИмяТаблицыПрогнозныеСрокиПоВерсииПроект);
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
				"%1.ПроектнаяЗадача = %2.СсылкаНаПроект",
				ИмяИсточника,
				ИмяТаблицыПрогнозныеСрокиПоВерсииПроект);
		Соединение = ОператорПакетаЗапросаИерархия.Источники[0].Соединения.Добавить(ИмяТаблицыПрогнозныеСрокиПоВерсииПроект,
				УсловиеСоединения);
		
		ШаблонВыбранноеПоле = "ВЫБОР
			|	КОГДА %1.ЭтоПроектнаяЗадача
			|		ТОГДА ЕСТЬNULL(%2.ДатаНачалаПрогноз, 0)
			|	ИНАЧЕ ЕСТЬNULL(%3.ДатаНачалаПрогноз, 0)
			|КОНЕЦ";
		ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонВыбранноеПоле,
				ИмяИсточника,
				ИмяТаблицыПрогнозныеСрокиПоВерсии,
				ИмяТаблицыПрогнозныеСрокиПоВерсииПроект);
		ВыбранноеПоле = ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
		ПакетЗапросаИерархияИтоговый.Колонки[ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Количество() - 1].Псевдоним =
			ИмяПоляДатаНачалаПрогнозПоВерсии;
		
		ШаблонВыбранноеПоле = "ВЫБОР
			|	КОГДА %1.ЭтоПроектнаяЗадача
			|		ТОГДА ЕСТЬNULL(%2.ДатаЗавершенияПрогноз, 0)
			|	ИНАЧЕ ЕСТЬNULL(%3.ДатаЗавершенияПрогноз, 0)
			|КОНЕЦ";
		ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонВыбранноеПоле,
				ИмяИсточника,
				ИмяТаблицыПрогнозныеСрокиПоВерсии,
				ИмяТаблицыПрогнозныеСрокиПоВерсииПроект);
		ВыбранноеПоле = ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
		ПакетЗапросаИерархияИтоговый.Колонки[ОператорПакетаЗапросаИерархия.ВыбираемыеПоля.Количество() - 1].Псевдоним =
			ИмяПоляДатаЗавершенияПрогнозПоВерсии;
	КонецЕсли;
	
	ОператорПакетаЗапросаИерархия.ВыраженияОтбораКомпоновкиДанных.Очистить();
	Для Каждого ВыбираемоеПоле Из ОператорПакетаЗапросаИерархия.ВыбираемыеПоля Цикл
		ОператорПакетаЗапросаИерархия.ВыраженияОтбораКомпоновкиДанных.Добавить(ВыбираемоеПоле);
	КонецЦикла;
	
	ПакетЗапросаИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Очистить();
	Для Каждого Колонка Из ПакетЗапросаИерархияИтоговый.Колонки Цикл
		ПакетЗапросаИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(Колонка);
	КонецЦикла;
	
	Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, ФорматПериодаДень());
	
	ДобавитьПолеКомпоновки(НаборИерархия,
		ИмяПоляДатаНачалаПоВерсии,
		ИмяПоляДатаНачалаПоВерсии,
		,
		,
		,
		,
		Оформление,
		СинонимПоляДатыНачалаПоВерсии);
	
	ДобавитьПолеКомпоновки(НаборИерархия,
		ИмяПоляДатаЗавершенияПоВерсии,
		ИмяПоляДатаЗавершенияПоВерсии,
		,
		,
		,
		,
		Оформление,
		СинонимПоляДатыЗавершенияПоВерсии);
	
	Если ИспользуютсяПрогнозныеСроки Тогда
		ДобавитьПолеКомпоновки(НаборИерархия,
			ИмяПоляДатаНачалаПрогнозПоВерсии,
			ИмяПоляДатаНачалаПрогнозПоВерсии,
			,
			,
			,
			,
			Оформление,
			СинонимПоляДатыНачалаПрогнозПоВерсии);
		
		ДобавитьПолеКомпоновки(НаборИерархия,
			ИмяПоляДатаЗавершенияПрогнозПоВерсии,
			ИмяПоляДатаЗавершенияПрогнозПоВерсии,
			,
			,
			,
			,
			Оформление,
			СинонимПоляДатыЗавершенияПрогнозПоВерсии);
	КонецЕсли;
	
	ТекстЗапросаСДобавленнымиСрокамиПоВерсииИерархия = СхемаЗапросаНаборДанныхИерархия.ПолучитьТекстЗапроса();
	НаборИерархия.Запрос = ТекстЗапросаСДобавленнымиСрокамиПоВерсииИерархия;
	
КонецПроцедуры

Процедура ДополнитьСКДСрокиФактПЗ(СКД, ТипВерсии, ОсновнойНаборДанных, СтруктураНастроек, 
	ПроверятьИспользованиеПолей, КомпоновщикНастроек, ОтборПоСценарию = Ложь)
	
	Если ПроверятьИспользованиеПолей Тогда
		Если КомпоновщикНастроек = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		Если Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ДатаНачалаФакт")
			И Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ДатаЗавершенияФакт") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	ОсновнойНабор = СКД.НаборыДанных.Найти(ОсновнойНаборДанных);
	ТекстЗапроса = ОсновнойНабор.Запрос;
	
	// Добавим фактические сроки в основной набор.
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	Оператор = ПакетЗапросов.Операторы[0];
	
	// Фактические сроки.
	ИсточникСрокиФактПЗ = Оператор.Источники.Добавить(
		"РегистрСведений.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.СрезПоследних", 
		"СрокиФактПЗ");
	ИсточникСрокиФактПЗ.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникСрокиФактПЗ.Источник.Параметры[1].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1 = СрокиФактПЗ.ПроектнаяЗадача", 
		СтруктураНастроек.ИмяПоляПЗДляСвязиСОсновнымНабором);
	Соединение = Оператор.Источники[0].Соединения.Добавить("СрокиФактПЗ", УсловиеСоединения);
	Оператор.Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
   	ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("СрокиФактПЗ.ДатаНачала");
	ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ДатаНачалаФакт";
	ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("СрокиФактПЗ.ДатаЗавершения");
	ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ДатаЗавершенияФакт";
	
	// Версии.
	ИсточникВерсияСрокиФактПЗ = Оператор.Источники.Добавить(
		"РегистрСведений.упоВерсииПроекта", 
		"упоВерсииПроектаСрокиФактПЗ");
	ИсточникВерсияСрокиФактПЗ.Соединения.Очистить();
	ТекстУсловия = "СрокиФактПЗ.Версия = упоВерсииПроектаСрокиФактПЗ.Версия И (упоВерсииПроектаСрокиФактПЗ.%1)";

	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);	
	КонецЕсли;

	ДобавитьВнутреннееСоединениеВИсточник(ИсточникСрокиФактПЗ, "упоВерсииПроектаСрокиФактПЗ", УсловиеСоединения);
		
	Если Не ОсновнойНабор.АвтоЗаполнениеДоступныхПолей Тогда
		ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ДатаНачалаФакт");
		ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ДатаЗавершенияФакт");
	КонецЕсли;
	
	ТекстЗапросаСрокиФакт = СхемаЗапроса.ПолучитьТекстЗапроса();

	ОсновнойНабор.Запрос = ТекстЗапросаСрокиФакт;
	
	Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, ФорматПериодаДень());
	
	ДобавитьПолеКомпоновки(ОсновнойНабор, 
							"ДатаНачалаФакт", 
							"ДатаНачалаФакт", 
							, 
							, 
							, 
							, 
							Оформление);
							
	ДобавитьПолеКомпоновки(ОсновнойНабор, 
							"ДатаЗавершенияФакт", 
							"ДатаЗавершенияФакт",
							, 
							, 
							, 
							, 
							Оформление);
	
	Группировки = Новый Массив;
	Группировки.Добавить("ПроектнаяЗадача");
	Группировки.Добавить("ПроектнаяЗадача Иерархия");
	ДобавитьПолеРесурса(СКД, "ДатаНачалаФакт", "ДатаНачалаФакт", Группировки);
	ДобавитьПолеРесурса(СКД, "ДатаЗавершенияФакт", "ДатаЗавершенияФакт", Группировки);
	
	// Добавим фактические сроки в иерархию.
	НаборИерархия = СКД.НаборыДанных.Найти("Иерархия");
	ТекстЗапроса = НаборИерархия.Запрос;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	// Поместим данные иерархии во временную таблицу, если не помещены.
	ПакетИерархия = СхемаЗапроса.ПакетЗапросов[1];
	ИмяИсточника = "ВТ_Иерархия";
	Если ПакетИерархия.ТаблицаДляПомещения = "" Тогда
		ПакетИерархия.ТаблицаДляПомещения = ИмяИсточника;
		ПакетЗапросовИерархияИтоговый = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		ОператорИерархияИтоговый = ПакетЗапросовИерархияИтоговый.Операторы[0];
		ОператорИерархияИтоговый.Источники.Добавить(ИмяИсточника, ИмяИсточника);
		Для Каждого Колонка Из ПакетИерархия.Колонки Цикл
			ИмяПоля = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", 
						ИмяИсточника, 
						Колонка.Псевдоним);
			ВыбранноеПоле = ОператорИерархияИтоговый.ВыбираемыеПоля.Добавить(ИмяПоля);
		КонецЦикла;	
	Иначе
		ПакетЗапросовИерархияИтоговый = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	КонецЕсли;
	
	// Фактические сроки по проекту рассчитываем в отдельной временной таблице.
	ПакетСрокиФактПроекта = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
	СхемаЗапроса.ПакетЗапросов.Сдвинуть(ПакетСрокиФактПроекта, -1);
	ТекстЗапросаСрокиФактПроекта = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                               |	упоВерсииПроекта.Проект КАК СсылкаНаПроект,
	                               |	МИНИМУМ(ВЫБОР
	                               |			КОГДА упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	                               |				ТОГДА ДАТАВРЕМЯ(3000, 1, 1)
	                               |			ИНАЧЕ упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ДатаНачала
	                               |		КОНЕЦ) КАК ДатаНачалаФакт,
	                               |	МАКСИМУМ(ВЫБОР
	                               |			КОГДА упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1)
	                               |				ТОГДА ДАТАВРЕМЯ(3000, 1, 1)
	                               |			ИНАЧЕ упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ДатаЗавершения
	                               |		КОНЕЦ) КАК ДатаЗавершенияФакт
	                               |ИЗ
	                               |	РегистрСведений.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних
	                               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК упоСвойстваПроектныхЗадачСрезПоследних
	                               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	                               |			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	                               |				
	                               |		ПО упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
	                               |			И упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	                               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	                               |{ГДЕ
	                               |	упоВерсииПроекта.Проект.* КАК СсылкаНаПроект}
	                               |
	                               |СГРУППИРОВАТЬ ПО
	                               |	упоВерсииПроекта.Проект";
	                           
	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		ТекстЗапросаСрокиФактПроекта = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапросаСрокиФактПроекта, УсловиеОтбора);	
	Иначе	
		ТекстЗапросаСрокиФактПроекта = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапросаСрокиФактПроекта, ТипВерсии);	
	КонецЕсли;
	
	ПакетСрокиФактПроекта.УстановитьТекстЗапроса(ТекстЗапросаСрокиФактПроекта);
	ПакетСрокиФактПроекта.ТаблицаДляПомещения = "ВТ_СрокиФактПроекта";
	
	// Фактические сроки ПЗ.
	Оператор = ПакетЗапросовИерархияИтоговый.Операторы[0];
	
	ИсточникСрокиФактПЗИерархия = Оператор.Источники.Добавить(
		"РегистрСведений.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.СрезПоследних", 
		"СрокиФактПЗ");
	ИсточникСрокиФактПЗИерархия.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникСрокиФактПЗИерархия.Источник.Параметры[1].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.СсылкаНаПроектнуюЗадачу = СрокиФактПЗ.ПроектнаяЗадача", 
		ИмяИсточника);
	Соединение = Оператор.Источники[0].Соединения.Добавить("СрокиФактПЗ", УсловиеСоединения);
	Оператор.Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
	
	// Версии ПЗ.
	ИсточникВерсияСрокиФактПЗ = Оператор.Источники.Добавить("РегистрСведений.упоВерсииПроекта", 
															"упоВерсииПроектаСрокиФактПЗ");
	ТекстУсловия = "СрокиФактПЗ.Версия = упоВерсииПроектаСрокиФактПЗ.Версия И (упоВерсииПроектаСрокиФактПЗ.%1)";

	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);
	КонецЕсли;
	
	ДобавитьВнутреннееСоединениеВИсточник(ИсточникСрокиФактПЗИерархия, "упоВерсииПроектаСрокиФактПЗ", УсловиеСоединения); 
	
	// Фактические сроки проекта.
	ИсточникСрокиФактПроектИерархия = Оператор.Источники.Добавить(
		"ВТ_СрокиФактПроекта", 
		"ВТ_СрокиФактПроекта");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.ПроектнаяЗадача = ВТ_СрокиФактПроекта.СсылкаНаПроект", 
		ИмяИсточника);
	Соединение = Оператор.Источники[0].Соединения.Добавить("ВТ_СрокиФактПроекта", УсловиеСоединения);
	Оператор.Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
	
	ШаблонВыбранноеПоле = "ВЫБОР
							|	КОГДА %1.ЭтоПроектнаяЗадача
							|		ТОГДА ЕСТЬNULL(СрокиФактПЗ.ДатаНачала, 0)
							|	ИНАЧЕ ЕСТЬNULL(ВЫБОР
							|						КОГДА ВТ_СрокиФактПроекта.ДатаНачалаФакт = ДАТАВРЕМЯ(3000, 1, 1)
							|							ТОГДА ДАТАВРЕМЯ(1, 1, 1)
							|						ИНАЧЕ ВТ_СрокиФактПроекта.ДатаНачалаФакт
							|					КОНЕЦ, 0)
							|КОНЕЦ";
	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
							ШаблонВыбранноеПоле,
							ИмяИсточника,
							"ДатаНачалаФакт");
	ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
		"ДатаНачалаФакт";
	
	ШаблонВыбранноеПоле = "ВЫБОР
							|	КОГДА %1.ЭтоПроектнаяЗадача
							|		ТОГДА ЕСТЬNULL(СрокиФактПЗ.ДатаЗавершения, 0)
							|	ИНАЧЕ ЕСТЬNULL(ВЫБОР
							|						КОГДА ВТ_СрокиФактПроекта.ДатаЗавершенияФакт = ДАТАВРЕМЯ(3000, 1, 1)
							|							ТОГДА ДАТАВРЕМЯ(1, 1, 1)
							|						ИНАЧЕ ВТ_СрокиФактПроекта.ДатаЗавершенияФакт
							|					КОНЕЦ, 0)
							|КОНЕЦ";
	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
							ШаблонВыбранноеПоле,
							ИмяИсточника,
							"ДатаЗавершенияФакт");
	ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
		"ДатаЗавершенияФакт";     
	
	Оператор.ВыраженияОтбораКомпоновкиДанных.Очистить();
	Для каждого ВыбираемоеПоле Из Оператор.ВыбираемыеПоля Цикл
		Оператор.ВыраженияОтбораКомпоновкиДанных.Добавить(ВыбираемоеПоле);
	КонецЦикла;
	
	ПакетЗапросовИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Очистить();
	Для каждого Колонка Из ПакетЗапросовИерархияИтоговый.Колонки Цикл
		ПакетЗапросовИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(Колонка);
	КонецЦикла;	
	
	ДобавитьПолеКомпоновки(НаборИерархия, 
							"ДатаНачалаФакт", 
							"ДатаНачалаФакт", 
							,
							,
							,
							,
							Оформление);
							
	ДобавитьПолеКомпоновки(НаборИерархия, 
							"ДатаЗавершенияФакт", 
							"ДатаЗавершенияФакт", 
							,
							,
							,
							,
							Оформление);
	
	ТекстЗапросаСрокиФактИерархия = СхемаЗапроса.ПолучитьТекстЗапроса();
	НаборИерархия.Запрос = ТекстЗапросаСрокиФактИерархия;
	
КонецПроцедуры

Процедура ДобавитьНаборДанныхСрокиПроекта(СКД, ОсновнойНаборДанных, ТипВерсии, ОтборПоСценарию, СтруктураНастроек)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                   |    упоВерсииПроекта.Проект КАК Проект,
                   |    МИНИМУМ(упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан) КАК ДатаНачалаПроект,
                   |    МАКСИМУМ(упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан) КАК ДатаЗавершенияПроект
                   |ПОМЕСТИТЬ ВТ_СрокиПроекта
                   |{ВЫБРАТЬ
                   |    Проект.*}
                   |ИЗ
                   |    РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК упоСрокиПроектныхЗадачСрезПоследних
                   |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК упоСвойстваПроектныхЗадачСрезПоследних
                   |            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
                   |            ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
                   |                И (упоВерсииПроекта.%1)
                   |        ПО упоСрокиПроектныхЗадачСрезПоследних.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
                   |            И упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
                   |            И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
                   |{ГДЕ
                   |    упоВерсииПроекта.Проект.* КАК Проект}
                   |
                   |СГРУППИРОВАТЬ ПО
                   |    упоВерсииПроекта.Проект
                   |;
                   |  
				   | //#ТекстЗапроса_ПрогнозныеСроки#
                   |
                   |////////////////////////////////////////////////////////////////////////////////
                   |ВЫБРАТЬ
                   |    ВТ_СрокиПроекта.Проект КАК Проект,
                   |    ВТ_СрокиПроекта.ДатаНачалаПроект КАК ДатаНачалаПроект,
                   |    ВТ_СрокиПроекта.ДатаЗавершенияПроект КАК ДатаЗавершенияПроект
                   |    //#Поля_ПрогнозныеСроки#
                   |ИЗ
                   |    ВТ_СрокиПроекта КАК ВТ_СрокиПроекта
                   |        //#Соединение_ПрогнозныеСроки#";

	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//#ТекстЗапроса_ПрогнозныеСроки#",
			"////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|    ВерсииПроекта.Проект КАК Проект,
			|    МИНИМУМ(ПрогнозныеСроки.ДатаНачалаПрогноз) КАК ДатаНачалаПрогноз,
			|    МАКСИМУМ(ПрогнозныеСроки.ДатаЗавершенияПрогноз) КАК ДатаЗавершенияПрогноз
			|ПОМЕСТИТЬ ВТ_ПрогнозныеСрокиПроекта
			|ИЗ
			|    РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК ПрогнозныеСроки
			|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК СвойстваПроектныхЗадач
			|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
			|            ПО СвойстваПроектныхЗадач.Версия = ВерсииПроекта.Версия
			|               И (ВерсииПроекта.%1)
			|        ПО ПрогнозныеСроки.Версия = СвойстваПроектныхЗадач.Версия
			|            И ПрогнозныеСроки.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
			|            И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)
			|ГДЕ
			|    (ПрогнозныеСроки.ДатаНачалаПрогноз <> ДАТАВРЕМЯ(1, 1, 1)
			|            ИЛИ ПрогнозныеСроки.ДатаЗавершенияПрогноз <> ДАТАВРЕМЯ(1, 1, 1))
			|
			|СГРУППИРОВАТЬ ПО
			|    ВерсииПроекта.Проект
			|; ");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//#Поля_ПрогнозныеСроки#",  
			"    , ВТ_ПрогнозныеСрокиПроекта.ДатаНачалаПрогноз КАК ДатаНачалаПрогнозПроект
	        |    , ВТ_ПрогнозныеСрокиПроекта.ДатаЗавершенияПрогноз КАК ДатаЗавершенияПрогнозПроект"); 
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//#Соединение_ПрогнозныеСроки#",  
			"        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПрогнозныеСрокиПроекта КАК ВТ_ПрогнозныеСрокиПроекта
            |        ПО ВТ_СрокиПроекта.Проект = ВТ_ПрогнозныеСрокиПроекта.Проект");
		
	КонецЕсли;
	
	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		ТекстЗапроса = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, УсловиеОтбора);
	Иначе	
		ТекстЗапроса = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, ТипВерсии);
	КонецЕсли;
	
	НаборДанныхСрокиПроектов = ДобавитьНаборДанных(СКД, "СрокиПроектов", "ИсточникДанных1", ТекстЗапроса);
	
	Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, ФорматПериодаДень());
	ОграничениеИспользования = НовоеОграничениеИспользованияПоля();
	ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов, "Проект", "Проект",
		Истина,
		Истина,
		Истина,
		Истина);
	ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов, "ДатаНачалаПроект", "ДатаНачалаПроект",
		,
		,
		,
		,
		Оформление, "Дата начала (проект)",
		,
		,
		ОграничениеИспользования);
	ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов, "ДатаЗавершенияПроект", "ДатаЗавершенияПроект",
		,
		,
		,
		,
		Оформление, "Дата завершения (проект)",
		,
		,
		ОграничениеИспользования);
		
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
			
		ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов, "ДатаНачалаПрогнозПроект", "ДатаНачалаПрогнозПроект",
			,
			,
			,
			,
			Оформление, "Дата начала, прогноз (проект)",
			,
			,
			ОграничениеИспользования);
		ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов, "ДатаЗавершенияПрогнозПроект", "ДатаЗавершенияПрогнозПроект",
			,
			,
			,
			,
			Оформление, "Дата завершения, прогноз (проект)",
			,
			,
			ОграничениеИспользования);   
			
	КонецЕсли;
	
	Группировки = Новый Массив;
	Группировки.Добавить("Проект");
	ДобавитьПолеРесурса(СКД, "ДатаНачалаПроект", "ДатаНачала", Группировки);
	ДобавитьПолеРесурса(СКД, "ДатаЗавершенияПроект", "ДатаЗавершения", Группировки);
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		ДобавитьПолеРесурса(СКД, "ДатаНачалаПрогнозПроект", "ДатаНачалаПрогноз", Группировки);
		ДобавитьПолеРесурса(СКД, "ДатаЗавершенияПрогнозПроект", "ДатаЗавершенияПрогноз", Группировки);
	КонецЕсли;
	
	ДобавитьСвязьНаборовДанных(СКД, ОсновнойНаборДанных, "СрокиПроектов", СтруктураНастроек.ИмяПоляПроект, "Проект");
	
КонецПроцедуры

Процедура ДобавитьНаборДанныхСрокиПроектаПоВерсии(СКД, ОсновнойНаборДанных, КоличествоВерсий, СтруктураНастроек)
	
	ИспользуютсяПрогнозныеСроки = упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков();
	
	Для НомерВерсии = 1 По КоличествоВерсий Цикл
		ИмяПоляДатаНачалаПоВерсии = "ДатаНачалаПоВерсии" + НомерВерсии;
		ИмяПоляДатаЗавершенияПоВерсии = "ДатаЗавершенияПоВерсии" + НомерВерсии;
		
		ИмяПоляДатаНачалаПрогнозПоВерсии = "ДатаНачалаПрогнозПоВерсии" + НомерВерсии;
		ИмяПоляДатаЗавершенияПрогнозПоВерсии = "ДатаЗавершенияПрогнозПоВерсии" + НомерВерсии;
		
		ИмяПоляДатаНачалаПроектаПоВерсии = "ДатаНачалаПоВерсииПроект" + НомерВерсии;
		ИмяПоляДатаЗавершенияПроектаПоВерсии = "ДатаЗавершенияПоВерсииПроект" + НомерВерсии;
		
		ИмяПоляДатаНачалаПроектаПрогнозПоВерсии = "ДатаНачалаПрогнозПоВерсииПроект" + НомерВерсии;
		ИмяПоляДатаЗавершенияПроектаПрогнозПоВерсии = "ДатаЗавершенияПрогнозПоВерсииПроект" + НомерВерсии;
		
		ТекстЗапросаСроковПроектовПоВерсии = ТекстЗапросаСроковПроектовПоВерсии();
		ТекстЗапросаСроковПроектовПоВерсии = СтрЗаменить(ТекстЗапросаСроковПроектовПоВерсии, "_Номер", НомерВерсии);
		
		НаборДанныхСрокиПроектов = ДобавитьНаборДанных(СКД, "СрокиПроектовПоВерсии" + НомерВерсии, "ИсточникДанных1",
			ТекстЗапросаСроковПроектовПоВерсии);
		
		Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, ФорматПериодаДень());
		ОграничениеИспользования = НовоеОграничениеИспользованияПоля();
		ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов, "Проект", "Проект",
			Истина,
			Истина,
			Истина,
			Истина);
		ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов,
			ИмяПоляДатаНачалаПроектаПоВерсии, ИмяПоляДатаНачалаПроектаПоВерсии,
			,
			,
			,
			,
			Оформление, СтрШаблон("Дата начала по версии %1 (проект)", НомерВерсии),
			,
			,
			ОграничениеИспользования);
		ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов,
			ИмяПоляДатаЗавершенияПроектаПоВерсии, ИмяПоляДатаЗавершенияПроектаПоВерсии,
			,
			,
			,
			,
			Оформление, СтрШаблон("Дата завершения по версии %1 (проект)", НомерВерсии),
			,
			,
			ОграничениеИспользования);
		
		Если ИспользуютсяПрогнозныеСроки Тогда
			
			ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов,
				ИмяПоляДатаНачалаПроектаПрогнозПоВерсии, ИмяПоляДатаНачалаПроектаПрогнозПоВерсии,
				,
				,
				,
				,
				Оформление, СтрШаблон("Дата начала, прогноз, по версии %1 (проект)", НомерВерсии),
				,
				,
				ОграничениеИспользования);
			ДобавитьПолеКомпоновки(НаборДанныхСрокиПроектов,
				ИмяПоляДатаЗавершенияПроектаПрогнозПоВерсии, ИмяПоляДатаЗавершенияПроектаПрогнозПоВерсии,
				,
				,
				,
				,
				Оформление, СтрШаблон("Дата завершения, прогноз, по версии %1 (проект)", НомерВерсии),
				,
				,
				ОграничениеИспользования);
			
		КонецЕсли;
		
		Группировки = Новый Массив;
		Группировки.Добавить(СтруктураНастроек.ИмяПоляПроект);
		ДобавитьПолеРесурса(СКД, ИмяПоляДатаНачалаПроектаПоВерсии, ИмяПоляДатаНачалаПоВерсии, Группировки);
		ДобавитьПолеРесурса(СКД, ИмяПоляДатаЗавершенияПроектаПоВерсии, ИмяПоляДатаЗавершенияПоВерсии, Группировки);
		
		Если ИспользуютсяПрогнозныеСроки Тогда
			ДобавитьПолеРесурса(СКД, ИмяПоляДатаНачалаПроектаПрогнозПоВерсии, ИмяПоляДатаНачалаПрогнозПоВерсии, Группировки);
			ДобавитьПолеРесурса(СКД, ИмяПоляДатаЗавершенияПроектаПрогнозПоВерсии, ИмяПоляДатаЗавершенияПрогнозПоВерсии, Группировки);
		КонецЕсли;
		
		ДобавитьСвязьНаборовДанных(СКД, ОсновнойНаборДанных, "СрокиПроектовПоВерсии" + НомерВерсии, СтруктураНастроек.ИмяПоляПроект, "Проект");
	КонецЦикла;
	
КонецПроцедуры

Функция ПолеИспользуетсяВОтчете(Настройки, ИмяИскомоеПоле, МассивПользовательскихПолей = Неопределено)
	
	ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяИскомоеПоле);
	Если МассивПользовательскихПолей = Неопределено Тогда
		МассивПользовательскихПолей = Новый Массив;
	КонецЕсли;	
	
	// выбранные поля
	Если ПолеИспользуетсяВВыбранныхПолях(Настройки.Выбор, ИскомоеПоле, МассивПользовательскихПолей) Тогда
		Возврат Истина;
	КонецЕсли;	
	
	// отбор
	Если ПолеИспользуетсяВОтборе(Настройки.Отбор, ИскомоеПоле, МассивПользовательскихПолей) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// оформление
	Если ПолеИспользуетсяВУсловномОформлении(Настройки.УсловноеОформление, ИскомоеПоле, МассивПользовательскихПолей) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// сортировка
	Если ПолеИспользуетсяВСортировке(Настройки.Порядок, ИскомоеПоле, МассивПользовательскихПолей) Тогда
		Возврат Истина;
	КонецЕсли;
	
	// группировка
	Если ПолеИспользуетсяВСтруктуре(Настройки.Структура, ИскомоеПоле, МассивПользовательскихПолей) Тогда
		Возврат Истина;
	КонецЕсли;	
	
	// пользовательские поля
	Если МассивПользовательскихПолей.Количество() > 0 Тогда
		Если ПолеИспользуетсяВПользовательскихПолях(Настройки.ПользовательскиеПоля.Элементы, 
				ИскомоеПоле, ИмяИскомоеПоле, МассивПользовательскихПолей) Тогда
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Ложь;
	
КонецФункции

Функция ПолеИспользуетсяВВыбранныхПолях(ПоляВыбора, ИскомоеПоле, МассивПользовательскихПолей)
	
	Для каждого ПолеВыбора Из ПоляВыбора.Элементы Цикл
		Если Не ПолеВыбора.Использование Тогда
			Продолжить;
		КонецЕсли;	
		Если ТипЗнч(ПолеВыбора) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
			Если ПолеВыбора.Поле = ИскомоеПоле Тогда
				Возврат Истина;
			КонецЕсли;
			ПолеПутьКДанным = Строка(ПолеВыбора.Поле);
			Если СтрНайти(ПолеПутьКДанным, "ПользовательскиеПоля.") <> 0 
				И МассивПользовательскихПолей.Найти(ПолеПутьКДанным) = Неопределено Тогда
				МассивПользовательскихПолей.Добавить(ПолеПутьКДанным);
			КонецЕсли;	
		ИначеЕсли ТипЗнч(ПолеВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			Если ПолеИспользуетсяВВыбранныхПолях(ПолеВыбора, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Ложь; 
	
КонецФункции

Функция ПолеИспользуетсяВОтборе(ПоляОтбора, ИскомоеПоле, МассивПользовательскихПолей)
	
	Для каждого ПолеОтбор Из ПоляОтбора.Элементы Цикл
		Если Не ПолеОтбор.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ПолеОтбор) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда 
			Если ПолеОтбор.ЛевоеЗначение = ИскомоеПоле Тогда
				Возврат Истина;
			Иначе	
				ПолеПутьКДанным = Строка(ПолеОтбор.ЛевоеЗначение);
				Если СтрНайти(ПолеПутьКДанным, "ПользовательскиеПоля.") <> 0 
					И МассивПользовательскихПолей.Найти(ПолеПутьКДанным) = Неопределено Тогда
					МассивПользовательскихПолей.Добавить(ПолеПутьКДанным);
				КонецЕсли;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(ПолеОтбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Если ПолеИспользуетсяВОтборе(ПолеОтбор, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолеИспользуетсяВУсловномОформлении(ПоляУсловногоОформления, ИскомоеПоле, МассивПользовательскихПолей)
	
	Для каждого ПолеУО Из ПоляУсловногоОформления.Элементы Цикл
		Если Не ПолеУО.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеИспользуетсяВОтборе(ПолеУО.Отбор, ИскомоеПоле, МассивПользовательскихПолей) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолеИспользуетсяВСортировке(ПоляПорядка, ИскомоеПоле, МассивПользовательскихПолей)
	
	Для каждого ПолеПорядка Из ПоляПорядка.Элементы Цикл
		Если Не ПолеПорядка.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ПолеПорядка.Поле = ИскомоеПоле Тогда
			Возврат Истина;
		КонецЕсли;	
		ПолеПутьКДанным = Строка(ПолеПорядка.Поле);
		Если СтрНайти(ПолеПутьКДанным, "ПользовательскиеПоля.") <> 0 
			И МассивПользовательскихПолей.Найти(ПолеПутьКДанным) = Неопределено Тогда
			МассивПользовательскихПолей.Добавить(ПолеПутьКДанным);
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолеИспользуетсяВСтруктуре(ЭлементыСтруктуры, ИскомоеПоле, МассивПользовательскихПолей)
	
	Для каждого ЭлементСтруктуры Из ЭлементыСтруктуры Цикл
		
		Если Не ЭлементСтруктуры.Использование Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") 
			Или ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаТаблицыКомпоновкиДанных") 
			Или ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаДиаграммыКомпоновкиДанных") Тогда
			
			Для Каждого ПолеГруппировки Из ЭлементСтруктуры.ПоляГруппировки.Элементы Цикл
				Если Не ПолеГруппировки.Использование Тогда
					Продолжить;
				КонецЕсли;
				Если ПолеГруппировки.Поле = ИскомоеПоле Тогда
					Возврат Истина;
				КонецЕсли;
				ПолеПутьКДанным = Строка(ПолеГруппировки.Поле);
				Если СтрНайти(ПолеПутьКДанным, "ПользовательскиеПоля.") <> 0 
					И МассивПользовательскихПолей.Найти(ПолеПутьКДанным) = Неопределено Тогда
					МассивПользовательскихПолей.Добавить(ПолеПутьКДанным);
				КонецЕсли;	
			КонецЦикла;
			
			Если ПолеИспользуетсяВСтруктуре(ЭлементСтруктуры.Структура, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
			
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			
			Если ПолеИспользуетсяВСтруктуре(ЭлементСтруктуры.Строки, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
			Если ПолеИспользуетсяВСтруктуре(ЭлементСтруктуры.Колонки, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
			
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ДиаграммаКомпоновкиДанных") Тогда
			
			Если ПолеИспользуетсяВСтруктуре(ЭлементСтруктуры.Серии, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
			Если ПолеИспользуетсяВСтруктуре(ЭлементСтруктуры.Точки, ИскомоеПоле, МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
			
			Если ПолеИспользуетсяВОтчете(ЭлементСтруктуры.Настройки, Строка(ИскомоеПоле), МассивПользовательскихПолей) Тогда
				Возврат Истина;
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции	

Функция ПолеИспользуетсяВПользовательскихПолях(ПользовательскиеПоля, ИскомоеПоле, ИмяИскомоеПоле, МассивПользовательскихПолей)
	
	Для Каждого ПользовательскоеПоле Из ПользовательскиеПоля Цикл
		Если МассивПользовательскихПолей.Найти(ПользовательскоеПоле.ПутьКДанным) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ПользовательскоеПоле) = Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных") Тогда
			ТекстВыраженияДетальныхЗаписей = ПользовательскоеПоле.ПолучитьВыражениеДетальныхЗаписей();
			Если СтрНайти(ТекстВыраженияДетальныхЗаписей, ИмяИскомоеПоле) > 0 Тогда 
				Возврат Истина;
			КонецЕсли;	
			ТекстВыраженияИтоговыхЗаписей = ПользовательскоеПоле.ПолучитьВыражениеИтоговыхЗаписей();
			Если СтрНайти(ТекстВыраженияИтоговыхЗаписей, ИмяИскомоеПоле) > 0 Тогда 
				Возврат Истина;
			КонецЕсли;	
		Иначе 	
			Для Каждого ЭлементПользовательскоеПоле Из ПользовательскоеПоле.Варианты.Элементы Цикл
				Если Не ЭлементПользовательскоеПоле.Использование Тогда
					Продолжить;
				КонецЕсли;
				Если ПолеИспользуетсяВОтборе(ЭлементПользовательскоеПоле.Отбор, ИскомоеПоле, Новый Массив) Тогда
					Возврат Истина;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

Функция ПолучитьПредставлениеПроектнойЗадачиНеЯвляетсяЗадачейВыбранныхВерсий()
	
	Возврат НСтр("ru = '(В выбранной версии проекта задача отсутствует)'");
	
КонецФункции

Процедура ОбработатьЗаголовкиПолейСВерсиями(СтруктураНастроек, ОсновнаяСхемаКомпоновкиДанных, Настройки)
    
    СтруктураПараметров = Новый Структура();
    Для каждого Элемент Из Настройки.ПараметрыДанных.Элементы Цикл
        
        ИмяПараметра = Строка(Элемент.Параметр);
        ЗначениеПараметра = Элемент.Значение;
        
        Если (ИмяПараметра = "Версия1" ИЛИ ИмяПараметра = "Версия2") 
            И ЗначениеЗаполнено(ЗначениеПараметра)
            И (ТипЗнч(ЗначениеПараметра) = Тип("ДокументСсылка.упоВерсияПланаПроекта") 
                ИЛИ ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.упоСценарии")) Тогда
            СтруктураПараметров.Вставить(ИмяПараметра, ЗначениеПараметра);   	        
        КонецЕсли;
        
    КонецЦикла; 

    КоличествоУказанныхВерсий = СтруктураПараметров.Количество(); 
    
    Если КоличествоУказанныхВерсий = 0 Тогда
        Возврат;	
    КонецЕсли;
    
    Для Версия = 1 По КоличествоУказанныхВерсий Цикл
        ВерсияСсылка = СтруктураПараметров["Версия" + Версия]; 
        НаименованиеВерсии = ?(ТипЗнч(ВерсияСсылка) = Тип("ДокументСсылка.упоВерсияПланаПроекта"),
            упоВерсионирование.ПолучитьНаименованиеВерсии(ВерсияСсылка), ВерсияСсылка.Наименование);
        СтруктураПараметров.Вставить("НаименованиеВерсии" + Версия, НаименованиеВерсии);   	        
    КонецЦикла;
           
    ОбработатьЗаголовкиПолейГруппировокРекурсивно(
        Настройки.Выбор.Элементы, СтруктураПараметров);
        
    ОсновнойНаборДанных = Неопределено;
    ИмяНабораДанных = Неопределено;
    Если СтруктураНастроек.Свойство("ИмяНабораДанных", ИмяНабораДанных) Тогда
        ОсновнойНаборДанных = ОсновнаяСхемаКомпоновкиДанных.НаборыДанных.Найти(ИмяНабораДанных);
    КонецЕсли;
    
    Если ОсновнойНаборДанных <> Неопределено Тогда
        ОбработатьЗаголовкиКоллекцииПолей(СтруктураНастроек, 
            ОсновнойНаборДанных.Поля, СтруктураПараметров);    
    КонецЕсли;
        
    ОбработатьЗаголовкиКоллекцииПолей(СтруктураНастроек, 
        ОсновнаяСхемаКомпоновкиДанных.ВычисляемыеПоля, СтруктураПараметров);
        
    СрокиПоВерсиям = Неопределено;
    СтруктураНастроек.Свойство("СрокиПоВерсиям", СрокиПоВерсиям); 
    СрокиПоВерсиям = ?(СрокиПоВерсиям = Неопределено, 0, СрокиПоВерсиям);
    Если СрокиПоВерсиям <> 0 Тогда
        Для Версия = 1 По СрокиПоВерсиям Цикл
            ИмяНабораДанных = "СрокиПоВерсии" + Версия;
            
            ОбработатьЗаголовкиКоллекцииПолей(СтруктураНастроек, 
                ОсновнаяСхемаКомпоновкиДанных.НаборыДанных[ИмяНабораДанных].Поля, СтруктураПараметров);
        КонецЦикла;
    КонецЕсли;        
            
КонецПроцедуры

Процедура ВыполнитьЗаменуТекста(Поле, Параметры)
    
    ЗаголовокПоля = Поле.Заголовок;
         
    Если Параметры.Свойство("Версия1") И СтрНайти(ЗаголовокПоля, НСтр("ru = 'по версии 1'")) Тогда
        ЗаголовокПоля = СтрЗаменить(ЗаголовокПоля, "по версии 1", "(%1)");	
        Поле.Заголовок = СтрШаблон(ЗаголовокПоля, Параметры.НаименованиеВерсии1);
    ИначеЕсли Параметры.Свойство("Версия2") И СтрНайти(ЗаголовокПоля, НСтр("ru = 'по версии 2'")) Тогда 
        ЗаголовокПоля = СтрЗаменить(ЗаголовокПоля, "по версии 2", "(%1)");	
        Поле.Заголовок = СтрШаблон(ЗаголовокПоля, Параметры.НаименованиеВерсии2);
    КонецЕсли;

КонецПроцедуры

Процедура ОбработатьЗаголовкиКоллекцииПолей(СтруктураНастроек, КоллекцияПолей, Параметры)

    ПоляСВерсиями = Неопределено;
    
    Если Не СтруктураНастроек.Свойство("ПоляСВерсиями", ПоляСВерсиями) Тогда
        Возврат;	
    КонецЕсли; 
            
    Для каждого НаименованиеПоля Из ПоляСВерсиями Цикл
    
        Поле = КоллекцияПолей.Найти(НаименованиеПоля);
        
        Если Поле = Неопределено Тогда
            Продолжить;	
        КонецЕсли;
        
        ВыполнитьЗаменуТекста(Поле, Параметры);
        
    КонецЦикла;

КонецПроцедуры

Процедура ОбработатьЗаголовкиПолейГруппировокРекурсивно(КоллекцияГруппВыбранныхПолей, Параметры)
    
    Для каждого Группа Из КоллекцияГруппВыбранныхПолей Цикл
        
        Если ТипЗнч(Группа) <> Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
            Продолжить;	
        КонецЕсли;
        
        Если Группа.Элементы.Количество() Тогда
            ОбработатьЗаголовкиПолейГруппировокРекурсивно(Группа.Элементы, Параметры);    	
        КонецЕсли;
        
        ВыполнитьЗаменуТекста(Группа, Параметры);
        
    КонецЦикла;

КонецПроцедуры

