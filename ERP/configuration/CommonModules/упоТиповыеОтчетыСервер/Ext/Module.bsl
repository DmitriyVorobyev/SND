////////////////////////////////////////////////////////////////////////////////
// Процедуры и функции работы с типовыми отчетами.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик события После компоновки результата.
//
// Параметры:
//  ОтчетОбъект			 - ОтчетОбъект 							- отчет, для которого вызывается обработчик.
//  ДокументРезультат	 - Произвольный 						- не используется.
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных 	- компоновщик настроек.
//  ДанныеРасшифровки	 - ДанныеРасшифровкиКомпоновкиДанных 	- содержит данные расшифровки.
//
Процедура ПослеКомпоновкиРезультата(ОтчетОбъект, ДокументРезультат, КомпоновщикНастроек, ДанныеРасшифровки) Экспорт
	
	ПолноеИмяОтчета = Строка(ОтчетОбъект);
	ТипОтчета = ?(Найти(ПолноеИмяОтчета, "ВнешнийОтчет"), "ВнешнийОтчет", "Отчет");
	
	Если ТипОтчета = "ВнешнийОтчет" И
		КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Свойство("УникальныйИдентификаторФормы") Тогда
		
		КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("АдресДанныхРасшифровки",
			ПоместитьВоВременноеХранилище(ДанныеРасшифровки,
			КомпоновщикНастроек.Настройки.ДополнительныеСвойства.УникальныйИдентификаторФормы));
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события При компоновке результата.
//
// Параметры:
//  ОтчетОбъект			 - ОтчетОбъект 							- отчет, для которого вызывается обработчик.
//  ДокументРезультат	 - ТабличныйДокумент					- документ, в который будет осуществляться вывод.
//  ДанныеРасшифровки	 - ДанныеРасшифровкиКомпоновкиДанных 	- содержит данные расшифровки.
//  СтандартнаяОбработка - Булево 								- признак стандартной обработки.
//  ИмяМакета 			 - Строка 								- имя макета СКД.
//  ВнешниеНаборыДанных - Неопределено, Структура:
//			* Ключ - Строка - имя внешнего набора данных.
//			* Значение - ТаблицаЗначений, ДеревоЗначений - внешний набор данных.
//
Процедура ПриКомпоновкеРезультата(ОтчетОбъект, ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка,
		ИмяМакета = "ОсновнаяСхемаКомпоновкиДанных", ВнешниеНаборыДанных = Неопределено) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ЭтоОбщийМакет = ОтчетОбъект.Метаданные().Макеты.Найти(ИмяМакета) = Неопределено;
	Если ЭтоОбщийМакет Тогда
		ОсновнаяСхемаКомпоновки = ПолучитьОбщийМакет(ИмяМакета);
	Иначе
		ОсновнаяСхемаКомпоновки = ОтчетОбъект.ПолучитьМакет(ИмяМакета);
	КонецЕсли;
	
	// Модифицируем СКД по настройкам объекта отчета.
	СтруктураНастроек = Новый Структура;
	Попытка
		СтруктураНастроек = ОтчетОбъект.ПолучитьНастройкиОтчета();
	Исключение
	КонецПопытки;
	
	Если СтруктураНастроек.Свойство("ДопОбработкаЗапроса") Тогда
		ОтчетОбъект.ДопОбработкаЗапроса(ОсновнаяСхемаКомпоновки,
			ОтчетОбъект.КомпоновщикНастроек.Настройки.ДополнительныеСвойства);
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("НеВыводитьНезаполненныеПоказатели")
		И СтруктураНастроек.Свойство("ИмяНабораДанных") Тогда
		
		УстановитьОтборПоПоказателям(ОтчетОбъект.КомпоновщикНастроек.Настройки, ОсновнаяСхемаКомпоновки,
			СтруктураНастроек.ИмяНабораДанных);
		
	КонецЕсли;
	
	ПрименитьНастройкуТипПлана(СтруктураНастроек, ОсновнаяСхемаКомпоновки, ОтчетОбъект.КомпоновщикНастроек);
	
	упоТиповыеОтчетыСервер.ДобавитьДополнительныеНаборыДанныхСКД(ОсновнаяСхемаКомпоновки, СтруктураНастроек, Истина, ОтчетОбъект.КомпоновщикНастроек);
	
	Настройки = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	
	Если СтруктураНастроек.Свойство("ДопОбработкаНастроекКомпоновщика") Тогда
		ОтчетОбъект.ДопОбработкаНастроекКомпоновщика(Настройки);
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ВыборВерсии") Тогда
		ОбработатьЗаголовкиПолейСВерсиями(СтруктураНастроек, ОсновнаяСхемаКомпоновки, Настройки);
	КонецЕсли;
	
	// Инициализация компоновщика настроек отчета после изменения настроек. Нужно для отображения пользовательских
	// полей из связанных наборов данных.
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	ОтчетОбъект.КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ОсновнаяСхемаКомпоновки));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ОсновнаяСхемаКомпоновки, Настройки, ДанныеРасшифровки);
	
	// Инициализируем процессор СКД.
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
	
	ДокументРезультат.Очистить();
	
	Если СтруктураНастроек.Свойство("ПроверкаОчередиРаспределенияТрудозатрат") Тогда
		упоРаботаСОчередямиВызовСервера.ВывестиВОтчетИнформациюПоОчередиТрудозатрат(ОтчетОбъект, ДокументРезультат);
	КонецЕсли;
	
	// Инициализируем процессор вывода.
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	ПараметрыВывода = ОтчетОбъект.КомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы;
	
	УстановитьФиксациюВТабличномДокументе(ДокументРезультат, ПараметрыВывода);
	
	ПрименитьПерсональныеНастройкиГруппировокОтчета(ДокументРезультат);
	
	// Обработчик события после.
	упоТиповыеОтчетыСервер.ПослеКомпоновкиРезультата(ОтчетОбъект,
		ДокументРезультат, ОтчетОбъект.КомпоновщикНастроек, ДанныеРасшифровки);
	
	ОтчетПустой = ОтчетыСервер.ОтчетПустой(ОтчетОбъект, ПроцессорКомпоновкиДанных);
	ОтчетОбъект.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить(
		"ОтчетПустой", ОтчетПустой);
	
	СнятьОтборПоПоказателям(ОтчетОбъект);
	
КонецПроцедуры

// Применение персональных настроек группировок.
//
// Параметры:
//  ДокументРезультат - ТабличныйДокумент - документ, в который будет осуществляться вывод.
//
Процедура ПрименитьПерсональныеНастройкиГруппировокОтчета(ДокументРезультат) Экспорт
	
	ПерсональныеНастройкиГруппировок = ПолучитьНастройкиГруппировокОтчета(); 
	
	Если ПерсональныеНастройкиГруппировок.УровеньСворачиванияГруппировок Тогда
		
		УровеньГруппировок = ПерсональныеНастройкиГруппировок.УровеньСворачиванияГруппировок;
		
		Если ПерсональныеНастройкиГруппировок.ПрименятьДляВложенныхГрупп Тогда		
			// Сворачиваем каждую группировку до заданного уровня вложенности.	
			Индекс = Цел(ДокументРезультат.КоличествоУровнейГруппировокСтрок()/УровеньГруппировок);	
			Пока Индекс > 0 Цикл 	
				ДокументРезультат.ПоказатьУровеньГруппировокСтрок(УровеньГруппировок*Индекс - 1);
				Индекс = Индекс - 1;
			КонецЦикла;	
	
		Иначе
			
			Индекс = ДокументРезультат.КоличествоУровнейГруппировокСтрок(); 
			Пока Индекс >= УровеньГруппировок Цикл
				ДокументРезультат.ПоказатьУровеньГруппировокСтрок(Индекс - 1);
				Индекс = Индекс - 1;
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

// Процедура добавляет наборы данных, поля и связи в схему компоновки данных.
//
// Параметры:
//  СКД							 - СхемаКомпоновкиДанных - схема компоновки данных.
//  СтруктураНастроек			 - Структура			 - структура настроек (добавляемые наборы данных, поля и связи).
//  ПроверятьИспользованиеПолей	 - Булево
//  КомпоновщикНастроек			 - КомпоновщикНастроекКомпоновкиДанных, Неопределено
//
Процедура ДобавитьДополнительныеНаборыДанныхСКД(СКД, СтруктураНастроек, 
	ПроверятьИспользованиеПолей = Ложь, КомпоновщикНастроек = Неопределено) Экспорт
	
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда 
		Возврат; 
	КонецЕсли;
	Если НЕ СтруктураНастроек.Свойство("ДопНаборыДанных") Тогда 
		Возврат; 
	КонецЕсли;
	
	ТипЗначенияДата = Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата));
	
	ОсновнойНаборДанных = СКД.НаборыДанных[0].Имя;
	
	ТипПлана = Неопределено;
	СтруктураНастроек.Свойство("ТипПлана", ТипПлана);
	
	НастройкиЗаменыВерсии = Неопределено;
	СтруктураНастроек.Свойство("НастройкиЗаменыВерсии", НастройкиЗаменыВерсии);
	
	Если НастройкиЗаменыВерсии = Неопределено 
		Или НастройкиЗаменыВерсии.Свойство("ЭтоЗаменаНеТекущейВерсии") Тогда
		Если ТипПлана = Неопределено Тогда
			ТипПлана = Перечисления.упоТипПланаПроекта.Текущий;
		КонецЕсли;	
	Иначе
		ТипПлана = НастройкиЗаменыВерсии.ТипПлана;
	КонецЕсли;	
	ТипВерсии = ТипВерсииСтрокойПоТипуПлана(ТипПлана);							
	
	ОтборПоСценарию = ЭтоОтборПоСценарию(ТипПлана);	
		
	НуженРасчетПроцентовПЗ = СтруктураНастроек.Свойство("ИмяПоляПЗ") 
							И СтруктураНастроек.Свойство("ПроцентыПЗ");
							
	НуженРасчетСроковПЗ = СтруктураНастроек.Свойство("ИмяПоляПЗ") 
							И СтруктураНастроек.Свойство("Сроки");
							
	НуженРасчетСроковФактПЗ = СтруктураНастроек.Свойство("ИмяПоляПЗ") 
								И СтруктураНастроек.Свойство("СрокиФакт");
	НуженРасчетСроковПоВерсии = СтруктураНастроек.Свойство("ИмяПоляПЗ")
									И СтруктураНастроек.Свойство("ВыборВерсии");
								
	ДобавитьНаборДанныхИерархия = ТипПлана <> Перечисления.упоТипПланаПроекта.Текущий
									Или НуженРасчетПроцентовПЗ
									Или НуженРасчетСроковПЗ
									Или НуженРасчетСроковФактПЗ;
		
	Если ДобавитьНаборДанныхИерархия Тогда
			
		// Иерархия.	
		УстановитьИерархиюПЗПоТипуВерсии(СКД, ОсновнойНаборДанных, СтруктураНастроек, ТипВерсии, ОтборПоСценарию);	
							
		// Проценты.
		Если НуженРасчетПроцентовПЗ Тогда
			
			ДополнитьСКДПроцентыПЗ(СКД, ТипВерсии, ОсновнойНаборДанных, СтруктураНастроек, 
				ПроверятьИспользованиеПолей, КомпоновщикНастроек, ОтборПоСценарию);
						
		КонецЕсли;		
		
		// Сроки.
		Если НуженРасчетСроковПЗ Тогда
			ДополнитьСКДСрокиПЗ(СКД, ТипВерсии, ОсновнойНаборДанных, СтруктураНастроек, 
				ПроверятьИспользованиеПолей, КомпоновщикНастроек, ОтборПоСценарию);
		КонецЕсли;
		
		Если НуженРасчетСроковПоВерсии Тогда
			СрокиПоВерсиям = Неопределено;
			Если СтруктураНастроек.ВыборВерсии.Свойство("СрокиПоВерсиям", СрокиПоВерсиям) Тогда
				ДополнитьСКДСрокиПоВерсии(СКД, СрокиПоВерсиям, ОсновнойНаборДанных, СтруктураНастроек,
					ПроверятьИспользованиеПолей, КомпоновщикНастроек);
			КонецЕсли;
		КонецЕсли;
		
		// Фактические сроки.
		Если НуженРасчетСроковФактПЗ Тогда
			ДополнитьСКДСрокиФактПЗ(СКД, ТипВерсии, ОсновнойНаборДанных, СтруктураНастроек, 
				ПроверятьИспользованиеПолей, КомпоновщикНастроек, ОтборПоСценарию);
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ИмяПоляПроект") Тогда 
		
		// Руководители.
		Если СтруктураНастроек.Свойство("Руководители") Тогда 
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	Руководители.Проект КАК Проект,
			               |	ЕСТЬNULL(Руководители.РуководительПроекта, ЗНАЧЕНИЕ(Справочник.упоСотрудники.ПустаяСсылка)) КАК РуководительПроекта,
						   |	ЕСТЬNULL(Руководители.КураторПроекта, ЗНАЧЕНИЕ(Справочник.упоСотрудники.ПустаяСсылка)) КАК КураторПроекта
			               |ИЗ
			               |	РегистрСведений.упоРуководителиПроектов.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, ) КАК Руководители";
			
			НаборДанныхРуководители = ДобавитьНаборДанных(СКД, "Руководители", "ИсточникДанных1", ТекстЗапроса);
			
			ДобавитьПолеКомпоновки(НаборДанныхРуководители, "Проект", "Проект", Истина, Истина, Истина, Истина);
			ДобавитьПолеКомпоновки(НаборДанныхРуководители, "РуководительПроекта", "РуководительПроекта");
			ДобавитьПолеКомпоновки(НаборДанныхРуководители, "КураторПроекта", "КураторПроекта");
			
			ДобавитьСвязьНаборовДанных(СКД, ОсновнойНаборДанных, "Руководители", СтруктураНастроек.ИмяПоляПроект, "Проект");
			
		КонецЕсли;
		
		// Сроки проектов.
		Если СтруктураНастроек.Свойство("Сроки") Тогда
			ДобавитьНаборДанныхСрокиПроекта(СКД, ОсновнойНаборДанных, ТипВерсии, ОтборПоСценарию, СтруктураНастроек);
		КонецЕсли;
		
		Если НуженРасчетСроковПоВерсии Тогда
			СрокиПоВерсиям = Неопределено;
			Если СтруктураНастроек.ВыборВерсии.Свойство("СрокиПоВерсиям", СрокиПоВерсиям) Тогда
				ДобавитьНаборДанныхСрокиПроектаПоВерсии(СКД, ОсновнойНаборДанных, СрокиПоВерсиям, СтруктураНастроек);
			КонецЕсли;
		КонецЕсли;
		
		// Статусы проектов.
		Если СтруктураНастроек.Свойство("СтатусыПроектов") Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ЕСТЬNULL(Статусы.СтатусПроекта, ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.ПустаяСсылка)) КАК СтатусПроекта,
			               |	ЕСТЬNULL(Статусы.СтатусПроекта, ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.ПустаяСсылка)) КАК СтатусПроектаРесурс,
			               |	Статусы.Проект
			               |ИЗ
			               |	РегистрСведений.упоСтатусыПроектов.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, ) КАК Статусы";
			
			НаборДанныхСтатусыПроектов = ДобавитьНаборДанных(СКД, "СтатусыПроектов", "ИсточникДанных1", ТекстЗапроса);
			
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПроектов, "Проект", "Проект", Истина, Истина, Истина, Истина);
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПроектов, "СтатусПроекта", "СтатусПроекта");
			
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПроектов, "СтатусПроектаРесурс", "СтатусПроектаРесурс", Истина, , , , ,
				НСтр("ru = 'Статус проекта, ресурс'"));
			Группировки = Новый Массив;
			Группировки.Добавить("Проект");
			Группировки.Добавить("Проект Иерархия");
			ДобавитьПолеРесурса(СКД, "СтатусПроектаРесурс", "СтатусПроектаРесурс", Группировки);
			
			ДобавитьСвязьНаборовДанных(СКД, ОсновнойНаборДанных, "СтатусыПроектов", СтруктураНастроек.ИмяПоляПроект, "Проект");
			
		КонецЕсли;
		
		// Проценты готовности проекта. 
		// Отдельный расчет, если проценты готовности ПЗ уже выводятся в основном отчете.
		Если СтруктураНастроек.Свойство("ПроцентыПроект") Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	ЕСТЬNULL(ПроцентыПроекта.ПроцентГотовности, 0) КАК ПроцентГотовностиПроекта,
			               |	ПроцентыПроекта.Проект КАК СсылкаНаПроект
						   |ИЗ
			               |	РегистрСведений.упоПроцентыГотовностиПроектов.СрезПоследних(
			               |			{(НЕОПРЕДЕЛЕНО) КАК Поле2},
			               |			Версия В
			               |				(ВЫБРАТЬ
			               |					ВерсииВыбранногоТипа.Версия
			               |				ИЗ
			               |					ВерсииВыбранногоТипа) {(Проект) КАК СсылкаНаПроект}) КАК ПроцентыПроекта";
			
			Если ОтборПоСценарию Тогда 
				ТекстЗапроса = ТекстЗапросаДляПолученияДанныхПоСценарию(ТекстЗапроса);
			Иначе	
				ТекстЗапроса = ТекстЗапросаДляПолученияДанныхПоТипуВерсии(ТипВерсии, ТекстЗапроса);
			КонецЕсли;
			
			НаборДанныхПроцентыПроект = ДобавитьНаборДанных(СКД, "ПроцентГотовностиПроекта", "ИсточникДанных1", ТекстЗапроса);
			
			ОграничениеИспользования = НовоеОграничениеИспользованияПоля();
			
			ДобавитьПолеКомпоновки(НаборДанныхПроцентыПроект, 
									"СсылкаНаПроект", 
									"СсылкаНаПроект", 
									Истина, 
									Истина, 
									Истина,
									Истина, 
									, 
									, 
									, 
									, 
									ОграничениеИспользования);
			ДобавитьПолеКомпоновки(НаборДанныхПроцентыПроект, 
									"ПроцентГотовностиПроекта", 
									"ПроцентГотовностиПроекта");
			ДобавитьПолеКомпоновки(НаборДанныхПроцентыПроект, 
									"Проект", 
									"Проект", 
									Истина, 
									Истина, 
									Истина,
									Истина);
			
			ЭлементОформленияФормат 			  = НаборДанныхПроцентыПроект.Поля[1].Оформление.Элементы.Найти("Формат");
			ЭлементОформленияФормат.Использование = Истина;
			ЭлементОформленияФормат.Значение      = "ЧДЦ=2";
			
			ДобавитьСвязьНаборовДанных(СКД, 
									ОсновнойНаборДанных, 
									"ПроцентГотовностиПроекта", 
									СтруктураНастроек.ИмяПоляПроект,
									"СсылкаНаПроект");
			
			Группировки = Новый Массив;
			Группировки.Добавить("Проект");
			ДобавитьПолеРесурса(СКД, "ПроцентГотовностиПроекта", "ПроцентГотовностиПроекта", Группировки);
			
			Группировки = Новый Массив;
			Группировки.Добавить("ОбщийИтог");
			// Умножение на 0 необходимо для использования польз.полей без непосредственного вывода ПроцентаГотовностиПроекта.
			ДобавитьПолеРесурса(СКД, "ПроцентГотовностиПроекта*0", "ПроцентГотовностиПроекта", Группировки);
			
			ВыражениеРесурса = "ВЫБОР КОГДА ПроектнаяЗадача.ЭтоПроектнаяЗадача 
				|ТОГДА "" "" 
				|ИНАЧЕ ПроцентГотовностиПроекта КОНЕЦ";
			
			Группировки = Новый Массив;
			Группировки.Добавить("ПроектнаяЗадача Иерархия");
			ДобавитьПолеРесурса(СКД, ВыражениеРесурса, "ПроцентГотовностиПроекта", Группировки);
			
			ДобавитьПолеРесурса(СКД, "ПроцентГотовностиПроекта", "ПроцентГотовностиПроекта");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ИмяПоляПЗ") Тогда  
						
		// Статусы проектных задач.
		Если СтруктураНастроек.Свойство("СтатусыПЗ") Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(СтатусыПЗ.СтатусЗадачи, ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.ПустаяСсылка)) КАК СтатусПроектнойЗадачи,
			|	ЕСТЬNULL(СтатусыПЗ.СтатусЗадачи, ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.ПустаяСсылка)) КАК СтатусПроектнойЗадачиРесурс,
			|	СтатусыПЗ.ПроектнаяЗадача КАК СсылкаНаПроектнуюЗадачу
			|{ВЫБРАТЬ
			|	СсылкаНаПроектнуюЗадачу.*}
			|ИЗ
			|	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
			|			{(НЕОПРЕДЕЛЕНО) КАК Поле2},
			|			Версия В
			|				(ВЫБРАТЬ
			|					ВерсииВыбранногоТипа.Версия
			|				ИЗ
			|					ВерсииВыбранногоТипа) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК СтатусыПЗ
			|{ГДЕ
			|	СтатусыПЗ.ПроектнаяЗадача.* КАК СсылкаНаПроектнуюЗадачу}";
		
				
			Если ОтборПоСценарию Тогда 
				ТекстЗапроса = ТекстЗапросаДляПолученияДанныхПоСценарию(ТекстЗапроса);
			Иначе	
				ТекстЗапроса = ТекстЗапросаДляПолученияДанныхПоТипуВерсии(ТипВерсии, ТекстЗапроса);
			КонецЕсли;
			
			НаборДанныхСтатусыПЗ = ДобавитьНаборДанных(СКД, "СтатусыПЗ", "ИсточникДанных1", ТекстЗапроса);
			
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПЗ, 
									"СсылкаНаПроектнуюЗадачу", 
									"СсылкаНаПроектнуюЗадачу", 
									Истина, 
									Истина, 
									Истина, 
									Истина);
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПЗ, 
									"Проект", 
									"Проект", 
									Истина, 
									Истина, 
									Истина, 
									Истина);
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПЗ, "СтатусЗадачи", "СтатусЗадачи");
			
			ДобавитьПолеКомпоновки(НаборДанныхСтатусыПЗ, "СтатусЗадачиРесурс", "СтатусЗадачиРесурс", Истина, , , , ,
				НСтр("ru = 'Статус задачи, ресурс'"));
			Группировки = Новый Массив;
			Группировки.Добавить("ПроектнаяЗадача");
			Группировки.Добавить("ПроектнаяЗадача Иерархия");
			ДобавитьПолеРесурса(СКД, "СтатусЗадачиРесурс", "СтатусЗадачиРесурс", Группировки);
			
			ДобавитьСвязьНаборовДанных(СКД, 
									ОсновнойНаборДанных, 
									"СтатусыПЗ", 
									СтруктураНастроек.ИмяПоляПЗ, 
									"СсылкаНаПроектнуюЗадачу");
			
		КонецЕсли;
		
		// Руководители ПЗ.
		Если СтруктураНастроек.Свойство("Руководители") Тогда 
			
			ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	РуководителиПЗ.ПроектнаяЗадача КАК СсылкаНаПроектнуюЗадачу,
			               |	ЕСТЬNULL(РуководителиПЗ.РуководительПроектнойЗадачи, ЗНАЧЕНИЕ(Справочник.упоСотрудники.ПустаяСсылка)) КАК РуководительПроектнойЗадачи
						   |{ВЫБРАТЬ
			               |	СсылкаНаПроектнуюЗадачу.*}
			               |ИЗ
			               |	РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК РуководителиПЗ
						   |{ГДЕ
			               |	РуководителиПЗ.ПроектнаяЗадача.* КАК СсылкаНаПроектнуюЗадачу}";
			
			НаборДанныхРуководителиПЗ = ДобавитьНаборДанных(СКД, "РуководителиПЗ", "ИсточникДанных1", ТекстЗапроса);
			
			ДобавитьПолеКомпоновки(НаборДанныхРуководителиПЗ, 
									"СсылкаНаПроектнуюЗадачу", 
									"СсылкаНаПроектнуюЗадачу", 
									Истина, 
									Истина, 
									Истина, 
									Истина);
			ДобавитьПолеКомпоновки(НаборДанныхРуководителиПЗ, 
									"РуководительПроектнойЗадачи", 
									"РуководительПроектнойЗадачи");
			
			ДобавитьСвязьНаборовДанных(СКД, 
									ОсновнойНаборДанных, 
									"РуководителиПЗ", 
									СтруктураНастроек.ИмяПоляПЗ, 
									"СсылкаНаПроектнуюЗадачу");
			
		КонецЕсли;
	
		// Свойства ПЗ.
		Если СтруктураНастроек.Свойство("СвойстваПЗ") Тогда
			
			Результат = упоТиповыеОтчетыСерверПовтИспСеанс.ПолучитьРеквизитыПроектныхЗадачХранящихсяВРС(ТипПлана);
					
			СвойстваПЗ = Результат.СвойстваПЗ;
			ТекстЗапроса = Результат.ТекстЗапроса;
			
			АвтозаполнениеДоступныхПолей = Ложь;
			НаборДанныхСвойства = ДобавитьНаборДанных(СКД, "СвойстваПЗ", "ИсточникДанных1", ТекстЗапроса, АвтозаполнениеДоступныхПолей);
			
			ДобавитьПолеКомпоновки(НаборДанныхСвойства, 
									"СсылкаНаПроектнуюЗадачу", 
									"СсылкаНаПроектнуюЗадачу", 
									Истина, 
									Истина, 
									Истина, 
									Истина);
			
			Если СтруктураНастроек.Свойство("ПутьКДанным") Тогда
				ПутьКДанным = СтруктураНастроек.ПутьКДанным;
			Иначе	
				ПутьКДанным = "СвойстваПроектныхЗадач";
			КонецЕсли;
			Если СтруктураНастроек.Свойство("ПутьКДаннымЗаголовок") Тогда
				ПутьКДаннымЗаголовок = СтруктураНастроек.ПутьКДаннымЗаголовок;
			Иначе
				ПутьКДаннымЗаголовок = НСтр("ru = 'Свойства проектных задач'");
			КонецЕсли;
			ПапкаПолейКомпоновки = НаборДанныхСвойства.Поля.Добавить(Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных"));
			ПапкаПолейКомпоновки.ПутьКДанным = ПутьКДанным;
			ПапкаПолейКомпоновки.Заголовок = ПутьКДаннымЗаголовок;
			
			ПапкаПолейКомпоновкиРесурсы = НаборДанныхСвойства.Поля.Добавить(Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных"));
			ПапкаПолейКомпоновкиРесурсы.ПутьКДанным = ПутьКДанным + "Ресурс";
			ПапкаПолейКомпоновкиРесурсы.Заголовок = ПутьКДаннымЗаголовок + НСтр("ru = ', ресурсы'");
			
			ПолеШаблон = "%1ПЗ";
			ПолеШаблонРесурс = "%1ПЗРесурс";
			ПутьКДаннымШаблон = ?(ЗначениеЗаполнено(ПутьКДанным), ПутьКДанным + "." + ПолеШаблон, ПолеШаблон);
			ПутьКДаннымШаблонРесурс = ?(ЗначениеЗаполнено(ПутьКДанным), ПутьКДанным + "Ресурс." + ПолеШаблонРесурс, "Ресурс" + ПолеШаблонРесурс);
			ЗаголовокШаблон = НСтр("ru = '%1 (ПЗ)'");
			ЗаголовокШаблонРесурс = НСтр("ru = '%1 (ПЗ), ресурс'");
			
			ГруппировкиРесурсовСвойствПЗ = Новый Массив;
			ГруппировкиРесурсовСвойствПЗ.Добавить("ПроектнаяЗадача");
			ГруппировкиРесурсовСвойствПЗ.Добавить("ПроектнаяЗадача Иерархия");
			ОграничениеНеГруппировка = Новый Структура("Группировка", Истина);
			
			ПутьКДаннымТипПроектнойЗадачи = ?(ЗначениеЗаполнено(ПутьКДанным),
				ПутьКДанным + ".ТипПроектнойЗадачиПЗ", "ТипПроектнойЗадачиПЗ");
			ДобавитьПолеКомпоновки(НаборДанныхСвойства, 
									"ТипПроектнойЗадачиПЗ", 
									ПутьКДаннымТипПроектнойЗадачи,
									,
									,
									,
									,
									, 
									НСтр("ru = 'Тип проектной задачи (ПЗ)'"));
			ПутьКДаннымТипПроектнойЗадачи = ?(ЗначениеЗаполнено(ПутьКДанным),
				ПутьКДанным + "Ресурс" +".ТипПроектнойЗадачиПЗРесурс", "РесурсТипПроектнойЗадачиПЗРесурс");
			ДобавитьПолеКомпоновки(НаборДанныхСвойства, 
									"ТипПроектнойЗадачиПЗРесурс", 
									ПутьКДаннымТипПроектнойЗадачи,
									Истина,
									,
									,
									,
									,
									НСтр("ru = 'Тип проектной задачи, ресурс (ПЗ)'"),
									,
									,
									ОграничениеНеГруппировка);
			ДобавитьПолеРесурса(СКД, ПутьКДаннымТипПроектнойЗадачи, ПутьКДаннымТипПроектнойЗадачи,
				ГруппировкиРесурсовСвойствПЗ);
			
			СвойстваИсключения = Новый Соответствие;
			СвойстваИсключения.Вставить("ЭтоВеха", 				Истина);
			СвойстваИсключения.Вставить("ЭтоПакетРабот", 		Истина);
			СвойстваИсключения.Вставить("ЭтоМодельПакетаРабот", Истина);
			
			Для каждого СвойствоПЗ Из СвойстваПЗ Цикл
				Если СвойстваИсключения.Получить(СвойствоПЗ.Имя) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если НРег(Лев(СвойствоПЗ.Имя, 7)) = "удалить" Тогда
					Продолжить;
				КонецЕсли;
				
				Поле = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПолеШаблон, СвойствоПЗ.Имя);
				ПутьКДанным = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПутьКДаннымШаблон, СвойствоПЗ.Имя);
				Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ЗаголовокШаблон, СвойствоПЗ.Синоним);
				ДобавитьПолеКомпоновки(НаборДанныхСвойства, Поле, ПутьКДанным, , , , , , Заголовок);
				
				// Поле ресурса.
				Поле = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПолеШаблонРесурс,
						СвойствоПЗ.Имя);
				ПутьКДанным = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПутьКДаннымШаблонРесурс,
						СвойствоПЗ.Имя);
				Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ЗаголовокШаблон, СвойствоПЗ.Синоним + ", ресурс");
				ДобавитьПолеКомпоновки(НаборДанныхСвойства, Поле, ПутьКДанным, Истина, , , , , Заголовок, , , ОграничениеНеГруппировка);
				ДобавитьПолеРесурса(СКД, ПутьКДанным, ПутьКДанным, ГруппировкиРесурсовСвойствПЗ);
			КонецЦикла;
			
			ДобавитьСвязьНаборовДанных(СКД, 
									ОсновнойНаборДанных, 
									"СвойстваПЗ", 
									СтруктураНастроек.ИмяПоляПЗ, 
									"СсылкаНаПроектнуюЗадачу");
						
		КонецЕсли;
		
		// Причины отклонений
		Если упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПричиныОтклонений() Тогда
			Если СтруктураНастроек.Свойство("ПричиныОтклонений") Тогда
				
				ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|    ПричиныОтклонений.ПроектнаяЗадача КАК СсылкаНаПроектнуюЗадачу,
					|    ПричиныОтклонений.Причина КАК ПричинаОтклонений,
					|    ПричиныОтклонений.ДатаИзменений КАК ПериодПричины,
					|    ПричиныОтклонений.Комментарий КАК КомментарийПричины
					|{ВЫБРАТЬ
					|    СсылкаНаПроектнуюЗадачу.*}
					|ИЗ
					|    РегистрСведений.упоПричиныОтклонений.СрезПоследних(
					|            {(НЕОПРЕДЕЛЕНО) КАК Поле2},
					|            Версия В
					|                (ВЫБРАТЬ
					|                    ВерсииВыбранногоТипа.Версия
					|                ИЗ
					|                    ВерсииВыбранногоТипа) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу, (Причина) КАК ПричинаОтклонений}) КАК ПричиныОтклонений
					|ГДЕ
					|    НЕ ПричиныОтклонений.Отмена
					|{ГДЕ
					|    ПричиныОтклонений.ПроектнаяЗадача.* КАК СсылкаНаПроектнуюЗадачу,
					|    ПричиныОтклонений.Причина КАК ПричинаОтклонений}";
				
				
				Если ОтборПоСценарию Тогда
					ТекстЗапроса = ТекстЗапросаДляПолученияДанныхПоСценарию(ТекстЗапроса);
				Иначе
					ТекстЗапроса = ТекстЗапросаДляПолученияДанныхПоТипуВерсии(ТипВерсии, ТекстЗапроса);
				КонецЕсли;
				
				НаборДанныхПричиныОтклонений = ДобавитьНаборДанных(СКД, "ПричиныОтклонений", "ИсточникДанных1", ТекстЗапроса);
				
				ДобавитьПолеКомпоновки(НаборДанныхПричиныОтклонений,
					"Проект",
					"Проект",
					Истина,
					Истина,
					Истина,
					Истина);
				ДобавитьПолеКомпоновки(НаборДанныхПричиныОтклонений,
					"СсылкаНаПроектнуюЗадачу",
					"СсылкаНаПроектнуюЗадачу",
					Истина,
					Истина,
					Истина,
					Истина);
				
				ДобавитьПолеКомпоновки(НаборДанныхПричиныОтклонений, "ПричинаОтклонений", "ПричинаОтклонений");
				
				ДобавитьСвязьНаборовДанных(СКД,
					ОсновнойНаборДанных,
					"ПричиныОтклонений",
					СтруктураНастроек.ИмяПоляПЗ,
					"СсылкаНаПроектнуюЗадачу");
				
				ВыражениеРесурса = "ВЫБОР 
					|	КОГДА ЗначениеЗаполнено(ПричинаОтклонений)   
					|		ТОГДА Упорядочить(ТаблицаЗначений(ПричинаОтклонений, 
					|			Формат(ПериодПричины, ""ДЛФ='D'"") КАК ПериодПричины,
					|			(ВЫБОР КОГДА ЗначениеЗаполнено(КомментарийПричины) 
					|				ТОГДА КомментарийПричины 
					|				ИНАЧЕ "" "" КОНЕЦ) КАК КомментарийПричины), 
					|					""ПериодПричины Убыв"") 
					|		ИНАЧЕ """"  
					|	КОНЕЦ";
				
				Группировки = Новый Массив;
				Группировки.Добавить("ПроектнаяЗадача");
				ДобавитьПолеРесурса(СКД, ВыражениеРесурса, "ПричинаОтклонений", Группировки);
				
			КонецЕсли;
		КонецЕсли;
		
		// Показатели отставания
		Если СтруктураНастроек.Свойство("ПоказателиОтставания") Тогда
			
			ТекстЗапроса = ТекстЗапросаДляПолученияПоказателейОтставания();
			
			НаборДанныхПоказателиОтставания = ДобавитьНаборДанных(СКД, "ПоказателиОтставания", "ИсточникДанных1", ТекстЗапроса);
			
			Оформление = Новый Структура("Формат", "ЧДЦ=0");
			
			ДобавитьПолеКомпоновки(НаборДанныхПоказателиОтставания, "ОтставаниеОтТП", "ОтставаниеОтТП", , , , , Оформление);
			ДобавитьПолеКомпоновки(НаборДанныхПоказателиОтставания, "ОтставаниеОтБП", "ОтставаниеОтБП", , , , , Оформление);				
			ДобавитьПолеКомпоновки(НаборДанныхПоказателиОтставания, "ОтставаниеОтДП", "ОтставаниеОтДП", , , , , Оформление);	
			
			ДобавитьСвязьНаборовДанных(СКД, ОсновнойНаборДанных, "ПоказателиОтставания", "ПроектнаяЗадача", "ПроектнаяЗадача");			
			
			ДобавитьПолеРесурса(СКД, "ОтставаниеОтТП", "ОтставаниеОтТП");
 			ДобавитьПолеРесурса(СКД, "ОтставаниеОтБП", "ОтставаниеОтБП");
			ДобавитьПолеРесурса(СКД, "ОтставаниеОтДП", "ОтставаниеОтДП");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОтборПоСценарию Тогда
		НаборыДанных = СКД.НаборыДанных;
		ДобавитьВТВерсийПоСценариюВНаборыДанных(НаборыДанных, ОсновнойНаборДанных);
	КонецЕсли;
	
КонецПроцедуры

// Процедура устанавливает скрытый отбор на заполненные выбранные показатели отчета
//
// Параметры:
//  НастройкиКомпоновкиДанных - НастройкиКомпоновкиДанных - настройки отчета.
//  СКД - СхемаКомпоновкиДанных - схема компоновки данных.
//  ИмяНабораДанных - Строка - имя набора данных СКД.
//  ПоляИсключения - Массив Из Строка - имена полей, к которым не нужно применять правило отбора.
//
Процедура УстановитьОтборПоПоказателям(НастройкиКомпоновкиДанных, СКД, ИмяНабораДанных, ПоляИсключения = Неопределено) Экспорт
	
	СтандартныйЗапрос = СКД.НаборыДанных[ИмяНабораДанных].Запрос;
	ВыбранныеПоля = НастройкиКомпоновкиДанных.Выбор.Элементы;
	Отбор = НастройкиКомпоновкиДанных.Отбор.Элементы;
	Показатели = Новый Соответствие;
	ИсключаяНеиспользуемые = Истина;
	ЗаполнитьСписокВыбранныхПолей(Показатели, ВыбранныеПоля, ВыбранныеПоля, ИсключаяНеиспользуемые);
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если ЭлементОтбора.Представление = НСтр("ru='Не выводить незаполненные движения'") Тогда
			ОтборПоказатели = ЭлементОтбора;
		КонецЕсли;
	КонецЦикла;
	
	Если ОтборПоказатели = Неопределено Тогда
		ОтборПоказатели = Отбор.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ОтборПоказатели.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		ОтборПоказатели.Представление = НСтр("ru='Не выводить незаполненные движения'");
	КонецЕсли;
	ОтборПоказатели.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ОтборПоказатели.Использование = Истина;
	ОтборПоказатели.Элементы.Очистить();
	
	Если ПоляИсключения = Неопределено Тогда
		ПоляИсключения = Новый Массив;
	КонецЕсли;
	
	ПоляСКД = СКД.НаборыДанных[ИмяНабораДанных].Поля;
	Для Каждого КлючИЗначение Из Показатели Цикл
		Показатель = КлючИЗначение.Ключ;
		
		Если ПоляИсключения.Найти(Строка(Показатель)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПоляСКД.Найти(Показатель) <> Неопределено Или СКД.ВычисляемыеПоля.Найти(Показатель) <> Неопределено Тогда
			ОтборПоказатель = ОтборПоказатели.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборПоказатель.Использование = Истина;
			ОтборПоказатель.ЛевоеЗначение = Показатель;
			ОтборПоказатель.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура добавляет дополнительные отборы и поля в компоновщик.
//
// Параметры:
//	КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек
//	СтруктураНастроек - Структура - структура дополнительных отборов и полей.
//
Процедура ДобавитьДополнительныеНастройкиВКомпоновщик(КомпоновщикНастроек, СтруктураНастроек) Экспорт
	
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	УстановитьФорматированиеСуммовыхПолейИзНастроекПользователя(КомпоновщикНастроек.Настройки, СтруктураНастроек);	
	ДобавитьФорматированиеПоказателейИОтборПоРуководителюИСтатусуПроекта(КомпоновщикНастроек.Настройки,
		СтруктураНастроек);
	
	Если НЕ (СтруктураНастроек.Свойство("ОтключитьОтборПоКомпоненту") 
		И СтруктураНастроек.ОтключитьОтборПоКомпоненту) Тогда 
		
		РодительскоеПоле = Новый ПолеКомпоновкиДанных("Проект");		
		
		// Похожий функционал реализован в общей форме "упоФормаОтчета" 
		// в процедуре УстановитьОтборПоКомпонентуПроектаКопируемойСКД
		
		упоФункцииОбщегоНазначенияКлиентСервер.УстановитьОтборПоПолюКомпоновки(КомпоновщикНастроек, "Проект.Компонент", 
			ПредопределенноеЗначение("Перечисление.упоКомпоненты.Проект"), Ложь, Истина, РодительскоеПоле);

	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("УстановитьПараметрыПоУмолчаниюИзОтчета") 
		И СтруктураНастроек.Свойство("ПараметрыПоУмолчанию") Тогда
		Для Каждого КлючЗначение Из СтруктураНастроек.ПараметрыПоУмолчанию Цикл
			ЗначениеПараметраСКД = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
														Новый ПараметрКомпоновкиДанных(КлючЗначение.Ключ));
			ЗначениеПараметраСКД.Использование = Истина;
			ЗначениеПараметраСКД.Значение = КлючЗначение.Значение;
			// В некоторых случаях пользовательские параметры не обновляются автоматически из параметров настроек, 
			// поэтому обновляем их принудительно.
			ПеренестиЗначениеПараметрДанныхВПользовательскиеНастройки(КомпоновщикНастроек, ЗначениеПараметраСКД, Истина);
		КонецЦикла;	
	КонецЕсли;	
	        	
КонецПроцедуры

// Процедура - Перенести значение параметра данных в пользовательские настройки.
//
// Параметры:
//	КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек 
//  ЗначениеПараметраСКД - ЗначениеПараметраКомпоновкиДанных - значение параметра компоновких данных
//  ПереносПараметраВДопСвойстваКомпоновщика - Булево - признак необходимости копирования параметра 
//  	в доп.свойства отчета для отключения перезаполнения пользовательскими настройками на форме.
//
Процедура ПеренестиЗначениеПараметрДанныхВПользовательскиеНастройки(КомпоновщикНастроек, 
																	ЗначениеПараметраСКД, 
																	ПереносПараметраВДопСвойстваКомпоновщика = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗначениеПараметраСКД.ИдентификаторПользовательскойНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	ПользовательскийПараметр = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(
										ЗначениеПараметраСКД.ИдентификаторПользовательскойНастройки);
	Если ТипЗнч(ПользовательскийПараметр) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда
		ПользовательскийПараметр.Значение = ЗначениеПараметраСКД.Значение;
	КонецЕсли;	
	
	// Отключение загрузки пользовательских настроек.
			 		
	Если ПереносПараметраВДопСвойстваКомпоновщика Тогда
		
		Если Не КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Свойство(
						"НеЗагружатьПользовательскиеНастройкиДляЭлементов") Тогда		
			КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить(
						"НеЗагружатьПользовательскиеНастройкиДляЭлементов", Новый Соответствие);
		КонецЕсли;	
				
		КомпоновщикНастроек.Настройки.ДополнительныеСвойства.НеЗагружатьПользовательскиеНастройкиДляЭлементов.Вставить(
			ЗначениеПараметраСКД.ИдентификаторПользовательскойНастройки, Истина);	
		
	КонецЕсли;		
	
КонецПроцедуры

// Получает значения персональных настроек оформления отчета.
//
// Возвращаемое значение:
//  Структура - ключи:
//   * ФорматСумм 				- Строка - Форматная строка.
//   * ШиринаСуммовыхКолонок 	- Число.
//   * Макет оформления отчетов - Строка - имя макета оформления отчета СКД.
//   * ФорматКоличества 		- Строка - Форматная строка.
//   * ШиринаКолонокКоличества 	- Число.
//
Функция ПолучитьНастройкиОформленияОтчета() Экспорт
	
	СтруктураНастроек = Новый Структура();
	
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ФорматСумм", "ЧДЦ='2'");
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ШиринаСуммовыхКолонок", 15);
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ФорматКоличества", "ЧДЦ=2");
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ШиринаКолонокКоличества", 15);
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ФорматТрудозатрат", "ЧЦ='15'; ЧДЦ='2'");
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ШиринаКолонокТрудозатрат", 15);
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ФорматКоличествоВыделятьОтрицательные", Истина);
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ФорматСуммаВыделятьОтрицательные", Истина);
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ФорматТрудозатратВыделятьОтрицательные", Истина);
	
	// Настройки периодов общие для всех - не сохраняем их в персональные.
	СтруктураНастроек.Вставить("ФорматПериодГод", 		ФорматПериодаГод());
	СтруктураНастроек.Вставить("ФорматПериодКвартал", 	ФорматПериодаКвартал());
	СтруктураНастроек.Вставить("ФорматПериодМесяц", 	ФорматПериодаМесяц());
	СтруктураНастроек.Вставить("ФорматПериодНеделя", 	ФорматПериодаНеделя());
	СтруктураНастроек.Вставить("ФорматПериодДень", 		ФорматПериодаДень());
	
	МакетОформленияОтчетов = МакетОформленияОтчетовИзСтиля();
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "МакетОформленияОтчетов", МакетОформленияОтчетов);
	
	Возврат СтруктураНастроек;
	
КонецФункции

// Получает значения персональных настроек группировок.
//
// Возвращаемое значение:
//  Структура - ключи:
//   * УровеньСворачиванияГруппировок - Число.
//   * ПрименятьДляВложенныхГрупп - Булево.
//
Функция ПолучитьНастройкиГруппировокОтчета() Экспорт
	
	СтруктураНастроек = Новый Структура();
			
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "УровеньСворачиванияГруппировок", 3);	
	ДобавитьПерсональнуюНастройку(СтруктураНастроек, "ПрименятьДляВложенныхГрупп", Ложь);
		
	Возврат СтруктураНастроек;
	
КонецФункции

// Формирует отчет "Динамика экономики проекта" и помещает результат во временное хранилище.
//
// Параметры:
//	ПараметрыОтчета - Структура - Ключи:
//		* СхемаКомпоновкиДанных - схема КД
//		* НастройкиКомпоновкиДанных - настройки КД.
//		* СоставПодписей - табличная часть "Состав подписей" отчета.
//		* ТипыПоказателей - табличная часть "Типы показателей" отчета.
//		* Показатели - табличная часть "Показатели" отчета.
//		* ВыбраннаяВерсия - документ "Версия плана проекта" (реквизит отчета).
//	АдресХранилища - Строка - адрес временного хранилища.
//
Процедура СформироватьОтчетДинамикаЭкономики(ПараметрыОтчета, АдресХранилища = "") Экспорт

	ОсновнаяСхемаКомпоновки = ПараметрыОтчета.СхемаКомпоновкиДанных;
	СоставПодписей 			= ПараметрыОтчета.СоставПодписей;
	ТипыПоказателей 		= ПараметрыОтчета.ТипыПоказателей;
	Показатели 				= ПараметрыОтчета.Показатели;
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(ПараметрыОтчета.НастройкиКомпоновкиДанных);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ОсновнаяСхемаКомпоновки)); 
	
	ВнешниеНаборыДанных = Новый Структура;
	
	Попытка
		Если КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0].Значение Тогда
			ТипДополнения = ТипДополненияПериодаКомпоновкиДанных.Месяц;
		Иначе
			ТипДополнения = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
		КонецЕсли;
		КомпоновщикНастроек.Настройки.Структура[0].Точки[0].ПоляГруппировки.Элементы[0].ТипДополнения = ТипДополнения;
	Исключение
	КонецПопытки;
	
	ТекДата = упоПоказателиПроектовСервер.ПолучитьТекДатуДляПоказателейФОТ();
	КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ТекДата", ТекДата);
					
	Настройки =	КомпоновщикНастроек.ПолучитьНастройки();
	
	// Тип плана.
	ТипПлана = Неопределено;
	Если ПараметрыОтчета.Свойство("ТипПлана", ТипПлана) Тогда
		
		НастройкиЗаменыВерсии = Новый Структура("ТипВерсии, ТипПлана", "Текущая", Перечисления.упоТипПланаПроекта.Текущий);
		ИзменитьТекстЗапросаОсновногоНабораДанныхСКДПоТипуПлана(ОсновнаяСхемаКомпоновки, ТипПлана, НастройкиЗаменыВерсии);
		
		упоТиповыеОтчетыСервер.ДобавитьДополнительныеНаборыДанныхСКД(ОсновнаяСхемаКомпоновки, 
			Новый Структура("ТипПлана", ТипПлана));
	КонецЕсли;		
		
	// Показатели.
	
	ВыбранныеПоказатели = Новый СписокЗначений;
	Для Каждого Показатель Из Показатели Цикл
		Если Показатель.Пометка Тогда
			ВыбранныеПоказатели.Добавить(Показатель.Значение);
		КонецЕсли;
	КонецЦикла;
	ВыбранныеТипыПоказателей = Новый СписокЗначений;
	Для Каждого ТипПоказателя Из ТипыПоказателей Цикл
		Если ТипПоказателя.Пометка Тогда
			ВыбранныеТипыПоказателей.Добавить(ТипПоказателя.Значение);
		КонецЕсли;
	КонецЦикла;
		
	ОтборПоПоказателям = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоПоказателям.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Показатель");
	ОтборПоПоказателям.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборПоПоказателям.ПравоеЗначение = ВыбранныеПоказатели;
	ОтборПоПоказателям.Использование = Истина;
	
	ОтборПоТипуПоказателя = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоТипуПоказателя.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТипПоказателя");
	ОтборПоТипуПоказателя.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборПоТипуПоказателя.ПравоеЗначение = ВыбранныеТипыПоказателей;
	ОтборПоТипуПоказателя.Использование = Истина;	
	
	ПодписьСерия = Ложь;
	ПодписьЗначение = Ложь;
	Для Каждого ВыбраннаяПодпись Из СоставПодписей Цикл
		Если ВыбраннаяПодпись.Пометка Тогда
			Если ВыбраннаяПодпись.Значение = "Показатель" Тогда
				ПодписьСерия = Истина;
			ИначеЕсли ВыбраннаяПодпись.Значение = "Сумма" Тогда
				ПодписьЗначение = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Если ПодписьСерия И ПодписьЗначение Тогда
		ВидПодписей = ВидПодписейКДиаграмме.СерияЗначение;
	ИначеЕсли ПодписьСерия Тогда
		ВидПодписей = ВидПодписейКДиаграмме.Серия;
	ИначеЕсли ПодписьЗначение Тогда
		ВидПодписей = ВидПодписейКДиаграмме.Значение;
	Иначе
		ВидПодписей = ВидПодписейКДиаграмме.Нет;
	КонецЕсли;
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ТипДиаграммы.ВидПодписей", ВидПодписей);
	
	ПараметрРасположениеЛегенды = Настройки.ПараметрыВывода.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ТипДиаграммы.РасположениеЛегенды"));
	Если ПараметрРасположениеЛегенды <> Неопределено Тогда
		
		Если Настройки.ДополнительныеСвойства.Свойство("ЭтаФормаРабочегоСтола") 
			И Настройки.ДополнительныеСвойства.ЭтаФормаРабочегоСтола = Истина Тогда
			
			ПараметрРасположениеЛегенды.Использование = Истина;
			ПараметрРасположениеЛегенды.Значение = РасположениеЛегендыДиаграммыКомпоновкиДанных.Нет;
			
		Иначе 
			
			Если НЕ ПараметрРасположениеЛегенды.Использование Тогда
				ПараметрРасположениеЛегенды.Использование = Истина;
				ПараметрРасположениеЛегенды.Значение = РасположениеЛегендыДиаграммыКомпоновкиДанных.Нет;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
				
	//
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(ОсновнаяСхемаКомпоновки, Настройки, ДанныеРасшифровки);
	
	// Инициализируем процессор СКД.
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки);
	
	// Инициализируем процессор вывода.
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;        
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);

	Если ДокументРезультат.Рисунки.Количество() <> 0 Тогда
		ДокументРезультат.Рисунки[0].Объект.ОбластьПостроения.ФорматШкалыЗначений = "ЧРГ=;";	                          
	КонецЕсли; 	

	ПоместитьВоВременноеХранилище(Новый Структура("Результат,ДанныеРасшифровки",
		ДокументРезультат, ДанныеРасшифровки), АдресХранилища);
	
КонецПроцедуры

// Формирует отчет и помещает результат во временное хранилище.
//
// Параметры:
//	ПараметрыОтчета - Структура - Ключи:
//		* ИдентификаторОтчета - Строка.
//		* НастройкиКомпоновкиДанных -НастройкиКомпоновкиДанных.
//
//	АдресХранилища - Строка - адрес временного хранилища.
//
Процедура СформироватьОтчет(ПараметрыОтчета, АдресХранилища = "") Экспорт
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	ОтчетОбъект = Отчеты[ПараметрыОтчета.ИдентификаторОтчета].Создать();
	
	ИнициализироватьСКДиКомпоновщикНастроекОтчета(ОтчетОбъект, ОтчетОбъект.КомпоновщикНастроек);
	СтруктураНастроек = ПараметрыОтчета.НастройкиОбъекта;
	
	// Загрузим пользовательские настройки после инициализации компоновщика настроек.
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(ПараметрыОтчета.НастройкиКомпоновкиДанных);
	
	// Временно отключено.
	//ОбработатьВыборПолейДополнительнойИнформации(ОтчетОбъект.КомпоновщикНастроек.Настройки, СтруктураНастроек);
	
	ОтчетОбъект.СкомпоноватьРезультат(ДокументРезультат, ДанныеРасшифровки);
	
	ПоместитьВоВременноеХранилище(Новый Структура("Результат,ДанныеРасшифровки", ДокументРезультат, ДанныеРасшифровки), АдресХранилища);
	
КонецПроцедуры

// Добавляет на форму кнопку "Открыть новый отчет" и соответствующую команду.
// Обработчик действия команды должен иметь имя "Подключаемый_ОткрытьНовыйОтчет".
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - форма, в которую надо добавить кнопку.
//  ГруппаФормы - ЭлементФормы - группа формы, на которую надо вывести ЭУ.
//
Процедура ДобавитьКнопкуОткрытияНовогоОтчета(ЭтаФорма, ГруппаФормы) Экспорт
	
	ИмяЭлемента = "ОткрытьНовыйОтчет";
	
	Команда = ЭтаФорма.Команды.Добавить(ИмяЭлемента);
	Команда.Действие  = "Подключаемый_ОткрытьНовыйОтчет";
	Команда.Заголовок = "Открыть новый отчет";
	Команда.Подсказка = "Открыть новый отчет";
	Команда.Картинка = БиблиотекаКартинок.Отчет;
	
	Элемент = ЭтаФорма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаФормы);
	Элемент.ИмяКоманды = ИмяЭлемента;
	Элемент.ТолькоВоВсехДействиях = Ложь;
	
КонецПроцедуры

// Сохраняет настройки компоновщика во временное хранилище, возвращает адрес.
//
// Параметры:
//	КомпоновщикНастроек - КомпновщиикНастроекКомпоновкиДанных - компоновщик,
//						чьи настройки необходимо сохранить во временном хранимлище.
// Возвращаемое значение:
//	Строка - адрес.
Функция СохранитьНастройкиКомпоновщика(КомпоновщикНастроек) Экспорт
	
	ТекНастройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	Возврат ПоместитьВоВременноеХранилище(ТекНастройки, Новый УникальныйИдентификатор);
	
КонецФункции

// Загружает настройки компоновщика в компоновщик настроек отчета.
//
// Параметры:
//  Настройки - Структура - структура с настройками.
//  ЭтаФорма - УправляемаяФорма - форма.
//  Отчет - ОтчетОбъект - отчет.
//
Процедура ЗагрузитьНастройкиКомпоновщикаВФормуОтчета(Настройки, ЭтаФорма, Отчет) Экспорт
	
	Если Настройки.Свойство("ЕстьОткрытиеНовогоОтчета") Тогда
		ТемпНастройкиКомпоновщика = ПолучитьИзВременногоХранилища(Настройки.НастройкиКомпоновщика);
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ТемпНастройкиКомпоновщика);
		Если Настройки.Свойство("ПериодИспользование") Тогда
			ЭтаФорма.ПериодИспользование = Настройки.ПериодИспользование;
			ЭтаФорма.ПериодВид = Настройки.ПериодВид;
			ЭтаФорма.ПериодЗначение = Настройки.ПериодЗначение;
			ЭтаФорма.ПериодПредставление = упоФункцииБСПКлиентСервер.ПредставлениеСтандартногоПериода(
				Настройки.ПериодЗначение, ЭтаФорма.ПериодВид);
		КонецЕсли;
		Если ЭтаФорма.РеквизитыВДопНастройки <> Неопределено Тогда
			Для Каждого ЭлементРеквизит Из ЭтаФорма.РеквизитыВДопНастройки Цикл
				ИмяРеквизита = ЭлементРеквизит.Значение;
				Если ТемпНастройкиКомпоновщика.ДополнительныеСвойства.Свойство(ИмяРеквизита) Тогда
					ЭтаФорма[ИмяРеквизита] = ТемпНастройкиКомпоновщика.ДополнительныеСвойства[ИмяРеквизита];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Принудительно прописывает заголовки выбранных полей из доступных полей.
//
// Параметры:
//	КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - компоновщик модифицируемого отчета.
//
Процедура УстановитьЗаголовкиПолейВыбораПоДоступнымПолямПринудительно(КомпоновщикНастроек) Экспорт
	
	ЭлементыВыбора = КомпоновщикНастроек.Настройки.Выбор.Элементы;
	ДоступныеПоляВыбора = КомпоновщикНастроек.Настройки.Выбор.ДоступныеПоляВыбора;	
	
	УстановитьЗаголовкиПолейВыбораПоДоступнымПолямРекурсивно(ЭлементыВыбора, ДоступныеПоляВыбора);
	
КонецПроцедуры	

// Процедура добавляет форматирование показателей проекта и отбор по руководителю и статусу проекта.
//
// Параметры:
//	Настройки - НастройкиКомпоновкиДанных	- настройки компоновки данных.
//	СтруктураНастроек	- Структура			- структура дополнительных отборов и полей.
//
Процедура ДобавитьФорматированиеПоказателейИОтборПоРуководителюИСтатусуПроекта(Настройки, СтруктураНастроек) Экспорт
	
	Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	Если СтруктураНастроек.Свойство("ФорматПоказателейПроектов") Тогда
		
		МассивПоказателей = Новый Массив;
		Для Каждого КлючЗначение Из СтруктураНастроек.ФорматПоказателейПроектов Цикл
			МассивПоказателей.Добавить(КлючЗначение.Ключ);	
		КонецЦикла;
		
		ДанныеФорматов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивПоказателей, "ФорматнаяСтрока", Истина);
		
		Для Каждого КлючЗначение Из СтруктураНастроек.ФорматПоказателейПроектов Цикл
			ФорматнаяСтрока = ДанныеФорматов.Получить(КлючЗначение.Ключ).ФорматнаяСтрока;
			ДобавитьФорматПолю(Настройки, ФорматнаяСтрока, КлючЗначение.Значение);	
		КонецЦикла;
			
	КонецЕсли;
	
	Если СтруктураНастроек.Свойство("ДопНаборыДанных") Тогда
		
		Если СтруктураНастроек.Свойство("Руководители") И СтруктураНастроек.Свойство("ИмяПоляПроект") Тогда	
			ОтборРуководитель 				 = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборРуководитель.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("РуководительПроекта");
			ОтборРуководитель.ВидСравнения 	 = ВидСравненияКомпоновкиДанных.Равно;
			ОтборРуководитель.Использование  = Ложь;		
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("СтатусыПроектов") И СтруктураНастроек.Свойство("ИмяПоляПроект") Тогда
			ОтборСтатус 			  		 = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборСтатус.ЛевоеЗначение 		 = Новый ПолеКомпоновкиДанных("СтатусПроекта");
			ОтборСтатус.ВидСравнения  		 = ВидСравненияКомпоновкиДанных.Равно;
			ОтборСтатус.Использование 		 = Ложь;		
		КонецЕсли; 		
		
	КонецЕсли;
			
КонецПроцедуры

// Процедура устанавливает условное оформление на поля сумма и количества.
//
// Параметры:
//	Настройки - НастройкиКомпоновкиДанных	- настройки компоновки данных.
//	НастройкиОбъекта	- Структура			- структура дополнительных полей.
//
Процедура УстановитьФорматированиеСуммовыхПолейИзНастроекПользователя(Настройки, НастройкиОбъекта) Экспорт
		
	СтруктураОформлениеОтчета = ПолучитьНастройкиОформленияОтчета();
	
	ФорматСумм 								= СтруктураОформлениеОтчета.ФорматСумм;
	ШиринаКолонок 							= СтруктураОформлениеОтчета.ШиринаСуммовыхКолонок;
	ФорматКоличества						= СтруктураОформлениеОтчета.ФорматКоличества;
	ШиринаКолонокКоличества 				= СтруктураОформлениеОтчета.ШиринаКолонокКоличества; 
	ФорматТрудозатрат						= СтруктураОформлениеОтчета.ФорматТрудозатрат;
	ШиринаКолонокТрудозатрат 				= СтруктураОформлениеОтчета.ШиринаКолонокТрудозатрат; 
	ФорматКоличествоВыделятьОтрицательные 	= СтруктураОформлениеОтчета.ФорматКоличествоВыделятьОтрицательные;
	ФорматСуммаВыделятьОтрицательные 		= СтруктураОформлениеОтчета.ФорматСуммаВыделятьОтрицательные; 
	ФорматТрудозатратВыделятьОтрицательные 	= СтруктураОформлениеОтчета.ФорматТрудозатратВыделятьОтрицательные;
	МакетОформленияОтчетов 					= СтруктураОформлениеОтчета.МакетОформленияОтчетов;
	
	ФорматПериодГод 	= СтруктураОформлениеОтчета.ФорматПериодГод;
	ФорматПериодКвартал = СтруктураОформлениеОтчета.ФорматПериодКвартал;
	ФорматПериодМесяц 	= СтруктураОформлениеОтчета.ФорматПериодМесяц;
	ФорматПериодНеделя 	= СтруктураОформлениеОтчета.ФорматПериодНеделя;
	ФорматПериодДень 	= СтруктураОформлениеОтчета.ФорматПериодДень;
	
	ЭлементыУсловногоОформления = Настройки.УсловноеОформление.Элементы;
	ПараметрыВывода = Настройки.ПараметрыВывода.Элементы;
	
	УстанавливатьОформлениеПолейСумм = ЗначениеЗаполнено(ФорматСумм) ИЛИ ЗначениеЗаполнено(ШиринаКолонок)
		ИЛИ ЗначениеЗаполнено(ФорматСуммаВыделятьОтрицательные);
	
	Если НастройкиОбъекта.Свойство("ПоляСуммы") И УстанавливатьОформлениеПолейСумм Тогда
		
		ДобавитьУсловноеОформлениеДляВыбранныхПолей(Настройки, НастройкиОбъекта.ПоляСуммы, ФорматСумм, ШиринаКолонок,
			ФорматСуммаВыделятьОтрицательные);
		
	КонецЕсли;
		
	Если НастройкиОбъекта.Свойство("ПоляСуммыБезВыделенияОтрицательных") 
		И УстанавливатьОформлениеПолейСумм 
		И ФорматСуммаВыделятьОтрицательные Тогда
		
		ДобавитьУсловноеОформлениеДляВыбранныхПолей(Настройки, 
			НастройкиОбъекта.ПоляСуммыБезВыделенияОтрицательных, ФорматСумм, ШиринаКолонок, Ложь);
		
	КонецЕсли;
	
	УстанавливатьОформлениеПолейКоличества = ЗначениеЗаполнено(ФорматКоличества) 
		ИЛИ ЗначениеЗаполнено(ШиринаКолонокКоличества) ИЛИ ЗначениеЗаполнено(ФорматКоличествоВыделятьОтрицательные);
	
	Если НастройкиОбъекта.Свойство("ПоляКоличества") И УстанавливатьОформлениеПолейКоличества Тогда
		
		ДобавитьУсловноеОформлениеДляВыбранныхПолей(Настройки, НастройкиОбъекта.ПоляКоличества, ФорматКоличества, ШиринаКолонокКоличества,
			ФорматКоличествоВыделятьОтрицательные);
		
	КонецЕсли;
		
	УстанавливатьОформлениеПолейТрудозатрат = ЗначениеЗаполнено(ФорматТрудозатрат) 
		ИЛИ ЗначениеЗаполнено(ШиринаКолонокТрудозатрат) ИЛИ ЗначениеЗаполнено(ФорматТрудозатратВыделятьОтрицательные);
	
	Если НастройкиОбъекта.Свойство("ПоляТрудозатрат") И УстанавливатьОформлениеПолейТрудозатрат Тогда
		
		ДобавитьУсловноеОформлениеДляВыбранныхПолей(Настройки, НастройкиОбъекта.ПоляТрудозатрат, ФорматТрудозатрат, ШиринаКолонокТрудозатрат,
			ФорматТрудозатратВыделятьОтрицательные);
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(МакетОформленияОтчетов) Тогда
		ИспользоватьМакет = МакетОформленияОтчетов <> ПолучитьЗначениеМакетаОформленияБезОформления();
		МакетОформления = Настройки.ПараметрыВывода.Элементы.Найти("МакетОформления");
		МакетОформления.Значение = МакетОформленияОтчетов;
		МакетОформления.Использование = ИспользоватьМакет;
		Для Каждого ЭлементСтруктуры Из Настройки.Структура Цикл
			Если ТипЗнч(ЭлементСтруктуры) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") Тогда
				ВложенныйМакетОформления = ЭлементСтруктуры.Настройки.ПараметрыВывода.Элементы.Найти("МакетОформления");
				ВложенныйМакетОформления.Значение = МакетОформленияОтчетов;
				ВложенныйМакетОформления.Использование = ИспользоватьМакет;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НастройкиОбъекта.Свойство("ПоляПериодов") Тогда
		
		ПоляПериодов = НастройкиОбъекта.ПоляПериодов;
		
		Для Каждого ПолеПериода Из ПоляПериодов Цикл
			
			ИмяПоляПериод = Неопределено;
			
			Если ПолеПериода.Свойство("ПериодМесяц", ИмяПоляПериод) Тогда
				ФорматПериода = ФорматПериодМесяц;
			ИначеЕсли ПолеПериода.Свойство("ПериодГод", ИмяПоляПериод) Тогда
				ФорматПериода = ФорматПериодГод;
			ИначеЕсли ПолеПериода.Свойство("ПериодКвартал", ИмяПоляПериод) Тогда
				ФорматПериода = ФорматПериодКвартал;
			ИначеЕсли ПолеПериода.Свойство("ПериодНеделя", ИмяПоляПериод) Тогда
				ФорматПериода = ФорматПериодНеделя;
			ИначеЕсли ПолеПериода.Свойство("ПериодДень", ИмяПоляПериод) Тогда
				ФорматПериода = ФорматПериодДень;
			Иначе
				Продолжить;
			КонецЕсли;
			
			ДобавитьУсловноеОформлениеДляВыбранныхПолей(Настройки, 
				ИмяПоляПериод, ФорматПериода,,, ГоризонтальноеПоложение.Центр);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Строковый идентификатор объекта метаданных по имени отчета.
//
// Параметры:
//  ИмяОтчета	 - Строка	 - имя отчета
// 
// Возвращаемое значение:
//  Строка - идентификатор объекта метаданных.
//
Функция ПолучитьИдентификаторОтчета(ИмяОтчета) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПолноеИмя = Метаданные.Отчеты[ИмяОтчета].ПолноеИмя(); 
	
	ИдентификаторОтчета = Справочники.ИдентификаторыОбъектовМетаданных.ИдентификаторОбъектаМетаданных(ПолноеИмя);
	
	Возврат ИдентификаторОтчета;
	
КонецФункции

// Заполняет период формы отчета значением по умолчанию (этот год).
//
// Параметры:
//  Отчет	 - ОтчетОбъект 		- отчет.
//  Форма	 - УправляемаяФорма - форма отчета.
//
Процедура УстановитьНаФормеНастройкуПериодаПоУмолчанию(Отчет, Форма) Экспорт
	
	ПараметрКДПериодОтчета = Новый ПараметрКомпоновкиДанных("ПериодОтчета");
	
	НастройкиОтчета = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Для Каждого ПараметрОтчета Из НастройкиОтчета.ПараметрыДанных.ДоступныеПараметры.Элементы Цикл
		
		Если ПараметрОтчета.Параметр = ПараметрКДПериодОтчета Тогда
				
			ЗначениеПараметра = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрОтчета.Параметр);
			Форма.ВыборТипаДаты = ЗначениеПараметра.Значение.Вариант;
			Форма.ПериодЗначение.ДатаНачала     = ЗначениеПараметра.Значение.ДатаНачала;
			Форма.ПериодЗначение.ДатаОкончания  = ЗначениеПараметра.Значение.ДатаОкончания;
			Форма.ПериодЗначение.Вариант 		= ЗначениеПараметра.Значение.Вариант;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Добавление дополнительных параметров в схему компоновки данных.
//
// Параметры:
//	СКД					- СхемаКомпоновкиДанных - схема компоновки данных.
//	НастройкиОбъекта	- Структура				- настройки объекта отчета.
//
Процедура ДобавитьДополнительныеПараметрыСКД(СКД, НастройкиОбъекта) Экспорт 
	
	Если НастройкиОбъекта.Свойство("ТипПлана") Тогда 
		
		ПараметрСКД = СКД.Параметры.Добавить();
		ПараметрСКД.Имя = "ТипПлана";
		ПараметрСКД.Заголовок = НСтр("ru = 'Тип плана/Сценарий'");
		ПараметрСКД.ВключатьВДоступныеПоля = Истина;
		ПараметрСКД.ЗапрещатьНезаполненныеЗначения = Истина;
		ПараметрСКД.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
		ПараметрСКД.ТипЗначения = 
			Новый ОписаниеТипов("ПеречислениеСсылка.упоТипПланаПроекта, СправочникСсылка.упоСценарии");
	
		Для Каждого ВариантНастройки Из СКД.ВариантыНастроек Цикл
			УстановитьПользовательскийПараметр(ВариантНастройки.Настройки, 
												"ТипПлана",
												Перечисления.упоТипПланаПроекта.Текущий,
												"_ТипПлана_");
		КонецЦикла;									
	
	КонецЕсли;	
	
	Если НастройкиОбъекта.Свойство("ВыборВерсии") Тогда 
		Для НомерВерсии = 1 По НастройкиОбъекта.ВыборВерсии.КоличествоВерсий Цикл
			Имя = "Версия" + Строка(НомерВерсии);
			Для Каждого ВариантНастройки Из СКД.ВариантыНастроек Цикл
				УстановитьПользовательскийПараметр(ВариантНастройки.Настройки, 
				                                    Имя,
													Документы.упоВерсияПланаПроекта.ПустаяСсылка(),
													"_" + Имя + "_");
			КонецЦикла;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

// Добавляет к источнику схемы запроса внутреннее соединение с таблицей.
//
// Параметры:
//	Источник					- ИсточникСхемыЗапроса  - источник схемы запроса.
//	ПсевдонимТаблицыСоединения	- Строка	- псевдоним таблицы соединения.
// 	СтрокаСоединения			- Строка 	- условие соединения.
//
Процедура ДобавитьВнутреннееСоединениеВИсточник(Источник, ПсевдонимТаблицыСоединения, СтрокаСоединения) Экспорт
	
	ИндексПоследнего = Источник.Соединения.Количество();
	Источник.Соединения.Добавить(ПсевдонимТаблицыСоединения, СтрокаСоединения);
	Источник.Соединения[ИндексПоследнего].ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее;	
	
КонецПроцедуры

// Инициализирует компоновщик настроек и формирует СКД отчета по его настройкам (см. модуль объекта отчета).
//
// Параметры:
//	ОтчетОбъект - ОтчетОбъект - источник настроек.
//	КомпоновщикНастроек - КомпоновщикНастроекКомпоновкиДанных - приемник настроек, требующий инициализации.
//
Процедура ИнициализироватьСКДиКомпоновщикНастроекОтчета(ОтчетОбъект, КомпоновщикНастроек) Экспорт
	
	СКД = ОтчетОбъект.СхемаКомпоновкиДанных;
	
	НастройкиОбъекта = Новый Структура;
	Попытка
		НастройкиОбъекта = ОтчетОбъект.ПолучитьНастройкиОтчета();
	Исключение
	КонецПопытки;
	
	ДобавитьДополнительныеНаборыДанныхСКД(СКД, НастройкиОбъекта);
	ДобавитьДополнительныеПараметрыСКД(СКД, НастройкиОбъекта);
	ДобавитьПараметрВыбораДляПоляПроект(СКД);
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД));
	
КонецПроцедуры

#Область ПредставлениеПроектнойЗадачи

// Используется для получения представления Проектной задачи с учетом признака ЗадачаОтменена
//
// Параметры:
//	Название - Строка - Название проектной задачи
//	ЗадачаОтменена - Булево - Признак отмененой задачи
//	ЯвляетсяЗадачейВыбранныхВерсий - Булево - Признак задачи, которая не входит в выбранный тип версии
//											  или в выбранную версию. Используется в отчете упоТрудозатратыПоУровнямПланирования 
//
// Возвращаемое значение:
//  Строка - Новое представление проектной задачи.
//
Функция ПолучитьПредставлениеПроектнойЗадачи(Название, ЗадачаОтменена, ЯвляетсяЗадачейВыбранныхВерсий = Истина) Экспорт
	
	ТипЗначения = ТипЗнч(ЯвляетсяЗадачейВыбранныхВерсий);
	Если ТипЗначения = Тип("Булево") И Не ЯвляетсяЗадачейВыбранныхВерсий Тогда
		Представление = ПолучитьПредставлениеПроектнойЗадачиНеЯвляетсяЗадачейВыбранныхВерсий();
		Возврат Представление;
	КонецЕсли;
	
	Представление = Название;	
	ТипЗначения = ТипЗнч(ЗадачаОтменена);
	Если ТипЗначения <> Тип("Булево") Тогда
		Возврат Представление;
	КонецЕсли;
	
	Если ЗадачаОтменена Тогда
		Префикс = упоПроектыИЗадачиОбщие.ПрефиксОтмененнойЗадачи();
		Представление = Префикс + Представление;		
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции	

#КонецОбласти

#Область ПредставлениеПричинОтклонения

// Получает строковое представление для списка причин отклонения проектной задачи.
//
// Параметры:
//  ПроектнаяЗадача	 - ДокументСсылка.упоПроектнаяЗадача
//  Версия			 - ДокументСсылка.упоВерсияПланаПроекта, Неопределено
// 
// Возвращаемое значение:
//  Строка - строковое представление причин отклонений.
//
Функция ПолучитьПредставлениеПричинОтклонений(ПроектнаяЗадача, Версия = Неопределено) Экспорт 
	
	Если Не упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПричиныОтклонений() Тогда
		Возврат "";
	КонецЕсли;
	
	Если Версия = Неопределено Тогда
		Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача);	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПричиныОтклонений();
	Запрос.УстановитьПараметр("Ссылка", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("текВерсия", Версия);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	ШаблонПричины = "%1, %2";
	ФорматПериодаДень =  ФорматПериодаДень();
	МассивПричин = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Причина = СтрШаблон(ШаблонПричины, Формат(Выборка.ДатаИзменений, ФорматПериодаДень), Выборка.Причина);
		МассивПричин.Добавить(Причина);
	КонецЦикла;
	Представление = СтрСоединить(МассивПричин, "; ");
	
	Возврат Представление;
	
КонецФункции //

#КонецОбласти

Процедура ДобавитьВТВерсийПоСценариюВНаборыДанных(НаборыДанных, Знач ОсновнойНаборДанных)
		
	ИмяВремТаблицыВерсийПоСценарию = ИмяВремТабВерсийПоСценарию();
	Для Каждого НаборДанных Из НаборыДанных Цикл
		
		Если НаборДанных.Имя = ОсновнойНаборДанных Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоОбъект = ТипЗнч(НаборДанных) = Тип("НаборДанныхОбъектСхемыКомпоновкиДанных");
		Если ЭтоОбъект Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоОбъединение = ТипЗнч(НаборДанных) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных");
		Если ЭтоОбъединение Тогда
			НаборыДанныхОбъединения = НаборДанных.Элементы;
			ДобавитьВТВерсийПоСценариюВНаборыДанных(НаборыДанныхОбъединения, ОсновнойНаборДанных);
		КонецЕсли;
		
		ВставитьВременнуюТаблицуВТекстЗапроса = СтрНайти(НаборДанных.Запрос, ИмяВремТаблицыВерсийПоСценарию) > 0
			И СтрНайти(НаборДанных.Запрос, "ПОМЕСТИТЬ " + ИмяВремТаблицыВерсийПоСценарию) = 0;
		Если ВставитьВременнуюТаблицуВТекстЗапроса Тогда
			ВставитьВТекстЗапросаВремТабСВерсиямиПоСценарию(НаборДанных.Запрос);
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

// Возвращает стандартную настройку полей периодов. Вызывается из модуля объекта отчета при определении 
// настроек объекта отчета.
// 
// Возвращаемое значение:
//  Массив - настройка полей периодов.
//
Функция СтандартнаяНастройкаОбъекта_Периоды() Экспорт
	
	МассивПолейПериода = Новый Массив;
	МассивПолейПериода.Добавить(Новый Структура("ПериодГод", 		"ПериодГод"));
	МассивПолейПериода.Добавить(Новый Структура("ПериодКвартал", 	"ПериодКвартал"));
	МассивПолейПериода.Добавить(Новый Структура("ПериодМесяц", 		"ПериодМесяц"));
	МассивПолейПериода.Добавить(Новый Структура("ПериодНеделя", 	"ПериодНеделя"));
	МассивПолейПериода.Добавить(Новый Структура("ПериодДень", 		"ПериодДень"));
	
	Возврат МассивПолейПериода;
	
КонецФункции

// Заполняет настройки отбора отчета из источника настроек.
//
// Параметры:
//  КомпоновщикНастроекПриемника - КомпоновщикНастроекКомпоновкиДанных - приемник настроек.
//  НастройкиИсточника - НастройкиКомпоновкиДанных - источник переносимых настроек.
//
Процедура ДополнитьОтборКомпоновщика(КомпоновщикНастроекПриемника, НастройкиИсточника) Экспорт
	
	ПоляИсключения = Новый Массив;
	ОтборКомпоновщика = КомпоновщикНастроекПриемника.Настройки.Отбор;
	
	КопируемыеЭлементыОтбора = НастройкиИсточника.Отбор.Элементы;
	ЭлементыОтбораИсточника = ОтборКомпоновщика.Элементы;
	
	ДополнитьОтборКомпоновщикаРекурсивно(ЭлементыОтбораИсточника, КопируемыеЭлементыОтбора, ПоляИсключения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьЗначениеМакетаОформленияБезОформления() Экспорт

	Возврат "Не использовать макет";
	
КонецФункции  

// Создает дополнительные группировки полей для переноса сроков ПЗ из общих итогов.
//
// Параметры:
//  НастройкиКомпоновкиДанных   - НастройкиКомпоновкиДанных - настройки компоновщика отчета.
//  НастройкиОбъектаОтчета      - см. метод ПолучитьНастройкиОтчета() модуля объекта отчета.
//
Процедура ПеренестиПоляСроковВДополнительнуюИнформацию(НастройкиКомпоновкиДанных, НастройкиОбъектаОтчета) Экспорт
	
	ТаблицаСодержащаяОсновныеНастройки = ТаблицаСодержащаяОсновныеНастройки(НастройкиКомпоновкиДанных);
	Если ТаблицаСодержащаяОсновныеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновныеКолонкиТаблицы = ТаблицаСодержащаяОсновныеНастройки.Колонки;
	ИменаПолейДляВыводаВДопИнформацию = ИменаПолейСроковПроектныхЗадач(НастройкиОбъектаОтчета);
	Для Каждого Колонка Из ОсновныеКолонкиТаблицы Цикл
		СписокВыбранныхПолей = Новый Соответствие;
		ВыбранныеПоляСКД = Колонка.Выбор.Элементы;
		ЗаполнитьСписокВыбранныхПолей(СписокВыбранныхПолей, ВыбранныеПоляСКД, ВыбранныеПоляСКД);
		
		// Найдем поле сроков в колонке. Если есть, то отключаем использование. Иначе создаем и отключаем.
		Для Каждого ИмяПоля Из ИменаПолейДляВыводаВДопИнформацию Цикл
			ИскомоеПоле = Новый ПолеКомпоновкиДанных(ИмяПоля);
			ИндексНайденногоПоля = СписокВыбранныхПолей.Получить(ИскомоеПоле);
			Если ИндексНайденногоПоля <> Неопределено Тогда
				НайденноеПоле = Колонка.Выбор.Элементы[ИндексНайденногоПоля];
				НайденноеПоле.Использование = Ложь;
			Иначе
				НовоеПоле = ВыбранныеПоляСКД.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
				НовоеПоле.Поле = ИскомоеПоле;
				НовоеПоле.Использование = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Добавим доп. информацию.
	ДобавитьГруппировкуДопИнформации(ОсновныеКолонкиТаблицы, ИменаПолейДляВыводаВДопИнформацию);
	ДобавитьГруппировкуВКонец = Истина;
	ДобавитьГруппировкуДопИнформации(ОсновныеКолонкиТаблицы, ИменаПолейДляВыводаВДопИнформацию, ДобавитьГруппировкуВКонец);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьФорматПолю(Настройки, Формат, ИмяПоля)
	
	ЭлементыУсловногоОформления = Настройки.УсловноеОформление.Элементы;
	
	ЭлементУсловногоОформления = ЭлементыУсловногоОформления.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	
	Оформление = ЭлементУсловногоОформления.Оформление.Элементы.Найти("Формат");
	Оформление.Значение = Формат;
	Оформление.Использование = Истина; 
	
	ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Использование = Истина;
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);	
	
КонецПроцедуры

Процедура ДобавитьСтрокуВПредставлениеРекурсивно(СтрокиКолонки, Представление)
	
	Для Каждого СтрокаКолонка Из СтрокиКолонки.ПоляГруппировки.Элементы Цикл
		
		Представление = Представление + СтрокаКолонка.Поле + ",";
		
		Если  СтрокиКолонки.Структура.Количество() > 0 Тогда
			
			Для Каждого ЭлементСтруктуры Из СтрокиКолонки.Структура Цикл
				
				ДобавитьСтрокуВПредставлениеРекурсивно(ЭлементСтруктуры,Представление);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает добавленный набор данных.
//
// Параметры:
//	СКД				- Схема компоновки данных	- схема компоновки данных.
//	Имя				- Строка					- имя набора данных.
//	ИсточникДанных	- Строка					- имя источника данных.
//	ТекстЗапроса	- Строка					- текст запроса для получения данных набора.
//			  
// Возвращаемое значение:
//	НаборДанныхЗапросСхемыКомпоновкиДанных - Описание набора данных схемы компоновки данных.
//
Функция ДобавитьНаборДанных(СКД, Имя, ИсточникДанных, ТекстЗапроса, АвтоЗаполнениеДоступныхПолей = Истина)
	
	НаборДанных 			   = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя 		   = Имя;
	НаборДанных.ИсточникДанных = ИсточникДанных;
	НаборДанных.Запрос 		   = ТекстЗапроса;
	НаборДанных.АвтоЗаполнениеДоступныхПолей = АвтоЗаполнениеДоступныхПолей;
	
	Возврат НаборДанных;
	
КонецФункции

// Процедура добавляет поле компоновки данных.
//
// Параметры:
//	НаборДанных		- НаборДанныхЗапросСхемыКомпоновкиДанных - описание набора данных схемы компоновки данных.
//	Поле			- Строка 								 - имя поля набора данных, для которого делается описание.
//	ПутьКДанным		- Строка 								 - путь к данным, под которым поле будет фигурировать в настройках и выражениях.
//	НеГруппировка	- Булево 								 - определяет, будет ли доступно поле для группировки.
//	НеПоле			- Булево 								 - определяет, будет ли доступно поле для выбора.
//	НеПорядок		- Булево 								 - определяет, будет ли доступно поле для упорядочивания.
//	НеУсловие		- Булево 								 - определяет, будет ли доступно поле для отбора.
//
Процедура ДобавитьПолеКомпоновки(НаборДанных,
								 Поле,
								 ПутьКДанным,
								 НеГруппировка = Ложь,
								 НеПоле = Ложь,
								 НеПорядок = Ложь,
								 НеУсловие = Ложь,
								 ЭлементыОформления = Неопределено,
								 Заголовок = Неопределено,
								 ТипЗначения = Неопределено,
								 ВыражениеПредставления = Неопределено,
								 ОграничениеИспользования = Неопределено)
	
	ПолеКомпоновки = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));		
	ПолеКомпоновки.Поле = Поле;
	ПолеКомпоновки.ПутьКДанным = ПутьКДанным;
	ПолеКомпоновки.ОграничениеИспользованияРеквизитов.Группировка = НеГруппировка;
	ПолеКомпоновки.ОграничениеИспользованияРеквизитов.Поле = НеПоле;
	ПолеКомпоновки.ОграничениеИспользованияРеквизитов.Порядок = НеПорядок;
	ПолеКомпоновки.ОграничениеИспользованияРеквизитов.Условие = НеУсловие;
	Если ОграничениеИспользования <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПолеКомпоновки.ОграничениеИспользования, ОграничениеИспользования);
	КонецЕсли;
	Если ЭлементыОформления <> Неопределено Тогда
		Для Каждого Эл Из ЭлементыОформления Цикл
			ПолеКомпоновки.Оформление.УстановитьЗначениеПараметра(Эл.Ключ, Эл.Значение);
		КонецЦикла;
	КонецЕсли;
	Если Заголовок <> Неопределено Тогда
		ПолеКомпоновки.Заголовок = Заголовок;
	КонецЕсли;	
	Если ТипЗначения <> Неопределено Тогда
		ПолеКомпоновки.ТипЗначения = ТипЗначения;	
	КонецЕсли;
	Если ВыражениеПредставления <> Неопределено Тогда
		ПолеКомпоновки.ВыражениеПредставления = ВыражениеПредставления;
	КонецЕсли; 	
	
КонецПроцедуры

// Процедура добавляет связь наборов данных в схему компоновки данных.
//
// Параметры:
//	СКД					- Схема компоновки данных 	- схема компоновки данных.
//	НаборДанныхИсточник	- Строка					- имя набора данных, от которого будет осуществляться связь.
//	НаборДанныхПриемник	- Строка					- имя набора данных, к которому будет осуществляться связь.
//	ВыражениеИсточник	- Строка					- выражение, по которому будет определяться значение связи источника.
//	ВыражениеПриемник	- Строка					- выражение, по которому будет определяться значение связи приемника.			  
//
Процедура ДобавитьСвязьНаборовДанных(СКД,
									 НаборДанныхИсточник, 
									 НаборДанныхПриемник, 
									 ВыражениеИсточник, 
									 ВыражениеПриемник,
									 РазрешенСписокПараметров = Ложь,
									 Параметр = Неопределено,
									 ЭтоОбязательнаяСвязь = Истина)
	
	СвязьНаборовДанных 	= СКД.СвязиНаборовДанных.Добавить();
	СвязьНаборовДанных.НаборДанныхИсточник 		= НаборДанныхИсточник;
	СвязьНаборовДанных.НаборДанныхПриемник 		= НаборДанныхПриемник;
	СвязьНаборовДанных.ВыражениеИсточник   		= ВыражениеИсточник;
	СвязьНаборовДанных.ВыражениеПриемник   		= ВыражениеПриемник;
	СвязьНаборовДанных.РазрешенСписокПараметров = РазрешенСписокПараметров;
	СвязьНаборовДанных.Обязательная = ЭтоОбязательнаяСвязь;
	Если РазрешенСписокПараметров Тогда 
		СвязьНаборовДанных.Параметр 			= Параметр;
	КонецЕсли;	
		
КонецПроцедуры

// Процедура добавляет поле ресурса в схему компоновки данных.
//
// Параметры:
//	СКД			- СхемаКомпоновкиДанных - схема компоновки данных.
//	Выражение   - Строка 				- содержит выражение, по которому будет осуществляться расчет итога по полю.
//	ПутьКДанным - Строка 				- содержит путь к данным поля, для которого описывается формула расчета итога.
//
Процедура ДобавитьПолеРесурса(СКД, Выражение, ПутьКДанным, МассивГруппировок = Неопределено)
	
	ПолеРесурса 			= СКД.ПоляИтога.Добавить();
	ПолеРесурса.Выражение 	= Выражение;
	ПолеРесурса.ПутьКДанным = ПутьКДанным;
	
	Если МассивГруппировок <> Неопределено Тогда
		Для Каждого Группировка Из МассивГруппировок Цикл
			ПолеРесурса.Группировки.Добавить(Группировка);		
		КонецЦикла; 			
	КонецЕсли; 
	
КонецПроцедуры

Процедура УстановитьЗаголовкиПолейВыбораПоДоступнымПолямРекурсивно(ЭлементыВыбора, ДоступныеПоляВыбора)
	
	Для Каждого ЭлементВыбора Из ЭлементыВыбора Цикл				
		Если ТипЗнч(ЭлементВыбора) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда						
			УстановитьЗаголовкиПолейВыбораПоДоступнымПолямРекурсивно(ЭлементВыбора.Элементы, ДоступныеПоляВыбора);
		Иначе	
			ДоступноеПоле = ДоступныеПоляВыбора.НайтиПоле(ЭлементВыбора.Поле);
			Если ДоступноеПоле <> Неопределено Тогда
				ЭлементВыбора.Заголовок = ДоступноеПоле.Заголовок;						
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Процедура ДобавитьПерсональнуюНастройку(СтруктураНастроек, ИмяНастройки, ЗначениеПоУмолчанию)
	
	ИмяГруппыНастроек = "НастройкиРаботыСОтчетами";
	
	Значение = ХранилищеОбщихНастроек.Загрузить(ИмяГруппыНастроек, ИмяНастройки);
	Если Значение = Неопределено Или ИмяНастройки = "МакетОформленияОтчетов" И Значение = "" Тогда 
		Значение = ЗначениеПоУмолчанию;
		ХранилищеОбщихНастроек.Сохранить(ИмяГруппыНастроек, ИмяНастройки, Значение);
	КонецЕсли;
	СтруктураНастроек.Вставить(ИмяНастройки, Значение);

КонецПроцедуры

Процедура СнятьОтборПоПоказателям(Отчет)
	
	Настройки = Отчет.КомпоновщикНастроек.Настройки;
	Отбор = Настройки.Отбор.Элементы;
	Для Каждого ЭлементОтбора Из Отбор Цикл
		Если ЭлементОтбора.Представление = НСтр("ru = 'Не выводить незаполненные движения'") Тогда
			ОтборПоказатели = ЭлементОтбора;
		КонецЕсли;
	КонецЦикла;
	Если ОтборПоказатели <> Неопределено Тогда
		Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(ОтборПоказатели);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПараметрВыбораДляПоляПроект(СхемаКомпоновки)
	
	Для Каждого НаборДанных Из СхемаКомпоновки.НаборыДанных Цикл
		ПолеПроект = НаборДанных.Поля.Найти("Проект");
		Если ПолеПроект <> Неопределено Тогда
			ПараметрыРедактирования = ПолеПроект.ПараметрыРедактирования;
			ПараметрыВыбора = ПараметрыРедактирования.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПараметрыВыбора"));
			Если ПараметрыВыбора <> Неопределено Тогда
				ПараметрВыбораПоКомпоненту = ПараметрыВыбора.Значение.Найти("Отбор.Компонент");
				Если ПараметрВыбораПоКомпоненту = Неопределено Тогда
					ПараметрыВыбора.Использование = Истина;
					НовыйПараметрВыбора = ПараметрыВыбора.Значение.Добавить();
					НовыйПараметрВыбора.Имя = "Отбор.Компонент";
					НовыйПараметрВыбора.Значение = Перечисления.упоКомпоненты.Проект;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область ЗаменаТипаВерсии

// Функция выполняет замену в тексте запроса типа версии из настроек на указанную.
//
// Параметры:
//	ТекстЗапроса			- Строка	- текст запроса.
//	ТипПлана			- ПеречислениеСсылка.упоТипПланаПроекта	- выбранный тип плана проекта.
//	НастройкиЗаменыВерсии - Структура - заменяемая версия 
//
// Возвращаемое значение:
//	Текст			- Строка	- текст запроса.
//
Функция ВыполнитьЗаменуТипаВерсииВТекстеЗапроса(Знач ТекстЗапроса, ТипПлана, НастройкиЗаменыВерсии) Экспорт 
	
	Если ТипПлана = НастройкиЗаменыВерсии.ТипПлана Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;	

	ОтборПоСценарию = ЭтоОтборПоСценарию(ТипПлана);
	
	ТипВерсииСтрокаЗамены = ТипВерсииСтрокойПоТипуПлана(ТипПлана);	
	
	МассивЧастей = Новый Массив;
	ЭтоЗаменаНеТекущейВерсии = НастройкиЗаменыВерсии.Свойство("ЭтоЗаменаНеТекущейВерсии");
	мРегистрыЗамены = РегистрыЗамены(ЭтоЗаменаНеТекущейВерсии, ТипВерсииСтрокаЗамены, ОтборПоСценарию);	
		
	Для Каждого КлючЗначение Из мРегистрыЗамены Цикл
					
		ПолноеИмяРегистра 		= КлючЗначение.Ключ;
		ПолноеИмяРегистраЗамены = КлючЗначение.Значение;
		
		// Нельзя заменить все таблицы сразу, т.к. они могут иметь разные псевдонимы. 
		ЧислоВхождений = СтрЧислоВхождений(ТекстЗапроса, ПолноеИмяРегистра);
		
		Если ЧислоВхождений = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Для Сч = 1 По ЧислоВхождений Цикл					
			ТекстЗапроса = ВыполнитьЗаменуВЧастиТекстаСВхождением(ТекстЗапроса, 
													ПолноеИмяРегистра, 
													ПолноеИмяРегистраЗамены, 
													НастройкиЗаменыВерсии.ТипВерсии,
													ТипВерсииСтрокаЗамены,
													МассивЧастей,
													ЭтоЗаменаНеТекущейВерсии,
													ОтборПоСценарию);
		КонецЦикла;		
		МассивЧастей.Добавить(ТекстЗапроса);
		
		ТекстЗапроса = СтрСоединить(МассивЧастей);
		
		МассивЧастей.Очистить();
		
	КонецЦикла;
	
	
	Если ОтборПоСценарию Тогда
		ВставитьВТекстЗапросаВремТабСВерсиямиПоСценарию(ТекстЗапроса);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
		
КонецФункции

Функция ВыполнитьЗаменуВЧастиТекстаСВхождением(Текст, 
												ПолноеИмяРегистра, 
												ПолноеИмяРегистраЗамены,
												ТипВерсииСтрока,
												ТипВерсииСтрокаЗамены, 
												МассивЧастей,
												ЭтоЗаменаНеТекущейВерсии,
												ОтборПоСценарию = Ложь)
												
	ДлинаИмениРегистра = СтрДлина(ПолноеИмяРегистра);  	
	ПозицияНачалоЗамены = СтрНайти(Текст, ПолноеИмяРегистра);
		
	Псевдоним = ПсевдонимТаблицыЗамены(Текст, ПолноеИмяРегистра);	
	
	// Где заменять.
	ПозицияПсевдоним = СтрНайти(Текст, Псевдоним, , ПозицияНачалоЗамены + ДлинаИмениРегистра + 1);		
	ПозицияКонецЗамены = СтрНайти(Текст, ПолноеИмяРегистра, , ПозицияПсевдоним + СтрДлина(Псевдоним));	
	Если ПозицияКонецЗамены = 0 Тогда 
		ПозицияКонецЗамены = СтрДлина(Текст) + 1;
	КонецЕсли;	
	
	ЧастьТекста = Лев(Текст, ПозицияКонецЗамены - 1);				
	
	// Что заменять.	
	Если ПолноеИмяРегистра = "РегистрСведений.упоВерсииПроекта" Тогда			
		Если ОтборПоСценарию Тогда
			ОтборПоВерсии = УсловиеОтбораВерсииПоВерсиямСценария(Псевдоним);
			ЧастьТекста = СтрЗаменить(ЧастьТекста, 	Псевдоним + "." + ТипВерсииСтрока, ОтборПоВерсии);
		Иначе
			ЧастьТекста = СтрЗаменить(ЧастьТекста, 	Псевдоним + "." + ТипВерсииСтрока,  Псевдоним + "." + ТипВерсииСтрокаЗамены);
		КонецЕсли;
		
	Иначе		
		
		Если ЭтоЗаменаНеТекущейВерсии Тогда
			ЧастьТекста = ТекстЗапросаУдалениеСвязиСТаблицей(ЧастьТекста, "РегистрСведений.упоВерсииПроекта", Псевдоним);
		КонецЕсли;
		
		ПозицияКонецПсевдонима = ПозицияПсевдоним + СтрДлина(Псевдоним);

		ИмяИПсевдонимРегистра = Сред(ЧастьТекста, ПозицияНачалоЗамены, ПозицияКонецПсевдонима - ПозицияНачалоЗамены);	
		ТекстЗамены = ТекстЗаменыАктуальныеПланыТрудозатрат(ПолноеИмяРегистраЗамены, Псевдоним, ТипВерсииСтрокаЗамены, ЭтоЗаменаНеТекущейВерсии, ОтборПоСценарию);
		ЧастьТекста = СтрЗаменить(ЧастьТекста, ИмяИПсевдонимРегистра, ТекстЗамены);
		Если Не ЭтоЗаменаНеТекущейВерсии Тогда
			// Замена отсутствующего измерения "Проект".
			ЧастьТекста = СтрЗаменить(ЧастьТекста, Псевдоним + ".Проект ", Псевдоним + ".Операция.Проект ");
			ЧастьТекста = СтрЗаменить(ЧастьТекста, Псевдоним + ".Проект.", Псевдоним + ".Операция.Проект.");
		КонецЕсли;
		
	КонецЕсли;			
	
	МассивЧастей.Добавить(ЧастьТекста);
		
	Возврат Сред(Текст, ПозицияКонецЗамены);

КонецФункции

Функция ТекстЗапросаУдалениеСвязиСТаблицей(ЧастьТекста, ИмяТаблицы, ПсевдонимТаблицы)

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ЧастьТекста);
	ЕстьУдаленныеСвязи = Ложь;
	Для каждого Пакет Из СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(Пакет) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда 
			Продолжить;
		КонецЕсли;
		Для Каждого Оператор Из Пакет.Операторы Цикл
			Для Каждого Источник Из Оператор.Источники Цикл
				Если Источник.Источник.Псевдоним <> ПсевдонимТаблицы Тогда
					Продолжить;
				КонецЕсли;
				мУдалить = Новый Массив;
				Для Каждого Соединение Из Источник.Соединения Цикл
					Если Соединение.Источник.Источник.ИмяТаблицы = ИмяТаблицы Тогда
						мУдалить.Вставить(0, Источник.Соединения.Индекс(Соединение));
					КонецЕсли;	
				КонецЦикла;	
				Для Каждого Индекс Из мУдалить Цикл
					Источник.Соединения.Удалить(Индекс);
				КонецЦикла;	
				ЕстьУдаленныеСвязи = Истина;
				Прервать;
			КонецЦикла;
			Если Не ЕстьУдаленныеСвязи Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Источник Из Оператор.Источники Цикл 
				Если Источник.Источник.ИмяТаблицы <> ИмяТаблицы Тогда
					Продолжить;
				КонецЕсли;	
				Оператор.Источники.Удалить(Оператор.Источники.Индекс(Источник));
				Прервать;
			КонецЦикла;	
			Прервать;						
		КонецЦикла;
		Если ЕстьУдаленныеСвязи Тогда
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат СхемаЗапроса.ПолучитьТекстЗапроса();
	
КонецФункции

Функция ТекстЗаменыАктуальныеПланыТрудозатрат(ИмяРегистраЗамены, ПсевдонимТаблицы, ТипВерсииСтрокаЗамены, ЭтоЗаменаНеТекущейВерсии, ОтборПоСценарию = Ложь)
 
	Если ОтборПоСценарию Тогда
		
			
		ТекстЗамены  = "%1 КАК %2
						|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ %3 КАК %3
						|		ПО %2.Версия = %3.Версия";
		ИмяТаблицыВерсийПоСценарию = ИмяВремТабВерсийПоСценарию();
					
 
		ТекстЗамены = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗамены, 
																	ИмяРегистраЗамены, 
																	ПсевдонимТаблицы, 
																	ИмяТаблицыВерсийПоСценарию);
		
	Иначе

	
		Если ЭтоЗаменаНеТекущейВерсии И ТипВерсииСтрокаЗамены = "Текущая" Тогда
			ТекстЗамены  = "%1 КАК %2";
		Иначе	
			ТекстЗамены  = "%1 КАК %2
							|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
							|		ПО %2.Версия = упоВерсииПроекта.Версия
							|			И (упоВерсииПроекта.%3)";
		КонецЕсли;
	
		ТекстЗамены = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗамены, 
																		ИмяРегистраЗамены, 
																		ПсевдонимТаблицы, 
																		ТипВерсииСтрокаЗамены);
			
	КонецЕсли;
																	
	Возврат ТекстЗамены;
	
КонецФункции

Функция ПсевдонимТаблицыЗамены(Текст, ИмяРегистра)
	
	ДлинаИмени = СтрДлина(ИмяРегистра);  
	ПозицияЗамены = СтрНайти(Текст, ИмяРегистра);
	
	ПозицияКонецИмениРегистра = ПозицияЗамены + ДлинаИмени + 1;
	
	ПозицияКонецСтроки = СтрНайти(Текст, Символы.ПС, , ПозицияКонецИмениРегистра);
	Если ПозицияКонецСтроки = 0 Тогда
		// Запрос написан в одну строку, задаем отрывок поиска.
		ОтрывокПоиска = 100;
		ПозицияКонецСтроки = ПозицияКонецИмениРегистра + ОтрывокПоиска; 
	КонецЕсли;		
	
	ОтрывокПоиска = Сред(Текст, ПозицияКонецИмениРегистра, ПозицияКонецСтроки - ПозицияКонецИмениРегистра);
	МассивПодстрокОтрывка = СтрРазделить(ОтрывокПоиска, " ", Ложь);
	
	ЗабратьПсевдоним = Ложь;
	ЕстьПсевдоним = Ложь;
	Псевдоним = "";
	
	Для Каждого ПодстрокаОтрывка Из МассивПодстрокОтрывка Цикл
		Если ЗабратьПсевдоним Тогда
			Псевдоним = ПодстрокаОтрывка;
			ЕстьПсевдоним = Истина;
			Прервать;
		КонецЕсли;	
		Если ПодстрокаОтрывка = "КАК" Тогда			
			ЗабратьПсевдоним = Истина;
		ИначеЕсли ПодстрокаОтрывка = "СОЕДИНЕНИЕ" 
			Или ПодстрокаОтрывка = "ГДЕ" 
			Или ПодстрокаОтрывка = ";" Тогда
			Прервать;
		Иначе	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Псевдоним;
	
КонецФункции

Функция РегистрыЗамены(ЭтоЗаменаНеТекущейВерсии, ТипВерсииСтрокаЗамены, ОтборПоСценарию = Ложь)
	
	СоответствиеИмен = Новый Соответствие;
	Если ЭтоЗаменаНеТекущейВерсии Тогда
		Если ТипВерсииСтрокаЗамены = "Текущая" 
			И Не ОтборПоСценарию Тогда
			
			СоответствиеИмен.Вставить("РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямВерсии", 
				"РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия");
			СоответствиеИмен.Вставить("РегистрСведений.упоАктуальныеПланыТрудозатратСводноВерсии", 
				"РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия");
		Иначе
			СоответствиеИмен.Вставить("РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямВерсии", 
				"РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямВерсии");
			СоответствиеИмен.Вставить("РегистрСведений.упоАктуальныеПланыТрудозатратСводноВерсии", 
				"РегистрСведений.упоАктуальныеПланыТрудозатратСводноВерсии");
		КонецЕсли;	
	Иначе	
		СоответствиеИмен.Вставить("РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия", 
			"РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямВерсии");
		СоответствиеИмен.Вставить("РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия", 
			"РегистрСведений.упоАктуальныеПланыТрудозатратСводноВерсии");
	КонецЕсли;	
	СоответствиеИмен.Вставить("РегистрСведений.упоВерсииПроекта", 
		"");
	
	Возврат СоответствиеИмен;
	
КонецФункции

Функция ТипВерсииСтрокойПоТипуПлана(ТипПлана) Экспорт
	
	Если ТипПлана = Перечисления.упоТипПланаПроекта.Договорной Тогда
		ТипВерсии = "Договорная";	
	ИначеЕсли ТипПлана = Перечисления.упоТипПланаПроекта.Базовый Тогда
		ТипВерсии = "Базовая";
	Иначе
		ТипВерсии = "Текущая";
	КонецЕсли;	
	
	Возврат ТипВерсии;
	
КонецФункции

Функция ТекстЗапросаДляПолученияДанныхПоТипуВерсии(ТипВерсии, ТекстЗапроса)
	
	ПолныйТекстЗапроса = Новый Массив;
	ВерсииВыбранногоТипа = ТекстЗапросаДляПолученияВерсийПоТипуВерсии();
	ВерсииВыбранногоТипа = СтрЗаменить(ВерсииВыбранногоТипа, "%ТипВерсии", ТипВерсии);
	ПолныйТекстЗапроса.Добавить(ВерсииВыбранногоТипа);
	ПолныйТекстЗапроса.Добавить(ОбщегоНазначения.РазделительПакетаЗапросов());
		
	ПолныйТекстЗапроса.Добавить(ТекстЗапроса);
	Возврат СтрСоединить(ПолныйТекстЗапроса);	
	
КонецФункции

Функция ТекстЗапросаДляПолученияВерсийПоТипуВерсии()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВерсииПроекта.Проект КАК Проект,
	               |	упоВерсииПроекта.Версия КАК Версия,
	               |	упоВерсииПроекта.Текущая КАК Текущая,
	               |	упоВерсииПроекта.ВерсияВключаетДанныеВыполнения КАК ВерсияВключаетДанныеВыполнения,
	               |	упоВерсииПроекта.%ТипВерсии КАК ТипВерсии
	               |ПОМЕСТИТЬ ВерсииПроектов
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	(упоВерсииПроекта.Текущая
	               |			ИЛИ упоВерсииПроекта.%ТипВерсии)
	               |{ГДЕ
	               |	упоВерсииПроекта.Проект.* КАК Проект}
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииПроектов.Проект КАК Проект,
	               |	ВерсииПроектов.Версия КАК Версия
	               |ПОМЕСТИТЬ ВерсииВыбранногоТипВерсии
	               |ИЗ
	               |	ВерсииПроектов КАК ВерсииПроектов
	               |ГДЕ
	               |	ВерсииПроектов.ТипВерсии
	               |	И ВерсииПроектов.ВерсияВключаетДанныеВыполнения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииПроектов.Проект КАК Проект,
	               |	ВерсииПроектов.Версия КАК Версия
	               |ПОМЕСТИТЬ ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе
	               |ИЗ
	               |	ВерсииПроектов КАК ВерсииПроектов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВерсииВыбранногоТипВерсии КАК ВерсииВыбранногоТипВерсии
	               |		ПО ВерсииПроектов.Проект = ВерсииВыбранногоТипВерсии.Проект
	               |ГДЕ
	               |	ВерсииВыбранногоТипВерсии.Проект ЕСТЬ NULL
	               |	И ВерсииПроектов.Текущая
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииВыбранногоТипВерсии.Проект КАК Проект,
	               |	ВерсииВыбранногоТипВерсии.Версия КАК Версия
	               |ПОМЕСТИТЬ ВерсииВыбранногоТипа
	               |ИЗ
	               |	ВерсииВыбранногоТипВерсии КАК ВерсииВыбранногоТипВерсии
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе.Проект,
	               |	ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе.Версия
	               |ИЗ
	               |	ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе КАК ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ЗаписатьСхемуВФайлXML(СКД, ИмяФайла, ПолучитьТекст = Ложь) Экспорт
// Функция также используется отдельно для отладочной записи СКД в файл.

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, 
		СКД, 
		"dataCompositionSchema", 
		"http://v8.1c.ru/8.1/data-composition-system/schema",
		НазначениеТипаXML.Явное);
		
	ЗаписьXML.Закрыть();
	
	Если ПолучитьТекст Тогда
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ИмяФайла);
		ТекстXML = ТекстДок.ПолучитьТекст();
		Возврат ТекстXML;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ВыгрузитьСхемуВФайлXML(АдресСхемыКомпоновкиДанных, УникальныйИдентификатор) Экспорт
			
	ИмяТемпФайла = ПолучитьИмяВременногоФайла("xml");
		
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
		
	ЗаписатьСхемуВФайлXML(СхемаКомпоновкиДанных, ИмяТемпФайла);
	
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяТемпФайла), УникальныйИдентификатор);
	
	Файл = Новый Файл(ИмяТемпФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяТемпФайла);
	КонецЕсли;
		
	Возврат АдресФайла; 
	
КонецФункции

Процедура ИзменитьТекстЗапросаОсновногоНабораДанныхСКДПоТипуПлана(ОсновнаяСхемаКомпоновки, ТипПлана, НастройкиЗаменыВерсии)
	
	Если Не ЗначениеЗаполнено(ТипПлана) 
		Или ТипПлана = НастройкиЗаменыВерсии.ТипПлана 
		И ТипЗнч(ТипПлана) = Тип("ПеречислениеСсылка.упоТипПланаПроекта") Тогда
		Возврат;		
	КонецЕсли;	
	
	Если ТипЗнч(ОсновнаяСхемаКомпоновки.НаборыДанных[0]) = Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных") Тогда
		
		Для Каждого ЭлементНабора Из ОсновнаяСхемаКомпоновки.НаборыДанных[0].Элементы Цикл
			
			Если ТипЗнч(ЭлементНабора) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда																					
				ЭлементНабора.Запрос = ВыполнитьЗаменуТипаВерсииВТекстеЗапроса(
															ЭлементНабора.Запрос,
															ТипПлана,
															НастройкиЗаменыВерсии);																					
			КонецЕсли;	
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ОсновнаяСхемаКомпоновки.НаборыДанных[0]) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда											
		ОсновнаяСхемаКомпоновки.НаборыДанных[0].Запрос = ВыполнитьЗаменуТипаВерсииВТекстеЗапроса(
															ОсновнаяСхемаКомпоновки.НаборыДанных[0].Запрос,
															ТипПлана,
															НастройкиЗаменыВерсии);
	КонецЕсли;				
	
КонецПроцедуры

Процедура ПрименитьНастройкуТипПлана(СтруктураНастроек, ОсновнаяСхемаКомпоновки, КомпоновщикНастроек) Экспорт
	
	Если СтруктураНастроек.Свойство("ТипПлана") Тогда
		// Перенос выбранной настройки формы в структуру настроек отчета.		
		ПН = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти("_ТипПлана_");
		Если ПН <> Неопределено Тогда
			СтруктураНастроек.ТипПлана = ПН.Значение;
		КонецЕсли;	
		
		Если СтруктураНастроек.Свойство("НастройкиЗаменыВерсии") Тогда
			НастройкиЗаменыВерсии = СтруктураНастроек.НастройкиЗаменыВерсии;
		Иначе
			НастройкиЗаменыВерсии = Новый Структура("ТипВерсии, ТипПлана", "Текущая", Перечисления.упоТипПланаПроекта.Текущий);
		КонецЕсли;	 
		ИзменитьТекстЗапросаОсновногоНабораДанныхСКДПоТипуПлана(ОсновнаяСхемаКомпоновки, СтруктураНастроек.ТипПлана, НастройкиЗаменыВерсии);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура УстановитьИерархиюПЗПоТипуВерсии(СКД, ОсновнойНаборДанных, СтруктураНастроек, Знач ТипВерсии, ОтборПоСценарию = Ложь)
						
	// Иерархия.
    ИмяПоляПЗДляИерархии = Неопределено;
	СтруктураНастроек.Свойство("ИмяПоляПЗДляИерархииПоВерсии", ИмяПоляПЗДляИерархии);		
	Если ИмяПоляПЗДляИерархии = Неопределено Тогда
		ИмяПоляПЗДляИерархии = "ПроектнаяЗадача";
	КонецЕсли;	
	
	ТекстЗапросаИерархия = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.Ссылка КАК ПроектнаяЗадача,
	|	Проекты.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу,
	|	Проекты.упоКорневойПроект КАК Проект,
	|	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача
	|ПОМЕСТИТЬ втОТбор
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|ГДЕ
	|	Проекты.Ссылка В(&ПроектныеЗадачи)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	|	втОтбор.ПроектнаяЗадача КАК %ИмяПоляПЗ,
	|	ЕСТЬNULL(Проекты.Ссылка, втОтбор.Проект) КАК ЗадачаРодитель,
	|	втОтбор.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу,
	|	втОтбор.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача
	|{ВЫБРАТЬ
	|	ПроектнаяЗадача.* КАК %ИмяПоляПЗ,
	|	ЗадачаРодитель.* КАК ЗадачаРодитель,
	|	СсылкаНаПроектнуюЗадачу,
	|	ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача}
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	|			{(НЕОПРЕДЕЛЕНО) КАК Поле2},
	|			ПроектнаяЗадача В
	|				(ВЫБРАТЬ
	|					втОТбор.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
	|				ИЗ
	|					втОТбор КАК втОТбор) {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	|			И (упоВерсииПроекта.%ТипВерсии)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОТбор КАК втОтбор
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = втОтбор.СсылкаНаПроектнуюЗадачу
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка))
	|			И упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = Проекты.СсылкаНаПроектнуюЗадачу
	|			И (НЕ Проекты.ПометкаУдаления)   
	| {ГДЕ
	|	втОтбор.ПроектнаяЗадача КАК %ИмяПоляПЗ,
	|	(ЕСТЬNULL(Проекты.Ссылка, втОтбор.Проект)) КАК ЗадачаРодитель}
	|
	| ОБЪЕДИНИТЬ ВСЕ
	| 
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	втОТбор.ПроектнаяЗадача,
	|	Значение(Справочник.Проекты.ПустаяСсылка),
	|	втОтбор.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу,
	|	втОтбор.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача
	|ИЗ
	|	втОТбор КАК втОТбор 
	|ГДЕ 
	|	НЕ втОТбор.ЭтоПроектнаяЗадача
	|{ГДЕ
	|	втОТбор.ПроектнаяЗадача КАК %ИмяПоляПЗ, 
	|	(ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)) КАК ЗадачаРодитель}";
	
	Если ОтборПоСценарию Тогда
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		ТекстЗапросаИерархия = СтрЗаменить(ТекстЗапросаИерархия, "%ТипВерсии", УсловиеОтбора);
	Иначе

		ТекстЗапросаИерархия = СтрЗаменить(ТекстЗапросаИерархия, "%ТипВерсии", ТипВерсии);
	КонецЕсли;
	
	ТекстЗапросаИерархия = СтрЗаменить(ТекстЗапросаИерархия, "%ИмяПоляПЗ", ИмяПоляПЗДляИерархии);

	НаборДанныхИерархия = ДобавитьНаборДанных(СКД, "Иерархия", "ИсточникДанных1", ТекстЗапросаИерархия, Ложь);
	ДобавитьПолеКомпоновки(НаборДанныхИерархия, "НазваниеЗадачи", "НазваниеЗадачи");
	ДобавитьПолеКомпоновки(НаборДанныхИерархия, ИмяПоляПЗДляИерархии, ИмяПоляПЗДляИерархии);
	ДобавитьПолеКомпоновки(НаборДанныхИерархия, "ЗадачаРодитель", "ЗадачаРодитель");
	ДобавитьПолеКомпоновки(НаборДанныхИерархия, "СсылкаНаПроектнуюЗадачу", "СсылкаНаПроектнуюЗадачу");
	
	ДобавитьСвязьНаборовДанных(СКД, 
		"Иерархия", 
		"Иерархия", 
		"ЗадачаРодитель", 
		ИмяПоляПЗДляИерархии, 
		Истина, 
		"ПроектныеЗадачи");
	
	ДобавитьСвязьНаборовДанных(СКД,
		ОсновнойНаборДанных,
		"Иерархия", 
		ИмяПоляПЗДляИерархии,           
		ИмяПоляПЗДляИерархии,
		Истина,
		"ПроектныеЗадачи");
	
	// Проверка иерархии.

	ТекстЗапросаПроверкаИерархии = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                               |	Проекты.Ссылка КАК ПроектнаяЗадача,
	                               |	Проекты.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу,
	                               |	Проекты.упоКорневойПроект КАК Проект
	                               |ПОМЕСТИТЬ втОТбор
	                               |ИЗ
	                               |	Справочник.Проекты КАК Проекты
	                               |ГДЕ
	                               |	Проекты.Ссылка В(&ПроектныеЭтапы)
	                               |;
	                               |
	                               |////////////////////////////////////////////////////////////////////////////////
	                               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                               |	Проекты.Ссылка КАК ПроектнаяЗадачаПроверкаИерархии,
	                               |	втОтбор.ПроектнаяЗадача КАК ЗадачаРодительПроверкаИерархии
	                               |{ВЫБРАТЬ
	                               |	ПроектнаяЗадачаПроверкаИерархии,
	                               |	ЗадачаРодительПроверкаИерархии}
	                               |ИЗ
	                               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК упоСвойстваПроектныхЗадачСрезПоследних
	                               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	                               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	                               |			И (упоВерсииПроекта.%ТипВерсии)
	                               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОТбор КАК втОтбор
	                               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = втОтбор.СсылкаНаПроектнуюЗадачу
	                               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка))
	                               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	                               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	                               |			И (НЕ Проекты.ПометкаУдаления)
	                               |
	                               |ОБЪЕДИНИТЬ ВСЕ
	                               |
	                               |ВЫБРАТЬ
	                               |	втОТбор.ПроектнаяЗадача,
	                               |	втОТбор.ПроектнаяЗадача
	                               |ИЗ
	                               |	втОТбор КАК втОТбор";

	Если ОтборПоСценарию Тогда
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		ТекстЗапросаПроверкаИерархии = СтрЗаменить(ТекстЗапросаПроверкаИерархии, "%ТипВерсии", УсловиеОтбора);
	Иначе
		ТекстЗапросаПроверкаИерархии = СтрЗаменить(ТекстЗапросаПроверкаИерархии, "%ТипВерсии", ТипВерсии);
	КонецЕсли;

	НаборДанныхПроверкаИерархии = ДобавитьНаборДанных(СКД, 
		"ПроверкаИерархии", 
		"ИсточникДанных1", 
		ТекстЗапросаПроверкаИерархии, 
		Ложь);
	
	ОграничениеИспользования = НовоеОграничениеИспользованияПоля();
	
	ДобавитьПолеКомпоновки(НаборДанныхПроверкаИерархии, 
		"ПроектнаяЗадачаПроверкаИерархии", 
		"ПроектнаяЗадачаПроверкаИерархии",
		,,,,,,,, 
		ОграничениеИспользования);
	ДобавитьПолеКомпоновки(НаборДанныхПроверкаИерархии, 
		"ЗадачаРодительПроверкаИерархии", 
		"ЗадачаРодительПроверкаИерархии",
		,,,,,,,, 
		ОграничениеИспользования);
	
	ДобавитьСвязьНаборовДанных(СКД, 
		"ПроверкаИерархии", 
		"ПроверкаИерархии", 
		"ПроектнаяЗадачаПроверкаИерархии", 
		"ЗадачаРодительПроверкаИерархии",
		Истина, 
		"ПроектныеЭтапы");
	
	ПоляОсновногоНабораДанных = СКД.НаборыДанных[ОсновнойНаборДанных].Поля;
	ПолеПроектнаяЗадача = ПоляОсновногоНабораДанных.Найти(ИмяПоляПЗДляИерархии);
	ПолеПроектнаяЗадача.НаборДанныхПроверкиИерархии 			= "ПроверкаИерархии";
	ПолеПроектнаяЗадача.ПараметрНабораДанныхПроверкиИерархии 	= "ПроектныеЭтапы";
	
КонецПроцедуры

Функция УсловиеОтбораВерсииПоВерсиямСценария(Знач ПсевдонимТаблицы = "") Экспорт
	
	ЗапросВыбораВерсииИзВТ = ТекстЗапросаВыбораВерсииИзВремТабВерсийПоСценарию();
	
	Если СтрДлина(ПсевдонимТаблицы) > 0 Тогда
		ШаблонУсловияОтбораПоВерсии = "%1.Версия В
		|%2";
	Иначе
		ШаблонУсловияОтбораПоВерсии = "Версия В
		|%2";
	КонецЕсли;
	
	ОтборПоВерсиямСценария = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонУсловияОтбораПоВерсии,
		ПсевдонимТаблицы,
		ЗапросВыбораВерсииИзВТ);
	
	Возврат ОтборПоВерсиямСценария;

КонецФункции

Функция ТекстЗапросаВыбораВерсииИзВремТабВерсийПоСценарию()
	
	ШаблонЗапросаВыбораВерсииИзВТ = 
	"			(ВЫБРАТЬ
	|				%1.Версия
	|			ИЗ
	|				%1 КАК %1)";
	ИмяВТ = ИмяВремТабВерсийПоСценарию();
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапросаВыбораВерсииИзВТ, ИмяВТ);
	Возврат ТекстЗапроса;
    
КонецФункции

Функция ТекстЗапросаВремТабСВерсиямиПоСценарию()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСценарииВерсий.Версия КАК Версия,
	               |	упоСценарииВерсий.Версия.Проект КАК Проект
	               |ПОМЕСТИТЬ ИМЯ_ВРЕМЕННОЙ_ТАБЛИЦЫ
	               |ИЗ
	               |	РегистрСведений.упоСценарииВерсий КАК упоСценарииВерсий
	               |ГДЕ
	               |	упоСценарииВерсий.Сценарий = &ТипПлана
	               |{ГДЕ
	               |	упоСценарииВерсий.Версия.Проект.*}";

	ИмяВременнойТаблицы = ИмяВремТабВерсийПоСценарию();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИМЯ_ВРЕМЕННОЙ_ТАБЛИЦЫ", ИмяВременнойТаблицы); 
	МассивТекстов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекстЗапроса);
	РазделительПакетаЗапросов = ОбщегоНазначения.РазделительПакетаЗапросов();
	МассивТекстов.Добавить(РазделительПакетаЗапросов);
	
	Возврат СтрСоединить(МассивТекстов);
		
КонецФункции 

Функция ЭтоОтборПоСценарию(ЗначениеПараметраОтбора) Экспорт

	Если ТипЗнч(ЗначениеПараметраОтбора) = Тип("СправочникСсылка.упоСценарии") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	

КонецФункции

Функция ТекстЗапросаДляПолученияДанныхПоСценарию(ТекстЗапроса)
		
	ПолныйТекстЗапроса = Новый Массив;
	ВерсииВыбранногоСценария = ТекстЗапросаДляПолученияВерсийПоСценарию();
	УсловиеОтбораВерсииПоВерсиямСценария = УсловиеОтбораВерсииПоВерсиямСценария();
	ВерсииВыбранногоСценария = СтрЗаменить(ВерсииВыбранногоСценария, "%ВерсииСценария", УсловиеОтбораВерсииПоВерсиямСценария);
	ПолныйТекстЗапроса.Добавить(ВерсииВыбранногоСценария);
	ПолныйТекстЗапроса.Добавить(ОбщегоНазначения.РазделительПакетаЗапросов());
		
	ПолныйТекстЗапроса.Добавить(ТекстЗапроса);
	Возврат СтрСоединить(ПолныйТекстЗапроса);	

КонецФункции

Функция ТекстЗапросаДляПолученияВерсийПоСценарию()
		
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВерсииПроекта.Проект КАК Проект,
	               |	упоВерсииПроекта.Версия КАК Версия,
	               |	упоВерсииПроекта.Текущая КАК Текущая,
	               |	упоВерсииПроекта.ВерсияВключаетДанныеВыполнения КАК ВерсияВключаетДанныеВыполнения
	               |ПОМЕСТИТЬ ВерсииПроектов
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	(упоВерсииПроекта.Текущая
	               |			ИЛИ упоВерсииПроекта.%ВерсииСценария)
	               |{ГДЕ
	               |	упоВерсииПроекта.Проект.* КАК Проект}
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииПроектов.Проект КАК Проект,
	               |	ВерсииПроектов.Версия КАК Версия
	               |ПОМЕСТИТЬ ВерсииВыбранногоТипВерсии
	               |ИЗ
	               |	ВерсииПроектов КАК ВерсииПроектов
	               |ГДЕ
	               |	ВерсииПроектов.%ВерсииСценария
	               |	И ВерсииПроектов.ВерсияВключаетДанныеВыполнения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииПроектов.Проект КАК Проект,
	               |	ВерсииПроектов.Версия КАК Версия
	               |ПОМЕСТИТЬ ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе
	               |ИЗ
	               |	ВерсииПроектов КАК ВерсииПроектов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВерсииВыбранногоТипВерсии КАК ВерсииВыбранногоТипВерсии
	               |		ПО ВерсииПроектов.Проект = ВерсииВыбранногоТипВерсии.Проект
	               |ГДЕ
	               |	ВерсииВыбранногоТипВерсии.Проект ЕСТЬ NULL
	               |	И ВерсииПроектов.Текущая
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВерсииВыбранногоТипВерсии.Проект КАК Проект,
	               |	ВерсииВыбранногоТипВерсии.Версия КАК Версия
	               |ПОМЕСТИТЬ ВерсииВыбранногоТипа
	               |ИЗ
	               |	ВерсииВыбранногоТипВерсии КАК ВерсииВыбранногоТипВерсии
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе.Проект,
	               |	ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе.Версия
	               |ИЗ
	               |	ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе КАК ТекущиеВерсииПроектовКоторыхНетВВыбранномТипе";
	
	Возврат ТекстЗапроса;

КонецФункции

Процедура ВставитьВТекстЗапросаВремТабСВерсиямиПоСценарию(ТекстЗапроса) Экспорт

	ТекстЗапросаВТВерсийПоСценарию = ТекстЗапросаВремТабСВерсиямиПоСценарию();
	МассивТекстов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекстЗапросаВТВерсийПоСценарию);
	МассивТекстов.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = СтрСоединить(МассивТекстов);

КонецПроцедуры

Функция ИмяВремТабВерсийПоСценарию()

