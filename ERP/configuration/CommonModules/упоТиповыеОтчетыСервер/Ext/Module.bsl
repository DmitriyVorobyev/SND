	Возврат "_ВТ_ВерсииПоСценарию";

КонецФункции	

#КонецОбласти

Процедура ДобавитьУсловноеОформлениеДляВыбранныхПолей(Настройки, Знач Поля, ФорматПоля, 
	ШиринаКолонок = Неопределено,
	ФорматПоляВыделятьОтрицательные = Неопределено,
	ГоризонтальноеПоложение = Неопределено)
	
	ЭлементыУсловногоОформления = Настройки.УсловноеОформление.Элементы;
	ПараметрыВывода = Настройки.ПараметрыВывода.Элементы;
	
	ЭлементУсловногоОформления = ЭлементыУсловногоОформления.Добавить();
	ЭлементУсловногоОформления.Использование = Истина;
	
	Если ЗначениеЗаполнено(ФорматПоля) Тогда
		Оформление = ЭлементУсловногоОформления.Оформление.Элементы.Найти("Формат");
		Оформление.Значение = ФорматПоля;
		Оформление.Использование = Истина; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ШиринаКолонок) Тогда
		Оформление = ЭлементУсловногоОформления.Оформление.Элементы.Найти("МинимальнаяШирина");
		Оформление.Значение = ШиринаКолонок;
		Оформление.Использование = Истина; 
		Оформление = ЭлементУсловногоОформления.Оформление.Элементы.Найти("МаксимальнаяШирина");
		Оформление.Значение = ШиринаКолонок;
		Оформление.Использование = Истина; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФорматПоляВыделятьОтрицательные) Тогда
		Оформление = ЭлементУсловногоОформления.Оформление.Элементы.Найти("ВыделятьОтрицательные");
		Оформление.Значение = ФорматПоляВыделятьОтрицательные;
		Оформление.Использование = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГоризонтальноеПоложение) Тогда
		Оформление = ЭлементУсловногоОформления.Оформление.Элементы.Найти("ГоризонтальноеПоложение");
		Оформление.Значение = ГоризонтальноеПоложение;
		Оформление.Использование = Истина;
	КонецЕсли;
	
	Если Не ТипЗнч(Поля) = Тип("Массив") Тогда
		Поля = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поля);
	КонецЕсли;
	
	Для Каждого ИмяПоля Из Поля Цикл
		ОформляемоеПоле = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Использование = Истина;
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьОтборВНастройки(ЭлементыОтбора, ОтборНастройкиКомпоновки, ДополнительныеПараметры = Неопределено) Экспорт
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") 
					И ДополнительныеПараметры.Свойство("НеКопироватьПоказатели") Тогда
										
				ИмяПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
				Если Лев(ИмяПоля, 1) = "_" Тогда
					Продолжить;
				КонецЕсли;	
					
			КонецЕсли;		
			
			НовыйЭлемент = ОтборНастройкиКомпоновки.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОтбора);
			
		Иначе
			
			НовыйЭлемент  = ОтборНастройкиКомпоновки.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОтбора);
			
			СкопироватьОтборВНастройки(ЭлементОтбора.Элементы, НовыйЭлемент.Элементы, ДополнительныеПараметры);
			
		КонецЕсли;		
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ЗаполнитьОтборПоОтборуКомпоновщика(Отбор, ОтборКомпоновщика, ПустоеЗначение) Экспорт 
    
    ЗаполнитьЗначенияСвойств(Отбор, ОтборКомпоновщика, "Использование, Представление");
    
    Если ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
        Отбор.ВидСравнения = ВидСравнения.Больше;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
        Отбор.ВидСравнения = ВидСравнения.БольшеИлиРавно;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
        Отбор.ВидСравнения = ВидСравнения.ВИерархии;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
        Отбор.ВидСравнения = ВидСравнения.ВСписке;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
        Отбор.ВидСравнения = ВидСравнения.ВСпискеПоИерархии;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
        Отбор.ВидСравнения = ВидСравнения.Меньше;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
        Отбор.ВидСравнения = ВидСравнения.МеньшеИлиРавно;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
        Отбор.ВидСравнения = ВидСравнения.НеВИерархии;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
        Отбор.ВидСравнения = ВидСравнения.НеВСписке;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
        Отбор.ВидСравнения = ВидСравнения.НеВСпискеПоИерархии;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
        Отбор.ВидСравнения = ВидСравнения.НеРавно;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
        Отбор.ВидСравнения = ВидСравнения.НеСодержит;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
        Отбор.ВидСравнения = ВидСравнения.Равно;
    ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда
        Отбор.ВидСравнения = ВидСравнения.Содержит;		
	ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
        Отбор.ВидСравнения = ВидСравнения.НеРавно;
	    Отбор.Значение = ПустоеЗначение;
		Возврат;
	ИначеЕсли ОтборКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
        Отбор.ВидСравнения = ВидСравнения.Равно;
	    Отбор.Значение = ПустоеЗначение;	
		Возврат;
    Иначе
       // Не нашли соответствие - не применяем отбор. 
        Отбор.Использование = Ложь;
        Возврат;
    КонецЕсли;
    
    Отбор.Значение = ОтборКомпоновщика.ПравоеЗначение;
    
КонецПроцедуры

Процедура УстановитьПользовательскийПараметр(НастройкиКомпоновки, 
											ИмяПараметра, 
											ЗначениеПараметра, 											
											ИдентификаторПН = Неопределено)
											
	Если ИдентификаторПН = Неопределено Тогда
		ИдентификаторПН = Новый УникальныйИдентификатор;
	КонецЕсли;	
											
	ПараметрПериод = НастройкиКомпоновки.ПараметрыДанных.Элементы.Добавить();
	ПараметрПериод.ИдентификаторПользовательскойНастройки 	= ИдентификаторПН;
	ПараметрПериод.Значение 								= ЗначениеПараметра;
	ПараметрПериод.Параметр 								= Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	ПараметрПериод.Использование 							= Истина; 
	ПараметрПериод.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;	
	
КонецПроцедуры

Процедура УстановитьФиксациюВТабличномДокументе(ТабличныйДокумент, ПараметрыВывода)
	
	// Обход бага рендеринга диаграмм (платформа 8.3.17): 
	// если в табличном документе с диаграммой есть фиксация, 
	// то диаграмма не отрисовывается, пока не начнешь прокрутку документа.
	ВДокументеЕстьДиаграмма = ТабличныйДокументСодержитДиаграмму(ТабличныйДокумент);
	Если ВДокументеЕстьДиаграмма Тогда
		СнятьФиксациюВТабличномДокументе(ТабличныйДокумент);
		Возврат;
	КонецЕсли;
	
	ГоризонтальноеРасположениеОбщихИтогов = ПараметрыВывода.Найти("ВертикальноеРасположениеОбщихИтогов");
	
	Если ГоризонтальноеРасположениеОбщихИтогов.Использование
		И (ГоризонтальноеРасположениеОбщихИтогов.Значение = РасположениеИтоговКомпоновкиДанных.НачалоИКонец
			Или ГоризонтальноеРасположениеОбщихИтогов.Значение = РасположениеИтоговКомпоновкиДанных.Начало) Тогда
		
		ТабличныйДокумент.ФиксацияСверху = ТабличныйДокумент.ФиксацияСверху + 1;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ТабличныйДокументСодержитДиаграмму(ТабличныйДокумент)
	
	ВДокументеЕстьДиаграмма = Ложь;
	Для Каждого РисунокДокумента Из ТабличныйДокумент.Рисунки Цикл
		Если РисунокДокумента.ТипРисунка = ТипРисункаТабличногоДокумента.Диаграмма Тогда
			ВДокументеЕстьДиаграмма = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ВДокументеЕстьДиаграмма;
	
КонецФункции

Процедура СнятьФиксациюВТабличномДокументе(ТабличныйДокумент)
	
	ТабличныйДокумент.ФиксацияСверху = 0;
	ТабличныйДокумент.ФиксацияСлева = 0;
	
КонецПроцедуры

#Область ДополнениеСКДПриИспользованииПолей

Процедура ДополнитьСКДПроцентыПЗ(СКД, ТипВерсии, ОсновнойНаборДанных, СтруктураНастроек, 
	ПроверятьИспользованиеПолей, КомпоновщикНастроек, ОтборПоСценарию = Ложь)
	
	Если ПроверятьИспользованиеПолей Тогда
		Если КомпоновщикНастроек = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		Если Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ПроцентГотовностиПроектнойЗадачи") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	// Добавим проценты готовности в основной набор.
	ОсновнойНабор = СКД.НаборыДанных.Найти(ОсновнойНаборДанных);
	ТекстЗапроса = ОсновнойНабор.Запрос;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	Оператор = ПакетЗапросов.Операторы[0];
	
	// Проценты.
	ИсточникПроцентыПЗ = Оператор.Источники.Добавить(
		"РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних", 
		"ПроцентыПЗ");
	ИсточникПроцентыПЗ.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникПроцентыПЗ.Источник.Параметры[1].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1 = ПроцентыПЗ.ПроектнаяЗадача", 
		СтруктураНастроек.ИмяПоляПЗДляСвязиСОсновнымНабором);
	Соединение = Оператор.Источники[0].Соединения.Добавить("ПроцентыПЗ", УсловиеСоединения);
	Оператор.Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
   	ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("ЕСТЬNULL(ПроцентыПЗ.ПроцентГотовности, 0)");
	ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ПроцентГотовностиПроектнойЗадачи";
	
	// Версии.
	ИсточникВерсияПроцентыПЗ = Оператор.Источники.Добавить(
		"РегистрСведений.упоВерсииПроекта", 
		"упоВерсииПроектаПроцентыПЗ");
	ИсточникВерсияПроцентыПЗ.Соединения.Очистить();
	ТекстУсловия = "ПроцентыПЗ.Версия = упоВерсииПроектаПроцентыПЗ.Версия И (упоВерсииПроектаПроцентыПЗ.%1)";

	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);	
	КонецЕсли;
	
	ДобавитьВнутреннееСоединениеВИсточник(ИсточникПроцентыПЗ, "упоВерсииПроектаПроцентыПЗ", УсловиеСоединения);
		
	Если Не ОсновнойНабор.АвтоЗаполнениеДоступныхПолей Тогда
		ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ПроцентГотовностиПроектнойЗадачи");	
	КонецЕсли;
	
	ТекстЗапросаПроценты = СхемаЗапроса.ПолучитьТекстЗапроса();

	ОсновнойНабор.Запрос = ТекстЗапросаПроценты;
	
	Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, "ЧДЦ=2;");
	
	ДобавитьПолеКомпоновки(ОсновнойНабор, "ПроцентГотовностиПроектнойЗадачи", 
												"ПроцентГотовностиПроектнойЗадачи", , , , , Оформление);
	
	// На уровне группировки "Проект" не рассчитываем процент готовности, т.к. не работает отбор по ПроектнойЗадаче.
	Группировки = Новый Массив;
	Группировки.Добавить("ПроектнаяЗадача");
	Группировки.Добавить("ПроектнаяЗадача Иерархия");
	ДобавитьПолеРесурса(СКД, "ПроцентГотовностиПроектнойЗадачи", "ПроцентГотовностиПроектнойЗадачи", Группировки);
	
	Группировки = Новый Массив;
	Группировки.Добавить("ОбщийИтог");
	// Для использования польз.полей без непосредственного вывода ПроцентаГотовностиПроектнойЗадачи подошел 
	// только такой расчет. ДобавитьПолеРесурса(СКД, "0", "ПроцентГотовностиПроектнойЗадачи", Группировки) - не работает.
	ДобавитьПолеРесурса(СКД, "ПроцентГотовностиПроектнойЗадачи*0", "ПроцентГотовностиПроектнойЗадачи", Группировки);
	
	// Добавим проценты готовности в иерархию.
	НаборИерархия = СКД.НаборыДанных.Найти("Иерархия");
	ТекстЗапроса = НаборИерархия.Запрос;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	// Поместим данные иерархии во временную таблицу, если не помещены.
	ПакетИерархия = СхемаЗапроса.ПакетЗапросов[1];
	ИмяИсточника = "ВТ_Иерархия";
	Если ПакетИерархия.ТаблицаДляПомещения = "" Тогда
		ПакетИерархия.ТаблицаДляПомещения = ИмяИсточника;
		ПакетЗапросовИерархияИтоговый = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		ОператорИерархияИтоговый = ПакетЗапросовИерархияИтоговый.Операторы[0];
		ОператорИерархияИтоговый.Источники.Добавить(ИмяИсточника, ИмяИсточника);
		Для Каждого Колонка Из ПакетИерархия.Колонки Цикл
			ИмяПоля = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", 
						ИмяИсточника, 
						Колонка.Псевдоним);
			ВыбранноеПоле = ОператорИерархияИтоговый.ВыбираемыеПоля.Добавить(ИмяПоля);
		КонецЦикла;	
	Иначе
		ПакетЗапросовИерархияИтоговый = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	КонецЕсли;
	Оператор = ПакетЗапросовИерархияИтоговый.Операторы[0];
	
	// Проценты ПЗ.
	ИсточникПроцентыПЗИерархия = Оператор.Источники.Добавить(
		"РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних", 
		"ПроцентыПЗ");
	ИсточникПроцентыПЗИерархия.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникПроцентыПЗИерархия.Источник.Параметры[1].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.СсылкаНаПроектнуюЗадачу = ПроцентыПЗ.ПроектнаяЗадача", 
		ИмяИсточника);
	Соединение = Оператор.Источники[0].Соединения.Добавить("ПроцентыПЗ", УсловиеСоединения);
	Оператор.Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
	
	// Версии ПЗ.
	ИсточникВерсияПроцентыПЗ = Оператор.Источники.Добавить("РегистрСведений.упоВерсииПроекта", 
															"упоВерсииПроектаПроцентыПЗ");
	ТекстУсловия = "ПроцентыПЗ.Версия = упоВерсииПроектаПроцентыПЗ.Версия И (упоВерсииПроектаПроцентыПЗ.%1)";

	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);
	КонецЕсли;
	
	ДобавитьВнутреннееСоединениеВИсточник(ИсточникПроцентыПЗИерархия, "упоВерсииПроектаПроцентыПЗ", УсловиеСоединения); 
		
	// Проценты проекта.
	ИсточникПроцентыПроектИерархия = Оператор.Источники.Добавить(
		"РегистрСведений.упоПроцентыГотовностиПроектов.СрезПоследних", 
		"ПроцентыПроект");
	ИсточникПроцентыПроектИерархия.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.ПроектнаяЗадача = ПроцентыПроект.Проект", 
		ИмяИсточника);
	Соединение = Оператор.Источники[0].Соединения.Добавить("ПроцентыПроект", УсловиеСоединения);
	Оператор.Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.ЛевоеВнешнее;
	
	// Версии проекта.
	ИсточникВерсияПроцентыПроект = Оператор.Источники.Добавить("РегистрСведений.упоВерсииПроекта", 
																"упоВерсииПроектаПроцентыПроект");
	ТекстУсловия = "ПроцентыПроект.Версия = упоВерсииПроектаПроцентыПроект.Версия И (упоВерсииПроектаПроцентыПроект.%1)";

	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);	
	КонецЕсли;
	
	ДобавитьВнутреннееСоединениеВИсточник(ИсточникПроцентыПроектИерархия, "упоВерсииПроектаПроцентыПроект", УсловиеСоединения); 

	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку("ВЫБОР
							|	КОГДА %1.ЭтоПроектнаяЗадача
							|		ТОГДА ЕСТЬNULL(ПроцентыПЗ.ПроцентГотовности, 0)
							|	ИНАЧЕ ЕСТЬNULL(ПроцентыПроект.ПроцентГотовности, 0)
							|КОНЕЦ",
							ИмяИсточника);
	ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
		"ПроцентГотовностиПроектнойЗадачи";
	
	Оператор.ВыраженияОтбораКомпоновкиДанных.Очистить();
	Для каждого ВыбираемоеПоле Из Оператор.ВыбираемыеПоля Цикл
		Оператор.ВыраженияОтбораКомпоновкиДанных.Добавить(ВыбираемоеПоле);
	КонецЦикла;
	
	ПакетЗапросовИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Очистить();
	Для каждого Колонка Из ПакетЗапросовИерархияИтоговый.Колонки Цикл
		ПакетЗапросовИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(Колонка);
	КонецЦикла;	
	
	ДобавитьПолеКомпоновки(НаборИерархия, 
							"ПроцентГотовностиПроектнойЗадачи", 
							"ПроцентГотовностиПроектнойЗадачи", 
							,
							,
							,
							,
							Оформление);
	
	ТекстЗапросаПроцентыИерархия = СхемаЗапроса.ПолучитьТекстЗапроса();
	НаборИерархия.Запрос = ТекстЗапросаПроцентыИерархия;
	
КонецПроцедуры

Процедура ДополнитьСКДСрокиПЗ(СКД, ТипВерсии, ОсновнойНаборДанных, СтруктураНастроек, 
	ПроверятьИспользованиеПолей, КомпоновщикНастроек, ОтборПоСценарию = Ложь)
	
	Если ПроверятьИспользованиеПолей Тогда
		Если КомпоновщикНастроек = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		Если Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ДатаНачала")
			И Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ДатаЗавершения")
			И Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ДатаНачалаПрогноз")
			И Не ПолеИспользуетсяВОтчете(КомпоновщикНастроек.Настройки, "ДатаЗавершенияПрогноз") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;	
	
	ОсновнойНабор = СКД.НаборыДанных.Найти(ОсновнойНаборДанных);
	ТекстЗапроса = ОсновнойНабор.Запрос;
	
	// Добавим сроки в основной набор.
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПакетЗапросов = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	Оператор = ПакетЗапросов.Операторы[0];
	
	// Сроки.
	ИсточникСрокиПЗ = Оператор.Источники.Добавить(
		"РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних", 
		"СрокиПЗ");
	ИсточникСрокиПЗ.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникСрокиПЗ.Источник.Параметры[1].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1 = СрокиПЗ.ПроектнаяЗадача", 
		СтруктураНастроек.ИмяПоляПЗДляСвязиСОсновнымНабором);
	Соединение = Оператор.Источники[0].Соединения.Добавить("СрокиПЗ", УсловиеСоединения);
	ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("СрокиПЗ.ДатаНачалаПлан");
	ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ДатаНачала";
	ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("СрокиПЗ.ДатаЗавершенияПлан");
	ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ДатаЗавершения";
	
	// Версии.
	ИсточникВерсияСрокиПЗ = Оператор.Источники.Добавить(
		"РегистрСведений.упоВерсииПроекта", 
		"упоВерсииПроектаСрокиПЗ");
	ИсточникВерсияСрокиПЗ.Соединения.Очистить();
	ТекстУсловия = "СрокиПЗ.Версия = упоВерсииПроектаСрокиПЗ.Версия И (упоВерсииПроектаСрокиПЗ.%1)";
	
	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);	
	КонецЕсли;
	
	ДобавитьВнутреннееСоединениеВИсточник(ИсточникСрокиПЗ, "упоВерсииПроектаСрокиПЗ", УсловиеСоединения);

	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		
		// Прогнозные сроки.
		ИсточникПрогнозныеСрокиПЗ = Оператор.Источники.Добавить(
			"РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних", 
			"ПрогнозныеСрокиПЗ");
		ИсточникПрогнозныеСрокиПЗ.Источник.Параметры[0].Выражение = 
			Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
		ИсточникПрогнозныеСрокиПЗ.Источник.Параметры[1].Выражение = 
			Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
		// Соединим левым соединением с таблицей СрокиПЗ, т.к. плановые сроки есть всегда.
		УсловиеСоединения = "СрокиПЗ.ПроектнаяЗадача = ПрогнозныеСрокиПЗ.ПроектнаяЗадача
		|  И СрокиПЗ.Версия = ПрогнозныеСрокиПЗ.Версия";
		Соединение = ИсточникСрокиПЗ.Соединения.Добавить("ПрогнозныеСрокиПЗ", УсловиеСоединения);
		ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("ПрогнозныеСрокиПЗ.ДатаНачалаПрогноз");
		ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ДатаНачалаПрогноз";
		ВыбранноеПоле =  Оператор.ВыбираемыеПоля.Добавить("ПрогнозныеСрокиПЗ.ДатаЗавершенияПрогноз");
		ПакетЗапросов.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = "ДатаЗавершенияПрогноз"; 
		
	КонецЕсли;
	
	Если Не ОсновнойНабор.АвтоЗаполнениеДоступныхПолей Тогда
		ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ДатаНачала");
		ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ДатаЗавершения");  
		
		Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
			ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ДатаНачалаПрогноз");
			ПакетЗапросов.ПоляВыбораКомпоновкиДанных.Добавить("ДатаЗавершенияПрогноз");
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапросаСроки = СхемаЗапроса.ПолучитьТекстЗапроса();

	ОсновнойНабор.Запрос = ТекстЗапросаСроки;
	
	Оформление = Новый Структура("ГоризонтальноеПоложение, Формат", ГоризонтальноеПоложение.Лево, ФорматПериодаДень());
	
	ДобавитьПолеКомпоновки(ОсновнойНабор, 
							"ДатаНачала", 
							"ДатаНачала", 
							, 
							, 
							, 
							, 
							Оформление);
							
	ДобавитьПолеКомпоновки(ОсновнойНабор, 
							"ДатаЗавершения", 
							"ДатаЗавершения",
							, 
							, 
							, 
							, 
							Оформление);
							
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
							
		ДобавитьПолеКомпоновки(ОсновнойНабор, 
								"ДатаНачалаПрогноз", 
								"ДатаНачалаПрогноз", 
								, 
								, 
								, 
								, 
								Оформление,
								НСтр("ru = 'Дата начала, прогноз'"));
								
		ДобавитьПолеКомпоновки(ОсновнойНабор, 
								"ДатаЗавершенияПрогноз", 
								"ДатаЗавершенияПрогноз",
								, 
								, 
								, 
								, 
								Оформление,
								НСтр("ru = 'Дата завершения, прогноз'"));   
	КонецЕсли;							
	
	Группировки = Новый Массив;
	Группировки.Добавить("ПроектнаяЗадача");
	Группировки.Добавить("ПроектнаяЗадача Иерархия");
	ДобавитьПолеРесурса(СКД, "ДатаНачала", "ДатаНачала", Группировки);
	ДобавитьПолеРесурса(СКД, "ДатаЗавершения", "ДатаЗавершения", Группировки); 
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		ДобавитьПолеРесурса(СКД, "ДатаНачалаПрогноз", "ДатаНачалаПрогноз", Группировки);
		ДобавитьПолеРесурса(СКД, "ДатаЗавершенияПрогноз", "ДатаЗавершенияПрогноз", Группировки);
	КонецЕсли;
	
	// Отключим вывод дат в общих итогах.
	Группировки = Новый Массив;
	Группировки.Добавить("ОбщийИтог");
	ДобавитьПолеРесурса(СКД, "0", "ДатаНачала", Группировки);
	ДобавитьПолеРесурса(СКД, "0", "ДатаЗавершения", Группировки);  
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		ДобавитьПолеРесурса(СКД, "0", "ДатаНачалаПрогноз", Группировки);
		ДобавитьПолеРесурса(СКД, "0", "ДатаЗавершенияПрогноз", Группировки);
	КонецЕсли;
		
	// Добавим сроки в иерархию.
	НаборИерархия = СКД.НаборыДанных.Найти("Иерархия");
	ТекстЗапроса = НаборИерархия.Запрос;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	// Поместим данные иерархии во временную таблицу, если не помещены.
	ПакетИерархия = СхемаЗапроса.ПакетЗапросов[1];
	ИмяИсточника = "ВТ_Иерархия";
	Если ПакетИерархия.ТаблицаДляПомещения = "" Тогда
		ПакетИерархия.ТаблицаДляПомещения = ИмяИсточника;
		ПакетЗапросовИерархияИтоговый = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		ОператорИерархияИтоговый = ПакетЗапросовИерархияИтоговый.Операторы[0];
		ОператорИерархияИтоговый.Источники.Добавить(ИмяИсточника, ИмяИсточника);
		Для Каждого Колонка Из ПакетИерархия.Колонки Цикл
			ИмяПоля = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", 
						ИмяИсточника, 
						Колонка.Псевдоним);
			ВыбранноеПоле = ОператорИерархияИтоговый.ВыбираемыеПоля.Добавить(ИмяПоля);
		КонецЦикла;	
	Иначе
		ПакетЗапросовИерархияИтоговый = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	КонецЕсли;
	
	// Сроки по проекту рассчитываем в отдельной временной таблице.
	ПакетСрокиПроекта = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
	СхемаЗапроса.ПакетЗапросов.Сдвинуть(ПакетСрокиПроекта, -1);
	ТекстЗапросаСрокиПроекта = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                               |    ВерсииПроекта.Проект КАК СсылкаНаПроект,
                               |    МИНИМУМ(ПлановыеСроки.ДатаНачалаПлан) КАК ДатаНачала,
                               |    МАКСИМУМ(ПлановыеСроки.ДатаЗавершенияПлан) КАК ДатаЗавершения
                               |ИЗ
                               |    РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК ПлановыеСроки
                               |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних({(НЕОПРЕДЕЛЕНО) КАК Поле2}, {(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}) КАК СвойстваПроектныхЗадач
                               |            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
                               |            ПО СвойстваПроектныхЗадач.Версия = ВерсииПроекта.Версия
                               |                И (ВерсииПроекта.%1)
                               |        ПО ПлановыеСроки.Версия = СвойстваПроектныхЗадач.Версия
                               |            И ПлановыеСроки.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
                               |            И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)
                               |{ГДЕ
                               |    ВерсииПроекта.Проект.* КАК СсылкаНаПроект}
                               |
                               |СГРУППИРОВАТЬ ПО
                               |    ВерсииПроекта.Проект";

	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		ТекстЗапросаСрокиПроекта = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапросаСрокиПроекта, УсловиеОтбора);
	Иначе	
		ТекстЗапросаСрокиПроекта = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапросаСрокиПроекта, ТипВерсии);	
	КонецЕсли;

	ПакетСрокиПроекта.УстановитьТекстЗапроса(ТекстЗапросаСрокиПроекта);
	ПакетСрокиПроекта.ТаблицаДляПомещения = "ВТ_СрокиПроекта";
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
	
		ПакетПрогнозныеСрокиПроекта = СхемаЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		СхемаЗапроса.ПакетЗапросов.Сдвинуть(ПакетПрогнозныеСрокиПроекта, -1);
		ТекстЗапросаПрогнозныеСрокиПроекта = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                               |    ВерсииПроекта.Проект КАК СсылкаНаПроект,
	                               |    МИНИМУМ(ПрогнозныеСроки.ДатаНачалаПрогноз) КАК ДатаНачалаПрогноз,
	                               |    МАКСИМУМ(ПрогнозныеСроки.ДатаЗавершенияПрогноз) КАК ДатаЗавершенияПрогноз
	                               |ИЗ
	                               |    РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних КАК ПрогнозныеСроки
	                               |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК СвойстваПроектныхЗадач
	                               |            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
	                               |            ПО СвойстваПроектныхЗадач.Версия = ВерсииПроекта.Версия
	                               |                И (ВерсииПроекта.%1)
	                               |        ПО ПрогнозныеСроки.Версия = СвойстваПроектныхЗадач.Версия
	                               |            И ПрогнозныеСроки.ПроектнаяЗадача = СвойстваПроектныхЗадач.ПроектнаяЗадача
	                               |            И (НЕ СвойстваПроектныхЗадач.ЗадачаОтменена)
	                               |ГДЕ
	                               |    (ПрогнозныеСроки.ДатаНачалаПрогноз <> ДАТАВРЕМЯ(1, 1, 1)
	                               |            ИЛИ ПрогнозныеСроки.ДатаЗавершенияПрогноз <> ДАТАВРЕМЯ(1, 1, 1))
	                               |
	                               |СГРУППИРОВАТЬ ПО
	                               |    ВерсииПроекта.Проект";

		Если ОтборПоСценарию Тогда 
			УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
			ТекстЗапросаПрогнозныеСрокиПроекта = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстЗапросаПрогнозныеСрокиПроекта, УсловиеОтбора);
		Иначе
			ТекстЗапросаПрогнозныеСрокиПроекта =
				упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапросаПрогнозныеСрокиПроекта, ТипВерсии);	
		КонецЕсли;

		ПакетПрогнозныеСрокиПроекта.УстановитьТекстЗапроса(ТекстЗапросаПрогнозныеСрокиПроекта);
		ПакетПрогнозныеСрокиПроекта.ТаблицаДляПомещения = "ВТ_ПрогнозныеСрокиПроекта";  
		
	КонецЕсли;
	
	// Сроки ПЗ.
	Оператор = ПакетЗапросовИерархияИтоговый.Операторы[0];
	
	ИсточникСрокиПЗИерархия = Оператор.Источники.Добавить(
		"РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних", 
		"СрокиПЗ");
	ИсточникСрокиПЗИерархия.Источник.Параметры[0].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
	ИсточникСрокиПЗИерархия.Источник.Параметры[1].Выражение = 
		Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.СсылкаНаПроектнуюЗадачу = СрокиПЗ.ПроектнаяЗадача", 
		ИмяИсточника);
	Соединение = Оператор.Источники[0].Соединения.Добавить("СрокиПЗ", УсловиеСоединения);
	
	// Версии ПЗ.
	ИсточникВерсияСрокиПЗ = Оператор.Источники.Добавить("РегистрСведений.упоВерсииПроекта", 
															"упоВерсииПроектаСрокиПЗ");
	ТекстУсловия = "СрокиПЗ.Версия = упоВерсииПроектаСрокиПЗ.Версия И (упоВерсииПроектаСрокиПЗ.%1)";
	
	Если ОтборПоСценарию Тогда 
		УсловиеОтбора = УсловиеОтбораВерсииПоВерсиямСценария();
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, УсловиеОтбора);
	Иначе	
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(ТекстУсловия, ТипВерсии);
	КонецЕсли;
	
	ДобавитьВнутреннееСоединениеВИсточник(ИсточникСрокиПЗИерархия, "упоВерсииПроектаСрокиПЗ", УсловиеСоединения); 
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		
		// Прогнозные сроки ПЗ.
		ИсточникПрогнозныеСрокиПЗИерархия = Оператор.Источники.Добавить(
			"РегистрСведений.упоПрогнозныеСрокиПроектныхЗадач.СрезПоследних", 
			"ПрогнозныеСрокиПЗ");
		ИсточникПрогнозныеСрокиПЗИерархия.Источник.Параметры[0].Выражение = 
			Новый ВыражениеСхемыЗапроса("{(НЕОПРЕДЕЛЕНО) КАК Поле2}");
		ИсточникПрогнозныеСрокиПЗИерархия.Источник.Параметры[1].Выражение = 
			Новый ВыражениеСхемыЗапроса("{(ПроектнаяЗадача) КАК СсылкаНаПроектнуюЗадачу}");
		// Соединим левым соединением с таблицей СрокиПЗ, т.к. плановые сроки есть всегда.
		УсловиеСоединения = "СрокиПЗ.ПроектнаяЗадача = ПрогнозныеСрокиПЗ.ПроектнаяЗадача
		|  И СрокиПЗ.Версия = ПрогнозныеСрокиПЗ.Версия";
		Соединение = ИсточникСрокиПЗИерархия.Соединения.Добавить("ПрогнозныеСрокиПЗ", УсловиеСоединения); 
		
	КонецЕсли;
	
	// Сроки проекта.
	ИсточникСрокиПроектИерархия = Оператор.Источники.Добавить(
		"ВТ_СрокиПроекта", 
		"ВТ_СрокиПроекта");
	УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.ПроектнаяЗадача = ВТ_СрокиПроекта.СсылкаНаПроект", 
		ИмяИсточника);
	Соединение = Оператор.Источники[0].Соединения.Добавить("ВТ_СрокиПроекта", УсловиеСоединения);
	
	ШаблонВыбранноеПоле = "ВЫБОР
							|	КОГДА %1.ЭтоПроектнаяЗадача
							|		ТОГДА ЕСТЬNULL(СрокиПЗ.ДатаНачалаПлан, 0)
							|	ИНАЧЕ ЕСТЬNULL(ВТ_СрокиПроекта.ДатаНачала, 0)
							|КОНЕЦ";
	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
							ШаблонВыбранноеПоле,
							ИмяИсточника,
							"ДатаНачала");
	ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
		"ДатаНачала";
	
	ШаблонВыбранноеПоле = "ВЫБОР
							|	КОГДА %1.ЭтоПроектнаяЗадача
							|		ТОГДА ЕСТЬNULL(СрокиПЗ.ДатаЗавершенияПлан, 0)
							|	ИНАЧЕ ЕСТЬNULL(ВТ_СрокиПроекта.ДатаЗавершения, 0)
							|КОНЕЦ";
	ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
							ШаблонВыбранноеПоле,
							ИмяИсточника,
							"ДатаЗавершения");
	ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
	ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
		"ДатаЗавершения";

	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков() Тогда
		
		// Прогнозные сроки проекта.
		ИсточникСрокиПроектИерархия = Оператор.Источники.Добавить(
			"ВТ_ПрогнозныеСрокиПроекта", 
			"ВТ_ПрогнозныеСрокиПроекта");
		УсловиеСоединения = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1.ПроектнаяЗадача = ВТ_ПрогнозныеСрокиПроекта.СсылкаНаПроект", 
			ИмяИсточника);
		Соединение = Оператор.Источники[0].Соединения.Добавить("ВТ_ПрогнозныеСрокиПроекта", УсловиеСоединения);
		
		ШаблонВыбранноеПоле = "ВЫБОР
								|	КОГДА %1.ЭтоПроектнаяЗадача
								|		ТОГДА ЕСТЬNULL(ПрогнозныеСрокиПЗ.ДатаНачалаПрогноз, 0)
								|	ИНАЧЕ ЕСТЬNULL(ВТ_ПрогнозныеСрокиПроекта.ДатаНачалаПрогноз, 0)
								|КОНЕЦ";
		ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
								ШаблонВыбранноеПоле,
								ИмяИсточника,
								"ДатаНачалаПрогноз");
		ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
		ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
			"ДатаНачалаПрогноз";
		
		ШаблонВыбранноеПоле = "ВЫБОР
								|	КОГДА %1.ЭтоПроектнаяЗадача
								|		ТОГДА ЕСТЬNULL(ПрогнозныеСрокиПЗ.ДатаЗавершенияПрогноз, 0)
								|	ИНАЧЕ ЕСТЬNULL(ВТ_ПрогнозныеСрокиПроекта.ДатаЗавершенияПрогноз, 0)
								|КОНЕЦ";
		ТекстВыбранноеПоле = упоФункцииОбщегоНазначенияКлиентСервер.ПодставитьПараметрыВСтроку(
								ШаблонВыбранноеПоле,
								ИмяИсточника,
								"ДатаЗавершенияПрогноз");
		ВыбранноеПоле = Оператор.ВыбираемыеПоля.Добавить(ТекстВыбранноеПоле);
		ПакетЗапросовИерархияИтоговый.Колонки[Оператор.ВыбираемыеПоля.Количество() - 1].Псевдоним = 
			"ДатаЗавершенияПрогноз";   
		
	КонецЕсли;
	
	Оператор.ВыраженияОтбораКомпоновкиДанных.Очистить();
	Для каждого ВыбираемоеПоле Из Оператор.ВыбираемыеПоля Цикл
		Оператор.ВыраженияОтбораКомпоновкиДанных.Добавить(ВыбираемоеПоле);
	КонецЦикла;
	
	ПакетЗапросовИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Очистить();
	Для каждого Колонка Из ПакетЗапросовИерархияИтоговый.Колонки Цикл
		ПакетЗапросовИерархияИтоговый.ПоляВыбораКомпоновкиДанных.Добавить(Колонка);
	КонецЦикла;	
	
	ДобавитьПолеКомпоновки(НаборИерархия, 
							"ДатаНачала", 
							"ДатаНачала", 
							,
							,
