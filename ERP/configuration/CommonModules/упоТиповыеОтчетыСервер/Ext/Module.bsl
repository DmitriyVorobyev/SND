КонецФункции

Функция ТекстЗапросаДляПолученияПоказателейОтставания()

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Проекты.Ссылка КАК ПроектнаяЗадача,
		|	ВЫБОР
		|		КОГДА НЕ упоСвойстваПроектныхЗадач.ЕдиницаНормированияДлительности = ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.ПустаяСсылка)
		|			ТОГДА упоСвойстваПроектныхЗадач.ЕдиницаНормированияДлительности
		|		КОГДА упоСвойстваПроектныхЗадач.ЕдиницаНормированияДлительности = ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.ПустаяСсылка)
		|				И НЕ Проекты.упоКорневойПроект.упоЕдиницаВремениПоУмолчанию = ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.ПустаяСсылка)
		|			ТОГДА Проекты.упоКорневойПроект.упоЕдиницаВремениПоУмолчанию
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.упоЕдиницыВремени.РабочийДень)
		|	КОНЕЦ КАК ЕдиницаНормированияДлительности,
		|	ВЫБОР
		|		КОГДА НЕ упоСвойстваПроектныхЗадач.КалендарьЗадачи = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
		|			ТОГДА упоСвойстваПроектныхЗадач.КалендарьЗадачи
		|		КОГДА упоСвойстваПроектныхЗадач.КалендарьЗадачи = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
		|				И НЕ КалендариПроектов.КалендарьПроекта = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
		|			ТОГДА КалендариПроектов.КалендарьПроекта
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
		|	КОНЕЦ КАК Календарь,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(&ДатаАктуальности, ДЕНЬ) > НАЧАЛОПЕРИОДА(СрокиБП.ДатаЗавершенияПлан, ДЕНЬ)
		|			ТОГДА НАЧАЛОПЕРИОДА(СрокиБП.ДатаЗавершенияПлан, ДЕНЬ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(&ДатаАктуальности, ДЕНЬ)
		|	КОНЕЦ КАК Дата1,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(&ДатаАктуальности, ДЕНЬ) > НАЧАЛОПЕРИОДА(СрокиБП.ДатаЗавершенияПлан, ДЕНЬ)
		|			ТОГДА НАЧАЛОПЕРИОДА(&ДатаАктуальности, ДЕНЬ)
		|		ИНАЧЕ НАЧАЛОПЕРИОДА(СрокиБП.ДатаЗавершенияПлан, ДЕНЬ)
		|	КОНЕЦ КАК Дата2,
		|	ВЫБОР
		|		КОГДА НАЧАЛОПЕРИОДА(&ДатаАктуальности, ДЕНЬ) > НАЧАЛОПЕРИОДА(СрокиБП.ДатаЗавершенияПлан, ДЕНЬ)
		|			ТОГДА 1
		|		ИНАЧЕ -1
		|	КОНЕЦ КАК ЗнакОтклонения,
		|	упоСвойстваПроектныхЗадач.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта
		|ПОМЕСТИТЬ ВТ_ЗадачиБП
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадач
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
		|		ПО (Версии.Версия = упоСвойстваПроектныхЗадач.Версия)
		|			И (Версии.Текущая)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		|		ПО упоСвойстваПроектныхЗадач.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК СрокиБП
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК ВерсииБП
		|			ПО (ВерсииБП.Версия = СрокиБП.Версия)
		|				И (ВерсииБП.Базовая)
		|		ПО упоСвойстваПроектныхЗадач.ПроектнаяЗадача = СрокиБП.ПроектнаяЗадача
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоКалендариПроектов.СрезПоследних КАК КалендариПроектов
		|		ПО (КалендариПроектов.Проект = Проекты.упоКорневойПроект)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК СтатусыПЗ
		|		ПО (СтатусыПЗ.Версия = упоСвойстваПроектныхЗадач.Версия)
		|			И (СтатусыПЗ.ПроектнаяЗадача = упоСвойстваПроектныхЗадач.ПроектнаяЗадача)
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(&ДатаАктуальности, ДЕНЬ) <> НАЧАЛОПЕРИОДА(СрокиБП.ДатаЗавершенияПлан, ДЕНЬ)
		|	И НЕ СрокиБП.ДатаЗавершенияПлан = ДАТАВРЕМЯ(1, 1, 1)
		|	И НЕ СтатусыПЗ.СтатусЗадачи В (ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Завершена), ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Закрыта))
		|	И НЕ упоСвойстваПроектныхЗадач.ЗадачаОтменена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА упоРабочиеКалендариСрезПоследних.День МЕЖДУ ВТ_ЗадачиБП.Дата1 И ВТ_ЗадачиБП.Дата2
		|				ТОГДА упоРабочиеКалендариСрезПоследних.КоличествоЧасов
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК КоличествоЧасов,
		|	ВТ_ЗадачиБП.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	ВТ_ЗадачиБП.ЕдиницаНормированияДлительности КАК ЕдиницаНормированияДлительности,
		|	ВТ_ЗадачиБП.Календарь КАК Календарь,
		|	ВТ_ЗадачиБП.Дата1 КАК Дата1,
		|	ВТ_ЗадачиБП.Дата2 КАК Дата2,
		|	ВТ_ЗадачиБП.ЗнакОтклонения КАК ЗнакОтклонения,
		|	ВТ_ЗадачиБП.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта
		|ПОМЕСТИТЬ ВТ_ЗадачиБПСЧасами
