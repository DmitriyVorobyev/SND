Процедура ДополнитьОтборКомпоновщикаРекурсивно(ЭлементыОтбораИсточника, КопируемыеЭлементыОтбора, ПоляИсключения)
	
	ЕстьОтбор = Ложь;
	Для Каждого Стр Из КопируемыеЭлементыОтбора Цикл
		Если Стр.Использование Тогда
			ЕстьОтбор = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОтбор Тогда
		Для Каждого ЭлементОтбор Из ЭлементыОтбораИсточника Цикл
			Если НЕ ТипЗнч(ЭлементОтбор) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				Если (ЭлементОтбор.Использование И Строка(ЭлементОтбор.ЛевоеЗначение) = "Проект") Тогда
					ЭлементОтбор.Использование = Ложь;
				КонецЕсли;
			Иначе
				ЭлементОтбор.Использование = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого КопируемыйЭлементОтбора Из КопируемыеЭлементыОтбора Цикл
		Если ПоляИсключения.Найти(КопируемыйЭлементОтбора.ЛевоеЗначение) = Неопределено Тогда
			ТипДобавляемогоЭлемента = ТипЗнч(КопируемыйЭлементОтбора);
			ЭлементОтбора = ЭлементыОтбораИсточника.Добавить(ТипДобавляемогоЭлемента);
			ЗаполнитьЗначенияСвойств(ЭлементОтбора, КопируемыйЭлементОтбора);
		КонецЕсли;
		
		Если ТипДобавляемогоЭлемента = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДополнитьОтборКомпоновщикаРекурсивно(ЭлементОтбора.Элементы, КопируемыйЭлементОтбора.Элементы, ПоляИсключения);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Имена полей сроков проектных задач.
//
// Параметры:
//  НастройкиОбъектаОтчета   - Структура - см. метод ПолучитьНастройкиОтчета() модуля объекта отчета.
// 
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаПолейСроковПроектныхЗадач(НастройкиОбъектаОтчета)
	
	ИменаКолонок = Новый Массив;
	
	НуженРасчетСроковПЗ = НастройкиОбъектаОтчета.Свойство("ИмяПоляПЗ")
		И НастройкиОбъектаОтчета.Свойство("Сроки");
	НуженРасчетСроковФактПЗ = НастройкиОбъектаОтчета.Свойство("ИмяПоляПЗ")
		И НастройкиОбъектаОтчета.Свойство("СрокиФакт");
	НуженРасчетСроковПоВерсии = НастройкиОбъектаОтчета.Свойство("ИмяПоляПЗ")
		И НастройкиОбъектаОтчета.Свойство("ВыборВерсии");
	
	ИспользуютсяПрогнозныеСроки = упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозныхСроков();
	
	Если НуженРасчетСроковПЗ Тогда
		ИменаКолонок.Добавить("ДатаНачала");
		ИменаКолонок.Добавить("ДатаЗавершения");
		Если ИспользуютсяПрогнозныеСроки Тогда
			ИменаКолонок.Добавить("ДатаНачалаПрогноз");
			ИменаКолонок.Добавить("ДатаЗавершенияПрогноз");
		КонецЕсли;
	КонецЕсли;
	
	Если НуженРасчетСроковФактПЗ Тогда
		ИменаКолонок.Добавить("ДатаНачалаФакт");
		ИменаКолонок.Добавить("ДатаЗавершенияФакт");
	КонецЕсли;
	
	Если НуженРасчетСроковПоВерсии Тогда
		КоличествоВерсий = НастройкиОбъектаОтчета.ВыборВерсии.СрокиПоВерсиям;
		Для НомерВерсии = 1 По КоличествоВерсий Цикл
			ИменаКолонок.Добавить("ДатаНачалаПоВерсии" + НомерВерсии);
			ИменаКолонок.Добавить("ДатаЗавершенияПоВерсии" + НомерВерсии);
			Если ИспользуютсяПрогнозныеСроки Тогда
				ИменаКолонок.Добавить("ДатаНачалаПрогнозПоВерсии" + НомерВерсии);
				ИменаКолонок.Добавить("ДатаЗавершенияПрогнозПоВерсии" + НомерВерсии);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ИменаКолонок;
	
КонецФункции

Процедура ЗаполнитьСписокВыбранныхПолей(ЗаполняемыйСписок, ВыбранныеПоля, ВыбранныеПоляВерхнийУровень, ИсключаяНеиспользуемые = Ложь) Экспорт
	
	Для Каждого ВыбранноеПоле Из ВыбранныеПоля Цикл
		Если ТипЗнч(ВыбранноеПоле) = Тип("ВыбранноеПолеКомпоновкиДанных") Тогда
			Если ИсключаяНеиспользуемые И ВыбранноеПоле.Использование Тогда
				ЗаполняемыйСписок.Вставить(ВыбранноеПоле.Поле, ВыбранныеПоляВерхнийУровень.Индекс(ВыбранноеПоле));
			ИначеЕсли Не ИсключаяНеиспользуемые Тогда
				ЗаполняемыйСписок.Вставить(ВыбранноеПоле.Поле, ВыбранныеПоляВерхнийУровень.Индекс(ВыбранноеПоле));
			КонецЕсли;
		ИначеЕсли ТипЗнч(ВыбранноеПоле) = Тип("ГруппаВыбранныхПолейКомпоновкиДанных") Тогда
			ЗаполнитьСписокВыбранныхПолей(ЗаполняемыйСписок, ВыбранноеПоле.Элементы, ВыбранныеПоляВерхнийУровень, ИсключаяНеиспользуемые);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьВыборПолейДополнительнойИнформации(НастройкиКомпоновкиДанных, НастройкиОбъектаОтчета)
	
	ТаблицаСодержащаяОсновныеНастройки = ТаблицаСодержащаяОсновныеНастройки(НастройкиКомпоновкиДанных);
	Если ТаблицаСодержащаяОсновныеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеПоляОтчета = Новый Соответствие;
	ВыбранныеПоляОтчетаНастройкиКомпоновки = НастройкиКомпоновкиДанных.Выбор.Элементы;
	ИсключаяНеиспользуемые = Истина;
	ЗаполнитьСписокВыбранныхПолей(ВыбранныеПоляОтчета, ВыбранныеПоляОтчетаНастройкиКомпоновки,
		ВыбранныеПоляОтчетаНастройкиКомпоновки, ИсключаяНеиспользуемые);
	
	ОсновныеКолонкиТаблицы = ТаблицаСодержащаяОсновныеНастройки.Колонки;
	ИменаПолейДляВыводаВДопИнформацию = ИменаПолейСроковПроектныхЗадач(НастройкиОбъектаОтчета);
	Для Каждого Колонка Из ОсновныеКолонкиТаблицы Цикл
		ПараметрНастройки = Колонка.ПараметрыВывода.Элементы.Найти("Заголовок");
		Если Не (ПараметрНастройки <> Неопределено И ПараметрНастройки.Значение = "ДополнительнаяИнформацияСроки") Тогда
			Продолжить;
		КонецЕсли;
		
		ВыбранныеПоляДопИнформации = Новый Соответствие;
		ВыбранныеПоляДопИнформацииНастройкиКомпоновки = Колонка.Выбор.Элементы;
		ЗаполнитьСписокВыбранныхПолей(ВыбранныеПоляДопИнформации, ВыбранныеПоляДопИнформацииНастройкиКомпоновки,
			ВыбранныеПоляДопИнформацииНастройкиКомпоновки);
		
		// Найдем поле сроков в колонке. Если есть, то отключаем использование. Иначе создаем и отключаем.
		БылаВключенаХотяБыОднаКолонка = Ложь;
		Для Каждого ИмяПоля Из ИменаПолейДляВыводаВДопИнформацию Цикл
			ИскомоеПолеВВыбранныхПоляхОтчета = Новый ПолеКомпоновкиДанных(ИмяПоля);
			ИндексНайденногоПоля = ВыбранныеПоляОтчета.Получить(ИскомоеПолеВВыбранныхПоляхОтчета);
			
			ИскомоеПолеВДопИнформации = Новый ПолеКомпоновкиДанных(ИмяПоля);
			ИндексНайденногоПоляВДопИнформации = ВыбранныеПоляДопИнформации.Получить(ИскомоеПолеВДопИнформации);
			Если ИндексНайденногоПоляВДопИнформации <> Неопределено Тогда
				Использование = ИндексНайденногоПоля <> Неопределено;
				ВыбранныеПоляДопИнформацииНастройкиКомпоновки[ИндексНайденногоПоляВДопИнформации].Использование =
					Использование;
				Если Использование И Не БылаВключенаХотяБыОднаКолонка Тогда
					БылаВключенаХотяБыОднаКолонка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Колонка.Использование = БылаВключенаХотяБыОднаКолонка;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьГруппировкуДопИнформации(КоллекцияГруппировокДляРазмещения, ИменаДобавляемыхПолей, ДобавитьВКонец = Ложь)
	
	Если ДобавитьВКонец Тогда
		ДополнительнаяИнформация = КоллекцияГруппировокДляРазмещения.Добавить();
		ДополнительнаяИнформация.Имя = "ДополнительнаяИнформацияСроки";
	Иначе
		ДополнительнаяИнформация = КоллекцияГруппировокДляРазмещения.Вставить(0);
		ДополнительнаяИнформация.Имя = "ДополнительнаяИнформацияСроки";
	КонецЕсли;
	
	ВариантИспользования = ДополнительнаяИнформация.ПараметрыВывода.Элементы.Найти("ВариантИспользованияГруппировки");
	ВариантИспользования.Использование = Истина;
	ВариантИспользования.Значение = ВариантИспользованияГруппировкиКомпоновкиДанных.ДополнительнаяИнформация;
	
	Для Каждого ИмяПоля Из ИменаДобавляемыхПолей Цикл
		НовоеПоле = ДополнительнаяИнформация.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		НовоеПоле.Использование = Истина;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаСодержащаяОсновныеНастройки(НастройкиКомпоновкиДанных)
	
	ТаблицаСодержащаяОсновныеНастройки = Неопределено;
	
	Для Каждого ЭлементСтруктуры Из НастройкиКомпоновкиДанных.Структура Цикл
		Если ЭлементСтруктуры.Имя = "Основная таблица" Тогда
			ТаблицаСодержащаяОсновныеНастройки = ЭлементСтруктуры;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаСодержащаяОсновныеНастройки;
	
КонецФункции

