#Область ПрограммныйИнтерфейс

// Функция возвращает наименование базовой версии.
// 
// Возвращаемое значение:
//  Строка - наименование базовой версии.
//
Функция ПолучитьНаименованиеБазовойВерсии() Экспорт
	
	Возврат НСтр("ru = 'Утвержденная версия'");
	
КонецФункции

// Функция возвращает наименование базовой версии для проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты	 - проект, для которого нужно верунть наименование базовой версии.
// 
// Возвращаемое значение:
//  Строка - наименование базовой версии.
//
Функция ПолучитьНаименованиеНовойВерсии(Проект) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(упоВерсииПроекта.Версия) КАК КоличествоВерсий
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	упоВерсииПроекта.Проект = &Проект
	               |	И НЕ упоВерсииПроекта.Системная
	               |	И НЕ упоВерсииПроекта.Текущая";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	КоличествоВерсий = 0;
	Если Выборка.Следующий() Тогда
		КоличествоВерсий = Выборка.КоличествоВерсий;
	КонецЕсли;
	
	Возврат НСтр("ru = 'Версия N'")+" "+Формат(КоличествоВерсий + 1, "ЧГ=0");
	
КонецФункции

// Получает наименование версии.
//
// Параметры:
//  Версия	 - ДокументСсылка.упоВерсияПланаПроекта - версия, для которой надо получить наименование.
//
// Возвращаемое значение:
//	Строка, Неопределено - наименование версии или Неопределено, если не нашли.
//
Функция ПолучитьНаименованиеВерсии(Версия) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоВерсииПроекта.НаименованиеВерсии
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	упоВерсииПроекта.Версия = &Версия";
	Запрос.УстановитьПараметр("Версия", Версия);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе     
		Возврат РезультатЗапроса.Выгрузить()[0].НаименованиеВерсии;
	КонецЕсли;
	
КонецФункции 

// Возвращает свойства версии.
//
// Параметры:
//  Версия	 -ДокументСсылка.упоВерсияПланаПроекта 	 - версия проекта.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - свойства версии
//
Функция ПолучитьДанныеВерсии(Версия) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоВерсииПроекта.Проект КАК Проект,
	               |	упоВерсииПроекта.Текущая КАК Текущая,
	               |	упоВерсииПроекта.Системная КАК Системная,
	               |	упоВерсииПроекта.Базовая КАК Базовая,
	               |	упоВерсииПроекта.НаименованиеВерсии КАК НаименованиеВерсии,
	               |	упоВерсииПроекта.Автор КАК Автор,
	               |	упоВерсииПроекта.ДатаОбновления КАК ДатаОбновления,
	               |	упоВерсииПроекта.Договорная КАК Договорная,
	               |	упоВерсииПроекта.ДатаСоздания КАК ДатаСоздания,
	               |	упоВерсииПроекта.Комментарий КАК Комментарий
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	упоВерсииПроекта.Версия = &Версия";
	
	ТаблицаВерсия = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Структура;
	Для Каждого Колонка Из ТаблицаВерсия.Колонки Цикл
		Результат.Вставить(Колонка.Имя);
	КонецЦикла;
	Если Результат.Количество() Тогда
		ЗаполнитьЗначенияСвойств(Результат, ТаблицаВерсия[0]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция возвращает текущую версию проекта или проектной задачи.
//
// Параметры:
//  Проект						 - СправочникСсылка.Проекты, ДокументСсылка.упоПроектнаяЗадача - 
//											проект или проектная задача, для которого нужно получить версию.
//  НеопределеноКогдаНеНайдено - Булево - признак того, что надо возвращать из функции Неопределено в случае,
//											когда текущая версия проекта не найдена. Если = Ложь, то возвращает
//											пустую ссылку ДокументСсылка.упоВерсияПланаПроекта.
//
// Возвращаемое значение:
//  ДокументСсылка.упоВерсияПланаПроекта, Неопределено - текущая версия проекта. Либо пустая ссылка или Неопределено,
//														 если установлен признак флНеопределеноКогдаНеНайдено.
//    
Функция ПолучитьТекущуюВерсиюПроекта(Проект, НеопределеноКогдаНеНайдено = Истина) Экспорт
	
	Если Не ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	ПустаяВерсия = Документы.упоВерсияПланаПроекта.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Проект) = Тип("СправочникСсылка.Проекты") Тогда
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Версия
		|ИЗ
		|	РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
		|ГДЕ
		|	Проект = &Проект
		|	И Текущая";
		
	ИначеЕсли ТипЗнч(Проект) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	ВерсииПроекта.Версия КАК Версия
		|ИЗ
		|	РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &Проект) КАК упоСвойстваПроектныхЗадач
		|		ПО ВерсииПроекта.Версия = упоСвойстваПроектныхЗадач.Версия
		|			И (ВерсииПроекта.Текущая)";
		
	Иначе
		
		Результат = НеопределеноКогдаНеНайдено(ПустаяВерсия, НеопределеноКогдаНеНайдено);
		Возврат Результат;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Версия;
	Иначе
		
		Результат = НеопределеноКогдаНеНайдено(ПустаяВерсия, НеопределеноКогдаНеНайдено);
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

// Возвращает базовую версию проекта.
//
// Параметры:
//  Проект						- СправочникСсылка.Проекты - проект, для которого нужно получить версию. 
//  НеопределеноКогдаНеНайдено 	- Булево - признак того, что надо возвращать из функции Неопределено в случае,
//											когда базовая версия проекта не найдена. Если = Ложь, то возвращает
//											пустую ссылку ДокументСсылка.упоВерсияПланаПроекта. 
//
// Возвращаемое значение:
//	ДокументСсылка.упоВерсияПланаПроекта, Неопределено - базовая версия проекта. Либо пустая ссылка или Неопределено,
//														 если установлен признак флНеопределеноКогдаНеНайдено.
//
Функция ПолучитьБазовуюВерсиюПроекта(Проект, НеопределеноКогдаНеНайдено = Истина) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Версия
		|ИЗ
		|	РегистрСведений.упоВерсииПроекта КАК ВерсииПроекта
		|ГДЕ
		|	Проект = &Проект
		|	И Базовая";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Версия;
	Иначе
		Если НеопределеноКогдаНеНайдено Тогда
			Возврат Неопределено;
		Иначе
			Возврат Документы.упоВерсияПланаПроекта.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

