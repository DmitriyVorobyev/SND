	               |	ВТ_Сводно.ДатаНачисления,
	               |	ВТ_Сводно.Статья,
	               |	ВТ_Сводно.СпособПривязки,
	               |	ВТ_Сводно.ПрофильРаспределения,
	               |	ВТ_Сводно.Заказ_ДоговорПодрядчика,
	               |	ВТ_Сводно.СобствСилы_Субподряд,
	               |	ВТ_Сводно.КонтрагентПодрядчик,
	               |	ВТ_Сводно.Контрагент,
	               |	ВТ_Сводно.Договор,
	               |	ВТ_Сводно.Валюта,
	               |	ВТ_Сводно.Подразделение,
	               |	ВТ_Сводно.Роль,
	               |	ВТ_Сводно.Номенклатура,
	               |	ВТ_Сводно.ЕдиницаИзмерения";
		
		Выборка  = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = ТаблицаДвижений.Добавить();				
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ВключитьСубпродуктыВПланДоходов = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(
		СвойстваПроведения.ПроектнаяЗадача, "ВключитьСубпродуктыВПланДоходов", Ложь);
	
	Если ВключитьСубпродуктыВПланДоходов 
		И РаспределениеНатурПоказателей = Ложь Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаСубпродукты.Контрагент КАК Контрагент,
		               |	ТаблицаСубпродукты.Договор КАК Договор,
		               |	ТаблицаСубпродукты.Валюта КАК Валюта,
		               |	ТаблицаСубпродукты.Ресурс КАК Ресурс,
		               |	ТаблицаСубпродукты.ЕдиницаНормирования КАК ЕдиницаНормирования,
		               |	ТаблицаСубпродукты.СтатьяДоходов КАК СтатьяДоходов,
		               |	ТаблицаСубпродукты.ОбщСтоимость КАК ОбщСтоимость,
		               |	ТаблицаСубпродукты.Количество КАК Количество,
		               |	ТаблицаСубпродукты.ПрофильРаспределения КАК ПрофильРаспределения,
		               |	ТаблицаСубпродукты.ДатаПривязки КАК ДатаПривязки,
		               |	ТаблицаСубпродукты.СпособПривязки КАК СпособПривязки,
		               |	ТаблицаСубпродукты.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения
		               |ПОМЕСТИТЬ ВТ_Субпродукты
		               |ИЗ
		               |	&ТаблицаСубпродукты КАК ТаблицаСубпродукты
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	&ТекущаяВерсия КАК Версия,
		               |	&Ссылка КАК ПроектнаяЗадача,
		               |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход) КАК ВидЭлемента,
		               |	ВТ_Субпродукты.Контрагент КАК Контрагент,
		               |	ВТ_Субпродукты.Договор КАК Договор,
		               |	ВТ_Субпродукты.Валюта КАК Валюта,
		               |	ВТ_Субпродукты.Ресурс КАК Номенклатура,
		               |	ВТ_Субпродукты.ЕдиницаНормирования КАК ЕдиницаИзмерения,
		               |	ВТ_Субпродукты.Количество КАК Количество,
		               |	ВТ_Субпродукты.ДатаПривязки КАК ДатаНачисления,
		               |	ВТ_Субпродукты.СтатьяДоходов КАК Статья,
		               |	ВТ_Субпродукты.СпособПривязки КАК СпособПривязки,
		               |	ВТ_Субпродукты.ПрофильРаспределения КАК ПрофильРаспределения,
		               |	ВТ_Субпродукты.ОбщСтоимость КАК СуммаВалютная,
		               |	ВТ_Субпродукты.ОбщСтоимость КАК Сумма
		               |ПОМЕСТИТЬ ВТ_Сводно
		               |ИЗ
		               |	ВТ_Субпродукты КАК ВТ_Субпродукты
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_Сводно.Версия КАК Версия,
		               |	ВТ_Сводно.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	ВТ_Сводно.ВидЭлемента КАК ВидЭлемента,
		               |	ВТ_Сводно.Контрагент КАК Контрагент,
		               |	ВТ_Сводно.Договор КАК Договор,
		               |	ВТ_Сводно.Валюта КАК Валюта,
		               |	ВТ_Сводно.Номенклатура КАК Номенклатура,
		               |	ВТ_Сводно.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		               |	СУММА(ВТ_Сводно.Количество) КАК Количество,
		               |	ВТ_Сводно.ДатаНачисления КАК ДатаНачисления,
		               |	ВТ_Сводно.Статья КАК Статья,
		               |	ВТ_Сводно.СпособПривязки КАК СпособПривязки,
		               |	ВТ_Сводно.ПрофильРаспределения КАК ПрофильРаспределения,
		               |	СУММА(ВТ_Сводно.СуммаВалютная) КАК СуммаВалютная,
		               |	СУММА(ВТ_Сводно.Сумма) КАК Сумма,
		               |	ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.Объемы) КАК ИсточникПлана
		               |ИЗ
		               |	ВТ_Сводно КАК ВТ_Сводно
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВТ_Сводно.Договор,
		               |	ВТ_Сводно.Валюта,
		               |	ВТ_Сводно.Номенклатура,
		               |	ВТ_Сводно.ЕдиницаИзмерения,
		               |	ВТ_Сводно.ДатаНачисления,
		               |	ВТ_Сводно.Статья,
		               |	ВТ_Сводно.СпособПривязки,
		               |	ВТ_Сводно.ПрофильРаспределения,
		               |	ВТ_Сводно.Версия,
		               |	ВТ_Сводно.ПроектнаяЗадача,
		               |	ВТ_Сводно.ВидЭлемента,
		               |	ВТ_Сводно.Контрагент";
		
		Выборка  = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = ТаблицаДвижений.Добавить();				
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;		
		
	КонецЕсли;
	
КонецПроцедуры

//

Процедура ЗаполнитьМассивыЗадачТрансляции(ЗадачиВключитьМатРесурсыВПланРасходов, ЗадачиВключитьДопЗатратыВПланРасходов, 
		ЗадачиВключитьСубпродуктыВПланДоходов, Версия, СписокЗадач)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТекущаяВерсия", Версия);
	Запрос.УстановитьПараметр("СписокЗадач", СписокЗадач);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьСубпродуктыВПланДоходов КАК ВключитьСубпродуктыВПланДоходов
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &ТекущаяВерсия
	               |				И ПроектнаяЗадача В (&СписокЗадач)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |ГДЕ
	               |	(упоСвойстваПроектныхЗадачСрезПоследних.ВключитьДопЗатратыВПланРасходов
	               |			ИЛИ упоСвойстваПроектныхЗадачСрезПоследних.ВключитьМатРесурсыВПланРасходов
	               |			ИЛИ упоСвойстваПроектныхЗадачСрезПоследних.ВключитьСубпродуктыВПланДоходов)";							
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ВключитьМатРесурсыВПланРасходов Тогда
				ЗадачиВключитьМатРесурсыВПланРасходов.Добавить(Выборка.ПроектнаяЗадача);
			КонецЕсли;	
			Если Выборка.ВключитьДопЗатратыВПланРасходов Тогда
				ЗадачиВключитьДопЗатратыВПланРасходов.Добавить(Выборка.ПроектнаяЗадача);
			КонецЕсли;
			Если Выборка.ВключитьСубпродуктыВПланДоходов Тогда
				ЗадачиВключитьСубпродуктыВПланДоходов.Добавить(Выборка.ПроектнаяЗадача);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;			
	
КонецПроцедуры	

Процедура ЗаполнитьТаблицуДвиженийРасходПоДаннымРегистров(ТаблицаДвижений, СвойстваПроведения, СвойстваПроекта)
	
	ЗадачиВключитьМатРесурсыВПланРасходов = СвойстваПроведения.ЗадачиВключитьМатРесурсыВПланРасходов;
	ЗадачиВключитьДопЗатратыВПланРасходов = СвойстваПроведения.ЗадачиВключитьДопЗатратыВПланРасходов;	
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваПроведения.Версия);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("СписокЗадач", СвойстваПроведения.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ИсточникПлана", Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Статья КАК Статья,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Валюта КАК Валюта,
	               |	упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Подразделение КАК Подразделение,
	               |	упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Роль КАК Роль,
				   |	ЕСТЬNULL(упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Сумма, упоДанныеПлановДоходовИРасходовСрезПоследних.Сумма) КАК Сумма,
	               |	ЕСТЬNULL(упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная, упоДанныеПлановДоходовИРасходовСрезПоследних.СуммаВалютная) КАК СуммаВалютная,
				   |	ВЫБОР
				   |		КОГДА упоДанныеПлановДоходовИРасходовСрезПоследних.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
				   |			ТОГДА упоДанныеПлановДоходовИРасходовСрезПоследних.ДатаПривязки
				   |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
				   |	КОНЕЦ КАК ДатаНачисления,
				   |	упоДанныеПлановДоходовИРасходовСрезПоследних.СпособПривязки КАК СпособПривязки,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Контрагент КАК КонтрагентПодрядчик,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Договор КАК Заказ_ДоговорПодрядчика,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Контрагент КАК Контрагент,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Договор КАК Договор,
	               |	&ИсточникПлана КАК ИсточникПлана,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.ПериодАгрегации КАК ПериодАгрегации
	               |ПОМЕСТИТЬ ВТ_Сводно
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановДоходовИРасходов.СрезПоследних(
	               |			,
	               |			Версия = &ТекущаяВерсия
	               |				И ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
	               |				И ПроектнаяЗадача В (&СписокЗадач)
	               |				И (ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы)
	               |					ИЛИ ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ПустаяСсылка))) КАК упоДанныеПлановДоходовИРасходовСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоДанныеПлановДоходовИРасходовПодразделения.СрезПоследних(
	               |				,
	               |				Версия = &ТекущаяВерсия
	               |					И ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
	               |					И ПроектнаяЗадача В (&СписокЗадач)
	               |					И (ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы)
	               |						ИЛИ ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ПустаяСсылка))) КАК упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних
	               |		ПО упоДанныеПлановДоходовИРасходовСрезПоследних.ИндексСтрокРаспределения = упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.ИндексСтрокиВладельца
	               |			И упоДанныеПлановДоходовИРасходовСрезПоследних.ПроектнаяЗадача = упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача
	               |			И (упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Сумма <> 0
	               |				ИЛИ упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная <> 0
	               |				ИЛИ упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Количество <> 0)
	               |ГДЕ
	               |	(упоДанныеПлановДоходовИРасходовСрезПоследних.Сумма <> 0
	               |			ИЛИ упоДанныеПлановДоходовИРасходовСрезПоследних.СуммаВалютная <> 0)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&ТекущаяВерсия КАК Версия,
	               |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход) КАК ВидЭлемента,
	               |	ВТ_Сводно.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВТ_Сводно.Статья КАК Статья,
	               |	ВТ_Сводно.Валюта КАК Валюта,
	               |	ВТ_Сводно.Подразделение КАК Подразделение,
	               |	ВТ_Сводно.Роль КАК Роль,
	               |	СУММА(ВТ_Сводно.Сумма) КАК Сумма,
	               |	СУММА(ВТ_Сводно.СуммаВалютная) КАК СуммаВалютная,
	               |	ВТ_Сводно.ДатаНачисления КАК ДатаНачисления,
	               |	ВТ_Сводно.СпособПривязки КАК СпособПривязки,
	               |	ВТ_Сводно.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ВТ_Сводно.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	ВТ_Сводно.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	               |	ВТ_Сводно.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	               |	ВТ_Сводно.Контрагент КАК Контрагент,
	               |	ВТ_Сводно.Договор КАК Договор,
	               |	ВТ_Сводно.ИсточникПлана КАК ИсточникПлана,
	               |	0 КАК Количество,
	               |	ВТ_Сводно.ПериодАгрегации КАК ПериодАгрегации
	               |ИЗ
	               |	ВТ_Сводно КАК ВТ_Сводно
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Сводно.Статья,
	               |	ВТ_Сводно.Валюта,
	               |	ВТ_Сводно.Подразделение,
	               |	ВТ_Сводно.Роль,
	               |	ВТ_Сводно.ДатаНачисления,
	               |	ВТ_Сводно.СпособПривязки,
	               |	ВТ_Сводно.ПрофильРаспределения,
	               |	ВТ_Сводно.СобствСилы_Субподряд,
	               |	ВТ_Сводно.КонтрагентПодрядчик,
	               |	ВТ_Сводно.Заказ_ДоговорПодрядчика,
	               |	ВТ_Сводно.Контрагент,
	               |	ВТ_Сводно.Договор,
	               |	ВТ_Сводно.ИсточникПлана,
	               |	ВТ_Сводно.ПроектнаяЗадача,
	               |	ВТ_Сводно.ПериодАгрегации";
		
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл		
		НоваяСтрока = ТаблицаДвижений.Добавить();			
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);		
	КонецЦикла;
	
