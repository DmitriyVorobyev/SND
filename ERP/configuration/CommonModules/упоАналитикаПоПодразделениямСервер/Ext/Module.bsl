	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДопЗатратыПоПодразделениям КАК ВТ_ДопЗатратыПоПодразделениям
	        |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеПоПериодам КАК ВТ_РаспределениеПоПериодам
	        |			ПО ВТ_ДопЗатратыПоПодразделениям.ИндексСтрокРаспределенияПоПериодам = ВТ_РаспределениеПоПериодам.ИндексСтрокиРаспределениеПоРолям
	        |		ПО ВТ_ДопЗатраты.ИндексСтрокРаспределения = ВТ_ДопЗатратыПоПодразделениям.ИндексСтрокиВладельца
	        |			И ВТ_ДопЗатраты.Отмена = ВТ_ДопЗатратыПоПодразделениям.Отмена
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ВТ_ДопЗатраты.Статья,
	        |	ВТ_ДопЗатратыПоПодразделениям.Подразделение,
	        |	ВТ_ДопЗатратыПоПодразделениям.Роль,
	        |	ВЫБОР
	        |		КОГДА ВТ_ДопЗатратыПоПодразделениям.Сумма ЕСТЬ NULL
	        |			ТОГДА ВТ_ДопЗатраты.Стоимость
	        |		ИНАЧЕ ВТ_ДопЗатратыПоПодразделениям.Сумма
	        |	КОНЕЦ,
	        |	ВЫБОР
	        |		КОГДА ВТ_ДопЗатратыПоПодразделениям.Сумма ЕСТЬ NULL
	        |			ТОГДА ВТ_ДопЗатраты.Стоимость
	        |		ИНАЧЕ ВТ_ДопЗатратыПоПодразделениям.Сумма
	        |	КОНЕЦ,
	        |	ВЫБОР
	        |		КОГДА &РасходыПоОбъемам
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_ДопЗатратыПоПодразделениям.СпособПривязки ЕСТЬ NULL
	        |						ТОГДА ВТ_ДопЗатраты.СпособПривязки
	        |					ИНАЧЕ ВТ_ДопЗатратыПоПодразделениям.СпособПривязки
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_ДопЗатраты.СпособПривязки
	        |	КОНЕЦ,
	        |	ВЫБОР
	        |		КОГДА &РасходыПоОбъемам
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_ДопЗатратыПоПодразделениям.ПрофильРаспределения ЕСТЬ NULL
	        |						ТОГДА ВТ_ДопЗатраты.ПрофильРаспределения
	        |					ИНАЧЕ ВТ_ДопЗатратыПоПодразделениям.ПрофильРаспределения
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_ДопЗатраты.ПрофильРаспределения
	        |	КОНЕЦ,
	        |	ВЫБОР
	        |		КОГДА &РасходыПоОбъемам
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_ДопЗатратыПоПодразделениям.ДатаПривязки ЕСТЬ NULL
	        |						ТОГДА ВТ_ДопЗатраты.ДатаПривязки
	        |					ИНАЧЕ ВТ_ДопЗатратыПоПодразделениям.ДатаПривязки
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_ДопЗатраты.ДатаПривязки
	        |	КОНЕЦ,
	        |	ВТ_ДопЗатраты.Контрагент,
	        |	ВТ_ДопЗатраты.Договор,
	        |	ВТ_ДопЗатратыПоПодразделениям.СобствСилы_Субподряд,
	        |	ВТ_ДопЗатраты.Контрагент,
	        |	ВТ_ДопЗатраты.Договор,
	        |	ВЫБОР
	        |		КОГДА ВТ_ДопЗатратыПоПодразделениям.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |			ТОГДА ЛОЖЬ
	        |		ИНАЧЕ ИСТИНА
	        |	КОНЕЦ
	        |ИЗ
	        |	ВТ_ДопЗатраты КАК ВТ_ДопЗатраты
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДопЗатратыПоПодразделениям КАК ВТ_ДопЗатратыПоПодразделениям
	        |		ПО ВТ_ДопЗатраты.ИндексСтрокРаспределения = ВТ_ДопЗатратыПоПодразделениям.ИндексСтрокиВладельца
	        |			И ВТ_ДопЗатраты.Отмена = ВТ_ДопЗатратыПоПодразделениям.Отмена
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	&ТекущаяВерсия КАК Версия,
	        |	&Ссылка КАК ПроектнаяЗадача,
	        |	ВТ_Сводно.Статья КАК Статья,
	        |	ВТ_Сводно.Подразделение КАК Подразделение,
	        |	ВТ_Сводно.Роль КАК Роль,
	        |	СУММА(ВТ_Сводно.Сумма) КАК Сумма,
	        |	СУММА(ВТ_Сводно.СуммаВалютная) КАК СуммаВалютная,
	        |	0 КАК Количество,
	        |	&ВалютаУправленческогоУчета КАК Валюта,
	        |	ВЫБОР
	        |		КОГДА ТИПЗНАЧЕНИЯ(ВТ_Сводно.СпособПривязки) = ТИП(Перечисление.упоСпособПривязкиРаспределения)
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_Сводно.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.НаДату)
	        |							ИЛИ ВТ_Сводно.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |						ТОГДА ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
	        |					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения)
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_Сводно.СпособПривязки
	        |	КОНЕЦ КАК СпособПривязки,
	        |	ВТ_Сводно.ПрофильРаспределения КАК ПрофильРаспределения,
	        |	ВТ_Сводно.ДатаНачисления КАК ДатаНачисления,
	        |	ВТ_Сводно.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	        |	ВТ_Сводно.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	        |	ВТ_Сводно.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	        |	ВТ_Сводно.Контрагент КАК Контрагент,
	        |	ВТ_Сводно.Договор КАК Договор,
	        |	&ИсточникПлана КАК ИсточникПлана,
	        |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Расход) КАК ВидОбъема
	        |ИЗ
	        |	ВТ_Сводно КАК ВТ_Сводно
	        |ГДЕ
	        |	ВТ_Сводно.Выводить
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_Сводно.КонтрагентПодрядчик,
	        |	ВТ_Сводно.Заказ_ДоговорПодрядчика,
	        |	ВТ_Сводно.СобствСилы_Субподряд,
	        |	ВТ_Сводно.Контрагент,
	        |	ВТ_Сводно.Договор,
	        |	ВТ_Сводно.ПрофильРаспределения,
	        |	ВТ_Сводно.ДатаНачисления,
	        |	ВТ_Сводно.Статья,
	        |	ВТ_Сводно.Подразделение,
	        |	ВТ_Сводно.Роль,
	        |	ВЫБОР
	        |		КОГДА ТИПЗНАЧЕНИЯ(ВТ_Сводно.СпособПривязки) = ТИП(Перечисление.упоСпособПривязкиРаспределения)
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_Сводно.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.НаДату)
	        |							ИЛИ ВТ_Сводно.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |						ТОГДА ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
	        |					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения)
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_Сводно.СпособПривязки
	        |	КОНЕЦ";
			
КонецФункции			

Функция ТекстРасходыТрансляцияДопзатрат_ДанныеРегистров()
	
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.ПериодРаспределения КАК Период,
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.ИндексСтрокиРаспределениеПоРолям КАК ИндексСтрокиРаспределениеПоРолям,
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.ИндексСтрокиРаспределенияРасходов КАК ИндексСтрокиРаспределенияРасходов,
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.Сумма КАК Сумма,
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.Количество КАК Количество
	        |ПОМЕСТИТЬ ВТ_РаспределениеПоПериодамДопЗатраты
	        |ИЗ
	        |	РегистрСведений.упоДанныеРаспределенияРасходовПоПериодам.СрезПоследних(
	        |			,
	        |			Версия = &ТекущаяВерсия
	        |				И ПроектнаяЗадача В
	        |					(ВЫБРАТЬ
	        |						ВТ_ЗадачиТрансляции.ПроектнаяЗадача КАК ПроектнаяЗадача
	        |					ИЗ
	        |						ВТ_ЗадачиТрансляции КАК ВТ_ЗадачиТрансляции
	        |					ГДЕ
	        |						ВТ_ЗадачиТрансляции.ВключитьДопЗатратыВПланРасходов)) КАК упоДанныеРаспределенияРасходовПоПериодамСрезПоследних
	        |ГДЕ
	        |	упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.ИндексСтрокиРаспределенияРасходов = &Неопределено
	        |	И упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.ИсточникПлана = &ИсточникПлана
	        |	И (упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.Сумма <> 0
	        |			ИЛИ упоДанныеРаспределенияРасходовПоПериодамСрезПоследних.Количество <> 0)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.СтатьяЗатрат КАК СтатьяЗатрат,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.ВидОперации КАК ВидОперации,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.КонтрагентДоходовРасходов КАК Контрагент,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.ДоговорДоходовРасходов КАК Договор,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.СпособПривязкиДоходовРасходов КАК СпособПривязки,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.ПрофильРаспределенияДоходовРасходов КАК ПрофильРаспределения,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.ДатаПривязкиДоходовРасходов КАК ДатаПривязки,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения,
	        |	упоДанныеПлановДополнительныхЗатратСрезПоследних.Сумма КАК Сумма
	        |ПОМЕСТИТЬ ВТ_ДопЗатраты
	        |ИЗ
	        |	РегистрСведений.упоДанныеПлановДополнительныхЗатрат.СрезПоследних(
	        |			,
