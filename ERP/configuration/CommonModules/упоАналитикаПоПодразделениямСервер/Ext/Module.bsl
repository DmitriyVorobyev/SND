			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Роль КАК Роль,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Номенклатура КАК Номенклатура,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Сумма КАК Сумма,
			               |	ВЫБОР
			               |		КОГДА &РасходыПоНатуральнымПоказателям
			               |			ТОГДА упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Количество
			               |		ИНАЧЕ 0
			               |	КОНЕЦ КАК Количество,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.ДатаПоступления КАК Период,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Сумма КАК СуммаВалютная,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Статья КАК Статья,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Договор КАК Заказ_ДоговорПодрядчика,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Контрагент КАК КонтрагентПодрядчик,
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.СобствСилы_Субподряд КАК СобствСилы_Субподряд
			               |ИЗ
			               |	Документ.упоСинхронизацияФактическиВыполненныхОбъемов.РасходныеОбъемы КАК упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы
			               |ГДЕ
			               |	упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.Ссылка = &Ссылка
			               |	И упоСинхронизацияФактическиВыполненныхОбъемовРасходныеОбъемы.ПроектнаяЗадача.Проект = &Проект";
					
			Если ТекстЗапроса <> Неопределено Тогда
				
				Запрос.Текст = ТекстЗапроса;
				Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
				Запрос.УстановитьПараметр("Проект", СвойстваПроведения.Проект);
				Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваПроведения.Версия);
				Запрос.УстановитьПараметр("РасходыПоНатуральнымПоказателям", СвойстваПроекта.РасходыПоНатуральнымПоказателям);
				
				ТаблицаРасходныхОбъемов = Запрос.Выполнить().Выгрузить();  
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТаблицаРасходныхОбъемов <> Неопределено Тогда
			
			упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаРасходныхОбъемов);
			
			Для Каждого СтркоаОбъемов Из ТаблицаРасходныхОбъемов Цикл
				
				НоваяСтрока = ДанныеДвижений.упоФактВыполненияОбъемовОбороты.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтркоаОбъемов);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//

// Добавляет обязательные строки по умолчанию в распределение доходных и расходных объемов.
// Параметры:
//	ЭтотОбъект - ДокументОбъект, УправляемаяФорма - объект.
//  ДополнительныеПараметрыРаспределения - Структура - параметры обработки таблиц распределения.
//	СвойстваПроекта - Структура - содержит настройки учета по подразделениям.
//	ТаблицыПроверки - Неопределено, Структура - содержит перечень таблиц проверки.
//	Отказ - Булево - признак отказа от проведения.
//
Процедура ПроверитьЗаполнитьРаспределениеОбъемов(ЭтотОбъект, ДополнительныеПараметрыРаспределения, 
	СвойстваПроекта = Неопределено, СтруктураСвойствПоУмолчанию = Неопределено, ТаблицыПроверки = Неопределено, Отказ) Экспорт							
	
	Если СвойстваПроекта = Неопределено Тогда
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ЭтотОбъект.Проект);	
	КонецЕсли;	
	
	СтруктураСвойствПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(ЭтотОбъект.Проект);	
		
	ПроверятьСубпродукты = ТаблицыПроверки = Неопределено Или ТаблицыПроверки.Свойство("Субпродукты");
	ПроверятьМатРесурсы = ТаблицыПроверки = Неопределено Или ТаблицыПроверки.Свойство("МатериальныеРесурсы");
	ПроверятьПланДоходов = ТаблицыПроверки = Неопределено Или ТаблицыПроверки.Свойство("ПланДоходов");
	ПроверятьПланРасходов = ТаблицыПроверки = Неопределено Или ТаблицыПроверки.Свойство("ПланРасходов");
	
	Если ПроверятьСубпродукты Тогда
				
		ТаблицаПоПодразделениям = Неопределено;
		ДополнительныеПараметрыРаспределения.Свойство("СубпродуктыТаблицаРаспределения", ТаблицаПоПодразделениям);
		
		ПроверитьЗаполнитьТаблицуРаспределения(ЭтотОбъект, ДополнительныеПараметрыРаспределения, СвойстваПроекта,
			СтруктураСвойствПоУмолчанию, "Субпродукты", ТаблицаПоПодразделениям, Отказ);
				
	КонецЕсли;
		
	Если ПроверятьМатРесурсы Тогда
					
		ТаблицаПоПодразделениям = Неопределено;
		ДополнительныеПараметрыРаспределения.Свойство("МатериальныеРесурсыТаблицаРаспределения", ТаблицаПоПодразделениям);
		
		ПроверитьЗаполнитьТаблицуРаспределения(ЭтотОбъект, ДополнительныеПараметрыРаспределения, СвойстваПроекта,
			СтруктураСвойствПоУмолчанию, "МатериальныеРесурсы", ТаблицаПоПодразделениям, Отказ); 
		
	КонецЕсли;	
	
	Если ПроверятьПланДоходов Тогда
		
		ТаблицаПоПодразделениям = Неопределено;
		ДополнительныеПараметрыРаспределения.Свойство("ПланДоходовТаблицаРаспределения", ТаблицаПоПодразделениям);				
		
		ПроверитьЗаполнитьТаблицуРаспределения(ЭтотОбъект, ДополнительныеПараметрыРаспределения, СвойстваПроекта,
			СтруктураСвойствПоУмолчанию, "ПланДоходов", ТаблицаПоПодразделениям, Отказ);                                  
		
	КонецЕсли;
	
	Если ПроверятьПланРасходов Тогда
		
		ТаблицаПоПодразделениям = Неопределено;
		ДополнительныеПараметрыРаспределения.Свойство("ПланРасходовТаблицаРаспределения", ТаблицаПоПодразделениям);				
		
		ПроверитьЗаполнитьТаблицуРаспределения(ЭтотОбъект, ДополнительныеПараметрыРаспределения, СвойстваПроекта,
			СтруктураСвойствПоУмолчанию, "ПланРасходов", ТаблицаПоПодразделениям, Отказ); 
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыПроверкиТаблицыРаспределения(ИмяТаблицыРаспределения, СвойстваПроекта, ЭтоПроектнаяЗадача)
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("РаспределениеОбъемов", 		Ложь);
	ПараметрыПроверки.Вставить("РаспределениеПотребностей", Ложь);
	ПараметрыПроверки.Вставить("РаспределениеДоходов", 		Ложь);
	ПараметрыПроверки.Вставить("РаспределениеРасходов", 	Ложь);
	ПараметрыПроверки.Вставить("ПроверитьЗаполнениеСпособаПривязки", Ложь);
	ПараметрыПроверки.Вставить("ПредставлениеТЧРаспределения", "");
	
	ПараметрыПроверки.РаспределениеОбъемов = 	ИмяТаблицыРаспределения = "РаспределениеОбъемов" 
													Или ИмяТаблицыРаспределения = "СубпродуктыПоПодразделениям";
	ПараметрыПроверки.РаспределениеПотребностей = ИмяТаблицыРаспределения = "РаспределениеПотребностей" 
													Или ИмяТаблицыРаспределения = "МатериальныеРесурсыПоПодразделениям";
	ПараметрыПроверки.РаспределениеДоходов = 	ИмяТаблицыРаспределения = "РаспределениеДоходов" 
													Или ИмяТаблицыРаспределения = "ПланДоходовПоПодразделениям";
	ПараметрыПроверки.РаспределениеРасходов =	ИмяТаблицыРаспределения = "РаспределениеРасходов" 
													Или ИмяТаблицыРаспределения = "ПланРасходовПоПодразделениям";	
													
	Если ПараметрыПроверки.РаспределениеОбъемов Тогда
		ПараметрыПроверки.ПроверитьЗаполнениеСпособаПривязки = СвойстваПроекта.ДоходыПоНатуральнымПоказателям;		
	ИначеЕсли ПараметрыПроверки.РаспределениеПотребностей Тогда
		ПараметрыПроверки.ПроверитьЗаполнениеСпособаПривязки = СвойстваПроекта.РасходыПоНатуральнымПоказателям;		
	КонецЕсли; 													
	
	ПараметрыПроверки.ПредставлениеТЧРаспределения = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(
																							ИмяТаблицыРаспределения, 
																							ЭтоПроектнаяЗадача);
	
	Возврат ПараметрыПроверки;
	
КонецФункции

Процедура ПроверитьЗаполнитьТаблицуРаспределения(ЭтотОбъект, 
												ДополнительныеПараметрыРаспределения,
												СвойстваПроекта, 
												СтруктураСвойствПоУмолчанию, 
												ОсновнаяТаблица, 
												ИмяТаблицыРаспределения, 
												Отказ)
	
	Если ИмяТаблицыРаспределения = Неопределено Тогда
		Возврат;	
	КонецЕсли; 
	
	ЭтоПроектнаяЗадача = ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоПроектнаяЗадача");
		
	ПараметрыПроверки = ПараметрыПроверкиТаблицыРаспределения(ИмяТаблицыРаспределения, 
																СвойстваПроекта, 
																ЭтоПроектнаяЗадача);	
		 		 		  	
	Если ((ПараметрыПроверки.РаспределениеПотребностей Или ПараметрыПроверки.РаспределениеРасходов) 
			И Не СвойстваПроекта.РасходыПоПодразделениям)
		Или (ПараметрыПроверки.РаспределениеДоходов И Не СвойстваПроекта.ДоходыПоПодразделениям) Тогда
		ЭтотОбъект[ИмяТаблицыРаспределения].Очистить();
	КонецЕсли;	
	
	// Временно закомментировано todo
	// ПериодыЗапланированныхТрудозатратПодразделениям = Новый Соответствие;
	
	Если ИмяТаблицыРаспределения = "РаспределениеПотребностей" Тогда
		
		ЗаписыватьРаспределениеПотребностей = СвойстваПроекта.РасходыПоОбъемам
			Или (СвойстваПроекта.РасходыПоПодразделениям И ЭтотОбъект.ВключитьМатРесурсыВПланРасходов);
			
		Если Не ЗаписыватьРаспределениеПотребностей Тогда
			ЭтотОбъект[ИмяТаблицыРаспределения].Очистить();
			Возврат;
		КонецЕсли;		
		
	КонецЕсли;

	Отбор = Новый Структура("ИндексСтрокиВладельца");
	
	Для Каждого СтрокаОсновнойТаблицы Из ЭтотОбъект[ОсновнаяТаблица] Цикл
		
		Если СтрокаОсновнойТаблицы.ИндексСтрокРаспределения = Неопределено Тогда
			СтрокаОсновнойТаблицы.ИндексСтрокРаспределения = 
				упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(ЭтотОбъект[ОсновнаяТаблица]);	
		КонецЕсли;
		
		Отбор.ИндексСтрокиВладельца = СтрокаОсновнойТаблицы.ИндексСтрокРаспределения;
		СтрокиРаспределения = ЭтотОбъект[ИмяТаблицыРаспределения].НайтиСтроки(Отбор);
		
		// Добавляем строки распределения по умолчанию.
				
		Если СтрокиРаспределения.Количество() = 0 Тогда
										
			ПараметрыПривязки = СпособПривязкиПрофильПоПараметрамПроверки(СтрокаОсновнойТаблицы, 
																			ПараметрыПроверки, 
																			СтруктураСвойствПоУмолчанию,
																			Отказ);
			
			Если Отказ Тогда				
				Прервать;				
			КонецЕсли;			
			
			НоваяСтрокаРаспр = ЭтотОбъект[ИмяТаблицыРаспределения].Добавить();
			
			ЗаполнитьСтрокуРаспределенияПоУмолчанию(СтрокаОсновнойТаблицы, 
													НоваяСтрокаРаспр,
													ПараметрыПроверки,
													ПараметрыПривязки,
													СтруктураСвойствПоУмолчанию,
													СвойстваПроекта);
																																		
		КонецЕсли; 			
		
		// Временно закомментировано todo
		// // Проверим запланированы ли трудозатраты по подразделениям в указанном периоде
		// ПроверитьРаспределениеТрудозатратПоПериодамПоПодразделениям(ОсновнаяТаблица, СтрокаОсновнойТаблицы,
		//	 СтрокиРаспределения, НоваяСтрокаРаспр, ЭтотОбъект, ПериодыЗапланированныхТрудозатратПодразделениям, Отказ);
		//
		// Если Отказ Тогда			
		//	 Прервать;			
		// КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция СпособПривязкиПрофильПоПараметрамПроверки(СтрокаОсновнойТаблицы, 
													ПараметрыПроверки, 
													СтруктураСвойствПоУмолчанию,
													Отказ)
			
	// Для включенных доходов/расходов по натуральным показателям необходимо обеспечить 
	// заполнение способа привязки/профиля в добавляемой строке распределения.			
	СпособПривязкиДР = СтрокаОсновнойТаблицы.СпособПривязки;
	ПрофильДР = СтрокаОсновнойТаблицы.ПрофильРаспределения;
	
	Результат = Новый Структура;
	Результат.Вставить("СпособПривязкиДР", 	СпособПривязкиДР);
	Результат.Вставить("ПрофильДР", 		ПрофильДР);
	
	Если Не ПараметрыПроверки.ПроверитьЗаполнениеСпособаПривязки Тогда
		Возврат Результат;
	КонецЕсли;	
		
	Если Не ЗначениеЗаполнено(СпособПривязкиДР) Тогда
		СпособПривязкиДР = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
		Результат.СпособПривязкиДР = СпособПривязкиДР;
	КонецЕсли;
			
	Если СпособПривязкиДР <> Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения Тогда					
		Возврат Результат;
	КонецЕсли;	
	
	//
	
	ЭтоРасход = ПараметрыПроверки.РаспределениеПотребностей 
				Или ПараметрыПроверки.РаспределениеРасходов;					
															
	Если Не ЗначениеЗаполнено(ПрофильДР) Тогда
		
		Если ЭтоРасход Тогда			
			ПрофильДРПоУмолчанию = СтруктураСвойствПоУмолчанию.ПрофильРасходовПоУмолчанию; 
		Иначе
			ПрофильДРПоУмолчанию = СтруктураСвойствПоУмолчанию.ПрофильДоходовПоУмолчанию;
		КонецЕсли;	
										
		ПрофильДР = ПрофильДРПоУмолчанию;
		
		Результат.ПрофильДР = ПрофильДР;
		
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ПрофильДР) Тогда
						
		ТекстСообщения = НСтр("ru = 'Для проведения задачи необходимо заполнить реквизит проекта ""%1"" '")
						+ НСтр("ru = 'или вручную добавить строки в таблице ""%2"".'"); 
 		
		Если ЭтоРасход Тогда
			СинонимРеквизитаПроекта = 
				Метаданные.Справочники.Проекты.Реквизиты.ПрофильРасходовПоУмолчанию.Синоним;	
		Иначе
			СинонимРеквизитаПроекта = 
				Метаданные.Справочники.Проекты.Реквизиты.ПрофильДоходовПоУмолчанию.Синоним;
		КонецЕсли;						
						
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			СинонимРеквизитаПроекта,
			ПараметрыПроверки.ПредставлениеТЧРаспределения);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		
	КонецЕсли;
										
	Возврат Результат;
	
КонецФункции // ()

Функция ЗаполнитьСтрокуРаспределенияПоУмолчанию(СтрокаОсновнойТаблицы, 
												СтрокаРаспределения, 
												ПараметрыПроверки, 
												ПараметрыПривязки, 
												СтруктураСвойствПоУмолчанию,
												СвойстваПроекта)				
	
	ДанныеОсновнойТаблицы = Новый Структура();
					
	ДанныеСтрокиРаспределения = Новый Структура;
	ДанныеСтрокиРаспределения.Вставить("ИндексСтрокиВладельца", СтрокаОсновнойТаблицы.ИндексСтрокРаспределения);
	ДанныеСтрокиРаспределения.Вставить("ПрофильРаспределения",	ПараметрыПривязки.ПрофильДР);
	ДанныеСтрокиРаспределения.Вставить("ДатаПривязки", 			СтрокаОсновнойТаблицы.ДатаПривязки);												
	
	СпособПривязкиРаспределения = 
		СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода(ПараметрыПривязки.СпособПривязкиДР);
	ДанныеСтрокиРаспределения.Вставить("СпособПривязки", СпособПривязкиРаспределения);
					
	Если ПараметрыПроверки.РаспределениеОбъемов Тогда
		
		ДанныеСтрокиРаспределения.Вставить("Сумма",  				СтрокаОсновнойТаблицы.ОбщСтоимость);
		ДанныеСтрокиРаспределения.Вставить("Роль", 					СтруктураСвойствПоУмолчанию.РольДоходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("СобствСилы_Субподряд", 	СтруктураСвойствПоУмолчанию.СССП_Доходы);
		ДанныеСтрокиРаспределения.Вставить("Подразделение", 		СтруктураСвойствПоУмолчанию.ПодразделениеДоходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("Количество",  			СтрокаОсновнойТаблицы.Количество);
			
	ИначеЕсли ПараметрыПроверки.РаспределениеПотребностей Тогда
		
		ДанныеСтрокиРаспределения.Вставить("Сумма",  				СтрокаОсновнойТаблицы.ОбщСтоимость);
		ДанныеСтрокиРаспределения.Вставить("Роль", 					СтруктураСвойствПоУмолчанию.РольРасходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("СобствСилы_Субподряд", 	СтруктураСвойствПоУмолчанию.СССП_Расходы);
		ДанныеСтрокиРаспределения.Вставить("Подразделение", 		СтруктураСвойствПоУмолчанию.ПодразделениеРасходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("Количество",  			СтрокаОсновнойТаблицы.Количество);
						
	ИначеЕсли ПараметрыПроверки.РаспределениеДоходов Тогда				
				
		ДанныеСтрокиРаспределения.Вставить("Сумма",  				СтрокаОсновнойТаблицы.Сумма);
		ДанныеСтрокиРаспределения.Вставить("Роль", 					СтруктураСвойствПоУмолчанию.РольДоходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("Подразделение", 		СтруктураСвойствПоУмолчанию.ПодразделениеДоходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("СобствСилы_Субподряд", 	СтруктураСвойствПоУмолчанию.СССП_Доходы);				
		ДанныеСтрокиРаспределения.Вставить("ИсточникПлана", 		СтрокаОсновнойТаблицы.ИсточникПлана);
							
	ИначеЕсли ПараметрыПроверки.РаспределениеРасходов Тогда
		
		ДанныеСтрокиРаспределения.Вставить("Сумма",  				СтрокаОсновнойТаблицы.Сумма);
		ДанныеСтрокиРаспределения.Вставить("Роль", 					СтруктураСвойствПоУмолчанию.РольРасходовПоУмолчанию);
		ДанныеСтрокиРаспределения.Вставить("СобствСилы_Субподряд", 	СтруктураСвойствПоУмолчанию.СССП_Расходы);
		ДанныеСтрокиРаспределения.Вставить("Подразделение", 		СтруктураСвойствПоУмолчанию.ПодразделениеРасходовПоУмолчанию);				
		ДанныеСтрокиРаспределения.Вставить("ИсточникПлана", 		СтрокаОсновнойТаблицы.ИсточникПлана);
		
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиентСервер.РаспределениеОбъемовСубподрядСобсСилыПриИзменении(ДанныеСтрокиРаспределения, 
																						СвойстваПроекта.ИспользоватьАналитикуКонтрагентДляСС);																																															
																							
	ЗаполнитьЗначенияСвойств(СтрокаРаспределения, ДанныеСтрокиРаспределения);
			
КонецФункции

Процедура ПроверитьРаспределениеТрудозатратПоПериодамПоПодразделениям(ОсновнаяТаблица, СтрокаОсновнойТаблицы,
	СтрокиРаспределения, НоваяСтрокаРаспр, ЭтотОбъект, ПериодыЗапланированныхТрудозатратПодразделениям, Отказ)
	
	// Проверяем строки только плана доходов, добавленные в ручную и со способом привязки на дату
	Если ОсновнаяТаблица <> "ПланДоходов" 
		Или СтрокаОсновнойТаблицы.ИндексСтрокРаспределенияИсходнойТЧ <> Неопределено
		Или СтрокаОсновнойТаблицы.СпособПривязки <> 
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиДоходаРасхода.НаДату") Тогда		
		Возврат;		
	КонецЕсли;	
		
	Если СтрокиРаспределения.Количество() = 0 И НоваяСтрокаРаспр <> Неопределено Тогда
		СтрокиРаспределения = Новый Массив;
		СтрокиРаспределения.Добавить(НоваяСтрокаРаспр);							
	КонецЕсли;
	
	Для Каждого Строка Из СтрокиРаспределения Цикл
		
		ПериодыТрудозатратПодразделения = 
			ПолучитьПериодыТрудозатратПодразделения(Строка, ЭтотОбъект, Отказ, ПериодыЗапланированныхТрудозатратПодразделениям);
			
		Если Отказ Тогда
			Прервать;		
		КонецЕсли;
			
		Если ПериодыТрудозатратПодразделения = Истина Тогда
			Продолжить;	
		КонецЕсли;
		
		ДатаПопалаВПериод = ДатаСодержитсяВПериода(СтрокаОсновнойТаблицы, ПериодыТрудозатратПодразделения);		
		Если Не ДатаПопалаВПериод Тогда
			ТекстСообщения = НСтр("ru = 'В плане доходов для подразделения ""%1"" не запланированы трудозатраты на дату %2.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				Строка.Подразделение, Формат(СтрокаОсновнойТаблицы.ДатаПривязки, "ДФ=dd.MM.yyyy"));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;			
			
КонецПроцедуры

Функция ПолучитьПериодыТрудозатратПодразделения(Строка, ЭтотОбъект, Отказ,
		ПериодыЗапланированныхТрудозатратПодразделениям)
	
	ПериодыТрудозатратПодразделения = ПериодыЗапланированныхТрудозатратПодразделениям[Строка.Подразделение];
	
	Если ПериодыТрудозатратПодразделения <> Неопределено Тогда
		Возврат ПериодыТрудозатратПодразделения;
	КонецЕсли;
	
	ПроверкаИзДокумента = ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоПроектнаяЗадача");
	СтрокиТР = ПолучитьСтрокиТРСПодразделением(ПроверкаИзДокумента, Строка, ЭтотОбъект);
	
	Если СтрокиТР.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'Для подразделения ""%1"" не запланированы трудозатраты.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			Строка.Подразделение);					
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);					
		Возврат Истина;
		
	КонецЕсли;
	
	ПоПрофилюРаспределения = Ложь;				
	МассивПериодов = Новый Массив;
	ПолучитьПериодыТР(ПроверкаИзДокумента, ПоПрофилюРаспределения, МассивПериодов, СтрокиТР, ЭтотОбъект);
	
	Если ПоПрофилюРаспределения Тогда
		// Если хоть одно подразделение распределено по профилю, то проверку не делаем.
		ПериодыЗапланированныхТрудозатратПодразделениям.Вставить(Строка.Подразделение, Истина);
		Возврат Истина;
	КонецЕсли;
	
	МассивПериодовУникальный = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПериодовУникальный, МассивПериодов, Истина);
	
	ПериодыЗапланированныхТрудозатратПодразделениям.Вставить(Строка.Подразделение, МассивПериодовУникальный);
	
	Возврат МассивПериодовУникальный;	
	
КонецФункции

Процедура ПолучитьПериодыТР(ПроверкаИзДокумента, ПоПрофилюРаспределения, МассивПериодов, СтрокиТР, ЭтотОбъект)
	
	Для Каждого СтрокаТР Из СтрокиТР Цикл
		
		Если СтрокаТР.СпособПривязки =
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения") Тогда
			
			ПоПрофилюРаспределения = Истина;
			Прервать;
			
		ИначеЕсли СтрокаТР.СпособПривязки =
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
			
			ЗаполнитьМассивПериодов(ПроверкаИзДокумента, МассивПериодов, СтрокаТР, ЭтотОбъект);			
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьМассивПериодов(ПроверкаИзДокумента, МассивПериодов, СтрокаТР, ЭтотОбъект)
	
	Если ПроверкаИзДокумента Тогда
		
		НайденныеСтроки = ЭтотОбъект.ТрудовыеРесурсыПоПериодам.НайтиСтроки(
			Новый Структура("ИндексСтрокиРаспределениеПоРолям", СтрокаТР.ИндексСтрокРаспределенияПоПериодам));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			МассивПериодов.Добавить(НайденнаяСтрока.Период);
		КонецЦикла;
		
	Иначе
		
		Для Каждого НайденнаяСтрока Из СтрокаТР.РаспределениеПоПериодам Цикл
			МассивПериодов.Добавить(НайденнаяСтрока.Период);
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтрокиТРСПодразделением(ПроверкаИзДокумента, Строка, ЭтотОбъект)
	
	Если ПроверкаИзДокумента Тогда
		СтрокиТР = ЭтотОбъект.ТрудовыеРесурсы.НайтиСтроки(Новый Структура("Подразделение", Строка.Подразделение));
	Иначе						
		СтрокиТР = Новый Массив;
		Трудозатраты = ЭтотОбъект.СвойстваТрудозатратДляПроверкиПланаДР;
		Если Трудозатраты <> Неопределено Тогда
			Для Каждого СтрокаТЗ Из Трудозатраты.СвойстваТрудозатратДляПроверкиПланаДР Цикл
				Если СтрокаТЗ.Подразделение = Строка.Подразделение Тогда
					СтрокиТР.Добавить(СтрокаТЗ);	
				КонецЕсли;
			КонецЦикла;							
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтрокиТР;
	
КонецФункции

Функция ДатаСодержитсяВПериода(СтрокаОсновнойТаблицы, ПериодыТрудозатратПодразделения)
	
	Для Каждого Период Из ПериодыТрудозатратПодразделения Цикл
		
		Если СтрокаОсновнойТаблицы.ДатаПривязки >= НачалоМесяца(Период) 
			И СтрокаОсновнойТаблицы.ДатаПривязки <= КонецМесяца(Период) Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции

// Добавляет обязательные строки по умолчанию в распределение доп.затрат.
// Параметры:
//	ЭтотОбъект - ДокументОбъект, УправляемаяФорма - объект.
//	СвойстваПроекта - Структура - содержит настройки учета по подразделениям.
//	ТаблицыПроверки - Неопределено, Структура - содержит перечень таблиц проверки.
//	Отказ - Булево - признак отказа от проведения.
//
Процедура ПроверитьЗаполнитьРаспределениеДопЗатрат(ЭтотОбъект, СвойстваПроекта = Неопределено, СтруктураСвойствПоУмолчанию = Неопределено, Отказ)
	
	Если СвойстваПроекта = Неопределено Тогда
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ЭтотОбъект.Проект);	
	КонецЕсли;	
	
	Если СтруктураСвойствПоУмолчанию = Неопределено Тогда
		СтруктураСвойствПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(ЭтотОбъект.Проект);							
	КонецЕсли;	
	
	Если ЭтотОбъект.ВключитьДопЗатратыВПланРасходов Тогда
		
		Если Не СвойстваПроекта.РасходыПоПодразделениям Тогда
			ЭтотОбъект.РаспределениеДополнительныхЗатрат.Очистить();
		КонецЕсли;	
		
		Для Каждого СтрокаДополнительныеЗатраты Из ЭтотОбъект.ДополнительныеЗатраты Цикл
			
			Если СтрокаДополнительныеЗатраты.ИндексСтрокРаспределения = Неопределено Тогда
				СтрокаДополнительныеЗатраты.ИндексСтрокРаспределения = 
				упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(ЭтотОбъект.ДополнительныеЗатраты);	
			КонецЕсли;
			
			Если ЭтотОбъект.РаспределениеДополнительныхЗатрат.Найти(СтрокаДополнительныеЗатраты.ИндексСтрокРаспределения, "ИндексСтрокиВладельца") = Неопределено Тогда
				
				НоваяСтрокаРаспр = ЭтотОбъект.РаспределениеДополнительныхЗатрат.Добавить();
				НоваяСтрокаРаспр.Сумма = СтрокаДополнительныеЗатраты.Стоимость;				
				НоваяСтрокаРаспр.ИндексСтрокиВладельца = СтрокаДополнительныеЗатраты.ИндексСтрокРаспределения;
								
				СпособПривязкиРаспределения = СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода(
					СтрокаДополнительныеЗатраты.СпособПривязкиДоходовРасходов);
				НоваяСтрокаРаспр.СпособПривязки = СпособПривязкиРаспределения;
											
				НоваяСтрокаРаспр.ПрофильРаспределения = СтрокаДополнительныеЗатраты.ПрофильРаспределенияДоходовРасходов;
				НоваяСтрокаРаспр.ДатаПривязки = СтрокаДополнительныеЗатраты.ДатаПривязкиДоходовРасходов;
				НоваяСтрокаРаспр.Подразделение = СтруктураСвойствПоУмолчанию.ПодразделениеРасходовПоУмолчанию;
				НоваяСтрокаРаспр.Роль = СтруктураСвойствПоУмолчанию.РольРасходовПоУмолчанию;
				НоваяСтрокаРаспр.СобствСилы_Субподряд = СтруктураСвойствПоУмолчанию.СССП_Расходы;
				
				упоПроектыИЗадачиОбщие.ПроверитьЗаполнениеСпособаПривязки(ЭтотОбъект, НоваяСтрокаРаспр, "РаспределениеДополнительныхЗатрат", 
						НСтр("ru = 'Распределение доп.затрат по подразделениям'"), Отказ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;						
	
КонецПроцедуры

// Получает таблицу движений для целей учета по подразделениям.
//
// Параметры:
//  ВидДвижения						 - Строка - "Доход" или "Расход".
//  СвойстваПроведения				 - Структура - свойства проведения.
//  РаспределениеБДР				 - Булево - признак распределения БДР.
//  РаспределениеНатурПоказателей	 - Булево - признак распределения натуральных показателей.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица движений.
//
Функция ПолучитьТаблицуДвиженийДляЦелейУчетаПоПодразделениям(ЭтотОбъект, ВидДвижения, Знач СвойстваПроведения, РаспределениеБДР,
	РаспределениеНатурПоказателей, ЭтоПроектнаяЗадача)  
	
	ТаблицаДвижений = упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру("упоАктуальныеПланыДоходовИРасходовПодразделения");
	
	ТаблицаКопия = ТаблицаДвижений.Скопировать();		
	
	Если ЭтоПроектнаяЗадача Тогда
		СрокиЗадач = Новый Соответствие;			
		СтруктураСроки = Новый Структура("ДатаНачала, ДатаЗавершения", СвойстваПроведения.НачДата, СвойстваПроведения.КонДата);
		СрокиЗадач.Вставить(СвойстваПроведения.ПроектнаяЗадача, Новый Структура("Результат", СтруктураСроки));
    Иначе
		СрокиЗадач = СвойстваПроведения.СрокиЗадач;
		
		СвойстваПроведения.Вставить("ЗадачиВключитьМатРесурсыВПланРасходов", Новый Массив);
		СвойстваПроведения.Вставить("ЗадачиВключитьДопЗатратыВПланРасходов", Новый Массив);
		СвойстваПроведения.Вставить("ЗадачиВключитьСубпродуктыВПланДоходов", Новый Массив);
		ЗаполнитьМассивыЗадачТрансляции(СвойстваПроведения.ЗадачиВключитьМатРесурсыВПланРасходов, 
			СвойстваПроведения.ЗадачиВключитьДопЗатратыВПланРасходов, 
			СвойстваПроведения.ЗадачиВключитьСубпродуктыВПланДоходов, 
			СвойстваПроведения.Версия, СвойстваПроведения.ПроектнаяЗадача);		
	КонецЕсли;		
		
	Если ВидДвижения = "Доход" Тогда
		Если ЭтоПроектнаяЗадача Тогда		
			ЗаполнитьТаблицуДвиженийДоходПоДаннымПЗ(ЭтотОбъект, ТаблицаКопия, СвойстваПроведения, РаспределениеБДР,
				РаспределениеНатурПоказателей);
		Иначе
			ЗаполнитьТаблицуДвиженийДоходПоДаннымРегистров(ТаблицаКопия, СвойстваПроведения, РаспределениеБДР, РаспределениеНатурПоказателей);
		КонецЕсли;	
	ИначеЕсли ВидДвижения = "Расход" Тогда
		Если ЭтоПроектнаяЗадача Тогда		
			ЗаполнитьТаблицуДвиженийРасходПоДаннымПЗ(ЭтотОбъект, ТаблицаКопия, СвойстваПроведения,
				СвойстваПроведения.СвойстваПроекта);
		Иначе
			ЗаполнитьТаблицуДвиженийРасходПоДаннымРегистров(ТаблицаКопия, СвойстваПроведения, 
				СвойстваПроведения.СвойстваПроекта);
		КонецЕсли;	
	КонецЕсли;
	
	упоАналитикаПоПодразделениямСервер.ЗаполнитьРаспределениеВТаблицеДоходовРасходов(ТаблицаДвижений, ТаблицаКопия, СрокиЗадач);				
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвижений);
	
	Возврат ТаблицаДвижений;
		
КонецФункции

Процедура ЗаполнитьТаблицуДвиженийРасходПоДаннымПЗ(ЭтотОбъект, ТаблицаДвижений, СвойстваПроведения, СвойстваПроекта)
	
	ТаблицаПланРасходов = ЭтотОбъект.ПланРасходов;
	ТаблицаРаспределениеРасходов = ЭтотОбъект.РаспределениеРасходов;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", СвойстваПроведения.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваПроведения.Версия);
	Запрос.УстановитьПараметр("ТаблицаПланРасходов", ТаблицаПланРасходов);	
	Запрос.УстановитьПараметр("ТаблицаРаспределениеРасходов", ТаблицаРаспределениеРасходов);	
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаПланРасходов.Статья КАК Статья,
	               |	ТаблицаПланРасходов.Контрагент КАК Контрагент,
	               |	ТаблицаПланРасходов.Договор КАК Договор,
	               |	ТаблицаПланРасходов.Валюта КАК Валюта,
	               |	ТаблицаПланРасходов.Сумма КАК Сумма,
	               |	ТаблицаПланРасходов.ДатаПривязки КАК ДатаПривязки,
	               |	ТаблицаПланРасходов.СпособПривязки КАК СпособПривязки,
	               |	ТаблицаПланРасходов.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ТаблицаПланРасходов.ИсточникПлана КАК ИсточникПлана,
	               |	ТаблицаПланРасходов.ПериодАгрегации КАК ПериодАгрегации,
	               |	ТаблицаПланРасходов.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения
	               |ПОМЕСТИТЬ ВТ_ПланРасходов
	               |ИЗ
	               |	&ТаблицаПланРасходов КАК ТаблицаПланРасходов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаРаспределениеРасходов.Подразделение КАК Подразделение,
	               |	ТаблицаРаспределениеРасходов.Роль КАК Роль,
	               |	ТаблицаРаспределениеРасходов.Сумма КАК Сумма,
	               |	ТаблицаРаспределениеРасходов.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	ТаблицаРаспределениеРасходов.ИндексСтрокиВладельца КАК ИндексСтрокиВладельца
	               |ПОМЕСТИТЬ ВТ_РаспределениеРасходов
	               |ИЗ
	               |	&ТаблицаРаспределениеРасходов КАК ТаблицаРаспределениеРасходов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&ТекущаяВерсия КАК Версия,
	               |	&Ссылка КАК ПроектнаяЗадача,
	               |	ВТ_ПланРасходов.Статья КАК Статья,
	               |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход) КАК ВидЭлемента,
	               |	ВТ_ПланРасходов.Валюта КАК Валюта,
	               |	ВТ_РаспределениеРасходов.Подразделение КАК Подразделение,
	               |	ВТ_РаспределениеРасходов.Роль КАК Роль,
	               |	ВЫБОР
	               |		КОГДА ВТ_РаспределениеРасходов.Сумма ЕСТЬ NULL
	               |			ТОГДА ВТ_ПланРасходов.Сумма
	               |		ИНАЧЕ ВТ_РаспределениеРасходов.Сумма
	               |	КОНЕЦ КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ВТ_РаспределениеРасходов.Сумма ЕСТЬ NULL
	               |			ТОГДА ВТ_ПланРасходов.Сумма
	               |		ИНАЧЕ ВТ_РаспределениеРасходов.Сумма
	               |	КОНЕЦ КАК СуммаВалютная,
	               |	0 КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПланРасходов.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
	               |			ТОГДА ВТ_ПланРасходов.ДатаПривязки
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	               |	КОНЕЦ КАК ДатаНачисления,
	               |	ВТ_ПланРасходов.СпособПривязки КАК СпособПривязки,
	               |	ВТ_ПланРасходов.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ВТ_РаспределениеРасходов.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	ВТ_ПланРасходов.Контрагент КАК КонтрагентПодрядчик,
	               |	ВТ_ПланРасходов.Договор КАК Заказ_ДоговорПодрядчика,
	               |	ВТ_ПланРасходов.Контрагент КАК Контрагент,
	               |	ВТ_ПланРасходов.Договор КАК Договор,
	               |	ВТ_ПланРасходов.ИсточникПлана КАК ИсточникПлана,
	               |	ВТ_ПланРасходов.ПериодАгрегации КАК ПериодАгрегации
	               |ПОМЕСТИТЬ ВТ_Сводно
	               |ИЗ
	               |	ВТ_ПланРасходов КАК ВТ_ПланРасходов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеРасходов КАК ВТ_РаспределениеРасходов
	               |		ПО ВТ_ПланРасходов.ИндексСтрокРаспределения = ВТ_РаспределениеРасходов.ИндексСтрокиВладельца
	               |ГДЕ
	               |	ВТ_ПланРасходов.ИсточникПлана <> ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Сводно.Версия КАК Версия,
	               |	ВТ_Сводно.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВТ_Сводно.Статья КАК Статья,
	               |	ВТ_Сводно.ВидЭлемента КАК ВидЭлемента,
	               |	ВТ_Сводно.Валюта КАК Валюта,
	               |	ВТ_Сводно.Подразделение КАК Подразделение,
	               |	ВТ_Сводно.Роль КАК Роль,
	               |	СУММА(ВТ_Сводно.Сумма) КАК Сумма,
	               |	СУММА(ВТ_Сводно.СуммаВалютная) КАК СуммаВалютная,
	               |	СУММА(ВТ_Сводно.Количество) КАК Количество,
	               |	ВТ_Сводно.ДатаНачисления КАК ДатаНачисления,
	               |	ВТ_Сводно.СпособПривязки КАК СпособПривязки,
	               |	ВТ_Сводно.ПрофильРаспределения КАК ПрофильРаспределения,
	               |	ВТ_Сводно.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	ВТ_Сводно.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	               |	ВТ_Сводно.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	               |	ВТ_Сводно.Контрагент КАК Контрагент,
	               |	ВТ_Сводно.Договор КАК Договор,
	               |	ВЫБОР
	               |		КОГДА ВТ_Сводно.ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ПустаяСсылка)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы)
	               |		ИНАЧЕ ВТ_Сводно.ИсточникПлана
	               |	КОНЕЦ КАК ИсточникПлана,
	               |	ВТ_Сводно.ПериодАгрегации КАК ПериодАгрегации
	               |ИЗ
	               |	ВТ_Сводно КАК ВТ_Сводно
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Сводно.Версия,
	               |	ВТ_Сводно.ПроектнаяЗадача,
	               |	ВТ_Сводно.Статья,
	               |	ВТ_Сводно.ВидЭлемента,
	               |	ВТ_Сводно.Валюта,
	               |	ВТ_Сводно.Подразделение,
	               |	ВТ_Сводно.Роль,
	               |	ВТ_Сводно.ДатаНачисления,
	               |	ВТ_Сводно.СпособПривязки,
	               |	ВТ_Сводно.ПрофильРаспределения,
	               |	ВТ_Сводно.СобствСилы_Субподряд,
	               |	ВТ_Сводно.КонтрагентПодрядчик,
	               |	ВТ_Сводно.Заказ_ДоговорПодрядчика,
	               |	ВТ_Сводно.Контрагент,
	               |	ВТ_Сводно.Договор,
	               |	ВТ_Сводно.ПериодАгрегации,
	               |	ВЫБОР
	               |		КОГДА ВТ_Сводно.ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ПустаяСсылка)
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы)
	               |		ИНАЧЕ ВТ_Сводно.ИсточникПлана
	               |	КОНЕЦ";
		
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл		
		НоваяСтрока = ТаблицаДвижений.Добавить();			
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);		
	КонецЦикла;
	
	Если СвойстваПроекта.РасходыПоПодразделениям Тогда	
		
		Если СвойстваПроведения.СвойстваЗадачи.ВключитьМатРесурсыВПланРасходов Тогда 	
			
			ТаблицаМатериальныеРесурсы = ЭтотОбъект.МатериальныеРесурсы;
			ТаблицаРаспределениеПотребностей = ЭтотОбъект.РаспределениеПотребностей;
			
			Запрос.УстановитьПараметр("ТаблицаМатериальныеРесурсы", ТаблицаМатериальныеРесурсы);
			Запрос.УстановитьПараметр("ТаблицаРаспределениеПотребностей", ТаблицаРаспределениеПотребностей);
	
			Запрос.Текст = "ВЫБРАТЬ
			               |	ТаблицаМатериальныеРесурсы.Контрагент КАК Контрагент,
			               |	ТаблицаМатериальныеРесурсы.Договор КАК Договор,
			               |	ТаблицаМатериальныеРесурсы.Валюта КАК Валюта,
			               |	ТаблицаМатериальныеРесурсы.Ресурс КАК Ресурс,
			               |	ТаблицаМатериальныеРесурсы.ЕдиницаНормирования КАК ЕдиницаНормирования,
			               |	ТаблицаМатериальныеРесурсы.ОбщСтоимость КАК ОбщСтоимость,
			               |	ТаблицаМатериальныеРесурсы.Количество КАК Количество,
			               |	ТаблицаМатериальныеРесурсы.ДатаПривязки КАК ДатаПривязки,
			               |	ТаблицаМатериальныеРесурсы.СтатьяЗатрат КАК СтатьяЗатрат,
			               |	ТаблицаМатериальныеРесурсы.СпособПривязки КАК СпособПривязки,
			               |	ТаблицаМатериальныеРесурсы.ПрофильРаспределения КАК ПрофильРаспределения,
			               |	ТаблицаМатериальныеРесурсы.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения
			               |ПОМЕСТИТЬ ВТ_МатериальныеРесурсы
			               |ИЗ
			               |	&ТаблицаМатериальныеРесурсы КАК ТаблицаМатериальныеРесурсы
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ТаблицаРаспределениеПотребностей.Подразделение КАК Подразделение,
			               |	ТаблицаРаспределениеПотребностей.Роль КАК Роль,
			               |	ТаблицаРаспределениеПотребностей.Сумма КАК Сумма,
			               |	ТаблицаРаспределениеПотребностей.Количество КАК Количество,
			               |	ТаблицаРаспределениеПотребностей.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
			               |	ТаблицаРаспределениеПотребностей.ИндексСтрокиВладельца КАК ИндексСтрокиВладельца
			               |ПОМЕСТИТЬ ВТ_РаспределениеПотребностей
			               |ИЗ
			               |	&ТаблицаРаспределениеПотребностей КАК ТаблицаРаспределениеПотребностей
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	ВТ_МатериальныеРесурсы.Контрагент КАК КонтрагентПодрядчик,
			               |	ВТ_МатериальныеРесурсы.Договор КАК Заказ_ДоговорПодрядчика,
			               |	ВТ_МатериальныеРесурсы.Валюта КАК Валюта,
			               |	ВТ_РаспределениеПотребностей.Подразделение КАК Подразделение,
			               |	ВТ_РаспределениеПотребностей.Роль КАК Роль,
			               |	ВТ_МатериальныеРесурсы.Ресурс КАК Номенклатура,
			               |	ВТ_МатериальныеРесурсы.ЕдиницаНормирования КАК ЕдиницаИзмерения,
			               |	ВЫБОР
			               |		КОГДА ВТ_РаспределениеПотребностей.Сумма ЕСТЬ NULL
			               |			ТОГДА ВТ_МатериальныеРесурсы.ОбщСтоимость
			               |		ИНАЧЕ ВТ_РаспределениеПотребностей.Сумма
			               |	КОНЕЦ КАК Сумма,
			               |	ВЫБОР
			               |		КОГДА ВТ_РаспределениеПотребностей.Сумма ЕСТЬ NULL
			               |			ТОГДА ВТ_МатериальныеРесурсы.ОбщСтоимость
			               |		ИНАЧЕ ВТ_РаспределениеПотребностей.Сумма
			               |	КОНЕЦ КАК СуммаВалютная,
			               |	ВЫБОР
			               |		КОГДА ВТ_РаспределениеПотребностей.Количество ЕСТЬ NULL
			               |			ТОГДА ВТ_МатериальныеРесурсы.Количество
			               |		ИНАЧЕ ВТ_РаспределениеПотребностей.Количество
			               |	КОНЕЦ КАК Количество,
			               |	ВТ_МатериальныеРесурсы.ДатаПривязки КАК ДатаНачисления,
			               |	ВТ_МатериальныеРесурсы.СтатьяЗатрат КАК Статья,
			               |	ВТ_МатериальныеРесурсы.СпособПривязки КАК СпособПривязки,
			               |	ВТ_МатериальныеРесурсы.ПрофильРаспределения КАК ПрофильРаспределения,
			               |	ВТ_РаспределениеПотребностей.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
			               |	ВТ_МатериальныеРесурсы.Контрагент КАК Контрагент,
			               |	ВТ_МатериальныеРесурсы.Договор КАК Договор
			               |ПОМЕСТИТЬ ВТ_Сводно
			               |ИЗ
			               |	ВТ_МатериальныеРесурсы КАК ВТ_МатериальныеРесурсы
			               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеПотребностей КАК ВТ_РаспределениеПотребностей
			               |		ПО ВТ_МатериальныеРесурсы.ИндексСтрокРаспределения = ВТ_РаспределениеПотребностей.ИндексСтрокиВладельца
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	&ТекущаяВерсия КАК Версия,
			               |	&Ссылка КАК ПроектнаяЗадача,
			               |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход) КАК ВидЭлемента,
			               |	ВТ_Сводно.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
			               |	ВТ_Сводно.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
			               |	ВТ_Сводно.Валюта КАК Валюта,
			               |	ВТ_Сводно.Подразделение КАК Подразделение,
			               |	ВТ_Сводно.Роль КАК Роль,
			               |	ВТ_Сводно.Номенклатура КАК Номенклатура,
			               |	ВТ_Сводно.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
			               |	СУММА(ВТ_Сводно.Сумма) КАК Сумма,
			               |	СУММА(ВТ_Сводно.СуммаВалютная) КАК СуммаВалютная,
			               |	СУММА(ВТ_Сводно.Количество) КАК Количество,
			               |	ВТ_Сводно.ДатаНачисления КАК ДатаНачисления,
