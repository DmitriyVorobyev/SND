	       |						ТОГДА ВТ_Константы.РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам
	       |					ИНАЧЕ ВТ_Портфели.РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам
	       |	КОНЕЦ КАК РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам,
	       |	ВЫБОР
	       |		КОГДА ЕСТЬNULL(ВТ_НастройкиПоПодразделениям.НастройкаУровняПланированияПриРасчетеГотовностиПроектов, ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.ПустаяСсылка)
	       |			ТОГДА ВЫБОР
	       |					КОГДА ЕСТЬNULL(ВТ_Портфели.НастройкаУровняПланированияПриРасчетеГотовностиПроектов, ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.ПустаяСсылка)
	       |						ТОГДА ВТ_Константы.НастройкаУровняПланированияПриРасчетеГотовностиПроектов
	       |					ИНАЧЕ ВТ_Портфели.НастройкаУровняПланированияПриРасчетеГотовностиПроектов
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.НастройкаУровняПланированияПриРасчетеГотовностиПроектов
	       |	КОНЕЦ КАК НастройкаУровняПланированияПриРасчетеГотовностиПроектов,
	       |	ВЫБОР
	       |		КОГДА ВТ_НастройкиПоПодразделениям.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат ЕСТЬ NULL
	       |			ТОГДА ВЫБОР
	       |					КОГДА ВТ_Портфели.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат ЕСТЬ NULL
	       |						ТОГДА ВТ_Константы.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат
	       |					ИНАЧЕ ВТ_Портфели.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат
	       |	КОНЕЦ КАК УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат,
	       |	ВЫБОР
	       |		КОГДА ВТ_НастройкиПоПодразделениям.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя ЕСТЬ NULL
	       |			ТОГДА ВЫБОР
	       |					КОГДА ВТ_Портфели.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя ЕСТЬ NULL
	       |						ТОГДА ВТ_Константы.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя
	       |					ИНАЧЕ ВТ_Портфели.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя
	       |	КОНЕЦ КАК НаследоватьЗначениеПоляОбъектИзЗадачиРодителя,
		   |	ВЫБОР
	       |		КОГДА ВТ_НастройкиПоПодразделениям.НастройкаРаспределенияБДР ЕСТЬ NULL
	       |			ТОГДА ВЫБОР
	       |					КОГДА ВТ_Портфели.НастройкаРаспределенияБДР ЕСТЬ NULL
	       |						ТОГДА ВТ_Константы.НастройкаРаспределенияБДР
	       |					ИНАЧЕ ВТ_Портфели.НастройкаРаспределенияБДР
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.НастройкаРаспределенияБДР
	       |	КОНЕЦ КАК НастройкаРаспределенияБДР,
		   |	ВЫБОР
	       |		КОГДА ВТ_НастройкиПоПодразделениям.НазначатьРСПОсновнойРолиКакРПЗ ЕСТЬ NULL
	       |			ТОГДА ВЫБОР
	       |					КОГДА ВТ_Портфели.НазначатьРСПОсновнойРолиКакРПЗ ЕСТЬ NULL
	       |						ТОГДА ВТ_Константы.НазначатьРСПОсновнойРолиКакРПЗ
	       |					ИНАЧЕ ВТ_Портфели.НазначатьРСПОсновнойРолиКакРПЗ
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.НазначатьРСПОсновнойРолиКакРПЗ
	       |	КОНЕЦ КАК НазначатьРСПОсновнойРолиКакРПЗ,
		   |	ВЫБОР
	       |		КОГДА ВТ_НастройкиПоПодразделениям.УстанавливатьПризнакОсновнаяПриДобавленииРоли ЕСТЬ NULL
	       |			ТОГДА ВЫБОР
	       |					КОГДА ВТ_Портфели.УстанавливатьПризнакОсновнаяПриДобавленииРоли ЕСТЬ NULL
	       |						ТОГДА ВТ_Константы.УстанавливатьПризнакОсновнаяПриДобавленииРоли
	       |					ИНАЧЕ ВТ_Портфели.УстанавливатьПризнакОсновнаяПриДобавленииРоли
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.УстанавливатьПризнакОсновнаяПриДобавленииРоли
	       |	КОНЕЦ КАК УстанавливатьПризнакОсновнаяПриДобавленииРоли,
		   |	ВЫБОР
	       |		КОГДА ВТ_НастройкиПоПодразделениям.ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки ЕСТЬ NULL
	       |			ТОГДА ВЫБОР
	       |					КОГДА ВТ_Портфели.ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки ЕСТЬ NULL
	       |						ТОГДА ВТ_Константы.ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки
	       |					ИНАЧЕ ВТ_Портфели.ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки
	       |				КОНЕЦ
	       |		ИНАЧЕ ВТ_НастройкиПоПодразделениям.ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки
	       |	КОНЕЦ КАК ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки
	       |ИЗ
	       |	Справочник.Проекты КАК Проекты
	       |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НастройкиПоПодразделениям КАК ВТ_НастройкиПоПодразделениям
	       |		ПО Проекты.Ссылка = ВТ_НастройкиПоПодразделениям.Объект
	       |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Портфели КАК ВТ_Портфели
	       |		ПО Проекты.ПортфельПроектов = ВТ_Портфели.Объект
	       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Константы КАК ВТ_Константы
	       |		ПО (ИСТИНА)
	       |ГДЕ
	       |	Проекты.Ссылка В(&СписокПроектов)";
	
	Возврат Текст;
	
КонецФункции

// Формирует записи в регистре настроек учета по подразделениям для Проекта/Портфеля.
//
// Параметры:
//	ЭтаФорма - УправляемаяФорма.
//	Объект - ДанныеФормыСтруктура.
//
Процедура ОбъектНастроекПослеЗаписиНаСервере(ЭтаФорма, Объект) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегистрСведенийКЗ = РегистрыСведений.упоНастройкаАналитикиВРазрезеПодразделений.СоздатьНаборЗаписей();
	РегистрСведенийКЗ.Отбор.Объект.Установить(Объект.Ссылка);
	
	НоваяСтрока = РегистрСведенийКЗ.Добавить();
	НоваяСтрока.Объект = Объект.Ссылка;
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭтаФорма, ,"Объект");
	НоваяСтрока.НастройкаПоказателейДляКарточкиПроектов = 
		Новый ХранилищеЗначения(ЭтаФорма.упоНастройкаПоказателейДляКарточкиПроектовНастройка);
	
	РегистрСведенийКЗ.Записать(Истина);
	
КонецПроцедуры

// Формирует структуру, содержащую значения по умолчанию для подстановки в реквизиты объекта.
//
// Параметры:
//	Проект - СправочникСсылка.Проекты - проект.
// 
// Возвращаемое значение:
//	Структура - структура.
Функция ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект) Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("СтатьяДоходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("НатуральныйПоказательДоходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("РольДоходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("ПодразделениеДоходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("ПрофильДоходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("КонтрагентДоходов");
	СтруктураРеквизитов.Вставить("ДоговорДоходов");
	СтруктураРеквизитов.Вставить("СтатьяЗатратПоУмолчанию");
	СтруктураРеквизитов.Вставить("РольРасходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("ПодразделениеРасходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("ПрофильРасходовПоУмолчанию");
	СтруктураРеквизитов.Вставить("КонтрагентЗатрат");
	СтруктураРеквизитов.Вставить("ДоговорЗатрат");
	СтруктураРеквизитов.Вставить("НатуральныйПоказательРасходовПоУмолчанию");
	
	РеквизитыПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Проект, СтруктураРеквизитов);
	
	СтруктураСвойствПоУмолчанию = Новый Структура;
	
	// Доходы.
	СтруктураСвойствПоУмолчанию.Вставить("СтатьяДоходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.СтатьяДоходовПоУмолчанию),
			РеквизитыПроекта.СтатьяДоходовПоУмолчанию,
			Константы.упоСтатьяДоходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("НатуральныйПоказательДоходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.НатуральныйПоказательДоходовПоУмолчанию),
			РеквизитыПроекта.НатуральныйПоказательДоходовПоУмолчанию,
			Константы.упоНатуральныйПоказательДоходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("РольДоходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.РольДоходовПоУмолчанию),
			РеквизитыПроекта.РольДоходовПоУмолчанию,
			Константы.упоРольДоходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("ПодразделениеДоходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.ПодразделениеДоходовПоУмолчанию),
			РеквизитыПроекта.ПодразделениеДоходовПоУмолчанию,
			Константы.упоПодразделениеДоходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("ПрофильДоходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.ПрофильДоходовПоУмолчанию),
			РеквизитыПроекта.ПрофильДоходовПоУмолчанию,
			Константы.упоПрофильДоходовПоУмолчанию.Получить())); 
	СтруктураСвойствПоУмолчанию.Вставить("КонтрагентДоходовПоУмолчанию", РеквизитыПроекта.КонтрагентДоходов);		
	СтруктураСвойствПоУмолчанию.Вставить("ДоговорДоходовПоУмолчанию", РеквизитыПроекта.ДоговорДоходов);
	
	Если ЗначениеЗаполнено(СтруктураСвойствПоУмолчанию.РольДоходовПоУмолчанию)
		И ЗначениеЗаполнено(СтруктураСвойствПоУмолчанию.РольДоходовПоУмолчанию.СобствСилы_Субподряд) Тогда		
		СССП_Доходы = СтруктураСвойствПоУмолчанию.РольДоходовПоУмолчанию.СобствСилы_Субподряд;	
	Иначе		
		СССП_Доходы = Справочники.упоСобственныеСилыСубподряд.СобственныеСилы;		
	КонецЕсли;	
	СтруктураСвойствПоУмолчанию.Вставить("СССП_Доходы", СССП_Доходы);
	
	// Расходы.
	СтруктураСвойствПоУмолчанию.Вставить("СтатьяЗатратПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.СтатьяЗатратПоУмолчанию),
			РеквизитыПроекта.СтатьяЗатратПоУмолчанию,
			Константы.упоСтатьяЗатратПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("НатуральныйПоказательРасходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.НатуральныйПоказательРасходовПоУмолчанию),
			РеквизитыПроекта.НатуральныйПоказательРасходовПоУмолчанию,
			Константы.упоНатуральныйПоказательРасходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("РольРасходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.РольРасходовПоУмолчанию),
			РеквизитыПроекта.РольРасходовПоУмолчанию,
			Константы.упоРольРасходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("ПодразделениеРасходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.ПодразделениеРасходовПоУмолчанию),
			РеквизитыПроекта.ПодразделениеРасходовПоУмолчанию,
			Константы.упоПодразделениеРасходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("ПрофильРасходовПоУмолчанию",
		?(ЗначениеЗаполнено(РеквизитыПроекта.ПрофильРасходовПоУмолчанию),
			РеквизитыПроекта.ПрофильРасходовПоУмолчанию,
			Константы.упоПрофильРасходовПоУмолчанию.Получить()));
	СтруктураСвойствПоУмолчанию.Вставить("КонтрагентЗатратПоУмолчанию", РеквизитыПроекта.КонтрагентЗатрат);
	СтруктураСвойствПоУмолчанию.Вставить("ДоговорЗатратПоУмолчанию", РеквизитыПроекта.ДоговорЗатрат);
		
	Если ЗначениеЗаполнено(СтруктураСвойствПоУмолчанию.РольРасходовПоУмолчанию)
		И ЗначениеЗаполнено(СтруктураСвойствПоУмолчанию.РольРасходовПоУмолчанию.СобствСилы_Субподряд) Тогда	
		СССП_Расходы = СтруктураСвойствПоУмолчанию.РольРасходовПоУмолчанию.СобствСилы_Субподряд;	
	Иначе	
		СССП_Расходы = Справочники.упоСобственныеСилыСубподряд.СобственныеСилы;		
	КонецЕсли;	
	СтруктураСвойствПоУмолчанию.Вставить("СССП_Расходы", СССП_Расходы);
	
	Возврат СтруктураСвойствПоУмолчанию;
	
КонецФункции

// Формирует дополнительную структуру настоек учета по подразделениям.
//
// Параметры:
//	ЭтотОбъект - ДокументОбъект - объект.
//	СтруктураПроведения - Структура - структура.
//
// Возвращаемое значение:
//	Структура – содержит настройки по подразделениям.
Процедура ЗаполнитьОбщиеНастройкиУчетаПоПодразделениям(ЭтотОбъект, СтруктураПроведения) Экспорт
	
	СтруктураПроведения.Вставить("НатуральныйПоказательДоходов", Константы.упоНатуральныйПоказательДоходовПоУмолчанию.Получить());
	СтруктураПроведения.Вставить("РольДоходов", Константы.упоРольДоходовПоУмолчанию.Получить());
	СтруктураПроведения.Вставить("ПодразделениеДоходов", Константы.упоПодразделениеДоходовПоУмолчанию.Получить());
	
	СтруктураПроведения.Вставить("НатуральныйПоказательРасходов", Константы.упоНатуральныйПоказательРасходовПоУмолчанию.Получить());
	СтруктураПроведения.Вставить("РольРасходов", Константы.упоРольРасходовПоУмолчанию.Получить());
	СтруктураПроведения.Вставить("ПодразделениеРасходов", Константы.упоПодразделениеРасходовПоУмолчанию.Получить());
	
КонецПроцедуры

// Формирует структуру настоек учета (из регистров) по подразделениям для прикладного объекта.
//
// Параметры:
//  СсылкаНаОбъект	 - СправочникСсылка.Проекты, СправочникСсылка.упоПортфелиПроектов	 - проект/портфель.
// 
// Возвращаемое значение:
//  Структура - содержит настройки по подразделениям.
//
Функция ЗаполнитьПараметрыУчетаПоПодразделениям(СсылкаНаОбъект) Экспорт
	
	Возврат упоАналитикаПоПодразделениямПовтИспВызов.ЗаполнитьПараметрыУчетаПоПодразделениям(СсылкаНаОбъект);
	
КонецФункции

// Устарела. см. упоПроектыИЗадачиОбщие.УстановитьВидимостьЭлементовФормыПроектнойЗадачи()
// Устанавливает видимость элементов управления формы ПЗ в зависимости от настроек учета.
//
// Параметры:
//	Форма - УправляемаяФорма - форма.
//	Объект - ДанныеФормыСтруктура - слепок объекта.
Процедура ВидимостьЭлементовПЗ(Форма, Объект) Экспорт
	
	упоПроектыИЗадачиОбщие.УстановитьВидимостьЭлементовФормыПроектнойЗадачи(Объект, Форма);
	
КонецПроцедуры

// Перепроводит проектные задачи, у которых заполнена табличная часть МатериальныеРесурсы.
Процедура ПерезаписатьАктуальныеПланыДоходовРасходовПоПодразделениям() Экспорт

	Если Метаданные.Константы.Найти("ПрименятьДатуЗапретаДляПолныхПрав") <> Неопределено Тогда
		
		ЗначениеКонстантыСтарое = Константы["ПрименятьДатуЗапретаДляПолныхПрав"].Получить();
		Константы["ПрименятьДатуЗапретаДляПолныхПрав"].Установить(Ложь);
		
	КонецЕсли;
	
	СтароеЗначениеПараметраСеансаОтключитьПроверкуОграничений = ПараметрыСеанса.упоОтключитьПроверкуОграничений;
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = Истина;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоАктуальныеПланыДоходовИРасходов.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ втДвиженияАктуальныеПланыДоходовРасходов
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДоходовИРасходов КАК упоАктуальныеПланыДоходовИРасходов
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоПроектнаяЗадачаМатериальныеРесурсы.Ссылка КАК ПроектнаяЗадача
	               |ИЗ
	               |	Документ.упоПроектнаяЗадача.МатериальныеРесурсы КАК упоПроектнаяЗадачаМатериальныеРесурсы
	               |ГДЕ
	               |	упоПроектнаяЗадачаМатериальныеРесурсы.Ссылка.Проведен
	               |	И НЕ упоПроектнаяЗадачаМатериальныеРесурсы.Ссылка.ВключитьМатРесурсыВПланРасходов
	               |	И упоПроектнаяЗадачаМатериальныеРесурсы.Ссылка В
	               |			(ВЫБРАТЬ
	               |				втДвиженияАктуальныеПланыДоходовРасходов.Регистратор
	               |			ИЗ
	               |				втДвиженияАктуальныеПланыДоходовРасходов КАК втДвиженияАктуальныеПланыДоходовРасходов)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ПроектнаяЗадачаОбъект = Выборка.ПроектнаяЗадача.ПолучитьОбъект();
			ПроектнаяЗадачаОбъект.Дата = ТекущаяДатаСеанса();
			ПроектнаяЗадачаОбъект.ПолучитьДанныеВерсии(Неопределено);
			ПроектнаяЗадачаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ПараметрыОшибки = Новый Структура;
			ПараметрыОшибки.Вставить("Событие", "Проведение документа " + Выборка.ПроектнаяЗадача);
			ПараметрыОшибки.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
			ПараметрыОшибки.Вставить("ОбъектМетаданных", Метаданные.Документы.упоПроектнаяЗадача);
			ПараметрыОшибки.Вставить("Данные", Выборка.ПроектнаяЗадача);
			ПараметрыОшибки.Вставить("Комментарий", ОписаниеОшибки());			
			упоРаботаСДиалогамиСервер.ЗаписатьВЖурналРегистрации(ПараметрыОшибки);
		КонецПопытки;		
	
	КонецЦикла;
	
	Если Метаданные.Константы.Найти("ПрименятьДатуЗапретаДляПолныхПрав") <> Неопределено Тогда
		
		Константы["ПрименятьДатуЗапретаДляПолныхПрав"].Установить(ЗначениеКонстантыСтарое);
		
	КонецЕсли;
	
	ПараметрыСеанса.упоОтключитьПроверкуОграничений = СтароеЗначениеПараметраСеансаОтключитьПроверкуОграничений;

КонецПроцедуры

#Область ОбработчикиПроведенияПЗИДокументовРегистрацииФакта

// Основная процедура - обработчик проведения по регистрам учета по подразделениям.
//
// Параметры:
//	ЭтотОбъект - ДокументОбъект.
//	ДанныеДвижений - Структура - содержит таблицы движений.
//	СвойстваПроекта - Структура - содержит настройки учета по подразделениям.
//	СвойстваПроведения - Структура - содержит дополнительные настройки учета по подразделениям.
//	Отказ - Булево - признак отказа от проведения.
//
Процедура ПодготовитьТаблицыДвижений(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ) Экспорт
	
	Если СвойстваПроекта.ДоходыПоПодразделениям
		Или СвойстваПроекта.РасходыПоПодразделениям Тогда
		// В противном случае учет по подразделениям не ведется.
		
		Если ДанныеДвижений.Свойство("упоАктуальныеПланыВыполненияОбъемов") Тогда
			ЗаполнитьДвиженияПлановыеОбъемы(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);			
		КонецЕсли;
		
		Если ДанныеДвижений.Свойство("упоФактВыполненияОбъемовОбороты") Тогда
			ЗаполнитьДвиженияФактическиеОбъемы(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);			
		КонецЕсли;
		
		Если ДанныеДвижений.Свойство("упоВыполненныеПринятыеОбъемы") Тогда			
			ЗаполнитьДвиженияВыполненныеПринятыеОбъемы(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);									
		КонецЕсли;
		
	КонецЕсли;	
	
	// Данные формируются вне зависимости от того, ведутся ли доходы/расходы в разрезе подразделений, или нет.
	
	Если ДанныеДвижений.Свойство("упоФактДоходовИРасходовОбороты") Тогда
		ЗаполнитьДвиженияДоходыРасходы(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);
	КонецЕсли;
	
	Если ДанныеДвижений.Свойство("упоАктуальныеПланыДоходовИРасходовПодразделения") Тогда
		ЗаполнитьДвиженияПланДоходовИРасходов(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Актуализирует таблицу движений регистра упоАктуальныеПланыДоходовИРасходовПодразделения при актуализации
//  календарного плана проекта.
//
// Параметры:
//  ЭтотОбъект								 - ДокументОбъект	 - объект.
//  ДанныеДокумента							 - Структура		 - данные документа проведения.
//  ТаблицаСроковЗадач						 - ТаблицаЗначений	 - сроки задач.
//  СоответствиеСроковЗадач					 - Соответствие		
//  ТаблицаДвиженийПланБДРПоПодразделениям	 - ТаблицаЗначений	 - исходная таблица с профилями.
//  СвойстваПроведения						 - Структура		 - содержит дополнительные настройки учета по подразделениям.
//  Отказ									 - Булево			 - признак отказа от проведения.
//
Процедура АктуализацияДанныхДоходовРасходов(ЭтотОбъект, 
											ДанныеДокумента,
											ТаблицаСроковЗадач,
											СоответствиеСроковЗадач,
											ТаблицаДвиженийПланБДРПоПодразделениям,
											СвойстваПроведения, 
											Отказ) Экспорт
	
	ТекстЗапроса =   "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Версия КАК Версия,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Статья КАК Статья,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ВидЭлемента КАК ВидЭлемента,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Контрагент КАК Контрагент,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Договор КАК Договор,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Валюта КАК Валюта,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Подразделение КАК Подразделение,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Роль КАК Роль,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Номенклатура КАК Номенклатура,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сценарий КАК Сценарий,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ДатаНачисления КАК ДатаНачисления,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	                 |	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сумма) КАК Сумма,
	                 |	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная) КАК СуммаВалютная,
	                 |	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Количество) КАК Количество,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СпособПривязки КАК СпособПривязки,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПрофильРаспределения КАК ПрофильРаспределения,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПериодАгрегации КАК ПериодАгрегации,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ИсточникПлана КАК ИсточникПлана
	                 |ИЗ
	                 |	РегистрСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СрезПоследних(
	                 |			,
	                 |			Версия = &Версия
	                 |				И ПроектнаяЗадача В
	                 |					(ВЫБРАТЬ
	                 |						ВТ_ПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача
	                 |					ИЗ
	                 |						ВТ_ПроектныеЗадачи КАК ВТ_ПроектныеЗадачи)
	                 |				И ИсточникПлана В (&ИсточникиПлана)) КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних
	                 |
	                 |СГРУППИРОВАТЬ ПО
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Версия,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Статья,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ВидЭлемента,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Контрагент,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Договор,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Валюта,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Подразделение,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Роль,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Номенклатура,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ЕдиницаИзмерения,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сценарий,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ДатаНачисления,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Заказ_ДоговорПодрядчика,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СобствСилы_Субподряд,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.КонтрагентПодрядчик,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СпособПривязки,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПрофильРаспределения,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПериодАгрегации,
	                 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ИсточникПлана";
	
	// Все источники,за исключением Трудозатрат.
	ИсточникиПлана = Новый Массив;
	ИсточникиПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ПустаяСсылка());
	ИсточникиПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ДополнительныеЗатраты);
	ИсточникиПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	ИсточникиПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты);
	ИсточникиПлана.Добавить(Перечисления.упоИсточникПланаДоходовИРасходов.Объемы);
	
	ЗапросНеАктуализированных = Новый Запрос(ТекстЗапроса);
	ЗапросНеАктуализированных.МенеджерВременныхТаблиц = СвойстваПроведения.МВТ;
	ЗапросНеАктуализированных.УстановитьПараметр("Версия", СвойстваПроведения.текВерсия);
	ЗапросНеАктуализированных.УстановитьПараметр("ИсточникиПлана", ИсточникиПлана);
	
	ТаблицаНеАктуализированных = ЗапросНеАктуализированных.Выполнить().Выгрузить();
	
	ЗаполнитьРаспределениеВТаблицеДоходовРасходов(ТаблицаДвиженийПланБДРПоПодразделениям, 
		ТаблицаНеАктуализированных, ТаблицаСроковЗадач);
	
	КолонкиСуммы = Новый Соответствие;
	КолонкиСуммы.Вставить("Сумма", Истина);
	КолонкиСуммы.Вставить("СуммаВалютная", Истина);
	КолонкиСуммы.Вставить("Количество", Истина);
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ТаблицаДвиженийПланБДРПоПодразделениям, КолонкиСуммы);
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвиженийПланБДРПоПодразделениям, , Ложь);
	
	// Зануление.
	
	МассивЗадач = ТаблицаНеАктуализированных.ВыгрузитьКолонку("ПроектнаяЗадача");
	
	ДанныеАктуализацииРегистра = Новый Структура("Регистратор, Период, МассивЗадач, ИмяРегистра",
		ЭтотОбъект.Ссылка, 
		упоРабочиеКалендариВызовСервера.обПолучитьМоментВремениДокумента(ЭтотОбъект), 
		МассивЗадач);
	УсловиеОтбора = "Версия = &Версия И НЕ ИсточникПлана = &ИсточникПлана";
	ПараметрОтбора = Новый Структура("Версия, ИсточникПлана", 
		СвойстваПроведения.текВерсия, Перечисления.упоИсточникПланаДоходовИРасходов.Трудозатраты);
	
	ДанныеАктуализацииРегистра.ИмяРегистра = "упоАктуальныеПланыДоходовИРасходовПодразделения";
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ТаблицаДвиженийПланБДРПоПодразделениям, ДанныеАктуализацииРегистра,,,
		УсловиеОтбора, ПараметрОтбора, Ложь);
	
КонецПроцедуры

// Актуализирует таблицу движений регистра упоАктуальныеПланыВыполненияОбъемов при актуализации
//  календарного плана проекта.
//
// Параметры:
//  ЭтотОбъект								 - ДокументОбъект	 - объект.
//  ДанныеДокумента							 - Структура		 - данные документа проведения.
//  ТаблицаСроковЗадач						 - ТаблицаЗначений	 - сроки задач.
//  СоответствиеСроковЗадач					 - Соответствие
//  ТаблицаДвиженийПланБДРПоПодразделениям	 - ТаблицаЗначений	 - исходная таблица с профилями.
//  СвойстваПроведения						 - Структура		 - содержит дополнительные настройки учета по подразделениям.
//  Отказ									 - Булево			 - признак отказа от проведения.
//
Процедура АктуализацияПлановыхОбъемов(ЭтотОбъект,
									  ДанныеДокумента,
									  ТаблицаСроковЗадач,
									  СоответствиеСроковЗадач,
									  ТаблицаДвиженийПланБДРПоПодразделениям,
									  СвойстваПроведения,
									  Отказ) Экспорт
	
	ТекстЗапроса =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Версия КАК Версия,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Статья КАК Статья,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ВидОбъема КАК ВидОбъема,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Контрагент КАК Контрагент,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Договор КАК Договор,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Валюта КАК Валюта,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Подразделение КАК Подразделение,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Роль КАК Роль,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Номенклатура КАК Номенклатура,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Сценарий КАК Сценарий,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СпособПривязки КАК СпособПривязки,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПрофильРаспределения КАК ПрофильРаспределения,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ДатаНачисления КАК ДатаНачисления,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ИсточникПлана КАК ИсточникПлана,
	                |	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Сумма) КАК Сумма,
	                |	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СуммаВалютная) КАК СуммаВалютная,
	                |	СУММА(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Количество) КАК Количество
	                |ИЗ
	                |	РегистрСведений.упоАктуальныеПланыВыполненияОбъемов.СрезПоследних(
	                |			,
	                |			Версия = &Версия
	                |				И ПроектнаяЗадача В
	                |					(ВЫБРАТЬ
	                |						ВТ_ПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача
	                |					ИЗ
	                |						ВТ_ПроектныеЗадачи КАК ВТ_ПроектныеЗадачи)) КАК упоАктуальныеПланыВыполненияОбъемовСрезПоследних
	                |ГДЕ
	                |	(упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Количество <> 0
	                |			ИЛИ упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СуммаВалютная <> 0)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Версия,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Статья,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ВидОбъема,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Контрагент,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Договор,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Валюта,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Подразделение,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Роль,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Номенклатура,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ЕдиницаИзмерения,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Сценарий,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СпособПривязки,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПрофильРаспределения,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ДатаНачисления,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Заказ_ДоговорПодрядчика,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СобствСилы_Субподряд,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.КонтрагентПодрядчик,
	                |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ИсточникПлана";
	
	ЗапросНеАктуализированных = Новый Запрос(ТекстЗапроса);
	ЗапросНеАктуализированных.МенеджерВременныхТаблиц = СвойстваПроведения.МВТ;
	ЗапросНеАктуализированных.УстановитьПараметр("Версия", СвойстваПроведения.текВерсия);
	
	Результат = ЗапросНеАктуализированных.Выполнить();
	
	Если Результат.Пустой() Тогда 
		Возврат; // Возврат
	КонецЕсли;
	
	ТаблицаНеАктуализированных = Результат.Выгрузить();
	
	Отбор = Новый Структура("СпособПривязки", Перечисления.упоСпособПривязкиДоходаРасхода.НаДату);
	ТаблицаНеАктуализированных_НаДату = ТаблицаНеАктуализированных.Скопировать(Отбор);
	
	Для Каждого СтрокаНеАктуализированных_НаДату Из ТаблицаНеАктуализированных_НаДату Цикл
		
		НоваяСтрока = ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных_НаДату);
		
	КонецЦикла;
	
	Отбор = Новый Структура("СпособПривязки", Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения);
	ТаблицаНеАктуализированных_ПоПрофилю = ТаблицаНеАктуализированных.Скопировать(Отбор);
	
	Для Каждого СтрокаНеАктуализированных_ПоПрофилю Из ТаблицаНеАктуализированных_ПоПрофилю Цикл
		
		НоваяСтрока =  ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных_ПоПрофилю);
		
		НоваяСтрока.Сумма = 0;
		НоваяСтрока.СуммаВалютная = 0;
		НоваяСтрока.Количество = 0;
		
	КонецЦикла;
	
	МассивИсключаемыхКолонок = Новый Массив;
	МассивИсключаемыхКолонок.Добавить("ДатаНачисления");
	МассивИсключаемыхКолонок.Добавить("Сумма");
	МассивИсключаемыхКолонок.Добавить("СуммаВалютная");
	МассивИсключаемыхКолонок.Добавить("Количество");
	
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ТаблицаНеАктуализированных_ПоПрофилю.Колонки Цикл
		Если МассивИсключаемыхКолонок.Найти(Колонка.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивКолонок.Добавить(Колонка.Имя);
	КонецЦикла;
	
	СтрокаКолонок = СтрСоединить(МассивКолонок, ",");
	
	КолонкиСуммированияСтрокой = "Сумма,СуммаВалютная,Количество";
	
	ТаблицаНеАктуализированных_ПоПрофилю.Свернуть(СтрокаКолонок, КолонкиСуммированияСтрокой);
		
	Для Каждого СтрокаНеАктуализированных_ПоПрофилю Из ТаблицаНеАктуализированных_ПоПрофилю Цикл
		
		Если ТипЗнч(ТаблицаСроковЗадач) = Тип("ТаблицаЗначений") Тогда
			
			СтрокаЗадача = ТаблицаСроковЗадач.Найти(СтрокаНеАктуализированных_ПоПрофилю.ПроектнаяЗадача, "Задача");
			
		Иначе 
			
			СтрокаЗадача = ТаблицаСроковЗадач[СтрокаНеАктуализированных_ПоПрофилю.ПроектнаяЗадача];
			
		КонецЕсли;
		
		Если СтрокаЗадача <> Неопределено Тогда
			
			ТаблицаРаспределенная = обРаспределитьДоходыИРасходыПоПрофилю(
				СтрокаНеАктуализированных_ПоПрофилю.ПрофильРаспределения, 
				СтрокаЗадача.Результат.ДатаНачала, 
				СтрокаЗадача.Результат.ДатаЗавершения, 
				СтрокаНеАктуализированных_ПоПрофилю.СуммаВалютная);
			
			Счетчик = 1;
			КоличествоРаспределенных = ТаблицаРаспределенная.Количество();
			ИтогПоКолву = 0;
			
			Для Каждого СтрокаРаспределенная Из ТаблицаРаспределенная Цикл
				
				НоваяСтрока = ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных_ПоПрофилю,, КолонкиСуммированияСтрокой);
				
				ДоляКоличества = СтрокаРаспределенная.Сумма 
					/ ?(СтрокаНеАктуализированных_ПоПрофилю.СуммаВалютная = 0, 1, СтрокаНеАктуализированных_ПоПрофилю.СуммаВалютная);
				
				НоваяСтрока.СуммаВалютная = СтрокаРаспределенная.Сумма;
				НоваяСтрока.ДатаНачисления = СтрокаРаспределенная.Период;
				
				Если Счетчик = КоличествоРаспределенных Тогда
					
					НоваяСтрока.Количество =  СтрокаНеАктуализированных_ПоПрофилю.Количество - ИтогПоКолву;
					
				Иначе
					
					НоваяСтрока.Количество = СтрокаНеАктуализированных_ПоПрофилю.Количество * ДоляКоличества;
					ИтогПоКолву = ИтогПоКолву + НоваяСтрока.Количество;
					
				КонецЕсли;
				
				Счетчик = Счетчик + 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	КолонкиСуммы = Новый Соответствие;
	КолонкиСуммы.Вставить("Сумма", 			Истина);
	КолонкиСуммы.Вставить("СуммаВалютная", 	Истина);
	КолонкиСуммы.Вставить("Количество", 	Истина);
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ТаблицаДвиженийПланБДРПоПодразделениям, КолонкиСуммы);
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвиженийПланБДРПоПодразделениям, , Ложь);
	
КонецПроцедуры

// Возвращает значение реквизита СобствСилы_Субподряд элемента справочника "Роли".
//
// Параметры: 
//	Роль - СправочникСсылка.упоРоли - роль.
//
// Возвращаемое значение:
//	СправочникСсылка.упоСобственныеСилыСубподряд - значение реквизита. 
Функция СССП_Роли(Роль) Экспорт
	
	СССП = Справочники.упоСобственныеСилыСубподряд.ПустаяСсылка();	
	Если ЗначениеЗаполнено(Роль) Тогда
		СССП = Роль.СобствСилы_Субподряд;
	КонецЕсли;
	
	Возврат СССП;
	
КонецФункции

// Получает стоимость номенклатуры по плановым данным.
//
// Параметры:
//  ПроектнаяЗадача	 - ДокументСсылка.упоПроектнаяЗадача - проектная задача.
//  Номенклатура	 - СправочникСсылка.Номенклатура 	 - номенклатура.
//  ВидЭлемента		 - Строка - "Доход" или "Расход".
//
// Возвращаемое значение:
//	Число - стоимость номенклатуры.
Функция ПолучитьСтоимостьНоменклатурыПоПлановымДанным(ПроектнаяЗадача, Номенклатура, ВидЭлемента = "Расход") Экспорт
	
	Стоимость = 0;
	
	ВходящиеДанныеЗаполнены = ЗначениеЗаполнено(ПроектнаяЗадача)
		И ЗначениеЗаполнено(Номенклатура);
	
	Если Не ВходящиеДанныеЗаполнены Тогда
		Возврат Стоимость; // Возврат
	КонецЕсли;
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача);
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеПланов.Цена КАК Цена,
	               |	ДанныеПланов.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
	               |			,
	               |			Версия = &ТекВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача
	               |				И Номенклатура = &Номенклатура) КАК ДанныеПланов
	               |ГДЕ
	               |	(ДанныеПланов.Количество <> 0
	               |			ИЛИ ДанныеПланов.СуммаВалютная <> 0)
	               |	И ДанныеПланов.Цена > 0";

	Если ВидЭлемента = "Расход" Тогда
		ИмяРегистраДоход = "упоДанныеПлановВыпускаСубпродуктов";
		ИмяРегистраРасход = "упоДанныеПлановПотребностейМатериальныхРесурсов";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ИмяРегистраДоход, ИмяРегистраРасход);
	КонецЕсли;
	
	ЗапросСтоимости = Новый Запрос(ТекстЗапроса);
	ЗапросСтоимости.УстановитьПараметр("ТекВерсия", 		ТекВерсия);
	ЗапросСтоимости.УстановитьПараметр("ПроектнаяЗадача", 	ПроектнаяЗадача);
	ЗапросСтоимости.УстановитьПараметр("Номенклатура", 		Номенклатура);
	
	Результат = ЗапросСтоимости.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Стоимость; // Возврат
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Стоимость = Выборка.Цена;
	
	Возврат Стоимость;
	
КонецФункции

// Процедура заполняет таблицу движений регистра упоАктуальныеПланыДоходовИРасходовПодразделения.
//
// Параметры:
//	ЭтотОбъект - ДокументОбъект - объект.
//	ДанныеДвижений - Структура - содержит таблицы движений.
//	СвойстваПроекта - Структура - содержит настройки учета по подразделениям.
//	СвойстваПроведения - Структура - содержит дополнительные настройки учета по подразделениям.
//	Отказ - Булево - признак отказа от проведения.
Процедура ЗаполнитьДвиженияПланДоходовИРасходов(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, Знач СвойстваПроведения,
	Отказ) Экспорт
	
	Перем ТаблицаДоходов, ТаблицаРасходов;
	
	ЭтоПроектнаяЗадача = ТипЗнч(ЭтотОбъект.Ссылка) = Тип("ДокументСсылка.упоПроектнаяЗадача");		
	
	// Свойства проектной задачи используются при проведении одиночной ПЗ.
	СтрокаСвойствПроектнойЗадачи = "ВключитьМатРесурсыВПланРасходов, ВключитьДопЗатратыВПланРасходов, ВключитьСубпродуктыВПланДоходов";
	СвойстваЗадачи = Новый Структура(СтрокаСвойствПроектнойЗадачи);
	Если ЭтоПроектнаяЗадача Тогда
		СвойстваЗадачи = упоПроектыИЗадачиСервер.ПолучитьСвойстваПроектнойЗадачи(СвойстваПроведения.ПроектнаяЗадача, 
			СтрокаСвойствПроектнойЗадачи);
		СвойстваПроведения.Вставить("СвойстваЗадачи", СвойстваЗадачи);		
	КонецЕсли;			
	
	СвойстваПроведения.Вставить("СвойстваПроекта", СвойстваПроекта);	
	
	Если СвойстваПроекта.ДоходыПоПодразделениям = Ложь Тогда
		
		ТаблицаДоходов = ПолучитьТаблицуДвиженийДляЦелейУчетаПоПодразделениям(ЭтотОбъект, 
			"Доход", СвойстваПроведения, Ложь, Ложь, ЭтоПроектнаяЗадача);
		
	ИначеЕсли СвойстваПроекта.ДоходыПоПодразделениям = Истина
		И СвойстваПроекта.ДоходыПоОбъемам = Ложь 
		И СвойстваПроекта.ДоходыПоНатуральнымПоказателям = Ложь Тогда
		
		ТаблицаДоходов = ПолучитьТаблицуДвиженийДляЦелейУчетаПоПодразделениям(ЭтотОбъект, 
			"Доход", СвойстваПроведения, Истина, Ложь, ЭтоПроектнаяЗадача);
		
	ИначеЕсли СвойстваПроекта.ДоходыПоПодразделениям = Истина
		И СвойстваПроекта.ДоходыПоОбъемам = Истина 
		И СвойстваПроекта.ДоходыПоНатуральнымПоказателям = Ложь Тогда
		
		ТаблицаДоходов = ПолучитьТаблицуДвиженийДляЦелейУчетаПоПодразделениям(ЭтотОбъект,
			"Доход", СвойстваПроведения, Истина, Истина, ЭтоПроектнаяЗадача);
		
	ИначеЕсли СвойстваПроекта.ДоходыПоПодразделениям = Истина
		И СвойстваПроекта.ДоходыПоОбъемам = Истина 
		И СвойстваПроекта.ДоходыПоНатуральнымПоказателям = Истина Тогда
						
		ТаблицаДоходов = ПолучитьТаблицуДвиженийДляЦелейУчетаПоПодразделениям(ЭтотОбъект, 
			"Доход", СвойстваПроведения, СвойстваЗадачи.ВключитьСубпродуктыВПланДоходов, Истина, ЭтоПроектнаяЗадача);
		
	КонецЕсли;		
		
	ТаблицаРасходов = ПолучитьТаблицуДвиженийДляЦелейУчетаПоПодразделениям(ЭтотОбъект, 
		"Расход", СвойстваПроведения, Неопределено, СвойстваПроекта.РасходыПоНатуральнымПоказателям, ЭтоПроектнаяЗадача);		
		
	Для Каждого СтрокаТД Из ТаблицаДоходов Цикл
		
		НоваяСтрока = ДанныеДвижений.упоАктуальныеПланыДоходовИРасходовПодразделения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТД);
		
		Если СвойстваПроекта.ДоходыПоНатуральнымПоказателям = Ложь Тогда		
			НоваяСтрока.Количество = 0;			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТР Из ТаблицаРасходов Цикл
		
		НоваяСтрока = ДанныеДвижений.упоАктуальныеПланыДоходовИРасходовПодразделения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТР);
		
		Если СвойстваПроекта.РасходыПоНатуральнымПоказателям = Ложь Тогда			
			НоваяСтрока.Количество = 0;			
		КонецЕсли;
		
	КонецЦикла;
	
	// Зануление.
	
	ДанныеОбработки = Новый Структура ("Регистратор, Период, МассивЗадач, ИмяРегистра",
		ЭтотОбъект.Ссылка, , СвойстваПроведения.ПроектнаяЗадача, "упоАктуальныеПланыДоходовИРасходовПодразделения");
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений.упоАктуальныеПланыДоходовИРасходовПодразделения, ДанныеОбработки,,,
		"Версия = &Версия И ИсточникПлана <> ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты)", 
		Новый Структура("Версия", СвойстваПроведения.Версия), 
		Ложь);
	
КонецПроцедуры

// Процедура заполняет таблицу движений регистра упоАктуальныеПланыВыполненияОбъемов.
//
// Параметры:
//	ЭтотОбъект - ДокументОбъект - объект.
//	ДанныеДвижений - Структура - содержит таблицы движений.
//	СвойстваПроекта - Структура - содержит настройки учета по подразделениям.
//	СвойстваПроведения - Структура - содержит дополнительные настройки учета по подразделениям.
//	Отказ - Булево - признак отказа от проведения.
Процедура ЗаполнитьДвиженияПлановыеОбъемы(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения,
	Отказ) Экспорт
			
	ТаблицаДвижений = ДанныеДвижений.упоАктуальныеПланыВыполненияОбъемов.СкопироватьКолонки();
	
	ЭтоПроектнаяЗадача = ТипЗнч(ЭтотОбъект.Ссылка) = Тип("ДокументСсылка.упоПроектнаяЗадача");		
		
	Если ЭтоПроектнаяЗадача Тогда
		СрокиЗадачи = Новый Структура("ДатаНачала, ДатаЗавершения", СвойстваПроведения.НачДата, СвойстваПроведения.КонДата);
		СрокиЗадач = Новый Соответствие;
		СрокиЗадач.Вставить(ЭтотОбъект.Ссылка, Новый Структура("Результат", СрокиЗадачи));	
	Иначе
		СрокиЗадач = СвойстваПроведения.СрокиЗадач;		
	КонецЕсли;	
	
	// Доходы.
	
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваПроведения.Версия);
	Запрос.УстановитьПараметр("НоменклатураПоУмолчанию", СвойстваПроведения.НатуральныйПоказательДоходов);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоУмолчанию", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("Неопределено", Неопределено);
	
	Если ЭтоПроектнаяЗадача Тогда
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);		
	Иначе	
		Запрос.УстановитьПараметр("СписокЗадач", СвойстваПроведения.ПроектнаяЗадача);
	КонецЕсли;	
	
	Если СвойстваПроекта.ДоходыПоПодразделениям И СвойстваПроекта.ДоходыПоОбъемам Тогда
		
		Если Не СвойстваПроекта.ДоходыПоНатуральнымПоказателям Тогда			
			// Движения по данным ТЧ "План доходов".			
			Если ЭтоПроектнаяЗадача Тогда 
				
				ТаблицаРаспределениеДоходовПоПериодам = ЭтотОбъект.РаспределениеДоходовПоПериодам;
				ТаблицаПланДоходов = ЭтотОбъект.ПланДоходов;
				ТаблицаРаспределениеДоходов = ЭтотОбъект.РаспределениеДоходов;
				
				Запрос.УстановитьПараметр("ТаблицаПланДоходов", ТаблицаПланДоходов);				
				Запрос.УстановитьПараметр("ТаблицаРаспределениеДоходов", ТаблицаРаспределениеДоходов);
				Запрос.УстановитьПараметр("ТаблицаРаспределениеДоходовПоПериодам", ТаблицаРаспределениеДоходовПоПериодам);
			
				ТекстЗапроса = ТекстДоходыПоОбъемам_ДанныеДокумента();
			Иначе
				ТекстЗапроса = ТекстДоходыПоОбъемам_ДанныеРегистров();
			КонецЕсли;										
		Иначе	
		    // Движения по данным ТЧ "Субпродукты".
			Если ЭтоПроектнаяЗадача Тогда 
				
				ТаблицаРаспределениеДоходовПоПериодам = ЭтотОбъект.РаспределениеДоходовПоПериодам;
				ТаблицаРаспределениеОбъемов = ЭтотОбъект.РаспределениеОбъемов;
				ТаблицаСубпродукты = ЭтотОбъект.Субпродукты;
				
				Запрос.УстановитьПараметр("ТаблицаРаспределениеОбъемов", ТаблицаРаспределениеОбъемов);
				Запрос.УстановитьПараметр("ТаблицаСубпродукты", ТаблицаСубпродукты);
				Запрос.УстановитьПараметр("ТаблицаРаспределениеДоходовПоПериодам", ТаблицаРаспределениеДоходовПоПериодам);
				Запрос.УстановитьПараметр("ИсточникПлана", Перечисления.упоИсточникПланаДоходовИРасходов.Объемы);
		
				ТекстЗапроса = ТекстДоходыПоНатуральнымПоказателям_ДанныеДокумента();
			Иначе
				ТекстЗапроса = ТекстДоходыПоНатуральнымПоказателям_ДанныеРегистров();
			КонецЕсли;																					
		КонецЕсли;	
		
		Запрос.Текст = ТекстЗапроса;
		РезультатЗапроса = Запрос.Выполнить();		
		ЗаполнитьТаблицуДвиженийАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(ТаблицаДвижений, РезультатЗапроса, СрокиЗадач);
		
	КонецЕсли;
	
	// Расходы.
	
	Запрос = Новый Запрос;
	
	Если ЭтоПроектнаяЗадача Тогда
		Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.Ссылка);
	Иначе	
		Запрос.УстановитьПараметр("СписокЗадач", СвойстваПроведения.ПроектнаяЗадача);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваПроведения.Версия);
	Запрос.УстановитьПараметр("НоменклатураПоУмолчанию", СвойстваПроведения.НатуральныйПоказательРасходов);
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоУмолчанию", Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("КонтрагентЗатрат", СвойстваПроведения.КонтрагентЗатрат);
	Запрос.УстановитьПараметр("ДоговорЗатрат",СвойстваПроведения.ДоговорЗатрат);
	
	Если СвойстваПроекта.РасходыПоПодразделениям И СвойстваПроекта.РасходыПоОбъемам Тогда
		
		Если НЕ СвойстваПроекта.РасходыПоНатуральнымПоказателям Тогда
		
			Если ЭтоПроектнаяЗадача Тогда 
				
				ТаблицаРаспределениеРасходовПоПериодам = ЭтотОбъект.РаспределениеРасходовПоПериодам;
				ТаблицаПланРасходов = ЭтотОбъект.ПланРасходов;
				ТаблицаРаспределениеРасходов = ЭтотОбъект.РаспределениеРасходов;
				
				Запрос.УстановитьПараметр("ТаблицаРаспределениеРасходовПоПериодам",ТаблицаРаспределениеРасходовПоПериодам);	
				Запрос.УстановитьПараметр("ТаблицаПланРасходов", ТаблицаПланРасходов);
				Запрос.УстановитьПараметр("ТаблицаРаспределениеРасходов", ТаблицаРаспределениеРасходов);
	
				ТекстЗапроса = ТекстРасходыПоОбъемам_ДанныеДокумента();
			Иначе
				ТекстЗапроса = ТекстРасходыПоОбъемам_ДанныеРегистров();
			КонецЕсли;
		    Запрос.Текст = ТекстЗапроса;
							  		
			Запрос.УстановитьПараметр("РасходыПоОбъемам",  СвойстваПроекта.РасходыПоОбъемам);
			Запрос.УстановитьПараметр("Неопределено",  Неопределено);	
			
			РезультатЗапроса = Запрос.Выполнить();		
			ЗаполнитьТаблицуДвиженийАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(ТаблицаДвижений, РезультатЗапроса, СрокиЗадач);
			
		КонецЕсли;	
	
		//////// Данные трансляции ////////
		
		Если ЭтоПроектнаяЗадача Тогда
			ВключитьДопЗатратыВПланРасходов = ЭтотОбъект.ВключитьДопЗатратыВПланРасходов;
			ВключитьМатРесурсыВПланРасходов = ЭтотОбъект.ВключитьМатРесурсыВПланРасходов;
		Иначе	
			// Флаги включения выставляем для попадания в условия, задачи отбираются в МВТ.
			ВключитьДопЗатратыВПланРасходов = Истина;	
			ВключитьМатРесурсыВПланРасходов = Истина;
			
			МВТ = Новый МенеджерВременныхТаблиц;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
			               |	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
			               |	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов
			               |ПОМЕСТИТЬ ВТ_ЗадачиТрансляции
			               |ИЗ
			               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
			               |			,
			               |			Версия = &ТекущаяВерсия
			               |				И ПроектнаяЗадача В (&СписокЗадач)) КАК упоСвойстваПроектныхЗадачСрезПоследних
			               |
			               |ИНДЕКСИРОВАТЬ ПО
			               |	ПроектнаяЗадача";
			Запрос.МенеджерВременныхТаблиц = МВТ;
			Запрос.Выполнить();
		КонецЕсли;	
		
		Если ВключитьДопЗатратыВПланРасходов И НЕ СвойстваПроекта.РасходыПоНатуральнымПоказателям Тогда
				
			Если ЭтоПроектнаяЗадача Тогда
				
				ТаблицаРаспределениеРасходовПоПериодам = ЭтотОбъект.РаспределениеРасходовПоПериодам;
				ТаблицаДополнительныеЗатраты = ЭтотОбъект.ДополнительныеЗатраты;
				ТаблицаРаспределениеДополнительныхЗатрат = ЭтотОбъект.РаспределениеДополнительныхЗатрат;
				
				Запрос.УстановитьПараметр("ТаблицаРаспределениеРасходовПоПериодам",ТаблицаРаспределениеРасходовПоПериодам);	
				Запрос.УстановитьПараметр("ТаблицаДополнительныеЗатраты", ТаблицаДополнительныеЗатраты);
				Запрос.УстановитьПараметр("ТаблицаРаспределениеДополнительныхЗатрат", ТаблицаРаспределениеДополнительныхЗатрат);
			
				ТекстЗапроса = ТекстРасходыТрансляцияДопзатрат_ДанныеДокумента();
			Иначе
				ТекстЗапроса = ТекстРасходыТрансляцияДопзатрат_ДанныеРегистров();
			КонецЕсли;
			
			Запрос.Текст = ТекстЗапроса;
			
			Запрос.УстановитьПараметр("РасходыПоОбъемам",  СвойстваПроекта.РасходыПоОбъемам);
			Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
			Запрос.УстановитьПараметр("ИсточникПлана",  Перечисления.упоИсточникПланаДоходовИРасходов.ДополнительныеЗатраты);
			Запрос.УстановитьПараметр("Неопределено",  Неопределено);
					
			РезультатЗапроса = Запрос.Выполнить();
			ЗаполнитьТаблицуДвиженийАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(ТаблицаДвижений, РезультатЗапроса, СрокиЗадач);
			
		КонецЕсли;
	
		Если ВключитьМатРесурсыВПланРасходов Или СвойстваПроекта.РасходыПоНатуральнымПоказателям Тогда
			
			Если ЭтоПроектнаяЗадача Тогда
				
				ТаблицаРаспределениеРасходовПоПериодам = ЭтотОбъект.РаспределениеРасходовПоПериодам;
				ТаблицаМатериальныеРесурсы = ЭтотОбъект.МатериальныеРесурсы;
				ТаблицаРаспределениеПотребностей = ЭтотОбъект.РаспределениеПотребностей;
				
				Запрос.УстановитьПараметр("ТаблицаРаспределениеРасходовПоПериодам",ТаблицаРаспределениеРасходовПоПериодам);	
				Запрос.УстановитьПараметр("ТаблицаМатериальныеРесурсы", ТаблицаМатериальныеРесурсы);
				Запрос.УстановитьПараметр("ТаблицаРаспределениеПотребностей", ТаблицаРаспределениеПотребностей);	
				
				ТекстЗапроса = ТекстРасходыПоНатуральнымПоказателям_ДанныеДокумента();
			Иначе
				ТекстЗапроса = ТекстРасходыПоНатуральнымПоказателям_ДанныеРегистров();
			КонецЕсли;
			
			Запрос.Текст = ТекстЗапроса;
			
			Запрос.УстановитьПараметр("РасходыПоНатуральнымПоказателям",  СвойстваПроекта.РасходыПоНатуральнымПоказателям);
			Запрос.УстановитьПараметр("РасходыПоОбъемам",  СвойстваПроекта.РасходыПоОбъемам);
			Запрос.УстановитьПараметр("ИсточникПлана",  Перечисления.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты);
			Запрос.УстановитьПараметр("Неопределено",  Неопределено);			
			
			РезультатЗапроса = Запрос.Выполнить();
			ЗаполнитьТаблицуДвиженийАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(ТаблицаДвижений, РезультатЗапроса, СрокиЗадач);
			
		КонецЕсли;
		
	КонецЕсли;	
				
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвижений);
	
	Для Каждого СтрокаДвижений Из ТаблицаДвижений Цикл		
		НоваяСтрока = ДанныеДвижений.упоАктуальныеПланыВыполненияОбъемов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДвижений);		
	КонецЦикла;
			
	ДанныеОбработки = Новый Структура("Регистратор, Период, МассивЗадач, ИмяРегистра",
		ЭтотОбъект.Ссылка, 
		, 
		СвойстваПроведения.ПроектнаяЗадача, 
		"упоАктуальныеПланыВыполненияОбъемов");		
	
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений.упоАктуальныеПланыВыполненияОбъемов, ДанныеОбработки,,,
		"Версия = &Версия", 
		Новый Структура("Версия", СвойстваПроведения.Версия), 
		Ложь);
					
КонецПроцедуры

#Область  ПроверкаЗаполненияОбъектов
	
// Добавляет наличие строк распределения в таблицах распределения доходных и расходных объемов
//  и доп.затрат. При отсутствии добавляет строки распределения и заполняет по умолчанию.
//
// Параметры:
//  ЭтотОбъект							 - ДокументОбъект, УправляемаяФорма	 - объект.
//  ДополнительныеПараметрыРаспределения - Ссруктура						 - настройки распределения.
//  СвойстваПроекта						 - Структура						 - содержит настройки учета по подразделениям.
//  ТаблицыПроверки						 - Неопределено, Структура			 - содержит перечень таблиц проверки.
//  Отказ								 - Булево							 - признак отказа от проведения.
//
Процедура ПроверитьЗаполнитьТабличныеЧастиРаспределений(ЭтотОбъект, ДополнительныеПараметрыРаспределения, СвойстваПроекта = Неопределено, 
	ТаблицыПроверки = Неопределено, Отказ) Экспорт		
	
	Если СвойстваПроекта = Неопределено Тогда
		СвойстваПроекта = ЗаполнитьПараметрыУчетаПоПодразделениям(ЭтотОбъект.Проект);	
	КонецЕсли;	
	
	СтруктураСвойствПоУмолчанию = ПолучитьЗначенияДляПодстановкиПоУмолчанию(ЭтотОбъект.Проект);							
			
	ПроверитьЗаполнитьРаспределениеОбъемов(ЭтотОбъект, ДополнительныеПараметрыРаспределения, СвойстваПроекта,
		СтруктураСвойствПоУмолчанию, ТаблицыПроверки, Отказ);
		
	Если ДополнительныеПараметрыРаспределения.Свойство("ПроверятьРаспределениеДопЗатрат") 
		И ДополнительныеПараметрыРаспределения.ПроверятьРаспределениеДопЗатрат Тогда
		ПроверитьЗаполнитьРаспределениеДопЗатрат(ЭтотОбъект, СвойстваПроекта, СтруктураСвойствПоУмолчанию, Отказ);
	КонецЕсли;	
	
КонецПроцедуры	
// Заполнение распределения в таблице доходов расходов.
//
// Параметры:
//  ТаблицаДвиженийПланБДРПоПодразделениям	 - ТаблицаЗначений	 - исходная таблица с профилями.
//  ТаблицаНеАктуализированных				 - ТаблицаЗначений	 - таблица для актуализации.
//  ТаблицаСроковЗадач						 - ТаблицаЗначений	 - сроки задач
//
Процедура ЗаполнитьРаспределениеВТаблицеДоходовРасходов(ТаблицаДвиженийПланБДРПоПодразделениям, 
	ТаблицаНеАктуализированных, ТаблицаСроковЗадач) Экспорт
	
	Для Каждого СтрокаНеАктуализированных Из ТаблицаНеАктуализированных Цикл
		
		Если СтрокаНеАктуализированных.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.НаДату Тогда
			
			НоваяСтрока = ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных);
			
		ИначеЕсли СтрокаНеАктуализированных.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно Тогда
			
			Если ТипЗнч(ТаблицаСроковЗадач) = Тип("ТаблицаЗначений") Тогда 				
				СтрокаЗадача = ТаблицаСроковЗадач.Найти(СтрокаНеАктуализированных.ПроектнаяЗадача, "Задача");
			Иначе 				
				СтрокаЗадача =  ТаблицаСроковЗадач[СтрокаНеАктуализированных.ПроектнаяЗадача];
			КонецЕсли;		  
			
			Если СтрокаЗадача <> Неопределено Тогда
				
				Если ТипЗнч(ТаблицаСроковЗадач) = Тип("ТаблицаЗначений") Тогда
					РезультатРасчета = СтрокаЗадача;
				Иначе 
					РезультатРасчета = СтрокаЗадача.Результат;  					
				КонецЕсли;
				
				ТаблицаРаспределенная = упоРаспределениеТрудозатратВызовСервера.ПолучитьТаблицуРаспределенияПоПериодамСводно(
					СтрокаНеАктуализированных.ПериодАгрегации, 
					РезультатРасчета.ДатаЗавершения, 
					СтрокаНеАктуализированных.СуммаВалютная); 
				
				Для Каждого СтрокаРаспределенная Из ТаблицаРаспределенная Цикл
					
					НоваяСтрока = ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных);
					НоваяСтрока.СуммаВалютная = СтрокаРаспределенная.Сумма;
					НоваяСтрока.ДатаНачисления = СтрокаРаспределенная.Период;
					
				КонецЦикла;
				
			КонецЕсли;				
			
		ИначеЕсли СтрокаНеАктуализированных.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения Тогда
			
			Если ТипЗнч(ТаблицаСроковЗадач) = Тип("ТаблицаЗначений") Тогда 				
				СтрокаЗадача = ТаблицаСроковЗадач.Найти(СтрокаНеАктуализированных.ПроектнаяЗадача, "Задача");
			Иначе 				
				СтрокаЗадача =  ТаблицаСроковЗадач[СтрокаНеАктуализированных.ПроектнаяЗадача];
			КонецЕсли;		  
			
			Если СтрокаЗадача <> Неопределено Тогда
				
				Если ТипЗнч(ТаблицаСроковЗадач) = Тип("ТаблицаЗначений") Тогда
					РезультатРасчета = СтрокаЗадача;
				Иначе 
					РезультатРасчета = СтрокаЗадача.Результат;  					
				КонецЕсли;
				
				ТаблицаРаспределенная = обРаспределитьДоходыИРасходыПоПрофилю(
				СтрокаНеАктуализированных.ПрофильРаспределения, 
				РезультатРасчета.ДатаНачала, 
				РезультатРасчета.ДатаЗавершения, 
				СтрокаНеАктуализированных.СуммаВалютная);
				
				Счетчик = 1;
				КоличествоРаспределенных = ТаблицаРаспределенная.Количество();
				ИтогПоКолву = 0;
				
				Для Каждого СтрокаРаспределенная Из ТаблицаРаспределенная Цикл
					
					НоваяСтрока = ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных,,"Сумма, СуммаВалютная, Количество"); 
					Если СтрокаНеАктуализированных.СуммаВалютная = 0 Тогда
						ДоляКоличества = 0;	
					Иначе
						ДоляКоличества = СтрокаРаспределенная.Сумма/СтрокаНеАктуализированных.СуммаВалютная;
					КонецЕсли;
					
					НоваяСтрока.СуммаВалютная = СтрокаРаспределенная.Сумма;
					НоваяСтрока.ДатаНачисления = СтрокаРаспределенная.Период;
					
					Если Счетчик = КоличествоРаспределенных Тогда
						
						НоваяСтрока.Количество =  СтрокаНеАктуализированных.Количество - ИтогПоКолву;
						
					Иначе
						
						НоваяСтрока.Количество = СтрокаНеАктуализированных.Количество * ДоляКоличества;
						ИтогПоКолву = ИтогПоКолву + НоваяСтрока.Количество;
						
					КонецЕсли;
					
					Счетчик = Счетчик + 1;
					
				КонецЦикла;
				
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока =  ТаблицаДвиженийПланБДРПоПодразделениям.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНеАктуализированных);
							
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверка заполнения способа привязки и связанных с ним реквизитов в табличных частях распределения.
// В т.ч. проверяется распределение по периодам.
//
// Параметры:
//  ЭтотОбъект		 - ДокументОбъект, СправочникОбъект - объект.
//  ПроверяемыеТЧ	 - СписокЗначений 					- содержит перечень таблиц проверки. 
//  Отказ			 - Булево    						- признак отказа от проведения.
//  СвойстваПроекта	 - Неопределено, Структура			- содержит настройки учета по подразделениям (для проектной задачи).
//
Процедура ПроверитьЗаполнениеТабличныхЧастей(ЭтотОбъект, ПроверяемыеТЧ, Отказ, СвойстваПроекта = Неопределено) Экспорт

	Для Каждого ПроверяемаяТЧ Из ПроверяемыеТЧ Цикл
		
		ИмяТаблицыРаспределения = ПроверяемаяТЧ.Значение;
		
		НадоФормироватьНомерПодчиненнойСтрокиДляСобщения = 
			НадоФормироватьНомерПодчиненнойСтрокиДляСобщения(ИмяТаблицыРаспределения);
		Если НадоФормироватьНомерПодчиненнойСтрокиДляСобщения Тогда
			СоответствиеНомераСтрок = Новый Соответствие;
		КонецЕсли;
		
		Для каждого стрПроверяемойТЧ Из ЭтотОбъект[ИмяТаблицыРаспределения] Цикл
			
			// Способ привязки
			упоПроектыИЗадачиОбщие.ПроверитьЗаполнениеСпособаПривязки(ЭтотОбъект, стрПроверяемойТЧ, ИмяТаблицыРаспределения, 
				ПроверяемаяТЧ.Представление, Отказ);
			
			// Распределение по периодам
			НомерСтрокиДляСообщения = НомерСтрокиДляСообщения(стрПроверяемойТЧ, СоответствиеНомераСтрок, 
				НадоФормироватьНомерПодчиненнойСтрокиДляСобщения);
                
            ИмяКолонкиСпособПривязки = "СпособПривязки";               
                
            Если ПроверяемаяТЧ.Значение = "ДополнительныеЗатраты" Тогда
                ИмяКолонкиСпособПривязки = "СпособПривязкиДоходовРасходов";	
            КонецЕсли; 
            
            ПроверитьЗаполнениеРаспределенияПоПериодам(ЭтотОбъект, СвойстваПроекта, стрПроверяемойТЧ, ПроверяемаяТЧ, 
				ИмяКолонкиСпособПривязки, НомерСтрокиДляСообщения, Отказ);
			
		КонецЦикла;
			
	КонецЦикла;
		
КонецПроцедуры

// Формировние параметров для проверки распределения по периодам и вызов метода проверки распределния по периодам.
//
// Параметры:
//  ЭтотОбъект		 		 - ДокументОбъект, СправочникОбъект - объект. 
//  СвойстваПроекта			 - Неопределено, Структура			- содержит настройки учета по подразделениям (для проектной задачи). 
//  СтрокаРаспределения		 - ДокументТабличнаяЧастьСтрока 	- Строка табличной части.
//  ПроверяемаяТЧ			 - ЭлементСпискаЗначений			- Проверяемая табличная часть.
//  ИмяКолонкиСпособПривязки - Строка	 						- Имя колонки способа привязки.
//  НомерСтрокиДляСообщения	 - Число							- Номер строки для сообщения.
//  Отказ					 - Булево 							- признак отказа от проведения. 
//
Процедура ПроверитьЗаполнениеРаспределенияПоПериодам(ЭтотОбъект, СвойстваПроекта, СтрокаРаспределения, ПроверяемаяТЧ, 
        ИмяКолонкиСпособПривязки, НомерСтрокиДляСообщения, Отказ)
        
	Если Не СтрокаРаспределения[ИмяКолонкиСпособПривязки] = Перечисления.упоСпособПривязкиРаспределения.Вручную Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблицыРаспределения = ПроверяемаяТЧ.Значение;
	ИсточникПлана = Неопределено;
	
	ПараметрыПроверки = Новый Структура();
	ПараметрыПроверки.Вставить("ПроверяемаяТЧ", ПроверяемаяТЧ);
	ПараметрыПроверки.Вставить("СтрокаТЧ", СтрокаРаспределения);
	ПараметрыПроверки.Вставить("ИмяИндексаТаблицыПоПериодам", "ИндексСтрокиРаспределениеПоРолям");
	ПараметрыПроверки.Вставить("НомерСтроки", НомерСтрокиДляСообщения);
	
	ЭтоПроектнаяЗадача = ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоПроектнаяЗадача");

	Если ИмяТаблицыРаспределения = "ТрудовыеРесурсы" Тогда
		
		ПараметрыПроверки.Вставить("ИмяПроверяемойТЧПоПериодам", ИмяТаблицыРаспределения + "ПоПериодам");
		
		ПроверятьСумму = Ложь;
		ПроверятьКоличество = Истина;
	
	ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеРасходов" Тогда
		
		ПараметрыПроверки.Вставить("ИмяИндексаТаблицыПоПериодам", "ИндексСтрокиРаспределенияРасходов");
		ПараметрыПроверки.Вставить("ИмяПроверяемойТЧПоПериодам", ИмяТаблицыРаспределения + "ПоПериодам");
		ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы;
		
		ПроверятьСумму = Истина;
		ПроверятьКоличество = Ложь;
		
	ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеПотребностей" Тогда
		
		ПараметрыПроверки.Вставить("ИмяПроверяемойТЧПоПериодам", "РаспределениеРасходовПоПериодам");
		ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты;
		
		ПроверятьСумму = Ложь;
		ПроверятьКоличество = Ложь;
		Если ЗначениеЗаполнено(СвойстваПроекта) Тогда			
			Если СвойстваПроекта.РасходыПоНатуральнымПоказателям 
				Или (СвойстваПроекта.РасходыПоОбъемам И ЭтотОбъект.ВключитьМатРесурсыВПланРасходов) Тогда
				ПроверятьСумму = Истина;
				ПроверятьКоличество = Истина;
			КонецЕсли;
		Иначе
			ПроверятьСумму = Истина;
			ПроверятьКоличество = Истина;
		КонецЕсли;
	
	ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеОбъемов"  Тогда
		
		ПараметрыПроверки.Вставить("ИмяПроверяемойТЧПоПериодам", "РаспределениеДоходовПоПериодам");
		
		// Проверка на источник плана добавляется только для проектной задачи, 
		// т.к. в шаблонах в распределении объемов источник плана не заполняется.
		Если ЭтоПроектнаяЗадача Тогда
			ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.Объемы;
		КонецЕсли;
	
		ПроверятьСумму = Истина;
		ПроверятьКоличество = Истина;
		
	ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеДоходов" Тогда
		
		ПараметрыПроверки.Вставить("ИмяИндексаТаблицыПоПериодам", "ИндексСтрокиРаспределенияДоходов");
		ПараметрыПроверки.Вставить("ИмяПроверяемойТЧПоПериодам", "РаспределениеДоходовПоПериодам");
		ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы;
		
		ПроверятьСумму = Истина;
		ПроверятьКоличество = Ложь;
		
	ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат" Тогда
		
		ПараметрыПроверки.Вставить("ИмяПроверяемойТЧПоПериодам", "РаспределениеРасходовПоПериодам");
		ИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.ДополнительныеЗатраты;
		
		ПроверятьСумму = Ложь;
		ПроверятьКоличество = Ложь;
		Если ЗначениеЗаполнено(СвойстваПроекта) Тогда			
			Если Не СвойстваПроекта.РасходыПоНатуральнымПоказателям 
				И СвойстваПроекта.РасходыПоОбъемам И ЭтотОбъект.ВключитьДопЗатратыВПланРасходов Тогда
				ПроверятьСумму = Истина;
			КонецЕсли;
		Иначе
			ПроверятьСумму = Истина;
		КонецЕсли;
	
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсточникПлана) Тогда
		ПараметрыПроверки.Вставить("ИсточникПлана", ИсточникПлана);			
	КонецЕсли;
	
	ПроверитьРаспределениеПоПериодамПоСтроке(ЭтотОбъект, ПараметрыПроверки, ПроверятьСумму, ПроверятьКоличество, Отказ);
	
КонецПроцедуры

// Проверяет распределение по периодам по строке.
//
// Параметры:
//  ЭтотОбъект		  - ДокументОбъект, СправочникОбъект - объект. 
//  ПараметрыПроверки - Структура:		
//   	* ИмяИндексаТаблицыПоПериодам	- Строка.
//      * ИмяПроверяемойТЧПоПериодам	- Строка.
//      * ИсточникПлана 				- ПеречислениеСсылка.
//      * НомерСтроки					- Число.
//      * ПроверяемаяТЧ 				- ЭлементСпискаЗначений.
//      * СтрокаТЧ 						- ДокументТабличнаяЧастьСтрока.
//  ПроверятьСумму		 - Булево	 	- признак нужно ли проверять сумму. 
//  ПроверятьКоличество	 - Булево	 	- признак нужно ли проверять количество.
//  Отказ				 - Булево	 	- признак отказа от проведения. 
//
Процедура ПроверитьРаспределениеПоПериодамПоСтроке(ЭтотОбъект, ПараметрыПроверки, ПроверятьСумму, ПроверятьКоличество, Отказ)
	
	СтрокаТЧ = ПараметрыПроверки.СтрокаТЧ;
	ПроверяемаяТЧ = ПараметрыПроверки.ПроверяемаяТЧ;
	ИндексСтрокиРаспределения = СтрокаТЧ.ИндексСтрокРаспределенияПоПериодам;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить(ПараметрыПроверки.ИмяИндексаТаблицыПоПериодам, ИндексСтрокиРаспределения);
	Если ПараметрыПроверки.Свойство("ИсточникПлана") И ЗначениеЗаполнено(ПараметрыПроверки.ИсточникПлана) Тогда
		ПараметрыОтбора.Вставить("ИсточникПлана", ПараметрыПроверки.ИсточникПлана);
	КонецЕсли;	
	ТЗСОтбором = ЭтотОбъект[ПараметрыПроверки.ИмяПроверяемойТЧПоПериодам].Выгрузить(ПараметрыОтбора);
	
	Если ПараметрыПроверки.ИмяПроверяемойТЧПоПериодам = "ТрудовыеРесурсыПоПериодам" Тогда
		МассивСтрокПоУровнюПланирования = ЭтотОбъект["ТрудовыеРесурсы"].НайтиСтроки(
			Новый Структура("УровеньПланирования", СтрокаТЧ.УровеньПланирования));	
		НомерСтрокиДляСообщения = МассивСтрокПоУровнюПланирования.Найти(СтрокаТЧ) + 1;
		Если СтрокаТЧ.УровеньПланирования = Перечисления.упоУровеньПланирования.Предварительный Тогда
			ТекстУровеньПланирования = НСтр("ru = 'для уровня планирования ""Предварительный""'");
		Иначе
			ТекстУровеньПланирования = НСтр("ru = 'для уровня планирования ""Окончательный""'");	
		КонецЕсли;	
	Иначе
		НомерСтрокиДляСообщения = ПараметрыПроверки.НомерСтроки;
		ТекстУровеньПланирования = "";
	КонецЕсли; 
	
	Если ПроверятьСумму Тогда
		
		СуммаРаспределенное = ТЗСОтбором.Итог("Сумма");
		
		Если СуммаРаспределенное <> СтрокаТЧ.Сумма Тогда
			Если ПроверятьКоличество Тогда
				КолвоРаспределенное = ТЗСОтбором.Итог("Количество");
				Если КолвоРаспределенное <> СтрокаТЧ.Количество Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'В строке №%1 табличной части ""%2"" %3 сумма и количество, распределенные по месяцам, не соответствуют общей сумме и общему количеству.'"),
									НомерСтрокиДляСообщения, ПроверяемаяТЧ.Представление, ТекстУровеньПланирования);
				Иначе
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'В строке №%1 табличной части ""%2"" %3 сумма, распределенная по месяцам, не соответствует общей сумме.'"),
									НомерСтрокиДляСообщения, ПроверяемаяТЧ.Представление, ТекстУровеньПланирования);					
				КонецЕсли;
			Иначе	
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'В строке №%1 табличной части ""%2"" %3 сумма, распределенная по месяцам, не соответствует общей сумме.'"),
									НомерСтрокиДляСообщения, ПроверяемаяТЧ.Представление, ТекстУровеньПланирования);
			КонецЕсли;	
			СформироватьСообщениеПользователю(ЭтотОбъект, ТекстСообщения, ПроверяемаяТЧ.Значение, СтрокаТЧ, "Сумма", Отказ);
		КонецЕсли;
		
	ИначеЕсли ПроверятьКоличество Тогда
		
		КолвоРаспределенное = ТЗСОтбором.Итог("Количество");
		
	 	Если КолвоРаспределенное <> СтрокаТЧ.Количество Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'В строке №%1 табличной части ""%2"" %3 количество, распределенное по месяцам, не соответствует общему количеству.'"),
								НомерСтрокиДляСообщения, ПроверяемаяТЧ.Представление, ТекстУровеньПланирования);
			СформироватьСообщениеПользователю(ЭтотОбъект, ТекстСообщения, ПроверяемаяТЧ.Значение, СтрокаТЧ, "Количество", Отказ);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует структуру настроек учета по подразделениям для проекта.
//
// Возвращаемое значение:
//	Структура – содержит настройки по подразделениям.
Функция ПолучитьСтруктуруСвойствУчета() Экспорт
	
	СтруктураСвойств = Новый Структура;
	
	СтруктураСвойств.Вставить("ВедетсяБюджетДоходов", Ложь);	
	СтруктураСвойств.Вставить("ДоходыПоПодразделениям", Ложь);
	СтруктураСвойств.Вставить("ДоходыПоОбъемам", Ложь);	
	СтруктураСвойств.Вставить("ДоходыПоНатуральнымПоказателям", Ложь);
	
	СтруктураСвойств.Вставить("ВедетсяБюджетРасходов", Ложь);	
	СтруктураСвойств.Вставить("РасходыПоПодразделениям", Ложь);
	СтруктураСвойств.Вставить("РасходыПоОбъемам", Ложь);
	СтруктураСвойств.Вставить("РасходыПоНатуральнымПоказателям", Ложь);
	
	СтруктураСвойств.Вставить("НастройкаРаспределенияБДР", Справочники.упоНастройкиРаспределенияБДР.ПустаяСсылка());
	
	СтруктураСвойств.Вставить("ПланироватьТрудозатратыПоРолям", Ложь);	
	СтруктураСвойств.Вставить("ВыделятьНаВыполнениеРаботРесурсы", Ложь);
	СтруктураСвойств.Вставить("ПланироватьТрудозатратыПоПроекту", Ложь);   
	СтруктураСвойств.Вставить("УказыватьПодразделениеРолиПриПланированииТР", Ложь);
	СтруктураСвойств.Вставить("ПланироватьЗатратыНаМатериалы", Ложь);
	СтруктураСвойств.Вставить("ПланироватьДополнительныеЗатратыПоЗадаче", Ложь);
	СтруктураСвойств.Вставить("ИспользоватьАналитикуКонтрагентДляСС", Ложь);	
	СтруктураСвойств.Вставить("РазрешитьСозданиеОбсужденийБезУказанияПроектнойЗадачи", Ложь);
	
	СтруктураСвойств.Вставить("ИспользоватьЗначенияДляПроектныхЗадачВРасчетахСПоказателямиGGF", Ложь);
	
	СтруктураСвойств.Вставить("ВедетсяБюджетДвиженияДенежныхСредств", Ложь);
	
	СтруктураСвойств.Вставить("РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен", Ложь);
	СтруктураСвойств.Вставить("РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусахЗапланированУтвержден", Ложь);
	
	СтруктураСвойств.Вставить("НастройкаПоказателейДляКарточкиПроектов", Неопределено);
	
	СтруктураСвойств.Вставить("ЗапретитьРПЗИзменятьСрокиЧужихЗадач", Ложь);
    
	СтруктураСвойств.Вставить("РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам", Ложь);
	
	СтруктураСвойств.Вставить("НормаСтоимостиТрудовыхРесурсов", Справочники.упоНормыСтоимости.ПустаяСсылка());
	СтруктураСвойств.Вставить("ВнешняяНормаСтоимостиТрудовыхРесурсов", Справочники.упоНормыСтоимости.ПустаяСсылка());
	СтруктураСвойств.Вставить("НастройкаДереваКлючевыхПоказателей", Справочники.упоНастройкиДереваКлючевыхПоказателей.ПустаяСсылка());
	
	СтруктураСвойств.Вставить("НастройкаУровняПланированияПриРасчетеГотовностиПроектов", Неопределено);
	
	СтруктураСвойств.Вставить("УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат", Ложь); 
	СтруктураСвойств.Вставить("НаследоватьЗначениеПоляОбъектИзЗадачиРодителя", Ложь);
	СтруктураСвойств.Вставить("НазначатьРСПОсновнойРолиКакРПЗ", Ложь);
	СтруктураСвойств.Вставить("УстанавливатьПризнакОсновнаяПриДобавленииРоли", Ложь);
	СтруктураСвойств.Вставить("ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки", Ложь);
	  	  
	Возврат СтруктураСвойств;
	
КонецФункции

// Формирует общую (из констант) структуру настоек учета по подразделениям.
//
// Возвращаемое значение:
//	Структура – содержит настройки по подразделениям.
Функция ПолучитьСвойстваУчетаПоУмолчанию() Экспорт
	
	СтруктураСвойств = ПолучитьСтруктуруСвойствУчета();
	
	СтруктураСвойств.ВедетсяБюджетДоходов = Константы.упоВедетсяБюджетДоходов.Получить();	
	СтруктураСвойств.ДоходыПоПодразделениям = Константы.упоДоходыПоПодразделениям.Получить();
	СтруктураСвойств.ДоходыПоОбъемам = Константы.упоДоходыПоОбъемам.Получить();	
	СтруктураСвойств.ДоходыПоНатуральнымПоказателям = Константы.упоДоходыПоНатуральнымПоказателям.Получить();
	
	СтруктураСвойств.ВедетсяБюджетРасходов = Константы.упоВедетсяБюджетРасходов.Получить();	
	СтруктураСвойств.РасходыПоПодразделениям = Константы.упоРасходыПоПодразделениям.Получить();
	СтруктураСвойств.РасходыПоОбъемам = Константы.упоРасходыПоОбъемам.Получить();
	СтруктураСвойств.РасходыПоНатуральнымПоказателям = Константы.упоРасходыПоНатуральнымПоказателям.Получить();
	
	СтруктураСвойств.НастройкаРаспределенияБДР = Константы.упоНастройкаРаспределенияБДРПоУмолчанию.Получить();
	
	СтруктураСвойств.ПланироватьТрудозатратыПоРолям = Ложь;	
	СтруктураСвойств.ВыделятьНаВыполнениеРаботРесурсы = Ложь;
	СтруктураСвойств.ПланироватьТрудозатратыПоПроекту = Константы.упоПланироватьТрудозатратыПоПроекту.Получить();
	СтруктураСвойств.УказыватьПодразделениеРолиПриПланированииТР = 
		Константы.упоУказыватьПодразделениеРолиПриПланированииТР.Получить();
	СтруктураСвойств.ПланироватьЗатратыНаМатериалы = Константы.упоПланироватьЗатратыНаМатериалы.Получить();
	СтруктураСвойств.ПланироватьДополнительныеЗатратыПоЗадаче = Константы.упоПланироватьДополнительныеЗатратыПоЗадаче.Получить();
	СтруктураСвойств.ИспользоватьАналитикуКонтрагентДляСС = Константы.упоИспользоватьАналитикуКонтрагентДляСС.Получить();			
	
	СтруктураСвойств.РазрешитьСозданиеОбсужденийБезУказанияПроектнойЗадачи = Константы.упоРазрешитьСозданиеОбсужденийБезУказанияПроектнойЗадачи.Получить();
	
	СтруктураСвойств.ИспользоватьЗначенияДляПроектныхЗадачВРасчетахСПоказателямиGGF = Константы.упоИспользоватьЗначенияДляПроектныхЗадачВРасчетахСПоказателямиGGF.Получить();
	
	СтруктураСвойств.ВедетсяБюджетДвиженияДенежныхСредств = Константы.упоВедетсяБюджетДвиженияДенежныхСредств.Получить();
	
	СтруктураСвойств.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен = Константы.упоРазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен.Получить();
	СтруктураСвойств.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусахЗапланированУтвержден = Константы.упоРазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусахЗапланированУтвержден.Получить();
	
	СтруктураСвойств.НормаСтоимостиТрудовыхРесурсов = Константы.упоНормаСтоимостиПоУмолчанию.Получить();
	СтруктураСвойств.ВнешняяНормаСтоимостиТрудовыхРесурсов = Константы.упоНормаСтоимостиПоУмолчаниюВнешняя.Получить();
	СтруктураСвойств.НастройкаДереваКлючевыхПоказателей = Константы.упоНастройкаДереваКлючевыхПоказателей.Получить();
	
	упоНастройкаПоказателейДляКарточкиПроектов = Константы.упоНастройкаПоказателейДляКарточкиПроектов.Получить(); 
	Адрес = ПоместитьВоВременноеХранилище(упоНастройкаПоказателейДляКарточкиПроектов);
	СтруктураСвойств.НастройкаПоказателейДляКарточкиПроектов = Адрес;
	
	СтруктураСвойств.НастройкаУровняПланированияПриРасчетеГотовностиПроектов = Константы.упоНастройкаУровняПланированияПриРасчетеГотовностиПроектов.Получить(); 
	СтруктураСвойств.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат = Константы.упоУчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат.Получить(); 
	СтруктураСвойств.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя = Константы.упоНаследоватьЗначениеПоляОбъектИзЗадачиРодителя.Получить(); 

	СтруктураСвойств.ЗапретитьРПЗИзменятьСрокиЧужихЗадач = Константы.упоЗапретитьРПЗИзменятьСрокиЧужихЗадач.Получить();
    
	СтруктураСвойств.РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам = Константы.упоРассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам.Получить();
	
	СтруктураСвойств.НазначатьРСПОсновнойРолиКакРПЗ = Константы.упоНазначатьРСПОсновнойРолиКакРПЗ.Получить();
	СтруктураСвойств.УстанавливатьПризнакОсновнаяПриДобавленииРоли = Константы.упоУстанавливатьПризнакОсновнаяПриДобавленииРоли.Получить();
	СтруктураСвойств.ХранитьВВерсияхПроцентыГотовСтатусыИФактСроки =
		Константы.упоХранитьВВерсияхПроцентыГотовСтатусыИФактСроки.Получить();
	
	СтруктураСвойств.Вставить("ИспользоватьЗаказыКлиентов", Ложь);
	СтруктураСвойств.Вставить("ИспользоватьЗаказыПоставщикам", Ложь);
	Если упоИнтеграцияКлиентСервер.ИнтеграцияСЗаказамиПоставщикамКлиентам() Тогда
		СтруктураСвойств.ИспользоватьЗаказыКлиентов = 
			упоФункцииОбщегоНазначенияСервер.упоПолучитьФункциональнуюОпцию("ИспользоватьЗаказыКлиентов");
		СтруктураСвойств.ИспользоватьЗаказыПоставщикам = 
			упоФункцииОбщегоНазначенияСервер.упоПолучитьФункциональнуюОпцию("ИспользоватьЗаказыПоставщикам");
	КонецЕсли;
	
	Возврат СтруктураСвойств;
	
КонецФункции

// Процедура заполняет таблицу движений регистра упоФактДоходовИРасходовОбороты.
//
// Параметры:
//	ЭтотОбъект - ДокументОбъект - объект.
//	ДанныеДвижений - Структура - содержит таблицы движений.
//	СвойстваПроекта - Структура - содержит настройки учета по подразделениям.
//	СвойстваПроведения - Структура - содержит дополнительные настройки учета по подразделениям.
//	Отказ - Булево - признак отказа от проведения.
Процедура ЗаполнитьДвиженияДоходыРасходы(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ)
	
	Перем ТаблицаДоходов, ТаблицаРасходов, ТекстЗапроса;
	
	Запрос = Новый Запрос;
	
	ТипОбъекта = ТипЗнч(ЭтотОбъект);
	Если ТипОбъекта = Тип("ДокументОбъект.упоРегистрацияФактическихДоходовИРасходов")
		Или ТипОбъекта = Тип("ДокументОбъект.упоРегистрацияФактическихЗатратМатРесурсов") Тогда
	
		// Доходы.
		Если  СвойстваПроекта.ДоходыПоПодразделениям = Ложь Тогда
			
			ТекстЗапроса = "ВЫБРАТЬ
			               |	&ТекущаяВерсия КАК ТекущаяВерсия,
			               |	упоРегистрацияФактическихДоходовИРасходовДоходы.ПроектнаяЗадача КАК ПроектнаяЗадача,
			               |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход) КАК ВидЭлемента,
			               |	упоРегистрацияФактическихДоходовИРасходовДоходы.Контрагент КАК Контрагент,
			               |	упоРегистрацияФактическихДоходовИРасходовДоходы.Договор КАК Договор,
			               |	упоРегистрацияФактическихДоходовИРасходовДоходы.Валюта КАК Валюта,
			               |	СУММА(упоРегистрацияФактическихДоходовИРасходовДоходы.Сумма) КАК Сумма,
			               |	СУММА(упоРегистрацияФактическихДоходовИРасходовДоходы.Сумма) КАК СуммаВалютная,
			               |	0 КАК Количество,
			               |	упоРегистрацияФактическихДоходовИРасходовДоходы.Статья КАК Статья,
			               |	упоРегистрацияФактическихДоходовИРасходовДоходы.ДатаНачисления КАК Период
