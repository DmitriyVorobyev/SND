//

Процедура ЗаполнитьТаблицуДвиженийАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(ТаблицаДвижений, РезультатЗапроса, СрокиЗадач)
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДоходРасход = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДоходРасход.Следующий() Цикл
		
		Если ВыборкаДоходРасход.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.НаДату Тогда					
			НоваяСтрока = ТаблицаДвижений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДоходРасход);					
		ИначеЕсли ВыборкаДоходРасход.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения Тогда
			
			СрокиЗадачи = СрокиЗадач[ВыборкаДоходРасход.ПроектнаяЗадача].Результат;
			
			Если ЗначениеЗаполнено(СрокиЗадачи.ДатаНачала) Тогда
				Если ВыборкаДоходРасход.СуммаВалютная = 0 Тогда
					ТаблицаРаспределенная = обРаспределитьДоходыИРасходыПоПрофилю(ВыборкаДоходРасход.ПрофильРаспределения,
						СрокиЗадачи.ДатаНачала,
						СрокиЗадачи.ДатаЗавершения,					
						ВыборкаДоходРасход.Количество,
						Истина);
					ЗаполнитьСтрокуДвиженияАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(
						ТаблицаРаспределенная, 
						ТаблицаДвижений, 
						ВыборкаДоходРасход, 
						Ложь);
				Иначе
					ТаблицаРаспределенная = обРаспределитьДоходыИРасходыПоПрофилю(ВыборкаДоходРасход.ПрофильРаспределения,
						СрокиЗадачи.ДатаНачала,
						СрокиЗадачи.ДатаЗавершения,
						ВыборкаДоходРасход.СуммаВалютная);
					ЗаполнитьСтрокуДвиженияАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(
						ТаблицаРаспределенная, 
						ТаблицаДвижений, 
						ВыборкаДоходРасход);	
				КонецЕсли;
			Иначе						
				НоваяСтрока = ТаблицаДвижений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДоходРасход);						
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстДоходыПоОбъемам_ДанныеДокумента()
	
	Возврат "ВЫБРАТЬ
	        |	ТаблицаРаспределениеДоходовПоПериодам.НомерСтроки КАК НомерСтроки,
	        |	ТаблицаРаспределениеДоходовПоПериодам.Период КАК Период,
	        |	ТаблицаРаспределениеДоходовПоПериодам.ИндексСтрокиРаспределениеПоРолям КАК ИндексСтрокиРаспределениеПоРолям,
	        |	ТаблицаРаспределениеДоходовПоПериодам.ИндексСтрокиРаспределенияДоходов КАК ИндексСтрокиРаспределенияДоходов,
	        |	ТаблицаРаспределениеДоходовПоПериодам.Сумма КАК Сумма,
