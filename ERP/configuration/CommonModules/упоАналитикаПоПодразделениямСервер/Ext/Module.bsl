	        |	ВТ_ДопЗатраты.Договор КАК Договор,
	        |	ВЫБОР
	        |		КОГДА ВТ_РаспределениеПоПодразделениямДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |			ТОГДА ЛОЖЬ
	        |		ИНАЧЕ ИСТИНА
	        |	КОНЕЦ КАК Выводить
	        |ПОМЕСТИТЬ ВТ_СводноДопЗатраты
	        |ИЗ
	        |	ВТ_ДопЗатраты КАК ВТ_ДопЗатраты
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеПоПодразделениямДопЗатраты КАК ВТ_РаспределениеПоПодразделениямДопЗатраты
	        |		ПО ВТ_ДопЗатраты.ИндексСтрокРаспределения = ВТ_РаспределениеПоПодразделениямДопЗатраты.ИндексСтрокиВладельца
	        |			И ВТ_ДопЗатраты.ПроектнаяЗадача = ВТ_РаспределениеПоПодразделениямДопЗатраты.ПроектнаяЗадача
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	ВТ_ДопЗатраты.ПроектнаяЗадача,
	        |	ВТ_РаспределениеПоПодразделениямДопЗатраты.Подразделение,
	        |	ВТ_РаспределениеПоПодразделениямДопЗатраты.Роль,
	        |	ВТ_РаспределениеПоПериодамДопЗатраты.Сумма,
	        |	ВТ_РаспределениеПоПериодамДопЗатраты.Сумма,
	        |	ВТ_ДопЗатраты.СтатьяЗатрат,
	        |	ВТ_РаспределениеПоПериодамДопЗатраты.Период,
	        |	ВТ_РаспределениеПоПодразделениямДопЗатраты.СобствСилы_Субподряд,
	        |	ВЫБОР
	        |		КОГДА &РасходыПоОбъемам
	        |			ТОГДА ЕСТЬNULL(ВТ_РаспределениеПоПодразделениямДопЗатраты.СпособПривязки, ВТ_ДопЗатраты.СпособПривязки)
	        |		ИНАЧЕ ВТ_ДопЗатраты.СпособПривязки
	        |	КОНЕЦ,
	        |	ВЫБОР
	        |		КОГДА &РасходыПоОбъемам
	        |			ТОГДА ЕСТЬNULL(ВТ_РаспределениеПоПодразделениямДопЗатраты.ПрофильРаспределения, ВТ_ДопЗатраты.ПрофильРаспределения)
	        |		ИНАЧЕ ВТ_ДопЗатраты.ПрофильРаспределения
	        |	КОНЕЦ,
	        |	ВТ_ДопЗатраты.Контрагент,
	        |	ВТ_ДопЗатраты.Договор,
	        |	ВТ_ДопЗатраты.Контрагент,
	        |	ВТ_ДопЗатраты.Договор,
	        |	ВЫБОР
	        |		КОГДА ВТ_РаспределениеПоПодразделениямДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |			ТОГДА ИСТИНА
	        |		ИНАЧЕ ЛОЖЬ
	        |	КОНЕЦ
	        |ИЗ
	        |	ВТ_ДопЗатраты КАК ВТ_ДопЗатраты
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеПоПодразделениямДопЗатраты КАК ВТ_РаспределениеПоПодразделениямДопЗатраты
	        |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеПоПериодамДопЗатраты КАК ВТ_РаспределениеПоПериодамДопЗатраты
	        |			ПО ВТ_РаспределениеПоПодразделениямДопЗатраты.ИндексСтрокРаспределенияПоПериодам = ВТ_РаспределениеПоПериодамДопЗатраты.ИндексСтрокиРаспределениеПоРолям
	        |				И ВТ_РаспределениеПоПодразделениямДопЗатраты.ПроектнаяЗадача = ВТ_РаспределениеПоПериодамДопЗатраты.ПроектнаяЗадача
	        |				И (ВТ_РаспределениеПоПодразделениямДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную))
	        |		ПО ВТ_ДопЗатраты.ИндексСтрокРаспределения = ВТ_РаспределениеПоПодразделениямДопЗатраты.ИндексСтрокиВладельца
	        |			И ВТ_ДопЗатраты.ПроектнаяЗадача = ВТ_РаспределениеПоПодразделениямДопЗатраты.ПроектнаяЗадача
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	&ТекущаяВерсия КАК Версия,
	        |	ВТ_СводноДопЗатраты.ПроектнаяЗадача КАК ПроектнаяЗадача,
	        |	ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Расход) КАК ВидОбъема,
	        |	&ВалютаУправленческогоУчета КАК Валюта,
	        |	ВТ_СводноДопЗатраты.Подразделение КАК Подразделение,
	        |	ВТ_СводноДопЗатраты.Роль КАК Роль,
	        |	ВТ_СводноДопЗатраты.Статья КАК Статья,
	        |	ВТ_СводноДопЗатраты.ДатаНачисления КАК ДатаНачисления,
	        |	ВТ_СводноДопЗатраты.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	        |	ВЫБОР
	        |		КОГДА ВТ_СводноДопЗатраты.СпособПривязки ССЫЛКА Перечисление.упоСпособПривязкиРаспределения
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_СводноДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.НаДату)
	        |							ИЛИ ВТ_СводноДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |						ТОГДА ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
	        |					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения)
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_СводноДопЗатраты.СпособПривязки
	        |	КОНЕЦ КАК СпособПривязки,
	        |	ВТ_СводноДопЗатраты.ПрофильРаспределения КАК ПрофильРаспределения,
	        |	ВТ_СводноДопЗатраты.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	        |	ВТ_СводноДопЗатраты.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	        |	ВТ_СводноДопЗатраты.Контрагент КАК Контрагент,
	        |	ВТ_СводноДопЗатраты.Договор КАК Договор,
	        |	&ИсточникПлана КАК ИсточникПлана,
	        |	СУММА(ВТ_СводноДопЗатраты.Сумма) КАК Сумма,
	        |	СУММА(ВТ_СводноДопЗатраты.СуммаВалютная) КАК СуммаВалютная,
	        |	0 КАК Количество,
	        |	ВТ_СводноДопЗатраты.Выводить КАК Выводить
	        |ИЗ
	        |	ВТ_СводноДопЗатраты КАК ВТ_СводноДопЗатраты
	        |ГДЕ
	        |	ВТ_СводноДопЗатраты.Выводить
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_СводноДопЗатраты.СобствСилы_Субподряд,
	        |	ВТ_СводноДопЗатраты.Статья,
	        |	ВТ_СводноДопЗатраты.ДатаНачисления,
	        |	ВТ_СводноДопЗатраты.ПроектнаяЗадача,
	        |	ВТ_СводноДопЗатраты.Подразделение,
	        |	ВТ_СводноДопЗатраты.Роль,
	        |	ВТ_СводноДопЗатраты.ПрофильРаспределения,
	        |	ВТ_СводноДопЗатраты.КонтрагентПодрядчик,
	        |	ВТ_СводноДопЗатраты.Заказ_ДоговорПодрядчика,
	        |	ВТ_СводноДопЗатраты.Контрагент,
	        |	ВТ_СводноДопЗатраты.Договор,
	        |	ВТ_СводноДопЗатраты.Выводить,
	        |	ВЫБОР
	        |		КОГДА ВТ_СводноДопЗатраты.СпособПривязки ССЫЛКА Перечисление.упоСпособПривязкиРаспределения
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_СводноДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.НаДату)
	        |							ИЛИ ВТ_СводноДопЗатраты.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |						ТОГДА ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
	        |					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения)
	        |				КОНЕЦ
	        |		ИНАЧЕ ВТ_СводноДопЗатраты.СпособПривязки
	        |	КОНЕЦ";							
	
КонецФункции

// Прокси для упоАналитикаПоПодразделениямКлиентСервер.
//		СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода()
//
Функция СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода(СпособПривязкиДоходаРасхода)
		
	Возврат упоАналитикаПоПодразделениямКлиентСервер.
		СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода(СпособПривязкиДоходаРасхода); 

КонецФункции

Процедура ЗаполнитьСтрокуДвиженияАктуальныеПланыВыполненияОбъемовПоДаннымВыборки(
			ТаблицаРаспределенная, ТаблицаДвижений, ВыборкаДоходРасход, РаспределятьКоличество = Истина)

	ОбщееКоличество = 0;					
	Для Каждого СтрокаРаспределенная Из ТаблицаРаспределенная Цикл
		
		НоваяСтрока = ТаблицаДвижений.Добавить();							
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДоходРасход);
		НоваяСтрока.ДатаНачисления = СтрокаРаспределенная.Период;
		
		Если Не РаспределятьКоличество Тогда
			НоваяСтрока.Количество = СтрокаРаспределенная.Количество;
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока.СуммаВалютная = СтрокаРаспределенная.Сумма;
		
		Если ВыборкаДоходРасход.СуммаВалютная <> 0 Тогда
			Доля = СтрокаРаспределенная.Сумма / ВыборкаДоходРасход.СуммаВалютная;
		Иначе
			Доля = 0;
		КонецЕсли;
		
		ОстатокРаспределения = ВыборкаДоходРасход.Количество - ОбщееКоличество;
		Если ОстатокРаспределения > 0 Тогда
			КоличествоРаспределенное = Окр(Доля * НоваяСтрока.Количество, 3);
			Если КоличествоРаспределенное <> 0 Тогда
				НоваяСтрока.Количество = Мин(КоличествоРаспределенное, ОстатокРаспределения);
			ИначеЕсли Доля <> 0 Тогда
				НоваяСтрока.Количество = Мин(0.001, ОстатокРаспределения);
			Иначе
				НоваяСтрока.Количество = ОстатокРаспределения;
			КонецЕсли;
			ОбщееКоличество = ОбщееКоличество + НоваяСтрока.Количество;
		Иначе
			НоваяСтрока.Количество = 0;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

Функция НадоФормироватьНомерПодчиненнойСтрокиДляСобщения(ИмяТаблицыРаспределения)
	
	Возврат ИмяТаблицыРаспределения = "РаспределениеПотребностей"
		Или ИмяТаблицыРаспределения = "РаспределениеОбъемов" 
		Или ИмяТаблицыРаспределения = "РаспределениеРасходов"
		Или ИмяТаблицыРаспределения = "РаспределениеДоходов";
	
КонецФункции

Процедура СформироватьСообщениеПользователю(ЭтотОбъект, ТекстСообщения, ИмяПроверяемойТЧ, стрПроверяемойТЧ, ПолеИмя, Отказ)
	
	Поле = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.%1[%2].%3Остаток", 
								ИмяПроверяемойТЧ, 
								Формат(ЭтотОбъект[ИмяПроверяемойТЧ].Индекс(стрПроверяемойТЧ), "ЧН=0; ЧГ=0"),
								ПолеИмя);
								
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , Поле, , Отказ);	
	
КонецПроцедуры

Функция НомерСтрокиДляСообщения(СтрокаРаспределения, СоответствиеНомераСтрок, НадоФормироватьНомерПодчиненнойСтрокиДляСобщения)
	
	Если НадоФормироватьНомерПодчиненнойСтрокиДляСобщения Тогда
		ИндексСтрокиВладельца = СтрокаРаспределения.ИндексСтрокиВладельца;
		Если ИндексСтрокиВладельца <> Неопределено Тогда
			НомерСтроки = СоответствиеНомераСтрок.Получить(ИндексСтрокиВладельца);
			Если НомерСтроки = Неопределено Тогда
				СоответствиеНомераСтрок.Вставить(ИндексСтрокиВладельца, 1);
				НомерСтроки = 1;
			Иначе
				НомерСтроки = НомерСтроки + 1;
			КонецЕсли;
		КонецЕсли;
	Иначе
		НомерСтроки = СтрокаРаспределения.НомерСтроки;
	КонецЕсли;
	
	Возврат НомерСтроки;
	
КонецФункции

#КонецОбласти