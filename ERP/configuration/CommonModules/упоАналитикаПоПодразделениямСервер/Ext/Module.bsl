	        |	ВТ_ПланРасходов.Контрагент,
	        |	ВТ_РаспределениеРасходов.СобствСилы_Субподряд,
	        |	ВТ_ПланРасходов.Договор,
	        |	ВТ_ПланРасходов.Контрагент,
	        |	ВТ_ПланРасходов.Договор,
	        |	ВЫБОР
	        |		КОГДА ВТ_РаспределениеРасходов.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
	        |			ТОГДА ИСТИНА
	        |		ИНАЧЕ ЛОЖЬ
	        |	КОНЕЦ,
	        |	ВТ_ПланРасходов.ИсточникПлана
	        |ИЗ
	        |	ВТ_ПланРасходов КАК ВТ_ПланРасходов
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РаспределениеРасходов КАК ВТ_РаспределениеРасходов
	        |			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаРаспределенияПоПериодам КАК ВТ_ТаблицаРаспределенияПоПериодам
	        |			ПО (ВТ_РаспределениеРасходов.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную))
	        |				И ВТ_РаспределениеРасходов.ИндексСтрокРаспределенияПоПериодам = ВТ_ТаблицаРаспределенияПоПериодам.ИндексСтрокиРаспределенияРасходов
	        |		ПО ВТ_ПланРасходов.ИндексСтрокРаспределения = ВТ_РаспределениеРасходов.ИндексСтрокиВладельца
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_Сводно.Версия КАК Версия,
	        |	ВТ_Сводно.ПроектнаяЗадача КАК ПроектнаяЗадача,
	        |	ВТ_Сводно.Статья КАК Статья,
	        |	ВТ_Сводно.ВидОбъема КАК ВидОбъема,
	        |	ВТ_Сводно.Валюта КАК Валюта,
	        |	ВТ_Сводно.Подразделение КАК Подразделение,
	        |	ВТ_Сводно.Роль КАК Роль,
	        |	СУММА(ВТ_Сводно.Сумма) КАК Сумма,
	        |	СУММА(ВТ_Сводно.СуммаВалютная) КАК СуммаВалютная,
	        |	СУММА(ВТ_Сводно.Количество) КАК Количество,
	        |	ВЫБОР
	        |		КОГДА ТИПЗНАЧЕНИЯ(ВТ_Сводно.СпособПривязки) = ТИП(Перечисление.упоСпособПривязкиРаспределения)
	        |			ТОГДА ВЫБОР
	        |					КОГДА ВТ_Сводно.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.НаДату)
	        |							ИЛИ ВТ_Сводно.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиРаспределения.Вручную)
