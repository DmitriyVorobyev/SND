Процедура ЗаполнитьТаблицуДвиженийДоходПоДаннымРегистров(ТаблицаДвижений, СвойстваПроведения, Знач РаспределениеБДР, 
	РаспределениеНатурПоказателей)
	
	ЗадачиВключитьСубпродуктыВПланДоходов = СвойстваПроведения.ЗадачиВключитьСубпродуктыВПланДоходов;
	
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("СписокЗадач", СвойстваПроведения.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ТекущаяВерсия", СвойстваПроведения.Версия);
	Запрос.УстановитьПараметр("ИсточникПлана", Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Статья КАК Статья,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.Валюта КАК Валюта,
	               |	упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Подразделение КАК Подразделение,
	               |	упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Роль КАК Роль,
	               |	ЕСТЬNULL(упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.Сумма, упоДанныеПлановДоходовИРасходовСрезПоследних.Сумма) КАК Сумма,
	               |	ЕСТЬNULL(упоДанныеПлановДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная, упоДанныеПлановДоходовИРасходовСрезПоследних.СуммаВалютная) КАК СуммаВалютная,
				   |	ВЫБОР
				   |		КОГДА упоДанныеПлановДоходовИРасходовСрезПоследних.СпособПривязки = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.НаДату)
				   |			ТОГДА упоДанныеПлановДоходовИРасходовСрезПоследних.ДатаПривязки
				   |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
				   |	КОНЕЦ КАК ДатаНачисления,
				   |	упоДанныеПлановДоходовИРасходовСрезПоследних.СпособПривязки КАК СпособПривязки,
	               |	упоДанныеПлановДоходовИРасходовСрезПоследних.ПрофильРаспределения КАК ПрофильРаспределения,
