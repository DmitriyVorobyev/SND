КонецФункции 

// Возвращает значения показателей проектов.
//
// Параметры:
//  Показатели	 - Массив, Соответствие	 - Список показателей проекта. Если тип параметра Показатели - соответствие тогда
//  	Соответствие - Список проектов и значений показателей.
//  	* Ключ - СправочникСсылка.Проекты - Ссылка на проект.
//  	* Значение - Соответствие - Список значений показателей.
//  	** Ключ -	СправочникСсылка.упоПоказателиПроектов - Ссылка на показатель.
//  	** Значение - Соответствие - Список идентификаторов параметров показателя.
//  	*** Ключ - Число - Идентификатор параметра показателя.
//  	*** Значение - Соответствие - Значение показателя.
//  Проекты					 - Массив	 - Список проектов.
//  РасчетВДокументе		 - Булево	 - Признак вызова функции из документа "упоРегистрацияПоказателейПроекта".
//  СтруктураДопПараметров	 - Структура - Параметры запроса получения данных по индикаторам.
//  ФорматироватьРезультат	 - Булево	 - Применить форматирование к полученным значениям показателей.
// 
// Возвращаемое значение:
//  Соответствие - Список проектов и значений показателей.
//  * Ключ - СправочникСсылка.Проекты - Ссылка на проект.
//  * Значение - Соответствие - Список значений показателей.
//  ** Ключ -	СправочникСсылка.упоПоказателиПроектов - Ссылка на показатель.
//  ** Значение - Произвольный - Значение показателя.
//
Функция ПолучитьЗначенияПоказателей(Показатели, 
			Проекты, 
			РасчетВДокументе = Ложь, 
			СтруктураДопПараметров = Неопределено,
			ФорматироватьРезультат = Ложь) Экспорт

	Если Проекты.Количество() = 0 Или Показатели.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	МасПоказателей = Новый Массив;
	ПоказателиСПараметрами = Неопределено;
	Если ТипЗнч(Показатели) = Тип("Соответствие") Тогда	
		Для Каждого Показатель Из Показатели Цикл
			МасПоказателей.Добавить(Показатель.Ключ);	
		КонецЦикла;
		ПоказателиСПараметрами = Показатели;
	Иначе		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МасПоказателей, Показатели, Истина);	
	КонецЕсли;	
		
	// Получим основные данные по показателям.
	Запрос = Новый Запрос;	
	Запрос.Текст = ПолучитьТекстЗапросаКПроектамИПоказателям();	
	Запрос.УстановитьПараметр("Проекты", Проекты);
	Запрос.УстановитьПараметр("Показатели", МасПоказателей);
	Запрос.УстановитьПараметр("ВидЗаполненияАвтоматически", 
		ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЗаполненияИндикатора.Автоматически"));
	Запрос.УстановитьПараметр("ВидЗаполненияАвтоматическиВДокументе",
		ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЗаполненияИндикатора.АвтоматическиВДокументе"));
	Запрос.УстановитьПараметр("РасчетВДокументе", РасчетВДокументе);
	
	ПакетЗапроса = Запрос.ВыполнитьПакет();	
	
	ДанныеПоПоказателям = ПакетЗапроса[3].Выгрузить();
	ДанныеПоПоказателям.Индексы.Добавить("Показатель");
	
	// Заполним значения по умолчанию для списка полей.
	СписокПолейИзначальный = Новый ТаблицаЗначений;
	СписокПолейИзначальный.Колонки.Добавить("Показатель", Новый ОписаниеТипов("СправочникСсылка.упоПоказателиПроектов"));
	СписокПолейИзначальный.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	СписокПолейИзначальный.Колонки.Добавить("ЗначениеПоУмолчанию");
	СписокПолейИзначальный.Индексы.Добавить("Показатель");
	Для Каждого Элем Из МасПоказателей Цикл
		Если ЗначениеЗаполнено(Элем) Тогда
			ИмяПоказателя = упоПанельПоказателейВызовСервера.ПолучитьИмяПоказателя(Элем);			
			Строка = СписокПолейИзначальный.Добавить();
			Строка.Показатель = Элем;
			Строка.Представление = ИмяПоказателя;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из СписокПолейИзначальный Цикл
		НайденнаяСтрока = ДанныеПоПоказателям.Найти(Строка.Показатель, "Показатель");
		Если НайденнаяСтрока <> Неопределено Тогда
			Строка.ЗначениеПоУмолчанию = ТипизацияНезаполненногоПоказателя(НайденнаяСтрока.ТипИндикатора);
		Иначе
			Строка.ЗначениеПоУмолчанию = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	ЕстьПоказателиСПараметрами = ПоказателиСПараметрами <> Неопределено;
	Если ЕстьПоказателиСПараметрами Тогда
		ЗаполнитьТабДанныеПоПоказателямПараметрами(ДанныеПоПоказателям, ПоказателиСПараметрами);		
	КонецЕсли;	
	
	ФормульныеПоказатели = ПакетЗапроса[1].Выгрузить();
	ДанныеПоВсемПоказателям = ПакетЗапроса[4].Выгрузить();  // Для расчета формул.
	ДанныеПоВсемПоказателям.Индексы.Добавить("Показатель");
	РасчетныеИндикаторыПоказателей = ПакетЗапроса[5].Выгрузить();
	РасчетныеИндикаторыПоказателей.Индексы.Добавить("Показатель");
	
	// Получим формулы.
	ПоляФормульныхПоказателей = Новый Структура;	
	ПоказателиИзФормульныхПоказателей = Новый СписокЗначений;				
	ДополнитьПоказателямиИзФормул(ФормульныеПоказатели, ДанныеПоПоказателям, 
		ДанныеПоВсемПоказателям, РасчетныеИндикаторыПоказателей, РасчетВДокументе, ПоляФормульныхПоказателей,
		ПоказателиИзФормульныхПоказателей);	
		
	ЗаполнитьПредставлениеВЗаданнойТаблице(ФормульныеПоказатели);	
	ЗаполнитьПредставлениеВЗаданнойТаблице(ДанныеПоПоказателям);
		
	ЕстьПроектныеЗадачи = Не ПакетЗапроса[7].Пустой();
	ЕстьПроекты = Не ПакетЗапроса[8].Пустой();
	
	ДопПараметры = Новый Структура;
	РучныеПоказатели = Новый Массив;
	
	ТекстЗапроса = ПолучитьТекстЗапросаПолученияЗначений(ДанныеПоПоказателям, ДопПараметры, РучныеПоказатели, ЕстьПроекты,
		ЕстьПроектныеЗадачи, РасчетВДокументе, ЕстьПоказателиСПараметрами);
		
	Запрос = Новый Запрос;	
	Запрос.Текст = ТекстЗапроса;	
	ТекДата = упоПоказателиПроектовСервер.ПолучитьТекДатуДляПоказателейФОТ();
	Запрос.УстановитьПараметр("ТекДата", ТекДата);
	Запрос.УстановитьПараметр("ТекДатаСеанса", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Проекты", Проекты);
	Запрос.УстановитьПараметр("Показатели", ДанныеПоПоказателям.ВыгрузитьКолонку("Показатель"));
	Запрос.УстановитьПараметр("РучныеИндикаторы", РучныеПоказатели);
	
	Для Каждого ДопПараметр Из ДопПараметры Цикл
		Запрос.УстановитьПараметр(ДопПараметр.Ключ, ДопПараметр.Значение);
	КонецЦикла;
	
	Если СтруктураДопПараметров <> Неопределено Тогда
		Для Каждого КлючЗначение Из СтруктураДопПараметров Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);		
		КонецЦикла;				
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Добавим если нужно Предшественников в ПоказателиИзФормульныхПоказателей.	
	СписокПредшественников = ЗаполнитьСписокПредшественниками(СписокПолейИзначальный, ПоказателиИзФормульныхПоказателей);
	
	ТаблицаПоказателейИндикаторов = ПолучитьПустуюТаблицуПоказателейИндикаторов(ДанныеПоПоказателям, ЕстьПоказателиСПараметрами,
		ПоказателиИзФормульныхПоказателей);	
	
	ЗаполнитьИзВыборкиТаблицуПоказателейИндикаторов(Выборка, ТаблицаПоказателейИндикаторов,
		ПоказателиИзФормульныхПоказателей, ЕстьПоказателиСПараметрами);
	
	упоПанельПоказателейВызовСервера.ЗаполнитьПоказателиПредшественниковВТаблицеПоказателей(ТаблицаПоказателейИндикаторов,
		ПоказателиИзФормульныхПоказателей);	
	
	ТаблицаПоказателейИндикаторов = ПосчитатьФормульныеПоказатели(ТаблицаПоказателейИндикаторов, ПоляФормульныхПоказателей,
		СписокПредшественников, ФормульныеПоказатели);	
		
	Возврат ПолучитьДанныеИзВыборки(Выборка, ДанныеПоПоказателям, ФорматироватьРезультат, ЕстьПоказателиСПараметрами,
		ТаблицаПоказателейИндикаторов, СписокПолейИзначальный);
		
КонецФункции	

// Возвращает значение показателя проекта.
//
// Параметры:
//  ЗначенияПоказателейПроектов	 - Соответствие			 - Список показателей проекта, см. возвращаемое значение ПолучитьЗначенияПоказателей(...).
//  Показатель					 - СправочникСсылка.упоПоказателиПроектов	 - Показатель.
//  Проект						 - СправочникСсылка.Проекты					 - Проект.
//  ИдентификаторПараметра		 - Число									 - Идентификатор параметра показателя.
// 
// Возвращаемое значение:
//  Произвольный
//
Функция ПолучитьЗначениеПоказателяПроекта(ЗначенияПоказателейПроектов, Показатель, Проект, ИдентификаторПараметра = Неопределено) Экспорт
	
	ПоказательПроекта = ЗначенияПоказателейПроектов.Получить(Проект);	
	
	Если ПоказательПроекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ИдентификаторПараметра <> Неопределено Тогда
		
		ДанныеПоПоказателюСНомерами = ПоказательПроекта.Получить(Показатель);
		
		Если ДанныеПоПоказателюСНомерами = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ЗначенияПоказателяСНомеромПараметров = ДанныеПоПоказателюСНомерами.Получить(ИдентификаторПараметра);
		
		Если ЗначенияПоказателяСНомеромПараметров = Неопределено Тогда
			Возврат ДанныеПоПоказателюСНомерами.Получить(0);
		КонецЕсли;		
		
		Возврат ЗначенияПоказателяСНомеромПараметров;
		
	Иначе	
		
		Возврат ПоказательПроекта.Получить(Показатель);	
		
	КонецЕсли;
	
КонецФункции

// Добавляет в текст запроса отборы по отмененным задачам для регистров с плановыми данными.
//
// Параметры:
//  ТекстЗапроса	- Строка - Исходный текст запроса
// 
// Возвращаемое значение:
//  Строка - Модифицированный текст запроса.
//
Функция ДобавитьПроверкуОтмененныхЗадачВТекстЗапроса(ТекстЗапроса) Экспорт
	
	РегистрыПлановыхДанных = 				РегистрыПлановыхДанных();	
	РегистрыПлановыхДанныхТекущаяВерсия = 	РегистрыПлановыхДанныхТекущаяВерсия();
	
	СхемаЗапроса = Новый СхемаЗапроса;	
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
			
	Для Каждого ПакетЗапроса ИЗ СхемаЗапроса.ПакетЗапросов Цикл
		 ОбработатьОператорыСхемыЗапроса(ПакетЗапроса.Операторы, 
		 	РегистрыПлановыхДанных, РегистрыПлановыхДанныхТекущаяВерсия);	
	КонецЦикла;	
		
	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипизацияНезаполненногоПоказателя(ТипПоказателя)
	
	Результат = Неопределено;
	
	Если ТипПоказателя = Перечисления.упоТипИндикатора.Число Тогда
		Результат = 0;
	ИначеЕсли ТипПоказателя = Перечисления.упоТипИндикатора.Дата Тогда
		Результат = Дата(1,1,1);
	ИначеЕсли ТипПоказателя = Перечисления.упоТипИндикатора.Булево Тогда
		Результат = Ложь;
	ИначеЕсли ТипПоказателя = Перечисления.упоТипИндикатора.Строка Тогда	
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьСтрокуПоТипуСвязи(ТипСвязи)
		
	лТипСвязи = "ОН";
	Если ТипСвязи = ПредопределенноеЗначение("Перечисление.упоТипСвязи.НачалоНачало") Тогда
		лТипСвязи = "НН";
	ИначеЕсли ТипСвязи = ПредопределенноеЗначение("Перечисление.упоТипСвязи.НачалоОкончание") Тогда
		лТипСвязи = "НО";
	ИначеЕсли ТипСвязи = ПредопределенноеЗначение("Перечисление.упоТипСвязи.ОкончаниеОкончание") Тогда
		лТипСвязи = "ОО";
	КонецЕсли;
	
	Возврат лТипСвязи;
	
КонецФункции

