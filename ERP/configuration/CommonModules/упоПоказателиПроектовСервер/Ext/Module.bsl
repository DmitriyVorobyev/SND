// Функция - Возвращает значение показателя проекта.
//
// Параметры:
//  Показатель				 - СправочникСсылка.упоПоказателиПроектов	 - Показатель.
//  Проект					 - СправочникСсылка.Проекты					 - Проект.
//  РасчетВДокументе		 - Булево									 - Признак вызова функции из документа "упоРегистрацияПоказателейПроекта" - Булево.
//  ТекстОшибки				 - Строка
//  СтруктураДопПараметров	 - Структура
//  ФорматироватьРезультат	 - Булево
// 
// Возвращаемое значение:
//  Произвольный, Неопределено - Значение показателя, Неопределено когда значения нет.
//
Функция ПолучитьЗначениеПоказателя(
			Показатель, 
			Проект, 
			РасчетВДокументе = Ложь, 
			ТекстОшибки = "", 
			СтруктураДопПараметров = Неопределено,
			ФорматироватьРезультат = Ложь) Экспорт
	
	Результат = Неопределено;
	
	Если Не ЗначениеЗаполнено(Показатель) ИЛИ Не ЗначениеЗаполнено(Проект) Тогда
		ТекстОшибкиЗаполнения = НСтр("ru = 'Не указан проект или показатель'");
		ТекстОшибки = ТекстОшибки + ТекстОшибкиЗаполнения + Символы.ПС;
		Возврат Результат;
	КонецЕсли;
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(Показатель);
	МассивПроектов = Новый Массив;
	МассивПроектов.Добавить(Проект);
	ЗначенияПоказателейПроектов = ПолучитьЗначенияПоказателей(МассивПоказателей, МассивПроектов, РасчетВДокументе,
		СтруктураДопПараметров, ФорматироватьРезультат);
	
	Возврат ПолучитьЗначениеПоказателяПроекта(ЗначенияПоказателейПроектов, Показатель, Проект);
	
КонецФункции

// Функция - Получить соответствие показателей предшественников
//
// Параметры:
//  МассивЗеркалПроектныхЗадач	 - Массив	 -  Массив зеркал проектных задач.
// 
// Возвращаемое значение:
//  Соответствие - Ключ - зеркало проектной задачи, Значение - структура с ключами Предшественники и ПредшественникиПроектов
//						  с массивами подготовленными для СтрСоединить в значениях.
//
Функция ПолучитьСоответствиеПоказателейПредшественников(МассивЗеркалПроектныхЗадач) Экспорт
	
	ЗапросПредшественников = Новый Запрос;
	ЗапросПредшественников.УстановитьПараметр("МассивЗеркалПроектныхЗадач", МассивЗеркалПроектныхЗадач);
	ЗапросПредшественников.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
	|	Проекты.Ссылка КАК Зеркало
	|ПОМЕСТИТЬ ВТ_Задачи
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|ГДЕ
	|	Проекты.Ссылка В(&МассивЗеркалПроектныхЗадач)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоПредусловияПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	ВТ_Задачи.Зеркало КАК Зеркало,
	|	упоПредусловияПроектныхЗадачСрезПоследних.ЗадачаПредшественник КАК ЗадачаПредшественник,
	|	упоПредусловияПроектныхЗадачСрезПоследних.ТипСвязи КАК ТипСвязи,
	|	упоПредусловияПроектныхЗадачСрезПоследних.Задержка КАК Задержка,
	|	упоПредусловияПроектныхЗадачСрезПоследних.СвязьМеждуПроектами КАК СвязьМеждуПроектами
	|ПОМЕСТИТЬ ВТ_Предшественники
	|ИЗ
	|	РегистрСведений.упоПредусловияПроектныхЗадач.СрезПоследних(
	|			,
	|			ПроектнаяЗадача В
	|				(ВЫБРАТЬ
	|					Вт_Задачи.ПроектнаяЗадача
	|				ИЗ
	|					Вт_Задачи КАК Вт_Задачи)) КАК упоПредусловияПроектныхЗадачСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Задачи КАК ВТ_Задачи
	|		ПО упоПредусловияПроектныхЗадачСрезПоследних.ПроектнаяЗадача = ВТ_Задачи.ПроектнаяЗадача
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|		ПО упоПредусловияПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	|			И (упоВерсииПроекта.Текущая)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ) КАК СвойстваПредшественника
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроектовПредшественников
	|			ПО СвойстваПредшественника.Версия = упоВерсииПроектовПредшественников.Версия
	|				И (упоВерсииПроектовПредшественников.Текущая)
	|				И (НЕ СвойстваПредшественника.ЗадачаОтменена)
	|		ПО упоПредусловияПроектныхЗадачСрезПоследних.ЗадачаПредшественник = СвойстваПредшественника.ПроектнаяЗадача
	|ГДЕ
	|	упоПредусловияПроектныхЗадачСрезПоследних.СвязьСуществует
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Предшественники.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	ВТ_Предшественники.Зеркало КАК Зеркало,
	|	ВТ_Предшественники.ЗадачаПредшественник КАК ЗадачаПредшественник,
	|	ВТ_Предшественники.ТипСвязи КАК ТипСвязи,
	|	ВТ_Предшественники.Задержка КАК Задержка,
	|	ВТ_Предшественники.СвязьМеждуПроектами КАК СвязьМеждуПроектами,
	|	Проекты.Ссылка КАК ЗеркалоПредшественника,
	|	Проекты.КодСДР КАК КодСДРПредшественника,
	|	Проекты.упоКорневойПроект КАК ПроектПредшественника
	|ИЗ
	|	ВТ_Предшественники КАК ВТ_Предшественники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО ВТ_Предшественники.ЗадачаПредшественник = Проекты.СсылкаНаПроектнуюЗадачу";
	
	ВыборкаПредшественников = ЗапросПредшественников.Выполнить().Выбрать();
	
	СоответствиеПредшественников = Новый Соответствие;
	
	Пока ВыборкаПредшественников.Следующий() Цикл
		
		СтруктураЗадачи = СоответствиеПредшественников.Получить(ВыборкаПредшественников.Зеркало);
		Если СтруктураЗадачи = Неопределено Тогда
			СтруктураЗадачи = Новый Структура("Предшественники, ПредшественникиПроектов", Новый Массив, Новый Массив);;
		КонецЕсли;
		
		Если ВыборкаПредшественников.СвязьМеждуПроектами Тогда
			
			ТекМассив = СтруктураЗадачи.ПредшественникиПроектов;	
			
			ТекМассив.Добавить("[");
			ТекМассив.Добавить(Строка(ВыборкаПредшественников.ПроектПредшественника));
			ТекМассив.Добавить("]");	
			ТекМассив.Добавить("/");
			
		Иначе
			
			ТекМассив = СтруктураЗадачи.Предшественники;
			
		КонецЕсли;
		
		ТекМассив.Добавить(ВыборкаПредшественников.КодСДРПредшественника);		
		
		Если НЕ ВыборкаПредшественников.ТипСвязи = Перечисления.упоТипСвязи.ОкончаниеНачало Тогда
			
			ТекМассив.Добавить(ПолучитьСтрокуПоТипуСвязи(ВыборкаПредшественников.ТипСвязи));
			
		КонецЕсли;
		
		Если НЕ ВыборкаПредшественников.Задержка = 0 Тогда
			ТекМассив.Добавить("(");
			ТекМассив.Добавить(Формат(ВыборкаПредшественников.Задержка, "ЧГ="));
			ТекМассив.Добавить(")");
		КонецЕсли;
		
		ТекМассив.Добавить(";");
		ТекМассив.Добавить(" ");	
		
		СоответствиеПредшественников.Вставить(ВыборкаПредшественников.Зеркало, СтруктураЗадачи);
		
	КонецЦикла;	
	
	Возврат СоответствиеПредшественников;

КонецФункции 

// Возвращает значение показателя для списка проектов.
//
// Параметры:
//  Показатель				 - СправочникСсылка.упоПоказателиПроектов	 - Показатель.
//  МассивПроектовИЗадач	 - 											 - Массив (СправочникСсылка.Проекты) - список проектов.
//  РасчетВДокументе		 - 											 - Признак вызова функции из документа "упоРегистрацияПоказателейПроекта" - Булево.
//  Ошибки					 - Неопределено, Соответствие				 - ошибки получения показателя.
//  СтруктураДопПараметров	 - Структура
// 
// Возвращаемое значение:
//  Соответствие - :
//  * Ключ - СправочникСсылка.Проекты
//  * Значение - Произвольный, Неопределено - Значение показателя, Неопределено когда значения нет.
//
Функция ПолучитьЗначенияПоказателяДляСпискаПроектов(Показатель, МассивПроектовИЗадач, РасчетВДокументе = Ложь, Ошибки = Неопределено, СтруктураДопПараметров = Неопределено) Экспорт
	
	ЗначенияПоказателяПроектов = Новый Соответствие;
	Если Ошибки = Неопределено Тогда
		Ошибки = Новый Соответствие;		
	КонецЕсли;	
	
	ТекстОшибки = "";
	Если Не ЗначениеЗаполнено(Показатель) ИЛИ Не ЗначениеЗаполнено(МассивПроектовИЗадач) Тогда
		ТекстОшибкиЗаполнения = НСтр("ru = 'Не указан список проектов или показатель'");
		ТекстОшибки = ТекстОшибки + ТекстОшибкиЗаполнения + Символы.ПС;
		Возврат ЗначенияПоказателяПроектов;
	КонецЕсли;
	
	МассивПоказателей = Новый Массив;
	МассивПоказателей.Добавить(Показатель);
	
	ЗначенияПоказателейПроектов = ПолучитьЗначенияПоказателей(МассивПоказателей, МассивПроектовИЗадач, РасчетВДокументе,
		СтруктураДопПараметров);
		
	ВозвращаемыеЗначения = Новый Соответствие;	
	Для Каждого Проект Из МассивПроектовИЗадач Цикл
		ВозвращаемыеЗначения.Вставить(Проект, ПолучитьЗначениеПоказателяПроекта(ЗначенияПоказателейПроектов, Показатель, Проект));	
	КонецЦикла;
	
	Возврат ВозвращаемыеЗначения;
		
КонецФункции

// Сообщает пользователю ошибки получения показателя для списка проектов.
//
// Параметры:
//  Показатель  - СправочникСсылка.упоПоказателиПроектов - показатель, получение которого привело к ошибкам.
//  Ошибки  - Соответствие:
//			* Ключ - СправочникСсылка.Проект - проект или проектная задача, для показателя которой получена ошибка.
//			* Значение - Строка - описание ошибки.
//
Процедура СообщитьОшибкиПолученияПоказателяДляСпискаПроектов(Показатель, Ошибки) Экспорт

	Если Ошибки = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если Ошибки.Количество() > 0 Тогда
		МассивОшибок = Новый Массив;
		МассивОшибок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'При получении показателя ""%1"" для следующих задач произошли ошибки:'"),
			Показатель)); 
		Для Каждого Ошибка Из Ошибки Цикл
			МассивОшибок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("""%1"" :  %2", 
				Ошибка.Ключ, Ошибка.Значение));
		КонецЦикла;			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрСоединить(МассивОшибок, Символы.ПС));
	КонецЕсли;	

КонецПроцедуры // ()

// Получить массив показателей по типу проекта
//
// Параметры:
//  ТипПроекта	 - СправочникСсылка.упоТипыПроектов	 - Тип проекта
// 
// Возвращаемое значение:
//  МассивПоказателей - Массив показателей
//
Функция ПолучитьМассивПоказателейПоТипуПроекта(ТипПроекта) Экспорт
	
	МассивПоказателей = Новый Массив;
	
	Если ТипПроекта = Справочники.упоТипыПроектов.Продажа Тогда
		МассивПоказателей.Добавить(Справочники.упоПоказателиПроектов.ВероятностьПродажи);	
		МассивПоказателей.Добавить(Справочники.упоПоказателиПроектов.ДатаПродажиПрогноз);	
		МассивПоказателей.Добавить(Справочники.упоПоказателиПроектов.СуммаДоговораПрогноз);	
		МассивПоказателей.Добавить(Справочники.упоПоказателиПроектов.СуммаДоговораФакт);	
	КонецЕсли;
	
	Возврат МассивПоказателей;
	
КонецФункции

