// Изменяет имена регистров в тексте запроса показателей.
//
// Возвращаемое значение:
//	Неопределено - не возвращает ничего.
//
Функция ПереименоватьРегистрыСвВПоказателях() Экспорт 
	
	СписокПереименованныхРегистров = Новый СписокЗначений;
	СписокПоказателейСУстаревшимиРС = Новый СписокЗначений;
	
	СписокПереименованныхРегистров.Добавить("упоДанныеПлановыхДоходовИРасходов", "упоДанныеПлановДоходовИРасходовПодразделения");
	СписокПереименованныхРегистров.Добавить("упоПланДоходовИРасходов", "упоАктуальныеПланыДоходовИРасходовПодразделения");
	СписокПереименованныхРегистров.Добавить("упоДанныеПлановыхОбъемов", "упоДанныеПлановОбъемовПодразделения");
	СписокПереименованныхРегистров.Добавить("упоПлановыеОбъемы", "упоАктуальныеПланыВыполненияОбъемов");
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	                |	упоПоказателиПроектов.Ссылка,
	                |	упоПоказателиПроектов.ТекстЗапроса
	                |ИЗ
	                |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	                |ГДЕ
	                |	упоПоказателиПроектов.ТипЗаполнения = 0
	                |	И упоПоказателиПроектов.ВидЗаполнения В(&ТипИндикатора)
	                |	И НЕ упоПоказателиПроектов.ПометкаУдаления";
	
	МассивТиповИ = Новый Массив;
	МассивТиповИ.Добавить(Перечисления.упоВидЗаполненияИндикатора.Автоматически);
	МассивТиповИ.Добавить(Перечисления.упоВидЗаполненияИндикатора.АвтоматическиВДокументе);
	 
	Запрос.УстановитьПараметр("ТипИндикатора", МассивТиповИ);
	
	ВыборкаПоказателей = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаПоказателей.Следующий() Цикл
		
		Для Каждого УстаревшийРС Из СписокПереименованныхРегистров Цикл
			
			Если Найти(ВыборкаПоказателей.ТекстЗапроса, "РегистрСведений." + УстаревшийРС.Значение) > 0
				И СписокПоказателейСУстаревшимиРС.НайтиПоЗначению(ВыборкаПоказателей.Ссылка)  = Неопределено Тогда
				
				СписокПоказателейСУстаревшимиРС.Добавить(ВыборкаПоказателей.Ссылка);
				
			КонецЕсли;
				
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ПоказательУстаревший Из СписокПоказателейСУстаревшимиРС Цикл
		
		ПоказательОбъект = ПоказательУстаревший.Значение.ПолучитьОбъект();
		ТекстЗапросаПоказателя = ПоказательОбъект.ТекстЗапроса;
		
		Для Каждого УстаревшийРС Из СписокПереименованныхРегистров Цикл		
			
			ТекстЗапросаПоказателя = СтрЗаменить(ТекстЗапросаПоказателя, "РегистрСведений." + УстаревшийРС.Значение,
				"РегистрСведений." + УстаревшийРС.Представление);
			
		КонецЦикла;
		
		ПоказательОбъект.ТекстЗапроса = ТекстЗапросаПоказателя;
		ПоказательОбъект.ДополнительныеСвойства.Вставить("РазрешитьЗаписьПредопределенных", Истина);
		
		Попытка
			ПоказательОбъект.Записать();	
		Исключение
			ПараметрыОшибки = Новый Структура;
			ПараметрыОшибки.Вставить("Событие", "Запись справочника " + ПоказательУстаревший.Значение);
			ПараметрыОшибки.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);
			ПараметрыОшибки.Вставить("ОбъектМетаданных", Метаданные.Справочники.упоПоказателиПроектов);
			ПараметрыОшибки.Вставить("Данные", ПоказательУстаревший.Значение);
			ПараметрыОшибки.Вставить("Комментарий", ОписаниеОшибки());			
			упоРаботаСДиалогамиСервер.ЗаписатьВЖурналРегистрации(ПараметрыОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецФункции

