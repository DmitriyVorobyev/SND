Функция ЗаполнитьСписокПредшественниками(СписокПолейИзначальный, ПоказателиИзФормульныхПоказателей)
	
	СписокПредшественников = Новый СписокЗначений;
	
	Предшественники = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоПоказателиПроектов.Предшественники");
	ВнешПредшественники = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоПоказателиПроектов.ВнешниеПредшественники");	
	
	ЭлементСпискаПред = СписокПолейИзначальный.Найти(Предшественники, "Показатель");
	Если ЭлементСпискаПред <> Неопределено Тогда
		Если ПоказателиИзФормульныхПоказателей.НайтиПоЗначению(Предшественники) = Неопределено Тогда
			ПоказателиИзФормульныхПоказателей.Добавить(ЭлементСпискаПред.Показатель, ЭлементСпискаПред.Представление);
		КонецЕсли;
		СписокПредшественников.Добавить(ЭлементСпискаПред.Показатель, ЭлементСпискаПред.Представление);
	КонецЕсли;
	
	ЭлементСпискаПред = СписокПолейИзначальный.Найти(ВнешПредшественники, "Показатель");
	Если ЭлементСпискаПред <> Неопределено Тогда
		Если ПоказателиИзФормульныхПоказателей.НайтиПоЗначению(ВнешПредшественники) = Неопределено Тогда
			ПоказателиИзФормульныхПоказателей.Добавить(ЭлементСпискаПред.Показатель, ЭлементСпискаПред.Представление);
		КонецЕсли;
		СписокПредшественников.Добавить(ЭлементСпискаПред.Показатель, ЭлементСпискаПред.Представление);
	КонецЕсли;	
	
	Возврат СписокПредшественников;
	
КонецФункции

Процедура ЗаполнитьПредставлениеВЗаданнойТаблице(Таблица)
	
	Таблица.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Для Каждого Строка Из Таблица Цикл
		Строка.Представление = упоПанельПоказателейВызовСервера.ПолучитьИмяПоказателя(Строка.Показатель);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТабДанныеПоПоказателямПараметрами(ДанныеПоПоказателям, ПоказателиСПараметрами)
	
	ДанныеПоПоказателям.Колонки.Добавить("ИдентификаторПараметров", Новый ОписаниеТипов("Число"));
	ДанныеПоПоказателям.Колонки.Добавить("Параметры");
	
	Для Каждого Показатель Из ПоказателиСПараметрами Цикл
		
		Если Показатель.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = ДанныеПоПоказателям.Найти(Показатель.Ключ, "Показатель"); 
		
		Если Строка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПервыйПроход = Истина;			
		Для Каждого ПараметрПоказателя Из Показатель.Значение Цикл
			Если ПервыйПроход Тогда
				ПервыйПроход = Ложь;
				НовСтрока = Строка;
			Иначе
				НовСтрока = ДанныеПоПоказателям.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
			КонецЕсли;
			НовСтрока.ИдентификаторПараметров = ПараметрПоказателя.Ключ;
			НовСтрока.Параметры = ПараметрПоказателя.Значение;
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьФорматированноеЗначение(СтрокаВыборки, ДанныеПоПоказателям, ФорматироватьРезультат, ЗначениеПоУмолчанию)

	Если СтрокаВыборки.Значение = Неопределено Или СтрокаВыборки.Значение = Null Тогда
		Значение = ЗначениеПоУмолчанию;
	Иначе
		Значение = СтрокаВыборки.Значение;
	КонецЕсли;	
		
	Если ФорматироватьРезультат Тогда
		ФорматнаяСтрока = "";		
		ДанныеПоказателя = ДанныеПоПоказателям.Найти(СтрокаВыборки.Показатель, "Показатель"); 
		Если ДанныеПоказателя <> Неопределено Тогда
			ФорматнаяСтрока = ДанныеПоказателя.ФорматнаяСтрока;				
		КонецЕсли;
		Значение = Формат(Значение, ФорматнаяСтрока);	
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьЗначение(Отбор, ТаблицаПоказателейИндикаторов, Выборка, ДанныеПоПоказателям, ФорматироватьРезультат, ЗначениеПоУмолчанию)

	НайденныеСтроки = ТаблицаПоказателейИндикаторов.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() <> 0 Тогда
		Значение = ПолучитьФорматированноеЗначение(НайденныеСтроки[0], ДанныеПоПоказателям, ФорматироватьРезультат,
		ЗначениеПоУмолчанию);
	Иначе
		Значение = ПолучитьФорматированноеЗначение(Выборка, ДанныеПоПоказателям, ФорматироватьРезультат, 
		ЗначениеПоУмолчанию);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьДанныеИзВыборки(ВыборкаПроекты, ДанныеПоПоказателям, ФорматироватьРезультат, ЕстьПоказателиСПараметрами,
		ТаблицаПоказателейИндикаторов, СписокПолейИзначальный)

	Если ЕстьПоказателиСПараметрами Тогда
		Отбор = Новый Структура("Проект, Показатель, ИдентификаторПараметров");
	Иначе
		Отбор = Новый Структура("Проект, Показатель");
	КонецЕсли;
	СоответствиеПроектов = Новый Соответствие;
	Пока ВыборкаПроекты.Следующий() Цикл
		СоответствиеПоказателей = Новый Соответствие;
		Если ЕстьПоказателиСПараметрами Тогда			
			ВыборкаПоказатели = ВыборкаПроекты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);			
			Пока ВыборкаПоказатели.Следующий() Цикл			
				
				Показатель = СписокПолейИзначальный.Найти(ВыборкаПоказатели.Показатель, "Показатель");
				Если Показатель = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СоответствиеИдентификатораИЗначения = Новый Соответствие;
				Выборка = ВыборкаПоказатели.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					Отбор.Проект = Выборка.Проект;
					Отбор.Показатель = Выборка.Показатель;
					Отбор.ИдентификаторПараметров = Выборка.ИдентификаторПараметров;
					Значение = ПолучитьЗначение(Отбор, ТаблицаПоказателейИндикаторов, Выборка, ДанныеПоПоказателям,
						ФорматироватьРезультат, Показатель.ЗначениеПоУмолчанию);
					СоответствиеИдентификатораИЗначения.Вставить(Выборка.ИдентификаторПараметров, Значение);
					
				КонецЦикла;
				
				СоответствиеПоказателей.Вставить(ВыборкаПоказатели.Показатель, СоответствиеИдентификатораИЗначения);
				
			КонецЦикла;			
		Иначе	
			ВыборкаПоказатели = ВыборкаПроекты.Выбрать();
			Пока ВыборкаПоказатели.Следующий() Цикл
				
				Показатель = СписокПолейИзначальный.Найти(ВыборкаПоказатели.Показатель, "Показатель");
				Если Показатель = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Отбор.Проект = ВыборкаПоказатели.Проект;
				Отбор.Показатель = ВыборкаПоказатели.Показатель;
				Значение = ПолучитьЗначение(Отбор, ТаблицаПоказателейИндикаторов, ВыборкаПоказатели, ДанныеПоПоказателям,
					ФорматироватьРезультат, Показатель.ЗначениеПоУмолчанию);
							
				СоответствиеПоказателей.Вставить(ВыборкаПоказатели.Показатель, Значение);
				
			КонецЦикла;
		КонецЕсли;
		
		СоответствиеПроектов.Вставить(ВыборкаПроекты.Проект, СоответствиеПоказателей);
		
	КонецЦикла;
	
	Возврат СоответствиеПроектов;
	
КонецФункции

