	        |		ПО (КоличествоФормульныхПоказателей.Показатель <> 0)
	        |			И (НЕ упоПоказателиПроектов.ЭтоГруппа)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	упоПоказателиПроектовРасчетныеИндикаторы.Ссылка КАК Показатель,
	        |	упоПоказателиПроектовРасчетныеИндикаторы.Индикатор КАК Индикатор,
	        |	упоПоказателиПроектовРасчетныеИндикаторы.Представление КАК Представление
	        |ИЗ
	        |	Справочник.упоПоказателиПроектов.РасчетныеИндикаторы КАК упоПоказателиПроектовРасчетныеИндикаторы
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КоличествоФормульныхПоказателей КАК КоличествоФормульныхПоказателей
	        |		ПО (КоличествоФормульныхПоказателей.Показатель <> 0)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	Проекты.Ссылка КАК Проект,
	        |	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача
	        |ПОМЕСТИТЬ ДанныеПоПроектам
	        |ИЗ
	        |	Справочник.Проекты КАК Проекты
	        |ГДЕ
	        |	Проекты.Ссылка В(&Проекты)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	КОЛИЧЕСТВО(ДанныеПоПроектам.Проект) КАК Количество
	        |ИЗ
	        |	ДанныеПоПроектам КАК ДанныеПоПроектам
	        |ГДЕ
	        |	ДанныеПоПроектам.ЭтоПроектнаяЗадача
	        |
	        |ИМЕЮЩИЕ
	        |	КОЛИЧЕСТВО(ДанныеПоПроектам.Проект) <> 0
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	КОЛИЧЕСТВО(ДанныеПоПроектам.Проект) КАК Количество
	        |ИЗ
	        |	ДанныеПоПроектам КАК ДанныеПоПроектам
	        |ГДЕ
	        |	НЕ ДанныеПоПроектам.ЭтоПроектнаяЗадача
	        |
	        |ИМЕЮЩИЕ
	        |	КОЛИЧЕСТВО(ДанныеПоПроектам.Проект) <> 0";		
	
КонецФункции

Процедура ДополнитьПоказателямиИзФормул(АвтоматическиеПоказателиФормула, ДанныеПоПоказателям,
		ДанныеПоВсемПоказателям, РасчетныеИндикаторыПоказателей, РасчетВДокументе, ПоляФормульныхПоказателей,
		ПоказателиИзФормульныхПоказателей)
		
	Таблицы = Новый Структура;	
	Таблицы.Вставить("ДанныеПоПоказателям", ДанныеПоПоказателям);
	Таблицы.Вставить("ДанныеПоВсемПоказателям", ДанныеПоВсемПоказателям);
	Таблицы.Вставить("РасчетныеИндикаторыПоказателей", РасчетныеИндикаторыПоказателей);
	
	Отбор = Новый Структура("Показатель");	
	Для Каждого Строка Из АвтоматическиеПоказателиФормула Цикл
		
		Отбор.Показатель = Строка.Показатель;
		НайденныеСтроки = РасчетныеИндикаторыПоказателей.НайтиСтроки(Отбор);
		
		ВложенныеПоказатели = Новый Структура;
		
		Для Каждого НСтрока Из НайденныеСтроки Цикл
			
			НайденнаяСтрока = ДанныеПоВсемПоказателям.Найти(НСтрока.Индикатор, "Показатель");
			
			Если НайденнаяСтрока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДополнитьПоказателямиИзФормулРекурсивно(НайденнаяСтрока, Таблицы, РасчетВДокументе, ВложенныеПоказатели,
				НСтрока.Представление, ПоказателиИзФормульныхПоказателей);			
					
		КонецЦикла;	
		
		// Заменим в формуле представления на ИмяПоказателя.
		ФормулаЧерезИмяПоказателя = Строка.строкаФормулы;
		Для Каждого Элемент Из ВложенныеПоказатели Цикл 
			
			Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;		
			
			Если Элемент.Значение.ФормулаЧерезИмяПоказателя = "" Тогда
				ФормулаЧерезИмяПоказателя = СтрЗаменить(ФормулаЧерезИмяПоказателя, Элемент.Значение.Представление, "т." + Элемент.Ключ);
			Иначе
				ФормулаЧерезИмяПоказателя = СтрЗаменить(ФормулаЧерезИмяПоказателя, Элемент.Значение.Представление, Элемент.Значение.ФормулаЧерезИмяПоказателя);
			КонецЕсли;
			
		КонецЦикла; 		
		
		ДанныеПоказателя = Новый Структура("Формула, ВложенныеПоказатели, ФормулаЧерезИмяПоказателя",
			Строка.строкаФормулы, ВложенныеПоказатели, ФормулаЧерезИмяПоказателя);
		ПоляФормульныхПоказателей.Вставить(упоПанельПоказателейВызовСервера.ПолучитьИмяПоказателя(Строка.Показатель), ДанныеПоказателя);			
				
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьПоказателямиИзФормулРекурсивно(ДанныеПоказателя, Таблицы, РасчетВДокументе,
		ПоляФормульныхПоказателей, Представление, ПоказателиИзФормульныхПоказателей)
		
	ДанныеПоПоказателям = Таблицы.ДанныеПоПоказателям;
	ДанныеПоВсемПоказателям = Таблицы.ДанныеПоВсемПоказателям;
	РасчетныеИндикаторыПоказателей = Таблицы.РасчетныеИндикаторыПоказателей;
	
	Отбор = Новый Структура("Показатель");
	
	ВложенныеПоказатели = Новый Структура;
	Если (ДанныеПоказателя.ВидЗаполнения = ОбщегоНазначения.ПредопределенныйЭлемент(
											"Перечисление.упоВидЗаполненияИндикатора.Автоматически")
		ИЛИ ДанныеПоказателя.ВидЗаполнения = ОбщегоНазначения.ПредопределенныйЭлемент(
												"Перечисление.упоВидЗаполненияИндикатора.АвтоматическиВДокументе") 
		И РасчетВДокументе) 
		И ДанныеПоказателя.ТипЗаполнения = 1 Тогда
		
		Отбор.Показатель = ДанныеПоказателя.Показатель;	
		НайденныеСтроки = РасчетныеИндикаторыПоказателей.НайтиСтроки(Отбор);
		
		Для Каждого НСтрока Из НайденныеСтроки Цикл
			
			НайденнаяСтрока = ДанныеПоВсемПоказателям.Найти(НСтрока.Индикатор, "Показатель");
			
			Если НайденнаяСтрока = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДополнитьПоказателямиИзФормулРекурсивно(НайденнаяСтрока, Таблицы, РасчетВДокументе, ВложенныеПоказатели,
				НСтрока.Представление, ПоказателиИзФормульныхПоказателей);
			
		КонецЦикла;
		
	Иначе
		
		ИмяПоказателя = упоПанельПоказателейВызовСервера.ПолучитьИмяПоказателя(ДанныеПоказателя.Показатель);
		ВложенныеПоказатели.Вставить(ИмяПоказателя, Представление);
		
		НайденнаяСтрока = ДанныеПоПоказателям.Найти(ДанныеПоказателя.Показатель, "Показатель");		
		Если НайденнаяСтрока = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ДанныеПоПоказателям.Добавить(), ДанныеПоказателя);			
		КонецЕсли;
		
		ЭлементФП = ПоказателиИзФормульныхПоказателей.НайтиПоЗначению(ДанныеПоказателя.Показатель);
		Если ЭлементФП = Неопределено Тогда
			ПоказателиИзФормульныхПоказателей.Добавить(ДанныеПоказателя.Показатель, ИмяПоказателя);
		КонецЕсли;
	
	КонецЕсли;	
	
	// Заменим в формуле представления на ИмяПоказателя.
	ФормулаЧерезИмяПоказателя = ДанныеПоказателя.строкаФормулы;
	Для Каждого Элемент Из ВложенныеПоказатели Цикл 
		
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;		
		
		Если Элемент.Значение.ФормулаЧерезИмяПоказателя = "" Тогда
			ФормулаЧерезИмяПоказателя = СтрЗаменить(ФормулаЧерезИмяПоказателя, Элемент.Значение.Представление, "т." + Элемент.Ключ);
		Иначе
			ФормулаЧерезИмяПоказателя = СтрЗаменить(ФормулаЧерезИмяПоказателя, Элемент.Значение.Представление, Элемент.Значение.ФормулаЧерезИмяПоказателя);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(ФормулаЧерезИмяПоказателя) Тогда
		ФормулаЧерезИмяПоказателя = "(" + ФормулаЧерезИмяПоказателя + ")";
	КонецЕсли;
	
	ДанныеПоказателяСтруктура = Новый Структура("Формула, ВложенныеПоказатели, Представление, ФормулаЧерезИмяПоказателя",
		ДанныеПоказателя.строкаФормулы, ВложенныеПоказатели, Представление, ФормулаЧерезИмяПоказателя);
	ПоляФормульныхПоказателей.Вставить(упоПанельПоказателейВызовСервера.ПолучитьИмяПоказателя(ДанныеПоказателя.Показатель), ДанныеПоказателяСтруктура);
	
КонецПроцедуры

Функция ПолучитьТекстЗапросаПолученияЗначений(ДанныеПоПоказателям, ДопПараметры, РучныеПоказатели, ЕстьПроекты,
		ЕстьПроектныеЗадачи, РасчетВДокументе, ЕстьПоказателиСПараметрами)
	
	ТекстЗапроса = "ВЫБРАТЬ 
	|	NULL КАК Показатель,
	|	NULL КАК Проект,	
	|	NULL КАК Значение%1
	|ПОМЕСТИТЬ ДанныеПоказателей
	|
	|";
		
	Для Каждого Строка Из ДанныеПоПоказателям Цикл
		
		Если Строка.Показатель = Справочники.упоПоказателиПроектов.Предшественники 
			ИЛИ Строка.Показатель = Справочники.упоПоказателиПроектов.ВнешниеПредшественники Тогда
			
			Продолжить;
			
		ИначеЕсли (Строка.ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.Автоматически
			ИЛИ Строка.ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.АвтоматическиВДокументе И РасчетВДокументе) Тогда
			
			Если Строка.ТипЗаполнения = 0 Тогда
				
				Если Строка.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроекта И ЕстьПроекты Тогда
					
					упоПанельПоказателейВызовСервера.ДобавитьПоказательвТекстЗапроса(ДопПараметры, ТекстЗапроса, Строка,,
						Истина, ЕстьПоказателиСПараметрами);
					
				ИначеЕсли Строка.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроектнойЗадачи И ЕстьПроектныеЗадачи Тогда 
					
					упоПанельПоказателейВызовСервера.ДобавитьПоказательвТекстЗапроса(ДопПараметры, ТекстЗапроса, Строка, Истина,
						Истина, ЕстьПоказателиСПараметрами);
					
				ИначеЕсли Строка.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.Общий Тогда
					
					Если ЕстьПроектныеЗадачи Тогда
						упоПанельПоказателейВызовСервера.ДобавитьПоказательвТекстЗапроса(ДопПараметры, ТекстЗапроса, Строка, Истина,
							Истина, ЕстьПоказателиСПараметрами);
					КонецЕсли;
					
					Если ЕстьПроекты Тогда
						упоПанельПоказателейВызовСервера.ДобавитьПоказательвТекстЗапроса(ДопПараметры, ТекстЗапроса, Строка,,
							Истина, ЕстьПоказателиСПараметрами);
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			
			РучныеПоказатели.Добавить(Строка.Показатель);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если РучныеПоказатели.Количество() <> 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + 
		"ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Индикатор,
		|	Объект,
		|	ЗначениеИндикатора%1
		|ИЗ
		|	РегистрСведений.упоЗначенияИндикаторов.СрезПоследних(, Объект В (&Проекты) И Индикатор В (&РучныеИндикаторы)) КАК ЗначенияИндикаторов
		|";
	КонецЕсли;
	
	Если ЕстьПоказателиСПараметрами Тогда
		ПараметрЗамены = "," + Символы.ПС + "	NULL КАК ИдентификаторПараметров";
	Иначе	
		ПараметрЗамены = "";
	КонецЕсли;
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, ПараметрЗамены);
	
	ТекстЗапроса = ТекстЗапроса + ";" + Символы.ПС +  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.Ссылка КАК Проект,
	|	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача
	|ПОМЕСТИТЬ Проекты
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|ГДЕ
	|	Проекты.Ссылка В(&Проекты)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоПоказателиПроектов.Ссылка КАК Показатель
	|ПОМЕСТИТЬ Показатели
	|ИЗ
	|	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	|ГДЕ
	|	упоПоказателиПроектов.Ссылка В(&Показатели)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Проекты.Проект КАК Проект,
	|	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача,
	|	Показатели.Показатель КАК Показатель
	|ПОМЕСТИТЬ ПроектыИПоказатели
	|ИЗ
	|	Проекты КАК Проекты,
	|	Показатели КАК Показатели
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроектыИПоказатели.Проект КАК Проект,
	|	ПроектыИПоказатели.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача,
	|	ПроектыИПоказатели.Показатель КАК Показатель,
	|	ДанныеПоказателей.Значение КАК Значение%1
	|ИЗ
	|	ПроектыИПоказатели КАК ПроектыИПоказатели
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеПоказателей КАК ДанныеПоказателей
	|		ПО ПроектыИПоказатели.Проект = ДанныеПоказателей.Проект
	|			И ПроектыИПоказатели.Показатель = ДанныеПоказателей.Показатель
	|ИТОГИ
	|	МАКСИМУМ(ЭтоПроектнаяЗадача)
	|ПО
	|	Проект%2";
	
	Если ЕстьПоказателиСПараметрами Тогда
		ПараметрЗамены = "," + Символы.ПС + "	ЕСТЬNULL(ДанныеПоказателей.ИдентификаторПараметров, 0) КАК ИдентификаторПараметров";
		ИтогиПО = "," + Символы.ПС + "	Показатель";
	Иначе	
		ПараметрЗамены = "";
		ИтогиПО = "";
	КонецЕсли;
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, ПараметрЗамены, ИтогиПО);
	
	ДобавитьПроверкуОтмененныхЗадачВТекстЗапроса(ТекстЗапроса);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьПустуюТаблицуПоказателейИндикаторов(ДанныеПоПоказателям, ЕстьПоказателиСПараметрами, ПоказателиИзКоторыхСоздаемТаблицу)

	ТаблицаПоказателейИндикаторов = Новый ТаблицаЗначений;
	ТаблицаПоказателейИндикаторов.Колонки.Добавить("Проект", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	ТаблицаПоказателейИндикаторов.Колонки.Добавить("ЭтоПроектнаяЗадача", Новый ОписаниеТипов("Булево"));
	ТаблицаПоказателейИндикаторов.Колонки.Добавить("ИдентификаторПараметров", Новый ОписаниеТипов("Число"));
	
	Для Каждого Показатель Из ПоказателиИзКоторыхСоздаемТаблицу Цикл
		
		ДанныеПоказателя = ДанныеПоПоказателям.Найти(Показатель.Значение, "Показатель");
		
		Если ДанныеПоказателя = Неопределено Или ЕстьПоказателиСПараметрами И
			ЗначениеЗаполнено(ДанныеПоказателя.ИдентификаторПараметров) И ДанныеПоказателя.ИдентификаторПараметров > 1 Тогда
			Продолжить;
		КонецЕсли;	
			
		Если ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Булево");
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Дата");
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Строка");
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
			КЧ = Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой);
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Число", КЧ);
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда	
			МассивТипов = упоПанельПоказателейКлиентСервер.ПолучитьМассивТиповПоТипуСсылки(ДанныеПоказателя.ТипСсылки);
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов(МассивТипов);			
		КонецЕсли;
		
		ТаблицаПоказателейИндикаторов.Колонки.Добавить(
			ДанныеПоказателя.Представление, ОписаниеТиповПоляПоказателя);
	КонецЦикла;
		
	Возврат ТаблицаПоказателейИндикаторов;
	
КонецФункции

Процедура ЗаполнитьИзВыборкиТаблицуПоказателейИндикаторов(ВыборкаПроекты, ТаблицаПоказателейИндикаторов, СписокПолей,
		ЕстьПоказателиСПараметрами)
		
	Если СписокПолей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Пока ВыборкаПроекты.Следующий() Цикл
			
		НоваяСтрокаПоказателейИндикаторов = ТаблицаПоказателейИндикаторов.Добавить();				
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПоказателейИндикаторов, ВыборкаПроекты);
		
		ВыборкаПоказателей = ВыборкаПроекты.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПоказателей.Следующий() Цикл
			
			ПоказательИзСписка = СписокПолей.НайтиПоЗначению(ВыборкаПоказателей.Показатель);
			
			Если ПоказательИзСписка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЕстьПоказателиСПараметрами Тогда
				
				Выборка = ВыборкаПоказателей.Выбрать();
				КоличествоПоИдентификаторам = Выборка.Количество() > 1;
				Пока Выборка.Следующий() Цикл
					
					// Делаем следующие действия из-за того, что если есть формулные показатели с параметрами, тогда нам нужно итоги
					// запроса делать не по показателям, а по идентификатору параметров, но нам нужны именно эти итоги потому, что
					// по этим итогам создается возвращаемое соответствие.
					Если КоличествоПоИдентификаторам Тогда 
						НайденныеСтроки = ТаблицаПоказателейИндикаторов.НайтиСтроки(
							Новый Структура("Проект, ИдентификаторПараметров", Выборка.Проект, Выборка.ИдентификаторПараметров));
						Если НайденныеСтроки.Количество() <> 0 Тогда
							НоваяСтрокаПоказателейИндикаторов = НайденныеСтроки[0];	
						Иначе
							НоваяСтрокаПоказателейИндикаторов = ТаблицаПоказателейИндикаторов.Добавить();				
							ЗаполнитьЗначенияСвойств(НоваяСтрокаПоказателейИндикаторов, Выборка);	
						КонецЕсли;					
					КонецЕсли;
					
					НоваяСтрокаПоказателейИндикаторов[ПоказательИзСписка.Представление] = Выборка.Значение;
					
				КонецЦикла;
				
			Иначе
								
				НоваяСтрокаПоказателейИндикаторов[ПоказательИзСписка.Представление] = ВыборкаПоказателей.Значение;
				
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;	
	
	ВыборкаПроекты.Сбросить();
		
КонецПроцедуры

Функция ПосчитатьФормульныеПоказатели(ТаблицаПоказателейИндикаторов, ПоляФормульныхПоказателей, СписокПредшественников,
		ФормульныеПоказатели)
		
	// Если в формуле есть агрегатные функции, то их нужно убрать.	
	АгрегатныеФункции = Новый Массив;
	АгрегатныеФункции.Добавить("СУММА(");
	АгрегатныеФункции.Добавить("МИНИМУМ(");
	АгрегатныеФункции.Добавить("МАКСИМУМ(");
	АгрегатныеФункции.Добавить("СРЕДНЕЕ(");
	АгрегатныеФункции.Добавить("КОЛИЧЕСТВО(");
	АгрегатныеФункции.Добавить("КОЛИЧЕСТВО(РАЗЛИЧНЫЕ");
	
	ПоляТекст = "";
	ШаблонПоля = ", %1 КАК %2";	
	Для Каждого Формула Из ПоляФормульныхПоказателей Цикл
		ПоляТекст = ПоляТекст + 
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоля, Формула.Значение.ФормулаЧерезИмяПоказателя, Формула.Ключ) 
		+ Символы.ПС;
		// Т.к. в запросе верхний и нижний регистр не учитывается, то приводим все к верхнему, для замены агрегатных функций.
		ПоляТекст = ВРег(ПоляТекст);
		Для Каждого АгрегатнаяФункция Из АгрегатныеФункции Цикл
			ПоляТекст = СтрЗаменить(ПоляТекст, АгрегатнаяФункция, "(");
		КонецЦикла;		
	КонецЦикла;  
	
	ШаблонПоляФормул = ", т.%1 КАК %1";
	Для Каждого Элемент Из СписокПредшественников Цикл
		ПоляТекст = ПоляТекст + 
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПоляФормул, Элемент.Представление) 
		+ Символы.ПС;
	КонецЦикла;
		
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	т.*
	|ПОМЕСТИТЬ ВТ_Табл
	|ИЗ
	|	&ТЗ КАК т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	т.Проект КАК Проект,
	|	т.ИдентификаторПараметров
	|%1
	|ИЗ
	|	ВТ_Табл КАК т";
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, ПоляТекст);
	Запрос.УстановитьПараметр("ТЗ", ТаблицаПоказателейИндикаторов);
	
	ПолученныеЗначения =  Запрос.Выполнить().Выгрузить();	
	
	ТаблицаПоказателейПроектов = Новый ТаблицаЗначений;
	ТаблицаПоказателейПроектов.Колонки.Добавить("Проект", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	ТаблицаПоказателейПроектов.Колонки.Добавить("Показатель", Новый ОписаниеТипов("СправочникСсылка.упоПоказателиПроектов"));
	ТаблицаПоказателейПроектов.Колонки.Добавить("ИдентификаторПараметров", Новый ОписаниеТипов("Число"));
	ТаблицаПоказателейПроектов.Колонки.Добавить("Значение");
	
	ТаблицаПоказателейПроектов.Индексы.Добавить("Проект");
	ТаблицаПоказателейПроектов.Индексы.Добавить("Показатель");
	ТаблицаПоказателейПроектов.Индексы.Добавить("ИдентификаторПараметров");
	
	Для Каждого Строка Из ПолученныеЗначения Цикл
		
		Для Каждого ФормульныйПоказатель Из ФормульныеПоказатели Цикл
			
			НоваяСтрока = ТаблицаПоказателейПроектов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Показатель = ФормульныйПоказатель.Показатель;
			НоваяСтрока.Значение = Строка[ФормульныйПоказатель.Представление];
			
		КонецЦикла;
		
		Для Каждого Элемент Из СписокПредшественников Цикл
			
			НоваяСтрока = ТаблицаПоказателейПроектов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.Показатель = Элемент.Значение;
			НоваяСтрока.Значение = Строка[Элемент.Представление];
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаПоказателейПроектов;
	
КонецФункции

#КонецОбласти

#Область ОтборОтмененныхЗадачВТекстеЗапроса

Процедура ОбработатьОператорыСхемыЗапроса(ОператорыЗапроса, 
	РегистрыПлановыхДанных, РегистрыПлановыхДанныхТекущаяВерсия)
		
	Для Каждого ОператорЗапроса Из ОператорыЗапроса Цикл
		
		Для Каждого ИсточникЗапроса Из ОператорЗапроса.Источники Цикл
			
			Если ТипЗнч(ИсточникЗапроса.Источник) = Тип("ТаблицаСхемыЗапроса") Тогда
				
				ОбработатьТаблицуСхемыЗапроса(ОператорЗапроса, ИсточникЗапроса, 
					РегистрыПлановыхДанных, РегистрыПлановыхДанныхТекущаяВерсия)					
				
			ИначеЕсли ТипЗнч(ИсточникЗапроса.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
								
				ОбработатьОператорыСхемыЗапроса(ИсточникЗапроса.Источник.Запрос.Операторы, 
					РегистрыПлановыхДанных, РегистрыПлановыхДанныхТекущаяВерсия);							
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
		
КонецПроцедуры	

Процедура ОбработатьТаблицуСхемыЗапроса(ОператорЗапроса, ИсточникЗапроса, 
	РегистрыПлановыхДанных, РегистрыПлановыхДанныхТекущаяВерсия)
	
	ИмяРегистра = ИмяРегистраПоИмениТаблицы(ИсточникЗапроса.Источник.ИмяТаблицы);	
			
	Если РегистрыПлановыхДанных.Получить(ИмяРегистра) <> Неопределено Тогда
		
		ДобавитьИсточникВСхемуЗапроса_Свойства(ОператорЗапроса, ИсточникЗапроса, 
									РегистрыПлановыхДанных.Получить(ИмяРегистра));
		
	ИначеЕсли РегистрыПлановыхДанныхТекущаяВерсия.Получить(ИмяРегистра) <> Неопределено Тогда
		
		ИсточникСвойства = ДобавитьИсточникВСхемуЗапроса_Свойства(ОператорЗапроса, ИсточникЗапроса, 
									РегистрыПлановыхДанныхТекущаяВерсия.Получить(ИмяРегистра), 
									Ложь);
		
		ДобавитьИсточникВСхемуЗапроса_Версии(ОператорЗапроса, ИсточникСвойства);
		
	ИначеЕсли ИмяРегистра = "упоСвойстваПроектныхЗадач" Тогда
		
		Если СтрНайти(ИсточникЗапроса.Источник.Псевдоним, СлужебныйПрефикс()) = 0 Тогда
			ДобавитьОтборОтмененные(ОператорЗапроса, ИсточникЗапроса.Источник.Псевдоним);
		КонецЕсли;	
		
	КонецЕсли;		
	
КонецПроцедуры	

Функция ДобавитьИсточникВСхемуЗапроса_Свойства(ОператорЗапроса, ИсточникЗапроса, 
												ИмяПоляПЗИсточника = "ПроектнаяЗадача",
												ВключатьВерсию = Истина)
	
	ПсведонимТаблицыСоединения 	= ИсточникЗапроса.Источник.Псевдоним;	
	ПсевдонимНовойТаблицы 		= СлужебныйПрефикс() + "СвойстваПЗ_" + ПсведонимТаблицыСоединения;	
	
	НовыйИсточник = ОператорЗапроса.Источники.Добавить("РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних", 
		ПсевдонимНовойТаблицы);
	// Удаляем автоматически добавленное левое соединение, т.к. дальше будем добавлять внутреннее.	
	Если НовыйИсточник.Соединения.Количество() > 0 Тогда
		НовыйИсточник.Соединения.Очистить();
	КонецЕсли;
	
	УсловияСоединения = Новый Массив;
	Если ВключатьВерсию Тогда
		УсловияСоединения.Добавить("%1.Версия = %2.Версия");
	КонецЕсли;
	УсловияСоединения.Добавить("%1.%3 = %2.ПроектнаяЗадача");
	УсловияСоединения.Добавить("НЕ %2.ЗадачаОтменена");
		
	СтрокаСоединения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		СтрСоединить(УсловияСоединения, " И "),
		ПсведонимТаблицыСоединения,
		ПсевдонимНовойТаблицы,
		ИмяПоляПЗИсточника);			
	
	упоТиповыеОтчетыСервер.ДобавитьВнутреннееСоединениеВИсточник(ИсточникЗапроса, 
																ПсевдонимНовойТаблицы, 
																СтрокаСоединения);
		
	Возврат НовыйИсточник;
	
КонецФункции

Функция ДобавитьИсточникВСхемуЗапроса_Версии(ОператорЗапроса, ИсточникЗапроса)
	
	ПсведонимТаблицыСоединения 	= ИсточникЗапроса.Источник.Псевдоним;
	ПсевдонимНовойТаблицы 		= СлужебныйПрефикс() + "Версии_" + ПсведонимТаблицыСоединения;	
	
	НовыйИсточник = ОператорЗапроса.Источники.Добавить("РегистрСведений.упоВерсииПроекта", ПсевдонимНовойТаблицы);	
	// Удаляем автоматически добавленное левое соединение, т.к. дальше будем добавлять внутреннее.	
	Если НовыйИсточник.Соединения.Количество() > 0 Тогда
		НовыйИсточник.Соединения.Очистить();
	КонецЕсли;
	
	СтрокаСоединения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"%1.Версия = %2.Версия И %2.Текущая",
		ПсведонимТаблицыСоединения, 
		ПсевдонимНовойТаблицы);									
	
	упоТиповыеОтчетыСервер.ДобавитьВнутреннееСоединениеВИсточник(ИсточникЗапроса, 
																ПсевдонимНовойТаблицы, 
																СтрокаСоединения);
	
	Возврат НовыйИсточник;
	
КонецФункции

Процедура ДобавитьОтборОтмененные(ОператорЗапроса, ПсевдонимТаблицы)
	
	СтрокаОтбора = СтрЗаменить("НЕ %1.ЗадачаОтменена", "%1", ПсевдонимТаблицы); 
	ОператорЗапроса.Отбор.Добавить(СтрокаОтбора);
	
КонецПроцедуры	

Функция ИмяРегистраПоИмениТаблицы(ПолноеИмяТаблицы)
	
	ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеИмяТаблицы, ".");
	
	Если ЧастиИмени.Количество() > 1 Тогда
		ИмяРегистра = ЧастиИмени[1];
	Иначе 
		ИмяРегистра = "Неопределено";
	КонецЕсли;	
	
	Возврат ИмяРегистра;
	
КонецФункции	

