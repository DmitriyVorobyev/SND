Функция НазначениеПоНаправлениюДеятельности(НаправлениеДеятельности) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаправлениеДеятельности", НаправлениеДеятельности);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Назначения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Назначения КАК Назначения
		|ГДЕ
		|	Назначения.НаправлениеДеятельности = &НаправлениеДеятельности
		|
		|УПОРЯДОЧИТЬ ПО
		|	Назначения.Заказ";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура РассчитатьЭлементыСпискаБюджетаКДобавлению(ДобавляемыеКолонки) Экспорт
	
	Для Каждого ДобавляемаяКолонка Из ДобавляемыеКолонки Цикл
		Если ДобавляемаяКолонка.Имя = "Проекты" Тогда
			ДобавляемаяКолонка.Вставить("ПараметрыВыбора", Новый Структура("Отбор, Значение", "ЭтоГруппа", Ложь));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура сохраняет показатели.
//
// Параметры:
//  Форма	 - Форма элемента справочника.
//
Процедура СохранитьРеквизитыКонтрагентаПартнера(Форма) Экспорт
	
	Если Не ЗначениеЗаполнено(Форма.КонтрагентПартнера) Тогда
		Возврат;
	КонецЕсли;
	
	КонтрагентОбъект = Форма.КонтрагентПартнера.ПолучитьОбъект();
	
	Если Константы.упоИспользоватьНормированиеИПроектныеРешения.Получить() Тогда
		
		КонтрагентОбъект.упоПоказатели.Очистить();
		
		Для Каждого СтрТз Из Форма.упоПоказатели Цикл
			НовСтр = КонтрагентОбъект.упоПоказатели.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не Константы["ИспользоватьПартнеровИКонтрагентов"].Получить() Тогда
		ЗаполнитьЗначенияСвойств(КонтрагентОбъект, Форма,
			"упоОсновнойДоговорКонтрагента, упоНаправлениеДеятельности, упоСхемаОплаты");
	КонецЕсли;
	
	КонтрагентОбъект.Записать();
	
КонецПроцедуры

Функция СоздатьСвязатьСтатьюДР_изERPвPM(СтатьяИнтеграция) Экспорт
	
	ДопИнформацияОСтатьеУПО = Неопределено;
	обСтатьяУПО = Неопределено;
	НужноЗаписатьСвязь = Ложь;
	
	Если ТипЗнч(СтатьяИнтеграция) = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") Тогда
		СправочникМенеджерУПО = Справочники.упоСтатьиДоходов;
	Иначе
		СправочникМенеджерУПО = Справочники.упоСтатьиЗатрат;
	КонецЕсли;
	
	ЭлементРодитель = СправочникМенеджерУПО.ПустаяСсылка();
	
	РеквизитыСтатьиИнтеграция = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяИнтеграция,
			"Наименование, ПометкаУдаления, ЭтоГруппа, Родитель");
	
	Если ЗначениеЗаполнено(РеквизитыСтатьиИнтеграция.Родитель) Тогда
		ЭлементРодитель = упоИнтеграция.СоздатьСвязатьСтатьюДР(РеквизитыСтатьиИнтеграция.Родитель);
	КонецЕсли;
	
	СтатьяУПО = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(СтатьяИнтеграция, ДопИнформацияОСтатьеУПО);
	
	Если Не ЗначениеЗаполнено(СтатьяУПО) Тогда
		
		обСтатьяУПО = упоИнтеграция.НовыйОбъектСИдентификаторомИсходного(СправочникМенеджерУПО,
				СтатьяИнтеграция,
				РеквизитыСтатьиИнтеграция.ЭтоГруппа);
		
		НужноЗаписатьСвязь = Истина;
		
	Иначе
		
		ДлинаНаименованияУПО = СтатьяУПО.Метаданные().ДлинаНаименования;
		
		Если ДопИнформацияОСтатьеУПО.Наименование <> Лев(РеквизитыСтатьиИнтеграция.Наименование, ДлинаНаименованияУПО)
			ИЛИ ДопИнформацияОСтатьеУПО.ПометкаУдаления <> РеквизитыСтатьиИнтеграция.ПометкаУдаления
			ИЛИ ДопИнформацияОСтатьеУПО.Родитель <> ЭлементРодитель Тогда
			
			обСтатьяУПО = СтатьяУПО.ПолучитьОбъект();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если обСтатьяУПО <> Неопределено Тогда
		
		обСтатьяУПО.ДополнительныеСвойства.Вставить("НеСинхронизироватьСтатьиДР", Истина);
		обСтатьяУПО.Наименование = РеквизитыСтатьиИнтеграция.Наименование;
		обСтатьяУПО.ПометкаУдаления = РеквизитыСтатьиИнтеграция.ПометкаУдаления;
		обСтатьяУПО.Родитель = ЭлементРодитель;
		обСтатьяУПО.Записать();
		СтатьяУПО = обСтатьяУПО.Ссылка;
		
	КонецЕсли;
	
	Если НужноЗаписатьСвязь Тогда
		
		Запись = РегистрыСведений.упоСоответствиеСтатейДР.СоздатьМенеджерЗаписи();
		Запись.СтатьяИнтеграция = СтатьяИнтеграция;
		Запись.СтатьяУПО = СтатьяУПО;
		Запись.Записать();
		
	КонецЕсли;
	
	Возврат СтатьяУПО;
	
КонецФункции

Функция СоздатьСвязатьСтатьюДР_изPMвERP(СтатьяPM) Экспорт
	
	СсылкаНаСтатью = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(СтатьяPM);
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаСтатью) Тогда
		
		Если ТипЗнч(СтатьяPM) = Тип("СправочникСсылка.упоСтатьиДоходов") Тогда
			ПВХМенеджер = ПланыВидовХарактеристик.СтатьиДоходов;
		Иначе
			ПВХМенеджер = ПланыВидовХарактеристик.СтатьиРасходов;
		КонецЕсли;
		
		НоваяСсылка = Неопределено;
		НоваяСтатья = упоИнтеграция.НовыйОбъектСИдентификаторомИсходного(ПВХМенеджер,
				СтатьяPM,
				СтатьяPM.ЭтоГруппа,
				НоваяСсылка);
		
		НоваяСтатья.Наименование = СтатьяPM.Наименование;
		НоваяСтатья.ПометкаУдаления = СтатьяPM.ПометкаУдаления;
		НоваяСтатья.Код = СтатьяPM.Код;
		
		Если ЗначениеЗаполнено(СтатьяPM.Родитель) Тогда
			РодительERP = СоздатьСвязатьСтатьюДР_изPMвERP(СтатьяPM.Родитель);
			НоваяСтатья.Родитель = РодительERP;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.упоСоответствиеСтатейДР.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.СтатьяИнтеграция = НоваяСсылка;
		МенеджерЗаписи.СтатьяУПО = СтатьяPM;
		
		НоваяСтатья.ДополнительныеСвойства.Вставить("НеСинхронизироватьСтатьиДР", Истина);
		
		НачатьТранзакцию();
		
		МенеджерЗаписи.Записать();
		НоваяСтатья.Записать();
		
		ЗафиксироватьТранзакцию();
		
		СсылкаНаСтатью = НоваяСтатья.Ссылка;
		
	КонецЕсли;
	
	Возврат СсылкаНаСтатью;
	
КонецФункции

// Заполняет проектными задачами табличные части документов.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура - Данные формы документов "Реализация товаров и услуг",
//			"Приобретение товаров и услуг" или "Акт выполненных работ".
//
Процедура ТоварыУслугиЗаполнитьПроектныеЗадачи(Объект) Экспорт
	
	ИменаМетаданных = ИменаМетаданныхДокументаДляЗаполненияПроектныхЗадач(Объект);
	
	ИмяТЧ = ИменаМетаданных.ИмяТабличнойЧасти;
	ИмяДокументаЗаказа = ИменаМетаданных.ИмяРеквизита;
	
	МассивЗаказов = Новый Массив;
	Для Каждого СтрокаТабличнойЧасти Из Объект[ИмяТЧ] Цикл
		ДокументЗаказ = СтрокаТабличнойЧасти[ИмяДокументаЗаказа];
		Если Не ЗначениеЗаполнено(ДокументЗаказ) Тогда
			Продолжить;
		КонецЕсли;
		МассивЗаказов.Добавить(ДокументЗаказ);
	КонецЦикла;
	
	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПЗиЗаказов = ПолучитьСоответствиеПЗиЗаказов(ИмяДокументаЗаказа, МассивЗаказов);
	
	ЗаполнитьПроектныеЗадачиПоЗаказамВТабличнойЧасти(Объект, СоответствиеПЗиЗаказов, ИмяДокументаЗаказа, ИмяТЧ);
	
КонецПроцедуры

Функция ИменаМетаданныхДокументаДляЗаполненияПроектныхЗадач(Объект)
	
	СоответствиеТипаДокументаИменамМетаданных = Новый Соответствие;
	СоответствиеТипаДокументаИменамМетаданных.Вставить(Тип("ДокументСсылка.РеализацияТоваровУслуг"),
		Новый Структура("ИмяТабличнойЧасти, ИмяРеквизита", "Товары", "ЗаказКлиента"));
	СоответствиеТипаДокументаИменамМетаданных.Вставить(Тип("ДокументСсылка.ПриобретениеТоваровУслуг"),
		Новый Структура("ИмяТабличнойЧасти, ИмяРеквизита", "Товары", "ЗаказПоставщику"));
	СоответствиеТипаДокументаИменамМетаданных.Вставить(Тип("ДокументСсылка.АктВыполненныхРабот"),
		Новый Структура("ИмяТабличнойЧасти, ИмяРеквизита", "Услуги", "ЗаказКлиента"));
	
	ТипДокумента = ТипЗнч(Объект.Ссылка);
	
	ИменаМетаданных = СоответствиеТипаДокументаИменамМетаданных.Получить(ТипДокумента);
	
	Если ИменаМетаданных = Неопределено Тогда
		ТекстИсключения = СтрШаблон(НСтр("ru = 'Заполнение проектными задачами табличной части документа ""%1"" не поддерживается.'"),
			ТипДокумента);
		ВызватьИсключение(ТекстИсключения);
	КонецЕсли;
	
	Возврат ИменаМетаданных;
		
КонецФункции

Функция ПолучитьПодстрокуОбъектаРасчетовДляЗапроса()
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM_2_5() Тогда
		Подстрока = "РасшифровкаПлатежа.ОбъектРасчетов.Договор";
	Иначе
		Подстрока = "РасшифровкаПлатежа.Заказ.Договор";
	КонецЕсли;
	
	Возврат Подстрока;
	
КонецФункции

// Поиск проектной задачи в данных заполнения.
Функция ПроектнаяЗадачаПоДаннымЗаполнения(ДанныеЗаполнения) Экспорт 
	
	ПроектнаяЗадачаЗеркало = Неопределено;
	
	Если ТипЗНЧ(ДанныеЗаполнения) = Тип("СправочникСсылка.Проекты") Тогда
		
		ПроектнаяЗадачаЗеркало = ДанныеЗаполнения;
		
	ИначеЕсли ТипЗНЧ(ДанныеЗаполнения) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
		
		НаправлениеДеятельности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "НаправлениеДеятельности");
		ПроектнаяЗадачаЗеркало = упоСвязьПроектаСНаправлениемДеятельности.ПолучитьЭлементПоНаправлениюДеятельности(НаправлениеДеятельности);
		
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
		
		МетаданныеОснования = ДанныеЗаполнения.Метаданные();
		
		Если ТипЗНЧ(ДанныеЗаполнения) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ПроектнаяЗадачаЗеркало = ДанныеЗаполнения;
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("упоПроектнаяЗадача", МетаданныеОснования) Тогда
			ПроектнаяЗадачаЗеркало = ДанныеЗаполнения.упоПроектнаяЗадача;
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("ДокументОснование", МетаданныеОснования)
			И ЗначениеЗаполнено(ДанныеЗаполнения.ДокументОснование)
			И ОбщегоНазначения.ЕстьРеквизитОбъекта("упоПроектнаяЗадача", ДанныеЗаполнения.ДокументОснование.Метаданные()) Тогда
			ПроектнаяЗадачаЗеркало = ДанныеЗаполнения.ДокументОснование.упоПроектнаяЗадача;
		Иначе
			Для Каждого ТабличнаяЧасть Из МетаданныеОснования.ТабличныеЧасти Цикл
				Если ОбщегоНазначения.ЕстьРеквизитОбъекта("упоПроектнаяЗадача", ТабличнаяЧасть) И ДанныеЗаполнения[ТабличнаяЧасть.Имя].Количество() > 0 Тогда
					
					ТаблицаПЗ = ДанныеЗаполнения[ТабличнаяЧасть.Имя].Выгрузить( , "упоПроектнаяЗадача");
					ТаблицаПЗ.Свернуть("упоПроектнаяЗадача");
					ТаблицаПЗ.Сортировать("упоПроектнаяЗадача Убыв");
					
					ПроектнаяЗадачаЗеркало = ТаблицаПЗ[0].упоПроектнаяЗадача;
					Если ЗначениеЗаполнено(ПроектнаяЗадачаЗеркало) Тогда
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПроектнаяЗадачаЗеркало;
	
КонецФункции

Процедура ЗаполнитьДанныеКонтрагентаПартнераPM(Приемник, Партнер) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Контрагенты.Ссылка КАК КонтрагентПартнера,
	               |	Контрагенты.упоОсновнойДоговорКонтрагента КАК упоОсновнойДоговорКонтрагента,
	               |	Контрагенты.упоНаправлениеДеятельности КАК упоНаправлениеДеятельности,
	               |	Контрагенты.упоСхемаОплаты КАК упоСхемаОплаты,
	               |	Контрагенты.упоПроектнаяЗадачаПоУмолчаниюДДС КАК упоПроектнаяЗадачаПоУмолчаниюДДС
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.Партнер = &Партнер";
	
	Запрос.УстановитьПараметр("Партнер",Партнер);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[0].Выбрать();

	Если Выборка.Следующий() Тогда
	
		ЗаполнитьЗначенияСвойств(Приемник, Выборка);
	
	КонецЕсли;

КонецПроцедуры

