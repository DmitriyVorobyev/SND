		|   ВТ_АВР.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   ВТ_АВР.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
		|   ВТ_АВР.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
		|   ЕСТЬNULL(ВЫБОР
		|       КОГДА ВТ_АВР.Валюта = &ВалютаУправленческогоУчета
		|           ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная
		|       ИНАЧЕ ВЫБОР
		|               КОГДА ВТ_АВР.ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
		|                   ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВзаиморасчетов
		|               ИНАЧЕ 0
		|           КОНЕЦ
		|   КОНЕЦ, 0) КАК Сумма,
		|   ЕСТЬNULL(ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная, ВЫБОР
		|           КОГДА &ВключатьНДСВФактДоходовРасходов
		|               ТОГДА ВТ_АВР.СуммаСНДС
		|           ИНАЧЕ ВТ_АВР.СуммаСНДС - ВТ_АВР.СуммаНДС
		|       КОНЕЦ) КАК СуммаВалютная,
		|   ВТ_АВР.Количество КАК Количество,
		|   ВТ_АВР.Номенклатура КАК Субпродукт,
		|   ВТ_АВР.Период КАК День,
		|   ВТ_АВР.Проект КАК Проект,
		|   1 КАК Коэффициент
		|ИЗ
		|   ВТ_АВР КАК ВТ_АВР
		|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеВалютныхСуммДокумента КАК ВТ_ДанныеВалютныхСуммДокумента
		|       ПО ВТ_АВР.ИдентификаторСтроки = ВТ_ДанныеВалютныхСуммДокумента.ИдентификаторСтроки
		|ГДЕ
		|   ВТ_АВР.ПроектнаяЗадача <> ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Текст запроса принятые объемы реализация товаров и услуг.
//
// Возвращаемое значение:
//  Строка - текст запроса.
Функция ТекстЗапросаПринятыеОбъемы_РеализацияТоваровУслуг()
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|   СуммыДокументовВВалютахУчетаСрезПоследних.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|   ВЫБОР
		|       КОГДА &ВключатьНДСВФактДоходовРасходов
		|           ТОГДА СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДС + СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДС
		|       ИНАЧЕ СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДС
		|   КОНЕЦ КАК СуммаВалютная,
		|   ВЫБОР
		|       КОГДА &ВключатьНДСВФактДоходовРасходов
		|           ТОГДА СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСУпр + СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДСУпр
		|       ИНАЧЕ СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСУпр
		|   КОНЕЦ КАК СуммаВзаиморасчетов
		|ПОМЕСТИТЬ ВТ_ДанныеВалютныхСуммДокумента
		|ИЗ
		|   РегистрСведений.СуммыДокументовВВалютахУчета.СрезПоследних(, (ВЫРАЗИТЬ(Регистратор КАК Документ.РеализацияТоваровУслуг)) = &Источник) КАК СуммыДокументовВВалютахУчетаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   РТУ.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|   РТУ.Ссылка.Контрагент КАК Контрагент,
		|   РТУ.Ссылка.Договор КАК Договор,
		|   РТУ.Ссылка.Валюта КАК Валюта,
		|   РТУ.Ссылка.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
		|   РТУ.упоПодразделение КАК Подразделение,
		|   РТУ.упоРоль КАК Роль,
		|   РТУ.Номенклатура КАК Номенклатура,
		|   упоСоответствиеСтатейДР.СтатьяУПО КАК Статья,
		|   ВЫБОР
		|       КОГДА РТУ.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|           ТОГДА РТУ.Номенклатура.ЕдиницаИзмерения
		|       ИНАЧЕ РТУ.Упаковка.ЕдиницаИзмерения
		|   КОНЕЦ КАК ЕдиницаИзмерения,
		|   РТУ.Ссылка.Дата КАК Период,
		|   &Расход КАК ВидДвижения,
		|   &Источник КАК Регистратор,
		|   ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Доход) КАК ВидОбъема,
		|   РТУ.упоРоль.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   РТУ.Ссылка.Контрагент КАК КонтрагентПодрядчик,
		|   РТУ.Ссылка.Договор КАК Заказ_ДоговорПодрядчика,
		|   РТУ.СуммаВзаиморасчетов КАК Сумма,
		|   РТУ.Сумма КАК СуммаВалютная,
		|   РТУ.СуммаНДС КАК СуммаНДС,
		|   РТУ.СуммаСНДС КАК СуммаСНДС,
		|   РТУ.Количество КАК Количество,
		|   РТУ.упоПроектнаяЗадача.упоКорневойПроект КАК Проект,
		|   РТУ.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ ВТ_РТУ
		|ИЗ
		|   Документ.РеализацияТоваровУслуг.Товары КАК РТУ
		|       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСоответствиеСтатейДР КАК упоСоответствиеСтатейДР
		|       ПО РТУ.упоСтатьяДоходов = упоСоответствиеСтатейДР.СтатьяИнтеграция
		|ГДЕ
		|   РТУ.Ссылка = &Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   ВТ_РТУ.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|   ВТ_РТУ.Контрагент КАК Контрагент,
		|   ВТ_РТУ.Договор КАК Договор,
		|   ВТ_РТУ.Валюта КАК Валюта,
		|   ВТ_РТУ.Подразделение КАК Подразделение,
		|   ВТ_РТУ.Роль КАК Роль,
		|   ВТ_РТУ.Номенклатура КАК Номенклатура,
		|   ВТ_РТУ.Статья КАК Статья,
		|   ВТ_РТУ.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|   ВТ_РТУ.Период КАК Период,
		|   ВТ_РТУ.ВидДвижения КАК ВидДвижения,
		|   ВТ_РТУ.Регистратор КАК Регистратор,
		|   ВТ_РТУ.ВидОбъема КАК ВидОбъема,
		|   ВТ_РТУ.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   ВТ_РТУ.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
		|   ВТ_РТУ.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
		|   ЕСТЬNULL(ВЫБОР
		|       КОГДА ВТ_РТУ.Валюта = &ВалютаУправленческогоУчета
		|           ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная
		|       ИНАЧЕ ВЫБОР
		|               КОГДА ВТ_РТУ.ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
		|                   ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВзаиморасчетов
		|               ИНАЧЕ 0
		|           КОНЕЦ
		|   КОНЕЦ, 0) КАК Сумма,
		|   ЕСТЬNULL(ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная, ВЫБОР
		|           КОГДА &ВключатьНДСВФактДоходовРасходов
		|               ТОГДА ВТ_РТУ.СуммаСНДС
		|           ИНАЧЕ ВТ_РТУ.СуммаСНДС - ВТ_РТУ.СуммаНДС
		|       КОНЕЦ) КАК СуммаВалютная,
		|   ВТ_РТУ.Количество КАК Количество,
		|   ВТ_РТУ.Проект КАК Проект,
		|   ВТ_РТУ.Период КАК День,
		|   ВТ_РТУ.Номенклатура КАК Субпродукт,
		|   1 КАК Коэффициент
		|ИЗ
		|   ВТ_РТУ КАК ВТ_РТУ
		|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеВалютныхСуммДокумента КАК ВТ_ДанныеВалютныхСуммДокумента
		|       ПО ВТ_РТУ.ИдентификаторСтроки = ВТ_ДанныеВалютныхСуммДокумента.ИдентификаторСтроки
		|ГДЕ
		|   ВТ_РТУ.ПроектнаяЗадача <> ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ПараметрыЗапросовДР

// Установить параметры запроса фактические движения БДР поступление товаров услуг.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
Процедура УстановитьПараметрыЗапросаФактическиеДвиженияБДР_ПриобретениеТоваровУслуг(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("упоОтражатьФактРасходаПриПриобретенииТоваров",
		ОтражатьФактРасходаПриПриобретенииТоваров());
	Запрос.УстановитьПараметр("упоСтатьяРасходовПриПриобретенииТоваров",
		СтатьяРасходовПриПриобретенииТоваров());
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("ВключатьНДСВФактДоходовРасходов", ВключатьНДСВФактРасходовПервичныхДокументов());
	
КонецПроцедуры

// Установить параметры запроса фактические движения БДР реализация товаров услуг.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
Процедура УстановитьПараметрыЗапросаФактическиеДвиженияБДР_РеализацияТоваровУслуг(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("ВключатьНДСВФактДоходовРасходов", ВключатьНДСВФактДоходовПервичныхДокументов());
	
КонецПроцедуры

// Установить параметры запроса фактические движения БДР акт выполненных работ.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
Процедура УстановитьПараметрыЗапросаФактическиеДвиженияБДР_АктВыполненныхРабот(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("ВключатьНДСВФактДоходовРасходов", ВключатьНДСВФактДоходовПервичныхДокументов());
	
КонецПроцедуры

// Установить параметры запроса для формирования движений упоВыполненныеПринятыеОбъемы акт выполненных работ.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
Процедура УстановитьПараметрыЗапросаПринятыеОбъемы_АктВыполненныхРабот(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("Источник", ДокументСсылка);
	Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("ВключатьНДСВФактДоходовРасходов", ВключатьНДСВФактДоходовПервичныхДокументов());
	
КонецПроцедуры

// Установить параметры запроса для формирования движений упоВыполненныеПринятыеОбъемы реализация товаров услуг.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
Процедура УстановитьПараметрыЗапросаПринятыеОбъемы_РеализацияТоваровУслуг(Запрос, ДокументСсылка)
	Запрос.УстановитьПараметр("Источник", ДокументСсылка);
	Запрос.УстановитьПараметр("Расход", ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("ВключатьНДСВФактДоходовРасходов", ВключатьНДСВФактДоходовПервичныхДокументов());
КонецПроцедуры

#КонецОбласти

#Область ЗапросыДДС

// Возвращает текст запроса для движений по регистру Фактические движения денежных средств
//  документа Поступление безналичных денежных средств.
//
// Параметры:
//  ЭтоEPM_2_5	 - Булево	 - признак интеграции с ERP 2.5.
// 
// Возвращаемое значение:
//  Строка - Текст запроса.
//
Функция ТекстЗапросаФактическиеДвиженияДСПоступлениеБезналичных(ЭтоEPM_2_5 = Ложь)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|   ВЫБОР
		|       КОГДА НЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ПроведеноБанком
		|               ИЛИ НАЧАЛОПЕРИОДА(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком
		|           ТОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Дата
		|       ИНАЧЕ КОНЕЦПЕРИОДА(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком, ДЕНЬ)
		|   КОНЕЦ КАК Период,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.упоНаправлениеДвижения КАК НаправлениеДвижения,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Контрагент КАК Контрагент,
		|   ВЫБОР
		|       КОГДА НЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ПроведеноБанком
		|               ИЛИ НАЧАЛОПЕРИОДА(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком
		|           ТОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Дата
		|       ИНАЧЕ КОНЕЦПЕРИОДА(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком, ДЕНЬ)
		|   КОНЕЦ КАК ДатаДвижения,
		|   ВЫБОР
		|       КОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.ВалютаВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|           ТОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Валюта
		|       ИНАЧЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.ВалютаВзаиморасчетов
		|   КОНЕЦ КАК Валюта,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.Валюта КАК ВалютаДокумента,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Сумма КАК Сумма,
		|   ВЫБОР
		|       КОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.СуммаВзаиморасчетов = 0
		|           ТОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Сумма
		|       ИНАЧЕ ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.СуммаВзаиморасчетов
		|   КОНЕЦ КАК СуммаВалютная,
		|   &СтрокаДоговор КАК Договор,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.ДатаВходящегоДокумента КАК ДатаПлатежногоДокумента,
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка.НомерВходящегоДокумента КАК НомерПлатежногоДокумента,
		|   """" КАК КомментарийДвижения
		|ПОМЕСТИТЬ ВТ_ДанныеРасшифровки
		|ИЗ
		|   Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа
		|ГДЕ
		|   ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Ссылка = &Ссылка
		|   И ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   ВТ_ДанныеРасшифровки.Период КАК Период,
		|   ВТ_ДанныеРасшифровки.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|   ВТ_ДанныеРасшифровки.СтатьяДДС КАК СтатьяДДС,
		|   ВТ_ДанныеРасшифровки.НаправлениеДвижения КАК НаправлениеДвижения,
		|   ВТ_ДанныеРасшифровки.Контрагент КАК Контрагент,
		|   ВТ_ДанныеРасшифровки.ДатаДвижения КАК ДатаДвижения,
		|   ВТ_ДанныеРасшифровки.Валюта КАК Валюта,
		|   ВЫБОР
		|       КОГДА ВТ_ДанныеРасшифровки.Валюта = &ВалютаУправленческогоУчета
		|           ТОГДА ВТ_ДанныеРасшифровки.СуммаВалютная
		|       ИНАЧЕ ВЫБОР
		|               КОГДА ВТ_ДанныеРасшифровки.ВалютаДокумента = &ВалютаУправленческогоУчета
		|                   ТОГДА ВТ_ДанныеРасшифровки.Сумма
		|               ИНАЧЕ 0
		|           КОНЕЦ
		|   КОНЕЦ КАК Сумма,
		|   ВТ_ДанныеРасшифровки.СуммаВалютная КАК СуммаВалютная,
		|   ВТ_ДанныеРасшифровки.Договор КАК Договор,
		|   ВТ_ДанныеРасшифровки.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|   ВТ_ДанныеРасшифровки.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|   ВТ_ДанныеРасшифровки.КомментарийДвижения КАК КомментарийДвижения
		|ИЗ
		|   ВТ_ДанныеРасшифровки КАК ВТ_ДанныеРасшифровки";
	
	Если ЭтоEPM_2_5 Тогда
		СтрокаДоговор = "ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.ОбъектРасчетов.Договор";
	Иначе
		СтрокаДоговор = "ВЫБОР
			|		КОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Заказ ССЫЛКА Справочник.ДоговорыКонтрагентов
			|			ТОГДА ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Заказ
			|		ИНАЧЕ ЕСТЬNULL(ПоступлениеБезналичныхДенежныхСредствРасшифровкаПлатежа.Заказ.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
			|	КОНЕЦ"
		КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаДоговор", СтрокаДоговор);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Возвращает текст запроса для движений по регистру Фактические движения денежных средств
//  документа Приходный кассовый ордер.
//
// Параметры:
//  ЭтоEPM_2_5	 - Булево	 - признак интеграции с ERP 2.5.
// 
// Возвращаемое значение:
//  Строка - Текст запроса.
//
Функция ТекстЗапросаФактическиеДвиженияДСПриходныйКО(ЭтоEPM_2_5 = Ложь)
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата КАК Период,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.упоНаправлениеДвижения КАК НаправлениеДвижения,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Контрагент КАК Контрагент,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата КАК ДатаДвижения,
		|   ВЫБОР
		|       КОГДА ПриходныйКассовыйОрдерРасшифровкаПлатежа.ВалютаВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|           ТОГДА ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Валюта
		|       ИНАЧЕ ПриходныйКассовыйОрдерРасшифровкаПлатежа.ВалютаВзаиморасчетов
		|   КОНЕЦ КАК Валюта,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Валюта КАК ВалютаДокумента,
		|   0 КАК Сумма,
		|   ВЫБОР
		|       КОГДА ПриходныйКассовыйОрдерРасшифровкаПлатежа.СуммаВзаиморасчетов = 0
		|           ТОГДА ПриходныйКассовыйОрдерРасшифровкаПлатежа.Сумма
		|       ИНАЧЕ ПриходныйКассовыйОрдерРасшифровкаПлатежа.СуммаВзаиморасчетов
		|   КОНЕЦ КАК СуммаВалютная,
		|   &СтрокаДоговор КАК Договор,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Дата КАК ДатаПлатежногоДокумента,
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Номер КАК НомерПлатежногоДокумента,
		|   """" КАК КомментарийДвижения
		|ПОМЕСТИТЬ ВТ_ДанныеРасшифровки
		|ИЗ
		|   Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
		|ГДЕ
		|   ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка = &Ссылка
		|   И ПриходныйКассовыйОрдерРасшифровкаПлатежа.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   ВТ_ДанныеРасшифровки.Период КАК Период,
		|   ВТ_ДанныеРасшифровки.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|   ВТ_ДанныеРасшифровки.СтатьяДДС КАК СтатьяДДС,
		|   ВТ_ДанныеРасшифровки.НаправлениеДвижения КАК НаправлениеДвижения,
		|   ВТ_ДанныеРасшифровки.Контрагент КАК Контрагент,
		|   ВТ_ДанныеРасшифровки.ДатаДвижения КАК ДатаДвижения,
		|   ВТ_ДанныеРасшифровки.Валюта КАК Валюта,
		|   ВЫБОР
		|       КОГДА ВТ_ДанныеРасшифровки.Валюта = &ВалютаУправленческогоУчета
		|           ТОГДА ВТ_ДанныеРасшифровки.СуммаВалютная
		|       ИНАЧЕ ВЫБОР
		|               КОГДА ВТ_ДанныеРасшифровки.ВалютаДокумента = &ВалютаУправленческогоУчета
		|                   ТОГДА ВТ_ДанныеРасшифровки.Сумма
		|               ИНАЧЕ 0
		|           КОНЕЦ
		|   КОНЕЦ КАК Сумма,
		|   ВТ_ДанныеРасшифровки.СуммаВалютная КАК СуммаВалютная,
		|   ВТ_ДанныеРасшифровки.Договор КАК Договор,
		|   ВТ_ДанныеРасшифровки.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
		|   ВТ_ДанныеРасшифровки.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
		|   ВТ_ДанныеРасшифровки.КомментарийДвижения КАК КомментарийДвижения
		|ИЗ
		|   ВТ_ДанныеРасшифровки КАК ВТ_ДанныеРасшифровки";
	
	Если ЭтоEPM_2_5 Тогда
		СтрокаДоговор = "ПриходныйКассовыйОрдерРасшифровкаПлатежа.ОбъектРасчетов.Договор";
	Иначе
		СтрокаДоговор = "ВЫБОР
			|		КОГДА ПриходныйКассовыйОрдерРасшифровкаПлатежа.Заказ ССЫЛКА Справочник.ДоговорыКонтрагентов
			|			ТОГДА ПриходныйКассовыйОрдерРасшифровкаПлатежа.Заказ
			|		ИНАЧЕ ЕСТЬNULL(ПриходныйКассовыйОрдерРасшифровкаПлатежа.Заказ.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
			|	КОНЕЦ"
		КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаДоговор", СтрокаДоговор);
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Текст запроса фактические движения ДССписание безналичных.
//
// Параметры:
//  ЭтоEPM_2_5				 - Булево - Параметр интеграции с ERP 2.5.
//  ДанныеВШапкеДокумента	 - Булево - Параметр источника данных.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаФактическиеДвиженияДССписаниеБезналичных(ЭтоEPM_2_5 = Ложь, ДанныеВШапкеДокумента = Ложь)
	
	Если ДанныеВШапкеДокумента Тогда
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|   ВЫБОР
			|       КОГДА НЕ СписаниеБезналичныхДенежныхСредств.ПроведеноБанком
			|               ИЛИ НАЧАЛОПЕРИОДА(СписаниеБезналичныхДенежныхСредств.Дата, ДЕНЬ) = СписаниеБезналичныхДенежныхСредств.ДатаПроведенияБанком
			|           ТОГДА СписаниеБезналичныхДенежныхСредств.Дата
			|       ИНАЧЕ КОНЕЦПЕРИОДА(СписаниеБезналичныхДенежныхСредств.ДатаПроведенияБанком, ДЕНЬ)
			|   КОНЕЦ КАК Период,
			|   СписаниеБезналичныхДенежныхСредств.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|   СписаниеБезналичныхДенежныхСредств.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|   СписаниеБезналичныхДенежныхСредств.СтатьяДвиженияДенежныхСредств.упоНаправлениеДвижения КАК НаправлениеДвижения,
			|   СписаниеБезналичныхДенежныхСредств.Контрагент КАК Контрагент,
			|   ВЫБОР
			|       КОГДА НЕ СписаниеБезналичныхДенежныхСредств.ПроведеноБанком
			|               ИЛИ НАЧАЛОПЕРИОДА(СписаниеБезналичныхДенежныхСредств.Дата, ДЕНЬ) = СписаниеБезналичныхДенежныхСредств.ДатаПроведенияБанком
			|           ТОГДА СписаниеБезналичныхДенежныхСредств.Дата
			|       ИНАЧЕ КОНЕЦПЕРИОДА(СписаниеБезналичныхДенежныхСредств.ДатаПроведенияБанком, ДЕНЬ)
			|   КОНЕЦ КАК ДатаДвижения,
			|   ВЫБОР
			|       КОГДА СписаниеБезналичныхДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
			|           ТОГДА СписаниеБезналичныхДенежныхСредств.БанковскийСчет.ВалютаДенежныхСредств
			|       КОГДА СписаниеБезналичныхДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
			|               ИЛИ СписаниеБезналичныхДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеречислениеВБюджет)
			|               ИЛИ СписаниеБезналичныхДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту)
			|               ИЛИ СписаниеБезналичныхДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета)
			|           ТОГДА СписаниеБезналичныхДенежныхСредств.Валюта
			|       ИНАЧЕ СписаниеБезналичныхДенежныхСредств.Валюта
			|   КОНЕЦ КАК Валюта,
			|   СписаниеБезналичныхДенежныхСредств.Валюта КАК ВалютаДокумента,
			|   СписаниеБезналичныхДенежныхСредств.Договор КАК Договор,
			|   0 КАК Сумма,
			|   ВЫБОР
			|       КОГДА СписаниеБезналичныхДенежныхСредств.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
			|           ТОГДА СписаниеБезналичныхДенежныхСредств.СуммаДокумента
			|       КОГДА СписаниеБезналичныхДенежныхСредств.СуммаКонвертации = 0
			|           ТОГДА СписаниеБезналичныхДенежныхСредств.СуммаДокумента
			|       ИНАЧЕ СписаниеБезналичныхДенежныхСредств.СуммаКонвертации
			|   КОНЕЦ КАК СуммаВалютная,
			|   СписаниеБезналичныхДенежныхСредств.ДатаВходящегоДокумента КАК ДатаПлатежногоДокумента,
			|   СписаниеБезналичныхДенежныхСредств.НомерВходящегоДокумента КАК НомерПлатежногоДокумента,
			|   ВЫРАЗИТЬ(СписаниеБезналичныхДенежныхСредств.Комментарий КАК СТРОКА(1000)) КАК КомментарийДвижения
			|ПОМЕСТИТЬ ВТ_ДанныеДокумента
			|ИЗ
			|   Документ.СписаниеБезналичныхДенежныхСредств КАК СписаниеБезналичныхДенежныхСредств
			|ГДЕ
			|   СписаниеБезналичныхДенежныхСредств.Ссылка = &Ссылка
			|   И СписаниеБезналичныхДенежныхСредств.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|   ВТ_ДанныеДокумента.Период КАК Период,
			|   ВТ_ДанныеДокумента.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|   ВТ_ДанныеДокумента.СтатьяДДС КАК СтатьяДДС,
			|   ВТ_ДанныеДокумента.НаправлениеДвижения КАК НаправлениеДвижения,
			|   ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
			|   ВТ_ДанныеДокумента.ДатаДвижения КАК ДатаДвижения,
			|   ВТ_ДанныеДокумента.Валюта КАК Валюта,
			|   ВТ_ДанныеДокумента.Договор КАК Договор,
			|   ВЫБОР
			|       КОГДА ВТ_ДанныеДокумента.Валюта = &ВалютаУправленческогоУчета
			|           ТОГДА ВТ_ДанныеДокумента.СуммаВалютная
			|       ИНАЧЕ ВЫБОР
			|               КОГДА ВТ_ДанныеДокумента.ВалютаДокумента = &ВалютаУправленческогоУчета
			|                   ТОГДА ВТ_ДанныеДокумента.Сумма
			|               ИНАЧЕ 0
			|           КОНЕЦ
			|   КОНЕЦ КАК Сумма,
			|   ВТ_ДанныеДокумента.СуммаВалютная КАК СуммаВалютная,
			|   ВТ_ДанныеДокумента.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
			|   ВТ_ДанныеДокумента.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
			|   ВТ_ДанныеДокумента.КомментарийДвижения КАК КомментарийДвижения
			|ИЗ
			|   ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
		
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ
			|   ВЫБОР
			|       КОГДА НЕ РасшифровкаПлатежа.Ссылка.ПроведеноБанком
			|               ИЛИ НАЧАЛОПЕРИОДА(РасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком
			|           ТОГДА РасшифровкаПлатежа.Ссылка.Дата
			|       ИНАЧЕ КОНЕЦПЕРИОДА(РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком, ДЕНЬ)
			|   КОНЕЦ КАК Период,
			|   РасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|   РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|   РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.упоНаправлениеДвижения КАК НаправлениеДвижения,
			|   РасшифровкаПлатежа.Ссылка.Контрагент КАК Контрагент,
			|   ВЫБОР
			|       КОГДА НЕ РасшифровкаПлатежа.Ссылка.ПроведеноБанком
			|               ИЛИ НАЧАЛОПЕРИОДА(РасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком
			|           ТОГДА РасшифровкаПлатежа.Ссылка.Дата
			|       ИНАЧЕ КОНЕЦПЕРИОДА(РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком, ДЕНЬ)
			|   КОНЕЦ КАК ДатаДвижения,
			|   ВЫБОР
			|       КОГДА РасшифровкаПлатежа.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
			|           ТОГДА РасшифровкаПлатежа.Ссылка.БанковскийСчет.ВалютаДенежныхСредств
			|       КОГДА РасшифровкаПлатежа.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПрочаяВыдачаДенежныхСредств)
			|               ИЛИ РасшифровкаПлатежа.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПеречислениеВБюджет)
			|               ИЛИ РасшифровкаПлатежа.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту)
			|               ИЛИ РасшифровкаПлатежа.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета)
			|           ТОГДА РасшифровкаПлатежа.Ссылка.Валюта
			|       ИНАЧЕ РасшифровкаПлатежа.ВалютаВзаиморасчетов
			|   КОНЕЦ КАК Валюта,
			|   РасшифровкаПлатежа.Ссылка.Валюта КАК ВалютаДокумента,
			|   &СтрокаДоговор КАК Договор,
			|   0 КАК Сумма,
			|   ВЫБОР
			|       КОГДА РасшифровкаПлатежа.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВыдачаДенежныхСредствПодотчетнику)
			|           ТОГДА РасшифровкаПлатежа.Сумма
			|       КОГДА РасшифровкаПлатежа.СуммаВзаиморасчетов = 0
			|           ТОГДА РасшифровкаПлатежа.Сумма
			|       ИНАЧЕ РасшифровкаПлатежа.СуммаВзаиморасчетов
			|   КОНЕЦ КАК СуммаВалютная,
			|   РасшифровкаПлатежа.Ссылка.ДатаВходящегоДокумента КАК ДатаПлатежногоДокумента,
			|   РасшифровкаПлатежа.Ссылка.НомерВходящегоДокумента КАК НомерПлатежногоДокумента,
			|   ВЫРАЗИТЬ(РасшифровкаПлатежа.Комментарий КАК СТРОКА(1000)) КАК КомментарийДвижения
			|ПОМЕСТИТЬ ВТ_ДанныеРасшифровки
			|ИЗ
			|   Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|   РасшифровкаПлатежа.Ссылка = &Ссылка
			|   И РасшифровкаПлатежа.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|   ВТ_ДанныеРасшифровки.Период КАК Период,
			|   ВТ_ДанныеРасшифровки.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|   ВТ_ДанныеРасшифровки.СтатьяДДС КАК СтатьяДДС,
			|   ВТ_ДанныеРасшифровки.НаправлениеДвижения КАК НаправлениеДвижения,
			|   ВТ_ДанныеРасшифровки.Контрагент КАК Контрагент,
			|   ВТ_ДанныеРасшифровки.ДатаДвижения КАК ДатаДвижения,
			|   ВТ_ДанныеРасшифровки.Валюта КАК Валюта,
			|   ВТ_ДанныеРасшифровки.ВалютаДокумента КАК ВалютаДокумента,
			|   ВТ_ДанныеРасшифровки.Договор КАК Договор,
			|   ВЫБОР
			|       КОГДА ВТ_ДанныеРасшифровки.Валюта = &ВалютаУправленческогоУчета
			|           ТОГДА ВТ_ДанныеРасшифровки.СуммаВалютная
			|       ИНАЧЕ ВЫБОР
			|               КОГДА ВТ_ДанныеРасшифровки.ВалютаДокумента = &ВалютаУправленческогоУчета
			|                   ТОГДА ВТ_ДанныеРасшифровки.Сумма
			|               ИНАЧЕ 0
			|           КОНЕЦ
			|   КОНЕЦ КАК Сумма,
			|   ВТ_ДанныеРасшифровки.СуммаВалютная КАК СуммаВалютная,
			|   ВТ_ДанныеРасшифровки.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
			|   ВТ_ДанныеРасшифровки.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
			|   ВТ_ДанныеРасшифровки.КомментарийДвижения КАК КомментарийДвижения
			|ИЗ
			|   ВТ_ДанныеРасшифровки КАК ВТ_ДанныеРасшифровки";
		
		Если ЭтоEPM_2_5 Тогда
			СтрокаДоговор = "РасшифровкаПлатежа.ОбъектРасчетов.Договор";
		Иначе
			СтрокаДоговор = "ВЫБОР
				|		КОГДА РасшифровкаПлатежа.Заказ ССЫЛКА Справочник.ДоговорыКонтрагентов
				|			ТОГДА РасшифровкаПлатежа.Заказ
				|		ИНАЧЕ ЕСТЬNULL(РасшифровкаПлатежа.Заказ.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
				|	КОНЕЦ";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаДоговор", СтрокаДоговор);
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Текст запроса фактические движения ДСРасходный КО.
//
// Параметры:
//  ЭтоEPM_2_5				 - Булево - признак интеграции с ERP 2.5.
//  ДанныеВШапкеДокумента	 - Булево - параметр источника данных.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаФактическиеДвиженияДСРасходныйКО(ЭтоEPM_2_5 = Ложь, ДанныеВШапкеДокумента = Ложь)
	Если ДанныеВШапкеДокумента Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ
			|   РасходныйКассовыйОрдер.Дата КАК Период,
			|   РасходныйКассовыйОрдер.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|   РасходныйКассовыйОрдер.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|   РасходныйКассовыйОрдер.СтатьяДвиженияДенежныхСредств.упоНаправлениеДвижения КАК НаправлениеДвижения,
			|   РасходныйКассовыйОрдер.Контрагент КАК Контрагент,
			|   РасходныйКассовыйОрдер.Дата КАК ДатаДвижения,
			|   ВЫБОР
			|       КОГДА РасходныйКассовыйОрдер.ВалютаКонвертации = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|           ТОГДА РасходныйКассовыйОрдер.Валюта
			|       ИНАЧЕ РасходныйКассовыйОрдер.ВалютаКонвертации
			|   КОНЕЦ КАК Валюта,
			|   РасходныйКассовыйОрдер.Валюта КАК ВалютаДокумента,
			|   РасходныйКассовыйОрдер.Договор КАК Договор,
			|   0 КАК Сумма,
			|   ВЫБОР
			|       КОГДА РасходныйКассовыйОрдер.СуммаКонвертации = 0
			|           ТОГДА РасходныйКассовыйОрдер.СуммаДокумента
			|       ИНАЧЕ РасходныйКассовыйОрдер.СуммаКонвертации
			|   КОНЕЦ КАК СуммаВалютная,
			|   РасходныйКассовыйОрдер.Дата КАК ДатаПлатежногоДокумента,
			|   РасходныйКассовыйОрдер.Номер КАК НомерПлатежногоДокумента,
			|   ВЫРАЗИТЬ(РасходныйКассовыйОрдер.Комментарий КАК СТРОКА(1000)) КАК КомментарийДвижения
			|ПОМЕСТИТЬ ВТ_ДанныеДокумента
			|ИЗ
			|   Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
			|ГДЕ
			|   РасходныйКассовыйОрдер.Ссылка = &Ссылка
			|   И РасходныйКассовыйОрдер.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|   ВТ_ДанныеДокумента.Период КАК Период,
			|   ВТ_ДанныеДокумента.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|   ВТ_ДанныеДокумента.СтатьяДДС КАК СтатьяДДС,
			|   ВТ_ДанныеДокумента.НаправлениеДвижения КАК НаправлениеДвижения,
			|   ВТ_ДанныеДокумента.Контрагент КАК Контрагент,
			|   ВТ_ДанныеДокумента.ДатаДвижения КАК ДатаДвижения,
			|   ВТ_ДанныеДокумента.Валюта КАК Валюта,
			|   ВТ_ДанныеДокумента.ВалютаДокумента КАК ВалютаДокумента,
			|   ВТ_ДанныеДокумента.Договор КАК Договор,
			|   ВЫБОР
			|       КОГДА ВТ_ДанныеДокумента.Валюта = &ВалютаУправленческогоУчета
			|           ТОГДА ВТ_ДанныеДокумента.СуммаВалютная
			|       ИНАЧЕ ВЫБОР
			|               КОГДА ВТ_ДанныеДокумента.ВалютаДокумента = &ВалютаУправленческогоУчета
			|                   ТОГДА ВТ_ДанныеДокумента.Сумма
			|               ИНАЧЕ 0
			|           КОНЕЦ
			|   КОНЕЦ КАК Сумма,
			|   ВТ_ДанныеДокумента.СуммаВалютная КАК СуммаВалютная,
			|   ВТ_ДанныеДокумента.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
			|   ВТ_ДанныеДокумента.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
			|   ВТ_ДанныеДокумента.КомментарийДвижения КАК КомментарийДвижения
			|ИЗ
			|   ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента";
		
	Иначе
		ТекстЗапроса =
			"ВЫБРАТЬ
			|   РасшифровкаПлатежа.Ссылка.Дата КАК Период,
			|   РасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|   РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
			|   РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств.упоНаправлениеДвижения КАК НаправлениеДвижения,
			|   РасшифровкаПлатежа.Ссылка.Контрагент КАК Контрагент,
			|   РасшифровкаПлатежа.Ссылка.Дата КАК ДатаДвижения,
			|   ВЫБОР
			|       КОГДА РасшифровкаПлатежа.ВалютаВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
			|           ТОГДА РасшифровкаПлатежа.Ссылка.Валюта
			|       ИНАЧЕ РасшифровкаПлатежа.ВалютаВзаиморасчетов
			|   КОНЕЦ КАК Валюта,
			|   РасшифровкаПлатежа.Ссылка.Валюта КАК ВалютаДокумента,
			|   &СтрокаДоговор КАК Договор,
			|   0 КАК Сумма,
			|   ВЫБОР
			|       КОГДА РасшифровкаПлатежа.СуммаВзаиморасчетов = 0
			|           ТОГДА РасшифровкаПлатежа.Сумма
			|       ИНАЧЕ РасшифровкаПлатежа.СуммаВзаиморасчетов
			|   КОНЕЦ КАК СуммаВалютная,
			|   РасшифровкаПлатежа.Ссылка.Дата КАК ДатаПлатежногоДокумента,
			|   РасшифровкаПлатежа.Ссылка.Номер КАК НомерПлатежногоДокумента,
			|   ВЫРАЗИТЬ(РасшифровкаПлатежа.Комментарий КАК СТРОКА(1000)) КАК КомментарийДвижения
			|ПОМЕСТИТЬ ВТ_ДанныеРасшифровки
			|ИЗ
			|   Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|   РасшифровкаПлатежа.Ссылка = &Ссылка
			|   И РасшифровкаПлатежа.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|   ВТ_ДанныеРасшифровки.Период КАК Период,
			|   ВТ_ДанныеРасшифровки.ПроектнаяЗадача КАК ПроектнаяЗадача,
			|   ВТ_ДанныеРасшифровки.СтатьяДДС КАК СтатьяДДС,
			|   ВТ_ДанныеРасшифровки.НаправлениеДвижения КАК НаправлениеДвижения,
			|   ВТ_ДанныеРасшифровки.Контрагент КАК Контрагент,
			|   ВТ_ДанныеРасшифровки.ДатаДвижения КАК ДатаДвижения,
			|   ВТ_ДанныеРасшифровки.Валюта КАК Валюта,
			|   ВТ_ДанныеРасшифровки.ВалютаДокумента КАК ВалютаДокумента,
			|   ВТ_ДанныеРасшифровки.Договор КАК Договор,
			|   ВЫБОР
			|       КОГДА ВТ_ДанныеРасшифровки.Валюта = &ВалютаУправленческогоУчета
			|           ТОГДА ВТ_ДанныеРасшифровки.СуммаВалютная
			|       ИНАЧЕ ВЫБОР
			|               КОГДА ВТ_ДанныеРасшифровки.ВалютаДокумента = &ВалютаУправленческогоУчета
			|                   ТОГДА ВТ_ДанныеРасшифровки.Сумма
			|               ИНАЧЕ 0
			|           КОНЕЦ
			|   КОНЕЦ КАК Сумма,
			|   ВТ_ДанныеРасшифровки.СуммаВалютная КАК СуммаВалютная,
			|   ВТ_ДанныеРасшифровки.ДатаПлатежногоДокумента КАК ДатаПлатежногоДокумента,
			|   ВТ_ДанныеРасшифровки.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
			|   ВТ_ДанныеРасшифровки.КомментарийДвижения КАК КомментарийДвижения
			|ИЗ
			|   ВТ_ДанныеРасшифровки КАК ВТ_ДанныеРасшифровки";
		
		Если ЭтоEPM_2_5 Тогда
			СтрокаДоговор = "РасшифровкаПлатежа.ОбъектРасчетов.Договор";
		Иначе
			СтрокаДоговор = "ВЫБОР
				|		КОГДА РасшифровкаПлатежа.Заказ ССЫЛКА Справочник.ДоговорыКонтрагентов
				|			ТОГДА РасшифровкаПлатежа.Заказ
				|		ИНАЧЕ ЕСТЬNULL(РасшифровкаПлатежа.Заказ.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
				|	КОНЕЦ";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаДоговор", СтрокаДоговор);
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ПараметрыЗапросовДДС

// Установить параметры запроса фактические движения ДС поступление безналичных.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция УстановитьПараметрыЗапросаФактическиеДвиженияДС_ПоступлениеБезналичных(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("упоОтражатьФактДДСПервичнымиДокументами",
		ИспользуетсяОтражениеФактаДДСПервичнымиДокументами());
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
КонецФункции

// Установить параметры запроса фактические движения ДС приходный КО.
//
// Параметры:
//  Запрос			 - Запрос
//  ДокументСсылка	 - ДокументСсылка
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция УстановитьПараметрыЗапросаФактическиеДвиженияДС_ПриходныйКО(Запрос, ДокументСсылка)
	
	Запрос.УстановитьПараметр("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	Запрос.УстановитьПараметр("упоОтражатьФактДДСПервичнымиДокументами",
		ИспользуетсяОтражениеФактаДДСПервичнымиДокументами());
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
КонецФункции

