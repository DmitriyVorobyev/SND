#КонецОбласти

Функция ИспользоватьДанныеШапкиФинансовогоДокумента(Объект)
	
	Результат = Ложь;
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не упоФункцииОбщегоНазначенияСервер.упоПолучитьФункциональнуюОпцию("ИспользоватьКадровыйУчет")
		Или ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
		ПроверяемыеХозОперации = Новый Соответствие;
		
		ПроверяемыеХозОперации.Вставить(
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыплатаЗарплаты"),
			Истина);
		ПроверяемыеХозОперации.Вставить(
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыНаЛицевыеСчета"),
			Истина);
		ПроверяемыеХозОперации.Вставить(
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыПоЗарплатномуПроекту"),
			Истина);
		ПроверяемыеХозОперации.Вставить(
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыРаботнику"),
			Истина);
		ПроверяемыеХозОперации.Вставить(
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыРаздатчиком"),
			Истина);
		ПроверяемыеХозОперации.Вставить(
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВыплатаЗарплатыЧерезКассу"),
			Истина);
		
		Результат = ПроверяемыеХозОперации.Получить(Объект.ХозяйственнаяОперация) <> Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьЗапросПроектныеЗадачиПоЗаказам(ИмяДокументаЗаказа)
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Заказ.Ссылка КАК ДокументЗаказ,
		|	Заказ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		|ИЗ
		|	Документ.&ИмяДокументаЗаказа КАК Заказ
		|ГДЕ
		|	Заказ.Ссылка В (&МассивЗаказов)";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяДокументаЗаказа", ИмяДокументаЗаказа);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьСоответствиеПЗиЗаказов(ИмяДокументаЗаказа, МассивЗаказов)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос();
	Запрос.Текст = СформироватьЗапросПроектныеЗадачиПоЗаказам(ИмяДокументаЗаказа);
	Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ВыборкаПЗ = РезультатЗапроса.Выбрать();
	Пока ВыборкаПЗ.Следующий() Цикл
		Результат.Вставить(ВыборкаПЗ.ДокументЗаказ, ВыборкаПЗ.упоПроектнаяЗадача);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПроектныеЗадачиПоЗаказамВТабличнойЧасти(Объект, СоответствиеПЗиЗаказов, ИмяДокументаЗаказа, ИмяТабличнойЧасти)
	
	Для Каждого СтрокаТЧ Из Объект[ИмяТабличнойЧасти] Цикл
		СтрокаТЧ.упоПроектнаяЗадача = СоответствиеПЗиЗаказов.Получить(СтрокаТЧ[ИмяДокументаЗаказа]);
	КонецЦикла;
	
КонецПроцедуры

#Область ОбработкаЗаполнения

Функция РеквизитыОснования(ДанныеЗаполнения)
	
	РеквизитыОснования = Новый Структура("Организация, Подразделение, НаправлениеДеятельности");
	
	Если Не Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
		Возврат РеквизитыОснования;
	КонецЕсли;
	
	МетаданныеОснования = ДанныеЗаполнения.Метаданные();
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", МетаданныеОснования) Тогда
		РеквизитыОснования.Организация = ДанныеЗаполнения.Организация;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Подразделение", МетаданныеОснования) Тогда
		РеквизитыОснования.Подразделение = ДанныеЗаполнения.Подразделение;
	КонецЕсли;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("НаправлениеДеятельности", МетаданныеОснования) Тогда
		РеквизитыОснования.НаправлениеДеятельности = ДанныеЗаполнения.НаправлениеДеятельности;
	КонецЕсли;
	
	Возврат РеквизитыОснования;
	
КонецФункции

Процедура ЗаполнитьРеквизитыТабличныхЧастей(Объект, Проект, ПроектнаяЗадачаЗеркало)
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	ПроектЗначенияПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект);
	упоСтатьяДоходов = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(ПроектЗначенияПоУмолчанию.СтатьяДоходовПоУмолчанию);
	
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		НужноЗаполнитьЗадачу = ОбщегоНазначения.ЕстьРеквизитОбъекта("упоПроектнаяЗадача", ТабличнаяЧасть);
		НужноЗаполнитьСтатьюДоходов = ОбщегоНазначения.ЕстьРеквизитОбъекта("упоСтатьяДоходов", ТабличнаяЧасть);
		НужненОбход = НужноЗаполнитьЗадачу ИЛИ НужноЗаполнитьСтатьюДоходов;
		Если Не НужненОбход Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаТЧ Из Объект[ТабличнаяЧасть.Имя] Цикл
			Если НужноЗаполнитьЗадачу Тогда
				СтрокаТЧ.упоПроектнаяЗадача = ПроектнаяЗадачаЗеркало;
			КонецЕсли;
			Если НужноЗаполнитьСтатьюДоходов Тогда
				СтрокаТЧ.упоСтатьяДоходов = упоСтатьяДоходов;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьРеквизитыШапки(Объект, Проект, ПроектнаяЗадачаЗеркало, РеквизитыОснования)
	
	ЗаполнениеУспешно = Истина;
	
	ПроектнаяЗадачаСсылкаНаДокумент =
		упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(ПроектнаяЗадачаЗеркало);
	
	Если НЕ ЗначениеЗаполнено(ПроектнаяЗадачаСсылкаНаДокумент) Тогда
		ЗаполнениеУспешно = Ложь;
		Возврат ЗаполнениеУспешно;
	КонецЕсли;
	
	//
	
	МетаданныеОбъекта = Объект.Ссылка.Метаданные();
	
	РеквизитыПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Проект, "Организация, Подразделение");
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("упоПроектнаяЗадача", МетаданныеОбъекта) Тогда
		Объект.упоПроектнаяЗадача = ПроектнаяЗадачаЗеркало;
	КонецЕсли;
	
	РеквизитыЗаполнения = Новый Массив;
	РеквизитыЗаполнения.Добавить("Организация");
	РеквизитыЗаполнения.Добавить("Подразделение");
	РеквизитыЗаполнения.Добавить("НаправлениеДеятельности");
	
	Для Каждого РеквизитЗаполнения Из РеквизитыЗаполнения Цикл
		
		Если Не ЕстьНезаполненныйРеквизит(МетаданныеОбъекта, Объект, РеквизитЗаполнения) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнятьИзДанныхЗаполнения = ЗаполнятьИзДанныхЗаполнения(МетаданныеОбъекта.Реквизиты[РеквизитЗаполнения],
				РеквизитыОснования[РеквизитЗаполнения]);
		Если ЗаполнятьИзДанныхЗаполнения Тогда
			Объект[РеквизитЗаполнения] = РеквизитыОснования[РеквизитЗаполнения];
		Иначе
			Если РеквизитЗаполнения = "Организация" Тогда
				Объект[РеквизитЗаполнения] = РеквизитыПроекта[РеквизитЗаполнения];
			ИначеЕсли РеквизитЗаполнения = "Подразделение" Тогда
				Объект[РеквизитЗаполнения] =
					упоИнтеграцияВызовСервера.НайтиСвязанныйЭлементСтруктурыИлиПодразделения(РеквизитыПроекта[РеквизитЗаполнения]);
			ИначеЕсли РеквизитЗаполнения = "НаправлениеДеятельности" Тогда
				Объект[РеквизитЗаполнения] =
					упоСвязьПроектаСНаправлениемДеятельности.ПолучитьНаправлениеДеятельностиПоПроектнойЗадаче(
						ПроектнаяЗадачаСсылкаНаДокумент);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЗаполнениеУспешно;
	
КонецФункции

Функция ЗаполнятьИзДанныхЗаполнения(РеквизитМетаданных, ЗначениеЗаполнения)
	
	Возврат РеквизитМетаданных.ЗаполнятьИзДанныхЗаполнения
	И ЗначениеЗаполнено(ЗначениеЗаполнения);
	
КонецФункции

Функция ЕстьНезаполненныйРеквизит(МетаданныеОбъекта, Объект, ИмяРеквизита)
	
	Возврат ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизита, МетаданныеОбъекта)
	И Не ЗначениеЗаполнено(Объект[ИмяРеквизита]);
	
КонецФункции

// Разбивает строку расшифровки платежа заполняемого объекта по остаткам сумм проектных задач
// РН упоДенежныеСредстваКВыплате.
//
// Параметры:
//  ЗаявкаНаРасходованиеДС - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - Заявка-основание заполнения.
//  Объект - ДокументОбъект - заполняемый объект.
//
// Возвращаемое значение:
//   Булево  - признак успешного заполнения.
//
Функция ЗаполнитьРасшифровкуПоРегистру_упоДенежныеСредстваКВыплате(Объект, ЗаявкаНаРасходованиеДС)
	
	РасшифровкаЗаполнена = Ложь;
	
	// Расшифровку по регистру делаем только для типов регистраторов.
	ТипыРегистраторовСРасшифровкой =
		Метаданные.РегистрыНакопления.упоДенежныеСредстваКВыплате.СтандартныеРеквизиты.Регистратор.Тип;
	Если Не ТипыРегистраторовСРасшифровкой.СодержитТип(ТипЗнч(Объект.Ссылка)) Тогда
		Возврат РасшифровкаЗаполнена; // Возврат.
	КонецЕсли;
	
	// Иногда в строках таблицы расшифровки платежа может быть не заполнена валюта (указана в шапке).
	Для Каждого СтрокаРасшифровки Из Объект.РасшифровкаПлатежа Цикл
		Если Не ЗначениеЗаполнено(СтрокаРасшифровки.ВалютаВзаиморасчетов) Тогда
			СтрокаРасшифровки.ВалютаВзаиморасчетов = Объект.Валюта;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заявка", ЗаявкаНаРасходованиеДС);
	Запрос.УстановитьПараметр("ТаблицаРасшифровкаПлатежа", Объект.РасшифровкаПлатежа);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    Проекты.Ссылка КАК упоПроектнаяЗадача,
		|    упоДенежныеСредстваКВыплатеОстатки.СуммаОстаток КАК Сумма,
		|    упоДенежныеСредстваКВыплатеОстатки.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|    упоДенежныеСредстваКВыплатеОстатки.Договор КАК Договор,
		|    ЕСТЬNULL(ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.ОбъектРасчетов, ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка)) КАК ОбъектРасчетов
		|ПОМЕСТИТЬ ВТ_РасшифровкаПоЗадачам
		|ИЗ
		|    РегистрНакопления.упоДенежныеСредстваКВыплате.Остатки(, ЗаявкаНаРасходованиеДенежныхСредств = &Заявка) КАК упоДенежныеСредстваКВыплатеОстатки
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		|        ПО упоДенежныеСредстваКВыплатеОстатки.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
		|        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа
		|        ПО упоДенежныеСредстваКВыплатеОстатки.ЗаявкаНаРасходованиеДенежныхСредств = ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.Ссылка
		|            И упоДенежныеСредстваКВыплатеОстатки.СтатьяДвиженияДенежныхСредств = ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств
		|            И (Проекты.Ссылка = ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.упоПроектнаяЗадача)
		|            И упоДенежныеСредстваКВыплатеОстатки.Договор = ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.ОбъектРасчетов.Договор
		|            И упоДенежныеСредстваКВыплатеОстатки.СуммаОстаток = ЗаявкаНаРасходованиеДенежныхСредствРасшифровкаПлатежа.Сумма
		|ГДЕ
		|	НЕ Проекты.СсылкаНаПроектнуюЗадачу = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)
		|	И НЕ Проекты.ПометкаУдаления
		|	И НЕ Проекты.ЗадачаОтменена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВЫРАЗИТЬ(ТаблицаРасшифровкаПлатежа.ОбъектРасчетов КАК Справочник.ОбъектыРасчетов) КАК ОбъектРасчетов,
		|    ТаблицаРасшифровкаПлатежа.Сумма КАК Сумма,
		|    ТаблицаРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
		|ПОМЕСТИТЬ ВТ_РасшифровкаПлатежаПромежуточная
		|ИЗ
		|    &ТаблицаРасшифровкаПлатежа КАК ТаблицаРасшифровкаПлатежа
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВТ_РасшифровкаПлатежаПромежуточная.ОбъектРасчетов КАК ОбъектРасчетов,
		|    ВТ_РасшифровкаПлатежаПромежуточная.Сумма КАК Сумма,
		|    ВТ_РасшифровкаПлатежаПромежуточная.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
		|    ЕСТЬNULL(ВТ_РасшифровкаПлатежаПромежуточная.ОбъектРасчетов.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор
		|ПОМЕСТИТЬ ВТ_РасшифровкаПлатежа
		|ИЗ
		|    ВТ_РасшифровкаПлатежаПромежуточная КАК ВТ_РасшифровкаПлатежаПромежуточная
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВТ_РасшифровкаПоЗадачам.упоПроектнаяЗадача КАК упоПроектнаяЗадача,
		|    ВТ_РасшифровкаПлатежа.ОбъектРасчетов КАК ОбъектРасчетов,
		|    ВТ_РасшифровкаПлатежа.Сумма КАК Сумма,
		|    ВТ_РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств
		|ИЗ
		|    ВТ_РасшифровкаПлатежа КАК ВТ_РасшифровкаПлатежа
		|        ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РасшифровкаПоЗадачам КАК ВТ_РасшифровкаПоЗадачам
		|        ПО ВТ_РасшифровкаПлатежа.Сумма = ВТ_РасшифровкаПоЗадачам.Сумма
		|            И ВТ_РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств = ВТ_РасшифровкаПоЗадачам.СтатьяДвиженияДенежныхСредств
		|            И ВТ_РасшифровкаПлатежа.Договор = ВТ_РасшифровкаПоЗадачам.Договор
		|            И ВТ_РасшифровкаПлатежа.ОбъектРасчетов = ВТ_РасшифровкаПоЗадачам.ОбъектРасчетов";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат РасшифровкаЗаполнена; // Возврат.
	КонецЕсли;
	
	РасшифровкаПоЗадачам = Результат.Выгрузить();
	
	ДанныеВШапке = ИспользоватьДанныеШапкиФинансовогоДокумента(Объект);
	Если ДанныеВШапке Тогда
		ЗаполнитьЗначенияСвойств(Объект, РасшифровкаПоЗадачам[0], "упоПроектнаяЗадача");
		РасшифровкаЗаполнена = Истина;
		Возврат РасшифровкаЗаполнена;
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровки Из РасшифровкаПоЗадачам Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Сумма", СтрокаРасшифровки.Сумма);
		ПараметрыОтбора.Вставить("СтатьяДвиженияДенежныхСредств", СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств);
		ПараметрыОтбора.Вставить("ОбъектРасчетов", СтрокаРасшифровки.ОбъектРасчетов);
		СтрокиЗаполнения = Объект.РасшифровкаПлатежа.НайтиСтроки(ПараметрыОтбора);
		
		Если СтрокиЗаполнения.Количество() = 1 Тогда
			СтрокаЗаполнения = СтрокиЗаполнения[0];
			ЗаполнитьЗначенияСвойств(СтрокаЗаполнения, СтрокаРасшифровки, "упоПроектнаяЗадача");
			
			Если Не ЗначениеЗаполнено(СтрокаЗаполнения.упоПроектнаяЗадача)
				И ТипЗнч(ЗаявкаНаРасходованиеДС) = Тип("ДокументСсылка.ЗаявкаНаКомандировку") Тогда
				ЗаполнитьЗначенияСвойств(СтрокаЗаполнения, ЗаявкаНаРасходованиеДС, "упоПроектнаяЗадача");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	РасшифровкаЗаполнена = Истина;
	
	Возврат РасшифровкаЗаполнена;
	
КонецФункции

Функция ТекстЗапросаПроектныхЗадачТабличнойЧасти(ОбъектыРасчетов)
	
	МассивТекстаЗапроса = Новый Массив;
	
	ШаблонЗапроса = "ВЫБРАТЬ
					|	СправочникОбъектыРасчетов.ОбъектРасчетов КАК ОбъектРасчетов,
					|	ДокументОбъектаРасчетов.упоПроектнаяЗадача КАК упоПроектнаяЗадача
					|ИЗ
					|	%1 КАК ДокументОбъектаРасчетов
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СправочникОбъектыРасчетов КАК СправочникОбъектыРасчетов
					|		ПО ДокументОбъектаРасчетов.Ссылка = СправочникОбъектыРасчетов.Объект";
	
	Для Каждого КлючЗначение Из ОбъектыРасчетов Цикл
		МД = КлючЗначение.Значение.Метаданные();
		ИмяМД = МД.ПолноеИмя();
		Если МД.Реквизиты.Найти("упоПроектнаяЗадача") <> Неопределено Тогда
			МассивТекстаЗапроса.Добавить(СтрШаблон(ШаблонЗапроса, ИмяМД));
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(МассивТекстаЗапроса) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Разделитель = "
				|ОБЪЕДИНИТЬ
				|";
	
	ТекстЗапроса = СтрСоединить(МассивТекстаЗапроса, Разделитель);
	
	МассивТекстаЗапроса.Очистить();
	
	ТекстЗапросаВТ = "ВЫБРАТЬ
					|	ОбъектыРасчетов.Ссылка КАК ОбъектРасчетов,
					|	ОбъектыРасчетов.Объект КАК Объект
					|ПОМЕСТИТЬ СправочникОбъектыРасчетов
					|ИЗ
					|	Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
					|ГДЕ
					|	ОбъектыРасчетов.Ссылка В(&МассивОбъектов)";
	
	МассивТекстаЗапроса.Добавить(ТекстЗапросаВТ);
	МассивТекстаЗапроса.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = СтрСоединить(МассивТекстаЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ИзменениеЭлементовФорм

Процедура ПриСозданииНаСервере_Документы(ИмяДокумента, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяДокумента = "ЗаказКлиента" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "ЗаказПоставщику" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "ЗаказНаПроизводство" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "ЗаказНаПроизводство2_2" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "РеализацияТоваровУслуг" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_РеализацияТоваровУслуг_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "ПриобретениеТоваровУслуг" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ПриобретениеТоваровУслуг_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "АктВыполненныхРабот" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_АктВыполненныхРабот_ФормаДокумента(Форма);
		
	ИначеЕсли ИмяДокумента = "ПоступлениеБезналичныхДенежныхСредств" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьКолонкиПроектПроектнаяЗадачаВРасшифровкаПлатежа(Форма);
		
	ИначеЕсли ИмяДокумента = "ПрочиеДоходыРасходы" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьЭлементы_Документ_ПрочиеДоходыРасходы_ФормаЭлемента(Форма);
		
	ИначеЕсли ИмяДокумента = "ПриходныйКассовыйОрдер" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьКолонкиПроектПроектнаяЗадачаВРасшифровкаПлатежа(Форма);
		
	ИначеЕсли ИмяДокумента = "РасходныйКассовыйОрдер" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьКолонкиПроектПроектнаяЗадачаВРасшифровкаПлатежа(Форма);
		
	ИначеЕсли ИмяДокумента = "СписаниеБезналичныхДенежныхСредств" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьКолонкиПроектПроектнаяЗадачаВРасшифровкаПлатежа(Форма);
		
	ИначеЕсли ИмяДокумента = "ЗаявкаНаРасходованиеДенежныхСредств" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьКолонкиПроектПроектнаяЗадачаВРасшифровкаПлатежа(Форма);
		
	ИначеЕсли ИмяДокумента = "ОтражениеЗарплатыВФинансовомУчете" 
		И (ИмяФормы = "ФормаДокумента" Или ИмяФормы = "ФормаСпискаФизическихЛиц") Тогда
		
		ПриСозданииНаСервере_Документы_РаспределениеЗарплаты(Форма, ИмяФормы);
		
	ИначеЕсли ИмяДокумента = "ЗаявкаНаКомандировку" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ЗаявкаНаКомандировку_ФормаДокумента(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_Справочники(ИмяСправочника, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяСправочника = "ДоговорыКонтрагентов" Тогда
		
		Если ИмяФормы = "ФормаЭлемента" Тогда
			ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаЭлемента(Форма);
		ИначеЕсли ИмяФормы = "ФормаСписка" Тогда
			Форма.Элементы.Список.Отображение = ОтображениеТаблицы.Дерево;
		ИначеЕсли ИмяФормы = "ФормаВыбора" Тогда
			Форма.Элементы.Список.Отображение = ОтображениеТаблицы.Дерево;
		КонецЕсли;
		
	ИначеЕсли ИмяСправочника = "СтатьиДвиженияДенежныхСредств" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ДобавитьЭлементы_СтатьиДвиженияДенежныхСредств_ФормаЭлемента(Форма);
		
	ИначеЕсли ИмяСправочника = "Контрагенты" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ДобавитьЭлементыФормыКонтрагентов(Форма, Отказ);
		
	ИначеЕсли ИмяСправочника = "Партнеры" И ИмяФормы = "ФормаЭлементаРеквизитыКонтрагента" Тогда
		
		ДобавитьЭлементыСпрПартнеровКакКонтрагентов(Форма);
		
	ИначеЕсли ИмяСправочника = "СтруктураПредприятия" И ИмяФормы = "ФормаВыбора" Тогда
		
		ДобавитьЭлементыФормыВыбораСтруктураПредприятия(Форма, Отказ);
		
	ИначеЕсли ИмяСправочника = "Сценарии" И ИмяФормы = "ФормаВыбора" Тогда
		
		ИзменитьЭлементы_Сценарии_ФормаВыбора(Форма);
		
	ИначеЕсли ИмяСправочника = "Номенклатура" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ИзменитьЭлементы_Номенклатура_ФормаЭлемента(Форма, Отказ);
		
	ИначеЕсли ИмяСправочника = "Проекты" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ИзменитьЭлементы_Проекты_ФормаЭлемента(Форма, Отказ);
		
	ИначеЕсли ИмяСправочника = "упоВидыОпераций" И ИмяФормы = "ФормаЭлементаУправляемая" Тогда
		
		ИзменитьРеквизиты_упоВидыОпераций_ФормаЭлемента(Форма, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_ПВХ(ИмяПВХ, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяПВХ = "СтатьиДоходов" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ИзменитьЭлементы_ПВХ_СтатьиДоходов_ФормаЭлемента(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЭлементыФормыВыбораСтруктураПредприятия(Форма, Отказ)
	
	Если Форма.Параметры.Свойство("упоВыборПодразделения") Тогда
		Форма.Элементы.Список.УстановитьДействие("ВыборЗначения", "Подключаемый_упоСписокВыборЗначения");
	КонецЕсли;
	
	упоИнтеграцияВызовСервера.НастроитьОтображениеСпискаПодразделений(Форма);
	
КонецПроцедуры

Процедура ИзменитьЭлементы_Номенклатура_ФормаЭлемента(Форма, Отказ)
	
	Если НЕ ОтражатьФактРасходаПриПриобретенииТоваров() Тогда
		Возврат;
	КонецЕсли;
	
	СворачиваемаяГруппаРегламентированныйУчет = Форма.Элементы.Найти("СворачиваемаяГруппаРегламентированныйУчет");
	Если СворачиваемаяГруппаРегламентированныйУчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	упоСтатьяРасходовПриПриобретенииТоваров = Форма.Элементы.Добавить("упоСтатьяРасходовПриПриобретенииТоваров",
			Тип("ПолеФормы"), СворачиваемаяГруппаРегламентированныйУчет);
	упоСтатьяРасходовПриПриобретенииТоваров.ПутьКДанным = "Объект.упоСтатьяРасходовПриПриобретенииТоваров";
	упоСтатьяРасходовПриПриобретенииТоваров.Вид = ВидПоляФормы.ПолеВвода;
	
КонецПроцедуры

Процедура ИзменитьЭлементы_ПВХ_СтатьиДоходов_ФормаЭлемента(Форма)
	
	Форма.УстановитьДействие("ПослеЗаписи", "ПослеЗаписи");
	
КонецПроцедуры

Процедура ДобавитьЭлементы_Документ_ПрочиеДоходыРасходы_ФормаЭлемента(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Форма.Объект.ХозяйственнаяОперация = 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.СписаниеПрочихРасходов") Тогда
		
		ЭлементРодитель = Элементы.Найти("ГруппаШапкаЛево");
		Если ЭлементРодитель = Неопределено Тогда
			ЭлементРодитель = Форма;
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Добавить("упоОтражениеФинансовогоРезультата", Тип("ПолеФормы"), ЭлементРодитель);
		НовыйЭлемент.ПутьКДанным = "Объект.упоОтражениеФинансовогоРезультата";
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		
	ИначеЕсли Форма.Объект.ХозяйственнаяОперация = 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеклассификацияРасходов") Тогда
		
		ЭлементРодитель = Элементы.Найти("ГруппаШапкаЛево");
		Если ЭлементРодитель = Неопределено Тогда
			ЭлементРодитель = Форма;
		КонецЕсли;
		
		НовыйЭлемент = Элементы.Добавить("упоОтражениеРаспределенияРасходовОПРиОХР", Тип("ПолеФормы"), ЭлементРодитель);
		НовыйЭлемент.ПутьКДанным = "Объект.упоОтражениеРаспределенияРасходовОПРиОХР";
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаЭлемента(Форма)
	
	упоРодитель = Форма.Элементы.Добавить("упоРодитель", Тип("ПолеФормы"), Форма.Элементы.ГруппаШапкаЛево);
	упоРодитель.ПутьКДанным = "Объект.Родитель";
	упоРодитель.Вид = ВидПоляФормы.ПолеВвода;
	упоРодитель.КнопкаВыбора = Истина;
	
	Форма.Элементы.Переместить(упоРодитель, Форма.Элементы.ГруппаШапкаЛево, Форма.Элементы.Наименование);
	
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Контрагент", "Объект.Контрагент");
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НоваяСвязь);
	НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
	упоРодитель.СвязиПараметровВыбора = НовыеСвязи;
	
	ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаДокумента_ПодменитьСтатус(Форма);
	
	упоСхемаОплаты = Форма.Элементы.Добавить("упоСхемаОплаты", Тип("ПолеФормы"), Форма.Элементы.ГруппаШапкаПраво);
	упоСхемаОплаты.ПутьКДанным = "Объект.упоСхемаОплаты";
	упоСхемаОплаты.Вид = ВидПоляФормы.ПолеВвода;
	упоСхемаОплаты.КнопкаВыбора = Истина;
	
КонецПроцедуры

Процедура ДобавитьЭлементыПроектПроектнаяЗадачаВШапкуДокумента(ЭтаФорма)
	
	Если Не ЭтаФорма.Объект.Свойство("упоПроектнаяЗадача") Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаРодитель = ЭтаФорма.Элементы.Найти("ГруппаДополнительныеРеквизитыШапки"); // Списание безналичных ДС
	Если ГруппаРодитель = Неопределено Тогда
		ГруппаРодитель = ЭтаФорма.Элементы.Найти("ГруппаШапкаПраво"); // Списание Заявка на расходование ДС
	КонецЕсли;
	Если ГруппаРодитель = Неопределено Тогда
		ГруппаРодитель = ЭтаФорма.Элементы.Найти("ГруппаПраво"); // РКО
	КонецЕсли;
	Если ГруппаРодитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипПолеФормы = Тип("ПолеФормы");
	
	ЭлементПроектнаяЗадача = ЭтаФорма.Элементы.Добавить("упоШапкаПроектнаяЗадача",
			ТипПолеФормы,
			ГруппаРодитель);
	ЭлементПроектнаяЗадача.ПутьКДанным = "Объект.упоПроектнаяЗадача";
	ЭлементПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементПроектнаяЗадача.КнопкаВыбора = Истина;
	
	ЭлементПроект = ЭтаФорма.Элементы.Добавить("упоШапкаПроект",
			ТипПолеФормы,
			ГруппаРодитель);
	ЭлементПроект.Вид = ВидПоляФормы.ПолеНадписи;
	ЭлементПроект.ПутьКДанным = "Объект.упоПроектнаяЗадача.упоКорневойПроект";
	ЭлементПроект.Заголовок = НСтр("ru = 'Проект'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецПроцедуры

Процедура ИзменитьЭлементы_Проекты_ФормаЭлемента(Форма, Отказ)
	
	упоИнтеграция.ДобавитьКомандуОткрытияФормыПроекта(Форма, "Подключаемый_упоОткрытьФормуПроектаPM",
		НСтр("ru = 'Открыть форму проекта PM'"));
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Родитель");
