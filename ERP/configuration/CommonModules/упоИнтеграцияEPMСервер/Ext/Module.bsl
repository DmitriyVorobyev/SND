	Элемент = Элементы.Вставить("СпособОтраженияЗарплаты", Тип("ПолеФормы"), Группа);
	Элемент.ПутьКДанным = "Объект.СпособОтраженияЗарплаты";
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.Ширина = 28;
	Элемент.Заголовок = НСтр("ru = 'Способ отражения'");
	
	Элемент = Элементы.Вставить("Служебный", Тип("ПолеФормы"), Группа, ЭлементВидНачисленияPM);
	Элемент.ПутьКДанным = "Объект.Служебный";
	Элемент.Вид = ВидПоляФормы.ПолеФлажка;
