			|	ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|	ФинансовыйДокумент.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|	ФинансовыйДокумент.Контрагент КАК Контрагент,
			|	ФинансовыйДокумент.Договор КАК Договор,
			|	ФинансовыйДокумент.Валюта КАК Валюта,
			|	СУММА(ФинансовыйДокумент.СуммаДокумента) КАК Сумма
			|ИЗ
			|	Документ.РасходныйКассовыйОрдер КАК ФинансовыйДокумент
			|ГДЕ
			|	ФинансовыйДокумент.Ссылка = &Ссылка
			|	И ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
			|	И НЕ ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств = ЗНАЧЕНИЕ(Документ.ЗаявкаНаРасходованиеДенежныхСредств.ПустаяСсылка)
			|	И ФинансовыйДокумент.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств,
			|	ФинансовыйДокумент.Контрагент,
			|	ФинансовыйДокумент.Договор,
			|	ФинансовыйДокумент.Валюта,
			|	ФинансовыйДокумент.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу,
			|	ФинансовыйДокумент.Подразделение,
			|	ФинансовыйДокумент.Организация,
			|	ФинансовыйДокумент.СтатьяДвиженияДенежныхСредств,
			|	ФинансовыйДокумент.Дата";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	&ВидДвижения КАК ВидДвижения,
			|	РасшифровкаПлатежа.Ссылка.Дата КАК Период,
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	РасшифровкаПлатежа.Ссылка.Организация КАК Организация,
			|	РасшифровкаПлатежа.Ссылка.Подразделение КАК Подразделение,
			|	РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|	РасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|	РасшифровкаПлатежа.Ссылка.Контрагент КАК Контрагент,
			|	&ПодстрокаОбъектаРасчетов КАК Договор,
			|	РасшифровкаПлатежа.Ссылка.Валюта КАК Валюта,
			|	СУММА(РасшифровкаПлатежа.Сумма) КАК Сумма
			|ИЗ
			|	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &Ссылка
			|	И РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
			|	И НЕ РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств = ЗНАЧЕНИЕ(Документ.ЗаявкаНаРасходованиеДенежныхСредств.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
			|	РасшифровкаПлатежа.Ссылка.Организация,
			|	РасшифровкаПлатежа.Ссылка.Подразделение,
			|	РасшифровкаПлатежа.Ссылка.Контрагент,
			|	&ПодстрокаОбъектаРасчетов,
			|	РасшифровкаПлатежа.Ссылка.Валюта,
			|	РасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу,
			|	РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств,
			|	РасшифровкаПлатежа.Ссылка.Дата";
		
		ПодстрокаОбъектаРасчетов = ПолучитьПодстрокуОбъектаРасчетовДляЗапроса();
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодстрокаОбъектаРасчетов", ПодстрокаОбъектаРасчетов);
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	ДенежныеСредстваКВыплате = Источник.Движения.упоДенежныеСредстваКВыплате;
	ДенежныеСредстваКВыплате.Записывать = Истина;
	ДенежныеСредстваКВыплате.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

Процедура ОбработкаПроведения_ПрочиеДоходыРасходы(Источник, Отказ, РежимПроведения)
	
	ОбработкаПроведения_ПрочиеДоходыРасходы_РаспределениеРеклассификацииОПРиОХР(Источник, Отказ, РежимПроведения);
	ОбработкаПроведения_ПрочиеДоходыРасходы_ФинансовыеРезультаты(Источник, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаПроведения_ПрочиеДоходыРасходы_РаспределениеРеклассификацииОПРиОХР(Источник, Отказ, РежимПроведения)
	
	Если НЕ Источник.ХозяйственнаяОперация = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеклассификацияРасходов") Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеИменРеквизитов = Новый Структура;
	СоответствиеИменРеквизитов.Вставить("СпособыРаспределенияРасходовПоПроектам", "упоСпособыРаспределенияРасходовПоПроектам");
	СоответствиеИменРеквизитов.Вставить("КоэфНД", "упоКоэфНД");
	СоответствиеИменРеквизитов.Вставить("КоэфПодразделение", "упоКоэфПодразделение");
	СоответствиеИменРеквизитов.Вставить("НДНеРаспределено", "упоНДНеРаспределено");
	СоответствиеИменРеквизитов.Вставить("ПодразделенияНеРаспределено", "упоПодразделенияНеРаспределено");
	
	ПериодРегистрации = НачалоМесяца(Источник.Дата);
	ДокументРегистратор = Источник.Ссылка;
	Организация = Источник.Организация;
	
	НаборЗаписей = РегистрыСведений.упоРаспределениеРеклассификацииОПРиОХР.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПериодРегистрации.Установить(ПериодРегистрации);
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.ДокументРегистратор.Установить(ДокументРегистратор);
	
	Если Источник.упоОтражениеРаспределенияРасходовОПРиОХР Тогда
		
		НомерСтроки = 1;
		ПрочиеРасходы = Источник.ПрочиеРасходы;
		
		Для Каждого СтрокаДвижений Из ПрочиеРасходы Цикл
			
			НоваяСтрока = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДвижений);
			
			НоваяСтрока.ПериодРегистрации = ПериодРегистрации;
			НоваяСтрока.Организация = Организация;
			НоваяСтрока.ДокументРегистратор = ДокументРегистратор;
			НоваяСтрока.Номер = НомерСтроки;
			
			Для Каждого ЭлСоответствия Из СоответствиеИменРеквизитов Цикл
				НоваяСтрока[ЭлСоответствия.Ключ] = СтрокаДвижений[ЭлСоответствия.Значение];
			КонецЦикла;
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстСообщения = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецПопытки;
	
КонецПроцедуры // ОтразитьупоРаспределениеРеклассификацииОПРиОХР()

Процедура ОбработкаПроведения_ПрочиеДоходыРасходы_ФинансовыеРезультаты(Источник, РежимПроведения)
	
	Если НЕ Источник.ХозяйственнаяОперация = 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.СписаниеПрочихРасходов") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.упоОтражениеФинансовогоРезультата Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	 &Период КАК Период, 
		|	 &Ссылка КАК Регистратор,
		|    ПрочиеДоходыРасходыПрочиеРасходы.Ссылка.Организация КАК Организация,
		|    ПрочиеДоходыРасходыПрочиеРасходы.Подразделение КАК Подразделение,
		|    ПрочиеДоходыРасходыПрочиеРасходы.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|    НЕОПРЕДЕЛЕНО КАК СтатьяДоходов,
		|    ПрочиеДоходыРасходыПрочиеРасходы.СтатьяРасходов КАК СтатьяРасходов,
		|    0 КАК Доходы,
		|    СУММА(ПрочиеДоходыРасходыПрочиеРасходы.Сумма) КАК Расходы
		|ИЗ
		|    Документ.ПрочиеДоходыРасходы.ПрочиеРасходы КАК ПрочиеДоходыРасходыПрочиеРасходы
		|ГДЕ
		|    ПрочиеДоходыРасходыПрочиеРасходы.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|    ПрочиеДоходыРасходыПрочиеРасходы.Ссылка.Организация,
		|    ПрочиеДоходыРасходыПрочиеРасходы.Подразделение,
		|    ПрочиеДоходыРасходыПрочиеРасходы.НаправлениеДеятельности,
		|    ПрочиеДоходыРасходыПрочиеРасходы.СтатьяРасходов";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Источник.Дата);
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.Текст = ТекстЗапроса;
	ТаблицаФинансовыеРезультаты = Запрос.Выполнить().Выгрузить();
	
	ФинансовыеРезультаты = Источник.Движения.ФинансовыеРезультаты;
	ФинансовыеРезультаты.Записывать = Истина;
	ФинансовыеРезультаты.Загрузить(ТаблицаФинансовыеРезультаты);
	
КонецПроцедуры

#КонецОбласти

#Область ЭтапыОплаты

Процедура ЭтапыОплатыДобавитьКнопку(Форма)
	
	упоПроектнаяЗадача = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Параметры.Ключ, "упоПроектнаяЗадача");
	
	Если НЕ ЗначениеЗаполнено(упоПроектнаяЗадача) Тогда
		Возврат;
	КонецЕсли;
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("упоПроектнаяЗадачаЗеркало", Новый ОписаниеТипов("СправочникСсылка.Проекты")));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("упоПроектнаяЗадачаДокумент", Новый ОписаниеТипов("ДокументСсылка.упоПроектнаяЗадача")));
	Форма.ИзменитьРеквизиты(МассивРеквизитов);
	Форма.упоПроектнаяЗадачаЗеркало = упоПроектнаяЗадача;
	Форма.упоПроектнаяЗадачаДокумент = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(упоПроектнаяЗадача);
	упоКоманда = Форма.Команды.Добавить("упоКомандаЗаполнитьПоДаннымPM");
	упоКоманда.Заголовок = НСтр("ru = 'Заполнить по данным РМ'");
	упоКоманда.Действие = "Подключаемый_упоКомандаЗаполнитьПоДаннымPM";
	упоКоманда.ИзменяетСохраняемыеДанные = Истина;
	упоЭлемент = Форма.Элементы.Добавить(упоКоманда.Имя, Тип("КнопкаФормы"), Форма.Элементы.ЭтапыГрафикаОплаты.КоманднаяПанель);
	упоЭлемент.ИмяКоманды = упоКоманда.Имя;
	
КонецПроцедуры

Процедура ЗаполнитьЭтапыОплатыПоДаннымPM(ПараметрыОбработки, НаправлениеДвижения, СоответствиеВидов)
	
	ПараметрыОбработкиЛокальные = Новый Структура("Заказ, Контрагент, ПроектнаяЗадачаДокумент, 
			|СуммаОплатыПоДокументу");
	
	ПодготовитьЛокальныеПараметрыОбработки(ПараметрыОбработки, ПараметрыОбработкиЛокальные);
	
	Заказ = ПараметрыОбработкиЛокальные.Заказ;
	Контрагент = ПараметрыОбработкиЛокальные.Контрагент;
	ПроектнаяЗадачаДокумент = ПараметрыОбработкиЛокальные.ПроектнаяЗадачаДокумент;
	СуммаОплатыПоДокументу = ПараметрыОбработкиЛокальные.СуммаОплатыПоДокументу;
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадачаДокумент);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектнаяЗадачаДокумент", ПроектнаяЗадачаДокумент);
	Запрос.УстановитьПараметр("ТекВерсия", ТекВерсия);
	Запрос.УстановитьПараметр("НаправлениеДвижения", НаправлениеДвижения);
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.ВидПлатежа КАК ВидПлатежа,
		|	СУММА(Т.Сумма) КАК Сумма,
		|	Т.ДатаДвижения КАК ДатаДвижения
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
		|			,
		|			Версия = &ТекВерсия
		|				И ПроектнаяЗадача = &ПроектнаяЗадачаДокумент) КАК Т
		|ГДЕ
		|	Т.НаправлениеДвижения = &НаправлениеДвижения
		|	И Т.Контрагент = &ДоговорКонтрагент
		|	И Т.Сумма <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.ВидПлатежа,
		|	Т.ДатаДвижения
		|ИТОГИ ПО
		|	ОБЩИЕ";
	
	ДоговорКонтрагента = Заказ.Договор;
	Если ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Контрагент", ".Договор");
		Запрос.УстановитьПараметр("ДоговорКонтрагент", ДоговорКонтрагента);
	Иначе
		Запрос.УстановитьПараметр("ДоговорКонтрагент", Контрагент);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРезультат = Результат.Выгрузить();
	
	СуммаБаза = ТаблицаРезультат[0].Сумма;
	ТаблицаРезультат.Удалить(0);
	
	Заказ.ЭтапыГрафикаОплаты.Очистить();
	
	ОстатокБазы = СуммаБаза;
	ПроцентовРаспределено = 0;
	СуммаРаспределено = 0;
	
	ДатаОтгрузки = Заказ.ДатаОтгрузки;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		
		ДатаПлатежа = СтрокаТаблицы.ДатаДвижения;
		
		тЭтапГрафикаОплаты = Заказ.ЭтапыГрафикаОплаты.Добавить();
		тЭтапГрафикаОплаты.ВариантОплаты = СоответствиеВидов.Получить(СтрокаТаблицы.ВидПлатежа);
		тЭтапГрафикаОплаты.ДатаПлатежа = ДатаПлатежа;
		
		Если ДатаПлатежа < ДатаОтгрузки Тогда
			тЭтапГрафикаОплаты.ВариантОтсчета = 
				упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВариантыОтсчетаДатыПлатежа.ДоДатыОтгрузки");
		Иначе
			тЭтапГрафикаОплаты.ВариантОтсчета = 
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВариантыОтсчетаДатыПлатежа.ОтДатыОтгрузки");
		КонецЕсли;
		
		ЗаполнитьОтсрочкуПлатежа(тЭтапГрафикаОплаты, Заказ);
		
		ОстатокБазы = ОстатокБазы - СтрокаТаблицы.Сумма;
		Если ОстатокБазы = 0 Тогда
			тЭтапГрафикаОплаты.ПроцентПлатежа = 100 - ПроцентовРаспределено;
			тЭтапГрафикаОплаты.СуммаПлатежа = СуммаОплатыПоДокументу - СуммаРаспределено;
		Иначе
			тЭтапГрафикаОплаты.ПроцентПлатежа = СтрокаТаблицы.Сумма * 100 / СуммаБаза;
			тЭтапГрафикаОплаты.СуммаПлатежа = тЭтапГрафикаОплаты.ПроцентПлатежа * СуммаОплатыПоДокументу / 100;
		КонецЕсли;
		ПроцентовРаспределено = ПроцентовРаспределено + тЭтапГрафикаОплаты.ПроцентПлатежа;
		СуммаРаспределено = СуммаРаспределено + тЭтапГрафикаОплаты.СуммаПлатежа;
		
		Если ОстатокБазы = 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодготовитьЛокальныеПараметрыОбработки(ПараметрыОбработки, ПараметрыОбработкиЛокальные)
	
	Если ПараметрыОбработки.Свойство("Заказ") Тогда
		ПараметрыОбработкиЛокальные.Заказ = ПараметрыОбработки.Заказ;
		ПараметрыОбработкиЛокальные.Контрагент = ПараметрыОбработки.Заказ.Контрагент;
		ПараметрыОбработкиЛокальные.ПроектнаяЗадачаДокумент = ПараметрыОбработки.ДокументОснование;
		ПараметрыОбработкиЛокальные.СуммаОплатыПоДокументу = ПараметрыОбработки.СуммаПоДокументу;
	ИначеЕсли ПараметрыОбработки.Свойство("Форма") Тогда
		ПараметрыОбработкиЛокальные.Заказ = ПараметрыОбработки.Форма;
		ПараметрыОбработкиЛокальные.Контрагент = ПараметрыОбработки.Контрагент;
		ПараметрыОбработкиЛокальные.ПроектнаяЗадачаДокумент = ПараметрыОбработкиЛокальные.Заказ.упоПроектнаяЗадачаДокумент;
		ПараметрыОбработкиЛокальные.СуммаОплатыПоДокументу = ПараметрыОбработкиЛокальные.Заказ.СуммаОплатыПоДокументу;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОтсрочкуПлатежа(тЭтапГрафикаОплаты, Заказ)
	
	Если ТипЗнч(Заказ) = Тип("ДокументОбъект.ЗаказКлиента")
		Или ТипЗнч(Заказ) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда
		ДатаЗаказа = Заказ.Дата;
		ДатаПереходаПраваСобственности = Дата("00010101");
	Иначе
		ДатаЗаказа = Заказ.ДатаЗаказа;
		ДатаПереходаПраваСобственности = Заказ.ДатаПереходаПраваСобственности;
	КонецЕсли;
	
	ЭтапыОплатыКлиентСерверМодуль = ОбщегоНазначения.ОбщийМодуль("ЭтапыОплатыКлиентСервер");
	ЭтапыОплатыВызовСервераМодуль = ОбщегоНазначения.ОбщийМодуль("ЭтапыОплатыВызовСервера");
	
	РеквизитыСоглашения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ.Соглашение,
			"СрокПереходаПраваСобственности,Календарь");
	СрокПереходаПраваСобственности = РеквизитыСоглашения.СрокПереходаПраваСобственности;
	Календарь = РеквизитыСоглашения.Календарь;
	
	СтруктураПараметров = ЭтапыОплатыКлиентСерверМодуль.ПараметрыРасчетаДатыПлатежа();
	СтруктураПараметров.ВариантОтсчета = тЭтапГрафикаОплаты.ВариантОтсчета;
	СтруктураПараметров.ДатаПлатежа = тЭтапГрафикаОплаты.ДатаПлатежа;
	СтруктураПараметров.ДатаЗаказа = ДатаЗаказа;
	СтруктураПараметров.ДатаСогласования = Заказ.ДатаСогласования;
	СтруктураПараметров.ДатаОтгрузки = Заказ.ДатаОтгрузки;
	СтруктураПараметров.ДатаПереходаПраваСобственности = ДатаПереходаПраваСобственности;
	СтруктураПараметров.СрокПереходаПраваСобственности = СрокПереходаПраваСобственности;
	СтруктураПараметров.Календарь = Календарь;
	
	Если ЗначениеЗаполнено(Календарь) Тогда
		тЭтапГрафикаОплаты.Сдвиг = ЭтапыОплатыВызовСервераМодуль.СдвигПоКалендарю(СтруктураПараметров);
	Иначе
		тЭтапГрафикаОплаты.Сдвиг = ЭтапыОплатыКлиентСерверМодуль.СдвигБезКалендаря(СтруктураПараметров);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
