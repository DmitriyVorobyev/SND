// Текст запроса фактические движения БДР поступление товаров услуг.
//
// Возвращаемое значение:
//  Строка - текст запроса.
Функция ТекстЗапросаФактическиеДвиженияБДР_ПриобретениеТоваровУслуг()
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|   СуммыДокументовВВалютахУчетаСрезПоследних.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|   ВЫБОР
		|       КОГДА &ВключатьНДСВФактДоходовРасходов
		|           ТОГДА СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДС + СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДС
		|       ИНАЧЕ СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДС
		|   КОНЕЦ КАК СуммаВалютная,
		|   ВЫБОР
		|       КОГДА &ВключатьНДСВФактДоходовРасходов
		|           ТОГДА СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСУпр + СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДСУпр
		|       ИНАЧЕ СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСУпр
		|   КОНЕЦ КАК СуммаВзаиморасчетов
		|ПОМЕСТИТЬ ВТ_ДанныеВалютныхСуммДокумента
		|ИЗ
		|   РегистрСведений.СуммыДокументовВВалютахУчета.СрезПоследних(, (ВЫРАЗИТЬ(Регистратор КАК Документ.ПриобретениеТоваровУслуг)) = &Ссылка) КАК СуммыДокументовВВалютахУчетаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   ПриобретениеТоваровУслугТовары.упоПроектнаяЗадача КАК упоПроектнаяЗадача,
		|   ПриобретениеТоваровУслугТовары.упоРоль КАК упоРоль,
		|   ПриобретениеТоваровУслугТовары.упоПодразделение КАК упоПодразделение,
		|   ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|   ВЫБОР
		|       КОГДА ПриобретениеТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|           ТОГДА ПриобретениеТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения
		|       ИНАЧЕ ПриобретениеТоваровУслугТовары.Упаковка.ЕдиницаИзмерения
		|   КОНЕЦ КАК Упаковка,
		|   ПриобретениеТоваровУслугТовары.Ссылка КАК Ссылка,
		|   ПриобретениеТоваровУслугТовары.СтатьяРасходов КАК СтатьяРасходов,
		|   ПриобретениеТоваровУслугТовары.СуммаСНДС КАК СуммаСНДС,
		|   ПриобретениеТоваровУслугТовары.Сумма КАК Сумма,
		|   ПриобретениеТоваровУслугТовары.СуммаНДС КАК СуммаНДС,
		|   ПриобретениеТоваровУслугТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|   ПриобретениеТоваровУслугТовары.ИдентификаторСтроки КАК ИдентификаторСтроки
		|ПОМЕСТИТЬ ВТТовары
		|ИЗ
		|   Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		|ГДЕ
		|   ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
		|   И ПриобретениеТоваровУслугТовары.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
		|   И ПриобретениеТоваровУслугТовары.СтатьяРасходов <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|   ПриобретениеТоваровУслугТовары.упоПроектнаяЗадача,
		|   ПриобретениеТоваровУслугТовары.упоРоль,
		|   ПриобретениеТоваровУслугТовары.упоПодразделение,
		|   ПриобретениеТоваровУслугТовары.Номенклатура,
		|   ВЫБОР
		|       КОГДА ПриобретениеТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|           ТОГДА ПриобретениеТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения
		|       ИНАЧЕ ПриобретениеТоваровУслугТовары.Упаковка.ЕдиницаИзмерения
		|   КОНЕЦ,
		|   ПриобретениеТоваровУслугТовары.Ссылка,
		|   ВЫБОР
		|       КОГДА ПриобретениеТоваровУслугТовары.Номенклатура.упоСтатьяРасходовПриПриобретенииТоваров = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
		|           ТОГДА &упоСтатьяРасходовПриПриобретенииТоваров
		|       ИНАЧЕ ПриобретениеТоваровУслугТовары.Номенклатура.упоСтатьяРасходовПриПриобретенииТоваров
		|   КОНЕЦ,
		|   ПриобретениеТоваровУслугТовары.СуммаСНДС,
		|   ПриобретениеТоваровУслугТовары.Сумма,
		|   ПриобретениеТоваровУслугТовары.СуммаНДС,
		|   ПриобретениеТоваровУслугТовары.КоличествоУпаковок,
		|   ПриобретениеТоваровУслугТовары.ИдентификаторСтроки
		|ИЗ
		|   Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		|ГДЕ
		|   ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
		|   И ПриобретениеТоваровУслугТовары.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
		|   И ПриобретениеТоваровУслугТовары.СтатьяРасходов = ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
		|   И &упоОтражатьФактРасходаПриПриобретенииТоваров
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   ВТТовары.Ссылка.Дата КАК Период,
		|   ВТТовары.Ссылка.Дата КАК ДатаНачисления,
		|   ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход) КАК ВидЭлемента,
		|   ВТТовары.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|   упоСоответствиеСтатейДР.СтатьяУПО КАК Статья,
		|   ВТТовары.упоРоль КАК Роль,
		|   ВТТовары.упоПодразделение КАК Подразделение,
		|   ВТТовары.Номенклатура КАК Номенклатура,
		|   ВТТовары.Упаковка КАК ЕдиницаИзмерения,
		|   ВТТовары.Ссылка.Контрагент КАК Контрагент,
		|   ВТТовары.Ссылка.Договор КАК Договор,
		|   ВТТовары.Ссылка.Валюта КАК Валюта,
		|   ВТТовары.упоРоль.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   ВТТовары.Ссылка.Контрагент КАК КонтрагентПодрядчик,
		|   ВТТовары.Ссылка.Договор КАК Заказ_ДоговорПодрядчика,
		|   ЕСТЬNULL(ВЫБОР
		|       КОГДА ВТТовары.Ссылка.Валюта = &ВалютаУправленческогоУчета
		|           ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная
		|       ИНАЧЕ ВЫБОР
		|               КОГДА ВТТовары.Ссылка.ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
		|                   ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВзаиморасчетов
		|               ИНАЧЕ 0
		|           КОНЕЦ
		|   КОНЕЦ, 0) КАК Сумма,
		|   ЕСТЬNULL(ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная, ВЫБОР
		|           КОГДА &ВключатьНДСВФактДоходовРасходов
		|               ТОГДА ВТТовары.СуммаСНДС
		|           ИНАЧЕ ВТТовары.СуммаСНДС - ВТТовары.СуммаНДС
		|       КОНЕЦ) КАК СуммаВалютная,
		|   ВТТовары.КоличествоУпаковок КАК Количество
		|ИЗ
		|   ВТТовары КАК ВТТовары
		|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСоответствиеСтатейДР КАК упоСоответствиеСтатейДР
		|       ПО ВТТовары.СтатьяРасходов = упоСоответствиеСтатейДР.СтатьяИнтеграция
		|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеВалютныхСуммДокумента КАК ВТ_ДанныеВалютныхСуммДокумента
		|       ПО ВТТовары.ИдентификаторСтроки = ВТ_ДанныеВалютныхСуммДокумента.ИдентификаторСтроки";
	
	ИмяТаблицы = "ВТТовары";
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Текст запроса фактические движения БДР реализация товаров услуг.
//
// Возвращаемое значение:
//  Строка - текст запроса.
Функция ТекстЗапросаФактическиеДвиженияБДР_РеализацияТоваровУслуг()
	
	ТекстЗапроса =
		"ВЫБРАТЬ
		|   СуммыДокументовВВалютахУчетаСрезПоследних.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|   ВЫБОР
		|       КОГДА &ВключатьНДСВФактДоходовРасходов
		|           ТОГДА СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДС + СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДС
		|       ИНАЧЕ СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДС
		|   КОНЕЦ КАК СуммаВалютная,
		|   ВЫБОР
		|       КОГДА &ВключатьНДСВФактДоходовРасходов
		|           ТОГДА СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСУпр + СуммыДокументовВВалютахУчетаСрезПоследних.СуммаНДСУпр
		|       ИНАЧЕ СуммыДокументовВВалютахУчетаСрезПоследних.СуммаБезНДСУпр
		|   КОНЕЦ КАК СуммаВзаиморасчетов
		|ПОМЕСТИТЬ ВТ_ДанныеВалютныхСуммДокумента
		|ИЗ
		|   РегистрСведений.СуммыДокументовВВалютахУчета.СрезПоследних(, ВЫРАЗИТЬ(Регистратор КАК Документ.РеализацияТоваровУслуг) = &Ссылка) КАК СуммыДокументовВВалютахУчетаСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   РеализацияТоваровУслугТовары.Ссылка.Дата КАК Период,
		|   РеализацияТоваровУслугТовары.Ссылка.Дата КАК ДатаНачисления,
		|   ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход) КАК ВидЭлемента,
		|   РеализацияТоваровУслугТовары.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|   упоСоответствиеСтатейДР.СтатьяУПО КАК Статья,
		|   РеализацияТоваровУслугТовары.упоРоль КАК Роль,
		|   РеализацияТоваровУслугТовары.упоРоль.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   РеализацияТоваровУслугТовары.упоПодразделение КАК Подразделение,
		|   РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
		|   ВЫБОР
		|       КОГДА РеализацияТоваровУслугТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|           ТОГДА РеализацияТоваровУслугТовары.Номенклатура.ЕдиницаИзмерения
		|       ИНАЧЕ РеализацияТоваровУслугТовары.Упаковка.ЕдиницаИзмерения
		|   КОНЕЦ КАК ЕдиницаИзмерения,
		|   РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК Контрагент,
		|   РеализацияТоваровУслугТовары.Ссылка.Договор КАК Договор,
		|   РеализацияТоваровУслугТовары.Ссылка.Валюта КАК Валюта,
		|   РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК КонтрагентПодрядчик,
		|   РеализацияТоваровУслугТовары.Ссылка.Договор КАК Заказ_ДоговорПодрядчика,
		|   ЕСТЬNULL(ВЫБОР
		|       КОГДА РеализацияТоваровУслугТовары.Ссылка.Валюта = &ВалютаУправленческогоУчета
		|           ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная
		|       ИНАЧЕ ВЫБОР
		|               КОГДА РеализацияТоваровУслугТовары.Ссылка.ВалютаВзаиморасчетов = &ВалютаУправленческогоУчета
		|                   ТОГДА ВТ_ДанныеВалютныхСуммДокумента.СуммаВзаиморасчетов
		|               ИНАЧЕ 0
		|           КОНЕЦ
		|   КОНЕЦ, 0) КАК Сумма,
		|   ЕСТЬNULL(ВТ_ДанныеВалютныхСуммДокумента.СуммаВалютная, ВЫБОР
		|           КОГДА &ВключатьНДСВФактДоходовРасходов
		|               ТОГДА РеализацияТоваровУслугТовары.СуммаСНДС
		|           ИНАЧЕ РеализацияТоваровУслугТовары.СуммаСНДС - РеализацияТоваровУслугТовары.СуммаНДС
		|       КОНЕЦ) КАК СуммаВалютная,
		|   РеализацияТоваровУслугТовары.КоличествоУпаковок КАК Количество
		|ИЗ
		|   Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
		|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСоответствиеСтатейДР КАК упоСоответствиеСтатейДР
		|       ПО РеализацияТоваровУслугТовары.упоСтатьяДоходов = упоСоответствиеСтатейДР.СтатьяИнтеграция
		|       ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеВалютныхСуммДокумента КАК ВТ_ДанныеВалютныхСуммДокумента
		|       ПО РеализацияТоваровУслугТовары.ИдентификаторСтроки = ВТ_ДанныеВалютныхСуммДокумента.ИдентификаторСтроки
		|ГДЕ
		|   РеализацияТоваровУслугТовары.Ссылка = &Ссылка
		|   И РеализацияТоваровУслугТовары.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)";
	
	ИмяТаблицы = "РеализацияТоваровУслугТовары";
	
	Возврат ТекстЗапроса;
	
КонецФункции

