#Область ИзменениеЭлементовФорм

// Изменяет элементы на форме документа "Приобретение товаров услуг".
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма	 - форма.
//
// Возвращаемое значение:
//  Непределено - не возвращает значение.
Функция ИзменитьЭлементы_ПриобретениеТоваровУслуг_ФормаДокумента(ЭтаФорма) Экспорт
	
	Если Не ИспользуетсяОтражениеФактаРасходовПервичнымиДокументами() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипПолеФормы = Тип("ПолеФормы");
	ТипКнопкаФормы = Тип("КнопкаФормы");
	
	НоваяКомандаФормы = ЭтаФорма.Команды.Добавить("упоТоварыЗаполнитьПроектныеЗадачи");
	НоваяКомандаФормы.Действие = "Подключаемый_упоТоварыЗаполнитьПроектныеЗадачи";
	НоваяКомандаФормы.Заголовок = НСтр("ru = 'Заполнить проектные задачи'");
	НоваяКомандаФормы.Картинка = БиблиотекаКартинок.упоВыполнить;
