Процедура ОбработкаПроведения_ЗаявкаНаРасходованиеДенежныхСредств(Источник, РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Приход);
	
	ДанныеВШапкеДокумента = ИспользоватьДанныеШапкиФинансовогоДокумента(Источник);
	
	Если ДанныеВШапкеДокумента Тогда
		ТекстЗапроса = "ВЫБРАТЬ
			|	ФинансовыйДокумент.ДатаПлатежа КАК Период,
			|	&ВидДвижения КАК ВидДвижения,
			|	ФинансовыйДокумент.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	ФинансовыйДокумент.Организация КАК Организация,
			|	ФинансовыйДокумент.Подразделение КАК Подразделение,
			|	ФинансовыйДокумент.Ссылка КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|	ФинансовыйДокумент.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|	ФинансовыйДокумент.Контрагент КАК Контрагент,
			|	ФинансовыйДокумент.Договор КАК Договор,
			|	ФинансовыйДокумент.Валюта КАК Валюта,
			|	СУММА(ФинансовыйДокумент.СуммаДокумента) КАК Сумма
			|ИЗ
			|	Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ФинансовыйДокумент
			|ГДЕ
			|	ФинансовыйДокумент.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	ФинансовыйДокумент.ДатаПлатежа,
			|	ФинансовыйДокумент.СтатьяДвиженияДенежныхСредств,
			|	ФинансовыйДокумент.Организация,
			|	ФинансовыйДокумент.Подразделение,
			|	ФинансовыйДокумент.Ссылка,
			|	ФинансовыйДокумент.Контрагент,
			|	ФинансовыйДокумент.Договор,
			|	ФинансовыйДокумент.Валюта,
			|	ФинансовыйДокумент.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ
			|    РасшифровкаПлатежа.Ссылка КАК Ссылка,
			|    РасшифровкаПлатежа.Сумма КАК Сумма,
			|    РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|    &ПодстрокаОбъектаРасчетов КАК Договор,
			|    Проекты.СсылкаНаПроектнуюЗадачу КАК СсылкаНаПроектнуюЗадачу
			|ПОМЕСТИТЬ ВТ_РасшифровкаПлатежа
			|ИЗ
			|    Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
			|        ПО РасшифровкаПлатежа.упоПроектнаяЗадача = Проекты.Ссылка
			|ГДЕ
			|    РасшифровкаПлатежа.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|    РасшифровкаПлатежа.Сумма,
			|    РасшифровкаПлатежа.Ссылка,
			|    РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
			|    Проекты.СсылкаНаПроектнуюЗадачу,
			|    &ПодстрокаОбъектаРасчетов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|    ЗаявкаНаРасходованиеДенежныхСредств.ДатаПлатежа КАК Период,
			|    &ВидДвижения КАК ВидДвижения,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Организация КАК Организация,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Подразделение КАК Подразделение,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Контрагент КАК Контрагент,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Валюта КАК Валюта,
			|    ВТ_РасшифровкаПлатежа.Сумма КАК Сумма,
			|    ВТ_РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|    ВТ_РасшифровкаПлатежа.Договор КАК Договор,
			|    ВТ_РасшифровкаПлатежа.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача
			|ИЗ
			|    ВТ_РасшифровкаПлатежа КАК ВТ_РасшифровкаПлатежа
			|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
			|        ПО ВТ_РасшифровкаПлатежа.Ссылка = ЗаявкаНаРасходованиеДенежныхСредств.Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|    ЗаявкаНаРасходованиеДенежныхСредств.ДатаПлатежа,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Организация,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Подразделение,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Ссылка,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Контрагент,
			|    ЗаявкаНаРасходованиеДенежныхСредств.Валюта,
			|    ВТ_РасшифровкаПлатежа.Сумма,
			|    ВТ_РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
			|    ВТ_РасшифровкаПлатежа.Договор,
			|    ВТ_РасшифровкаПлатежа.СсылкаНаПроектнуюЗадачу";
		
		ПодстрокаОбъектаРасчетов = ПолучитьПодстрокуОбъектаРасчетовДляЗапроса();
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодстрокаОбъектаРасчетов", ПодстрокаОбъектаРасчетов);
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	ДенежныеСредстваКВыплате = Источник.Движения.упоДенежныеСредстваКВыплате;
	ДенежныеСредстваКВыплате.Записывать = Истина;
	ДенежныеСредстваКВыплате.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

Процедура ОбработкаПроведения_СписаниеБезналичныхДенежныхСредств(Источник, РежимПроведения)
	
	Если Не Источник.ПроведеноБанком Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	Запрос.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
	
	ДанныеВШапкеДокумента = ИспользоватьДанныеШапкиФинансовогоДокумента(Источник);
	
	Если ДанныеВШапкеДокумента Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	&ВидДвижения КАК ВидДвижения,
			|	ВЫБОР
			|		КОГДА НЕ ФинансовыйДокумент.ПроведеноБанком
			|				ИЛИ НАЧАЛОПЕРИОДА(ФинансовыйДокумент.Дата, ДЕНЬ) = ФинансовыйДокумент.ДатаПроведенияБанком
			|			ТОГДА ФинансовыйДокумент.Дата
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ФинансовыйДокумент.ДатаПроведенияБанком, ДЕНЬ)
			|	КОНЕЦ КАК Период,
			|	ФинансовыйДокумент.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	ФинансовыйДокумент.Организация КАК Организация,
			|	ФинансовыйДокумент.Подразделение КАК Подразделение,
			|	ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|	ФинансовыйДокумент.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|	ФинансовыйДокумент.Контрагент КАК Контрагент,
			|	ФинансовыйДокумент.Договор КАК Договор,
			|	ФинансовыйДокумент.Валюта КАК Валюта,
			|	СУММА(ФинансовыйДокумент.СуммаДокумента) КАК Сумма
			|ИЗ
			|	Документ.СписаниеБезналичныхДенежныхСредств КАК ФинансовыйДокумент
			|ГДЕ
			|	ФинансовыйДокумент.Ссылка = &Ссылка
			|	И ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
			|	И НЕ ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств = ЗНАЧЕНИЕ(Документ.ЗаявкаНаРасходованиеДенежныхСредств.ПустаяСсылка)
			|	И ФинансовыйДокумент.упоПроектнаяЗадача <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	ФинансовыйДокумент.ЗаявкаНаРасходованиеДенежныхСредств,
			|	ФинансовыйДокумент.Контрагент,
			|	ФинансовыйДокумент.Валюта,
			|	ФинансовыйДокумент.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу,
			|	ФинансовыйДокумент.Подразделение,
			|	ФинансовыйДокумент.Организация,
			|	ФинансовыйДокумент.СтатьяДвиженияДенежныхСредств,
			|	ВЫБОР
			|		КОГДА НЕ ФинансовыйДокумент.ПроведеноБанком
			|				ИЛИ НАЧАЛОПЕРИОДА(ФинансовыйДокумент.Дата, ДЕНЬ) = ФинансовыйДокумент.ДатаПроведенияБанком
			|			ТОГДА ФинансовыйДокумент.Дата
			|		ИНАЧЕ КОНЕЦПЕРИОДА(ФинансовыйДокумент.ДатаПроведенияБанком, ДЕНЬ)
			|	КОНЕЦ,
			|	ФинансовыйДокумент.Договор";
		
	Иначе
		
		ТекстЗапроса = "ВЫБРАТЬ
			|	&ВидДвижения КАК ВидДвижения,
			|	ВЫБОР
			|		КОГДА НЕ РасшифровкаПлатежа.Ссылка.ПроведеноБанком
			|				ИЛИ НАЧАЛОПЕРИОДА(РасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком
			|			ТОГДА РасшифровкаПлатежа.Ссылка.Дата
			|		ИНАЧЕ КОНЕЦПЕРИОДА(РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком, ДЕНЬ)
			|	КОНЕЦ КАК Период,
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств КАК СтатьяДвиженияДенежныхСредств,
			|	РасшифровкаПлатежа.Ссылка.Организация КАК Организация,
			|	РасшифровкаПлатежа.Ссылка.Подразделение КАК Подразделение,
			|	РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств,
			|	РасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
			|	РасшифровкаПлатежа.Ссылка.Контрагент КАК Контрагент,
			|	&ПодстрокаОбъектаРасчетов КАК Договор,
			|	РасшифровкаПлатежа.Ссылка.Валюта КАК Валюта,
			|	СУММА(РасшифровкаПлатежа.Сумма) КАК Сумма
			|ИЗ
			|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК РасшифровкаПлатежа
			|ГДЕ
			|	РасшифровкаПлатежа.Ссылка = &Ссылка
			|	И РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств ССЫЛКА Документ.ЗаявкаНаРасходованиеДенежныхСредств
			|	И НЕ РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств = ЗНАЧЕНИЕ(Документ.ЗаявкаНаРасходованиеДенежныхСредств.ПустаяСсылка)
			|
			|СГРУППИРОВАТЬ ПО
			|	&ПодстрокаОбъектаРасчетов,
			|	РасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств,
			|	РасшифровкаПлатежа.Ссылка.Организация,
			|	РасшифровкаПлатежа.Ссылка.Подразделение,
			|	РасшифровкаПлатежа.Ссылка.Контрагент,
			|	РасшифровкаПлатежа.Ссылка.Валюта,
			|	РасшифровкаПлатежа.упоПроектнаяЗадача.СсылкаНаПроектнуюЗадачу,
			|	РасшифровкаПлатежа.ЗаявкаНаРасходованиеДенежныхСредств,
			|	ВЫБОР
			|		КОГДА НЕ РасшифровкаПлатежа.Ссылка.ПроведеноБанком
			|				ИЛИ НАЧАЛОПЕРИОДА(РасшифровкаПлатежа.Ссылка.Дата, ДЕНЬ) = РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком
			|			ТОГДА РасшифровкаПлатежа.Ссылка.Дата
			|		ИНАЧЕ КОНЕЦПЕРИОДА(РасшифровкаПлатежа.Ссылка.ДатаПроведенияБанком, ДЕНЬ)
			|	КОНЕЦ";
		
		ПодстрокаОбъектаРасчетов = ПолучитьПодстрокуОбъектаРасчетовДляЗапроса();
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПодстрокаОбъектаРасчетов", ПодстрокаОбъектаРасчетов);
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	ДенежныеСредстваКВыплате = Источник.Движения.упоДенежныеСредстваКВыплате;
	ДенежныеСредстваКВыплате.Записывать = Истина;
	ДенежныеСредстваКВыплате.Загрузить(ТаблицаРезультат);
	
КонецПроцедуры

