// Обработчик события "При создании на сервере".
//
// Параметры:
//  Форма				 - УправляемаяФорма	 - форма
//  Отказ				 - Булево			 - признак отказа от создания.
//  СтандартнаяОбработка - Булево			 - признак стандартной обработки.
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
		И Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2() Тогда
		Возврат;
	КонецЕсли;
	
	СостИмени = упоФункцииОбщегоНазначенияКлиентСервер.СоставИмениФормы(Форма.ИмяФормы);
	ИмяТипаМетаданных = СостИмени.ТипМетаданных;
	
	Если ИмяТипаМетаданных = "Документ" Тогда
		
		ПриСозданииНаСервере_Документы(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "Справочник" Тогда
		
		ПриСозданииНаСервере_Справочники(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "ПланВидовХарактеристик" Тогда
		
		ПриСозданииНаСервере_ПВХ(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_НаправленияДеятельности(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Не ЗначениеЗаполнено(Форма.Объект.упоПроектнаяЗадачаЗеркало) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементПоследователь = Форма.Элементы.Найти("Родитель");
	Если ЭлементПоследователь <> Неопределено Тогда
		ЭлементГруппа = ЭлементПоследователь.Родитель;
		ЭлементПоследовательВГруппе = Истина;
	Иначе
		ЭлементГруппа = Форма;
		ЭлементПоследовательВГруппе = Ложь;
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ()
		И ЭлементПоследовательВГруппе Тогда
		ЭлементПоследователь = ЭлементГруппа;
		ЭлементГруппа = ЭлементПоследователь.Родитель;
		
	КонецЕсли;
	
	Элемент = Форма.Элементы.Вставить("упоПроектнаяЗадачаЗеркало", Тип("ПолеФормы"), ЭлементГруппа, ЭлементПоследователь);
	Элемент.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент.Гиперссылка = Истина;
	Элемент.ПутьКДанным = "Объект.упоПроектнаяЗадачаЗеркало";
	Элемент.Заголовок = НСтр("ru = 'Связано с проектной задачей'");
	
КонецПроцедуры

#КонецОбласти

Процедура УстановитьСвязиПараметровВыбораДоговораКонтрагента(ЭлементУправленияДоговор, ПутьКДаннымКонтрагента) Экспорт
	
	// В PM справочник "Договоры контрагентов" подчинен справочнику "Контрагенты".
	// В ERP связь надо устнавливать по значению реквизита объекта "Контрагент".
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
		Или упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2() Тогда
		
		НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Контрагент", ПутьКДаннымКонтрагента);
		
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НоваяСвязь);
		
		Для каждого ЭлСвязьПараметровВыбора Из ЭлементУправленияДоговор.СвязиПараметровВыбора Цикл
			Если ЭлСвязьПараметровВыбора.Имя = "Отбор.Владелец" Тогда
				Продолжить;
			КонецЕсли;
			НовыйМассив.Добавить(ЭлСвязьПараметровВыбора);
		КонецЦикла;
		
		НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
		
		ЭлементУправленияДоговор.СвязиПараметровВыбора = НовыеСвязи;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьХозОперациюФактДоходовРасходовПроектногоБюджетирования(Параметры = Неопределено) Экспорт
	
	МенеджерНастроекОпераций = Справочники["НастройкиХозяйственныхОпераций"];
	НастройкаОперации = МенеджерНастроекОпераций["упоФактПроектногоБюджетирования"].ПолучитьОбъект();
	
	НастройкаОперации["ИсточникДанных"] = "упоФактДоходовИРасходовОбороты";
	НастройкаОперации["ПредставлениеИсточникаДанных"] = "Факт доходов и расходов (Обороты)";
	НастройкаОперации["ИспользоватьВМеждународномУчете"] = Истина;
	НастройкаОперации["ХозяйственнаяОперация"] = Перечисления.ХозяйственныеОперации.упоФактПроектногоБюджетирования;
	
	НастройкаОперации["ПоказателиРегистра"].Очистить();
	ТипыПоказателей = Новый Массив;
	ТипыПоказателей.Добавить(упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ПоказателиАналитическихРегистров.Сумма"));
	ТипыПоказателей.Добавить(упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ПоказателиАналитическихРегистров.СуммаВВалюте"));
	Для Каждого ТипПоказателя Из ТипыПоказателей Цикл
		Показатель = НастройкаОперации["ПоказателиРегистра"].Добавить();
		Показатель.Показатель = ТипПоказателя;
		Показатель.Использование = Истина;
	КонецЦикла;
	
	НастройкаОперации["Документы"].Очистить();
	Документ = НастройкаОперации["Документы"].Добавить();
	Документ.ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
			Метаданные.Документы.упоОтражениеФактаВПроектномБюджетировании);
	Если упоИнтеграцияКлиентСервер.ЕстьРеквизитПредставлениеДокументаВСправочникеНастройкиХозяйственныхОпераций() Тогда
		Документ.ПредставлениеДокумента = Документ.ИдентификаторОбъектаМетаданных.Синоним;
	КонецЕсли;
	
	НастройкаОперации["ФункциональныеОпции"].Очистить();
	ФО = НастройкаОперации["ФункциональныеОпции"].Добавить();
	ФО.ИмяФункциональнойОпции = "упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании";
	
	НастройкаОперации.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьВладельцаУпаковкиЕдИзмерения(Объект) Экспорт
	
	Если НЕ (упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() ИЛИ упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2()) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Владелец = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения");
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(Знач ДанныеЗаполнения, Объект) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗНЧ(ДанныеЗаполнения) = Тип("Структура") Тогда
		Если ДанныеЗаполнения.Свойство("ЗаявкаНаРасходованиеДенежныхСредств") Тогда
			ДанныеЗаполнения = ДанныеЗаполнения.ЗаявкаНаРасходованиеДенежныхСредств;
			
			РасшифровкаЗаполнена = ЗаполнитьРасшифровкуПоРегистру_упоДенежныеСредстваКВыплате(Объект, ДанныеЗаполнения);
			Если РасшифровкаЗаполнена Тогда
				Возврат; // Возврат.
			КонецЕсли;
			
		ИначеЕсли ДанныеЗаполнения.Свойство("ДокументОснование") Тогда
			ДанныеЗаполнения = ДанныеЗаполнения.ДокументОснование;	
		КонецЕсли;

	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Массив") Тогда
		Если ДанныеЗаполнения.Количество() = 1 Тогда
			ДанныеЗаполнения = ДанныеЗаполнения[0];
		КонецЕсли;
	КонецЕсли;
	
	ПроектнаяЗадачаЗеркало = ПроектнаяЗадачаПоДаннымЗаполнения(ДанныеЗаполнения);
	Если Не ЗначениеЗаполнено(ПроектнаяЗадачаЗеркало) Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыОснования = РеквизитыОснования(ДанныеЗаполнения);
	Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадачаЗеркало, "упоКорневойПроект");
	
	ЗаполнениеУспешно = ЗаполнитьРеквизитыШапки(Объект, Проект, ПроектнаяЗадачаЗеркало, РеквизитыОснования);
	Если ЗаполнениеУспешно Тогда
		ЗаполнитьРеквизитыТабличныхЧастей(Объект, Проект, ПроектнаяЗадачаЗеркало);
	КонецЕсли;
	
КонецПроцедуры

