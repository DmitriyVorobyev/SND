	ПолеПроект.Заголовок = НСтр("ru = 'Проект'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	ПолеПроект.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеПроект.Гиперссылка = Истина;
	ПолеПроект.Ширина = 33;
	
КонецФункции

// Определяет порядок имен групп элементов формы, в котором будет идти поиск группы 
// для размещения элементов Проектная задача/Проект.
// 
// Возвращаемое значение:
//  Массив - имена элементов поиска.
//
Функция ИменаЭлементовФорм_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику()
	
	МассивИменЭлементов = Новый Массив;
	МассивИменЭлементов.Добавить("ГруппаСтатусПриоритет");
	МассивИменЭлементов.Добавить("ГруппаШапка");
	МассивИменЭлементов.Добавить("Шапка");
	
	Возврат МассивИменЭлементов;
	
КонецФункции

Функция ПоискЭлементаФормыПоПриоритету(ЭлементыФормы, МассивИменЭлементов)
	
	Элемент = Неопределено;
	
	Для Каждого ИмяЭлемента Из МассивИменЭлементов Цикл
		Элемент = ЭлементыФормы.Найти(ИмяЭлемента);
		Если Элемент <> Неопределено Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Элемент;
	
КонецФункции

// Создаёт и возвращает элемент формы на основе передаваемых данных.
//
// Параметры:
//  ЭтотОбъект	 	 - ФормаКлиентскогоПриложения - Форма документа.
//  Имя				 - Строка - Имя добавляемого элемента.
//  Тип				 - Тип - Тип добавляемого элемента.
//  Родитель		 - ГруппаФормы, ТаблицаФормы, ФормаКлиентскогоПриложения - Родитель элемента.
//  Вид				 - ВидПоляФормы - Способ представления данных реквизита в форме.
//  ПутьКДанным		 - Строка - Путь к связанному реквизиту.
//  ИмяКоманды		 - Строка - Имя связанной команды. Только для кнопок.
//  Заголовок		 - Строка - Отображаемый заголовок элемента.
//  СмещаемыйЭлемент - ДекорацияФормы, ГруппаФормы, ТаблицаФормы, ФормаКлиентскогоПриложения - Элемент, перед которым
//							необходимо вставить новый элемент.
//
// Возвращаемое значение:
// ДекорацияФормы, ГруппаФормы, КнопкаФормы, ТаблицаФормы, ПолеФормы - Элемент, созданный согласно переданным данным.
//
Функция ДобавитьЭлементФормы(ЭтотОбъект, Имя, Тип, Родитель, Вид, ПутьКДанным = "", ИмяКоманды = "", Заголовок = "",
		СмещаемыйЭлемент = Неопределено)
	
	Элементы = ЭтотОбъект.Элементы;
	
	ЭлементФормы = Элементы.Вставить(Имя, Тип, Родитель, СмещаемыйЭлемент);
	ЭлементФормы.Вид = Вид;
	Если Не ПустаяСтрока(ПутьКДанным) Тогда
		ЭлементФормы.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяКоманды) Тогда
		ЭлементФормы.ИмяКоманды = ИмяКоманды;
	КонецЕсли;
	Если Не ПустаяСтрока(Заголовок) Тогда
		ЭлементФормы.Заголовок = Заголовок;
	КонецЕсли;
	
	Возврат ЭлементФормы;
	
КонецФункции

// Создаёт и возвращает команду формы на основании переданных параметров.
//
// Параметры:
//  ЭтотОбъект				  - ФормаКлиентскогоПриложения - Форма документа.
//  Имя						  - Строка - Имя добавляемой команды.
//  Действие				  - Строка - Имя процедуры обработчика команды.
//  Заголовок				  - Строка - Отображаемый текст команды.
//  Подсказка				  - Строка - Подсказка команды.
//  ИзменяетСохраняемыеДанные - Булево - Признак необходимости сохранения данных после вызова команды.
//
// Возвращаемое значение:
// КомандаФормы - Команда формы, созданная согласно переданным параметрам.
//
Функция ДобавитьКомандуФормы(ЭтотОбъект, Имя, Действие, Заголовок,
		Подсказка = "", ИзменяетСохраняемыеДанные = Ложь)
	
	Команды = ЭтотОбъект.Команды;
	
	Команда = Команды.Добавить(Имя);
	Команда.Действие = Действие;
	Команда.Заголовок = Заголовок;
	Если Не ПустаяСтрока(Подсказка) Тогда
		Команда.Подсказка = Подсказка;
	КонецЕсли;
	Если ИзменяетСохраняемыеДанные Тогда
		Команда.ИзменяетСохраняемыеДанные = ИзменяетСохраняемыеДанные;
	КонецЕсли;
	
	Возврат Команда;
	
КонецФункции

Процедура УстановитьОтметкуНезаполненногоСтатьиДоходов(ЭтаФорма)

	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
				
	ГруппаОтбора = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.упоПроектнаяЗадача");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
		
	ОтборЭлемента = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.упоСтатьяДоходов");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				
	НовоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	НовоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыупоСтатьяДоходов");

КонецПроцедуры

#Область РаспределениеЗарплатыПоПроектам

Процедура ПриСозданииНаСервере_Документы_РаспределениеЗарплаты(Форма, ИмяФормы)
	
	МодульупоРаспределениеЗарплатыНастройкиСервер = ОбщегоНазначения.ОбщийМодуль("упоРаспределениеЗарплатыНастройкиСервер");
	ИспользоватьПодсистему = 
		МодульупоРаспределениеЗарплатыНастройкиСервер.ИспользоватьПодсистему();
	Если Не ИспользоватьПодсистему ТОгда
		Возврат;
	КонецЕсли;
	
	МодульупоРаспределениеЗарплатыСервер = ОбщегоНазначения.ОбщийМодуль("упоРаспределениеЗарплатыСервер");
	МодульупоРаспределениеЗарплатыСервер.ДобавитьКомандыНаФорму_ОтражениеЗарплатыВФинансовомУчете(Форма);
	МодульупоРаспределениеЗарплатыСервер.ДобавитьОтчетНаФорму_ОтражениеЗарплатыВФинансовомУчете(Форма);
	
	Если ИмяФормы = "ФормаСпискаФизическихЛиц" Тогда
		ИзменитьЭлементы_ФормаСпискаФизическихЛиц(Форма);
	КонецЕсли;
	
КонецПроцедуры

// Изменяет элементы в документе "ОтражениеЗарплатыВФинансовомУчете" в форме списка физ. лиц.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма	 - форма.
//
// Возвращаемое значение:
//  Непределено - не возвращает значение.
Процедура ИзменитьЭлементы_ФормаСпискаФизическихЛиц(ЭтаФорма)
	// {Распределение зарплаты}
	
	МодульупоРаспределениеЗарплатыНастройкиСервер = 
		ОбщегоНазначения.ОбщийМодуль("упоРаспределениеЗарплатыНастройкиСервер");
	
	УчетВоВнешнейСистеме = 
		МодульупоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("УчетВоВнешнейСистеме");
	
	Элементы = ЭтаФорма.Элементы;
	
	///////////////////////////////////////////////////////////////
	ДобавляемыеРеквизиты = Новый Массив;
	
	ИмяТаблицы = "НачисленнаяЗарплатаИВзносы";
	МетаданныеОбъекта = Метаданные.Документы.ОтражениеЗарплатыВФинансовомУчете;
	ТабличнаяЧасть = МетаданныеОбъекта.ТабличныеЧасти.Найти("НачисленнаяЗарплатаИВзносыПоФизлицам");
	РеквизитыТабЧасти = ТабличнаяЧасть.Реквизиты;
	
	ИмяРеквизита = "упоНачислениеPM";
	РеквизитФормы = РеквизитыТабЧасти.Найти(ИмяРеквизита);
	НовыйРеквизит = Новый РеквизитФормы(РеквизитФормы.Имя, РеквизитФормы.Тип, ИмяТаблицы, РеквизитФормы.Синоним, Истина);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизита = "упоЧасы";
	РеквизитФормы = РеквизитыТабЧасти.Найти(ИмяРеквизита);
	НовыйРеквизит = Новый РеквизитФормы(РеквизитФормы.Имя, РеквизитФормы.Тип, ИмяТаблицы, РеквизитФормы.Синоним, Истина);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизита = "упоКоэффициент";
	РеквизитФормы = РеквизитыТабЧасти.Найти(ИмяРеквизита);
	НовыйРеквизит = Новый РеквизитФормы(РеквизитФормы.Имя, РеквизитФормы.Тип, ИмяТаблицы, РеквизитФормы.Синоним, Истина);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ИмяРеквизита = ?(УчетВоВнешнейСистеме, "упоНачислениеЗУП", "упоНачислениеERP");
	РеквизитФормы = РеквизитыТабЧасти.Найти(ИмяРеквизита);
	НовыйРеквизит = Новый РеквизитФормы(РеквизитФормы.Имя, РеквизитФормы.Тип, ИмяТаблицы, РеквизитФормы.Синоним, Истина);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	///////////////////////////////////////////////////////////////
	ТипПолеФормы = Тип("ПолеФормы");
	
	ШаблонРеквизита = "%1.%2";
	Если УчетВоВнешнейСистеме Тогда
		ИмяЭлемента = "упоНачислениеЗУП";
		Элемент = Элементы.Добавить(ИмяЭлемента, ТипПолеФормы, Элементы.НачисленнаяЗарплатаИВзносы);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = СтрШаблон(ШаблонРеквизита, ИмяТаблицы, ИмяЭлемента);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Иначе
		ИмяЭлемента = "упоНачислениеERP";
		Элемент = Элементы.Добавить(ИмяЭлемента, ТипПолеФормы, Элементы.НачисленнаяЗарплатаИВзносы);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = СтрШаблон(ШаблонРеквизита, ИмяТаблицы, ИмяЭлемента);
	КонецЕсли;
	
	Элемент.УстановитьДействие("ПриИзменении",
		"упоПодключаемый_НачисленнаяЗарплатаИВзносыПоФизлицамУпоНачислениеERP_ЗУППриИзменении");
	
	ИмяЭлемента = "упоНачислениеPM";
	Элемент = Элементы.Добавить(ИмяЭлемента, ТипПолеФормы, Элементы.НачисленнаяЗарплатаИВзносы);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = СтрШаблон(ШаблонРеквизита, ИмяТаблицы, ИмяЭлемента);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.АвтоОтметкаНезаполненного = Истина;
	
	ИмяЭлемента = "упоЧасы";
	Элемент = Элементы.Добавить(ИмяЭлемента, ТипПолеФормы, Элементы.НачисленнаяЗарплатаИВзносы);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = СтрШаблон(ШаблонРеквизита, ИмяТаблицы, ИмяЭлемента);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	
	ИмяЭлемента = "упоКоэффициент";
	Элемент = Элементы.Добавить(ИмяЭлемента, ТипПолеФормы, Элементы.НачисленнаяЗарплатаИВзносы);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = СтрШаблон(ШаблонРеквизита, ИмяТаблицы, ИмяЭлемента);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	// {/Распределение зарплаты}
КонецПроцедуры

Процедура ИзменитьРеквизиты_упоВидыОпераций_ФормаЭлемента(Форма, Отказ)
	
	Элементы = Форма.Элементы;
	
	Группа = Элементы.Вставить("РаспределениеЗП", Тип("ГруппаФормы"), Форма);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа.Заголовок = НСтр("ru = 'Распределение зарплаты'");
	Группа.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
	Группа.ОтображатьЗаголовок = Истина;
	
	ЭлементВидНачисленияPM = Элементы.Вставить("ВидНачисленияPM", Тип("ПолеФормы"), Группа);
	ЭлементВидНачисленияPM.ПутьКДанным = "Объект.ВидНачисленияPM";
	ЭлементВидНачисленияPM.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементВидНачисленияPM.Ширина = 28;
	ЭлементВидНачисленияPM.Заголовок = НСтр("ru = 'Вид начисления PM'");
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.НеОтражатьЧасы", Ложь);
	МассивПараметрыВыбора = Новый Массив;
	МассивПараметрыВыбора.Добавить(ПараметрВыбора);
