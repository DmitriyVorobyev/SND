// Добавляет в таблицу Расшифровка платежа колонки Проектная задача и Проект в ТЧ Расшифровка платежа.
//
// Параметры:
//	Форма - Управляемая форма - Форма, на которую добавляются колонки.
//
Процедура ДобавитьКолонкиПроектПроектнаяЗадачаВРасшифровкаПлатежа(ЭтаФорма) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ИнтеграцияСПервичнымиДокументами() Тогда
		Возврат;
	КонецЕсли;
	
	КолонкаПроектнаяЗадача = ЭтаФорма.Элементы.Добавить("упоРасшифровкаПлатежаПроектнаяЗадача",
			Тип("ПолеФормы"),
			ЭтаФорма.Элементы.РасшифровкаПлатежа);
	КолонкаПроектнаяЗадача.ПутьКДанным = "Объект.РасшифровкаПлатежа.упоПроектнаяЗадача";
	КолонкаПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	КолонкаПроектнаяЗадача.КнопкаВыбора = Истина;
	
	КолонкаПроект = ЭтаФорма.Элементы.Добавить("упоРасшифровкаПлатежаПроект",
			Тип("ПолеФормы"),
			ЭтаФорма.Элементы.РасшифровкаПлатежа);
	КолонкаПроект.Вид = ВидПоляФормы.ПолеНадписи;
	КолонкаПроект.ПутьКДанным = "Объект.РасшифровкаПлатежа.упоПроектнаяЗадача.упоКорневойПроект";
	КолонкаПроект.Заголовок = НСтр("ru = 'Проект'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ДобавитьЭлементыПроектПроектнаяЗадачаВПлатежныеДокументы(ЭтаФорма);
	
	ДобавитьЭлементыПроектПроектнаяЗадачаВШапкуДокумента(ЭтаФорма);
	УстановитьВидимостьЭлементовФинансовыхДокументов(ЭтаФорма);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияУХ") Тогда
		МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУХ");
		МодульИнтеграции.ИзменитьВидимостьЭлементовПроектаУХи(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Добавить элементы на форму контрагентов.
//
// Параметры:
//  Форма	 - УправляемаяФорма	 - Форма элемента контрагентов.
//  Отказ	 - Булево			 - Отказ создания формы.
//
Процедура ДобавитьЭлементыФормыКонтрагентов(Форма, Отказ) Экспорт
	
	Если Найти(Форма.ИмяФормы, "Справочник.Контрагенты.") <> 0 И Найти(Форма.ИмяФормы, "ФормаЭлемента") <> 0 Тогда
		
		// Оповещения PM
		упоОповещенияВызовСервера.ДобавитьЭлементыПодписки(Форма, Форма.Объект);
		// Конец Оповещения PM
		
		ДобавитьЭлементыМоделированиеЭффективностиСпрКонтрагенты(Форма);
		
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
			Или упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2() Тогда
			
			Если Форма.Элементы.Найти("СтраницаОсновное") <> Неопределено Тогда
				Родитель = Форма.Элементы.СтраницаОсновное;
			Иначе
				Родитель = Форма;
			КонецЕсли;
			
			Элемент_упоОсновнойДоговорКонтрагента = Форма.Элементы.Добавить("упоОсновнойДоговорКонтрагента", Тип("ПолеФормы"), Родитель);
			Элемент_упоОсновнойДоговорКонтрагента.Вид = ВидПоляФормы.ПолеВвода;
			Элемент_упоОсновнойДоговорКонтрагента.КнопкаВыбора = Истина;
			Элемент_упоОсновнойДоговорКонтрагента.ПутьКДанным = "Объект.упоОсновнойДоговорКонтрагента";
			
			Элемент_упоНаправлениеДеятельности = Форма.Элементы.Добавить("упоНаправлениеДеятельности", Тип("ПолеФормы"), Родитель);
			Элемент_упоНаправлениеДеятельности.Вид = ВидПоляФормы.ПолеВвода;
			Элемент_упоНаправлениеДеятельности.КнопкаВыбора = Истина;
			Элемент_упоНаправлениеДеятельности.ПутьКДанным = "Объект.упоНаправлениеДеятельности";
			
			упоСхемаОплаты = Форма.Элементы.Добавить("упоСхемаОплаты", Тип("ПолеФормы"), Родитель);
			упоСхемаОплаты.ПутьКДанным = "Объект.упоСхемаОплаты";
			упоСхемаОплаты.Вид = ВидПоляФормы.ПолеВвода;
			упоСхемаОплаты.КнопкаВыбора = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Добавляет на форму элементы необходимые для моделирования эффективности проекта.
//
// Параметры:
//  Форма	 - Форма элемента справочника Контрагенты.
//
Процедура ДобавитьЭлементыМоделированиеЭффективностиСпрКонтрагенты(Форма) Экспорт
	
	Если НЕ Константы.упоИспользоватьНормированиеИПроектныеРешения.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаПоказатели = Форма.Элементы.Добавить("упоГруппаПоказатели", Тип("ГруппаФормы"), Форма.Элементы.СтраницыФормы);
	ГруппаПоказатели.Вид = ВидГруппыФормы.Страница;
	ГруппаПоказатели.Заголовок = НСтр("ru = 'Компетенции'");
	
	ТаблицаПоказателей = Форма.Элементы.Добавить("упоПоказатели", Тип("ТаблицаФормы"), ГруппаПоказатели);
	ТаблицаПоказателей.ПутьКДанным = "Объект.упоПоказатели";
	
	Для Каждого Реквизит Из Метаданные.Справочники.Контрагенты.ТабличныеЧасти.упоПоказатели.СтандартныеРеквизиты Цикл
		НоваяКолонка = Форма.Элементы.Добавить("упоПоказатели" + Реквизит.Имя, Тип("ПолеФормы"), ТаблицаПоказателей);
		НоваяКолонка.ПутьКДанным = "Объект.упоПоказатели." + Реквизит.Имя;
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.Видимость = Ложь;
	КонецЦикла;
	
	Для Каждого Реквизит Из Метаданные.Справочники.Контрагенты.ТабличныеЧасти.упоПоказатели.Реквизиты Цикл
		НоваяКолонка = Форма.Элементы.Добавить("упоПоказатели" + Реквизит.Имя, Тип("ПолеФормы"), ТаблицаПоказателей);
		НоваяКолонка.ПутьКДанным = "Объект.упоПоказатели." + Реквизит.Имя;
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	КонецЦикла;
	
КонецПроцедуры

// Процедура добавляет на форму элементы партнеров.
//
// Параметры:
//  Форма	 - Форма элемента справочника Партнеры.
//
Процедура ДобавитьЭлементыСпрПартнеровКакКонтрагентов(Форма) Экспорт
	
	Если Не Константы["ИспользоватьПартнеровИКонтрагентов"].Получить() Тогда
		
		НовыеРеквизиты = Новый Массив;
		
		НовыеРеквизиты.Добавить(
			Новый РеквизитФормы(
				"упоОсновнойДоговорКонтрагента",
				Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"),
				,
				"Основной договор контрагента (PM)",
				Истина));
		
		НовыеРеквизиты.Добавить(
			Новый РеквизитФормы(
				"упоНаправлениеДеятельности",
				Новый ОписаниеТипов("СправочникСсылка.НаправленияДеятельности"),
				,
				"Направление деятельности (PM)",
				Истина));
		
		НовыеРеквизиты.Добавить(
			Новый РеквизитФормы(
				"упоСхемаОплаты",
				Новый ОписаниеТипов("СправочникСсылка.упоСхемыОплаты"),
				,
				"Схема оплаты (PM)",
				Истина));
		
		Форма.ИзменитьРеквизиты(НовыеРеквизиты);
		
		Если Форма.Элементы.Найти("ГруппаОбщаяИнформация") <> Неопределено Тогда
			Родитель = Форма.Элементы.ГруппаОбщаяИнформация;
		Иначе
			Родитель = Форма;
		КонецЕсли;
		
		Элемент_упоОсновнойДоговорКонтрагента = Форма.Элементы.Добавить("упоОсновнойДоговорКонтрагента", Тип("ПолеФормы"), Родитель);
		Элемент_упоОсновнойДоговорКонтрагента.Вид = ВидПоляФормы.ПолеВвода;
		Элемент_упоОсновнойДоговорКонтрагента.КнопкаВыбора = Истина;
		Элемент_упоОсновнойДоговорКонтрагента.ПутьКДанным = "упоОсновнойДоговорКонтрагента";
		
		Элемент_упоНаправлениеДеятельности = Форма.Элементы.Добавить("упоНаправлениеДеятельности", Тип("ПолеФормы"), Родитель);
		Элемент_упоНаправлениеДеятельности.Вид = ВидПоляФормы.ПолеВвода;
		Элемент_упоНаправлениеДеятельности.КнопкаВыбора = Истина;
		Элемент_упоНаправлениеДеятельности.ПутьКДанным = "упоНаправлениеДеятельности";
		
		НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Контрагент", "КонтрагентПартнера");
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НоваяСвязь);
		НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
		Элемент_упоОсновнойДоговорКонтрагента.СвязиПараметровВыбора = НовыеСвязи;
		
		упоСхемаОплаты = Форма.Элементы.Добавить("упоСхемаОплаты", Тип("ПолеФормы"), Родитель);
		упоСхемаОплаты.ПутьКДанным = "упоСхемаОплаты";
		упоСхемаОплаты.Вид = ВидПоляФормы.ПолеВвода;
		упоСхемаОплаты.КнопкаВыбора = Истина;
		
		Если ЗначениеЗаполнено(Форма.КонтрагентПартнера) Тогда
			ЗаполнитьЗначенияСвойств(Форма, Форма.КонтрагентПартнера,
				"упоОсновнойДоговорКонтрагента, упоНаправлениеДеятельности, упоСхемаОплаты");
		КонецЕсли;
		
	КонецЕсли;
	
	ДобавитьЭлементыМоделированиеЭффективностиСпрПартнеровКакКонтрагентов(Форма);
	
КонецПроцедуры

// Процедура добавляет на форму элементы партнеров.
//
// Параметры:
//  Форма	 - Форма элемента справочника Партнеры.
//
Процедура ДобавитьЭлементыМоделированиеЭффективностиСпрПартнеровКакКонтрагентов(Форма) Экспорт
	
	Если НЕ Константы.упоИспользоватьНормированиеИПроектныеРешения.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	НовыеРеквизиты = Новый Массив;
	НовыеРеквизиты.Добавить(Новый РеквизитФормы("упоПоказатели", Новый ОписаниеТипов("ТаблицаЗначений"), "", "упоПоказатели"));
	
	Для Каждого Реквизит Из Метаданные.Справочники.Контрагенты.ТабличныеЧасти.упоПоказатели.СтандартныеРеквизиты Цикл
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(Реквизит.Имя, Реквизит.Тип, "упоПоказатели", Реквизит.Синоним));
	КонецЦикла;
	
	Для Каждого Реквизит Из Метаданные.Справочники.Контрагенты.ТабличныеЧасти.упоПоказатели.Реквизиты Цикл
		НовыеРеквизиты.Добавить(Новый РеквизитФормы(Реквизит.Имя, Реквизит.Тип, "упоПоказатели", Реквизит.Синоним));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(НовыеРеквизиты);
	
	ГруппаПоказатели = Форма.Элементы.Добавить("упоГруппаПоказатели", Тип("ГруппаФормы"), Форма.Элементы.ГруппаСтраницы);
	ГруппаПоказатели.Вид = ВидГруппыФормы.Страница;
	ГруппаПоказатели.Заголовок = НСтр("ru = 'Компетенции'");
	
	ТаблицаПоказателей = Форма.Элементы.Добавить("упоПоказатели", Тип("ТаблицаФормы"), ГруппаПоказатели);
	ТаблицаПоказателей.ПутьКДанным = "упоПоказатели";
	
	Для Каждого Реквизит Из Метаданные.Справочники.Контрагенты.ТабличныеЧасти.упоПоказатели.СтандартныеРеквизиты Цикл
		НоваяКолонка = Форма.Элементы.Добавить("упоПоказатели" + Реквизит.Имя, Тип("ПолеФормы"), ТаблицаПоказателей);
		НоваяКолонка.ПутьКДанным = "упоПоказатели." + Реквизит.Имя;
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
		НоваяКолонка.Видимость = Ложь;
	КонецЦикла;
	
	Для Каждого Реквизит Из Метаданные.Справочники.Контрагенты.ТабличныеЧасти.упоПоказатели.Реквизиты Цикл
		НоваяКолонка = Форма.Элементы.Добавить("упоПоказатели" + Реквизит.Имя, Тип("ПолеФормы"), ТаблицаПоказателей);
		НоваяКолонка.ПутьКДанным = "упоПоказатели." + Реквизит.Имя;
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Форма.КонтрагентПартнера) Тогда
		Возврат;
	КонецЕсли;
	
	тзПоказатели = Форма.КонтрагентПартнера.упоПоказатели.Выгрузить();
	Для Каждого СтрТз Из тзПоказатели Цикл
		новстр = Форма.упоПоказатели.Добавить();
		ЗаполнитьЗначенияСвойств(новстр, СтрТз);
	КонецЦикла;
	
КонецПроцедуры

// Процедура добавляет на форму элемент направления движения.
//
// Параметры:
//  ЭтаФорма - ФормаКлиентскогоПриложения - Форма элемента справочника СтатьиДвиженияДенежныхСредств.
//
Процедура ДобавитьЭлементы_СтатьиДвиженияДенежныхСредств_ФормаЭлемента(ЭтаФорма) Экспорт
	
	ЭлементНаправлениеДвижения = ЭтаФорма.Элементы.Добавить("НаправлениеДвижения", Тип("ПолеФормы"));
	ЭлементНаправлениеДвижения.ПутьКДанным = "Объект.упоНаправлениеДвижения";
	ЭлементНаправлениеДвижения.Вид = ВидПоляФормы.ПолеВвода;
	
КонецПроцедуры

// Ограничивает видимость элементов форм Справочник.упоСтатьиЗатрат, Справочник.упоСтатьиДоходов,
// Справочник.упоПодразделения группой элементов "ГруппаРежимаИнтеграции" при вызове формы PM
// из связанных элементов интегрированной конфигурации.
//
Процедура УстановитьВидимостьЭлементовВРежимеИнтеграции(ЭтаФорма) Экспорт
	
	Если Не ЭтаФорма.Параметры.Свойство("РежимИнтеграции") Тогда
		Возврат;
	КонецЕсли;
	
	ПодчиненныеЭлементы = ЭтаФорма.ПодчиненныеЭлементы;
	Для Каждого Элемент Из ПодчиненныеЭлементы Цикл
		Если Элемент.Имя = "ГруппаРежимаИнтеграции" 
			Или Элемент.Имя = "Наименование" 
			Или Элемент.Имя = "Код" Тогда
			Продолжить; // Продолжить
		КонецЕсли;
		Если Элемент.Видимость Тогда
			Элемент.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// Отображение кода и наименования.
	Элементы = ЭтаФорма.Элементы;
	Элементы.Переместить(Элементы.Наименование, Элементы.ГруппаАдаптация);
	Элементы.Переместить(Элементы.Код, Элементы.ГруппаАдаптация);
	
КонецПроцедуры

// Изменяет видимость полей Проект и Проектная задача на форме финансовых документов.
//
// Параметры:
//  ЭтаФорма - ФормаКлиентскогоПриложения - форма финансового документа.
//
Процедура УстановитьВидимостьЭлементовФинансовыхДокументов(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	Если Не Объект.Свойство("упоПроектнаяЗадача") Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементыФормы = Форма.Элементы;
	
	ОтображатьПоля = ИспользоватьДанныеШапкиФинансовогоДокумента(Объект);
	
	Если Не ОтображатьПоля Тогда
		Объект.упоПроектнаяЗадача = Справочники.Проекты.ПустаяСсылка();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы,
		"упоШапкаПроектнаяЗадача",
		"Видимость",
		ОтображатьПоля);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы,
		"упоШапкаПроект",
		"Видимость",
		ОтображатьПоля);
	
КонецПроцедуры

// Изменяет элементы в справочнике "Сценарии" в форме выбора.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма	 - форма.
//
// Возвращаемое значение:
//  Непределено - не возвращает значение.
Функция ИзменитьЭлементы_Сценарии_ФормаВыбора(ЭтаФорма) Экспорт
	
	Если ЭтаФорма.Параметры.Свойство("упоВыборСценария") Тогда
		ЭтаФорма.Элементы.Список.УстановитьДействие("ВыборЗначения", "Подключаемый_упоСписокВыборЗначения");
	КонецЕсли;
	
КонецФункции

// Изменяет элементы формы документа "Заявка на командировку".
//
// Параметры:
//  Форма	 - УправляемаяФорма	 - форма.
//
Функция ИзменитьЭлементы_ЗаявкаНаКомандировку_ФормаДокумента(Форма) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	
	ПолеПроектнаяЗадача = ЭлементыФормы.Добавить("упоПроектнаяЗадача", Тип("ПолеФормы"), ЭлементыФормы.ГруппаЛево);
	ПолеПроектнаяЗадача.ПутьКДанным = "Объект.упоПроектнаяЗадача";
	ПолеПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПроектнаяЗадача.Ширина = 28;
	
	ПолеПроект = ЭлементыФормы.Добавить("упоПроект", Тип("ПолеФормы"), ЭлементыФормы.ГруппаПраво);
	ПолеПроект.ПутьКДанным = "Объект.упоПроектнаяЗадача.упоКорневойПроект";
	ПолеПроект.Заголовок = НСтр("ru = 'Проект'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	ПолеПроект.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеПроект.Гиперссылка = Истина;
	ПолеПроект.Ширина = 33;
	
КонецФункции

#КонецОбласти

#Область ЭтапыОплаты

Процедура ЭтапыОплатыКлиентом_ПриСозданииНаСервере(Форма) Экспорт
	
	Если НЕ (Форма.Параметры.Свойство("Ключ") И ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.ЗаказКлиента")) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапыОплатыДобавитьКнопку(Форма);
	
КонецПроцедуры

Процедура ЭтапыОплатыКлиентом_ЗаполнитьПоДаннымPMСервер(ПараметрыОбработки) Экспорт
	
	ВидыПлатежейPM = Перечисления.упоВидыПлатежей;
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM_2_5() Тогда
		ВидыПлатежейERP = Перечисления["ВариантыКонтроляОплатыКлиентом"];
	Иначе
		ВидыПлатежейERP = Перечисления["ВариантыОплатыКлиентом"];
	КонецЕсли;
	
	СоответствиеВидов = Новый Соответствие;
	СоответствиеВидов.Вставить(ВидыПлатежейPM.Аванс, ВидыПлатежейERP.АвансДоОбеспечения);
	СоответствиеВидов.Вставить(ВидыПлатежейPM.Оплата, ВидыПлатежейERP.ПредоплатаДоОтгрузки);
	СоответствиеВидов.Вставить(ВидыПлатежейPM.Расчет, ВидыПлатежейERP.КредитПослеОтгрузки);
	
	ЗаполнитьЭтапыОплатыПоДаннымPM(ПараметрыОбработки,
		Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление,
		СоответствиеВидов);
	
КонецПроцедуры

Процедура ЭтапыОплатыПоставщику_ПриСозданииНаСервере(Форма) Экспорт
	
	Если НЕ (Форма.Параметры.Свойство("Ключ") И ТипЗнч(Форма.Параметры.Ключ) = Тип("ДокументСсылка.ЗаказПоставщику")) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтапыОплатыДобавитьКнопку(Форма);
	
КонецПроцедуры

Процедура ЭтапыОплатыПоставщику_ЗаполнитьПоДаннымPMСервер(ПараметрыОбработки) Экспорт
	
	ВидыПлатежейPM = Перечисления.упоВидыПлатежей;
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM_2_5() Тогда
		ВидыПлатежейERP = Перечисления["ВариантыКонтроляОплатыПоставщику"];
	Иначе
		ВидыПлатежейERP = Перечисления["ВариантыОплатыПоставщику"];
	КонецЕсли;
	
	СоответствиеВидов = Новый Соответствие;
	СоответствиеВидов.Вставить(ВидыПлатежейPM.Аванс, ВидыПлатежейERP.ПредоплатаДоПоступления);
	СоответствиеВидов.Вставить(ВидыПлатежейPM.Оплата, ВидыПлатежейERP.КредитПослеПоступления);
	СоответствиеВидов.Вставить(ВидыПлатежейPM.Расчет, ВидыПлатежейERP.КредитСдвиг);
	
	ЗаполнитьЭтапыОплатыПоДаннымPM(ПараметрыОбработки,
		Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата,
		СоответствиеВидов);
	
КонецПроцедуры

