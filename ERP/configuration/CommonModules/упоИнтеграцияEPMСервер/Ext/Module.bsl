#Область ПрограммныйИнтерфейс

#Область ОбработчикиПодписок

// Трансляция плана доходов и расходов в обороты бюджетов.
//
// Параметры:
//  Источник		 - Произвольный	 - источник события.
//  Отказ			 - Булево 	 - признак отказа от выполнения обработки.
//  РежимПроведения	 - РежимПроведенияДокумента	 - режим проведения.
//
Процедура упоТрансляцияПланаДоходаРасходовВОборотыБюджетов(Источник, Отказ, РежимПроведения) Экспорт
	
КонецПроцедуры

// Обработчик события "Перед записью" справочника "Номенклатура"
//
// Параметры:
//  Источник - СправочникОбъект.Номенклатура - элемент справочника номенклатура, который нужно отработать.
//  Отказ	 - Булево						 - флаг отказа от проведения документа.
//
Процедура упоНоменклатураПередЗаписью(Источник, Отказ) Экспорт
	
	Если НЕ Источник.ЭтоГруппа Тогда
		Источник.упоВидРесурса = Перечисления.упоВидРесурса.Материальный;
		Источник.упоВидМатериальногоРесурса = Перечисления.упоВидМатериальногоРесурса.Материал;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события обработка проведения.
//
// Параметры:
//  Источник		 - Произвольный				 - источник события.
//  Отказ			 - Булево 	 				 - признак отказа от выполнения обработки.
//  РежимПроведения	 - РежимПроведенияДокумента	 - режим проведения.
//
Процедура ОтражениеПервичныхДокументовERP_ОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
	ЭтоDev2 = упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2();
	
	Если Отказ
		Или (Не ЭтоEPM И Не ЭтоDev2) Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоEPM_2_5 = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM_2_5(ЭтоEPM);
	
	ОтражатьДоходы = Ложь;
	ОтражатьРасходы = Ложь;
	ОтражатьДДС = Ложь;
	
	упоОтражатьФактДоходовПервичнымиДокументами = ИспользуетсяОтражениеФактаДоходовПервичнымиДокументами();
	упоОтражатьФактРасходовПервичнымиДокументами = ИспользуетсяОтражениеФактаРасходовПервичнымиДокументами();
	упоОтражатьФактДДСПервичнымиДокументами = ИспользуетсяОтражениеФактаДДСПервичнымиДокументами();
	
	ЗапросБДР = Новый Запрос;
	ЗапросДДС = Новый Запрос;
	ЗапросПринятныеОбъемы = Новый Запрос;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.АктВыполненныхРабот") Тогда
		
		ОтражатьДоходы = Истина;
		ЗапросБДР.Текст = ТекстЗапросаФактическиеДвиженияБДР_АктВыполненныхРабот();
		УстановитьПараметрыЗапросаФактическиеДвиженияБДР_АктВыполненныхРабот(ЗапросБДР,
			Источник.Ссылка);
		
		ЗапросПринятныеОбъемы.Текст = ТекстЗапросаПринятыеОбъемы_АктВыполненныхРабот();
		УстановитьПараметрыЗапросаПринятыеОбъемы_АктВыполненныхРабот(ЗапросПринятныеОбъемы,
			Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеБезналичныхДенежныхСредств")
		И Источник.ПроведеноБанком Тогда
		
		ОтражатьДДС = Истина;
		ЗапросДДС.Текст = ТекстЗапросаФактическиеДвиженияДСПоступлениеБезналичных(ЭтоEPM_2_5);
		УстановитьПараметрыЗапросаФактическиеДвиженияДС_ПоступлениеБезналичных(ЗапросДДС,
			Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
		
		ОтражатьРасходы = Истина;
		ЗапросБДР.Текст = ТекстЗапросаФактическиеДвиженияБДР_ПриобретениеТоваровУслуг();
		УстановитьПараметрыЗапросаФактическиеДвиженияБДР_ПриобретениеТоваровУслуг(ЗапросБДР,
			Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") Тогда
		
		ОтражатьДДС = Истина;
		ЗапросДДС.Текст = ТекстЗапросаФактическиеДвиженияДСПриходныйКО(ЭтоEPM_2_5);
		УстановитьПараметрыЗапросаФактическиеДвиженияДС_ПриходныйКО(ЗапросДДС, Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") Тогда
		
		ОтражатьДДС = Истина;
		ДанныеВШапкеДокумента = ИспользоватьДанныеШапкиФинансовогоДокумента(Источник);
		ЗапросДДС.Текст = ТекстЗапросаФактическиеДвиженияДСРасходныйКО(ЭтоEPM_2_5, ДанныеВШапкеДокумента);
		УстановитьПараметрыЗапросаФактическиеДвиженияДС_РасходныйКО(ЗапросДДС, Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		ОтражатьДоходы = Истина;
		ЗапросБДР.Текст = ТекстЗапросаФактическиеДвиженияБДР_РеализацияТоваровУслуг();
		УстановитьПараметрыЗапросаФактическиеДвиженияБДР_РеализацияТоваровУслуг(ЗапросБДР,
			Источник.Ссылка);
		
		ЗапросПринятныеОбъемы.Текст = ТекстЗапросаПринятыеОбъемы_РеализацияТоваровУслуг();
		УстановитьПараметрыЗапросаПринятыеОбъемы_РеализацияТоваровУслуг(ЗапросПринятныеОбъемы,
			Источник.Ссылка);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.СписаниеБезналичныхДенежныхСредств")
		И Источник.ПроведеноБанком Тогда
		
		ОтражатьДДС = Истина;
		ДанныеВШапкеДокумента = ИспользоватьДанныеШапкиФинансовогоДокумента(Источник);
		ЗапросДДС.Текст = ТекстЗапросаФактическиеДвиженияДССписаниеБезналичных(ЭтоEPM_2_5, ДанныеВШапкеДокумента);
		УстановитьПараметрыЗапросаФактическиеДвиженияДС_СписаниеБезналичных(ЗапросДДС,
			Источник.Ссылка);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОчиститьРегистрФактДоходовИРасходов  = Ложь;
		
	Если (ОтражатьДоходы И упоОтражатьФактДоходовПервичнымиДокументами)
		Или (ОтражатьРасходы И упоОтражатьФактРасходовПервичнымиДокументами) Тогда
		
		РезультатЗапроса = ЗапросБДР.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			ОчиститьРегистрФактДоходовИРасходов = Истина;
		Иначе
			тзРезультат = РезультатЗапроса.Выгрузить();
			
			СтрокиКЗаполнениюСуммыУпрУчета = СтрокиКЗаполнениюСуммыУправленческогоУчета(тзРезультат);
			
			упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(СтрокиКЗаполнениюСуммыУпрУчета);
			
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СтрокиКЗаполнениюСуммыУпрУчета, тзРезультат);
			
			//упоФактДоходовИРасходовОбороты
			ДвиженияФактБДР = Источник.Движения.упоФактДоходовИРасходовОбороты;
			ДвиженияФактБДР.Записывать = Истина;
			ДвиженияФактБДР.Загрузить(тзРезультат);
			
			тзРезультат.Свернуть("Период, ПроектнаяЗадача, Статья, ВидЭлемента, Контрагент, Договор, ДатаНачисления, Валюта",
				"Сумма, СуммаВалютная");
			
			// упоФактДоходовИРасходовПоДням
			ДвиженияФакт = Источник.Движения.упоФактДоходовИРасходовПоДням;
			ДвиженияФакт.Записывать = Истина;
			ДвиженияФакт.Загрузить(тзРезультат);
		КонецЕсли;
	КонецЕсли;
	
	Если (ОтражатьДоходы И Не упоОтражатьФактДоходовПервичнымиДокументами)
		Или (ОтражатьРасходы И Не упоОтражатьФактРасходовПервичнымиДокументами) 
		Или ОчиститьРегистрФактДоходовИРасходов Тогда
		упоПроведениеДокументовСервер.ОчиститьНаборЗаписей("РегистрНакопления", "упоФактДоходовИРасходовОбороты", 
			Источник.Ссылка); 
		упоПроведениеДокументовСервер.ОчиститьНаборЗаписей("РегистрСведений", "упоФактДоходовИРасходовПоДням", 
			Источник.Ссылка);	
	КонецЕсли;

	Если ОтражатьДДС Тогда
		
		ОчиститьРегистрФактДДС = Истина;
		
		Если упоОтражатьФактДДСПервичнымиДокументами Тогда
			РезультатЗапроса = ЗапросДДС.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				тзРезультат = РезультатЗапроса.Выгрузить();
				
				тзРезультат.Свернуть("Период, ПроектнаяЗадача, СтатьяДДС, НаправлениеДвижения, Контрагент, Договор, ДатаДвижения,
				|Валюта, ДатаПлатежногоДокумента, НомерПлатежногоДокумента, КомментарийДвижения", "Сумма, СуммаВалютная");
				
				СтрокиКЗаполнениюСуммыУпрУчета = СтрокиКЗаполнениюСуммыУправленческогоУчета(тзРезультат);
				
				упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(СтрокиКЗаполнениюСуммыУпрУчета);
				
				ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СтрокиКЗаполнениюСуммыУпрУчета, тзРезультат);
				
				ДвиженияФакт = Источник.Движения.упоФактДвиженийДенежныхСредств;
				ДвиженияФакт.Записывать = Истина;
				ДвиженияФакт.Загрузить(тзРезультат);
				
				ОчиститьРегистрФактДДС = Ложь;			
			КонецЕсли;
		КонецЕсли;
		
		Если ОчиститьРегистрФактДДС Тогда 
			упоПроведениеДокументовСервер.ОчиститьНаборЗаписей("РегистрСведений", "упоФактДвиженийДенежныхСредств", 
				Источник.Ссылка);				
		КонецЕсли;
	КонецЕсли;
	
	Если ОтражатьДоходы Тогда
		
		ОчиститьВыполненныеПринятыеОбъемы = Истина;
				
		Если упоОтражатьФактДоходовПервичнымиДокументами Тогда
			РезультатЗапроса = ЗапросПринятныеОбъемы.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				тзРезультат = РезультатЗапроса.Выгрузить();
				
				СтрокиКЗаполнениюСуммыУпрУчета = СтрокиКЗаполнениюСуммыУправленческогоУчета(тзРезультат);
				
				упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(СтрокиКЗаполнениюСуммыУпрУчета);
				
				ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СтрокиКЗаполнениюСуммыУпрУчета, тзРезультат);
				
				// РН. Выполненные и принятые объемы (Остатки)
				ДвиженияОбъемы = Источник.Движения.упоВыполненныеПринятыеОбъемы;
				ДвиженияОбъемы.Записывать = Истина;
				ДвиженияОбъемы.Загрузить(тзРезультат);
				
				ОчиститьВыполненныеПринятыеОбъемы = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если ОчиститьВыполненныеПринятыеОбъемы Тогда 
			упоПроведениеДокументовСервер.ОчиститьНаборЗаписей("РегистрНакопления", "упоВыполненныеПринятыеОбъемы", 
				Источник.Ссылка); 
		КонецЕсли; 
	КонецЕсли; 

КонецПроцедуры

// Обработчик события обработка заполнения.
//
// Параметры:
//  Источник				 - Произвольный	- источник события.
//  ДанныеЗаполнения 		 - Произвольный - данные заполнения.
//  ТекстЗаполнения	 		 - Строка	    - Текст, используемый для заполнения документа.
//  СтандартнаяОбработка	 - Булево	    - Признак стандартной обработки события.
//
Процедура упоОбработкаЗаполненияДокументовERPОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения,
		СтандартнаяОбработка) Экспорт
	
	ОбработкаЗаполнения(ДанныеЗаполнения, Источник);
	
КонецПроцедуры

// Обработчик события обработка проведения.
//
// Параметры:
//  Источник  - ДокументОбъект - документ ERP.
//  Отказ  - Булево - флаг отказа.
//  РежимПроведения  - РежимПроведенияДокумента - режим проведения документа.
//
Процедура упоОбработкаПроведенияДокументовERP(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда Возврат КонецЕсли;
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств") Тогда
		ОбработкаПроведения_ЗаявкаНаРасходованиеДенежныхСредств(Источник, РежимПроведения)
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") Тогда
		ОбработкаПроведения_СписаниеБезналичныхДенежныхСредств(Источник, РежимПроведения)
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ОбработкаПроведения_РасходныйКассовыйОрдер(Источник, РежимПроведения)
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПрочиеДоходыРасходы") Тогда
		ОбработкаПроведения_ПрочиеДоходыРасходы(Источник, Отказ, РежимПроведения);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события обработка удаления проведения.
//
// Параметры:
//  Источник  - ДокументОбъект - документ ERP.
//  Отказ  - Булево - флаг отказа.
//
Процедура упоОбработкаУдаленияПроведенияДокументовERP(Источник, Отказ) Экспорт
	// Вставить содержимое обработчика.
КонецПроцедуры

// Обработчик события обработка удаления проведения.
//
// Параметры:
//  Источник			 - ДокументОбъект	 - документ ERP.
//  Отказ				 - Булево			 - флаг отказа.
//  ПроверяемыеРеквизиты - Массив
//
Процедура упоОбработкаПроверкиЗаполненияДокументовERPОбработкаПроверкиЗаполнения(Источник, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаказНаПроизводство2_2") Тогда
		
		Если ЗначениеЗаполнено(Источник.ДатаПотребности) И ЗначениеЗаполнено(Источник.НачатьНеРанее)
			И Источник.ДатаПотребности < Источник.НачатьНеРанее Тогда
			
			ТекстОшибки = НСтр("ru = 'Желаемая дата выпуска меньше даты начала производства';
					|en = 'Желаемая дата выпуска меньше даты начала производства'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки, ,
				"ДатаПотребности",
				"Объект",
				Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОсновныеФункцииДвиженийДляДокументовERP

// Отражает фактические движения БДР в регистрах.
//
// Параметры:
//  ДополнительныеСвойства	 - Структура	 	 - структура доп. свойств.
//  Движения				 - КоллекцияДвижений - движения.
//  Отказ					 - Булево	 	 	 - признак отказа от отражения движений.
//
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
Функция ОтразитьФактическиеДвиженияБДР(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ВхТаблицаДвиженияФактБДР = ДополнительныеСвойства.ТаблицыДляДвижений.упоТаблицаДвиженияФактБДР;
	ТаблицаДвиженияФактБДР = ВхТаблицаДвиженияФактБДР.Скопировать();
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвиженияФактБДР);
	
	ДвиженияФактБДР = Движения.упоФактДоходовИРасходовОбороты;
	ДвиженияФактБДР.Записывать = Истина;
	ДвиженияФактБДР.Загрузить(ТаблицаДвиженияФактБДР);
	
	ТаблицаДвиженияФактБДР.Свернуть("Период, ПроектнаяЗадача, Статья, ВидЭлемента, Контрагент, Договор, ДатаНачисления, Валюта", "Сумма, СуммаВалютная");
	
	ДвиженияФактБДР = Движения.упоФактДоходовИРасходовПоДням;
	ДвиженияФактБДР.Записывать = Истина;
	ДвиженияФактБДР.Загрузить(ТаблицаДвиженияФактБДР);
	
КонецФункции

// Процедура формирования движений по регистру "Фактические движения денежных средств".
//
// Параметры:
//  ДополнительныеСвойства	 - Структура - дополнительные свойства объекта при проведении.
//  Движения				 - Движения	 - набор движений документа.
//  Отказ					 - Булево	 - Признак отказа от проведения документа.
//
Процедура ОтразитьФактическиеДвиженияДенежныхСредств(ДополнительныеСвойства, Движения, Отказ) Экспорт
	
	Если Отказ Тогда
		
		Возврат;
		
	КонецЕсли;
	
	вхТаблицаДенежныеСредства = ДополнительныеСвойства.ТаблицыДляДвижений.упоТаблицаФактическиеДвиженияДенежныхСредств;
	
	ТаблицаДенежныеСредства = вхТаблицаДенежныеСредства.Скопировать();
	ТаблицаДенежныеСредства.Свернуть("Период, ПроектнаяЗадача, СтатьяДДС, НаправлениеДвижения, Контрагент, Договор, ДатаДвижения, Валюта",
		"Сумма, СуммаВалютная");
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДенежныеСредства);
	
	ДвиженияДенежныеСредства = Движения.упоФактДвиженийДенежныхСредств;
	ДвиженияДенежныеСредства.Записывать = Истина;
	ДвиженияДенежныеСредства.Загрузить(ТаблицаДенежныеСредства);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеСтатейДДС

// Заполнить направление движения статей ДДС
//
// Параметры:
//  НачальноеЗаполнение	 - Булево	 - признак начального заполнения базы.
//
Процедура ЗаполнитьНаправлениеДвиженияСтатейДДС(НачальноеЗаполнение = Ложь) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		Возврат;
	КонецЕсли;
	
	Выплата = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата;
	Поступление = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление;
	
	СтатьиДДС = Справочники.СтатьиДвиженияДенежныхСредств;
	
	СоответствиеСтатьиИНаправленияДвижения = Новый Соответствие;
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ВозвратДенежныхСредствОтДругойОрганизации"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ВозвратДенежныхСредствОтПоставщика"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ВозвратОплатыКлиенту"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ВыдачаДенежныхСредствВДругуюКассу"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ВыдачаДенежныхСредствВКассуККМ"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ВыплатаЗаработнойПлаты"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["КурсовыеРазницыПрибыль"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["КурсовыеРазницыУбыток"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ОплатаДенежныхСредствВДругуюОрганизацию"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ОплатаПоставщику"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ПеречислениеДенежныхСредствНаДругойСчет"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ПоступлениеДенежныхСредствИзБанка"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ПоступлениеДенежныхСредствИзБанкаВИностраннойВалюте"],
		Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ПоступлениеДенежныхСредствИзКассыККМ"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ПоступлениеДенежныхСредствОтДругойОрганизации"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["ПоступлениеОплатыОтКлиента"], Поступление);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["СдачаДенежныхСредствВБанк"], Выплата);
	СоответствиеСтатьиИНаправленияДвижения.Вставить(СтатьиДДС["СдачаДенежныхСредствВБанкВИностраннойВалюте"], Выплата);
	
	Для Каждого Элемент Из СоответствиеСтатьиИНаправленияДвижения Цикл
		
		Если Не НачальноеЗаполнение И ЗначениеЗаполнено(Элемент.Ключ.упоНаправлениеДвижения) Тогда
			Продолжить;
		КонецЕсли;
		
		СтатьяДДСОбъект = Элемент.Ключ.ПолучитьОбъект();
		СтатьяДДСОбъект.упоНаправлениеДвижения = Элемент.Значение;
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(СтатьяДДСОбъект);
		Исключение
			ТекстСообщения = СтрШаблон(
					НСтр("ru = 'Справочник %1 не записан, произошли ошибки при записи!';
						|en = 'The %1 catalog was not saved. Errors occurred during saving.'",
						ОбщегоНазначения.КодОсновногоЯзыка()), СтатьяДДСОбъект);
			ОписаниеОшибки = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки.Описание);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// Проверяет использование подсистемы "Распределение зарплаты".
//
// Возвращаемое значение:
//  Булево - результат проверки.
//
Функция ИспользоватьПодсистемуРаспределениеЗарплаты() Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияЗарплатыПоПроектам() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоРаспределениеЗарплатыПоПроектам") Тогда
		МодульРаспределениеЗарплатыНастройки = ОбщегоНазначения.ОбщийМодуль("упоРаспределениеЗарплатыНастройкиСервер");
		Результат = МодульРаспределениеЗарплатыНастройки.ИспользоватьПодсистему();
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Заполняет реквизит "Проектная задача" в табличной части документа "Заявка на расходование денежных средств".
//
// Параметры:
//  КоллекцияФормы	 - ДанныеФормыКоллекция - Данные формы табличной части РасшифровкаПлатежа.
//
Процедура ЗаполнитьПроектныеЗадачиВТЧЗаявкиНаРасходованияДС(КоллекцияФормы) Экспорт
	
	МассивОбъектов = Новый Массив;
	СоответствиеСтрокОбъектов = Новый Соответствие;
	Для Каждого СтрокаДанных Из КоллекцияФормы Цикл
		МассивОбъектов.Добавить(СтрокаДанных.ОбъектРасчетов);
		СоответствиеСтрокОбъектов.Вставить(СтрокаДанных.ОбъектРасчетов, СтрокаДанных);
	КонецЦикла;
	
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыРасчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивОбъектов, "Объект", Истина);
	
    ТекстЗапроса = ТекстЗапросаПроектныхЗадачТабличнойЧасти(ОбъектыРасчетов);
	Если ТекстЗапроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаОбработки = СоответствиеСтрокОбъектов.Получить(Выборка.ОбъектРасчетов);
		СтрокаОбработки.упоПроектнаяЗадача = Выборка.упоПроектнаяЗадача;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

