// Изменить элементы договоры контрагентов форма документа добавить статус.
//
// Параметры:
//  ЭтаФорма - 	 -
// Возвращаемое значение:
//  Непределено - не возвращает значение.
Функция ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаДокумента_ДобавитьСтатус(ЭтаФорма, ГруппаФормы, ПодключитьОбработчикПриИзменении = Истина) Экспорт
	
	Если ГруппаФормы = Неопределено Тогда
		ГруппаФормы = ЭтаФорма;
	КонецЕсли;
	
	ЭлементСтатусДоговора = ЭтаФорма.Элементы.Добавить("упоСтатусДоговора", Тип("ПолеФормы"), ГруппаФормы);
	ЭлементСтатусДоговора.ПутьКДанным = "Объект.упоСтатусДоговора";
	ЭлементСтатусДоговора.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСтатусДоговора.Ширина = 20;
	ЭлементСтатусДоговора.РастягиватьПоГоризонтали = Ложь;
	ЭлементСтатусДоговора.РедактированиеТекста = Ложь;
	
	Если ПодключитьОбработчикПриИзменении Тогда
		ЭлементСтатусДоговора.УстановитьДействие("ПриИзменении", "Подключаемый_упоСтатусДоговораПриИзменении");
	КонецЕсли;
	
	МассивСтатусов = упоИнтеграцияEPMСервер.ПолучитьМассивСтатусовДоговоров();
	ЭлементСтатусДоговора.СписокВыбора.ЗагрузитьЗначения(МассивСтатусов);
	ЭлементСтатусДоговора.РежимВыбораИзСписка = Истина;
	
КонецФункции

// Возвращает массив доступных для договоров статусов
//
// Возвращаемое значение:
//  Массив - Массив статусов договоров.
//
Функция ПолучитьМассивСтатусовДоговоров() Экспорт
	
	Список = Новый Массив;
	Список.Добавить(Справочники.упоСтатусыОбъектов.Запланирован);
	Список.Добавить(Справочники.упоСтатусыОбъектов.НаСогласовании);
	Список.Добавить(Справочники.упоСтатусыОбъектов.Подписан);
	Список.Добавить(Справочники.упоСтатусыОбъектов.Выполняется);
	Список.Добавить(Справочники.упоСтатусыОбъектов.Приостановлен);
	Список.Добавить(Справочники.упоСтатусыОбъектов.Закрыт);
	
	Возврат Список;
	
КонецФункции

