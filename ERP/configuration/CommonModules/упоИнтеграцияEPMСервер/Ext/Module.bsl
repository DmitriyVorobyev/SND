	Элемент_упоПроектнаяЗадача.ПутьКДанным = "Объект.РасшифровкаПлатежа.упоПроектнаяЗадача";
	
	Элемент_упоПроект = ЭтаФорма.Элементы.Добавить("упоПроект", Тип("ПолеФормы"), ЭтаФорма.Элементы.РасшифровкаБезРазбиения);
