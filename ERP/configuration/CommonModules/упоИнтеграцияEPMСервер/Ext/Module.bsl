#Область УправлениеДоговорами

Функция СтатусERPПоСтатусуPM(СтатусДоговораPM) Экспорт
	
	
	СоответствиеСтатусов = Новый Соответствие();
	СоответствиеСтатусов.Вставить(ПредопределенноеЗначение("Справочник.упоСтатусыОбъектов.НаСогласовании"),
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.НеСогласован"));
	СоответствиеСтатусов.Вставить(ПредопределенноеЗначение("Справочник.упоСтатусыОбъектов.Выполняется"),
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.Действует"));
	СоответствиеСтатусов.Вставить(ПредопределенноеЗначение("Справочник.упоСтатусыОбъектов.Закрыт"),
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.Закрыт"));
	СоответствиеСтатусов.Вставить(ПредопределенноеЗначение("Справочник.упоСтатусыОбъектов.Запланирован"),
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.НеСогласован"));
	СоответствиеСтатусов.Вставить(ПредопределенноеЗначение("Справочник.упоСтатусыОбъектов.Подписан"),
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.Действует"));
	СоответствиеСтатусов.Вставить(ПредопределенноеЗначение("Справочник.упоСтатусыОбъектов.Приостановлен"),
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.СтатусыДоговоровКонтрагентов.Действует"));
	
	Возврат СоответствиеСтатусов.Получить(СтатусДоговораPM);
	
КонецФункции

