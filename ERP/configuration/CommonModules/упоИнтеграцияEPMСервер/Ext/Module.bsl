Функция СтрокиКЗаполнениюСуммыУправленческогоУчета(ТаблицаИсточник)
	
	Строки = ТаблицаИсточник.СкопироватьКолонки();
	
	// Удалим строки с отсутствующей суммой упр. учета.
	СтрокиКУдалениюВИсточнике = Новый Массив;
	Для каждого СтрокаИсточник Из ТаблицаИсточник Цикл
		Если СтрокаИсточник.Сумма = 0 Тогда
			НоваяСтрока = Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсточник);
			СтрокиКУдалениюВИсточнике.Добавить(СтрокаИсточник);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого Строка Из СтрокиКУдалениюВИсточнике Цикл
		ТаблицаИсточник.Удалить(Строка);
	КонецЦикла;
		
	Возврат Строки;
	
КонецФункции

