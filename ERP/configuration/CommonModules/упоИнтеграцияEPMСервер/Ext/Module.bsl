			ТипКнопкаФормы,
			ЭтаФорма.Элементы.ТоварыЗаполнить);
	Элемент_упоПроектнаяЗадача.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	Элемент_упоПроектнаяЗадача.ИмяКоманды = "упоТоварыЗаполнитьПроектныеЗадачи";
	
	Элемент_упоПроектнаяЗадача = ЭтаФорма.Элементы.Добавить("ТоварыупоПроектнаяЗадача",
			ТипПолеФормы,
			ЭтаФорма.Элементы.Товары);
	Элемент_упоПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	Элемент_упоПроектнаяЗадача.КнопкаВыбора = Истина;
	Элемент_упоПроектнаяЗадача.ПутьКДанным = "Объект.Товары.упоПроектнаяЗадача";
	
	Элемент_упоПроектнаяЗадача = ЭтаФорма.Элементы.Добавить("ТоварыупоПроект",
			ТипПолеФормы,
			ЭтаФорма.Элементы.Товары);
	Элемент_упоПроектнаяЗадача.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент_упоПроектнаяЗадача.ПутьКДанным = "Объект.Товары.упоПроектнаяЗадача.упоКорневойПроект";
	Элемент_упоПроектнаяЗадача.Заголовок = НСтр("ru = 'Проект'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	Элемент_упоПроектнаяЗадача = ЭтаФорма.Элементы.Добавить("ТоварыупоПодразделение",
			ТипПолеФормы,
			ЭтаФорма.Элементы.Товары);
	Элемент_упоПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	Элемент_упоПроектнаяЗадача.ПутьКДанным = "Объект.Товары.упоПодразделение";
	
	Элемент_упоПроектнаяЗадача = ЭтаФорма.Элементы.Добавить("ТоварыупоРоль",
			ТипПолеФормы,
			ЭтаФорма.Элементы.Товары);
	Элемент_упоПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	Элемент_упоПроектнаяЗадача.ПутьКДанным = "Объект.Товары.упоРоль";
	
КонецФункции

// Изменяет элементы формы документа "Заказ клиента", "Заказ на производство" и "Заказ поставщику".
//
// Параметры:
//  Форма	 - УправляемаяФорма	 - форма.
//
// Возвращаемое значение:
//  Непределено - не возвращает значение.
Функция ИзменитьЭлементы_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику_ФормаДокумента(Форма) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	
	ДобавитьЭлементПроектВШапку_ЗаказКлиентаЗаказНаПроизводствоИЗаказПоставщику(ЭлементыФормы);
	
	Если ТипЗнч(Форма.Объект.Ссылка) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		
		ГруппаТоварыЗаполнить = ЭлементыФормы.Найти("ГруппаТоварыЗаполнить");
		ТоварыПодобратьНоменклатуру = ЭлементыФормы.Найти("ТоварыПодобратьНоменклатуру");
		
		Если ГруппаТоварыЗаполнить <> Неопределено Тогда
			упоКоманда = Форма.Команды.Добавить("упоКомандаЗаполнитьНазначениеПоНД");
			упоКоманда.Заголовок = НСтр("ru = 'Заполнить назначение по НД'");
			упоКоманда.Действие = "Подключаемый_упоКомандаЗаполнитьНазначениеПоНД";
			упоКоманда.Подсказка = НСтр("ru = 'Заполнить назначение по направлению деятельности'");
			упоГруппа = Форма.Элементы.Вставить(упоКоманда.Имя + "Группа", Тип("ГруппаФормы"), 
				ГруппаТоварыЗаполнить, ТоварыПодобратьНоменклатуру);
			упоГруппа.Вид = ВидГруппыФормы.ГруппаКнопок;
			упоЭлемент = Форма.Элементы.Добавить(упоКоманда.Имя, Тип("КнопкаФормы"), упоГруппа);
			упоЭлемент.ИмяКоманды = упоКоманда.Имя;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

