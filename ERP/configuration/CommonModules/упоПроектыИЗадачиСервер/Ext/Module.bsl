Функция ПолучитьТаблицуКСохранению(СписокОбъектов, Проект, Пользователь, ЭтоСправочники = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Проекты.Ссылка КАК ПроектнаяЗадача
		|ИЗ
		|	Справочник.Проекты КАК Проекты
		|ГДЕ
		|	Проекты.СсылкаНаПроектнуюЗадачу В(&СписокОбъектов)";
	
	Если ЭтоСправочники Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Проекты.СсылкаНаПроектнуюЗадачу В(&СписокОбъектов)", "Проекты.Ссылка В(&СписокОбъектов)"); 	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("СписокОбъектов", СписокОбъектов);
	Результат = Запрос.Выполнить();
	
	ТаблицаДляВозврата = Результат.Выгрузить();  
	
	Если ТаблицаДляВозврата.Найти(Проект, "ПроектнаяЗадача") = Неопределено Тогда
		ТаблицаДляВозврата.Добавить().ПроектнаяЗадача = Проект;	
	КонецЕсли;
	
	ТаблицаДляВозврата.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ТаблицаДляВозврата.Колонки.Добавить("Проект", Новый ОписаниеТипов("СправочникСсылка.Проекты"));
	
	ТаблицаДляВозврата.ЗаполнитьЗначения(Проект, "Проект");
	ТаблицаДляВозврата.ЗаполнитьЗначения(Пользователь, "Пользователь");
	
	Возврат ТаблицаДляВозврата;
	
КонецФункции

Процедура ДобавитьОшибку(Таблица, Объект = Неопределено, ОбъектПредставление = Неопределено, 
	ТекстОшибки = "Нет текста.")
	
	НоваяСтрока = Таблица.Добавить();
