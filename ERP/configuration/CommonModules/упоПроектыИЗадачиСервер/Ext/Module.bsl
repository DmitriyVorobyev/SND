	НоваяСтрока.ЭлементПроектаПредставление = Объект;
	НоваяСтрока.ТекстОшибки = ТекстОшибки;
	
КонецПроцедуры

// Процедура (рекурсивная) обрабатывает Соответствие, в котором каждому элементу соотнесены
// подчинненные элементы. Процедура устраняет из подчиненных элементов элементы Родители.
//
// Параметры:
//  Родители  	– Соответствие, содержит родителей и их подчиненных элементов:
//					Ключ		- Любая ссылка, элемент проекта, у которого если подчиненные элементы.
//					Значение	- Соответствие, подчиненные по иерархии элементы.
//  Родитель  	– Любая ссылка, элемент проекта, который обрабатывается на данной итерации.
//  Дети  		– Соответствие, содержит подчиненные элементы для элемента "родитель".
//  ДетиУбраны  – Соответствие, хранит элементы проекта, которые уже были обработаны.
//
Процедура убратьРодителейИзДетей(Родители, Родитель, Дети, ДетиУбраны)
	
	Для каждого кизРебенок Из Дети Цикл
		ребенок = кизРебенок.Ключ;
		Если Не Родители[ребенок] = Неопределено Тогда
			Если ДетиУбраны[ребенок] = Неопределено Тогда
				убратьРодителейИзДетей(Родители, ребенок, Родители[ребенок], ДетиУбраны);
			КонецЕсли;
			Дети.Удалить(ребенок);
			Для каждого новыйРебенок Из Родители[ребенок] Цикл
			    Дети.Вставить(новыйРебенок.Ключ, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Родители.Вставить(Родитель, Дети);
	ДетиУбраны.Вставить(Родитель, Истина);
	
КонецПроцедуры

Процедура НайтиЦиклыРекурсивно(ТаблицаСвязей, СоответствиеПроверенныеЗадачи, МассивПроверяемыеЗадачи, Элемент, ИсточникСвязи, СтруктураДанныхЦикла)
	
	// Если нашли хоть один цикл, то дальнейшую проверку прекращаем.
	Если СтруктураДанныхЦикла.ЦиклЗаписан Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПроверенныеЗадачи.Вставить(Элемент, Истина);
	МассивПроверяемыеЗадачи.Добавить(Элемент);
	
	Отбор = Новый Структура("СвязанныйЭлемент", Элемент);
	НайденныеСтроки = ТаблицаСвязей.НайтиСтроки(Отбор);
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если СтруктураДанныхЦикла.НайденЦикл Тогда     
			Прервать;
		КонецЕсли;
		
		ПодчиненныйЭлемент = НайденнаяСтрока.ЭлементПроекта;
		Если НЕ ЗначениеЗаполнено(ПодчиненныйЭлемент) Тогда
			Продолжить;
		КонецЕсли;
				
		Если МассивПроверяемыеЗадачи.Найти(ПодчиненныйЭлемент) <> Неопределено Тогда  // Найден цикл.
			СтруктураДанныхЦикла.НайденЦикл = Истина;
			СтруктураДанныхЦикла.Элемент = ПодчиненныйЭлемент;  
			СтруктураДанныхЦикла.МассивЭлементовЦикла.Добавить(ПодчиненныйЭлемент);
			// Если это связь элемента-родителя, то добавим в элементы цикла и его.
			Если НайденнаяСтрока.ИсточникСвязи <> Неопределено Тогда
				СтруктураДанныхЦикла.МассивЭлементовЦикла.Добавить(НайденнаяСтрока.ИсточникСвязи);	
			КонецЕсли;
			Углубляемся = Ложь;
		Иначе
			ЭлементУжеПроверялся = СоответствиеПроверенныеЗадачи.Получить(ПодчиненныйЭлемент) <> Неопределено; 
			Углубляемся = НЕ ЭлементУжеПроверялся;
		КонецЕсли;
		
		Если Углубляемся Тогда 
			НайтиЦиклыРекурсивно(ТаблицаСвязей, СоответствиеПроверенныеЗадачи, МассивПроверяемыеЗадачи, ПодчиненныйЭлемент,
			НайденнаяСтрока.ИсточникСвязи, СтруктураДанныхЦикла);
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтруктураДанныхЦикла.НайденЦикл И НЕ СтруктураДанныхЦикла.ЦиклЗаписан Тогда
		Если Элемент = СтруктураДанныхЦикла.Элемент Тогда
			СтруктураДанныхЦикла.ЦиклЗаписан = Истина;
		Иначе
			СтруктураДанныхЦикла.МассивЭлементовЦикла.Добавить(Элемент);
			// Если это связь элемента-родителя, то добавим в элементы цикла и его.
			Если ИсточникСвязи <> Неопределено Тогда
				СтруктураДанныхЦикла.МассивЭлементовЦикла.Добавить(ИсточникСвязи);	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;		
	
	МассивПроверяемыеЗадачи.Удалить(МассивПроверяемыеЗадачи.Количество() - 1);
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаСсылкиНаЗадачу(ТекстЗапроса, ИмяДокумента, ИмяРегистра, ИмяИзмерения, ЭтоНачалоЗапроса)

	Если НЕ ЭтоНачалоЗапроса Тогда 		
		ТекстЗапроса = ТекстЗапроса + "
		|
		| ОБЪЕДИНИТЬ ВСЕ
		|";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + " 	
	 |ВЫБРАТЬ" + ?(ЭтоНачалоЗапроса, " РАЗРЕШЕННЫЕ", "") + "
	 |	" + ИмяРегистра + ".Регистратор
	 |" + ?(ЭтоНачалоЗапроса, "ПОМЕСТИТЬ втВсеДанные", "") + "
	 |ИЗ
	 |	РегистрСведений." + ИмяРегистра + " КАК " + ИмяРегистра + "
	 |ГДЕ
	 |	" + ИмяРегистра + "." + ИмяИзмерения + " В (&СписокЗадач)
	 |   И Регистратор ССЫЛКА Документ." + ИмяДокумента + "";     	

	Если ЭтоНачалоЗапроса Тогда
		ЭтоНачалоЗапроса = Ложь;
	КонецЕсли;	
	 
КонецПроцедуры

#Область ПодчиненныеЗадачи

Функция ТекстЗапросаПодчиненныеЗадачиНачало(Проект = Неопределено)
			
	ТекстНачало = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	         |	Проекты.Ссылка КАК Ребенок,
	         |	Проекты.Родитель КАК Родитель
	         |ПОМЕСТИТЬ Иерархия1
	         |ИЗ
	         |	Справочник.Проекты КАК Проекты
	         |ГДЕ
	         |	Проекты.упоКорневойПроект = &Проект
	         |	И НЕ Проекты.ПометкаУдаления
	         |	И Проекты.Родитель <> ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	         |
	         |ОБЪЕДИНИТЬ
	         |
	         |ВЫБРАТЬ
	         |	Проекты.Ссылка,
	         |	Проекты.Ссылка
	         |ИЗ
	         |	Справочник.Проекты КАК Проекты
	         |ГДЕ
	         |	Проекты.упоКорневойПроект = &Проект
	         |	И НЕ Проекты.ПометкаУдаления";
	
	Если Проект = Неопределено Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстНачало);
		
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Удалить(0);
		СхемаЗапроса.ПакетЗапросов[0].Операторы[1].Отбор.Удалить(0);
		
		ТекстНачало = СхемаЗапроса.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	Возврат ТекстНачало;
	
КонецФункции	

Функция ПакетСхемыЗапросаПоИмениВременнойТаблицы(ТекстЗапроса, ИмяВременнойТаблицы, ПолучитьТолькоИндекс = Ложь) 
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);

	Сч = 0;
	Для Каждого ПакетЗапроса Из СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(ПакетЗапроса) = Тип("ЗапросВыбораСхемыЗапроса") 
			И ПакетЗапроса.ТаблицаДляПомещения = ИмяВременнойТаблицы Тогда
			Если ПолучитьТолькоИндекс Тогда
				Возврат Сч;			
			Иначе
				Возврат ПакетЗапроса;
			КонецЕсли;	
		КонецЕсли;
		Сч = Сч + 1;
	КонецЦикла;	
	
	Возврат Неопределено;
	
КонецФункции	

#КонецОбласти

Функция ПолучитьСледующийИндексРаспределения(ПроектнаяЗадача, СоответствиеПоследнихИндексовРаспределения) 
	
	ТекущийИндекс = СоответствиеПоследнихИндексовРаспределения.Получить(ПроектнаяЗадача);
	
	Если ТекущийИндекс = Неопределено Тогда
		ТекущийИндекс = 1000;
	КонецЕсли;
	
	НовыйИндекс = ТекущийИндекс + 1;
	
	СоответствиеПоследнихИндексовРаспределения.Вставить(ПроектнаяЗадача, НовыйИндекс);
	
	Возврат НовыйИндекс;
	
КонецФункции

Функция ПолучитьТекстСоединенияДляФильтраПоОтмененнымЗадачам()
	
	Соединение = 
	"		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	|				,
	|				Версия В
	|					(ВЫБРАТЬ
	|						упоВерсииПроекта.Версия
	|					ИЗ
	|						РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|					ГДЕ
	|						упоВерсииПроекта.Проект = &Проект
	|						И упоВерсииПроекта.Текущая)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ПО (Док.Ссылка = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача)
	|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)";
		
	Возврат Соединение;
	
КонецФункции

Функция ТекстЗапросаКоэффициентыЕдиницИзмерения()
	
	ЕстьРеквизитыЧислительЗнаменатель = 
		упоИнтеграцияКлиентСервер.ЕстьРеквизитыЧислительЗнаменательВСправочникеУпаковки();				
	
	Текст = "ВЫБРАТЬ
	        |	упоЕдиницыВремени.Ссылка КАК Ссылка,
	        |	упоЕдиницыВремени.Коэффициент КАК Коэффициент
	        |ИЗ
	        |	Справочник.упоЕдиницыВремени КАК упоЕдиницыВремени
	        |ГДЕ
	        |	упоЕдиницыВремени.Ссылка В(&ЕдиницыНормирования)
	        |
	        |ОБЪЕДИНИТЬ ВСЕ
	        |
	        |ВЫБРАТЬ
	        |	УпаковкиЕдиницыИзмерения.Ссылка,
	        |	&РасчетКоэффициентаУпаковки
	        |ИЗ
	        |	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	        |ГДЕ
	        |	УпаковкиЕдиницыИзмерения.Ссылка В(&ЕдиницыНормирования)";
		
	Если ЕстьРеквизитыЧислительЗнаменатель Тогда
		Текст = СтрЗаменить(Текст, "&РасчетКоэффициентаУпаковки", 
				   "ВЫБОР
	               |	КОГДА УпаковкиЕдиницыИзмерения.Знаменатель = 0
	               |		ТОГДА 1
	               |	ИНАЧЕ УпаковкиЕдиницыИзмерения.Числитель / УпаковкиЕдиницыИзмерения.Знаменатель
	               |КОНЕЦ");			
	Иначе
		Текст = СтрЗаменить(Текст, "&РасчетКоэффициентаУпаковки", "1");
	КонецЕсли;	

	Возврат Текст;
	
КонецФункции

Процедура ЗаполнитьДокументСохраненияДанных(ДокСохраненияДанных, Проект, ПроектныеЗадачи)
	
	ДокСохраненияДанных.Проект = Проект;
	ДокСохраненияДанных.Дата = ТекущаяДатаСеанса();	
	текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);	
	ДанныеПоТекСвойствам = 
		ДокСохраненияДанных.СформироватьДанныеПоТекущимСвойстваПроектныхЗадач(текущаяВерсия, ПроектныеЗадачи);
		
	ТаблицаТекущиеСвойства = ДанныеПоТекСвойствам.ТаблицаТекущиеСвойства;	
		
	ТЧПроектныеЗадачи = ДокСохраненияДанных.ПроектныеЗадачи;
	Для Каждого ТекущиеСвойства Из ТаблицаТекущиеСвойства Цикл
		СтрокаТЧ = ТЧПроектныеЗадачи.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекущиеСвойства);
		СтрокаТЧ.ЗадачаОтменена = Истина;
	КонецЦикла;	
	
КонецПроцедуры

// Удаляет (помечает на удаление) заданный массив документов из БД.
// 
// Параметры:
//  МассивДокументов - Массив - список ссылок на документы.
// 
Процедура УдалитьДокументы(МассивДокументов)
		
	Для Каждого Документ Из МассивДокументов Цикл
		
		Объект = Документ.ПолучитьОбъект();
		Объект.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
		Объект.УстановитьПометкуУдаления(Истина);
		
	КонецЦикла;
		
КонецПроцедуры

// В зависимости от входящей структуры данных (Таблица значений или Соответствие) 
// значения могут находиться в полях строк с разным наименованием. 
// Метод унифицирует имена полей входящих данных для дальнейшей обработки.
//
Функция ИменаПолейСтрокиДанных(ТекущиеДанные)
	
	Результат = Новый Структура();
	Результат.Вставить("ДопПутьКДаннымСтроки", ""); // Имя дополнительного ключа при получении данных из структуры. 
	Результат.Вставить("ПолучатьПутьКДаннымСтроки", Ложь); // Признак получения данных из структуры.
	Результат.Вставить("ИмяПоляДатаНачала", "ДатаНачала");
	Результат.Вставить("ИмяПоляДатаЗавершения", "ДатаЗавершения");

	Если ТипЗнч(ТекущиеДанные) = Тип("Соответствие") Тогда
		
		Результат.ПолучатьПутьКДаннымСтроки = Истина;
		
		Для Каждого Строка Из ТекущиеДанные Цикл
			
			// Сроки могут лежать в промежуточной структуре с именем "Результат" 
			// или напрямую в соответствии в зависимости от вызывающего метода.
			Если Строка.Значение.Свойство("Результат") Тогда
				ДопПутьКДаннымСтроки = "Результат";
				ДанныеСроков = Строка.Значение.Результат;
			Иначе
				ДанныеСроков = Строка.Значение;
			КонецЕсли;
			
			Результат.ДопПутьКДаннымСтроки = ДопПутьКДаннымСтроки;
			
			Если ДанныеСроков.Свойство("ДатаНачалаПлан") Тогда
				Результат.ИмяПоляДатаНачала = "ДатаНачалаПлан";
			КонецЕсли;
			Если ДанныеСроков.Свойство("ДатаЗавершенияПлан") Тогда
				Результат.ИмяПоляДатаЗавершения = "ДатаЗавершенияПлан";
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтруктураСроковПроектнойЗадачи()
	
	СрокиЗадачи = Новый Структура;
	СрокиЗадачи.Вставить("КрайнийСрок");
	СрокиЗадачи.Вставить("ДатаНачалаПлан");
	СрокиЗадачи.Вставить("ДатаЗавершенияПлан");
	СрокиЗадачи.Вставить("ДатаРаннегоСтарта");
	СрокиЗадачи.Вставить("ДатаРаннегоФиниша");
	СрокиЗадачи.Вставить("ДатаПозднегоСтарта");
	СрокиЗадачи.Вставить("ДатаПозднегоФиниша");
	
	Возврат СрокиЗадачи;
	
КонецФункции

Функция СтатусыЗадачаЗакрыта()
	
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	
	Возврат Статусы;
	
КонецФункции

Функция ЭтоЗаписьНепроведенного(ДокументОбъект, РежимЗаписи)
	
	Возврат РежимЗаписи = РежимЗаписиДокумента.Запись
		И Не ДокументОбъект.Проведен;
	
КонецФункции

