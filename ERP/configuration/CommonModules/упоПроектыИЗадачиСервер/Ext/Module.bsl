Функция ПолучитьВсехДетейРодителей(пТаблицаЭлементов, Родитель, ДетиРодителей, ПустойРодитель = Неопределено, УдалятьРодителейИзДетей = Истина)
	Отбор = Новый Структура("ЭлементРодитель", Родитель);
	Элементы = пТаблицаЭлементов.НайтиСтроки(Отбор);
	ДетиРодителя = Новый Массив;
	НужныДетиРодителя = ПустойРодитель <> Родитель;
	Для Каждого Элемент Из Элементы Цикл
		ДетиЭлемента = ПолучитьВсехДетейРодителей(пТаблицаЭлементов, Элемент.ЭлементПроекта, ДетиРодителей, ПустойРодитель, УдалятьРодителейИзДетей);	
		Если Не УдалятьРодителейИзДетей ИЛИ ДетиЭлемента.Количество() = 0 Тогда 
			ДетиЭлемента.Добавить(Элемент.ЭлементПроекта);
		КонецЕсли;
		Если НужныДетиРодителя Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДетиРодителя, ДетиЭлемента);
		КонецЕсли;
		//Если ДетиЭлемента.Количество() Тогда
		//	ДетиРодителей.Вставить(Элемент, ДетиЭлемента);
		//КонецЕсли;
	КонецЦикла;
	Если ДетиРодителя.Количество() Тогда
		ДетиРодителей.Вставить(Родитель, ДетиРодителя);
	КонецЕсли;	
	Возврат ДетиРодителя;
КонецФункции 

Функция ПроверитьВозможностьПереходаВСтатус(Проект, ТекущийСтатусПроекта, ВыбранныйСтатус)
	
	// Из статуса Завершен в статус Выполняется проект можно перевести,
	// только если он до этого уже был в статусе Выполняется.
	Если ТекущийСтатусПроекта = Перечисления.упоСостояниеСтатусаПроекта.Завершен Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		               |	упоСтатусыПроектов.Проект,
		               |	упоСтатусыПроектов.СтатусПроекта
		               |ИЗ
		               |	РегистрСведений.упоСтатусыПроектов КАК упоСтатусыПроектов
		               |ГДЕ
		               |	упоСтатусыПроектов.Проект = &Проект
		               |	И упоСтатусыПроектов.СтатусПроекта = &СтатусПроекта";
		Запрос.УстановитьПараметр("Проект", Проект);				   
		Запрос.УстановитьПараметр("СтатусПроекта", Перечисления.упоСостояниеСтатусаПроекта.Выполняется);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
