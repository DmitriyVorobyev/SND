#Область ПрограммныйИнтерфейс

// Обрабатывает установку текущего проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты - установленный проект.
//
// Возвращаемое значение:
//	Неопределено - не возвращает значение.
//
Функция ОбработатьУстановкуТекущегоПроекта(Проект) Экспорт
	
	Если Проект.ЭтоПроектнаяЗадача Тогда
		Возврат Ложь;
	Иначе
		
		ПараметрыСеанса.упоТекущийПроект = Проект;
		ХранилищеОбщихНастроек.Сохранить("упоТекущийПроект", , Проект, "Текущий проект");
		
		Возврат Истина;
		
	КонецЕсли; 
	
КонецФункции 

// Запись программы проектов в проекте
//
// Параметры:
//  Проект				 - СправочникСсылка.Проекты				 - проект.
//  ПрограммаПроектов	 - СправочникСсылка.упоПрограммыПроектов - программа.
//
Процедура ЗаписатьПрограммуПроектовВПроекте(Проект, ПрограммаПроектов) Экспорт
	
	Объект = Проект.ПолучитьОбъект();
	Объект.ПрограммаПроектов = ПрограммаПроектов;
	Объект.Записать();
	
КонецПроцедуры

#Область ПолучениеПолныхДанныхСтруктурыПроектаИзБД

// Функция возвращает рабочий календарь проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты	 - заданный проект.
// 
// Возвращаемое значение:
//  СправочникСсылка.упоРабочиеКалендари, Неопределено - нет сведений о календаре на запрашиваемый год.
//
Функция ПолучитьКалендарьПроекта(Проект) Экспорт
	
	Календарь = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект" , Проект);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.КалендарьПроекта КАК Календарь
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Календарь;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Календарь;
	
КонецФункции

// Функция возвращает банковский календарь проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты	 - проект.
// 
// Возвращаемое значение:
//  СправочникСсылка.упоРабочиеКалендари, Неопределено - нет сведений о календаре на запрашиваемый год.
//
Функция ПолучитьБанковскийКалендарьПроекта(Проект) Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР
		|		КОГДА Рег.КалендарьБанковскихДней ЕСТЬ NULL 
		|			ТОГДА Рег.КалендарьПроекта
		|		ИНАЧЕ ВЫБОР
		|				КОГДА Рег.КалендарьБанковскихДней = &ПустойКалендарь
		|					ТОГДА Рег.КалендарьПроекта
		|				ИНАЧЕ Рег.КалендарьБанковскихДней
		|			КОНЕЦ
		|	КОНЕЦ КАК Календарь
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	ПараметрыЗапроса = Новый Структура("Проект,ПустойКалендарь", Проект, Справочники.упоРабочиеКалендари.ПустаяСсылка());
	
	Результат = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
	Если Результат.Пустой() Тогда
		Возврат Неопределено; // Нет сведений.
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Календарь;
	
КонецФункции

// Функция возвращает все календари проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты	 - заданный проект.
// 
// Возвращаемое значение:
//  Структура - содержит календари проекта.
//
Функция ПолучитьКалендариПроекта(Проект) Экспорт
	
	КалендариПроекта = Новый Структура;
	КалендариПроекта.Вставить("Банковский", Неопределено);
	КалендариПроекта.Вставить("Рабочий", Неопределено);
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.упоКалендариПроектов) Тогда
		Возврат КалендариПроекта;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект" , Проект);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.КалендарьПроекта КАК Рабочий,
		|	ЕСТЬNULL(Рег.КалендарьБанковскихДней, Рег.КалендарьПроекта) КАК Банковский
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат КалендариПроекта;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(КалендариПроекта, Выборка);
	
	Возврат КалендариПроекта;
	
КонецФункции

// Получает статус проекта.
//
// Параметры:
//  Проект	 - СправочникСсылка.Проекты - проект, для которого нужно получить статус.
//
// Возвращаемое значение:
//	ПеречислениеСсылка.упоСостояниеСтатусаПроекта - статус.
//
Функция ПолучитьСтатусПроекта(Проект) Экспорт
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.упоСтатусыПроектов) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект" , Проект);
	Запрос.Текст =
		"ВЫБРАТЬ 
		|	Рег.СтатусПроекта КАК СтатусПроекта
		|ИЗ
		|	РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.СтатусПроекта;
	
КонецФункции 

// Возвращает текущую дату старта проекта.
//
// Параметры:
//  Проект					 - СправочникСсылка.Проекты	 - проект.
//  ЗаполнятьПустуюТекущей	 - Булево	 - возвращать текущую дату, если не удалось определить дату старта.
//  Версия					 - ДокументСсылка.упоВерсияПланаПроекта - версия проекта.
// 
// Возвращаемое значение:
//  Дата - дата старта проекта.
//
Функция ДатаСтартаПроекта(Проект, ЗаполнятьПустуюТекущей = Ложь, Знач Версия = Неопределено) Экспорт
	
	ДатаСтарта = Дата(1,1,1);
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.упоСвойстваПроектов) Тогда
		Возврат ДатаСтарта;
	КонецЕсли;
	
	Если Версия = Неопределено Тогда
		Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Версия) Тогда
		Возврат ДатаСтарта;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСвойстваПроектов.ДатаСтарта КАК ДатаСтарта
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектов.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И Проект = &Проект) КАК упоСвойстваПроектов";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ДатаСтарта = Выборка.ДатаСтарта;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСтарта) Тогда
		СрокиПроекта = ПолучитьПланируемыеСрокиПроекта(Проект, Версия);
		ДатаСтарта = СрокиПроекта.ДатаНачалаПлан;
	КонецЕсли;
	
	Если ЗаполнятьПустуюТекущей И НЕ ЗначениеЗаполнено(ДатаСтарта) Тогда
		ДатаСтарта = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат ДатаСтарта;
	
КонецФункции

// Возвращает метод оперативного планирования проекта.
//
// Параметры:
//  Проект	- СправочникСсылка.Проекты - Проект.
//
// Возвращаемое значение:
//	ПеречислениеСсылка.упоМетодОперативногоПланирования, Неопределено - метод оперативного планирования проекта.
//
Функция МетодОперативногоПланированияПроекта(Проект) Экспорт
	
	МетодОперативногоПланирования = Неопределено;
	
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.упоКалендариПроектов) Тогда
		Возврат МетодОперативногоПланирования; // Нет сведений.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Рег.МетодОперативногоПланирования
			|ИЗ
			|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	Запрос.УстановитьПараметр("Проект", Проект);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		МетодОперативногоПланирования = Выборка.МетодОперативногоПланирования;
	КонецЕсли;
	
	Возврат МетодОперативногоПланирования;
	
КонецФункции

// Возвращает календарь по иерархии объектов ДДС.
//
// Параметры:
//  ПроектнаяЗадача - ДокументСсылка.упоПроектнаяЗадача - ссылка на заданную проектную задачу. 
// 
// Возвращаемое значение:
//   СправочникСсылка.упоРабочиеКалендари, Неопределено - нет сведений о календаре на запрашиваемый год. 
//
Функция КалендарьПоИерархииОбъектовДДС(ПроектнаяЗадача, Проект = Неопределено) Экспорт
	
	ПроектДляПоискаКалендаря = Проект;
	
	Если ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		Календарь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "КалендарьЗадачи");
		
		Если ЗначениеЗаполнено(Календарь) Тогда
			Возврат Календарь;
		КонецЕсли;
		
		ПроектДляПоискаКалендаря = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "Проект");
	КонецЕсли;
	
	Календарь = упоПроектыИЗадачиСервер.ПолучитьБанковскийКалендарьПроекта(ПроектДляПоискаКалендаря);
	
	Если ЗначениеЗаполнено(Календарь) Тогда
		Возврат Календарь;
	КонецЕсли;
	
	Календарь = упоПроектыИЗадачиСервер.ПолучитьКалендарьПроекта(ПроектДляПоискаКалендаря);
	
	Возврат Календарь;
	
КонецФункции

#КонецОбласти

#Область ПолученияОтдельныхСведенийОПроектнойЗадаче

// Функция получает последние сведения о названии заданной проектной задачи.
//
// Параметры:
//  Задача						 - ДокументСсылка.упоПроектнаяЗадача - ссылка на заданную проектную задачу.
//  ДобавитьРасшифровкуДокумента - Булево
// 
// Возвращаемое значение:
//  Строка, Неопределено - название задачи. Неопределено, если не найдено.
//
Функция НазваниеПроектнойЗадачи(Задача, ДобавитьРасшифровкуДокумента = Ложь, ДобавитьКодСДР = Ложь) Экспорт
	
	НазваниеЗадачи = "";
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА Рег.НазваниеЗадачи > """"
	               |			ТОГДА Рег.НазваниеЗадачи
	               |		ИНАЧЕ Рег.ПроектнаяЗадача.НазваниеПроектнойЗадачи
	               |	КОНЕЦ КАК НазваниеЗадачи,
	               |	ВЫБОР
	               |		КОГДА &ДобавитьРасшифровкуДокумента
	               |			ТОГДА ПРЕДСТАВЛЕНИЕ(Рег.ПроектнаяЗадача)
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ПредставлениеДокумента,
	               |	ЕСТЬNULL(Проекты.КодСДР, """") КАК КодСДР
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, &УсловиеОтбораЗадачи) КАК Рег
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО Рег.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	               |			И (&ДобавитьКодСДР)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО Рег.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)";
	
	Если ТипЗнч(Задача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда 
		УсловиеОтбораЗадачи = "ПроектнаяЗадача = &Задача";
	ИначеЕсли ТипЗнч(Задача) = Тип("СправочникСсылка.Проекты") Тогда
		УсловиеОтбораЗадачи = "ПроектнаяЗадача В
				               |(ВЫБРАТЬ
				               |	Проекты.СсылкаНаПроектнуюЗадачу КАК Ссылка
				               |ИЗ
				               |	Справочник.Проекты КАК Проекты
				               |ГДЕ
				               |	Проекты.Ссылка = &Задача)";
	Иначе
		Возврат НазваниеЗадачи;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОтбораЗадачи", УсловиеОтбораЗадачи);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДобавитьРасшифровкуДокумента", ДобавитьРасшифровкуДокумента);
	Запрос.УстановитьПараметр("ДобавитьКодСДР", ДобавитьКодСДР);
	Запрос.УстановитьПараметр("Задача", Задача);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		НазваниеЗадачи = НСтр("ru = '(задачи нет в текущей версии)'"); 
		Возврат НазваниеЗадачи;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Если ДобавитьКодСДР Тогда
		НазваниеЗадачи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"%1, %2",
			Выборка.КодСДР,
			Выборка.НазваниеЗадачи);
	Иначе
		НазваниеЗадачи = Выборка.НазваниеЗадачи;
	КонецЕсли;
	
	Если ДобавитьРасшифровкуДокумента Тогда
		НазваниеЗадачи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"""%1"" (%2)",
			НазваниеЗадачи,
			Выборка.ПредставлениеДокумента);
	КонецЕсли;
	
	Возврат НазваниеЗадачи;
	
КонецФункции
 
// Функция - получает названия с кодом СДР проектных задач текущей версии проекта.
//
// Параметры:
//  ПроектныеЗадачи	 - Массив	 - массив документов типа ДокументСсылка.упоПроектнаяЗадача
// 
// Возвращаемое значение:
//  Соответствие - соответствие проектных задач и их названий
//
Функция НазванияПроектныхЗадач(ПроектныеЗадачи, ДобавитьРасшифровкуДокумента = Ложь) Экспорт
	
	НазванияПроектныхЗадач = Новый Соответствие;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СвойстваЗадач.НазваниеЗадачи КАК НазваниеЗадачи,
	               |	СвойстваЗадач.ПроектнаяЗадача КАК СсылкаНаПроектнуюЗадачу,
	               |	Проекты.КодСДР КАК КодСДР,
	               |	ПРЕДСТАВЛЕНИЕ(СвойстваЗадач.ПроектнаяЗадача) КАК ПредставлениеДокумента
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК СвойстваЗадач
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
	               |		ПО СвойстваЗадач.Версия = Версии.Версия
	               |			И (Версии.Текущая)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО СвойстваЗадач.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу";
	
	Если Не ДобавитьРасшифровкуДокумента Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПРЕДСТАВЛЕНИЕ(СвойстваЗадач.ПроектнаяЗадача)", "Неопределено");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ПроектныеЗадачи);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если ДобавитьРасшифровкуДокумента Тогда
		ШаблонНаименования = "%1, %2 (%3)";
		Пока Выборка.Следующий() Цикл
			НазваниеЗадачи = СтрШаблон(ШаблонНаименования, Выборка.КодСДР, Выборка.НазваниеЗадачи, Выборка.ПредставлениеДокумента);
			НазванияПроектныхЗадач.Вставить(Выборка.СсылкаНаПроектнуюЗадачу, НазваниеЗадачи);
		КонецЦикла;
	Иначе
		ШаблонНаименования = "%1, %2";
		Пока Выборка.Следующий() Цикл
			НазваниеЗадачи = СтрШаблон(ШаблонНаименования, Выборка.КодСДР, Выборка.НазваниеЗадачи);
			НазванияПроектныхЗадач.Вставить(Выборка.СсылкаНаПроектнуюЗадачу, НазваниеЗадачи);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НазванияПроектныхЗадач;
	
КонецФункции

// Производит поиск связанных элементов проекта по "зеркальным" элементам.
//
// Параметры:
//  ВхДанные		 - ДокументСсылка.ПроектнаяЗадача, СправочникСсылка.Проекты, Массив	 - исходные данные для поиска.
//  ВернутьТаблицу	 - Булево - флаг указывает на необходиомость вернуть результат
//  	в виде таблицы значений.
// 
// Возвращаемое значение:
//  ДокументСсылка.ПроектнаяЗадача, СправочникСсылка.Проекты, ТаблицаЗначений, Неопределено - найденные данные.
//
Функция НайтиСвязанныйЭлементПроекта(ВхДанные, ВернутьТаблицу = Ложь, ВернутьСоответствие = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ВхДанные) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Определяем тип исходного объекта и направление для поиска.
	
	ЭтоМассив = Ложь;
	ЭтоСправочник = Ложь;
	ЭтоТекущиеДанныеСписка = (ТипЗнч(ВхДанные) = Тип("ТекущиеДанныеСписка"));	
	
	Если ВернутьСоответствие Тогда
		РезультатСоответствие = Новый Соответствие;
	КонецЕсли;
	
	Если ТипЗнч(ВхДанные) = Тип("Массив") Тогда
		ЭтоМассив = Истина;
		Если ТипЗнч(ВхДанные[0]) = Тип("СправочникСсылка.Проекты") Тогда
			ЭтоСправочник = Истина;
		КонецЕсли; 
	ИначеЕсли ТипЗнч(ВхДанные) = Тип("СправочникСсылка.Проекты") Или (ЭтоТекущиеДанныеСписка
		И ТипЗнч(ВхДанные.Ссылка) = Тип("СправочникСсылка.Проекты")) Тогда
		
		ЭтоСправочник = Истина;
		
	КонецЕсли; 

	Если НЕ ЭтоСправочник Тогда
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Проекты.СсылкаНаПроектнуюЗадачу КАК ДокументСсылка,
			|	Проекты.Ссылка КАК СправочникСсылка
			|ИЗ
			|	Справочник.Проекты КАК Проекты
			|ГДЕ
			|	НЕ Проекты.СсылкаНаПроектнуюЗадачу = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)
			|	И Проекты.СсылкаНаПроектнуюЗадачу " + ?(ЭтоМассив, " В (&Список) ", " = &Список ");
	Иначе
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Проекты.Ссылка КАК СправочникСсылка,
			|	Проекты.СсылкаНаПроектнуюЗадачу КАК ДокументСсылка
			|ИЗ
			|	Справочник.Проекты КАК Проекты
			|ГДЕ
			|	Проекты.Ссылка "+?(ЭтоМассив," В (&Список)"," = &Список ");
	КонецЕсли; 
	
	ПараметрыЗапроса = Новый Структура();
	
	Если ЭтоМассив Тогда
		ПараметрыЗапроса.Вставить("Список", ВхДанные);
	Иначе
		ПараметрыЗапроса.Вставить("Список", ?(ЭтоТекущиеДанныеСписка,ВхДанные.Ссылка,ВхДанные));
	КонецЕсли; 
	
	РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
	Если РезультатЗапроса.Пустой() Тогда
		Если ВернутьСоответствие Тогда
			Возврат РезультатСоответствие;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли; 
	
	ИмяКолонкиРезультата = "СправочникСсылка";
	ИмяИсходнойКолонки = "ДокументСсылка";
	Если ЭтоСправочник Тогда
		ИмяКолонкиРезультата = "ДокументСсылка";
		ИмяИсходнойКолонки = "СправочникСсылка";
	КонецЕсли;
	
	Если ЭтоМассив Тогда
		Если ВернутьСоответствие Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Пока Выборка.Следующий() Цикл
				РезультатСоответствие.Вставить(Выборка[ИмяИсходнойКолонки], Выборка[ИмяКолонкиРезультата]);
			КонецЦикла;
			Возврат РезультатСоответствие;
		ИначеЕсли ВернутьТаблицу Тогда
			Возврат РезультатЗапроса.Выгрузить();
		Иначе
			Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(ИмяКолонкиРезультата);
		КонецЕсли;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка[ИмяКолонкиРезультата];
	КонецЕсли; 
	
КонецФункции

// Формирует структуру необходимых данных по проектным задачам.
//
// Параметры:
//  ВхПараметр			 - СправочникСсылка.Проекты, Массив, СписокЗначений	 - собираются данные по всем задачам проекта
//  	или по заданным задачам проекта.
//  НужныеТаблицы		 - Структура										 - содержащая список необходимых таблиц для выгрузки
//  	 По умолчанию: получаем все данные.
//  ВключаяЗануленные	 -  Булево
// 
// Возвращаемое значение:
//  ТаблицаЗначенй - сформированная структура данных.
//
Функция ПолучитьДанныеПроектнойЗадачи(ВхПараметр, НужныеТаблицы = Неопределено, ВключаяЗануленные = Ложь) Экспорт
	
	Если НужныеТаблицы = Неопределено Тогда
		НужныеТаблицы = Новый Структура("ДанныеЗадачи,
										|ОтветственнаяРоль,
										|Ресурсы,
										|ТрудовыеРесурсыТЧ,
										|ПредУсловия,
										|Длительность,
										|Руководитель");
	КонецЕсли;
	
	ВозможныЗадачиРазныхПроектов = Ложь;
	
	Если ТипЗнч(ВхПараметр) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Проект = ВхПараметр.Проект;
		СписокПроектныхЗадач = Новый Массив;
		СписокПроектныхЗадач.Добавить(ВхПараметр);
		ВидОперации = 0; // Получаем данные только для одной задачи.
	ИначеЕсли ТипЗнч(ВхПараметр) = Тип("Массив") Или ТипЗнч(ВхПараметр) = Тип("СписокЗначений") Тогда
		ВозможныЗадачиРазныхПроектов = Истина;
		Проект = Неопределено;
		// Преобразуем список значений в массив (необходимо для операций поиска ниже)
		Если ТипЗнч(ВхПараметр) = Тип("СписокЗначений") Тогда 		
			СписокПроектныхЗадач = ВхПараметр.ВыгрузитьЗначения();
		Иначе
			СписокПроектныхЗадач = ВхПараметр;                   
		КонецЕсли;
		ВидОперации = 1; // Получаем данные для списка задач.
	ИначеЕсли ТипЗнч(ВхПараметр) = Тип("СправочникСсылка.Проекты") Тогда
		Проект = ВхПараметр;
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Проект", Проект);
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	упоВерсииПроекта.Версия КАК Версия
			|ПОМЕСТИТЬ ТекущаяВерсияПроекта
			|ИЗ
			|	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
			|ГДЕ
			|	упоВерсииПроекта.Проект = &Проект
			|	И упоВерсииПроекта.Текущая
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Рег.ПроектнаяЗадача КАК ПроектнаяЗадача
			|ИЗ
			|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
			|			,
			|			Версия В
			|				(ВЫБРАТЬ
			|					ТекущаяВерсияПроекта.Версия КАК Версия
			|				ИЗ
			|					ТекущаяВерсияПроекта КАК ТекущаяВерсияПроекта)) КАК Рег
			|ГДЕ
			|	НЕ Рег.ЗадачаОтменена";
		СписокПроектныхЗадач = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПроектнаяЗадача");
		ВидОперации = 1; // Получаем данные для списка задач.
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокЗадач", СписокПроектныхЗадач);
	Запрос.УстановитьПараметр("ВключаяЗануленные", ВключаяЗануленные);
	
	Если НЕ ВозможныЗадачиРазныхПроектов Тогда
		текВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
		Запрос.УстановитьПараметр("текВерсия", текВерсия);
	Иначе
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	МАКСИМУМ(упоВерсииПроекта.Версия) КАК Версия,
		               |	упоПроектнаяЗадача.Проект
		               |ПОМЕСТИТЬ втТекущиеВерсии
		               |ИЗ
		               |	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		               |		ПО упоПроектнаяЗадача.Проект = упоВерсииПроекта.Проект
		               |ГДЕ
		               |	упоВерсииПроекта.Текущая
		               |	И упоПроектнаяЗадача.Ссылка В(&СписокЗадач)
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	упоПроектнаяЗадача.Проект
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	Версия";
		Запрос.Выполнить();	
		СтрокаПодменыВерсии = "Версия В (ВЫБРАТЬ втТекущиеВерсии.Версия ИЗ втТекущиеВерсии КАК втТекущиеВерсии)";
		СтрокаВерсии = "версия = &текверсия";
	КонецЕсли;
	
	Если НужныеТаблицы.Свойство("ДанныеЗадачи") Тогда
			
		Запрос.Текст = ТекстЗапросаВременнаяТаблицаПрогнозныеСроки(Истина)
			+ ОбщегоНазначения.РазделительПакетаЗапросов() + "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РегСвойства.ПроектнаяЗадача.Проект КАК Проект,
			|	РегСвойства.ПроектнаяЗадача.Дата КАК Дата,
			|	РегСвойства.ПроектнаяЗадача КАК Ссылка,
			|	РегСвойства.Версия КАК ТекущаяВерсияПроекта,
			|	ВЫБОР
			|		КОГДА РегСвойства.НазваниеЗадачи <> """"
			|			ТОГДА РегСвойства.НазваниеЗадачи
			|		ИНАЧЕ РегСвойства.ПроектнаяЗадача.НазваниеПроектнойЗадачи
			|	КОНЕЦ КАК Наименование,
			|	РегСвойства.ЗадачаРодитель КАК Родитель,
			|	РегСвойства.ЭтоПакетРабот КАК ЭтоПакетРабот,
			|	РекКоды.КодСДР КАК КодСДР,
			|	РегСтатусы.СтатусЗадачи КАК Статус,
			|	РегГотовности.ПроцентГотовности КАК ПроцентГотовности,
			|	РегСвойства.КрайнийСрок КАК КрайнийСрок,
			|	РегСрокиПлан.ДатаНачалаПлан КАК ДатаНачалаПлан,
			|	РегПрогСроки.ДатаНачалаПрогноз КАК ДатаНачалаПрогноз,
			|	РегПрогСроки.ДатаЗавершенияПрогноз КАК ДатаЗавершенияПрогноз,
			|	РегПрогСроки.СтатусСроков КАК СтатусСроков,
			|	РегСвойства.НормаСтоимостиТрудовыхРесурсов КАК НормаСтоимостиТрудовыхРесурсов,
			|	РегСвойства.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов,
			|	РегСвойства.ВидОперации КАК ВидОперации,
			|	РегСвойства.КалендарьЗадачи КАК КалендарьЗадачи,
			|	РегСвойства.ПодчиненныйПроект КАК ПодчиненныйПроект,
			|	РегСвойства.СуммаСанкцийЗаДеньЗадержки КАК СуммаСанкцийЗаДеньЗадержки,
			|	РегСрокиПлан.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
			|	РегСрокиРасчет.ДатаРаннегоСтарта КАК ДатаРаннегоСтарта,
			|	РегСрокиРасчет.ДатаПозднегоСтарта КАК ДатаПозднегоСтарта,
			|	РегСрокиРасчет.ДатаРаннегоФиниша КАК ДатаРаннегоФиниша,
			|	РегСрокиРасчет.ДатаПозднегоФиниша КАК ДатаПозднегоФиниша,
			|	ЕСТЬNULL(РегСвойства.ЭтоМодельПакетаРабот, ЛОЖЬ) КАК ЭтоМодельПакетаРабот,
			|	ЕСТЬNULL(РегСвойства.ЭтоВеха, ЛОЖЬ) КАК ЭтоВеха,
			|	ЕСТЬNULL(РегСвойства.ПланироватьТрудозатратыНаИсполнителей, ЛОЖЬ) КАК ПланироватьТрудозатратыНаИсполнителей,
			|	РегСвойства.ВключитьТрудРесурсыВПланРасходов КАК ВключитьТрудРесурсыВПланРасходов,
			|	ВЫБОР
			|		КОГДА РегСвойства.УровеньПланированияТрудозатратДляБДР = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланированияТрудозатратДляБДР.пустаяСсылка)
			|			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоУровеньПланированияТрудозатратДляБДР.Авто)
			|		ИНАЧЕ РегСвойства.УровеньПланированияТрудозатратДляБДР
			|	КОНЕЦ КАК УровеньПланированияТрудозатратДляБДР,
			|	РегСвойства.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов,
			|	РегСвойства.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
			|	РегСвойства.ВключитьСубпродуктыВПланДоходов КАК ВключитьСубпродуктыВПланДоходов,
			|	РегСвойства.ВключитьПланДоходовВБДДС КАК ВключитьПланДоходовВБДДС,
			|	РегСвойства.ВключитьПланРасходовВБДДС КАК ВключитьПланРасходовВБДДС
			|ИЗ
			|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
			|			,
			|			ПроектнаяЗадача В (&СписокЗадач)
			|				И Версия = &текВерсия) КАК РегСвойства
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
			|				,
			|				Версия = &текВерсия
			|					И ПроектнаяЗадача В (&СписокЗадач)) КАК РегСтатусы
			|		ПО РегСвойства.ПроектнаяЗадача = РегСтатусы.ПроектнаяЗадача
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
			|				,
			|				ПроектнаяЗадача В (&СписокЗадач)
			|					И Версия = &текВерсия) КАК РегСрокиПлан
			|		ПО РегСвойства.ПроектнаяЗадача = РегСрокиПлан.ПроектнаяЗадача
			|		ЛЕВОЕ СОЕДИНЕНИЕ ПрогнозныеСроки КАК РегПрогСроки
			|		ПО РегСвойства.ПроектнаяЗадача = РегПрогСроки.ПроектнаяЗадача
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРасчетныеСрокиПроектныхЗадач.СрезПоследних(
			|				,
			|				ПроектнаяЗадача В (&СписокЗадач)
			|					И Версия = &текВерсия) КАК РегСрокиРасчет
			|		ПО РегСвойства.ПроектнаяЗадача = РегСрокиРасчет.ПроектнаяЗадача
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК РекКоды
			|		ПО РегСвойства.ПроектнаяЗадача = РекКоды.СсылкаНаПроектнуюЗадачу
