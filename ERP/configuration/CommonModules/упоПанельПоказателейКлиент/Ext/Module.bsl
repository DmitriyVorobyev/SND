#Область ПрограммныйИнтерфейс

// Открывает форму выбора поля, передавая в нее параметры.
//
// Параметры:
//  Форма				 - УправляемаяФорма - форма-владелец.
//  Элемент				 - Произвольный - не используется.
//  Отказ				 - Булево - признак отказа от выполнения стандартной операции.
//  Копирование			 - Произвольный - не используется.
//  Родитель			 - Произвольный - не используется.
//  Группа				 - Произвольный - не используется.
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек.
//
Процедура ГруппировкаПередНачаломДобавления(Форма, Элемент, Отказ, Копирование, Родитель, Группа,
	КомпоновщикНастроек) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КомпоновщикНастроек", КомпоновщикНастроек);
	ПараметрыФормы.Вставить("Режим"          , "Группировка");
	ПараметрыФормы.Вставить("Событие"        , "Добавление");
	ПараметрыФормы.Вставить("ИсключенныеПоля", Форма.ПолучитьЗапрещенныеПоля("Группировка"));
	ПараметрыФормы.Вставить("ТекущаяСтрока"  , Неопределено);
	ПараметрыФормы.Вставить("ИсточникИД"  , Форма.УникальныйИдентификатор);
	
	ОткрытьФорму("ОбщаяФорма.упоФормаВыбораДоступногоПоля", ПараметрыФормы);
	
	Отказ = Истина;
	
КонецПроцедуры

// Добавляет в ТЧ строку с выбранным полем группировки.
//
// Параметры:
//  РезультатЗакрытия		 - Произвольный, Структура - данные выбранного поля.
//  ДополнительныеПараметры	 - Произвольный - не используется.
//  ТЧ						 - ДанныеФормыКоллекция - ТЧ, куда добавляется строка.
//
Процедура ГруппировкаПередНачаломДобавленияЗавершение(РезультатЗакрытия, ДополнительныеПараметры, ТЧ) Экспорт
	
	ПараметрыВыбранногоПоля = РезультатЗакрытия;
	
	Если ТипЗнч(ПараметрыВыбранногоПоля) = Тип("Структура") Тогда
		
		НоваяСтрока = ТЧ.Добавить();
		НоваяСтрока.Использование = Истина;
		НоваяСтрока.Поле          = ПараметрыВыбранногоПоля.Поле;
		НоваяСтрока.Представление = ПараметрыВыбранногоПоля.Заголовок;
		
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму выбора поля, передавая в нее параметры.
//
// Параметры:
//  Форма				 - УправляемаяФорма, Форма - форма-владелец.
//  Элемент				 - Произвольный - не используется.
//  Отказ				 - Булево - признак отказа от выполнения стандартной операции.
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек.
Процедура ГруппировкаПередНачаломИзменения(Форма, Элемент, Отказ, КомпоновщикНастроек) Экспорт
	
	Если Элемент.ТекущийЭлемент = Форма.Элементы.ГруппировкаПредставление Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("КомпоновщикНастроек", КомпоновщикНастроек);
		ПараметрыФормы.Вставить("Режим"          , "Группировка");
		ПараметрыФормы.Вставить("Событие"        , "Изменение");
		ПараметрыФормы.Вставить("ИсключенныеПоля", Форма.ПолучитьЗапрещенныеПоля("Группировка"));
		ПараметрыФормы.Вставить("ТекущаяСтрока"  , Элемент.ТекущиеДанные.Поле);
		ПараметрыФормы.Вставить("ИсточникИД"  , Форма.УникальныйИдентификатор);
		
		ОткрытьФорму("ОбщаяФорма.упоФормаВыбораДоступногоПоля", ПараметрыФормы);
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, возникающий при завершении изменения.
//
// Параметры:
//  РезультатЗакрытия		 - Произвольный - результат работы с формой упоФормаВыбораДоступногоПоля.
//  ДополнительныеПараметры	 - Произвольный - не используется.
//  Элемент					 - Произвольный - ЭУ формы, для которого вызван обработчик.
Процедура ГруппировкаПередНачаломИзмененияЗавершение(РезультатЗакрытия, ДополнительныеПараметры, Элемент) Экспорт
	
	ПараметрыВыбранногоПоля = РезультатЗакрытия;
	
	Если ТипЗнч(ПараметрыВыбранногоПоля) = Тип("Структура") Тогда
		НоваяСтрока = Элемент.ТекущиеДанные;
		НоваяСтрока.Использование = Истина;
		НоваяСтрока.Поле          = ПараметрыВыбранногоПоля.Поле;
		НоваяСтрока.Представление = ПараметрыВыбранногоПоля.Заголовок;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, вызываемый перед началом добавления.
//
// Параметры:
//  Форма				 - УправляемаяФорма, Форма - форма, из которой вызван обработчик.
//  Элемент				 - Произвольный - ЭУ, для которого вызван обработчик.
//  Отказ				 - Булево - признак стандартной обработки.
//  Копирование			 - Произвольный - не используется.
//  Родитель			 - Произвольный - не используется.
//  Группа				 - Произвольный - не используется.
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек СКД.
Процедура ОтборыПередНачаломДобавления(Форма, Элемент, Отказ, Копирование, Родитель, Группа,
	КомпоновщикНастроек) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КомпоновщикНастроек"  , КомпоновщикНастроек);
	ПараметрыФормы.Вставить("Режим"                , "Отбор");
	ПараметрыФормы.Вставить("Событие"         	   , "Добавление");
	ПараметрыФормы.Вставить("ИсключенныеПоля"      , Форма.ПолучитьЗапрещенныеПоля("Отбор"));
	ПараметрыФормы.Вставить("ТекущаяСтрока"        , Неопределено);
	ПараметрыФормы.Вставить("ИсточникИД"  		   , Форма.УникальныйИдентификатор);
		
	ОткрытьФорму("ОбщаяФорма.упоФормаВыбораДоступногоПоля", ПараметрыФормы);
	
	Отказ = Истина;
	
КонецПроцедуры

// Обработчик события, вызываемый при окончании обавления.
//
// Параметры:
//	РезультатЗакрытия		 - Произвольный - результат работы с формой упоФормаВыбораДоступногоПоля.
//  ДополнительныеПараметры	 - Произвольный - не используется.
//  Элемент					 - Произвольный - ЭУ формы, для которого вызван обработчик.
Процедура ОтборыПередНачаломДобавленияЗавершение(РезультатЗакрытия, ДополнительныеПараметры, Элемент) Экспорт
	
	КомпоновщикНастроек =   ДополнительныеПараметры.КомпоновщикНастроек;
	
	ПараметрыВыбранногоПоля = РезультатЗакрытия;
	
	Если ТипЗнч(ПараметрыВыбранногоПоля) = Тип("Структура") Тогда
		
		Если Элемент.ТекущаяСтрока = Неопределено Тогда
			ТекущаяСтрока = Неопределено;
		Иначе
			ТекущаяСтрока = КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(Элемент.ТекущаяСтрока);
		КонецЕсли;
		
		Если ТипЗнч(ТекущаяСтрока) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЭлементОтбора = ТекущаяСтрока.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ИначеЕсли ТипЗнч(ТекущаяСтрока) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если ТекущаяСтрока.Родитель <> Неопределено Тогда
				ЭлементОтбора = ТекущаяСтрока.Родитель.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Иначе
				ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			КонецЕсли;
		Иначе
			ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		КонецЕсли;
		
		ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ПараметрыВыбранногоПоля.Поле);
		
		ЭлементОтбора.ВидСравнения = ПараметрыВыбранногоПоля.ВидСравнения;
		
		Элемент.ТекущаяСтрока = КомпоновщикНастроек.Настройки.Отбор.ПолучитьИдентификаторПоОбъекту(ЭлементОтбора);
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, вызываемый перед началом изменения.
//
// Параметры:
//  Форма				 - УправляемаяФорма, Форма - форма-владелец.
//  Элемент				 - Произвольный - не используется.
//  Отказ				 - Булево - признак отказа от выполнения стандартной операции.
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек. 
Процедура ОтборыПередНачаломИзменения(Форма, Элемент, Отказ, КомпоновщикНастроек) Экспорт
	
	Если (Найти(Элемент.ТекущийЭлемент.Имя, "ОтборыЛевоеЗначение") > 0 И ТипЗнч(Элемент.ТекущиеДанные.ЛевоеЗначение) = Тип("ПолеКомпоновкиДанных")) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("КомпоновщикНастроек"  , КомпоновщикНастроек);
		ПараметрыФормы.Вставить("Режим"                , "Отбор");
		ПараметрыФормы.Вставить("Событие"              , "Изменение");
		ПараметрыФормы.Вставить("ИсключенныеПоля"      , Форма.ПолучитьЗапрещенныеПоля("Отбор"));
		ПараметрыФормы.Вставить("ТекущаяСтрока"        , Элемент.ТекущиеДанные.ЛевоеЗначение);
		ПараметрыФормы.Вставить("ИсточникИД"  		   , Форма.УникальныйИдентификатор);
				
		ОткрытьФорму("ОбщаяФорма.упоФормаВыбораДоступногоПоля", ПараметрыФормы);
		
		Отказ = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

// Обработчик события, вызываемый при окончании изменения.
//
// Параметры:
//  РезультатЗакрытия		 - Произвольный - результат работы с формой упоФормаВыбораДоступногоПоля.
//  ДополнительныеПараметры	 - Произвольный - не используется.
//  Элемент					 - Произвольный - ЭУ формы, для которого вызван обработчик.
Процедура ОтборыПередНачаломИзмененияЗавершение(РезультатЗакрытия, ДополнительныеПараметры, Элемент) Экспорт
	
	КомпоновщикНастроек = ДополнительныеПараметры.КомпоновщикНастроек;
	
	ПараметрыВыбранногоПоля = РезультатЗакрытия;
	
	Если ТипЗнч(ПараметрыВыбранногоПоля) = Тип("Структура") Тогда
		
		ТекущаяСтрока = КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(Элемент.ТекущаяСтрока);
		
		Если Найти(Элемент.ТекущийЭлемент.Имя, "ОтборыЛевоеЗначение") > 0 Тогда 
			ТекущаяСтрока.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПараметрыВыбранногоПоля.Поле);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, вызываемый перед началом добавления.
//
// Параметры:
//  Форма				 - УправляемаяФорма, Форма - форма, из которой вызван обработчик.
//  Элемент				 - Произвольный - ЭУ, для которого вызван обработчик.
//  Отказ				 - Булево - признак стандартной обработки.
//  Копирование			 - Произвольный - не используется.
//  Родитель			 - Произвольный - не используется.
//  Группа				 - Произвольный - не используется.
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек СКД.
Процедура ДополнительныеПоляПередНачаломДобавления(Форма, Элемент, Отказ, Копирование, Родитель, Группа,
	КомпоновщикНастроек) Экспорт
	
