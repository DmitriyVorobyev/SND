	ПараметрыФормы.Вставить("КомпоновщикНастроек"  , КомпоновщикНастроек);
	ПараметрыФормы.Вставить("Режим"                , "Выбор");
	ПараметрыФормы.Вставить("Событие"         	   , "Добавление");
	ПараметрыФормы.Вставить("ИсключенныеПоля"      , Форма.ПолучитьЗапрещенныеПоля("Выбор"));
	ПараметрыФормы.Вставить("ТекущаяСтрока"        , Неопределено);
	ПараметрыФормы.Вставить("ИсточникИД"  		   , Форма.УникальныйИдентификатор);
		
	ОткрытьФорму("ОбщаяФорма.упоФормаВыбораДоступногоПоля", ПараметрыФормы);
	
