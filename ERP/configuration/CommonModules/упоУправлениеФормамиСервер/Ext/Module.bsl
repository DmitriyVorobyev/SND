// Заполняет информацию по трудовому ресуру в строке.
//
// Параметры:
//  СтрокаТабличнойЧасти - ДанныеФормыЭлементКоллекции - строка табличной части.
//  ПараметрыПодбора	 - Структура - параметры подбора.
//  Объект				 - Произвольный - объект или ссылка на обьъект, содержащий табличную часть.
//  мДанные				 - Произвольный - не используется.
//  ДопПараметрыПодбора	 - Произвольный - не используется.
//
Процедура ЗаполнитьИнформациюТрудовыеРесурыВСтроке(СтрокаТабличнойЧасти,
												   ПараметрыПодбора,
												   Объект,
												   мДанные,
												   ДопПараметрыПодбора) Экспорт
	
	ПриИзмененииРесурсаТабЧастиВызовСервера(СтрокаТабличнойЧасти, Объект, Объект.НормаСтоимостиТрудовыхРесурсов);
	СтрокаТабличнойЧасти.ПрофильРаспределения =
		Справочники.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение;

	Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Подразделение) Тогда
	   СтрокаТабличнойЧасти.Подразделение = 
	   	упоУправлениеФормамиСервер.ПолучитьПодразделениеРолиВызовСервера(СтрокаТабличнойЧасти.Ресурс);
	КонецЕсли;
			
КонецПроцедуры

// Функция возвращает строку календаря
//
// Параметры:
//  ДатаНач					 - Дата					 - дата начала, от которой считается задержка.
//  КоличествоДней			 - Число				 - количество дней задержки.
//  Календарь				 - СправочникСсылка.упоРабочиеКалендари	 - календарь, на основании которого считается задержка.
//  таблицаКалендаря		 - ТаблицаЗначений						 - талица календаря.
//  таблицаКалендаряПолные	 - ТаблицаЗначений						 - талица календаря.
// 
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - Строка ТЗ таблицаКалендаря.
//
Функция НайтиСтрокуДня(ДатаНач, КоличествоДней, Календарь, таблицаКалендаря, таблицаКалендаряПолные) Экспорт
	
	пДень = ДатаНач;
	
	Если таблицаКалендаря = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	строкаДня = таблицаКалендаря.Найти(НачалоДня(пДень), "День");
	
	Если ЗначениеЗаполнено(строкаДня) Тогда
		Возврат строкаДня;
	КонецЕсли;
	
	// Не нашли строку дня - проверим, а вдруг это просто не рабочий день недели
	Если таблицаКалендаряПолные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	строкаДняПолные = таблицаКалендаряПолные.Найти(НачалоДня(пДень), "День");
	Если строкаДняПолные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Все-таки нашли.
	// Тогда в зависимости от задержки найдем близлежайший рабочий день.
	// Если задержка "-" тогда идем вверх иначе вниз.
	индексСтроки = таблицаКалендаряПолные.Индекс(строкаДняПолные);
	новаяСтрока = Неопределено;
	Пока Истина Цикл
		Если КоличествоДней < 0 Тогда
			индексСтроки = индексСтроки + 1;
		Иначе
			индексСтроки = индексСтроки - 1;
		КонецЕсли;
		
		Если индексСтроки < 0 Тогда
			сохрДата = таблицаКалендаряПолные[0].День;
			увелДата = ДобавитьМесяц(таблицаКалендаряПолные[0].День, -1);
			Если НЕ УвеличитьКалендарь(увелДата, Календарь, таблицаКалендаря, таблицаКалендаряПолные) Тогда
				НСтрока = НСтр("ru = 'Нет календаря на дату: %1 по календарю %2'");
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, увелДата, Календарь);
				Сообщение.Сообщить();
				Прервать;
			КонецЕсли;
			
			строкаСохр = таблицаКалендаряПолные.Найти(сохрДата, "День");
			индексСтроки = таблицаКалендаряПолные.Индекс(строкаСохр) - 1;
		ИначеЕсли индексСтроки > таблицаКалендаряПолные.Количество() - 1 Тогда
			сохрДата = таблицаКалендаряПолные[таблицаКалендаряПолные.Количество() - 1].День;
			увелДата = ДобавитьМесяц(таблицаКалендаряПолные[таблицаКалендаряПолные.Количество() - 1].День, 1);
			Если НЕ УвеличитьКалендарь(увелДата, Календарь, таблицаКалендаря, таблицаКалендаряПолные) Тогда
				НСтрока = НСтр("ru = 'Нет календаря на дату: %1 по календарю %2'");
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, увелДата, Календарь);
				Сообщение.Сообщить();
				Прервать;
			КонецЕсли;
			
			строкаСохр = таблицаКалендаряПолные.Найти(сохрДата, "День");
			индексСтроки = таблицаКалендаряПолные.Индекс(строкаСохр) + 1;
		КонецЕсли;
		
		новаяСтрока = таблицаКалендаряПолные[индексСтроки];
		Если новаяСтрока.КоличествоЧасов > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если новаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат таблицаКалендаря.Найти(новаяСтрока.День, "День");
	
КонецФункции
 
// Функция к уже имеющимся данным календаря добавляет новые записи
//
// Параметры: 
//  ДопДата					 - Дата 		   - дата на которую увеличиваем календать.
//  Календарь				 - СправочникСсылка.упоРабочиеКалендари - календарь, на основании которого считается задержка.
//  таблицаКалендаря		 - ТаблицаЗначений - талица календаря.
//  таблицаКалендаряПолные	 - ТаблицаЗначений - талица календаря.
//
// Возвращаемое значение:
//	Булево - Признак удалось ли найти календарь на указанную дату.
//
Функция УвеличитьКалендарь(ДопДата, Календарь, таблицаКалендаря, таблицаКалендаряПолные) Экспорт
	
	допТаблицаКалендаря = мПолучитьРабочийКалендарь(Календарь, ДопДата);
	Если допТаблицаКалендаря = Неопределено Тогда
		Возврат Ложь; 
	КонецЕсли;
	
	Если ТаблицаКалендаря = Неопределено Тогда
		ТаблицаКалендаря = допТаблицаКалендаря.Скопировать();
		ТаблицаКалендаря.Индексы.Добавить("День");
	Иначе
		Для каждого лСтрока Из допТаблицаКалендаря Цикл
	    	новаяСтрока = ТаблицаКалендаря.Добавить();
			ЗаполнитьЗначенияСвойств(новаяСтрока, лСтрока);
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаКалендаря.Сортировать("День");
	
	// Календарь полный со всеми днями
	допТаблицаКалендаряПолные = мПолучитьРабочийКалендарь(Календарь, ДопДата, Ложь);
	Если допТаблицаКалендаряПолные = Неопределено Тогда
		Возврат Ложь; 
	КонецЕсли;
	
	Если ТаблицаКалендаряПолные = Неопределено Тогда
		ТаблицаКалендаряПолные = допТаблицаКалендаряПолные.Скопировать();
		ТаблицаКалендаряПолные.Индексы.Добавить("День");
	Иначе
		Для каждого лСтрока Из допТаблицаКалендаряПолные Цикл
	    	новаяСтрока = ТаблицаКалендаряПолные.Добавить();
			ЗаполнитьЗначенияСвойств(новаяСтрока, лСтрока);
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаКалендаряПолные.Сортировать("День");
	
	Возврат Истина;
	
КонецФункции

// Рассчитывает задержку по календарю от даты.
//
// Параметры:
//  ДатаНачала	 - Дата		 - дата начала, от которой считается задержка.
//  ДатаЗаказа	 - Дата		 - дата заказа, до которой считается задержка.
//  Проект		 - СправочникСсылка.Проекты	 - проект, на основании которого считается календарь.
// 
// Возвращаемое значение:
//  Структура, Неопределено - дата, рассчитанная как дата начала плюс количество дней с учетом календаря.
//
Функция РассчитатьЗадержкуПоКалендарюСтрокиТаблицы(Знач ДатаНачала, Знач ДатаЗаказа, Проект) Экспорт 
	
	ДатаНачала = НачалоДня(ДатаНачала);
	ДатаЗаказа = НачалоДня(ДатаЗаказа);
	
	Календарь = упоПроектыИЗадачиВызовСервера.обПолучитьБанковскийКалендарьПроекта(Проект);
	
	Знак = ?(ДатаНачала > ДатаЗаказа, -1, 1);
	
	ТаблицаКалендаря = Неопределено;
	ТаблицаКалендаряПолные = Неопределено;	
	СтрокаДня = Неопределено;
	
	ШаблонСообщения = НСтр("ru = 'Нет календаря на дату: %1 по календарю %2'");
	
	Если Не УвеличитьКалендарь(ДатаНачала, Календарь, ТаблицаКалендаря, ТаблицаКалендаряПолные) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДатаНачала, Календарь);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
		
	СтрокаДатыНачала = НайтиСтрокуДня(ДатаНачала, 0, Календарь, ТаблицаКалендаря, ТаблицаКалендаряПолные);
	СтрокаДня = НайтиСтрокуДня(ДатаЗаказа, 0, Календарь, ТаблицаКалендаря, ТаблицаКалендаряПолные);
	
	множитель = 1;
	Пока СтрокаДня = Неопределено Цикл
		
		УвеличиваемаяДата = ДобавитьМесяц(ДатаНачала, Знак * 12 * множитель);
		Если Не УвеличитьКалендарь(УвеличиваемаяДата, Календарь, ТаблицаКалендаря, ТаблицаКалендаряПолные) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, УвеличиваемаяДата, Календарь);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Неопределено;
		КонецЕсли;
		
		множитель = множитель + 1;
		СтрокаДня = НайтиСтрокуДня(ДатаЗаказа, 0, Календарь, ТаблицаКалендаря, ТаблицаКалендаряПолные);
		
	КонецЦикла;
	
	НайденнаяДата = СтрокаДня.День;
	Задержка = ТаблицаКалендаря.Индекс(СтрокаДня) - ТаблицаКалендаря.Индекс(СтрокаДатыНачала);	
	
	Возврат Новый Структура("ДатаПоКалендарю, Задержка", НайденнаяДата, Задержка);  
	
КонецФункции

