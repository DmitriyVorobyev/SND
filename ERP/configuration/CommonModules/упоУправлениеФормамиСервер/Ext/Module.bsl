// Получает объект по данным формы.
//
// Параметры:
//  ДанныеФормыОбъект	 - ДанныеФормыСтруктура - структура данных формы.
//
// Возвращаемое значение:
//	Произвольный - ссылка на объект или сам объект.
//
Функция ПолучитьОбъектПоДаннымФормы(ДанныеФормыОбъект) Экспорт
		
	тТип = ВернутьСтрокуТипа(ДанныеФормыОбъект, Истина, "Объект");	
	
	Возврат ДанныеФормыВЗначение(ДанныеФормыОбъект, Тип(тТип));
	
КонецФункции

// Проверяет, новый объект или нет по форме.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма - форма.
//
// Возвращаемое значение:
//	Булево - признак того, новй объект или нет.
//
Функция ЭтоНовый(ЭтаФорма) Экспорт
	
	Если ЭтаФорма.Параметры.Ключ.Пустая() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Возвращает строковое представление типа.
//
// Параметры:
//  Предмет		 - Произвольный - объект или структура, содержащие ссылку на объект, для которого надо
//					получить строкое представление.
//  УказыватьТип - Булево		- признак необходимости указывать в возвращаемой строке тип (документ или
//					Справочник).
//  СсылкаОбъект - Строка 		- "Ссылка" или "Объект".
//
// Возвращаемое значение:
//	Строка - представление типа.
//
Функция ВернутьСтрокуТипа(Предмет, УказыватьТип = Истина, СсылкаОбъект = "Ссылка") Экспорт
	
	сТип = "";
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Предмет.Ссылка)) Тогда
		сТип = "Документ";	   
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Предмет.Ссылка)) Тогда
		сТип = "Справочник";
	КонецЕсли;
	XMLТип = XMLТипЗнч(Предмет.Ссылка);
	Если УказыватьТип Тогда
		сТип = сТип+СсылкаОбъект+".";	
	Иначе
		сТип = "";
	КонецЕсли;
	
	Возврат сТип + Прав(XMLТип.ИмяТипа, СтрДлина(XMLТип.ИмяТипа) -  Найти(XMLТип.ИмяТипа,"."));
	
КонецФункции

// Возвращает список оснований объекта.
//
// Параметры:
//  ДанныеФормыОбъект	 - ДанныеФормыСтруктура - данные объекта.
//
// Возвращаемое значение:
//	СписокЗначений - список оснований объекта.
//
Функция ВернутьСписокОснованийОбъекта(Знач ДанныеФормыОбъект) Экспорт
	
	Список = Новый СписокЗначений;
	Объект = ПолучитьОбъектПоДаннымФормы(ДанныеФормыОбъект);
	Для Каждого ОбъектМетаданных Из Объект.Метаданные().ВводитсяНаОсновании Цикл
		Если РазделМетаданныхСодержатОбъект("Документы", ОбъектМетаданных) Тогда
			Объект = Документы[ОбъектМетаданных.Имя].ПустаяСсылка();
			Список.Добавить(Объект, ТипЗнч(Объект));
		ИначеЕсли РазделМетаданныхСодержатОбъект("Справочники",ОбъектМетаданных) Тогда
			Объект = Справочники[ОбъектМетаданных.Имя].ПустаяСсылка();
			Список.Добавить(Объект, ТипЗнч(Объект));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции       

// Везаращает список типов реквизита объекта.
//
// Параметры:
//  ДанныеФормыОбъект	 - ДанныеФормыСтруктура - данные объекта.
//  ИмяРеквизита		 - Строка				- имя реквизита.
//
// Возвращаемое значение:
//	СписокЗначений - список типов реквизита объекта.
//
Функция ВернутьСписокТиповРеквизитаОбъекта(Знач ДанныеФормыОбъект, ИмяРеквизита) Экспорт
	
	Объект = ПолучитьОбъектПоДаннымФормы(ДанныеФормыОбъект);

	Список = Новый СписокЗначений;
	
	Для Каждого ТипРеквизита Из Объект.Метаданные().Реквизиты[ИмяРеквизита].Тип.Типы() Цикл
	
		Список.Добавить(Новый(ТипРеквизита), ТипРеквизита);
		
	КонецЦикла;
		
	Возврат Список;	
	
КонецФункции       

// Рассчитывает задержку по календарю от даты.
//
// Параметры:
//  ДатаНач					 - Дата 			- дата начала, от которой считается задержка.
//  КоличествоДней			 - Число 			- количество дней задержки.
//  пКалендарь				 - СправочникСсылка.упоРабочиеКалендари - календарь, на основании которого считается задержка.
//  таблицаКалендаря		 - ТаблицаЗначений 	- талица календаря.
//  таблицаКалендаряПолные	 - ТаблицаЗначений 	- талица календаря.
//  ВыводитьСообщения		 - Булево 			- признак необходимости вывода служебных сообщений.
//
// Возвращаемое значение:
//	Дата, Неопределено - дата, рассчитанная как дата начала плюс количество дней с учетом календаря.
//
Функция РассчитатьЗадержкуПоКалендарю(ДатаНач,
									  КоличествоДней,
									  пКалендарь,
									  таблицаКалендаря = Неопределено,
									  таблицаКалендаряПолные = Неопределено,
									  ВыводитьСообщения = Ложь) Экспорт 
										
	  таблицаКалендаряКопия = таблицаКалендаря;
	  таблицаКалендаряПолныеКопия = таблицаКалендаряПолные;
	  
	  Возврат обРассчитатьЗадержкуПоКалендарю(ДатаНач,
											  КоличествоДней, 
											  пКалендарь, 
											  таблицаКалендаряКопия , 
											  таблицаКалендаряПолныеКопия, 
											  ВыводитьСообщения);						
	  										
КонецФункции
									
// Возвращает структуру дополнительных параметров подбора. 
//
// Возвращаемое значение:
//	Структура - дополнительные параметры подбора. Свойства:
//		* ВалютаУправленческогоУчета 	- СправочникСсылка.Валюты 
//		* РежимИнтеграции_УПО 			- Булево
//
Функция ДозаполнитьПараметрыПодбора() Экспорт
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ВалютаУправленческогоУчета", ПараметрыСеанса.упоВалютаУправленческогоУчета);
	ПараметрыПодбора.Вставить("РежимИнтеграции_УПО", упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПО());
	
	Возврат ПараметрыПодбора;
	 
КонецФункции

