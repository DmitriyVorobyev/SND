// Проверяет документ-основание и устанавливает надпись документа-основания
// и прочие свойства.
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, СправочникСсылка, СправочникОбъект - объект.
//  Форма					 - УправляемаяФорма - форма объекта.
//  ИмяРеквизитаОснования	 - Строка 			- имя реквизита, содержащего ссылку на документ-основание.
//  ТекстНадписи			 - Строка 			- текст надписи. Если параметр указан, то подставляется он.
//
Процедура ПроверитьДокументОснование(Объект,
									 Форма,
									 ИмяРеквизитаОснования = "ДокументОснование",
									 ТекстНадписи = Неопределено) Экспорт
									 
	
	ГиперссылкаЭлемент = Форма.Элементы["Надпись" + ИмяРеквизитаОснования];
	
	// Если оснований много, проверим что выбран тип основания.
	Если Не Объект[ИмяРеквизитаОснования] = Неопределено Тогда
		Если Не Объект[ИмяРеквизитаОснования].Пустая() Тогда
			// стандартный вид гиперссылки
			ГиперссылкаЭлемент.ЦветТекста = ВернутьЦветСтиля("ЦветТекстаФормы");
			Форма["Надпись" + ИмяРеквизитаОснования] =  ПолучитьСтроковоеПредставление(Объект[ИмяРеквизитаОснования]);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// Укажем пользователю на необходимость выбрать документ-основание
	ГиперссылкаЭлемент.ЦветТекста = ВернутьЦветСтиля("ЦветОсобогоТекста");
	Форма["Надпись" + ИмяРеквизитаОснования] = ?(ТекстНадписи = Неопределено,
		"Не выбран " + ВернутьПредставлениеДокументОснование(Объект, ИмяРеквизитаОснования) + ". Нажмите здесь для выбора.",
		?(ТипЗнч(ТекстНадписи)=Тип("Строка"), ТекстНадписи, ""));
	
КонецПроцедуры 

// Заполняет надпись-гиперссылку на форме.
//
// Параметры:
//  Объект					 - ДокументСсылка, ДокументОбъект, СправочникСсылка, СправочникОбъект, ДанныеФормыСтруктура - объект.
//  Форма					 - УправляемаяФорма - форма объекта.
//  ИмяРеквизита			 - Строка			- необязательный. Имя реквизита.
//  ПредставлениеРеквизита	 - Строка 			- необязательный. Представление реквизита.
//  ПредставлениеСостояния	 - Строка			- необязательный. Представление состояния.
//  ПроверятьПустойРеквизит	 - Булево			- необязательный. Признак необходимости проверять пустой реквизит или нет.
//
Процедура ЗаполнитьГиперссылку(Объект,
							   Форма,
							   ИмяРеквизита = "Проект",
							   ПредставлениеРеквизита = "проект", 
							   ПредставлениеСостояния = "выбран", 
							   ПроверятьПустойРеквизит = Истина) Экспорт

	ГиперссылкаЭлемент = Форма.Элементы["Надпись" + ИмяРеквизита];
	
	// Если оснований много, проверим что выбран тип основания.
	Если Не Объект[ИмяРеквизита] = Неопределено Тогда
		Если Не Объект[ИмяРеквизита].Пустая() Тогда
			// стандартный вид гиперссылки
			ГиперссылкаЭлемент.ЦветТекста = ВернутьЦветСтиля("ЦветТекстаФормы");
			Форма["Надпись" + ИмяРеквизита] =  ПолучитьСтроковоеПредставление(Объект[ИмяРеквизита]);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьПустойРеквизит Тогда
		// Укажем пользователю на необходимость выбрать документ-основание
		ГиперссылкаЭлемент.ЦветТекста = ВернутьЦветСтиля("ЦветОсобогоТекста");
		Форма["Надпись" + ИмяРеквизита] = "Не " + ПредставлениеСостояния + " " 
							  + ПредставлениеРеквизита
							  + ". Нажмите здесь для выбора.";
	Иначе
		ГиперссылкаЭлемент.ЦветТекста = ВернутьЦветСтиля("ЦветТекстаФормы");
		Форма["Надпись" + ИмяРеквизита] = "";
	КонецЕсли;

КонецПроцедуры 

// Получает представление реквизита объекта.
//
// Параметры:
//  Объект					 - Произволльный 	- объект, для которого надо получить представление реквизита по его имени.
//  ИмяРеквизитаОснования	 - Строка 			- имя реквизита.
//
// Возвращаемое значение:
//	Строка - представление реквизита.
//
Функция ВернутьПредставлениеДокументОснование(Объект, ИмяРеквизитаОснования) Экспорт
	
	тОбъект = ПолучитьОбъектПоДаннымФормы(Объект);
	
	Возврат Нрег(СокрЛП(тОбъект.Метаданные().Реквизиты[ИмяРеквизитаОснования].Представление()));
	
КонецФункции

