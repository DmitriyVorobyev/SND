	ПараметрВыводитьПЗ = СхемаКомпоновкиДанных.Параметры.Добавить();
	ПараметрВыводитьПЗ.Заголовок = НСтр("ru = 'Выводить проектные задачи'");
	ПараметрВыводитьПЗ.Имя = "ВыводитьПроектныеЗадачи";
	
	ПараметрВыводитьПз.ТипЗначения = Новый ОписаниеТипов(МассивТиповБулево);
	ПараметрВыводитьПЗ.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
	ПараметрВыводитьПЗ.Значение = Истина; 
	
	ПараметрВыводитьБезПоказателей = СхемаКомпоновкиДанных.Параметры.Добавить();
	ПараметрВыводитьБезПоказателей.Заголовок = НСтр("ru = 'Выводить только с ненулевыми показателями'");
	ПараметрВыводитьБезПоказателей.Имя = "ВыводитьТолькоСНенулевымиПоказателями";
	
	ПараметрВыводитьБезПоказателей.ТипЗначения = Новый ОписаниеТипов(МассивТиповБулево);
	ПараметрВыводитьБезПоказателей.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
	ПараметрВыводитьБезПоказателей.Значение = Ложь; 
	
КонецПроцедуры

Процедура ДобавитьРесурсы(СхемаКомпоновкиДанных, ТаблицаИндикаторов)
	
	Для Каждого ЭлементРесурс Из ТаблицаИндикаторов Цикл 
		
		
		Если ЭлементРесурс.СсылкаНаПоказатель.ТипИндикатора = Перечисления.упоТипИндикатора.Строка
			И Не ЭлементРесурс.Группировки Тогда 
			
			ВыражениеРесурса = "ВЫБОР КОГДА МАКСИМУМ("+ЭлементРесурс.ИмяПоказателя+") = МИНИМУМ("+ЭлементРесурс.ИмяПоказателя+") ТОГДА "+ЭлементРесурс.ИмяПоказателя+" ИНАЧЕ ВЫБОР КОГДА
			| УровеньВГруппировке() > 0 ТОГДА " + ЭлементРесурс.ИмяПоказателя
			+ " ИНАЧЕ """" КОНЕЦ КОНЕЦ";
			
		ИначеЕсли ЭлементРесурс.Группировки
			И Не СокрЛП(ЭлементРесурс.ВыражениеГруппировки) = "Формула" Тогда
			
			Если СтрДлина(СокрЛП(ЭлементРесурс.ВыражениеГруппировки)) = 0 Тогда
				
				ВыражениеГруппировки = "Сумма";
				
			Иначе 
				
				ВыражениеГруппировки = ЭлементРесурс.ВыражениеГруппировки;
				
			КонецЕсли;
			
			ВыражениеРесурса = ВыражениеГруппировки + "(" + ЭлементРесурс.ИмяПоказателя + ")";				
			
		Иначе
			
			ВыражениеРесурса = ЭлементРесурс.ИмяПоказателя;
			
		КонецЕсли;
		
		Если СхемаКомпоновкиДанных.ПоляИтога.Найти(ЭлементРесурс.ИмяПоказателя)  = Неопределено Тогда
			
			НовыйРесурс = СхемаКомпоновкиДанных.ПоляИтога.Добавить();
			НовыйРесурс.Выражение = ВыражениеРесурса;
			НовыйРесурс.ПутьКДанным = ЭлементРесурс.ИмяПоказателя;
			
			ДобавитьГруппировкиПоляИтогов(ЭлементРесурс, НовыйРесурс);
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ДобавитьПоляВыбора(ВыборЭлементы, ТаблицаРесурсов);
	
	Для Каждого ЭлементГруппировки Из ТаблицаРесурсов Цикл
		
		Если ЭлементГруппировки.ТолькоВФормуле =Ложь Тогда
			
			НовоеПолеПоказатель = ВыборЭлементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			НовоеПолеПоказатель.Заголовок = ЭлементГруппировки.ЗаголовокПоказателя;
			НовоеПолеПоказатель.Поле = Новый ПолеКомпоновкиДанных(ЭлементГруппировки.ИмяПоказателя);		
			НовоеПолеПоказатель.Использование = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИзФормул(ЭтаФорма,ВыбранныеИндикаторы, ТаблицаИндикаторов)
	
	Для Каждого СтрокаИндикатора Из ТаблицаИндикаторов Цикл
		
		Если СтрокаИндикатора.ЭтоФормула Тогда
			
			Для Каждого СтрокаРасчетногоПоказателя Из СтрокаИндикатора.СсылкаНаПоказатель.РасчетныеИндикаторы Цикл
				
				ДобавитьИндикаторыИзРасчетных(ЭтаФорма,ВыбранныеИндикаторы, ТаблицаИндикаторов, СтрокаРасчетногоПоказателя.Индикатор);		
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьФормулы(ТаблицаИндикаторов)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ЭтоФормула", Истина);
	
	ТаблицаКопия = ТаблицаИндикаторов.Скопировать(Отбор);
	
	ТаблицаКопия.Колонки.Добавить("СписокВФормуле");
	ТаблицаКопия.Колонки.Добавить("ВФормулахЕстьФормулы", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаКопии Из ТаблицаКопия Цикл
		
		СтрокаКопии.СписокВФормуле = Новый СписокЗначений;
		ВФормулахЕстьФормулы = Ложь;
		
		Для Каждого РасчетныйПоказатель Из СтрокаКопии.СсылкаНаПоказатель.РасчетныеИндикаторы Цикл
			
			СтрокаКопии.СписокВФормуле.Добавить(РасчетныйПоказатель.Индикатор);
			
			Если РасчетныйПоказатель.Индикатор.ТипЗаполнения = 1 Тогда
				
				ВФормулахЕстьФормулы = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаКопии.ВФормулахЕстьФормулы = ВФормулахЕстьФормулы;
		
	КонецЦикла;
	
	ВФормулахЕстьФормулы = Истина;	
	Счетчик = 1;
	
	ФормулыОбработаныУспешно = Истина;
	
	Пока ВФормулахЕстьФормулы Цикл
		
		Счетчик = Счетчик + 1;
		
		Если Счетчик = 1000 Тогда
			
			ФормулыОбработаныУспешно = Ложь;
			
			Прервать;
			
		КонецЕсли;
		
		ТаблицаКопия.Сортировать("ВФормулахЕстьФормулы Возр");
		
		Для Каждого СтрокаФормулы Из  ТаблицаКопия Цикл
			
			СписокОставшихсяФормул = Новый СписокЗначений;
			
			Для Каждого ЭлементРасчетногоИндикатора Из СтрокаФормулы.СписокВФормуле Цикл
				
				Если  ЭлементРасчетногоИндикатора.Значение.ТипЗаполнения = 1 Тогда
					
					СписокОставшихсяФормул.Добавить(ЭлементРасчетногоИндикатора.Значение);
					
				Иначе
					
					ПредставлениеИндикатора = ТаблицаИндикаторов.Найти(ЭлементРасчетногоИндикатора.Значение,
						"СсылкаНаПоказатель").ИмяПоказателя;	
					Если ЗначениеЗаполнено(ЭлементРасчетногоИндикатора.Значение.ВыражениеГруппировки) Тогда
						ПредставлениеИндикатора = ЭлементРасчетногоИндикатора.Значение.ВыражениеГруппировки + "("+ПредставлениеИндикатора+")";			
					КонецЕсли;	
					СтрокаФормулы.ФормулаРасчета = СтрЗаменить(СтрокаФормулы.ФормулаРасчета,
						"[" + ЭлементРасчетногоИндикатора.Значение.Наименование + "]", ПредставлениеИндикатора);
					
				КонецЕсли;
				
				ВФормулахЕстьФормулы = Ложь;
				
				Для Каждого ЭлементПоФормуле Из СписокОставшихсяФормул Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("СсылкаНаПоказатель",   ЭлементПоФормуле.Значение);
					Отбор.Вставить("ВФормулахЕстьФормулы",   Ложь);
					
					НайденныеСтроки = ТаблицаКопия.НайтиСтроки(Отбор);
					
					Если НайденныеСтроки.Количество() = 0 Тогда
						
						ВФормулахЕстьФормулы = Истина;
						
					Иначе
						
						Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
							
							ПредставлениеИндикатора = НайденнаяСтрока.ФормулаРасчета;
							
							Если ЗначениеЗаполнено(ЭлементРасчетногоИндикатора.Значение.ВыражениеГруппировки) Тогда
								
								Если ЭлементРасчетногоИндикатора.Значение.ВыражениеГруппировки <> "Формула" Тогда								
									ПредставлениеИндикатора = ЭлементПоФормуле.Значение.ВыражениеГруппировки + "("+ПредставлениеИндикатора+")";
								КонецЕсли;
									
							КонецЕсли;
							
							СтрокаФормулы.ФормулаРасчета = СтрЗаменить(СтрокаФормулы.ФормулаРасчета,
								"[" + ЭлементПоФормуле.Значение.Наименование + "]", "(" + ПредставлениеИндикатора + ")");
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;
				
				СтрокаФормулы.ВФормулахЕстьФормулы = ВФормулахЕстьФормулы;
				
			КонецЦикла;			
			
		КонецЦикла;
		
		ВФормулахЕстьФормулы =  (ТаблицаКопия.НайтиСтроки(Новый Структура("ВФормулахЕстьФормулы", Истина)).Количество() > 0);
		
	КонецЦикла;
	
	Если ФормулыОбработаныУспешно = Ложь Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Обнаружены взаимозависимые показатели. Корректный расчет таких показателей невозможен'");
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	Для  Каждого СтрокаКопия Из ТаблицаКопия Цикл
		
		СтрокаФормулы =	 ТаблицаИндикаторов.Найти(СтрокаКопия.СсылкаНаПоказатель, "СсылкаНаПоказатель");
		
		Если СтрокаКопия.ВФормулахЕстьФормулы Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрокаКопия.СсылкаНаПоказатель;
			Сообщение.УстановитьДанные(СтрокаКопия.СсылкаНаПоказатель.ПолучитьОбъект());
			Сообщение.Сообщить();
			
			СтрокаФормулы.ФормулаРасчета = "0";
			
		Иначе
			 
			СтрокаФормулы.ФормулаРасчета = СтрокаКопия.ФормулаРасчета; 
						
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

