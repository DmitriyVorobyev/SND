// Формирует дерево показателей и помещает во временное хранилище.
//
// Параметры:
//  Параметры		 - Структура		 - Структура, ключи:
//  		* ОсновнаяСхемаКомпоновкиДанных - СхемаКомпоновкиДанных.
//  		* СписокПолей - СписокЗначений.
//  		* Настройки - НастройкиКомпоновкиДанных.
//  		* ДополнительныеНастройки - НастройкиКомпоновкиДанных.
//  		* СКД - СхемаКомпоновкиДанных.
//  АдресХранилища	 - Строка	 - адрес временного хранилища.
//
Процедура ПолучитьДеревоПоказателей(Параметры, АдресХранилища = "") Экспорт
	
	ДеревоОбъект = Новый ДеревоЗначений;

	ПроцессорКомпоновкиДанных = ПодготовитьСхемуСКД(Параметры, АдресХранилища);
	
	Если ПроцессорКомпоновкиДанных <> Неопределено Тогда
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		
		ПроцессорВывода.УстановитьОбъект(ДеревоОбъект);
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
		ДеревоОбъект.Колонки.ПроектЭтоПроектнаяЗадача.Имя = "ЭтоПроектнаяЗадача";
		
	КонецЕсли;
	
	Если АдресХранилища = "" Тогда
		АдресХранилища = ПоместитьВоВременноеХранилище(Новый Структура("ДеревоПоказателей", ДеревоОбъект));
	Иначе
		ПоместитьВоВременноеХранилище(Новый Структура("ДеревоПоказателей", ДеревоОбъект), АдресХранилища);
	КонецЕсли;

КонецПроцедуры

// Готовит схему СКД.
//
// Параметры:
//  Параметры			 - Структура - параметры схемы.
//  АдресХранилища		 - Строка	 - адрес временного хранилища.
//  КоличествоВложенных	 - Число	 - ограничение количества вложенных схем.
//  ДанныеРасшифровки	 - ДанныеРасшифровкиКомпоновкиДанных
// 
// Возвращаемое значение:
//  ПроцессорКомпоновкиДанных - процессор КД.
//
Функция ПодготовитьСхемуСКД(Параметры, АдресХранилища = "", КоличествоВложенных = 0, ДанныеРасшифровки = Неопределено) Экспорт
	
	СписокПолей 			= Параметры.СписокПолей;
	Настройки 				= Параметры.Настройки;
	ДополнительныеНастройки = Параметры.ДополнительныеНастройки;
	СКД 					= Параметры.СКД;
	
	ВыводитьТолькоСНенулевымиПоказателями = Неопределено;
	ВыводитьПроектныеЗадачи = Неопределено;
	НеВыводитьЭлементИерархииВПодчиненных = Неопределено;
	ОтдельныеЗапросыДляПроектовИЗадач = Неопределено;
	Параметры.Свойство("ВыводитьТолькоСНенулевымиПоказателями", ВыводитьТолькоСНенулевымиПоказателями);
	Параметры.Свойство("ВыводитьПроектныеЗадачи", ВыводитьПроектныеЗадачи);
	Параметры.Свойство("НеВыводитьЭлементИерархииВПодчиненных", НеВыводитьЭлементИерархииВПодчиненных);
	Параметры.Свойство("ОтдельныеЗапросыДляПроектовИЗадач", ОтдельныеЗапросыДляПроектовИЗадач);
	Если ВыводитьТолькоСНенулевымиПоказателями = Неопределено Тогда
		ВыводитьТолькоСНенулевымиПоказателями = Ложь;
	КонецЕсли;
	Если ВыводитьПроектныеЗадачи = Неопределено Тогда
		ВыводитьПроектныеЗадачи = Истина;
	КонецЕсли;
	Если НеВыводитьЭлементИерархииВПодчиненных = Неопределено Тогда
		НеВыводитьЭлементИерархииВПодчиненных = Ложь;
	КонецЕсли;
	Если ОтдельныеЗапросыДляПроектовИЗадач = Неопределено Тогда
		ОтдельныеЗапросыДляПроектовИЗадач = Ложь;
	КонецЕсли;
	
	ОбработатьОтборПоВидуОперацииРекурсивно(Параметры.ДополнительныеНастройки.Отбор.Элементы);
	
	СписокПроектов = ПолучитьСписокПроектов(Параметры, ВыводитьПроектныеЗадачи);
	
	ДопПараметры = Новый Соответствие;
	
	Текст = ПолучитьТекстЗапроса();
	
	ТекстПолей = "";
	ТекстСоединений = "
		|   ГДЕ 
		|   НЕ Проекты.ПометкаУдаления И Проекты.Ссылка В ИЕРАРХИИ (&СписокПроектов)
		|	И (("+?(НеВыводитьЭлементИерархииВПодчиненных,"НЕ &ВыводитьПроектныеЗадачи И ", "")+"НЕ Проекты.ЭтоПроектнаяЗадача)
		|	ИЛИ (&ВыводитьПроектныеЗадачи И Проекты.ЭтоПроектнаяЗадача И НЕ &ОтдельныеЗапросыДляПроектовИЗадач)
		|	ИЛИ (&ВыводитьПроектныеЗадачи И &ОтдельныеЗапросыДляПроектовИЗадач))
		|	И ВЫБОР
		|			КОГДА Проекты.ЭтоПроектнаяЗадача
		|				ТОГДА НЕ упоСвойстваПроектныхЗадачСрезПоследнихОтбор.ЗадачаОтменена
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
	
	Если НЕ СписокПолей.Количество() = 0 Тогда
		
		Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Индикаторы.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Индикаторы
		|ИЗ
		|	Справочник.упоПоказателиПроектов КАК Индикаторы
		|ГДЕ
		|	НЕ Индикаторы.ЭтоГруппа
		|	И Индикаторы.Ссылка В(&СписокИндикаторов)
		|;
		|" + Текст;
		
		ТекстЗапросаДляИндикаторов = ПолучитьТекстЗапросаДляИндикаторов(СписокПолей, 
			ДопПараметры, ВыводитьПроектныеЗадачи, ОтдельныеЗапросыДляПроектовИЗадач);
		
		ТекстСоединений = "
			|	ПОЛНОЕ СОЕДИНЕНИЕ Индикаторы КАК Индикаторы
			|	ПО ИСТИНА
			|	
			|	ЛЕВОЕ СОЕДИНЕНИЕ (" + ТекстЗапросаДляИндикаторов + ") КАК ЗначенияИндикаторов
			|	ПО Индикаторы.Ссылка = ЗначенияИндикаторов.Индикатор
			|		И Проекты.Ссылка = ЗначенияИндикаторов.Объект" + ТекстСоединений;
		
		ТекстПолей = ",
			|	Индикаторы.Ссылка КАК Показатель,
			|	ПРЕДСТАВЛЕНИЕ(Индикаторы.Ссылка),
			|	ЗначенияИндикаторов.ЗначениеИндикатора КАК ЗначениеПоказателя,
			|	Индикаторы.Ссылка.СчитатьСуммуПоГруппировкам КАК СчитатьСуммуПоГруппировкам
			|";
		
		Текст = Текст + " ИТОГИ  
			|//ИТОГОВОЕПОЛЕ
			|ПО Объект";
	
	КонецЕсли;
	
	Текст = СтрЗаменить(Текст, "//ПОКАЗАТЕЛИ", ТекстПолей);
	Текст = СтрЗаменить(Текст, "//СОЕДИНЕНИЕ_ПОКАЗАТЕЛЕЙ", ТекстСоединений);
	
	ТаблицаПоказателейИндикаторов = СоздатьПустуюТаблицуПоказателейИндикаторов();
	
	Для Каждого СтрокаПоказателя Из СписокПолей Цикл
		
		ДанныеПоказателя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаПоказателя.Значение, "ТипИндикатора, ТипСсылки, Наименование");
		Если ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Булево");
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Дата");
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Строка");
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
			КЧ = Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой);
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов("Число", КЧ);
		ИначеЕсли ДанныеПоказателя.ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда	
			МассивТипов = упоПанельПоказателейКлиентСервер.ПолучитьМассивТиповПоТипуСсылки(ДанныеПоказателя.ТипСсылки);
			ОписаниеТиповПоляПоказателя = Новый ОписаниеТипов(МассивТипов);			
		КонецЕсли;
		
		ТаблицаПоказателейИндикаторов.Колонки.Добавить(
			СтрокаПоказателя.Представление, ОписаниеТиповПоляПоказателя, ДанныеПоказателя.Наименование, 16);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	
	Запрос.УстановитьПараметр("СписокПроектов", СписокПроектов);
	
	Для Каждого допПараметр Из ДопПараметры Цикл
		Запрос.УстановитьПараметр(допПараметр.Ключ, допПараметр.Значение);
	КонецЦикла;
	
	// Установка параметра ТекДата нужна для расчета показателей ФОТ. Аналогичное получение текущей даты использовано
	// в процедуре ЗагрузитьПроектИзБазыИПолучитьДопПеременные формы обработки упоУпрощенныйВводСтруктурыПроекта.
	ТекДата = упоПоказателиПроектовСервер.ПолучитьТекДатуДляПоказателейФОТ();
	Запрос.УстановитьПараметр("ТекДата", ТекДата);
			
	Запрос.УстановитьПараметр("ПустойРуководитель", Справочники.упоСотрудники.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойСтатус", Перечисления.упоСостояниеСтатусаПроекта.ПустаяСсылка());
	Запрос.УстановитьПараметр("СписокИндикаторов", СписокПолей);
	Запрос.УстановитьПараметр("ВыводитьПроектныеЗадачи", ВыводитьПроектныеЗадачи);
	Запрос.УстановитьПараметр("ОтдельныеЗапросыДляПроектовИЗадач", ОтдельныеЗапросыДляПроектовИЗадач);
	Запрос.УстановитьПараметр("ТекДатаСеанса", ТекущаяДатаСеанса());
	
	// Строки, у которых все показатели  = null удаляем только после обработки
 	// результата запроса, иначе будет вылезать ошибка в вычисляемых полях.
	МассивСтрокНаУдаление = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрокаПоказателейИндикаторов = ТаблицаПоказателейИндикаторов.Добавить();
		НоваяСтрокаПоказателейИндикаторов.Проект = Выборка.Объект;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПоказателейИндикаторов, Выборка);
		
		ВыборкаПолей = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "");
		
		ЕстьНеNULL = Ложь;
		
		Пока ВыборкаПолей.Следующий() Цикл
			
			НетГруппировки = ПроверитьГруппировкуПоПроекту(Выборка.Объект,
				ВыводитьПроектныеЗадачи,
				ОтдельныеЗапросыДляПроектовИЗадач,
				ВыборкаПолей.ЭтоПроектнаяЗадача,
				ВыборкаПолей.СчитатьСуммуПоГруппировкам);
				
			Если НетГруппировки Тогда
				Продолжить;
			КонецЕсли;	
			
			Если ВыборкаПолей.Показатель = Null Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВыборкаПолей.ЗначениеПоказателя <> Null Тогда
				ЕстьНеNULL = Истина;
			КонецЕсли;
			
			ПредставлениеИндикатора = СписокПолей.НайтиПоЗначению(ВыборкаПолей.Показатель).Представление;
			НоваяСтрокаПоказателейИндикаторов[ПредставлениеИндикатора] = ВыборкаПолей.ЗначениеПоказателя;
			НоваяСтрокаПоказателейИндикаторов.СтатусПроекта = ВыборкаПолей.СтатусПроекта;
			НоваяСтрокаПоказателейИндикаторов.РуководительПроекта = ВыборкаПолей.РуководительПроекта;
			НоваяСтрокаПоказателейИндикаторов.КураторПроекта = ВыборкаПолей.КураторПроекта;
			НоваяСтрокаПоказателейИндикаторов.ЭтоВеха = ВыборкаПолей.ЭтоВеха;
			НоваяСтрокаПоказателейИндикаторов.ЭтоМодельПакетаРабот = ВыборкаПолей.ЭтоМодельПакетаРабот;
			НоваяСтрокаПоказателейИндикаторов.КодСДРВПрограмме = ВыборкаПолей.КодСДРВПрограмме;
			НоваяСтрокаПоказателейИндикаторов.ВидОперации = ВыборкаПолей.ВидОперации;
			НоваяСтрокаПоказателейИндикаторов.ОбъектПЗ = ВыборкаПолей.ОбъектПЗ;
			НоваяСтрокаПоказателейИндикаторов.ОбъектПроекта = ВыборкаПолей.ОбъектПроекта;
		КонецЦикла;
		
		Если НЕ ЕстьНеNULL Тогда
			
			Если ВыводитьТолькоСНенулевымиПоказателями Тогда
				МассивСтрокНаУдаление.Добавить(НоваяСтрокаПоказателейИндикаторов);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаНаУдаление Из МассивСтрокНаУдаление Цикл		
		ТаблицаПоказателейИндикаторов.Удалить(СтрокаНаУдаление);	
	КонецЦикла;
	
	ЗаполнитьПоказателиПредшественниковВТаблицеПоказателей(ТаблицаПоказателейИндикаторов, СписокПолей);
		
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("Основной", ТаблицаПоказателейИндикаторов);

	НастройкиКомпоновки = ДополнительныеНастройки;
	
	Если СписокПолей.Количество() = 0 Тогда
		врКомпоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
		врКомпоновщик.ЗагрузитьНастройки(ДополнительныеНастройки);
		врНастройкиКомпоновки = врКомпоновщик.ПолучитьНастройки();
		НастройкиКомпоновки.Отбор.Элементы.Очистить();
		
		ДопПараметры = Новый Структура("НеКопироватьПоказатели", Истина);
		упоТиповыеОтчетыСервер.СкопироватьОтборВНастройки(врНастройкиКомпоновки.Отбор.Элементы, НастройкиКомпоновки.Отбор.Элементы, ДопПараметры);
	КонецЕсли;
	
	НастройкиКомпоновки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", 
		РасположениеИтоговКомпоновкиДанных.Конец);
	
	МассивГруппировок = Новый Массив;
	КоличествоВложенных = 0;
	ДобавитьАвтоПоле(НастройкиКомпоновки.Структура, МассивГруппировок, КоличествоВложенных);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Если ДанныеРасшифровки = Неопределено Тогда
		ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КонецЕсли;
	
	ЭтоВызовИзПанелиПоказателей = Неопределено;
	Параметры.Свойство("ЭтоВызовИзПанелиПоказателей", ЭтоВызовИзПанелиПоказателей); 
	ЭлементыОтбора = НастройкиКомпоновки.Отбор.Элементы;
	ИзменитьВидСравненияЭлементовОтбораПроекта(ВыводитьПроектныеЗадачи, ЭлементыОтбора,
																				 ЭтоВызовИзПанелиПоказателей);	
	
	СортировкаЭлементов = НастройкиКомпоновки.Порядок.Элементы;
	ДобавитьСортировкуПоКодуСДР(СортировкаЭлементов);
	
	Попытка
		МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СКД, НастройкиКомпоновки, ДанныеРасшифровки,,
			Тип(Параметры.ТипГенератораМакета));
					
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;	
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, ВнешниеНаборыДанных, ДанныеРасшифровки);
	
	Возврат ПроцессорКомпоновкиДанных;
	
КонецФункции

// Используется для функции упоПанельПоказателейКлиентСервер.ПолучитьМассивТиповПоТипуСсылки
// 
// Возвращаемое значение:
//  ОписаниеТипов - все ссылочные типы конфигурации.
//
Функция ОписаниеТипаВсеСсылки() Экспорт

	Возврат ОбщегоНазначения.ОписаниеТипаВсеСсылки();

КонецФункции // ()

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЗаполнитьПоказателиПредшественниковВТаблицеПоказателей(ТаблицаПоказателейИндикаторов, СписокПолей) Экспорт 
	
	ПолеПредшественники = СписокПолей.НайтиПоЗначению(Справочники.упоПоказателиПроектов.Предшественники);
	ПолеПредшественникиПроектов = СписокПолей.НайтиПоЗначению(Справочники.упоПоказателиПроектов.ВнешниеПредшественники);
	
	Если ПолеПредшественники = Неопределено И ПолеПредшественникиПроектов = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивЗеркалПроектныхЗадач = ТаблицаПоказателейИндикаторов.Скопировать(Новый Структура("ЭтоПроектнаяЗадача", Истина)).ВыгрузитьКолонку("Проект"); 
	
	СоответствиеПредшественников = упоПоказателиПроектовСервер.ПолучитьСоответствиеПоказателейПредшественников(МассивЗеркалПроектныхЗадач);
	
	Для Каждого СтрокаТаблицы Из ТаблицаПоказателейИндикаторов Цикл
		СтруктураЗадачи = СоответствиеПредшественников.Получить(СтрокаТаблицы.Проект);
		Если СтруктураЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПолеПредшественники = Неопределено Тогда
			СтрокаТаблицы[ПолеПредшественники.Представление] = СтрСоединить(СтруктураЗадачи.Предшественники);
		КонецЕсли; 
		Если НЕ ПолеПредшественникиПроектов = Неопределено Тогда
			СтрокаТаблицы[ПолеПредшественникиПроектов.Представление] = СтрСоединить(СтруктураЗадачи.ПредшественникиПроектов);
		КонецЕсли; 
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции

#Область ИнициализацияКомпоновщика

Процедура ИнициализироватьКомпоновщик(Объект, СтруктураДанных, ВторичнаяИнициализация = Ложь, ИзОтчета = Ложь, ЭтоПрограммноеФормирование = Ложь) Экспорт
	
	Перем ПрименяемыеНастройки;
	
	ТаблицаПоказателей = СтруктураДанных.ТаблицаПоказателей;
	
	ТаблицаИндикаторов = Новый ТаблицаЗначений;
	
	ТаблицаИндикаторов.Колонки.Добавить("ИмяПоказателя");
	ТаблицаИндикаторов.Колонки.Добавить("СсылкаНаПоказатель");
	ТаблицаИндикаторов.Колонки.Добавить("ЗаголовокПоказателя");
	ТаблицаИндикаторов.Колонки.Добавить("ЭтоФормула");
	ТаблицаИндикаторов.Колонки.Добавить("ФормулаРасчета");
	ТаблицаИндикаторов.Колонки.Добавить("ТолькоВФормуле");	
	ТаблицаИндикаторов.Колонки.Добавить("ТипЗначения");	
	ТаблицаИндикаторов.Колонки.Добавить("ФорматнаяСтрока");	
	ТаблицаИндикаторов.Колонки.Добавить("Группировки");	
	ТаблицаИндикаторов.Колонки.Добавить("ВыражениеГруппировки");	
	ТаблицаИндикаторов.Колонки.Добавить("ПринадлежностьПоказателя");
	ТаблицаИндикаторов.Колонки.Добавить("ТипИндикатора");
		
	ТаблицаИндикаторов.Индексы.Добавить("СсылкаНаПоказатель");
	
	Если ВторичнаяИнициализация Тогда
		
		ПрименяемыеНастройки = Объект.ДопКомпоновщикНастроек.ПолучитьНастройки();
		Если ИзОтчета Тогда
			Объект.АвтоФиксация = СтруктураДанных.ПолучитьКоличествоПолейДляФиксацииСлева(ПрименяемыеНастройки);
		КонецЕсли;
		
	КонецЕсли;
	
	СписокИндикаторов = Новый Массив;		
	
	СписокИндикаторовТолькоФормула = Новый СписокЗначений;	
	СписокПростыхПолей = Новый СписокЗначений;
	СписокПоФормуле = Новый СписокЗначений;
	
	ОтборИспользуемых = Новый Структура;
	ОтборИспользуемых.Вставить("Использовать", Истина);
	
	Если ТипЗнч(ТаблицаПоказателей) = Тип("ДанныеФормыКоллекция") Тогда
		ВыбранныеИндикаторы = ТаблицаПоказателей.Выгрузить(ОтборИспользуемых);
	Иначе
		ВыбранныеИндикаторы = ТаблицаПоказателей.НайтиСтроки(ОтборИспользуемых);
	КонецЕсли;
	ПодготовитьСпискиИндикаторов(Объект, СтруктураДанных, ВыбранныеИндикаторы, ТаблицаИндикаторов, ЭтоПрограммноеФормирование);
	
	СКД = Новый СхемаКомпоновкиДанных;
	НовыйИсточник = СКД.ИсточникиДанных.Добавить();
	НовыйИсточник.Имя = "ИсточникДанных1";
	НовыйИсточник.ТипИсточникаДанных = "Local";
	
	НовыйНаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НовыйНаборДанных.ИсточникДанных = "Local";
	
	НовыйНаборДанных.Имя = "Основной";
	НовыйНаборДанных.ИмяОбъекта = "Основной"; 	
	НовыйНаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	ДобавитьОбщиеПоля(НовыйНаборДанных);
	
	ДобавитьПараметры(СКД);
	
	индексПоля = 0;
	
	МассивПоФормуле = Новый Массив;
	СписокПростыхПолей = Новый СписокЗначений;
	
	Для Каждого ЭлементРеквизит Из ТаблицаИндикаторов Цикл
		
		Если ЭлементРеквизит.ТипЗначения = Неопределено Тогда
			
			НСтрока = НСтр("ru = 'Ошибка в заполнении показателя: ""%1"": не заполнен тип значения'");
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтрока, ЭлементРеквизит.СсылкаНаПоказатель);
			Сообщение.КлючДанных = ЭлементРеквизит.СсылкаНаПоказатель;
			Сообщение.Сообщить();
			
			Продолжить;
			
		КонецЕсли;
		
		Если ЭлементРеквизит.ЭтоФормула = Ложь Тогда
			
			НовоеПолеНабораДанных = НовыйНаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			НовоеПолеНабораДанных.Заголовок = ЭлементРеквизит.ЗаголовокПоказателя;
			НовоеПолеНабораДанных.Поле =  ЭлементРеквизит.ИмяПоказателя;
			НовоеПолеНабораДанных.Оформление.УстановитьЗначениеПараметра("Формат", ЭлементРеквизит.ФорматнаяСтрока);
			
			Если ЭлементРеквизит.ТолькоВФормуле Тогда
				
				НовоеПолеНабораДанных.ОграничениеИспользования.Группировка = Истина;
				НовоеПолеНабораДанных.ОграничениеИспользования.Поле = Истина;
				Если ИзОтчета Тогда
					НовоеПолеНабораДанных.ОграничениеИспользования.Порядок = Истина;
					НовоеПолеНабораДанных.ОграничениеИспользования.Условие = Истина;	
				Иначе
					НовоеПолеНабораДанных.ОграничениеИспользования.Порядок = Ложь;
					НовоеПолеНабораДанных.ОграничениеИспользования.Условие = Ложь;
				КонецЕсли;
				
			КонецЕсли;
			
			НовоеПолеНабораДанных.ТипЗначения = ЭлементРеквизит.ТипЗначения;				
			НовоеПолеНабораДанных.ПутьКДанным = ЭлементРеквизит.ИмяПоказателя;
			Если ИзОтчета Тогда
			Иначе
				НовоеПолеНабораДанных.ОграничениеИспользования.Условие = Истина;
				НовоеПолеНабораДанных.ОграничениеИспользования.Условие = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементРеквизит Из ТаблицаИндикаторов Цикл
		
		Если ЭлементРеквизит.ЭтоФормула = Истина Тогда
			
			НовоеПолеВыражение = СКД.ВычисляемыеПоля.Добавить();
			НовоеПолеВыражение.Выражение = ЭлементРеквизит.ФормулаРасчета;
			НовоеПолеВыражение.Заголовок = ЭлементРеквизит.ЗаголовокПоказателя;
			НовоеПолеВыражение.ПутьКДанным = ЭлементРеквизит.ИмяПоказателя;
			НовоеПолеВыражение.Оформление.УстановитьЗначениеПараметра("Формат", ЭлементРеквизит.ФорматнаяСтрока);
			НовоеПолеВыражение.ТипЗначения =  ЭлементРеквизит.ТипЗначения;
			
			Если ЭлементРеквизит.ТолькоВФормуле Тогда
				
				НовоеПолеВыражение.ОграничениеИспользования.Группировка = Истина;
				НовоеПолеВыражение.ОграничениеИспользования.Поле = Истина;
				НовоеПолеВыражение.ОграничениеИспользования.Порядок = Истина;
				
				Если ИзОтчета Тогда
					НовоеПолеВыражение.ОграничениеИспользования.Условие = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			НовоеПолеВыражение.ОграничениеИспользования.Условие = Истина;
			НовоеПолеНабораДанных.ОграничениеИспользования.Условие = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьРесурсы(СКД, ТаблицаИндикаторов);
	
	Объект.АдресСКД = ПоместитьВоВременноеХранилище(СКД,СтруктураДанных.УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Объект.АдресСКД);
	
	Если ПрименяемыеНастройки = Неопределено Тогда
		
		НастройкиКомпоновки = СКД.НастройкиПоУмолчанию;
		Если Не ЭтоПрограммноеФормирование Тогда
			СтруктураДанных.ЗаполнитьНастройкиПоУмолчанию(НастройкиКомпоновки);
		КонецЕсли;
		
	Иначе
		
		НастройкиКомпоновки = ПрименяемыеНастройки;
		
	КонецЕсли;
	
	НастройкиКомпоновки.Выбор.Элементы.Очистить();
	
	ДобавитьПоляВыбора(НастройкиКомпоновки.Выбор.Элементы, ТаблицаИндикаторов);
	
	Для Каждого ПараметрДанных Из НастройкиКомпоновки.ПараметрыДанных.Элементы Цикл
		ПараметрДанных.ИдентификаторПользовательскойНастройки = Строка(Новый УникальныйИдентификатор);
		ПараметрДанных.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	КонецЦикла;
	
	Объект.ДопКомпоновщикНастроек.Инициализировать(ИсточникНастроек);	
	Объект.ДопКомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновки);
	
КонецПроцедуры

Функция ПолучитьИмяПоказателя(СсылкаНаПоказатель) Экспорт
	
	// УИД нужно преобразовать в такую строку, чтобы ее можно было использовать 
	// в качестве псевдонима поля запроса или имени колонки в Таблице значений.
	
	УИДСтрокой = Строка(СсылкаНаПоказатель.УникальныйИдентификатор());
	УИДСтрокой = СтрЗаменить(УИДСтрокой, "-", "_");
	УИДСтрокой = "_" + УИДСтрокой;
	
	Возврат УИДСтрокой;
	
КонецФункции

// Структура данных для программного формирования отчета.
// 
// Возвращаемое значение:
// СтруктураДанных - Структура:
//  * ТаблицаПоказателей - ТаблицаЗначений
//  * СписокПоказателейТолькоВФормуле - СписокЗначений
//  * УникальныйИдентификатор - УникальныйИдентификатор
//
Функция СтруктураДанныхДляПрограммногоФормированияОтчета() Экспорт
	
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("ТаблицаПоказателей", СтруктураТаблицыПоказателей());
	СтруктураДанных.Вставить("СписокПоказателейТолькоВФормуле", Новый СписокЗначений);
	СтруктураДанных.Вставить("УникальныйИдентификатор", Новый УникальныйИдентификатор);
	
	ПолучитьСписокВсехПоказателей(СтруктураДанных);
	
	Возврат СтруктураДанных;
	
КонецФункции

// Таблица показателей согласно шаблону реквизита ТаблицаПоказателей формы отчёта
// (см. Отчет.упоАнализПроектовПоПоказателямСКД.ФормаОтчета).
Функция СтруктураТаблицыПоказателей() Экспорт
	
	ТаблицаПоказателей = Новый ТаблицаЗначений;
	КолонкиТаблицы = ТаблицаПоказателей.Колонки;
	
	ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
	ОписаниеТипаСправочникПоказателиПроектов = Новый ОписаниеТипов("СправочникСсылка.упоПоказателиПроектов");
	ОписаниеТипаПринадлежностьПоказателя = Новый ОписаниеТипов("ПеречислениеСсылка.упоПринадлежностьПоказателя");
	ОписаниеТипаТипИндикатора = Новый ОписаниеТипов("ПеречислениеСсылка.упоТипИндикатора");
	
	КолонкиТаблицы.Добавить("Использовать", ОписаниеТипаБулево);
	КолонкиТаблицы.Добавить("Показатель", ОписаниеТипаСправочникПоказателиПроектов);
	КолонкиТаблицы.Добавить("Группа", ОписаниеТипаСправочникПоказателиПроектов);
	КолонкиТаблицы.Добавить("Порядок", ОбщегоНазначения.ОписаниеТипаЧисло(10));
	КолонкиТаблицы.Добавить("ФорматнаяСтрока", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	КолонкиТаблицы.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(32));
	КолонкиТаблицы.Добавить("ТипЗаполнения", ОбщегоНазначения.ОписаниеТипаЧисло(1));
	КолонкиТаблицы.Добавить("Группировки", ОписаниеТипаБулево);
	КолонкиТаблицы.Добавить("ВыражениеГруппировки", ОбщегоНазначения.ОписаниеТипаСтрока(10));
	КолонкиТаблицы.Добавить("ПринадлежностьПоказателя", ОписаниеТипаПринадлежностьПоказателя);
	КолонкиТаблицы.Добавить("ТипИндикатора", ОписаниеТипаТипИндикатора);
	КолонкиТаблицы.Добавить("ИмяПоказателя", ОбщегоНазначения.ОписаниеТипаСтрока(37));
	
	Возврат ТаблицаПоказателей;
	
КонецФункции

// Получает список всех показателей.
//
// Параметры:
//  СтруктураДанных - Структура\Форма	 - Объект с полем ТаблицаПоказателей
//  ИзОтчета - Булево	 - признак вызова из отчета.
//
Процедура ПолучитьСписокВсехПоказателей(СтруктураДанных, ИзОтчета = Ложь) Экспорт
	
	Если ТипЗнч(СтруктураДанных.ТаблицаПоказателей) = Тип("ТаблицаЗначений") Тогда
		ТаблицаПоказателей = СтруктураДанных.ТаблицаПоказателей;
		КэшПоказателей = ТаблицаПоказателей;
	Иначе
		ТаблицаПоказателей = СтруктураДанных.ТаблицаПоказателей;
		КэшПоказателей = ТаблицаПоказателей.Выгрузить();
		ТаблицаПоказателей.Очистить();
	КонецЕсли;
	
	ЗапросПоказателей = Новый Запрос;
	ЗапросПоказателей.Текст = "ВЫБРАТЬ
	                          |	упоПоказателиПроектов.Ссылка КАК Показатель,
	                          |	упоПоказателиПроектов.Родитель КАК Группа,
	                          |	упоПоказателиПроектов.Порядок КАК Порядок,
	                          |	ВЫРАЗИТЬ(упоПоказателиПроектов.ФорматнаяСтрока КАК СТРОКА(100)) КАК ФорматнаяСтрока,
	                          |	упоПоказателиПроектов.Наименование КАК Наименование,
	                          |	упоПоказателиПроектов.ТипЗаполнения КАК ТипЗаполнения,
	                          |	упоПоказателиПроектов.СчитатьСуммуПоГруппировкам КАК Группировки,
	                          |	упоПоказателиПроектов.ВыражениеГруппировки КАК ВыражениеГруппировки,
	                          |	упоПоказателиПроектов.ТипИндикатора КАК ТипИндикатора,
	                          |	упоПоказателиПроектов.ПринадлежностьПоказателя КАК ПринадлежностьПоказателя,
	                          |	упоПоказателиПроектов.ТипСсылки КАК ТипСсылки,
	                          |	ВЫБОР
	                          |		КОГДА упоПоказателиПроектов.ПометкаУдаления
	                          |			ТОГДА 4
	                          |		КОГДА упоПоказателиПроектов.Предопределенный
	                          |				ИЛИ упоПоказателиПроектов.ПредустановленныйКод <> """"
	                          |			ТОГДА 5
	                          |		ИНАЧЕ 3
	                          |	КОНЕЦ КАК ИндексКартинки
	                          |ИЗ
	                          |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	                          |ГДЕ
	                          |	НЕ упоПоказателиПроектов.ПометкаУдаления
	                          |	И НЕ упоПоказателиПроектов.ЭтоГруппа
	                          |	И НЕ упоПоказателиПроектов.ТекстЗапроса ПОДОБНО &ПараметрНачалоПериода
	                          |	И НЕ упоПоказателиПроектов.ТекстЗапросаПЗ ПОДОБНО &ПараметрНачалоПериода
	                          |	И НЕ упоПоказателиПроектов.ПринадлежностьПоказателя = ЗНАЧЕНИЕ(Перечисление.упоПринадлежностьПоказателя.Произвольный)
	                          |
	                          |УПОРЯДОЧИТЬ ПО
	                          |	упоПоказателиПроектов.Родитель,
	                          |	упоПоказателиПроектов.Порядок";
	
	ЗапросПоказателей.УстановитьПараметр("ПараметрНачалоПериода", "%&НачалоПериода%");
	
	Выборка = ЗапросПоказателей.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаПоказателей.Добавить();
		
		Если КэшПоказателей.Количество() = 0 Тогда
			
			НоваяСтрока.Использовать = ИзОтчета;
			
		Иначе
			
			ПоказательБылВыбран = КэшПоказателей.Найти(Выборка.Показатель, "Показатель");
			Если ПоказательБылВыбран <> Неопределено Тогда
				НоваяСтрока.Использовать = ПоказательБылВыбран.Использовать;
			Иначе
				НоваяСтрока.Использовать = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИмяПоказателя = ПолучитьИмяПоказателя(Выборка.Показатель);
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет параметры <Источника> в <Приемник>.
//
// Параметры:
//  Приемник – ТаблицаЗначений - Колонки: ИмяПараметра, ЭтоВыражение, ЗначениеПараметра.
//  Источник – ТаблицаЗначений - Колонки: ИмяПараметра, ЭтоВыражение, ЗначениеПараметра.
//
Процедура СкопироватьПараметры(Приемник, Источник) Экспорт
	
	Если Источник <> Неопределено И Приемник <> Неопределено Тогда
		
		Для каждого СтрокаПараметров Из Источник Цикл
			
			Если СтрокаПараметров.ЭтоВыражение = Истина Тогда
				Попытка
					Приемник.Вставить(СтрокаПараметров.ИмяПараметра, Вычислить(СтрокаПараметров.ЗначениеПараметра));
				Исключение
					обПредупреждение(НСтр("ru='Ошибка в выражении параметра '") + СтрокаПараметров.ИмяПараметра);
				КонецПопытки;
			Иначе
				Приемник.Вставить(СтрокаПараметров.ИмяПараметра, СтрокаПараметров.ЗначениеПараметра);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОтборПоКомпоненту(НастройкиКомпоновки) Экспорт
	
	НовыйЭлементОтбора = Неопределено;
	ПолеКомпоновкиДанныхКомпонент = Новый ПолеКомпоновкиДанных("Компонент");
	
	Для Каждого ЭлементОтбора Из НастройкиКомпоновки.Отбор.Элементы Цикл
		
		Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиДанныхКомпонент Тогда
			
			НовыйЭлементОтбора = ЭлементОтбора;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НовыйЭлементОтбора = Неопределено Тогда
		НовыйЭлементОтбора = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиДанныхКомпонент;
	КонецЕсли;
	
	НовыйЭлементОтбора.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.упоКомпоненты.Проект");
	НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементОтбора.Использование = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, Структура, Группировка)
	
	Если Структура.ПоляГруппировки.Элементы.Количество() > 0 Тогда
		
		Поле = Строка(Структура.ПоляГруппировки.Элементы[0].Поле);
		НоваяСтрока = Группировка.Добавить();
		
		НоваяСтрока.Использование  = Структура.Использование;
		НоваяСтрока.Поле           = Поле;
		НоваяСтрока.Представление  = ПолучитьСвойствоПоля(КомпоновщикНастроек, НоваяСтрока.Поле);
		ТипГруппировки = Структура.ПоляГруппировки.Элементы[0].ТипГруппировки;
		Если ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия Тогда
			НоваяСтрока.ТипГруппировки = 1;
		ИначеЕсли ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия Тогда
			НоваяСтрока.ТипГруппировки = 2;
		Иначе
			НоваяСтрока.ТипГруппировки = 0;
		КонецЕсли;
		
		Если Структура.Структура.Количество() > 0 Тогда
			ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, Структура.Структура[0], Группировка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьГруппировкуПоПроекту(КомпоновщикНастроек)
	
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	
	Если КомпоновщикНастроек.Настройки.Структура.Количество() > 0 Тогда
				
		ЭлементСтруктуры  = КомпоновщикНастроек.Настройки.Структура[0];		
		ГруппировкаПроект = Неопределено;
		
		Пока ГруппировкаПроект = Неопределено Цикл 
			
			Для Каждого ПолеГруппировки Из ЭлементСтруктуры.ПоляГруппировки.Элементы Цикл
				
				Если ПолеГруппировки.Поле = ПолеПроект Тогда
					ГруппировкаПроект = ЭлементСтруктуры;
					Прервать;
				КонецЕсли; 
				
			КонецЦикла;
			
			Если ТипЗнч(ГруппировкаПроект) = Тип("ГруппировкаКомпоновкиДанных") Тогда 
				Прервать;	
			КонецЕсли; 
			
			Если ЭлементСтруктуры.Структура.Количество() > 0 Тогда
				ЭлементСтруктуры = ЭлементСтруктуры.Структура[0];
			Иначе
				ГруппировкаПроект = Ложь;
			КонецЕсли; 
			
		КонецЦикла;
		
	Иначе 
		ГруппировкаПроект = Ложь;	
		ЭлементСтруктуры = КомпоновщикНастроек.Настройки;
	КонецЕсли;
	
	Если ТипЗнч(ГруппировкаПроект) = Тип("Булево") Тогда
		
		ГруппировкаПроект 				= ЭлементСтруктуры.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ГруппировкаПроект.Использование = Истина;
		
		НовоеПолеКомпоновкиДанных 				 = ГруппировкаПроект.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		НовоеПолеКомпоновкиДанных.Использование  = Истина;
		НовоеПолеКомпоновкиДанных.Поле 			 = ПолеПроект;
		НовоеПолеКомпоновкиДанных.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;	
		
	КонецЕсли;
	
	Возврат ГруппировкаПроект;
		
КонецФункции

Функция ПолучитьСписокПроектов(Параметры, СПроектнымиЗадачами = Ложь)
	
	ТекущийОтбор = Параметры.ДополнительныеНастройки.Отбор;
	НастройкиКомпоновки  = Параметры.Настройки;	
	
	// Очистка отбор не нужна, если формируется отчет упоАнализПроектовПоПоказателямСКД.
	Если (Параметры.Свойство("ОчищатьОтборКомпоновщикаНастроек") И Параметры.ОчищатьОтборКомпоновщикаНастроек = Истина)
		ИЛИ НЕ Параметры.Свойство("ОчищатьОтборКомпоновщикаНастроек") Тогда
		НастройкиКомпоновки.Отбор.Элементы.Очистить();
	КонецЕсли;
	
	// Если формируется отчет упоАнализПроектовПоПоказателямСКД, то копировать настройки не надо,
	// т.к. в доп. отборе содержатся показатели, а таблице-источике для получения списка проектов
	// просто нет колонок, по которым будет сделана попытка произвести отбор (нет показателей).
	Если (Параметры.Свойство("КопироватьОтборИзДопНастроекВНастройки") И Параметры.КопироватьОтборИзДопНастроекВНастройки = Истина)
		ИЛИ НЕ Параметры.Свойство("КопироватьОтборИзДопНастроекВНастройки") Тогда
		ДопПараметры = Новый Структура("НеКопироватьПоказатели", Истина);
		упоТиповыеОтчетыСервер.СкопироватьОтборВНастройки(ТекущийОтбор.Элементы, НастройкиКомпоновки.Отбор.Элементы, ДопПараметры);
	КонецЕсли;
	
	ТекстЗапроса = ПолучитьТекстЗапросаСпискаПроектов();	
	ТекстЗапроса = УдалитьТаблицуСОбъектомПЗЕслиПоОбъектуНетОтбора(ТекстЗапроса, НастройкиКомпоновки.Отбор.Элементы);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПустойСтатус", Перечисления.упоСостояниеСтатусаПроекта.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойРуководитель", Справочники.упоСотрудники.ПустаяСсылка());
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	СКД = Параметры.ОсновнаяСхемаКомпоновкиДанных;
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("Основной", ТаблицаРезультат);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СКД, НастройкиКомпоновки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;	
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных,ВнешниеНаборыДанных);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	ТаблицаРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ТаблицаРезультат.Свернуть("Проект");
	
	СписокПроектов = Новый СписокЗначений;
	Для Каждого ЭлементРезультат Из ТаблицаРезультат Цикл
		СписокПроектов.Добавить(ЭлементРезультат.Проект);
	КонецЦикла;
	
	Возврат СписокПроектов;
	
КонецФункции

// Возвращает текст запроса для списка индикаторов.
//
// Параметры:
//  СписокИндикаторов	 - СписокЗначений 	- список индикаторов.
//  Параметры			 - Структура 		- структура параметров запроса.
//
// Возвращаемое значение:
//	Строка - текст запроса.
//
Функция ПолучитьТекстЗапросаДляИндикаторов(СписокИндикаторов, Параметры, 
												ВыводитьПроектныеЗадачи, 
												ОтдельныеЗапросыДляПроектовИЗадач = Ложь) Экспорт 
	
	ТекстЗапроса = "
		|ВЫБРАТЬ 
		|	NULL КАК Индикатор,
		|	NULL КАК Объект,
		|	NULL КАК ЗначениеИндикатора
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Индикатор,
		|	Объект,
		|	ЗначениеИндикатора
		|ИЗ
		|	РегистрСведений.упоЗначенияИндикаторов.СрезПоследних КАК ЗначенияИндикаторов
		|ГДЕ
		|	НЕ Индикатор.ВидЗаполнения = &Автоматически
		|";
	
	Параметры.Вставить("Автоматически", Перечисления.упоВидЗаполненияИндикатора.Автоматически);
	
	тзИндикаторы = Новый ТаблицаЗначений;
	тзИндикаторы.Колонки.Добавить("Значение", Новый ОписаниеТипов("СправочникСсылка.упоПоказателиПроектов"));
	тзИндикаторы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	тзИндикаторы.Колонки.Добавить("НомерПП", Новый ОписаниеТипов("Число"));
	Сч = 1;
	Для Каждого Эл Из СписокИндикаторов Цикл
		новСтр = тзИндикаторы.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,Эл);
		НовСтр.НомерПП = Сч;		
		Сч = Сч + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ * ПОМЕСТИТЬ ВтИндикаторы ИЗ &тзИндикаторы КАК тзИндикаторы";
	Запрос.УстановитьПараметр("тзИндикаторы", тзИндикаторы);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПоказателиПроектов.Ссылка КАК Показатель,
	               |	упоПоказателиПроектов.ВидЗаполнения,
	               |	упоПоказателиПроектов.ТипЗаполнения,
	               |	упоПоказателиПроектов.Наименование,
	               |	упоПоказателиПроектов.ПринадлежностьПоказателя,
	               |	упоПоказателиПроектов.ТекстЗапроса,
	               |	упоПоказателиПроектов.ТекстЗапросаПЗ,
	               |	упоПоказателиПроектов.ИмяПоляЗначения,
	               |	упоПоказателиПроектов.ИмяПоляЗначенияПЗ,
	               |	упоПоказателиПроектов.ИмяПоляОбъекта,
	               |	упоПоказателиПроектов.ИмяПоляОбъектаПЗ,
	               |	ВтИндикаторы.Представление,
	               |	упоПоказателиПроектов.ПараметрыЗапроса,
	               |	упоПоказателиПроектов.ПараметрыЗапросаПЗ
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтИндикаторы КАК ВтИндикаторы
	               |		ПО упоПоказателиПроектов.Ссылка = ВтИндикаторы.Значение
	               |ГДЕ
	               |	упоПоказателиПроектов.ВидЗаполнения = ЗНАЧЕНИЕ(Перечисление.упоВидЗаполненияИндикатора.Автоматически)
	               |	И упоПоказателиПроектов.ТипЗаполнения = 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВтИндикаторы.НомерПП";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроекта Тогда
			
			ДобавитьПоказательвТекстЗапроса(Параметры, ТекстЗапроса, Выборка);
				
		ИначеЕсли Выборка.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроектнойЗадачи И ВыводитьПроектныеЗадачи Тогда 
			
			ДобавитьПоказательвТекстЗапроса(Параметры, ТекстЗапроса, Выборка, Истина);
				
		ИначеЕсли Выборка.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.Общий Тогда
				
			Если ВыводитьПроектныеЗадачи Тогда
				ДобавитьПоказательвТекстЗапроса(Параметры, ТекстЗапроса, Выборка, Истина);
			КонецЕсли;
			
			Если ОтдельныеЗапросыДляПроектовИЗадач ИЛИ Не ВыводитьПроектныеЗадачи Тогда
				ДобавитьПоказательвТекстЗапроса(Параметры, ТекстЗапроса, Выборка);
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	упоПоказателиПроектовСервер.ДобавитьПроверкуОтмененныхЗадачВТекстЗапроса(ТекстЗапроса);
	
	Возврат ТекстЗапроса;
		
КонецФункции

Процедура ДобавитьПоказательвТекстЗапроса(Параметры, ТекстЗапроса, Выборка, ЭтоПоказательДляПЗ = Ложь,
		ОтборПоПроектам = Ложь, ДополнитьДопПараметрами = Ложь) Экспорт
	
	Если ЭтоПоказательДляПЗ Тогда
		
		ТекстЗапросаПоказателя = Выборка.ТекстЗапросаПЗ;
		ИмяПоляОбъекта = Выборка.ИмяПоляОбъектаПЗ;
		ИмяПоляЗначения = Выборка.ИмяПоляЗначенияПЗ;
		ПараметрыЗапроса = Выборка.ПараметрыЗапросаПЗ;
		
	Иначе
		
		ТекстЗапросаПоказателя = Выборка.ТекстЗапроса;
		ИмяПоляОбъекта = Выборка.ИмяПоляОбъекта;
		ИмяПоляЗначения = Выборка.ИмяПоляЗначения;
		ПараметрыЗапроса = Выборка.ПараметрыЗапроса;
		
	КонецЕсли;
	
	ТекстОшибки = "";
	ЗапросКорректный = упоФункцииОбщегоНазначенияСервер.ПроверитьЗапрос(ТекстЗапросаПоказателя,
																		ТекстОшибки, 
																		Выборка.Показатель, 
																		Истина);
	Если НЕ ЗапросКорректный Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось рассчитать показатель ""%1"" для %2! %3'"),
			Выборка.Наименование,
			?(ЭтоПоказательДляПЗ, НСтр("ru = 'проектной задачи'"), НСтр("ru = 'проекта'")),
			ТекстОшибки);
					
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Выборка.Показатель);
		
		Возврат;
		
	КонецЕсли;
	
	Если ОтборПоПроектам Тогда
		СтрокаВставки = "ГДЕ
		|	Главная." + ИмяПоляОбъекта + " В (&Проекты)
		|";
	Иначе
		СтрокаВставки = "";
	КонецЕсли;
		
	ШаблонЗапроса = "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ		
		|	&Индикатор" + Выборка.Представление + ",
		|	" + ИмяПоляОбъекта + ",
		|	" + ИмяПоляЗначения + "%1	
		|ИЗ
		|	(" + ТекстЗапросаПоказателя + ") КАК Главная
		|" + СтрокаВставки;
	
	Параметры.Вставить("Индикатор" + Выборка.Представление, Выборка.Показатель);
	
	Если ДополнитьДопПараметрами Тогда
		Если ЗначениеЗаполнено(Выборка.ИдентификаторПараметров) И ЗначениеЗаполнено(Выборка.Параметры) Тогда
			ШаблонТекста = "ДопПараметр%1_%2_Индикатора%3";	
			СделатьЗаменуПараметровВТекстеЗапроса(ШаблонЗапроса, Параметры, ШаблонТекста, Выборка.Параметры,
				Выборка.Представление, Выборка.ИдентификаторПараметров);
			ПараметрЗамены = "," + Символы.ПС + Символы.Таб + Выборка.ИдентификаторПараметров;
		Иначе
			ПараметрЗамены = "," + Символы.ПС + Символы.Таб + "0";	
		КонецЕсли;
	Иначе
		ПараметрЗамены = "";	
	КонецЕсли;
	 
	ШаблонЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса, ПараметрЗамены);
	
	ПараметрыВложенногоЗапроса = Новый Структура;	
	упоПанельПоказателейВызовСервера.СкопироватьПараметры(ПараметрыВложенногоЗапроса, ПараметрыЗапроса.Получить());
	
	Если ПараметрыВложенногоЗапроса.Количество() = 0 Тогда
		ТекстЗапроса = ТекстЗапроса + ШаблонЗапроса;
		Возврат;
	КонецЕсли;
	
	ШаблонТекста = "Параметр_%2_Индикатора%3";		
	СделатьЗаменуПараметровВТекстеЗапроса(ШаблонЗапроса, Параметры, ШаблонТекста, ПараметрыВложенногоЗапроса, Выборка.Представление);
	
	ТекстЗапроса = ТекстЗапроса + ШаблонЗапроса;
	
КонецПроцедуры

Процедура СделатьЗаменуПараметровВТекстеЗапроса(ШаблонТекстаЗапроса, Параметры, ШаблонПараметра, СтруктураПараметров,
		Представление, Идентификатор = "")
	
	ТаблДляСортировкиПараметров = Новый ТаблицаЗначений;
	ТаблДляСортировкиПараметров.Колонки.Добавить("ИмяПараметра");
	ТаблДляСортировкиПараметров.Колонки.Добавить("Значение");
	ТаблДляСортировкиПараметров.Колонки.Добавить("ДлинаИмениПараметра");
	ТаблДляСортировкиПараметров.Колонки.Добавить("НовоеИмяПараметра");
	Для Каждого Параметр Из СтруктураПараметров Цикл
				
		Строка = ТаблДляСортировкиПараметров.Добавить();
		Строка.ИмяПараметра = Параметр.Ключ;
		Строка.Значение = Параметр.Значение;
		Строка.ДлинаИмениПараметра = СтрДлина(Параметр.Ключ);
		Строка.НовоеИмяПараметра = 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПараметра, Идентификатор, Параметр.Ключ, Представление);
		
	КонецЦикла;	
	
	ТаблДляСортировкиПараметров.Сортировать("ДлинаИмениПараметра Убыв");
	
	ШаблонТекста = "&%1";
	Для Каждого Строка Из ТаблДляСортировкиПараметров Цикл
		ИмяПараметра = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекста, Строка.ИмяПараметра);
		НовоеИмяПараметра = 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекста, Строка.НовоеИмяПараметра);
		ШаблонТекстаЗапроса = СтрЗаменить(ШаблонТекстаЗапроса, ИмяПараметра, НовоеИмяПараметра);
		Параметры.Вставить(Строка.НовоеИмяПараметра, Строка.Значение);	
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстЗапроса(ВыводитьПроектныеЗадачи = Истина)

    Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |    Проекты.Ссылка КАК Объект,
        |    ЕСТЬNULL(Руководители.РуководительПроекта, &ПустойРуководитель) КАК РуководительПроекта,
        |    ЕСТЬNULL(Руководители.КураторПроекта, &ПустойРуководитель) КАК КураторПроекта,
        |    ЕСТЬNULL(Статусы.СтатусПроекта, &ПустойСтатус) КАК СтатусПроекта,
        |    Проекты.Автор,
        |    Проекты.АвторИзменений,
        |    Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.ИсточникФинансирования
        |        ИНАЧЕ Проекты.ИсточникФинансирования
        |    КОНЕЦ КАК ИсточникФинансирования,       
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.Организация
        |        ИНАЧЕ Проекты.Организация
        |    КОНЕЦ КАК Организация,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.ПортфельПроектов
        |        ИНАЧЕ Проекты.ПортфельПроектов
        |    КОНЕЦ КАК ПортфельПроектов,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.ПрограммаПроектов
        |        ИНАЧЕ Проекты.ПрограммаПроектов
        |    КОНЕЦ КАК ПрограммаПроектов,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.Подразделение
        |        ИНАЧЕ Проекты.Подразделение
        |    КОНЕЦ КАК Подразделение,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.КонтрагентЗатрат
        |        ИНАЧЕ Проекты.КонтрагентЗатрат
        |    КОНЕЦ КАК КонтрагентЗатрат,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.КонтрагентДоходов
        |        ИНАЧЕ Проекты.КонтрагентДоходов
        |    КОНЕЦ КАК КонтрагентДоходов,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.ДоговорЗатрат
        |        ИНАЧЕ Проекты.ДоговорЗатрат
        |    КОНЕЦ КАК ДоговорЗатрат,
        |    Проекты.Код,
        |    Проекты.Наименование,
        |    Проекты.ПолноеНаименование,               
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.ДоговорДоходов
        |        ИНАЧЕ Проекты.ДоговорДоходов
        |    КОНЕЦ КАК ДоговорДоходов,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.Компонент
        |        ИНАЧЕ Проекты.Компонент
        |    КОНЕЦ КАК Компонент,
		|    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.Объект
        |        ИНАЧЕ Проекты.Объект
        |    КОНЕЦ КАК ОбъектПроекта
        |//ПОЛЯ_ЗАДАЧ
		|//ПОЛЕ_КодСДРВПрограмме
        |//ПОКАЗАТЕЛИ
        |{ВЫБРАТЬ
        |    РуководительПроекта,
        |    КураторПроекта,
        |    СтатусПроекта,
        |    Компонент}
        |ИЗ
        |    Справочник.Проекты КАК Проекты
        |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних(, Проект В (&СписокПроектов)) КАК Руководители
        |        ПО (Руководители.Проект = ВЫБОР
        |                                    КОГДА Проекты.ЭтоПроектнаяЗадача
        |                                        ТОГДА Проекты.упоКорневойПроект
        |                                    ИНАЧЕ Проекты.Ссылка
        |                                КОНЕЦ)
        |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект В (&СписокПроектов)) КАК Статусы
        |        ПО (Статусы.Проект = ВЫБОР
        |                                КОГДА Проекты.ЭтоПроектнаяЗадача
        |                                    ТОГДА Проекты.упоКорневойПроект
        |                                ИНАЧЕ Проекты.Ссылка
        |                            КОНЕЦ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследнихОтбор
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроектаОтбор
		|			ПО (упоСвойстваПроектныхЗадачСрезПоследнихОтбор.Версия = упоВерсииПроектаОтбор.Версия
		|					И упоВерсииПроектаОтбор.Проект В (&СписокПроектов)
		|					И упоВерсииПроектаОтбор.Текущая)
		|		ПО (Проекты.ЭтоПроектнаяЗадача 
		|			И Проекты.СсылкаНаПроектнуюЗадачу = упоСвойстваПроектныхЗадачСрезПоследнихОтбор.ПроектнаяЗадача)
        | //СОЕДИНЕНИЕ_ЗАДАЧИ 
		| //СОЕДИНЕНИЕ_КодыСДРВПрограмме
        | //СОЕДИНЕНИЕ_ПОКАЗАТЕЛЕЙ
		|
        |{ГДЕ
        |    Проекты.Ссылка.* КАК Объект,
        |    Проекты.Код,
        |    Проекты.Наименование,
        |    Проекты.Автор.*,
        |    Проекты.АвторИзменений.*,
        |    Проекты.ДатаМодификации,
        |    Проекты.Организация.*,
        |    Проекты.Комментарий,
        |    Проекты.ПолноеНаименование,
        |    Проекты.ПрограммаПроектов.*,
        |    (ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.Подразделение
        |        ИНАЧЕ Проекты.Подразделение
        |    КОНЕЦ).* КАК Подразделение,
        |    ВЫБОР
        |        КОГДА Проекты.ЭтоПроектнаяЗадача
        |            ТОГДА Проекты.упоКорневойПроект.Компонент
        |        ИНАЧЕ Проекты.Компонент
        |    КОНЕЦ КАК Компонент,
        |    (ЕСТЬNULL(Руководители.РуководительПроекта, &ПустойРуководитель)) КАК РуководительПроекта,
        |    (ЕСТЬNULL(Руководители.КураторПроекта, &ПустойРуководитель)) КАК КураторПроекта,
        |    (ЕСТЬNULL(Статусы.СтатусПроекта, &ПустойСтатус)) КАК СтатусПроекта}";

		
	НуженКодСДРВПрограмме = Истина;
	Если НуженКодСДРВПрограмме Тогда
		
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Проекты.Ссылка КАК Проект,
		|	Проекты.ПрограммаПроектов,
		|	Проекты.ПрограммаПроектов.ПроектСтруктуры КАК ПроектСтруктуры
		|ПОМЕСТИТЬ ВТ_ПрограммыПроектов
		|ИЗ
		|	Справочник.Проекты КАК Проекты
		|ГДЕ
		|	Проекты.Ссылка В (&СписокПроектов)
		|	И Проекты.ПрограммаПроектов <> Значение(Справочник.упоПрограммыПроектов.ПустаяСсылка)
		|	И Проекты.ПрограммаПроектов.ПроектСтруктуры <> Значение(Справочник.Проекты.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненныйПроект КАК ПроектВходящийВПрограмму,
		|	МИНИМУМ(Проекты.КодСДР) КАК КодСДРВПрограмме
		|ПОМЕСТИТЬ ВТ_КодыСДРВПрограмме
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|			,
		|			ПроектнаяЗадача.Проект В
		|				(ВЫБРАТЬ
		|					ВТ_Программыпроектов.ПроектСтруктуры
		|				ИЗ
		|					ВТ_Программыпроектов)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|		ПО (упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		|				И упоВерсииПроекта.Текущая)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		|		ПО (упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
		|				И НЕ Проекты.ПометкаУдаления)
		|
		|СГРУППИРОВАТЬ ПО
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненныйПроект
		|;" + Текст;
		
		ТекстСоединения =   
        "ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КодыСДРВПрограмме КАК ВТ_КодыСДРВПрограмме
        |        ПО (Проекты.ЭтоПроектнаяЗадача
        |                И Проекты.упоКорневойПроект = ВТ_КодыСДРВПрограмме.ПроектВходящийВПрограмму)
		|        ИЛИ (НЕ Проекты.ЭтоПроектнаяЗадача
        |                И Проекты.Ссылка = ВТ_КодыСДРВПрограмме.ПроектВходящийВПрограмму)
		|";	
		
		Текст = СтрЗаменить(Текст, "//ПОЛЕ_КодСДРВПрограмме", ", ВТ_КодыСДРВПрограмме.КодСДРВПрограмме");
		Текст = СтрЗаменить(Текст, "//СОЕДИНЕНИЕ_КодыСДРВПрограмме", ТекстСоединения);
		
	КонецЕсли;
	
    Если ВыводитьПроектныеЗадачи Тогда
        ТекстСоединения =   
        "ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадач
        |            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
        |            ПО (упоСвойстваПроектныхЗадач.Версия = упоВерсииПроекта.Версия
        |                    И упоВерсииПроекта.Текущая)
        |        ПО (Проекты.ЭтоПроектнаяЗадача
        |                И Проекты.СсылкаНаПроектнуюЗадачу = упоСвойстваПроектныхЗадач.ПроектнаяЗадача)
        |";
        ТекстПолей = ", 
		|	ISNULL(упоСвойстваПроектныхЗадач.ЭтоВеха, Ложь) КАК ЭтоВеха, 
		|	ISNULL(упоСвойстваПроектныхЗадач.ЭтоМодельПакетаРабот, Ложь) КАК ЭтоМодельПакетаРабот,
		|	упоСвойстваПроектныхЗадач.ВидОперации КАК ВидОперации, 
		|	упоСвойстваПроектныхЗадач.Объект КАК ОбъектПЗ";
        Текст = СтрЗаменить(Текст, "//СОЕДИНЕНИЕ_ЗАДАЧИ", ТекстСоединения);
        Текст = СтрЗаменить(Текст, "//ПОЛЯ_ЗАДАЧ", ТекстПолей);
	Иначе
		ТекстПолей = ", 
		|	Ложь КАК ЭтоВеха,
		|	Ложь КАК ЭтоМодельПакетаРабот, 
		|	ЗНАЧЕНИЕ(СправочникСсылка.упоВидыОпераций.ПустаяСсылка) КАК ВидОпераций,
		|	ЗНАЧЕНИЕ(СправочникСсылка.упоОбъекты.ПустаяСсылка) КАК ОбъектПЗ"; 
        Текст = СтрЗаменить(Текст, "//ПОЛЯ_ЗАДАЧ", ТекстПолей);   
    КонецЕсли;

    Возврат Текст;             

КонецФункции

Функция ПолучитьТекстЗапросаСпискаПроектов()

    Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	упоВерсииПроекта.Проект КАК Проект,
	|	упоСвойстваПроектныхЗадачСрезПоследних.Объект КАК ОбъектПЗ
	|ПОМЕСТИТЬ ОбъектыПроектныхЗадачПроекта
	|{ВЫБРАТЬ
	|	Проект.*,
	|	ОбъектПЗ.*}
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	|			И (упоВерсииПроекта.Текущая)
	|{ГДЕ
	|	упоВерсииПроекта.Проект.*,
	|	упоСвойстваПроектныхЗадачСрезПоследних.Объект.*}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.Ссылка КАК Проект,
	|	ЕСТЬNULL(Руководители.РуководительПроекта, &ПустойРуководитель) КАК РуководительПроекта,
	|	ЕСТЬNULL(Руководители.КураторПроекта, &ПустойРуководитель) КАК КураторПроекта,
	|	ЕСТЬNULL(Статусы.СтатусПроекта, &ПустойСтатус) КАК СтатусПроекта,
	|	Проекты.ПортфельПроектов КАК ПортфельПроектов,
	|	Проекты.ПрограммаПроектов КАК ПрограммаПроектов,
	|	Проекты.ЭтоПроектнаяЗадача КАК ЭтоПроектнаяЗадача,
	|	Проекты.Подразделение КАК Подразделение,
	|	Проекты.ИсточникФинансирования КАК ИсточникФинансирования,
	|	ЛОЖЬ КАК ЭтоВеха,
	|	ЛОЖЬ КАК ЭтоМодельПакетаРабот,
	|	Проекты.Компонент КАК Компонент,
	|	NULL КАК ВидОперации,
	|	Проекты.Объект КАК ОбъектПроекта,
	|	ОбъектыПроектныхЗадачПроекта.ОбъектПЗ КАК ОбъектПЗ
	|{ВЫБРАТЬ
	|	РуководительПроекта,
	|	СтатусПроекта,
	|	КураторПроекта,
	|	Проекты.Ссылка.* КАК Проект,
	|	Проекты.Код,
	|	Проекты.Наименование,
	|	Проекты.Автор.*,
	|	Проекты.АвторИзменений.*,
	|	Проекты.ДатаМодификации,
	|	Проекты.Организация.*,
	|	Проекты.Комментарий,
	|	Проекты.ПолноеНаименование,
	|	Проекты.Компонент,
	|	Проекты.Родитель.*,
	|	ОбъектПроекта.*,
	|	ОбъектПЗ.*}
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних(, ) КАК Руководители
	|		ПО (Руководители.Проект = Проекты.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектов.СрезПоследних(, ) КАК Статусы
	|		ПО (Статусы.Проект = Проекты.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбъектыПроектныхЗадачПроекта КАК ОбъектыПроектныхЗадачПроекта
	|		ПО (ОбъектыПроектныхЗадачПроекта.Проект = Проекты.Ссылка)
	|ГДЕ
	|	НЕ Проекты.ЭтоПроектнаяЗадача
	|	И НЕ Проекты.ПометкаУдаления
	|{ГДЕ
	|	Проекты.Ссылка.* КАК Проект,
	|	Проекты.Код,
	|	Проекты.Наименование,
	|	Проекты.Автор.*,
	|	Проекты.АвторИзменений.*,
	|	Проекты.ДатаМодификации,
	|	Проекты.Организация.*,
	|	Проекты.Комментарий,
	|	Проекты.ПолноеНаименование,
	|	Проекты.Компонент,
	|	Проекты.Подразделение.* КАК Подразделение,
	|	(ЕСТЬNULL(Руководители.РуководительПроекта, &ПустойРуководитель)) КАК РуководительПроекта,
	|	(ЕСТЬNULL(Руководители.КураторПроекта, &ПустойРуководитель)) КАК КураторПроекта,
	|	(ЕСТЬNULL(Статусы.СтатусПроекта, &ПустойСтатус)) КАК СтатусПроекта,
	|	Проекты.Объект.* КАК ОбъектПроекта,
	|	ОбъектыПроектныхЗадачПроекта.ОбъектПЗ.*}";

    Возврат Текст;

КонецФункции

Функция УдалитьТаблицуСОбъектомПЗЕслиПоОбъектуНетОтбора(Знач ТекстЗапроса, ЭлементыОтбора)
	
	ПолеОбъектТекст = "ОбъектПЗ";
	УдалитьОтбор = Не ПолеНайденоВОтборе(ЭлементыОтбора, ПолеОбъектТекст);
	
	// Удалить Отбор по Объекту проектной задачи если нет активного отбора по нему
	Если УдалитьОтбор Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		СхемаЗапроса.ПакетЗапросов.Удалить(0);
		// При удалении соединения автоматически удаляются все выбранные поля соединяемой таблицы
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники.Удалить(3);
		ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолеНайденоВОтборе(ЭлементыОтбора, ИмяПоля, ПолеНайдено = Ложь)
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ПолеНайдено = ПолеНайденоВОтборе(ЭлементОтбора.Элементы, ИмяПоля);
			Если ПолеНайдено Тогда
				Возврат ПолеНайдено;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ИмяОтбора = Строка(ЭлементОтбора.ЛевоеЗначение);
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И Лев(ИмяОтбора, 8) = ИмяПоля
			И ЭлементОтбора.Использование Тогда
			ПолеНайдено = Истина;
			Возврат ПолеНайдено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПолеНайдено;
	
КонецФункции

