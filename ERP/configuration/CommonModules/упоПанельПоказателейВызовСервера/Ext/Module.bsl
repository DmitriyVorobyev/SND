#Область ПрограммныйИнтерфейс

// Заполняет начальные значения группировок.
//
// Параметры:
//  КомпоновщикНастроек	 - КомпоновщикНастроекКомпоновкиДанных - компоновщик настроек.
//  Группировка			 - КоллекцияПолейГруппировкиКомпоновкиДанных - поля группировки.
//
Процедура ЗаполнитьНачальныеЗначенияГруппировок(КомпоновщикНастроек, Группировка) Экспорт
	
	// Установка начальных значений Группировки.
	Группировка.Очистить();
	Для Каждого ЭлементСтруктуры Из КомпоновщикНастроек.Настройки.Структура Цикл
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ДиаграммаКомпоновкиДанных") Тогда
			Для Каждого Серия Из ЭлементСтруктуры.Серии Цикл
				Если Серия.Имя = "Группировка" Тогда
					ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, Серия, Группировка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Для Каждого Точка Из ЭлементСтруктуры.Точки Цикл
				Если Точка.Имя = "Группировка" Тогда
					ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, Точка, Группировка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			Для Каждого Колонка Из ЭлементСтруктуры.Колонки Цикл
				Если Колонка.Имя = "Группировка" Тогда
					ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, Колонка, Группировка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Для Каждого Строка Из ЭлементСтруктуры.Строки Цикл
				Если Строка.Имя = "Группировка" Тогда
					ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, Строка, Группировка);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(ЭлементСтруктуры) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			Группировка.Очистить();
			ЗаполнитьГруппировкиИзНастроек(КомпоновщикНастроек, ЭлементСтруктуры, Группировка);
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

// Получает свойство поля.
//
// Параметры:
//  ЭлементСтруктура - ДоступныеПоляКомпоновкиДанных - коллекция полей СКД.
//  Поле			 - ПолеКомпоновкиДанных - поле.
//  Свойство		 - Строка - имя свойства.
//
// Возвращаемое значение:
//	ПолеКомпоновкиДанных - поле СКД.
//
Функция ПолучитьСвойствоПоля(ЭлементСтруктура, Поле, Свойство = "Заголовок") Экспорт
	
	Если ТипЗнч(ЭлементСтруктура) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		Коллекция = ЭлементСтруктура.Настройки.ДоступныеПоляВыбора;
	Иначе
		Коллекция = ЭлементСтруктура;
	КонецЕсли;
	
	ПолеСтрокой = Строка(Поле);
	ПозицияКвадратнойСкобки = Найти(ПолеСтрокой, "[");
	Окончание = "";
	Заголовок = "";
	Если ПозицияКвадратнойСкобки > 0 Тогда
		Окончание = Сред(ПолеСтрокой, ПозицияКвадратнойСкобки);
		ПолеСтрокой = Лев(ПолеСтрокой, ПозицияКвадратнойСкобки - 2);
	КонецЕсли;
	
	МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолеСтрокой, ".");
	
	Если Не ПустаяСтрока(Окончание) Тогда
		МассивСтрок.Добавить(Окончание);
	КонецЕсли;
	
	ДоступныеПоля = Коллекция.Элементы;
	ПолеПоиска = "";
	Для Индекс = 0 По МассивСтрок.Количество() - 1 Цикл
		ПолеПоиска = ПолеПоиска + ?(Индекс = 0, "", ".") + МассивСтрок[Индекс];
		ДоступноеПоле = ДоступныеПоля.Найти(ПолеПоиска);
		Если ДоступноеПоле <> Неопределено Тогда
			ДоступныеПоля = ДоступноеПоле.Элементы;
		КонецЕсли;
	КонецЦикла;
	
	Если ДоступноеПоле <> Неопределено Тогда
		Если Свойство = "ДоступноеПоле" Тогда
			Результат = ДоступноеПоле;
		Иначе
			Результат = ДоступноеПоле[Свойство]; 
		КонецЕсли;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Добавляет группировки.
//
// Параметры:
//  ПараметрыОтчета		 - ПараметрыСхемыКомпоновкиДанных - параметры.
//  КомпоновщикНастроек	 - КомпоновщикНастроек - компоновщик настроек СКД.
Процедура ДобавитьГруппировки(ПараметрыОтчета, КомпоновщикНастроек) Экспорт
	
	Если ТипЗнч(КомпоновщикНастроек) = Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		СтруктураНастроек = КомпоновщикНастроек.Настройки.Структура;
	Иначе
		СтруктураНастроек = КомпоновщикНастроек;
	КонецЕсли;
	
	Для Каждого ЭлементСтруктуры Из СтруктураНастроек Цикл
		
		Группировка = ЭлементСтруктуры;
		
		Если ТипЗнч(Группировка) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			Родитель = Группировка.Родитель;
			ПерваяГруппировка = Истина;
			Индекс = Родитель.Структура.Индекс(Группировка);
			Родитель.Структура.Удалить(Группировка);
			Для Каждого ПолеВыбраннойГруппировки Из ПараметрыОтчета.Группировка Цикл 
				Если ПолеВыбраннойГруппировки.Использование Тогда
					Если ПерваяГруппировка Тогда
						Группировка = Родитель.Структура.Вставить(Индекс, Тип("ГруппировкаКомпоновкиДанных"));
						ПерваяГруппировка = Ложь;
					Иначе
						Группировка = Группировка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
					КонецЕсли;
					
					ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
					ПолеГруппировки.Использование  = Истина;
					ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных(ПолеВыбраннойГруппировки.Поле);
					Если ПолеВыбраннойГруппировки.ТипГруппировки = 1 Тогда
						ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
					ИначеЕсли ПолеВыбраннойГруппировки.ТипГруппировки = 2 Тогда
						ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
					Иначе
						ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
					КонецЕсли;
					Если Не ПолеВыбраннойГруппировки.ВыключитьАвтоПоля Тогда
						Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
						Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет начальные значения дополнительных полей.
//
// Параметры:
//  КомпоновщикНастроек	 - КомпоновщикНастроек - компоновщик настроек СКД.
//  ДопПоля				 - ДоступныеПоляКомпоновкиДанных - коллекция полей СКД.
Процедура ЗаполнитьНачальныеЗначенияДопПолей(КомпоновщикНастроек, ДопПоля) Экспорт 
	
	ДопПоля.Очистить();
	
	ГруппировкаПроект = ПолучитьГруппировкуПоПроекту(КомпоновщикНастроек);
					
	Для Каждого ЭлементВыбора Из ГруппировкаПроект.Выбор.Элементы Цикл
		
		Поле = Строка(ЭлементВыбора.Поле);
		
		НоваяСтрока 			  = ДопПоля.Добавить();
		НоваяСтрока.Поле		  = Поле;
		НоваяСтрока.Использование = ЭлементВыбора.Использование;
		//НоваяСтрока.Представление = ПолучитьСвойствоПоля(КомпоновщикНастроек, НоваяСтрока.Поле);
		НоваяСтрока.Представление = ЭлементВыбора.Заголовок;
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет дополнительные поля.
//
// Параметры:
//  ПараметрыОтчета		 - ПараметрыСхемыКомпоновкиДанных	 - параметры.
//  КомпоновщикНастроек	 - КомпоновщикНастроек				 - компоновщик настроек СКД.
//  ТолькоВыбранныеПоля	 - Булево
//
Процедура ДобавитьДопПоля(ПараметрыОтчета, КомпоновщикНастроек, ТолькоВыбранныеПоля = Ложь) Экспорт
	
	ДопПоля = ПараметрыОтчета.ДополнительныеПоля;
	
	ГруппировкаПроект = ПолучитьГруппировкуПоПроекту(КомпоновщикНастроек);
	
	Для Каждого ДопПоле Из ДопПоля Цикл
		
		Группировка = ПараметрыОтчета.Группировка.Найти(ДопПоле.Поле, "Поле");
		Если Группировка = Неопределено ИЛИ НЕ Группировка.Использование Тогда
			
			НовоеПолеКомпоновкиДанных = ГруппировкаПроект.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			НовоеПолеКомпоновкиДанных.Использование = ДопПоле.Использование;
			НовоеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных(ДопПоле.Поле);
			
			ВыбранноеПоле = ГруппировкаПроект.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Использование = ДопПоле.Использование;
			ВыбранноеПоле.Заголовок =  ДопПоле.Представление;
			ВыбранноеПоле.Поле = НовоеПолеКомпоновкиДанных.Поле;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТолькоВыбранныеПоля Тогда
		Возврат;
	КонецЕсли;
	
	НовоеПолеКомпоновкиДанных = ГруппировкаПроект.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	НовоеПолеКомпоновкиДанных.Использование = Истина;
	НовоеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Проект.ЭтоПроектнаяЗадача");
	
	ВыбранноеПоле = ГруппировкаПроект.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Заголовок =  "";
	ВыбранноеПоле.Поле = НовоеПолеКомпоновкиДанных.Поле;
	
	НовоеПолеКомпоновкиДанных = ГруппировкаПроект.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	НовоеПолеКомпоновкиДанных.Использование = Истина;
	НовоеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Проект.СсылкаНаПроектнуюЗадачу");
	
	ВыбранноеПоле = ГруппировкаПроект.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Заголовок =  "";
	ВыбранноеПоле.Поле = НовоеПолеКомпоновкиДанных.Поле;
	
	НовоеПолеКомпоновкиДанных = ГруппировкаПроект.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	НовоеПолеКомпоновкиДанных.Использование = Истина;
	НовоеПолеКомпоновкиДанных.Поле = Новый ПолеКомпоновкиДанных("Проект.ПометкаУдаления");
	
	ВыбранноеПоле = ГруппировкаПроект.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Заголовок =  "";
	ВыбранноеПоле.Поле = НовоеПолеКомпоновкиДанных.Поле;
	
	НовоеПолеКомпоновкиДанных = ГруппировкаПроект.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
