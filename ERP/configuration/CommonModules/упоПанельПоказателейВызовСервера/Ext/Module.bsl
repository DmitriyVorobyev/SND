Процедура ДобавитьАвтоПоле(СтруктураКомпоновки, МассивГруппировок, КоличествоВложенных)
	
	КоличествоВложенных = КоличествоВложенных + 1;
	
	Для каждого ВыбранныйЭлемент Из СтруктураКомпоновки Цикл
		
		Если ТипЗнч(ВыбранныйЭлемент) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			
			ПроверитьДоступностьВыбранныхПолей(ВыбранныйЭлемент);
			
			МассивГруппировок.Добавить(Формат(ВыбранныйЭлемент.Выбор.Элементы.Количество(), "ЧГ=0"));
			
			Если ВыбранныйЭлемент.Структура.Количество() = 0 Тогда
				
				АвтоПолеЕсть = Ложь;
				
				Для Каждого ЭлементГруппировки Из ВыбранныйЭлемент.Выбор.Элементы Цикл
					
					Если ТипЗнч(ЭлементГруппировки) = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
						
						АвтоПолеЕсть = Истина;
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если АвтоПолеЕсть = Ложь Тогда
					
					НовоеПоле = ВыбранныйЭлемент.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
					
				КонецЕсли;
				
			Иначе
				
				ДобавитьАвтоПоле(ВыбранныйЭлемент.Структура, МассивГруппировок, КоличествоВложенных);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьДоступностьВыбранныхПолей(ВыбранныйЭлемент)
	
	ВыборСтруктуры = ВыбранныйЭлемент.Выбор;			 
	ПоляГруппировки =  ВыбранныйЭлемент.ПоляГруппировки.Элементы;
	
	Для Каждого ЭлементГруппировки Из ПоляГруппировки Цикл
		
		Для Каждого ВыбранноеПоле Из ВыборСтруктуры.Элементы Цикл
			
			Если ТипЗнч(ВыбранноеПоле) = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
				Продолжить;	  
			КонецЕсли;
			
			Если ВыбранноеПоле.Поле =  ЭлементГруппировки.Поле Тогда
				
				ВыбранноеПоле.Использование = ЭлементГруппировки.Использование;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого ЭлементВыбора Из ВыборСтруктуры.Элементы Цикл
		
		Если ТипЗнч(ЭлементВыбора) = Тип("АвтоВыбранноеПолеКомпоновкиДанных") Тогда
			Продолжить;	  
		КонецЕсли;		  
		
		ЭлементНайден = Ложь;
		
		Для Каждого ЭлементГруппировки Из ПоляГруппировки Цикл
			
			Если ТипЗнч(ЭлементГруппировки) = Тип("ПолеГруппировкиКомпоновкиДанных") Тогда
				
				Если ЭлементГруппировки.Поле =  ЭлементВыбора.Поле 
					И ЭлементГруппировки.Использование Тогда
					
					ЭлементНайден = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЭлементВыбора.Использование = ЭлементНайден;
		
	КонецЦикла;
	
КонецПроцедуры

#Область ИнициализацияКомпоновщика

Процедура ПодготовитьСпискиИндикаторов(Объект, СтруктураДанных, ВыбранныеИндикаторы, ТаблицаИндикаторов,
		ЭтоПрограммноеФормирование)
	
	Объект.СписокПолей.Очистить();
	СписокПоказателейТолькоВФормуле = СтруктураДанных.СписокПоказателейТолькоВФормуле;
	СписокПоказателейТолькоВФормуле.Очистить();
	
	Если Не ЭтоПрограммноеФормирование Тогда
		РассчитыватьПоказатели = СтруктураДанных.Элементы.Найти("КомандаРассчитыватьПоказатели");
		Если НЕ РассчитыватьПоказатели = Неопределено И НЕ РассчитыватьПоказатели.Пометка Тогда
			ВыбранныеИндикаторы.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	МассивТиповЧ = Новый Массив;
	МассивТиповЧ.Добавить(Тип("Число"));
	
	КЧ = Новый КвалификаторыЧисла(15,2);
	МассивТиповДата = Новый Массив;
	МассивТиповДата.Добавить(Тип("Дата"));
	
	КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);
	
	МассивТиповБулево = Новый Массив;
	МассивТиповБулево.Добавить(Тип("Булево"));
	
	МассивТиповСтрока = Новый Массив;
	МассивТиповСтрока.Добавить(Тип("Строка"));
	
	ОписаниеТиповЧ = Новый ОписаниеТипов(МассивТиповЧ,КЧ);
	ОписаниеТиповД = Новый ОписаниеТипов(МассивТиповДата,,,КвалификаторыДаты);
	ОписаниеТиповДД = Новый ОписаниеТипов(МассивТиповБулево);
	ОписаниеТиповСтр = Новый ОписаниеТипов(МассивТиповСтрока);
		
	Для Каждого ВыбранныйПоказатель Из ВыбранныеИндикаторы Цикл
		
		НоваяСтрока = ТаблицаИндикаторов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыбранныйПоказатель);
		НоваяСтрока.СсылкаНаПоказатель =  ВыбранныйПоказатель.Показатель;
		НоваяСтрока.ЗаголовокПоказателя = ВыбранныйПоказатель.Наименование;
		НоваяСтрока.ТолькоВФормуле = Ложь;
		
		ВидЗаполненияПоказателя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбранныйПоказатель.Показатель, "ВидЗаполнения");
						
		Если ВыбранныйПоказатель.ТипЗаполнения = 1 И НЕ ВидЗаполненияПоказателя = Перечисления.упоВидЗаполненияИндикатора.АвтоматическиВДокументе Тогда
			
			НоваяСтрока.ЭтоФормула = Истина;
			НоваяСтрока.ФормулаРасчета = 
				Справочники.упоПоказателиПроектов.ПолучитьФормулуРасчетаПоказателя(ВыбранныйПоказатель.Показатель);
			
		Иначе
			
			НоваяСтрока.ЭтоФормула = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьИзФормул(СтруктураДанных, ВыбранныеИндикаторы, ТаблицаИндикаторов);
	
	индексСтроки = 0;
	
	Для Каждого СтрокаИндикатора Из ТаблицаИндикаторов Цикл
				
		Если СтрДлина(СокрЛП(СтрокаИндикатора.ВыражениеГруппировки)) = 0 Тогда
			
			СтрокаИндикатора.ВыражениеГруппировки = "";
			
		КонецЕсли;
		
		Если СтрокаИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
			
			СтрокаИндикатора.ТипЗначения = ОписаниеТиповЧ;
			
		ИначеЕсли СтрокаИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
			
			СтрокаИндикатора.ТипЗначения = ОписаниеТиповД;
			
		ИначеЕсли СтрокаИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
			
			СтрокаИндикатора.ТипЗначения = ОписаниеТиповДД;
			
		ИначеЕсли СтрокаИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
			
			СтрокаИндикатора.ТипЗначения = ОписаниеТиповСтр;
			
		ИначеЕсли СтрокаИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда			
			
			МассивТипов = упоПанельПоказателейКлиентСервер.ПолучитьМассивТиповПоТипуСсылки(СтрокаИндикатора.СсылкаНаПоказатель.ТипСсылки);
			ОписаниеТиповПоказателя = Новый ОписаниеТипов(МассивТипов);
			
			СтрокаИндикатора.ТипЗначения = ОписаниеТиповПоказателя;	
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаИндикатора Из ТаблицаИндикаторов Цикл
		
