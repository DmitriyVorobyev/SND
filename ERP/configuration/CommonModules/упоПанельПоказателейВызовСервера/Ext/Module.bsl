Процедура ДобавитьИндикаторыИзРасчетных(ЭтаФорма,ВыбранныеИндикаторы, ТаблицаИндикаторов, ИндикаторПоФормуле)
	
	ОтборОбработанных = Новый Структура;
	ОтборОбработанных.Вставить("СсылкаНаПоказатель", ИндикаторПоФормуле);
	
	Если ТаблицаИндикаторов.НайтиСтроки(ОтборОбработанных).Количество() = 0 Тогда
		
		НоваяСтрока =  ТаблицаИндикаторов.Добавить();
		НоваяСтрока.СсылкаНаПоказатель =  ИндикаторПоФормуле;
		НоваяСтрока.ЗаголовокПоказателя = ИндикаторПоФормуле.Наименование;			
		НоваяСтрока.ТолькоВФормуле = (ВыбранныеИндикаторы.НайтиСтроки(
			Новый Структура("Использовать, Показатель", Истина, ИндикаторПоФормуле)).Количество() = 0);
		
		Если ИндикаторПоФормуле.ТипЗаполнения = 1 Тогда
			
			НоваяСтрока.ЭтоФормула = Истина;					
			НоваяСтрока.ФормулаРасчета = ИндикаторПоФормуле.строкаФормулы;					
			
			Для Каждого СтрокаРасчетногоПоказателя Из ИндикаторПоФормуле.РасчетныеИндикаторы Цикл
				
				ДобавитьИндикаторыИзРасчетных(ЭтаФорма,ВыбранныеИндикаторы, ТаблицаИндикаторов, СтрокаРасчетногоПоказателя.Индикатор);		
				
			КонецЦикла;
			
		Иначе
			
			НоваяСтрока.ЭтоФормула = Ложь;					
			
		КонецЕсли;
		
		Если НоваяСтрока.ТолькоВФормуле Тогда
			ЭтаФорма.СписокПоказателейТолькоВФормуле.Добавить(ИндикаторПоФормуле);	
		КонецЕсли;
		
		НоваяСтрока.ФорматнаяСтрока = ИндикаторПоФормуле.ФорматнаяСтрока;
		НоваяСтрока.Группировки = ИндикаторПоФормуле.СчитатьСуммуПоГруппировкам;
		НоваяСтрока.ВыражениеГруппировки = ИндикаторПоФормуле.ВыражениеГруппировки;
		НоваяСтрока.ПринадлежностьПоказателя = ИндикаторПоФормуле.ПринадлежностьПоказателя;
		НоваяСтрока.ТипИндикатора = ИндикаторПоФормуле.ТипИндикатора;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ОбработатьОтборПоВидуОперацииРекурсивно(ЭлементыТекущегоОтбора)

	ИзменяемоеПолеОтбора = Новый ПолеКомпоновкиДанных("ВидОперации");	
	
	Сч = ЭлементыТекущегоОтбора.Количество();
	
	Пока Сч > 0 Цикл
		
		Сч = Сч - 1;
		
		ЭлементОтбора = ЭлементыТекущегоОтбора[Сч];
		
		Если Не ЭлементОтбора.Использование Тогда		
			Продолжить;		
		КонецЕсли; 
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда	
			ОбработатьОтборПоВидуОперацииРекурсивно(ЭлементОтбора.Элементы);	
			Продолжить;	
		КонецЕсли; 
		
		Если ЭлементОтбора.ЛевоеЗначение <> ИзменяемоеПолеОтбора Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеЭлементаОтбора		= ЭлементОтбора.ПравоеЗначение;
		
		ВидСравненияЭлементаОтбора 	= ЭлементОтбора.ВидСравнения;
		
		ИзменитьЭлементОтбораВидОперации(ЭлементыТекущегоОтбора, ЗначениеЭлементаОтбора, ВидСравненияЭлементаОтбора);		
		
		ЭлементыТекущегоОтбора.Удалить(ЭлементОтбора);
		
	КонецЦикла; 	

КонецПроцедуры

Процедура ИзменитьЭлементОтбораВидОперации(ЭлементыТекущегоОтбора, ЗначениеЭлементаОтбора, ВидСравненияЭлементаОтбора)
		
	ГруппаЭлементовОтбора 	= ЭлементыТекущегоОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
 	ГруппаЭлементовОтбора.ТипГруппы 	= ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
	
	ЭлементОтбораГруппы 	= ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораГруппы.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Проект.ЭтоПроектнаяЗадача");
	ЭлементОтбораГруппы.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбораГруппы.ПравоеЗначение 	= Ложь;

	ЭлементОтбораГруппы 	= ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораГруппы.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("ВидОперации");
	ЭлементОтбораГруппы.ВидСравнения 	= ВидСравненияЭлементаОтбора;
	ЭлементОтбораГруппы.ПравоеЗначение	= ЗначениеЭлементаОтбора;		 	

КонецПроцедуры

Процедура ИзменитьВидСравненияЭлементовОтбораПроекта(ВыводитьПроектныеЗадачи, ЭлементыОтбора, ЭтоВызовИзПанелиПоказателей)
	
	Если Не ВыводитьПроектныеЗадачи Или ЭтоВызовИзПанелиПоказателей = Неопределено
		Или Не ЭтоВызовИзПанелиПоказателей Тогда
		Возврат;
	КонецЕсли;
	
	ПолеКомпоновкиПроект = Новый ПолеКомпоновкиДанных("Проект");
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоРеквизитПроекта = СтрНайти(Строка(ЭлементОтбора.ЛевоеЗначение), "Проект.") <> 0;
		
		Если (ЭлементОтбора.ЛевоеЗначение <> ПолеКомпоновкиПроект И Не ЭтоРеквизитПроекта) Или Не ЭлементОтбора.Использование Тогда
			Продолжить;	
		КонецЕсли;
		
		Если ЭтоРеквизитПроекта Тогда
			ЛевоеЗначениеОтбораСтрокой = Строка(ЭлементОтбора.ЛевоеЗначение);
			ЛевоеЗначениеОтбораСтрокой = "Проект.упоКорневойПроект." + Прав(ЛевоеЗначениеОтбораСтрокой,
				СтрДлина(ЛевоеЗначениеОтбораСтрокой) - СтрДлина("Проект."));
			
			ПолеКомпоновкиПроект = Новый ПолеКомпоновкиДанных(ЛевоеЗначениеОтбораСтрокой);
			ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиПроект;
		ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
		ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСортировкуПоКодуСДР(ЭлементыСортировки)
	
	СортировкаПоКодуСДР = ЭлементыСортировки.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	СортировкаПоКодуСДР.Использование = Истина;
	СортировкаПоКодуСДР.Поле = Новый ПолеКомпоновкиДанных("Проект.КодСДР");
	СортировкаПоКодуСДР.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

Функция ПроверитьГруппировкуПоПроекту(Объект, ВыводитьПроектныеЗадачи, ОтдельныеЗапросыДляПроектовИЗадач, 
	ЭтоПроектнаяЗадача, СчитатьСуммуПоГруппировкам)
	
	Если Не ВыводитьПроектныеЗадачи Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ТипЗнч(Объект) = Тип("СправочникСсылка.Проекты") Тогда
		Возврат Ложь;
	КонецЕсли;

	Проверка = НЕ ЭтоПроектнаяЗадача И СчитатьСуммуПоГруппировкам И Не ОтдельныеЗапросыДляПроектовИЗадач;

	Возврат Проверка;

КонецФункции

#КонецОбласти
