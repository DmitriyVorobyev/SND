КонецПроцедуры

// Обработчик события, вызываемый при записи статей доходов и расходов ERP.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево 		- признак отказа от выполнения обработки.
Процедура ПриЗаписиПодразделенияИлиСтруктурыПредприятия(Источник, Отказ) Экспорт
	
	Если (Источник.ДополнительныеСвойства.Свойство("ВыполняетсяОбработчикЗаполнения")
		И Источник.ДополнительныеСвойства.ВыполняетсяОбработчикЗаполнения)
		Или Источник.ОбменДанными.Загрузка Тогда
		
		Возврат;
		
    КонецЕсли;
    
    // Только для ERP+PM.
    // При изменении на закладке "Настройки РМ" формы элемента спр.упоПодразделение не требуется синхронизация.
    // В случае записи на закладке "Настройки РМ", а затем перехода на основную закладку пользователю 
    // будет выдано сообщение, что данные были обновлены.
    Если Источник.ДополнительныеСвойства.Свойство("НеСинхронизироватьСоСтруктураПроекта")
		И Источник.ДополнительныеСвойства.НеСинхронизироватьСоСтруктураПроекта Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ВыполняетсяОбработчикЗаполнения = Истина;
	СинхронизироватьПодразделениеИСтруктуруПредприятия(Источник.Ссылка, ВыполняетсяОбработчикЗаполнения);
	
КонецПроцедуры

// Обработчик события, вызываемый при записи статей доходов и расходов.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево - признак отказа от выполнения обработки.
Процедура ПриЗаписиСтатейДР(Источник, Отказ) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.НеобходимаСинхронизацияСтатейДР() Тогда
		Возврат;
	КонецЕсли;	
	
	Если Источник.ДополнительныеСвойства.Свойство("НеСинхронизироватьСтатьиДР")
		И Источник.ДополнительныеСвойства.НеСинхронизироватьСтатьиДР Тогда 
		Возврат;
	КонецЕсли;
	
	СинхронизироватьСтатьиДР(Источник.Ссылка);
	
КонецПроцедуры

Процедура ПользователиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Пользователь", Источник.Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ГруппыДоступа.Ссылка КАК ГруппаДоступа
		               |ИЗ
		               |	Справочник.ГруппыДоступа КАК ГруппыДоступа
		               |ГДЕ
		               |	ГруппыДоступа.Пользователь = &Пользователь
		               |	И НЕ ГруппыДоступа.ПометкаУдаления";
		
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат;
		КонецЕсли;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			 Объект = Выборка.ГруппаДоступа.ПолучитьОбъект();
			 Объект.УстановитьПометкуУдаления(Истина);
			
		 КонецЦикла;
		 
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, вызываемый при записи сценариев.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево 		- признак отказа от выполнения обработки.
Процедура ПриЗаписиСценариев(Источник, Отказ) Экспорт
	
	Если Источник.ДополнительныеСвойства.Свойство("ВыполняетсяОбработчикЗаполнения")
		И Источник.ДополнительныеСвойства.ВыполняетсяОбработчикЗаполнения Тогда
		
		Возврат;
		
    КонецЕсли;
    	
	ВыполняетсяОбработчикЗаполнения = Истина;
	СинхронизироватьСценарии(Источник.Ссылка, ВыполняетсяОбработчикЗаполнения);
	
КонецПроцедуры

// Обработчик события, вызываемый перед записью валют, пользователей и групп пользователей.
// Заполнение служебных реквизитов необходимо для перехода на РМ5.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево 		- признак отказа от выполнения обработки.
//
Процедура ЗаполнитьСлужебныеРеквизиты(Источник, Отказ) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоЧистыйPM() Тогда
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.Валюты") Тогда
		
		Источник.НеИспользоватьЗагружаетсяИзИнтернета = Источник.ЗагружаетсяИзИнтернета;
		Источник.НеИспользоватьНаименованиеПолное = Источник.НаименованиеПолное;
		Источник.НеИспользоватьНаценка = Источник.Наценка;
