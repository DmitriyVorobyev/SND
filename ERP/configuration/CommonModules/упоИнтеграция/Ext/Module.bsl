#Область УправлениеДоступом

// Обработчик обновления, заполняет поставляемые группы доступа.
//
Процедура ЗаполнитьПоставляемыеГруппыДоступа(Параметр = Неопределено) Экспорт
	
	СтруктураГруппИПрофилей = ПолучитьСтруктуруТиповыхГруппИПрофилей();
	
	Для Каждого КлючЗначение Из СтруктураГруппИПрофилей Цикл
		Профиль = Справочники.ГруппыДоступа[КлючЗначение.Ключ].Профиль;
		Если Не ЗначениеЗаполнено(Профиль) Или Профиль.ПометкаУдаления Тогда
			Объект = Справочники.ГруппыДоступа[КлючЗначение.Ключ].ПолучитьОбъект();
			Объект.Профиль = Справочники.ПрофилиГруппДоступа[КлючЗначение.Значение];
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьПрофилиОбязательнымиРолямиРМа(ОписанияПрофилей, ИдентификаторыСлужПрофилей, КонфигурацияПродукта)
	
	ДобавитьОграничениеПоВидуДоступа = Истина;		
	Если КонфигурацияПродукта.ЭтоPM_Проф И Не КонфигурацияПродукта.ЭтоУПФ Тогда			
		ДобавитьОграничениеПоВидуДоступа = Ложь;
	КонецЕсли;
		
	Для Каждого ОписаниеПрофиля Из ОписанияПрофилей Цикл
		
		Если ИдентификаторыСлужПрофилей[ОписаниеПрофиля.Идентификатор] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОписаниеПрофиля.Свойство("Назначение") И ЗначениеЗаполнено(ОписаниеПрофиля.Назначение) Тогда
			Продолжить;
		КонецЕсли;
		
		// Роли
		Если ОписаниеПрофиля.Свойство("Роли") Тогда
			ОписаниеПрофиля.Роли.Добавить("упоБазовыеПраваEPM");
			ОписаниеПрофиля.Роли.Добавить("упоБазовыеПраваPM");
			Если КонфигурацияПродукта.ЭтоУПФ Тогда
				ОписаниеПрофиля.Роли.Добавить("упоБазовыеПраваУПФ");
			КонецЕсли;
		КонецЕсли;
		
		// Виды доступа
		Если ОписаниеПрофиля.Свойство("ВидыДоступа") Тогда
			Если ДобавитьОграничениеПоВидуДоступа Тогда
				ОписаниеПрофиля.ВидыДоступа.Добавить("упоПроекты", "ВначалеВсеЗапрещены");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

