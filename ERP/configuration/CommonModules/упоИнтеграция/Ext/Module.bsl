//
Процедура ЗаполнитьИсточникиДанныхДляПроверкиЗапретаИзменения(ИсточникиДанных) Экспорт
	
	ЗаполнитьИсточникиДанныхДляРазделаОбъемыФакт(ИсточникиДанных);
	ЗаполнитьИсточникиДанныхДляРазделаБДРФакт(ИсточникиДанных);
	ЗаполнитьИсточникиДанныхДляРазделаДДСФакт(ИсточникиДанных);
    ЗаполнитьИсточникиДанныхДляРазделаТрудозатратыФакт(ИсточникиДанных);
			
КонецПроцедуры

// См. ДатыЗапретаИзмененияПереопределяемый.ПередПроверкойЗапретаИзменения
//
Процедура ПередПроверкойЗапретаИзменения(Объект,
                                         ПроверкаЗапретаИзменения,
                                         УзелПроверкиЗапретаЗагрузки,
                                         ВерсияОбъекта) Экспорт
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.упоРаспределениеРабочегоВремениЗаНеделю") Тогда
		Если Объект.ДополнительныеСвойства.Свойство("РежимЗаписи") И 
			Объект.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
			УзелПроверкиЗапретаЗагрузки = Неопределено;
			ПроверкаЗапретаИзменения = Ложь;
		Иначе
			МесяцНачала = Месяц(Объект.ДеньНачалаНедели);
			МесяцКонец = Месяц(Объект.ДеньКонецНедели);
			
			Если Не Константы.упоРегистрироватьТрудозатратыПереходящейНеделиДвумяДокументами.Получить() Или
				МесяцНачала = МесяцКонец Тогда
				Возврат;
			КонецЕсли;
			
			ТаблицаДней = Объект.ПолучитьТаблицуДней();
			
			Объект.РассчитатьТрудозатратыНаКаждыйДень(ТаблицаДней);
			
			РезультатСравненияПериодов = Объект.ПроверитьНаличиеДанныхВДвухПериодах(ТаблицаДней, МесяцКонец, МесяцНачала);
			
			Если РезультатСравненияПериодов.ТрудозатратыКонечногоПериода > 0 Тогда
				
				ИмяРаздела = ИмяРазделТрудозатратыФакт();
				ЗапретНайден = ЕстьЗапретПоРазделуНаДату(ИмяРаздела, Объект.ДеньКонецНедели);
				
				Если Не ЗапретНайден Тогда
					ПроверкаЗапретаИзменения = Ложь;
					УзелПроверкиЗапретаЗагрузки = Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Отключает контроль запрета изменения по объектам для данных PM.
//
// Параметры:
//  Данные              - СправочникОбъект
//                      - ДокументОбъект
//                      - ПланВидовХарактеристикОбъект
//                      - ПланСчетовОбъект
//                      - ПланВидовРасчетаОбъект
//                      - БизнесПроцессОбъект
//                      - ЗадачаОбъект
//                      - ПланОбменаОбъект
//                      - РегистрСведенийНаборЗаписей
//                      - РегистрНакопленияНаборЗаписей
//                      - РегистрБухгалтерииНаборЗаписей
//                      - РегистрРасчетаНаборЗаписей - проверяемый элемент данных или набор записей.
//                      - Строка - полное имя объекта метаданных, данные которого следует проверить в базе данных.
//                                 Например: "Документ.ПриходнаяНакладная".
//                                 В этом случае следует указать в параметре ИдентификаторДанных,
//                                 какие именно данные требуется прочитать из базы и проверить.
//  БезОбъекта	 - Булево - признак контроля по объектам.
//
Процедура УстановитьРежимБезОбъектаДляДанныхPM(Данные, БезОбъекта) Экспорт

	Если БезОбъекта Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыPM = упоИнтеграцияПовтИсп.ОбъектыСКонтролемДатыЗапретаИзменения();
	
	Если ОбъектыPM[ТипЗнч(Данные)] = Истина Тогда
		БезОбъекта = Истина;
	КонецЕсли;

КонецПроцедуры

