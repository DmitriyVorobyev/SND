// Определяет доступность системы лицензирования
//
Функция ДоступнаСистемаЛицензирования() Экспорт
	
	ИменаРолей = Новый Массив;
	
	// Роли по умолчанию 
	ИменаРолей.Добавить("упоИспользованиеЗащищенногоФункционалаРМ");
	ИменаРолей.Добавить("ПолныеПрава");
	
	упоИнтеграцияПереопределяемый.ПриПроверкеДоступностиСистемыЛицензирования(ИменаРолей);
	
	ВсеРолиНедоступны = Истина;
	Для Каждого ИмяРоли Из ИменаРолей Цикл		
		Если РольДоступна(ИмяРоли) Тогда
			ВсеРолиНедоступны = Ложь;
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат Не ВсеРолиНедоступны;
	
КонецФункции

// Проверяет, является ли хотя бы один тип из переданного массива, интегрируемым с Документооборотом.
//
// Параметры:
//  МассивТипов	 - Массив
// 
// Возвращаемое значение:
//  Булево
//
Функция ТипИнтегрированСДокументооборотом(МассивТипов) Экспорт 
	
	ТипИнтегрирован = Ложь;
	
	ИнтегрированныеТипы = Метаданные.ОпределяемыеТипы.ИнтеграцияС1СДокументооборотВсеСсылкиПереопределяемый.Тип;
	
	Для Каждого ТипИсточника Из МассивТипов Цикл
		
		Если ИнтегрированныеТипы.СодержитТип(ТипИсточника) Тогда
			ТипИнтегрирован = Истина;
			Прервать;
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат ТипИнтегрирован;
	
КонецФункции

// Возвращает представление переданного объекта.
//
// Параметры:
//	ПараметрОбъект - Строка или ОбъектМетаданных - объект для получения представления
//
// Возвращаемое значение:
//	Строка - представление объекта
//
Функция ПредставлениеОбъекта(ПараметрОбъект) Экспорт
	
	Если ПараметрОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	МетаданныеОбъекта = ?(ТипЗнч(ПараметрОбъект) = Тип("Строка"), Метаданные.НайтиПоПолномуИмени(ПараметрОбъект), ПараметрОбъект);
	
	Представление = Новый Структура("ПредставлениеОбъекта");
	ЗаполнитьЗначенияСвойств(Представление, МетаданныеОбъекта);
	Если Не ПустаяСтрока(Представление.ПредставлениеОбъекта) Тогда
		Возврат Представление.ПредставлениеОбъекта;
	КонецЕсли;
	
	Возврат МетаданныеОбъекта.Представление();
	
КонецФункции

// Выполняет регистрацию изменений для всех объектов с правилами регистрации.
//
// Параметры:
//  УзелПланаОбмена	 - ПланОбменаСсылка	 - узел плана обмена.
//
Процедура ЗарегистрироватьИзмененияДляВсехОбъектовСПравиламиРегистрации(Знач УзелПланаОбмена) Экспорт
	
	ПравилаРегистрации = ОбменДаннымиXDTOСервер.ПравилаРегистрацииОбъектов(УзелПланаОбмена);
	Для Каждого ТекПравило Из ПравилаРегистрации Цикл
		ТекМетаданные = Метаданные.НайтиПоПолномуИмени(ТекПравило.ОбъектМетаданныхИмя);
		Если Не ТекМетаданные = Неопределено Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(УзелПланаОбмена, ТекМетаданные);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// См. ПодключаемыеКоманды.ПриСозданииНаСервере
//
Процедура ПодключаемыеКомандыПриСозданииНаСервере(Форма, ПараметрыРазмещения) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияУХ") Тогда
		МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУХ");
		МодульИнтеграции.ПодключаемыеКомандыПриСозданииНаСервере(Форма, ПараметрыРазмещения);
	КонецЕсли;
	Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияУПФ") Тогда
		МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияУПФСервер");
		МодульИнтеграции.ПодключаемыеКомандыПриСозданииНаСервере(Форма, ПараметрыРазмещения);
	КонецЕсли;
	
КонецПроцедуры

// Вызывает добавление команды открытия проекта формой интегрируемой конфигурации (ERP, УНФ).
//
// Параметры:
//  Форма	 - УправляемаяФорма
//
Процедура ДобавитьКомандуОткрытияЗамененнойФормыПроекта(Форма) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		
		ДобавитьКомандуОткрытияФормыПроекта(Форма, "Подключаемый_ОткрытьЗамененнуюФормуПроекта",
			НСтр("ru = 'Открыть форму проекта ERP'"));
		
	ИначеЕсли упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		
		ДобавитьКомандуОткрытияФормыПроекта(Форма, "Подключаемый_ОткрытьЗамененнуюФормуПроекта",
			НСтр("ru = 'Открыть форму проекта УНФ'"));
		
	КонецЕсли;
	
КонецПроцедуры

// Добавляет команду открытия формы интегрируемой конфигурации (ERP, УНФ).
//
// Параметры:
//  Форма		 - УправляемаяФорма
//  ИмяКоманды	 - Строка
//  Заголовок	 - Строка
//
Процедура ДобавитьКомандуОткрытияФормыПроекта(Форма, ИмяКоманды, Заголовок) Экспорт
	
	КомандаОткрытьФорму			 = Форма.Команды.Добавить(ИмяКоманды);
	КомандаОткрытьФорму.Действие = ИмяКоманды;
	
	ЭлементОткрытьФорму = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), Форма.Элементы.ФормаКоманднаяПанель);
	ЭлементОткрытьФорму.ИмяКоманды 			 = ИмяКоманды;
	ЭлементОткрытьФорму.Заголовок  			 = Заголовок;
	ЭлементОткрытьФорму.ТолькоВоВсехДействиях = Истина;
	
КонецПроцедуры

