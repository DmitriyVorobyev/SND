		ОписаниеВарианта.Описание = НСтр("ru = 'Анализ распределения доходов и расходов'");
		ОписаниеВарианта.Включен = ДоступенФункционалОПРОХР;
		
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалСогласованиеТрудозатрат() Тогда
		ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.упоСогласованныеТрудозатраты);
		ОписаниеВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, ОписаниеОтчета, "СогласованныеТрудозатраты");
		ОписаниеВарианта.Описание = НСтр("ru = 'Информация о согласованных фактических трудозатратах проектных задач.'");
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПричиныОтклонений() Тогда
		ОписаниеОтчета = ВариантыОтчетов.ОписаниеОтчета(Настройки, Метаданные.Отчеты.упоФакторныйАнализПричинОтклонений);
		ОписаниеВарианта = ВариантыОтчетов.ОписаниеВарианта(Настройки, ОписаниеОтчета, "Основной");
		ОписаниеВарианта.Описание = НСтр("ru = 'Вывод причин отклонений сроков проектных задач.'");
	КонецЕсли;
	
КонецПроцедуры

// Определяет разделы, в которых доступна команда вызова дополнительных обработок.
// В разделы необходимо добавить метаданные тех разделов,
// в которых размещены команды вызова.
// Для начальной страницы указать ДополнительныеОтчетыИОбработкиКлиентСервер.ИмяНачальнойСтраницы.
//
// Параметры:
//   Разделы - Массив - разделы, в которых размещены команды вызова дополнительных обработок.
//       * ОбъектМетаданных: Подсистема - метаданные раздела (подсистемы).
//       * Строка - для начальной страницы.
//
Процедура ОпределитьРазделыСДополнительнымиОбработками(Разделы) Экспорт
	
	упоИнтеграция.ОпределитьРазделыСВариантамиОтчетов(Разделы);		
	
КонецПроцедуры

// Уточняет сокращенное наименование интегрируемой конфигурации для вывода в заголовках и декорациях.
//
// Параметры:
//   СокращенноеНаименование - Строка - неявно возвращаемое значение, краткое название конфигурации.
//
// Пример:
//   СокращенноеНаименование = НСтр("ru = '1С:ERP УП'");
//
Процедура ПриОпределенииСокращенногоНаименованияКонфигурации(СокращенноеНаименование) Экспорт
	 
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		СокращенноеНаименование = НСтр("ru = '1С:ERP+PM'");
	ИначеЕсли упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		СокращенноеНаименование = НСтр("ru = '1С:УНФ+PM'");	
	ИначеЕсли упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Корп() Тогда
		СокращенноеНаименование = НСтр("ru = '1С:PM КОРП'");
	ИначеЕсли упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		СокращенноеНаименование = НСтр("ru = '1С:PM ПРОФ'");
	КонецЕсли; 
	
КонецПроцедуры

// Определяет префикс кодов и номеров объектов информационной базы по умолчанию.
//
// Параметры:
//	Префикс - Строка, 2 - префикс кодов и номеров объектов информационной базы по умолчанию.
//
Процедура ПриОпределенииПрефиксаИнформационнойБазыПоУмолчанию(Префикс) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоЧистыйPM() Тогда
		Префикс = НСтр("ru = 'ЦБ'");	
	КонецЕсли;	
	
КонецПроцедуры

// Определяет список планов обмена, которые используют функционал подсистемы обмена данными.
//
// Параметры:
//  ПланыОбменаПодсистемы - Массив - Массив планов обмена конфигурации,
//   которые используют функционал подсистемы обмена данными.
//   Элементами массива являются объекты метаданных планов обмена.
//
// Пример:
//   ПланыОбменаПодсистемы.Добавить(Метаданные.ПланыОбмена.ОбменБезИспользованияПравилКонвертации);
//   ПланыОбменаПодсистемы.Добавить(Метаданные.ПланыОбмена.ОбменСБиблиотекойСтандартныхПодсистем);
//   ПланыОбменаПодсистемы.Добавить(Метаданные.ПланыОбмена.РаспределеннаяИнформационнаяБаза);
//
Процедура ПолучитьПланыОбмена(ПланыОбменаПодсистемы) Экспорт
	 	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоЧистыйPM() Тогда
		ПланыОбменаПодсистемы.Добавить(Метаданные.ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат);
	КонецЕсли;

	ПланыОбменаПодсистемы.Добавить(Метаданные.ПланыОбмена.упоПереходНаPM);
	
КонецПроцедуры

// Получает доступные для использования версии универсального формата EnterpriseData.
//
// Параметры:
//   ВерсииФормата - Соответствие - Соответствие номера версии формата,
//                   общему модулю, в котором находятся обработчики выгрузки/загрузки для данной версии.
//
// Пример:
//   ВерсииФормата.Вставить("1.2", <ИмяОбщегоМодуляСПравиламиКонвертации>);
