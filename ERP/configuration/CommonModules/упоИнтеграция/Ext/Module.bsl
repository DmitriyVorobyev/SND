// См. РегламентныеЗаданияПереопределяемый.ПриОпределенииНастроекРегламентныхЗаданий
// 
Процедура ПриОпределенииНастроекРегламентныхЗаданий(Настройки) Экспорт
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.упоОбработкаДетекторовСобытий;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.упоИспользоватьОповещения;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ДоступноВМоделиСервиса = Ложь;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.упоОбработкаПроизошедшихСобытий;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.упоИспользоватьОповещения;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ДоступноВМоделиСервиса = Ложь;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.упоОтправкаСообщенийИзОчереди;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.упоИспользоватьОповещения;
	Настройка.РаботаетСВнешнимиРесурсами = Истина;
	Настройка.ДоступноВМоделиСервиса = Ложь;	
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.упоПересчетОграниченийДоступаПоПроектам;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.ОграничиватьДоступНаУровнеЗаписей;
	Настройка.РаботаетСВнешнимиРесурсами = Ложь;
	Настройка.ДоступноВМоделиСервиса = Ложь;
	
	Настройка = Настройки.Добавить();
	Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания.упоОтражениеДокументовВПроектномБюджетировании;
	Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции.упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании;
	Настройка.РаботаетСВнешнимиРесурсами = Ложь;
	Настройка.ДоступноВМоделиСервиса = Ложь;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Настройка = Настройки.Добавить();
		Настройка.РегламентноеЗадание = Метаданные.РегламентныеЗадания["упоРасчетСтатусовПроектнойПродукции"];
		Настройка.ФункциональнаяОпция = Метаданные.ФункциональныеОпции["упоИспользоватьПроектнуюПродукцию"];
		Настройка.РаботаетСВнешнимиРесурсами = Ложь;
		Настройка.ДоступноВМоделиСервиса = Ложь;
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоЧистыйPM()
		Или упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		// ИнтеграцияС1СДокументооборотом
		ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриОпределенииНастроекРегламентныхЗаданий(Настройки);
		// Конец ИнтеграцияС1СДокументооборотом
	КонецЕсли;
	
КонецПроцедуры

