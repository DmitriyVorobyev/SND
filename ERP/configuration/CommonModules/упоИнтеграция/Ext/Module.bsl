		|Документ.упоСогласованиеТрудозатрат.Чтение.упоПроекты
		|Документ.упоСогласованиеТрудозатрат.Изменение.упоПроекты
		|РегистрНакопления.упоСогласованныеТрудозатраты.Чтение.упоПроекты";
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалВерсионированиеДопРеквизитов() Тогда
		Описание = Описание + "
		|РегистрСведений.упоДополнительныеРеквизитыВерсии.Чтение.упоПроекты
		|РегистрСведений.упоДополнительныеРеквизитыВерсии.Изменение.упоПроекты";
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределениеКосвенныхРасходов() Тогда
		Описание = Описание + "
		|Документ.упоРаспределениеРасходовПоПроектамФакт.Чтение.упоПроекты
		|Документ.упоРаспределениеРасходовПоПроектамФакт.Изменение.упоПроекты";
	КонецЕсли;
	
КонецПроцедуры

// Определяет объекты конфигурации, в модулях менеджеров которых размещена процедура ДобавитьКомандыПечати,
// формирующая список команд печати, предоставляемых этим объектом.
// Синтаксис процедуры ДобавитьКомандыПечати см. в документации к подсистеме.
//
// Параметры:
//  СписокОбъектов - Массив - менеджеры объектов с процедурой ДобавитьКомандыПечати.
//
Процедура ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов) Экспорт
	 
	СписокОбъектов.Добавить(Документы.упоРасчетЦеныКонтракта);
	СписокОбъектов.Добавить(Документы.упоРегистрацияФактическиВыполненногоОбъема);
	СписокОбъектов.Добавить(Документы.упоРегистрацияФактическихДоходовИРасходов);
	СписокОбъектов.Добавить(Документы.упоРегистрацияФактическихЗатратМатРесурсов);
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		
		СписокОбъектов.Добавить(Документы.упоСтатусОтчетПоПроекту);
		СписокОбъектов.Добавить(Документы.упоСводныйСтатусОтчетПоПроектам);
		
	КонецЕсли; 
	
КонецПроцедуры

// См. ЗагрузкаДанныхИзФайлаПереопределяемый.ПриОпределенииСправочниковДляЗагрузкиДанных()
//
Процедура ПриОпределенииСправочниковДляЗагрузкиДанных(ЗагружаемыеСправочники) Экспорт
	
	МетаданныеСправочники = Метаданные.Справочники;
	
	//
	
	ДобавляемыеСправочники = Новый Массив;
	ДобавляемыеСправочники.Добавить("упоТрудовыеРесурсы");
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		ДобавляемыеСправочники.Добавить("упоПроектнаяПродукция");
	КонецЕсли;
	
	Для Каждого ИмяОбъекта Из ДобавляемыеСправочники Цикл
		ОбъектМетаданныхДляВывода = МетаданныеСправочники[ИмяОбъекта];
		
		Строка = ЗагружаемыеСправочники.Добавить();
		Строка.Представление = ОбъектМетаданныхДляВывода.Представление();
		Строка.ПолноеИмя = ОбъектМетаданныхДляВывода.ПолноеИмя();
	КонецЦикла;
	
	//
	
	УдаляемыеСправочники = Новый Массив;
	УдаляемыеСправочники.Добавить("упоИзбранныеДействия");
	УдаляемыеСправочники.Добавить("упоКлючиАналитикиФактаБДР");
	УдаляемыеСправочники.Добавить("упоКонфигурацияПродуктаPM"); 
	
	Для Каждого ИмяОбъекта Из УдаляемыеСправочники Цикл
		ОбъектМетаданныхДляВывода = МетаданныеСправочники[ИмяОбъекта];
		ПолноеИмя = ОбъектМетаданныхДляВывода.ПолноеИмя();
		
		НайденныйЭлемент = ЗагружаемыеСправочники.Найти(ПолноеИмя, "ПолноеИмя");
		Если ЗначениеЗаполнено(НайденныйЭлемент) Тогда
			ЗагружаемыеСправочники.Удалить(НайденныйЭлемент);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// См. РаботаВБезопасномРежимеПереопределяемый.ПриЗаполненииРазрешенийНаДоступКВнешнимРесурсам()
//
Процедура ПриЗаполненииРазрешенийНаДоступКВнешнимРесурсам(ЗапросыРазрешений) Экспорт
	
	МодульРаботаВБезопасномРежиме = ОбщегоНазначения.ОбщийМодуль("РаботаВБезопасномРежиме");
	
	Разрешения = Новый Массив;
	Разрешения.Добавить(МодульРаботаВБезопасномРежиме.РазрешениеНаИспользованиеВнешнейКомпоненты(
		"ОбщийМакет.слкКомпонентаЗащиты", НСтр("ru = 'Компонента защиты СЛК.'")));
	ЗапросыРазрешений.Добавить(
		МодульРаботаВБезопасномРежиме.ЗапросНаИспользованиеВнешнихРесурсов(Разрешения));
	
КонецПроцедуры

// См. ВариантыОтчетовПереопределяемый.ОпределитьОбъектыСКомандамиОтчетов
//
Процедура ОпределитьОбъектыСКомандамиОтчетов(Объекты) Экспорт
	
