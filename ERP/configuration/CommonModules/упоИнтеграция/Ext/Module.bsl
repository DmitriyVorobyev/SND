// Создает для каждого сценария ЕРП соответствующий элемент сценария PM.
Процедура СинхронизироватьВсеСценари() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	упоСоответствиеСценариев.СценарийERP КАК СценарийERP
	                      |ПОМЕСТИТЬ втСопоставленныеСценарии
	                      |ИЗ
	                      |	РегистрСведений.упоСоответствиеСценариев КАК упоСоответствиеСценариев
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	Сценарии.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.Сценарии КАК Сценарии
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ втСопоставленныеСценарии КАК втСопоставленныеСценарии
	                      |		ПО Сценарии.Ссылка = втСопоставленныеСценарии.СценарийERP
	                      |ГДЕ
	                      |	втСопоставленныеСценарии.СценарийERP ЕСТЬ NULL
	                      |	И НЕ Сценарии.ПометкаУдаления");
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	ВыполняетсяОбработчикЗаполнения = Истина;
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
		Попытка
			СинхронизироватьСценарии(Выборка.Ссылка, ВыполняетсяОбработчикЗаполнения);
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ВызватьИсключение(ТекстОшибки);
			ОтменитьТранзакцию();
		КонецПопытки;
	КонецЦикла;
	
	Если ТранзакцияАктивна() Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

// Создаёт для сценария сквозного версионирования сценарий ERP.
Функция СинхронизироватьСценарии(ЭлементИсточник, ВыполняетсяОбработчикЗаполнения = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ЭлементИсточник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
	Если Не ЭтоEPM Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.упоСценарии") Тогда
		СправочникМенеджер = Справочники.Сценарии;
	ИначеЕсли ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.Сценарии") Тогда
		СправочникМенеджер = Справочники.упоСценарии;
	Иначе
		ВызватьИсключение НСтр("ru = 'Неверный тип параметра ""ЭлементИсточник"" функции
		|""СинхронизироватьСценарии"".'");
	КонецЕсли;
	
	ДопИнформацияОбИсточнике 	= Неопределено;
	ЗаписываемыйЭлемент 		= Неопределено;
	НужноЗаписатьСвязь 			= Ложь;
	
	РеквизитыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементИсточник, "Наименование, ПометкаУдаления");
	
	СвязанныйЭлемент = упоИнтеграцияВызовСервера.НайтиСвязанныйЭлементСценария(ЭлементИсточник, ДопИнформацияОбИсточнике);
	
	Если Не ЗначениеЗаполнено(СвязанныйЭлемент) Тогда
		ЗаписываемыйЭлемент = СправочникМенеджер.СоздатьЭлемент();
		НужноЗаписатьСвязь 	= Истина;
	Иначе
		ЗаписываемыйЭлемент = СвязанныйЭлемент.ПолучитьОбъект();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЗаписываемыйЭлемент, РеквизитыИсточника);
	
	Если ЗаписываемыйЭлемент.Модифицированность() Тогда
		ЗаписываемыйЭлемент.ДополнительныеСвойства.Вставить("ВыполняетсяОбработчикЗаполнения", Истина);
		ЗаписываемыйЭлемент.Записать();
	КонецЕсли;
	
	СвязанныйЭлемент = ЗаписываемыйЭлемент.Ссылка;
	
	Если НужноЗаписатьСвязь Тогда
		
		Запись = РегистрыСведений.упоСоответствиеСценариев.СоздатьМенеджерЗаписи();
		Если ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.упоСценарии") Тогда
			Запись.Сценарий 	= ЭлементИсточник;
			Запись.СценарийERP  = СвязанныйЭлемент;
		Иначе // Сценарий ERP.
			Запись.Сценарий     = СвязанныйЭлемент;
			Запись.СценарийERP  = ЭлементИсточник;
		КонецЕсли;
		Запись.Записать();
		
	КонецЕсли;
	
	Возврат СвязанныйЭлемент;
	
КонецФункции

