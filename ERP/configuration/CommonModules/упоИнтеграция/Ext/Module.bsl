// Переопределяемый обработчик события формы "При создании".
//
// Параметры:
//  Форма				 - УправляемаяФорма
//  Отказ				 - Булево
//  СтандартнаяОбработка - Булево
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	ПриСозданииНаСервере_ИнтегрированнаяКонфигурация(Форма, Отказ, СтандартнаяОбработка);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияEPM") Тогда
		МодульИнтеграции = ОбщегоНазначения.ОбщийМодуль("упоИнтеграцияEPMСервер");
		МодульИнтеграции.ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка);
