Процедура ПриСозданииНаСервере_ИнтегрированнаяКонфигурация(Форма, Отказ, СтандартнаяОбработка)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Справочник.Пользователи.Форма.ФормаЭлемента" Тогда
		ДобавитьЭлементы_Пользователи_ФормаЭлемента(Форма);
	ИначеЕсли Форма.ИмяФормы = "Обработка.УдалениеПомеченныхОбъектов.Форма.ОсновнаяФорма" Тогда
		ДобавитьЭлементы_УдалениеПомеченныхОбъектов_ОсновнаяФорма(Форма);
	ИначеЕсли Форма.ИмяФормы = "Обработка.ПанельАдминистрированияБИД.Форма.НастройкаИнтеграцииС1СДокументооборотом" Тогда
		ДобавитьЭлементы_ПанельАдминистрированияБИД_НастройкаИнтеграцииC1СДокументооборотом(Форма);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет элементы управления в форму.
//
// Параметры:
//  ЭтаФорма - УправляемаяФорма	 - форма, на которую добавляем.
//
Процедура ДобавитьЭлементы_Пользователи_ФормаЭлемента(ЭтаФорма)
	
	ЕстьПравоДоступа_упоСотрудники = ПравоДоступа("Чтение", Метаданные.Справочники.упоСотрудники);
	Если Не ЕстьПравоДоступа_упоСотрудники Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);

	// Добавим новый реквизит - динамический список.
	ИмяДССписокПользователей = "ДССписокСотрудниковПользователя";
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяДССписокПользователей, 
		Новый ОписаниеТипов("ДинамическийСписок")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СотрудникПоУмолчанию", 
		Новый ОписаниеТипов("СправочникСсылка.упоСотрудники"),,, Истина));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СотрудникПоУмолчаниюДоИзменения", 
		Новый ОписаниеТипов("СправочникСсылка.упоСотрудники")));
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Установим свойства для нового реквизита.
	ЭтаФорма[ИмяДССписокПользователей].ПроизвольныйЗапрос = Истина;
	ЭтаФорма[ИмяДССписокПользователей].ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ДиспетчерыСистемы.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.упоДиспетчерыСистемы.СрезПоследних(, Пользователь = &Пользователь) КАК ДиспетчерыСистемы
		|ГДЕ
		|	ДиспетчерыСистемы.ФлагУправления";
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтаФорма[ИмяДССписокПользователей],
	"Пользователь", ЭтаФорма.Объект.Ссылка);
	
	ЭтаФорма[ИмяДССписокПользователей].ДинамическоеСчитываниеДанных = Ложь;
	ЭтаФорма[ИмяДССписокПользователей].ОсновнаяТаблица = "РегистрСведений.упоДиспетчерыСистемы.СрезПоследних";
	
	// Добавим страницу "Диспетчер".
	НоваяСтрДиспетчер = ЭтаФорма.Элементы.Добавить("СтраницаДиспетчер", Тип("ГруппаФормы"), ЭтаФорма.Элементы.Страницы);
	НоваяСтрДиспетчер.Вид = ВидГруппыФормы.Страница;
	НоваяСтрДиспетчер.Заголовок = НСтр("ru = 'Диспетчер'");
	
	// Добавим поле выбора сотрудника по умолчанию.
	НовыйЭУСотрудникПоУмолчанию = ЭтаФорма.Элементы.Добавить("СотрудникПоУмолчанию", Тип("ПолеФормы"), НоваяСтрДиспетчер);
	НовыйЭУСотрудникПоУмолчанию.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭУСотрудникПоУмолчанию.Заголовок = НСтр("ru = 'Сотрудник по умолчанию'");
	НовыйЭУСотрудникПоУмолчанию.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭУСотрудникПоУмолчанию.ПутьКДанным = "СотрудникПоУмолчанию";
	НовыйЭУСотрудникПоУмолчанию.УстановитьДействие("НачалоВыбора", "Подключаемый_упоСотрудникПоУмолчаниюНачалоВыбора");
	НовыйЭУСотрудникПоУмолчанию.УстановитьДействие("ПриИзменении", "Подключаемый_упоСотрудникПоУмолчаниюПриИзменении");
	НовыйЭУСотрудникПоУмолчанию.РедактированиеТекста = Ложь;
	НовыйЭУСотрудникПоУмолчанию.КнопкаОчистки = Истина;
	НовыйЭУСотрудникПоУмолчанию.КнопкаВыпадающегоСписка = Ложь;
	НовыйЭУСотрудникПоУмолчанию.КнопкаВыбора = Истина;
	НовыйЭУСотрудникПоУмолчанию.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	
	// Установим сотрудника по умолчанию, если он был сохранен ранее.
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.Ссылка) Тогда
		СотрудникПользователяПоУмолчанию = упоПользователиВызовСервера.обПолучитьНастройкуПользователя(
			"СотрудникПоУмолчанию", 
			ЭтаФорма.Объект.Ссылка);
	Иначе
		СотрудникПользователяПоУмолчанию = Неопределено
	КонецЕсли;
	
	ЭтаФорма["СотрудникПоУмолчанию"] = ?(СотрудникПользователяПоУмолчанию = Неопределено, 
		Справочники.упоСотрудники.ПустаяСсылка(), СотрудникПользователяПоУмолчанию);
	ЭтаФорма["СотрудникПоУмолчаниюДоИзменения"] = ЭтаФорма["СотрудникПоУмолчанию"];
	
	// Добавим поле выбора основного трудового ресурса.
	НовыйЭУСотрудникПоУмолчанию = ЭтаФорма.Элементы.Добавить("упоОсновнойТрудовойРесурс", 
		Тип("ПолеФормы"), НоваяСтрДиспетчер);
	НовыйЭУСотрудникПоУмолчанию.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭУСотрудникПоУмолчанию.ПутьКДанным = "Объект.упоОсновнойТрудовойРесурс";
	
	// Добавим ЭУ СписокСотрудниковПользователя.
	НовыйЭУТаблицаСотрудников = ЭтаФорма.Элементы.Добавить("СписокСотрудниковПользователя", 
		Тип("ТаблицаФормы"), НоваяСтрДиспетчер);
	НовыйЭУТаблицаСотрудников.ПутьКДанным = ИмяДССписокПользователей;
	
	// Добавим колонку для ЭУ.
	НоваяКолонкаТаблицыСотрудников = ЭтаФорма.Элементы.Добавить("СписокСотрудниковПользователяСотрудник", 
		Тип("ПолеФормы"), НовыйЭУТаблицаСотрудников);
	НоваяКолонкаТаблицыСотрудников.ПутьКДанным = ИмяДССписокПользователей + ".Сотрудник";
	
	// Добавим условное оформление. Текущий сотрудник должен быть жирный.
	НовыйЭлементУсловногоОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", 
		Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина));
	ОформляемоеПоле 	 		 = НовыйЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле 		 = Новый ПолеКомпоновкиДанных("СписокСотрудниковПользователя");
	ЭлементОтбора 				 = НовыйЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных(ИмяДССписокПользователей + ".Сотрудник");
	ЭлементОтбора.ПравоеЗначение = ПараметрыСеанса.упоТекущийСотрудник;
	
КонецПроцедуры

Процедура ДобавитьЭлементы_УдалениеПомеченныхОбъектов_ОсновнаяФорма(Форма)
	
	Элементы = Форма.Элементы;
	
	// ******   Группа формы "упоГруппаИнформацияPM"    ***********
	НовыйЭлемент = Элементы.Вставить("упоГруппаИнформацияPM", Тип("ГруппаФормы"), , Элементы.КоманднаяПанельФормы);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Группа Информация PM'");
	НовыйЭлемент.РазрешитьИзменениеСостава = Ложь;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	
	// ******   Декорация формы "упоНадписьИнформация"    ***********
	НовыйЭлемент = Элементы.Добавить("упоНадписьИнформация", Тип("ДекорацияФормы"), Элементы.упоГруппаИнформацияPM);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.АвтомаксимальнаяШирина = Ложь;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Для удаления проектов следует использовать'");
	
	// ******   Декорация формы "упоНадписьСсылка"    ***********
	НовыйЭлемент = Элементы.Добавить("упоНадписьСсылка", Тип("ДекорацияФормы"), Элементы.упоГруппаИнформацияPM);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.АвтомаксимальнаяШирина = Ложь;
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Удаление проекта и его элементов'");
	НовыйЭлемент.УстановитьДействие("Нажатие","Подключаемый_упоОткрытьОбработкуУдалениеПроектаНажатие");
	
КонецПроцедуры

Процедура ДобавитьЭлементы_ПанельАдминистрированияБИД_НастройкаИнтеграцииC1СДокументооборотом(Форма)
	
	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("ДекорацияОписаниеНазначенияФормы") <> Неопределено Тогда
		Элементы.ДекорацияОписаниеНазначенияФормы.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
		ТекстПодсказки = НСтр("ru = 'Пользовательская документация по работе с подсистемой ""Интеграция с 1С:Документооборот"" размещена на сайте 1С:ИТС в разделе 
			|""Инструкции по разработке на 1С - Библиотека интеграции с 1С:Документооборотом - Библиотека интеграции с 1С:Документооборотом <Редакция библиотеки> - Пользовательская документация"".
			|Редакция библиотеки указана в файле поставки ""Версии библиотек.txt"", а также в разделе программы 
			|""Администрирование - Параметры подсистемы PM - Версии подсистем конфигурации - БиблиотекаИнтеграцииС1СДокументооборотом"".'");
		Элементы.ДекорацияОписаниеНазначенияФормы.РасширеннаяПодсказка.Заголовок = ТекстПодсказки;
		Элементы.ДекорацияОписаниеНазначенияФормы.РасширеннаяПодсказка.АвтомаксимальнаяШирина = Ложь;
	КонецЕсли;
	
КонецПроцедуры

