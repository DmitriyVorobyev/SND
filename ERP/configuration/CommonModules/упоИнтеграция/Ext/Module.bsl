// Может вызываться из модулей обновления интеграционных подсистем (например, из УПФ)
// 
// Возвращаемое значение:
// СтруктураГруппИПрофилей - перечень всех типовых профилей групп доступа, где ключ - наименование группы доступа,
//							 а значение - наименование профиля группы доступа
//
Функция ПолучитьСтруктуруТиповыхГруппИПрофилей() Экспорт
	
	СтруктураГруппИПрофилей = Новый Структура;
	СтруктураГруппИПрофилей.Вставить("упоАдминистраторыПроектногоОфиса", "упоАдминистраторПроектногоОфиса");
	СтруктураГруппИПрофилей.Вставить("упоИсполнителиРабот", "упоИсполнительРаботБезФинансов");
	СтруктураГруппИПрофилей.Вставить("упоРуководителиПроектногоОфиса", "упоРуководительПроектногоОфиса");
	СтруктураГруппИПрофилей.Вставить("упоРуководителиПроектовПодразделений", "упоРуководительПроектовПодразделений");
	СтруктураГруппИПрофилей.Вставить("упоРуководителиПроектовПодразделенийБезФинансов",
		"упоРуководительПроектовПодразделенийБезФинансов");
	СтруктураГруппИПрофилей.Вставить("упоФинансистыПроектногоОфиса", "упоФинансистПроектногоОфиса");
	СтруктураГруппИПрофилей.Вставить("упоОповещения_ИзмененияСтатусовПроектов", "упоОсобыеПраваНаОповещения");
	СтруктураГруппИПрофилей.Вставить("упоИспользованиеЗащищенногоФункционала", "упоИспользованиеЗащищенногоФункционала");
	СтруктураГруппИПрофилей.Вставить("упоВыборПроектныхЗадачКакПроекта", "упоВыборПроектныхЗадачКакПроекта");    
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		СтруктураГруппИПрофилей.Вставить("упоРаботаСПроектамиДополнительный", "упоРаботаСПроектамиДополнительный");    		
	КонецЕсли;	
	
	Возврат СтруктураГруппИПрофилей;
	
КонецФункции

Функция ПолучитьПризнакиКонфигурацийПродукта()
	
	КонфигурацияПродукта = Новый Структура();
	КонфигурацияПродукта.Вставить("ЭтоEPM", упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM());
	КонфигурацияПродукта.Вставить("ЭтоDev2", упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2());
	КонфигурацияПродукта.Вставить("ЭтоPM_Проф", упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф());
	КонфигурацияПродукта.Вставить("ЭтоУПФ", упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ());
	
	Возврат КонфигурацияПродукта;
	
КонецФункции

#КонецОбласти

#Область СвязьПодразделенийИСтруктурыПредприятия

// Создает для каждого подразделения соответствующий элемент структуры предприятия.
Процедура СинхронизироватьВсеПодразделенияИСтруктурыПредприятия() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить("ВЫБРАТЬ
		|	Подразделения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.упоПодразделения КАК Подразделения");
	Если ЭтоУПФ Тогда
		ЧастиЗапроса.Добавить("
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтруктурныеЕдиницы.Ссылка
		|ИЗ
		|	Справочник.СтруктурныеЕдиницы КАК СтруктурныеЕдиницы
		|ГДЕ
		|	СтруктурныеЕдиницы.ТипСтруктурнойЕдиницы = ЗНАЧЕНИЕ(Перечисление.ТипыСтруктурныхЕдиниц.Подразделение)");
	Иначе
		ЧастиЗапроса.Добавить("
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтруктураПредприятия.Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВыполняетсяОбработчикЗаполнения = Истина;
	Пока Выборка.Следующий() Цикл
		СинхронизироватьПодразделениеИСтруктуруПредприятия(Выборка.Ссылка, ВыполняетсяОбработчикЗаполнения);
	КонецЦикла;
	
КонецПроцедуры

Функция СинхронизироватьПодразделениеИСтруктуруПредприятия(ЭлементИсточник, ВыполняетсяОбработчикЗаполнения = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ЭлементИсточник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
		И Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2()
		И Не ЭтоУПФ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоУПФ И ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда
		ТипСтруктурнойЕдиницы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементИсточник, "ТипСтруктурнойЕдиницы", Истина); 
		ТипСтруктурнойЕдиницыПодразделение = 
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыСтруктурныхЕдиниц.Подразделение");
		Если ТипСтруктурнойЕдиницы <> ТипСтруктурнойЕдиницыПодразделение Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.упоПодразделения") Тогда
		Если ЭтоУПФ Тогда
			СправочникМенеджер = Справочники.СтруктурныеЕдиницы;
		Иначе
			СправочникМенеджер = Справочники.СтруктураПредприятия;
		КонецЕсли;
	ИначеЕсли Не ЭтоУПФ И ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.СтруктураПредприятия")
		Или ЭтоУПФ И ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.СтруктурныеЕдиницы") Тогда				
		СправочникМенеджер = Справочники.упоПодразделения;
	Иначе
		ВызватьИсключение НСтр("ru = 'Неверный тип параметра ""ЭлементИсточник"" функции
		|""СинхронизироватьПодразделениеИСтруктуруПредприятия"".'");
	КонецЕсли;
	
	ДопИнформацияОбИсточнике 	= Неопределено;
	ЗаписываемыйЭлемент 		= Неопределено;
	НужноЗаписатьСвязь 			= Ложь;
	
	РеквизитыИсточника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементИсточник, 
		"Наименование, ПометкаУдаления, Родитель");
	
	Если ЗначениеЗаполнено(РеквизитыИсточника.Родитель) Тогда
		ЭлементРодитель = СинхронизироватьПодразделениеИСтруктуруПредприятия(РеквизитыИсточника.Родитель, Истина);
	Иначе
		ЭлементРодитель = СправочникМенеджер.ПустаяСсылка();
	КонецЕсли;	
	
	СвязанныйЭлемент = упоИнтеграцияВызовСервера.НайтиСвязанныйЭлементСтруктурыИлиПодразделения(
		ЭлементИсточник, 
		ДопИнформацияОбИсточнике);
	
	Если Не ЗначениеЗаполнено(СвязанныйЭлемент) Тогда
		
		ЗаписываемыйЭлемент = НовыйОбъектСИдентификаторомИсходного(СправочникМенеджер, ЭлементИсточник);
		
		Если ЭтоУПФ И СправочникМенеджер = Справочники.СтруктурныеЕдиницы Тогда
			ЗаписываемыйЭлемент.ТипСтруктурнойЕдиницы = 
				ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыСтруктурныхЕдиниц.Подразделение");
			КонецЕсли;
			
		НужноЗаписатьСвязь = Истина;
	Иначе
		ЗаписываемыйЭлемент = СвязанныйЭлемент.ПолучитьОбъект();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЗаписываемыйЭлемент, РеквизитыИсточника, "Наименование, ПометкаУдаления");
	ЗаписываемыйЭлемент.Родитель = ЭлементРодитель;
	
	Если ЗаписываемыйЭлемент.Модифицированность() Тогда
		ЗаписываемыйЭлемент.ДополнительныеСвойства.Вставить("ВыполняетсяОбработчикЗаполнения", Истина);
		ЗаписываемыйЭлемент.Записать();
	КонецЕсли;
	
	СвязанныйЭлемент = ЗаписываемыйЭлемент.Ссылка;
	
	Если НужноЗаписатьСвязь Тогда
		
		Запись = РегистрыСведений.упоСоответствиеПодразделенийИСтруктурыПредприятия.СоздатьМенеджерЗаписи();
		Если ТипЗнч(ЭлементИсточник) = Тип("СправочникСсылка.упоПодразделения") Тогда
			Запись.Подразделение 		= ЭлементИсточник;
			Запись.СтруктураПредприятия = СвязанныйЭлемент;
		Иначе // Структура предприятия или структурная единица.
			Запись.Подразделение 		= СвязанныйЭлемент;
			Запись.СтруктураПредприятия = ЭлементИсточник;
		КонецЕсли;
		Запись.Записать();
		
	КонецЕсли;
	
	Возврат СвязанныйЭлемент;
	
КонецФункции

#КонецОбласти

#Область СвязьСтатейБДР_СправочниковУПО_И_ПВХ_ERP

// Синхронизирует все статьи ДР.
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция СинхронизироватьВсеСтатьиДР() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда 
		
		Запрос.Текст = "ВЫБРАТЬ
		|	СтатьиДоходов.Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.СтатьиДоходов КАК СтатьиДоходов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СтатьиРасходов.Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.СтатьиРасходов КАК СтатьиРасходов";
		
	Иначе 
		
		Запрос.Текст = 	
		"ВЫБРАТЬ
		|	Управленческий.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.Управленческий КАК Управленческий
		|ГДЕ
		|	Управленческий.ТипСчета <> &ТипСчетаГруппаСчетов";
		
		Запрос.УстановитьПараметр("ТипСчетаГруппаСчетов", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыСчетов.ГруппаСчетов"));
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СинхронизироватьСтатьиДР(Выборка.Ссылка);
	КонецЦикла;
	
КонецФункции

// Вызывает функцию синхронизации статьи ДР.
//
// Параметры:
//  Статья	 - ПланВидовХарактеристикСсылка.СтатьиРасходов, ПланВидовХарактеристикСсылка.СтатьиДоходов,
//  		   СправочникСсылка.СтатьиЗатрат, СправочникСсылка.упоСтатьиДоходов - статья ERP\PM.
// 
// Возвращаемое значение:
//  СвязаннаяСтатья  - ПланВидовХарактеристикСсылка.СтатьиРасходов, ПланВидовХарактеристикСсылка.СтатьиДоходов,
//  		   СправочникСсылка.СтатьиЗатрат, СправочникСсылка.упоСтатьиДоходов - связанная статья ERP\PM.
//
Функция СинхронизироватьСтатьиДР(Статья) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.НеобходимаСинхронизацияСтатейДР() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Статья) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат СоздатьСвязатьСтатьюДР(Статья);
	
КонецФункции 

// Синхронизирует статью ДР.
//
// Параметры:
//  Статья	 - ПланВидовХарактеристикСсылка.СтатьиРасходов, ПланВидовХарактеристикСсылка.СтатьиДоходов,
//  		   СправочникСсылка.СтатьиЗатрат, СправочникСсылка.упоСтатьиДоходов - статья ERP\PM.
// 
// Возвращаемое значение:
//  СвязаннаяСтатья  - ПланВидовХарактеристикСсылка.СтатьиРасходов, ПланВидовХарактеристикСсылка.СтатьиДоходов,
//  		   СправочникСсылка.СтатьиЗатрат, СправочникСсылка.упоСтатьиДоходов - связанная статья ERP\PM.
//
Функция СоздатьСвязатьСтатьюДР(Статья) Экспорт
	
	ТипСтатьи = ТипЗнч(Статья);
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		
		Если ТипСтатьи = Тип("ПланСчетовСсылка.Управленческий") Тогда 
			
			Возврат упоИнтеграцияУПФСервер.СоздатьСвязатьСтатьюДР_изУНФвPM(Статья, Неопределено);
			
		КонецЕсли;
		
	Иначе 
		
		Если ТипСтатьи = Тип("ПланВидовХарактеристикСсылка.СтатьиДоходов") ИЛИ
			ТипСтатьи = Тип("ПланВидовХарактеристикСсылка.СтатьиРасходов") Тогда
			
			Возврат упоИнтеграцияEPMСервер.СоздатьСвязатьСтатьюДР_изERPвPM(Статья);
			
		Иначе
			
			Возврат упоИнтеграцияEPMСервер.СоздатьСвязатьСтатьюДР_изPMвERP(Статья);
			
