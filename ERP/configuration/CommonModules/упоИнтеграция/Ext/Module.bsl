// См. УправлениеСвойствамиПереопределяемый.ПриПолученииПредопределенныхНаборовСвойств()
//
Процедура ПриПолученииПредопределенныхНаборовСвойств(Наборы) Экспорт
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалФазыПроекта() Тогда
		Использование = ПолучитьФункциональнуюОпцию("упоИспользоватьФазыПроектов");
		ДобавитьИспользованиеПреопределенногоНабораСвойств(Наборы, "Справочник_упоФазыПроектов", Использование);
	КонецЕсли;
	
	//  
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалРасчетЦеныКонтракта() Тогда
		Использование = ПолучитьФункциональнуюОпцию("упоИспользоватьРасчетЦеныКонтракта");
		ДобавитьИспользованиеПреопределенногоНабораСвойств(Наборы, "Документ_упоРасчетЦеныКонтракта", Использование);
	КонецЕсли;
	
	//
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалСогласованиеТрудозатрат() Тогда
		Использование = ПолучитьФункциональнуюОпцию("упоИспользоватьРасчетЦеныКонтракта");
		ДобавитьИспользованиеПреопределенногоНабораСвойств(Наборы, "Документ_упоСогласованиеТрудозатрат", Использование);
	КонецЕсли;
	
	//       
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалЗаявкиНаПроекты() Тогда
		Использование = ПолучитьФункциональнуюОпцию("упоИспользоватьЗаявкиНаПроекты");
		ИменаНаборов = Новый Массив;
		ИменаНаборов.Добавить("Документ_упоЗаявкаНаПроект");
		ИменаНаборов.Добавить("Документ_упоРасчетИтоговогоБаллаПроектов");
		ИменаНаборов.Добавить("Документ_упоРегистрацияПоказателейЭффективностиПроекта");
		ИменаНаборов.Добавить("Документ_упоСоответствиеСтратегическимЦелям");
		ИменаНаборов.Добавить("Документ_упоФормированиеБизнесПлана");
		ДобавитьИспользованиеПреопределенныхНаборовСвойств(Наборы, ИменаНаборов, Использование);
	КонецЕсли;
	
	//           
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалОтражениеПервичныхДокументовВПроектномБюджетировании() Тогда	
		Использование = ПолучитьФункциональнуюОпцию("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
		ИменаНаборов = Новый Массив;
		ИменаНаборов.Добавить("Документ_упоОтражениеФактаВПроектномБюджетировании");
		ИменаНаборов.Добавить("Справочник_упоПравилаПолученияФактаДляПроектногоБюджетирования");
		ДобавитьИспользованиеПреопределенныхНаборовСвойств(Наборы, ИменаНаборов, Использование);
	КонецЕсли;
	
	//
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда 
		Использование = ПолучитьФункциональнуюОпцию("упоИспользоватьПроектнуюПродукцию");
		ИменаНаборов = Новый Массив;
		ИменаНаборов.Добавить("Справочник_упоТипыПроектнойПродукции");
		ИменаНаборов.Добавить("Справочник_упоПроектнаяПродукция");
		ДобавитьИспользованиеПреопределенныхНаборовСвойств(Наборы, ИменаНаборов, Использование);
	КонецЕсли;
	
КонецПроцедуры

