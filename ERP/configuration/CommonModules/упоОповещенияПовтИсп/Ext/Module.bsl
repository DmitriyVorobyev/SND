				ВремМас.Добавить(Новый Структура("ИмяТаблицы,ИмяРеквизита,ИмяРеквизитаПредставление,ЭтоПолеСвязи",Эл.ПолноеИмя(),Рекв.Имя,Рекв.Синоним,ЭтоПолеСвязи));
				
			КонецЦикла;
			
			Для Каждого Рекв Из Эл.Ресурсы Цикл
				
