// Получает настройки транспорта.
//
// Параметры:
//  Транспорт	 - СправочникСсылка.упоТранспортОповещений
// 
// Возвращаемое значение:
//  Структура - настройки транспорта.
//
Функция ПолучитьНастройкиТранспорта(Транспорт) Экспорт
	
	Рез = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	упоТранспортОповещений.ДоступнаТемаСообщения,
	|	упоТранспортОповещений.ДоступенТекстСообщенияВHTML,
	|	упоТранспортОповещений.ДоступнаНастройкаДляВидаСобытия,
	|	упоТранспортОповещений.ИмяМодуляОтправкиСообщений,
	|	упоТранспортОповещений.Параметры
	|ИЗ
	|	Справочник.упоТранспортОповещений КАК упоТранспортОповещений
	|ГДЕ
	|	упоТранспортОповещений.Ссылка = &Транспорт";
	Запрос.УстановитьПараметр("Транспорт",Транспорт);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Рез.Вставить("ДоступнаТемаСообщения",Выборка.ДоступнаТемаСообщения);
		Рез.Вставить("ДоступенТекстСообщенияВHTML",Выборка.ДоступенТекстСообщенияВHTML);
		Рез.Вставить("ДоступнаНастройкаДляВидаСобытия",Выборка.ДоступнаНастройкаДляВидаСобытия);
		Рез.Вставить("ИмяМодуляОтправкиСообщений",Выборка.ИмяМодуляОтправкиСообщений);
		Рез.Вставить("ПараметрыТранспорта", Выборка.Параметры.Получить());
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Получает настройки транспорта для вида события.
//
// Параметры:
//  ВидСобытия	 - СправочникСсылка.упоВидыСобытий	 - вид события.
// 
// Возвращаемое значение:
//  Соответствие - настройки.
//
Функция ПолучитьНастройкиТранспортовДляВидаСобытия(ВидСобытия) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);	
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоВидыСобытийТранспортОповещений.Транспорт КАК Транспорт,
	               |	упоВидыСобытийТранспортОповещений.НастройкаХЗ КАК НастройкаХЗ
	               |ИЗ
	               |	Справочник.упоВидыСобытий.ТранспортОповещений КАК упоВидыСобытийТранспортОповещений
	               |ГДЕ
	               |	упоВидыСобытийТранспортОповещений.Транспорт.ДоступнаНастройкаДляВидаСобытия
	               |	И упоВидыСобытийТранспортОповещений.Ссылка = &ВидСобытия";
	
	Запрос.УстановитьПараметр("ВидСобытия", ВидСобытия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Транспорт, Выборка.НастройкаХЗ.Получить());			
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

