#Область ПрограммныйИнтерфейс

// Получает список доступных таблиц.
//
// Параметры:
//  НужныеТипы			 - Строка
//  НужныеТаблицы		 - Строка
//  ТаблицыИсключения	 - Строка
//  СокрПредставление	 - Булево
//  БезТабЧастей		 - Булево
// 
// Возвращаемое значение:
//  СписокЗначений
//
Функция ПолучитьСписокДоступныхТаблиц(НужныеТипы = "", НужныеТаблицы = "", ТаблицыИсключения = "", 
	СокрПредставление = Ложь, БезТабЧастей = Ложь) Экспорт
	
	Если ПустаяСтрока(НужныеТипы) Тогда
		масНужныеТипы = Неопределено;
	Иначе
		масНужныеТипы = упоОповещенияВызовСервера.РазложитьСтрокуВМассивПодстрок(НужныеТипы,",");
	КонецЕсли;
	
	Если ПустаяСтрока(НужныеТаблицы) Тогда
		масНужныеТаблицы = Неопределено;
	Иначе
		масНужныеТаблицы = упоОповещенияВызовСервера.РазложитьСтрокуВМассивПодстрок(НужныеТаблицы,",");
	КонецЕсли;
	
	Если ПустаяСтрока(ТаблицыИсключения) Тогда
		масТаблицыИсключения = Неопределено;
	Иначе
		масТаблицыИсключения = упоОповещенияВызовСервера.РазложитьСтрокуВМассивПодстрок(ТаблицыИсключения,",");
	КонецЕсли;
		
	Рез = Новый СписокЗначений;
	
	списОбщиеТипы = Новый СписокЗначений;
	списОбщиеТипы.Добавить("Справочники", НСтр("ru = 'Справочник'"));
	списОбщиеТипы.Добавить("Документы", НСтр("ru = 'Документ'"));
	списОбщиеТипы.Добавить("РегистрыСведений", НСтр("ru = 'Регистр сведений'"));
	списОбщиеТипы.Добавить("ПланыВидовХарактеристик", НСтр("ru = 'План видов характеристик'"));
	списОбщиеТипы.Добавить("Задачи", НСтр("ru = 'Задача'"));
	списОбщиеТипы.Добавить("БизнесПроцессы", НСтр("ru = 'Бизнес-процессы'"));
	
	МасУдалить = Новый Массив;
	Если масНужныеТипы <> Неопределено Тогда
		Для Каждого Эл Из списОбщиеТипы Цикл
			Если МасНужныеТипы.Найти(Эл.Значение) = Неопределено Тогда	
				МасУдалить.Добавить(Эл);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Эл Из МасУдалить Цикл
		списОбщиеТипы.Удалить(Эл);
	КонецЦикла;
	
	ПроверямыеВставкиИсключений = 
		упоФункцииОбщегоНазначенияСервер.ПроверяемыеВставкиСинонимовОбъектовМетаданныхДляИсключения();
	
	ШаблонПолный = "%1 %2.%3";
	ШаблонСокр = "%1.%2";
	
	Для Каждого ЭлТип Из списОбщиеТипы Цикл 
		
		ВремСписок = Новый СписокЗначений;
		Для Каждого ЭлМД Из Метаданные[ЭлТип.Значение] Цикл
			
			ПолноеИмя = ЭлМД.ПолноеИмя();
			
			Если Не ПравоДоступа("Чтение",ЭлМД) Тогда
				Продолжить; // Продолжить
			КонецЕсли;
			
			Если масТаблицыИсключения <> Неопределено Тогда
				Если масТаблицыИсключения.Найти(ПолноеИмя) <> Неопределено Тогда
					Продолжить; // Продолжить
				КонецЕсли;
			КонецЕсли;
			
			Если масНужныеТаблицы <> Неопределено Тогда
				Если масНужныеТаблицы.Найти(ПолноеИмя) = Неопределено Тогда
					Продолжить; // Продолжить
				КонецЕсли;
			КонецЕсли;
			
			ИспользованиеОбъекта = упоФункцииОбщегоНазначенияСервер.ИспользованиеОбъектаМетаданныхПоСинониму(ЭлМД.Синоним, 
				ПроверямыеВставкиИсключений);
			Если Не ИспользованиеОбъекта Тогда
				Продолжить; // Продолжить
			КонецЕсли;
			
			Если СокрПредставление Тогда
				ВремСписок.Добавить(ПолноеИмя, ЭлМД.Синоним);
			Иначе
				ВремСписок.Добавить(ПолноеИмя, ЭлТип.Представление + " " + ЭлМД.Синоним);
			КонецЕсли;
			
			Если (ЭлТип.Значение = "Справочники" Или ЭлТип.Значение = "Документы" 
				Или ЭлТип.Значение = "ПланыВидовХарактеристик") И Не БезТабЧастей Тогда
				
				Для Каждого ТабЧасть Из ЭлМД.ТабличныеЧасти Цикл
					
					ПолноеИмяТабЧасти = СтрШаблон(ШаблонСокр, ПолноеИмя, ТабЧасть.Имя);
					
					Если масТаблицыИсключения <> Неопределено Тогда
						Если масТаблицыИсключения.Найти(ПолноеИмяТабЧасти) <> Неопределено Тогда
							Продолжить; // Продолжить
						КонецЕсли;
					КонецЕсли;
					
					Если масНужныеТаблицы <> Неопределено Тогда
						Если масНужныеТаблицы.Найти(ПолноеИмяТабЧасти) = Неопределено Тогда
							Продолжить; // Продолжить
						КонецЕсли;
					КонецЕсли;
					
					Если СокрПредставление Тогда
						ПредставлениеЭлемента = СтрШаблон(ШаблонСокр, ЭлМД.Синоним, ТабЧасть.Синоним);
					Иначе
						ПредставлениеЭлемента = СтрШаблон(ШаблонПолный, ЭлТип.Представление, ЭлМД.Синоним, ТабЧасть.Синоним);
					КонецЕсли;
					ВремСписок.Добавить(ПолноеИмяТабЧасти, ПредставлениеЭлемента);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ВремСписок.СортироватьПоПредставлению();
		
		Для Каждого Эл Из ВремСписок Цикл
			Рез.Добавить(Эл.Значение,Эл.Представление);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

// Функция - Получить виды событий в доп свойства объекта.
//
// Параметры:
//  ПолноеИмя				 - Строка	 - Полное имя таблицы-источника.
//  СтруктВариантыИзменения	 - Структура - варианты изменения.
// 
// Возвращаемое значение:
//  Структура - * упоВидыСобытий - Соответствие.
//  *упоКодОпределенияДопПараметров - Соответствие.
//  *упоУсловияСобытий - Соответствие.
//  *НужныПредЗначения - Булево.
//
Функция ПолучитьВидыСобытийВДопСвойстваОбъекта(ПолноеИмя, СтруктВариантыИзменения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВидыСобытий = Новый Соответствие;
	УсловияСобытий = Новый Соответствие;
	КодДопПараметров = Новый Соответствие;
		
	НужныПредЗначения = Ложь;
	
	масВариантыИзменения = Новый Массив;
	Для Каждого КлючЗначения Из СтруктВариантыИзменения Цикл
		масВариантыИзменения.Добавить(КлючЗначения.Значение);		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытий.ЛогикаПримененияУсловийРегистрацииСобытия,
	               |	упоВидыСобытий.Ссылка КАК ВидСобытия,
	               |	упоВидыСобытий.ИспользоватьДляАнализаПредыдущиеЗначения,
	               |	упоВидыСобытий.КодОпределенияДопПараметра
	               |ПОМЕСТИТЬ ВтВидыСобытий
	               |ИЗ
	               |	Справочник.упоВидыСобытий КАК упоВидыСобытий
	               |ГДЕ
	               |	упоВидыСобытий.Используется
	               |	И НЕ упоВидыСобытий.ПометкаУдаления
	               |	И упоВидыСобытий.ВариантИзмененияОбъекта В(&масВариантыИзменения)
	               |	И упоВидыСобытий.Источник = &Источник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытийУсловияРегистрацииСобытия.РеквизитОбъекта,
	               |	упоВидыСобытийУсловияРегистрацииСобытия.ВидСравнения,
	               |	упоВидыСобытийУсловияРегистрацииСобытия.ЗначениеУсловия,
	               |	упоВидыСобытийУсловияРегистрацииСобытия.ПроверкаПоКоду,
	               |	упоВидыСобытийУсловияРегистрацииСобытия.ВыполняемыйКод,
	               |	упоВидыСобытийУсловияРегистрацииСобытия.Ссылка
	               |ПОМЕСТИТЬ ВтУсловия
	               |ИЗ
	               |	Справочник.упоВидыСобытий.УсловияРегистрацииСобытия КАК упоВидыСобытийУсловияРегистрацииСобытия
	               |ГДЕ
	               |	упоВидыСобытийУсловияРегистрацииСобытия.Ссылка В
	               |			(ВЫБРАТЬ
	               |				Т.ВидСобытия
	               |			ИЗ
	               |				ВтВидыСобытий КАК Т)
	               |	И упоВидыСобытийУсловияРегистрацииСобытия.Используется
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВтВидыСобытий.ЛогикаПримененияУсловийРегистрацииСобытия,
	               |	ВтВидыСобытий.ВидСобытия КАК ВидСобытия,
	               |	ВтУсловия.РеквизитОбъекта,
	               |	ВтУсловия.ВидСравнения,
	               |	ВтУсловия.ЗначениеУсловия,
	               |	ВтУсловия.ПроверкаПоКоду,
	               |	ВтУсловия.ВыполняемыйКод,
	               |	ВтВидыСобытий.ИспользоватьДляАнализаПредыдущиеЗначения,
	               |	ВтВидыСобытий.КодОпределенияДопПараметра
	               |ИЗ
	               |	ВтВидыСобытий КАК ВтВидыСобытий
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВтУсловия КАК ВтУсловия
	               |		ПО ВтВидыСобытий.ВидСобытия = ВтУсловия.Ссылка
	               |ИТОГИ ПО
	               |	ВидСобытия";
				   
	Запрос.УстановитьПараметр("масВариантыИзменения", масВариантыИзменения);
	Запрос.УстановитьПараметр("Источник", ПолноеИмя);
	ВыборкаВиды = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВиды.Следующий() Цикл
				
		КодОпределенияДопПараметра = Неопределено;
		ЛогикаПримененияУсловийРегистрацииСобытия = Неопределено;		
		масУсловий = Новый Массив;
		ВыборкаУсловия = ВыборкаВиды.Выбрать();
		Пока ВыборкаУсловия.Следующий() Цикл
			НужныПредЗначения = НужныПредЗначения ИЛИ ВыборкаУсловия.ИспользоватьДляАнализаПредыдущиеЗначения;
			КодОпределенияДопПараметра = ВыборкаУсловия.КодОпределенияДопПараметра;
			Если ВыборкаУсловия.РеквизитОбъекта = Null Тогда
				Продолжить;
			КонецЕсли;
			масУсловий.Добавить(Новый Структура("РеквизитОбъекта,ВидСравнения,ЗначениеУсловия,ПроверкаПоКоду,ВыполняемыйКод",
								ВыборкаУсловия.РеквизитОбъекта,
								ВыборкаУсловия.ВидСравнения,
								ВыборкаУсловия.ЗначениеУсловия,
								ВыборкаУсловия.ПроверкаПоКоду,
								ВыборкаУсловия.ВыполняемыйКод));			
			ЛогикаПримененияУсловийРегистрацииСобытия = ВыборкаУсловия.ЛогикаПримененияУсловийРегистрацииСобытия;					
		КонецЦикла;
		
		ВидыСобытий.Вставить(ВыборкаВиды.ВидСобытия,Новый Структура("ЛогикаПримененияУсловий,ПолноеИмяОбъекта",
													ЛогикаПримененияУсловийРегистрацииСобытия,
													ПолноеИмя));
													
		Если ЗначениеЗаполнено(КодОпределенияДопПараметра) Тогда
			КодДопПараметров.Вставить(ВыборкаВиды.ВидСобытия, КодОпределенияДопПараметра);													
		КонецЕсли;

		УсловияСобытий.Вставить(ВыборкаВиды.ВидСобытия, масУсловий);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("упоВидыСобытий", ВидыСобытий);
	Результат.Вставить("упоКодОпределенияДопПараметров", КодДопПараметров);
	Результат.Вставить("упоУсловияСобытий", УсловияСобытий);
	Результат.Вставить("НужныПредЗначения", НужныПредЗначения);
	
	Возврат Результат;
	
КонецФункции

// Получает список реквизитов для оповещений.
//
// Параметры:
//  ИмяТаблицыИТабЧасти	 - Строка
// 
// Возвращаемое значение:
//  Массив
//
Функция ПолучитьСписокРеквизитовДляОповещений(ИмяТаблицыИТабЧасти) Экспорт
	
	Рез = Новый Массив;
	Ключи = "Имя,Представление,ИмяТаблицы";
	
	ИменаТаблиц = упоОповещенияВызовСервера.РазобратьИмяТаблицы(ИмяТаблицыИТабЧасти);
	
	ВидТаблицы = ИменаТаблиц.ВидТаблицы;
	ИмяТаблицы = ИменаТаблиц.ИмяТаблицы;
	ИмяТабЧасти = ИменаТаблиц.ИмяТабЧасти;
	ЭтоТабЧасть = ИменаТаблиц.ЭтоТабЧасть;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	
	ВремСписок = Новый СписокЗначений;
	
	Если ВидТаблицы = "РегистрСведений" ИЛИ ВидТаблицы = "РегистрНакопления" ИЛИ ВидТаблицы = "РегистрБухгалтерии" ИЛИ ВидТаблицы = "РегистрРасчета" Тогда
		
		Для Каждого Рекв Из МетаданныеОбъекта.Измерения Цикл
			Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.Ресурсы Цикл
			Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
			Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
		КонецЦикла;
		
	ИначеЕсли ВидТаблицы = "Перечисление" Тогда
		
		
		Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
		КонецЦикла;
		
	Иначе
		
		Если ЭтоТабЧасть Тогда
			
			Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
				
				Если ТабЧасть.Имя = ИмяТабЧасти Тогда
					
					ВремСписок = Новый СписокЗначений;
					Для Каждого Рекв Из ТабЧасть.Реквизиты Цикл
						
						Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
						
						//ВремСписок.Добавить(Рекв.Имя,Рекв.Синоним);
						
					КонецЦикла;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				Если ВидТаблицы = "Задача" И Рекв.Имя = "ТочкаМаршрута" Тогда
					Продолжить;
				КонецЕсли;
				
				ИмяТаблицы = ИмяТаблицы(Рекв.Тип);
				Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы));
			КонецЦикла;
			
			Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
				Рез.Добавить(Новый Структура(Ключи, Рекв.Имя, ?(ПустаяСтрока(Рекв.Синоним), Рекв.Имя, Рекв.Синоним), ИмяТаблицы(Рекв.Тип)));
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// Получает возможные доп. реквизиты и свойства.
//
// Параметры:
//  ИмяТаблицы	 - Строка
// 
// Возвращаемое значение:
//  Массив, СписокЗначений - список свойств и доп.реквизитов.
//
Функция ПолучитьВозможныеДопРеквизитыИСвойства(ИмяТаблицы) Экспорт
	
	Результат = Новый Массив;
	
	ПараметрыТаблицы = упоОповещенияВызовСервера.РазобратьИмяТаблицы(ИмяТаблицы);
	
	ВидТаблицы = ПараметрыТаблицы.ВидТаблицы;
	ИмяТаблицы = ПараметрыТаблицы.ИмяТаблицы;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЭтоМетаданныеСсылочногоОбъекта(МетаданныеОбъекта) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИменаПредопределенных = УправлениеДоступомСлужебныйПовтИсп.ИменаПредопределенныхЭлементовСправочника(
			"НаборыДополнительныхРеквизитовИСведений");
	
	ИмяЭлемента = ВидТаблицы + "_" + МетаданныеОбъекта.Имя;
	ИмяЭлементаУдалить = "Удалить" + ВидТаблицы + "_" + МетаданныеОбъекта.Имя;
	Если ИменаПредопределенных.Найти(ИмяЭлемента) = Неопределено Тогда
		Если ИменаПредопределенных.Найти(ИмяЭлементаУдалить) = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Ссылка = УправлениеДоступомСлужебный.ПустаяСсылкаОбъектаМетаданных(МетаданныеОбъекта);
	
	Возврат УправлениеСвойствами.ПолучитьСписокСвойств(Ссылка, Истина, Истина);
	
КонецФункции

// Получает список вычисляемых реквизитов.
//
// Параметры:
//  ИмяТаблицы	 - Строка
// 
// Возвращаемое значение:
//  Массив
//
Функция ПолучитьСписокВычисляемыхРеквизитов(ИмяТаблицы) Экспорт
	
	Рез = Новый Массив;
	Ключи = "Имя,Представление,ИмяТаблицы";
	
	тзВсеРеквизиты = ПолучитьВсеВычисляемыеРеквизиты();
	РезПоиска = тзВсеРеквизиты.НайтиСтроки(Новый Структура("ИмяТаблицы",ИмяТаблицы));
	Для Каждого Эл Из РезПоиска Цикл
		Рез.Добавить(Новый Структура(Ключи,Эл.ИмяРеквизита,Эл.Представление,Ложь));	
	КонецЦикла;                       
	
	Возврат Рез;	
	
КонецФункции

// Получает тип вычисляемого реквизита.
//
// Параметры:
//  ИмяТаблицы	 - Строка
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  Тип
//
Функция ПолучитьТипВычисляемогоРеквизита(ИмяТаблицы,ИмяРеквизита) Экспорт
	
	Рез = "";
	
	тзВсеРеквизиты = упоОповещенияВызовСервера.ПолучитьВсеВычисляемыеРеквизиты();
	РезПоиска = тзВсеРеквизиты.НайтиСтроки(Новый Структура("ИмяТаблицы,ИмяРеквизита",ИмяТаблицы,ИмяРеквизита));
	Для Каждого Эл Из РезПоиска Цикл
		Рез = Эл.ТипРеквизита;	
	КонецЦикла;                       
	
	Возврат Рез;
	
КонецФункции

// Получает выполняемый код вычисляемого реквизита.
//
// Параметры:
//  ИмяТаблицы	 - Строка
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьВыполняемыйКодВычисляемогоРеквизита(ИмяТаблицы,ИмяРеквизита) Экспорт
	
	Рез = "";
	
	тзВсеРеквизиты = упоОповещенияВызовСервера.ПолучитьВсеВычисляемыеРеквизиты();
	РезПоиска = тзВсеРеквизиты.НайтиСтроки(Новый Структура("ИмяТаблицы,ИмяРеквизита",ИмяТаблицы,ИмяРеквизита));
	Для Каждого Эл Из РезПоиска Цикл
		Рез = Эл.ВыполняемыйКод;	
	КонецЦикла;                       
	
	Возврат Рез;
	
КонецФункции

// Получает все вычисляемые реквизиты.
// 
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ПолучитьВсеВычисляемыеРеквизиты() Экспорт
	
	тз = Новый ТаблицаЗначений;
	тз.Колонки.Добавить("ИмяТаблицы");
	тз.Колонки.Добавить("ИмяРеквизита");
	тз.Колонки.Добавить("ТипРеквизита");
	тз.Колонки.Добавить("ВыполняемыйКод");
	тз.Колонки.Добавить("Представление");
		
	Макет = Справочники.упоВидыСобытий.ПолучитьМакет("ВычисляемыеРеквизиты");
	
	НомСтр = 1;
	
	Пока 0 = 0 Цикл
		
		НомСтр = НомСтр + 1;
		
		ИмяТаблицы = СокрЛП(Макет.Область(НомСтр,1,НомСтр,1).Текст);
		
		Если ПустаяСтрока(ИмяТаблицы) Тогда
			Прервать;
		КонецЕсли;
		
		ИмяРеквизита = СокрЛП(Макет.Область(НомСтр,2,НомСтр,2).Текст);
		ТипРеквизита = СокрЛП(Макет.Область(НомСтр,3,НомСтр,3).Текст);
		ВыполняемыйКод = СокрЛП(Макет.Область(НомСтр,4,НомСтр,4).Текст);
		Представление = СокрЛП(Макет.Область(НомСтр,5,НомСтр,5).Текст);
		
		Если ПустаяСтрока(ИмяРеквизита) ИЛИ ПустаяСтрока(ВыполняемыйКод) Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = тз.Добавить();
		НовСтр.ИмяТаблицы = ИмяТаблицы;
		НовСтр.ИмяРеквизита = ИмяРеквизита;
		НовСтр.ТипРеквизита = ТипРеквизита;
		НовСтр.ВыполняемыйКод = ВыполняемыйКод;
		НовСтр.Представление = Представление;
		
	КонецЦикла;
	
	упоОповещенияПереопределяемый.СкорректироватьВычисляемыеРеквизиты(тз);

	Возврат тз;
	
КонецФункции

// Получает список возможных реквизитов для хранения адресов.
//
// Параметры:
//  ИмяТаблицыИТабЧасти	 - Строка
// 
// Возвращаемое значение:
//  СписокЗначений
//
Функция ПолучитьСписокВозможныхРеквизитовДляХраненияАдресов(ИмяТаблицыИТабЧасти) Экспорт
	
	Рез = Новый СписокЗначений;
	
	ИменаТаблиц = упоОповещенияВызовСервера.РазобратьИмяТаблицы(ИмяТаблицыИТабЧасти);
	
	ВидТаблицы = ИменаТаблиц.ВидТаблицы;
	ИмяТаблицы = ИменаТаблиц.ИмяТаблицы;
	ИмяТабЧасти = ИменаТаблиц.ИмяТабЧасти;
	ЭтоТабЧасть = ИменаТаблиц.ЭтоТабЧасть;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	
	БезОграниченияТипа = Истина;
	ТипЧ = Тип("Число");
	ТипСтр = Тип("Строка");
	
	ВремСписок = Новый СписокЗначений;
	
	Если ВидТаблицы = "РегистрСведений" ИЛИ ВидТаблицы = "РегистрНакопления" ИЛИ ВидТаблицы = "РегистрБухгалтерии" ИЛИ ВидТаблицы = "РегистрРасчета" Тогда
		
		Для Каждого Рекв Из МетаданныеОбъекта.Измерения Цикл
			Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
				Рез.Добавить(Рекв.Имя,?(ПустаяСтрока(Рекв.Синоним),Рекв.Имя,Рекв.Синоним));	
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.Ресурсы Цикл
			Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
				Рез.Добавить(Рекв.Имя,?(ПустаяСтрока(Рекв.Синоним),Рекв.Имя,Рекв.Синоним));	
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
			Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
				Рез.Добавить(Рекв.Имя,?(ПустаяСтрока(Рекв.Синоним),Рекв.Имя,Рекв.Синоним));	
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
				Рез.Добавить(Рекв.Имя,?(ПустаяСтрока(Рекв.Синоним),Рекв.Имя,Рекв.Синоним));	
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ВидТаблицы = "Перечисление" Тогда
		
		Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
				Рез.Добавить(Рекв.Имя,?(ПустаяСтрока(Рекв.Синоним),Рекв.Имя,Рекв.Синоним));	
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		Если ЭтоТабЧасть Тогда
			
			Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
				
				Если ТабЧасть.Имя = ИмяТабЧасти Тогда
					
					ВремСписок = Новый СписокЗначений;
					Для Каждого Рекв Из ТабЧасть.Реквизиты Цикл
						
						Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
							ВремСписок.Добавить(Рекв.Имя,Рекв.Синоним);	                          	
						КонецЕсли;
						
					КонецЦикла;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
					Рез.Добавить(Рекв.Имя,?(ПустаяСтрока(Рекв.Синоним),Рекв.Имя,Рекв.Синоним));	
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
				Если БезОграниченияТипа ИЛИ Рекв.Тип.СодержитТип(ТипЧ) ИЛИ Рекв.Тип.СодержитТип(ТипСтр) Тогда
					ВремСписок.Добавить(Рекв.Имя,Рекв.Синоним);	                          	
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВремСписок.СортироватьПоПредставлению();
	Для Каждого Эл Из ВремСписок Цикл
		Рез.Добавить(Эл.Значение,Эл.Представление);			
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

// Получает представление таблицы.
//
// Параметры:
//  ИмяТаблицыИТабЧасти	 - Строка
// 
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьПредставлениеТаблицы(ИмяТаблицыИТабЧасти) Экспорт
	
	ИменаТаблиц = упоОповещенияВызовСервера.РазобратьИмяТаблицы(ИмяТаблицыИТабЧасти);
	
	ВидТаблицы = ИменаТаблиц.ВидТаблицы;
	ИмяТаблицы = ИменаТаблиц.ИмяТаблицы;
	ИмяТабЧасти = ИменаТаблиц.ИмяТабЧасти;
	ЭтоТабЧасть = ИменаТаблиц.ЭтоТабЧасть;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаблицы);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат ИмяТаблицыИТабЧасти;
	КонецЕсли;
	
	ПредставлениеТаблицы = МетаданныеОбъекта.Синоним;
	ПредставлениеТабЧасти = "";
	
	Если ЭтоТабЧасть Тогда
		
		Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
			
			Если ТабЧасть.Имя = ИмяТабЧасти Тогда
				ПредставлениеТабЧасти = ТабЧасть.Синоним;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПолноеПредставление = ВидТаблицы + "." + ПредставлениеТаблицы + ?(ЭтоТабЧасть,"."+ПредставлениеТабЧасти,"");
		
	Возврат ПолноеПредставление;
	
КонецФункции

// Получает список доступных констант для шаблона сообщения.
// 
// Возвращаемое значение:
//  СписокЗначений
//
Функция ПолучитьСписокДоступныхКонстантДляШаблонаСообщения() Экспорт
	
	Рез = Новый СписокЗначений;
	
	Для Каждого ЭлМД Из Метаданные.Константы Цикл
		Если Не ПравоДоступа("Чтение",ЭлМД) Тогда
			Продолжить;
		КонецЕсли;
		Рез.Добавить(ЭлМД.Имя,ЭлМД.Синоним);
	КонецЦикла;
	
	Рез.СортироватьПоПредставлению();
	
	Возврат Рез;
	
КонецФункции

// Получает список доступных видов сравнений для реквизита.
//
// Параметры:
//  ПолноеИмяРеквизита	 - Строка
//  Источник			 - Строка
// 
// Возвращаемое значение:
//  СписокЗначений
//
Функция ПолучитьСписокДоступныхВидовСравненийДляРеквизита(Знач ПолноеИмяРеквизита, Источник = "") Экспорт
	
	МассивВидовСравнений = Новый Массив;
		
	ОписаниеТиповРеквизитов = ПолучитьОписаниеТипаРеквизитаИсточника(ПолноеИмяРеквизита, Источник);
	Если ОписаниеТиповРеквизитов = Неопределено ИЛИ ОписаниеТиповРеквизитов.Типы().Количество() = 0 Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Неопределено);
	Иначе
		МассивТипов = ОписаниеТиповРеквизитов.Типы();
	КонецЕсли;
	
	Для Каждого ТипРеквизита Из МассивТипов Цикл
		
		Если ТипРеквизита = Неопределено ИЛИ ТипРеквизита = Тип("Булево") Тогда 
			
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Равно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеРавно);
			
		ИначеЕсли ТипРеквизита = Тип("Число") Тогда
			
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Равно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Больше);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.БольшеИлиРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Меньше);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.МеньшеИлиРавно);
			
		ИначеЕсли ТипРеквизита = Тип("Дата") Тогда
			
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Равно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Больше);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.БольшеИлиРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Меньше);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.МеньшеИлиРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Интервал);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.ИнтервалВключаяГраницы);
			
		ИначеЕсли ТипРеквизита = Тип("Строка") Тогда
			
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Равно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Содержит);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеСодержит);
			
		Иначе
			
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.Равно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеРавно);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.ВСписке);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеВСписке);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.ВИерархии);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.НеВИерархии);
			МассивВидовСравнений.Добавить(Перечисления.упоВидыСравнения.ВСпискеПоИерархии);
