//
// Параметры:
//  ТаблицаПолучателя	 - Строка - Имя
//  ПодписчикСсылка		 - ЛюбаяСсылка
// 
// Возвращаемое значение:
//  ТаблицаЗначений - виды событий.
//
Функция ПолучитьВидыСобытийДляПодписки(ТаблицаПолучателя, ПодписчикСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустоеОграничениеДоступа", Справочники.упоОграниченияДоступаКОповещениям.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПодписчикСсылка", ПодписчикСсылка);
	Запрос.УстановитьПараметр("ТаблицаПолучателя", ТаблицаПолучателя);
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	упоВидыСобытийПолучатели.Ссылка КАК ВидСобытия,
	               |	упоВидыСобытийПолучатели.ВидПолучателя,
	               |	упоВидыСобытийПолучатели.Получатель,
	               |	упоВидыСобытийПолучатели.ОграничениеДоступа,
	               |	упоВидыСобытийПолучатели.Ссылка.Принудительное КАК Принудительное,
	               |	ВЫБОР
	               |		КОГДА ЕСТЬNULL(упоОграниченияДоступаКОповещениямСостав.Элемент, НЕОПРЕДЕЛЕНО) = &ПодписчикСсылка
	               |				ИЛИ ЕСТЬNULL(упоОграниченияДоступаКОповещениямСостав.Элемент, НЕОПРЕДЕЛЕНО) В
	               |					(ВЫБРАТЬ
	               |						ГруппыДоступа.ГруппаДоступа
	               |					ИЗ
	               |						врГруппыДоступа КАК ГруппыДоступа)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПодписчикВСоставеОграничения,
	               |	ЕСТЬNULL(упоВидыСобытийПолучатели.ОграничениеДоступа.Условие, НЕОПРЕДЕЛЕНО) КАК Условие
	               |ПОМЕСТИТЬ Полная
	               |ИЗ
	               |	Справочник.упоВидыСобытий.Получатели КАК упоВидыСобытийПолучатели
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.упоОграниченияДоступаКОповещениям.Состав КАК упоОграниченияДоступаКОповещениямСостав
	               |		ПО упоВидыСобытийПолучатели.ОграничениеДоступа = упоОграниченияДоступаКОповещениямСостав.Ссылка
	               |ГДЕ
	               |	НЕ упоВидыСобытийПолучатели.Ссылка.ПометкаУдаления
	               |	И упоВидыСобытийПолучатели.Ссылка.Используется
	               |	И упоВидыСобытийПолучатели.ВидПолучателя.ТаблицаПолучателя = &ТаблицаПолучателя
	               |	И (упоВидыСобытийПолучатели.Получатель = НЕОПРЕДЕЛЕНО
	               |			ИЛИ упоВидыСобытийПолучатели.Получатель = &ПодписчикСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Полная.ВидСобытия,
	               |	Полная.ВидПолучателя,
	               |	Полная.Получатель,
	               |	Полная.ОграничениеДоступа,
	               |	Полная.Принудительное,
	               |	Полная.Условие,
	               |	МАКСИМУМ(Полная.ПодписчикВСоставеОграничения) КАК ПодписчикВСоставеОграничения
	               |ПОМЕСТИТЬ Сгруп
	               |ИЗ
	               |	Полная КАК Полная
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Полная.ВидПолучателя,
	               |	Полная.Получатель,
	               |	Полная.ОграничениеДоступа,
	               |	Полная.Принудительное,
	               |	Полная.ВидСобытия,
	               |	Полная.Условие
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Сгруп.ВидСобытия,
	               |	Сгруп.ВидПолучателя,
	               |	Сгруп.Получатель,
	               |	Сгруп.ОграничениеДоступа,
	               |	Сгруп.Принудительное,
	               |	Сгруп.ПодписчикВСоставеОграничения,
	               |	Сгруп.Условие
	               |ИЗ
	               |	Сгруп КАК Сгруп
	               |ГДЕ
	               |	(Сгруп.ОграничениеДоступа = &ПустоеОграничениеДоступа
	               |			ИЛИ Сгруп.ПодписчикВСоставеОграничения
	               |				И Сгруп.Условие = ЗНАЧЕНИЕ(Перечисление.упоУсловияОграниченияДоступаКОповещениям.ТолькоУказанные)
	               |			ИЛИ НЕ Сгруп.ПодписчикВСоставеОграничения
	               |				И Сгруп.Условие = ЗНАЧЕНИЕ(Перечисление.упоУсловияОграниченияДоступаКОповещениям.ВсеКромеУказанных))";
				   
	Если ТипЗнч(ПодписчикСсылка) = Тип("СправочникСсылка.Пользователи") ИЛИ 
		ТипЗнч(ПодписчикСсылка) = Тип("СправочникСсылка.ВнешниеПользователи") Тогда 
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	СоставыГруппПользователей.ГруппаПользователей
		|ПОМЕСТИТЬ врГруппыПользователя
		|ИЗ
		|	РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
		|ГДЕ
		|	СоставыГруппПользователей.Используется
		|	И СоставыГруппПользователей.Пользователь = &ПодписчикСсылка 
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаПользователи.Ссылка КАК ГруппаДоступа
		|ПОМЕСТИТЬ врГруппыДоступа
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	НЕ ГруппыДоступаПользователи.Ссылка.ПометкаУдаления
		|	И (ГруппыДоступаПользователи.Пользователь = &ПодписчикСсылка
		|			ИЛИ ГруппыДоступаПользователи.Пользователь В
		|				(ВЫБРАТЬ
		|					ГруппыПользователя.ГруппаПользователей
		|				ИЗ
		|					врГруппыПользователя КАК ГруппыПользователя)) 
		|; 
		|" + ТекстЗапроса;	
		
	Иначе	
		
		ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	-2 КАК ГруппаДоступа
		|ПОМЕСТИТЬ врГруппыДоступа		
		|; 
		|" + ТекстЗапроса;
		
	КонецЕсли;
   
	Запрос.Текст = ТекстЗапроса;
				  	
	тз = Запрос.Выполнить().Выгрузить();
		
	Возврат тз;
	
КонецФункции

// Функция - Получить все элементы таблицы получателя
//
// Параметры:
//  ТаблицаПолучателя	 - Строка
// 
// Возвращаемое значение:
//  Массив - Массив получателей
//
Функция ПолучитьВсеЭлементыТаблицыПолучателя(ТаблицаПолучателя) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаПолучателя.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Пользователи КАК ТаблицаПолучателя
			|		
			|ГДЕ
			|	НЕ ТаблицаПолучателя.ПометкаУдаления";	
			
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Пользователи", ТаблицаПолучателя);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоМетаданныеСсылочногоОбъекта(пМетаданные)
	
	Результат = Ложь;
	
	Для Каждого ОписаниеРеквизита Из пМетаданные.СтандартныеРеквизиты Цикл
		Если ОписаниеРеквизита.Имя = "Ссылка" Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
