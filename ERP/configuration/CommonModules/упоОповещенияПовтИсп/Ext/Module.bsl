Функция ПолучитьСвязанныеТаблицы(ИмяТаблицы) Экспорт
	
	Рез = Новый Массив;
	
	Поз = Найти(ИмяТаблицы,".");
	Если Поз > 0 Тогда
		Вид = Лев(ИмяТаблицы,Поз-1);
	    Имя = Сред(ИмяТаблицы,Поз+1);
	Иначе
		Возврат Рез;
	КонецЕсли;
	
	Если Вид = "РегистрСведений" ИЛИ Вид = "РегистрНакопления" ИЛИ Вид = "РегистрБухгалтерии" ИЛИ Вид = "РегистрРасчета" Тогда
		Возврат Рез;
	КонецЕсли;
	
	ТипТаблицы = Тип(Вид + "Ссылка."+Имя); 
