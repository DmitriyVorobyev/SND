// Получает описание типа реквизита.
//
// Параметры:
//  ПолноеИмя	 - Строка
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  Тип, Неопределено
//
Функция ПолучитьОписаниеТипаРеквизита(ПолноеИмя, ИмяРеквизита = "") Экспорт
	
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		ИменаТаблиц = упоОповещенияВызовСервера.РазобратьИмяРеквизита(ПолноеИмя);
		ИмяРеквизита = ИменаТаблиц.ИмяРеквизита;
	Иначе
		ИменаТаблиц = упоОповещенияВызовСервера.РазобратьИмяТаблицы(ПолноеИмя,Истина);
	КонецЕсли;
	
	ВидТаблицы = ИменаТаблиц.ВидТаблицы;
	ИмяТаблицы = ИменаТаблиц.ИмяТаблицы;
	ИмяТабЧасти = ИменаТаблиц.ИмяТабЧасти;
	ЭтоТабЧасть = ИменаТаблиц.ЭтоТабЧасть;
	
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ВидТаблицы+"."+ИмяТаблицы);
	
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВидТаблицы = "РегистрСведений" ИЛИ ВидТаблицы = "РегистрНакопления" ИЛИ ВидТаблицы = "РегистрБухгалтерии" ИЛИ ВидТаблицы = "РегистрРасчета"  Тогда
		
		Для Каждого Рекв Из МетаданныеОбъекта.Измерения Цикл
			Если Рекв.Имя = ИмяРеквизита Тогда
				Возврат Рекв.Тип;	
			КонецЕсли;
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.Ресурсы Цикл
			Если Рекв.Имя = ИмяРеквизита Тогда
				Возврат Рекв.Тип;	
			КонецЕсли;	
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
			Если Рекв.Имя = ИмяРеквизита Тогда
				Возврат Рекв.Тип;	
			КонецЕсли;	
		КонецЦикла;
		Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			Если Рекв.Имя = ИмяРеквизита Тогда
				Возврат Рекв.Тип;	
			КонецЕсли;	
		КонецЦикла;		
		
	Иначе
		
		Если ЭтоТабЧасть Тогда
			
			Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
				
				Если ТабЧасть.Имя = ИмяТабЧасти Тогда
					
					Для Каждого Рекв Из ТабЧасть.Реквизиты Цикл
						
						Если Рекв.Имя = ИмяРеквизита Тогда
							Возврат Рекв.Тип;
						КонецЕсли;
						
					КонецЦикла;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				Если Рекв.Имя = ИмяРеквизита Тогда
					Возврат Рекв.Тип;	
				КонецЕсли;	
			КонецЦикла;
			
			Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
				Если Рекв.Имя = ИмяРеквизита Тогда
					Возврат Рекв.Тип;	
				КонецЕсли;	                          	
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Получает описание типа реквизита источника.
//
// Параметры:
//  ПолноеИмяРеквизита	 - Строка
//  Источник			 - Строка
// 
// Возвращаемое значение:
//  Тип, Неопределено
//
Функция ПолучитьОписаниеТипаРеквизитаИсточника(Знач ПолноеИмяРеквизита,Источник = "") Экспорт
	
	МасРекв = Новый Массив;
	
	Остаток = ПолноеИмяРеквизита;
	Поз = Найти(ПолноеИмяРеквизита,".");
	Пока Поз > 0 Цикл
		
		Подстрока = Лев(Остаток,Поз-1);
		Остаток = Сред(Остаток,Поз+1);
		МасРекв.Добавить(Подстрока);
		Поз = Найти(Остаток,".");
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(Остаток) Тогда
		МасРекв.Добавить(Остаток);
	КонецЕсли;
	
	Если МасРекв.Количество() < 2 Тогда
		// в первых двух элементах должны быть вид таблицы и имя таблицы
		Возврат Неопределено;
	КонецЕсли;
	
	ВидТаб = МасРекв[0];
	СокрИмяТаб = МасРекв[1];
	ИмяТаб = ВидТаб+"." + СокрИмяТаб;
	МасРекв.Удалить(0);
	МасРекв.Удалить(0);
	
	масРеквИТаб = Новый Массив;
	Если Найти(ИмяТаб,"РегистрСведений") > 0 ИЛИ Найти(ИмяТаб,"РегистрНакопления") > 0 ИЛИ Найти(ИмяТаб,"РегистрБухгалтерии") > 0 ИЛИ Найти(ИмяТаб,"РегистрРасчета") > 0 Тогда	
		ИмяРеквизита = "";
		ТипРеквизита = Неопределено;
	ИначеЕсли ВидТаб = "ДополнительныйРеквизит" ИЛИ ВидТаб = "ДополнительноеСведение" Тогда	
		Ссылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПолучитьСсылку(Новый УникальныйИдентификатор(СокрИмяТаб));
		ИмяРеквизита = "";
		//ТипРеквизита = Ссылка.ТипЗначения.Типы()[0];
		ТипРеквизита = Ссылка.ТипЗначения;
	ИначеЕсли ВидТаб="Вычисляемый" Тогда
		ИмяРеквизита = "";
		ТипРеквизитаСтрока = ПолучитьТипВычисляемогоРеквизита(Источник,СокрИмяТаб);
		Попытка
			//ТипРеквизита = Тип(ТипРеквизитаСтрока);
			ТипРеквизита = Новый ОписаниеТипов(ТипРеквизитаСтрока);
		Исключение
			ТипРеквизита = Неопределено;	
		КонецПопытки;
	Иначе
		ИмяРеквизита = "Ссылка";
		ТипТаблицы = ОпределитьТипТаблицы(ИмяТаб);
		Попытка 
			ТипРеквизита = Новый ОписаниеТипов(ИмяТаб);
		Исключение 
			ТипРеквизита = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	масРеквИТаб.Добавить(Новый Структура("ИмяРеквизита,ИмяТаблицы,ТипРеквизита",ИмяРеквизита,ИмяТаб,ТипРеквизита));
	
	ПредИмяТаб = "";
	ЭтоТабЧасть = Ложь;
	Для Каждого ИмяРеквизита Из МасРекв Цикл
		
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяТаб);
		ТекОписаниеТипа = Неопределено;
		
		Нашли = Ложь;
		Если Найти(ИмяТаб,"РегистрСведений") > 0 ИЛИ Найти(ИмяТаб,"РегистрНакопления") > 0 ИЛИ Найти(ИмяТаб,"РегистрБухгалтерии") > 0 ИЛИ Найти(ИмяТаб,"РегистрРасчета") > 0 Тогда
			
			Для Каждого Рекв Из МетаданныеОбъекта.Измерения Цикл
				Если Рекв.Имя = ИмяРеквизита Тогда
					ТекОписаниеТипа = Рекв.Тип;	
					Нашли = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ Нашли Тогда
				Для Каждого Рекв Из МетаданныеОбъекта.Ресурсы Цикл
					Если Рекв.Имя = ИмяРеквизита Тогда
						ТекОписаниеТипа = Рекв.Тип;
						Нашли = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;
			
			Если НЕ Нашли Тогда
				Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
					Если Рекв.Имя = ИмяРеквизита Тогда
						ТекОписаниеТипа = Рекв.Тип;
						Нашли = Истина;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;
			
			Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				Если Рекв.Имя = ИмяРеквизита Тогда
					ТекОписаниеТипа = Рекв.Тип;
					Нашли = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
		ИначеЕсли Найти(ИмяТаб,"Перечисление") > 0 Тогда
			
			Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				Если Рекв.Имя = ИмяРеквизита Тогда
					ТекОписаниеТипа = Рекв.Тип;
					Нашли = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
		Иначе
			
			Для Каждого Рекв Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				Если Рекв.Имя = ИмяРеквизита Тогда
					ТекОписаниеТипа = Рекв.Тип;
					Нашли = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
			Если НЕ Нашли Тогда
				Для Каждого Рекв Из МетаданныеОбъекта.Реквизиты Цикл
					Если Рекв.Имя = ИмяРеквизита Тогда
						ТекОписаниеТипа = Рекв.Тип;
						Нашли = Истина;
						Прервать;
					КонецЕсли;	                          	
				КонецЦикла;
			КонецЕсли;
			
			Если НЕ Нашли Тогда
				
				Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
					
					Если ТабЧасть.Имя = ИмяРеквизита Тогда
						
						ЭтоТабЧасть = Истина;
						Нашли = Истина;
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоТабЧасть Тогда
			ИмяТаб = ПредИмяТаб + "." + ИмяРеквизита;	
		Иначе
			ИмяТаб = ИмяТаблицы(ТекОписаниеТипа);
			ПредИмяТаб = ИмяТаб;
		КонецЕсли;
		
		Если ТекОписаниеТипа.Типы().Количество() > 0 Тогда
			//ТипРеквизита = ТекОписаниеТипа.Типы()[0];
			ТипРеквизита = ТекОписаниеТипа;
		Иначе
			ТипРеквизита = Неопределено;	
		КонецЕсли;
		
		масРеквИТаб.Добавить(Новый Структура("ИмяРеквизита,ИмяТаблицы,ТипРеквизита",ИмяРеквизита,ИмяТаб,ТипРеквизита));
		
	КонецЦикла;
	
	Если масРеквИТаб.Количество() > 0 Тогда
		Рез = масРеквИТаб[масРеквИТаб.Количество()-1].ТипРеквизита;
	Иначе
		Рез = Неопределено;
	КонецЕсли;
		
	Возврат Рез;
	
КонецФункции

// Получает текст вида сравнения.
//
// Параметры:
//  ВидСравнения - Перечисления.упоВидыСравнения
// 
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьТекстВидаСравнения(ВидСравнения) Экспорт
	
	Рез = Новый Структура;
	
	ВидСравненияНач = "=";
	ВидСравненияКон = "";
	ВидСравненияНач2 = "";
	ВидСравненияКон2 = "";
	ЭтоОтрицание = Ложь;
	ДваЗначения = Ложь;
	
	Если ВидСравнения = Перечисления.упоВидыСравнения.Равно Тогда
		ВидСравненияНач = "=";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.НеРавно Тогда
		ЭтоОтрицание = Истина;
		ВидСравненияНач = "=";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.Больше Тогда
		ВидСравненияНач = ">";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.БольшеИлиРавно Тогда
		ВидСравненияНач = ">=";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.Меньше Тогда
		ВидСравненияНач = "<";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.МеньшеИлиРавно Тогда
		ВидСравненияНач = "<=";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.Интервал Тогда
		ВидСравненияНач = ">";
		ВидСравненияНач2 = "<";
		ДваЗначения = Истина;
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.ИнтервалВключаяГраницы Тогда
		ВидСравненияНач = " Между ";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.Содержит Тогда
		ВидСравненияНач = " Подобно ";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.НеСодержит Тогда
		ЭтоОтрицание = Истина;
		ВидСравненияНач = " Подобно "
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.ВСписке Тогда
		ВидСравненияНач = " В (";
		ВидСравненияКон = ")";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.НеВСписке Тогда
		ЭтоОтрицание = Истина;
		ВидСравненияНач = " В (";
		ВидСравненияКон = ")";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.ВИерархии Тогда
		ВидСравненияНач = " В Иерархии (";
		ВидСравненияКон = ")";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.НеВИерархии Тогда
		ЭтоОтрицание = Истина;
		ВидСравненияНач = " В Иерархии (";
		ВидСравненияКон = ")";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.ВСпискеПоИерархии Тогда
		ВидСравненияНач = " В Иерархии (";
		ВидСравненияКон = ")";
	ИначеЕсли ВидСравнения = Перечисления.упоВидыСравнения.НеВСпискеПоИерархии Тогда
		ЭтоОтрицание = Истина;
		ВидСравненияНач = " В Иерархии (";
		ВидСравненияКон = ")";
	КонецЕсли;
	
	Рез.Вставить("ВидСравненияНач",ВидСравненияНач);
	Рез.Вставить("ВидСравненияКон",ВидСравненияКон);
	Рез.Вставить("ВидСравненияНач2",ВидСравненияНач2);
	Рез.Вставить("ВидСравненияКон2",ВидСравненияКон2);
	Рез.Вставить("ЭтоОтрицание",ЭтоОтрицание);
	Рез.Вставить("ДваЗначения",ДваЗначения);
	
	Возврат Рез;
	
КонецФункции

