// Возвращает имя таблицы.
//
// Параметры:
//  ОписаниеТипа - ОписаниеТипа
// 
// Возвращаемое значение:
//  Строка - имя таблицы.
//
Функция ИмяТаблицы(Знач ОписаниеТипа) Экспорт
	
	Если ОписаниеТипа = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Рез = "";;
	
	Если ОписаниеТипа.СодержитТип(Тип("Булево")) Тогда
		Рез = "";
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Число")) Тогда
		Рез = "";
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Дата")) Тогда
		Рез = "";
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("Строка")) Тогда
		Рез = "";
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("УникальныйИдентификатор")) Тогда
		Рез = "";
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("ХранилищеЗначения")) Тогда
		Рез = "";
	ИначеЕсли ОписаниеТипа.СодержитТип(Тип("ОписаниеТипов")) Тогда
		Рез = "";	

	Иначе
		Тип = ОписаниеТипа.Типы()[0];
		Ссылка = Новый(Тип); 
		МД = Ссылка.Метаданные();
		Рез = МД.ПолноеИмя();
	КонецЕсли;	
		
	Возврат Рез;
	
КонецФункции

// Возвращает список таблиц, в которых может хранится контактная информация.
//
// Параметры:
