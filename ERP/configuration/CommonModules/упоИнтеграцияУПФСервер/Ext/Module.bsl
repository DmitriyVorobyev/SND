#Область ОбработкаЗаполнения

// Заполняет реквизит "Проект" переданного объекта по данным документа-основания с учетом размещения
// реквизита либо в шапке, либо в таб. части как в Объекте, так и в ДанныхЗаполнения
//
// Параметры:
//	Объект - ДокументОбъект
//	ДанныеЗаполнения - ДокументСсылка
//
Процедура ЗаполнитьПроект(Объект, ДанныеЗаполнения) Экспорт
	
	// Для определенных типов заполняем реквизит
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.упоПроектнаяЗадача")
		И ТипЗнч(Объект) = упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.Событие") Тогда
		Объект.Проект = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(ДанныеЗаполнения);
		Объект.ДокументОснование = ДанныеЗаполнения;
		Возврат;
	КонецЕсли;

	// У некоторых документов имя реквизита, хранящего проект, отличается от стандартного имени "Проект".
	ИмяРеквизитаПроектИсточника = "Проект";
	ИмяРеквизитаПроектПриемника = "Проект";
	
	ТипОбъекта = ТипЗнч(Объект);
	Если упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.ЗаказПоставщику") = ТипОбъекта Тогда 
		ИмяРеквизитаПроектПриемника = "упоПроектнаяЗадача";
	КонецЕсли;
	
	ТипИсточника = ТипЗнч(ДанныеЗаполнения);
	Если упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.ЗаказПоставщику") = ТипИсточника Тогда
		ИмяРеквизитаПроектИсточника = "упоПроектнаяЗадача";
	КонецЕсли;	
	
	// Реквизит, хранящий проект, должен существовать и в приемнике и в источнике.
	УОбъектаЕстьПроект = 
		ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, ИмяРеквизитаПроектПриемника);
	УИсточникаЕстьПроект = ЗначениеЗаполнено(ДанныеЗаполнения)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеЗаполнения, ИмяРеквизитаПроектИсточника);
	ТипПроектаОбъектаИИсточникаСовпадает = УОбъектаЕстьПроект И УИсточникаЕстьПроект
		И ЗначениеЗаполнено(ДанныеЗаполнения) И (ТипЗнч(Объект[ИмяРеквизитаПроектПриемника]) = ТипЗнч(ДанныеЗаполнения[ИмяРеквизитаПроектИсточника]));
	Если УОбъектаЕстьПроект = Ложь
		Или УИсточникаЕстьПроект = Ложь
		Или ТипПроектаОбъектаИИсточникаСовпадает = Ложь Тогда
		Возврат;
	КонецЕсли;
	// Для правильного заполнения некоторых объектов нужно, чтобы в источнике
	// для всех строк табличной части был указан одинаковый проект (когда проект расположен в таб. части источника).
	КонтрольУникальностиПроектаВТабЧасти = Ложь;
	
	ЭтимОбъектамНуженКонтрольУникальности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.СчетНаОплату"));
	ЭтимОбъектамНуженКонтрольУникальности.Добавить(
		упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.ПоступлениеДСПлан"));
	ЭтимОбъектамНуженКонтрольУникальности.Добавить(
		упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.Событие")); 
	
	ЭтимИсточникамНуженКонтрольУникальности = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.АктВыполненныхРабот"));
	ЭтимИсточникамНуженКонтрольУникальности.Добавить(
		упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.РасходнаяНакладная"));
	
	Если ЗначениеЗаполнено(ЭтимОбъектамНуженКонтрольУникальности.Найти(ТипОбъекта))
		И ЗначениеЗаполнено(ЭтимИсточникамНуженКонтрольУникальности.Найти(ТипИсточника)) Тогда
		КонтрольУникальностиПроектаВТабЧасти = Истина;
	КонецЕсли;	
	
	// Имя табличной части, хранящей значение проекта, для разных объектов отличается.
	ИмяТабЧастиПриемника = "";
	Если упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.ПоступлениеВКассу") = ТипОбъекта
		ИЛИ упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.ПоступлениеНаСчет") = ТипОбъекта 
		ИЛИ упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.РасходИзКассы") = ТипОбъекта
		ИЛИ упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.РасходСоСчета") = ТипОбъекта Тогда
		ИмяТабЧастиПриемника = "РасшифровкаПлатежа";
	ИначеЕсли упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументОбъект.РасходнаяНакладная") = ТипОбъекта Тогда
		ИмяТабЧастиПриемника = "Запасы";
	КонецЕсли;	
	
	// Имя табличной части источника, в которой может храниться проект, для разных документов-источников может быть различным.
	ИмяТабЧастиИсточника = "";
	Если ТипИсточника = упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.АктВыполненныхРабот") Тогда
		ИмяТабЧастиИсточника = "РаботыИУслуги";
	ИначеЕсли ТипИсточника = упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.РасходнаяНакладная") Тогда
		ИмяТабЧастиИсточника = "Запасы";
	КонецЕсли; 
	
	// Возможно два варианта размещения Проекта - в шапке документа либо в таб. части.
	ВШапке = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВШапке");
	ВТЧ = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти");
	
	// Если у источника нет реквизита ПоложениеПроекта - значит проект расположен в шапке.
	УИсточникаЕстьПоложениеПроекта = ЗначениеЗаполнено(ДанныеЗаполнения)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеЗаполнения, "ПоложениеПроекта");
	ПоложениеПроектаИсточника = ?(УИсточникаЕстьПоложениеПроекта,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "ПоложениеПроекта"),
		ВШапке);              
		
	// Если у Объекта нет реквизита ПоложениеПроекта - значит проект расположен в шапке.
	УОбъектаЕстьПоложениеПроекта = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ПоложениеПроекта");
	ПоложениеПроектаОбъекта = Неопределено;      
	
	// Положение проекта может быть задано в настройках для каждого документа персонально либо для всех документов сразу.   
	ОбщийМодульУправлениеНебольшойФирмойПовтИсп = ОбщегоНазначения.ОбщийМодуль("УправлениеНебольшойФирмойПовтИсп");  
	
	ПоложениеПроектаПоУмолчанию = ОбщийМодульУправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(
		Пользователи.ТекущийПользователь(),
		"ПоложениеПроекта");   
				
	ПоложениеПроектаПоУмолчанию = ?(ЗначениеЗаполнено(ПоложениеПроектаПоУмолчанию), ПоложениеПроектаПоУмолчанию, ВШапке);
	Если УОбъектаЕстьПоложениеПроекта Тогда
		Если Не ЗначениеЗаполнено(Объект.ПоложениеПроекта) Тогда
			Объект.ПоложениеПроекта = ПоложениеПроектаПоУмолчанию;
		КонецЕсли;	
		ПоложениеПроектаОбъекта = Объект.ПоложениеПроекта;
	Иначе
		ПоложениеПроектаОбъекта = ВШапке;
	КонецЕсли;	     
	
	// Структура для передачи параметров в служебные методы.
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяРеквизитаПроектИсточника", ИмяРеквизитаПроектИсточника);
	Параметры.Вставить("ИмяРеквизитаПроектПриемника", ИмяРеквизитаПроектПриемника);
	Параметры.Вставить("КонтрольУникальностиПроектаВТабЧасти", КонтрольУникальностиПроектаВТабЧасти);
	Параметры.Вставить("ИмяТабЧастиПриемника", ИмяТабЧастиПриемника);
	Параметры.Вставить("ИмяТабЧастиИсточника", ИмяТабЧастиИсточника);
	
	Если ПоложениеПроектаИсточника = ВШапке И ПоложениеПроектаОбъекта = ВШапке Тогда
		ИзШапкиВШапку(Объект, ДанныеЗаполнения, Параметры);
	ИначеЕсли ПоложениеПроектаИсточника = ВШапке И ПоложениеПроектаОбъекта = ВТЧ Тогда
		ИзШапкиВТЧ(Объект, ДанныеЗаполнения, Параметры);
	ИначеЕсли ПоложениеПроектаИсточника = ВТЧ И ПоложениеПроектаОбъекта = ВШапке Тогда
		ИзТЧВШапку(Объект, ДанныеЗаполнения, Параметры);
	Иначе // У Источника и Приемника проект в таб. части. 
		ИзТЧВТЧ(Объект, ДанныеЗаполнения, Параметры);
	КонецЕсли;
		
КонецПроцедуры

#Область ЗаданияИКонтактЦентр

// Создает или обновляет элемент справочника ЗаписиКалендаряСотрудника, связанный с 
// элементом справочника упоЗадания.
//
// Параметры:
//	ОбъектупоЗадания - СправочникОбъект.упоЗадания
//
Процедура СоздатьОбновитьСвязанныйЭлементСправочникаЗаписиКалендаряСотрудника(ОбъектупоЗадания) Экспорт
	
	Если Не ПравоДоступа("Редактирование", Метаданные.Справочники["ЗаписиКалендаряСотрудника"]) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураСроки = упоЗаданияСервер.ПолучитьСрокиЗадания(ОбъектупоЗадания.Ссылка);
	СтруктураСроки = ?(СтруктураСроки = Неопределено,
		Новый Структура("ДатаНачалаПлан, ДатаОкончанияПлан, ДатаНачалаФакт, ДатаОкончанияФакт"),
		СтруктураСроки);
	
	ДанныеЗаполнения = Новый Структура("Источник, Начало, Окончание, Наименование, Календарь, КолонкаКалендаря, ОтветственныйИсточника, ПометкаУдаления, Завершено");
	ДанныеЗаполнения.Источник = ОбъектупоЗадания.Ссылка;
	ДанныеЗаполнения.Начало = СтруктураСроки.ДатаНачалаПлан;
	ДанныеЗаполнения.Окончание = СтруктураСроки.ДатаОкончанияПлан;
	ДанныеЗаполнения.Наименование = ОбъектупоЗадания.Наименование;
	ДанныеЗаполнения.ПометкаУдаления = ОбъектупоЗадания.ПометкаУдаления;
	
	
	СтатусыЗаданияПриКоторыхЗКСЗавершено = Новый Массив;
	СтатусыЗаданияПриКоторыхЗКСЗавершено.Добавить(Перечисления.упоСтатусыЗаданий.Завершено);
	СтатусыЗаданияПриКоторыхЗКСЗавершено.Добавить(Перечисления.упоСтатусыЗаданий.Закрыто);
	СтатусыЗаданияПриКоторыхЗКСЗавершено.Добавить(Перечисления.упоСтатусыЗаданий.Отменено);
	
	СтатусЗадания = упоЗаданияСервер.ПолучитьСтатусЗадания(ОбъектупоЗадания.Ссылка);
	
	Если СтатусыЗаданияПриКоторыхЗКСЗавершено.Найти(СтатусЗадания) = Неопределено Тогда
		ДанныеЗаполнения.Завершено = Ложь;
	Иначе
		ДанныеЗаполнения.Завершено = Истина;	
	КонецЕсли;	
	
	СвязанныйЭлементСправочникаЗКС = 
		Справочники["ЗаписиКалендаряСотрудника"].НайтиПоРеквизиту("Источник", ОбъектупоЗадания.Ссылка);
	
	Если СвязанныйЭлементСправочникаЗКС.Пустая() Тогда
		ОбъектСвязанныйЭлементСправочникаЗКС = Справочники["ЗаписиКалендаряСотрудника"].СоздатьЭлемент();
	Иначе
		ОбъектСвязанныйЭлементСправочникаЗКС = СвязанныйЭлементСправочникаЗКС.ПолучитьОбъект();
	КонецЕсли;
	
	СотрудникПользователя = СотрудникУНФпоТрудовомуРесурсуPM(ОбъектупоЗадания.Исполнитель);
	
	ОбщийМодульЗаполнениеОбъектовУНФ = ОбщегоНазначения.ОбщийМодуль("ЗаполнениеОбъектовУНФ");
	
	ДанныеЗаполнения.Календарь = ОбщийМодульЗаполнениеОбъектовУНФ.ПолучитьКалендарьСотрудника(СотрудникПользователя);
	ДанныеЗаполнения.КолонкаКалендаря = Справочники["КолонкиКалендарейСотрудников"].КолонкаНеобработанное(ДанныеЗаполнения.Календарь);
	ДанныеЗаполнения.ОтветственныйИсточника = СотрудникПользователя;
	
	ОбъектСвязанныйЭлементСправочникаЗКС.Заполнить(ДанныеЗаполнения);
	ОбъектСвязанныйЭлементСправочникаЗКС.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти   

#КонецОбласти

#Область СлужебныеОбработкаЗаполнения
 
Процедура ИзШапкиВШапку(Объект, ДанныеЗаполнения, Параметры)
	
	Объект[Параметры.ИмяРеквизитаПроектПриемника] = ДанныеЗаполнения[Параметры.ИмяРеквизитаПроектИсточника];
	
КонецПроцедуры

Процедура ИзТЧВШапку(Объект, ДанныеЗаполнения, Параметры)
	
	Если СтрДлина(Параметры.ИмяТабЧастиИсточника) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.КонтрольУникальностиПроектаВТабЧасти Тогда
		// При контроле уникальности проектов ТЧ источника,
		// если в ТЧ источника во всех строка указан одинаковый проект - переносим его в приемник.
		Проекты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДанныеЗаполнения[Параметры.ИмяТабЧастиИсточника].ВыгрузитьКолонку("Проект"));
		Если Проекты.Количество() = 1 Тогда
			Объект[Параметры.ИмяРеквизитаПроектПриемника] = Проекты[0];
		Иначе
			// Если в ТЧ источника указаны разные проекты - в приемник запишем пустой проект.
			Объект[Параметры.ИмяРеквизитаПроектПриемника] = Справочники.Проекты.ПустаяСсылка();	
		КонецЕсли;	
	Иначе
		// Без контроля уникальности проектов источника перенесём в приемник проект первой строки ТЧ источника
		Объект[Параметры.ИмяРеквизитаПроектПриемника] = ?(ДанныеЗаполнения[Параметры.ИмяТабЧастиИсточника].Количество() > 0,
			ДанныеЗаполнения[Параметры.ИмяТабЧастиИсточника][0].Проект,
			Объект[Параметры.ИмяРеквизитаПроектПриемника]);
	КонецЕсли;
		
КонецПроцедуры

Процедура ИзШапкиВТч(Объект, ДанныеЗаполнения, Параметры)
	// В источнике Проект расположен в шапке, переносим в ТЧ приёмника.
	
	ПроектИсточника = ДанныеЗаполнения[Параметры.ИмяРеквизитаПроектИсточника];
	Если ПроектИсточника.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ТабЧастьОбъекта = Объект[Параметры.ИмяТабЧастиПриемника];
	Для Каждого СтрокаТЧ Из ТабЧастьОбъекта Цикл
		СтрокаТЧ.Проект = ПроектИсточника;
	КонецЦикла;

КонецПроцедуры

Процедура ИзТчВТч(Объект, ДанныеЗаполнения, Параметры)
	// В источнике Проект расположен в ТЧ, переносим в ТЧ приёмника проекты из ТЧ источника.
	Если СтрДлина(Параметры.ИмяТабЧастиИсточника) = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если ДанныеЗаполнения[Параметры.ИмяТабЧастиИсточника].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если Параметры.КонтрольУникальностиПроектаВТабЧасти Тогда
		// С контролем уникальности проектов тч источника.
		// Если в ТЧ источника во всех строка указан одинаковый проект - переносим его в приемник.
		Проекты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ДанныеЗаполнения[Параметры.ИмяТабЧастиИсточника].ВыгрузитьКолонку("Проект"));
		Если Проекты.Количество() = 1 Тогда
			Проект = Проекты[0];
		Иначе
			// Если в ТЧ источника указаны разные проекты, или проектов нет вовсе - в приемник запишем пустой проект.
			Проект = Справочники.Проекты.ПустаяСсылка();	
		КонецЕсли;	
		Для Каждого СтрокаТЧ Из Объект[Параметры.ИмяТабЧастиПриемника] Цикл
			СтрокаТЧ.Проект = Проект;	
		КонецЦикла;	
	Иначе
		// Без контроля уникальности проектов тч источника.
		// Алгоритм нуждается в проработке, для каждой пары приемник-источник состав полей параметров отбора может быть разным.
		Для Каждого СтрокаТЧ Из Объект[Параметры.ИмяТабЧастиПриемника] Цикл
			ПараметрыОтбора = Новый Структура("Номенклатура");
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТЧ);
			СтрокиИсточника = ДанныеЗаполнения[Параметры.ИмяТабЧастиИсточника].НайтиСтроки(ПараметрыОтбора);
			Если СтрокиИсточника.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;	
			СтрокаТЧ.Проект = СтрокиИсточника[0].Проект;
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти   

#Область ЗаданияИКонтактЦентр

// Получает сотрудника УНФ по значению Трудового ресурса. 
// Если сотрудника не удалось определенить, будет возвращено Неопределено.
//
// Параметры:
//	ТрудовойРесурс - СправочникаСсылка.упоТрудовыеРесурсы 
//
// Возвращаемое значение:
//	СправочникаСсылка.Сотрудники, Неопределено
//
Функция СотрудникУНФпоТрудовомуРесурсуPM(Знач ТрудовойРесурс)
		
	упоСотрудник = упоРесурсыИРолиВызовСервера.обПолучитьТекущегоВладельцаРесурса(ТрудовойРесурс);
	Если ЗначениеЗаполнено(упоСотрудник) Тогда
		ОтветственныйЗКС = Неопределено;
		//массив диспетчеров сотрудника
		Диспетчеры = упоПользователи.ПолучитьМассивДиспетчеровСотрудника(упоСотрудник);
		
		Если Диспетчеры.Количество() = 0 Тогда
			ОтветственныйЗКС = Пользователи.ТекущийПользователь();
		ИначеЕсли Диспетчеры.Количество() = 1 Тогда
			ОтветственныйЗКС = Диспетчеры[0];
		Иначе // Количество() > 1
			Для Каждого Диспетчер Из Диспетчеры Цикл
				СотрудникПользователяПоУмолчанию = упоПользователиВызовСервера.обПолучитьНастройкуПользователя(
					"СотрудникПоУмолчанию", 
					Диспетчер);
				Если СотрудникПользователяПоУмолчанию = упоСотрудник Тогда
					ОтветственныйЗКС = Диспетчер;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			Если ОтветственныйЗКС = Неопределено Тогда
				ПредставлениеСотрудника = Строка(упоСотрудник); 
				упоИерархияИПолномочияВызовСервера.обПодобратьДиспетчераПоИмени(
					Диспетчеры, ПредставлениеСотрудника, ОтветственныйЗКС)
			КонецЕсли;
		КонецЕсли;	
	Иначе
		ПользовательПоОсновномуТрудовомуРесурсу = 
			Справочники.Пользователи.НайтиПоРеквизиту("упоОсновнойТрудовойРесурс", ТрудовойРесурс);
		Если ПользовательПоОсновномуТрудовомуРесурсу.Пустая() Тогда
			ОтветственныйЗКС = Пользователи.ТекущийПользователь();
		Иначе
			ОтветственныйЗКС = ПользовательПоОсновномуТрудовомуРесурсу;
		КонецЕсли;
	КонецЕсли;	
	
	СотрудникиПользователя = 
		РегистрыСведений["СотрудникиПользователя"].ПолучитьСотрудниковПользователя(ОтветственныйЗКС);
	
	СотрудникУНФ = ?(СотрудникиПользователя.Количество() > 0, СотрудникиПользователя[0], Неопределено);
	Возврат СотрудникУНФ;

КонецФункции

#КонецОбласти

