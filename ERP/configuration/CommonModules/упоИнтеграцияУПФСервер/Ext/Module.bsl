Функция ПолучитьТекстЗапросаДанныхПЗ(ПараметрыСозданияЗаказов)
	
	ВидДокумента = ПараметрыСозданияЗаказов.ВидДокумента;
	
	ВидДокументаЗаказПокупателя = упоИнтеграцияУПФКлиентСервер.ПолучитьИмяВидаЗаказаПокупателя();
	Если ВидДокумента = ВидДокументаЗаказПокупателя Тогда
		ТекстЗапроса = ПолучитьТекстЗапросаДанныхПЗДляЗаказаПокупателя();
	Иначе
		ТекстЗапроса = ПолучитьТекстЗапросаДанныхПЗДляЗаказаПоставщику();	
	КонецЕсли;
			
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТекстЗапросаДляПолученияСвойстваВедетсяБюджетДвиженияДенежныхСредств()

	ТекстЗапроса = 	"ВЫБРАТЬ
					|	упоНастройкаАналитикиВРазрезеПодразделений.ВедетсяБюджетДвиженияДенежныхСредств КАК ВедетсяБюджетДвиженияДенежныхСредств
					|ИЗ
					|	РегистрСведений.упоНастройкаАналитикиВРазрезеПодразделений КАК упоНастройкаАналитикиВРазрезеПодразделений
					|ГДЕ
					|	упоНастройкаАналитикиВРазрезеПодразделений.Объект = &Проект";  
	
	Возврат ТекстЗапроса;
	
КонецФункции 

Процедура ПроверитьВозможностьПолученияДанныхДляЗаказаПокупателя(Проект, ПараметрыСозданияЗаказов)
	
	ВидДокументаЗаказПокупателя = упоИнтеграцияУПФКлиентСервер.ПолучитьИмяВидаЗаказаПокупателя();
	Если ПараметрыСозданияЗаказов.ВидДокумента <> ВидДокументаЗаказПокупателя Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураНастроек = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);	
	
	Если СтруктураНастроек.ДоходыПоНатуральнымПоказателям Тогда
		Возврат;
	КонецЕсли;
	
	ТекстИсключения = 
		НСтр("ru = 'Для создания заказа покупателя необходимо в паспорте проекта включить опцию ""Доходы по натуральным показателям""'");
		
	ВызватьИсключение ТекстИсключения;	
		
КонецПроцедуры

// Удаляет незаполненные значения из структуры заполнения.
//
// Параметры:
//  СтруктураЗаполнения	 - Структура - данные заполнения.
//
Процедура УдалитьНезаполненныеЗначенияИзСтруктурыЗаполнения(СтруктураЗаполнения)
		
	ПараметрыКУдалению = Новый Массив;
	Для Каждого КлючЗначение Из СтруктураЗаполнения Цикл
		Если Не ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			ПараметрыКУдалению.Добавить(КлючЗначение.Ключ);
		КонецЕсли;	
	КонецЦикла;	

	Для Каждого ПараметрКУдалению Из ПараметрыКУдалению Цикл
		СтруктураЗаполнения.Удалить(ПараметрКУдалению);		
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#Область СинхронизацияЕдиницИзмерения

Процедура ИзменитьЭлементы_КлассификаторЕдиницИзмерения_ФормаВыбора(Форма, Отказ)

	ИмяРеквизита = упоИнтеграцияУПФКлиентСервер.ПолучитьИмяРеквизитаДляОпределенияВыбораУпаковки();
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Булево"));	
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Если Форма.Параметры.Свойство(ИмяРеквизита) Тогда
		
		// Установим действие выбор у элемента "Список".
		Элементы = Форма.Элементы;
		ЭлементСписок = Элементы.Найти("Список");
		
		Если ЭлементСписок <> Неопределено Тогда
			ЭлементСписок.УстановитьДействие("ВыборЗначения", "Подключаемый_упоСписокВыборЗначения");
			Форма[ИмяРеквизита] = Истина;
		КонецЕсли;
	
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

Процедура ДобавитьЭлементы_НачислениеЗарплаты_ФормаДокумента(Форма, Отказ)
	
	Родитель = Форма.Элементы.Найти("СтраховыеВзносыГруппаЗатраты");
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ТипПолеФормы = Тип("ПолеФормы");
	
	// Добавление поля "Проектная задача".
	Элемент_упоПроектнаяЗадача = Форма.Элементы.Добавить("упоСтраховыеВзносыПроектнаяЗадача",
			ТипПолеФормы,
			Родитель);
	Элемент_упоПроектнаяЗадача.Вид = ВидПоляФормы.ПолеВвода;
	Элемент_упоПроектнаяЗадача.КнопкаВыбора = Истина;
	Элемент_упоПроектнаяЗадача.ПутьКДанным = "Объект.Взносы.упоПроектнаяЗадача";
	
	// Добавление поля "Проект".
	Элемент_упоПроект = Форма.Элементы.Добавить("упоСтраховыеВзносыПроект",
			ТипПолеФормы,
			Родитель);
	Элемент_упоПроект.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент_упоПроект.ПутьКДанным = "Объект.Взносы.упоПроектнаяЗадача.упоКорневойПроект";
	Элемент_упоПроект.Заголовок = НСтр("ru = 'Проект'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	// Типовому полю "Аналитика-Направление деятельности" наздначаем обработчик события
	// "ПриИзменении", для автоматического заполнения ПЗ, связанной с выбранным Направлением деятельности.
	Элемент_СтраховыеВзносыНаправлениеДеятельности = Форма.Элементы.Найти("СтраховыеВзносыНаправлениеДеятельности");
	
	Если Элемент_СтраховыеВзносыНаправлениеДеятельности <> Неопределено Тогда 
		Элемент_СтраховыеВзносыНаправлениеДеятельности.УстановитьДействие("ПриИзменении", 
			"Подключаемый_упоСтраховыеВзносыНаправлениеДеятельностиПриИзменении");
	КонецЕсли;	

КонецПроцедуры	

Процедура ИзменитьЭлементы_Проекты_упоФормаЭлементаУправляемая(Форма, Отказ)
	
	ЭлементыФормы = Форма.Элементы;
	
	ДобавитьПодсказкуДляСвойстваВедетсяБюджетДвиженияДенежныхСредств(Форма, Отказ);
	
	СкрытьКомандыСозданияЗаданияНаПланированиеНаПрогноз(ЭлементыФормы);
		
КонецПроцедуры

