Процедура ДобавитьПодсказкуДляСвойстваВедетсяБюджетДвиженияДенежныхСредств(Форма, Отказ)
	
	ВедетсяБюджетДвиженияДенежныхСредств = Неопределено;
	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("упоВедетсяБюджетДвиженияДенежныхСредств") <> Неопределено Тогда
		ВедетсяБюджетДвиженияДенежныхСредств = Элементы.упоВедетсяБюджетДвиженияДенежныхСредств;
	ИначеЕсли Элементы.Найти("ВедетсяБюджетДвиженияДенежныхСредств") <> Неопределено Тогда
		ВедетсяБюджетДвиженияДенежныхСредств = Элементы.ВедетсяБюджетДвиженияДенежныхСредств;
	КонецЕсли;

	Если ВедетсяБюджетДвиженияДенежныхСредств = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ТекстПодсказки = нСтр("ru='Рекомендуется включить опцию ""Платежный календарь"" в подсистеме ""Деньги"" в настройках УНФ'", "ru");
	
	ВедетсяБюджетДвиженияДенежныхСредств.Подсказка 				= ТекстПодсказки;
	ВедетсяБюджетДвиженияДенежныхСредств.ОтображениеПодсказки 	= ОтображениеПодсказки.Кнопка;
	
КонецПроцедуры 

#Область ПолучениеДанныхРаспределенияЗарплаты

Процедура ЗаполнитьПараметрыЗапроса(Запрос, ДанныеДокумента)

	ПериодРегистрации = ДанныеДокумента.ПериодРегистрации;
	НачалоПериода = НачалоМесяца(ПериодРегистрации);
	ОкончаниеПериода = КонецДня(КонецМесяца(ПериодРегистрации));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	СотрудникиИзТЧ = ПолучитьСотрудниковИзДанныхТабличнойЧасти(ДанныеДокумента);
	Запрос.УстановитьПараметр("Сотрудники", СотрудникиИзТЧ);
	СтруктурнаяЕдиница = ДанныеДокумента.СтруктурнаяЕдиница;
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница", СтруктурнаяЕдиница);	
	Запрос.УстановитьПараметр("УровеньПланированияОкончательный", Перечисления.упоУровеньПланирования.Окончательный);
	
КонецПроцедуры	

Процедура ИсправитьСуммуВРаспределенииПослеОкругления(РаспределениеПоПропорции, ОбщаяСумма)
	
	Если РаспределениеПоПропорции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СуммаСтрокРаспределения = 0;
	Для Каждого	СтрокаРаспределения Из РаспределениеПоПропорции Цикл		
		СуммаСтрокРаспределения = СуммаСтрокРаспределения + СтрокаРаспределения.Сумма;		
	КонецЦикла;
	
	Если СуммаСтрокРаспределения = ОбщаяСумма Тогда
		Возврат;
	КонецЕсли;
	
	Отклонение = ОбщаяСумма - СуммаСтрокРаспределения;
	
	ИндексПоследнегоЭлемента = РаспределениеПоПропорции.ВГраница();
	ПоследниеЭлементРаспределения = РаспределениеПоПропорции[ИндексПоследнегоЭлемента];
	ПоследниеЭлементРаспределения.Сумма = ПоследниеЭлементРаспределения.Сумма + Отклонение;
	
КонецПроцедуры

Функция ПолучитьДанныеТабЧастиСУчетомРаспределения(ДанныеДокумента, Распределение)
		
	НачисленияУдержания = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(ДанныеДокумента.ДанныеТЧНачисленияУдержания);
	
	ИменаПолей = упоИнтеграцияУПФКлиентСервер.ПолучитьИменаРеквизитовДляРаспределенияСуммыЗарплатыПоФактуТрудозатрат();
	
	Для Каждого Строка Из НачисленияУдержания Цикл
		
		Отбор = Новый Структура("Сотрудник", Строка.Сотрудник);
		СтрокиРаспределения = Распределение.НайтиСтроки(Отбор);
		РаспределениеПоПропорции = Новый Массив;
		ОбщаяСумма = Строка.Сумма;
		Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл
			СтрокаНачисления = Новый Структура(ИменаПолей);
			ЗаполнитьЗначенияСвойств(СтрокаНачисления, СтрокаРаспределения);
			ПропорциональнаяСумма = ОбщаяСумма * СтрокаРаспределения.Пропорция;
			СтрокаНачисления.Сумма = Окр(ПропорциональнаяСумма, 2);
			РаспределениеПоПропорции.Добавить(СтрокаНачисления);
		КонецЦикла;
		
		ИсправитьСуммуВРаспределенииПослеОкругления(РаспределениеПоПропорции, ОбщаяСумма);
		
		Строка.Вставить("Распределение", РаспределениеПоПропорции);
		
	КонецЦикла;
	
	Возврат НачисленияУдержания;
	
КонецФункции

Функция ПолучитьПропорциюРаспределенияПоТрудозатратам(ДанныеДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляПолученияПропорцииТрудозатрат();	
	ЗаполнитьПараметрыЗапроса(Запрос, ДанныеДокумента);	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Распределение = РезультатЗапроса.Выгрузить();
	
	Возврат Распределение;
	
КонецФункции

Функция ПолучитьСотрудниковИзДанныхТабличнойЧасти(ДанныеДокумента)
	
	СотрудникиИзТЧ = Новый Массив;
	Для Каждого Строка Из ДанныеДокумента.ДанныеТЧНачисленияУдержания Цикл
		СотрудникиИзТЧ.Добавить(Строка.Сотрудник);			
	КонецЦикла;
	
	Возврат СотрудникиИзТЧ;
	
КонецФункции

Функция ПолучитьТекстЗапросаДляПолученияПропорцииТрудозатрат()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	упоСоответствиеСотрудниковИТрудовыхРесурсов.ТрудовойРесурс КАК ТрудовойРесурс
	|ПОМЕСТИТЬ ТрудовыеРесурсыСотрудников
	|ИЗ
	|	РегистрСведений.упоСоответствиеСотрудниковИТрудовыхРесурсов КАК упоСоответствиеСотрудниковИТрудовыхРесурсов
	|ГДЕ
	|	упоСоответствиеСотрудниковИТрудовыхРесурсов.Сотрудник В(&Сотрудники)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСоответствиеПодразделенийИСтруктурыПредприятия.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ПодразделенияСтруктурнойЕдиницы
	|ИЗ
	|	РегистрСведений.упоСоответствиеПодразделенийИСтруктурыПредприятия КАК упоСоответствиеПодразделенийИСтруктурыПредприятия
	|ГДЕ
	|	упоСоответствиеПодразделенийИСтруктурыПредприятия.СтруктураПредприятия = &СтруктурнаяЕдиница
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСоставПодразделенийСрезПоследних.Подразделение КАК Подразделение,
	|	упоСоставПодразделенийСрезПоследних.Роль КАК Роль
	|ПОМЕСТИТЬ РолиПодразделения
	|ИЗ
	|	РегистрСведений.упоСоставПодразделений.СрезПоследних(
	|			,
	|			Подразделение В
	|				(ВЫБРАТЬ
	|					ПодразделенияСтруктурнойЕдиницы.Подразделение
	|				ИЗ
	|					ПодразделенияСтруктурнойЕдиницы)) КАК упоСоставПодразделенийСрезПоследних
	|ГДЕ
	|	упоСоставПодразделенийСрезПоследних.ВходитВСостав
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Роль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоФактТрудозатратПоДням.Операция КАК ПроектнаяЗадача,
	|	упоФактТрудозатратПоДням.Ресурс КАК Ресурс,
	|	СУММА(упоФактТрудозатратПоДням.Трудозатраты) КАК Трудозатраты
	|ПОМЕСТИТЬ ФактТрудозатрат
	|ИЗ
	|	РегистрСведений.упоФактТрудозатратПоДням КАК упоФактТрудозатратПоДням
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТрудовыеРесурсыСотрудников КАК ТрудовыеРесурсыСотрудников
	|		ПО упоФактТрудозатратПоДням.Ресурс = ТрудовыеРесурсыСотрудников.ТрудовойРесурс
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РолиПодразделения КАК РолиПодразделения
	|		ПО упоФактТрудозатратПоДням.Роль = РолиПодразделения.Роль
	|ГДЕ
	|	упоФактТрудозатратПоДням.День МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|	И упоФактТрудозатратПоДням.УровеньПланирования = &УровеньПланированияОкончательный
	|
	|СГРУППИРОВАТЬ ПО
	|	упоФактТрудозатратПоДням.Операция,
	|	упоФактТрудозатратПоДням.Ресурс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФактТрудозатрат.Ресурс КАК Ресурс,
	|	СУММА(ФактТрудозатрат.Трудозатраты) КАК Трудозатраты
	|ПОМЕСТИТЬ ОбщаяСуммаПоТрудовымРесурсам
	|ИЗ
	|	ФактТрудозатрат КАК ФактТрудозатрат
	|
	|СГРУППИРОВАТЬ ПО
	|	ФактТрудозатрат.Ресурс
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСоответствиеСотрудниковИТрудовыхРесурсов.Сотрудник КАК Сотрудник,
	|	упоСвязьПроектаСНаправлениемДеятельности.НаправлениеДеятельностиЭлемент КАК НаправлениеДеятельности,
	|	Проекты.Ссылка КАК Проект,
	|	ФактТрудозатрат.Трудозатраты / ОбщаяСуммаПоТрудовымРесурсам.Трудозатраты КАК Пропорция
	|ИЗ
	|	ФактТрудозатрат КАК ФактТрудозатрат
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбщаяСуммаПоТрудовымРесурсам КАК ОбщаяСуммаПоТрудовымРесурсам
	|		ПО ФактТрудозатрат.Ресурс = ОбщаяСуммаПоТрудовымРесурсам.Ресурс
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСоответствиеСотрудниковИТрудовыхРесурсов КАК упоСоответствиеСотрудниковИТрудовыхРесурсов
	|		ПО ФактТрудозатрат.Ресурс = упоСоответствиеСотрудниковИТрудовыхРесурсов.ТрудовойРесурс
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО ФактТрудозатрат.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвязьПроектаСНаправлениемДеятельности КАК упоСвязьПроектаСНаправлениемДеятельности
	|		ПО ФактТрудозатрат.ПроектнаяЗадача = упоСвязьПроектаСНаправлениемДеятельности.ПроектныйЭлементПроектнаяЗадача";
	
	Возврат ТекстЗапроса;
	
КонецФункции

