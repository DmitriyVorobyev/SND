Процедура ДобавитьЭлементы_АнализБизнеса_ФормаОтчета(Форма, Отказ)
	
	ЭлементПроект = Форма.Элементы.ОтборПроект;
	
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЭтоФормаВыбораПроекта", Истина));
	
	ЭлементПроект.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
	
КонецПроцедуры

Процедура ДобавитьЭлементыФормыВыбораСтруктурныеЕдиницы(Форма, Отказ)
	
	ПараметрыФормы = Форма.Параметры;
	
	Если ПараметрыФормы.Свойство("упоВыборПодразделения") Тогда
		Реквизит_упоВыборПодразделения 			= Новый РеквизитФормы("упоВыборПодразделения", Новый ОписаниеТипов("Булево"));  
		Реквизит_упоАдресПараметровДляОтбора 	= Новый РеквизитФормы("упоАдресПараметровДляОтбора", 
			Новый ОписаниеТипов("Строка"));               
			
		ДобавляемыеРеквизиты = Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Реквизит_упоВыборПодразделения);
		ДобавляемыеРеквизиты.Добавить(Реквизит_упоАдресПараметровДляОтбора);
		
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты); 
		
		Форма.упоВыборПодразделения = ПараметрыФормы.упоВыборПодразделения;
		
		Форма.Элементы.Список.УстановитьДействие("ВыборЗначения", "Подключаемый_упоСписокВыборЗначения");	
	КонецЕсли; 
	
	Если ПараметрыФормы.Свойство("РежимОтображения") И ЗначениеЗаполнено(ПараметрыФормы.РежимОтображения) Тогда
		Форма.РежимОтображения 			= ПараметрыФормы.РежимОтображения;       
		Форма.ТекущийРежимОтображения 	= ПараметрыФормы.РежимОтображения;		
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьЭлементы_ПерсональныеНастройки_МоиНастройки(Форма, Отказ)
	
	ИмяГруппы = "ГруппаПрочиеНастройки";
	ГруппаПередКоторойВставитьНовую = Форма.Элементы.Найти(ИмяГруппы);
	
	ИмяНовойГруппы = "НастройкиУправленияПроектов";
	ЗаголовокНовойГруппы = НСтр("ru = 'Настройки управления проектами'");
	
	НовыйЭлементГруппа = Форма.Элементы.Вставить(ИмяНовойГруппы,
												Тип("ГруппаФормы"),
												Форма,
												ГруппаПередКоторойВставитьНовую);
	НовыйЭлементГруппа.Заголовок = ЗаголовокНовойГруппы;
	НовыйЭлементГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлементГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлементГруппа.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;

	Гиперссылка = Форма.Элементы.Добавить("УправлениеПроектами",
										  Тип("ДекорацияФормы"),
										  НовыйЭлементГруппа);
	Гиперссылка.Заголовок = Новый ФорматированнаяСтрока(НСтр("ru = 'Управление проектами'"),
														,
														,
														,
														"e1cib/command/ОбщаяКоманда.ПерсональныеНастройки");
		
КонецПроцедуры 

Процедура ИзменитьЭлементы_ОбщаяФорма_ПерсональныеНастройки(Форма, Отказ)
	
	Форма.Заголовок = НСтр("ru = 'Управление проектами'");
	
	ИмяГруппыТиповыхЭлементов = "Группа";
	ГруппаТиповыхЭлементов = Форма.Элементы.Найти(ИмяГруппыТиповыхЭлементов);

	Для каждого Элемент Из ГруппаТиповыхЭлементов.ПодчиненныеЭлементы Цикл
	
		Элемент.Видимость = Ложь;

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЭлементы_Событие_ФормаСписка(Форма, Отказ)
	
	// Для типового отбора по Проекту установим параметры отбора,
	// необходимо только проекты, без ПЗ.
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЭтоФормаВыбораПроекта", Истина));  
	Форма.Элементы.ОтборПроект.ПараметрыВыбора 		= Новый ФиксированныйМассив(ПараметрыВыбора);
	
	ДобавляемыеРеквизиты = Новый Массив;	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("упоОтборПЗ", 
														Новый ОписаниеТипов("СправочникСсылка.Проекты"), 
														,
														"Отбор проектная задача"));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);													
	
	ГруппаРодитель = Форма.Элементы.Найти("ГруппаОтборы");
	Если ГруппаРодитель <> Неопределено Тогда
		ГруппаПроекты = Форма.Элементы.Найти("Проекты");
		Если ГруппаПроекты <> Неопределено Тогда
			НовыйЭлементГруппа = Форма.Элементы.Вставить("упоГруппаОтборПЗ", Тип("ГруппаФормы"), ГруппаРодитель, ГруппаПроекты);
			Форма.Элементы.Переместить(ГруппаПроекты, ГруппаРодитель, НовыйЭлементГруппа);
		Иначе	
			НовыйЭлементГруппа = Форма.Элементы.Добавить("упоГруппаОтборПЗ", Тип("ГруппаФормы"), ГруппаРодитель);		
		КонецЕсли;
		
		НовыйЭлементГруппа.Заголовок			= НСтр("ru = 'Отбор проектная задача'", ОбщегоНазначения.КодОсновногоЯзыка());
		НовыйЭлементГруппа.Вид 					= ВидГруппыФормы.ОбычнаяГруппа;
		НовыйЭлементГруппа.Группировка 			= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		НовыйЭлементГруппа.Отображение 			= ОтображениеОбычнойГруппы.Нет;
		НовыйЭлементГруппа.ОтображатьЗаголовок 	= Ложь;	           
		
		ПараметрыВыбора = Новый Массив;
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЭтоФормаВыбораПроектнойЗадачиКакПроекта", Истина));  
		
		НовыйЭлементФормы = Форма.Элементы.Добавить("упоОтборПЗ", Тип("ПолеФормы"), НовыйЭлементГруппа);
		НовыйЭлементФормы.ПутьКДанным 			= "упоОтборПЗ"; 
		НовыйЭлементФормы.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлементФормы.Вид 					= ВидПоляФормы.ПолеВвода; 
		НовыйЭлементФормы.ПодсказкаВвода		= НСтр("ru = 'Проектная задача'", ОбщегоНазначения.КодОсновногоЯзыка());
		НовыйЭлементФормы.КнопкаОткрытия		= Ложь;
		НовыйЭлементФормы.ПараметрыВыбора 		= Новый ФиксированныйМассив(ПараметрыВыбора);
		НовыйЭлементФормы.УстановитьДействие("ОбработкаВыбора", "Подключаемые_упоОтборПЗОбработкаВыбора");
	КонецЕсли;

	// Изменим текст запроса.
	// 1. Переименуем поле Проект в ПроектнаяЗадача, 
	// т.к. фактически в нем хранится ссылка на ПЗ, по этому полю будет работать
	// новый, добавленный программно выше отбор.
	// 2. Добавим поле Проект.упоКорневойПроект с псевдонимом Проект,
	// чтобы типовой отбор по проекту работал по этому полю.
	Форма.Список.ТекстЗапроса = СтрЗаменить(Форма.Список.ТекстЗапроса, 
									  "КАК Проект", 
									  "КАК ПроектнаяЗадача,
									  |ДокументСобытие.Проект.упоКорневойПроект КАК Проект");
		
КонецПроцедуры 

Функция ОпределитьВидимостьГрупп(Форма)
		
	ВидимостьГрупп = Истина;  
	
	ОбъектФормы = Форма.Объект;
	ИмяФормы 	= Форма.ИмяФормы;    
	
	Если ИмяФормы = "Документ.ПеремещениеЗапасов.Форма.ФормаДокумента" Тогда
		
		Если ОбъектФормы.ВидОперации <> 
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПеремещениеЗапасов.СписаниеНаРасходы") Тогда
			ВидимостьГрупп = Ложь;
		КонецЕсли;
		
	ИначеЕсли ИмяФормы = "Документ.ПлатежноеПоручение.Форма.ФормаДокумента" Тогда
		
		Если ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПереводНаДругойСчет") 
			//ИЛИ ОбъектФормы.ВидОперации = Перечисления.ВидыОперацийПлатежноеПоручение.РасчетыПоКредитам
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПлатежноеПоручение.ПеречислениеНалога") Тогда
			ВидимостьГрупп = Ложь;
		КонецЕсли;	
		
	ИначеЕсли ИмяФормы = "Документ.ПоступлениеВКассу.Форма.ФормаДокумента" Тогда
		
		Если ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеВКассу.ВозвратЗаймаСотрудником") 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеВКассу.ПокупкаВалюты")
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеВКассу.РозничнаяВыручка")
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеВКассу.ПолучениеНаличныхВБанке") Тогда
			ВидимостьГрупп = Ложь;
		КонецЕсли;	
		
	ИначеЕсли ИмяФормы = "Документ.ПоступлениеНаСчет.Форма.ФормаДокумента" Тогда
		
		Если ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ВозвратЗаймаСотрудником") 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ВзносНаличными")
			//ИЛИ ОбъектФормы.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.РасчетыПоКредитам
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ПереводСДругогоСчета") 
			//ИЛИ ОбъектФормы.ВидОперации = Перечисления.ВидыОперацийПоступлениеНаСчет.Налоги 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийПоступлениеНаСчет.ПоступлениеОплатыПоКартам") Тогда
			ВидимостьГрупп = Ложь;
		КонецЕсли;		
		
	ИначеЕсли ИмяФормы = "Документ.РасходИзКассы.Форма.ФормаДокумента" Тогда
		
		Если ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходИзКассы.ВыдачаЗаймаСотруднику")
			//ИЛИ ОбъектФормы.ВидОперации = Перечисления.ВидыОперацийРасходИзКассы.РасчетыПоКредитам
			//ИЛИ ОбъектФормы.ВидОперации = Перечисления.ВидыОперацийРасходИзКассы.Налоги 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходИзКассы.ВзносНаличнымиВБанк") 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходИзКассы.ПеремещениеВКассуККМ") Тогда
			ВидимостьГрупп = Ложь;
		КонецЕсли;	
		
	ИначеЕсли ИмяФормы = "Документ.РасходСоСчета.Форма.ФормаДокумента" Тогда
		
		Если ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ВыдачаЗаймаСотруднику") 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ПереводНаДругойСчет")
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.СнятиеНаличных")
			//ИЛИ ОбъектФормы.ВидОперации = Перечисления.ВидыОперацийРасходСоСчета.Налоги 
			ИЛИ ОбъектФормы.ВидОперации = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыОперацийРасходСоСчета.ВозвратОплатыНаПлатежныеКарты") Тогда
			ВидимостьГрупп = Ложь;
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ВидимостьГрупп;
	
КонецФункции

Функция ПараметрыДляДобавленияПроектаВТаблицу(ТаблицаФормы)
	
	Параметры = СтруктураПараметров();
    ПолеТаблицыСвязанноеСПроектом = ПолеСвязанноеСПроектом(ТаблицаФормы);
	
	Если ПолеТаблицыСвязанноеСПроектом = Неопределено Тогда  
		Возврат Параметры; 	
	КонецЕсли;	         
	
	Параметры.ИмяСкрываемогоЭлемента 	= ПолеТаблицыСвязанноеСПроектом.Имя;
	Параметры.ИмяТабличнойЧасти 		= ТаблицаФормы.Имя;	
	
	Возврат Параметры;
	
КонецФункции

Функция ПолеСвязанноеСПроектом(ТаблицаИлиГруппаФормы, ТаблицаВладелецЭлемента = Неопределено)
	
	Если ТипЗнч(ТаблицаИлиГруппаФормы) = Тип("ТаблицаФормы") Тогда
		ТаблицаВладелецЭлемента = ТаблицаИлиГруппаФормы;
	Иначе
		ТаблицаВладелецЭлемента = ТаблицаВладелецЭлемента;
	КонецЕсли;
	
	Для Каждого ЭлементТаблицы Из ТаблицаИлиГруппаФормы.ПодчиненныеЭлементы Цикл
		
		Если ЭтоПолеСвязанноеСПроектом(ЭлементТаблицы, ТаблицаВладелецЭлемента) Тогда
			Возврат ЭлементТаблицы;
		КонецЕсли;
		
		Если ЭтоГруппаСодержащаяПолеСвязанноеСПроектом(ЭлементТаблицы, ТаблицаИлиГруппаФормы) Тогда
			Возврат ПолеСвязанноеСПроектом(ЭлементТаблицы, ТаблицаВладелецЭлемента);
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

