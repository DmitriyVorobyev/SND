		НовыйЭлементФормы.Вид 					= ВидПоляФормы.ПолеВвода; 
		НовыйЭлементФормы.ПодсказкаВвода		= НСтр("ru = 'Проект'", ОбщегоНазначения.КодОсновногоЯзыка());
		НовыйЭлементФормы.КнопкаОткрытия		= Ложь;
