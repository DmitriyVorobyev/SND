Функция РодительСТипомГруппаСчетов(Счет, СтатьяМенеджер)
	
	СчетГруппаСчетов = Неопределено;
	СчетРодитель = Счет.Родитель;
	
	Если Не ЗначениеЗаполнено(Счет.Родитель) Тогда
		Возврат СтатьяМенеджер.ПустаяСсылка();
	КонецЕсли;
	
	Если СчетРодитель.ТипСчета = 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыСчетов.ГруппаСчетов") Тогда
		Возврат СчетРодитель;
	Иначе 
		Возврат РодительСТипомГруппаСчетов(СчетРодитель, СтатьяМенеджер);
	КонецЕсли;
	
КонецФункции
 
Функция СправочникМенеджерПоТипуСчета(ТипСчета, ТипыСчетовВДоходы, ТипыСчетовВЗатраты)
	
	Если ТипыСчетовВДоходы.Найти(ТипСчета) <> Неопределено Тогда
		
		Возврат Справочники.упоСтатьиДоходов;
		
	ИначеЕсли ТипыСчетовВЗатраты.Найти(ТипСчета) <> Неопределено Тогда
		
		Возврат Справочники.упоСтатьиЗатрат;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
		
КонецФункции

Функция ВставитьГруппуРеквизитыPM(Форма, 
									Знач Родитель = Неопределено, 
									Знач ПередЭлементом = Неопределено, 
									Группировка = Неопределено)
	
	Если Родитель = Неопределено Тогда
		Родитель = ПередЭлементом.Родитель;
	КонецЕсли;	
	
	Если Группировка = Неопределено Тогда
		Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;	
	
	ГруппаPM = Форма.Элементы.Вставить("упоГруппаPM", 
										Тип("ГруппаФормы"), 
										Родитель, 
										ПередЭлементом);
			
	ГруппаPM.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаPM.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаPM.Группировка = Группировка;
	ГруппаPM.Заголовок = НСтр("ru = 'Реквизиты PM'");
	ГруппаPM.ОтображатьЗаголовок = Ложь;
	ГруппаPM.РазрешитьИзменениеСостава = Ложь;
		
	Возврат ГруппаPM;	
	
КонецФункции	

Процедура ДобавитьЭлементыПроектаВФорму(Форма)
	
	НужнаОбработкаФормыДокумента = Ложь;
	
	ИмяФормы = Форма.ИмяФормы;
	
	// Параметры добавления и изменения элементов
	Параметры	= СтруктураПараметров();
	ИмяГруппы 	= упоИнтеграцияУПФКлиентСервер.ИмяСоздаваемойГруппыДляНастройкиВидимостиЭлементов(); 
	
	МассивИменФормСПроектом = ПолучитьСписокФормСПроектом();
	
	Для Каждого ИмяФормыСПроектом Из МассивИменФормСПроектом Цикл
		
		Если ИмяФормы <> ИмяФормыСПроектом Тогда
			Продолжить;		
		КонецЕсли;
		
		НужнаОбработкаФормыДокумента = Истина;
		
		Прервать;
		
	КонецЦикла;

	Если Не НужнаОбработкаФормыДокумента Тогда
		Возврат;	
	КонецЕсли;
	
	Если ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаЗаказНаряда" Тогда
		Параметры.ИмяСкрываемогоЭлемента = "ЗНПроект";	  
	// Для этих документов в шапку реквизит "Проект" не выводится.
	ИначеЕсли ИмяФормы = "Документ.Бюджет.Форма.ФормаДокумента"
		ИЛИ ИмяФормы = "Документ.НачислениеЗарплатыУНФ.Форма.ФормаДокумента"
		ИЛИ ИмяФормы = "Документ.НачисленияПоКредитамИЗаймам.Форма.ФормаДокумента" Тогда
		Параметры.ИмяСкрываемогоЭлемента = "";
	Иначе
		Параметры.ИмяСкрываемогоЭлемента = "Проект";		
	КонецЕсли;
	
	ДобавитьЭлементыПроектаВШапкуТаблицу(Форма, ИмяГруппы, Ложь, Параметры); 
	
	ТаблицыФормы = ТаблицыФормыСодержащиеПроект(Форма);	
	
	Для Каждого Таблица Из ТаблицыФормы Цикл	                                                                
		Параметры = ПараметрыДляДобавленияПроектаВТаблицу(Таблица);  

		Если Параметры.ИмяТабличнойЧасти = "РасшифровкаПлатежа"
			И (ИмяФормы = "Документ.ПоступлениеНаСчет.Форма.ФормаДокумента"
			Или ИмяФормы = "Документ.РасходСоСчета.Форма.ФормаДокумента"
			Или ИмяФормы = "Документ.ПоступлениеВКассу.Форма.ФормаДокумента"
			Или ИмяФормы = "Документ.РасходИзКассы.Форма.ФормаДокумента" 
			Или ИмяФормы = "Документ.ПлатежноеПоручение.Форма.ФормаДокумента") Тогда  
			
			Параметры.Вставить("ДобавитьВГруппуТЧ", Истина);         
			Параметры.Вставить("БезГруппировкиКолонок", Истина);
			Параметры.Вставить("НеОтображатьВШапке", Истина);
			Параметры.Вставить("НовыйЗаголовокРодителя", НСтр("ru = 'Проектная задача / Проект / Подразделение'"));	
			
		КонецЕсли;

		ИмяТабличнойЧасти = упоИнтеграцияУПФКлиентСервер.ИмяГруппыТЧПоИмениТЧ(Параметры.ИмяТабличнойЧасти);	
		
		ДобавитьЭлементыПроектаВШапкуТаблицу(Форма, ИмяТабличнойЧасти, Истина, Параметры);	
	КонецЦикла;
	
	УстановитьВидимостьЭлементовПроектИПроектнаяЗадачаВЗависимостиОтПользовательскихНастроек(Форма);	
	
КонецПроцедуры

// Добавляет на форму элементы и скрывает указанный в параметрах элемент
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Произвольная форма
//  ИмяСоздаваемойГруппы - Строка - Имя создаваемой группы
//  ЭтоЭлементТЧ - Булево - Определяет, где создаем элементы в табличной части или в группе формы
//  Параметры - Структура - Необходимые параметры
//   * ИмяТабличнойЧасти - Строка - Имя табличной части
//   * ИмяСкрываемогоЭлемента - Строка - Имя скрываемого элемента
//	 * ИмяГруппыВШапке - Строка - Имя группы в шапке
//	 * ПоложениеПроекта - Строка - Положение проекта
//
Процедура ДобавитьЭлементыПроектаВШапкуТаблицу(Форма, ИмяСоздаваемойГруппы, ЭтоЭлементТЧ, Параметры)
	
	Элементы = Форма.Элементы;
	
	ИмяТабличнойЧасти = Параметры.ИмяТабличнойЧасти;
	
	ИмяСкрываемогоЭлемента = Параметры.ИмяСкрываемогоЭлемента;   
	
	Если ИмяСкрываемогоЭлемента = "" Тогда
		Возврат;	
	КонецЕсли;         
	
	РодительСкрываемогоЭлемента	= Элементы.Найти(ИмяСкрываемогоЭлемента).Родитель;

	Если ЭтоЭлементТЧ Тогда
		Если Параметры.Свойство("ДобавитьВГруппуТЧ") И Параметры.ДобавитьВГруппуТЧ Тогда
			ГруппаРодитель = РодительСкрываемогоЭлемента;
		Иначе
			ГруппаРодитель = Элементы.Найти(ИмяТабличнойЧасти);
		КонецЕсли;
	Иначе        
		ГруппаРодитель 	= РодительСкрываемогоЭлемента; 		
	КонецЕсли;
	
	Если ГруппаРодитель = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЭтоЭлементТЧ Тогда
		// Предполагаем, что таб. часть содержит реквизит "Проект"
		ПутьКДанным = Форма.Элементы[ИмяТабличнойЧасти].ПутьКДанным;
	Иначе
		// Предполагаем, что основной реквизит формы называется "Объект".
		ПутьКДанным = "Объект";
	КонецЕсли;  
	
	ПутьКДаннымПроектнойЗадачи = ПутьКДанным + ".Проект";
	ПутьКДаннымПроекта = ПутьКДанным + ".Проект.упоКорневойПроект";
	
	Если Параметры.Свойство("НовыйЗаголовокРодителя") И ЗначениеЗаполнено(Параметры.НовыйЗаголовокРодителя) Тогда
		ГруппаРодитель.Заголовок = Параметры.НовыйЗаголовокРодителя;	
	КонецЕсли;
	
	ОтображатьВШапке = Истина; 
	
	Если Параметры.Свойство("НеОтображатьВШапке") Тогда
		ОтображатьВШапке = Ложь;
	КонецЕсли;
	
	ГруппировкаКолонокВГруппе = Истина;
	
	Если Параметры.Свойство("БезГруппировкиКолонок") Тогда
		ГруппировкаКолонокВГруппе = Ложь;
		ОтображатьВШапке = Ложь;
	КонецЕсли;
	
	ГруппаСоздаваемыхЭлементов = Элементы.Добавить(ИмяСоздаваемойГруппы, Тип("ГруппаФормы"), ГруппаРодитель);  
	
	Если ЭтоЭлементТЧ Тогда
		ГруппаСоздаваемыхЭлементов.Вид = ВидГруппыФормы.ГруппаКолонок; 
		
		Если ГруппировкаКолонокВГруппе Тогда
			ГруппаСоздаваемыхЭлементов.Группировка = ГруппировкаКолонок.Горизонтальная;
		КонецЕсли;  
		
	Иначе
		ГруппаСоздаваемыхЭлементов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаСоздаваемыхЭлементов.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаСоздаваемыхЭлементов.ОтображатьЗаголовок = Ложь;
		ГруппаСоздаваемыхЭлементов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	СкрываемыйЭлемент = Элементы.Найти(ИмяСкрываемогоЭлемента);
	
	Если СкрываемыйЭлемент <> Неопределено Тогда
		
		Элементы.Переместить(ГруппаСоздаваемыхЭлементов, ГруппаРодитель, СкрываемыйЭлемент);      
		
		ИмяГруппы = упоИнтеграцияУПФКлиентСервер.ИмяГруппыДляСкрытия(ИмяТабличнойЧасти);
		
		// Чтобы внутренняя логика изменения видимости для скрываемого поля не отрабатывала, помещаем его в отдельную группу
		// и делаем эту группу невидимой
		ГруппаСкрываемыхЭлементов = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), ГруппаРодитель); 
		
		Если ЭтоЭлементТЧ Тогда
			ГруппаСкрываемыхЭлементов.Вид = ВидГруппыФормы.ГруппаКолонок;
			ГруппаСкрываемыхЭлементов.Группировка = ГруппировкаКолонок.Горизонтальная;
		Иначе
			ГруппаСкрываемыхЭлементов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			ГруппаСкрываемыхЭлементов.Отображение = ОтображениеОбычнойГруппы.Нет;
		КонецЕсли; 
		
		Элементы.Переместить(СкрываемыйЭлемент, ГруппаСкрываемыхЭлементов); 
		
		ГруппаСкрываемыхЭлементов.Видимость = Ложь;
		
	КонецЕсли;
	
	Подсказка = НСтр("ru = 'Проект, в рамках которого оформляется документ'");
	
	ИмяЭлемента = "упо&1ПроектнаяЗадача";
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "&1", ИмяТабличнойЧасти);
	
	ПолеПроектнаяЗадача 						= Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаСоздаваемыхЭлементов);
	ПолеПроектнаяЗадача.ПутьКДанным 			= ПутьКДаннымПроектнойЗадачи;
	ПолеПроектнаяЗадача.Вид 					= ВидПоляФормы.ПолеВвода;	
	ПолеПроектнаяЗадача.Заголовок				= НСтр("ru = 'Проектная задача'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	ПолеПроектнаяЗадача.ОтображатьВШапке 		= ОтображатьВШапке;
	ПолеПроектнаяЗадача.Подсказка 				= Подсказка; 
	
	ПараметрыВыбора = Новый Массив;
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЭтоФормаВыбораПроектнойЗадачиКакПроекта", Истина));
	ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЭтоПроектнаяЗадача", Истина));
	ПолеПроектнаяЗадача.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);	

	ИмяЭлемента = "упо&1Проект";
	ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "&1", ИмяТабличнойЧасти);
	
	ПолеПроект 			   		= Элементы.Добавить(ИмяЭлемента,Тип("ПолеФормы"), ГруппаСоздаваемыхЭлементов);
	ПолеПроект.ПутьКДанным 		= ПутьКДаннымПроекта;
	ПолеПроект.Заголовок   		= НСтр("ru = 'Проект'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	ПолеПроект.Вид	       		= ВидПоляФормы.ПолеНадписи;
	ПолеПроект.Гиперссылка 		= Истина;
	ПолеПроект.ОтображатьВШапке = ОтображатьВШапке;
	ПолеПроект.Подсказка 		= Подсказка;
	
КонецПроцедуры

// Роль БазовыеПраваБСП дает право на изменение справочника "Пользователи",
// при этом в УНФ есть подписка "ПриЗаписиПользователей", по которой создается элемент справочника "Сотрудники".
// Роли, которые дают возможность изменения Сотрудников, дают очень много прав,
// поэтому определяем возможность редактирования след. образом.
//
Функция РазрешеноРедактированиеПользователя(ПользовательСсылка)
	
	МожемРедактировать = ПравоДоступа("Добавление", Метаданные.Справочники.Сотрудники);	
	МожемРедактировать = МожемРедактировать Или ЗначениеЗаполнено(ПользовательСсылка);
	
	Возврат МожемРедактировать;
	
КонецФункции

Процедура ИзменитьЭлементы_Пользователи_ФормаЭлемента(Форма, Отказ)
			
	Форма.Доступность = РазрешеноРедактированиеПользователя(Форма.Объект.Ссылка);
	
КонецПроцедуры

Процедура ИзменитьЭлементы_Пользователи_ФормаСписка(Форма, Отказ)
		
	МожемДобавлять = ПравоДоступа("Добавление", Метаданные.Справочники.Сотрудники);	
	
	Элементы = Форма.Элементы;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СоздатьПользователя", "Видимость", МожемДобавлять);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СоздатьГруппуПользователей", "Видимость", МожемДобавлять);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ФормаСкопировать", "Видимость", МожемДобавлять);
		
КонецПроцедуры

// Скопирована из упоИнтеграцияEPMСервер.ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаЭлемента
//
Процедура ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаЭлемента(Форма)
	
	ГруппаЛево = Форма.Элементы.ЛеваяКолонка;		
	ГруппаPM = ВставитьГруппуРеквизитыPM(Форма,  , Форма.Элементы.ГруппаКомментарий);
	
	упоРодитель = Форма.Элементы.Добавить("упоРодитель", Тип("ПолеФормы"), ГруппаЛево);
	упоРодитель.ПутьКДанным = "Объект.Родитель";
	упоРодитель.Вид = ВидПоляФормы.ПолеВвода;
	упоРодитель.КнопкаВыбора = Истина;
	
	Форма.Элементы.Переместить(упоРодитель, ГруппаЛево, Форма.Элементы.Наименование); 
	
	НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Контрагент", "Объект.Контрагент");
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НоваяСвязь);
	НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
	упоРодитель.СвязиПараметровВыбора = НовыеСвязи;
	
	ПодключитьОбработчикПриИзменении = Ложь;
	упоИнтеграцияEPMСервер.ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаДокумента_ДобавитьСтатус(Форма, ГруппаPM, ПодключитьОбработчикПриИзменении);
	
	упоСхемаОплаты = Форма.Элементы.Добавить("упоСхемаОплаты", Тип("ПолеФормы"), ГруппаPM);
	упоСхемаОплаты.ПутьКДанным = "Объект.упоСхемаОплаты";
	упоСхемаОплаты.Вид = ВидПоляФормы.ПолеВвода;
	упоСхемаОплаты.КнопкаВыбора = Истина;	
	
КонецПроцедуры	

Процедура ИзменитьЭлементы_ЗаказПоставщику_ФормаЭлемента(Форма, Отказ)
	
	ГруппаДополнительныеРеквизиты = Форма.Элементы.Найти("ГруппаДополнительныеРеквизиты");
	
	Если ГруппаДополнительныеРеквизиты <> Неопределено Тогда
		
		ДобавитьЭлементПроектНаФорму(Форма, ГруппаДополнительныеРеквизиты, "Объект.упоПроектнаяЗадача.упоКорневойПроект"); 	
		ДобавитьЭлементПроектнаяЗадачаНаФорму(Форма, ГруппаДополнительныеРеквизиты, "Объект.упоПроектнаяЗадача"); 

	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЭлементы_ПроектИПроектнаяЗадача_ФормаЭлемента(Форма, Отказ, НаименованиеГруппаРодитель)

	ГруппаРодитель = Форма.Элементы.Найти(НаименованиеГруппаРодитель);
	
	Если ГруппаРодитель <> Неопределено Тогда
		
		ДобавитьЭлементПроектНаФорму(Форма, ГруппаРодитель, "Объект.Проект.упоКорневойПроект"); 	
		ДобавитьЭлементПроектнаяЗадачаНаФорму(Форма, ГруппаРодитель, "Объект.Проект"); 

	КонецЕсли;	
	
КонецПроцедуры
 
Процедура ДобавитьЭлементПроектНаФорму(Форма, ГруппаРодитель, ПутьКДанным)

	ПолеПроект 				= Форма.Элементы.Добавить("упоПроект", Тип("ПолеФормы"), ГруппаРодитель);
	ПолеПроект.ПутьКДанным	= ПутьКДанным;
	ПолеПроект.Заголовок	= НСтр("ru = 'Проект'", ОбщегоНазначения.КодОсновногоЯзыка());
	ПолеПроект.Вид			= ВидПоляФормы.ПолеНадписи;
	ПолеПроект.Гиперссылка	= Истина;
	ПолеПроект.Ширина 		= 28; 
	
КонецПроцедуры

Процедура ДобавитьЭлементПроектнаяЗадачаНаФорму(Форма, ГруппаРодитель, ПутьКДанным)
	
	ПолеПроектнаяЗадача 			= Форма.Элементы.Добавить("упоПроектнаяЗадача", Тип("ПолеФормы"), ГруппаРодитель);
	ПолеПроектнаяЗадача.ПутьКДанным = ПутьКДанным; 
	ПолеПроектнаяЗадача.Заголовок	= НСтр("ru = 'Проектная задача'", ОбщегоНазначения.КодОсновногоЯзыка());		
	ПолеПроектнаяЗадача.Вид 		= ВидПоляФормы.ПолеВвода;
	ПолеПроектнаяЗадача.Ширина 		= 28;
	
КонецПроцедуры    

Процедура ДобавитьЭлементы_ПлатежныйКалендарь_ФормаОтчета(Форма, Отказ)
	
	Элементы = Форма.Элементы;
	
	ДобавляемыеРеквизиты = Новый Массив;	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("упоОтборПроект", Новый ОписаниеТипов("СправочникСсылка.Проекты"), ,
																											"Отбор проект"));	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("упоОтборПЗ", Новый ОписаниеТипов("СправочникСсылка.Проекты"), ,
																											"Отбор проектная задача"));		
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ГруппаРодитель = Элементы.Найти("ГруппаСтрокиЭлементы");
	
	Если ГруппаРодитель <> Неопределено Тогда         
		
		ЭлементОтображатьСтатью = Элементы.Найти("ОтображатьСтатью");
		
		Если ЭлементОтображатьСтатью = Неопределено Тогда
			НовыйЭлементФормы = Элементы.Добавить("упоОтображатьПроект", Тип("ПолеФормы"), ГруппаРодитель);		
		Иначе
			НовыйЭлементФормы = Элементы.Вставить("упоОтображатьПроект", Тип("ПолеФормы"), ГруппаРодитель, 
																						ЭлементОтображатьСтатью);
		КонецЕсли;
		
		НовыйЭлементФормы.ПутьКДанным = "Объект.упоОтображатьПроект"; 
		НовыйЭлементФормы.Заголовок	= НСтр("ru = 'Проект'", ОбщегоНазначения.КодОсновногоЯзыка());
		НовыйЭлементФормы.Вид 		= ВидПоляФормы.ПолеФлажка;
		НовыйЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право; 
		НовыйЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемые_упоОтображатьПроектПриИзменении");
		
		Если ЭлементОтображатьСтатью = Неопределено Тогда
			НовыйЭлементФормы = Элементы.Добавить("упоОтображатьПроектнуюЗадачу", Тип("ПолеФормы"), ГруппаРодитель);		
		Иначе
			НовыйЭлементФормы = Элементы.Вставить("упоОтображатьПроектнуюЗадачу", Тип("ПолеФормы"), ГруппаРодитель, 
																						ЭлементОтображатьСтатью);
		КонецЕсли;
		
		НовыйЭлементФормы.ПутьКДанным = "Объект.упоОтображатьПроектнуюЗадачу"; 
		НовыйЭлементФормы.Заголовок	= НСтр("ru = 'Проектная задача'", ОбщегоНазначения.КодОсновногоЯзыка());
		НовыйЭлементФормы.Вид 		= ВидПоляФормы.ПолеФлажка;
		НовыйЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право; 
		НовыйЭлементФормы.УстановитьДействие("ПриИзменении", "Подключаемые_упоОтображатьПроектнуюЗадачуПриИзменении");
		
		Элементы.Переместить(ЭлементОтображатьСтатью, ГруппаРодитель, Элементы.упоОтображатьПроект);
		
	КонецЕсли;
	
	ГруппаФильтры = Элементы.Найти("ГруппаФильтры");  
	
	Если ГруппаФильтры <> Неопределено Тогда
		
		ЭлементГруппаОтборСтатья = Элементы.Найти("ОтображатьСтатью");
		
		Если ЭлементГруппаОтборСтатья <> Неопределено Тогда
			НовыйЭлементГруппа = Элементы.Вставить("упоГруппаОтборПроекты", Тип("ГруппаФормы"), ГруппаФильтры, 
																					Элементы.ГруппаОтборСтатья);
		Иначе
			НовыйЭлементГруппа = Элементы.Добавить("упоГруппаОтборПроекты", Тип("ГруппаФормы"), ГруппаФильтры);
		КонецЕсли;
		
