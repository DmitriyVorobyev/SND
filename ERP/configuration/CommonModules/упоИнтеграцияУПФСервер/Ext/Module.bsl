			НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеФлажка;
			НовыйЭлементФормы.ВидФлажка = ВидФлажка.Выключатель;
			НовыйЭлементФормы.Заголовок	= НСтр("ru = 'Отражать иерархию и статус'", ОбщегоНазначения.КодОсновногоЯзыка());
