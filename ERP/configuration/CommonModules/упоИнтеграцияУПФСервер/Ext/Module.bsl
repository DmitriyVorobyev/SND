#Область ПрограммныйИнтерфейс

#Область СобытияФорм

// См. ПодключаемыеКоманды.ПриСозданииНаСервере
//
Процедура ПодключаемыеКомандыПриСозданииНаСервере(Форма, ПараметрыРазмещения) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьЭлементыПроектаВФорму(Форма);
	ЗаполнитьЗаказ(Форма);
	
КонецПроцедуры

// См. МодификацияКонфигурацииПереопределяемый.ПриСозданииНаСервере
//
Процедура ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	СостИмени = упоФункцииОбщегоНазначенияКлиентСервер.СоставИмениФормы(Форма.ИмяФормы);
	ИмяТипаМетаданных = СостИмени.ТипМетаданных;
	
	Если ИмяТипаМетаданных = "Документ" Тогда
		
		ПриСозданииНаСервере_Документы(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "Справочник" Тогда
		
		ПриСозданииНаСервере_Справочники(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "ПланСчетов" Тогда
		
		ПриСозданииНаСервере_ПланыСчетов(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "Отчет" Тогда
		
		ПриСозданииНаСервере_Отчеты(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "Обработка" Тогда
		
		ПриСозданииНаСервере_Обработки(СостИмени.ВидМетаданных, СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	ИначеЕсли ИмяТипаМетаданных = "ОбщаяФорма" Тогда
		
		ПриСозданииНаСервере_ОбщиеФормы(СостИмени.ИмяФормы, Форма, Отказ, СтандартнаяОбработка);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиПодписок

// Обработчик события, вызываемый при записи класификатора единиц измерения.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево - признак отказа от выполнения обработки.
//
Процедура КлассификаторЕдиницИзмеренияПриЗаписи(Источник, Отказ) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ИспользуетсяСинхронизацияЕдиницИзмерения() Тогда
		Возврат;
	КонецЕсли;
	
	Упаковка = УпаковкаЕдИзмСвязаннаяСКлассификаторомЕдИзм(Источник.Ссылка);
	
	НужноСоздаватьСоответствиеЕдИзм = Ложь;
	Если ЗначениеЗаполнено(Упаковка) Тогда
		УпаковкаОбъект = Упаковка.ПолучитьОбъект();	
	Иначе;
		НужноСоздаватьСоответствиеЕдИзм = Истина;
		УпаковкаОбъект = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
	КонецЕсли;
	
	УпаковкаОбъект.Наименование = Источник.Наименование;	
	УпаковкаОбъект.Код = Источник.Код;
	УпаковкаОбъект.ПометкаУдаления = Источник.ПометкаУдаления;
	УпаковкаОбъект.Записать();
	
	Если Не НужноСоздаватьСоответствиеЕдИзм Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.упоСоответствиеКлассификаторовЕдИзмИУпаковокЕдИзм.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.КлассификаторЕдИзм = Источник.Ссылка;
	МенеджерЗаписи.Упаковка = УпаковкаОбъект.Ссылка;
	МенеджерЗаписи.Записать();
			
КонецПроцедуры

// Обработчик события, вызываемый перед записью договора контрагента.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево - признак отказа от выполнения обработки.
//
Процедура ДоговорыКонтрагентовПередЗаписью(Источник, Отказ) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Источник.Контрагент = Источник.Владелец;
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, вызываемый при записи ставки НДС.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево - признак отказа от выполнения обработки.
//
Процедура СтавкаНДСПриЗаписи(Источник, Отказ) Экспорт
	
	Если Не упоИнтеграцияКлиентСервер.ИспользуетсяСинхронизацияСтавокНДС() Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.упоСоответствиеСтавкиНДС.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.СтавкаСправочник = Источник.Ссылка;
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		
		ПеречислениеНДС = ПеречислениеНДСПоСправочникуНДС(Источник.Ссылка);			
		
		Если ЗначениеЗаполнено(ПеречислениеНДС) Тогда
			МенеджерЗаписи.СтавкаПеречисление = ПеречислениеНДС;			
			МенеджерЗаписи.Записать();
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события, вызываемый при записи пользователя.
//
// Параметры:
//  Источник - Произвольный - источник события.
//  Отказ	 - Булево - признак отказа от выполнения обработки.
//
Процедура упоПользователиПередЗаписью(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	РазрешеноРедактирование = РазрешеноРедактированиеПользователя(Источник.Ссылка);
	
	Отказ = Не РазрешеноРедактирование;
	
КонецПроцедуры

// Обработчик события заполнения заказа поставщику.
//
// Параметры:
//  Источник			 - Произвольный
//  ДанныеЗаполнения	 - Произвольный
//  ТекстЗаполнения		 - Строка
//  СтандартнаяОбработка - Булево
//
Процедура упоОбработкаЗаполненияЗаказаПоставщикуУПФОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения,
		СтандартнаяОбработка) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	ТипДанныхЗаполнения = ТипЗнч(ДанныеЗаполнения);
	Если ДанныеЗаполнения = Неопределено Или ТипДанныхЗаполнения <> упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат;
	КонецЕсли;
	
	ПроектЗаказаПокупателя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения, "Проект", Истина);
	
	Источник.упоПроектнаяЗадача = ПроектЗаказаПокупателя;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОбновления

// Осуществляет заполнение пустой информационной базы.
//
// Параметры:
//  Параметры - Произвольный - параметры.
//
Процедура НачальноеЗаполнение(Параметры = Неопределено) Экспорт
	
	упоИнтеграция.СинхронизироватьВсеСтатьиДР();
	ЗаполнитьНеобходимыеРеквизитыПроектовУНФ();
	СинхронизироватьКлассификаторЕдИзмИУпаковкиЕдИзм();
	ЗаполнитьРеквизитКонтрагентВДоговорах();
	СинхронизироватьСтавкиНДС();
	ЗаполнитьВидРесурсаВНоменклатуре();
	ВключитьИспользованиеПодсистемыУчетПоПроектамУНФ();
	ЗаполнитьНаправлениеДвиженияВПредопределенныхСтатьяхДДС();
	ВключитьИспользованиеПодсистемыРаботы();
	
КонецПроцедуры

// Обработчик обновления, который выполняет заполнение реквизитов Компонент и ТекущаяВерсия проектов,
// которые были созданы до подключения подсистемы РМ.
//
Процедура ЗаполнитьНеобходимыеРеквизитыПроектовУНФ() Экспорт
	
	ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	Если Не ЭтоУПФ Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Проекты КАК Проекты
	|ГДЕ
	|	НЕ Проекты.ЭтоПроектнаяЗадача
	|	И Проекты.Компонент = &Компонент";
	
	ПустаяСсылкаКомпонента = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоКомпоненты.ПустаяСсылка");
	
	Запрос.УстановитьПараметр("Компонент", ПустаяСсылкаКомпонента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	КомпонентПроект = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоКомпоненты.Проект");
	
	Пока Выборка.Следующий() Цикл
		
		ПроектОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПроектОбъект.Компонент = Перечисления.упоКомпоненты.Проект;
		ПроектОбъект.ТекущаяВерсия = Истина;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПроектОбъект);
		
	КонецЦикла;
	
КонецПроцедуры

// Обработчик обновления, который создает по классификатору единиц измерения упаковки единиц измерения.
//
Процедура СинхронизироватьКлассификаторЕдИзмИУпаковкиЕдИзм() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлассификаторЕдиницИзмерения.Код КАК Код,
	|	КлассификаторЕдиницИзмерения.Наименование КАК Наименование,
	|	КлассификаторЕдиницИзмерения.ПометкаУдаления КАК ПометкаУдаления,
	|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Отказ = Ложь;
	Пока Выборка.Следующий() Цикл
		
		КлассификаторЕдиницИзмеренияПриЗаписи(Выборка, Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

// Обработчик обновления, который перезаписывает договора контрагентов для заполнения реквизита "Контрагент".
//
Процедура ЗаполнитьРеквизитКонтрагентВДоговорах() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	               |ГДЕ
	               |	ДоговорыКонтрагентов.Контрагент = &Контрагент";
	
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ДоговорОбъект = Выборка.Ссылка.ПолучитьОбъект();		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДоговорОбъект);
	КонецЦикла;	
	
КонецПроцедуры	

// Обработчик обновления, который сопоставляет значения справочника СтавкиНДС значениям перечисления СтавкиНДС.
//
Процедура СинхронизироватьСтавкиНДС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСоответствиеСтавкиНДС.СтавкаСправочник КАК СтавкаСправочник
	               |ПОМЕСТИТЬ СинхронизированныеСтавки
	               |ИЗ
	               |	РегистрСведений.упоСоответствиеСтавкиНДС КАК упоСоответствиеСтавкиНДС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СтавкиНДС.Ссылка КАК Ссылка,
	               |	СтавкиНДС.Ставка КАК Ставка,
	               |	СтавкиНДС.Расчетная КАК Расчетная,
	               |	СтавкиНДС.ВидСтавкиНДС КАК ВидСтавкиНДС
	               |ИЗ
	               |	Справочник.СтавкиНДС КАК СтавкиНДС
	               |ГДЕ
	               |	НЕ СтавкиНДС.Ссылка В
	               |				(ВЫБРАТЬ
	               |					СинхронизированныеСтавки.СтавкаСправочник
	               |				ИЗ
	               |					СинхронизированныеСтавки)";
	
	Результат = Запрос.Выполнить();	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();	
	Пока Выборка.Следующий() Цикл
		
		ПеречислениеНДС = ПеречислениеНДСПоСправочникуНДС(Выборка.Ссылка);
				
		Если ЗначениеЗаполнено(ПеречислениеНДС) Тогда
			
			НЗ = РегистрыСведений.упоСоответствиеСтавкиНДС.СоздатьНаборЗаписей();
			НЗ.Отбор.СтавкаСправочник.Установить(Выборка.Ссылка);
			НЗ.Прочитать();
			Запись = НЗ.Добавить();
			Запись.СтавкаСправочник 	= Выборка.Ссылка;
			Запись.СтавкаПеречисление 	= ПеречислениеНДС;					
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НЗ);		
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Обработчик обновления, который заполняет реквизит упоВидРесурса в справончике Номенклатура.
//
Процедура ЗаполнитьВидРесурсаВНоменклатуре() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.упоВидРесурса = ЗНАЧЕНИЕ(Перечисление.упоВидРесурса.ПустаяСсылка)
	               |	И НЕ Номенклатура.ЭтоГруппа";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.упоВидРесурса = Перечисления.упоВидРесурса.Материальный;
		Объект.упоВидМатериальногоРесурса = Перечисления.упоВидМатериальногоРесурса.Материал;
					
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
		
	КонецЦикла;
	
КонецПроцедуры

// Обработчик обновления, который включает использование "Учета по проектам" в УНФ.
//
Процедура ВключитьИспользованиеПодсистемыУчетПоПроектамУНФ() Экспорт
	
	МенеджерЗначенияКонстанты = Константы.ФункциональнаяОпцияУчетПоПроектам.СоздатьМенеджерЗначения();
	МенеджерЗначенияКонстанты.Значение = Истина;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(МенеджерЗначенияКонстанты);		
	
КонецПроцедуры

// Обработчик обновления, который включает использование подсистемы Работы в УНФ.
//
Процедура ВключитьИспользованиеПодсистемыРаботы() Экспорт
	
	МенеджерЗначенияКонстанты = Константы["ФункциональнаяОпцияИспользоватьПодсистемуРаботы"].СоздатьМенеджерЗначения();
	МенеджерЗначенияКонстанты.Значение = Истина;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(МенеджерЗначенияКонстанты);
	
КонецПроцедуры

// Обработчик обновления заполняющий реквизит упоНаправлениеДвижения
// в предопределнных статьях СтатьиДвиженияДенежныхСредств
//
Процедура ЗаполнитьНаправлениеДвиженияВПредопределенныхСтатьяхДДС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка КАК Ссылка,
	|	ИСТИНА КАК ЭтоВыплаты
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.Родитель = &ОперационныеПлатежи
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка,
	|	ИСТИНА
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.Родитель = &ФинансовыеПлатежи
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка,
	|	ИСТИНА
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.Родитель = &ИнвестиционныеПлатежи
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка,
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.Родитель = &ОперационныеПоступления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка,
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.Родитель = &ФинансовыеПоступления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтатьиДвиженияДенежныхСредств.Ссылка,
	|	ЛОЖЬ
	|ИЗ
	|	Справочник.СтатьиДвиженияДенежныхСредств КАК СтатьиДвиженияДенежныхСредств
	|ГДЕ
	|	СтатьиДвиженияДенежныхСредств.Родитель = &ИнвестиционныеПоступления";
	
	Запрос.УстановитьПараметр("ИнвестиционныеПлатежи", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ИнвестиционныеПлатежи"));
	Запрос.УстановитьПараметр("ОперационныеПлатежи", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ОперационныеПлатежи"));
	Запрос.УстановитьПараметр("ФинансовыеПлатежи", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ФинансовыеПлатежи"));
	Запрос.УстановитьПараметр("ОперационныеПоступления", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ОперационныеПоступления"));
	Запрос.УстановитьПараметр("ФинансовыеПоступления", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ФинансовыеПоступления"));
	Запрос.УстановитьПараметр("ИнвестиционныеПоступления", 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Справочник.СтатьиДвиженияДенежныхСредств.ИнвестиционныеПоступления"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выплата = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата;
	Поступление = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление;
	
	Пока Выборка.Следующий() Цикл
		
		СтатьяОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Если Выборка.ЭтоВыплаты Тогда
			СтатьяОбъект.упоНаправлениеДвижения = Выплата;	
		Иначе
			СтатьяОбъект.упоНаправлениеДвижения = Поступление;
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(СтатьяОбъект);
		
	КонецЦикла;		
	
КонецПроцедуры

#КонецОбласти

#Область СчетаУчета

// Изменяет элементы формы выбора плана счетов "Управленческий".
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма выбора плана счетов "Управленческий"
//
Процедура ИзменитьЭлементы_ПланСчета_Управленческий_ФормаВыбора(Форма) Экспорт

	// Добавим реквизит на форму для последующего определения выбранного значения в событии выбора статьи.
	ИмяРеквизита = упоИнтеграцияУПФКлиентСервер.ИмяРеквизитаДляОпределенияВыбораСвязанойСтатьи();
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Булево"));	
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Если Форма.Параметры.Свойство(ИмяРеквизита) Тогда
		
		// Установим действие выбор у элемента "Список"
		Элементы = Форма.Элементы;
		ЭлементСписок = Элементы.Найти("Список");
		
		Если ЭлементСписок <> Неопределено Тогда

			ЭлементСписок.УстановитьДействие("Выбор", "Подключаемый_упоСписокВыбор");
			Форма[ИмяРеквизита] = Истина;

			ОтборПоСчетамСУказаннойСтатьейДоходовРасходов = Ложь;
			// Если требуется дать возможность выбора только такого элемента плана счетов, у которого есть соответствие со статьей доходов/расходов,
			// необходимо установить отбор дин. списка, отсеивающий элементы, не имеющие такого соотвествия. 
			Если ОтборПоСчетамСУказаннойСтатьейДоходовРасходов Тогда
				ДинамическийСписокФормы = Форма[ЭлементСписок.ПутьКДанным];
				ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ СтатьяИнтеграция ИЗ РегистрСведений.упоСоответствиеСтатейДР";
				ДопустимыеЭлементы = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса).Выгрузить().ВыгрузитьКолонку(0);
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДинамическийСписокФормы,
					"Ссылка",
					ДопустимыеЭлементы,
					ВидСравненияКомпоновкиДанных.ВСписке,
					НСтр("ru = 'Выводить только счета, для которых задано соотвествие со статьями доходов/расходов PM'"),
					Истина,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
			КонецЕсли;	
				
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры	
	
// Возвращает структуру счетов учета, необходимых для создания напрвления деятельности на основании проектной задачи.
//
// Возвращаемое значение:
//  Структура - Счета учета.
//  	* СчетУчетаВыручкиОтПродаж - ПланСчетовСсылка.Управленческий
//  	* СчетУчетаСебестоимостиПродаж - ПланСчетовСсылка.Управленческий
//		* СчетУчетаПрибыли - ПланСчетовСсылка.Управленческий
//
Функция СчетаУчетаНаправленияДеятельностиУПФПоУмолчанию() Экспорт
	
	СчетаУчетаПоУмолчанию = Новый Структура;
	СчетУчетаВыручкиОтПродаж = ОбщегоНазначения.ПредопределенныйЭлемент("ПланСчетов.Управленческий.ВыручкаОтПродаж");
	СчетаУчетаПоУмолчанию.Вставить("СчетУчетаВыручкиОтПродаж", СчетУчетаВыручкиОтПродаж);
	СчетУчетаСебестоимостиПродаж = 
		ОбщегоНазначения.ПредопределенныйЭлемент("ПланСчетов.Управленческий.СебестоимостьПродаж");
	СчетаУчетаПоУмолчанию.Вставить("СчетУчетаСебестоимостиПродаж", СчетУчетаСебестоимостиПродаж); 
	СчетУчетаПрибыли =
		ОбщегоНазначения.ПредопределенныйЭлемент("ПланСчетов.Управленческий.ПрибылиИУбыткиБезНалогаНаПрибыль");
	СчетаУчетаПоУмолчанию.Вставить("СчетУчетаПрибыли", СчетУчетаПрибыли);
	
	Возврат СчетаУчетаПоУмолчанию;
	
КонецФункции

// Синхронизирует счет учета со статьей доходов/затрат
//
// Параметры:
//  Счет - ПланСчетовСсылка.Управленческий - синхронизируемый счет.
//  ТипСчетаДляГруппы - ПеречислениеСсылка.ТипыСчетов - тип счета группа счетов
//
// Возвращаемое значение:
//  СправочникСсылка.упоСтатьиДоходов, СправочникСсылка.упоСтатьиЗатрат, Неопределено - 
//
Функция СоздатьСвязатьСтатьюДР_изУНФвPM(Счет, ТипСчетаДляГруппы) Экспорт
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ДопИнформацияОСтатьеУПО = Неопределено;
	обСтатьяУПО = Неопределено;
	НужноЗаписатьСвязь = Ложь;
		
	Если Счет.ТипСчета <> 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыСчетов.ГруппаСчетов") Тогда
		ТипСчетаДляГруппы = Счет.ТипСчета;
	КонецЕсли;
	
	ТипыСчетовВДоходы = ПредопределенныеЗначенияТиповСчетов_Доходы();
	ТипыСчетовВЗатраты = ПредопределенныеЗначенияТиповСчетов_Затраты();
	
	Если Счет.ТипСчета = 
		упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыСчетов.ГруппаСчетов") 
		И ТипСчетаДляГруппы <> Неопределено Тогда
	
		СправочникМенеджерУПО = СправочникМенеджерПоТипуСчета(ТипСчетаДляГруппы, ТипыСчетовВДоходы, ТипыСчетовВЗатраты);	
		
	Иначе 
		
		СправочникМенеджерУПО = СправочникМенеджерПоТипуСчета(Счет.ТипСчета, ТипыСчетовВДоходы, ТипыСчетовВЗатраты);
		
	КонецЕсли;
	
	Если СправочникМенеджерУПО = Неопределено Тогда
		Возврат Неопределено;		
	КонецЕсли; 
	
	ЭлементРодитель = СправочникМенеджерУПО.ПустаяСсылка();			
	
	РеквизитыСчетУНФ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Счет, "Наименование, ПометкаУдаления, Родитель");
	РодительСТипомГруппаСчетов = РодительСТипомГруппаСчетов(Счет, СправочникМенеджерУПО); 
	
	Если ЗначениеЗаполнено(РеквизитыСчетУНФ.Родитель) Тогда		
		
		ЭлементРодитель = СоздатьСвязатьСтатьюДР_изУНФвPM(РодительСТипомГруппаСчетов, ТипСчетаДляГруппы);
		
	КонецЕсли;	
	
	СтатьяУПО = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Счет, ДопИнформацияОСтатьеУПО);	
	
	Если Не ЗначениеЗаполнено(СтатьяУПО) Тогда
		
		НужноЗаписатьСвязь 	= Истина;

		Если Счет.ТипСчета = 
				упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыСчетов.ГруппаСчетов") Тогда  
			
			обСтатьяУПО = СправочникМенеджерУПО.СоздатьГруппу();
			
		Иначе
			
			обСтатьяУПО = СправочникМенеджерУПО.СоздатьЭлемент();
			
		КонецЕсли;
		
	Иначе
		
		ДлинаНаименованияУПО = СтатьяУПО.Метаданные().ДлинаНаименования;
		
		Если ДопИнформацияОСтатьеУПО.Наименование <> Лев(РеквизитыСчетУНФ.Наименование, ДлинаНаименованияУПО) 
			ИЛИ ДопИнформацияОСтатьеУПО.ПометкаУдаления <> РеквизитыСчетУНФ.ПометкаУдаления 
			ИЛИ  ДопИнформацияОСтатьеУПО.Родитель <> ЭлементРодитель Тогда
			
			обСтатьяУПО = СтатьяУПО.ПолучитьОбъект();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если обСтатьяУПО <> Неопределено Тогда
		
		обСтатьяУПО.ДополнительныеСвойства.Вставить("НеСинхронизироватьСтатьиДР", Истина);
		обСтатьяУПО.Наименование = РеквизитыСчетУНФ.Наименование;
		обСтатьяУПО.ПометкаУдаления = РеквизитыСчетУНФ.ПометкаУдаления;	 
		обСтатьяУПО.Родитель = ЭлементРодитель;
		обСтатьяУПО.Записать();
		СтатьяУПО = обСтатьяУПО.Ссылка;
		
	КонецЕсли;
	
	Если НужноЗаписатьСвязь Тогда
		
		Запись = РегистрыСведений.упоСоответствиеСтатейДР.СоздатьМенеджерЗаписи();
		Запись.СтатьяИнтеграция = Счет;
		Запись.СтатьяУПО = СтатьяУПО;
		Запись.Записать();
		
	КонецЕсли;
	
	Возврат СтатьяУПО;	
	
КонецФункции

// Возвращает предопределенный список типов счет доходов или расходов
//
// Параметры:
//  ЭтоСтатьяДоходов - Булево - Признак того, что возвращаем типы статей доходов.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ТипыСчетов - 
//
Функция ТипыСчетовДоходыРасходы(ЭтоСтатьяДоходов) Экспорт
	
	Если ЭтоСтатьяДоходов Тогда
		ТипыСчетов = ПредопределенныеЗначенияТиповСчетов_Доходы();			
	Иначе
		ТипыСчетов = ПредопределенныеЗначенияТиповСчетов_Затраты();	
	КонецЕсли;

	// Удалим из типов счетов тип Группа счетов
	ЭлементГруппаСчетов = ТипыСчетов.Найти(упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ТипыСчетов.ГруппаСчетов"));
	Если ЭлементГруппаСчетов <> Неопределено Тогда
		ТипыСчетов.Удалить(ЭлементГруппаСчетов);	
	КонецЕсли;
	
	Возврат ТипыСчетов;
	
КонецФункции	

// Получает типы счетов в зависимости от признака доходной/расходной статьи и заворачивает в структуру данных 
// для использования в параметрах отбора динамического списка.
//
// Параметры:
//  ЭтоСтатьяДоходов - Булево - признак доходной/расходной статьи.
// 
// Возвращаемое значение:
//  Структура - фиксированный массив в структуре для использования в параметрах отборов динамического списка.
//
Функция ТипыСчетовДоходыРасходы_ДляОтбора(ЭтоСтатьяДоходов) Экспорт
	
	ТипыСчетов = ТипыСчетовДоходыРасходы(ЭтоСтатьяДоходов);
	
	ТипыСчетов = Новый ФиксированныйМассив(ТипыСчетов);
	ОтборПоТипуСчетов = Новый Структура("ТипСчета", ТипыСчетов);
	
	Возврат ОтборПоТипуСчетов;
	
КонецФункции
	
#КонецОбласти

#Область СинхронизацияЕдиницИзмерения

// Возвращает упаковку единиц измерения связанную с классификатором единиц измерения,
// если связанную упаковку найти не удалось, то возращает пустую ссылку на справочник УпаковкиЕдиницыИзмерения.
//
// Параметры:
//  КлассификаторЕдиницИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения 
//
// Возвращаемое значение:
//	- СправочникСсылка.УпаковкиЕдиницыИзмерения 
//	
Функция УпаковкаЕдИзмСвязаннаяСКлассификаторомЕдИзм(КлассификаторЕдиницИзмерения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСоответствиеКлассификаторовЕдИзмИУпаковокЕдИзм.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.упоСоответствиеКлассификаторовЕдИзмИУпаковокЕдИзм КАК упоСоответствиеКлассификаторовЕдИзмИУпаковокЕдИзм
	|ГДЕ
	|	упоСоответствиеКлассификаторовЕдИзмИУпаковокЕдИзм.КлассификаторЕдИзм = &КлассификаторЕдИзм";
	
	Запрос.УстановитьПараметр("КлассификаторЕдИзм", КлассификаторЕдиницИзмерения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка");
	КонецЕсли;	
		
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Упаковка;
	
КонецФункции

#КонецОбласти

#Область ПользовательскиеНастройки

// Устанавливает настройки интерфейса пользователя.
//
// Параметры:
//  НачальныеНастройки	 - Структура
//  СохранятьНастройки	 - Булево
//  ИмяПользователя		 - Строка, Неопределено
//
Процедура ПриУстановкеНачальныхНастроек(НачальныеНастройки, СохранятьНастройки = Ложь, ИмяПользователя = Неопределено) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиСостава = Новый НастройкиСоставаИнтерфейсаКлиентскогоПриложения;
	
	НастройкиСостава.Верх.Очистить();
	НастройкиСостава.Лево.Очистить();
	НастройкиСостава.Низ.Очистить();
	НастройкиСостава.Право.Очистить();
	
	ПанельРазделов = Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельРазделов");
	ПанельОткрытых = Новый ЭлементНастройкиСоставаИнтерфейсаКлиентскогоПриложения("ПанельОткрытых");
	
	НастройкиСостава.Верх.Добавить(ПанельОткрытых);
	НастройкиСостава.Лево.Добавить(ПанельРазделов);
	
	Если СохранятьНастройки Тогда
		Настройки = Новый НастройкиИнтерфейсаКлиентскогоПриложения;
		Настройки.УстановитьСостав(НастройкиСостава);
		ХранилищеСистемныхНастроек.Сохранить("Общее/НастройкиИнтерфейсаКлиентскогоПриложения",
			"", Настройки, , ИмяПользователя);
	Иначе
		НачальныеНастройки.НастройкиТакси.УстановитьСостав(НастройкиСостава);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Изменяет связи параметров выбора у элементов формы справочника Проекты
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма элемента справочника Проекты
//
Процедура ИзменитьСвязиПараметровВыбораУЭлементовДоговоровКонтрагентов(Форма) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат	
	КонецЕсли;	
	
	Элементы = Форма.Элементы;
	   
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ДоговорДоходов");
	ИменаЭлементов.Добавить("ДоговорЗатрат");
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		НовыеСвязиПарВыбора = Новый Массив;
		Элемент = Элементы[ИмяЭлемента];
		Для Каждого СвязьПараметровВыбора Из Элемент.СвязиПараметровВыбора Цикл
			Если СвязьПараметровВыбора.Имя <> "Отбор.Организация" Тогда
				НовыеСвязиПарВыбора.Добавить(СвязьПараметровВыбора);
			КонецЕсли;			
		КонецЦикла;
		Элемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыеСвязиПарВыбора);
	КонецЦикла;	
	
КонецПроцедуры

// Добавляет отбор по типу структурной единицы в Параметры.
//
// Параметры:
//  Параметры - Структура - Параметры формы.
//
Процедура ДобавитьВПараметрыОтборПоТипуСтруктурнойЕдиницы(Параметры) Экспорт	
	
	Если Не Параметры.Свойство("Отбор") Тогда
		Параметры.Вставить("Отбор", Новый Структура);	
	КонецЕсли;
	ТипПодразделение = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ТипыСтруктурныхЕдиниц.Подразделение");
	Параметры.Отбор.Вставить("ТипСтруктурнойЕдиницы", ТипПодразделение);	
	Параметры.Вставить("РежимОтображения", 1);

КонецПроцедуры

#Область ЗаполнениеЗаказа

// Получает данные для создания заказов
//
// Параметры:
//	ПроектнаяЗадача - ДокументСсылка.упоПроектнаяЗадача
//	ВидДокумента - Строка
//
// Возвращаемое значение:
//	Структура - Данные для заполнения заказов
//
Функция ПолучитьДанныеДляЗаполненияЗаказов(ПроектнаяЗадача, ВидДокумента) Экспорт
	
	ПараметрыСозданияЗаказов = ПолучитьПараметрыСозданияПоВидуЗаказа(ВидДокумента);
	
	ПараметрыСозданияЗаказов = ДополнитьРеквизитамиШапкиПоУмолчанию(ПроектнаяЗадача, ПараметрыСозданияЗаказов);
	
	ПакетРезультатов = ПолучитьДанныеИзПроектнойЗадачи(ПроектнаяЗадача, ПараметрыСозданияЗаказов);	
	ДанныеЗаказов = ПолучитьДанныеЗаказовИзВыборки(ПакетРезультатов, ПроектнаяЗадача, ПараметрыСозданияЗаказов);
	
	ВозвращаемыеДанные = Новый Структура;	
	ВозвращаемыеДанные.Вставить("ПараметрыСозданияЗаказов", ПараметрыСозданияЗаказов);
	ВозвращаемыеДанные.Вставить("ДанныеЗаказов", ДанныеЗаказов);
	
	Возврат ВозвращаемыеДанные;	
	
КонецФункции

#КонецОбласти

// Выполняет действия согласно наименованию.
//
// Параметры:
//  ДокументОбъект		 - ДокументОбъект
//  ДокументОснование	 - Структура, ДокументОбъект, ДокументСсылка
//
Процедура ЗаполнитьПроектПоДокументуОснованию(ДокументОбъект, ДокументОснование) Экспорт
	
	Если ДокументОснование <> Неопределено 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОснование, "Проект") Тогда
		ДокументОбъект.Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование,"Проект");
	КонецЕсли

КонецПроцедуры

// Устанавливает видимость созданных на форме групп отображающих проектные задачи
//
// Параметры:
//   Форма - ФормаКлиентскогоПриложения - Произвольная форма
//
Процедура УстановитьВидимостьОтПользовательскихНастроек(Форма) Экспорт
		
	Элементы = Форма.Элементы;
	
	ИмяГруппы = упоИнтеграцияУПФКлиентСервер.ИмяСоздаваемойГруппыДляНастройкиВидимостиЭлементов(); 
	
	МассивТаблицФормы = ТаблицыФормыСодержащиеПроект(Форма);
	
	ВидимостьГрупп = ОпределитьВидимостьГрупп(Форма);
	
	ЭтоПоложениеВТабличнойЧасти = Форма.Объект.ПоложениеПроекта = 
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти"); 
		
	Элементы[ИмяГруппы].Видимость = ВидимостьГрупп И Не ЭтоПоложениеВТабличнойЧасти;
	
	Для Каждого ТаблицаФормы Из МассивТаблицФормы Цикл   
		ИмяГруппыСПроектом = упоИнтеграцияУПФКлиентСервер.ИмяГруппыТЧПоИмениТЧ(ТаблицаФормы.Имя);
		Элементы[ИмяГруппыСПроектом].Видимость = ВидимостьГрупп И ЭтоПоложениеВТабличнойЧасти;
	КонецЦикла;
		
КонецПроцедуры

