			НовыйЭлементФормы.ВидФлажка = ВидФлажка.Выключатель;
			НовыйЭлементФормы.Заголовок	= НСтр("ru = 'Отражать данные по проекту'", ОбщегоНазначения.КодОсновногоЯзыка());
