Функция СтрокаИерархииПЗ(Выборка, ТекущаяПроектнаяЗадача) Экспорт 
	
	МаксУровеньИерархииВВыборке = 1;
	Иерархия = Новый Массив;
	
	// Получаем максимальный предусмотренный в запросе уровень иерархии
	Пока Истина Цикл
		ТекУровень = МаксУровеньИерархииВВыборке + 1;	
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка, "упоПроектнаяЗадачаРодитель" + ТекУровень) Тогда
			МаксУровеньИерархииВВыборке = ТекУровень;
		Иначе
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	
	Если ЗначениеЗаполнено(Выборка["упоПроектнаяЗадачаРодитель" + МаксУровеньИерархииВВыборке]) Тогда
		// Заполнен максимально предусмотренный уровень иерархии в выборке, вероятно иерархия еще глубже.
		// Требуется построить полную иерархию ПЗ
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Представление(Проекты.Ссылка) КАК ПредставлениеПЗ
		|ИЗ
		|	Справочник.Проекты КАК Проекты
		|ГДЕ
		|	Проекты.Ссылка = &ТекущаяПроектнаяЗадача
		|ИТОГИ ПО
		|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
		
		Запрос.УстановитьПараметр("ТекущаяПроектнаяЗадача", ТекущаяПроектнаяЗадача);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.Прямой);
		
		НомерСтрокиВыборки = 1;
				
		Пока ВыборкаСсылка.Следующий() Цикл
			
			// Первый элемент выборки - сам проект, его не нужно включать в иерархию.
			// Последний элемент выборки - сама текущая проектная задача. Она тоже не нужна в иерархии.
			Если НомерСтрокиВыборки = 1  ИЛИ
				НомерСтрокиВыборки = ВыборкаСсылка.Количество() Тогда
				НомерСтрокиВыборки = НомерСтрокиВыборки + 1;
				Продолжить;
			КонецЕсли;	
			
			// Строка иерархии будет построена "снизу-вверх" (т.е. сначала идет ПЗ самого нижнего уровня иерархии, затем более высокого и т.д.,
			// а выборку иерархии обходим в прямом порядке, т.е. "сверху-вниз" - заполняем массив "Иерархия" по методу LIFO (новый элемент вставляется в начало массива)
			Иерархия.Вставить(0, ВыборкаСсылка.ПредставлениеПЗ);
						
			НомерСтрокиВыборки = НомерСтрокиВыборки + 1;
			
		КонецЦикла;
		
		
	Иначе
		
		Для ТекУровень = 1 По МаксУровеньИерархииВВыборке Цикл
			
			УровеньИерархииВыборки = Выборка["упоПроектнаяЗадачаРодитель" + ТекУровень];
			
			Если НЕ ЗначениеЗаполнено (УровеньИерархииВыборки) Тогда
				Прервать;
			КонецЕсли;
						
			ЭтоПроектнаяЗадача = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УровеньИерархииВыборки, "ЭтоПроектнаяЗадача");
			
			// Если родитель ПЗ - Проект, значит получен самый верхний уровень иерархии.
			Если НЕ ЭтоПроектнаяЗадача Тогда
				Прервать;
			КонецЕсли;
			
			ПредставлениеПЗ = Строка(УровеньИерархииВыборки);
			Иерархия.Добавить(ПредставлениеПЗ);
		
		КонецЦикла;
		
	КонецЕсли;
	
	СтрокаИерархии = "";
	
	// Заполнение строки иерархии. 
	// Массив "Иерархия"  заранее сформирован таким образом, что чем больше индекс элемента - тем "выше" по уровню иерархии находится ПЗ
	ЭтоПервыйЭлемент = Истина;
	Для каждого ЭлементИерархии Из Иерархия Цикл
		
		Если ЭтоПервыйЭлемент Тогда
			ЭтоПервыйЭлемент = Ложь;
			СтрокаИерархии = СтрокаИерархии + ЭлементИерархии;
			Продолжить;
		КонецЕсли;	
		
		СтрокаИерархии = СтрокаИерархии + " / " + ЭлементИерархии ;

	КонецЦикла;

	Возврат СтрокаИерархии;

КонецФункции 

Функция ЗаказыДляПерезаполненияПоПроектнойЗадаче(ПроектнаяЗадача) Экспорт 
	
	ЗаказыДляПерезаполнения = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПоставщикуПлатежныйКалендарь.ДатаОплаты КАК Дата,
		|	ЗаказПоставщикуПлатежныйКалендарь.СуммаОплаты КАК Сумма,
		|	ЗаказПоставщикуПлатежныйКалендарь.Ссылка.Контрагент КАК Контрагент,
		|	ЗаказПоставщикуПлатежныйКалендарь.Ссылка.Договор КАК Договор,
		|	ЗаказПоставщикуПлатежныйКалендарь.Ссылка КАК Ссылка,
		|	ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата) КАК НаправлениеДвижения
		|ИЗ
		|	Документ.ЗаказПоставщику.ПлатежныйКалендарь КАК ЗаказПоставщикуПлатежныйКалендарь
		|ГДЕ
		|	ЗаказПоставщикуПлатежныйКалендарь.Ссылка.Проведен
		|	И ЗаказПоставщикуПлатежныйКалендарь.Ссылка.Проект.СсылкаНаПроектнуюЗадачу = &СсылкаНаПроектнуюЗадачу
		|	И ЗаказПоставщикуПлатежныйКалендарь.СуммаОплаты <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказПокупателяПлатежныйКалендарь.ДатаОплаты,
		|	ЗаказПокупателяПлатежныйКалендарь.СуммаОплаты,
		|	ЗаказПокупателяПлатежныйКалендарь.Ссылка.Контрагент,
		|	ЗаказПокупателяПлатежныйКалендарь.Ссылка.Договор,
		|	ЗаказПокупателяПлатежныйКалендарь.Ссылка,
		|	ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление)
		|ИЗ
		|	Документ.ЗаказПокупателя.ПлатежныйКалендарь КАК ЗаказПокупателяПлатежныйКалендарь
		|ГДЕ
		|	ЗаказПокупателяПлатежныйКалендарь.Ссылка.Проведен
		|	И ЗаказПокупателяПлатежныйКалендарь.Ссылка.Проект.СсылкаНаПроектнуюЗадачу = &СсылкаНаПроектнуюЗадачу
		|	И ЗаказПокупателяПлатежныйКалендарь.СуммаОплаты <> 0";
	
	Запрос.УстановитьПараметр("СсылкаНаПроектнуюЗадачу", ПроектнаяЗадача);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		// Пустой массив
		Возврат ЗаказыДляПерезаполнения; 
	КонецЕсли;
	
	ТЗЗаказы = РезультатЗапроса.Выгрузить();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Контрагент КАК Контрагент,
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Договор КАК Договор,
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Сумма КАК Сумма,
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ДатаДвижения КАК Дата,
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.НаправлениеДвижения КАК НаправлениеДвижения
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
		|			,
		|			ПроектнаяЗадача = &СсылкаНаПроектнуюЗадачу
		|				И Версия = &Версия) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних
		|ГДЕ
		|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Сумма <> 0
		|	И упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.НаправлениеДвижения В (ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление), ЗНАЧЕНИЕ(Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата))";
	
	Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "Проект");
	ТекущаяВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	Запрос.УстановитьПараметр("Версия", ТекущаяВерсияПроекта);
	Запрос.УстановитьПараметр("СсылкаНаПроектнуюЗадачу", ПроектнаяЗадача);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЗПланыДДС = РезультатЗапроса.Выгрузить();
	
	// проверка по датам.
	
	Для каждого СтрокаЗаказов из ТЗЗаказы Цикл
		
		Если ЗаказыДляПерезаполнения.Найти(СтрокаЗаказов.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;	
	
		ПараметрыОтбора = Новый Структура("Контрагент, Договор, Дата, Сумма");
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаЗаказов);
		СтрокиПланов = ТЗПланыДДС.НайтиСтроки(ПараметрыОтбора);
		
		Если СтрокиПланов.Количество() = 0 Тогда
			ЗаказыДляПерезаполнения.Добавить(СтрокаЗаказов.Ссылка);
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ЗаказыДляПерезаполнения;	
		
КонецФункции 

Процедура ПерезаполнитьЗаказыНаСервере(Заказы) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		
		Для каждого Заказ из Заказы Цикл
			

			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Сумма КАК СуммаОплаты,
			|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ДатаДвижения КАК ДатаОплаты
			|ИЗ
			|	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
			|			,
			|			Версия = &ТекущаяВерсия
			|				И Договор = &Договор
			|				И Контрагент = &Контрагент
			|				И НаправлениеДвижения = &НаправлениеДвижения
			|				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних
			|ГДЕ
			|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Сумма <> 0";
			
			СвойстваЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Договор, Контрагент, Проект");
			СвойстваПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваЗаказа.Проект, "СсылкаНаПроектнуюЗадачу, упоКорневойПроект");
			
			Запрос.УстановитьПараметр("Договор", СвойстваЗаказа.Договор);
			Запрос.УстановитьПараметр("Контрагент", СвойстваЗаказа.Контрагент);
			
			НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.ПустаяСсылка();
			Если ТипЗнч(Заказ) = упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.ЗаказПокупателя") Тогда
				НаправлениеДвижения = 
					упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление");
			ИначеЕсли ТипЗнч(Заказ) = упоФункцииОбщегоНазначенияКлиентСервер.упоТип("ДокументСсылка.ЗаказПоставщику") Тогда
				НаправлениеДвижения = 
					упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата");
			КонецЕсли;
			
			ПроектнаяЗадача = СвойстваПроекта.СсылкаНаПроектнуюЗадачу;
			ТекущаяВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(СвойстваПроекта.упоКорневойПроект);
			
			Запрос.УстановитьПараметр("НаправлениеДвижения", НаправлениеДвижения);
			Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
			Запрос.УстановитьПараметр("ТекущаяВерсия", ТекущаяВерсияПроекта); 
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				Продолжить;
			КонецЕсли;
			
			ДокументОбъект = Заказ.ПолучитьОбъект();
			ДокументОбъект.ПлатежныйКалендарь.Очистить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				НоваяСтрокаПлатКалендаря = ДокументОбъект.ПлатежныйКалендарь.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаПлатКалендаря, ВыборкаДетальныеЗаписи);
				
				ЗапасыИтог = ДокументОбъект.Запасы.Итог("Всего");
				ПлатежныйКалендарьИтог = ДокументОбъект.ПлатежныйКалендарь.Итог("СуммаОплаты");
				
				Если ПлатежныйКалендарьИтог > ЗапасыИтог Тогда
					НоваяСтрокаПлатКалендаря.СуммаОплаты = НоваяСтрокаПлатКалендаря.СуммаОплаты - (ПлатежныйКалендарьИтог - ЗапасыИтог);
				КонецЕсли;
				
				НоваяСтрокаПлатКалендаря.ПроцентОплаты = ?(ЗапасыИтог = 0, 0, Окр(НоваяСтрокаПлатКалендаря.СуммаОплаты / ЗапасыИтог * 100, 2, 1));
				НоваяСтрокаПлатКалендаря.СуммаНДСОплаты = Окр(ДокументОбъект.Запасы.Итог("СуммаНДС") * НоваяСтрокаПлатКалендаря.ПроцентОплаты / 100, 2, 1);
				
				Если ДокументОбъект.ПлатежныйКалендарь.Итог("ПроцентОплаты") = 100 И ДокументОбъект.ПлатежныйКалендарь.Итог("СуммаОплаты") <> ДокументОбъект.Запасы.Итог("Всего") Тогда
					ТаблицаРаспределения = ДокументОбъект.ПлатежныйКалендарь.Выгрузить();
					Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияУПФ") Тогда
						МодульРасчетыПроведениеДокументов = ОбщегоНазначения.ОбщийМодуль("РасчетыПроведениеДокументов");
						МодульРасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(ДокументОбъект.Запасы.Итог("Всего"), ТаблицаРаспределения,
							"СуммаОплаты", "ПроцентОплаты");
					КонецЕсли; 
					ДокументОбъект.ПлатежныйКалендарь.Загрузить(ТаблицаРаспределения);
				КонецЕсли;
				
			КонецЦикла;

			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
					
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;	

КонецПроцедуры
 
#КонецОбласти

#Область РаспределениеЗарплатыПоЗадачамПроектов

// Получает данные необходимые для распределения суммы зарплаты пропоционально трудозатратам по проектам
//
// Параметры:
//	ДанныеДокумента - Структура - 
//
// Возвращаемое значение:
//	Массив из Структура - 
//
Функция ПолучитьДанныеРаспределенияЗарплатыПоФактуТрудозатрат(ДанныеДокумента) Экспорт
		
	Распределение = ПолучитьПропорциюРаспределенияПоТрудозатратам(ДанныеДокумента);
	ДанныеТЧСРаспределением = ПолучитьДанныеТабЧастиСУчетомРаспределения(ДанныеДокумента, Распределение);
	
	Возврат ДанныеТЧСРаспределением;
	
КонецФункции

#КонецОбласти

// Серверный обработчик события ОбработкаПолученияФормы.
//
Процедура ОбработкаПолученияФормыКонтрагентыДоговоры(Источник, ВидФормы) Экспорт
		
	НеПодменятьФорму = УправлениеДоступом.ЕстьРоль("ДобавлениеИзменениеКонтрагентов");
	Если НеПодменятьФорму Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтоМенеджерСпрКонтрагенты = Ложь;
	Если Источник = Справочники.Контрагенты Тогда
		ЭтоМенеджерСпрКонтрагенты = Истина;
	ИначеЕсли Источник = Справочники.ДоговорыКонтрагентов Тогда
		ЭтоМенеджерСпрКонтрагенты = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПутьКФорме = "Справочник.%1.Форма.";
	
	Если ВидФормы = "ФормаОбъекта" Тогда		
		ИмяФормы = "ФормаЭлементаУправляемая";	
	ИначеЕсли ВидФормы = "ФормаГруппы" Тогда				
		Если ЭтоМенеджерСпрКонтрагенты Тогда
			ИмяФормы = "ФормаГруппыГруппы";
		Иначе
			ИмяФормы = "ФормаГруппыУправляемая";
		КонецЕсли;
	ИначеЕсли ВидФормы = "ФормаСписка" Тогда
		ИмяФормы = "ФормаСпискаУправляемая";
	ИначеЕсли ВидФормы = "ФормаВыбора" Тогда
		ИмяФормы = "ФормаВыбораУправляемая";
	ИначеЕсли ВидФормы = "ФормаВыбораГруппы" Тогда
		ИмяФормы = "ФормаВыбораГруппыУправляемая";
	КонецЕсли;
	
	ТипСправочника = "ДоговорыКонтрагентов";
	Если ЭтоМенеджерСпрКонтрагенты Тогда
		ТипСправочника = "Контрагенты";	
	КонецЕсли;
	
	ПутьКФорме = "Справочник.%1.Форма.%2";
	ВыбраннаяФорма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПутьКФорме, ТипСправочника, ИмяФормы);
	
КонецПроцедуры

// Функция возвращает процент ставки НДС.
//
// Параметры:
//  СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - Ставка НДС.
//
// Возвращаемое значение:
//	Число - Процент ставки НДС.
//
Функция ПеречислениеНДСПоРазмеруСтавки(СтавкаНДС, Расчетная) Экспорт
	
	СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка");
	
	Если ТипЗнч(СтавкаНДС) = Тип("Число") Тогда
	
		Если СтавкаНДС = 10 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10_110");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС10");
			КонецЕсли;
			
		ИначеЕсли СтавкаНДС = 20 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20_120");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
			КонецЕсли;
			
		ИначеЕсли СтавкаНДС = 22 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22_122");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС22");
			КонецЕсли;
			
		ИначеЕсли СтавкаНДС = 18 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18_118");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС18");
			КонецЕсли;
			
		ИначеЕсли СтавкаНДС = 0 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
			КонецЕсли;
			
		ИначеЕсли СтавкаНДС = 5 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5_105");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС5");
			КонецЕсли;
			
		ИначеЕсли СтавкаНДС = 7 Тогда
			
			Если Расчетная Тогда
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7_107");
			Иначе
				СтавкаПеречисление = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС7");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтавкаПеречисление;
	
КонецФункции

Функция ПеречислениеНДСПоСправочникуНДС(СправочникНДС) Экспорт
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СправочникНДС, "Ставка, Расчетная, ВидСтавкиНДС");
		
	Если Реквизиты.Ставка = 0 Тогда
		
		Если Реквизиты.ВидСтавкиНДС = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение("Перечисление.ВидыСтавокНДС.БезНДС") Тогда
			Расчетная = Ложь;
		Иначе	
			Расчетная = Истина;
		КонецЕсли;
		
	Иначе
		
		Расчетная = Реквизиты.Расчетная;
		
	КонецЕсли;	
		
	ПеречислениеНДС = ПеречислениеНДСПоРазмеруСтавки(Реквизиты.Ставка, Расчетная);
	
	Возврат ПеречислениеНДС;
	
КонецФункции	

Процедура УстановитьВидимостьЭлементовПроектИПроектнаяЗадачаВЗависимостиОтПользовательскихНастроек(Форма) Экспорт
	
	НужнаОбработкаФормыДокумента = Форма.ИмяФормы = "Документ.ПоступлениеНаСчет.Форма.ФормаДокумента"
		Или Форма.ИмяФормы = "Документ.РасходСоСчета.Форма.ФормаДокумента"
		Или Форма.ИмяФормы = "Документ.ПоступлениеВКассу.Форма.ФормаДокумента"
		Или Форма.ИмяФормы = "Документ.РасходИзКассы.Форма.ФормаДокумента" 
		Или Форма.ИмяФормы = "Документ.ПлатежноеПоручение.Форма.ФормаДокумента"; 
	
	Если Не НужнаОбработкаФормыДокумента Тогда
		Возврат;
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	
	ИмяГруппы = упоИнтеграцияУПФКлиентСервер.ИмяСоздаваемойГруппыДляНастройкиВидимостиЭлементов();  
	
	Если Элементы.Найти(ИмяГруппы) = Неопределено Тогда
		НужнаОбработкаФормыДокумента = Ложь;
	КонецЕсли;	  
	
	МассивТаблицФормы = ТаблицыФормыСодержащиеПроект(Форма);     

	Для Каждого ТаблицаФормы Из МассивТаблицФормы Цикл      
		
		ИмяГруппыСПроектом = упоИнтеграцияУПФКлиентСервер.ИмяГруппыТЧПоИмениТЧ(ТаблицаФормы.Имя);
		
		Если Элементы.Найти(ИмяГруппыСПроектом) = Неопределено Тогда
			НужнаОбработкаФормыДокумента = Ложь;
			Прервать;
		КонецЕсли;	 
				
	КонецЦикла;    
	
	Если Не НужнаОбработкаФормыДокумента Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьВидимостьОтПользовательскихНастроек(Форма);	
	
КонецПроцедуры

Процедура ПриОпределенииКомандПодключенныхКОбъекту(НастройкиФормы, Источники, ПодключенныеОтчетыИОбработки, Команды) Экспорт
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Возврат;
	КонецЕсли;

	ЭтоФормаОбъектаИЕстьПрава = НастройкиФормы.ЭтоФормаОбъекта
		И УправлениеДоступом.ЕстьРоль("упоОбработкаЗаполнениеДокументовУНФ");
	
	Если Не ЭтоФормаОбъектаИЕстьПрава Тогда
		Возврат;
	КонецЕсли;
		
	ТипПараметра = Новый ОписаниеТипов("ДокументСсылка.Бюджет");

	Команда = Команды.Добавить();
	Команда.Вид = "ПроектноеБюджетирование";
	Команда.Идентификатор = "ЗаполнитьИзБюджетаПроектов";
	Команда.Представление = НСтр("ru = 'Заполнить из бюджета проектов'");
	Команда.Важность = "Важное";	
	Команда.Порядок = 100;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Текст;
	Команда.ТипПараметра = ТипПараметра;	
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.МножественныйВыбор = Ложь;	
	Команда.Обработчик = "упоИнтеграцияУПФКлиент.Подключаемый_ОткрытьФормуЗаполненияДокументаБюджет";
	
	ТипПараметра = Новый ОписаниеТипов("ДокументСсылка.НачислениеЗарплатыУНФ");
	
	Команда = Команды.Добавить();
	Команда.Вид = "ПроектноеБюджетирование";
	Команда.Идентификатор = "ЗаполнитьПоФактуТрудозатрат";
	Команда.Представление = НСтр("ru = 'Заполнить по факту трудозатрат'");
	Команда.Важность = "Важное";	
	Команда.Порядок = 100;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Текст;
	Команда.ТипПараметра = ТипПараметра;	
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.МножественныйВыбор = Ложь;	
	Команда.Обработчик = "упоИнтеграцияУПФКлиент.Подключаемый_ОткрытьФормуЗаполненияДокументаНачисленияЗП";
	
	Команда = Команды.Добавить();
	Команда.Вид = "ПроектноеБюджетирование";
	Команда.Идентификатор = "РаспределитьПоЗадачамПроектов";
	Команда.Представление = НСтр("ru = 'Распределить по задачам проектов'");
	Команда.Важность = "Важное";	
	Команда.Порядок = 100;
	Команда.ОтображениеКнопки = ОтображениеКнопки.Текст;
	Команда.ТипПараметра = ТипПараметра;	
	Команда.ИзменяетВыбранныеОбъекты = Ложь;
	Команда.МножественныйВыбор = Ложь;	
	Команда.Обработчик = "упоИнтеграцияУПФКлиент.Подключаемый_РаспределитьПоЗадачамПроектов";
	
КонецПроцедуры

Процедура ДобавитьКомандыСозданияНаОсновании(ТаблицаОбъектовВводНаОсновании) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		СтрокаТаблицы = ТаблицаОбъектовВводНаОсновании.Добавить();
		СтрокаТаблицы.ИмяОбъектаМетаданных = "Документ.ЗаказПокупателя";
		СтрокаТаблицы.ФунциональныеОпцииОбъектаМетаданных = Новый Массив;
		
		СтрокаТаблицы = ТаблицаОбъектовВводНаОсновании.Добавить();
		СтрокаТаблицы.ИмяОбъектаМетаданных = "Документ.ЗаказПоставщику";
		СтрокаТаблицы.ФунциональныеОпцииОбъектаМетаданных = Новый Массив;	
		
		НайденнаяСтрокаКомандыЗадание = ТаблицаОбъектовВводНаОсновании.Найти("Команда.СоздатьЗадание", "ИмяОбъектаМетаданных");
		НайденнаяСтрокаСобытия = ТаблицаОбъектовВводНаОсновании.Найти("Документ.Событие", "имяОбъектаМетаданных");
		Если ЗначениеЗаполнено(НайденнаяСтрокаКомандыЗадание) И ЗначениеЗаполнено(НайденнаяСтрокаСобытия) Тогда
			ИндексСтрокиКомандыЗадание 	= ТаблицаОбъектовВводНаОсновании.Индекс(НайденнаяСтрокаКомандыЗадание);	
			ИндексСтрокиСобытие 		= ТаблицаОбъектовВводНаОсновании.Индекс(НайденнаяСтрокаСобытия);
			СдвигСтроки 				= ИндексСтрокиСобытие - ИндексСтрокиКомандыЗадание - 1;
			ТаблицаОбъектовВводНаОсновании.Сдвинуть(ИндексСтрокиСобытие, -СдвигСтроки);
		Иначе 
			СтрокаТаблицы = ТаблицаОбъектовВводНаОсновании.Добавить(); 
			СтрокаТаблицы.ИмяОбъектаМетаданных = "Документ.Событие";
			СтрокаТаблицы.ФунциональныеОпцииОбъектаМетаданных = Новый Массив;			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПриСозданииНаСервере_Документы(ИмяДокумента, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяДокумента = "ЗаказПоставщику" И ИмяФормы = "ФормаДокумента" Тогда
		
		ИзменитьЭлементы_ЗаказПоставщику_ФормаЭлемента(Форма, Отказ);
		ЗаполнитьЗаказ(Форма);
		
	ИначеЕсли ИмяДокумента = "ПеремещениеДСПлан" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьЭлементы_ПроектИПроектнаяЗадача_ФормаЭлемента(Форма, Отказ, "ПраваяКолонка");
		
	ИначеЕсли (ИмяДокумента = "ПоступлениеДСПлан" Или ИмяДокумента = "РасходДСПлан") 
		И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьЭлементы_ПроектИПроектнаяЗадача_ФормаЭлемента(Форма, Отказ, "КолонкаПраво");
		
	ИначеЕсли (ИмяДокумента = "СчетНаОплату" Или ИмяДокумента = "СчетНаОплатуПоставщика") 
		И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьЭлементы_ПроектИПроектнаяЗадача_ФормаЭлемента(Форма, Отказ, "ГруппаДополнительныеРеквизиты");
		
	ИначеЕсли ИмяДокумента = "Событие" И ИмяФормы = "ФормаСписка" Тогда
		
		ДобавитьЭлементы_Событие_ФормаСписка(Форма, Отказ);
		
	ИначеЕсли ИмяДокумента = "НачислениеЗарплаты" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьЭлементы_НачислениеЗарплаты_ФормаДокумента(Форма, Отказ); 
		
	ИначеЕсли ИмяДокумента = "СписаниеЗапасов" И ИмяФормы = "ФормаДокумента" Тогда
		
		ДобавитьЭлементы_ПроектИПроектнаяЗадача_ФормаЭлемента(Форма, Отказ, "ГруппаДополнительныеРеквизиты");
		
	ИначеЕсли ИмяДокумента = "упоПроектнаяЗадача" И ИмяФормы = "ФормаСпискаУправляемая" Тогда
		
		ИзменитьЭлементы_упоПроектнаяЗадача_ФормаСпискаУправляемая(Форма, Отказ);
					
	ИначеЕсли ИмяДокумента = "упоПроектнаяЗадача" И ИмяФормы = "ФормаДокументаУправляемая" Тогда  
		
		ИзменитьЭлементы_упоПроектнаяЗадача_ФормаДокументаУправляемая(Форма, Отказ);				
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_Справочники(ИмяСправочника, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяСправочника = "ДоговорыКонтрагентов" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ИзменитьЭлементы_ДоговорыКонтрагентов_ФормаЭлемента(Форма);
		
	ИначеЕсли ИмяСправочника = "Проекты" Тогда
		
		Если ИмяФормы = "ФормаЭлемента" Тогда
			ИзменитьЭлементы_Проекты_ФормаЭлемента(Форма, Отказ); 
		ИначеЕсли ИмяФормы = "упоФормаЭлементаУправляемая" Тогда  
			ИзменитьЭлементы_Проекты_упоФормаЭлементаУправляемая(Форма, Отказ); 
		ИначеЕсли ИмяФормы = "упоФормаСпискаУправляемая" Тогда
			ИзменитьЭлементы_Проекты_упоФормаСпискаУправляемая(Форма, Отказ); 			
		КонецЕсли;
		
	ИначеЕсли ИмяСправочника = "СтатьиДвиженияДенежныхСредств" И ИмяФормы = "ФормаЭлемента" Тогда
		
		упоИнтеграцияEPMСервер.ДобавитьЭлементы_СтатьиДвиженияДенежныхСредств_ФормаЭлемента(Форма);
		
	ИначеЕсли ИмяСправочника = "Пользователи" Тогда
		
		Если ИмяФормы = "ФормаЭлемента" Тогда
			ИзменитьЭлементы_Пользователи_ФормаЭлемента(Форма, Отказ);
		ИначеЕсли ИмяФормы = "ФормаСписка" Тогда
			ИзменитьЭлементы_Пользователи_ФормаСписка(Форма, Отказ);
		КонецЕсли;
		
	ИначеЕсли ИмяСправочника = "СтруктурныеЕдиницы" И ИмяФормы = "ФормаСписка" Тогда
		
		ДобавитьЭлементыФормыВыбораСтруктурныеЕдиницы(Форма, Отказ);
		
	ИначеЕсли ИмяСправочника = "КлассификаторЕдиницИзмерения" И ИмяФормы = "ФормаВыбора" Тогда
		
		ИзменитьЭлементы_КлассификаторЕдиницИзмерения_ФормаВыбора(Форма, Отказ);
		
	ИначеЕсли ИмяСправочника = "упоЗадания" И ИмяФормы = "ФормаЭлемента" Тогда
		
		ИзменитьЭлементы_упоЗадания_ФормаЭлемента(Форма, Отказ);  
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_ПланыСчетов(ИмяПланаСчетов, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяПланаСчетов = "Управленческий" И ИмяФормы = "ФормаВыбора" Тогда
		
		ИзменитьЭлементы_ПланСчета_Управленческий_ФормаВыбора(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_Отчеты(ИмяОтчета, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяОтчета = "ПлатежныйКалендарь" И ИмяФормы = "Форма" Тогда
		
		ДобавитьЭлементы_ПлатежныйКалендарь_ФормаОтчета(Форма, Отказ);
		
	ИначеЕсли ИмяОтчета = "АнализБизнеса" И ИмяФормы = "Форма" Тогда
		
		ДобавитьЭлементы_АнализБизнеса_ФормаОтчета(Форма, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_Обработки(ИмяОбработки, ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяОбработки = "ПерсональныеНастройки" И ИмяФормы = "МоиНастройки" Тогда 
		
		ДобавитьЭлементы_ПерсональныеНастройки_МоиНастройки(Форма, Отказ);
		
	ИначеЕсли ИмяОбработки = "КонтактЦентр" И ИмяФормы = "Форма" Тогда
		
		ДобавитьЭлементы_КонтактЦентр_Форма(Форма, Отказ);
						
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере_ОбщиеФормы(ИмяФормы, Форма, Отказ, СтандартнаяОбработка)
	
	Если ИмяФормы = "ПерсональныеНастройки" Тогда 
		
		ИзменитьЭлементы_ОбщаяФорма_ПерсональныеНастройки(Форма, Отказ);
		
	ИначеЕсли ИмяФормы = "упоНастройкаПараметровPM" Тогда	
		
		ИзменитьЭлементы_ОбщаяФорма_упоНастройкаПараметровPM(Форма, Отказ);	
			
	КонецЕсли;
	
КонецПроцедуры

Процедура ИзменитьЭлементы_Проекты_ФормаЭлемента(Форма, Отказ)
	
	упоИнтеграция.ДобавитьКомандуОткрытияФормыПроекта(Форма, "Подключаемый_упоОткрытьФормуПроектаPM",
		НСтр("ru = 'Открыть форму проекта PM'"));
		
КонецПроцедуры

