Функция СтруктураПараметров()
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяСкрываемогоЭлемента", "");
	Параметры.Вставить("ИмяТабличнойЧасти", "");
	
	Возврат Параметры;   
	
КонецФункции

// Возвращает массив таблиц формы, в которых есть элемент "Проект"
//
// Параметры:
//  Форма	 - форма, из обработчика события которой происходит вызов процедуры 
// 
// Возвращаемое значение:
//  Массив - Массив элементов с типом "Таблица формы"
//
Функция ТаблицыФормыСодержащиеПроект(Форма)
	
	ЭлементыФормы			 = Форма.Элементы;
	ТаблицыСПроектами		 = Новый Массив;
	ЭтаТаблицаСодержитПроект = Ложь;
	
	Для каждого Элемент Из ЭлементыФормы Цикл
		
		ЭтоТаблицаФормы = ТипЗнч(Элемент) = Тип("ТаблицаФормы");
		
		Если ЭтоТаблицаФормы = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ПодчиненныеЭлементыТаблицы = Элемент.ПодчиненныеЭлементы;
		
		Для каждого ЭлементТаблицы Из ПодчиненныеЭлементыТаблицы Цикл
			
			Если ЭтоПолеСвязанноеСПроектом(ЭлементТаблицы, Элемент)
				Или ЭтоГруппаСодержащаяПолеСвязанноеСПроектом(ЭлементТаблицы, Элемент) Тогда
				ЭтаТаблицаСодержитПроект = Истина;
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;
		
		Если ЭтаТаблицаСодержитПроект Тогда
			ТаблицыСПроектами.Добавить(Элемент);
		КонецЕсли;
		
		ЭтаТаблицаСодержитПроект = Ложь;
		
	КонецЦикла;
	
	Возврат ТаблицыСПроектами;
	
КонецФункции
 
Функция ЭтоГруппаСодержащаяПолеСвязанноеСПроектом(ЭлементТаблицы, ТаблицаФормы)
	
	ЭтоГруппаФормы = ТипЗнч(ЭлементТаблицы) = Тип("ГруппаФормы");
	
	Если Не ЭтоГруппаФормы Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоГруппаДобавленнаяПрограммноДляОтображенияПроектаИПЗ =
		ВРЕГ(ЭлементТаблицы.Имя) = ВРЕГ(упоИнтеграцияУПФКлиентСервер.ИмяГруппыТЧПоИмениТЧ(ТаблицаФормы.Имя)); 
		
	Если ЭтоГруппаДобавленнаяПрограммноДляОтображенияПроектаИПЗ Тогда
		Возврат Истина;
	КонецЕсли;	
	
	Для Каждого ПодчиненныйЭлемент Из ЭлементТаблицы.ПодчиненныеЭлементы Цикл
		
		Если НЕ (ЭтоПолеСвязанноеСПроектом(ПодчиненныйЭлемент, ТаблицаФормы)
			Или ЭтоГруппаСодержащаяПолеСвязанноеСПроектом(ПодчиненныйЭлемент, ТаблицаФормы)) Тогда
			Продолжить;
		КонецЕсли;	
		
		Возврат Истина; 
		
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоПолеСвязанноеСПроектом(ЭлементТаблицы, ТаблицаФормы) Экспорт
	
	ЭтоПолеФормы = (ТипЗнч(ЭлементТаблицы) = Тип("ПолеФормы"));
	
	Если Не ЭтоПолеФормы Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПолеСвязаноСПроектом = ВРЕГ(ЭлементТаблицы.ПутьКДанным) = ВРЕГ(ТаблицаФормы.ПутьКДанным + ".Проект"); 
	
	Возврат ПолеСвязаноСПроектом;

КонецФункции

#Область ЗаполнениеЗаказа

Процедура ЗаполнитьЗаказ(Форма)
	
	Параметры = Форма.Параметры;
	Если Не Параметры.Свойство("упоДанныеЗаполнения") Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыСозданияЗаказов = Параметры.упоДанныеЗаполнения.ПараметрыСозданияЗаказов;
	// Удалим ключи с незаполненными значениями, чтобы не затирать данные, заполненные по умолчанию в УНФ 
	// (см.ОбработкаЗаполнения в заказах).
	УдалитьНезаполненныеЗначенияИзСтруктурыЗаполнения(ПараметрыСозданияЗаказов);
	
	ИмяФормы = Форма.ИмяФормы;
	Если ИмяФормы <> ПараметрыСозданияЗаказов.ИмяФормы Тогда
		Возврат;		
	КонецЕсли;
	
	БылоЗаполнение = Параметры.упоДанныеЗаполнения.Свойство("БылоЗаполнение");
	Если БылоЗаполнение Тогда 
		Возврат;
	КонецЕсли;
	Параметры.упоДанныеЗаполнения.Вставить("БылоЗаполнение", Истина);
	
	ДанныеЗаказа = Параметры.упоДанныеЗаполнения.ДанныеЗаказа;
		
	ОбъектФормы = Форма.Объект;		
	ЗаполнитьЗначенияСвойств(ОбъектФормы, ПараметрыСозданияЗаказов);
	ШапкаЗаказа = ДанныеЗаказа.ШапкаЗаказа;
	ЗаполнитьЗначенияСвойств(ОбъектФормы, ШапкаЗаказа);
		
	ВидДокументаЗаказПокупателя = упоИнтеграцияУПФКлиентСервер.ПолучитьИмяВидаЗаказаПокупателя();
	ЭтоЗаказПокупателя = ПараметрыСозданияЗаказов.ВидДокумента = ВидДокументаЗаказПокупателя;
	Если ЭтоЗаказПокупателя Тогда
		ПараметрыРасчета = Новый Структура("СброситьФлагСкидкиРассчитаны", Истина);
	Иначе
		ПараметрыРасчета = Новый Структура;	
	КонецЕсли;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", ОбъектФормы.СуммаВключаетНДС);
	
	ИмяЗаполняемойТабличнойЧасти = ПараметрыСозданияЗаказов.ИмяТабличнойЧасти;
	ТЧЗапасы = ОбъектФормы[ИмяЗаполняемойТабличнойЧасти];
	ТабличнаяЧасть = ДанныеЗаказа.ТабличнаяЧасть;
	Для Каждого СтрокаЗапасов Из ТабличнаяЧасть Цикл
		
		СтрокаТЧЗапасы = ТЧЗапасы.Добавить();	
		ЗаполнитьЗначенияСвойств(СтрокаТЧЗапасы, СтрокаЗапасов);		
		
		Если ЭтоЗаказПокупателя Тогда
			СтрокаТЧЗапасы.ДатаОтгрузки = СтрокаЗапасов.ДатаНачисления;
		Иначе
			СтрокаТЧЗапасы.ДатаПоступления = СтрокаЗапасов.ДатаНачисления;
		КонецЕсли;
		
		МодульТабличныеЧастиУНФКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ТабличныеЧастиУНФКлиентСервер");
		МодульТабличныеЧастиУНФКлиентСервер.РассчитатьСуммыВСтрокеТЧ(СтрокаТЧЗапасы, ПараметрыРасчета);
		
	КонецЦикла;
	
	// Платежный календарь 
	УстановитьПривилегированныйРежим(Истина);	    
	
	ПлатежныйКалендарьИспользуется = Константы["ФункциональнаяОпцияПлатежныйКалендарь"].Получить();	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ДанныеЗаказа.Свойство("ПлатежныйКалендарь") И ПлатежныйКалендарьИспользуется Тогда	
		
		ЗапланироватьОплату = Ложь;
		
		ВедетсяБюджетДвиженияДенежныхСредств = ПолучитьСвойствоВедетсяБюджетДвиженияДенежныхСредств(ОбъектФормы.Проект);
		
		Если ВедетсяБюджетДвиженияДенежныхСредств Тогда	
			ЗапланироватьОплату = Истина;			
		КонецЕсли;
		
		ОбъектФормы.ЗапланироватьОплату = ЗапланироватьОплату;
		
		Форма.Элементы.РедактироватьСписком.Пометка = Истина;
		ТЧПлатежныйКалендарь = ОбъектФормы.ПлатежныйКалендарь;   
		
		Для Каждого СтрокаПлатежногоКалендаря Из ДанныеЗаказа.ПлатежныйКалендарь Цикл
			СтрокаТЧ = ТЧПлатежныйКалендарь.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаПлатежногоКалендаря);
		

			ЗапасыИтог = ОбъектФормы.Запасы.Итог("Всего");
			ПлатежныйКалендарьИтог = ОбъектФормы.ПлатежныйКалендарь.Итог("СуммаОплаты");
			
			Если ПлатежныйКалендарьИтог > ЗапасыИтог Тогда
				СтрокаТЧ.СуммаОплаты = СтрокаТЧ.СуммаОплаты - (ПлатежныйКалендарьИтог - ЗапасыИтог);
			КонецЕсли;
			
			СтрокаТЧ.ПроцентОплаты = ?(ЗапасыИтог = 0, 0, Окр(СтрокаТЧ.СуммаОплаты / ЗапасыИтог * 100, 2, 1));
			СтрокаТЧ.СуммаНДСОплаты = Окр(ОбъектФормы.Запасы.Итог("СуммаНДС") * СтрокаТЧ.ПроцентОплаты / 100, 2, 1);
			
			Если ОбъектФормы.ПлатежныйКалендарь.Итог("ПроцентОплаты") = 100 И ОбъектФормы.ПлатежныйКалендарь.Итог("СуммаОплаты") <> ОбъектФормы.Запасы.Итог("Всего") Тогда
				ТаблицаРаспределения = ОбъектФормы.ПлатежныйКалендарь.Выгрузить();
				
				Если ОбщегоНазначения.ПодсистемаСуществует("упоУправлениеПроектамиPM.упоИнтеграцияУПФ") Тогда
					МодульРасчетыПроведениеДокументов = ОбщегоНазначения.ОбщийМодуль("РасчетыПроведениеДокументов");
					МодульРасчетыПроведениеДокументов.РаспределитьСуммуПоКолонкеТаблицы(ОбъектФормы.Запасы.Итог("Всего"), ТаблицаРаспределения,
						"СуммаОплаты", "ПроцентОплаты");
				КонецЕсли;
				
				ОбъектФормы.ПлатежныйКалендарь.Загрузить(ТаблицаРаспределения);
			КонецЕсли;
		

		КонецЦикла;	
	КонецЕсли;	
 	
КонецПроцедуры

Функция ДополнитьРеквизитамиШапкиПоУмолчанию(ПроектнаяЗадача, ПараметрыСозданияЗаказов)
	
	ПараметрыСозданияЗаказов = ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыСозданияЗаказов);
		
	ТекДата = ТекущаяДата();
	Дата = НачалоДня(ТекДата);
	ПараметрыСозданияЗаказов.Вставить("Дата", Дата);	
	
	ИменаРеквизитов = Новый Структура;
	ИменаРеквизитов.Вставить("Автор", "Автор");
	ИменаРеквизитов.Вставить("Проект", "Проект");
	ИменаРеквизитов.Вставить("Организация", "Проект.Организация");	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПроектнаяЗадача, ИменаРеквизитов, Истина);
	Организация = ЗначенияРеквизитов.Организация;
	ПараметрыСозданияЗаказов.Вставить("Организация", Организация);
	
	ПроектнаяЗадачаСправочник = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(ПроектнаяЗадача);
	ПараметрыСозданияЗаказов.Вставить("Проект", ПроектнаяЗадачаСправочник);
	ПараметрыСозданияЗаказов.Вставить("упоПроектнаяЗадача", ПроектнаяЗадачаСправочник);
	
	Проект = ЗначенияРеквизитов.Проект;
	ПроверитьВозможностьПолученияДанныхДляЗаказаПокупателя(Проект, ПараметрыСозданияЗаказов);
	СтруктураНастроек = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	СтруктурнаяЕдиница = ПолучитьСтруктурнуюЕдиницуПоВидуДокумента(Проект, ПараметрыСозданияЗаказов);
	ПараметрыСозданияЗаказов.Вставить(ПараметрыСозданияЗаказов.ИмяРеквизитаСтруктурнойЕдиницы, СтруктурнаяЕдиница);	
	
	ВидСтавкиНДСПоУмолчанию = 
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВидСтавкиНДСПоУмолчанию", Истина);
	ПараметрыСозданияЗаказов.Вставить("ВидСтавкиНДСПоУмолчанию", ВидСтавкиНДСПоУмолчанию);	
		
	СотрудникиПользователя = 
		РегистрыСведений["СотрудникиПользователя"].ПолучитьСотрудниковПользователя(ЗначенияРеквизитов.Автор);
	Если СотрудникиПользователя.Количество() <> 0 Тогда
		ПараметрыСозданияЗаказов.Вставить("Ответственный", СотрудникиПользователя[0]);
	КонецЕсли; 
	
	Возврат ПараметрыСозданияЗаказов;
	
КонецФункции

Функция ОпределитьИзменениеГруппировочныхПолей(ГруппировочныеПоля, Выборка)
	
	ЕстьИзменения = Ложь;
	Для Каждого ГруппировочноеПоле Из ГруппировочныеПоля Цикл
		ИмяПоля = ГруппировочноеПоле.Ключ;
		ЗначениеПоля = ГруппировочноеПоле.Значение;
		Если Выборка[ИмяПоля] <> ЗначениеПоля Тогда 
			ЕстьИзменения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьИзменения;
	
КонецФункции

Функция ПолучитьПараметрыСозданияПоВидуЗаказа(ВидДокумента)
	
	ПараметрыСозданияЗаказов = Новый Структура;
	ПараметрыСозданияЗаказов.Вставить("ВидДокумента", ВидДокумента);
	
	ВидДокументаЗаказПокупателю = упоИнтеграцияУПФКлиентСервер.ПолучитьИмяВидаЗаказаПокупателя();
	Если ВидДокумента = ВидДокументаЗаказПокупателю Тогда		
		ПараметрыСозданияЗаказов.Вставить("ИмяФормы", "Документ.ЗаказПокупателя.Форма.ФормаДокумента");
		ПараметрыСозданияЗаказов.Вставить("ИмяТабличнойЧасти", "Запасы");
		ВидЗаказа = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыЗаказовПокупателей.Основной");
		ПараметрыСозданияЗаказов.Вставить("ВидЗаказа", ВидЗаказа);
		ВидОперации = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыОперацийЗаказПокупателя.ЗаказНаПродажу");
		ПараметрыСозданияЗаказов.Вставить("ВидОперации", ВидОперации);
		ПараметрыСозданияЗаказов.Вставить("ИмяРеквизитаСтруктурнойЕдиницы", "СтруктурнаяЕдиницаПродажи");
		ВидЭлемента = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход");
		ПараметрыСозданияЗаказов.Вставить("ВидЭлемента", ВидЭлемента);
		ИсточникПлана = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы");
		ПараметрыСозданияЗаказов.Вставить("ИсточникПлана", ИсточникПлана);
		ВидОбъема = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЭлементаОбъемов.Доход");
		ПараметрыСозданияЗаказов.Вставить("ВидОбъема", ВидОбъема);
		ПоложениеДатыОтгрузки = 
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти");
		ПараметрыСозданияЗаказов.Вставить("ПоложениеДатыОтгрузки", ПоложениеДатыОтгрузки);
	Иначе		
		ПараметрыСозданияЗаказов.Вставить("ИмяФормы", "Документ.ЗаказПоставщику.Форма.ФормаДокумента");
		ПараметрыСозданияЗаказов.Вставить("ИмяТабличнойЧасти", "Запасы");
		ВидОперации = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ВидыОперацийЗаказПоставщику.ЗаказНаЗакупку");
		ПараметрыСозданияЗаказов.Вставить("ВидОперации", ВидОперации);
		ПараметрыСозданияЗаказов.Вставить("ИмяРеквизитаСтруктурнойЕдиницы", "СтруктурнаяЕдиница");
		ВидЭлемента = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход");
		ПараметрыСозданияЗаказов.Вставить("ВидЭлемента", ВидЭлемента);
		ИсточникПлана = 
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты");
		ПараметрыСозданияЗаказов.Вставить("ИсточникПлана", ИсточникПлана);
		ВидОбъема = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоВидЭлементаОбъемов.Расход");
		ПараметрыСозданияЗаказов.Вставить("ВидОбъема", ВидОбъема);
		ПоложениеДатыПоступления = 
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.ПоложениеРеквизитаНаФорме.ВТабличнойЧасти");
		ПараметрыСозданияЗаказов.Вставить("ПоложениеДатыПоступления", ПоложениеДатыПоступления);
	КонецЕсли;	
	
	Возврат ПараметрыСозданияЗаказов;
	
КонецФункции

Функция ПолучитьДанныеЗаказовИзВыборки(ПакетРезультатов, ПроектнаяЗадача, ПараметрыСозданияЗаказов)
	
	СрокиПЗ = упоПроектыИЗадачиСервер.ПолучитьСрокиПроектнойЗадачи(ПроектнаяЗадача);
	ДатаНачалаПЗ = СрокиПЗ.ДатаНачалаПлан;
	
	ВидСтавкиНДСПоУмолчанию = ПараметрыСозданияЗаказов.ВидСтавкиНДСПоУмолчанию;
	ДанныеЗаказов = Новый Массив;
	ГруппировочныеПоля = Новый Структура("Контрагент, Договор");
	ПоляТЧЗапасов = "Номенклатура, ДатаНачисления, ЕдиницаИзмерения, Количество, Цена, СтавкаНДС";
	
	ВыборкаОсновныеДанные = ПакетРезультатов[ПакетРезультатов.ВГраница()-1].Выбрать();
	
	// Последний элемент пакета результатов запроса содержит данные по данным Платежного календаря.
	ТЗПлатежныйКалендарь = ПакетРезультатов[ПакетРезультатов.ВГраница()].Выгрузить();
	ПоляТЗПлатежныйКалендарь = "СуммаОплаты, ДатаОплаты";
	
	Пока ВыборкаОсновныеДанные.Следующий() Цикл
		НовыйЗаказ = ОпределитьИзменениеГруппировочныхПолей(ГруппировочныеПоля, ВыборкаОсновныеДанные);
		Если НовыйЗаказ Тогда
			ЗаполнитьЗначенияСвойств(ГруппировочныеПоля, ВыборкаОсновныеДанные);
			Заказ = Новый Структура("ШапкаЗаказа, ТабличнаяЧасть");
			ШапкаЗаказа = ОбщегоНазначения.СкопироватьРекурсивно(ГруппировочныеПоля);
			Заказ.ШапкаЗаказа = ШапкаЗаказа;
			ТабличнаяЧасть = Новый Массив;
			Заказ.ТабличнаяЧасть = ТабличнаяЧасть;
			
			// Платежный календарь.
			ТЧПлатежныйКалендарь = Новый Массив;
			СтрокаТЧ = Новый Структура (ПоляТЗПлатежныйКалендарь);
			ПараметрыОтбора = Новый Структура("Контрагент, Договор");
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ВыборкаОсновныеДанные);
			НайденныеСтроки = ТЗПлатежныйКалендарь.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаТЗ из НайденныеСтроки Цикл
				НоваяСтрокаТЧ = Новый Структура(ПоляТЗПлатежныйКалендарь);
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТЧ, СтрокаТЗ);
				ТЧПлатежныйКалендарь.Добавить(НоваяСтрокаТЧ);
			КонецЦикла;	
			Заказ.Вставить("ПлатежныйКалендарь", ТЧПлатежныйКалендарь);
			
			ДанныеЗаказов.Добавить(Заказ);
			
		КонецЕсли;
		
		СтрокаЗапасов = ПолучитьСтрокуЗапасов(ВыборкаОсновныеДанные, ПоляТЧЗапасов, ВидСтавкиНДСПоУмолчанию);
		
		Если Не ЗначениеЗаполнено(СтрокаЗапасов.ДатаНачисления) Тогда
			СтрокаЗапасов.ДатаНачисления = ДатаНачалаПЗ;	
		КонецЕсли;
		
		ТабличнаяЧасть.Добавить(СтрокаЗапасов);
		
	КонецЦикла;
	
	Возврат ДанныеЗаказов;	
	
КонецФункции	

Функция ПолучитьСтрокуЗапасов(Выборка, ПоляТЧЗапасов, ВидСтавкиНДСПоУмолчанию)
	
	СтрокаЗапасов = Новый Структура(ПоляТЧЗапасов);
	ЗаполнитьЗначенияСвойств(СтрокаЗапасов, Выборка);
	СтрокаЗапасов.Цена = 0;
	Если Выборка.Количество <> 0 Тогда
		СтрокаЗапасов.Цена = Выборка.Сумма / Выборка.Количество;
	КонецЕсли;
	
	МенеджерСтавкиНДС = ОбщегоНазначения.ОбщийМодуль("Справочники.СтавкиНДС");
	
	ДатаОбработки = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура.ВидСтавкиНДС) Тогда
		СтрокаЗапасов.СтавкаНДС = МенеджерСтавкиНДС.СтавкаНДС(СтрокаЗапасов.Номенклатура.ВидСтавкиНДС, ДатаОбработки);
	Иначе
		СтрокаЗапасов.СтавкаНДС = МенеджерСтавкиНДС.СтавкаНДС(ВидСтавкиНДСПоУмолчанию, ДатаОбработки);
	КонецЕсли;
	
	Возврат СтрокаЗапасов;
	
КонецФункции

Функция ПолучитьДанныеИзПроектнойЗадачи(ПроектнаяЗадача, ПараметрыСозданияЗаказов)
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДанныхПЗ(ПараметрыСозданияЗаказов);	
	Запрос.УстановитьПараметр("ТекВерсия", ТекВерсия);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ВидЭлемента", ПараметрыСозданияЗаказов.ВидЭлемента);
	Запрос.УстановитьПараметр("ИсточникПлана", ПараметрыСозданияЗаказов.ИсточникПлана);
	Запрос.УстановитьПараметр("ВидОбъема", ПараметрыСозданияЗаказов.ВидОбъема);
	
	Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "Проект");
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	Запрос.УстановитьПараметр("РасходыПоОбъемам", СвойстваПроекта.РасходыПоОбъемам);
	Запрос.УстановитьПараметр("РасходыПоНатуральнымПоказателям", СвойстваПроекта.РасходыПоНатуральнымПоказателям);

	ПакетРезультатов = Запрос.ВыполнитьПакет();


	Возврат ПакетРезультатов;
	
КонецФункции

Функция ПолучитьСвойствоВедетсяБюджетДвиженияДенежныхСредств(ПроектнаяЗадача) Экспорт
 	
	СвойствоВедетсяБюджетДвиженияДенежныхСредств = Истина;

	Если ТипЗнч(ПроектнаяЗадача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Проект = ПроектнаяЗадача.Проект;
	ИначеЕсли ТипЗнч(ПроектнаяЗадача) = Тип("СправочникСсылка.Проекты") Тогда
		КорневойПроект = ПроектнаяЗадача.упоКорневойПроект;
		
		Если ЗначениеЗаполнено(КорневойПроект) Тогда
			Проект = КорневойПроект;	
		Иначе
			Проект = ПроектнаяЗадача;		
		КонецЕсли;   
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаДляПолученияСвойстваВедетсяБюджетДвиженияДенежныхСредств();	  	
	Запрос.УстановитьПараметр("Проект", Проект);  
	
	РезультатЗапроса = Запрос.Выполнить();   
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СвойствоВедетсяБюджетДвиженияДенежныхСредств;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл	
		СвойствоВедетсяБюджетДвиженияДенежныхСредств = Выборка.ВедетсяБюджетДвиженияДенежныхСредств;		
		Прервать;
	КонецЦикла;
	
	Возврат	СвойствоВедетсяБюджетДвиженияДенежныхСредств;

КонецФункции  

Функция ПолучитьСтруктурнуюЕдиницуПоВидуДокумента(Проект, ПараметрыСозданияЗаказов)
	
	ЗначенияПоУмолчаниюПроекта =
		упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект);	
		
	ВидДокумента = ПараметрыСозданияЗаказов.ВидДокумента;
	ВидДокументаЗаказПокупателю = упоИнтеграцияУПФКлиентСервер.ПолучитьИмяВидаЗаказаПокупателя();
	Если ВидДокумента = ВидДокументаЗаказПокупателю Тогда
		Подразделение = ЗначенияПоУмолчаниюПроекта.ПодразделениеДоходовПоУмолчанию;	
	Иначе
		Подразделение = ЗначенияПоУмолчаниюПроекта.ПодразделениеРасходовПоУмолчанию;	
	КонецЕсли;
		
	СтруктурнаяЕдиница = упоИнтеграцияВызовСервера.НайтиСвязанныйЭлементСтруктурыИлиПодразделения(Подразделение);
								
	Возврат СтруктурнаяЕдиница;
	
КонецФункции

Функция ПолучитьТекстЗапросаДанныхПЗДляЗаказаПокупателя()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Контрагент КАК Контрагент,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Договор КАК Договор,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ДатаНачисления КАК ДатаНачисления,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Номенклатура КАК Номенклатура,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сумма) КАК Сумма,
	|	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Количество) КАК Количество
	|ПОМЕСТИТЬ АктуальныеПланыДоходовИРасходов
	|ИЗ
	|	РегистрСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СрезПоследних(
	|			,
	|			Версия = &ТекВерсия
	|				И ПроектнаяЗадача = &ПроектнаяЗадача
	|				И ВидЭлемента = &ВидЭлемента
	|				И ИсточникПлана = &ИсточникПлана) КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Контрагент,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ЕдиницаИзмерения,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Договор,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Номенклатура,
	|	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ДатаНачисления
	|
	|ИМЕЮЩИЕ
	|	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сумма) <> 0 И
	|	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Количество) <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА КОЛИЧЕСТВО(АктуальныеПланыДоходовИРасходов.Контрагент) <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьСтроки
