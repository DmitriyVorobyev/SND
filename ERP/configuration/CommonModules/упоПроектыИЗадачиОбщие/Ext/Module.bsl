	Возврат ПредставлениеТЧ;			
	
КонецФункции

// Имя подчиненной таблицы по имени основной
//
// Параметры:
//  ИмяОсновнойТаблицы	 - Строка	 - имя основной таблицы-владельца
//  ИмяДляДокументаПЗ	 - Булево	 - признак вызова из формы документа Проектная задача (Ложь - вызов из формы задачи структуы проекта).
// 
// Возвращаемое значение:
//  Строка - имя подчиненной таблицы.
//
Функция ИмяПодчиненнойТаблицыПоИмениОсновной(ИмяОсновнойТаблицы, ИмяДляДокументаПЗ = Ложь) Экспорт
		
	Если ИмяОсновнойТаблицы = "МатериальныеРесурсы" Тогда
		ИмяПодчиненнойТаблицы = ?(ИмяДляДокументаПЗ, "РаспределениеПотребностей", ИмяОсновнойТаблицы + "ПоПодразделениям");
	ИначеЕсли ИмяОсновнойТаблицы = "Субпродукты" Тогда	
		ИмяПодчиненнойТаблицы = ?(ИмяДляДокументаПЗ, "РаспределениеОбъемов", ИмяОсновнойТаблицы + "ПоПодразделениям");
	ИначеЕсли ИмяОсновнойТаблицы = "ПланДоходов" Тогда
		ИмяПодчиненнойТаблицы = ?(ИмяДляДокументаПЗ, "РаспределениеДоходов", ИмяОсновнойТаблицы + "ПоПодразделениям");
	ИначеЕсли ИмяОсновнойТаблицы = "ПланРасходов" Тогда
		ИмяПодчиненнойТаблицы = ?(ИмяДляДокументаПЗ, "РаспределениеРасходов", ИмяОсновнойТаблицы + "ПоПодразделениям");
	ИначеЕсли ИмяОсновнойТаблицы = "ДоходныеОбъемы" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеДоходныхОбъемов";
	ИначеЕсли ИмяОсновнойТаблицы = "РасходныеОбъемы" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеРасходныхОбъемов";
	ИначеЕсли ИмяОсновнойТаблицы = "Доходы" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеДоходов";
	ИначеЕсли ИмяОсновнойТаблицы = "Расходы" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеРасходов";
	ИначеЕсли ИмяОсновнойТаблицы = "ЗатратыМатРесурсовФакт" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеЗатрат";
	ИначеЕсли ИмяОсновнойТаблицы = "ДополнительныеЗатраты" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеДополнительныхЗатрат";	
	Иначе
		ИмяПодчиненнойТаблицы = "";
	КонецЕсли;	
			
	Возврат ИмяПодчиненнойТаблицы;				
		
КонецФункции	

// Данные подчиненной таблицы по периодам по имени владельца.
//
// Параметры:
//  ИмяОсновнойТаблицы	 - Строка	 - имя основной таблицы-владельца
//  ИмяДляДокументаПЗ	 - Булево	 - признак вызова из формы документа Проектная задача (Ложь - вызов из формы задачи структуы проекта).
// 
// Возвращаемое значение:
//  Структура
//
Функция ДанныеПодчиненнойТаблицыПоПериодамПоИмениВладельца(ИмяОсновнойТаблицы, ИмяДляДокументаПЗ = Ложь) Экспорт
	
	Если Не ИмяДляДокументаПЗ Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	ИмяПодчиненнойТаблицы = "";
	ИндексСтрокиРаспределения = "";
	ИсточникПлана = Неопределено;
	колонкиСуммы = Новый Массив;
	колонкиСуммы.Добавить("Сумма");
	колонкиСуммы.Добавить("Количество");			
	колонкиОтбора = "Период, ИсточникПлана";
						
	Если ИмяОсновнойТаблицы = "РаспределениеПотребностей" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеРасходовПоПериодам";
		ИндексСтрокиРаспределения = "ИндексСтрокиРаспределениеПоРолям";
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты");
	ИначеЕсли ИмяОсновнойТаблицы = "РаспределениеОбъемов" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеДоходовПоПериодам";
		ИндексСтрокиРаспределения = "ИндексСтрокиРаспределениеПоРолям";
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы");
	ИначеЕсли ИмяОсновнойТаблицы = "РаспределениеДополнительныхЗатрат" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеРасходовПоПериодам";
		ИндексСтрокиРаспределения = "ИндексСтрокиРаспределениеПоРолям";
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.ДополнительныеЗатраты");
	ИначеЕсли ИмяОсновнойТаблицы = "РаспределениеДоходов" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеДоходовПоПериодам";
		ИндексСтрокиРаспределения = "ИндексСтрокиРаспределенияДоходов";
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы");
	ИначеЕсли ИмяОсновнойТаблицы = "РаспределениеРасходов" Тогда
		ИмяПодчиненнойТаблицы = "РаспределениеРасходовПоПериодам";
		ИндексСтрокиРаспределения = "ИндексСтрокиРаспределенияРасходов";
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.ДоходыРасходы");
	Иначе
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	ДанныеПодчиненнойТаблицы = Новый Структура;
	ДанныеПодчиненнойТаблицы.Вставить("ИмяПодчиненнойТаблицы", ИмяПодчиненнойТаблицы);
	ДанныеПодчиненнойТаблицы.Вставить("ИндексСтрокиРаспределения", ИндексСтрокиРаспределения);
	ДанныеПодчиненнойТаблицы.Вставить("ИсточникПлана", ИсточникПлана);
	ДанныеПодчиненнойТаблицы.Вставить("колонкиСуммы", колонкиСуммы);
	ДанныеПодчиненнойТаблицы.Вставить("колонкиОтбора", колонкиОтбора);
													
	Возврат ДанныеПодчиненнойТаблицы;
	
КонецФункции

