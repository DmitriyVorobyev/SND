#Область ПрограммныйИнтерфейс

// Устанавливает значение устаревших реквизитов
// (требуются для совместимости с функционалом редакции 1)
// по значению реквизита ТипПроектнойЗадачи.
//
// Параметры:
//	ЗадачаОбъект - ДокументСсылка.упоПроектнаяЗадача, ДокументОбъект.упоПроектнаяЗадача - задача,
//					для которой нужно узнать и записть тип.
//
Процедура ЗаписатьТипЗадачи(ЗадачаОбъект) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗадачаОбъект.ТипПроектнойЗадачи) Тогда
		УстановитьТипЗадачи(ЗадачаОбъект);
	КонецЕсли; 	
	
	Если ЗадачаОбъект.ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Этап") Тогда
		ЗадачаОбъект.ЭтоМодельПакетаРабот = Ложь;                                                                  
		ЗадачаОбъект.ЭтоПакетРабот = Ложь;
		ЗадачаОбъект.ЭтоВеха = Ложь;		
	ИначеЕсли ЗадачаОбъект.ТипПроектнойЗадачи = 
		ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.ПакетРабот") Тогда
		ЗадачаОбъект.ЭтоМодельПакетаРабот = Ложь;
		ЗадачаОбъект.ЭтоПакетРабот = Истина;
		ЗадачаОбъект.ЭтоВеха = Ложь;		
	ИначеЕсли ЗадачаОбъект.ТипПроектнойЗадачи = 
		ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот") Тогда
		ЗадачаОбъект.ЭтоМодельПакетаРабот = Истина;
		ЗадачаОбъект.ЭтоПакетРабот = Истина;
		ЗадачаОбъект.ЭтоВеха = Ложь;		
	ИначеЕсли ЗадачаОбъект.ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Веха") Тогда
		ЗадачаОбъект.ЭтоМодельПакетаРабот = Ложь;
		ЗадачаОбъект.ЭтоПакетРабот = Ложь;		
		ЗадачаОбъект.ЭтоВеха = Истина;		
	КонецЕсли; 
	
	Если ЗадачаОбъект.ТипПроектнойЗадачи = 
		ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот") Тогда
		Если Не ЗначениеЗаполнено(ЗадачаОбъект.ЕдиницаНормированияДлительности) Тогда
			ЗадачаОбъект.ЕдиницаНормированияДлительности = ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.РабочийДень");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры 

// Устанавливает видимость элементов формы проектной задачи.
//
// Параметры:
//  Объект			 - ДокументСсылка.упоПроектнаяЗадача, ДокументОбъект.упоПроектнаяЗадача	 - объект,
//  	из которого берутся значения реквизитов для установки видимости элементов.
//  Форма			 - УправляемаяФорма	 - форма, на которой необходимо установить видимость элементов.
//  СтруктураСвойств - Структура		 - структура предварительно полученных проектных опций. Передается в случае,
//  	если проектные опции были получены в вызывающем объекте и нет необходимости их повторно инициировать.
//
Процедура УстановитьВидимостьЭлементовФормыПроектнойЗадачи(Объект, Форма, СтруктураСвойств = Неопределено) Экспорт
	
	Если СтруктураСвойств = Неопределено Тогда
		СтруктураСвойств = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	КонецЕсли;
	
	Элементы = Форма.Элементы;
	
	Форма.ИспользоватьАналитикуКонтрагентДляСС = СтруктураСвойств.ИспользоватьАналитикуКонтрагентДляСС;
	
	Элементы.СтраницаФинансы.Видимость = ЭтоЗадачаСФинансами(СтруктураСвойств);
	
	// Доходы
	Элементы.СтраницаПланДоходов.Видимость = СтруктураСвойств.ВедетсяБюджетДоходов;
	Элементы.РамкаГруппыРаспределениеПоПодразделениям.Видимость = СтруктураСвойств.ДоходыПоПодразделениям;

	Элементы.РаспределениеДоходовГруппаОбъемыПоПодразделениям.Видимость = СтруктураСвойств.ДоходыПоОбъемам 
		И Не СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
		
	Элементы.ПланДоходовЗаполнитьПоРолям.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
	Элементы.РаспределениеДоходовЗаполнитьПоРолям.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
	Элементы.ПланДоходовЗаполнитьПоПланамРесурсов.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту 
		Или СтруктураСвойств.ПланироватьЗатратыНаМатериалы;		
	Элементы.РаспределениеДоходовЗаполнитьПоПланамРесурсов.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту
		Или СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
	Элементы.ПланДоходовЗаполнитьПоПлануМатериальныхРесурсов.Видимость = СтруктураСвойств.ПланироватьЗатратыНаМатериалы;	
	Элементы.РаспределениеДоходовЗаполнитьПоПлануМатериальныхРесурсов.Видимость = 
		СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
		
	Элементы.РаспределениеДоходовРаспределитьПоПериодамПланДоходов.Видимость = СтруктураСвойств.ДоходыПоОбъемам 
		И Не СтруктураСвойств.ДоходыПоНатуральнымПоказателям;

	// Расходы
	Элементы.СтраницаПланРасходов.Видимость = СтруктураСвойств.ВедетсяБюджетРасходов;
	Элементы.ГруппаРаспределениеРасходов.Видимость = СтруктураСвойств.РасходыПоПодразделениям;
	
	Элементы.РаспределениеРасходовГруппаОбъемыПоПодразделениям.Видимость = СтруктураСвойств.РасходыПоПодразделениям
		И СтруктураСвойств.РасходыПоОбъемам 
		И Не СтруктураСвойств.РасходыПоНатуральнымПоказателям;
		
	Элементы.ПланРасходовЗаполнитьПоТрудовымРесурсам.Видимость = СтруктураСвойств.ВедетсяБюджетРасходов 
		И СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		
	Элементы.ПланРасходовПланРасходов_ЗаполнитьЗатраты.Видимость = СтруктураСвойств.ПланироватьЗатратыНаМатериалы
		Или СтруктураСвойств.ПланироватьТрудозатратыПоПроекту
		Или СтруктураСвойств.ПланироватьДополнительныеЗатратыПоЗадаче;
		
	Элементы.ПодменюЗаполнитьПоТрудовымРесурсам.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту; 
	
	Элементы.РаспределениеРасходовРаспределитьПоПериодамПланРасходов.Видимость = СтруктураСвойств.РасходыПоПодразделениям
		И СтруктураСвойств.РасходыПоОбъемам 
		И Не СтруктураСвойств.РасходыПоНатуральнымПоказателям;

	// Доп.затраты
	Элементы.СтраницаДопЗатраты.Видимость = СтруктураСвойств.ПланироватьДополнительныеЗатратыПоЗадаче;
	Элементы.ДополнительныеЗатратыГруппаНастройкиБДР.Видимость = СтруктураСвойств.ПланироватьДополнительныеЗатратыПоЗадаче
		И Объект.ВключитьДопЗатратыВПланРасходов;
	Элементы.ГруппаРаспределениеДополнительныхЗатрат.Видимость = СтруктураСвойств.ПланироватьДополнительныеЗатратыПоЗадаче 
		И Объект.ВключитьДопЗатратыВПланРасходов 
		И СтруктураСвойств.РасходыПоПодразделениям;
		
	Элементы.РаспределениеДополнительныхЗатратГруппаОбъемыПоПодразделениям.Видимость = 
		СтруктураСвойств.РасходыПоПодразделениям
		И СтруктураСвойств.РасходыПоОбъемам 
		И Не СтруктураСвойств.РасходыПоНатуральнымПоказателям;
	
		
	// Объемы
	Элементы.СтраницаПланВыпуска.Видимость 		= СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	Элементы.СтраницаОсвоенныеОбъемы.Видимость 	= СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	
	Элементы.СубпродуктыГруппаНастройкиБДР.Видимость = Объект.ВключитьСубпродуктыВПланДоходов;
	
	Элементы.ГруппаРаспределениеОбъемовПоПодразделениям.Видимость = 
		УчетСубпродуктовПоПодразделениям(СтруктураСвойств, Объект.ВключитьСубпродуктыВПланДоходов);
		
	Элементы.ГруппаРаспределениеОбъемовПоПодразделениямРаспределениеПоПрофилю.Видимость = 
		УчетДоходныхОбъемовПоПодразделениям(СтруктураСвойств, Объект.ВключитьСубпродуктыВПланДоходов);
		
	Элементы.СубпродуктыГруппаЗаполнитьПоРолям.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
	Элементы.СубпродуктыПоПодразделениямГруппаЗаполнитьПоРолям.Видимость = 
		СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
				
	// Трудозатраты
	ПрименитьСвойство_ПланироватьТрудозатратыПоПроекту(Элементы, 
		СтруктураСвойств.ПланироватьТрудозатратыПоПроекту);
		
	ПрименитьСвойство_УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат(Элементы, 
		СтруктураСвойств.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат);
	
	Элементы.УровеньПланированияТрудозатратДляБДР.Доступность = Объект.ВключитьТрудРесурсыВПланРасходов;
	
	Элементы.ГруппаРаспределениеПотребностейРаспределениеПоПрофилю.Видимость = СтруктураСвойств.РасходыПоОбъемам 
		Или Объект.ВключитьМатРесурсыВПланРасходов;
	
	// Мат.затраты
	Элементы.СтраницаМатериалыИОборудование.Видимость = СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
	
	Элементы.МатериальныеРесурсыГруппаНастройкиБДР.Видимость = Объект.ВключитьМатРесурсыВПланРасходов;
	
	Элементы.ГруппаРаспределениеПотребностей.Видимость = 
		УчетМатРесурсовПоПодразделениям(СтруктураСвойств, Объект.ВключитьМатРесурсыВПланРасходов);
		
	Элементы.РаспределениеПотребностейГруппаСпособПривязки.Видимость = СтруктураСвойств.РасходыПоНатуральнымПоказателям
		Или (СтруктураСвойств.РасходыПоОбъемам И Объект.ВключитьМатРесурсыВПланРасходов);
	Элементы.ГруппаРаспределениеПотребностейРаспределениеПоПрофилю.Видимость = 
		СтруктураСвойств.РасходыПоНатуральнымПоказателям 
		Или (СтруктураСвойств.РасходыПоОбъемам И Объект.ВключитьМатРесурсыВПланРасходов);
    Элементы.РаспределениеПотребностейГруппаКоличествоСуммаРаспределение.Видимость = 
		СтруктураСвойств.РасходыПоНатуральнымПоказателям 
		Или (СтруктураСвойств.РасходыПоОбъемам И Объект.ВключитьМатРесурсыВПланРасходов);
		
	Элементы.РаспределениеПотребностейРаспределитьПоПериодамМатРесурсы.Видимость = 
		СтруктураСвойств.РасходыПоНатуральнымПоказателям Или (СтруктураСвойств.РасходыПоОбъемам
		И Объект.ВключитьМатРесурсыВПланРасходов);
	
	// ДДС
	ПрименитьСвойство_ВедетсяБюджетДвиженияДенежныхСредств(Элементы, 
		СтруктураСвойств.ВедетсяБюджетДвиженияДенежныхСредств,
		Ложь);
	
	// Сроки
	Элементы.ДатаНачалаПлан.АвтоОтметкаНезаполненного 		= Объект.РучнойВводСроков;
	Элементы.ДатаНачалаПлан.Доступность 					= Объект.РучнойВводСроков И Не Объект.ЭтоВеха;
	Элементы.ДатаЗавершенияПлан.АвтоОтметкаНезаполненного 	= Объект.РучнойВводСроков;
	Элементы.ДатаЗавершенияПлан.Доступность 				= Объект.РучнойВводСроков;
	
	Элементы.ГруппаДлительность.Видимость = Объект.ЭтоМодельПакетаРабот;
	
	Элементы.ЕдиницаНормированияДлительности.ТолькоПросмотр = Объект.ДлительностьБезУчетаКалендаряПроекта;
	
	// Связи
	Элементы.СтраницаСоставЗадачи.Видимость = Не Объект.ЭтоПакетРабот И Не Объект.ЭтоМодельПакетаРабот;
	Элементы.ПредупреждениеОНеактивностиСвязейДляРасчетаСроков.Видимость = Объект.РучнойВводСроков;
	
	// Заказы
	Элементы.СтраницаЗаказыПокупателей.Видимость = СтруктураСвойств.ИспользоватьЗаказыКлиентов 
		И СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	Элементы.СтраницаЗаказыПоставщикам.Видимость = СтруктураСвойств.ИспользоватьЗаказыПоставщикам;
	Элементы.СтраницаЗаказыНаПроизводство2_1.Видимость = СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	Элементы.СтраницаЗаказыНаПроизводство2_2.Видимость = СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	
КонецПроцедуры

// Устанавливает тип проектной задачи.
//
// Параметры:
//  ЗадачаОбъект - ДокументСсылка.упоПроектнаяЗадача, ДокументОбъект.упоПроектнаяЗадача - задача,
//					для которой нужно установить тип.
//
Процедура УстановитьТипЗадачи(ЗадачаОбъект) Экспорт

	ЗадачаОбъект.ТипПроектнойЗадачи = ПолучитьТипЗадачи(ЗадачаОбъект);
	
КонецПроцедуры

// Возвращает тип проектной задачи.
//
// Параметры:
//  ЗадачаОбъект - ДокументСсылка.упоПроектнаяЗадача, ДокументОбъект.упоПроектнаяЗадача, Структура 
//	- задача или ее свойства, для которой нужно установить тип.
//					
// Возвращаемое значение:
//	ПеречислениеСсылка.упоТипПроектнойЗадачи   - Тип проектной задачи.
//
Функция ПолучитьТипЗадачи(ЗадачаОбъект) Экспорт

	Если ЗадачаОбъект.ЭтоВеха Тогда
		ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Веха");
	ИначеЕсли ЗадачаОбъект.ЭтоМодельПакетаРабот Тогда
		ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
	ИначеЕсли ЗадачаОбъект.ЭтоПакетРабот Тогда 		
		ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.ПакетРабот");
	Иначе
		ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Этап");
	КонецЕсли; 
	
	Возврат ТипПроектнойЗадачи;

КонецФункции

// Возвращает заголовок кнопки смены статуса в панели статусов проекта.
//
// Параметры:
//  Статус  - ПеречислениеСсылка.упоСостояниеСтатусаПроекта - статус.
//
// Возвращаемое значение:
//	Строка   - заголовок кнопки.
//
Функция ПолучитьЗаголовокКнопкиПоСтатусу(Знач Статус) Экспорт
	Возврат ?(ЗначениеЗаполнено(Статус), Статус, "Без статуса");
КонецФункции

// Возвращает статус по имени кнопки.
//
// Параметры:
//  ИмяКнопки  - Строка - имя кнопки.
//
// Возвращаемое значение:
//	ПеречислениеСсылка.упоСостояниеСтатусаПроекта - статус.
//
Функция ПолучитьСтатусПоИмениКнопки(Знач ИмяКнопки) Экспорт
	
	ИмяСтатуса = СтрЗаменить(ИмяКнопки, "КнопкаСтатуса", "");
	
	Возврат ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаПроекта." 
		+ ?(ИмяСтатуса = "БезСтатуса", "ПустаяСсылка", ИмяСтатуса));
		
КонецФункции

// Возвращает имя кнопки смены статуса в панели статусов проекта по статусу.
//
// Параметры:
//  Статус  - ПеречислениеСсылка.упоСостояниеСтатусаПроекта - статус.
//
// Возвращаемое значение:
//   Строка   - имя кнопки.
//
Функция ПолучитьИмяКнопкиПоСтатусу(Статус) Экспорт
	Возврат "КнопкаСтатуса" + ?(ЗначениеЗаполнено(Статус), Статус, "БезСтатуса");
КонецФункции

// Обновляет дату привязки в строке.
//
// Параметры:
//  Сроки		 - Структура							 - свойства:
//  							* НачалоПлан		- Дата - дата начала.
//  							* ЗавершениеПлан	- Дата - дата окончания.
//  Проект		 - СправочникСсылка.Проекты				 - проект.
//  НекаяСтрока	 - ДанныеФормыЭлементКоллекции, Структура	 - данные строки.
//
Процедура ОбновитьДатуПривязкиВСтроке(Сроки, Проект, НекаяСтрока) Экспорт
	
	Если Не ЗначениеЗаполнено(Сроки) Тогда
		ДатаНач = Неопределено;
	ИначеЕсли НекаяСтрока.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоЗадачи") Тогда
		ДатаНач = Сроки.НачалоПлан;
	ИначеЕсли НекаяСтрока.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоПроекта")
		И Сроки.Свойство("НачалоПланПроект") Тогда
		ДатаНач = Сроки.НачалоПланПроект;
	ИначеЕсли НекаяСтрока.СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеЗадачи") Тогда
		ДатаНач = Сроки.ЗавершениеПлан;
	ИначеЕсли НекаяСтрока.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеПроекта")
		И Сроки.Свойство("ЗавершениеПланПроект") Тогда
		ДатаНач = Сроки.ЗавершениеПланПроект;
	Иначе
		Возврат;
	КонецЕсли;
	
	Задержка = НекаяСтрока.Задержка;
	НоваяДатаПривязки = упоУправлениеФормамиСервер.РассчитатьЗадержкуПоКалендарю(ДатаНач, Задержка, Проект);	
	
	Если НЕ НекаяСтрока.ДатаПривязки = НоваяДатаПривязки Тогда
		НекаяСтрока.ДатаПривязки = НоваяДатаПривязки;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет заполнение профиля распределения и даты привязки в строке,
//  для которой установлен способ привязки "По профилю" или "К конкретной дате".
//
// Параметры:
//  Объект						 - ДокументОбъект, СправочникОбъект, ДанныеФормы - объект, для табличных частей которого делается проверка.
//  СтрокаПроверки				 - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекции - строка табличной части,
//  для которой выполняется проверка.
//  НаименованиеТабличнойЧасти	 - Строка											 - имя табличной части, для которой выполняется проверка.
//  ПредставлениеТабличнойЧасти	 - Строка											 - представление табличной части в сообщении об ошибке.
//  Отказ						 - Булево											 - флаг успешности проверки.
//  НомерСтроки					 - Число
//
Процедура ПроверитьЗаполнениеСпособаПривязки(Объект, 
											СтрокаПроверки, 
											НаименованиеТабличнойЧасти, 
											ПредставлениеТабличнойЧасти, 
											Отказ, 
											Знач НомерСтроки = Неопределено) Экспорт
	
	ИмяПоляПрофильРаспределения = "ПрофильРаспределения";
	ИмяПоляДатаПривязки = "ДатаПривязки";
	ИмяПоляСпособПривязки = "СпособПривязки";
	Если НаименованиеТабличнойЧасти = "ПараметрыРасчета" Тогда
		ИмяПоляСпособПривязки = "ВидПривязки";
	ИначеЕсли НаименованиеТабличнойЧасти = "ДополнительныеЗатраты" Тогда
		ИмяПоляСпособПривязки = "СпособПривязкиДоходовРасходов";	
		ИмяПоляПрофильРаспределения = "ПрофильРаспределенияДоходовРасходов";
		ИмяПоляДатаПривязки = "ДатаПривязкиДоходовРасходов";
	КонецЕсли;
	
	Если НомерСтроки = Неопределено Тогда
		НомерСтроки = СтрокаПроверки.НомерСтроки;
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("УправляемаяФорма") Тогда 				
		КлючДанных = Неопределено;
		ПутьКДанным = "";
	ИначеЕсли ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
		КлючДанных = Объект.Ссылка;
		ПутьКДанным = "Объект";
	Иначе	
		КлючДанных = Объект;
		ПутьКДанным = "Объект";
	КонецЕсли;	
	
	ШаблонСообщения = НСтр("ru = 'В строке №%1 табличной части ""%2"": Необходимо заполнить значение реквизита ""%3""'");
	
	Если ЭтоСпособПривязкиПоПрофилю(СтрокаПроверки[ИмяПоляСпособПривязки])
		И Не ЗначениеЗаполнено(СтрокаПроверки[ИмяПоляПрофильРаспределения]) Тогда				
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
																				НомерСтроки, 
																				ПредставлениеТабличнойЧасти, 
																				"Профиль распределения");
		Поле = ИмяПоляДляСообщения(НаименованиеТабличнойЧасти, 
									Объект[НаименованиеТабличнойЧасти].Индекс(СтрокаПроверки), 
									ИмяПоляПрофильРаспределения);
							
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, КлючДанных, Поле, ПутьКДанным, Отказ);
		
	ИначеЕсли ЭтоСпособПривязкиНаДату(СтрокаПроверки[ИмяПоляСпособПривязки])
		И Не ЗначениеЗаполнено(СтрокаПроверки[ИмяПоляДатаПривязки]) Тогда		
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
																				НомерСтроки, 
																				ПредставлениеТабличнойЧасти, 
																				"Дата привязки");				
		Поле = ИмяПоляДляСообщения(НаименованиеТабличнойЧасти, 
									Объект[НаименованиеТабличнойЧасти].Индекс(СтрокаПроверки), 
									ИмяПоляДатаПривязки);
				
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, КлючДанных, Поле, ПутьКДанным, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

// Получить статус задачи по проценту готовности
//
// Параметры:
//  ПроцентГотовности	 - Число	 - Процент готовности.
//  ТекущийСтатус		 - 	ПеречислениеСсылка.упоСостояниеСтатусаЗадачи - 
//								Установленный на данный момент статус (Необязательный).
// 
// Возвращаемое значение:
//  ПеречислениеСсылка.упоСостояниеСтатусаЗадачи - Статус задачи. 
//
Функция ПолучитьСтатусЗадачиПоПроцентуГотовности(ПроцентГотовности, ТекущийСтатус = Неопределено) Экспорт
			
	Если ПроцентГотовности > 100 Тогда
		
		ПроцентГотовности = 100;
		
	ИначеЕсли ПроцентГотовности < 0 Тогда
		
		ПроцентГотовности = 0;
		
	КонецЕсли;
	
	Если ПроцентГотовности = 100 Тогда
		
		Если ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта") Тогда
			Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта"); 
		Иначе			
			Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Завершена");
		КонецЕсли;
		
	ИначеЕсли ПроцентГотовности = 0 Тогда
		
		Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Запланирована");
		
	ИначеЕсли ПроцентГотовности > 0 И ПроцентГотовности < 100 Тогда
		
		Статус = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Выполняется");
		
	Иначе 
		
		Статус = Неопределено;
		
	КонецЕсли;
	
	Возврат Статус;

КонецФункции 

// Устанавливает видимость элементов формы задачи при редактировании в структуре проекта.
//
// Параметры:
//  Форма	 - УправляемаяФорма	 - форма, на которой необходимо установить видимость элементов.
//
Процедура УстановитьВидимостьЭлементовФормыЗадачиСтруктуры(Форма, СтруктураСвойств = Неопределено) Экспорт
	
	Если СтруктураСвойств = Неопределено Тогда
		СтруктураСвойств = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Форма.Проект);
	КонецЕсли;
	
	Форма.ИспользоватьАналитикуКонтрагентДляСС = СтруктураСвойств.ИспользоватьАналитикуКонтрагентДляСС;
	Форма.УказыватьПодразделениеРолиПриПланированииТР = СтруктураСвойств.УказыватьПодразделениеРолиПриПланированииТР;
	
	Элементы = Форма.Элементы;
	
	Если Элементы.СтраницаТрудовыеРесурсыРоли.Видимость Тогда
		
		Элементы.СтраницаТрудовыеРесурсыРоли.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		Элементы.УровеньПланированияТрудозатратДляБДР.Доступность = Форма.ВключитьТрудРесурсыВПланРасходов;
		
	КонецЕсли;
	
	Если Элементы.СтраницаНазначенныеТрудовыеРесурсы.Видимость Тогда
		
		Элементы.СтраницаНазначенныеТрудовыеРесурсы.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		
	КонецЕсли;
	
	Если Элементы.СтраницаМатериальныеРесурсы.Видимость Тогда
		
		Элементы.СтраницаМатериальныеРесурсы.Видимость = СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
		Элементы.ГруппаМатериальныеРесурсыПоПодразделениям.Видимость =
			УчетМатРесурсовПоПодразделениям(СтруктураСвойств, Форма.ВключитьМатРесурсыВПланРасходов);
		Элементы.МатериальныеРесурсыГруппаНастройкиБДР.Видимость = Форма.ВключитьМатРесурсыВПланРасходов;
		Элементы.МатериальныеРесурсыПоПодразделениямГруппаОбъемыПоПодразделениям.Видимость =
			СтруктураСвойств.РасходыПоНатуральнымПоказателям
			Или (СтруктураСвойств.РасходыПоОбъемам и Форма.ВключитьМатРесурсыВПланРасходов);
		Элементы.МатериальныеРесурсыПоПодразделениямПрофильДатаПривязки.Видимость =
			СтруктураСвойств.РасходыПоНатуральнымПоказателям
			Или (СтруктураСвойств.РасходыПоОбъемам и Форма.ВключитьМатРесурсыВПланРасходов);
		
		ПараметрыОтбора = Новый Структура("СпособПривязки",
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную"));
		ЕстьРучноеРаспределение = Форма.МатериальныеРесурсыПоПодразделениям.НайтиСтроки(ПараметрыОтбора).Количество() > 0;
		
		Элементы.МатериальныеРесурсыПоПодразделениямГруппаРаспределение.Видимость =
			(СтруктураСвойств.РасходыПоНатуральнымПоказателям
				Или (СтруктураСвойств.РасходыПоОбъемам И Форма.ВключитьМатРесурсыВПланРасходов)) И ЕстьРучноеРаспределение;
				
		Элементы.МатериальныеРесурсыПоПодразделениямРаспределитьПоПериодамМатРесурсы.Видимость =
			СтруктураСвойств.РасходыПоНатуральнымПоказателям
			Или (СтруктураСвойств.РасходыПоОбъемам и Форма.ВключитьМатРесурсыВПланРасходов);
			
	КонецЕсли;
	
	Если Элементы.СтраницаСубпродукты.Видимость Тогда
		
		Элементы.СтраницаСубпродукты.Видимость = СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
		Элементы.ГруппаСубпродуктыПоПодразделениям.Видимость =
			УчетСубпродуктовПоПодразделениям(СтруктураСвойств, Форма.ВключитьСубпродуктыВПланДоходов);
		Элементы.СубпродуктыПоПодразделениямГруппаОбъемыПоПодразделениям.Видимость =
			УчетДоходныхОбъемовПоПодразделениям(СтруктураСвойств, Форма.ВключитьСубпродуктыВПланДоходов);
		Элементы.СубпродуктыГруппаНастройкиБДР.Видимость = Форма.ВключитьСубпродуктыВПланДоходов;
		Элементы.СубпродуктыГруппаЗаполнитьПоРолям.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		Элементы.СубпродуктыПоПодразделениямГруппаЗаполнитьПоРолям.Видимость =
			СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
			
	КонецЕсли;
	
	Если Элементы.СтраницаПланДоходов.Видимость Тогда
		
		Элементы.СтраницаПланДоходов.Видимость = СтруктураСвойств.ВедетсяБюджетДоходов;
		Элементы.ГруппаПланДоходовПоПодразделениям.Видимость = СтруктураСвойств.ДоходыПоПодразделениям;
		Элементы.ПланДоходовПоПодразделениямГруппаОбъемы.Видимость = СтруктураСвойств.ДоходыПоОбъемам
			И Не СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
		Элементы.ПланДоходовЗаполнитьПоРолям.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		Элементы.ПланДоходовПоПодразделениямЗаполнитьПоРолям.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		Элементы.ПланДоходовЗаполнитьПоПланамРесурсов.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту
			Или СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
		Элементы.ПланДоходовПоПодразделениямЗаполнитьПоПланамРесурсов.Видимость =
			СтруктураСвойств.ПланироватьТрудозатратыПоПроекту Или СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
		Элементы.ПланДоходовПоПодразделениямРаспределитьПоПериодамПланДоходов.Видимость = СтруктураСвойств.ДоходыПоОбъемам
			И Не СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
		Элементы.ПланДоходов_ЗаполнитьПоПлануМатериальныхРесурсов.Видимость = 
			СтруктураСвойств.ПланироватьЗатратыНаМатериалы;	
		Элементы.ПланДоходовПоПодразделениямЗаполнитьПоПлануМатериальныхРесурсов.Видимость = 
			СтруктураСвойств.ПланироватьЗатратыНаМатериалы;
			
	КонецЕсли;
	
	Если Элементы.СтраницаПланРасходов.Видимость Тогда
		
		Элементы.СтраницаПланРасходов.Видимость = СтруктураСвойств.ВедетсяБюджетРасходов;
		Элементы.ГруппаПланРасходовПоПодразделениям.Видимость = СтруктураСвойств.РасходыПоПодразделениям;
		Элементы.ПланРасходовПоПодразделениямГруппаОбъемы.Видимость = СтруктураСвойств.РасходыПоОбъемам
			И Не СтруктураСвойств.РасходыПоНатуральнымПоказателям;
		Элементы.ПодменюЗаполнитьПоТрудовымРесурсам.Видимость = СтруктураСвойств.ПланироватьТрудозатратыПоПроекту;
		Элементы.ПланРасходовПланРасходов_ЗаполнитьЗатраты.Видимость = СтруктураСвойств.ПланироватьЗатратыНаМатериалы
			Или СтруктураСвойств.ПланироватьТрудозатратыПоПроекту
			Или СтруктураСвойств.ПланироватьДополнительныеЗатратыПоЗадаче;
		Элементы.ПланРасходовПоПодразделениямРаспределитьПоПериодамПланРасходов.Видимость = СтруктураСвойств.РасходыПоОбъемам
			И Не СтруктураСвойств.РасходыПоНатуральнымПоказателям;

	КонецЕсли;
	
	Если Элементы.СтраницаДДС.Видимость Тогда
		
		ПрименитьСвойство_ВедетсяБюджетДвиженияДенежныхСредств(Элементы,
			СтруктураСвойств.ВедетсяБюджетДвиженияДенежныхСредств,
			Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает представление табличной части задачи по имени в метаданных.
//
// Параметры:
//  ИмяТабличнойЧасти			 - Строка	 - имя табличной части в метаданных.
//  ПредставлениеДляДокумента	 - Булево	 - признак представления для документа проектная задача
//  	или для формы задачи в структуре проекта.
// 
// Возвращаемое значение:
//  Строка - представление табличной части.
//
Функция ПредставлениеТабличнойЧастиЗадачи(ИмяТабличнойЧасти, ПредставлениеДляДокумента = Истина) Экспорт
			
	Если ИмяТабличнойЧасти = "МатериальныеРесурсы" Тогда		
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Материалы и оборудование / Потребности'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'План потребностей'");	
		КонецЕсли;					
		
	ИначеЕсли ИмяТабличнойЧасти = "Субпродукты" Тогда	
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Объемы / План выпуска'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'План выпуска'");	
		КонецЕсли;		
		
	ИначеЕсли ИмяТабличнойЧасти = "ПланРасходов" Тогда			
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Фин. планы / План расходов'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'План расходов'");	
		КонецЕсли;	
		
	ИначеЕсли ИмяТабличнойЧасти = "ПланДоходов" Тогда			
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Фин. планы / План доходов'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'План доходов'");
		КонецЕсли;		
		
	ИначеЕсли ИмяТабличнойЧасти = "ДополнительныеЗатраты" Тогда			
		
		ПредставлениеТЧ = НСтр("ru = 'Дополнительные затраты'");		
		
	ИначеЕсли ИмяТабличнойЧасти = "ТрудовыеРесурсы" Или ИмяТабличнойЧасти = "ТрудовыеРесурсыРоли" Тогда			
		
		ПредставлениеТЧ = НСтр("ru = 'Роли трудовых ресурсов'");		
		
	ИначеЕсли ИмяТабличнойЧасти = "ДвиженияДенежныхСредств" Тогда			
		
		ПредставлениеТЧ = НСтр("ru = 'Фин. планы / План движения денежных средств'");		
		
	ИначеЕсли ИмяТабличнойЧасти = "ПотребностиВМашинахМеханизмах" Тогда			
		
		ПредставлениеТЧ = НСтр("ru = 'Машины / механизмы'");		
		
	ИначеЕсли ИмяТабличнойЧасти = "ПредусловияЗадачи" Тогда	
		
		ПредставлениеТЧ = НСтр("ru = 'Предусловия'");		
		
	ИначеЕсли ИмяТабличнойЧасти = "РаспределениеПотребностей" 
		Или ИмяТабличнойЧасти = "МатериальныеРесурсыПоПодразделениям" Тогда			
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Материалы и оборудование / Распределение потребностей'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'Распределение плана потребностей'");
		КонецЕсли;		
		
	ИначеЕсли ИмяТабличнойЧасти = "РаспределениеОбъемов" Или ИмяТабличнойЧасти = "СубпродуктыПоПодразделениям" Тогда			
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Объемы / Распределение объемов'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'Распределение плана выпуска'");
		КонецЕсли;				
		
	ИначеЕсли ИмяТабличнойЧасти = "РаспределениеДоходов" Или ИмяТабличнойЧасти = "ПланДоходовПоПодразделениям" Тогда			
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Фин. планы / Распределение доходов'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'Распределение плана доходов'");
		КонецЕсли;		
		
	ИначеЕсли ИмяТабличнойЧасти = "РаспределениеРасходов" Или ИмяТабличнойЧасти = "ПланРасходовПоПодразделениям" Тогда			
		
		Если ПредставлениеДляДокумента Тогда
			ПредставлениеТЧ = НСтр("ru = 'Фин. планы / Распределение расходов'");
		Иначе
			ПредставлениеТЧ = НСтр("ru = 'Распределение плана расходов'");
		КонецЕсли;
		
	ИначеЕсли ИмяТабличнойЧасти = "РаспределениеДополнительныхЗатрат" Тогда			
		
		ПредставлениеТЧ = НСтр("ru = 'Распределение дополнительных затрат'");
		
	ИначеЕсли ИмяТабличнойЧасти = "ПланПоступлений" Тогда			
		
		ПредставлениеТЧ = НСтр("ru = 'Фин. планы / План поступлений'");
		
