// Возвращает признак наличия реквизита ИсточникПлана в полученной строке данных.
//
// Параметры:
//  СтрокаДанных - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекция, Структура - проверяемая строка.
//								
// Возвращаемое значение:
//  Булево - признак наличия реквизита.
//
Функция ЕстьРеквизитИсточникПлана(СтрокаДанных)
	
	ЕстьРеквизит = Ложь;
	
	Если ТипЗнч(СтрокаДанных) = Тип("ДанныеФормыЭлементКоллекции")
		Или ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда	
		
		ЕстьРеквизит = СтрокаДанных.Свойство("ИсточникПлана");
		
	Иначе
		
		ШаблонИсточник = Новый Структура("ИсточникПлана", "");
		ЗаполнитьЗначенияСвойств(ШаблонИсточник, СтрокаДанных);
		
		ЕстьРеквизит = ШаблонИсточник.ИсточникПлана <> "";
		
	КонецЕсли;
	
	Возврат ЕстьРеквизит;
	
КонецФункции	

#КонецОбласти