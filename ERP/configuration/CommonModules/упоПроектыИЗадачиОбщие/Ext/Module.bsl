// Возвращает единицу измерения по умолчанию для расчета в формах Проектной задачи и Шаблона проектной задачи.
// 
// Параметры:
//  ЭтаФорма	 - УправляемаяФорма - форма Проектной задачи, форма Шаблона проектной задачи.
//  ЭтоШаблонПроектнойЗадачи - Булево - опреляет, что расчет идет для шаблона проектной задачи.
// 
// Возвращаемое значение:
//  СправочникСсылка.упоЕдиницыВремени - единица измерения.
//
Функция ЕдИзмеренияПоУмолчанию(ЭтаФорма, ЭтоШаблонПроектнойЗадачи = Ложь) Экспорт
	
	Если ЭтаФорма.Объект.ДлительностьБезУчетаКалендаряПроекта Тогда		
		Возврат ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.Сутки");		
	Иначе				
		Если Не ЭтоШаблонПроектнойЗадачи И ЗначениеЗаполнено(ЭтаФорма.ЕдиницаВремениПоУмолчанию) Тогда
			Возврат ЭтаФорма.ЕдиницаВремениПоУмолчанию;
		Иначе
			Возврат ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.РабочийДень");
		КонецЕсли;		
	КонецЕсли;
	
КонецФункции

// Возвращает массив строк подчиненной таблицы по подразделениям.
//
// Параметры:
//  СтрокаВладелец	 	- СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекция - строка владелец.
//  ТаблицаРаспределения - 	ТабличнаяЧасть, ДанныеФормыКоллекция - набор подчиненных строк.
//	ТолькоНаличие	- Булево - признак неполного перебора строк (возврат при первом найденном значении).
//								
// Возвращаемое значение:
//  Массив - строки подчиненной таблицы по подразделениям.
//
Функция ПолучитьСтрокиРаспределенияПоПодразделениям(СтрокаВладелец, ТаблицаРаспределения, ТолькоНаличие = Ложь) Экспорт 
	
	МассивСтрок = Новый Массив;
	
	Если СтрокаВладелец.ИндексСтрокРаспределения = Неопределено Тогда
		Возврат МассивСтрок;
	КонецЕсли;
						
	Для Каждого СтрокаРаспределения Из ТаблицаРаспределения Цикл
		Если СтрокаРаспределения.ИндексСтрокиВладельца = СтрокаВладелец.ИндексСтрокРаспределения Тогда
			МассивСтрок.Добавить(СтрокаРаспределения);
			Если ТолькоНаличие Тогда
				Прервать;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат МассивСтрок;
	
КонецФункции

// Возвращает массив строк подчиненной таблицы по периодам.
//
// Параметры:
//  СтрокаВладелец						 - СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекция - строка владелец.
//  ТаблицаРаспределенияПоПериодам		 - ТабличнаяЧасть, ДанныеФормыКоллекция				 - набор подчиненных строк.
//  ИмяПоляИндексРаспределенияПоПериодам - Строка											 - имя поля связи родителя.
//  ТолькоНаличие						 - Булево											 - признак неполного перебора строк (возврат при первом найденном значении).
//  ИсточникПлана						 - Перечисление.упоИсточникПланаДоходовИРасходов, Неопределено	 - Источник плана
// 
// Возвращаемое значение:
//  Массив - строки подчиненной таблицы по периодам.
//
Функция ПолучитьСтрокиРаспределенияПоПериодам(СтрокаВладелец, 
											ТаблицаРаспределенияПоПериодам, 
											ИмяПоляИндексРаспределенияПоПериодам, 
											ТолькоНаличие = Ложь, 
											ИсточникПлана = Неопределено) Экспорт
									
	МассивСтрок = Новый Массив;
		
	ЕстьИсточникПлана =	ЕстьРеквизитИсточникПлана(СтрокаВладелец);
		
	Если ЕстьИсточникПлана Тогда
		Если ИсточникПлана = Неопределено Тогда
			ИсточникПланаРаспределения = СтрокаВладелец.ИсточникПлана;	
		Иначе	
			ИсточникПланаРаспределения = ИсточникПлана;	
		КонецЕсли;
	Иначе
		ИсточникПланаРаспределения = Неопределено;	
	КонецЕсли;
		
	Для Каждого СтрокаРаспределения Из ТаблицаРаспределенияПоПериодам Цикл
		
		ЭтоПодчиненнаяСтрока = СтрокаРаспределения[ИмяПоляИндексРаспределенияПоПериодам] 
								= СтрокаВладелец.ИндексСтрокРаспределенияПоПериодам;
		Если Не ЭтоПодчиненнаяСтрока Тогда
			Продолжить;
		КонецЕсли;	
										
		Если ЕстьИсточникПлана Тогда
			ЭтоСтрокаИсточника = СтрокаРаспределения.ИсточникПлана = ИсточникПланаРаспределения; 
		Иначе
			ЭтоСтрокаИсточника = Истина;
		КонецЕсли;	
		
		Если Не ЭтоСтрокаИсточника Тогда
			Продолжить;
		КонецЕсли;	
										
		МассивСтрок.Добавить(СтрокаРаспределения);
		
		Если ТолькоНаличие Тогда
			Прервать;
		КонецЕсли;	
				
	КонецЦикла;	
	
	Возврат МассивСтрок;
				
КонецФункции

// Возвращает массив строк подчиненной таблицы по периодам.
//
// Параметры:
//  СтрокаТаблицы	- СтрокаТабличнойЧасти, ДанныеФормыЭлементКоллекция - строка владелец.
//  ТаблицаРаспределения - 	ТабличнаяЧасть, ДанныеФормыКоллекция - набор подчиненных строк распределения.
//  ТаблицаРаспределенияПоПериодам - ТабличнаяЧасть, ДанныеФормыКоллекция - набор подчиненных строк периодов.
//  ИмяПоляИндексРаспределенияПоПериодам - 	Строка - имя поля связи родителя.
//  ИсточникПлана - Перечисление.упоИсточникПланаДоходовИРасходов, Неопределено - Источник плана. Задается при обработке
// 		 табличных частей РаспределениеПотребностей, РаспределениеОбъемов, поскольку в них нет реквизита ИсточникПлана.
//
Процедура УдалитьСтрокуРаспределенияПоПодразделениям(СтрокаТаблицы, 
													ТаблицаРаспределения, 
													ТаблицаРаспределенияПоПериодам, 
													ИмяПоляИндексРаспределенияПоПериодам, 
													ИсточникПлана = Неопределено) Экспорт
	
	СтрокиРаспределенияПоПериодам = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПериодам(СтрокаТаблицы, 
																								ТаблицаРаспределенияПоПериодам, 
																								ИмяПоляИндексРаспределенияПоПериодам, 
																								, 
																								ИсточникПлана);	
	Для Каждого СтрокаРаспределенияПоПериодам Из СтрокиРаспределенияПоПериодам Цикл				
		ТаблицаРаспределенияПоПериодам.Удалить(СтрокаРаспределенияПоПериодам);					
	КонецЦикла; 	
	
	ТаблицаРаспределения.Удалить(СтрокаТаблицы);
	
КонецПроцедуры

// Очищает строки распределения с подчиненными строками периодов.
//
// Параметры:
//  ТаблицаРаспределения - 	ТабличнаяЧасть, ДанныеФормыКоллекция - набор подчиненных строк распределения.
//  ТаблицаРаспределенияПоПериодам - ТабличнаяЧасть, ДанныеФормыКоллекция - набор подчиненных строк периодов.
//  ИмяПоляИндексРаспределенияПоПериодам - 	Строка - имя поля связи родителя.
//  ИсточникПлана - Перечисление.упоИсточникПланаДоходовИРасходов, Неопределено - Источник плана
//
Процедура ОчиститьСтрокиРаспределенияПоПодразделениям(ТаблицаРаспределения, ТаблицаРаспределенияПоПериодам, 
	ИмяПоляИндексРаспределенияПоПериодам, ИсточникПлана = Неопределено) Экспорт
				
	Сч = ТаблицаРаспределения.Количество() - 1;	
	// Очистить распределение.
	Пока Сч >= 0 Цикл 
		СтрокаРаспределения = ТаблицаРаспределения[Сч];
		упоПроектыИЗадачиОбщие.УдалитьСтрокуРаспределенияПоПодразделениям(СтрокаРаспределения, ТаблицаРаспределения, 
			ТаблицаРаспределенияПоПериодам, ИмяПоляИндексРаспределенияПоПериодам, ИсточникПлана);		
		Сч = Сч - 1;	
	КонецЦикла;
	
КонецПроцедуры

// Возвращает префикс для изменения представления для задач с признаком ЗадачаОтменена
//
// Возвращаемое значение:
//	Строка - Префикс
//
Функция ПрефиксОтмененнойЗадачи() Экспорт
	
	Префикс = НСтр("ru = '<ОТМЕНЕНА>'");
	Возврат Префикс;
	
КонецФункции

// Возвращает структуру сроков проектной задачи для передачи в расчетные методы.
//
// Параметры:
//  ДатаНачала		 - Дата - дата начала задачи.
//  ДатаЗавершения	 - Дата - дата завершения задачи.
// 
// Возвращаемое значение:
//  Структура - структура сроков.
//
Функция СтруктураСроки(ДатаНачала, ДатаЗавершения) Экспорт
	
	СтруктураСроки = Новый Структура;
	СтруктураСроки.Вставить("НачалоПлан", ДатаНачала);
	СтруктураСроки.Вставить("ЗавершениеПлан", ДатаЗавершения);
	
	Возврат СтруктураСроки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПрименитьСвойство_ВедетсяБюджетДвиженияДенежныхСредств(Элементы, 
																ВедетсяБюджетДвиженияДенежныхСредств,
																ЭтоФормаСтруктуры = Истина)
		
	Элементы.СтраницаДДС.Видимость = ВедетсяБюджетДвиженияДенежныхСредств;	
		
	Элементы.ВключитьПланДоходовВБДДС.Доступность 	= ВедетсяБюджетДвиженияДенежныхСредств;
	Элементы.ВключитьПланРасходовВБДДС.Доступность 	= ВедетсяБюджетДвиженияДенежныхСредств;	
		
	Если ЭтоФормаСтруктуры Тогда		
		Элементы.СхемаОплатыПоУмолчаниюДоходы.Доступность 	= ВедетсяБюджетДвиженияДенежныхСредств;
		Элементы.СхемаОплатыПоУмолчаниюРасходы.Доступность 	= ВедетсяБюджетДвиженияДенежныхСредств;
	Иначе	
		Элементы.СхемаОплатыБДДСДоход.Доступность 			= ВедетсяБюджетДвиженияДенежныхСредств;
		Элементы.СхемаОплатыБДДСРасход.Доступность 			= ВедетсяБюджетДвиженияДенежныхСредств;
	КонецЕсли;
	
КонецПроцедуры		
		
Процедура ПрименитьСвойство_УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат(Элементы, 
																						УчитыватьПериодРегистрацииНормСтоимости)
		
	Элементы.КнопкаПересчитатьПоНормеТР.Доступность 			= Не УчитыватьПериодРегистрацииНормСтоимости;
	Элементы.ТрудовыеРесурсыСтоимость.ТолькоПросмотр 			= УчитыватьПериодРегистрацииНормСтоимости;
	Элементы.ТрудовыеРесурсыОбщСтоимость.ТолькоПросмотр 		= УчитыватьПериодРегистрацииНормСтоимости;
	Элементы.ТрудовыеРесурсыВнешняяСтоимость.ТолькоПросмотр 	= УчитыватьПериодРегистрацииНормСтоимости;
	Элементы.ТрудовыеРесурсыОбщВнешняяСтоимость.ТолькоПросмотр 	= УчитыватьПериодРегистрацииНормСтоимости;
	
	Если УчитыватьПериодРегистрацииНормСтоимости Тогда
		ЦветНовый = Новый Цвет(135, 135, 135);
	Иначе
		ЦветНовый = Новый Цвет;
	КонецЕсли;
	
	Элементы.ТрудовыеРесурсыСтоимость.ЦветТекстаЗаголовка 			= ЦветНовый;
	Элементы.ТрудовыеРесурсыСтоимость.ЦветТекста 					= ЦветНовый;
	Элементы.ТрудовыеРесурсыСтоимость.ЦветТекстаПодвала 			= ЦветНовый;

	Элементы.ТрудовыеРесурсыОбщСтоимость.ЦветТекстаЗаголовка 		= ЦветНовый;
	Элементы.ТрудовыеРесурсыОбщСтоимость.ЦветТекста 				= ЦветНовый;
	Элементы.ТрудовыеРесурсыОбщСтоимость.ЦветТекстаПодвала 			= ЦветНовый;

	Элементы.ТрудовыеРесурсыВнешняяСтоимость.ЦветТекстаЗаголовка 	= ЦветНовый;
	Элементы.ТрудовыеРесурсыВнешняяСтоимость.ЦветТекста 			= ЦветНовый;
	Элементы.ТрудовыеРесурсыВнешняяСтоимость.ЦветТекстаПодвала 		= ЦветНовый;

	Элементы.ТрудовыеРесурсыОбщВнешняяСтоимость.ЦветТекстаЗаголовка = ЦветНовый;
	Элементы.ТрудовыеРесурсыОбщВнешняяСтоимость.ЦветТекста 			= ЦветНовый;
	Элементы.ТрудовыеРесурсыОбщВнешняяСтоимость.ЦветТекстаПодвала 	= ЦветНовый;		
		
КонецПроцедуры

Процедура ПрименитьСвойство_ПланироватьТрудозатратыПоПроекту(Элементы, 
		ПланироватьТрудозатратыПоПроекту)

	Элементы.СтраницаТрудовыеРесурсы.Видимость 	= ПланироватьТрудозатратыПоПроекту;		
	Элементы.СтраницаИсполнители.Видимость 		= ПланироватьТрудозатратыПоПроекту;
	Элементы.СтраницаМашиныМеханизмы.Видимость 	= ПланироватьТрудозатратыПоПроекту;

КонецПроцедуры

Функция УчетСубпродуктовПоПодразделениям(СтруктураСвойств, ВключитьСубпродуктыВПланДоходов)
	
	Возврат СтруктураСвойств.ДоходыПоПодразделениям 
			И (ВключитьСубпродуктыВПланДоходов Или СтруктураСвойств.ДоходыПоНатуральнымПоказателям);	
	
КонецФункции	

Функция УчетДоходныхОбъемовПоПодразделениям(СтруктураСвойств, ВключитьСубпродуктыВПланДоходов)
	
	Возврат (ВключитьСубпродуктыВПланДоходов И СтруктураСвойств.ДоходыПоОбъемам) 
			Или СтруктураСвойств.ДоходыПоНатуральнымПоказателям;	
	
КонецФункции

Функция УчетМатРесурсовПоПодразделениям(СтруктураСвойств, ВключитьМатРесурсыВПланРасходов)
	
	Возврат СтруктураСвойств.РасходыПоПодразделениям
			И (ВключитьМатРесурсыВПланРасходов Или СтруктураСвойств.РасходыПоОбъемам);	
	
КонецФункции
			
Функция ЭтоЗадачаСФинансами(СтруктураСвойств)

	ЗадачаБезФинансов = Не СтруктураСвойств.ВедетсяБюджетДвиженияДенежныхСредств
		И Не СтруктураСвойств.ВедетсяБюджетДоходов
		И Не СтруктураСвойств.ВедетсяБюджетРасходов;
	
	Возврат Не ЗадачаБезФинансов;

КонецФункции // ()

Функция ЭтоСпособПривязкиПоПрофилю(СпособПривязки)	
	
	Если СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения") Тогда
		Возврат Истина;
	ИначеЕсли СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения") Тогда
		Возврат Истина;
	ИначеЕсли СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиСхемОплаты.ПоПрофилюРаспределения") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

Функция ЭтоСпособПривязкиНаДату(СпособПривязки)	
	
	Если СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.НаДату") Тогда
		Возврат Истина;
	ИначеЕсли СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.НаДату") Тогда
		Возврат Истина;
	ИначеЕсли СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиСхемОплаты.НаДату") Тогда
		Возврат Истина;
	ИначеЕсли СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НаДату") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

Функция ИмяПоляДляСообщения(ИмяТабличнойЧасти, НомерСтроки, ИмяПоля)
	
