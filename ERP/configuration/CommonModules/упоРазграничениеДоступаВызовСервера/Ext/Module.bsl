// Корректирует правила в соответствии с доп. свойствами объекта.
//
// Параметры:
//  ПравилаОбъекта	 - Структура	 - правила разграничения объекта.
//  ЭтотОбъект		 - Произвольный	 - объект, у которого проверяем доп. свойства и правила которого корректируем.
//
Процедура КорректироватьПравилаРазграниченияОбъекта(ПравилаОбъекта, ЭтотОбъект)
	
	Если ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект." + Метаданные.Документы.упоСохранениеДанныхПроекта.Имя) Тогда
		
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ЕстьПравоИзменятьЧужиеПроектныеЗадачи")
			И ЭтотОбъект.ДополнительныеСвойства.ЕстьПравоИзменятьЧужиеПроектныеЗадачи = Истина Тогда
			
			Если ПравилаОбъекта.Свойство("РуководителиПроектныхЗадач") 
				И ТипЗнч(ПравилаОбъекта.РуководителиПроектныхЗадач) = Тип("Структура")
				И ПравилаОбъекта.РуководителиПроектныхЗадач.Свойство("Прочие") Тогда
				
				ПравилаОбъекта.РуководителиПроектныхЗадач.Удалить("Прочие")
			
			КонецЕсли;
		
		КонецЕсли;
		
	// Если проводится документ ПЗ, созданный вручную или полученный при разворачивании из шаблона, 
	// то его свойства еще не записаны. Поэтому родителя для определения РПЭ берем непосредственно из документа.	
	ИначеЕсли ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект." + Метаданные.Документы.упоПроектнаяЗадача.Имя) Тогда
				
		ПравилаОбъекта.Вставить("ПроектнаяЗадачаРодитель", ЭтотОбъект.ЗадачаРодитель);					
			
	КонецЕсли;
	
КонецПроцедуры

// Функция по заданному набору правил документа, запрашивает необходимые данные из БД.
// 
// Параметры:
//  Правила - Структура, сформированный набор правил, в начале структуры идут параметры документа,
//                            затем структура набора правил: ОписаниеПравила - Структура,
//                            содержит поля вида: название правила и его значение.
// 
// Возвращаемое значение:
//	Структура - сформированный набор параметров для правил.
// 
Функция ПолучитьДанныеРазграничения(Правила)
	
	Данные = Новый Структура;
	Данные.Вставить("СтатусПроекта");
	Данные.Вставить("СтатусыПроектов");
	
	Данные.Вставить("СтатусПроектнойЗадачи");
	Данные.Вставить("СтатусыПроектныхЗадач");
	
	Данные.Вставить("РуководительПроекта");
	Данные.Вставить("РуководителиПроектов");
	
	Данные.Вставить("РуководительПроектнойЗадачи");
	Данные.Вставить("РуководителиПроектныхЗадач");
	
	Данные.Вставить("РуководительПроектногоЭтапа");	
	
	Данные.Вставить("АктуализацияПроекта");	
	
	Запрос = Новый Запрос;
	
	ТекВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Правила.Проект);
	
	Запрос.УстановитьПараметр("Проект"         , Правила.Проект);
	Запрос.УстановитьПараметр("текВерсия"      , ТекВерсияПроекта);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", Правила.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("Объект"         , Правила.ОбъектБазовогоПлана);
	
	Если Не Правила.Проект = Неопределено Тогда
		// Получим статус проекта.
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтатусыПроектов.СтатусПроекта
			|ИЗ
			|	РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект = &Проект) КАК СтатусыПроектов";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Данные.Вставить("СтатусПроекта", РезультатЗапроса.Выгрузить()[0].СтатусПроекта);
		КонецЕсли;
		
	КонецЕсли;	
	
	Если Не Правила.ПроектнаяЗадача = Неопределено Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СтатусыПроектныхЗадач.СтатусЗадачи КАК СтатусЗадачи
			|ИЗ
			|	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
			|			,
			|			Версия = &текВерсия
			|				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК СтатусыПроектныхЗадач";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Данные.Вставить("СтатусПроектнойЗадачи", РезультатЗапроса.Выгрузить()[0].СтатусЗадачи);
		КонецЕсли;
	КонецЕсли;
				
	// Получим данные по руководителю проекта.
	Если НЕ Правила.Проект = Неопределено Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РуководителиПроектов.РуководительПроекта
			|ИЗ
			|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(, Проект = &Проект) КАК РуководителиПроектов";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Данные.Вставить("РуководительПроекта", РезультатЗапроса.Выгрузить()[0].РуководительПроекта);
		КонецЕсли;
	КонецЕсли;
	
	// Получим данные по руководителям и статусам проектов.
	Если НЕ Правила.МассивПроектов = Неопределено Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РуководителиПроектов.Проект,
			|	РуководителиПроектов.РуководительПроекта
			|ИЗ
			|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(, Проект В (&МассивПроектов)) КАК РуководителиПроектов
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	упоСтатусыПроектовСрезПоследних.Проект,
			|	упоСтатусыПроектовСрезПоследних.СтатусПроекта
			|ИЗ
			|	РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект В (&МассивПроектов)) КАК упоСтатусыПроектовСрезПоследних";			
		Запрос.УстановитьПараметр("МассивПроектов", Правила.МассивПроектов); 	
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		Данные.Вставить("РуководителиПроектов", РезультатЗапроса[0].Выгрузить());	
		Данные.Вставить("СтатусыПроектов", РезультатЗапроса[1].Выгрузить());	
	КонецЕсли;	
	
	// Получим данные по руководителю проектной задачи и этапа-родителя.
	Если НЕ Правила.ПроектнаяЗадача = Неопределено Тогда
		
		// РПЗ
		
		РПЗ = упоИерархияИПолномочияСервер.ПолучитьВсехРуководителейПроектнойЗадачиПоИерархии(Правила.ПроектнаяЗадача);
		Данные.Вставить("РуководительПроектнойЗадачи", РПЗ);
		
		// РПЭ
		
		РПЭ = Неопределено;
		
		Если Правила.Свойство("ПроектнаяЗадачаРодитель") Тогда 			
			РПЭ = упоИерархияИПолномочияСервер.ПолучитьРуководителяПроектнойЗадачиПоИерархии(Правила.ПроектнаяЗадачаРодитель);										
		Иначе				
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			               |	упоРуководителиПроектныхЗадачАктуальные.РуководительПроектнойЗадачи КАК РуководительПроектногоЭтапа
			               |ИЗ
			               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
			               |			,
			               |			Версия = &ТекВерсия
			               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК упоРуководителиПроектныхЗадачАктуальные
			               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = упоРуководителиПроектныхЗадачАктуальные.ПроектнаяЗадача";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда				
				РПЭ = Выборка.РуководительПроектногоЭтапа;
			КонецЕсли;			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(РПЭ) Тогда	
			Данные.Вставить("РуководительПроектногоЭтапа", РПЭ); 
		КонецЕсли;
			
	КонецЕсли;
	
	// Получим данные по руководителям проектных задач.
	Если НЕ Правила.МассивПроектныхЗадач = Неопределено Тогда
		ТаблицаПЗ = ПолучитьРуководителейПЗ(Правила.МассивПроектныхЗадач, ТекВерсияПроекта);
		Данные.Вставить("РуководителиПроектныхЗадач", ТаблицаПЗ);
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоПроектнаяЗадача.Ссылка КАК ПроектнаяЗадача,
		               |	упоПроектнаяЗадача.Проект КАК Проект
		               |ПОМЕСТИТЬ ПроектныеЗадачиСПроектами
		               |ИЗ
		               |	Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
		               |ГДЕ
		               |	упоПроектнаяЗадача.Ссылка В(&МассивЗадач)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ПроектныеЗадачиСПроектами.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	упоВерсииПроекта.Версия КАК Версия
		               |ПОМЕСТИТЬ ТекущиеВерсииПроектныхЗадач
		               |ИЗ
		               |	ПроектныеЗадачиСПроектами КАК ПроектныеЗадачиСПроектами
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		               |		ПО ПроектныеЗадачиСПроектами.Проект = упоВерсииПроекта.Проект
		               |			И (упоВерсииПроекта.Текущая)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачи
		               |ИЗ
		               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
		               |			,
		               |			(Версия, ПроектнаяЗадача) В
		               |				(ВЫБРАТЬ
		               |					ТекущиеВерсииПроектныхЗадач.Версия,
		               |					ТекущиеВерсииПроектныхЗадач.ПроектнаяЗадача
		               |				ИЗ
		               |					ТекущиеВерсииПроектныхЗадач)) КАК упоСтатусыПроектныхЗадачСрезПоследних";
		Запрос.УстановитьПараметр("МассивЗадач", Правила.МассивПроектныхЗадач);					   
		Данные.Вставить("СтатусыПроектныхЗадач", Запрос.Выполнить().Выгрузить());		

	КонецЕсли;
	
	Если Правила.Свойство("АктуализацияПроекта") Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Док.Ссылка
			|ИЗ
			|	Документ.упоАктуализацияПроекта КАК Док
			|ГДЕ
			|	Док.Проект = &Проект
			|	И Док.Проведен
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Док.Ссылка
			|ИЗ
			|	Документ.упоРучнаяАктуализацияПроекта КАК Док
			|ГДЕ
			|	Док.Проект = &Проект
			|	И Док.Проведен";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Данные.Вставить("АктуализацияПроекта", Истина);
		Иначе
			Данные.Вставить("АктуализацияПроекта", Ложь);
		КонецЕсли;
	КонецЕсли;
		
	Возврат Данные;
	
КонецФункции

Функция ПолучитьЗадачиРучнойАктуализации(Ссылка)
