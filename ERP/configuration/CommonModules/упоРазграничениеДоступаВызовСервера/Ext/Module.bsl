						НашлосьОграничение = Истина;
						Продолжить;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;				
			
		КонецЦикла;
		
		Если НашлосьОграничение Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЕсли; // Правило по статусам проектных задач.	
	
	Возврат Ложь;
	
КонецФункции	

