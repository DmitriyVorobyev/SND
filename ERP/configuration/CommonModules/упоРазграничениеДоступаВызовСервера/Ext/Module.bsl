Функция ПолучитьРуководителейПЗ(МассивПЗ, ТекВерсия)
	
	ТаблицаПЗ = Новый ТаблицаЗначений;
	ТаблицаПЗ.Колонки.Добавить("ПроектнаяЗадача", Новый ОписаниеТипов("ДокументСсылка.упоПроектнаяЗадача"));
	Для Каждого ПЗ Из МассивПЗ Цикл
		ТаблицаПЗ.Добавить().ПроектнаяЗадача = ПЗ;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПЗ", ТаблицаПЗ);
	Запрос.УстановитьПараметр("МассивЗадач", МассивПЗ);
	Запрос.УстановитьПараметр("ТекВерсия", ТекВерсия);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ ТаблицаПЗ
	               |ИЗ
	               |	&ТаблицаПЗ КАК ТаблицаПЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоРуководителиПроектныхЗадачАктуальные.РуководительПроектнойЗадачи КАК РуководительПроектногоЭтапа
	               |ПОМЕСТИТЬ РуководителиПроектныхЭтапов
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &ТекВерсия
	               |				И ПроектнаяЗадача В (&МассивЗадач)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК упоРуководителиПроектныхЗадачАктуальные
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = упоРуководителиПроектныхЗадачАктуальные.ПроектнаяЗадача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоРуководителиПроектныхЗадачАктуальные.РуководительПроектнойЗадачи КАК Руководитель,
	               |	упоРуководителиПроектовСрезПоследних.РуководительПроекта КАК РуководительПроекта,
	               |	РуководителиПроектныхЭтапов.РуководительПроектногоЭтапа КАК РуководительПроектногоЭтапа
	               |ИЗ
	               |	ТаблицаПЗ КАК ТаблицаПЗ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК упоРуководителиПроектныхЗадачАктуальные
	               |		ПО ТаблицаПЗ.ПроектнаяЗадача = упоРуководителиПроектныхЗадачАктуальные.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних КАК упоРуководителиПроектовСрезПоследних
	               |		ПО ТаблицаПЗ.ПроектнаяЗадача.Проект = упоРуководителиПроектовСрезПоследних.Проект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РуководителиПроектныхЭтапов КАК РуководителиПроектныхЭтапов
	               |		ПО ТаблицаПЗ.ПроектнаяЗадача = РуководителиПроектныхЭтапов.ПроектнаяЗадача";				   
				   
	ТаблицаПЗ = Запрос.Выполнить().Выгрузить();
	ТаблицаПЗ.Индексы.Добавить("Руководитель");
	
	Возврат ТаблицаПЗ;				   
					   
КонецФункции   					   

Функция обЗапретитьРедактированиеРеквизитовПроекта(Проект, СтатусПроекта, ТолькоПросмотр) Экспорт
	
	Если Не ЗначениеЗаполнено(СтатусПроекта) Тогда
		Возврат ТолькоПросмотр;
	КонецЕсли;
	
	РуководительКураторПроекта = упоИерархияИПолномочияСервер.ПолучитьРуководителяИКуратораПроекта(Проект);
	Результат = ТолькоПросмотр Или Не (упоРесурсыИРолиВызовСервера.обУправляетсяДиспетчером(ПользователиКлиентСервер.АвторизованныйПользователь(), РуководительКураторПроекта.РуководительПроекта) 
							Или упоРесурсыИРолиВызовСервера.обУправляетсяДиспетчером(ПользователиКлиентСервер.АвторизованныйПользователь(), РуководительКураторПроекта.КураторПроекта)
							Или РольДоступна("упоРедактированиеКарточекПроектов")
							Или РольДоступна("ПолныеПрава")
							Или РазграничениеДоступаОтключено());	
	Возврат Результат;
	
КонецФункции

Функция ПроектПроектныеЗадачиДокумента(Ссылка, ПроверятьШапку = Истина, ПроверятьТабЧасти = Ложь)
	
	ПроектныеДанные = Новый Структура("Проект, ПроектнаяЗадача, МассивПроектов, МассивПроектныхЗадач");		
	
	ТолькоШапка = ПроверятьШапку И Не ПроверятьТабЧасти;
	
	Если Не ТолькоШапка Тогда
		ПроектныеДанные.МассивПроектов = Новый Массив;
		ПроектныеДанные.МассивПроектныхЗадач = Новый Массив;		
	КонецЕсли;
			
	ПоляЗапроса = Новый Структура;
	
	ТипПроектнаяЗадача = Тип("ДокументСсылка.упоПроектнаяЗадача");
	
	МетаДок = Ссылка.Метаданные();	
	Если ПроверятьШапку Тогда
		Для Каждого Реквизит Из МетаДок.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(ТипПроектнаяЗадача) Тогда			
				ПоляЗапроса.Вставить("Шапка", Реквизит.Имя);
			КонецЕсли;				
		КонецЦикла;
	КонецЕсли;		
	Если ПроверятьТабЧасти Тогда
		Для Каждого ТабЧасть Из МетаДок.ТабличныеЧасти Цикл
			СтруктураТЧ = Новый Структура(ТабЧасть.Имя);
			МассивПолей = Новый Массив;
			Для Каждого Реквизит Из ТабЧасть.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипПроектнаяЗадача) Тогда
					ПоляЗапроса.Вставить(ТабЧасть.Имя, Реквизит.Имя);
				КонецЕсли;	
			КонецЦикла;		
		КонецЦикла;
	КонецЕсли;	
		
	ТекстыЗапроса = Новый Массив;
	
	Для Каждого ЭлементСтруктуры Из ПоляЗапроса Цикл
		Если ПроверятьШапку И ЭлементСтруктуры.Ключ = "Шапка" Тогда
			ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"ВЫБРАТЬ
				|	Документ.%1 КАК ПроектнаяЗадача,
				|	Документ.%1.Проект КАК Проект
				|ИЗ
				|	Документ.%2 КАК Документ
				|ГДЕ
	        	|	Документ.Ссылка = &Ссылка
				|", ЭлементСтруктуры.Значение, МетаДок.Имя);
			ТекстыЗапроса.Добавить(ТекстЗапроса);
		Иначе 
			ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				"ВЫБРАТЬ РАЗЛИЧНЫЕ				
				|	Документ.%1 КАК ПроектнаяЗадача,
				|	Документ.%1.Проект КАК Проект
				|ИЗ
				|	Документ.%2.%3 КАК Документ
				|ГДЕ
	        	|	Документ.Ссылка = &Ссылка
				|", ЭлементСтруктуры.Значение, МетаДок.Имя, ЭлементСтруктуры.Ключ);
			ТекстыЗапроса.Добавить(ТекстЗапроса);
		КонецЕсли;	
	КонецЦикла;	
	
	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, 
		"ОБЪЕДИНИТЬ ВСЕ
		|");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить();			
	Если Результат.Пустой() Тогда
		Возврат ПроектныеДанные;
	КонецЕсли;	
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл		
		Если ТолькоШапка Тогда
			ПроектныеДанные.ПроектнаяЗадача = Выборка.ПроектнаяЗадача;
			ПроектныеДанные.Проект = Выборка.Проект;
		Иначе	
			Если ПроектныеДанные.МассивПроектныхЗадач.Найти(Выборка.ПроектнаяЗадача) = Неопределено Тогда
				ПроектныеДанные.МассивПроектныхЗадач.Добавить(Выборка.ПроектнаяЗадача);
			КонецЕсли;
			Если ПроектныеДанные.МассивПроектов.Найти(Выборка.Проект) = Неопределено Тогда
				ПроектныеДанные.МассивПроектов.Добавить(Выборка.Проект);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
		
	Возврат ПроектныеДанные;
	
КонецФункции

// Ищем правила для разграничения по владению.
Функция ЕстьОграничениеПоВладению(Правила, Данные, ЭтотОбъект, ПрерватьВыполнение,
	Режим, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав)  
	
	ПрерватьВыполнение = Ложь;
	ОписаниеПравила = Неопределено;
	ВидОграничения	= Неопределено;
	
	// Получим список сотрудников, которыми управляет текущий пользователь.
	СписокСотрудников = упоИерархияИПолномочияСервер.СотрудникиДиспетчера(Пользователи.ТекущийПользователь(), Истина);
	
	// Ищем правило для разграничения по руководителям проектных задач.
	Если Правила.Свойство("РуководителиПроектныхЗадач", ОписаниеПравила) Тогда
		
		НетРазрешений = Ложь;
		
		МассивСообщений = Новый Массив;
		МассивСообщений.Добавить(
			СтрШаблон(НСтр("ru = 'Пользователь ""%1"" не имеет полномочий на выполнение этой операции с задачами:'"),
				Пользователи.ТекущийПользователь()));
		
		СтрокаСообщения = НСтр("ru = '	- %1 (%2)'");
		
		Для Каждого СтрокаПроектнойЗадачи Из Данные.РуководителиПроектныхЗадач Цикл
			
			Если _ЕстьВСписке(СписокСотрудников, СтрокаПроектнойЗадачи.РуководительПроекта) Тогда
				Если ОписаниеПравила.Свойство("РП", ВидОграничения) Тогда
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(СтрокаПроектнойЗадачи.ПроектнаяЗадача);
						МассивСообщений.Добавить(СтрШаблон(СтрокаСообщения, Зеркало, СтрокаПроектнойЗадачи.ПроектнаяЗадача));
						
						НетРазрешений = Истина;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли _ЕстьВСписке(СписокСотрудников, СтрокаПроектнойЗадачи.Руководитель) Тогда
				Если ОписаниеПравила.Свойство("РПЗ", ВидОграничения) Тогда
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(СтрокаПроектнойЗадачи.ПроектнаяЗадача);
						МассивСообщений.Добавить(СтрШаблон(СтрокаСообщения, Зеркало, СтрокаПроектнойЗадачи.ПроектнаяЗадача));
						
						НетРазрешений = Истина;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли _ЕстьВСписке(СписокСотрудников, СтрокаПроектнойЗадачи.РуководительПроектногоЭтапа) Тогда
				Если ОписаниеПравила.Свойство("РПЭ", ВидОграничения) Тогда
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(СтрокаПроектнойЗадачи.ПроектнаяЗадача);
						МассивСообщений.Добавить(СтрШаблон(СтрокаСообщения, Зеркало, СтрокаПроектнойЗадачи.ПроектнаяЗадача));
						
						НетРазрешений = Истина;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если ОписаниеПравила.Свойство("Прочие", ВидОграничения) Тогда
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(СтрокаПроектнойЗадачи.ПроектнаяЗадача);
						МассивСообщений.Добавить(СтрШаблон(СтрокаСообщения, Зеркало, СтрокаПроектнойЗадачи.ПроектнаяЗадача));
						
						НетРазрешений = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НетРазрешений Тогда
			ОбработатьОграничение(СтрСоединить(МассивСообщений, Символы.ПС), Отказ, Заголовок, 
				ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
			ПрерватьВыполнение = Истина;
			Возврат Истина;
		КонецЕсли;
		
	/////////////////////////////////////////////////////
		
	// Ищем правило для разграничения по руководителю проектной задачи.
	ИначеЕсли Правила.Свойство("РуководительПроектнойЗадачи", ОписаниеПравила) Тогда
		
		СтрокаСообщения = НСтр("ru = 'Пользователь ""%1"" не имеет полномочий на выполнение этой операции.'"); 
		
		ЕстьРПЗ = _ЕстьВСписке(СписокСотрудников, Данные.РуководительПроектнойЗадачи);
		ЕстьРПЭ = _ЕстьВСписке(СписокСотрудников, Данные.РуководительПроектногоЭтапа);
		
		Если _ЕстьВСписке(СписокСотрудников, Данные.РуководительПроекта) Тогда
			Если ОписаниеПравила.Свойство("РП", ВидОграничения) Тогда
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
												
					СтрокаСообщения = 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());	
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;

				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЕстьРПЗ Или ЕстьРПЭ Тогда
			
			ЕстьПраваРПЗ = ЕстьРПЗ;
			Если ЕстьРПЗ И ОписаниеПравила.Свойство("РПЗ", ВидОграничения) Тогда						
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда														
					ЕстьПраваРПЗ = Ложь;
				КонецЕсли;			
			КонецЕсли;
													
			ЕстьПраваРПЭ = ЕстьРПЭ;
			Если ЕстьРПЭ И ОписаниеПравила.Свойство("РПЭ", ВидОграничения) Тогда						
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда														
					ЕстьПраваРПЭ = Ложь;
				КонецЕсли;			
			КонецЕсли;

			Если Не (ЕстьПраваРПЗ Или ЕстьПраваРПЭ) Тогда
														
				СтрокаСообщения =
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());
				ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
				
				ПрерватьВыполнение = Истина;
				Возврат Истина;
				
			КонецЕсли;	
						
		Иначе
			Если ОписаниеПравила.Свойство("Прочие", ВидОграничения) Тогда						
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
												
					СтрокаСообщения =
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;

				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	// Ищем правило для разграничения по руководителю проекта.
	ИначеЕсли Правила.Свойство("РуководительПроекта", ОписаниеПравила) Тогда
		
		СтрокаСообщения = НСтр("ru = 'Пользователь ""%1"" не имеет полномочий на выполнение этой операции.'");
		
		Если _ЕстьВСписке(СписокСотрудников, Данные.РуководительПроекта) Тогда
			Если ОписаниеПравила.Свойство("РП", ВидОграничения) Тогда						
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
												
					СтрокаСообщения =
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;
					
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоРасчетКалендарногоПланаПроекта") 
			ИЛИ (ТипЗнч(ЭтотОбъект) = Тип("ДанныеФормыСтруктура")
			И ТипЗнч(ЭтотОбъект.Ссылка) = Тип("ДокументСсылка.упоРасчетКалендарногоПланаПроекта")) Тогда 
			ТаблицаРуководителейПЗ = упоИерархияИПолномочияСервер.ПолучитьРуководителейПроектныхЗадачПроекта(ЭтотОбъект.Проект);				
			
			Если ТаблицаРуководителейПЗ <> Неопределено Тогда
				
				Для Каждого Сотрудник Из СписокСотрудников Цикл					
					Если ТаблицаРуководителейПЗ.Найти(Сотрудник.Значение, "РуководительПроектнойЗадачи") <> Неопределено Тогда						
						
						ПрерватьВыполнение = Истина;
						Возврат Ложь;												
						
					КонецЕсли;					
				КонецЦикла; 
				
			КонецЕсли; 
		ИначеЕсли  ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоРегистрацияПроекта") 
			ИЛИ ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоУтверждениеПланаПроекта")
			ИЛИ ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоЗавершениеПроекта")
			ИЛИ ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоВозобновлениеПроекта")
			ИЛИ ТипЗнч(ЭтотОбъект) = Тип("ДокументОбъект.упоСтартПроектныхРабот") Тогда
			
			Если Пользователи.ЭтоПолноправныйПользователь( , , Ложь) Тогда
				ПрерватьВыполнение = Истина;
				Возврат Ложь;	
			КонецЕсли;	
			
			Если Данные.РуководительПроекта <> Неопределено Тогда
				РуководительПроекта = Данные.РуководительПроекта;
			Иначе 
				РуководительПроекта = ЭтотОбъект.РуководительПроекта;
			КонецЕсли;
			
			Если Не _ЕстьВСписке(СписокСотрудников, РуководительПроекта) Тогда
				
				СтрокаСообщения =
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());
				ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
				
				ПрерватьВыполнение = Истина;
				Возврат Истина;
				
			КонецЕсли;	
		Иначе
			Если ОписаниеПравила.Свойство("Прочие", ВидОграничения) Тогда						
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
												
					СтрокаСообщения = 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь());
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);										
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;					
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		
	// Ищем правило для разграничения по руководителям проектов.
	ИначеЕсли Правила.Свойство("РуководителиПроектов", ОписаниеПравила) Тогда
		
		Для Каждого Проект Из Правила.МассивПроектов Цикл
			
			ДанныеРП = Данные.РуководителиПроектов.Найти(Проект, "Проект"); 
			
			Если ДанныеРП = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаСообщения = НСтр("ru = 'Пользователь ""%1"" не имеет полномочий на выполнение этой операции с проектом ""%2"".'");
			
			Если _ЕстьВСписке(СписокСотрудников, ДанныеРП.РуководительПроекта) Тогда
				Если ОписаниеПравила.Свойство("РП", ВидОграничения) Тогда							
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
														
						СтрокаСообщения =
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь(), Проект);
						ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
						
						ПрерватьВыполнение = Истина;
						Возврат Истина;
																		
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если ОписаниеПравила.Свойство("Прочие", ВидОграничения) Тогда							
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
														
						СтрокаСообщения = 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, Пользователи.ТекущийПользователь(), Проект);
						ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
						
						ПрерватьВыполнение = Истина;
						Возврат Истина;												
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;					
	
	Возврат Ложь;
	
КонецФункции

// Ищем правило для разграничения по статусу/статусам проектных задач.
Функция ЕстьОграничениеПоСтатусамЗадач(Правила, Данные, ЭтотОбъект, ПрерватьВыполнение,
	Режим, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав)  
		
	ПрерватьВыполнение = Ложь;
	ОписаниеПравила = Неопределено;
	ВидОграничения	= Неопределено;

	// Ищем правило для разграничения по статусу проектной задачи.
	Если Правила.Свойство("СтатусПроектнойЗадачи", ОписаниеПравила) Тогда
					
		Если ОписаниеПравила.Свойство("Запланирована", ВидОграничения) Тогда
			Если Данные.СтатусПроектнойЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Запланирована Тогда
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
					
					СтрокаСообщения = НСтр("ru = 'Проектная задача находится в состоянии ""Запланирована"".'");
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ОписаниеПравила.Свойство("Выполняется", ВидОграничения) Тогда
			Если Данные.СтатусПроектнойЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Выполняется Тогда					
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
					
					СтрокаСообщения = НСтр("ru = 'Проектная задача находится в состоянии ""Выполняется"".'");
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ОписаниеПравила.Свойство("Завершена", ВидОграничения) Тогда
			Если Данные.СтатусПроектнойЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Завершена Тогда					
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
					
					СтрокаСообщения = НСтр("ru = 'Проектная задача находится в состоянии ""Завершена"".'");
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ОписаниеПравила.Свойство("Закрыта", ВидОграничения) Тогда
			Если Данные.СтатусПроектнойЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Закрыта Тогда					
				Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
					
					СтрокаСообщения = НСтр("ru = 'Проектная задача находится в состоянии ""Закрыта"".'");
					ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
					
					ПрерватьВыполнение = Истина;
					Возврат Истина;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;			
		
	КонецЕсли; // Правило по статусу проектной задачи.
	
	// Ищем правило для разграничения по статусам проектных задач.
	Если Правила.Свойство("СтатусыПроектныхЗадач", ОписаниеПравила) Тогда
		
		НашлосьОграничение = Ложь;
		
		ШаблонСообщения = НСтр("ru = 'Проектная задача ""%1"" (%2) находится в состоянии ""%3"".'");
		
		Для Каждого ПроектнаяЗадача Из Правила.МассивПроектныхЗадач Цикл							
			
			ДанныеСтатуса = Данные.СтатусыПроектныхЗадач.Найти(ПроектнаяЗадача, "ПроектнаяЗадача");
			
			Если ДанныеСтатуса = Неопределено Тогда
				Продолжить;
			КонецЕсли;											
			
			Если ОписаниеПравила.Свойство("Запланирована", ВидОграничения) Тогда
				Если ДанныеСтатуса.СтатусЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Запланирована Тогда
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						
						Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(ПроектнаяЗадача);
													
						СтрокаСообщения = СтрШаблон(ШаблонСообщения, Зеркало, ПроектнаяЗадача, "Запланирована");
						ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
						
						НашлосьОграничение = Истина;
						Продолжить;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ОписаниеПравила.Свойство("Выполняется", ВидОграничения) Тогда
				Если ДанныеСтатуса.СтатусЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Выполняется Тогда						
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						
						Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(ПроектнаяЗадача);
						                                                            							
						СтрокаСообщения = СтрШаблон(ШаблонСообщения, Зеркало, ПроектнаяЗадача, "Выполняется");
						ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
						
						НашлосьОграничение = Истина;
						Продолжить;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ОписаниеПравила.Свойство("Завершена", ВидОграничения) Тогда
