#Область ПрограммныйИнтерфейс

// Базовая Функция. Для заданного документа по его правилам определяет отказ от текущего режима документа.
// 
// Параметры:
//  ЭтотОбъект - ДокументОбъект - документ.
//  Режим     - РежимЗаписиДокумента, Строка - Если режим записи, то проведение или отмена проведения.
//				Если строка, то режим открытия формы (используется по умолчанию).
//  Отказ     - Булево - признак отказа от режима документа.
//  Заголовок - Строка - текст заголовка сообщения.
//	ВыводитьСообщенияОРазграниченииПрав - Булево - признак необходимости выводить сообщения о разграничении прав.
//											По умолчанию = ложь и запись делается только в ЖР.
// 
// Возвращаемое значение:
//  Булево - признак отказа.
//
Функция обПроверитьПравилаРазграничения(ЭтотОбъект, Режим = "Форма", Отказ = Ложь, Заголовок = "", 
	ВыводитьСообщенияОРазграниченииПрав = Ложь) Экспорт
		
	// Если уже был отказ, то отменяем действия функции.
	Если Отказ = Истина Тогда
		Возврат ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Проверка правил доступа может быть директивно отключена
	// либо администратором ИБ (при помощи константы)
	// либо разработчиком, временно, для проведения некоей операции (при помощи параметра сеанса).
		
	Если РазграничениеДоступаОтключено() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Получим правила для данного документа.
	ПравилаОбъекта = ПолучитьПравилаРазграничения(ЭтотОбъект.Ссылка);
	// Скорректируем правила в соответствии с доп. свойствами объекта.
	КорректироватьПравилаРазграниченияОбъекта(ПравилаОбъекта, ЭтотОбъект);
		
	Если ПравилаОбъекта = Неопределено Тогда
		// Для данного документа правила не имеют смысла.
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТипЗнч(ПравилаОбъекта) = Тип("Массив") Тогда
		ВсеПравила = ПравилаОбъекта;
	Иначе
		ВсеПравила = Новый Массив;
		ВсеПравила.Добавить(ПравилаОбъекта);
	КонецЕсли;
		
	Для Каждого Правила Из ВсеПравила Цикл
		
		// Получим данные для разграничения правил данного документа.
		Данные = ПолучитьДанныеРазграничения(Правила);
			
		ОписаниеПравила = Неопределено;
		ВидОграничения	= Неопределено;
		
		// Ищем правило для разграничения по существованию актуализации проекта.
		Если Правила.Свойство("АктуализацияПроекта", ОписаниеПравила) Тогда
			Если Данные.АктуализацияПроекта = Истина Тогда
				Если ОписаниеПравила.Свойство("Есть", ВидОграничения) Тогда				
					Если _ЕстьОграничение(Режим, ВидОграничения) Тогда
						
						СтрокаСообщения = НСтр("ru = 'По этому проекту уже была проведена актуализация.'");
						ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав, ЭтотОбъект.Ссылка);
						
						Возврат Истина;
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;					
		
		ПрерватьВыполнение = Ложь;
		
		НашлосьОграничение = ЕстьОграничениеПоСтатусамПроектов(Правила, 
																Данные, 
																ЭтотОбъект, 
																ПрерватьВыполнение, 
																Режим, 
																Отказ, 
																Заголовок, 
																ВыводитьСообщенияОРазграниченииПрав);
		Если ПрерватьВыполнение Тогда
			Возврат НашлосьОграничение;
		КонецЕсли;		
				
		НашлосьОграничение = ЕстьОграничениеПоСтатусамЗадач(Правила, 
																Данные, 
																ЭтотОбъект, 
																ПрерватьВыполнение, 
																Режим, 
																Отказ, 
																Заголовок, 
																ВыводитьСообщенияОРазграниченииПрав);
		Если ПрерватьВыполнение Тогда
			Возврат НашлосьОграничение;
		КонецЕсли;
				
		НашлосьОграничение = ЕстьОграничениеПоВладению(Правила, 
																Данные, 
																ЭтотОбъект, 
																ПрерватьВыполнение, 
																Режим, 
																Отказ, 
																Заголовок, 
																ВыводитьСообщенияОРазграниченииПрав);
		Если ПрерватьВыполнение Тогда
			Возврат НашлосьОграничение;
		КонецЕсли;		
									
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Устанавливает доступ к колонке табличной части.
//
// Параметры:
//  ТП			 - Произвольный - табличная часть.
//  ИмяКолонки	 - Строка 		- имя колонки.
//  Доступ		 - Строка 		- значения: "Отсутствует" (по умолчанию), "Просмотр", "Редактирование".
//  УправляемаяФорма - Булево 		- признак вызова из управляемой формы.
//
// Возвращаемое значение:
//	Неопределено - не возвращает зачение.
//
Функция обУстановитьДоступККолонке(ТП, ИмяКолонки, Доступ = "Отсутствует", УправляемаяФорма = Ложь) Экспорт
	
	Если УправляемаяФорма Тогда
		
		Если Доступ = "Отсутствует" Тогда
			ТП[ИмяКолонки].Видимость = Ложь;
		ИначеЕсли Доступ = "Просмотр" Тогда
			ТП[ИмяКолонки].ТолькоПросмотр = Истина;
		ИначеЕсли Доступ = "Редактирование" Тогда
			ТП[ИмяКолонки].Видимость = Истина;
			ТП[ИмяКолонки].ТолькоПросмотр = Ложь;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЕсли; 
	
	Колонки = ТП.Колонки;
	Если Доступ = "Отсутствует" Тогда
		Колонки[ИмяКолонки].Видимость = Ложь;
		Колонки[ИмяКолонки].ИзменятьНастройку = Ложь;
		Попытка 
			ТП.ОтборСтрок.Удалить(ТП.ОтборСтрок.Индекс(ТП.ОтборСтрок[ИмяКолонки]));
		Исключение
		КонецПопытки;
	ИначеЕсли Доступ = "Просмотр" Тогда
		Колонки[ИмяКолонки].ТолькоПросмотр = Истина;
	ИначеЕсли Доступ = "Редактирование" Тогда
		Колонки[ИмяКолонки].Видимость = Истина;
		Колонки[ИмяКолонки].ТолькоПросмотр = Ложь;
		Колонки[ИмяКолонки].ИзменятьНастройку = Истина;
	КонецЕсли;
	
КонецФункции

// Устанавливает доступ к колонкам табличной части.
//
// Параметры:
//  ЭлементыФормы 	- ЭлементыФормы - элементы формы.
//  ИменаКолонок	- Массив, СписокЗначений - имя колонки.
//  Доступ		 	- Строка - значения: "Отсутствует" (по умолчанию), "Просмотр", "Редактирование".
//
// Возвращаемое значение:
//	Неопределено - не возвращает зачение.
//
Процедура УстановитьДоступККолонкамТабличнойЧасти(ЭлементыФормы, ИменаКолонок, Доступ = "Отсутствует") Экспорт
	
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		обУстановитьДоступККолонке(ЭлементыФормы, ИмяКолонки, Доступ, Истина);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает доступность финансовой информации.
//
// Возвращаемое значение:
//	Строка - доступность финансовой информации. "Отсутствует", "Просмотр" или "Редактирование".
//
Функция обДоступностьФинансовойИнформации() Экспорт
	
	Если РольДоступна("ПолныеПрава") Или РольДоступна("упоДоступностьФинансовойИнформацииРедактирование") Тогда
		Результат = "Редактирование";
	ИначеЕсли РольДоступна("упоПроектнаяЗадачаРедактированиеТолько_ДР_ДДС") Тогда
		Результат = "РедактированиеТолько_ДР_ДДС";
	ИначеЕсли РольДоступна("упоДоступностьФинансовойИнформацииПросмотр") Тогда
		Результат = "Просмотр";
	Иначе
		Результат = "Отсутствует";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Разграничение доступа отключено
// 
// Возвращаемое значение:
//  Булево - Результат
//
Функция РазграничениеДоступаОтключено() Экспорт 
	
	Возврат ПараметрыСеанса.упоОтключитьПроверкуОграничений 
		Или Константы.упоОтключитьРазграничениеДоступаКДокументам.Получить();
	
КонецФункции 

// Функция - Разграничение доступа отключено для объекта
//
// Параметры:
//  Объект	 - ДокументОбъект, СправочникОбъект, НаборЗаписей - Проверяемый объект
// 
// Возвращаемое значение:
//  Булево - Результат
//
Функция РазграничениеДоступаОтключеноДляОбъекта(Объект) Экспорт
	
	Отключено = Объект.ДополнительныеСвойства.Свойство("НеПроверятьРазграничениеДоступа") 
		И Объект.ДополнительныеСвойства.НеПроверятьРазграничениеДоступа;
		
	Отключено = Отключено Или РазграничениеДоступаОтключено();
	
	Возврат Отключено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Внутренняя процедура. Добавляет правило в заданную структура по заданному ключу и значению.
// Предварительно по определенному закону преобразовывает значение в бинарный вид (в разработке).
// 
// Параметры:
//  Правило - Структура, содержит общее правило.
//  Ключ    - Строка, имя ключа струтуры,  название некоторого значения правила.
//  Правило - Строка, собственно само значение правила.
// 
Процедура _ДобавитьПравило(Правило, Ключ, Значение)
	
	// Фильтруем значения без ограничений.
	Если Значение = "+++" Тогда
		Возврат;
	КонецЕсли;
	
	Правило.Вставить(Ключ, Значение);
	
КонецПроцедуры

// Внутренняя функция. Проверяет ограничение по заданному значению правила и режиму поведения документа.
// Так же, формирует сообщение для нужного режима документа, по заданному тексту.
// 
// Параметры:
//  Режим           - РежимЗаписиДокумента:
//                         - Проведение, режим проведение документа.
//                         - ОтменаПроведения, режим отмены проведения документа.
//                  - Строка:
//                         - "Форма", режим открытия формы.
//  ВидОграничения  - Строка, значение некоего правила.
//  СтрокаСообщения - Строка, текст сообщения.
//  Отказ           - Булево, признак отказа от режима документа.
//  Заголовок       - Строка, текст заголовка сообщения.
// 
// Возвращаемое значение:
// 	Булево - Истина, есть ограничение по значению правила. Ложь, нет ограничения по значению правила.
// 
Функция _ЕстьОграничение(Режим, ВидОграничения)

	ЕстьОграничение = Ложь;

	Если Режим = РежимЗаписиДокумента.Проведение Тогда
		Если ВидОграничения = "---" Или ВидОграничения = "+--" Или ВидОграничения = "--+" Или ВидОграничения = "+-+" Тогда
			// Запрещаем проведение.
			ЕстьОграничение = Истина;
		КонецЕсли;
	ИначеЕсли Режим = РежимЗаписиДокумента.ОтменаПроведения Тогда
		Если ВидОграничения = "---" Или ВидОграничения = "+--" Или ВидОграничения = "-+-" Или ВидОграничения = "++-" Тогда
			// Запрещаем отмену проведения.
			ЕстьОграничение = Истина;
		КонецЕсли;
	ИначеЕсли Режим = "Форма" Тогда
		Если ВидОграничения = "---" Или ВидОграничения = "-+-" Или ВидОграничения = "--+" Или ВидОграничения = "-++" Тогда
			// Признак только чтение.
			ЕстьОграничение = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьОграничение;

КонецФункции

Функция ОбработатьОграничение(СтрокаСообщения, Отказ, Заголовок, ВыводитьСообщенияОРазграниченииПрав = Ложь, СсылкаНаОбъект = Неопределено) 
	
	ПараметрыОшибки = Новый Структура;
	ПараметрыОшибки.Вставить("Событие", "Ограничение доступа");
	ПараметрыОшибки.Вставить("Уровень", УровеньЖурналаРегистрации.Ошибка);		
	ПараметрыОшибки.Вставить("Комментарий", СтрокаСообщения);		
	Если СсылкаНаОбъект <> Неопределено И ТипЗнч(СсылкаНаОбъект) <> Тип("Структура") Тогда
		ПараметрыОшибки.Вставить("Данные", СсылкаНаОбъект);
	Иначе	
		ПараметрыОшибки.Вставить("Данные", Неопределено);
	КонецЕсли;		
	обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок, ПараметрыОшибки, , ВыводитьСообщенияОРазграниченииПрав);
		
КонецФункции

// Внутренняя функция. Проверяет принадлежность заданного значения заданному списку значений.
// 
// Параметры:
//  Список   - СписокЗначений.
//  Значение - Произвольный.
// 
// Возвращаемое значение:
//	Булево - Истина, значение есть в списке; Ложь, значения нет в списке.
// 
Функция _ЕстьВСписке(Список, Значение)
	
	// РЛС.
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		естьВСписке = Ложь;
		Для каждого элементЗначения Из Значение Цикл
			Если НЕ Список.НайтиПоЗначению(элементЗначения.Ключ) = Неопределено Тогда
				естьВСписке = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат естьВСписке;
	Иначе
		Если Список.НайтиПоЗначению(Значение) = Неопределено Тогда
			Возврат Ложь;
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции
	
// Функция для заданного документа формирует набор правил поведения.
// 
// Параметры:
//  ДокументСсылка - ДокументСсылка.
// 
// Возвращаемое значение:
//   Структура - сформированный набор правил, в начале структуры идут параметры документа,
//                 затем структура набора правил: ОписаниеПравила - Структура,
//                 содержит поля вида: название правила и его значение.
// 
Функция ПолучитьПравилаРазграничения(ДокументСсылка)
	
	Правила = Новый Структура;
	Правила.Вставить("Проект");
	Правила.Вставить("МассивПроектов");
	Правила.Вставить("ПроектнаяЗадача");
	Правила.Вставить("МассивПроектныхЗадач");
	Правила.Вставить("Подразделение");
	Правила.Вставить("ОбъектБазовогоПлана");
	
	Если ТипЗнч(ДокументСсылка) = Тип("Структура") Тогда
		Если ДокументСсылка.ИмяОбъекта = "упоУпрощенныйВводСтруктурыПроекта" Тогда
			
			// Ограничение по статусу проекта.
			Правила.Вставить("Проект", ДокументСсылка.Проект);
			
			ОписаниеПравила = Новый Структура;
			Правила.Вставить("СтатусПроекта", ОписаниеПравила);
			
			_ДобавитьПравило(ОписаниеПравила, "Нет"         , "---");
			_ДобавитьПравило(ОписаниеПравила, "Запланирован", "+++");
			_ДобавитьПравило(ОписаниеПравила, "Утвержден"   , "+++");
			_ДобавитьПравило(ОписаниеПравила, "Выполняется" , "+++");
			_ДобавитьПравило(ОписаниеПравила, "Завершен"    , "---");
						
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка." + Метаданные.Документы.упоРегистрацияПроекта.Имя) Тогда
		// Ограничение по статусу проекта.
		Правила.Вставить("Проект", ДокументСсылка.Проект);
		
		ОписаниеПравила = Новый Структура;
		Правила.Вставить("СтатусПроекта", ОписаниеПравила);
		
		_ДобавитьПравило(ОписаниеПравила, "Нет"         , "+++");
		_ДобавитьПравило(ОписаниеПравила, "Запланирован", "+++");
		_ДобавитьПравило(ОписаниеПравила, "Утвержден"   , "---");
		_ДобавитьПравило(ОписаниеПравила, "Выполняется" , "---");
		_ДобавитьПравило(ОписаниеПравила, "Завершен"    , "---");
		_ДобавитьПравило(ОписаниеПравила, "Остановлен"  , "---");
		
		// Ограничение по руководителю проекта.
		ОписаниеПравила = Новый Структура;
		Правила.Вставить("РуководительПроекта", ОписаниеПравила);
		
		_ДобавитьПравило(ОписаниеПравила, "РП"    , "+++");
		_ДобавитьПравило(ОписаниеПравила, "Прочие", "+++");
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка." + Метаданные.Документы.упоУтверждениеПланаПроекта.Имя) Тогда
		// Ограничение по статусу проекта.
		Правила.Вставить("Проект", ДокументСсылка.Проект);
		
