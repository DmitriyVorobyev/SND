                                                    МАКСИМУМ(Влож.Период) КАК Период,
                                                    Влож.Ресурс,
                                                    Влож.Роль
                                                ИЗ
                                                    РегистрСведений.упоРолиТрудовыхРесурсов КАК Влож
                                                ГДЕ Влож.РольНазначена = ИСТИНА
                                                    И Влож.Ресурс В (&amp;упоСписокТрудовыхРесурсовСотрудника)
                                                СГРУППИРОВАТЬ ПО
                                                    Влож.Ресурс,
                                                    Влож.Роль)
                )</condition>
			</restrictionByCondition>
		</right>
