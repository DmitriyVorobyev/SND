Процедура УстановитьПараметрыСтатусовРисковВЗапрос(Запрос)
	
	Запрос.УстановитьПараметр("СостояниеРискаISNULL", Перечисления.упоСтатусОтчетыСтатусыРисков.НеЗаявлены);		
	Запрос.УстановитьПараметр("СостояниеРискаПрочее", Неопределено);
	
	Запрос.УстановитьПараметр("СтатусРиска0", Справочники.упоСтатусыРисковПроектов.Закрыт);
	Запрос.УстановитьПараметр("СостояниеРиска0", Перечисления.упоСтатусОтчетыСтатусыРисков.Закрыты);
	
	Запрос.УстановитьПараметр("СтатусРиска1", Справочники.упоСтатусыРисковПроектов.ПотерялАктуальность);
	Запрос.УстановитьПараметр("СостояниеРиска1", Перечисления.упоСтатусОтчетыСтатусыРисков.НеАктуальны);
	
	Запрос.УстановитьПараметр("СтатусРиска2", Справочники.упоСтатусыРисковПроектов.Актуален);
	Запрос.УстановитьПараметр("СостояниеРиска2", Перечисления.упоСтатусОтчетыСтатусыРисков.Актуальны);
	
	Запрос.УстановитьПараметр("СтатусРиска3", Справочники.упоСтатусыРисковПроектов.Сработал);
	Запрос.УстановитьПараметр("СостояниеРиска3", Перечисления.упоСтатусОтчетыСтатусыРисков.Сработали);	

