&НаСервере
Процедура ЗаполнитьСводныйСтатусНаСервере()
		
	СоответствиеТиповКолонкам = Новый Соответствие;
	СоответствиеТиповКолонкам.Вставить("Сроки", Перечисления.упоСтатусОтчетыСтатусыСроков);
	СоответствиеТиповКолонкам.Вставить("Ресурсы", Перечисления.упоСтатусОтчетыСтатусыРесурсов);
	СоответствиеТиповКолонкам.Вставить("Бюджеты", Перечисления.упоСтатусОтчетыСтатусыБюджетов);
	СоответствиеТиповКолонкам.Вставить("Риски", Перечисления.упоСтатусОтчетыСтатусыРисков);
	
	//
	
	КэшИндексов = Новый Соответствие;
	МаксимумыИндексов = Новый Структура;
	ТЗЗадач = Новый ТаблицаЗначений;
	Для Каждого КлючЗначение Из СоответствиеТиповКолонкам Цикл	
		КэшИндексов.Вставить(КлючЗначение.Ключ, ПолучитьИндексыПеречисления(КлючЗначение.Значение));
		МаксимумыИндексов.Вставить(КлючЗначение.Ключ, -1);
		ТЗЗадач.Колонки.Добавить(КлючЗначение.Ключ);
	КонецЦикла;	
	
	ДеревоЗадачВТЗ(ДеревоЗадач.ПолучитьЭлементы(), ТЗЗадач);
	
	Для Каждого СтрокаТЗ Из ТЗЗадач Цикл
		Для Каждого КлючЗначение Из КэшИндексов Цикл
			ЗначениеИндекса = КэшИндексов[КлючЗначение.Ключ].ИндексПоЗначению.Получить(СтрокаТЗ[КлючЗначение.Ключ]);
			Если ЗначениеИндекса = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			МаксимумыИндексов[КлючЗначение.Ключ] = Макс(МаксимумыИндексов[КлючЗначение.Ключ], ЗначениеИндекса);
		КонецЦикла;
	КонецЦикла;
	
	МаксимумыЗначений = Новый Структура;
	Для Каждого КлючЗначение Из МаксимумыИндексов Цикл
		Если КлючЗначение.Значение = -1 Тогда
			ЗначениеПоИндексу = Неопределено;
		Иначе
			ЗначениеПоИндексу = КэшИндексов[КлючЗначение.Ключ].ЗначениеПоИндексу.Получить(КлючЗначение.Значение);		
		КонецЕсли;
		МаксимумыЗначений.Вставить(КлючЗначение.Ключ, ЗначениеПоИндексу);
	КонецЦикла;
	
	//
	
	Объект.СрокиСводно = МаксимумыЗначений.Сроки;
	Объект.РесурсыСводно = МаксимумыЗначений.Ресурсы;
	Объект.БюджетыСводно = МаксимумыЗначений.Бюджеты;
	Объект.РискиСводно = МаксимумыЗначений.Риски;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИндексыПеречисления(ПеречислениеМенеджер)
	Результат = Новый Структура("ИндексПоЗначению, ЗначениеПоИндексу", Новый Соответствие, Новый Соответствие);
	КоличествоЭлементов = ПеречислениеМенеджер;	
	Для Каждого ЗначениеПеречисления Из ПеречислениеМенеджер Цикл
		Индекс = ПеречислениеМенеджер.Индекс(ЗначениеПеречисления);	
		Результат.ИндексПоЗначению.Вставить(ЗначениеПеречисления, Индекс);
		Результат.ЗначениеПоИндексу.Вставить(Индекс, ЗначениеПеречисления);
	КонецЦикла;
	Возврат Результат; 
КонецФункции

&НаСервере
Процедура ЗаполнитьЗадачиАктивностиНаСервере()
	
	Объект.ЗадачиАктивности.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СрокиПлан.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	СрокиПлан.ДатаНачалаПлан КАК ДатаНачалаПлан,
	|	СрокиПлан.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
	|	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК НазваниеЗадачи,
	|	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот
	|ПОМЕСТИТЬ ВТ_Сроки
	|ИЗ
	|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК СрокиПлан
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ПО СрокиПлан.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сроки.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	Сроки.ДатаНачалаПлан КАК ДатаНачалаПлан,
	|	Сроки.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан,
	|	ВЫБОР
	|		КОГДА Сроки.ДатаЗавершенияПлан >= ДОБАВИТЬКДАТЕ(&ДатаДок, ДЕНЬ, -7)
	|				И Сроки.ДатаЗавершенияПлан <= &ДатаДок
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Выполненные,
	|	ВЫБОР
	|		КОГДА Сроки.ДатаНачалаПлан <= &ДатаДок
	|				И Сроки.ДатаЗавершенияПлан >= &ДатаДок
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Выполняемые,
	|	ВЫБОР
	|		КОГДА Сроки.ДатаНачалаПлан > &ДатаДок
	|				И Сроки.ДатаНачалаПлан <= ДОБАВИТЬКДАТЕ(&ДатаДок, ДЕНЬ, 7)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Ближайшие,
	|	Сроки.ЭтоМодельПакетаРабот КАК ЭтоМодель,
	|	Сроки.НазваниеЗадачи КАК НазваниеЗадачи
	|ПОМЕСТИТЬ ВТ_Упорядоченные
	|ИЗ
	|	ВТ_Сроки КАК Сроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сроки.НазваниеЗадачи КАК Вопрос,
	|	ВЫБОР
	|		КОГДА Сроки.Выполненные
	|			ТОГДА 4
	|		КОГДА Сроки.Выполняемые
	|			ТОГДА 1
	|		КОГДА Сроки.Ближайшие
	|			ТОГДА 3
	|	КОНЕЦ КАК ТипВопроса
	|ИЗ
	|	ВТ_Упорядоченные КАК Сроки
	|ГДЕ
	|	(Сроки.Выполненные
	|			ИЛИ Сроки.Выполняемые
	|			ИЛИ Сроки.Ближайшие)
	|	И Сроки.ЭтоМодель");
	
	Запрос.УстановитьПараметр("Проект", Объект.Проект);
	Запрос.УстановитьПараметр("ДатаДок", НачалоДня(Объект.Дата));	
	Запрос.УстановитьПараметр("Версия", ЭтотОбъект.ТекущаяВерсия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.ЗадачиАктивности.Добавить(), Выборка);
	КонецЦикла;
	
	СтруктураТипыВопросаТаблиц = СтруктураТипыВопросаТаблиц();
	НумерацияСтрокТЧЗадачиАктивности(СтруктураТипыВопросаТаблиц, Объект.ЗадачиАктивности);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРискиНаСервере()
		
	Объект.Риски.Очистить();
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |   Риски.Событие КАК СобытиеРиска,
    |   Риски.ТипРиска КАК ТипРиска,
    |   Риски.Последствие КАК Последствия,
    |   Риски.ТипРеакции КАК ТипРеакции,
    |   Риски.ВероятностьВозникновения КАК Вероятность,
    |   Риски.Риск.СтратегияРеагированияНаРискОписание КАК Действия,
    |   Риски.Риск.ОтветственныйЗаРеагированиеНаРиск КАК Ответственный,
    |   СтатусыРисков.Статус КАК Статус,
    |   Риски.Риск КАК Риск
    |ИЗ
    |   РегистрСведений.упоСвойстваРисковПроектовПлан.СрезПоследних(, Риск.Владелец = &Проект) КАК Риски
    |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыРисковПроектов.СрезПоследних КАК СтатусыРисков
    |       ПО Риски.Риск = СтатусыРисков.Риск");
	
	Запрос.УстановитьПараметр("Проект", Объект.Проект);
        
    РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;		
	
	СоответствиеСтатусовРисков = Соответствие_СтатусыРисковПроектов_СтатусОтчетыСтатусыРисков();

    Выборка = РезультатЗапроса.Выбрать();    
    Пока Выборка.Следующий() Цикл
        НоваяСтрока = Объект.Риски.Добавить(); 
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка); 
		
		Если ЗначениеЗаполнено(Выборка.СобытиеРиска) Тогда
			НоваяСтрока.Риск = Выборка.СобытиеРиска;
		КонецЕсли;
		
		НоваяСтрока.Статус = СоответствиеСтатусовРисков[Выборка.Статус];
		
    КонецЦикла; 
	
КонецПроцедуры

&НаСервере
