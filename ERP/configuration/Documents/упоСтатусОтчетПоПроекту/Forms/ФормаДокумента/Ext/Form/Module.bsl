&НаКлиенте
Процедура ДокументОснованиеПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='Перезаполнить % динамики и вопросы на контроле?'");
	ОписаниеОповещения = Новый ОписаниеОповещения("ДокументОснованиеПриИзмененииЗавершение", ЭтотОбъект, Неопределено);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеПриИзмененииЗавершение(Результат, Параметр) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОснованиеПриИзмененииНаСервре();
КонецПроцедуры

&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервре()
	// процент динамики
	РекурсивноПерезаполнитьПроцентДинамики(ДеревоЗадач);
	// вопросы на контроле
	ЗаполнитьВопросыНаСервере();
КонецПроцедуры

&НаСервере
Процедура РекурсивноПерезаполнитьПроцентДинамики(Дерево, Данные = Неопределено)
	Если Данные = Неопределено Тогда
		Данные = ПолучитьПроцентыВыполненияДокументаОснования();
	КонецЕсли;
	
	СтрокиДерева = Дерево.ПолучитьЭлементы();
	СтруктураПоиска = Новый Структура("ЗадачаСсылка");
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если ЗначениеЗаполнено(СтрокаДерева.ЗадачаСсылка) Тогда
			СтруктураПоиска.ЗадачаСсылка = СтрокаДерева.ЗадачаСсылка;
			НайденныеСтроки = Данные.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаДерева.ПроцентДинамики = 0;
			КонецЕсли;
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				СтрокаДерева.ПроцентДинамики = СтрокаДерева.ПроцентВыполненияЗадачи - НайденнаяСтрока.ПроцентВыполненияЗадачи;
			КонецЦикла;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДерева.ПолучитьЭлементы()) Тогда
			РекурсивноПерезаполнитьПроцентДинамики(СтрокаДерева, Данные);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПроцентыВыполненияДокументаОснования()
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСтатусОтчетПоПроектуСтатусЗадач.ЗадачаСсылка КАК ЗадачаСсылка,
	|	упоСтатусОтчетПоПроектуСтатусЗадач.ПроцентВыполненияЗадачи КАК ПроцентВыполненияЗадачи
	|ИЗ
	|	Документ.упоСтатусОтчетПоПроекту.СтатусЗадач КАК упоСтатусОтчетПоПроектуСтатусЗадач
	|ГДЕ
	|	упоСтатусОтчетПоПроектуСтатусЗадач.Ссылка = &ДокументОснование");
	Запрос.УстановитьПараметр("ДокументОснование", Объект.ДокументОснование);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

