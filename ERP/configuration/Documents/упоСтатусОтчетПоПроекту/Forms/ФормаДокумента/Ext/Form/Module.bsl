&НаКлиенте
Процедура ЗаполнитьРиски(Команда)
	
	ЗаголовокРиски = НСтр("ru = 'Риски'");
	ПараметрыПроверки = Новый Структура("ПроверяемыйОбъект, НазваниеПроверяемогоОбъекта, ВыполняемаяОперация",
		Объект.Риски, ЗаголовокРиски, "ЗаполнитьРиски");
	
	ПроверитьЗаполненностьТаблицы(ПараметрыПроверки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	ЗаполненныеТЧ = Новый Массив;	
	
	Если ДеревоЗадач.ПолучитьЭлементы().Количество() > 0 Тогда
		ЗаполненныеТЧ.Добавить(Элементы.СтраницаСтатусЗадач.Заголовок);
	КонецЕсли;
			
	Если Объект.ЗадачиАктивности.Количество() > 0 Тогда
		ЗаполненныеТЧ.Добавить(Элементы.СтраницаЗадачиАктивности.Заголовок);
	КонецЕсли;
	
	НайденныеСтроки = Объект.Вопросы.НайтиСтроки(Новый Структура("ТипВопроса", 2));
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЗаполненныеТЧ.Добавить(Элементы.Группа17.Заголовок);
	КонецЕсли;
	
	Если Объект.Риски.Количество() > 0 Тогда
		ЗаполненныеТЧ.Добавить(НСтр("ru = 'Риски'"));
	КонецЕсли;	
	
	ТекстВопроса = НСтр("ru = 'Перед заполнением требуется очистить данные%1. Продолжить?'");
	
	КоличествоЗаполненныхТЧ = ЗаполненныеТЧ.Количество();
	Если КоличествоЗаполненныхТЧ > 0 Тогда 
		
		ДобавкаКВопросуВЕдинственномЧисле = 
			НСтр("ru = ' и очистить таблицу ""%1""'");
		ДобавкаКВопросуВМножественномЧисле = 
			НСтр("ru = ' и очистить таблицы ""%1""'");
		
		Если КоличествоЗаполненныхТЧ = 1 Тогда
			ДобавкаКВопросу = ДобавкаКВопросуВЕдинственномЧисле;	
		Иначе
			ДобавкаКВопросу = ДобавкаКВопросуВМножественномЧисле;
		КонецЕсли;
		
		ЗаполненныеТЧСтрокой = СтрСоединить(ЗаполненныеТЧ, ", ");
		ДобавкаКВопросу = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ДобавкаКВопросу, ЗаполненныеТЧСтрокой);
		
	Иначе	
		
		ДобавкаКВопросу = "";
		
	КонецЕсли;
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ДобавкаКВопросу);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьДокументЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

