// Функция возвращает доступные варианты печати документа, обрабатываемые в модуле объекта.
// 
// Возвращаемое значение: 
//  Структура - каждая строка которой соответствует одному из вариантов печати.
// 
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	Возврат Новый Структура(); // нет внутренних печатных форм.

КонецФункции

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр).
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой 
//											  был выведен объект (выходной параметр).
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных
//											  табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
		
КонецПроцедуры

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный - значение, которое используется как основание для заполнения.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
		
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
	ТрудозатратыСОкончНаПредв = Истина;
	ПереноситьНазначенныеТрудовыеРесурсы = Истина;
	
	Если ТипЗнч(Основание) = Тип("Структура") 
		И Основание.Свойство("Проект") Тогда
		
		СводныйПроект = Основание.Проект;
		
	ИначеЕсли ТипЗнч(Основание) = Тип("СправочникСсылка.Проекты") Тогда 
		
		СводныйПроект = Основание;
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьТаблицуСкопированныхРанееЗадач(ТекущаяВерсияПроекта, пМассивКопируемыхЗадач) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекВерсия", ТекущаяВерсияПроекта);
	Запрос.УстановитьПараметр("Задачи", пМассивКопируемыхЗадач);
	Запрос.Текст = "ВЫБРАТЬ
	               |	тСвойства.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	тСвойства.ПроектнаяЗадача.СкопированаВСводныйИзЗадачи КАК СкопированаВСводныйИзЗадачи,
	               |	тСвойства.ПроектнаяЗадача.ДокументОснование КАК ДокументОснование
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК тСвойства
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
	               |		ПО тСвойства.ПроектнаяЗадача = упоПроектнаяЗадача.Ссылка
	               |			И (упоПроектнаяЗадача.СкопированаВСводныйИзЗадачи В (&Задачи))";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьНазначенныеТрудовыеРесурсыКопируемыхЗадач(Задачи) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задачи", Задачи);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Ресурс КАК ТрудовойРесурс,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса КАК Роль,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатрат КАК ДоляТрудозатрат,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатратПоУровнюПланирования КАК ДоляТрудозатратПоУровнюПланирования,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Подразделение КАК Подразделение,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ВариантРаспределения КАК ВариантРаспределения
	               |ИЗ
	               |	РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(, ПроектнаяЗадача В (&Задачи)) КАК упоВыделенныеТрудовыеРесурсыСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоВыделенныеТрудовыеРесурсыСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)";
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

#КонецОбласти

