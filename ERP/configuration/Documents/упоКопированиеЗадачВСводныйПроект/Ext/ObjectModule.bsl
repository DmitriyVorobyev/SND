Функция ИсключенияКопированияРеквизитовПЗ()
	
	НеКопируютсяРеквизиты = Новый Массив;
	НеКопируютсяРеквизиты.Добавить("ЗадачаРодитель");
	НеКопируютсяРеквизиты.Добавить("РучнойВводСроков");
	НеКопируютсяРеквизиты.Добавить("Дата");
	НеКопируютсяРеквизиты.Добавить("Номер");
	НеКопируютсяРеквизиты.Добавить("Проведен");
	НеКопируютсяРеквизиты.Добавить("ПроектнаяЗадача");
	НеКопируютсяРеквизиты.Добавить("Автор");
	НеКопируютсяРеквизиты.Добавить("АвторИзменений");
	НеКопируютсяРеквизиты.Добавить("ДатаМодификации");
	НеКопируютсяРеквизиты.Добавить("ФлагИмпортаMSP");
	НеКопируютсяРеквизиты.Добавить("СкопированаВСводныйИзЗадачи");
	НеКопируютсяРеквизиты.Добавить("ДокументОснование");
	НеКопируютсяРеквизиты.Добавить("Проект");
	
	Возврат НеКопируютсяРеквизиты;
	
КонецФункции

Функция ИсключенияКопированияТабЧастейПЗ()
	
	НеКопируютсяТЧ = Новый Массив;
	
	НеКопируютсяТЧ.Добавить("ПредусловияЗадачи");
	
	Возврат НеКопируютсяТЧ;
	
КонецФункции

Функция КопированиеРазрешено(ТекущаяВерсия, СкопированныеЗадачиСводногоПроекта)
	
	Результат = Истина;
	
	Если упоРазграничениеДоступаВызовСервера.РазграничениеДоступаОтключено() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СкопированныеЗадачиСводногоПроекта) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПроверяемыеСтатусы = упоПроектыИЗадачиСервер.СтатусыЗадачаЗакрытаЗавершена();
	ЗакрытыеЗавершенныеЗадачи = упоПроектыИЗадачиСервер.ЗадачиУказанныхСтатусов(СводныйПроект, 
		ПроверяемыеСтатусы, ТекущаяВерсия, СкопированныеЗадачиСводногоПроекта);
	Если ЗначениеЗаполнено(ЗакрытыеЗавершенныеЗадачи) Тогда
		ТекстыСообщений = Новый Массив;
		ТекстСообщения = СтрШаблон(НСтр("ru = 'В проекте ""%1"" не могут быть обновлены задачи:'"), СводныйПроект);
		ТекстыСообщений.Добавить(ТекстСообщения);
		ШаблонСписка = НСтр("ru = ' - %1 (статус ""%2"")'");
		Для Каждого ЗакрытаяЗавершеннаяЗадача Из ЗакрытыеЗавершенныеЗадачи Цикл
			ТекстСообщения = СтрШаблон(ШаблонСписка, 
				ЗакрытаяЗавершеннаяЗадача.НазваниеЗадачи, ЗакрытаяЗавершеннаяЗадача.СтатусЗадачи);
			ТекстыСообщений.Добавить(ТекстСообщения);
		КонецЦикла;
		ТекстСообщения = СтрСоединить(ТекстыСообщений, Символы.ПС);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обработчик события ОбработкаПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	СписокКопируемыхЗадач = КопируемыеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача");
	
	ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(СводныйПроект);
	
	ТаблицаСкопированныхРанее = ПолучитьТаблицуСкопированныхРанееЗадач(ТекущаяВерсия, СписокКопируемыхЗадач);
	СкопированныеЗадачиСводногоПроекта = ТаблицаСкопированныхРанее.ВыгрузитьКолонку("ПроектнаяЗадача");
	Если Не КопированиеРазрешено(ТекущаяВерсия, СкопированныеЗадачиСводногоПроекта) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПереноситьНазначенныеТрудовыеРесурсы Тогда
		ТаблицаНазначенныхТР = ПолучитьНазначенныеТрудовыеРесурсыКопируемыхЗадач(СписокКопируемыхЗадач);
	КонецЕсли;
	НужноПереноситьНазначенныеТрудовыеРесурсы = ПереноситьНазначенныеТрудовыеРесурсы И ЗначениеЗаполнено(ТаблицаНазначенныхТР);
	
	НеКопируютсяРеквизиты = ИсключенияКопированияРеквизитовПЗ();
	СтрокаИсключений = СтрСоединить(НеКопируютсяРеквизиты, ", ");
	НеКопируютсяТЧ = ИсключенияКопированияТабЧастейПЗ();
 
	//
	
	КэшСкопированных = Новый Соответствие;
	ОтборСкопированных = Новый Структура("ДокументОснование, СкопированаВСводныйИзЗадачи", Ссылка);
	Для Каждого СтрокаКопируемойЗадачи Из КопируемыеЗадачи Цикл
		ОтборСкопированных.СкопированаВСводныйИзЗадачи = СтрокаКопируемойЗадачи.ПроектнаяЗадача;
		СтрокиСкопированныхРаннееЭтимДокументом = ТаблицаСкопированныхРанее.НайтиСтроки(ОтборСкопированных);
		Если ЗначениеЗаполнено(СтрокиСкопированныхРаннееЭтимДокументом) Тогда
			СкопированнаяПЗ = СтрокиСкопированныхРаннееЭтимДокументом[0].ПроектнаяЗадача;
			КэшСкопированных.Вставить(СтрокаКопируемойЗадачи.ПроектнаяЗадача, СкопированнаяПЗ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаКопируемойЗадачи Из КопируемыеЗадачи Цикл
		
		СсылкаНаОбновляемуюПЗ = КэшСкопированных.Получить(СтрокаКопируемойЗадачи.ПроектнаяЗадача);
		Если СсылкаНаОбновляемуюПЗ = Неопределено Тогда
			ОбъектЗадачи = Документы.упоПроектнаяЗадача.СоздатьДокумент();
		Иначе
			ОбъектЗадачи = СсылкаНаОбновляемуюПЗ.ПолучитьОбъект();
		КонецЕсли;
		
		//
		
		ДокументИсточник = СтрокаКопируемойЗадачи.ПроектнаяЗадача.ПолучитьОбъект();
		ДокументИсточник.ПолучитьДанныеВерсии(Неопределено);
		
		ЗаполнитьЗначенияСвойств(ОбъектЗадачи, ДокументИсточник, , СтрокаИсключений);
		Если НеКопируютсяРеквизиты.Найти("НазваниеПроектнойЗадачи") = Неопределено Тогда
			ОбъектЗадачи.НазваниеПроектнойЗадачи = ДокументИсточник.НазваниеПроектнойЗадачи + " [" +ДокументИсточник.Проект + "]";
		КонецЕсли;
		ОбъектЗадачи.РучнойВводСроков = ЗначениеЗаполнено(ОбъектЗадачи.ДатаНачалаПлан) 
			И ЗначениеЗаполнено(ОбъектЗадачи.ДатаЗавершенияПлан);
		ОбъектЗадачи.Проект = СводныйПроект;
		ОбъектЗадачи.ДокументОснование = Ссылка;
		ОбъектЗадачи.СкопированаВСводныйИзЗадачи = СтрокаКопируемойЗадачи.ПроектнаяЗадача;
		
		Для Каждого МетаданныеТЧ Из Метаданные.Документы.упоПроектнаяЗадача.ТабличныеЧасти Цикл
			ИмяТЧ = МетаданныеТЧ.Имя;
			Если НеКопируютсяТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОбъектЗадачи[ИмяТЧ].Загрузить(ДокументИсточник[ИмяТЧ].Выгрузить()); 
		КонецЦикла;
		
		Если ТрудозатратыСОкончНаПредв Тогда
			СтрокиКУдалению = ОбъектЗадачи.ТрудовыеРесурсы.НайтиСтроки(
									Новый Структура("УровеньПланирования", 
									Перечисления.упоУровеньПланирования.Предварительный));
			Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
				СтрокиПодчТЧКУдалению = ОбъектЗадачи.ТрудовыеРесурсыПоПериодам.НайтиСтроки(
											Новый Структура("ИндексСтрокиРаспределениеПоРолям", 
											СтрокаКУдалению.ИндексСтрокРаспределенияПоПериодам));
				Для Каждого СтрокаПодчТЧКУдалению Из СтрокиПодчТЧКУдалению Цикл
					ОбъектЗадачи.ТрудовыеРесурсыПоПериодам.Удалить(СтрокаПодчТЧКУдалению);
				КонецЦикла;
				ОбъектЗадачи.ТрудовыеРесурсы.Удалить(СтрокаКУдалению);
			КонецЦикла;
			
			Для Каждого СтрокаТЧ Из ОбъектЗадачи.ТрудовыеРесурсы Цикл
				СтрокаТЧ.УровеньПланирования = Перечисления.упоУровеньПланирования.Предварительный;
			КонецЦикла;
		КонецЕсли;
		
		ОбъектЗадачи.ДополнительныеСвойства.Вставить("НеПроверятьРазграничениеДоступа", Истина);
		ОбъектЗадачи.ДополнительныеСвойства.Вставить("ДанныеВерсииПолучены", Истина);
		
		Попытка
			ОбъектЗадачи.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Копирование задач'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,, Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)); 
			
			ТекстСообщения = НСтр("ru = 'Произошла ошибка при копировании задач. Подробнее см. журнал регистрации.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			
			Возврат; // Возврат
			
		КонецПопытки;
		
		Если НужноПереноситьНазначенныеТрудовыеРесурсы Тогда
			
			Отбор = Новый Структура("ПроектнаяЗадача", СтрокаКопируемойЗадачи.ПроектнаяЗадача);
			НайденныеСтроки = ТаблицаНазначенныхТР.НайтиСтроки(Отбор);
			УдаляемыеСтроки = Новый Массив;
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если ОбъектЗадачи.ТрудовыеРесурсы.Найти(НайденнаяСтрока.Роль, "Ресурс") = Неопределено Тогда
					УдаляемыеСтроки.Добавить(НайденнаяСтрока);
					Продолжить;
				КонецЕсли;
				НайденнаяСтрока.ПроектнаяЗадача = ОбъектЗадачи.Ссылка;
			КонецЦикла;
			
			Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
				ТаблицаНазначенныхТР.Удалить(УдаляемаяСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НужноПереноситьНазначенныеТрудовыеРесурсы И ЗначениеЗаполнено(ТаблицаНазначенныхТР) Тогда
		
		НайденныйДокСсылка = Документы.упоСохранениеДанныхПроекта.НайтиПоРеквизиту("ДокументОснование", Ссылка);
		
		Если ЗначениеЗаполнено(НайденныйДокСсылка) Тогда
			ДокСохраненияДанныхПроекта = НайденныйДокСсылка.ПолучитьОбъект();
		Иначе
			ДокСохраненияДанныхПроекта = Документы.упоСохранениеДанныхПроекта.СоздатьДокумент();
			ДокСохраненияДанныхПроекта.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		
		ДокСохраненияДанныхПроекта.Проект = СводныйПроект;
		ДокСохраненияДанныхПроекта.ПерезаписатьНазначенныеТрудовыеРесурсы = Истина;
		ДокСохраненияДанныхПроекта.ДокументОснование = Ссылка;
		ДокСохраненияДанныхПроекта.НазначенныеТрудовыеРесурсы.Загрузить(ТаблицаНазначенныхТР);
		
		Попытка
			ДокСохраненияДанныхПроекта.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			
			ТекстСообщения = НСтр("ru = 'Не удалось провести: ""Сохранение данных проекта""!'", 
				ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
			ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка,, Ссылка, ТекстСообщения); 
			
			ТекстСообщения = 
				НСтр("ru = 'Произошла ошибка при копировании назначенных трудовых ресурсов. Подробнее см. журнал регистрации.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			
			Возврат; // Возврат
			
		КонецПопытки
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отмены проведения документа.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ТаблицаСкопированныхРанее = ПолучитьТаблицуСкопированныхРанееЗадач(СводныйПроект, КопируемыеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача"));
	
	Для Каждого СтрокаЗадачи Из ТаблицаСкопированныхРанее Цикл
		Если СтрокаЗадачи.ДокументОснование <> Ссылка Тогда
			Продолжить;
		КонецЕсли;
		СтруктураУдаляемыеОбъекты = упоПроектыИЗадачиСервер.ПолучитьУдаляемыеОбъекты(СтрокаЗадачи.ПроектнаяЗадача);
		упоПроектыИЗадачиСервер.УдалитьПроектнуюЗадачу(СтрокаЗадачи.ПроектнаяЗадача, СтруктураУдаляемыеОбъекты, "", Ложь);
	КонецЦикла;
	
	НайденныйДокСсылка = Документы.упоСохранениеДанныхПроекта.НайтиПоРеквизиту("ДокументОснование", Ссылка);
	Если ЗначениеЗаполнено(НайденныйДокСсылка) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НайденныйДокСсылка, "Проведен") Тогда
		НайденныйДок = НайденныйДокСсылка.ПолучитьОбъект();
		НайденныйДок.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;	
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.';
                        |en = 'Invalid object call on the client.'");
#КонецЕсли
