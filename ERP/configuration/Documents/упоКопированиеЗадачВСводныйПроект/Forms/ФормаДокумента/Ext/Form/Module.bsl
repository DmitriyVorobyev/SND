КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.Проведен 
		И ПараметрыЗаписи.Свойство("РежимЗаписи") 
		И Не ПараметрыЗаписи.Свойство("упоБезусловноеВыполнение") Тогда
		
		Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
			
			ТекстВопроса = НСтр("ru = 'Перепроведение документа приведет к замене данных в уже скопированных задачах. Выберите действие.'");
			
			СписокОтветов = Новый СписокЗначений;
			СписокОтветов.Добавить("ПровестиИЗакрыть", НСтр("ru = 'Провести и закрыть'"));
			СписокОтветов.Добавить("Провести", НСтр("ru = 'Провести'"));
			СписокОтветов.Добавить("Отмена", НСтр("ru = 'Отмена'"));
			СписокОтветов.Добавить("Закрыть", НСтр("ru = 'Закрыть'"));
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокОтветов);
			
			Отказ = Истина;
			
			Возврат;
			
		ИначеЕсли ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
			
			ТекстВопроса = НСтр("ru = 'При отмене проведения будут удалены все копии задач, созданные данным документом. Продолжить?'");
			
			СписокОтветов = Новый СписокЗначений;
			СписокОтветов.Добавить("ОтменаПроведения", НСтр("ru = 'Отменить проведение'"));
			СписокОтветов.Добавить("Отмена", НСтр("ru = 'Отмена'"));
			СписокОтветов.Добавить("Закрыть", НСтр("ru = 'Закрыть'"));
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, СписокОтветов);
			
			Отказ = Истина;
			
			Возврат;
				
		КонецЕсли;
		
	КонецЕсли;
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписьюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт 
	
	Если РезультатВопроса = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатВопроса = "ПровестиИЗакрыть" Тогда
		Записать(Новый Структура("РежимЗаписи, упоБезусловноеВыполнение", РежимЗаписиДокумента.Проведение, Истина));
		Закрыть();
	ИначеЕсли РезультатВопроса = "Провести" Тогда		
		Записать(Новый Структура("РежимЗаписи, упоБезусловноеВыполнение", РежимЗаписиДокумента.Проведение, Истина));
	ИначеЕсли РезультатВопроса = "Закрыть" Тогда		
		Закрыть();
	ИначеЕсли РезультатВопроса = "ОтменаПроведения" Тогда		
		Записать(Новый Структура("РежимЗаписи, упоБезусловноеВыполнение", РежимЗаписиДокумента.ОтменаПроведения, Истина));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)	
	
	ТекущийОбъект.НачалоПериода = ПериодЗначение.ДатаНачала;
	ТекущийОбъект.КонецПериода = ПериодЗначение.ДатаОкончания;
	ТекущийОбъект.ОтборПоПериоду = ПериодИспользование;
	
	ТекущийОбъект.ПроектыИсточники.Очистить();
	Для Каждого ЭлементСписка Из ПроектыИсточникиСписок Цикл
		ТекущийОбъект.ПроектыИсточники.Добавить().Проект = ЭлементСписка.Значение;	
	КонецЦикла;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("упоБезусловноеВыполнение");
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
		
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

