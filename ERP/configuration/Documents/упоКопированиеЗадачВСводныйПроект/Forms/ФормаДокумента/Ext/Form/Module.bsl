&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	// Перенаправим заполнение реквизитов документа
	// процедуре модуля.
	тОбъект = упоУправлениеФормамиСервер.ПолучитьОбъектПоДаннымФормы(Объект);
	тОбъект.ОбработкаЗаполнения(ВыбранноеЗначение);
	ЗначениеВДанныеФормы(тОбъект, Объект);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьДанныеОбъекта(ЭтаФорма, Объект) 
		
	ЭтаФорма.ПериодЗначение.ДатаНачала = Объект.НачалоПериода;
	ЭтаФорма.ПериодЗначение.ДатаОкончания = Объект.КонецПериода;
	Если ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		ЭтаФорма.ПериодВид = упоФункцииБСПКлиентСервер.ПолучитьВидПериода(Объект.НачалоПериода, КонецДня(Объект.КонецПериода));
	Иначе
		ЭтаФорма.ПериодВид = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.ПроизвольныйПериод");
	КонецЕсли;		
	ЭтаФорма.ПериодИспользование = Объект.ОтборПоПериоду;
			
	ЭтаФорма.ПроектыИсточникиСписок.ЗагрузитьЗначения(Объект.ПроектыИсточники.Выгрузить().ВыгрузитьКолонку("Проект"));
	ЭтаФорма.ПроектыИсточникИспользовать = ЭтаФорма.ПроектыИсточникиСписок.Количество() <> 0;	
		                                                
	СтандартныйПериод_Вид_ПриИзменении(ЭтаФорма, Ложь);
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);

КонецФункции

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКопируемыеЗадачи()
	
	Если Не ЗначениеЗаполнено(Объект.ВидОперации) И Не ЗначениеЗаполнено(Объект.Подразделение)
		И Не ПериодИспользование И Не (ПроектыИсточникИспользовать И ПроектыИсточникиСписок.Количество()) Тогда
		
		ТекстСообщения = НСтр("ru = 'Запрещено заполнять список задач без установки отбора.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.КопируемыеЗадачи.Количество() Тогда
		
		ОповещениеВопроса = Новый ОписаниеОповещения("ЗаполнитьКопируемыеЗадачиЗавершение", ЭтотОбъект);		
		ТекстВопроса = НСтр("ru = 'Список копируемых задач не пуст. Он будет очищен. Продолжить?'");		
		ПоказатьВопрос(ОповещениеВопроса, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьКопируемыеЗадачиЗавершение(КодВозвратаДиалога.Да, Неопределено);
	
КонецПроцедуры  

&НаКлиенте
Процедура ЗаполнитьКопируемыеЗадачиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт 
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьКопируемыеЗадачиСервер();
	
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКопируемыеЗадачиСервер()
		
	Объект.КопируемыеЗадачи.Очистить();
	
	//
		
	СтатусыЗадач = Новый Массив;
	СтатусыЗадач.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Запланирована);
	СтатусыЗадач.Добавить(Перечисления.упоСостояниеСтатусаЗадачи.Выполняется);	
	
	//
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.СкопированаВСводныйИзЗадачи КАК ИзЗадачи
	               |ПОМЕСТИТЬ РанееЗагруженныеЗадачиСводного
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача.Проект = &СводныйПроект) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	               |ГДЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.СкопированаВСводныйИзЗадачи <> ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК ПредставлениеЗадачи,
	               |	Проекты.Ссылка КАК ПроектнаяЗадачаЗеркало,
	               |	Проекты.КодСДР КАК КодСДР,
	               |	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан КАК ДатаНачала,
	               |	упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан КАК ДатаЗавершения,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК Статус,
	               |	ВЫБОР
	               |		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача В
	               |				(ВЫБРАТЬ
	               |					РанееЗагруженныеЗадачиСводного.ИзЗадачи
	               |				ИЗ
	               |					РанееЗагруженныеЗадачиСводного)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК СкопированаРанее,
	               |	упоВерсииПроекта.Версия КАК ТекВерсия
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК упоСрокиПроектныхЗадачСрезПоследних
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоСрокиПроектныхЗадачСрезПоследних.Версия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоСтатусыПроектныхЗадачСрезПоследних.Версия
	               |ГДЕ
	               |	(&флВсеПроекты
	               |				И упоВерсииПроекта.Проект <> &СводныйПроект
	               |			ИЛИ упоВерсииПроекта.Проект В (&МассивПроектов))
	               |	И (&флБезПериода
	               |			ИЛИ упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан <= &ДатаОкончания
	               |				И упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан >= &ДатаНачала)
	               |	И упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи В(&СтатусыЗадач)
	               |	И упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации = &ВидОперации
	               |	И НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проект,
	               |	Проекты.КодСДР";
	
	Запрос = Новый Запрос;	
	
	Если ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		Запрос.УстановитьПараметр("ВидОперации", Объект.ВидОперации);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации = &ВидОперации", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		
		КонструкторЗапроса = Новый СхемаЗапроса;	
		КонструкторЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		
		ЗапросБезОтбораПодразделения = КонструкторЗапроса.ПакетЗапросов[КонструкторЗапроса.ПакетЗапросов.Количество()-1];
		ЗапросБезОтбораПодразделения.ТаблицаДляПомещения = "ТаблицаБезОтбораПодразделения";
		
		ЗапросОтборПоПодразделению = КонструкторЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		ЗапросОтборПоПодразделению.УстановитьТекстЗапроса("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		                                                  |	упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
		                                                  |ПОМЕСТИТЬ ЗадачиПоПодразделению
		                                                  |ИЗ
		                                                  |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
		                                                  |			,
		                                                  |			(ПроектнаяЗадача, Версия) В
		                                                  |					(ВЫБРАТЬ
		                                                  |						ТаблицаБезОтбораПодразделения.ПроектнаяЗадача,
		                                                  |						ТаблицаБезОтбораПодразделения.ТекВерсия
		                                                  |					ИЗ
		                                                  |						ТаблицаБезОтбораПодразделения)
		                                                  |				И Подразделение = &Подразделение) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
		                                                  |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		                                                  |				,
		                                                  |				(ПроектнаяЗадача, Версия) В
		                                                  |					(ВЫБРАТЬ
		                                                  |						ТаблицаБезОтбораПодразделения.ПроектнаяЗадача,
		                                                  |						ТаблицаБезОтбораПодразделения.ТекВерсия
		                                                  |					ИЗ
		                                                  |						ТаблицаБезОтбораПодразделения)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		                                                  |		ПО упоДанныеПлановТрудозатратРолейСрезПоследних.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
		                                                  |			И упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		                                                  |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		                                                  |ГДЕ
		                                                  |	упоДанныеПлановТрудозатратРолейСрезПоследних.Количество <> 0");
		
		ЗапросРезультат = КонструкторЗапроса.ПакетЗапросов.Добавить(Тип("ЗапросВыбораСхемыЗапроса"));
		ЗапросРезультат.ВыбиратьРазрешенные = Истина;
		Оператор = ЗапросРезультат.Операторы[0];
		Источник = Оператор.Источники.Добавить("ТаблицаБезОтбораПодразделения", "ТаблицаБезОтбораПодразделения");
		Для Каждого Колонка Из ЗапросБезОтбораПодразделения.Колонки Цикл
			Оператор.ВыбираемыеПоля.Добавить(Колонка.Псевдоним);
		КонецЦикла;
		Оператор.Отбор.Добавить("ПроектнаяЗадача В (ВЫБРАТЬ ЗадачиПоПодразделению.ПроектнаяЗадача ИЗ ЗадачиПоПодразделению)");   		
		
		ЗапросРезультат.Порядок.Добавить("ПроектнаяЗадача.Проект");
		ЗапросРезультат.Порядок.Добавить("КодСДР");
		
		ТекстЗапроса = КонструкторЗапроса.ПолучитьТекстЗапроса();
		
		Запрос.УстановитьПараметр("Подразделение", Объект.Подразделение);
		
	КонецЕсли;
					   
	Запрос.УстановитьПараметр("СводныйПроект", Объект.СводныйПроект);
	Запрос.УстановитьПараметр("флВсеПроекты", ПроектыИсточникиСписок.Количество() = 0);
	Запрос.УстановитьПараметр("МассивПроектов", ПроектыИсточникиСписок.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("флБезПериода", НЕ ПериодИспользование);
	Запрос.УстановитьПараметр("ДатаНачала", ПериодЗначение.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПериодЗначение.ДатаОкончания);
	Запрос.УстановитьПараметр("СтатусыЗадач", СтатусыЗадач);
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Объект.НеСкопированныеРанее И Выборка.СкопированаРанее Тогда
				Продолжить;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Выборка.ПроектнаяЗадача) Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Объект.КопируемыеЗадачи.Добавить(), Выборка); 	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьВозможностьИзменения(ЭтаФорма) 
	
	ЭтаФорма.ВозможностьМенятьСоставЗадач = НЕ ЭтаФорма.Объект.Проведен;
	ЭтаФорма.ВозможностьМенятьОтбор = ЭтаФорма.ВозможностьМенятьСоставЗадач И ЭтаФорма.Объект.КопируемыеЗадачи.Количество() = 0;
	ЭтаФорма.ВозможностьМенятьСводныйПроект = ЭтаФорма.ВозможностьМенятьОтбор;
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьВидимостьДоступностьЭлементов(ЭтаФорма) 
	
	ОпределитьВозможностьИзменения(ЭтаФорма);
	
	ЭтаФорма.Элементы.СводныйПроект.ТолькоПросмотр = Не ЭтаФорма.ВозможностьМенятьСводныйПроект;	
	ЭтаФорма.Элементы.ГруппаОтбор.ТолькоПросмотр = Не ЭтаФорма.ВозможностьМенятьОтбор;
	ЭтаФорма.Элементы.КопируемыеЗадачи.ТолькоПросмотр = Не ЭтаФорма.ВозможностьМенятьСоставЗадач;	
	ЭтаФорма.Элементы.ГруппаПараметрыКопирования.ТолькоПросмотр = Не ЭтаФорма.ВозможностьМенятьСоставЗадач;	
	ЭтаФорма.Элементы.КопируемыеЗадачиКомандаЗаполнить.Доступность = ЭтаФорма.ВозможностьМенятьСоставЗадач;
	
	ЭтаФорма.Элементы.ПроектыИсточникиСписок.Видимость = ЭтаФорма.ПроектыИсточникИспользовать;
	
	ЭтаФорма.Элементы.КопируемыеЗадачиСкопированаРанее.Видимость = НЕ ЭтаФорма.Объект.НеСкопированныеРанее;
	
КонецФункции

#КонецОбласти
