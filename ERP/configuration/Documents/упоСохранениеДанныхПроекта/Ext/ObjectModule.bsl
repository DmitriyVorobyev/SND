Процедура СформироватьДвижения_упоСтатусыПроектнойПродукции()
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	// Предварительная проверка необходимости дальнейшей обработки: должна быть отмененная ПП или отмененные ПЗ, 
	// у которых потенциально может быть ПП.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	упоСохранениеДанныхПроектаСубпродукты.Ресурс КАК ПроектнаяПродукция
	               |ИЗ
	               |	Документ.упоСохранениеДанныхПроекта.Субпродукты КАК упоСохранениеДанныхПроектаСубпродукты
	               |ГДЕ
	               |	упоСохранениеДанныхПроектаСубпродукты.Ссылка = &Ссылка
	               |	И упоСохранениеДанныхПроектаСубпродукты.Ресурс ССЫЛКА Справочник.упоПроектнаяПродукция
	               |	И упоСохранениеДанныхПроектаСубпродукты.Отмена
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	упоСохранениеДанныхПроектаПроектныеЗадачи.ПроектнаяЗадача
	               |ИЗ
	               |	Документ.упоСохранениеДанныхПроекта.ПроектныеЗадачи КАК упоСохранениеДанныхПроектаПроектныеЗадачи
	               |ГДЕ
	               |	упоСохранениеДанныхПроектаПроектныеЗадачи.Ссылка = &Ссылка
	               |	И упоСохранениеДанныхПроектаПроектныеЗадачи.ЗадачаОтменена";
	РезультатЗапроса = Запрос.Выполнить();
	ТребуетсяОбработка = Не РезультатЗапроса.Пустой();
	
	Если Не ТребуетсяОбработка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Версия", ЭтотОбъект.Версия);
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Версия КАК Версия,
	               |	упоСохранениеДанныхПроектаСубпродукты.Ресурс КАК ПроектнаяПродукция,
	               |	упоСохранениеДанныхПроектаСубпродукты.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	МИНИМУМ(упоСохранениеДанныхПроектаСубпродукты.Отмена) КАК Отмена
	               |ПОМЕСТИТЬ УдаленныеСПД_Субпродукты
	               |ИЗ
	               |	Документ.упоСохранениеДанныхПроекта.Субпродукты КАК упоСохранениеДанныхПроектаСубпродукты
	               |ГДЕ
	               |	упоСохранениеДанныхПроектаСубпродукты.Ссылка = &Ссылка
	               |	И упоСохранениеДанныхПроектаСубпродукты.Ресурс ССЫЛКА Справочник.упоПроектнаяПродукция
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоСохранениеДанныхПроектаСубпродукты.Ресурс,
	               |	упоСохранениеДанныхПроектаСубпродукты.ПроектнаяЗадача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСохранениеДанныхПроектаПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ УдаленныеПЗ
	               |ИЗ
	               |	Документ.упоСохранениеДанныхПроекта.ПроектныеЗадачи КАК упоСохранениеДанныхПроектаПроектныеЗадачи
	               |ГДЕ
	               |	упоСохранениеДанныхПроектаПроектныеЗадачи.Ссылка = &Ссылка
	               |	И упоСохранениеДанныхПроектаПроектныеЗадачи.ЗадачаОтменена
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	&Версия КАК Версия,
	               |	упоПроектнаяПродукция.Ссылка КАК ПроектнаяПродукция,
	               |	УдаленныеПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ УдаленныеСПД_ПЗ
	               |ИЗ
	               |	УдаленныеПЗ КАК УдаленныеПЗ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.упоПроектнаяПродукция КАК упоПроектнаяПродукция
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектнойПродукции.СрезПоследних(
	               |					,
	               |					Версия = &Версия
	               |						И ПроектнаяЗадача В
	               |							(ВЫБРАТЬ
	               |								УдаленныеПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |							ИЗ
	               |								УдаленныеПЗ КАК УдаленныеПЗ)) КАК упоСтатусыПроектнойПродукцииСрезПоследних
	               |			ПО упоПроектнаяПродукция.ПроектнаяЗадача = упоСтатусыПроектнойПродукцииСрезПоследних.ПроектнаяЗадача
	               |				И упоПроектнаяПродукция.Ссылка = упоСтатусыПроектнойПродукцииСрезПоследних.ПроектнаяПродукция
	               |		ПО УдаленныеПЗ.ПроектнаяЗадача = упоПроектнаяПродукция.ПроектнаяЗадача
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА упоСтатусыПроектнойПродукцииСрезПоследних.Статус ЕСТЬ NULL
	               |				ТОГДА ИСТИНА
	               |			КОГДА упоСтатусыПроектнойПродукцииСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыПроектнойПродукции.Неактивно)
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	УдаленныеСПД_Субпродукты.Версия КАК Версия,
	               |	УдаленныеСПД_Субпродукты.ПроектнаяПродукция КАК ПроектнаяПродукция,
	               |	УдаленныеСПД_Субпродукты.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ИЗ
	               |	УдаленныеСПД_Субпродукты КАК УдаленныеСПД_Субпродукты
	               |ГДЕ
	               |	УдаленныеСПД_Субпродукты.Отмена
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	УдаленныеСПД_ПЗ.Версия,
	               |	УдаленныеСПД_ПЗ.ПроектнаяПродукция,
	               |	УдаленныеСПД_ПЗ.ПроектнаяЗадача
	               |ИЗ
	               |	УдаленныеСПД_ПЗ КАК УдаленныеСПД_ПЗ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	МодульупоПроектнаяПродукция = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукция");
	
	МодульупоПроектнаяПродукция.УстановитьСтатусПроектнойПродукции(РезультатЗапроса.Выгрузить(), Дата);
	
КонецПроцедуры

Процедура СоздатьОбновитьСвязанныйЭлементСправочникаПроекты(Отказ)
	
	Если Отказ Тогда
		Возврат; // Возврат
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("НеОбновлятьЭлементыСправочникаПроекты") 
		И ДополнительныеСвойства.НеОбновлятьЭлементыСправочникаПроекты Тогда
		Возврат; // Возврат
	КонецЕсли;
	
	Для Каждого СтрокаПЗ Из ПроектныеЗадачи Цикл
		
		СтруктураСвойств = Новый Структура();
		СтруктураСвойств.Вставить("Ссылка", СтрокаПЗ.ПроектнаяЗадача);
		СтруктураСвойств.Вставить("ЗадачаРодитель", СтрокаПЗ.ЗадачаРодитель);
		СтруктураСвойств.Вставить("НазваниеПроектнойЗадачи", СтрокаПЗ.НазваниеЗадачи);
		СтруктураСвойств.Вставить("Проект", ЭтотОбъект.Проект);
		СтруктураСвойств.Вставить("Проведен", Истина);
		СтруктураСвойств.Вставить("ПометкаУдаления", Ложь);
		СтруктураСвойств.Вставить("ДополнительныеСвойства", Новый Структура("НеИзменятьКодСДР", Истина));
		СтруктураСвойств.Вставить("ЭтоАктируемаяЗадача", СтрокаПЗ.ЭтоАктируемаяЗадача);
		СтруктураСвойств.Вставить("ЗадачаОтменена", СтрокаПЗ.ЗадачаОтменена);
		
		Ошибка = упоПроектыИЗадачиСервер.СоздатьОбновитьСвязанныйЭлементСправочникаПроекты(СтруктураСвойств);
		
		Отказ = ?(Отказ, Отказ, Ошибка);
		
	КонецЦикла; 
	
КонецПроцедуры

// Заполняет движения регистра по переданной таблице.
//
// Параметры:
//  ТабЧасть		 - ТаблицаЗначений, ТабличнаяЧасть	 - таблица-источник для формирования движений.
//  ДвиженияРегистра - КоллекцияЗначенийСвойстваОбъектаМетаданных. - движения регистра-приемника. 
//
Процедура ЗаполнитьДвиженияПоТаблице(Таблица, ДвиженияРегистра)
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Движение = ДвиженияРегистра.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, СтрокаТаблицы);
		ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Движение);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Движение)
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Версия) Тогда
		Движение.Версия = ЭтотОбъект.Версия;
	КонецЕсли;
	Движение.Регистратор = Ссылка;
	Движение.Период = Дата;
	Движение.Активность = Истина;
	
КонецПроцедуры 

Процедура СформироватьДвижения_упоСвойстваПроектныхЗадач()
	
	ПараметрыЗаполненияНовойЗадачи = ПараметрыЗаполненияНовойЗадачи();
	
	МассивПЗ = ПроектныеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача");
	ДанныеПоТекСвойствам = СформироватьДанныеПоТекущимСвойстваПроектныхЗадач(ЭтотОбъект.Версия, МассивПЗ);
	
	МассивСвойств = ДанныеПоТекСвойствам.МассивСвойств;
	ТаблицаТекущиеСвойства = ДанныеПоТекСвойствам.ТаблицаТекущиеСвойства;
	
	МассивИменРеквизитовТабличнойЧастиПроектныеЗадачи = Новый Массив;
	МассивИменРеквизитовТабличнойЧастиПроектныеЗадачиНовых = Новый Массив;
	РеквизитыТабличнойЧастиПроектныеЗадачи = ЭтотОбъект.Метаданные().ТабличныеЧасти.ПроектныеЗадачи.Реквизиты;
	Для Каждого РеквизитТабличнойЧастиПроектныеЗадачи Из РеквизитыТабличнойЧастиПроектныеЗадачи Цикл
		Если МассивСвойств.Найти(РеквизитТабличнойЧастиПроектныеЗадачи.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МассивИменРеквизитовТабличнойЧастиПроектныеЗадачи.Добавить(РеквизитТабличнойЧастиПроектныеЗадачи.Имя);
		Если ПараметрыЗаполненияНовойЗадачи.Свойство(РеквизитТабличнойЧастиПроектныеЗадачи.Имя) Тогда
			МассивИменРеквизитовТабличнойЧастиПроектныеЗадачиНовых.Добавить(РеквизитТабличнойЧастиПроектныеЗадачи.Имя);	
		КонецЕсли;
	КонецЦикла;	
	СтрокаИменаСвойствДляЗаписи = СтрСоединить(МассивИменРеквизитовТабличнойЧастиПроектныеЗадачи, ",");
	СтрокаИменаСвойствДляЗаписиНовых = СтрСоединить(МассивИменРеквизитовТабличнойЧастиПроектныеЗадачиНовых, ",");
		
	Для Каждого СтрокаТЧ Из ПроектныеЗадачи Цикл
		
		Движение = Движения.упоСвойстваПроектныхЗадач.Добавить();
		
		ЗаполнитьЗначенияСвойств(Движение, СтрокаТЧ);
		
		СтрокаТекущиеСвойства = ТаблицаТекущиеСвойства.Найти(СтрокаТЧ.ПроектнаяЗадача, "ПроектнаяЗадача");
		НайденыТекущиеСвойства = СтрокаТекущиеСвойства <> Неопределено;
		Если НайденыТекущиеСвойства Тогда
			ЗаполнитьЗначенияСвойств(Движение, СтрокаТекущиеСвойства,, СтрокаИменаСвойствДляЗаписи);
		Иначе
			СтрокаТекущиеСвойства = ПараметрыЗаполненияНовойЗадачи;	
			ЗаполнитьЗначенияСвойств(Движение, СтрокаТекущиеСвойства,, СтрокаИменаСвойствДляЗаписиНовых);	
		КонецЕсли;	
		
		ЗаполнитьРесурсВыводитьВСводныйСтатусОтчет(НайденыТекущиеСвойства, Движение, СтрокаТекущиеСвойства);
		
		Если НЕ ПерезаписатьНормуСтоимостиТрудовыхРесурсов Тогда
			Движение.НормаСтоимостиТрудовыхРесурсов = СтрокаТекущиеСвойства.НормаСтоимостиТрудовыхРесурсов;
		КонецЕсли;
		Если НЕ ПерезаписатьНормуСтоимости Тогда
			Движение.НормаСтоимости = СтрокаТекущиеСвойства.НормаСтоимости;
		КонецЕсли;
		Если НЕ ПерезаписатьНормуСтоимостиОбъемы Тогда
			Движение.НормаСтоимостиОбъемы = СтрокаТекущиеСвойства.НормаСтоимостиОбъемы;
		КонецЕсли;
		Если НЕ ПерезаписатьВключитьМатРесурсыВПланРасходов Тогда
			Движение.ВключитьМатРесурсыВПланРасходов = СтрокаТекущиеСвойства.ВключитьМатРесурсыВПланРасходов;
		КонецЕсли;
		Если ВерсияРеализации < 33 Тогда
			Движение.Объект = СтрокаТекущиеСвойства.Объект;
		КонецЕсли;
		Если ВерсияРеализации < 34 Тогда
			Движение.ВнешняяНормаСтоимостиТрудовыхРесурсов = СтрокаТекущиеСвойства.ВнешняяНормаСтоимостиТрудовыхРесурсов;
		КонецЕсли;
		
		Движение.Длительность = 
			Движение.ДлительностьМоделиПакетаРабот * Движение.ЕдиницаНормированияДлительности.Коэффициент;
		
		ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Движение);

	КонецЦикла;
	
КонецПроцедуры 

// Смена записываемй версии производится программно через доп.свойство "Версия". По умолчанию - текущая версия проекта.
// ВАЖНО: в текущей версии реализации не формируются актуальные трудозатраты по версии.
//
Функция УстановитьВерсиюПроекта(ДополнительныеСвойства)
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.Версия) Тогда
		
		ДополнительныеСвойства.Свойство("Версия", ЭтотОбъект.Версия);
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Версия) Тогда 
			ЭтотОбъект.Версия = ТекВерсия;
		КонецЕсли;
		
	КонецЕсли;
	
	// Версия проекта должна быть в доп.свойствах для корректного построения иерархии при расчете процентов готовности.
	ДополнительныеСвойства.Вставить("Версия", ЭтотОбъект.Версия);
	
	ЭтоПроведениеПоТекущейВерсии = ЭтотОбъект.Версия = ТекВерсия;
	
	Возврат ЭтоПроведениеПоТекущейВерсии;
	
КонецФункции

// Фактические даты расчитываются при изменениях строки структуры интерактивно и записываются напрямую 
// табличной частью документа СДП. Дополнительный расчет требуется для случая автоматического расчета 
// % готовности этапов, когда в движениях появляются записи по этапам, отсутствующие в ТЧ документа. 
// Для этих записей рассчитываем фактические даты начала/окончания.
//
Процедура РасчетФактическихДатНачалаИОкончанияПроектныхЗадач(Отказ)
	
	// Отключение автоматического расчета требуется при свертке регистров.
	Если ДополнительныеСвойства.Свойство("ОтключитьАвтоматическийРасчетГотовности") 
		И ДополнительныеСвойства.ОтключитьАвтоматическийРасчетГотовности = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// Косвенный признак расчета этапов - количество записей статусов, 
	// превышающее количество измененных фактических дат.
	НуженРасчетФактическихДат = Движения.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.Количество() 
		<> Движения.упоСтатусыПроектныхЗадач.Количество();
		
	Если Не НуженРасчетФактическихДат Тогда
		Возврат;
	КонецЕсли;
	
	упоПроведениеДокументовСервер.РасчетФактическихДатНачалаИОкончанияПроектныхЗадач(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Функция ИспользоватьИнкрементВДвиженияхПланаДР(ТаблицаДвиженийПоПодразделениям, 
	ТаблицаДвиженийБезУчетаПрофиля)
	
	ИспользоватьИнкрементВремени = Истина;
	
	СтруктураКолонокСвертывания = ПолучитьСтруктуруКолонокСвертывания("упоДанныеПлановДоходовИРасходовБезПрофиля");
	ТаблицаДвиженийБезУчетаПрофиля.Свернуть(СтруктураКолонокСвертывания.КолонкиГруппировок, 
		СтруктураКолонокСвертывания.КолонкиСумм);

	Если ТаблицаДвиженийПоПодразделениям.Количество() = ТаблицаДвиженийБезУчетаПрофиля.Количество() Тогда 
		ИспользоватьИнкрементВремени = Ложь;
	КонецЕсли;
	
	Возврат ИспользоватьИнкрементВремени;
	
КонецФункции

