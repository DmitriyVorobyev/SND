
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Обработчик события ПриУстановкеНовогоНомера модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - СправочникОбъект, содержит сам объект.
//  СтандартнаяОбработка – Булево, признак выполнения стандартной (системной) обработки события..
//                 продолжение описания параметра. 
//  Префикс      – Строка, префикс, который будет использоваться для генерации номера.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры // ПриУстановкеНовогоНомера()

// Обработчик события ПриКопировании модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  ОбъектКопирования – ДокументОбъект, исходный документ, который является источником копирования. 
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриКопировании(ОбъектКопирования)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	
КонецПроцедуры // ПриКопировании()

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Основание    - Произвольный, значение, которое используется как основание для заполнения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаЗаполнения(Основание)
	
	Если ТипЗнч(Основание)=Тип("Неопределено") Тогда 
		Возврат;	
	КонецЕсли; 
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
//  РежимЗаписи  - РежимЗаписиДокумента, в параметр передается текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	Если ЭтоНовый() И НЕ ЗначениеЗаполнено(ВерсияРеализации) Тогда
		ВерсияРеализации = Документы.упоСохранениеДанныхПроекта.ПолучитьТекущуюВерсиюРеализации();
	КонецЕсли;	
		
КонецПроцедуры // ПередЗаписью()

// Обработчик события ПриЗаписи модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриЗаписи(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПриЗаписи()

// Обработчик события ПередУдалением модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак удаления документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередУдалением(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередУдалением(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПередУдалением()

// Обработчик события ОбработкаПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Заголовок = обСформироватьЗаголовокОшибкиПриПроведении(ЭтотОбъект);
	
	ПроверятьРазграничениеДоступа = Не (ДополнительныеСвойства.Свойство("НеПроверятьРазграничениеДоступа")
		И ДополнительныеСвойства.НеПроверятьРазграничениеДоступа);
	Если ПроверятьРазграничениеДоступа Тогда 
		упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(ЭтотОбъект, 
			РежимЗаписиДокумента.Проведение, Отказ, Заголовок, Истина);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат; // Возврат
	КонецЕсли;
	
	ЭтоПроведениеПоТекущейВерсии = УстановитьВерсиюПроекта(ДополнительныеСвойства);
	
	ЗаполнитьМассивыИзмененныхЗадач();
	
	СформироватьДвижения_упоСвойстваПроектныхЗадач();
	СформироватьДвижения_упоСвойстваПроектов();
	СформироватьДвижения_упоПрогнозныеСрокиПроектныхЗадач();
	СформироватьДвижения_упоПрогнозныеСрокиПроектов();
	СформироватьДвижения_ПроцентыГотовности(Отказ, РежимПроведения);
	СформироватьДвижение_упоПредусловияПроектныхЗадач();
	СформироватьДвижения_упоКодыСДР();
	СформироватьДвижение_упоСтатусыПроектныхЗадач();
	СформироватьДвижения_Сроки();
	
	ЗаписатьДвиженияРегистра("упоСвойстваПроектныхЗадач");
	
	СформироватьДвижения_упоДанныеПлановТрудозатратРолей();
	
	ЗаписатьДвиженияРегистра("упоДанныеПлановТрудозатратРолей");
	ЗаписатьДвиженияРегистра("упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам");
	
	упоПроведениеДокументовСервер.АвтоматическийРасчетГотовности(ЭтотОбъект, Отказ, РежимПроведения);
	
	упоЗакрытиеЭтапа.УдалитьИзДвиженийСтатусовИПроцентовЗакрытыеЗадачи(ЭтотОбъект);
	
	// При автоматическом расчете процента готовности в движения могут быть добавлены вышестоящие этапы.
	// Их фактические даты начала и окончания тоже надо пересчитать.
	РасчетФактическихДатНачалаИОкончанияПроектныхЗадач(Отказ);
	
	Если Отказ Тогда
		Возврат; // Возврат
	КонецЕсли;
	
	СформироватьДвижения_упоВыделенныеТрудовыеРесурсы();
	
	ЗаписатьДвиженияРегистра("упоВыделенныеТрудовыеРесурсы");
	ЗаписатьДвиженияРегистра("упоСрокиПроектныхЗадач");
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПричиныОтклонений() Тогда
		СформироватьДвижение_упоПричиныОтклонений();
		ЗаписатьДвиженияРегистра("упоПричиныОтклонений");
	КонецЕсли;
	
	ФлагЗаписатьДвиженияОбъемов = Ложь;
	
	Если ПерезаписатьМатериальныеРесурсы Или ПерезаписатьВключитьМатРесурсыВПланРасходов Тогда
		
		СформироватьДвижения_упоДанныеПлановМатериальныхРесурсов();
		
		// Записанные движения используются при формировании актуальных планов.
		ЗаписатьДвиженияРегистра("упоДанныеПлановПотребностейМатериальныхРесурсов");
		ЗаписатьДвиженияРегистра("упоДанныеРаспределенияРасходовПоПериодам");
		
		ФлагЗаписатьДвиженияОбъемов = Истина;
		
		СформироватьДвижения_упоАктуальныеПланыЗатратМатериальныхРесурсов();
		
	КонецЕсли;
		
	Если ПерезаписатьСубпродукты ИЛИ ПерезаписатьВключитьСубпродуктыВПланДоходов Тогда
		
		СформироватьДвижения_упоДанныеПлановВыпускаСубпродуктов();
		
		// Записанные движения используются при формировании актуальных планов.
		ЗаписатьДвиженияРегистра("упоДанныеПлановВыпускаСубпродуктов");
		ЗаписатьДвиженияРегистра("упоДанныеРаспределенияДоходовПоПериодам");
		
		ФлагЗаписатьДвиженияОбъемов = Истина;
		
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Если ЭтотОбъект["ПерезаписатьПроектнуюДокументацию"] Тогда
			СформироватьДвижения_упоДанныеПроектнойПродукции();
			ЗаписатьДвиженияРегистра("упоДанныеПроектнойПродукции");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПроектныеЗадачи)	Или ПерезаписатьСубпродукты Тогда
			СформироватьДвижения_упоСтатусыПроектнойПродукции();
		КонецЕсли;
	КонецЕсли;
	
	Если ФлагЗаписатьДвиженияОбъемов Тогда
		ЗаписатьДвиженияРегистра("упоДанныеПлановОбъемовПодразделения");
	КонецЕсли;
	
	Если ПерезаписатьПланДоходов Или ПерезаписатьПланРасходов Или ПерезаписатьВключитьМатРесурсыВПланРасходов 
		Или ПерезаписатьВключитьТрудРесурсыВПланРасходов Тогда
		
		СформироватьДвижения_упоДанныеПлановДоходовИРасходов(ЭтотОбъект.Версия);
		ЗаписатьДвиженияРегистра("упоДанныеПлановДоходовИРасходов");
		ЗаписатьДвиженияРегистра("упоДанныеПлановДоходовИРасходовПодразделения");
		ЗаписатьДвиженияРегистра("упоДанныеРаспределенияДоходовПоПериодам");
		
	КонецЕсли;
	
	Если ПерезаписатьДвиженияДенежныхСредств Или ПерезаписатьВключитьМатРесурсыВПланРасходов 
		Или ПерезаписатьВключитьТрудРесурсыВПланРасходов Тогда
		
		СформироватьДвижение_упоДанныеПлановДвиженияДенежныхСредств();
		ЗаписатьДвиженияРегистра("упоДанныеПлановДвиженияДенежныхСредств");
		
	КонецЕсли;
	
	// Сроки и трансляция.
	
	АктуализироватьЗадачиПоСрокамИТрансляции(Отказ);
	
	ЗаписатьДвиженияРегистра("упоСтатусыПроектныхЗадач");
	
	Если ЭтоПроведениеПоТекущейВерсии Тогда
		
		// Трудозатраты
		
		упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(
			ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами, ЭтотОбъект.Ссылка);
		
		//
		
		СоздатьОбновитьСвязанныйЭлементСправочникаПроекты(Отказ);
		
		упоИерархияИПолномочияСервер.АктуализироватьРуководителейВсехПроектныхЗадачПроекта(Проект);
		
		упоЗадания.СинхронизироватьПорученияЗадач(Проект, ДополнительныеСвойства.МассивЗадачСИзмененнымиНазначеннымиТР);
		
		ОбновитьСвязанныеПроекты();
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отмены проведения документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
	ЗаполнитьМассивыИзмененныхЗадач();
	
	упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами, ЭтотОбъект.Ссылка);	
	
	упоЗадания.СинхронизироватьПорученияЗадач(Проект, Неопределено);	
	
КонецПроцедуры // ОбработкаУдаленияПроведения()

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает структуру с именами свойств регистра упоСвойстваПроектныхЗадач
// и текущим значениями свойств заданных проектных задач
//
// Параметры:
//	Версия - ДокументСсылка.упоВерсияПланаПроекта - Версия проекта 
//	ПроектныеЗадачи - Массив из ДокументСсылка.упоПроектнаяЗадача - Список проектных задач
//
// Возвращаемое значение:
//	Структура - возвращаема структура
//	 * МассивСвойств - Массив из Строка - Массив имен свойств регистра упоСвойстваПроектныхЗадач
//	 * ТаблицаТекущиеСвойства - ТаблицаЗначений - Значения текущих свойств проектных задач
//
Функция СформироватьДанныеПоТекущимСвойстваПроектныхЗадач(Версия, ПроектныеЗадачи) Экспорт
	
	МассивСвойствДляЗапроса = Новый Массив;
	МассивСвойств = Новый Массив;
	Для Каждого МСвойство Из Метаданные.РегистрыСведений.упоСвойстваПроектныхЗадач.Ресурсы Цикл
		МассивСвойствДляЗапроса.Добавить("упоСвойства." + МСвойство.Имя);
		МассивСвойств.Добавить(МСвойство.Имя);
	КонецЦикла;
	Для Каждого МСвойство Из Метаданные.РегистрыСведений.упоСвойстваПроектныхЗадач.Реквизиты Цикл
		МассивСвойствДляЗапроса.Добавить("упоСвойства." + МСвойство.Имя);
		МассивСвойств.Добавить(МСвойство.Имя);
	КонецЦикла;
	Для Каждого МСвойство Из Метаданные.РегистрыСведений.упоСвойстваПроектныхЗадач.Измерения Цикл
		МассивСвойствДляЗапроса.Добавить("упоСвойства." + МСвойство.Имя);
		МассивСвойств.Добавить(МСвойство.Имя);
	КонецЦикла;	
	ТекстЗапросаПоляСвойств = СтрСоединить(МассивСвойствДляЗапроса, ",");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	"+ТекстЗапросаПоляСвойств+"
				   |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И ПроектнаяЗадача В (&МассивПроектныхЗадач)) КАК упоСвойства";
				   
	Запрос.УстановитьПараметр("Версия", Версия);
	Запрос.УстановитьПараметр("МассивПроектныхЗадач", ПроектныеЗадачи);	
	ТаблицаТекущиеСвойства = Запрос.Выполнить().Выгрузить();
	ТаблицаТекущиеСвойства.Индексы.Добавить("ПроектнаяЗадача");	
	
	Возврат Новый Структура("МассивСвойств, ТаблицаТекущиеСвойства", МассивСвойств, ТаблицаТекущиеСвойства);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаписатьДвиженияРегистра(ИмяРегистра)
	Если Движения[ИмяРегистра].Количество() Тогда
		Движения[ИмяРегистра].Записать();
	КонецЕсли;
КонецФункции 

#Область Актуализация_по_срокам_и_трансляции

// Актуализирует финансовые данные для задач, у которых изменились сроки или признак трансляции данных в БДР.
//
// Параметры: 
//  Отказ        - Булево, признак отмены проведения документа.
//  
Процедура АктуализироватьЗадачиСФинансамиИТрансляцией(ДанныеДокумента, ДанныеДвиженийФинансов, Отказ) 

	Если ДополнительныеСвойства.МассивЗадачТрансляции.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	СоответствиеСроковЗадач = Новый Соответствие;
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан КАК ДатаНачала,
	|	упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан КАК ДатаЗавершения
	|ИЗ
	|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
	|			,
	|			Версия = &Версия
	|				И ПроектнаяЗадача В (&ПроектнаяЗадача)) КАК упоСрокиПроектныхЗадачСрезПоследних");
	Запрос.УстановитьПараметр("Версия", ЭтотОбъект.Версия);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ДополнительныеСвойства.МассивЗадачТрансляции);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураСроки = Новый Структура("ДатаНачала, ДатаЗавершения", Выборка.ДатаНачала, Выборка.ДатаЗавершения);
		СоответствиеСроковЗадач.Вставить(Выборка.ПроектнаяЗадача, Новый Структура("Результат", СтруктураСроки));					
	КонецЦикла;
		
	// Финансы
	
	ДопПараметрыРасчета = Новый Структура("ПолныйПересчетИзИсходныхДанных,
		|упоДанныеПлановПотребностейМатериальныхРесурсов_ДвиженияПодготовлены,
		|упоДанныеПлановВыпускаСубпродуктов_ДвиженияПодготовлены,
		|ЭтоДанныеСФинансамиИТрансляцией",
		Истина, Истина, Истина, Истина);			
	упоАктуализацияПроектаВызовСервера.РассчитатьФинансовыеПланы(ЭтотОбъект,
																  ДанныеДвиженийФинансов,
																  ДанныеДокумента,
																  СоответствиеСроковЗадач, 
																  ДополнительныеСвойства.МассивЗадачТрансляции,
																  ЭтотОбъект.Версия,
																  Отказ,
																  ДопПараметрыРасчета);
																  
	Если ДополнительныеСвойства.МассивЗадачТрансляции.Количество() > 0 Тогда
		ЗанулитьДанныеТрудозатратДСС(ДанныеДвиженийФинансов);
	КонецЕсли;	
	
КонецПроцедуры

Процедура АктуализироватьРаспределяемыеПоСрокам(ДанныеДокумента, ДанныеДвиженийФинансов, Отказ) 
	
	Если Не ДополнительныеСвойства.МассивЗадачАктуализацииПоСрокам.Количество() Тогда
		Возврат;
	КонецЕсли;	
	
	НезаписанныеСрокиЗадачи = Новый Соответствие;
	Для Каждого СтрокаСроки Из Сроки Цикл
		Если ДополнительныеСвойства.МассивЗадачАктуализацииПоСрокам.Найти(СтрокаСроки.ПроектнаяЗадача) <> Неопределено Тогда
			СтруктураСроки = Новый Структура;
			СтруктураСроки.Вставить("ДатаНачала", СтрокаСроки.ДатаНачалаПлан);
			СтруктураСроки.Вставить("ДатаЗавершения", СтрокаСроки.ДатаЗавершенияПлан);
			НезаписанныеСрокиЗадачи.Вставить(СтрокаСроки.ПроектнаяЗадача, Новый Структура("Результат", СтруктураСроки));		
		КонецЕсли;	
	КонецЦикла;
	
	// Финансы
	
	ДопПараметрыРасчета = Новый Структура("ПолныйПересчетИзИсходныхДанных,
		|упоДанныеПлановПотребностейМатериальныхРесурсов_ДвиженияПодготовлены,
		|упоДанныеПлановВыпускаСубпродуктов_ДвиженияПодготовлены,
		|ЭтоДанныеСФинансамиИТрансляцией",
		Ложь, 
		Ложь, 
		Ложь,
		Истина);
	упоАктуализацияПроектаВызовСервера.РассчитатьФинансовыеПланы(ЭтотОбъект,
																  ДанныеДвиженийФинансов,
																  ДанныеДокумента,
																  НезаписанныеСрокиЗадачи, 
																  ДополнительныеСвойства.МассивЗадачАктуализацииПоСрокам,
																  ЭтотОбъект.Версия,
																  Отказ, 
																  ДопПараметрыРасчета);
					
КонецПроцедуры

Процедура АктуализироватьЗадачиПоСрокамИТрансляции(Отказ)
	
	ДанныеДокумента = упоПроведениеДокументовВызовСервера.обПолучитьДанныеДокумента(Ссылка);
	ДанныеДокумента.Вставить("ТекущаяВерсияПроекта", ЭтотОбъект.Версия);
	
	ДанныеДвиженийФинансов = Новый Структура();	
	ДанныеДвиженийФинансов.Вставить("упоСрокиПроектныхЗадач");			
	ДанныеДвиженийФинансов.Вставить("упоДанныеПлановПотребностейМатериальныхРесурсов");
	ДанныеДвиженийФинансов.Вставить("упоДанныеПлановВыпускаСубпродуктов");
	ДанныеДвиженийФинансов.Вставить("упоДанныеПлановДвиженияДенежныхСредств");
	ДанныеДвиженийФинансов.Вставить("упоАктуальныеПланыДвиженийДенежныхСредств");
	ДанныеДвиженийФинансов.Вставить("упоАктуальныеПланыДоходовИРасходов");
	ДанныеДвиженийФинансов.Вставить("упоАктуальныеПланыВыполненияОбъемов");
	ДанныеДвиженийФинансов.Вставить("упоАктуальныеПланыДоходовИРасходовПодразделения");
	
	Для Каждого КлючЗначение Из ДанныеДвиженийФинансов Цикл
		ДанныеДвиженийФинансов.Вставить(КлючЗначение.Ключ, Движения[КлючЗначение.Ключ].Выгрузить());
	КонецЦикла;		
	
	АктуализироватьРаспределяемыеПоСрокам(ДанныеДокумента, ДанныеДвиженийФинансов, Отказ);	
	
	АктуализироватьЗадачиСФинансамиИТрансляцией(ДанныеДокумента, ДанныеДвиженийФинансов, Отказ);
	
	Для Каждого КлючЗначение Из ДанныеДвиженийФинансов Цикл
		Если КлючЗначение.Ключ = "упоСрокиПроектныхЗадач" Тогда
			Продолжить;
		КонецЕсли; 		
		упоФункцииОбщегоНазначенияСервер.ЗаполнитьСистемныеПоляТаблицыДвиженийРегистраСведений(КлючЗначение.Значение, Ссылка, Дата);		
		Движения[КлючЗначение.Ключ].Загрузить(КлючЗначение.Значение);
	КонецЦикла;	

КонецПроцедуры

Процедура ЗанулитьДанныеТрудозатратДСС(ДанныеДвиженийФинансов)
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПроектныеЗадачиТРНеВБДДС.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ втПроектныеЗадачиУдалитьТрансляциюТРВБДДС
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		упоСохранениеДанныхПроектаПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |	ИЗ
	               |		Документ.упоСохранениеДанныхПроекта.ПроектныеЗадачи КАК упоСохранениеДанныхПроектаПроектныеЗадачи
	               |	ГДЕ
	               |		упоСохранениеДанныхПроектаПроектныеЗадачи.Ссылка = &Ссылка
	               |		И (НЕ упоСохранениеДанныхПроектаПроектныеЗадачи.ВключитьПланРасходовВБДДС
	               |			ИЛИ НЕ упоСохранениеДанныхПроектаПроектныеЗадачи.ВключитьТрудРесурсыВПланРасходов)) КАК ПроектныеЗадачиТРНеВБДДС
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |				,
	               |				Версия = &Версия
	               |					И НЕ Регистратор = &Ссылка) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ПО ПроектныеЗадачиТРНеВБДДС.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И (упоСвойстваПроектныхЗадачСрезПоследних.ВключитьПланРасходовВБДДС)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Версия КАК Версия,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.СтатьяДДС КАК СтатьяДДС,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.НаправлениеДвижения КАК НаправлениеДвижения,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Контрагент КАК Контрагент,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Договор КАК Договор,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ДатаДвижения КАК ДатаДвижения,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Валюта КАК Валюта,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ИсточникПлана КАК ИсточникПлана,
	               |	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ВидПлатежа КАК ВидПлатежа,
	               |	0 КАК Сумма,
	               |	0 КАК СуммаВалютная
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДДС.Трудозатраты)
	               |				И ПроектнаяЗадача В
	               |					(ВЫБРАТЬ
	               |						втПроектныеЗадачиУдалитьТрансляциюТРВБДДС.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |					ИЗ
	               |						втПроектныеЗадачиУдалитьТрансляциюТРВБДДС КАК втПроектныеЗадачиУдалитьТрансляциюТРВБДДС)) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних";
	
	Запрос.УстановитьПараметр("Версия", ЭтотОбъект.Версия);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ДанныеДвиженийФинансов.упоАктуальныеПланыДвиженийДенежныхСредств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьМассивыИзмененныхЗадач()
	
	Если ДополнительныеСвойства.Свойство("СписокНовыхЗадач") 
		И НЕ ДополнительныеСвойства.СписокНовыхЗадач.Количество() = 0 Тогда
		СписокНовыхЗадач = ДополнительныеСвойства.СписокНовыхЗадач;
	Иначе
		СписокНовыхЗадач = Неопределено
	КонецЕсли;
	
	//
	
	// При программном создании документа данное доп. свойство может быть заполнено. Например,
	// при изменении трансляции доп. затрат.
	Если Не ДополнительныеСвойства.Свойство("МассивЗадачТрансляции") Тогда
		ДополнительныеСвойства.Вставить("МассивЗадачТрансляции", Новый Массив);
	КонецЕсли;
	
	Если ПерезаписатьВключитьМатРесурсыВПланРасходов Или ПерезаписатьВключитьСубпродуктыВПланДоходов
		Или ПерезаписатьВключитьТрудРесурсыВПланРасходов
		Или ПерезаписатьВключитьПланДоходовВБДДС Или ПерезаписатьСхемаОплатыПоУмолчаниюДоходы
		Или ПерезаписатьВключитьПланРасходовВБДДС Или ПерезаписатьСхемаОплатыПоУмолчаниюРасходы Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачТрансляции,
			ПроектныеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача"));
		
	КонецЕсли;
	
	Если ПерезаписатьМатериальныеРесурсы Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачТрансляции,
			МатериальныеРесурсы.ВыгрузитьКолонку("ПроектнаяЗадача"), Истина);
			
	КонецЕсли;
	
	Если ПерезаписатьСубпродукты Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачТрансляции,
			Субпродукты.ВыгрузитьКолонку("ПроектнаяЗадача"), Истина);
			
	КонецЕсли;
	
	Если ПерезаписатьПланДоходов Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачТрансляции,
			ПланДоходов.ВыгрузитьКолонку("ПроектнаяЗадача"), Истина);
			
	КонецЕсли;
	
	Если ПерезаписатьПланРасходов Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачТрансляции,
			ПланРасходов.ВыгрузитьКолонку("ПроектнаяЗадача"), Истина);
			
	КонецЕсли;
	
	Если ПерезаписатьДвиженияДенежныхСредств Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачТрансляции,
			ДвиженияДенежныхСредств.ВыгрузитьКолонку("ПроектнаяЗадача"), Истина);
			
	КонецЕсли;
	
	// Задачи, которые будут транслироваться, исключаются из задач, которые актуализируются по срокам,
	// т.к. актуализация происходит при трансляции.
	
	МассивЗадачСИзмененнымиСроками = Сроки.ВыгрузитьКолонку("ПроектнаяЗадача");
	
	ДополнительныеСвойства.Вставить("МассивЗадачАктуализацииПоСрокам", Новый Массив);
	Если ДополнительныеСвойства.МассивЗадачТрансляции.Количество() > 0 Тогда
		Для Каждого Задача Из МассивЗадачСИзмененнымиСроками Цикл
			Если ДополнительныеСвойства.МассивЗадачТрансляции.Найти(Задача) = Неопределено Тогда
				ДополнительныеСвойства.МассивЗадачАктуализацииПоСрокам.Добавить(Задача);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ДополнительныеСвойства.МассивЗадачАктуализацииПоСрокам = МассивЗадачСИзмененнымиСроками;
	КонецЕсли;
	
	//
	
	ДополнительныеСвойства.Вставить("МассивЗадачСИзмененнымиНормами", Новый Массив);
	Если ПерезаписатьНормуСтоимостиТрудовыхРесурсов Тогда
		ДополнительныеСвойства.МассивЗадачСИзмененнымиНормами = ПроектныеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача");
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("МассивЗадачСИзмененнымиРолями", Новый Массив);
	Если ПерезаписатьТрудовыеРесурсыРоли Тогда
		МассивЗадачСИзмененнымиРолями = ТрудовыеРесурсыРоли.ВыгрузитьКолонку("ПроектнаяЗадача");
		ДополнительныеСвойства.МассивЗадачСИзмененнымиРолями = 
			ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЗадачСИзмененнымиРолями);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("МассивЗадачСИзмененнымиНазначеннымиТР", Новый Массив);
	Если ПерезаписатьНазначенныеТрудовыеРесурсы Тогда
		МассивЗадачСИзмененнымиНазначеннымиТР = НазначенныеТрудовыеРесурсы.ВыгрузитьКолонку("ПроектнаяЗадача");
		ДополнительныеСвойства.МассивЗадачСИзмененнымиНазначеннымиТР = 
			ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЗадачСИзмененнымиНазначеннымиТР);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("МассивЗадачТрансляцииТР", Новый Массив);
	Если ПерезаписатьВключитьТрудРесурсыВПланРасходов
		Или ПерезаписатьВключитьПланРасходовВБДДС 
		Или ПерезаписатьСхемаОплатыПоУмолчаниюРасходы Тогда
		ДополнительныеСвойства.Вставить("МассивЗадачТрансляцииТР", ПроектныеЗадачи.ВыгрузитьКолонку("ПроектнаяЗадача"));
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("МассивЗадачСИзмененнымиТрудозатратами", Новый Массив);
	ДополнитьМассивСИсключениями(ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами,
		МассивЗадачСИзмененнымиСроками, СписокНовыхЗадач);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами,
		ДополнительныеСвойства.МассивЗадачСИзмененнымиНазначеннымиТР, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами,
		ДополнительныеСвойства.МассивЗадачСИзмененнымиРолями, Истина);
	ДополнитьМассивСИсключениями(ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами,
		ДополнительныеСвойства.МассивЗадачСИзмененнымиНормами, СписокНовыхЗадач);
	ДополнитьМассивСИсключениями(ДополнительныеСвойства.МассивЗадачСИзмененнымиТрудозатратами,
		ДополнительныеСвойства.МассивЗадачТрансляцииТР, СписокНовыхЗадач);
	
КонецПроцедуры

Процедура ОбновитьСвязанныеПроекты()
	
	ИспользоватьАвтоматическийРасчетСроковСвязанныхПроектов =
		Константы.упоАвтоматическийРасчетСроковСвязанныхПроектов.Получить();
	Если Не ИспользоватьАвтоматическийРасчетСроковСвязанныхПроектов Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сроки) Тогда
		Возврат;
	КонецЕсли;
	
	ПроектныеЗадачиСНовымиСроками = Сроки.ВыгрузитьКолонку("ПроектнаяЗадача");
	упоРасчетКалендарныхСроковРедакция3Сервер.ПриИзмененииСроковЗадачНеобходимоПересчитатьПроекты(
		ПроектныеЗадачиСНовымиСроками);
	
КонецПроцедуры

Функция ПараметрыЗаполненияНовойЗадачи()
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ПланироватьТрудозатратыНаИсполнителей", Истина);
	СтруктураПараметры.Вставить("Объект", Неопределено);
	
	ПроектныеОпции = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	СтруктураПараметры.Вставить("НормаСтоимости", Константы.упоНормаСтоимостиПоУмолчанию.Получить());
	СтруктураПараметры.Вставить("НормаСтоимостиОбъемы");
	СтруктураПараметры.Вставить("НормаСтоимостиТрудовыхРесурсов", ПроектныеОпции.НормаСтоимостиТрудовыхРесурсов);
	СтруктураПараметры.Вставить("ВнешняяНормаСтоимостиТрудовыхРесурсов", ПроектныеОпции.ВнешняяНормаСтоимостиТрудовыхРесурсов);
	
	Реквизиты = Новый Структура("ВключитьСубпродуктыВПланДоходов, ВключитьМатРесурсыВПланРасходов, 
			|ВключитьТрудРесурсыВПланРасходов, ВключитьПланРасходовВБДДС, ВключитьПланДоходовВБДДС",
			"ВключитьСубпродуктыВПланДоходов", "ВключитьМатРесурсыВПланРасходов", "ВключитьТрудРесурсыВПланРасходов",
			"упоВключитьПланРасходовВБДДС", "упоВключитьПланДоходовВБДДС", "упоТипСубпродукта");
	РеквизитыПроекта = упоФункцииБСП.ЗначенияРеквизитовОбъектаВызовСервера(Проект, Реквизиты);
	
	Для Каждого КлючЗначение Из РеквизитыПроекта Цикл
		СтруктураПараметры.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
	Возврат СтруктураПараметры;
	
КонецФункции

Процедура ЗаполнитьРесурсВыводитьВСводныйСтатусОтчет(НайденыТекущиеСвойства, Движение, СтрокаТекущиеСвойства)
	
	ТипПроектнойЗадачи = упоПроектыИЗадачиСервер.ПолучитьТипПроектнойЗадачи(Движение);
	
	Если Не НайденыТекущиеСвойства Тогда		
		упоПроектыИЗадачиСервер.ЗаполнитьРеквизитВыводитьВСводныйСтатусОтчет(ТипПроектнойЗадачи, Движение);		
		Возврат;		
	КонецЕсли;
	
	ТипПроектнойЗадачиВРегистре = упоПроектыИЗадачиСервер.ПолучитьТипПроектнойЗадачи(СтрокаТекущиеСвойства);
	
	Если ТипПроектнойЗадачи <> ТипПроектнойЗадачиВРегистре Тогда		
		упоПроектыИЗадачиСервер.ЗаполнитьРеквизитВыводитьВСводныйСтатусОтчет(ТипПроектнойЗадачи, Движение);		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьДвижения_упоКодыСДР()
	
	Если НЕ ПерезаписатьКодыСДР Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если КодыСДР.Количество() Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("КодыСДР", КодыСДР);
		Запрос.УстановитьПараметр("Версия", ЭтотОбъект.Версия);
		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	КодыСДР.КодСДР КАК КодСДР,
		               |	КодыСДР.ПроектнаяЗадача КАК ПроектнаяЗадача
		               |ПОМЕСТИТЬ вт
		               |ИЗ
		               |	&КодыСДР КАК КодыСДР
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Проекты.Ссылка КАК ПроектнаяЗадача,
		               |	вт.КодСДР КАК КодСДР,
		               |	&Версия КАК Версия,
		               |	&Дата КАК Период,
		               |	&Ссылка КАК Регистратор,
		               |	ИСТИНА КАК Активность
		               |ИЗ
		               |	вт КАК вт
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		               |		ПО вт.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу";
		
		Движения.упоКодыСДР.Загрузить(Запрос.Выполнить().Выгрузить());
		
	Иначе
		
		Для Каждого СтрокаТЧ Из ПроектныеЗадачи Цикл
			
			Движение = Движения.упоКодыСДР.Добавить();
			
			ЗаполнитьЗначенияСвойств(Движение, СтрокаТЧ);
			ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Движение);
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		// Проведение в привилегированном режиме.
		Запрос.Текст = "ВЫБРАТЬ
		               |	Проекты.КодСДР,
		               |	Проекты.Ссылка КАК ПроектнаяЗадача
		               |ИЗ
		               |	Документ.упоСохранениеДанныхПроекта.ПроектныеЗадачи КАК упоСохранениеДанныхПроектаПроектныеЗадачи
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		               |		ПО упоСохранениеДанныхПроектаПроектныеЗадачи.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
		               |ГДЕ
		               |	упоСохранениеДанныхПроектаПроектныеЗадачи.Ссылка = &Ссылка";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Движение = Движения.упоКодыСДР.Добавить();
			
			ЗаполнитьЗначенияСвойств(Движение, Выборка);
			ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Движение);
			
		КонецЦикла;
		
	КонецЕсли;
		
КонецФункции 

