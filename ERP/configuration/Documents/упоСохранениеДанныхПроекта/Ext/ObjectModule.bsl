			Новый Структура ("Регистратор, Период, МассивЗадач, ИмяРегистра",
				Ссылка, Дата, МассивЗадач, "упоДанныеРаспределенияРасходовПоПериодам"),,,
			ДопОтбор, ДопПараметрыАктуализацииРегистра, Ложь, ДопОтборСоединение);
			 				
КонецФункции

Функция СформироватьДвижения_упоДанныеПлановВыпускаСубпродуктов() 

	Если НЕ ПерезаписатьСубпродукты Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Актуализация по срокам пройдет штатно в актуализации фин.планов.
	
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСохранениеДанныхПроектаСубпродукты.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСохранениеДанныхПроектаСубпродукты.Ресурс КАК Номенклатура,
	               |	упоСохранениеДанныхПроектаСубпродукты.Контрагент КАК Контрагент,
