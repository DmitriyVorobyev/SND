		ДопОтборСоединение);
	
КонецФункции

Функция СформироватьТаблицуОтбораЗануления_упоДанныеПлановТрудозатратРолей(ТаблицаТрудовыеРесурсыРоли)
	
	// Отбор по источнику плана необходим при добавлении идентичной строки трудозатрат вручную.
	СтрокаСвертки = "УровеньПланирования, ПроектнаяЗадача, Ресурс, ИсточникПлана";
	ТаблицаРольПроектнаяЗадачаУровеньПланирования = ТаблицаТрудовыеРесурсыРоли.Скопировать(, СтрокаСвертки);
	ТаблицаРольПроектнаяЗадачаУровеньПланирования.Свернуть(СтрокаСвертки);
	
	// В исторических данных могут оставаться строки с незаполненным источником плана. 
	// Такие строки необходимо добавить в отбор зануления, если идет движение по строке с источником плана = Трудозатраты.
	Сч = ТаблицаРольПроектнаяЗадачаУровеньПланирования.Количество() - 1;
	Пока Сч >= 0 Цикл
		
		СтрокаТаблицы = ТаблицаРольПроектнаяЗадачаУровеньПланирования[Сч];
		Сч = Сч - 1;

		Если СтрокаТаблицы.ИсточникПлана <> Перечисления.упоИсточникПланаТрудозатратРолей.Трудозатраты Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ТаблицаРольПроектнаяЗадачаУровеньПланирования.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, , "ИсточникПлана");
		// Здесь ИсточникПлана = Неопределено (нюансы таблиц значений, выгруженных из результата запроса).
		// В явном виде присвоим пустую ссылку, иначе не сработают отборы по базе.
		НоваяСтрока.ИсточникПлана = Перечисления.упоИсточникПланаТрудозатратРолей.ПустаяСсылка();
		
	КонецЦикла;
	
	Возврат ТаблицаРольПроектнаяЗадачаУровеньПланирования;
	
КонецФункции

Функция СформироватьДвижения_упоВыделенныеТрудовыеРесурсы()
	
	Если НЕ ПерезаписатьНазначенныеТрудовыеРесурсы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Версия", ЭтотОбъект.Версия);
	Запрос.УстановитьПараметр("ВерсияРеализации", ВерсияРеализации);
	Запрос.УстановитьПараметр("УровеньПланированияПоУмолчанию", Перечисления.упоУровеньПланирования.Окончательный);
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.ТрудовойРесурс КАК ТрудовойРесурс,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.Подразделение КАК Подразделение,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.Роль КАК Роль,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.Отмена КАК Отмена,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.ВариантРаспределения КАК ВариантРаспределения,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.ДоляТрудозатратПоУровнюПланирования КАК ДоляТрудозатратПоУровнюПланирования,
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.ДоляТрудозатрат КАК ДоляТрудозатрат
	               |ПОМЕСТИТЬ ДанныеДокумента
	               |ИЗ
	               |	Документ.упоСохранениеДанныхПроекта.НазначенныеТрудовыеРесурсы КАК упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы
	               |ГДЕ
	               |	упоСохранениеДанныхПроектаНазначенныеТрудовыеРесурсы.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Ресурс КАК Роль,
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Подразделение КАК Подразделение,
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.УровеньПланирования КАК УровеньПланирования,
	               |	ВЫБОР
	               |		КОГДА упоДанныеПлановТрудозатратРолейСрезПоследних.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ИндексУровеньПланирования
	               |ПОМЕСТИТЬ ВТ_Роли_ПЗ
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И (Ресурс, ПроектнаяЗадача) В
	               |					(ВЫБРАТЬ
	               |						ВТ.Роль,
	               |						ВТ.ПроектнаяЗадача
	               |					ИЗ
	               |						ДанныеДокумента КАК ВТ)) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	               |ГДЕ
	               |	(упоДанныеПлановТрудозатратРолейСрезПоследних.Количество <> 0
	               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.Стоимость <> 0
	               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.ВнешняяСтоимость <> 0)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Роли_ПЗ.Роль КАК Роль,
	               |	ВТ_Роли_ПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	МАКСИМУМ(ВТ_Роли_ПЗ.ИндексУровеньПланирования) КАК ИндексУровеньПланирования
	               |ПОМЕСТИТЬ ВТ_Роли_Максимум
	               |ИЗ
	               |	ВТ_Роли_ПЗ КАК ВТ_Роли_ПЗ
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Роли_ПЗ.ПроектнаяЗадача,
	               |	ВТ_Роли_ПЗ.Роль
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Роли_ПЗ.Роль КАК Роль,
	               |	ВТ_Роли_ПЗ.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВТ_Роли_ПЗ.Подразделение КАК Подразделение,
	               |	ВТ_Роли_ПЗ.УровеньПланирования КАК УровеньПланирования,
	               |	ВТ_Роли_ПЗ.ИндексУровеньПланирования КАК ИндексУровеньПланирования
	               |ПОМЕСТИТЬ ВТ_Роли
	               |ИЗ
	               |	ВТ_Роли_ПЗ КАК ВТ_Роли_ПЗ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Роли_Максимум КАК ВТ_Роли_Максимум
	               |		ПО ВТ_Роли_ПЗ.Роль = ВТ_Роли_Максимум.Роль
	               |			И ВТ_Роли_ПЗ.ПроектнаяЗадача = ВТ_Роли_Максимум.ПроектнаяЗадача
	               |			И ВТ_Роли_ПЗ.ИндексУровеньПланирования = ВТ_Роли_Максимум.ИндексУровеньПланирования
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеДокумента.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДанныеДокумента.ТрудовойРесурс КАК ТрудовойРесурс,
	               |	ДанныеДокумента.Роль КАК Роль,
	               |	ДанныеДокумента.Отмена КАК Отмена,
	               |	ВЫБОР
	               |		КОГДА &ВерсияРеализации >= 30
	               |			ТОГДА ДанныеДокумента.Подразделение
	               |		ИНАЧЕ ВТ_Роли.Подразделение
	               |	КОНЕЦ КАК Подразделение,
	               |	ДанныеДокумента.ВариантРаспределения КАК ВариантРаспределения,
	               |	ДанныеДокумента.ДоляТрудозатрат КАК ДоляТрудозатрат,
	               |	ВЫБОР
	               |		КОГДА &ВерсияРеализации >= 32
	               |			ТОГДА ДанныеДокумента.ДоляТрудозатратПоУровнюПланирования
	               |		ИНАЧЕ ЕСТЬNULL(ВТ_Роли.УровеньПланирования, ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Предварительный))
	               |	КОНЕЦ КАК УровеньПланирования
	               |ПОМЕСТИТЬ ДанныеДокументаСПодразделением
	               |ИЗ
	               |	ДанныеДокумента КАК ДанныеДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Роли КАК ВТ_Роли
	               |		ПО ДанныеДокумента.ПроектнаяЗадача = ВТ_Роли.ПроектнаяЗадача
	               |			И ДанныеДокумента.Роль = ВТ_Роли.Роль
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Ресурс КАК Ресурс,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Проект КАК Проект,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса КАК РольРесурса,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Подразделение КАК Подразделение,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатрат КАК ДоляТрудозатрат,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатратПоУровнюПланирования КАК ДоляТрудозатратПоУровнюПланирования,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ВариантРаспределения КАК ВариантРаспределения
	               |ПОМЕСТИТЬ ДанныеРегистра
	               |ИЗ
	               |	РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(
	               |			,
	               |			Версия = &Версия И (ПроектнаяЗадача, Ресурс) В
	               |				(ВЫБРАТЬ
	               |					ВР.ПроектнаяЗадача,
	               |					ВР.ТрудовойРесурс
	               |				ИЗ
	               |					ДанныеДокумента КАК ВР)) КАК упоВыделенныеТрудовыеРесурсыСрезПоследних
	               |ГДЕ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РесурсВыделен
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеДокумента.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДанныеДокумента.ТрудовойРесурс КАК Ресурс,
	               |	ДанныеДокумента.Роль КАК РольРесурса,
	               |	ВЫБОР
	               |		КОГДА &ВерсияРеализации >= 31
	               |			ТОГДА ДанныеДокумента.ДоляТрудозатрат
	               |		ИНАЧЕ ЕСТЬNULL(ДанныеРегистра.ДоляТрудозатрат, 100)
	               |	КОНЕЦ КАК ДоляТрудозатрат,
	               |	ВЫБОР
	               |		КОГДА &ВерсияРеализации >= 31
	               |			ТОГДА ДанныеДокумента.ВариантРаспределения
	               |		ИНАЧЕ ЕСТЬNULL(ДанныеРегистра.ВариантРаспределения, ЗНАЧЕНИЕ(Перечисление.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат))
	               |	КОНЕЦ КАК ВариантРаспределения,
	               |	ВЫБОР
	               |		КОГДА &ВерсияРеализации >= 32
	               |			ТОГДА ДанныеДокумента.УровеньПланирования
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА НЕ ДанныеРегистра.ДоляТрудозатратПоУровнюПланирования ЕСТЬ NULL
	               |					ТОГДА ДанныеРегистра.ДоляТрудозатратПоУровнюПланирования
	               |				ИНАЧЕ ВЫБОР
	               |						КОГДА ДанныеДокумента.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Предварительный)
	               |							ТОГДА ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Предварительный)
	               |						ИНАЧЕ &УровеньПланированияПоУмолчанию
	               |					КОНЕЦ
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ДоляТрудозатратПоУровнюПланирования,
	               |	ВЫБОР
	               |		КОГДА &ВерсияРеализации >= 30
	               |			ТОГДА ДанныеДокумента.Подразделение
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ДанныеДокумента.Роль = ЕСТЬNULL(ДанныеРегистра.РольРесурса, НЕОПРЕДЕЛЕНО)
	               |					ТОГДА ЕСТЬNULL(ДанныеРегистра.Подразделение, ДанныеДокумента.Подразделение)
	               |				ИНАЧЕ ДанныеДокумента.Подразделение
	               |			КОНЕЦ
	               |	КОНЕЦ КАК Подразделение,
	               |	ВЫБОР
	               |		КОГДА ДанныеДокумента.Отмена
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК РесурсВыделен,
	               |	ДанныеДокумента.ПроектнаяЗадача.Проект КАК Проект
	               |ИЗ
	               |	ДанныеДокументаСПодразделением КАК ДанныеДокумента
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеРегистра КАК ДанныеРегистра
	               |		ПО (ДанныеРегистра.ПроектнаяЗадача = ДанныеДокумента.ПроектнаяЗадача)
	               |			И (ДанныеРегистра.Ресурс = ДанныеДокумента.ТрудовойРесурс)";
				   
	ТаблицаВыделенныеРесурсы = Запрос.Выполнить().Выгрузить();
	
	ТаблицаВыделенныеРесурсы.Свернуть("ПроектнаяЗадача, Ресурс, РольРесурса, ДоляТрудозатрат, ВариантРаспределения, 
									| ДоляТрудозатратПоУровнюПланирования, Подразделение, РесурсВыделен, Проект");
	
	Движения.упоВыделенныеТрудовыеРесурсы.Загрузить(ТаблицаВыделенныеРесурсы);
	
	Для Каждого Запись Из Движения.упоВыделенныеТрудовыеРесурсы Цикл
		ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Запись);
	КонецЦикла;
	
КонецФункции 

Процедура ДополнитьМассивСИсключениями(МассивПриемник, МассивИсточник, СписокИсключений = Неопределено) 
	
	Если СписокИсключений = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПриемник, МассивИсточник, Истина);
		
	Иначе
		
		УникальныеЗначения = Новый Соответствие;
		
		Для Каждого Значение Из МассивПриемник Цикл
			УникальныеЗначения.Вставить(Значение, Истина);
		КонецЦикла;
		
		Для Каждого Значение Из МассивИсточник Цикл
			
			Если СписокИсключений.НайтиПоЗначению(Значение) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если УникальныеЗначения[Значение] = Неопределено Тогда
				МассивПриемник.Добавить(Значение);
				УникальныеЗначения.Вставить(Значение, Истина);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруКолонокСвертывания(ИмяТаблицы)
	
	КолонкиГруппировок = "";
	КолонкиСумм = "";
	
	Если ИмяТаблицы = "упоДанныеПлановОбъемовПодразделения" Тогда
		КолонкиГруппировок = "ПроектнаяЗадача, ВидОбъема, Подразделение, Роль, СпособПривязки, ПрофильРаспределения, ДатаНачисления, 
			|Заказ_ДоговорПодрядчика, СобствСилы_Субподряд, КонтрагентПодрядчик, ИндексСтрокиВладельца, ИндексСтрокРаспределенияПоПериодам";
		КолонкиСумм = "Сумма, СуммаВалютная, Количество";
	ИначеЕсли ИмяТаблицы = "упоДанныеПлановДоходовИРасходовПодразделения" Тогда
		КолонкиГруппировок = "ПроектнаяЗадача, ВидЭлемента, Подразделение, Роль, СпособПривязки, ПрофильРаспределения, ДатаНачисления, 
			|Заказ_ДоговорПодрядчика, СобствСилы_Субподряд, КонтрагентПодрядчик, ИндексСтрокиВладельца, ИндексСтрокРаспределенияПоПериодам,
			|ИсточникПлана";
		КолонкиСумм = "Сумма, СуммаВалютная, Количество";
	ИначеЕсли ИмяТаблицы = "упоДанныеПлановДоходовИРасходовБезПрофиля" Тогда
		КолонкиГруппировок = "ПроектнаяЗадача, ВидЭлемента, Подразделение, Роль, ДатаНачисления, Заказ_ДоговорПодрядчика,
			|СобствСилы_Субподряд, КонтрагентПодрядчик, ИндексСтрокиВладельца, ИндексСтрокРаспределенияПоПериодам,
			|ИсточникПлана";
		КолонкиСумм = "Сумма, СуммаВалютная, Количество";	
	КонецЕсли;
	
	СтруктураКолонок = Новый Структура("КолонкиГруппировок, КолонкиСумм", КолонкиГруппировок, КолонкиСумм);
	Возврат СтруктураКолонок;
	
КонецФункции

Функция СформироватьДвижения_упоДанныеПлановМатериальныхРесурсов() 

	Если НЕ ПерезаписатьМатериальныеРесурсы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
