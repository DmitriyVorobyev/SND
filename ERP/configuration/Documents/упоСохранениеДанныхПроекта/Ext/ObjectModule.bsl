	               |				И ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты)
	               |				И ПроектнаяЗадача В
	               |					(ВЫБРАТЬ
	               |						втПроектныеЗадачиУдалитьТрансляциюТРВПланРасходов.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |					ИЗ
	               |						втПроектныеЗадачиУдалитьТрансляциюТРВПланРасходов КАК втПроектныеЗадачиУдалитьТрансляциюТРВПланРасходов)) КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних";					   						   
	
	РезультатыПакета = Запрос.ВыполнитьПакет();
	ИндексПоследнегоЗапроса = РезультатыПакета.ВГраница();
	
	ОсновнаяТаблица = РезультатыПакета[ИндексПоследнегоЗапроса - 5].Выгрузить();
	ТаблицаПоПодразделениям = РезультатыПакета[ИндексПоследнегоЗапроса - 4].Выгрузить();
	ТаблицаДоходовПоПериодам = РезультатыПакета[ИндексПоследнегоЗапроса - 3].Выгрузить();
	ТаблицаРасходовПоПериодам = РезультатыПакета[ИндексПоследнегоЗапроса - 2].Выгрузить();
	ОсновнаяТаблицаАктуальные = РезультатыПакета[ИндексПоследнегоЗапроса - 1].Выгрузить();
	ТаблицаПоПодразделениямАктуальные = РезультатыПакета[ИндексПоследнегоЗапроса].Выгрузить();
	
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ОсновнаяТаблица);
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаПоПодразделениям);
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДоходовПоПериодам);
	упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаРасходовПоПериодам);
	
	Движения.упоДанныеПлановДоходовИРасходов.Загрузить(ОсновнаяТаблица);
	Для Каждого Запись Из Движения.упоДанныеПлановДоходовИРасходов Цикл
		ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Запись);
	КонецЦикла;
	
	ТаблицаДвиженийПоПодразделениям = ТаблицаПоПодразделениям.Скопировать();
	СтруктураКолонокСвертывания = ПолучитьСтруктуруКолонокСвертывания("упоДанныеПлановДоходовИРасходовПодразделения");
	ТаблицаДвиженийПоПодразделениям.Свернуть(СтруктураКолонокСвертывания.КолонкиГруппировок, СтруктураКолонокСвертывания.КолонкиСумм);
	ТаблицаДвиженийПоПодразделениям.Сортировать("Сумма");
	
	ТаблицаДвиженийБезУчетаПрофиля = ТаблицаПоПодразделениям.Скопировать(); 
	ИспользоватьИнкрементВремени = ИспользоватьИнкрементВДвиженияхПланаДР(ТаблицаДвиженийПоПодразделениям,
		ТаблицаДвиженийБезУчетаПрофиля);
	
	ЗаполнитьДвиженияПоТаблице(ТаблицаДвиженийПоПодразделениям, Движения.упоДанныеПлановДоходовИРасходовПодразделения);
	// Обновим период для уникальности записей при кейсе, когда у строки-родителя меняется только
	// способ привязки/профиль распределения. 
	
	Если ИспользоватьИнкрементВремени Тогда
		ИнкрементаВремени = 0;
		Для каждого Движение Из Движения.упоДанныеПлановДоходовИРасходовПодразделения Цикл
			Движение.Период = Движение.Период + ИнкрементаВремени;
			ИнкрементаВремени = ИнкрементаВремени + 1;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьДвиженияПоТаблице(ТаблицаДоходовПоПериодам, Движения.упоДанныеРаспределенияДоходовПоПериодам);
	ЗаполнитьДвиженияПоТаблице(ТаблицаРасходовПоПериодам, Движения.упоДанныеРаспределенияРасходовПоПериодам);
	
	Движения.упоАктуальныеПланыДоходовИРасходов.Загрузить(ОсновнаяТаблицаАктуальные);
	Для Каждого Запись Из Движения.упоАктуальныеПланыДоходовИРасходов Цикл
		ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Запись);
	КонецЦикла;
	
	Движения.упоАктуальныеПланыДоходовИРасходовПодразделения.Загрузить(ТаблицаПоПодразделениямАктуальные);
	Для Каждого Запись Из Движения.упоАктуальныеПланыДоходовИРасходовПодразделения Цикл
		ЗаполнитьСтандартныеПараметрыДляЗаписиРС(Запись);
	КонецЦикла;
	
	// Зануление. Основную таблицу и таблицу по подразделениям занулять не надо, т.к. зануление (отмена) идет в строках документа.
	
	ОтборИзменениеРаспределения = Новый Структура("ИзменениеРаспределения", Истина);
	
	ПоляСвертки = "ПроектнаяЗадача, ИндексСтрокРаспределенияПоПериодам";
	ТаблицаДляАктуализацииРаспределения = ТаблицаПоПодразделениям.Скопировать(ОтборИзменениеРаспределения, 
													ПоляСвертки);
	ТаблицаДляАктуализацииРаспределения.Свернуть(ПоляСвертки);
	
	МассивЗадач = ТаблицаДляАктуализацииРаспределения.ВыгрузитьКолонку("ПроектнаяЗадача");

	ДопПараметрыАктуализацииРегистра = Новый Структура;
	ДопПараметрыАктуализацииРегистра.Вставить("ТаблицаОтбора", ТаблицаДляАктуализацииРаспределения);
	ДопПараметрыАктуализацииРегистра.Вставить("Версия", Версия);
	
	ДопОтбор = "Версия = &Версия";
	
	ДопОтборСоединение = "ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаОтбора КАК ТаблицаОтбора
	|ПО Регистр.ПроектнаяЗадача = ТаблицаОтбора.ПроектнаяЗадача
	| И Регистр.ИндексСтрокиРаспределениеПоРолям = ТаблицаОтбора.ИндексСтрокРаспределенияПоПериодам";
	
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(Движения.упоДанныеРаспределенияДоходовПоПериодам, 
			Новый Структура ("Регистратор, Период, МассивЗадач, ИмяРегистра",
				Ссылка, Дата, МассивЗадач, "упоДанныеРаспределенияДоходовПоПериодам"),,,
			ДопОтбор, ДопПараметрыАктуализацииРегистра, Ложь, ДопОтборСоединение);
			
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(Движения.упоДанныеРаспределенияРасходовПоПериодам, 
			Новый Структура ("Регистратор, Период, МассивЗадач, ИмяРегистра",
				Ссылка, Дата, МассивЗадач, "упоДанныеРаспределенияРасходовПоПериодам"),,,
			ДопОтбор, ДопПараметрыАктуализацииРегистра, Ложь, ДопОтборСоединение);
			
