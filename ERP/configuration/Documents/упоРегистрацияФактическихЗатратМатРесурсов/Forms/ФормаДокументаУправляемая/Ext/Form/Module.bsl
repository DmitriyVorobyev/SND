&НаСервере
Процедура ВыделитьНДС(СтрокаВладелец, ИмяТаблицы)
				
	ПараметрыРаспределения = упоДоходыИРасходыСервер.ПараметрыВыделенияНДСВРаспределенииПоУмолчанию();
	ПараметрыРаспределения.Проект 		= Объект.Проект;
	ПараметрыРаспределения.СтавкаНДС 	= упоДоходыИРасходыСервер.ЗначениеСтавкиНДС(СтрокаВладелец.Договор, Объект.Проект);
	
	упоДоходыИРасходыСервер.ВыделитьНДСВРаспределении(Объект, 
													СтрокаВладелец, 
													ИмяТаблицы,
													, 
													ПараметрыРаспределения);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОсновнойТаблицыПоИмениКоманды(ИмяКоманды)
			
	Если ИмяКоманды = "ВыделитьНДСЗатраты"
		Или ИмяКоманды = "ЗаполнитьПоВладельцуЗатраты" Тогда				
		ИмяТаблицы = "ЗатратыМатРесурсовФакт";														
	Иначе
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Возврат ИмяТаблицы;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы)			
		
	ИмяКолонкиСумма = "ОбщСтоимость";
	
	Если ИмяОсновнойТаблицы = "ЗатратыМатРесурсовФакт" Тогда						
		ИмяТаблицыРаспределения = "РаспределениеЗатрат";		
	Иначе
		Возврат Неопределено; // Возврат.
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ИмяТаблицыРаспределения", 	ИмяТаблицыРаспределения);
	Результат.Вставить("ИмяКолонкиСумма", 			ИмяКолонкиСумма);	
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиПоИмениКоманды(ИмяКоманды)
		
	ИмяОсновнойТаблицы = ИмяОсновнойТаблицыПоИмениКоманды(ИмяКоманды);
	Если ИмяОсновнойТаблицы = Неопределено Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Результат = ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы);	
	Если Результат = Неопределено Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Результат.Вставить("ИмяОсновнойТаблицы", 	ИмяОсновнойТаблицы);
	Результат.Вставить("УчитыватьКоличество", 	Истина);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаИзмененияРеквизитаВключитьМатРесурсыВФактРасходов()
	
	УстановитьВидимостьКолонокТЧ(Элементы.ЗатратыМатРесурсовФакт, Объект.ВключитьМатРесурсыВФактРасходов);
	УстановитьОтметкуНезаполненного();
	Элементы.ГруппаРаспределениеЗатрат.Видимость = Объект.ВключитьМатРесурсыВФактРасходов;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступКФинансовойИнформации()
	
	ДоступКФинИнформации = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	Если ДоступКФинИнформации = "Отсутствует" Тогда
		СкрытьФинансовуюИнформацию();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкрытьФинансовуюИнформацию()
	
	КолонкиСОграничениемДоступа = Новый Массив;
	
	ИмяТЧ = "ЗатратыМатРесурсовФакт";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Стоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ОбщСтоимость");
	
	ИмяТЧ = "РаспределениеЗатрат";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Сумма");

	упоРазграничениеДоступаВызовСервера.УстановитьДоступККолонкамТабличнойЧасти(Элементы,
		КолонкиСОграничениемДоступа,
		"Отсутствует");
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеСтоимостиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не РасходыПоНатуральнымПоказателям Тогда
		ДополнительныеПараметры.Вставить("ПересчитыватьКоличество", Ложь);
	КонецЕсли;

	упоРаботаСФормамиКлиент.ПересчитатьТаблицуРаспределенияЗавершение(ДополнительныеПараметры);			
	
	ВосстановитьОбнуленныйНДСПослеПересчета(ДополнительныеПараметры.ТаблицаРаспределения,
											ДополнительныеПараметры.ТекДанные,
											ДополнительныеПараметры.ИмяТаблицыВладельца);
												
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, 
																		ДополнительныеПараметры.ИмяТаблицыВладельца, 
																		ДополнительныеПараметры.ИмяТаблицыРаспределения, 
																		ДополнительныеПараметры.ИмяКолонкиОбщСтоимость,
																		ДополнительныеПараметры.ПересчитыватьКоличество);
																		
КонецПроцедуры 
																	
// Если в подчиненных строках был НДС, его сумма обнулится при пересчете по коэффициентам, т.к. в строке НДС Количество = 0. 
// Для восстановления делаем пересчет НДС.
&НаКлиенте
Процедура ВосстановитьОбнуленныйНДСПослеПересчета(ТаблицаРаспределения, СтрокаВладелец, ИмяТаблицыВладельца)
	
	СтруктураСтрокаВладелец = упоРаботаСФормамиКлиент.СтруктураСтрокиДляРасчетаНДС(ТаблицаРаспределения, СтрокаВладелец, 
		ИмяТаблицыВладельца);
		
	Если Не ЗначениеЗаполнено(СтруктураСтрокаВладелец) Тогда
		Возврат;
	КонецЕсли;
	
	ВыделитьНДС(СтруктураСтрокаВладелец, ИмяТаблицыВладельца);
		
КонецПроцедуры

#КонецОбласти

