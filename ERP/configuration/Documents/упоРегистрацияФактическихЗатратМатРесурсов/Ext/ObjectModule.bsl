// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	
	ПравилаНаложения = Новый Структура();
		
	// Правила для регистра "упоФактЗатратМатериальныхРесурсов".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактЗатратМатериальныхРесурсов.Метаданные().Имя, Правила);
	
	// Правила для табличной части "упоФактЗатратМатериальныхРесурсов" документа.
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить("ЗатратыМатРесурсовФакт", ПравилаТаблицы);
	
	// Делаем одно движение по данной ТЧ.
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ОпределениеЗатратМатРесурсовПоФакту", ПравилаДвижения);
	
	// Правила связи.
	ПравилаДвижения.Вставить("ПроектнаяЗадача"       , "Шапка_ПроектнаяЗадача");
	ПравилаДвижения.Вставить("Ресурс"                , "Ресурс");
	ПравилаДвижения.Вставить("ВидОперации"           , "ВидОперации");
	ПравилаДвижения.Вставить("КоличествоЕдНормирования", "Количество");
	ПравилаДвижения.Вставить("ЕдиницаНормирования"   , "ЕдиницаНормирования");
	ПравилаДвижения.Вставить("Стоимость"             , "ОбщСтоимость");
	
	// Правила для регистра "ФактическиеДоходыИРасходы".
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактДоходовИРасходовПоДням.Метаданные().Имя, Правила);
	
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить("ЗатратыМатРесурсовФакт", ПравилаТаблицы);
	
	// Делаем одно движение по ТЧ.
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ОпределениеФактическихДоходов", ПравилаДвижения);
	
	// Правила связи.
	ПравилаДвижения.Вставить("ПроектнаяЗадача", "Шапка_ПроектнаяЗадача");
	ПравилаДвижения.Вставить("Статья", "Статья");
	ПравилаДвижения.Вставить("ДатаНачисления", "ДатаНачисления");
	ПравилаДвижения.Вставить("ВидЭлемента", Новый Структура("Значение", Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход));
	ПравилаДвижения.Вставить("Валюта", "Валюта");
	ПравилаДвижения.Вставить("СуммаВалютная", "ОбщСтоимость");
	ПравилаДвижения.Вставить("Контрагент", "Контрагент");
	ПравилаДвижения.Вставить("Договор", "Договор");
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактДоходовИРасходовОбороты.Метаданные().Имя, Правила);
	
	// Правила готовы.
	Возврат ПравилаНаложения; 

КонецФункции

Процедура СвернутьТаблицуДвижений(ИмяРегистра, ТаблицаДвижений)
		
	КолонкиГруппировок	= "";
	КолонкиСуммирования = "";
	
	ТипЧисло = Тип("Число");
	
	РесурсыРегистра = Движения[ИмяРегистра].Метаданные().Ресурсы;
	Для каждого Ресурс Из РесурсыРегистра Цикл
		Если Ресурс.Тип.СодержитТип(ТипЧисло) Тогда
			КолонкиСуммирования = КолонкиСуммирования + ?(НЕ ПустаяСтрока(КолонкиСуммирования), ",", "") + Ресурс.Имя;
		Иначе
			КолонкиГруппировок = КолонкиГруппировок + ?(НЕ ПустаяСтрока(КолонкиГруппировок), ",", "") + Ресурс.Имя;
		КонецЕсли;	
	КонецЦикла;
		
	Для каждого Колонка Из ТаблицаДвижений.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		Если ИмяКолонки = "НомерСтроки" Тогда
			Продолжить;
		КонецЕсли;	
		Если Не РесурсыРегистра.Найти(ИмяКолонки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КолонкиГруппировок = КолонкиГруппировок + ?(НЕ ПустаяСтрока(КолонкиГруппировок), ",", "") + ИмяКолонки;
	КонецЦикла;
	ТаблицаДвижений.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
КонецПроцедуры	

// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт
			
	ТаблицаДвижения = ДанныеДвижений[Движения.упоФактЗатратМатериальныхРесурсов.Метаданные().Имя];	
		
	упоПроектыИЗадачиСервер.ЗаполнитьКоличествоПоКоличествуЕдНормированияМатериальныхЗатрат(ТаблицаДвижения);
	
	СвернутьТаблицуДвижений("упоФактЗатратМатериальныхРесурсов", ТаблицаДвижения);
		
	ТаблицаДвиженияФактическиеДоходыРасходы = ДанныеДвижений[Движения.упоФактДоходовИРасходовПоДням.Метаданные().Имя];
	ТаблицаДвиженияФактическиеДоходыРасходыПодразделения = ДанныеДвижений[Движения.упоФактДоходовИРасходовОбороты.Метаданные().Имя];
	
	// Документ должен проводиться, если в табличной части присутствует разная номенклатура от одного поставщика
	// или одна номенклатура от разных поставщиков.		
	СвернутьТаблицуДвижений("упоФактДоходовИРасходовПоДням", ТаблицаДвиженияФактическиеДоходыРасходы);
		
	Если ВключитьМатРесурсыВФактРасходов Тогда
		// Пересчет валютной суммы.
		упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвиженияФактическиеДоходыРасходы);
				
		текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
				
		СвойстваПроведения = Новый Структура;
		СвойстваПроведения.Вставить("Проект", Проект);
		СвойстваПроведения.Вставить("Версия", текущаяВерсия);
		СвойстваПроведения.Вставить("ПроектнаяЗадача", текущаяВерсия);
		
		упоАналитикаПоПодразделениямСервер.ЗаполнитьОбщиеНастройкиУчетаПоПодразделениям(ЭтотОбъект, СвойстваПроведения);
		упоАналитикаПоПодразделениямСервер.ПодготовитьТаблицыДвижений(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);
		
		СвернутьТаблицуДвижений("упоФактДоходовИРасходовОбороты", ТаблицаДвиженияФактическиеДоходыРасходыПодразделения);
		
	Иначе
		// Движений делать не нужно.
		ТаблицаДвиженияФактическиеДоходыРасходы.Очистить();
		ТаблицаДвиженияФактическиеДоходыРасходыПодразделения.Очистить();
		
	КонецЕсли;
			
КонецПроцедуры

