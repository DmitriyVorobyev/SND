&НаСервереБезКонтекста
Процедура ЗаполнитьУсловноеОформлениеФильтраИзмененныхЭтапов(Форма, ЭтоДополнительноеСоглашение, УсловноеОформлениеДляФильтраИзменений, ТолькоИзмененныеЭтапы)
	
	Если ЭтоДополнительноеСоглашение Тогда
		
		Если ЗначениеЗаполнено(УсловноеОформлениеДляФильтраИзменений) Тогда
			Для Каждого ЭлементУО Из УсловноеОформлениеДляФильтраИзменений Цикл
				Форма.УсловноеОформление.Элементы.Удалить(ЭлементУО.Значение);
			КонецЦикла;
		КонецЕсли;
		
		УсловноеОформление = Форма.УсловноеОформление;
		Элементы = Форма.Элементы;
		
		// Оформление для скрытия неизменнных этапов проекта в календарном плане.
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЭтапов.НеизмененныйЭтапВКалендарномПлане"); 
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.ПравоеЗначение = Истина;	
		ЭлементОтбора.Использование = Истина;
	
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЭтапов.Имя);
		ПолеОформления.Использование = Истина;
		СоздатьСписокПодчиненныхПолей(Элементы.ДеревоЭтапов, ЭлементОформления.Поля.Элементы);
		
		ЭлементОформления.Использование = ТолькоИзмененныеЭтапы;
		УсловноеОформлениеДляФильтраИзменений.Добавить(УсловноеОформление.Элементы.Индекс(ЭлементОформления));
		
		// Оформление для выделение серым удаленных этапов проекта в календарном плане.
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЭтапов.УдаленныйЭтапВКалендарномПлане");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.ПравоеЗначение = Истина;	
		ЭлементОтбора.Использование = Истина;
	
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЭтапов.Имя);
		ПолеОформления.Использование = Истина;
		СоздатьСписокПодчиненныхПолей(Элементы.ДеревоЭтапов, ЭлементОформления.Поля.Элементы);
		
		ЭлементОформления.Использование = Не ТолькоИзмененныеЭтапы;
		УсловноеОформлениеДляФильтраИзменений.Добавить(УсловноеОформление.Элементы.Индекс(ЭлементОформления));

		// Оформление для скрытия удаленных этапов проекта в календарном плане.
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоЭтапов.УдаленныйЭтапВКалендарномПлане");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
		ЭлементОтбора.ПравоеЗначение = Истина;	
		ЭлементОтбора.Использование = Истина;
	
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	    ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ДеревоЭтапов.Имя);
		ПолеОформления.Использование = Истина;
		СоздатьСписокПодчиненныхПолей(Элементы.ДеревоЭтапов, ЭлементОформления.Поля.Элементы);
		
		ЭлементОформления.Использование = ТолькоИзмененныеЭтапы;
		УсловноеОформлениеДляФильтраИзменений.Добавить(УсловноеОформление.Элементы.Индекс(ЭлементОформления));

	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста 
Процедура СоздатьСписокПодчиненныхПолей(ЭлементФормы, СписокПолей)

	Для Каждого Элемент Из ЭлементФормы.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда		
			ПолеОформления = СписокПолей.Добавить();

			ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элемент.Имя);
			ПолеОформления.Использование = Истина;
		Иначе
			СоздатьСписокПодчиненныхПолей(Элемент, СписокПолей);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолей(РегулированиеТолькоПоТипуДоговора = Ложь)
		
	ДоговорДоходный = УсловияДоговораДоходные(Объект.ТипЮридическихУсловийДоговора);
	ДоговорРасходный = УсловияДоговораРасходные(Объект.ТипЮридическихУсловийДоговора);
						
	Элементы.ДеревоЭтаповДобавитьСтатьюБДР.Видимость = ДоговорДоходный;
	Элементы.ДеревоЭтаповДобавитьСтатьюПоступлений.Видимость = ДоговорДоходный;
	Элементы.ФормаЗаполнитьПоПроектуДоход.Видимость = ДоговорДоходный;
	Элементы.ФормаЗаполнитьПоШаблонуДоход.Видимость = ДоговорДоходный;
	
	Элементы.ДеревоЭтаповДобавитьСтатьюРасходов.Видимость = ДоговорРасходный;
	Элементы.ДеревоЭтаповДобавитьСтатьюВыплат.Видимость = ДоговорРасходный;
	Элементы.ФормаЗаполнитьПоПроектуРасход.Видимость = ДоговорРасходный;
	Элементы.ФормаЗаполнитьПоШаблонуРасход.Видимость = ДоговорРасходный;
	
	Элементы.ФормаЗаполнитьПоПроектуДоходРасход.Видимость = ДоговорДоходный И ДоговорРасходный;
	Элементы.ФормаЗаполнитьПоШаблонуДоходРасход.Видимость = ДоговорДоходный И ДоговорРасходный;
	
	Элементы.ФормаЗаполнитьПоПроектуПоКонтрагенту.Видимость = ДоговорДоходный Или ДоговорРасходный;
	ВведенКонтрагент = ЗначениеЗаполнено(Объект.Контрагент);
	Элементы.ФормаЗаполнитьПоПроектуПоКонтрагентуИДоговору.Видимость = ВведенКонтрагент И (ДоговорДоходный Или ДоговорРасходный);
	
	УстановитьДоступностьЭлементаИПодчиненных(Элементы.Заполнить, Объект.ИспользоватьЭтапы);
	
	Если РегулированиеТолькоПоТипуДоговора Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ЭтоДополнительноеСоглашение Тогда
		Элементы.Группа1.Видимость = Ложь;	
		Элементы.ОсновныеШапка.Видимость = Ложь;
		Элементы.СтраницаДокументы.Видимость = Ложь;
		Элементы.ПоследнееДополнительноеСоглашение.Видимость = Ложь;
		
		ЭУСоздатьРегистрациюЮрУсловийНаОсновании = Элементы.Найти("ФормаДокументупоРегистрацияЮридическихУсловийДоговораСоздатьНаОсновании");
		Если НЕ ЭУСоздатьРегистрациюЮрУсловийНаОсновании = Неопределено Тогда
			ЭУСоздатьРегистрациюЮрУсловийНаОсновании.Видимость = Ложь;
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Заголовок = НСтр("ru = 'Дополнительное соглашение (создание)'");
		Иначе
			Заголовок = НСтр("ru = 'Дополнительное соглашение %1 от %2'");
		КонецЕсли;
	Иначе
		
		Элементы.ГруппаПроекта.Видимость = Ложь;
		Элементы.ТолькоИзмененныеЭтапы.Видимость = Ложь;
		
		ДокОснованиеЗаполнен = ЗначениеЗаполнено(Параметры.Ключ);
		ДополнительныеСоглашения.Параметры.УстановитьЗначениеПараметра("Договор", Параметры.Ключ);
		ДополнительныеСоглашения.Параметры.УстановитьЗначениеПараметра("ДокОснованиеЗаполнен", ДокОснованиеЗаполнен);
		
		ПоследнееДополнительноеСоглашение = Документы.упоРегистрацияЮридическихУсловийДоговора.ПолучитьПоследнийАктуальныйДокументИзмененияДоговора(Параметры.Ключ);
		ЕстьДопСоглашение = ЗначениеЗаполнено(ПоследнееДополнительноеСоглашение);
		
		Элементы.ИспользоватьЭтапы.Доступность = НЕ ЕстьДопСоглашение;
		Элементы.ДеревоЭтаповГруппаКоманд.Доступность = НЕ ЕстьДопСоглашение;
		Элементы.Добавить.Доступность = НЕ ЕстьДопСоглашение;
		Элементы.ДеревоЭтаповГруппаУровень.Доступность = НЕ ЕстьДопСоглашение;
		Элементы.Заполнить.Доступность = НЕ ЕстьДопСоглашение; 		
		Элементы.ПоследнееДополнительноеСоглашение.Видимость = ЕстьДопСоглашение;
		Элементы.ДеревоЭтапов.КоманднаяПанель.ТолькоПросмотр = ЕстьДопСоглашение;
		Элементы.ДеревоЭтапов.ТолькоПросмотр = ЕстьДопСоглашение;
		Элементы.ПараметрыГрафика.ТолькоПросмотр = ЕстьДопСоглашение;
		Элементы.ТипЮридическихУсловийДоговора.ТолькоПросмотр = ЕстьДопСоглашение;
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Заголовок = НСтр("ru = 'Регистрация юридических условий договора (создание)'");
		Иначе
			Заголовок = НСтр("ru = 'Регистрация юридических условий договора %1 от %2'");
		КонецЕсли;	
		
	КонецЕсли;
	
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Заголовок, СокрЛП(Объект.Номер), Строка(Объект.Дата));
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда 
		ИспользоватьЭтапыОснование = Объект.ДокументОснование.ИспользоватьЭтапы;
	Иначе
		ИспользоватьЭтапыОснование = Ложь;
	КонецЕсли;
	
	Элементы.СуммаДоговора.Доступность 			= НЕ Объект.ИспользоватьЭтапы;
	Элементы.СуммаДоговораДопСоглашение.Доступность = НЕ ИспользоватьЭтапыОснование;
	Элементы.ЭтапыОсновногоДоговора.Видимость	= Объект.ИспользоватьЭтапы ИЛИ ИспользоватьЭтапыОснование;
	Элементы.ТолькоИзмененныеЭтапы.Пометка = Объект.ТолькоИзмененныеЭтапы;

КонецПроцедуры

