&НаСервереБезКонтекста
Процедура ЗаписатьОшибкуВЖурналРегистрации(Ссылка, ОписаниеОшибки)

	ЗаписьЖурналаРегистрации("Ошибка выполнения",
								 УровеньЖурналаРегистрации.Ошибка,
								 Метаданные.Документы.упоРегистрацияЮридическихУсловийДоговора,
								 Ссылка,
								 ОписаниеОшибки);	

КонецПроцедуры // ЗаписатьОшибкуВЖурналРегистраци()

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)	
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ТекущийОбъект.лмПроверитьЗаполнениеРеквизитов(Отказ);
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	Если Объект.ЭтоДополнительноеСоглашение Тогда
		КолонкиДляСверки = Новый Соответствие;
		КолонкиДляСверки.Вставить("УдаленныйЭтапВКалендарномПлане", Истина);
	Иначе
		КолонкиДляСверки = Неопределено;
	КонецЕсли;

	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Если НеобходимоСверитьЭтапы Тогда
		ПроверитьИзмененныеУдаленныеЭтапы();
	КонецЕсли;
	
	СтруктураДляНовыхЭтапов = Новый Структура();
	ТекущийПОльзователь = ПользователиКлиентСервер.ТекущийПользователь();
	СтруктураДляНовыхЭтапов.Вставить("Автор", ТекущийПользователь);
	СтруктураДляНовыхЭтапов.Вставить("АвторИзменений", ТекущийПользователь);
	СтруктураДляНовыхЭтапов.Вставить("ДатаМодификации", ТекущаяДатаСеанса());
	//СтруктураДляНовыхЭтапов.Вставить("Комментарий");
	СтруктураДляНовыхЭтапов.Вставить("Наименование");
	СтруктураДляНовыхЭтапов.Вставить("ПолноеНаименование");
	//СтруктураДляНовыхЭтапов.Вставить("НомерЭтапа");
	СтруктураДляНовыхЭтапов.Вставить("ЮридическоеУсловиеДоговора", ?(ЗначениеЗаполнено(ТекущийОбъект.Ссылка), ТекущийОбъект.Ссылка, ТекущийОбъект.ПолучитьСсылкуНового()));
	Попытка
		упоУправлениеДоговорамиКлиентСервер.СохранитьДеревоВТаблицу(ДеревоЭтапов, ТекущийОбъект,,, КолонкиДляСверки, СтруктураДляНовыхЭтапов);
	Исключение
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();	
		ЗаписатьОшибкуВЖурналРегистрации(Объект.Ссылка, ОписаниеОшибки());
	КонецПопытки;

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

