&НаСервере
Функция ЗаполнитьДеревоЭтаповСервер()
	
	ДеревоЭтапов.ПолучитьЭлементы().Очистить();
	
	ДеревоДляЗаполнения = ДанныеФормыВЗначение(ДеревоЭтапов, Тип("ДеревоЗначений")); 
	Дерево = упоОперацииСДеревьямиСервер.ВыгрузитьТаблицуЗначенийВДеревоЗначений(Объект.Этапы, ДеревоДляЗаполнения,
		"ИндексСвязиЭтапа", "ИндексСвязиЭтапаРодитель", "Этап", "ЭтапРодитель");
	упоУправлениеДоговорамиСервер.ДобавитьВДеревоБДРиБДДС(Дерево, Объект.ГрафикНачислений, Объект.ГрафикОплаты);
	
	упоУправлениеДоговорамиСервер.ПроставитьКартинкиЭтапов(Дерево);
	ЗначениеВРеквизитФормы(Дерево,"ДеревоЭтапов");
	
	ОбновитьСуммуДоговора(ДеревоЭтапов, Объект);
	
	Если Объект.ЭтоДополнительноеСоглашение Тогда
		ПроверитьИзмененныеУдаленныеЭтапы(Истина, Ложь);
	КонецЕсли;
	
КонецФункции

