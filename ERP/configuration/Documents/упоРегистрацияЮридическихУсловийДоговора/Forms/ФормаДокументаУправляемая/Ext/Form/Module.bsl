&НаСервере
Процедура ЗаполнитьПоПроектуШаблонуНаСервере(ДополнительныеПараметры)
	
	
	СтруктураДоговора = Новый Структура;
	Для Каждого ДопПараметр Из ДополнительныеПараметры Цикл
		Если ДопПараметр.Ключ = "Режим" Тогда
			Режим = ДополнительныеПараметры.Режим;
		ИначеЕсли ДопПараметр.Ключ = "ПроектШаблон" Тогда
			ПроектШаблон = ДополнительныеПараметры.ПроектШаблон;
		ИначеЕсли ДопПараметр.Ключ = "РежимДоходыРасходы" Тогда 
			РежимДоходыРасходы = ДополнительныеПараметры.РежимДоходыРасходы;
		Иначе
			СтруктураДоговора.Вставить(ДопПараметр.Ключ, ДопПараметр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураДоговора.Вставить("Проект", Объект.Проект);
	СтруктураДоговора.Вставить("ДатаДокумента", Объект.Дата);
	СтруктураДоговора.Вставить("ДоговорВзаиморасчетов", Объект.ДоговорВзаиморасчетов);
	СтруктураДоговора.Вставить("Валюта", Объект.Валюта);
	СтруктураДоговора.Вставить("Этапы", Объект.Этапы.Выгрузить());
	СтруктураДоговора.Вставить("ГрафикНачислений", Объект.ГрафикНачислений.Выгрузить());
	СтруктураДоговора.Вставить("ГрафикОплаты", Объект.ГрафикОплаты.Выгрузить());
	СтруктураДоговора.Вставить("СвязиЭтаповДоговораСПроектнымКонтуром", Объект.СвязиЭтаповДоговораСПроектнымКонтуром.Выгрузить());
	СтруктураДоговора.Вставить("РежимЗаполнения", РежимДоходыРасходы); // Непоределено - только структура; 0 - дходы+расходы; 1 - доходы; 2 - расходы;

	Если Режим = 1 Тогда
		упоУправлениеДоговорамиСервер.ЗаполнитьЮридическиеУсловияПоПроекту(ПроектШаблон, СтруктураДоговора);
	ИначеЕсли Режим = 2 Тогда
		упоУправлениеДоговорамиСервер.ЗаполнитьДоговорПоШаблону(ПроектШаблон, СтруктураДоговора);
	КонецЕсли;
	
	ДоговорОбъект = РеквизитФормыВЗначение("Объект");
	
	ДоговорОбъект.СхемаОплаты = Справочники.упоСхемыОплаты.ПустаяСсылка();
	ДоговорОбъект.Этапы.Загрузить(СтруктураДоговора.Этапы);	
	ДоговорОбъект.ГрафикНачислений.Загрузить(СтруктураДоговора.ГрафикНачислений);
	ДоговорОбъект.ГрафикОплаты.Загрузить(СтруктураДоговора.ГрафикОплаты); 	
	ДоговорОбъект.СвязиЭтаповДоговораСПроектнымКонтуром.Загрузить(СтруктураДоговора.СвязиЭтаповДоговораСПроектнымКонтуром);
	
	ЗначениеВРеквизитФормы(ДоговорОбъект, "Объект");

	ЗаполнитьДеревоЭтаповСервер();
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПроектуШаблону(Режим, РежимДоходыРасходы, ДопПараметры = Неопределено)
	
	Если НЕ Объект.ИспользоватьЭтапы И НЕ ИспользоватьЭтапыОснование Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Загрузка невозможна! В документе не используются этапы!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли; 	
	
	МассивТипов = Новый Массив;
	Если Режим = 1 Тогда
		МассивТипов.Добавить(Тип("СправочникСсылка.Проекты"));
		Подсказка = НСтр("ru = 'Выберите проект'");
	ИначеЕсли Режим = 2 Тогда
		МассивТипов.Добавить(Тип("СправочникСсылка.упоШаблоныПроектов"));
		Подсказка = НСтр("ru = 'Выберите шаблон'");
	КонецЕсли;
	
	ПроектШаблон = Неопределено;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Режим",Режим);
	ДополнительныеПараметры.Вставить("РежимДоходыРасходы",РежимДоходыРасходы);
	ДополнительныеПараметры.Вставить("ПроектШаблон",ПроектШаблон);
	Если ДопПараметры <> Неопределено Тогда
		Для Каждого ДопЭлемент Из ДопПараметры Цикл
			ДополнительныеПараметры.Вставить(ДопЭлемент.Ключ, ДопЭлемент.Значение);
		КонецЦикла;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоПроектуШаблонуЗавершение",ЭтотОбъект,ДополнительныеПараметры);
	
	Если Объект.ЭтоДополнительноеСоглашение И Режим = 1 Тогда
	
		ПараметрыВыбораЗадачи = Новый Структура;
		ПараметрыВыбораЗадачи.Вставить("РежимВыбора", Истина);
		ПараметрыВыбораЗадачи.Вставить("ВыбиратьЗадачиИПроекты", Истина);
		ПараметрыВыбораЗадачи.Вставить("Отбор", Новый Структура("Организация", ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Организация")));

		ОткрытьФорму("Справочник.Проекты.ФормаСписка", ПараметрыВыбораЗадачи,,,,,ОписаниеОповещения);
		
	Иначе
		ПоказатьВводЗначения(ОписаниеОповещения, ПроектШаблон, Подсказка, Новый ОписаниеТипов(МассивТипов));
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПроектуШаблонуЗавершение(ПроектШаблон, ДополнительныеПараметры) Экспорт
	
	Если ПроектШаблон = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Режим = 1 Тогда
		Если ЗначениеРеквизитаОбъекта(ПроектШаблон, "ЭтоПроектнаяЗадача") Тогда
			ПроектШаблон = ЗначениеРеквизитаОбъекта(ПроектШаблон, "упоКорневойПроект");
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ПроектШаблон", ПроектШаблон);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоПроектуШаблонуЗавершение2",ЭтотОбъект,ДополнительныеПараметры);
	ТекстВопроса = НСтр("ru = 'Графики будут перезаполнены. Продолжить?'");
	
	ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса, РежимДиалогаВопрос.ДаНет, 120, КодВозвратаДиалога.Да);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПроектуШаблонуЗавершение2(Ответ,ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоПроектуШаблонуНаСервере(ДополнительныеПараметры);
	
	упоУправлениеДоговорамиКлиент.ПересчитатьИтогиВсегоГрафикаДляУсловногоОформления(Объект);
	
	Модифицированность = Истина;
	
	Если ДополнительныеПараметры.Режим = 1 И НЕ Объект.ДоговорСвязанСНесколькимиПроектами Тогда
		Объект.Проект = ДополнительныеПараметры.ПроектШаблон;
	КонецЕсли;
	
	ОбновитьСуммуДоговора(ДеревоЭтапов, Объект);
		
	Если Не Объект.ЭтоДополнительноеСоглашение Тогда
		Если ДополнительныеПараметры.Режим = 1 Тогда
			Объект.Организация = ЗначениеРеквизитаОбъекта(ДополнительныеПараметры.ПроектШаблон, "Организация"); 
		Иначе
			Объект.Организация = ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
		КонецЕсли;
	КонецЕсли;
	
	РазвернутьДерево();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуЭтапа(ТипЭлемента)
	
	// 0 - Модель
	// 1 - Этап
	// 2 - Пакет
	// 3 - Доход
	// 4 - Расход
	// 5 - Поступление
	// 6 - Выплата
	
	ТипДобавленногоЭлемента = ТипЭлемента;
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные; 
	
	Если ТекущиеДанные = Неопределено Тогда	
		Элементы.ДеревоЭтапов.ДобавитьСтроку();  
		Если ТекущиеДанные <> Элементы.ДеревоЭтапов.ТекущиеДанные Тогда
			НоваяСтрока = Элементы.ДеревоЭтапов.ТекущиеДанные;
			Если НоваяСтрока = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТекущиеДанные.ТипЭлемента = 1 И ТипДобавленногоЭлемента < 5
				Или ТекущиеДанные.ТипЭлемента = 0 И (ТипДобавленногоЭлемента = 3 Или ТипДобавленногоЭлемента = 4)
				Или ТекущиеДанные.ТипЭлемента = 3 И ТипДобавленногоЭлемента = 5 
				Или ТекущиеДанные.ТипЭлемента = 4 И ТипДобавленногоЭлемента = 6 Тогда
		НоваяСтрока = ТекущиеДанные.ПолучитьЭлементы().Добавить();
	Иначе
		Возврат;
	КонецЕсли;
	НоваяСтрока.ТипЭлемента = ТипДобавленногоЭлемента;
	Если ТипДобавленногоЭлемента = 0 Тогда
		НоваяСтрока.ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
	ИначеЕсли ТипДобавленногоЭлемента = 1 Тогда
		НоваяСтрока.ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Этап");  			
	КонецЕсли;
	НоваяСтрока.ИндексСвязиЭтапаРодитель = ?(ТекущиеДанные = Неопределено, 0, ТекущиеДанные.ИндексСвязиЭтапа);
	Если ТипДобавленногоЭлемента < 3 Тогда
		НоваяСтрока.ИндексСвязиЭтапа = НайтиМаксимальныйИндексСвязиЭтапов(ДеревоЭтапов.ПолучитьЭлементы()) + 1;
		ИндексСвязиЭтапов = НоваяСтрока.ИндексСвязиЭтапа;
	Иначе
		НоваяСтрока.ИндексСвязиЭтапа = НоваяСтрока.ИндексСвязиЭтапаРодитель;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиМаксимальныйИндексСвязиЭтапов(СтрокиДерева)
	
	Если ИндексСвязиЭтапов > 0 Тогда
		Возврат ИндексСвязиЭтапов;
	КонецЕсли;
	
	МаксимальныИндекс = 0;
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		МаксимальныИндекс = Макс(МаксимальныИндекс, СтрокаДерева.ИндексСвязиЭтапа, НайтиМаксимальныйИндексСвязиЭтапов(СтрокаДерева.ПолучитьЭлементы()));
	КонецЦикла;
	
	Возврат МаксимальныИндекс;

КонецФункции	

