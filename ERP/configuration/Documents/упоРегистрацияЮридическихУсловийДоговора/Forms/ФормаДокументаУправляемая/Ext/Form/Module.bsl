&НаКлиенте
Процедура ЗаполнитьПоПроектуПоКонтрагенту(Команда)
	
	Режим = 1;
	ДоговорДоходный = УсловияДоговораДоходные(Объект.ТипЮридическихУсловийДоговора);
	ДоговорРасходный = УсловияДоговораРасходные(Объект.ТипЮридическихУсловийДоговора);
	Если ДоговорДоходный И ДоговорРасходный Тогда
		РежимДоходыРасходы = 0; 
	ИначеЕсли ДоговорДоходный Тогда
		РежимДоходыРасходы = 1; 
	ИначеЕсли ДоговорРасходный Тогда 
		РежимДоходыРасходы = 2; 
	КонецЕсли;

	Объект.КонтрагентЗаполнения = Объект.Контрагент;           
	Если Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходный") Тогда
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагенту");
	ИначеЕсли Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.Доходный") Тогда
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагенту");
	ИначеЕсли Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.Расходный") Тогда
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагенту");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("Контрагент", Объект.КонтрагентЗаполнения);
	ЗаполнитьПоПроектуШаблону(Режим, РежимДоходыРасходы, ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПроектуПоКонтрагентуИДоговору(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоПроектуПоКонтрагентуИДоговоруЗавершение", ЭтотОбъект);
	ПараметрыФормыВыбора = Новый Структура;	
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", Объект.ДоговорВзаиморасчетов);
	ПараметрыФормыВыбора.Вставить("РежимОткрытияОкна", РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	ПараметрыФормыВыбора.Вставить("ЗаголовокФормыПодбора", НСтр("ru = 'Подбор договора контрагента'"));
	
	ФиксированныеНастройки = Новый НастройкиКомпоновкиДанных;
	ЭлементНастройки = ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементНастройки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент");
	ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементНастройки.ПравоеЗначение = Объект.Контрагент;
	ЭлементНастройки.Использование = Истина;
	ЭлементНастройки.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ПараметрыФормыВыбора.Вставить("ФиксированныеНастройки", ФиксированныеНастройки);

	ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаВыбора", ПараметрыФормыВыбора, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	//ПоказатьВводЗначения(ОписаниеОповещения, Объект.ДоговорВзаиморасчетов);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПроектуПоКонтрагентуИДоговоруЗавершение(ДоговорВзаиморасчетов, ДополнительныеПараметры = Неопределено) Экспорт

	Если ДоговорВзаиморасчетов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Режим = 1;
	ДоговорДоходный = УсловияДоговораДоходные(Объект.ТипЮридическихУсловийДоговора);
	ДоговорРасходный = УсловияДоговораРасходные(Объект.ТипЮридическихУсловийДоговора);
	Если ДоговорДоходный И ДоговорРасходный Тогда
		РежимДоходыРасходы = 0; 
	ИначеЕсли ДоговорДоходный Тогда
		РежимДоходыРасходы = 1; 
	ИначеЕсли ДоговорРасходный Тогда 
		РежимДоходыРасходы = 2; 
	КонецЕсли;
	
	Объект.КонтрагентЗаполнения = Объект.Контрагент;
	Объект.ДоговорКонтрагентаЗаполнения = ДоговорВзаиморасчетов;
        
	Если Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходный") Тогда
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагентуИДоговору");
	ИначеЕсли Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.Доходный") Тогда
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагентуИДоговору");
	ИначеЕсли Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.Расходный") Тогда
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагентуИДоговору");
	КонецЕсли;

	Если Не (ЗначениеЗаполнено(Объект.ДоговорВзаиморасчетов) И Объект.ДетализацияПоДоговорамВзаиморасчетов) Тогда
		Объект.ДоговорВзаиморасчетов = ДоговорВзаиморасчетов;
		Объект.ПоКаждомуЭтапуОтдельныйДоговорВзаиморасчетов = Ложь;
		Объект.ДетализацияПоДоговорамВзаиморасчетов = Истина;
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("Контрагент, ДоговорКонтрагента", Объект.КонтрагентЗаполнения, Объект.ДоговорКонтрагентаЗаполнения);
	ЗаполнитьПоПроектуШаблону(Режим, РежимДоходыРасходы, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
