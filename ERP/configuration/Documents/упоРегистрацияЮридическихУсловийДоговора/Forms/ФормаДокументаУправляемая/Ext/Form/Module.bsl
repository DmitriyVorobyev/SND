&НаКлиенте
Процедура ТипЮридическихУсловийДоговораПриИзменении(Элемент)
	
	Доходный = УсловияДоговораДоходные(Объект.ТипЮридическихУсловийДоговора);
	Расходный = УсловияДоговораРасходные(Объект.ТипЮридическихУсловийДоговора);
	
	Если Объект.Этапы.Количество() > 0 И Не (Доходный И Расходный) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ТипЮридическихУсловийДоговораПриИзмененииЗавершение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Изменение типа юридических условий договора приведет к очищению этапов договора. Продолжить?'"), РежимДиалогаВопрос.ДаНет, 120,
			КодВозвратаДиалога.Нет);
			
	Иначе
			
		ТипЮридическихУсловийДоговораПриИзмененииЗавершение(Неопределено, Неопределено);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТипЮридическихУсловийДоговораПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьДеревоЭтапов();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.ТипЮридическихУсловийДоговора = ТекущийТипЮрУсловийДоговора;
		Возврат;
	КонецЕсли;
	
	ТекущийТипЮрУсловийДоговора = Объект.ТипЮридическихУсловийДоговора;
	УстановитьВидимостьПолей(Истина);
	
КонецПроцедуры	

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	Если КонтрагентДоИзменения <> Объект.Контрагент
		И (Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагенту")
			Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагентуИДоговору")
			Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагенту")
			Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагентуИДоговору")
			Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагенту")
			Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагентуИДоговору"))
		И (ДеревоЭтапов.ПолучитьЭлементы().Количество() > 0) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("КонтрагентПриИзмененииЗавершение", ЭтотОбъект);
		
		Если Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагенту") 
				Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагенту")
				Или Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагенту") Тогда
			ТекстЗаполнения = НСтр("ru = 'по контрагенту %1'");
		Иначе
			ТекстЗаполнения = НСтр("ru = 'по контрагенту %1 и договору %2'");
		КонецЕсли;
		ТекстЗаполнения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаполнения, Объект.КонтрагентЗаполнения, Объект.ДоговорКонтрагентаЗаполнения);
		
		ТекстВопроса = НСтр("ru = 'Таблица этапов заполнена %1. 
									|Необходимо ли очистить таблицу этапов для новых условий заполнения?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ТекстЗаполнения);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 120, КодВозвратаДиалога.Нет, НСтр("ru = 'Внимание'"));
		Возврат;
		
	Иначе
		
		КонтрагентПриИзмененииЗавершение(КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура КонтрагентПриИзмененииЗавершение(Ответ, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Объект.Контрагент = КонтрагентДоИзменения;
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда 
		Объект.ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходный");
		Объект.КонтрагентЗаполнения = Неопределено;
		Объект.ДоговорКонтрагентаЗаполнения = Неопределено;
		КонтрагентДоИзменения = Объект.Контрагент;
		
		ОчиститьДеревоЭтапов();
	КонецЕсли;
	
	ИзменениеПредставлениеДоговора("Контрагент");
	УстановитьВидимостьПолей();
	
КонецПроцедуры

