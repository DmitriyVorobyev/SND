&НаКлиенте
Процедура КомандаПонизитьУровеньЗадачи(Команда)
	
	Отказ = Ложь;
	ПроверитьВозможностьИзмененияУровня(Элементы, ДеревоЭтапов, 2, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	упоУправлениеДоговорамиКлиент.КомандаПонизитьУровеньЗадачи(Элементы, ДеревоЭтапов); 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПовыситьУровеньЗадачи(Команда)
	
	Отказ = Ложь;
	ПроверитьВозможностьИзмененияУровня(Элементы, ДеревоЭтапов, 1, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	упоУправлениеДоговорамиКлиент.КомандаПовыситьУровеньЗадачи(Элементы, ДеревоЭтапов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВозможностьИзмененияУровня(Элементы, Дерево, Направление, Отказ) 
	
	ПерваяВыделенняСтрока = Элементы.ДеревоЭтапов.ВыделенныеСтроки[0];
	ПервыйСдвигаемыйЭлемент = Дерево.НайтиПоИдентификатору(ПерваяВыделенняСтрока);
	
	старыйРодитель = ПервыйСдвигаемыйЭлемент.ПолучитьРодителя();
		
	Если Направление = 1 Тогда
		новыйРодитель = Неопределено;		
		Если НЕ старыйРодитель = Неопределено Тогда
			новыйРодитель = старыйРодитель.ПолучитьРодителя();
			Если новыйРодитель = Неопределено Тогда
				новыйРодитель = Дерево;
			КонецЕсли; 			
			идВставки = новыйРодитель.ПолучитьЭлементы().Индекс(старыйРодитель) + 1;
		КонецЕсли;
	ИначеЕсли Направление = 2 Тогда
		новыйРодитель = упоОперацииСДеревьямиКлиент.ОпределитьПредыдущуюСтроку(Дерево, ПервыйСдвигаемыйЭлемент, СтарыйРодитель);
	КонецЕсли;
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ДеревоЭтапов.ВыделенныеСтроки Цикл
	
		СдвигаемыйЭлемент = Дерево.НайтиПоИдентификатору(ВыделеннаяСтрока); 
		
		Если НовыйРодитель <> Неопределено Тогда
			упоУправлениеДоговорамиКлиент.ПроверитьВозможностьПодчинения(СдвигаемыйЭлемент, НовыйРодитель, Отказ);
		КонецЕсли;
		
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтруктуруДоговора(Команда)
	
	Если Объект.ЭтоДополнительноеСоглашение Тогда
		КолонкиДляСверки = Новый Соответствие;
		КолонкиДляСверки.Вставить("УдаленныйЭтапВКалендарномПлане", Истина);
	Иначе
		КолонкиДляСверки = Неопределено;
	КонецЕсли;
	
	упоУправлениеДоговорамиКлиентСервер.СохранитьДеревоВТаблицу(ДеревоЭтапов, Объект,,, КолонкиДляСверки);
	
	ПараметрыФормы = Новый Структура("ОбъектДляИзменения", Объект);
	ПараметрыФормы.Вставить("ДоговорДоходный", УсловияДоговораДоходные(Объект.ТипЮридическихУсловийДоговора));
	ПараметрыФормы.Вставить("ДоговорРасходный", УсловияДоговораРасходные(Объект.ТипЮридическихУсловийДоговора)); 
	
	ОткрытьФорму("Обработка.упоНастройкаСвязей.Форма.НастройкиСвязей", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМодель(Команда)
	
	ДобавитьСтрокуЭтапа(0);
	
