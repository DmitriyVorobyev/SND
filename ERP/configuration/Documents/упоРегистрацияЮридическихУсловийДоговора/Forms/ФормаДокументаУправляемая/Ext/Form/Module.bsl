	|ГДЕ
	|	СвязиЭтаповДоговораСПроектнымКонтуром.Ссылка В(&Договор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром.ЭтапДоговора, ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)
	|			ТОГДА Этапы.Этап
	|		ИНАЧЕ ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром.ЭтапДоговора
	|	КОНЕЦ КАК Этап,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром.ЭтапДоговора, ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром.ИндексСвязиЭтапа
	|	КОНЕЦ КАК ИндексСвязиЭтапа,
	|	Этапы.ДатаНачала КАК ДатаНачала,
	|	Этапы.ДатаОкончания КАК ДатаОкончания,
	|	Этапы.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром1.ЭтапДоговора, ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)
	|			ТОГДА Этапы.ЭтапРодитель
	|		ИНАЧЕ ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром1.ЭтапДоговора
	|	КОНЕЦ КАК ЭтапРодитель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром1.ЭтапДоговора, ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоЭтапыДоговоров.ПустаяСсылка)
