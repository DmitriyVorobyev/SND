	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Этапы = РезультатЗапроса[5].Выгрузить();
	ГрафикНачислений = РезультатЗапроса[6].Выгрузить();	
	ГрафикиОплаты = РезультатЗапроса[7].Выгрузить();	

КонецПроцедуры

&НаСервере
Процедура СверкаВДеревеБДРиБДДС(Дерево, ТаблицаБДР, ТаблицаБДДС, КолонкаРезультатаСравнения, КолонкаРезультатаПоиска, КолонкиСверкиБДР, КолонкиСверкиБДДС)
	
	// Дополняем дерево данными БДР и БДДС.
	
	// Типы элементов:
	// 0 - Модель
	// 1 - Этап
	// 2 - Пакет
	// 3 - Доход
	// 4 - Расход
	// 5 - Поступление
	// 6 - Выплата.

	// Заполнять будем с конца таблицы, потому что строки будут вставляться непосредственно под родителя,
	// таким образом порядок строк будет сохранен.
	СписокИндексовДляПовторногоПросмотра = Новый Массив;
	МассивПросмотренныхЭлементов = Новый Массив;
	ОтборСравнения = Новый Структура("Статья, ТипЭлемента, ВидДвижения, УдаленныйЭтапВКалендарномПлане");

	КоличествоПрогонов = ?(ЗначениеЗаполнено(КолонкаРезультатаСравнения) И ЗначениеЗаполнено(КолонкаРезультатаПоиска), 2, 1);
	
	Для Сч = 1 По КоличествоПрогонов Цикл
		Индекс = ТаблицаБДР.Количество() - 1;
		Пока Индекс >= 0 Цикл
			
			Если Сч > 1 И СписокИндексовДляПовторногоПросмотра.Найти(Индекс) = Неопределено Тогда
				Индекс = Индекс - 1;
				Продолжить;
			КонецЕсли;
			
			СтрокаБДР = ТаблицаБДР[Индекс];
			
			Отбор = Новый Структура();
			Если ЗначениеЗаполнено(СтрокаБДР.Этап) Тогда
				Отбор.Вставить("Этап", СтрокаБДР.Этап);
			Иначе
				Отбор.Вставить("ИндексСвязиЭтапа", СтрокаБДР.ИндексСвязиЭтапа);
			КонецЕсли;
			Отбор.Вставить("ТипЭлемента", 0);

			НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина);  	
			Если НайденныеСтроки.Количество() = 0 Тогда
				Отбор.Вставить("ТипЭлемента", 1);
				НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина); 
			КонецЕсли;
			Если НайденныеСтроки.Количество() = 0 Тогда
				РодительскаяСтрокаДерева = Дерево;
			Иначе	
				РодительскаяСтрокаДерева = НайденныеСтроки[0];	
			КонецЕсли;
			ДобавлениеНового = Истина;

			Если ЗначениеЗаполнено(КолонкаРезультатаСравнения) И ЗначениеЗаполнено(КолонкаРезультатаПоиска) Тогда 
				ОтборСравнения.Статья = СтрокаБДР.Статья;
				ОтборСравнения.УдаленныйЭтапВКалендарномПлане = Ложь;
				Если СтрокаБДР.ВидДвижения = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход Тогда
					ОтборСравнения.ТипЭлемента = 3;
				Иначе
					ОтборСравнения.ТипЭлемента = 4;
				КонецЕсли;
				ОтборСравнения.ВидДвижения = СтрокаБДР.ВидДвижения;
				
				РезультатПоискаСравнения = РодительскаяСтрокаДерева.Строки.НайтиСтроки(ОтборСравнения, Ложь);
				СтрокаРассмотрена = Ложь;
				Для Каждого СтрокаПоиска Из РезультатПоискаСравнения Цикл
					Если СтрокаПоиска[КолонкаРезультатаСравнения] Или МассивПросмотренныхЭлементов.Найти(СтрокаПоиска) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					РезультатСравнения = Истина;
					
					ДобавлениеНового = Ложь;
					Если Сч = 1 Тогда
						Для Каждого ИмяКолонки Из КолонкиСверкиБДР Цикл
							Если ИмяКолонки.Ключ = "Сумма" Тогда
								ДопИмяКолонки = "СуммаБДР";
							ИначеЕсли ИмяКолонки.Ключ = "ДатаНачисления" Тогда
								ДопИмяКолонки = "ДатаНачисленияОплаты";
							Иначе
								ДопИмяКолонки = ИмяКолонки.Ключ;
							КонецЕсли;

							РезультатСравнения = РезультатСравнения И 
											Не (СтрокаПоиска[ДопИмяКолонки] <> СтрокаБДР[ИмяКолонки.Ключ] 
												И (ЗначениеЗаполнено(СтрокаПоиска[ДопИмяКолонки]) Или ЗначениеЗаполнено(СтрокаБДР[ИмяКолонки.Ключ])));
						КонецЦикла;	
						СтрокаПоиска[КолонкаРезультатаСравнения] = РезультатСравнения;	
						СтрокаРассмотрена = СтрокаРассмотрена Или РезультатСравнения;
					Иначе
						СтрокаРассмотрена = Истина;
						МассивПросмотренныхЭлементов.Вставить(СтрокаПоиска);
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не (СтрокаРассмотрена Или ДобавлениеНового) Тогда
					СписокИндексовДляПовторногоПросмотра.Вставить(Индекс);
				КонецЕсли;
			КонецЕсли;		
						
			Если ДобавлениеНового Тогда
				
				НоваяСтрока = РодительскаяСтрокаДерева.Строки.Вставить(0);
				
				НоваяСтрока.Этап = СтрокаБДР.Статья;
				НоваяСтрока.ЭтапРодитель = СтрокаБДР.Этап;
				НоваяСтрока.ИндексСвязиЭтапаРодитель = СтрокаБДР.ИндексСвязиЭтапа;
				НоваяСтрока.ПредставлениеЭтапа = СтрокаБДР.Статья;
				НоваяСтрока.Статья = СтрокаБДР.Статья;
				Если СтрокаБДР.ВидДвижения = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход Тогда
					НоваяСтрока.ТипЭлемента = 3;
				Иначе
					НоваяСтрока.ТипЭлемента = 4;
				КонецЕсли;
				НоваяСтрока.ВидДвижения = СтрокаБДР.ВидДвижения;
				НоваяСтрока.СуммаБДР = СтрокаБДР.Сумма;
				НоваяСтрока.СхемаОплаты = СтрокаБДР.СхемаОплаты;
				НоваяСтрока.ДатаНачисленияОплаты = СтрокаБДР.ДатаНачисления;
				НоваяСтрока.Примечание = СтрокаБДР.Примечание;
				НоваяСтрока.ИндексСвязиЭтапа = СтрокаБДР.ИндексСвязиЭтапа;

				Если ЗначениеЗаполнено(КолонкаРезультатаПоиска) Тогда
			    	НоваяСтрока[КолонкаРезультатаПоиска] = Истина;
				КонецЕсли;
				
			КонецЕсли;
			Индекс = Индекс - 1;
				
		КонецЦикла;  	
	КонецЦикла;
	
	СписокИндексовДляПовторногоПросмотра = Новый Массив;
	МассивПросмотренныхЭлементов = Новый Массив;
	ОтборСравнения = Новый Структура("Статья, ТипЭлемента, ВидДвижения, УдаленныйЭтапВКалендарномПлане");
	Для Сч = 1 По КоличествоПрогонов Цикл

		Для Каждого СтрокаБДДС Из ТаблицаБДДС Цикл
			
			Если Сч > 1 И СписокИндексовДляПовторногоПросмотра.Найти(ТаблицаБДДС.Индекс(СтрокаБДДС)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Отбор = Новый Структура();
			Если ЗначениеЗаполнено(СтрокаБДДС.СтатьяБДР) Тогда
				Если ЗначениеЗаполнено(СтрокаБДДС.Этап) Тогда 
					Отбор.Вставить("ЭтапРодитель", СтрокаБДДС.Этап);
				Иначе
					Отбор.Вставить("ИндексСвязиЭтапаРодитель", СтрокаБДДС.ИндексСвязиЭтапа);
				КонецЕсли;
				Отбор.Вставить("Статья", СтрокаБДДС.СтатьяБДР);
				//Отбор.Вставить("СхемаОплаты", СтрокаБДДС.СхемаОплаты);
				Отбор.Вставить("ТипЭлемента", 3);
				НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина);      
				Если ЗначениеЗаполнено(СтрокаБДДС.СтатьяБДР) И НайденныеСтроки.Количество() = 0 Тогда
					Отбор.Вставить("ТипЭлемента", 4);
				    НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина);
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(СтрокаБДДС.Этап) Тогда 
					Отбор.Вставить("Этап", СтрокаБДДС.Этап);
				Иначе
					Отбор.Вставить("ИндексСвязиЭтапа", СтрокаБДДС.ИндексСвязиЭтапа);
				КонецЕсли;
				Отбор.Вставить("ТипЭлемента", 0);
				НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина);      
				Если НайденныеСтроки.Количество() = 0 Тогда
					Отбор.Вставить("ТипЭлемента", 1);
				    НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина);
				КонецЕсли;
			КонецЕсли;	
				
			Если НайденныеСтроки.Количество() = 0 Тогда
				РодительскаяСтрокаДерева = Дерево;
			Иначе
				РодительскаяСтрокаДерева = НайденныеСтроки[0];
			КонецЕсли;	
			ДобавлениеНового = Истина;

			// Если строка оплаты на одном уровне с этапами, то передвигаем ее вверх.
			Для ИндексДляВставки = 0 По РодительскаяСтрокаДерева.Строки.Количество() - 1 Цикл
				СоседняяСтрока = РодительскаяСтрокаДерева.Строки[ИндексДляВставки];
				Если СоседняяСтрока.ТипЭлемента = 0 ИЛИ СоседняяСтрока.ТипЭлемента = 1 Тогда
					Прервать;	
				КонецЕсли;
			КонецЦикла;
			
		    Если ЗначениеЗаполнено(КолонкаРезультатаСравнения) И ЗначениеЗаполнено(КолонкаРезультатаПоиска) Тогда 
				
				ОтборСравнения.Статья = СтрокаБДДС.Статья;
				ОтборСравнения.УдаленныйЭтапВКалендарномПлане = Ложь;
				Если СтрокаБДДС.ВидДвижения = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход 
					ИЛИ СтрокаБДДС.ВидДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление Тогда 
					ОтборСравнения.ТипЭлемента = 5;
				Иначе 
					ОтборСравнения.ТипЭлемента = 6;
				КонецЕсли;
				ОтборСравнения.ВидДвижения = СтрокаБДДС.ВидДвижения;
				
				РезультатПоискаСравнения = РодительскаяСтрокаДерева.Строки.НайтиСтроки(ОтборСравнения, Ложь);
				СтрокаРассмотрена = Ложь;

				Для Каждого СтрокаПоиска Из РезультатПоискаСравнения Цикл
					Если СтрокаПоиска[КолонкаРезультатаСравнения] Или МассивПросмотренныхЭлементов.Найти(СтрокаПоиска) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					РезультатСравнения = Истина;
					ДобавлениеНового = Ложь;
					Если Сч = 1 Тогда
						Для Каждого ИмяКолонки Из КолонкиСверкиБДДС Цикл
							Если ИмяКолонки.Ключ = "Сумма" Тогда
								ДопИмяКолонки = "СуммаБДДС";
							ИначеЕсли ИмяКолонки.Ключ = "ДатаОплаты" Тогда
								ДопИмяКолонки = "ДатаНачисленияОплаты";
							Иначе
								ДопИмяКолонки = ИмяКолонки.Ключ;
							КонецЕсли;
							
							РезультатСравнения = РезультатСравнения И 
											Не (СтрокаПоиска[ДопИмяКолонки] <> СтрокаБДДС[ИмяКолонки.Ключ] 
												И (ЗначениеЗаполнено(СтрокаПоиска[ДопИмяКолонки]) Или ЗначениеЗаполнено(СтрокаБДДС[ИмяКолонки.Ключ])));
						КонецЦикла;	
						СтрокаПоиска[КолонкаРезультатаСравнения] = РезультатСравнения;
						СтрокаРассмотрена = СтрокаРассмотрена Или РезультатСравнения;
					Иначе
						СтрокаРассмотрена = Истина;
						МассивПросмотренныхЭлементов.Вставить(СтрокаПоиска);
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не (СтрокаРассмотрена Или ДобавлениеНового) Тогда
					СписокИндексовДляПовторногоПросмотра.Вставить(ТаблицаБДДС.Индекс(СтрокаБДДС));
				КонецЕсли;
			КонецЕсли;		
						
			Если ДобавлениеНового Тогда
				НоваяСтрока = РодительскаяСтрокаДерева.Строки.Вставить(ИндексДляВставки);

				НоваяСтрока.Этап = СтрокаБДДС.Статья;
				НоваяСтрока.ЭтапРодитель = СтрокаБДДС.СтатьяБДР;
				НоваяСтрока.ПредставлениеЭтапа = СтрокаБДДС.Статья;
				НоваяСтрока.Статья = СтрокаБДДС.Статья;
				
				НоваяСтрока.ВидДвижения = СтрокаБДДС.ВидДвижения;
				Если СтрокаБДДС.ВидДвижения = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход 
					ИЛИ СтрокаБДДС.ВидДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление Тогда 
					НоваяСтрока.ТипЭлемента = 5;
				Иначе 
					НоваяСтрока.ТипЭлемента = 6;
				КонецЕсли;
					
				НоваяСтрока.СуммаБДДС = СтрокаБДДС.Сумма;
				НоваяСтрока.СхемаОплаты = СтрокаБДДС.СхемаОплаты;
				НоваяСтрока.ДатаНачисленияОплаты = СтрокаБДДС.ДатаОплаты;
				НоваяСтрока.Задержка = СтрокаБДДС.Задержка;
				НоваяСтрока.Примечание = СтрокаБДДС.Примечание;
				НоваяСтрока.ВидПривязки = СтрокаБДДС.ВидПривязки;
				НоваяСтрока.ИндексСвязиЭтапа = СтрокаБДДС.ИндексСвязиЭтапа;

				Если ЗначениеЗаполнено(КолонкаРезультатаПоиска) Тогда
			    	НоваяСтрока[КолонкаРезультатаПоиска] = Истина;
				КонецЕсли;

			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, ИмяРеквизита);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УсловияДоговораДоходные(ТипЮридическихУсловийДоговора) Экспорт
	
	Возврат ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходный")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.Доходный")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагенту")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагентуИДоговору")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагенту")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйПоКонтрагентуИДоговору");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УсловияДоговораРасходные(ТипЮридическихУсловийДоговора) Экспорт
	
	Возврат ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходный") 
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.Расходный")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагенту")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.ДоходныйРасходныйПоКонтрагентуИДоговору")
	        Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагенту")
			Или ТипЮридическихУсловийДоговора = ПредопределенноеЗначение("Перечисление.упоТипыЮридическихУсловийДоговора.РасходныйПоКонтрагентуИДоговору");

КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементаИПодчиненных(Элемент, НовоеЗначение)
	
	Элемент.Доступность = НовоеЗначение;
	Если Элемент.Вид = ВидГруппыФормы.Подменю Тогда
		Для каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
			УстановитьДоступностьЭлементаИПодчиненных(ПодчиненныйЭлемент, НовоеЗначение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСуммуДоговора(ДеревоЭтапов, Объект)

	Если Не Объект.ИспользоватьЭтапы Тогда
		Возврат;
	КонецЕсли;	

	Объект.СуммаДоговора =
		упоУправлениеДоговорамиКлиентСервер.ПересчитатьВетвьДрева(ДеревоЭтапов.ПолучитьЭлементы())["СуммаБДР"];
    
КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормы()

	СтатусДоговора = упоУправлениеДоговорамиСервер.ПолучитьСтатусДоговора(Параметры.Ключ);	
	КонтрагентДоИзменения = Объект.Контрагент;
	
	ЗаполнитьДеревоЭтаповСервер();
	УстановитьВидимостьПолей();
	
	ЗаполнитьУсловноеОформлениеФильтраИзмененныхЭтапов(ЭтаФорма, Объект.ЭтоДополнительноеСоглашение, 
		УсловноеОформлениеДляФильтраИзменений, Объект.ТолькоИзмененныеЭтапы);
		
	Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		Объект.Валюта = ПараметрыСеанса.упоВалютаУправленческогоУчета;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если Не ЗначениеЗаполнено(Объект.ДатаДоговора) Тогда
			Объект.ДатаДоговора = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

