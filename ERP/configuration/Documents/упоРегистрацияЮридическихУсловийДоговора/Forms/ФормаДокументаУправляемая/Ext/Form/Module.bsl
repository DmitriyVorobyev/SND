&НаСервере
Процедура ЗаписатьИзмененияЭтапов(ЭтапыПроектаКоллекция)
	
	Для Каждого ЭтапПодчиненный Из ЭтапыПроектаКоллекция Цикл
		
		ПодчиненныеЭтапы = ЭтапПодчиненный.ПолучитьЭлементы();
		ЗаписатьИзмененияЭтапов(ПодчиненныеЭтапы);

		Если ЭтапПодчиненный.ЭтапМодифицирован Тогда
			
			ЭтапОбъект = ЭтапПодчиненный.Этап.ПолучитьОбъект();
			ЭтапОбъект.Наименование = ЭтапПодчиненный.ПредставлениеЭтапа;
			ЭтапОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьНадписьПоследняяМодификация();
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтаФорма);
	упоУправлениеДоговорамиКлиент.ПересчитатьИтогиВсегоГрафикаДляУсловногоОформления(Объект);
	РазвернутьДерево();
	Если Объект.ЭтоДополнительноеСоглашение Тогда
		Заголовок = НСтр("ru = 'Дополнительное соглашение %1 от %2'");
	Иначе	
		Заголовок = НСтр("ru = 'Регистрация юридических условий договора %1 от %2'");
	КонецЕсли;	
	
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Заголовок, СокрЛП(Объект.Номер), Строка(Объект.Дата));
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

