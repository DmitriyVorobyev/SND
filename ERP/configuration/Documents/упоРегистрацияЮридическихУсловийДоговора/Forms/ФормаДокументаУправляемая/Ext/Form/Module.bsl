&НаКлиенте
Процедура ДеревоЭтаповПредставлениеЭтапаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ТипЭлемента = 3 Тогда
		ОткрытьФорму("Справочник.упоСтатьиДоходов.ФормаВыбора", , Элемент);
	ИначеЕсли ТекущиеДанные.ТипЭлемента = 4 Тогда		
		ОткрытьФорму("Справочник.упоСтатьиЗатрат.ФормаВыбора", , Элемент);
	ИначеЕсли ТекущиеДанные.ТипЭлемента = 5 ИЛИ ТекущиеДанные.ТипЭлемента = 6 Тогда	
		Если ТекущиеДанные.ТипЭлемента = 5 Тогда
			НаправлениеДвижения = ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление");	
		Иначе
			НаправлениеДвижения = ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата");
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;			
		Отбор = Новый Структура("упоНаправлениеДвижения", НаправлениеДвижения);
		ПараметрыФормы.Вставить("Отбор", Отбор);
		ОткрытьФорму("Справочник.СтатьиДвиженияДенежныхСредств.ФормаВыбора", ПараметрыФормы, Элемент);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПредставлениеЭтапаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	// Типы элементов:
	// 0 - Модель
	// 1 - Этап
	// 2 - Пакет
	// 3 - Доход
	// 4 - Расход
	// 5 - Поступление
	// 6 - Выплата
	
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные;
	ТекущиеДанные.Статья = ВыбранноеЗначение;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	упоУправлениеДоговорамиКлиентСервер.ЗаполнитьВидДвиженияПоСтатье(ТекущиеДанные);
	Если ТекущиеДанные.ТипЭлемента = 3 ИЛИ ТекущиеДанные.ТипЭлемента = 4 Тогда
		ТекущиеДанные.Этап = ТекущиеДанные.Статья;
		
		Если Не Родитель = Неопределено Тогда
			ТекущиеДанные.ЭтапРодитель = Родитель.Этап;
			ТекущиеДанные.ДатаНачисленияОплаты = Родитель.ДатаОкончания;
		КонецЕсли;
		
	ИначеЕсли ТекущиеДанные.ТипЭлемента = 5 ИЛИ ТекущиеДанные.ТипЭлемента = 6 Тогда
		ТекущиеДанные.Этап = ТекущиеДанные.Статья;
		
		Если Не Родитель = Неопределено Тогда
			ТекущиеДанные.ЭтапРодитель = Родитель.Этап;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ДеревоЭтаповСхемаОплатыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные;
	ПодчиненныеСтроки = ТекущиеДанные.ПолучитьЭлементы();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущиеДанные",ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ПодчиненныеСтроки",ПодчиненныеСтроки);
	
	Если ПодчиненныеСтроки.Количество() > 0 Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ДеревоЭтаповСхемаОплатыПриИзмененииЗавершение",ЭтотОбъект,ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Данные графика оплаты для текущей строки будут обновлены. Продолжить?'"), РежимДиалогаВопрос.ДаНет, 120,
			КодВозвратаДиалога.Нет);
			
	Иначе
			
		 ДеревоЭтаповСхемаОплатыПриИзмененииЗавершение("безответа",ДополнительныеПараметры);
		 
	КонецЕсли; 
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповСхемаОплатыПриИзмененииЗавершение(Ответ,ДополнительныеПараметры) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.Да И НЕ Ответ = "безответа" Тогда
		Возврат;
	КонецЕсли; 
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	ДополнительныеПараметры.ПодчиненныеСтроки.Очистить();

	Если Объект.ЭтоДополнительноеСоглашение Тогда
		КолонкиДляСверки = Новый Соответствие;
		КолонкиДляСверки.Вставить("УдаленныйЭтапВКалендарномПлане", Истина);
	Иначе
		КолонкиДляСверки = Неопределено;
	КонецЕсли;

	упоУправлениеДоговорамиКлиентСервер.СохранитьДеревоВТаблицу(ДеревоЭтапов, Объект,,, КолонкиДляСверки);
	
	СтруктураСтроки = Новый Структура;
	СтруктураСтроки.Вставить("Этап", ТекущиеДанные.ЭтапРодитель);
	СтруктураСтроки.Вставить("ИндексСвязиЭтапа", ТекущиеДанные.ИндексСвязиЭтапаРодитель);
	СтруктураСтроки.Вставить("Статья", ТекущиеДанные.Статья);
	СтруктураСтроки.Вставить("СхемаОплаты", ТекущиеДанные.СхемаОплаты);
	СтруктураСтроки.Вставить("Сумма", ТекущиеДанные.СуммаБДР);

	ДеревоЭтаповСхемаОплатыПриИзмененииНаСервере(СтруктураСтроки);
	РазвернутьДерево();
	
КонецПроцедуры

&НаСервере
Процедура ДеревоЭтаповСхемаОплатыПриИзмененииНаСервере(СтруктураСтроки)
	
	ГрафикОплаты = Объект.ГрафикОплаты;
	ДанныеПроекта = упоУправлениеДоговорамиСервер.ПолучитьДатыНачалаИОкончанияПроекта(Объект);
	Если ЗначениеЗаполнено(СтруктураСтроки.Этап) Тогда
		РезПоискаЭтапа =  Объект.Этапы.НайтиСтроки(Новый Структура("Этап", СтруктураСтроки.Этап));
	Иначе
		РезПоискаЭтапа =  Объект.Этапы.НайтиСтроки(Новый Структура("ИндексСвязиЭтапа", СтруктураСтроки.ИндексСвязиЭтапа));
	КонецЕсли;	
	Если РезПоискаЭтапа.Количество() > 0 Тогда
		ДанныеЭтапа = РезПоискаЭтапа[0];
	Иначе
		Возврат;
	КонецЕсли;
	упоУправлениеДоговорамиСервер.РассчитатьГрафикПлатежейВСтроке(Объект, ГрафикОплаты, ДанныеПроекта, ДанныеЭтапа, СтруктураСтроки);
	
	ЗаполнитьДеревоЭтаповСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	Если Копирование Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	СтрокаРодитель = Элемент.ТекущиеДанные;
	СтруктураТипЭлемента = Новый Структура("ТипЭлемента", ТипДобавленногоЭлемента);
	
	упоУправлениеДоговорамиКлиент.ПроверитьВозможностьПодчинения(СтруктураТипЭлемента, СтрокаРодитель, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементДереваЭтапов = Элементы.ДеревоЭтапов.ТекущийЭлемент;
	ИмяТекущегоЭлемента = ЭлементДереваЭтапов.Имя;
	Если СтрНайти(ИмяТекущегоЭлемента, "ПредставлениеЭтапа") Тогда
		Если ТекущиеДанные.ТипЭлемента = 3 
			Или ТекущиеДанные.ТипЭлемента = 4 
			Или ТекущиеДанные.ТипЭлемента = 5 
			ИЛИ ТекущиеДанные.ТипЭлемента = 6 Тогда	
		
			ЭлементДереваЭтапов.РедактированиеТекста = Ложь;
		Иначе 
			ЭлементДереваЭтапов.РедактированиеТекста = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПредставлениеЭтапаОткрытие(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные; 
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Этап) Тогда 
		ПоказатьЗначение(, ТекущиеДанные.Этап);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДополнительныеСоглашения

&НаКлиенте
Процедура ДополнительныеСоглашенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДополнительныеСоглашения.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	
КонецПроцедуры

#КонецОбласти

