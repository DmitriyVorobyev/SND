&НаКлиенте
Процедура ПоказатьТолькоИзмененныеЭтапы(Команда)
	
	Объект.ТолькоИзмененныеЭтапы = Не Объект.ТолькоИзмененныеЭтапы;
	Элементы.ТолькоИзмененныеЭтапы.Пометка = Объект.ТолькоИзмененныеЭтапы;
	ПоказатьТолькоИзмененныеЭтапыНаСервере();
	 
	Если НеобходимоСверитьЭтапы И Элементы.ТолькоИзмененныеЭтапы.Пометка Тогда
		ПроверитьИзмененныеУдаленныеЭтапы(Истина);
		РазвернутьДерево();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьДеревоДляСверки(СтрокиДерева)
	
	Индекс = СтрокиДерева.Количество() - 1;	
	Пока Индекс >= 0 Цикл
		СтрокаДерева = СтрокиДерева.Получить(Индекс);
		Если СтрокаДерева.НеизмененныйЭтапВКалендарномПлане Тогда
			 СтрокаДерева.НеизмененныйЭтапВКалендарномПлане = Ложь;
		КонецЕсли;
		Если СтрокаДерева.УдаленныйЭтапВКалендарномПлане Тогда
			СтрокиДерева.Удалить(Индекс);
		Иначе
			ОчиститьДеревоДляСверки(СтрокаДерева.Строки)
		КонецЕсли;	
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзмененныеУдаленныеЭтапы(ПересчитатьВетвиДерева = Ложь, ОчиститьДеревоДляСверки = Истина)
	
	ДеревоДляЗаполнения = ДанныеФормыВЗначение(ДеревоЭтапов, Тип("ДеревоЗначений")); 
	Если ОчиститьДеревоДляСверки Тогда
		ОчиститьДеревоДляСверки(ДеревоДляЗаполнения.Строки);
	КонецЕсли;
	
	ТаблицаСверкиЭтапов = Неопределено;
	ТаблицаСверкиГрафикОплаты = Неопределено;
	ТаблицаСверкиГрафикНачислений = Неопределено;

	КолонкиСверки = Новый Соответствие;
	КолонкиСверки.Вставить("ДатаНачала", Истина);
	КолонкиСверки.Вставить("ДатаОкончания", Истина);
	КолонкиСверки.Вставить("Сумма", Истина);

	ПолучитьТаблицаСверкиИзмененыхУдаленныхЭтапов(ТаблицаСверкиЭтапов, ТаблицаСверкиГрафикОплаты, ТаблицаСверкиГрафикНачислений);
	ДеревоДляЗаполнения = упоОперацииСДеревьямиСервер.ВыгрузитьТаблицуЗначенийВДеревоЗначений(ТаблицаСверкиЭтапов, ДеревоДляЗаполнения,
		"ИндексСвязиЭтапа", "ИндексСвязиЭтапаРодитель", "Этап", "ЭтапРодитель", КолонкиСверки, "НеизмененныйЭтапВКалендарномПлане");
	
	КолонкиСверкиБДР = Новый Соответствие;
	КолонкиСверкиБДР.Вставить("СхемаОплаты", Истина);
	КолонкиСверкиБДР.Вставить("Сумма", Истина);
	КолонкиСверкиБДР.Вставить("ДатаНачисления", Истина);
	
	КолонкиСверкиБДДС = Новый Соответствие;
	КолонкиСверкиБДДС.Вставить("СхемаОплаты", Истина);
	КолонкиСверкиБДДС.Вставить("Сумма", Истина);
	КолонкиСверкиБДДС.Вставить("ДатаОплаты", Истина);
	КолонкиСверкиБДДС.Вставить("Задержка", Истина);
	КолонкиСверкиБДДС.Вставить("ВидПривязки", Истина);

	СверкаВДеревеБДРиБДДС(ДеревоДляЗаполнения, ТаблицаСверкиГрафикНачислений, ТаблицаСверкиГрафикОплаты, "НеизмененныйЭтапВКалендарномПлане", "УдаленныйЭтапВКалендарномПлане", КолонкиСверкиБДР, КолонкиСверкиБДДС);
	ПроверитьИзмененияРодителейПоДетям(ДеревоДляЗаполнения.Строки);
	НеобходимоСверитьЭтапы = Ложь;
	
	упоУправлениеДоговорамиСервер.ПроставитьКартинкиЭтапов(ДеревоДляЗаполнения);
	ЗначениеВРеквизитФормы(ДеревоДляЗаполнения, "ДеревоЭтапов");
	
	Если ПересчитатьВетвиДерева Тогда
		упоУправлениеДоговорамиКлиентСервер.ПересчитатьВетвьДрева(ДеревоЭтапов.ПолучитьЭлементы())
	КонецЕсли;

	ДеревоДляЗаполнения = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзмененияРодителейПоДетям(Дерево, Неизмененные = Истина)
	
	Для Каждого СтрокаДерева Из Дерево Цикл	
		Проверка = СтрокаДерева.НеизмененныйЭтапВКалендарномПлане;
		ПроверитьИзмененияРодителейПоДетям(СтрокаДерева.Строки, Проверка);
		Неизмененные = СтрокаДерева.НеизмененныйЭтапВКалендарномПлане И Неизмененные;		
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(Дерево.Родитель) Тогда
		Дерево.Родитель.НеизмененныйЭтапВКалендарномПлане = Дерево.Родитель.НеизмененныйЭтапВКалендарномПлане И Неизмененные;
		Неизмененные = Истина;		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьТолькоИзмененныеЭтапыНаСервере()
	
	Для Каждого ЭлементСписка Из УсловноеОформлениеДляФильтраИзменений Цикл
		
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Получить(ЭлементСписка.Значение);
		ЭлементУО.Использование = Не ЭлементУО.Использование;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьТаблицаСверкиИзмененыхУдаленныхЭтапов(Этапы, ГрафикиОплаты, ГрафикНачислений)
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Договор = Документы.упоРегистрацияЮридическихУсловийДоговора.ПолучитьПоследнийАктуальныйДокументИзмененияДоговора(Объект.ДокументОснование, Объект.Ссылка);
	Иначе
		Договор = Документы.упоРегистрацияЮридическихУсловийДоговора.ПолучитьПоследнийАктуальныйДокументИзмененияДоговора(Объект.ДокументОснование);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Договор = Объект.ДокументОснование;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("СвязиЭтаповДоговораСПроектнымКонтуром", Объект.СвязиЭтаповДоговораСПроектнымКонтуром.Выгрузить());

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СвязиЭтаповДоговораСПроектнымКонтуром.ЭтапДоговора КАК ЭтапДоговора,
	|	СвязиЭтаповДоговораСПроектнымКонтуром.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	СвязиЭтаповДоговораСПроектнымКонтуром.Проект КАК Проект,
	|	СвязиЭтаповДоговораСПроектнымКонтуром.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	СвязиЭтаповДоговораСПроектнымКонтуром.ИндексСвязиЭтапа КАК ИндексСвязиЭтапа
	|ПОМЕСТИТЬ ТекущиеСвязиЭтаповДоговораСПроектнымКонтуром
	|ИЗ
	|	&СвязиЭтаповДоговораСПроектнымКонтуром КАК СвязиЭтаповДоговораСПроектнымКонтуром
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Этапы.Этап КАК Этап,
	|	Этапы.ДатаНачала КАК ДатаНачала,
	|	Этапы.ДатаОкончания КАК ДатаОкончания,
	|	Этапы.Сумма КАК Сумма,
	|	Этапы.ЭтапРодитель КАК ЭтапРодитель,
	|	Этапы.ТипПроектнойЗадачи КАК ТипПроектнойЗадачи,
	|	ИСТИНА КАК УдаленныйЭтапВКалендарномПлане,
	|	Этапы.Ссылка КАК Ссылка,
	|	Этапы.ИндексСвязиЭтапа КАК ИндексСвязиЭтапа,
	|	Этапы.ИндексСвязиЭтапаРодитель КАК ИндексСвязиЭтапаРодитель
	|ПОМЕСТИТЬ Этапы
	|ИЗ
	|	Документ.упоРегистрацияЮридическихУсловийДоговора.Этапы КАК Этапы
	|ГДЕ
	|	Этапы.Ссылка В(&Договор)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГрафикНачислений.Этап КАК Этап,
	|	ГрафикНачислений.Статья КАК Статья,
	|	ГрафикНачислений.ВидДвижения КАК ВидДвижения,
	|	ГрафикНачислений.СхемаОплаты КАК СхемаОплаты,
	|	ГрафикНачислений.Сумма КАК Сумма,
	|	ГрафикНачислений.ДатаНачисления КАК ДатаНачисления,
	|	ГрафикНачислений.Примечание КАК Примечание,
	|	ГрафикНачислений.Ссылка КАК Ссылка,
