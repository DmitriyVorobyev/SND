&НаКлиенте
Процедура СхемаОплатыПриИзменении(Элемент) 	
	
	Если Объект.ГрафикНачислений.Количество() > 0 Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СхемаОплатыПриИзмененииЗавершение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Данные графика оплаты будут обновлены. Продолжить?'"), РежимДиалогаВопрос.ДаНет, 120,
			КодВозвратаДиалога.Нет);
			
	Иначе
			
		СхемаОплатыПриИзмененииЗавершение(КодВозвратаДиалога.Да,Неопределено);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СхемаОплатыПриИзмененииЗавершение(Ответ,ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.СхемаОплаты = СтараяСхемаОплаты;
		Возврат;
	КонецЕсли;
	
	ПроверяемыКолонки = Новый Массив;
	ПроверяемыКолонки.Добавить("Статья");
	//ПроверяемыКолонки.Добавить("Этап");
	//ПроверяемыКолонки.Добавить("ПредставлениеЭтапа");
	
	упоОперацииСДеревьямиКлиент.ПроставитьРеквизитВДереве(ДеревоЭтапов.ПолучитьЭлементы(),
		Новый Структура("СхемаОплаты",Объект.СхемаОплаты), ПроверяемыКолонки);
		
	Если Объект.ЭтоДополнительноеСоглашение Тогда
		КолонкиДляСверки = Новый Соответствие;
		КолонкиДляСверки.Вставить("УдаленныйЭтапВКалендарномПлане", Истина);
	Иначе
		КолонкиДляСверки = Неопределено;
	КонецЕсли;
	
	упоУправлениеДоговорамиКлиентСервер.СохранитьДеревоВТаблицу(ДеревоЭтапов, Объект,,, КолонкиДляСверки);
	
	КомандаРассчитатьНаСервере();	
	
	ИзменениеПредставлениеДоговора("СхемаОплаты");
	
	РазвернутьДерево();	
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево()
	
	Для Каждого СтрокаДерева Из ДеревоЭтапов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоЭтапов.Развернуть(СтрокаДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;	
	
КонецПроцедуры 

&НаКлиенте
Процедура ИспользоватьЭтапыПриИзменении(Элемент)
	
	УстановитьВидимостьПолей();
	
КонецПроцедуры

