&НаКлиенте
Процедура ДеревоЭтаповПриИзменении(Элемент)
	
	НеобходимоСверитьЭтапы = Истина;
	Если НеобходимоСверитьЭтапы И Объект.ТолькоИзмененныеЭтапы Тогда
		ПроверитьИзмененныеУдаленныеЭтапы();
		РазвернутьДерево();	
	КонецЕсли;

	ОбновитьСуммуДоговора(ДеревоЭтапов, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущаяСтрока = Элементы.ДеревоЭтапов.ТекущиеДанные;
		ТекущаяСтрока.ТипЭлемента = ТипДобавленногоЭлемента;
		Если ТипДобавленногоЭлемента = 0 Тогда
			ТекущаяСтрока.ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот");
		ИначеЕсли ТипДобавленногоЭлемента = 1 Тогда
			ТекущаяСтрока.ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Этап");  			
		КонецЕсли;	
	КонецЕсли;
	
	Если Копирование Тогда
		
		ТекущаяСтрока = Элементы.ДеревоЭтапов.ТекущиеДанные;
		ТекущаяСтрока.Этап = ПредопределенноеЗначение("Справочник.упоЭтапыДоговоров.ПустаяСсылка");
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ПоляГруппировки = Новый Соответствие;
	ПоляГруппировки.Вставить("ЭтапРодитель", "Этап");
	ПоляГруппировки.Вставить("ИндексСвязиЭтапаРодитель", "ИндексСвязиЭтапа");
	упоОперацииСДеревьямиКлиент.ДеревоЭтаповПеретаскивание(Элементы, Этаформа, "ДеревоЭтапов", "ДеревоЭтапов",
		//Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, "ЭтапРодитель");
		Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле, ПоляГруппировки);
		
	НеобходимоСверитьЭтапы = Истина;
	Если НеобходимоСверитьЭтапы И Объект.ТолькоИзмененныеЭтапы Тогда
		ПроверитьИзмененныеУдаленныеЭтапы();
		РазвернутьДерево();	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	упоУправлениеДоговорамиКлиент.ДеревоЭтаповПроверкаПеретаскивания(ЭтаФорма,Элемент, ПараметрыПеретаскивания,
		СтандартнаяОбработка, Строка, Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПредставлениеЭтапаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры,
	СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Элемент.Родитель.ТекущиеДанные.Этап) Тогда
			Элемент.Родитель.ТекущиеДанные.ПредставлениеЭтапа = Текст;
	Иначе	
		Элемент.Родитель.ТекущиеДанные.ЭтапМодифицирован = Истина;
		Элемент.Родитель.ТекущиеДанные.ПредставлениеЭтапа = Текст;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭтаповПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	упоУправлениеДоговорамиКлиент.ДеревоЭтаповПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования,
		Отказ, Объект.СхемаОплаты);
		
	Если НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ДеревоЭтапов.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтапМодифицирован Или Не ЗначениеЗаполнено(ТекущиеДанные.Этап) Тогда
		Возврат;
	КонецЕсли;
		
	НовоеПредставление = ЗначениеРеквизитаОбъекта(ТекущиеДанные.Этап, "Наименование");
	Если ТекущиеДанные.ПредставлениеЭтапа <> НовоеПредставление Тогда 
		ТекущиеДанные.ПредставлениеЭтапа = НовоеПредставление;
	КонецЕсли;	
	
КонецПроцедуры

