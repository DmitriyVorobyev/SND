	упоУправлениеДоговорамиСервер.ПроверитьВозможностьПроведенияДокументаРЮУДиДопоСогл(Ссылка, Отказ);
	Если НЕ Отказ = Истина Тогда 
		упоУправлениеДоговорамиСервер.АктуализироватьСтатусСправочникаДоговорыКонтрагентов(Ссылка, Ссылка, , "Проведение");
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроведения()

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отмены проведения документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	упоУправлениеДоговорамиСервер.АктуализироватьСтатусСправочникаДоговорыКонтрагентов(Ссылка, Ссылка, , "ОтменаПроведения");
	
КонецПроцедуры // ОбработкаУдаленияПроведения()

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтоДополнительноеСоглашение Тогда
		
		МассивНепроверяемыхРеквизитов = Новый Массив();
		МассивНепроверяемыхРеквизитов.Добавить("ВидДоговора");
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		МассивНепроверяемыхРеквизитов.Добавить("Валюта");
		
		Для Каждого ЭлементМассива Из МассивНепроверяемыхРеквизитов Цикл  			
			ПорядковыйНомер = ПроверяемыеРеквизиты.Найти(ЭлементМассива);
			Если ПорядковыйНомер <> Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(ПорядковыйНомер);
			КонецЕсли; 			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// См. описание в комментарии к одноименной процедуре в модуле УправлениеДоступом.
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокаТаб = Таблица.Добавить();
	Если ЗначениеЗаполнено(Проект) Тогда
		СтрокаТаб.ЗначениеДоступа = Проект;
	Иначе
		СтрокаТаб.ЗначениеДоступа = Справочники.Проекты.ПустаяСсылка();
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьОсновнойРегистраторЮридическихУсловийДоговора(ДокументОснование) Экспорт
	
	Если упоФункцииБСП.ЗначениеРеквизитаОбъектаВызовСервера(ДокументОснование, "ЭтоДополнительноеСоглашение") Тогда
		Возврат ПолучитьОсновнойРегистраторЮридическихУсловийДоговора(
			упоФункцииБСП.ЗначениеРеквизитаОбъектаВызовСервера(ДокументОснование, "ДокументОснование"));
	Иначе
		Возврат ДокументОснование;
	КонецЕсли;
	
КонецФункции

