//											  табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
КонецПроцедуры

// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт
	
	ПравилаНаложения = Новый Структура();
	
	// Для каждого из регистров описывается, по какой из таблиц документа
	// строится список движений, и какие реквизиты куда записать
	// Если требуется добавлять в запись реквизиты шапки, отмечаем их
	// префиксом "Шапка_". 
	  
	Правила = Новый Структура();	
	
	ПравилаНаложения.Вставить(Движения.упоАктуальнаяВерсияДоговора.Метаданные().Имя, Правила);
	
	ПравилаТаблицы = Новый Структура();	
	Правила.Вставить("ШапкаДокумента", ПравилаТаблицы);
	
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("АктуальныйДоговор", ПравилаДвижения);
	
	Если ЭтоДополнительноеСоглашение Тогда
		ПравилаДвижения.Вставить("Договор", 					"Шапка_ДокументОснование");
		ПравилаДвижения.Вставить("АктуальноеИзменениеДоговора", "Шапка_Ссылка");
	Иначе
		ПравилаДвижения.Вставить("Договор", 					"Шапка_Ссылка");
	КонецЕсли;
	
	ПравилаупоЭтапыДоговора = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоЭтапыДоговора.Метаданные().Имя, ПравилаупоЭтапыДоговора);
	
	ПравилаТаблицы = Новый Структура();	
	ПравилаупоЭтапыДоговора.Вставить("Этапы", ПравилаТаблицы);
	
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("Этапы", ПравилаДвижения);
	ПравилаДвижения.Вставить("ДокументИзменения",			"Шапка_Ссылка");
	ПравилаДвижения.Вставить("Этап",						"Этап");
	ПравилаДвижения.Вставить("ЮридическиеУсловияДоговора",	"Шапка_Ссылка");
	ПравилаДвижения.Вставить("ЭтапРодитель",				"ЭтапРодитель");
	ПравилаДвижения.Вставить("ДатаНачала",					"ДатаНачала");
	ПравилаДвижения.Вставить("ДатаОкончания",				"ДатаОкончания");
	ПравилаДвижения.Вставить("Сумма",						"Сумма");
	
	ПравилаупоГрафикОплатыПоДоговору = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоГрафикОплатыПоДоговору.Метаданные().Имя, ПравилаупоГрафикОплатыПоДоговору);
	
	ПравилаТаблицы = Новый Структура();	
	ПравилаупоГрафикОплатыПоДоговору.Вставить("ГрафикОплаты", ПравилаТаблицы);
	
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ГрафикОплаты", ПравилаДвижения);
	ПравилаДвижения.Вставить("ДокументИзменения",			"Шапка_Ссылка");
	ПравилаДвижения.Вставить("Этап",						"Этап");
	ПравилаДвижения.Вставить("Статья",						"Статья");
	ПравилаДвижения.Вставить("Задержка",					"Задержка");
	ПравилаДвижения.Вставить("Сумма",						"Сумма");
	ПравилаДвижения.Вставить("ДатаОплаты",					"ДатаОплаты");
	
	
	ПравилаупоСвязьЭтаповДоговораСПроектнымКонтуром = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСвязьЭтаповДоговораСПроектнымКонтуром.Метаданные().Имя, 
		ПравилаупоСвязьЭтаповДоговораСПроектнымКонтуром);
	
	ПравилаТаблицы = Новый Структура();	
	ПравилаупоСвязьЭтаповДоговораСПроектнымКонтуром.Вставить("СвязиЭтаповДоговораСПроектнымКонтуром", ПравилаТаблицы);
	Если ЭтотОбъект.ИспользоватьЭтапы ИЛИ (ЭтоДополнительноеСоглашение И ДокументОснование.ИспользоватьЭтапы) Тогда 
		ПравилаДвижения = Новый Структура();
		ПравилаТаблицы.Вставить("СвязиЭтаповДоговораСПроектнымКонтуром", ПравилаДвижения);
		ПравилаДвижения.Вставить("ДокументИзменения",			"Шапка_Ссылка");
		Если ЭтоДополнительноеСоглашение Тогда
			ПравилаДвижения.Вставить("ЮридическиеУсловияДоговора",	"Шапка_ДокументОснование");
		Иначе	
			ПравилаДвижения.Вставить("ЮридическиеУсловияДоговора",	"Шапка_Ссылка");
		КонецЕсли;	
		ПравилаДвижения.Вставить("ЭтапДоговора",				"ЭтапДоговора");
		ПравилаДвижения.Вставить("ДоговорКонтрагента",			"ДоговорКонтрагента");
		ПравилаДвижения.Вставить("Проект",						"Проект");
		ПравилаДвижения.Вставить("ПроектнаяЗадача",				"ПроектнаяЗадача");
	КонецЕсли;
	
	Возврат ПравилаНаложения; 
	
КонецФункции // ПолучитьПравилаНаложенияРеквизитовНаРегистр()

// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт
	
	ДанныеДвижений.упоГрафикОплатыПоДоговору.Свернуть("ДокументИзменения, Этап, Статья, ДатаОплаты, Активность, Период, МоментВремени", "Задержка, Сумма");
	
КонецПроцедуры // ПодготовитьДанныеДвижений()

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный - значение, которое используется как основание для заполнения.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
		
	ОдинЭтапДоговораСвязанСОднимЭтапомПроекта = Истина;
	
	Если ТипЗнч(Основание) = Тип("СправочникСсылка.Проекты") Тогда
		Проект           = Основание;
		Организация      = упоФункцииБСП.ЗначениеРеквизитаОбъектаВызовСервера(Основание, "Организация");
	ИначеЕсли ТипЗнч(Основание) = Тип("Структура") И Основание.Свойство("ЭтоДополнительноеСоглашение") Тогда
		ЭтотОбъект.ЭтоДополнительноеСоглашение = Основание.ЭтоДополнительноеСоглашение;
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.упоРегистрацияЮридическихУсловийДоговора") Тогда
		ДокументОснование = ПолучитьОсновнойРегистраторЮридическихУсловийДоговора(Основание);
		АктуальныйДокументРегистраторЮридическихУсловийДоговора = Документы.упоРегистрацияЮридическихУсловийДоговора.ПолучитьПоследнийАктуальныйДокументИзмененияДоговора(ДокументОснование);
		Если Не ЗначениеЗаполнено(АктуальныйДокументРегистраторЮридическихУсловийДоговора) Тогда
			АктуальныйДокументРегистраторЮридическихУсловийДоговора = ДокументОснование;
		КонецЕсли;

		ЭтоДополнительноеСоглашение = Истина;
		ЗаполнитьЗначенияСвойств(ЭтотОбъект , Основание,
			"Контрагент, Организация, ВидДоговора, ИспользоватьЭтапы, Валюта, ТипЮридическихУсловийДоговора");
		ЗаполнитьЗначенияСвойств(ЭтотОбъект , АктуальныйДокументРегистраторЮридическихУсловийДоговора,
			"ДетализацияПоДоговорамВзаиморасчетов, ДоговорВзаиморасчетов, ПоКаждомуЭтапуОтдельныйДоговорВзаиморасчетов, 
			|ДоговорСвязанСНесколькимиПроектами, Проект, ОдинЭтапДоговораСвязанСОднимЭтапомПроекта, СхемаОплаты, СпособУчетаАванса");
		ЭтотОбъект.СвязиЭтаповДоговораСПроектнымКонтуром.Загрузить(АктуальныйДокументРегистраторЮридическихУсловийДоговора.СвязиЭтаповДоговораСПроектнымКонтуром.Выгрузить());
		ЭтотОбъект.Этапы.Загрузить(АктуальныйДокументРегистраторЮридическихУсловийДоговора.Этапы.Выгрузить());
		ЭтотОбъект.ГрафикНачислений.Загрузить(АктуальныйДокументРегистраторЮридическихУсловийДоговора.ГрафикНачислений.Выгрузить());
		ЭтотОбъект.ГрафикОплаты.Загрузить(АктуальныйДокументРегистраторЮридическихУсловийДоговора.ГрафикОплаты.Выгрузить());
		ЭтотОбъект.СуммаДоговора = АктуальныйДокументРегистраторЮридическихУсловийДоговора.СуммаДоговора;
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

