				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументупоЗакрытиеЭтапа.Ссылка,
	ДокументупоЗакрытиеЭтапа.ПометкаУдаления,
	ДокументупоЗакрытиеЭтапа.Номер,
	ДокументупоЗакрытиеЭтапа.Дата,
	ДокументупоЗакрытиеЭтапа.Проведен,
	ДокументупоЗакрытиеЭтапа.Комментарий,
	ДокументупоЗакрытиеЭтапа.МоментВремени,
	ДокументупоЗакрытиеЭтапа.Проект,
	ДокументупоЗакрытиеЭтапа.Автор,
	ДокументупоЗакрытиеЭтапа.АвторИзменений,
	ДокументупоЗакрытиеЭтапа.ДатаМодификации,
	Проекты.Ссылка КАК Этап,
	упоРуководителиПроектовСрезПоследних.РуководительПроекта КАК РуководительПроекта
ИЗ
	Документ.упоЗакрытиеЭтапа КАК ДокументупоЗакрытиеЭтапа
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		ПО ДокументупоЗакрытиеЭтапа.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних КАК упоРуководителиПроектовСрезПоследних
		ПО ДокументупоЗакрытиеЭтапа.Проект = упоРуководителиПроектовСрезПоследних.Проект
</QueryText>
				<MainTable>Document.упоЗакрытиеЭтапа</MainTable>
