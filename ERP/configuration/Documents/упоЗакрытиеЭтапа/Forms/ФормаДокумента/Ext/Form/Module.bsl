КонецФункции

#КонецОбласти

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()	
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Проекты") Тогда
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		Объект.Проект = ВыбранноеЗначение.Проект;
		Объект.ПроектнаяЗадача = ВыбранноеЗначение;
		упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "ПроектнаяЗадача", "");
				
	КонецЕсли;
	
	Объект.Сложность = ЗначениеПоказателяСложность(Объект.ПроектнаяЗадача);
	
	ЗаполнитьПоДаннымУчета = Истина;
	ЗаполнитьТаблицуФормы(ЗаполнитьПоДаннымУчета);	
	
КонецПроцедуры

&НаСервере
Процедура СохранитьТаблицуФормы(ТекущийОбъект)
	
	ТекущийОбъект.ОценкиИсполнителейПодрядчиков.Очистить();	
	ТекущийОбъект.Трудозатраты.Очистить();
	
	Для Каждого ОценкаИсполнителяПодрядчика Из ТаблицаФормы Цикл
		
		ЕстьОценки = Ложь;
		
		Для Каждого КолонкаОценки Из КолонкиОценки Цикл
			Оценка = ОценкаИсполнителяПодрядчика[КолонкаОценки.Ключ];
			Если ЗначениеЗаполнено(Оценка) Тогда			
				НоваяСтрока = ТекущийОбъект.ОценкиИсполнителейПодрядчиков.Добавить();				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ОценкаИсполнителяПодрядчика);	
				НоваяСтрока.Оценка = Оценка;
				НоваяСтрока.ЗначениеОценки = ОценкаИсполнителяПодрядчика[КолонкаОценки.Ключ + "_Значение"];
				НоваяСтрока.Вес = ОценкаИсполнителяПодрядчика[КолонкаОценки.Ключ + "_Вес"];								
				
				ЕстьОценки = Истина;
			КонецЕсли;	
		КонецЦикла;
		
		Если ЕстьОценки = Ложь Тогда
			НоваяСтрока = ТекущийОбъект.ОценкиИсполнителейПодрядчиков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОценкаИсполнителяПодрядчика);
		КонецЕсли;	
		
		НоваяСтрока = ТекущийОбъект.Трудозатраты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОценкаИсполнителяПодрядчика);	
		
	КонецЦикла;	
	
КонецПроцедуры	

// Вывод оценок и трудозатрат в сводную таблицу формы.
//
&НаСервере
Процедура ДобавитьКолонкиОценокВТаблицуФормы(ОценкиИсполнителей)
		
	ДобавляемыеРеквизиты = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;
	
	ТипОценки = Новый ОписаниеТипов("СправочникСсылка.упоОценкиИсполнителейПодрядчиков");
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Если КолонкиОценки = Неопределено Тогда
		КолонкиОценки = Новый Структура;
	КонецЕсли;
					
	ИмяТаблицы = "ТаблицаФормы";	
	ПутьКТаблице = "ТаблицаФормы.";	
	
	// Очистка колонок при повторном заполнении.
	Если КолонкиОценки.Количество() > 0 Тогда
		Для Каждого КолонкаОценки Из КолонкиОценки Цикл		
			ИмяКолонки = ПутьКТаблице + КолонкаОценки.Ключ;
			УдаляемыеРеквизиты.Добавить(ИмяКолонки);
			УдаляемыеРеквизиты.Добавить(ИмяКолонки + "_Вес");
			УдаляемыеРеквизиты.Добавить(ИмяКолонки + "_Значение");
						
			ИмяЭлемента = ИмяТаблицы + КолонкаОценки.Ключ;
			Элементы.Удалить(Элементы[ИмяЭлемента]);				
		КонецЦикла;		
		КолонкиОценки.Очистить();														
	КонецЕсли;	
	
	Сч = 1;
	Для Каждого Оценка Из ОценкиИсполнителей Цикл
		
		Если НЕ ЗначениеЗаполнено(Оценка) Тогда		
			Продолжить;
		КонецЕсли;
		
		ИмяКолонки = "Оценка" + Сч;				
		ПолноеИмяКолонки = ИмяТаблицы + ИмяКолонки;
		ЗаголовокКолонки = Строка(Оценка);
						
		Реквизит = Новый РеквизитФормы(ИмяКолонки, ТипОценки, ИмяТаблицы, ЗаголовокКолонки);			
		ДобавляемыеРеквизиты.Добавить(Реквизит);			
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "_Вес", ТипЧисло, ИмяТаблицы, "Вес");			
		ДобавляемыеРеквизиты.Добавить(Реквизит);			
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "_Значение", ТипЧисло, ИмяТаблицы, ЗаголовокКолонки);			
		ДобавляемыеРеквизиты.Добавить(Реквизит);				
		
		КолонкиОценки.Вставить(ИмяКолонки, Оценка);				
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
		
		ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
				
		ПредыдущийЭлемент = Неопределено;
		
		НаборКолонокОценки = Новый Массив;
		НаборКолонокОценки.Добавить("_Значение");
		НаборКолонокОценки.Добавить("_Вес");
		
		Для Каждого КолонкаОценки Из КолонкиОценки Цикл
			
			ПолноеИмяГруппы = ИмяТаблицы + КолонкаОценки.Ключ;			
			ГруппаКолонок = Элементы.Найти(ПолноеИмяГруппы);	 
			Если ГруппаКолонок <> Неопределено Тогда																										
				Продолжить;
			КонецЕсли;							
			
			ГруппаКолонок = Элементы.Вставить(ПолноеИмяГруппы, Тип("ГруппаФормы"), Элементы.ТаблицаФормыГруппаОценки, ПредыдущийЭлемент);
			ГруппаКолонок.Вид = ВидГруппыФормы.ГруппаКолонок;			
			ГруппаКолонок.Группировка = ГруппировкаКолонок.Горизонтальная;
			ГруппаКолонок.Ширина = 10;			
			ГруппаКолонок.РастягиватьПоГоризонтали = Ложь;		
			ГруппаКолонок.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1, Вес оценки", КолонкаОценки.Значение);
			ГруппаКолонок.ШрифтЗаголовка = Новый Шрифт(ГруппаКолонок.ШрифтЗаголовка,, 9);
			ГруппаКолонок.ОтображатьВШапке = Истина;
			
			ПредыдущийЭлемент = ГруппаКолонок;																							
			
			Для Каждого КолонкаНабора Из НаборКолонокОценки Цикл
				
				ИмяКолонки = КолонкаОценки.Ключ + КолонкаНабора;
				ПолноеИмяКолонки = ИмяТаблицы + ИмяКолонки;
				
				ЭлементКолонки = Элементы.Добавить(ПолноеИмяКолонки, Тип("ПолеФормы"), ГруппаКолонок);					
				ЭлементКолонки.Ширина = 5;				
				ЭлементКолонки.АвтоМаксимальнаяШирина = Ложь;
				ЭлементКолонки.МаксимальнаяШирина = 5;				
				ЭлементКолонки.ПутьКДанным = ПутьКТаблице + ИмяКолонки;			
				ЭлементКолонки.ОтображатьВШапке = Ложь;				
				Если КолонкаНабора = "_Значение" Тогда
					ЭлементКолонки.Вид = ВидПоляФормы.ПолеВвода;
					ЭлементКолонки.УстановитьДействие("ПриИзменении", "ТаблицаФормыЗначениеОценкиПриИзменении_Подключаемый");
				Иначе
					ЭлементКолонки.Вид = ВидПоляФормы.ПолеНадписи;					
				КонецЕсли;			
				
			КонецЦикла;							
			
		КонецЦикла;
		
		// Отключаем колонку-заглушку.
		Элементы.ТаблицаФормыНадписьНетОценок.Видимость = Ложь;
					
	КонецЕсли;	
	
	Если ОценкиИсполнителей.Количество() > 0 Тогда
		Элементы.ТаблицаФормыСредняяОценка.ФиксацияВТаблице = ФиксацияВТаблице.Право;
	Иначе 
		Элементы.ТаблицаФормыСредняяОценка.ФиксацияВТаблице = ФиксацияВТаблице.Нет
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
			
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ПолеЭлементаУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлементаУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаФормыТрудозатратыПроцент");
	ПолеЭлементаУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлементаУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаФормыКТУ");
	
	ОтборЭлементаУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлементаУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаФормы.Роль");
	ОтборЭлементаУО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;						
	ОтборЭлементаУО.ПравоеЗначение = Перечисления.упоПредметыОценки.Подрядчик;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветНедоступнойСтрокиДокумента());
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	//	
	
	ИмяТаблицы = "ТаблицаФормы";	
	ПутьКТаблице = "ТаблицаФормы.";		
	
	НаборКолонокОценки = Новый Массив;
	НаборКолонокОценки.Добавить("_Значение");
	НаборКолонокОценки.Добавить("_Вес");
	
	Для Каждого КолонкаОценки Из ЭтаФорма.КолонкиОценки Цикл
						
		ЭлементУО = УсловноеОформление.Элементы.Добавить();				
		
		Для Каждого КолонкаНабора Из НаборКолонокОценки Цикл			
			ИмяКолонки = КолонкаОценки.Ключ + КолонкаНабора;
			ПолноеИмяКолонки = ИмяТаблицы + ИмяКолонки;										
			
			ПолеЭлементаУО = ЭлементУО.Поля.Элементы.Добавить();
			ПолеЭлементаУО.Поле = Новый ПолеКомпоновкиДанных(ПолноеИмяКолонки);								
		КонецЦикла;							
		
		// Засеривание оценок, недоступных для роли.
		ОтборЭлементаУО = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлементаУО.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКТаблице + КолонкаОценки.Ключ);
		ОтборЭлементаУО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;						
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветНедоступнойСтрокиДокумента());
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
				
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФормы(ЗаполнитьПоДаннымУчета = Ложь, СохранитьВведенныеЗначения = Ложь)
	
	Если НЕ ПолучитьФункциональнуюОпцию("упоИспользоватьОценкуИсполнителейПодрядчиков") Тогда
		Возврат;
	КонецЕсли;					
	
	ОценкиРолей.Очистить();
	
	ОценкиЭтапа = Объект.ОценкиИсполнителейПодрядчиков.Выгрузить();
	
	Если ЗаполнитьПоДаннымУчета Тогда					
		
		Если Не ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
			Возврат;
		КонецЕсли;	
		
		ТаблицыОценки = Новый Структура;
		Если СохранитьВведенныеЗначения Тогда
			ТаблицыОценки.Вставить("Оценки", ОценкиЭтапа);
			ТаблицыОценки.Вставить("Трудозатраты", Объект.Трудозатраты.Выгрузить());
		КонецЕсли;
		
		Результат = Документы.упоЗакрытиеЭтапа.ТаблицыОценокИТрудозатрат(Объект.ПроектнаяЗадача, ТаблицыОценки);		
		ОценкиЭтапа = Результат.Оценки;
		ТрудозатратыЭтапа = Результат.Трудозатраты;
		
		Объект.Трудозатраты.Очистить();	
		Объект.ОценкиИсполнителейПодрядчиков.Очистить();
		
		Если ТрудозатратыЭтапа.Количество() > 0 Тогда					
			Объект.Трудозатраты.Загрузить(ТрудозатратыЭтапа);				
		КонецЕсли;	
		Если ОценкиЭтапа.Количество() > 0 Тогда
			Объект.ОценкиИсполнителейПодрядчиков.Загрузить(ОценкиЭтапа);						
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ОценкиЭтапа.Количество() > 0 Тогда
		ОценкиРолей.Загрузить(СвернутаяТаблица(ОценкиЭтапа, "Оценка,Роль"));
	КонецЕсли;	
		
	ДобавитьКолонкиОценокВТаблицуФормы(МассивУникальныхПоТаблицеЗначений(ОценкиЭтапа, "Оценка", " УБЫВ"));
	
	УстановитьУсловноеОформление();
	
	ЗагрузитьДанныеВТаблицуФормы(ОценкиЭтапа);			
		
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьДанныеВТаблицуФормы(ОценкиИсполнителей)
		
	ТрудозатратыИсполнителей = Объект.Трудозатраты;
	
	ТаблицаФормы.Очистить();
	
	КолонкиОтбора = "ИсполнительПодрядчик,Роль";
	ТрудовыеРесурсыЭтапа = СвернутаяТаблица(ОценкиИсполнителей, КолонкиОтбора);
	
	Отбор = Новый Структура(КолонкиОтбора);
	
	ОценкиВКолонках = СоответствиеПоСтруктуре(КолонкиОценки);		
	
	Для Каждого ТрудовойРесурс Из ТрудовыеРесурсыЭтапа Цикл
		
		// Оценки.
		
		СтрокаОценки = ТаблицаФормы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОценки, ТрудовойРесурс);
		СтрокаОценки.НетОценок = Истина;
		
		ЗаполнитьЗначенияСвойств(Отбор, ТрудовойРесурс);
		НайденныеОценкиИсполнителя = ОценкиИсполнителей.НайтиСтроки(Отбор);				
		СуммарнаяОценка = 0;
		Для Каждого ОценкаИсполнителя Из НайденныеОценкиИсполнителя Цикл			
			ИмяКолонки = ОценкиВКолонках[ОценкаИсполнителя.Оценка];
			Если ИмяКолонки <> Неопределено Тогда
				СтрокаОценки[ИмяКолонки] = ОценкаИсполнителя.Оценка;
				СтрокаОценки[ИмяКолонки + "_Вес"] = ОценкаИсполнителя.Вес;
				СтрокаОценки[ИмяКолонки + "_Значение"] = ОценкаИсполнителя.ЗначениеОценки;				
				
				СтрокаОценки.НетОценок = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаОценки.НетОценок = Ложь Тогда
			РассчитатьСреднююОценкуПоСтроке(СтрокаОценки, КолонкиОценки);
		КонецЕсли;	
		
		// Трудозатраты.
		
		НайденныеТрудозатратыИсполнителя = ТрудозатратыИсполнителей.НайтиСтроки(Отбор);
		Если НайденныеТрудозатратыИсполнителя.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаОценки, НайденныеТрудозатратыИсполнителя[0]);	
		КонецЕсли;	
		
	КонецЦикла;	
	
	ОбновитьИтогиТаблицыФормы(ЭтаФорма);
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьПредставлениеТаблицыФормы()
		
	Элементы.ТаблицаФормыГруппаТрудозатраты.Видимость = Представление = 0;	
	Элементы.ТаблицаФормыГруппаОценки.Видимость = Представление = 1;	
	Элементы.ТаблицаФормы.Подвал = Представление = 0;
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиТаблицыФормы(Форма, ТолькоКТУ = Ложь)
	
	Если НЕ ТолькоКТУ Тогда
		Форма.ТрудозатратыИтого = Форма.ТаблицаФормы.Итог("Трудозатраты");
		Форма.ТрудозатратыПроцентИтого = Форма.ТаблицаФормы.Итог("ТрудозатратыПроцент");
	КонецЕсли;	
	Форма.КТУИтого = Форма.ТаблицаФормы.Итог("КТУ");
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСреднююОценкуПоСтроке(СтрокаДанных, КолонкиОценки)
	
	ОбщаяСумма = 0;
	ОбщийВес = 0;
	Для Каждого КолонкаОценки Из КолонкиОценки Цикл
		Если ЗначениеЗаполнено(СтрокаДанных[КолонкаОценки.Ключ]) Тогда
			ОбщийВес = ОбщийВес + СтрокаДанных[КолонкаОценки.Ключ + "_Вес"];
			ОбщаяСумма = ОбщаяСумма + СтрокаДанных[КолонкаОценки.Ключ + "_Значение"] * СтрокаДанных[КолонкаОценки.Ключ + "_Вес"];					
		КонецЕсли;	
	КонецЦикла;	
		
	СтрокаДанных.СредняяОценка = ?(ОбщийВес = 0, 0, ОбщаяСумма/ОбщийВес);	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция СоответствиеПоСтруктуре(ИсходнаяСтруктура)
	
	НовоеСоответствие = Новый Соответствие;
	
	Для Каждого ЗначениеСтруктуры Из ИсходнаяСтруктура Цикл
		НовоеСоответствие.Вставить(ЗначениеСтруктуры.Значение, ЗначениеСтруктуры.Ключ);		
	КонецЦикла;
	
	Возврат НовоеСоответствие;
	
КонецФункции

&НаСервереБезКонтекста
Функция СвернутаяТаблица(Таблица, КолонкиСвертки)
	
	КопияТаблицы = Новый ТаблицаЗначений;
	
	КолонкиОтбора = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиСвертки,,,Истина);
	КолонкиТаблицы = Таблица.Колонки;
	Для Каждого КолонкаОтбора Из КолонкиОтбора Цикл
		Если КолонкиТаблицы.Найти(КолонкаОтбора) = Неопределено Тогда
			Возврат КопияТаблицы;	
		КонецЕсли;	
	КонецЦикла;	
	
	КопияТаблицы = Таблица.Скопировать(, КолонкиСвертки);
	КопияТаблицы.Свернуть(КолонкиСвертки);
	
	Возврат КопияТаблицы;
	
КонецФункции	

&НаСервереБезКонтекста
Функция МассивУникальныхПоТаблицеЗначений(Таблица, ИмяКолонки, Направление = " ВОЗР")
	
	МассивУникальных = Новый Массив;
	
	Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		КопияТаблицы = СвернутаяТаблица(Таблица, ИмяКолонки);	
		КопияТаблицы.Сортировать(ИмяКолонки + Направление);
		
		МассивУникальных = КопияТаблицы.ВыгрузитьКолонку(ИмяКолонки);	
	КонецЕсли;	
	
	Возврат МассивУникальных;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ЗначениеПоказателяСложность(ПроектнаяЗадача)
		
	Возврат Документы.упоЗакрытиеЭтапа.ЗначениеПоказателяСложность(ПроектнаяЗадача);
	
КонецФункции	

