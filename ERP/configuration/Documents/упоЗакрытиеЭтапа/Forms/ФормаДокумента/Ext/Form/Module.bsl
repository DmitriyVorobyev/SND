#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПроектнаяЗадачаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	упоУправлениеФормамиКлиент.ОбработатьНажатиеНаГиперссылкуРеквизитаОбъекта(Объект, ЭтаФорма, "ПроектнаяЗадача", СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПроектнаяЗадачаОчистка(Элемент, СтандартнаяОбработка)
	
	Объект.Проект = ПредопределенноеЗначение("Справочник.Проекты.ПустаяСсылка");
	Объект.ПроектнаяЗадача = ПредопределенноеЗначение("Документ.упоПроектнаяЗадача.ПустаяСсылка");
	
	Объект.Сложность = 0;
	ТаблицаФормы.Очистить();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПроектнаяЗадачаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	Если ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
		ПоказатьЗначение(, Объект.ПроектнаяЗадача);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПриИзменении(Элемент)	
	УстановитьПредставлениеТаблицыФормы();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФормыЗначениеОценкиПриИзменении_Подключаемый(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаФормы.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;				
	КонецЕсли;	
	
	РассчитатьСреднююОценкуПоСтроке(ТекущиеДанные, КолонкиОценки);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФормыКТУПриИзменении(Элемент)
	
	ТолькоКТУ = Истина;
	ОбновитьИтогиТаблицыФормы(ЭтаФорма, ТолькоКТУ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОценкиТрудозатраты(Команда)
	
	Если ТаблицаФормы.Количество() > 0 Тогда				
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Очистить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Сохранить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьОценкиТрудозатратыЗавершение", ЭтаФорма), 
			НСтр("ru = 'Заполненные оценки и КТУ следует:'"), 
			Кнопки, 
			, 
			КодВозвратаДиалога.Нет);		
	Иначе		
		ЗаполнитьПоДаннымУчета = Истина;	
		ЗаполнитьТаблицуФормы(ЗаполнитьПоДаннымУчета);		
	КонецЕсли;
			
КонецПроцедуры

// Продолжает процесс заполнения оценок после показа вопроса.
//
&НаКлиенте
Процедура ЗаполнитьОценкиТрудозатратыЗавершение(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да ИЛИ Результат = КодВозвратаДиалога.Нет Тогда		
		ЗаполнитьПоДаннымУчета = Истина;
		СохранитьВведенныеЗначения = Результат = КодВозвратаДиалога.Нет;
		
		ЗаполнитьТаблицуФормы(ЗаполнитьПоДаннымУчета, СохранитьВведенныеЗначения);
		
		Модифицированность = Истина;		
	КонецЕсли;					
			
КонецПроцедуры

