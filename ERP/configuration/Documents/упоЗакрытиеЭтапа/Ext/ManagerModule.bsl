// Возвращает данные для проведения документа.
//
// Параметры:
//   ДокументСсылка  - ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//
// Возвращаемое значение:
//  Структура: 
//   	* Ключ - Строка - имя регистра.
//   	* Значение - ТаблицаЗначений - данные для проведения документа.
//
Функция ДанныеПроведения(ДокументСсылка) Экспорт
	
	ДанныеПроведения = Новый Структура;
	
	ИспользоватьОценкуИсполнителейПодрядчиков = ПолучитьФункциональнуюОпцию("упоИспользоватьОценкуИсполнителейПодрядчиков");
	
	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(ТекстЗадачиЭтапа());
	ТекстыЗапроса.Добавить(ТекстПроведение());
	Если ИспользоватьОценкуИсполнителейПодрядчиков Тогда
		ТекстыЗапроса.Добавить(ТекстПроведениеИспользоватьОценку());
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ПроектнаяЗадача, Проект");
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ТекВерсия", 
		упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(РеквизитыДокумента.Проект));
	Запрос.УстановитьПараметр("ПроектнаяЗадача", РеквизитыДокумента.ПроектнаяЗадача);
	Запрос.УстановитьПараметр("Зеркало", 
		упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(РеквизитыДокумента.ПроектнаяЗадача));
	Запрос.УстановитьПараметр("СтатусПроектнойЗадачи", Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	Если ИспользоватьОценкуИсполнителейПодрядчиков Тогда
		Запрос.УстановитьПараметр("РольПодрядчик", Перечисления.упоПредметыОценки.Подрядчик);
	КонецЕсли;
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Результат = Запрос.ВыполнитьПакет();
	
	Последний = Результат.ВГраница();
	ПакетыОценки = 0;
	Если ИспользоватьОценкуИсполнителейПодрядчиков Тогда
		ДанныеПроведения.Вставить("упоОценкаИсполнителейПодрядчиков", Результат[Последний - 1].Выгрузить());
		ДанныеПроведения.Вставить("упоКТУИсполнителей", Результат[Последний].Выгрузить());
		ПакетыОценки = 3;
	КонецЕсли;
	ДанныеПроведения.Вставить("упоСтатусыПроектныхЗадач", Результат[Последний - ПакетыОценки - 1].Выгрузить());
	ДанныеПроведения.Вставить("упоПроцентыГотовностиПроектныхЗадач", Результат[Последний - ПакетыОценки].Выгрузить());
	ДанныеПроведения.Вставить("МассивЗадачЭтапа", 
		ДанныеПроведения.упоПроцентыГотовностиПроектныхЗадач.ВыгрузитьКолонку("ПроектнаяЗадача"));
		
	Возврат ДанныеПроведения;
		
КонецФункции

#КонецОбласти

#Область ОценкаИсполнителейПодрядчиков

// Проверяет заполнение показателя сложности.
//
// Параметры:
//  ПоказательСложность  - СправочникСсылка.упоПоказателиПроектов - показатель Сложность.
//
// Возвращаемое значение:
//   Булево - правильность заполнения показателя.
//
Функция ПоказательСложностьЗаполненПравильно(ПоказательСложность) Экспорт
	
	МассивОшибок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ПоказательСложность) Тогда
		
		МассивОшибок.Добавить(НСтр("ru = 'Не установлен показатель сложности задач.'"));
		
	Иначе	
		
		РеквизитыПоказателя = упоФункцииБСП.ЗначенияРеквизитовОбъектаВызовСервера(ПоказательСложность, 
			"ПринадлежностьПоказателя, ВидЗаполнения, ТипЗаполнения, ИмяПоляОбъектаПЗ, ИмяПоляЗначенияПЗ, ТипИндикатора");
		
		Если НЕ(РеквизитыПоказателя.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.Общий
			ИЛИ РеквизитыПоказателя.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроектнойЗадачи) Тогда
 			МассивОшибок.Добавить(НСтр("ru = 'Показатель сложности не может быть получен для проектной задачи.'")); 		
        Иначе			 			
			Если РеквизитыПоказателя.ВидЗаполнения <> Перечисления.упоВидЗаполненияИндикатора.Вручную 
				И РеквизитыПоказателя.ТипЗаполнения = 0 Тогда
				Если НЕ ЗначениеЗаполнено(РеквизитыПоказателя.ИмяПоляОбъектаПЗ) Тогда
					МассивОшибок.Добавить(НСтр("ru = 'В показателе сложности не заполнено имя поля задачи.'")); 	
				КонецЕсли;	
				Если НЕ ЗначениеЗаполнено(РеквизитыПоказателя.ИмяПоляЗначенияПЗ) Тогда
		 			МассивОшибок.Добавить(НСтр("ru = 'В показателе сложности не заполнено имя поля показателя задачи.'")); 
				КонецЕсли;
			КонецЕсли;	
			Если РеквизитыПоказателя.ТипИндикатора <> Перечисления.упоТипИндикатора.Число Тогда
	 			МассивОшибок.Добавить(НСтр("ru = 'Тип показателя сложности не является числовым.'")); 
			КонецЕсли;			
		КонецЕсли;							
		
	КонецЕсли;	
	
	ПоказательЗаполненПравильно = МассивОшибок.Количество() = 0;
	
	Если Не ПоказательЗаполненПравильно Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрСоединить(МассивОшибок, Символы.ПС));		
	КонецЕсли;	
	
	Возврат ПоказательЗаполненПравильно;
	
КонецФункции	

// Получает значение показателя сложности для проектной задачи.
//
// Параметры:
//  ПроектнаяЗадача  - ДокументСсылка.упоПроектнаяЗадача - проектная задача.
//
// Возвращаемое значение:
//   Число - значение показателя.
//
Функция ЗначениеПоказателяСложность(ПроектнаяЗадача) Экспорт
	
	Сложность = 0;
	
	Если ПолучитьФункциональнуюОпцию("упоИспользоватьОценкуИсполнителейПодрядчиков") 
		И ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
	
		ПоказательСложность = Константы.упоПоказательСложности.Получить();
		
		Если НЕ ПоказательСложностьЗаполненПравильно(ПоказательСложность) Тогда
			Возврат Сложность;
		КонецЕсли;	
			
		ТекстОшибки = "";
		Сложность = упоПоказателиПроектовСервер.ПолучитьЗначениеПоказателя(ПоказательСложность, 
			упоПроектыИЗадачиВызовСервера.обПолучитьСвязанныйЭлементПроекта(ПроектнаяЗадача),, ТекстОшибки);
			
		Если ТекстОшибки <> "" Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , "Сложность", "Объект.Сложность");
		КонецЕсли;
		
	КонецЕсли;	
		
	Возврат Сложность;
	
КонецФункции	

// Формирует таблицы оценок и трудозатрат для заполнения документа оценки.
//
// Параметры:
//  ПроектнаяЗадачаЭтап  - ДокументСсылка.упоПроектнаяЗадача - проектная задача (оцениваемый этап).
//  ТаблицыОценокИТрудозатрат  - Структура: - передается для сохранения заполненных значений на форме.
//		* Оценки - ТаблицаЗначений - таблица оценок из документа оценки.
//		* Трудозатраты - ТаблицаЗначений - таблица трудозатрат из документа оценки.		
//  ТолькоНаличие  - Булево - признак необходимости проверки наличия трудозатрат по проектной задаче без возврата 
//   таблицы значений. Используется при проведении документа с константой упоОбязательнаяОценкаИсполнителейПодрядчиков.
//
// Возвращаемое значение:
//   Структура, Булево - структура с таблицами значений таблица оценок исполнителей и трудозатрат 
//		или признак наличия трудозатрат по проектной задаче.
//
Функция ТаблицыОценокИТрудозатрат(ПроектнаяЗадачаЭтап, Знач ТаблицыОценокИТрудозатрат, ТолькоНаличие = Ложь) Экспорт
		
	Запрос = Новый Запрос();	
	Запрос.УстановитьПараметр("Зеркало", упоПроектыИЗадачиВызовСервера.обПолучитьСвязанныйЭлементПроекта(ПроектнаяЗадачаЭтап));
	Запрос.УстановитьПараметр("РольПодрядчик", Перечисления.упоПредметыОценки.Подрядчик);				
	ПакетТрудозатраты = 0;
	Запрос.Текст = ТекстЗаполнение(ТаблицыОценокИТрудозатрат, Запрос, ПакетТрудозатраты);

	Результат = Запрос.ВыполнитьПакет();
	
	ИндексТрудозатраты = Результат.ВГраница();
	ИндексОценки = ИндексТрудозатраты - ПакетТрудозатраты;
		
	ЕстьОценки = НЕ Результат[ИндексОценки].Пустой();
	
	Если ТолькоНаличие Тогда
		
		Возврат ЕстьОценки;
		
	Иначе		
		
		РезультатСтруктура = Новый Структура("Оценки, Трудозатраты",
			Новый ТаблицаЗначений, Новый ТаблицаЗначений);
								
		Если ЕстьОценки Тогда			
			РезультатСтруктура.Оценки = Результат[ИндексОценки].Выгрузить();						
		КонецЕсли;
		
		// Трудозатрат может не быть, если задача полностью отдана на субподряд. 		
		Если НЕ Результат[ИндексТрудозатраты].Пустой() Тогда
			ТаблицаТрудозатрат = Результат[ИндексТрудозатраты].Выгрузить();
			
			МассивРаспределения = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(100, 
				ТаблицаТрудозатрат.ВыгрузитьКолонку("Трудозатраты"));			
			ТаблицаТрудозатрат.ЗагрузитьКолонку(МассивРаспределения, "ТрудозатратыПроцент");
										
			РезультатСтруктура.Трудозатраты = ТаблицаТрудозатрат;							
		КонецЕсли;	
						
		Возврат РезультатСтруктура;
		
	КонецЕсли;	
	
КонецФункции

