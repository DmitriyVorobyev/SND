// Возвращает текст запроса для получения подчиненных задач этапа.
//
// Параметры:
//
// Возвращаемое значение:
//   Строка - текст запроса.
//
Функция ТекстЗадачиЭтапа()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.Версия КАК Версия,
	               |	Проекты.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ втПроектныеЗадачиЭтапа
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ПО Проекты.СсылкаНаПроектнуюЗадачу = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	               |ГДЕ
	               |	Проекты.Ссылка В ИЕРАРХИИ(&Зеркало)
	               |	И НЕ Проекты.ПометкаУдаления
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПроектнаяЗадача";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстПроведение()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	упоЗакрытиеЭтапа.Ссылка КАК Регистратор,
	               |	упоЗакрытиеЭтапа.Дата КАК Дата,
				   |	упоЗакрытиеЭтапа.ДатаМодификации КАК ДатаМодификации
	               |ПОМЕСТИТЬ втДанныеШапки
	               |ИЗ
	               |	Документ.упоЗакрытиеЭтапа КАК упоЗакрытиеЭтапа
	               |ГДЕ
	               |	упоЗакрытиеЭтапа.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДанныеШапки.Регистратор КАК Регистратор,
	               |	втДанныеШапки.ДатаМодификации КАК Период,
				   |	втПроектныеЗадачиЭтапа.Версия КАК Версия,
	               |	втПроектныеЗадачиЭтапа.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	&СтатусПроектнойЗадачи КАК СтатусЗадачи
	               |ИЗ
	               |	втДанныеШапки КАК втДанныеШапки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПроектныеЗадачиЭтапа КАК втПроектныеЗадачиЭтапа
	               |		ПО (ИСТИНА)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДанныеШапки.Регистратор КАК Регистратор,
	               |	втДанныеШапки.ДатаМодификации КАК Период,
				   |	втПроектныеЗадачиЭтапа.Версия КАК Версия,
				   |	втПроектныеЗадачиЭтапа.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	100 КАК ПроцентГотовности
	               |ИЗ
	               |	втДанныеШапки КАК втДанныеШапки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПроектныеЗадачиЭтапа КАК втПроектныеЗадачиЭтапа
	               |		ПО (ИСТИНА)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстПроведениеИспользоватьОценку()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	упоФактТрудозатратСводноСрезПоследних.Ресурс КАК Ресурс,
	               |	упоФактТрудозатратСводноСрезПоследних.Роль КАК Роль,
	               |	упоФактТрудозатратСводноСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ втИсполнителиЗадачЭтапа
	               |ИЗ
	               |	РегистрСведений.упоФактТрудозатратСводно.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача В
	               |				(ВЫБРАТЬ
	               |					втПроектныеЗадачиЭтапа.ПроектнаяЗадача
	               |				ИЗ
	               |					втПроектныеЗадачиЭтапа КАК втПроектныеЗадачиЭтапа)) КАК упоФактТрудозатратСводноСрезПоследних
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоФактДвиженийДенежныхСредствСрезПоследних.Контрагент,
	               |	&РольПодрядчик,
	               |	упоФактДвиженийДенежныхСредствСрезПоследних.ПроектнаяЗадача
	               |ИЗ
	               |	РегистрСведений.упоФактДвиженийДенежныхСредств.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача В
	               |				(ВЫБРАТЬ
	               |					втПроектныеЗадачиЭтапа.ПроектнаяЗадача
	               |				ИЗ
	               |					втПроектныеЗадачиЭтапа КАК втПроектныеЗадачиЭтапа)) КАК упоФактДвиженийДенежныхСредствСрезПоследних
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Роль,
	               |	Ресурс
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДанныеШапки.Регистратор КАК Регистратор,
	               |	втДанныеШапки.Дата КАК Период,
	               |	втИсполнителиЗадачЭтапа.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.Роль КАК Роль,
	               |	упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.ИсполнительПодрядчик КАК ИсполнительПодрядчик,
	               |	упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.Оценка КАК Оценка,
	               |	НЕ втИсполнителиЗадачЭтапа.ПроектнаяЗадача = &ПроектнаяЗадача КАК Косвенная,
	               |	упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.ЗначениеОценки КАК ЗначениеОценки,
	               |	упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.Вес КАК Вес
	               |ИЗ
	               |	втДанныеШапки КАК втДанныеШапки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоЗакрытиеЭтапа.ОценкиИсполнителейПодрядчиков КАК упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИсполнителиЗадачЭтапа КАК втИсполнителиЗадачЭтапа
	               |			ПО упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.Роль = втИсполнителиЗадачЭтапа.Роль
	               |				И упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.ИсполнительПодрядчик = втИсполнителиЗадачЭтапа.Ресурс
	               |		ПО втДанныеШапки.Регистратор = упоЗакрытиеЭтапаОценкиИсполнителейПодрядчиков.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДанныеШапки.Регистратор КАК Регистратор,
	               |	втДанныеШапки.Дата КАК Период,
	               |	втИсполнителиЗадачЭтапа.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоЗакрытиеЭтапаТрудозатраты.Роль КАК Роль,
	               |	упоЗакрытиеЭтапаТрудозатраты.ИсполнительПодрядчик КАК Ресурс,
	               |	упоЗакрытиеЭтапаТрудозатраты.КТУ КАК КТУ
	               |ИЗ
	               |	втДанныеШапки КАК втДанныеШапки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоЗакрытиеЭтапа.Трудозатраты КАК упоЗакрытиеЭтапаТрудозатраты
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ втИсполнителиЗадачЭтапа КАК втИсполнителиЗадачЭтапа
	               |			ПО упоЗакрытиеЭтапаТрудозатраты.Роль = втИсполнителиЗадачЭтапа.Роль
	               |				И упоЗакрытиеЭтапаТрудозатраты.ИсполнительПодрядчик = втИсполнителиЗадачЭтапа.Ресурс
	               |				И (НЕ упоЗакрытиеЭтапаТрудозатраты.Роль = &РольПодрядчик)
	               |		ПО втДанныеШапки.Регистратор = упоЗакрытиеЭтапаТрудозатраты.Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

Функция ТекстЗаполнение(ТаблицыОценок, Запрос, ПакетТрудозатраты)
	
	ТекстыЗапроса = Новый Массив;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	Проекты.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ втПроектныеЗадачиЭтапа
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
	               |				И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	               |		ПО Проекты.СсылкаНаПроектнуюЗадачу = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |ГДЕ
	               |	Проекты.Ссылка В ИЕРАРХИИ(&Зеркало)
	               |	И НЕ Проекты.ПометкаУдаления
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПроектнаяЗадача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	упоФактТрудозатратСводно.Ресурс КАК Ресурс,
	               |	упоФактТрудозатратСводно.Роль КАК Роль,
	               |	СУММА(упоФактТрудозатратСводно.КоличествоЧасов) КАК Трудозатраты
	               |ПОМЕСТИТЬ втИсполнителиЗадачЭтапа
	               |ИЗ
	               |	РегистрСведений.упоФактТрудозатратСводно КАК упоФактТрудозатратСводно
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втПроектныеЗадачиЭтапа КАК втПроектныеЗадачиЭтапа
	               |		ПО упоФактТрудозатратСводно.ПроектнаяЗадача = втПроектныеЗадачиЭтапа.ПроектнаяЗадача
	               |			И (упоФактТрудозатратСводно.УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Окончательный))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоФактТрудозатратСводно.Ресурс,
	               |	упоФактТрудозатратСводно.Роль
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоФактДвиженийДенежныхСредствСрезПоследних.Контрагент,
	               |	&РольПодрядчик,
	               |	СУММА(упоФактДвиженийДенежныхСредствСрезПоследних.Сумма)
	               |ИЗ
	               |	РегистрСведений.упоФактДвиженийДенежныхСредств.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача В
	               |				(ВЫБРАТЬ
	               |					втПроектныеЗадачиЭтапа.ПроектнаяЗадача
	               |				ИЗ
	               |					втПроектныеЗадачиЭтапа КАК втПроектныеЗадачиЭтапа)) КАК упоФактДвиженийДенежныхСредствСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоФактДвиженийДенежныхСредствСрезПоследних.Контрагент";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Если ТаблицыОценок.Свойство("Оценки") И ТаблицыОценок.Оценки <> Неопределено Тогда
		
		ТекстЗначенияОценок = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	втИсполнителиЗадачЭтапа.Ресурс КАК ИсполнительПодрядчик,
		                      |	втИсполнителиЗадачЭтапа.Роль КАК Роль,
		                      |	упоНастройкиОценки.Оценка КАК Оценка,
		                      |	упоНастройкиОценки.Вес КАК Вес
		                      |ПОМЕСТИТЬ втТаблицаНастроек
		                      |ИЗ
		                      |	втИсполнителиЗадачЭтапа КАК втИсполнителиЗадачЭтапа
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоНастройкиОценки КАК упоНастройкиОценки
		                      |		ПО втИсполнителиЗадачЭтапа.Роль = упоНастройкиОценки.ПредметОценки
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	ТаблицаОценок.ИсполнительПодрядчик КАК ИсполнительПодрядчик,
		                      |	ТаблицаОценок.Роль КАК Роль,
		                      |	ТаблицаОценок.Оценка КАК Оценка,
		                      |	ТаблицаОценок.ЗначениеОценки КАК ЗначениеОценки,
		                      |	ТаблицаОценок.Вес КАК Вес
		                      |ПОМЕСТИТЬ втТаблицаОценок
		                      |ИЗ
		                      |	&ТаблицаОценок КАК ТаблицаОценок
		                      |;
		                      |
		                      |////////////////////////////////////////////////////////////////////////////////
		                      |ВЫБРАТЬ
		                      |	втТаблицаНастроек.ИсполнительПодрядчик КАК ИсполнительПодрядчик,
		                      |	втТаблицаНастроек.Роль КАК Роль,
		                      |	втТаблицаНастроек.Оценка КАК Оценка,
		                      |	втТаблицаНастроек.Вес КАК Вес,
		                      |	ЕСТЬNULL(втТаблицаОценок.ЗначениеОценки, 0) КАК ЗначениеОценки
		                      |ИЗ
		                      |	втТаблицаНастроек КАК втТаблицаНастроек
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаОценок КАК втТаблицаОценок
		                      |		ПО втТаблицаНастроек.Роль = втТаблицаОценок.Роль
		                      |			И втТаблицаНастроек.ИсполнительПодрядчик = втТаблицаОценок.ИсполнительПодрядчик
		                      |			И втТаблицаНастроек.Оценка = втТаблицаОценок.Оценка";							
		Запрос.УстановитьПараметр("ТаблицаОценок", ТаблицыОценок.Оценки);
		
	Иначе
		
		ТекстЗначенияОценок = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                      |	втИсполнителиЗадачЭтапа.Ресурс КАК ИсполнительПодрядчик,
		                      |	втИсполнителиЗадачЭтапа.Роль КАК Роль,
		                      |	упоНастройкиОценки.Оценка КАК Оценка,
		                      |	упоНастройкиОценки.Вес КАК Вес,
		                      |	0 КАК ЗначениеОценки
		                      |ИЗ
		                      |	втИсполнителиЗадачЭтапа КАК втИсполнителиЗадачЭтапа
		                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоНастройкиОценки КАК упоНастройкиОценки
		                      |		ПО втИсполнителиЗадачЭтапа.Роль = упоНастройкиОценки.ПредметОценки";		
		
	КонецЕсли;	
	
	Если ТаблицыОценок.Свойство("Трудозатраты") И ТаблицыОценок.Трудозатраты <> Неопределено Тогда
		
		ТекстТрудозатраты =  "ВЫБРАТЬ
		                     |	втИсполнителиЗадачЭтапа.Ресурс КАК ИсполнительПодрядчик,
		                     |	втИсполнителиЗадачЭтапа.Роль КАК Роль,
		                     |	втИсполнителиЗадачЭтапа.Трудозатраты КАК Трудозатраты
		                     |ПОМЕСТИТЬ втТаблицаИсполнители
		                     |ИЗ
		                     |	втИсполнителиЗадачЭтапа КАК втИсполнителиЗадачЭтапа
		                     |ГДЕ
		                     |	ТИПЗНАЧЕНИЯ(втИсполнителиЗадачЭтапа.Ресурс) = ТИП(Справочник.упоТрудовыеРесурсы)
		                     |;
		                     |
		                     |////////////////////////////////////////////////////////////////////////////////
		                     |ВЫБРАТЬ
		                     |	ТаблицаТрудозатрат.ИсполнительПодрядчик КАК ИсполнительПодрядчик,
		                     |	ТаблицаТрудозатрат.Роль КАК Роль,
		                     |	ТаблицаТрудозатрат.КТУ КАК КТУ
		                     |ПОМЕСТИТЬ втТаблицаТрудозатрат
		                     |ИЗ
		                     |	&ТаблицаТрудозатрат КАК ТаблицаТрудозатрат
		                     |;
		                     |
		                     |////////////////////////////////////////////////////////////////////////////////
		                     |ВЫБРАТЬ
		                     |	втТаблицаИсполнители.ИсполнительПодрядчик КАК ИсполнительПодрядчик,
		                     |	втТаблицаИсполнители.Роль КАК Роль,
		                     |	втТаблицаИсполнители.Трудозатраты КАК Трудозатраты,
		                     |	0 КАК ТрудозатратыПроцент,
		                     |	ЕСТЬNULL(втТаблицаТрудозатрат.КТУ, 0) КАК КТУ
		                     |ИЗ
		                     |	втТаблицаИсполнители КАК втТаблицаИсполнители
		                     |		ЛЕВОЕ СОЕДИНЕНИЕ втТаблицаТрудозатрат КАК втТаблицаТрудозатрат
		                     |		ПО втТаблицаИсполнители.Роль = втТаблицаТрудозатрат.Роль
		                     |			И втТаблицаИсполнители.ИсполнительПодрядчик = втТаблицаТрудозатрат.ИсполнительПодрядчик";		
		ПакетТрудозатраты = 3;
		Запрос.УстановитьПараметр("ТаблицаТрудозатрат", ТаблицыОценок.Трудозатраты);
		
	Иначе
		
		ТекстТрудозатраты = "ВЫБРАТЬ
		                    |	втИсполнителиЗадачЭтапа.Ресурс КАК ИсполнительПодрядчик,
		                    |	втИсполнителиЗадачЭтапа.Роль КАК Роль,
		                    |	втИсполнителиЗадачЭтапа.Трудозатраты КАК Трудозатраты,
		                    |	0 КАК ТрудозатратыПроцент,
		                    |	0 КАК КТУ
		                    |ИЗ
		                    |	втИсполнителиЗадачЭтапа КАК втИсполнителиЗадачЭтапа
		                    |ГДЕ
		                    |	ТИПЗНАЧЕНИЯ(втИсполнителиЗадачЭтапа.Ресурс) = ТИП(Справочник.упоТрудовыеРесурсы)";
		ПакетТрудозатраты = 1;
		
	КонецЕсли;	
	
	ТекстыЗапроса.Добавить(ТекстЗначенияОценок);
	ТекстыЗапроса.Добавить(ТекстТрудозатраты);
				
	Возврат СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
КонецФункции	

#КонецОбласти

#КонецЕсли