&НаСервере
Процедура ЗаполнитьВнепроектныеЗадачиНаСервере()
	
	ТаблицаВнепроектныеЗадачи = упоРаспределениеТрудозатратВызовСервера.ЗаполнитьВнепроектныеЗадачи(Объект.ТрудовойРесурс,
		НачалоДня(Объект.ДеньНачалаНедели), 
		КонецДня(Объект.ДеньКонецНедели));
		
	Объект.ВнепроектныеЗадачи.Очистить();	
	Для каждого СтрокаТаблицы Из ТаблицаВнепроектныеЗадачи Цикл
	  СтрокаВнепроектныеЗадачи = Объект.ВнепроектныеЗадачи.Добавить(); 
      ЗаполнитьЗначенияСвойств(СтрокаВнепроектныеЗадачи,СтрокаТаблицы);
	  СтрокаВнепроектныеЗадачи.ДатаНачала = СтрокаТаблицы.ДатаНачалаПлан;
	  СтрокаВнепроектныеЗадачи.ДатаОкончания = СтрокаТаблицы.ДатаОкончанияПлан;
	КонецЦикла;	

	ОчиститьРасшифровкуРазделаУчета(Перечисления.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача);
		
	ИспользоватьРасшифровку = Объект.ИспользоватьРасшифровкуТрудозатрат 
		И константа_ИспользоватьРасшифровкуТрудозатратНаПроектныхЗадачах;
	
	ОпределитьВозможностьРедактированияЯчеекВТаблице("ВнепроектныеЗадачи", ИспользоватьРасшифровку, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДатыНачалаОкончанияВСтроке(ТаблицаСроковЗадач, Строка, Задача)
	
	НайденнаяСтрока = ТаблицаСроковЗадач.Найти(Задача, "Задача");
	Если НайденнаяСтрока <> Неопределено Тогда
		Строка.ДатаНачала = НайденнаяСтрока.ДатаНачала;
		Строка.ДатаОкончания = НайденнаяСтрока.ДатаЗавершения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСрокиВнепроектногоЗаданияВСтроке(Строка, Задание)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСрокиЗаданий.ДатаНачалаПлан,
	               |	упоСрокиЗаданий.ДатаОкончанияПлан
	               |ИЗ
	               |	РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
	               |ГДЕ
	               |	упоСрокиЗаданий.Задание = &Задание";
				   
	Запрос.УстановитьПараметр("Задание", Задание);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 		
		Строка.ДатаНачала = Выборка.ДатаНачалаПлан;
		Строка.ДатаОкончания = Выборка.ДатаОкончанияПлан; 		
	Иначе
		Строка.ДатаНачала = Дата(1, 1, 1);
		Строка.ДатаОкончания = Дата(1, 1, 1);
	КонецЕсли;
	
	ОпределитьВозможностьРедактированияЧасовНаДату(Строка);    	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСрокиЗадач()
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Сроки.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Сроки.ПроектнаяЗадача.Проект КАК Проект,
	               |	ЕСТЬNULL(Сроки.ДатаНачалаПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНачала,
	               |	ЕСТЬNULL(Сроки.ДатаЗавершенияПлан, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗавершения
	               |ПОМЕСТИТЬ втСрокиПроектнойЗадачи
	               |ИЗ
	               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&МассивПроектныхЗадач)) КАК Сроки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
	               |		ПО Сроки.Версия = Версии.Версия
	               |			И (Версии.Текущая)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫБОР
	               |		КОГДА упоСтатусыПроектовСрезПоследних.СтатусПроекта = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Остановлен)
	               |			ТОГДА упоСтатусыПроектовСрезПоследних.Период
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ КАК ДатаОстановки,
	               |	упоСтатусыПроектовСрезПоследних.Проект КАК Проект
	               |ПОМЕСТИТЬ ВТ_ДатыОстановкиПроектов
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектов.СрезПоследних(
	               |			&КонецНедели,
	               |			Проект В
	               |				(ВЫБРАТЬ
	               |					втСрокиПроектнойЗадачи.Проект КАК Проект
	               |				ИЗ
	               |					втСрокиПроектнойЗадачи КАК втСрокиПроектнойЗадачи)) КАК упоСтатусыПроектовСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоНастройкаАналитикиВРазрезеПодразделений КАК НастройкаАналитикиВРазрезеПодразделений
	               |		ПО упоСтатусыПроектовСрезПоследних.Проект = НастройкаАналитикиВРазрезеПодразделений.Объект
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних КАК РуководителиПроектов
	               |		ПО упоСтатусыПроектовСрезПоследних.Проект = РуководителиПроектов.Проект
	               |ГДЕ
	               |	НЕ(НастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусеОстановлен
	               |				И упоСтатусыПроектовСрезПоследних.СтатусПроекта = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Остановлен)
	               |				И НЕ(НастройкаАналитикиВРазрезеПодразделений.РазрешитьСписаниеЧасовНаПроектныеЗадачиПроектаВСтатусахЗапланированУтвержден
	               |						И упоСтатусыПроектовСрезПоследних.СтатусПроекта В (ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Запланирован), ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Утвержден)))
	               |				И РуководителиПроектов.РуководительПроекта = &СотрудникТрудовогоРесурса)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВЫБОР
	               |		КОГДА упоСтатусыПроектовСрезПоследних.СтатусПроекта = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Остановлен)
	               |			ТОГДА упоСтатусыПроектовСрезПоследних.Период
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	упоСтатусыПроектовСрезПоследних.Проект
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоЗадания.Ссылка КАК Задача,
	               |	ЕСТЬNULL(упоСрокиЗаданий.ДатаНачалаПлан, втСрокиПроектнойЗадачи.ДатаНачала) КАК ДатаНачала,
	               |	ВЫБОР
	               |		КОГДА НЕ ВТ_ДатыОстановкиПроектов.ДатаОстановки ЕСТЬ NULL
	               |			ТОГДА ВТ_ДатыОстановкиПроектов.ДатаОстановки
	               |		ИНАЧЕ ЕСТЬNULL(упоСрокиЗаданий.ДатаОкончанияПлан, втСрокиПроектнойЗадачи.ДатаЗавершения)
	               |	КОНЕЦ КАК ДатаЗавершения
	               |ИЗ
	               |	Справочник.упоЗадания КАК упоЗадания
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
	               |		ПО (упоСрокиЗаданий.Задание = упоЗадания.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втСрокиПроектнойЗадачи КАК втСрокиПроектнойЗадачи
	               |		ПО (втСрокиПроектнойЗадачи.ПроектнаяЗадача = упоЗадания.ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатыОстановкиПроектов КАК ВТ_ДатыОстановкиПроектов
	               |		ПО упоЗадания.Проект = ВТ_ДатыОстановкиПроектов.Проект
	               |ГДЕ
	               |	упоЗадания.Ссылка В(&МассивЗадач)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Сроки.ПроектнаяЗадача,
	               |	ЕСТЬNULL(Сроки.ДатаНачалаПлан, ДАТАВРЕМЯ(1, 1, 1)),
	               |	ВЫБОР
	               |		КОГДА НЕ ВТ_ДатыОстановкиПроектов.ДатаОстановки ЕСТЬ NULL
	               |			ТОГДА ВТ_ДатыОстановкиПроектов.ДатаОстановки
	               |		ИНАЧЕ ЕСТЬNULL(Сроки.ДатаЗавершенияПлан, ДАТАВРЕМЯ(1, 1, 1))
	               |	КОНЕЦ
	               |ИЗ
	               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&МассивЗадач)) КАК Сроки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
	               |		ПО Сроки.Версия = Версии.Версия
	               |			И (Версии.Текущая)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДатыОстановкиПроектов КАК ВТ_ДатыОстановкиПроектов
	               |		ПО Сроки.ПроектнаяЗадача.Проект = ВТ_ДатыОстановкиПроектов.Проект";
				   
	МассивЗадач = Новый Массив();
	МассивПроектныхЗадач = Новый Массив();
	Для Каждого СтрокаЗадача Из Объект.РабочиеЗадания Цикл
		МассивЗадач.Добавить(?(ЗначениеЗаполнено(СтрокаЗадача.Задание), СтрокаЗадача.Задание, СтрокаЗадача.РабочееЗадание));
		МассивПроектныхЗадач.Добавить(СтрокаЗадача.РабочееЗадание);
	КонецЦикла;
	Для Каждого СтрокаЗадача Из Объект.ВнепроектныеЗадачи Цикл
		МассивЗадач.Добавить(СтрокаЗадача.Задача);
	КонецЦикла;
				   
	Запрос.УстановитьПараметр("МассивЗадач", МассивЗадач);	
	Запрос.УстановитьПараметр("МассивПроектныхЗадач", МассивПроектныхЗадач);
	Запрос.УстановитьПараметр("КонецНедели", Объект.ДеньКонецНедели);
	
	СотрудникТР = упоРесурсыИРолиВызовСервера.обПолучитьТекущегоВладельцаРесурса(Объект.ТрудовойРесурс);
	Запрос.УстановитьПараметр("СотрудникТрудовогоРесурса", СотрудникТР);
	
	ТаблицаСроковЗадач = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаЗадача Из Объект.РабочиеЗадания Цикл
		Задача = ?(ЗначениеЗаполнено(СтрокаЗадача.Задание), СтрокаЗадача.Задание, СтрокаЗадача.РабочееЗадание);
		ЗаполнитьДатыНачалаОкончанияВСтроке(ТаблицаСроковЗадач, СтрокаЗадача, Задача);
	КонецЦикла;
	
	Для Каждого СтрокаЗадача Из Объект.ВнепроектныеЗадачи Цикл
		Задача = СтрокаЗадача.Задача;
		ЗаполнитьДатыНачалаОкончанияВСтроке(ТаблицаСроковЗадач, СтрокаЗадача, Задача);
	КонецЦикла;  	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНадписьДатыВвода(ИмяЭлементаНадпись, ИмяТаблицы)
	
	текДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	Если текДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;    	
		
	лДатаНачала = текДанные.ДатаНачала;
	лДатаЗавершения = текДанные.ДатаОкончания;
	
	ИнфоСрокиЗадачи = "Сроки: [" + Формат(лДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(лДатаЗавершения, "ДФ=dd.MM.yyyy") + "]";  	

	ЭтаФорма[ИмяЭлементаНадпись] = ИнфоСрокиЗадачи;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьВозможностьРедактированияЧасовНаДату(СтрокаТабличнойЧасти)
	
	Для Каждого ДанныеДняНедели Из СтруктураДниНедели Цикл
		ПроверитьПопаданиеВСрокЗадачи(СтрокаТабличнойЧасти, ДанныеДняНедели.Ключ, ДанныеДняНедели.Значение, Объект.ДеньНачалаНедели, Истина);	
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Процедура ОпределитьВозможностьРедактированияЯчеекВТаблице(ИмяТаблицы, ИспользоватьРасшифровку, ПоСрокам = Ложь)
	
	Для Каждого СтрокаТаблицы Из Объект[ИмяТаблицы] Цикл	
		Если ИспользоватьРасшифровку Тогда 
			ОпределитьВозможностьРедактированияЯчеекВСтроке(СтрокаТаблицы, ИмяТаблицы);
		Иначе
			СтрокаТаблицы.ТолькоПросмотрПонедельник = Ложь;
			СтрокаТаблицы.ТолькоПросмотрВторник = Ложь;
			СтрокаТаблицы.ТолькоПросмотрСреда = Ложь;
			СтрокаТаблицы.ТолькоПросмотрЧетверг = Ложь;
			СтрокаТаблицы.ТолькоПросмотрПятница = Ложь;
			СтрокаТаблицы.ТолькоПросмотрСуббота = Ложь;
			СтрокаТаблицы.ТолькоПросмотрВоскресенье = Ложь;
		КонецЕсли;
		Если ПоСрокам Тогда
			ОпределитьВозможностьРедактированияЧасовНаДату(СтрокаТаблицы);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьПопаданиеВСрокЗадачи(СтрокаТабличнойЧасти, ИмяКолонки, СмещениеДаты, ДеньНачалаНедели, УстановитьТолькоПросмотр = Ложь)
	
	РедактированиеРазрешено = Истина;
	Дата = ДеньНачалаНедели + СмещениеДаты * 24 * 60 * 60;
	
	Если Дата < СтрокаТабличнойЧасти.ДатаНачала ИЛИ (Дата > СтрокаТабличнойЧасти.ДатаОкончания И ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДатаОкончания)) Тогда
		РедактированиеРазрешено = Ложь;
		Если УстановитьТолькоПросмотр Тогда
			СтрокаТабличнойЧасти["ТолькоПросмотр" + ИмяКолонки] = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат РедактированиеРазрешено;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВыбораВидаОперацииОсновная(ВидОперации,ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ТаблицаРасшифровкаТрудозатрат.НайтиПоИдентификатору(ДополнительныеПараметры.УИстроки);
	
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ВидОперации = ВидОперации;
	КонецЕсли;
	
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьШаблонТекстаСообщенияДляПроверкиРасшифровки(ИмяТабличнойЧасти)
	
	Если ИмяТабличнойЧасти = "РабочиеЗадания" Тогда
		ШаблонТекстаСообщения =
			НСтр("ru = 'На вкладке ""%1"" для рабочего задания ""%2"", роли трудового ресурса ""%3"" и подразделения ""%4""
			|не заполнен вид операции в расшифровке для дня ""%5""'");	 
	ИначеЕсли ИмяТабличнойЧасти = "ВнепроектныеЗадачи" Тогда
		ШаблонТекстаСообщения =
			НСтр("ru = 'На вкладке ""%1"" для задачи ""%2"" не заполнен вид операции в расшифровке для дня ""%3""'");	
	ИначеЕсли ИмяТабличнойЧасти = "ПотериВремени" Тогда
		ШаблонТекстаСообщения =
			НСтр("ru = 'На вкладке ""%1"" для причины ""%2"" не заполнен вид операции в расшифровке для дня ""%3""'");
	Иначе
		ШаблонТекстаСообщения = "";	
	КонецЕсли;
	
	Возврат ШаблонТекстаСообщения;
	
КонецФункции

&НаКлиенте
Процедура СообщитьПользователюОНезаполненостиВидаОперации(ИмяТабличнойЧасти, ШаблонТекстаСообщения, СтрокаРасшифровки, НазванияПЗРабочиеЗадания)
	
	Если ИмяТабличнойЧасти = "РабочиеЗадания" Тогда
		
		ЗаголовокПроверяемойСтраницы = Элементы.СтраницаРабочиеЗадания.Заголовок;			
		НаименованиеРабЗадания = НазванияПЗРабочиеЗадания[СтрокаРасшифровки.РабочееЗадание];			
		ТекстНеЗаполенныхДней = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,
			ЗаголовокПроверяемойСтраницы, НаименованиеРабЗадания, СтрокаРасшифровки.РольРесурса,
			СтрокаРасшифровки.Подразделение, СтрокаРасшифровки.ДеньНедели);				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстНеЗаполенныхДней);
		
	ИначеЕсли ИмяТабличнойЧасти = "ВнепроектныеЗадачи" Тогда
		
		ЗаголовокПроверяемойСтраницы = Элементы.СтраницаВнепроектныеЗадачи.Заголовок;						
		ТекстНеЗаполенныхДней = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,
			ЗаголовокПроверяемойСтраницы, СтрокаРасшифровки.Задача, СтрокаРасшифровки.ДеньНедели);				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстНеЗаполенныхДней);
		
	ИначеЕсли ИмяТабличнойЧасти = "ПотериВремени" Тогда
		
		ЗаголовокПроверяемойСтраницы = Элементы.СтраницаПотериВремени.Заголовок;						
		ТекстНеЗаполенныхДней = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,
			ЗаголовокПроверяемойСтраницы, СтрокаРасшифровки.Причина, СтрокаРасшифровки.ДеньНедели);				
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстНеЗаполенныхДней);
		
	Иначе	
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполненияВидОперацииРасшифровкиДляТабЧасти(НайденныеСтроки, Отказ, ИмяТабличнойЧасти)
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;		
	КонецЕсли;	
	
	Отказ = Истина;	
	ШаблонТекстаСообщения = ПолучитьШаблонТекстаСообщенияДляПроверкиРасшифровки(ИмяТабличнойЧасти);
	
	НазванияПЗРабочиеЗадания = Новый Соответствие;
	НужноПолучатьНаименованиеЗадачи = ИмяТабличнойЧасти = "РабочиеЗадания";
	Если НужноПолучатьНаименованиеЗадачи Тогда
		Для Каждого Строка Из Объект.РабочиеЗадания Цикл
			НазванияПЗРабочиеЗадания.Вставить(Строка.РабочееЗадание, Строка.Наименование);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого СтрокаРасшифровки Из НайденныеСтроки Цикл			
		СообщитьПользователюОНезаполненостиВидаОперации(ИмяТабличнойЧасти, ШаблонТекстаСообщения, СтрокаРасшифровки, НазванияПЗРабочиеЗадания);			
	КонецЦикла;
					
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЗаполненияРасшифровки(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	РасшифровкаТрудозатрат = Объект.РасшифровкаТрудозатрат;
	
	ИмяТабличнойЧасти = "РабочиеЗадания";
	
	РазделУчетаПроектнаяЗадача = 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача");
	ПустаяСсылкаупоВидыОпераций = 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Справочник.упоВидыОпераций.ПустаяСсылка");
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("РазделУчета", РазделУчетаПроектнаяЗадача);
	ОтборСтрок.Вставить("ВидОперации", ПустаяСсылкаупоВидыОпераций);
	НайденныеСтроки = РасшифровкаТрудозатрат.НайтиСтроки(ОтборСтрок);
	
	ПроверитьЗаполненияВидОперацииРасшифровкиДляТабЧасти(НайденныеСтроки, Отказ, ИмяТабличнойЧасти);	
	
	ИмяТабличнойЧасти = "ВнепроектныеЗадачи";
	РазделУчетаВнепроектнаяЗадача = 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача");
	ОтборСтрок.РазделУчета = РазделУчетаВнепроектнаяЗадача;
	НайденныеСтроки = РасшифровкаТрудозатрат.НайтиСтроки(ОтборСтрок);
	
	ПроверитьЗаполненияВидОперацииРасшифровкиДляТабЧасти(НайденныеСтроки, Отказ, ИмяТабличнойЧасти);
	
	ИмяТабличнойЧасти = "ПотериВремени";
	РазделУчетаПотеряРабочегоВремени = 
		ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени");
	ОтборСтрок.РазделУчета = РазделУчетаПотеряРабочегоВремени;
	НайденныеСтроки = РасшифровкаТрудозатрат.НайтиСтроки(ОтборСтрок);
	
	ПроверитьЗаполненияВидОперацииРасшифровкиДляТабЧасти(НайденныеСтроки, Отказ, ИмяТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСтрокиРасшифровкиСвязанныеСТабЧастью(ИмяТЧ, СтрокиРасшифровкиСвязанныеСТабЧастями)
	
	ПараметрыОтбора = ПараметрыДляПоискаСвязанныхСтрок(ИмяТЧ);
	СтрокаСвойств = ПараметрыОтбора.СтрокаСвойств;
	РазделУчета = ПараметрыОтбора.РазделУчета;
	
	Отбор = Новый Структура(СтрокаСвойств);
	Отбор.РазделУчета = РазделУчета;
	Для Каждого Строка Из Объект[ИмяТЧ] Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, Строка);		
		НайденныеСтроки = Объект.РасшифровкаТрудозатрат.НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			СтрокиРасшифровкиСвязанныеСТабЧастями.Вставить(НайденнаяСтрока, Истина);
		КонецЦикла;		
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыДляПоискаСвязанныхСтрок(ИмяТЧ)
	
	ПараметрыОтбора = Новый Структура("СтрокаСвойств, РазделУчета");
	Если ИмяТЧ = "РабочиеЗадания" Тогда
		ПараметрыОтбора.СтрокаСвойств = "РабочееЗадание,РольРесурса, Подразделение, РазделУчета, Задание";
		ПараметрыОтбора.РазделУчета = 
			ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача");
	ИначеЕсли ИмяТЧ = "ВнепроектныеЗадачи" Тогда
		ПараметрыОтбора.СтрокаСвойств = "Задача, РазделУчета";
		ПараметрыОтбора.РазделУчета = 
			ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача");
	ИначеЕсли ИмяТЧ = "ПотериВремени" Тогда		
		ПараметрыОтбора.СтрокаСвойств = "Причина, РазделУчета";
		ПараметрыОтбора.РазделУчета = 
			ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени");			
	Иначе
		ПараметрыОтбора.СтрокаСвойств = "";		
	КонецЕсли;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиРасшифровкиНеСвязанныеСТабЧастями()
	
	СтрокиРасшифровкиСвязанныеСТабЧастями = Новый Соответствие;
	
	ПолучитьСтрокиРасшифровкиСвязанныеСТабЧастью("РабочиеЗадания", СтрокиРасшифровкиСвязанныеСТабЧастями);	
	ПолучитьСтрокиРасшифровкиСвязанныеСТабЧастью("ВнепроектныеЗадачи", СтрокиРасшифровкиСвязанныеСТабЧастями);	
	ПолучитьСтрокиРасшифровкиСвязанныеСТабЧастью("ПотериВремени", СтрокиРасшифровкиСвязанныеСТабЧастями);
	
	СтрокиНеСвязанныеСТабЧастями = Новый Массив;
	Для Каждого Строка Из Объект.РасшифровкаТрудозатрат Цикл
		Если СтрокиРасшифровкиСвязанныеСТабЧастями[Строка] = Неопределено Тогда
			СтрокиНеСвязанныеСТабЧастями.Добавить(Строка);	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Строка Из СтрокиНеСвязанныеСТабЧастями Цикл
		Объект.РасшифровкаТрудозатрат.Удалить(Строка);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыВыбораПодразделенияРоли(Роль, Элемент)
	
	НовыйМассив = Новый Массив;
	НовыйМассив.Добавить(Новый ПараметрВыбора("РесурсПодразделения", Роль));
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элемент.ПараметрыВыбора = НовыеПараметры;
	
КонецПроцедуры

