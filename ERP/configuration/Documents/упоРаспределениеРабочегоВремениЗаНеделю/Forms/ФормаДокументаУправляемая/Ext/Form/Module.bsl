// Список задач

&НаКлиенте
Процедура ЗаполнитьТаблицуРабочихЗаданий(Режим = "")
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("Режим",Режим);
	
	Если Объект.РабочиеЗадания.Количество() > 0 Тогда      
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТаблицуРабочихЗаданийЗавершение",ЭтотОбъект,ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Табличная часть будет изменена в соответствии со списком задач
				|трудового ресурса на указанный период.
				|Возможно, при этом какие-то из уже введенных данных будут потеряны.
				|Продолжить?'"), РежимДиалогаВопрос.ДаНет, 120, КодВозвратаДиалога.Да);
		
	Иначе
		
		ЗаполнитьТаблицуРабочихЗаданийЗавершение(Неопределено,ДополнительныеПараметры);			
		
	КонецЕсли;   
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуРабочихЗаданийЗавершение(Ответ,ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда      
			Возврат;
		КонецЕсли; 
	
	Если ДополнительныеПараметры.Режим = "" Тогда		
		ОбновитьСписокЗадач();		
	ИначеЕсли ДополнительныеПараметры.Режим = "ПоОперативнойЗагрузке" Тогда
		ЗаполнитьПоОперативнойЗагрузкеНаСервере();	
	КонецЕсли;	
	
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЗадач(ОчиститьЗадания = Ложь)
	
	Если ОчиститьЗадания Тогда	
		Объект.РабочиеЗадания.Очистить();
		мРабочиеЗадания.Очистить();
	КонецЕсли;
	
	тчРабочиеЗадания = Объект.РабочиеЗадания.Выгрузить();
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("РасшифровкаТрудозатрат", Объект.РасшифровкаТрудозатрат);
	ДанныеДокумента.Вставить("ТрудовойРесурс", Объект.ТрудовойРесурс);
	ДанныеДокумента.Вставить("ДеньНачалаНедели", Объект.ДеньНачалаНедели);
	ДанныеДокумента.Вставить("ДеньКонецНедели", Объект.ДеньКонецНедели);
	
	УстановитьПривилегированныйРежим(Истина);
	
	упоРаспределениеТрудозатратВызовСервера.ЗаполнитьРабочиеЗадания(ЭтаФорма, тчРабочиеЗадания, мРабочиеЗадания, ДанныеДокумента);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	// Сортируем по рабочим заданиям в рамках одного проекта
		
	Для каждого СтрокаТЧ Из тчРабочиеЗадания Цикл
		
		СтрокиКэша = мРабочиеЗадания.НайтиСтроки(Новый Структура("РабочееЗадание, РольРесурса, Задание",
			СтрокаТЧ.РабочееЗадание, СтрокаТЧ.РольРесурса, СтрокаТЧ.Задание));

		Если НЕ СтрокиКэша.Количество() = 0 Тогда	
			СтрокаКэш = СтрокиКэша[0]; 	
			ЗаполнитьЗначенияСвойств(СтрокаТЧ,СтрокаКэш);
		КонецЕсли;
	
	КонецЦикла; 
	
	Объект.РабочиеЗадания.Загрузить(тчРабочиеЗадания);
    
	ЗаполнитьДопПараметрыРабочихЗаданий();
	
	Объект.РабочиеЗадания.Сортировать("Проект возр, Наименование возр");
	
	ИспользоватьРасшифровку = Объект.ИспользоватьРасшифровкуТрудозатрат И константа_ИспользоватьРасшифровкуТрудозатратНаПроектныхЗадачах;
	ОпределитьВозможностьРедактированияЯчеек(ИспользоватьРасшифровку);

КонецПроцедуры 

&НаСервере
Функция ЗаполнитьДопПараметрыРабочихЗаданий()
	
	УстановитьПривилегированныйРежим(Истина);
	МассивРабочихЗаданий = Объект.РабочиеЗадания.Выгрузить().ВыгрузитьКолонку("РабочееЗадание");	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК РабочееЗадание,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК Наименование
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&МассивРабочихЗаданий)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО (упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И упоВерсииПроекта.Текущая)";
	Запрос.УстановитьПараметр("МассивРабочихЗаданий", МассивРабочихЗаданий);				   
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеСтроки = Объект.РабочиеЗадания.НайтиСтроки(Новый Структура("РабочееЗадание", Выборка.РабочееЗадание));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Наименование = Выборка.Наименование;
			// Добавление к названию ПЗ наименования поручения
			Если ЗначениеЗаполнено(НайденнаяСтрока.Задание) Тогда
				НайденнаяСтрока.Наименование = НайденнаяСтрока.Наименование + " / " + НайденнаяСтрока.Задание.Наименование;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;     
	
	
	Для Каждого СтрокаРЗ Из Объект.РабочиеЗадания Цикл
		
	// PM 4.2.15 Отключено: не должен документ дозаполняться данными, влияющими на проведение, после записи.	
	//	Если НЕ ЗначениеЗаполнено(СтрокаРЗ.РольРесурса) Тогда
	//		СтрокаРЗ.РольРесурса = РольПоУмолчанию;
	//	КонецЕсли;
	//	Если НЕ ЗначениеЗаполнено(СтрокаРЗ.Подразделение) Тогда
	//		СтрокаРЗ.Подразделение = Объект.Подразделение;
	//	КонецЕсли;
	//	
		СтрокаРЗ.ТипЗадачи = ?(СтрокаРЗ.ЭтоПроектнаяЗадача, 3, 2);
		
	КонецЦикла;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоОперативнойЗагрузкеНаСервере()
	
	Если Объект.РабочиеЗадания.Количество() > 0 Тогда
		Объект.РабочиеЗадания.Очистить();
	КонецЕсли;		
	
	ОчиститьРасшифровкуРазделаУчета(Перечисления.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача);
		
	ТаблицаРабочиеЗадания = Объект.РабочиеЗадания.Выгрузить(); 	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТрудовойРесурс", Объект.ТрудовойРесурс);
	СтруктураПараметров.Вставить("НачалоПериода", Объект.ДеньНачалаНедели);
	СтруктураПараметров.Вставить("КонецПериода", Объект.ДеньКонецНедели);
	
	УстановитьПривилегированныйРежим(Истина);

	упоРаспределениеТрудозатратВызовСервера.ПолучитьТаблицуРабочихЗаданийЗаНеделюПоОперативнойЗагрузке(ТаблицаРабочиеЗадания, СтруктураПараметров);
	
	УстановитьПривилегированныйРежим(Ложь);
		
	ТаблицаРабочиеЗадания.Сортировать("Проект возр, Наименование возр");
	
	Объект.РабочиеЗадания.Загрузить(ТаблицаРабочиеЗадания);
	
	ИспользоватьРасшифровку = Объект.ИспользоватьРасшифровкуТрудозатрат И константа_ИспользоватьРасшифровкуТрудозатратНаПроектныхЗадачах;
	ОпределитьВозможностьРедактированияЯчеек(ИспользоватьРасшифровку);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьРасшифровкуРазделаУчета(РазделУчета)
	
	НайденныеСтроки = Объект.РасшифровкаТрудозатрат.НайтиСтроки(Новый Структура("РазделУчета", РазделУчета));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Объект.РасшифровкаТрудозатрат.Удалить(НайденнаяСтрока);
	КонецЦикла;	 
	
КонецПроцедуры 	

////////////////////////////////////////////////////////////////////////////////
// Даты

&НаСервере
Процедура ИзменитьНачалоНеделиСервер(Направление = Неопределено)
	
	ЗаполнитьПодразделение();
	
	// необходимо проверять список текущих РЗ при изменении даты	
	Если НЕ ЗначениеЗаполнено(Объект.ДеньНачалаНедели) Тогда
		Объект.ДеньНачалаНедели = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Направление = Неопределено Тогда
		НоваяНеделя = НачалоНедели(Объект.ДеньНачалаНедели);
	Иначе
		НоваяНеделя = НачалоНедели(НачалоДня(Объект.ДеньНачалаНедели) + (604800 * Направление));
	КонецЕсли; 
	
	Объект.ДеньНачалаНедели = НоваяНеделя;
	Объект.ДеньКонецНедели = КонецНедели(Объект.ДеньНачалаНедели);
	
	ОчиститьЗадания = Объект.ДеньНачалаНедели <> НачалоНедели(ПредыдущаяДата);
	
	ОбновитьСписокЗадач(ОчиститьЗадания);
	
	ПредыдущаяДата = Объект.ДеньНачалаНедели;

	УстановитьДатыДнямНеделиВШапкиТаблиц(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьДатыДнямНеделиВШапкиТаблиц(Объект, ЭтаФорма)
	
	СтруктураИменКолонок = Новый Структура(
		"Понедельник, Вторник, Среда, Четверг, Пятница, Суббота, Воскресенье",
		"Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс");
	
	МассивТЧ = Новый Массив;
	МассивТЧ.Добавить("РабочиеЗадания");
	МассивТЧ.Добавить("ВнепроектныеЗадачи");
	МассивТЧ.Добавить("ПотериВремени");
	Для Каждого ИмяТЧ Из МассивТЧ Цикл
		УстановитьДатыВидимостьДнямНедели(Объект, ЭтаФорма, Объект.ДеньНачалаНедели, СтруктураИменКолонок, ИмяТЧ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьДатыВидимостьДнямНедели(Объект, ЭтаФорма, ДатаНачалаНедели, СтруктураИменКолонок, ИмяТаблицы)
	
	ТекДата = ДатаНачалаНедели;
	
	Шаблон = "%1 %2";
	
	Для Каждого ДеньНедели Из СтруктураИменКолонок Цикл
		
		ИмяКолонки = ИмяТаблицы + ДеньНедели.Ключ;
		ЭтаФорма.Элементы[ИмяКолонки].Заголовок = СтрШаблон(Шаблон, ДеньНедели.Значение, Формат(ТекДата, "ДФ=dd.MM"));
		
		ТекДата = КонецДня(ТекДата) + 1; // Начало следующего дня.
		
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Итоги

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИтоги(ЭтаФорма)

	ЭтаФорма.ТаблицаИтого.Очистить();
	
	СтруктураКолонок = Новый Структура("Понедельник, Вторник, Среда, Четверг, Пятница, Суббота, Воскресенье, ИтогоПоСтроке");
	
	СоответствиеТаблиц = Новый Соответствие;
	СоответствиеТаблиц.Вставить(ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача"),
		"ВнепроектныеЗадачи");
	СоответствиеТаблиц.Вставить(ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача"),
		"РабочиеЗадания");
	СоответствиеТаблиц.Вставить(ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени"),
		"ПотериВремени");
	
	Для Каждого КлючЗначениеКолонок Из СтруктураКолонок Цикл
		ЭтаФорма["ТаблицаИтого_"+КлючЗначениеКолонок.Ключ] = 0;		
	КонецЦикла;
	
	Для Каждого КлючЗначениеТаблиц Из СоответствиеТаблиц Цикл
		НоваяСтрока = ЭтаФорма.ТаблицаИтого.Добавить();
		НоваяСтрока.РазделУчета = КлючЗначениеТаблиц.Ключ;
		Для Каждого КлючЗначениеКолонок Из СтруктураКолонок Цикл
			НоваяСтрока[КлючЗначениеКолонок.Ключ] = ЭтаФорма.Объект[КлючЗначениеТаблиц.Значение].Итог(КлючЗначениеКолонок.Ключ);			
			ЭтаФорма["ТаблицаИтого_" + КлючЗначениеКолонок.Ключ] = ЭтаФорма.ЭтаФорма["ТаблицаИтого_" + КлючЗначениеКолонок.Ключ] 
				+ НоваяСтрока[КлючЗначениеКолонок.Ключ]; 
		КонецЦикла; 			
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуТабличнойЧасти(ТаблицаДанных)

	ТекДанные = Элементы[ТаблицаДанных].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ТекДанные.ИтогоПоСтроке = ТекДанные.Понедельник
		+ ТекДанные.Вторник 
		+ ТекДанные.Среда
		+ ТекДанные.Четверг
		+ ТекДанные.Пятница 
		+ ТекДанные.Суббота
		+ ТекДанные.Воскресенье;
		
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Расшифровка

&НаКлиенте
Процедура ОткрытьФормуВыбораВидаОперации(Элемент, ТаблицаФормы, РазделУчета, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
    Отбор = Новый Структура("РазделУчета", РазделУчета);	
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	
	Контекст = Новый Структура;
	Контекст.Вставить("УИстроки",ТаблицаФормы.ТекущиеДанные.ПолучитьИдентификатор());

	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуВыбораВидаОперацииОсновная", ЭтотОбъект, Контекст);
	ОткрытьФорму("Справочник.упоВидыОпераций.ФормаВыбора", ПараметрыФормы, Элемент,,,, ОписаниеОповещения); 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЧасыВРасшифровке(ОсновнаяТаблица, ТаблицаРасшифровки)
	
	ИмяТабличногоПоля 	=  ОсновнаяТаблица.Имя;
	ТекущаяСтрока 		=  ОсновнаяТаблица.ТекущиеДанные;
	ТекущаяКолонка 		=  ОсновнаяТаблица.ТекущийЭлемент;
	
	ДеньНедели = СтрЗаменить(ТекущаяКолонка.Имя, ИмяТабличногоПоля, "");

	ТаблицаДляПоиска = ТаблицаРасшифровкаТрудозатрат;
	МассивНайденныхРасшифровок = ПолучитьСтрокиРасшифровкиПоОтбору(ЭтаФорма, ТаблицаДляПоиска, ИмяТабличногоПоля, ТекущаяСтрока, ДеньНедели);
	
	Если МассивНайденныхРасшифровок <> Неопределено И МассивНайденныхРасшифровок.Количество() > 0 Тогда
		ТекущаяСтрокаРасшифровка = МассивНайденныхРасшифровок[0];
		ТекущаяСтрокаРасшифровка.ИтогоПоСтроке = ОсновнаяТаблица.ТекущиеДанные[ДеньНедели];
		ОбновитьДанныеТабличнойЧасти(ОсновнаяТаблица);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВозможностьДобавленияРасшифровки(ТекущаяКолонка, ИмяТаблицы, Отказ)
	
	ДоступностьРасшифровки = Ложь;
	
	Если Объект.ИспользоватьРасшифровкуТрудозатрат Тогда
	
		ДеньНедели = СтрЗаменить(ТекущаяКолонка.Имя, ИмяТаблицы, "");
		
		СмещениеДаты = Неопределено;		
		Если СтруктураДниНедели.Свойство(ДеньНедели, СмещениеДаты) Тогда 
			
			Если ИмяТаблицы = "РабочиеЗадания" Или ИмяТаблицы = "ВнепроектныеЗадачи" Тогда								
				
				ДоступностьРасшифровки = ПроверитьПопаданиеВСрокЗадачи(Элементы[ИмяТаблицы].ТекущиеДанные, 
																		ДеньНедели, 
																		СмещениеДаты, 
																		Объект.ДеньНачалаНедели);
																		
			Иначе
				ДоступностьРасшифровки = Истина;
			КонецЕсли;		
			
		КонецЕсли;
		
	КонецЕсли;	
		
	Если Не ДоступностьРасшифровки Тогда
		ТекстСообщения = НСтр("ru = 'Для ввода расшифровки выделите ячейку с трудозатратами.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	КонецЕсли;	
			
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСтрокиРасшифровкиПоОтбору(ЭтаФорма, ТаблицаДляПоиска, ИмяТабличногоПоля, ТекущаяСтрока, Знач ДеньНедели,
	ОтборТабличнойЧасти = Неопределено, СтрокаСвойства = "")
	
	ЭтоСтраницаРабочиеЗадания = (ИмяТабличногоПоля = "РабочиеЗадания");
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтаФорма.СтруктураДниНедели.Свойство(ДеньНедели) = Неопределено Тогда
		ДеньНедели = "ДеньНеделиНеУказан";
	КонецЕсли;	
	
	Если ИмяТабличногоПоля = "РабочиеЗадания" Тогда
		
		СтрокаСвойства = "РабочееЗадание,РольРесурса, Подразделение, ДеньНедели, РазделУчета, Задание";
	
		ОтборТабличнойЧасти = Новый Структура(СтрокаСвойства,
												ТекущаяСтрока["РабочееЗадание"],
												ТекущаяСтрока["РольРесурса"],
												ТекущаяСтрока["Подразделение"],												
												ДеньНедели,
												ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача"),
												ТекущаяСтрока["Задание"]);
		
	ИначеЕсли ИмяТабличногоПоля = "ВнепроектныеЗадачи" Тогда
		
		СтрокаСвойства = "Задача,ДеньНедели, РазделУчета"; 
		
		ОтборТабличнойЧасти = Новый Структура(СтрокаСвойства,
												ТекущаяСтрока["Задача"],
												ДеньНедели,
												ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача"));
		
	ИначеЕсли ИмяТабличногоПоля = "ПотериВремени" Тогда
		
		СтрокаСвойства = "Причина,ДеньНедели,РазделУчета";
		ОтборТабличнойЧасти = Новый Структура(СтрокаСвойства,
												ТекущаяСтрока["Причина"],
												ДеньНедели,
												ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени"));		
	КонецЕсли;
	
	МассивНайденныхРасшифровок = ТаблицаДляПоиска.НайтиСтроки(ОтборТабличнойЧасти);
	
	Возврат МассивНайденныхРасшифровок;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДанныеТабличнойЧасти(Таблица)
	
	ИмяТаблицы 	=  Таблица.Имя;

	ТекущаяСтрока 		=  Таблица.ТекущиеДанные;
	ТекущаяКолонка 		=  Таблица.ТекущийЭлемент;
	ИмяКолонки = СтрЗаменить(ТекущаяКолонка.Имя, ИмяТаблицы, "");
	
	Отбор = Новый Структура;
	СтрокаСвойстваДляЗаполнения = "";
	
	ТаблицаДляПоиска = Объект.РасшифровкаТрудозатрат;
	МассивНайденныхРасшифровок = ПолучитьСтрокиРасшифровкиПоОтбору(ЭтаФорма, ТаблицаДляПоиска, ИмяТаблицы, ТекущаяСтрока, ИмяКолонки,
		Отбор, СтрокаСвойстваДляЗаполнения);
	
	Если МассивНайденныхРасшифровок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из МассивНайденныхРасшифровок Цикл
		Объект.РасшифровкаТрудозатрат.Удалить(Строка);
	КонецЦикла;	
	
	КоличествоЧасов = 0;
	
	Для Каждого Строка Из ТаблицаРасшифровкаТрудозатрат Цикл  		
		
		НоваяСтрока = Объект.РасшифровкаТрудозатрат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор, СтрокаСвойстваДляЗаполнения);
		
		КоличествоЧасов = КоличествоЧасов + Строка.ИтогоПоСтроке;
		
		ЗаполнитьЗначенияСвойств(Строка, НоваяСтрока);
		
	КонецЦикла;
	
	СделатьЯчейкуНедоступной = ?(ТаблицаРасшифровкаТрудозатрат.Количество() > 1, Истина, Ложь); 
	ТекущаяСтрока["ТолькоПросмотр" + ИмяКолонки] = СделатьЯчейкуНедоступной;
	
	ТекущаяСтрока[ИмяКолонки] = КоличествоЧасов; 
	ПересчитатьСтрокуТабличнойЧасти(ИмяТаблицы);
	
	Если НЕ НеПроверятьКоличествоРабочихЧасов Тогда
		ПроверитьНа24Часа(ТекущаяКолонка, Таблица);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтборРасшифровки(ТаблицаФормы)
	
	ТаблицаРасшифровкаТрудозатрат.Очистить(); 
	
	ИмяТабличногоПоля 	=  ТаблицаФормы.Имя;
	ТекущаяСтрока 		=  ТаблицаФормы.ТекущиеДанные;
	ТекущаяКолонка 		=  ТаблицаФормы.ТекущийЭлемент;
	
	Если ТекущаяКолонка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДеньНедели = СтрЗаменить(ТекущаяКолонка.Имя, ИмяТабличногоПоля, "");
	Если НЕ СтруктураДниНедели.Свойство(ДеньНедели) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДляПоиска = Объект.РасшифровкаТрудозатрат;
	МассивНайденныхРасшифровок = ПолучитьСтрокиРасшифровкиПоОтбору(ЭтаФорма, ТаблицаДляПоиска, ИмяТабличногоПоля, ТекущаяСтрока, ДеньНедели);
	
	Если МассивНайденныхРасшифровок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из МассивНайденныхРасшифровок Цикл
		НоваяСтрока = ТаблицаРасшифровкаТрудозатрат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРасшифровкиСтрокиТЧ(ИмяТабличногоПоля, ТекущаяСтрока)
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяТабличногоПоля = "РабочиеЗадания" Тогда
		
		ОтборТабличнойЧасти = Новый Структура("РабочееЗадание, РольРесурса, Подразделение, ДеньНедели, РазделУчета, Задание",
			ТекущаяСтрока["РабочееЗадание"], ТекущаяСтрока["РольРесурса"], ТекущаяСтрока["Подразделение"], ,
			ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача"), ТекущаяСтрока["Задание"]);
	
	ИначеЕсли ИмяТабличногоПоля = "ВнепроектныеЗадачи" Тогда
		
		ОтборТабличнойЧасти = Новый Структура("Задача,ДеньНедели,РазделУчета",
			ТекущаяСтрока["Задача"], , ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача"));
	ИначеЕсли ИмяТабличногоПоля = "ПотериВремени" Тогда
		
		ОтборТабличнойЧасти = Новый Структура("Причина,ДеньНедели,РазделУчета",
			ТекущаяСтрока["Причина"], , ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени"));
	КонецЕсли;
	
	Для Каждого мЭлементДеньНедели Из СтруктураДниНедели Цикл
		
		ОтборТабличнойЧасти.Вставить("ДеньНедели", мЭлементДеньНедели.Ключ);
		
		МассивНайденныхРасшифровок = Объект.РасшифровкаТрудозатрат.НайтиСтроки(ОтборТабличнойЧасти);
		
		// Нужно удалить расшифровку по этому дню
		Для каждого ЭлементНайденнаяРасшифровка Из МассивНайденныхРасшифровок Цикл
			Объект.РасшифровкаТрудозатрат.Удалить(ЭлементНайденнаяРасшифровка);
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНа24Часа(Элемент, Таблица)
	
	ИмяЭлемента = Элемент.Имя;

	ДеньНедели = СтрЗаменить(Элемент.Имя, Таблица.Имя, "");
	КоличествоЧасовДень = Объект.РабочиеЗадания.Итог(ДеньНедели) + Объект.ВнепроектныеЗадачи.Итог(ДеньНедели) 
		+ Объект.ПотериВремени.Итог(ДеньНедели);
	
	Если КоличествоЧасовДень > 24 Тогда
		ТекстСообщения = СтрЗаменить(НСтр("ru = 'За день недели ""%1"" введено больше 24 часов.'"), "%1", ДеньНедели);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	ЧасовВсего = Объект.РабочиеЗадания.Итог("ИтогоПоСтроке") + Объект.ВнепроектныеЗадачи.Итог("ИтогоПоСтроке") 
		+ Объект.ПотериВремени.Итог("ИтогоПоСтроке");
	Если ЧасовВсего > 168 Тогда
		ТекстСообщения = НСтр("ru = 'За неделю введено больше 168 часов.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРасшифровки()
	
	ИспользоватьРасшифровку = Объект.ИспользоватьРасшифровкуТрудозатрат 
		И константа_ИспользоватьРасшифровкуТрудозатратНаПроектныхЗадачах;
	
	Если константа_ИспользоватьРасшифровкуТрудозатратНаПроектныхЗадачах Тогда
		Элементы.КомандаИспользоватьРасшифровку.Пометка = ИспользоватьРасшифровку;
	Иначе
		Элементы.КомандаИспользоватьРасшифровку.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.РасшифровкаТрудозатратРабочиеЗадания.Видимость = ИспользоватьРасшифровку;
	Элементы.РасшифровкаТрудозатратВнепроектныеЗадачи.Видимость = ИспользоватьРасшифровку;
    Элементы.РасшифровкаТрудозатратПотериВремени.Видимость = ИспользоватьРасшифровку;
	Элементы.РабочиеЗаданияДобавить.Видимость = ИспользоватьРасшифровку;
	Элементы.РабочиеЗаданияУдалить.Видимость = ИспользоватьРасшифровку;
	Элементы.ВнепроектныеЗадачиДобавить.Видимость = ИспользоватьРасшифровку;
	Элементы.ВнепроектныеЗадачиУдалить.Видимость = ИспользоватьРасшифровку;
	Элементы.ПотериВремениДобавить.Видимость = ИспользоватьРасшифровку;
	Элементы.ПотериВремениУдалить.Видимость = ИспользоватьРасшифровку;
	
	ОпределитьВозможностьРедактированияЯчеек(ИспользоватьРасшифровку);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидОперацииПоЗадаче(Задача)
	
	Если Задача = Неопределено Тогда
		Возврат Справочники.упоВидыЗаданий.ПустаяСсылка();	
	КонецЕсли; 
		
	ВидОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Задача, "ВидОперации");
	
	Возврат ВидОперации;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Трудовые ресурсы

&НаСервере
Процедура ИнициализацияВыбораТрудовогоРесурса()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	РегТР.Ресурс
	               |ИЗ
	               |	РегистрСведений.упоВладениеРесурсами.СрезПоследних(
	               |			,
	               |			Сотрудник В
	               |				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					РегДС.Сотрудник КАК Сотрудник
	               |				ИЗ
	               |					РегистрСведений.упоДиспетчерыСистемы.СрезПоследних(, Пользователь = &ТекПользователь) КАК РегДС
	               |				ГДЕ
	               |					РегДС.ФлагУправления = ИСТИНА)) КАК РегТР
	               |ГДЕ
	               |	РегТР.ВладеетРесурсом = ИСТИНА";
	
	РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, Новый Структура("ТекПользователь", Пользователи.ТекущийПользователь()));
	СписокТР = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ресурс");
	
	СписокТрудовыхРесурсовПользователя.ЗагрузитьЗначения(СписокТР);
	СписокТрудовыхРесурсовПользователя.СортироватьПоЗначению();

КонецПроцедуры

&НаСервере
Функция ТрудовойРесурсПриИзмененииСервер() 
	
	ПроверитьСоответствиеТрудовогоРесурсаПриИзменении();

	ЗаполнитьПодразделение();

	Если ЗначениеЗаполнено(Объект.ТрудовойРесурс) Тогда
		ОбновитьСписокЗадач();
	КонецЕсли;	
	
КонецФункции

&НаСервере
Процедура ПроверитьСоответствиеТрудовогоРесурсаПриИзменении()

	Если Не ЗначениеЗаполнено(Объект.ТрудовойРесурс) Тогда
		Объект.РабочиеЗадания.Очистить();
		Возврат;
	КонецЕсли; 
	
	Если Не упоРесурсыИРолиСервер.РесурсУправляетсяТекущимПользователем(Объект.ТрудовойРесурс) Тогда
		ТекстСообщения = НСтр("ru = 'Текущий пользователь не является владельцем выбранного трудового ресурса ""%1"".'");
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, Объект.ТрудовойРесурс), , "Объект.ТрудовойРесурс");
		
		Объект.ТрудовойРесурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

