&НаКлиенте
Функция ПодготовитьДопПараметры(имяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	 		
	АдресХранилища = "";
	
	Если имяКоманды = "ВнепроектныеЗадачиПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец = Элементы.ВнепроектныеЗадачи;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоВнепроектныеЗадачи";
        ТаблицаФормы = Объект.ВнепроектныеЗадачи;
	    ИмяКолонки = "Задача";				
		
	ИначеЕсли имяКоманды = "ПотериВремениПодобрать" Тогда
			
		ПараметрыПодбора.ЭлементВладелец = Элементы.ПотериВремени;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоПричиныПотерьРабочегоВремени";
        ТаблицаФормы = Объект.ПотериВремени;
	    ИмяКолонки = "Причина";		
		
	КонецЕсли;
	
	АдресХранилища = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(ЭтаФорма.УникальныйИдентификатор,
		ТаблицаФормы, ИмяКолонки);
		
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = АдресХранилища;
	
	Возврат ПараметрыПодбора;
	
КонецФункции

