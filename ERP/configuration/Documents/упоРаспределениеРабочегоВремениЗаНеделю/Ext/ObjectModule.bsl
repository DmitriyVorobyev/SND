//                 продолжение описания параметра. 
//  Префикс      – Строка, префикс, который будет использоваться для генерации номера.
// 
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры

// Обработчик события ПриКопировании модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  ОбъектКопирования – ДокументОбъект, исходный документ, который является источником копирования. 
// 
Процедура ПриКопировании(ОбъектКопирования)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	
	ЭтотОбъект.РабочиеЗадания.Очистить();
	ЭтотОбъект.ВнепроектныеЗадачи.Очистить();
	ЭтотОбъект.ПотериВремени.Очистить();
	
КонецПроцедуры

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
//  РежимЗаписи  - РежимЗаписиДокумента, в параметр передается текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	ПроверятьРазграничениеДоступа = Не ((ЭтотОбъект.ДополнительныеСвойства.Свойство("НеПроверятьРазграничениеДоступа")
		И ЭтотОбъект.ДополнительныеСвойства.НеПроверятьРазграничениеДоступа
		Или ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтложенноеПроведение")));
		
	Если ПроверятьРазграничениеДоступа 
			И Не упоРесурсыИРолиСервер.РесурсУправляетсяТекущимПользователем(ТрудовойРесурс) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Текущий пользователь не является владельцем выбранного трудового ресурса ""%1"".'"),
			ТрудовойРесурс);
		Отказ = Истина;
	КонецЕсли; 
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект.Ссылка, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если Не Константы.упоИспользоватьРасшифровкуТрудозатратНаПроектныхЗадачах.Получить()
		И ИспользоватьРасшифровкуТрудозатрат Тогда
		ИспользоватьРасшифровкуТрудозатрат = Ложь;
	КонецЕсли;
	
	ЕдиницаНормирования = Справочники.упоЕдиницыВремени.Час;
	ДеньКонецНедели = КонецНедели(ДеньНачалаНедели);
	
	СвернутьТабличныеЧасти();
	
КонецПроцедуры

// Обработчик события ПриЗаписи модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
// 
Процедура ПриЗаписи(Отказ)
	
