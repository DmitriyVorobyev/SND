//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отмены проведения документа.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверятьКоличествоЧасов = НЕ Константы.упоОтключитьПроверкуКоличестваРабочихЧасов.Получить();
	
	Если ПроверятьКоличествоЧасов Тогда 
		
		МассивДниНедели = Новый Массив;
		МассивДниНедели.Добавить("Понедельник");
		МассивДниНедели.Добавить("Вторник");
		МассивДниНедели.Добавить("Среда");
		МассивДниНедели.Добавить("Четверг");
		МассивДниНедели.Добавить("Пятница");
		МассивДниНедели.Добавить("Суббота");
		МассивДниНедели.Добавить("Воскресенье");
		
		ПроверятьКоличествоЧасов = Константы.упоОтключитьПроверкуКоличестваРабочихЧасов.Получить();
		
		ВсегоЧасов = РабочиеЗадания.Итог("ИтогоПоСтроке") 
			+ ВнепроектныеЗадачи.Итог("ИтогоПоСтроке") 
			+ ПотериВремени.Итог("ИтогоПоСтроке");
		Если ВсегоЧасов > 168 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Неделя физически не может содержать более 168 рабочих часов." + Символы.ПС
				+ "Распределено в документе: " + ВсегоЧасов + " ч." + Символы.ПС + Символы.ПС
				+ "Необходимо проверить табличные части документа" + Символы.ПС + "и убрать лишние часы.";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Для Каждого ДеньНедели Из МассивДниНедели Цикл
			
			КоличествоЧасовДень = РабочиеЗадания.Итог(ДеньНедели) 
				+ ВнепроектныеЗадачи.Итог(ДеньНедели) 
				+ ПотериВремени.Итог(ДеньНедели);
			
			Если КоличествоЧасовДень > 24 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "За день недели """ + ДеньНедели + """ введено больше 24 часов!";
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьВидОперацииИзСвойствПЗ(СвойстваЗадачи, РазделыУчетаВидовОпераций, ВидОперацииПоУмолчанию)

	ВидОперации = ВидОперацииПоУмолчанию;
	Если СвойстваЗадачи <> Неопределено Тогда
		ВидОперацииЗадачи = СвойстваЗадачи.ВидОперации;
		РазделУчетаВидаОперации = РазделыУчетаВидовОпераций[ВидОперацииЗадачи];
		Если ЗначениеЗаполнено(РазделУчетаВидаОперации) Тогда
			ВидОперации	= ВидОперацииЗадачи;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВидОперации;
	
КонецФункции

Процедура ПроверитьВозможностьРаспределенияРабочегоВремени(Отказ)
	
	// Проведение в привилегированном режиме.
	// Для статусов остановлен отбираем дату статуса с конца недели, для запланирован/утвержден - с начала недели.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДеньНачалаНедели);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Запрос.Текст = ТекстЗапросаДатаСтатусаВКонцеНедели();
	ТЗ = Запрос.Выполнить().Выгрузить();   
	
	СотрудникТР = упоРесурсыИРолиВызовСервера.обПолучитьТекущегоВладельцаРесурса(ТрудовойРесурс);
	
	упоРаспределениеТрудозатратВызовСервера.ПроверитьВозможностьСписанияФактическихЗатратПоПроектамСУчетомСтатуса(
		ТЗ, СотрудникТР, "Остановлен", Отказ);
		
	Запрос.Текст = ТекстЗапросаДатаСтатусаВНачалеНедели();
	ТЗ = Запрос.Выполнить().Выгрузить(); 	
		
	упоРаспределениеТрудозатратВызовСервера.ПроверитьВозможностьСписанияФактическихЗатратПоПроектамСУчетомСтатуса(
		ТЗ, СотрудникТР, "ЗапланированУтвержден", Отказ);
	
	Если Константы.упоРазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПЗ = РабочиеЗадания.ВыгрузитьКолонку("РабочееЗадание");
	МассивЗаданий = РабочиеЗадания.ВыгрузитьКолонку("Задание");
	упоРаспределениеТрудозатратВызовСервера.ПроверитьВозможностьСписанияФактическихЗатратПоЗакрытымЗадачам(
		МассивПЗ,
		МассивЗаданий,
		Отказ);
		
КонецПроцедуры

Процедура ПроверитьРаспределениеРабочегоВремениТрудовогоРесурсаВДругихДокументах(Отказ)
	
	Если Константы.упоОтключитьПроверкуКоличестваРабочихЧасов.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	// Проведение в привилегированном режиме.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Ссылка.ДеньНачалаНедели КАК ДеньНачалаНедели,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Понедельник КАК Понедельник,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Вторник КАК Вторник,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Среда КАК Среда,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Четверг КАК Четверг,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Пятница КАК Пятница,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Суббота КАК Суббота,
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Воскресенье КАК Воскресенье
	|ПОМЕСТИТЬ ВсеТрудозатратыДокумента
	|ИЗ
	|	Документ.упоРаспределениеРабочегоВремениЗаНеделю.РабочиеЗадания КАК упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания
	|ГДЕ
	|	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Ссылка.ДеньНачалаНедели,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Понедельник,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Вторник,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Среда,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Четверг,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Пятница,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Суббота,
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Воскресенье
	|ИЗ
	|	Документ.упоРаспределениеРабочегоВремениЗаНеделю.ВнепроектныеЗадачи КАК упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи
	|ГДЕ
	|	упоРаспределениеРабочегоВремениЗаНеделюВнепроектныеЗадачи.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Ссылка.ДеньНачалаНедели,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Понедельник,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Вторник,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Среда,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Четверг,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Пятница,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Суббота,
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Воскресенье
	|ИЗ
	|	Документ.упоРаспределениеРабочегоВремениЗаНеделю.ПотериВремени КАК упоРаспределениеРабочегоВремениЗаНеделюПотериВремени
	|ГДЕ
	|	упоРаспределениеРабочегоВремениЗаНеделюПотериВремени.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
