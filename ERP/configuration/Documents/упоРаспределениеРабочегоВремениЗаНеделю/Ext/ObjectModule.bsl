// Контроль ввода данных за два периода (месяца).
//
// Параметры:
//	Отказ - Булево - признак отмены транзакции.
//
Процедура ВведеныДанныеЗаДваПериода(Отказ = Ложь) Экспорт

	Если НЕ Константы.упоРегистрироватьТрудозатратыПереходящейНеделиДвумяДокументами.Получить() 
		ИЛИ ПараметрыСеанса.упоОтключитьПроверкуОграничений Тогда
		
		Возврат;
		
	КонецЕсли;
	
	МесяцНачала = Месяц(ДеньНачалаНедели);
	МесяцКонец  = Месяц(ДеньКонецНедели);
	
	Если МесяцНачала = МесяцКонец Тогда
		// Ничего проверять не надо.
		Возврат;
	КонецЕсли;
	
	ТаблицаДней = ПолучитьТаблицуДней();
	
	РассчитатьТрудозатратыНаКаждыйДень(ТаблицаДней);
	
	РезультатСравненияПериодов = ПроверитьНаличиеДанныхВДвухПериодах(ТаблицаДней, МесяцКонец, МесяцНачала);
	
	Если РезультатСравненияПериодов.ДанныеЗаДваПериода Тогда
		
		Отказ = Истина;
		
		ТекстСообщения = НСтр("ru = 'В документе допускается ввод данных только за дни одного месяца.'");
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

