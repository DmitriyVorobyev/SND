// Сворачивает табличные части по ключевым реквизитам и
// рассчитывает итоговые показатели трудозатрат по разделам.
//
Процедура СвернутьТабличныеЧасти() Экспорт
	
	// Сворачиваем табличные части во избежание дублирования
	// записей регистра сведений по одному набору измерений.
	
	СтрокаСуммирования = "Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье,ИтогоПоСтроке";
	
	РабочиеЗадания.Свернуть("РабочееЗадание,Проект,ЭтоПроектнаяЗадача,РольРесурса,Подразделение,Задание", СтрокаСуммирования);
	ВнепроектныеЗадачи.Свернуть("Задача,Роль,Подразделение", СтрокаСуммирования);
	ПотериВремени.Свернуть("Причина", СтрокаСуммирования);
	
	// Рассчитываем итоговые трудозатраты по разделам.
	
	ИтогоРабочиеЗадания = РабочиеЗадания.Итог("ИтогоПоСтроке");
	ИтогоВнепроектныеЗадачи = ВнепроектныеЗадачи.Итог("ИтогоПоСтроке");
	ИтогоПотериВремени = ПотериВремени.Итог("ИтогоПоСтроке");
	
	ИтогоЧасов = ИтогоРабочиеЗадания + ИтогоВнепроектныеЗадачи + ИтогоПотериВремени;	

КонецПроцедуры

// Формирует итоговую таблицу по дням и разделам учета.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - сформированная итоговая таблица.
//
Функция ПолучитьИтоговуюТаблицу() Экспорт

	ТаблицаДанных = ВнепроектныеЗадачи.Выгрузить();
	ТаблицаДанных.Очистить();
	ТаблицаДанных.Колонки.Удалить("Задача");
	ТаблицаДанных.Колонки.Удалить("НомерСтроки");
	ТаблицаДанных.Колонки.Добавить("РазделУчета", Новый ОписаниеТипов("ПеречислениеСсылка.упоРазделУчетаРабочегоВремени"));
	
	// Перекачиваем данные из табличных частей по дням.
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача;
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл		
		Если Не Колонка.Имя = "РазделУчета" Тогда
			НоваяСтрока[Колонка.Имя] = ВнепроектныеЗадачи.Итог(Колонка.Имя);
		КонецЕсли; 		
	КонецЦикла; 
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача;
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл		
		Если Не Колонка.Имя = "РазделУчета" Тогда
			НоваяСтрока[Колонка.Имя] = РабочиеЗадания.Итог(Колонка.Имя);
		КонецЕсли; 		
	КонецЦикла; 
	
	НоваяСтрока = ТаблицаДанных.Добавить();
	НоваяСтрока.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени;
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл		
		Если Не Колонка.Имя = "РазделУчета" Тогда
			НоваяСтрока[Колонка.Имя] = ПотериВремени.Итог(Колонка.Имя);
		КонецЕсли; 		
	КонецЦикла; 
	
	Возврат ТаблицаДанных;

КонецФункции

// Функция формирует структуру обязательных реквизитов шапки или заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	Если ИмяТабличнойЧасти = Неопределено Тогда
		СтруктураОбязательныхПолей.Вставить("ТрудовойРесурс");
		СтруктураОбязательныхПолей.Вставить("ДеньНачалаНедели");
	ИначеЕсли ИмяТабличнойЧасти = "РабочиеЗадания" Тогда		
		СтруктураОбязательныхПолей.Вставить("Проект");
		СтруктураОбязательныхПолей.Вставить("РабочееЗадание");
		СтруктураОбязательныхПолей.Вставить("РольРесурса");
	ИначеЕсли ИмяТабличнойЧасти = "ВнепроектныеЗадачи" Тогда		
		СтруктураОбязательныхПолей.Вставить("Задача");
	ИначеЕсли ИмяТабличнойЧасти = "ПотериВремени" Тогда		
		СтруктураОбязательныхПолей.Вставить("Причина");
	КонецЕсли;
	                                        
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

