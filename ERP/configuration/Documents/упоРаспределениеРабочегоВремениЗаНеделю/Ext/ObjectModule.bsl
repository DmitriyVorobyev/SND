	|		ПО (ТрудозатратыВБазеСРегистратором.День = ИтоговаяТаблица.День)
	|
	|УПОРЯДОЧИТЬ ПО
	|	День";
	
	Запрос.УстановитьПараметр("НачалоНедели", ДеньНачалаНедели);
	Запрос.УстановитьПараметр("ОкончаниеНедели", ДеньКонецНедели);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ТрудовойРесурс", ТрудовойРесурс);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	упоРаспределениеТрудозатратВызовСервера.СообщитьОбОшибкахПроверкиПриПроведении(РезультатЗапроса, ТрудовойРесурс);
	
КонецПроцедуры

// Назначение процедуры понятно из названия
Процедура ДобавитьДвижениеВРегистрыФактаТрудозатрат(ФактТрудозатратПоДням, СтрокаЗадача, ПараметрыДанных)
	
	УровеньПланирования 			= ПараметрыДанных.УровеньПланирования;
	РабочийДень 					= ПараметрыДанных.РабочийДень;
	ТрудозатратыДня 				= ПараметрыДанных.ТрудозатратыДня;
	СтрокиНормыСтоимостиПоРоли 		= ПараметрыДанных.СтрокиНормыСтоимостиПоРоли;
	СтрокиНормыСтоимостиПоУровню	= ПараметрыДанных.СтрокиНормыСтоимостиПоУровню;
	ДатаИзмененияНормы 				= ПараметрыДанных.ДатаИзмененияНормы;
	ИтогоНормаСтоимостиПоПериоду	= ПараметрыДанных.ИтогоНормаСтоимостиПоПериоду;
	ТрудовойРесурс 					= ПараметрыДанных.ТрудовойРесурс;		
	
	СтоимостьЧаса = 0;
        
	Движение = ФактТрудозатратПоДням.Добавить();			
	
	Движение.Операция 			= СтрокаЗадача.РабочееЗадание;			
	Движение.Задание 			= СтрокаЗадача.Задание;			
	Движение.Подразделение 		= СтрокаЗадача.Подразделение;			
	Движение.День 				= РабочийДень;
	Движение.УровеньПланирования = УровеньПланирования;			
	Движение.Трудозатраты 		= ТрудозатратыДня;	
	Если УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный Тогда
		Движение.Роль 			= СтрокаЗадача.РольРесурса;
		Движение.Ресурс 		= ТрудовойРесурс;			    
	Иначе // Предварительный.
		Движение.Ресурс 		= СтрокаЗадача.РольРесурса;			    
	КонецЕсли;	
	Движение.ВидОперации 		= ПараметрыДанных.ВидОперации;			
	
	Если ПараметрыДанных.ЕстьСтрокаНормы Тогда
		
		Если УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный Тогда
			
			// Пробуем найти стоимость по норме роли на текущий день.
			Если ПараметрыДанных.ДатаИзмененияНормы <= НачалоДня(РабочийДень) Тогда
				СтоимостьЧаса = упоРаспределениеТрудозатратВызовСервера.НайтиСтоимостьПоНормеЗаДень(СтрокиНормыСтоимостиПоРоли, 
																									РабочийДень);
			КонецЕсли;
			
			Движение.Стоимость = ТрудозатратыДня * СтоимостьЧаса;
			ПараметрыДанных.ИтогоНормаСтоимостиПоПериоду = ИтогоНормаСтоимостиПоПериоду + Движение.Стоимость;
			
		КонецЕсли;
		
	Иначе
		
		// Найдем стоимость по норме трудового ресурса в текущий день.
		Если ПараметрыДанных.ДатаИзмененияНормы <= НачалоДня(РабочийДень) Тогда
			СтоимостьЧаса = упоРаспределениеТрудозатратВызовСервера.НайтиСтоимостьПоНормеЗаДень(СтрокиНормыСтоимостиПоУровню, 
																								РабочийДень, 
																								ДатаИзмененияНормы);
		КонецЕсли;
		
		// Пробуем найти стоимость по норме роли на текущий день.
		Если СтоимостьЧаса = 0 Тогда
			СтоимостьЧаса = упоРаспределениеТрудозатратВызовСервера.НайтиСтоимостьПоНормеЗаДень(СтрокиНормыСтоимостиПоРоли, 
																								РабочийДень);
		КонецЕсли;
		
		Движение.Стоимость = ТрудозатратыДня * СтоимостьЧаса;
		ПараметрыДанных.ИтогоНормаСтоимостиПоПериоду = ИтогоНормаСтоимостиПоПериоду + Движение.Стоимость;					
		
    КонецЕсли;
		
КонецПроцедуры

// Назначение функции понятно из названия
Функция ИменаКолонокДляСворачивания(РасшифровкаТрудозатрат)
	
	мсИменКолонок = Новый Массив;
	
	Для Каждого тКолонка Из РасшифровкаТрудозатрат.Колонки Цикл
		Если тКолонка.Имя = "НомерСтроки" ИЛИ тКолонка.Имя = "ИтогоПоСтроке" ИЛИ тКолонка.Имя = "Расшифровка" Тогда
			Продолжить;
		КонецЕсли;
		мсИменКолонок.Добавить(тКолонка.Имя);
	КонецЦикла;
	
	Возврат СтрСоединить(мсИменКолонок, ", ");
		
КонецФункции	

Процедура ЗаполнитьДвиженияПоФактуТрудозатратСводно(ДанныеДвижений)

	КолонкиДляКопирования = "Операция, Ресурс, Роль, Подразделение, УровеньПланирования, ВидОперации, Задание, 
		|Трудозатраты, Стоимость";
	ФактТрудозатратСводно = ДанныеДвижений.упоФактТрудозатратПоДням.Скопировать(, КолонкиДляКопирования);	
	КолонкаОперация = ФактТрудозатратСводно.Колонки.Найти("Операция");
	КолонкаОперация.Имя = "ПроектнаяЗадача";
	КолонкаОперация = ФактТрудозатратСводно.Колонки.Найти("Трудозатраты");
	КолонкаОперация.Имя = "КоличествоЧасов";
	
	упоФункцииОбщегоНазначенияСервер.СвернутьТаблицуДвижений(ФактТрудозатратСводно, "упоФактТрудозатратСводно");
	
	ДанныеДвижений.упоФактТрудозатратСводно = ФактТрудозатратСводно;	
	
КонецПроцедуры

// Возвращает структурированную таблицу значений с днями недели.
//
// Возвращаемое значение:
// ТаблицаЗначений:
//		* ИмяДня - Строка - Имя дня недели.
//		* Смещение - Число - Смещение по количеству дней с начала недели.
//		* Трудозатраты - Число - Количество часов за текущий день.
//
Функция ПолучитьТаблицуДней() Экспорт
	
	ТаблицаДней = Новый ТаблицаЗначений();
	ТаблицаДней.Колонки.Добавить("ИмяДня");
	ТаблицаДней.Колонки.Добавить("Смещение");
	ТаблицаДней.Колонки.Добавить("Трудозатраты", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 2)));
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Понедельник";
	СтрокаДня.Смещение = 0;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Вторник";
	СтрокаДня.Смещение = 1;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Среда";
	СтрокаДня.Смещение = 2;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Четверг";
	СтрокаДня.Смещение = 3;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Пятница";
	СтрокаДня.Смещение = 4;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Суббота";
	СтрокаДня.Смещение = 5;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Воскресенье";
	СтрокаДня.Смещение = 6;
	
	Возврат ТаблицаДней;
	
КонецФункции

// Процедура выполняет расчет по всем строкам всех табличных частей в разрезе дней недели.
//
// Параметры:
//  ТаблицаДней	 - ТаблицаЗначений:
//		* ИмяДня		- Строка	- Имя дня недели.
//		* Смещение		- Число		- Смещение по количеству дней с начала недели.
//		* Трудозатраты 	- Число		- Количество часов за текущий день.
//
Процедура РассчитатьТрудозатратыНаКаждыйДень(ТаблицаДней) Экспорт
	
	Для Каждого СтрокаДанных Из РабочиеЗадания Цикл
		
		Для Каждого СтрокаДень Из ТаблицаДней Цикл
			
			СтрокаДень.Трудозатраты = СтрокаДень.Трудозатраты + СтрокаДанных[СтрокаДень.ИмяДня];
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ВнепроектныеЗадачи Цикл
		
		Для Каждого СтрокаДень Из ТаблицаДней Цикл
			
			СтрокаДень.Трудозатраты = СтрокаДень.Трудозатраты + СтрокаДанных[СтрокаДень.ИмяДня];
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаДанных Из ПотериВремени Цикл
		
		Для Каждого СтрокаДень Из ТаблицаДней Цикл
			
			СтрокаДень.Трудозатраты = СтрокаДень.Трудозатраты + СтрокаДанных[СтрокаДень.ИмяДня];
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция выполняет раздельный расчет трудозатрат за каждый период.
//
// Параметры:
//  ТаблицаДней  - ТаблицаЗначений:
//		* ИмяДня		- Строка	- Имя дня недели.
//		* Смещение		- Число		- Смещение по количеству дней с начала недели.
//		* Трудозатраты 	- Число		- Количество часов за текущий день.
//  МесяцКонец	 - Число - Конечный месяц переходящей недели.
//  МесяцНачала	 - Число - Начальный месяц переходящей недели.
//
// Возвращаемое значение:
// 	Структура:
//	 * ДанныеЗаДваПериода - Булево - Наличие данных в двух периодах.
//	 * ТрудозатратыНачальногоПериода - Число - Трудозатраты раннего месяца переходящего периода.
//	 * ТрудозатратыКонечногоПериода - Число - Трудозатраты конечного месяца переходящего периода.
//
Функция ПроверитьНаличиеДанныхВДвухПериодах(ТаблицаДней, МесяцКонец, МесяцНачала) Экспорт
	
	чТрудозатратыМесяцНачала = 0;
	чТрудозатратыМесяцКонец = 0;
	Результат = Новый Структура;
	
	Для Каждого СтрокаДень Из ТаблицаДней Цикл
		
		РабочийДень = НачалоДня(ДеньНачалаНедели) + 86400 * СтрокаДень.Смещение;
		
		чТрудозатратыМесяцНачала = чТрудозатратыМесяцНачала + ?(МесяцНачала = Месяц(РабочийДень), СтрокаДень.Трудозатраты, 0);
		чТрудозатратыМесяцКонец = чТрудозатратыМесяцКонец + ?(МесяцКонец = Месяц(РабочийДень), СтрокаДень.Трудозатраты, 0);
		
	КонецЦикла;
	
	ДанныеЗаДваПериода = чТрудозатратыМесяцНачала <> 0 И чТрудозатратыМесяцКонец <> 0;
	
	Результат.Вставить("ТрудозатратыНачальногоПериода", чТрудозатратыМесяцНачала);
	Результат.Вставить("ТрудозатратыКонечногоПериода", чТрудозатратыМесяцКонец);
	Результат.Вставить("ДанныеЗаДваПериода", ДанныеЗаДваПериода);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаДатаСтатусаВНачалеНедели()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Проект КАК Проект,
	               |	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.РабочееЗадание КАК ПроектнаяЗадача,
	               |	ВЫБОР
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Понедельник > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(&ДатаНачала, ДЕНЬ)
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Вторник > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, 1), ДЕНЬ)
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Среда > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, 2), ДЕНЬ)
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Четверг > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, 3), ДЕНЬ)
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Пятница > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, 4), ДЕНЬ)
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Суббота > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, 5), ДЕНЬ)
	               |		КОГДА упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Воскресенье > 0
	               |			ТОГДА КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, 6), ДЕНЬ)
	               |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	               |	КОНЕЦ КАК ДатаСтатуса
	               |ИЗ
	               |	Документ.упоРаспределениеРабочегоВремениЗаНеделю.РабочиеЗадания КАК упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания
	               |ГДЕ
	               |	упоРаспределениеРабочегоВремениЗаНеделюРабочиеЗадания.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

