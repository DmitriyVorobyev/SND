					ПараметрыДанных.Вставить("ТрудозатратыДня", 	ТрудозатратыДня);
					ПараметрыДанных.Вставить("ЕстьСтрокаНормы", 	СтрокаНормыПоОкончательномуУровню = Неопределено);
