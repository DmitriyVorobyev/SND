// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	ПравилаНаложения = Новый Структура();
	
	// Для этого документа реализовано ручное управление движениями.
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактТрудозатратСводно.Метаданные().Имя, Правила);
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактТрудозатратПоДням.Метаданные().Имя, Правила);
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоИспользованиеРабочегоВремени.Метаданные().Имя, Правила);
	
	Возврат ПравилаНаложения; 

КонецФункции

// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт

	ТаблицаДней = Новый ТаблицаЗначений();
	ТаблицаДней.Колонки.Добавить("ИмяДня");
	ТаблицаДней.Колонки.Добавить("Смещение");
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Понедельник";
	СтрокаДня.Смещение = 0;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Вторник";
	СтрокаДня.Смещение = 1;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Среда";
	СтрокаДня.Смещение = 2;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Четверг";
	СтрокаДня.Смещение = 3;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Пятница";
	СтрокаДня.Смещение = 4;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Суббота";
	СтрокаДня.Смещение = 5;
	
	СтрокаДня = ТаблицаДней.Добавить();
	СтрокаДня.ИмяДня = "Воскресенье";
	СтрокаДня.Смещение = 6;
	
	// Вначале формируем движения по табличным частям, данные которых
	// не связаны с проектами.
	
	Для Каждого СтрокаДанных Из ДанныеДокумента.ВнепроектныеЗадачи Цикл		
		
		Для Каждого СтрокаДень Из ТаблицаДней Цикл
			
			ТрудозатратыДня = СтрокаДанных[СтрокаДень.ИмяДня];
			РабочийДень = НачалоДня(ДанныеДокумента.ДеньНачалаНедели) + 86400 * СтрокаДень.Смещение;
			
			Если ТрудозатратыДня = 0 Тогда
				Продолжить;
			КонецЕсли;			
			
			Если ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда 
				ОтборПоискРасшифровок = Новый Структура();
				ОтборПоискРасшифровок.Вставить("Задача", СтрокаДанных.Задача);
				ОтборПоискРасшифровок.Вставить("ДеньНедели", СтрокаДень.ИмяДня);
				
				СтрокиРасшифровки = ДанныеДокумента.РасшифровкаТрудозатрат.НайтиСтроки(ОтборПоискРасшифровок);
				
				// По проектнойЗадаче нет расшифровок.
				Если СтрокиРасшифровки.Количество() = 0 Тогда 
					ПроведениеБезРасшифровки = Истина;
				Иначе 
					СуммаЗаДеньПоВсемРасшифровкам = 0;
					Для Каждого ЭлементРасшифровки Из СтрокиРасшифровки Цикл
						Если ЭлементРасшифровки.ДеньНедели = СтрокаДень.ИмяДня Тогда
							СуммаЗаДеньПоВсемРасшифровкам = СуммаЗаДеньПоВсемРасшифровкам + ЭлементРасшифровки.ИтогоПоСтроке;
						КонецЕсли;
					КонецЦикла;
					Если СуммаЗаДеньПоВсемРасшифровкам > 0 Тогда 
						ПроведениеБезРасшифровки = Ложь;
					Иначе	                           
						ПроведениеБезРасшифровки = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ВидОперацииПроектнойЗадачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДанных.Задача, "ВидОперации");
			Если ЗначениеЗаполнено(ВидОперацииПроектнойЗадачи) Тогда
				ВидОперации = ВидОперацииПроектнойЗадачи;
			Иначе
				ВидОперации = Справочники.упоВидыОпераций.Явка;
			КонецЕсли; 
			
			Подразделение = ?(ЗначениеЗаполнено(СтрокаДанных.Подразделение), СтрокаДанных.Подразделение, ДанныеДокумента.Подразделение);
			
			Если Не ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда
				
				Движение = ДанныеДвижений.упоИспользованиеРабочегоВремени.Добавить();
				Движение.ТрудовойРесурс = ДанныеДокумента.ТрудовойРесурс;
				Движение.Подразделение = Подразделение;
				Движение.ВидОперации = ВидОперации;				
				Движение.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача;
				Движение.ЗадачаПричина = СтрокаДанных.Задача;
				Если ТипЗнч(СтрокаДанных.Задача) = Тип("СправочникСсылка.упоЗадания") Тогда
					Движение.Задание = СтрокаДанных.Задача;	
					Движение.РольРесурса = СтрокаДанных.Роль;
				КонецЕсли;
				Движение.День = РабочийДень;
				Движение.РасшифровкаТрудозатрат = "БезРасшифровки";
				Движение.Трудозатраты = ТрудозатратыДня;	
				
			Иначе
				
				Если ПроведениеБезРасшифровки Тогда  
					
					Движение = ДанныеДвижений.упоИспользованиеРабочегоВремени.Добавить();
					Движение.ТрудовойРесурс = ДанныеДокумента.ТрудовойРесурс;
					Движение.Подразделение = Подразделение;
					Движение.ВидОперации = ВидОперации;
					Движение.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача;
					Движение.ЗадачаПричина = СтрокаДанных.Задача;
					Если ТипЗнч(СтрокаДанных.Задача) = Тип("СправочникСсылка.упоЗадания") Тогда
						Движение.Задание = СтрокаДанных.Задача;	
						Движение.РольРесурса = СтрокаДанных.Роль;	
					КонецЕсли;
					Движение.День = РабочийДень;
					Движение.РасшифровкаТрудозатрат = "БезРасшифровки";
					Движение.Трудозатраты = ТрудозатратыДня;	
					
				Иначе 
					
					Для Каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
						
						Движение = ДанныеДвижений.упоИспользованиеРабочегоВремени.Добавить();
						Движение.ТрудовойРесурс = ДанныеДокумента.ТрудовойРесурс;
						Движение.Подразделение = Подразделение;
						Движение.ВидОперации = СтрокаРасшифровки.ВидОперации;
						Движение.РольРесурса = ?(ЗначениеЗаполнено(СтрокаРасшифровки.РольРесурса), СтрокаРасшифровки.РольРесурса,
							СтрокаДанных.Роль);
						Движение.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача;
						Движение.ЗадачаПричина = СтрокаРасшифровки.Задача;
						Если ТипЗнч(СтрокаДанных.Задача) = Тип("СправочникСсылка.упоЗадания") Тогда
							Движение.Задание = СтрокаДанных.Задача;	
						КонецЕсли;
						Движение.РасшифровкаТрудозатрат = СтрокаРасшифровки.Расшифровка;
						Движение.День = РабочийДень;
						Движение.Трудозатраты = СтрокаРасшифровки.ИтогоПоСтроке;	
						
					КонецЦикла;  
					
				КонецЕсли; 			
			КонецЕсли; 			
			
		КонецЦикла; 				
	КонецЦикла; 
	
	// Потеря времени.
	
	Для Каждого СтрокаДанных Из ДанныеДокумента.ПотериВремени Цикл		
		
		Для Каждого СтрокаДень Из ТаблицаДней Цикл
			
			ТрудозатратыДня = СтрокаДанных[СтрокаДень.ИмяДня];
			РабочийДень = НачалоДня(ДанныеДокумента.ДеньНачалаНедели) + 86400 * СтрокаДень.Смещение;
			
			Если ТрудозатратыДня = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			Если ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда 
				
				ОтборПоискРасшифровок = Новый Структура();
				ОтборПоискРасшифровок.Вставить("Причина", СтрокаДанных.Причина);
				ОтборПоискРасшифровок.Вставить("ДеньНедели", СтрокаДень.ИмяДня);
				
				СтрокиРасшифровки = ДанныеДокумента.РасшифровкаТрудозатрат.НайтиСтроки(ОтборПоискРасшифровок);
				
				// По проектнойЗадаче нет расшифровок.
				Если СтрокиРасшифровки.Количество() = 0  Тогда 
					ПроведениеБезРасшифровки = Истина;
				Иначе 
					СуммаЗаДеньПоВсемРасшифровкам = 0;
					Для Каждого ЭлементРасшифровки Из СтрокиРасшифровки Цикл
						Если ЭлементРасшифровки.ДеньНедели = СтрокаДень.ИмяДня Тогда
							СуммаЗаДеньПоВсемРасшифровкам = СуммаЗаДеньПоВсемРасшифровкам + ЭлементРасшифровки.ИтогоПоСтроке;
						КонецЕсли;
					КонецЦикла;
					Если СуммаЗаДеньПоВсемРасшифровкам > 0 Тогда 
						ПроведениеБезРасшифровки = Ложь;
					Иначе	                           
						ПроведениеБезРасшифровки = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ВидОперацииПричины = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДанных.Причина, "ВидОперации");
			Если ЗначениеЗаполнено(ВидОперацииПричины) Тогда
				ВидОперации = ВидОперацииПричины;
			Иначе
				ВидОперации = Справочники.упоВидыОпераций.ПотеряВремени;
			КонецЕсли;
			
			Если Не ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда                       			
				
				Движение = ДанныеДвижений.упоИспользованиеРабочегоВремени.Добавить();
				Движение.ТрудовойРесурс = ДанныеДокумента.ТрудовойРесурс;
				Движение.Подразделение = ДанныеДокумента.Подразделение;
				Движение.ВидОперации = ВидОперации;				
				Движение.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени;
				Движение.ЗадачаПричина = СтрокаДанных.Причина;
				Движение.День = РабочийДень;
				Движение.РасшифровкаТрудозатрат = "БезРасшифровки";
				Движение.Трудозатраты = ТрудозатратыДня;	
				
			Иначе
				
				Если ПроведениеБезРасшифровки Тогда  
						
					Движение = ДанныеДвижений.упоИспользованиеРабочегоВремени.Добавить();
					Движение.ТрудовойРесурс = ДанныеДокумента.ТрудовойРесурс;
					Движение.Подразделение = ДанныеДокумента.Подразделение;
					Движение.ВидОперации = ВидОперации;
					Движение.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени;
					Движение.ЗадачаПричина = СтрокаДанных.Причина;
					Движение.День = РабочийДень;
					Движение.РасшифровкаТрудозатрат = "БезРасшифровки";
					Движение.Трудозатраты = ТрудозатратыДня;	
					
				Иначе 
					
					Для Каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
						
						Движение = ДанныеДвижений.упоИспользованиеРабочегоВремени.Добавить();
						Движение.ТрудовойРесурс = ДанныеДокумента.ТрудовойРесурс;
						Движение.Подразделение = ДанныеДокумента.Подразделение;
						Движение.ВидОперации = СтрокаРасшифровки.ВидОперации;	
						Движение.РольРесурса = СтрокаРасшифровки.РольРесурса;	
						Движение.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени;
						Движение.ЗадачаПричина = СтрокаРасшифровки.Причина;
						Движение.РасшифровкаТрудозатрат = СтрокаРасшифровки.Расшифровка;
						Движение.День = РабочийДень;
						Движение.Трудозатраты = СтрокаРасшифровки.ИтогоПоСтроке;	
						
					КонецЦикла;  
				КонецЕсли; 
			КонецЕсли; 			
		КонецЦикла; 				
	КонецЦикла; 
	
	// Формируем список рабочих заданий, по которым
	// пользователь ввел ненулевые трудозатраты.
		
	СписокРабочихЗаданий = Новый СписокЗначений();	
	СписокНормСтоимости = Новый СписокЗначений();
	СоответствиеСтруктурНастроекПроектов = Новый Соответствие;
	СписокРолейИТрудовыхРесурсовПоПериоду = Новый СписокЗначений();
	
	Для Каждого СтрокаЗадача Из ДанныеДокумента.РабочиеЗадания Цикл
		
		НеПустаяСтрока = СтрокаЗадача.Понедельник Или СтрокаЗадача.Вторник Или 
		СтрокаЗадача.Среда Или СтрокаЗадача.Четверг Или СтрокаЗадача.Пятница Или 
		СтрокаЗадача.Суббота Или СтрокаЗадача.Воскресенье;
		
		Если НеПустаяСтрока Тогда 
			
			СписокРабочихЗаданий.Добавить(СтрокаЗадача.РабочееЗадание);
			
			СтруктураНастроекПроекта = СоответствиеСтруктурНастроекПроектов.Получить(СтрокаЗадача.Проект);
			Если СтруктураНастроекПроекта = Неопределено Тогда
				СтруктураНастроекПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(СтрокаЗадача.Проект);
				СоответствиеСтруктурНастроекПроектов.Вставить(СтрокаЗадача.Проект, СтруктураНастроекПроекта);
			КонецЕсли;
            
            СписокРолейИТрудовыхРесурсовПоПериоду.Добавить(ТрудовойРесурс);
            СписокРолейИТрудовыхРесурсовПоПериоду.Добавить(СтрокаЗадача.РольРесурса);             
			
		КонецЕсли; 
	КонецЦикла; 
	
	Если СписокРабочихЗаданий.Количество() = 0 Тогда      
		Возврат;
	КонецЕсли;
	
	СвойстваПроектныхЗадач = упоПроектыИЗадачиСервер.ПолучитьСвойстваПроектныхЗадач(СписокРабочихЗаданий.ВыгрузитьЗначения(), 
															"ВидОперации, НормаСтоимостиТрудовыхРесурсов");
	
	ВидыОпераций = Новый Массив;
	Для Каждого КлючЗначение Из СвойстваПроектныхЗадач Цикл
		СписокНормСтоимости.Добавить(КлючЗначение.Значение.НормаСтоимостиТрудовыхРесурсов);
		ВидыОпераций.Добавить(КлючЗначение.Значение.ВидОперации);
	КонецЦикла;
	
	РазделыУчетаВидовОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ВидыОпераций, "РазделУчета", Истина);
	
	Если СписокРолейИТрудовыхРесурсовПоПериоду.Количество() > 0 Тогда
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	                        |	РегНормы.Ресурс КАК Ресурс,
	                        |	РегНормы.Норма КАК Норма,
	                        |	РегНормы.ЕдиницаНормирования КАК ЕдиницаНормирования,
	                        |	РегНормы.ЕдСтоимость КАК СтоимостьЕдиницы,
	                        |	ВЫБОР
	                        |		КОГДА ВЫРАЗИТЬ(РегНормы.ЕдиницаНормирования КАК Справочник.упоЕдиницыВремени) ЕСТЬ NULL
	                        |			ТОГДА 0
	                        |		ИНАЧЕ ВЫБОР
	                        |				КОГДА РегНормы.ЕдиницаНормирования ЕСТЬ NULL
	                        |					ТОГДА 0
	                        |				ИНАЧЕ ВЫБОР
	                        |						КОГДА РегНормы.ЕдиницаНормирования.Коэффициент > 0
	                        |							ТОГДА РегНормы.ЕдСтоимость / РегНормы.ЕдиницаНормирования.Коэффициент
	                        |						ИНАЧЕ 0
	                        |					КОНЕЦ
	                        |			КОНЕЦ
	                        |	КОНЕЦ КАК СтоимостьЧаса,
	                        |	НАЧАЛОПЕРИОДА(РегНормы.Период, ДЕНЬ) КАК ПериодНачала
	                        |ПОМЕСТИТЬ ВТ_РегНормы
	                        |ИЗ
	                        |	РегистрСведений.упоНормыСтоимостиРесурсов КАК РегНормы
	                        |ГДЕ
	                        |	ВЫБОР
	                        |		КОГДА  &МаксимальнаяДата = ДАТАВРЕМЯ(1, 1, 1)
	                        |			ТОГДА ИСТИНА
	                        |		ИНАЧЕ РегНормы.Период <= &МаксимальнаяДата
	                        |	КОНЕЦ
	                        |	И РегНормы.Норма В(&СписокНорм)
	                        |	И РегНормы.Ресурс В(&СписокРесурсов)
	                        |;
	                        |
	                        |////////////////////////////////////////////////////////////////////////////////
	                        |ВЫБРАТЬ
	                        |	ВТ_РегНормы.Ресурс КАК Ресурс,
	                        |	ВТ_РегНормы.Норма КАК Норма,
	                        |	ВТ_РегНормы.ЕдиницаНормирования КАК ЕдиницаНормирования,
	                        |	ВТ_РегНормы.СтоимостьЕдиницы КАК СтоимостьЕдиницы,
	                        |	ВТ_РегНормы.СтоимостьЧаса КАК СтоимостьЧаса,
	                        |	ВТ_РегНормы.ПериодНачала КАК ПериодНачала,
	                        |	МИНИМУМ(ЕСТЬNULL(ВТ_РегНормы1.ПериодНачала, &МаксимальнаяДата)) КАК ПериодОкончания
	                        |ИЗ
	                        |	ВТ_РегНормы КАК ВТ_РегНормы
	                        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РегНормы КАК ВТ_РегНормы1
	                        |		ПО ВТ_РегНормы.Ресурс = ВТ_РегНормы1.Ресурс
	                        |			И ВТ_РегНормы.Норма = ВТ_РегНормы1.Норма
	                        |			И ВТ_РегНормы.ПериодНачала < ВТ_РегНормы1.ПериодНачала
	                        |
	                        |СГРУППИРОВАТЬ ПО
	                        |	ВТ_РегНормы.Норма,
	                        |	ВТ_РегНормы.Ресурс,
	                        |	ВТ_РегНормы.ЕдиницаНормирования,
	                        |	ВТ_РегНормы.ПериодНачала,
	                        |	ВТ_РегНормы.СтоимостьЕдиницы,
	                        |	ВТ_РегНормы.СтоимостьЧаса";

		ПараметрыЗапроса = Новый Структура();
		ПараметрыЗапроса.Вставить("СписокНорм", СписокНормСтоимости.ВыгрузитьЗначения());
		ПараметрыЗапроса.Вставить("СписокРесурсов", СписокРолейИТрудовыхРесурсовПоПериоду.ВыгрузитьЗначения());
		ПараметрыЗапроса.Вставить("ДатаДок", упоРабочиеКалендариВызовСервера.обПолучитьМоментВремениДокумента(ЭтотОбъект));
		ПараметрыЗапроса.Вставить("МаксимальнаяДата", КонецДня(ДеньКонецНедели));
		
		РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
		ТаблицаНормСтоимостиПоПериоду = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	ИспользоватьСтавкуТрудовогоРесурсаДляПредварительного = Константы.упоИспользоватьСтавкуТрудовогоРесурсаПриРасчетеСтоимостиТрудозатрат.Получить();	
	
	Если ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда 
		тзРасшифровкаТрудозатрат = ДанныеДокумента.РасшифровкаТрудозатрат.Скопировать();
		ИменаКолонок = ИменаКолонокДляСворачивания(тзРасшифровкаТрудозатрат);
		тзРасшифровкаТрудозатрат.Свернуть(ИменаКолонок, "ИтогоПоСтроке");
	КонецЕсли;
	
	// Перебираем рабочие задания из табличной части и для каждого
	// формируем свой набор движений, в зависимости от контекста.
	
	ТаблицаФактТрудозатратПоДням = 
		упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру("упоФактТрудозатратПоДням", "День,Стоимость,Период");
	ВидОперацииЯвка = Справочники.упоВидыОпераций.Явка;
	Для Каждого СтрокаЗадача Из ДанныеДокумента.РабочиеЗадания Цикл
		   
		ПустаяСтрока = СтрокаЗадача.Понедельник Или	СтрокаЗадача.Вторник Или 
		СтрокаЗадача.Среда Или СтрокаЗадача.Четверг Или СтрокаЗадача.Пятница Или 
		СтрокаЗадача.Суббота Или СтрокаЗадача.Воскресенье;
		
		Если Не ПустаяСтрока Тогда 
			Продолжить;
		КонецЕсли; 
		
		// Норма стоимости зависит от типа записи - рабочее задание или проектная задача.
		
		СвойстваЗадачи = СвойстваПроектныхЗадач.Получить(СтрокаЗадача.РабочееЗадание);
		Если СвойстваЗадачи = Неопределено Тогда
			НормаСтоимостиФакт = Неопределено;
		Иначе
			НормаСтоимостиФакт = СвойстваЗадачи.НормаСтоимостиТрудовыхРесурсов;
		КонецЕсли;
		
		ВидОперации = ПолучитьВидОперацииИзСвойствПЗ(СвойстваЗадачи, РазделыУчетаВидовОпераций, ВидОперацииЯвка);
		
        ТаблицаНормСтоимости = ТаблицаНормСтоимостиПоПериоду;
        ИтогоНормаСтоимостиПоПериоду = 0;
        ИтогоНормаСтоимостиПоПредварительномуУровнюПоПериоду = 0;
        ДатаИзмененияНормы = Дата(1, 1, 1);
        ДатаИзмененияНормыПоПредварительномуУровню = Дата(1, 1, 1);
		
		//
		
		ОтборПоТрудовомуРесурсу = Новый Структура("Ресурс,Норма", ДанныеДокумента.ТрудовойРесурс, НормаСтоимостиФакт);
		ОтборПоРоли = Новый Структура("Ресурс,Норма", СтрокаЗадача.РольРесурса, НормаСтоимостиФакт);
		
		СтрокиНормыСтоимостиПоТрудовомуРесурсу = ТаблицаНормСтоимости.НайтиСтроки(ОтборПоТрудовомуРесурсу);
		СтрокиНормыСтоимостиПоРоли = ТаблицаНормСтоимости.НайтиСтроки(ОтборПоРоли);

		Если СтрокиНормыСтоимостиПоТрудовомуРесурсу.Количество() = 0 Тогда
			СтрокаНормыСтоимостиПоТрудовомуРесурсу = Неопределено;
		Иначе
			СтрокаНормыСтоимостиПоТрудовомуРесурсу = СтрокиНормыСтоимостиПоТрудовомуРесурсу[0];
		КонецЕсли;
			
		Если СтрокиНормыСтоимостиПоРоли.Количество() = 0 Тогда
			СтрокаНормыСтоимостиПоРоли = Неопределено;
		Иначе
			СтрокаНормыСтоимостиПоРоли = СтрокиНормыСтоимостиПоРоли[0];
		КонецЕсли;

		//
		
		Если ИспользоватьСтавкуТрудовогоРесурсаДляПредварительного 
			И СтрокаНормыСтоимостиПоТрудовомуРесурсу <> Неопределено 
			И СтрокаНормыСтоимостиПоТрудовомуРесурсу.СтоимостьЧаса <> 0 Тогда      
			СтрокаНормыПоПредварительномуУровню = СтрокаНормыСтоимостиПоТрудовомуРесурсу;
			СтрокиНормыСтоимостиПоПредварительномуУровню = СтрокиНормыСтоимостиПоТрудовомуРесурсу;
		Иначе	
			СтрокаНормыПоПредварительномуУровню = СтрокаНормыСтоимостиПоРоли; 
			СтрокиНормыСтоимостиПоПредварительномуУровню = СтрокиНормыСтоимостиПоРоли;
		КонецЕсли;
		
		Если СтрокаНормыСтоимостиПоТрудовомуРесурсу <> Неопределено 
			И СтрокаНормыСтоимостиПоТрудовомуРесурсу.СтоимостьЧаса <> 0 Тогда  
			СтрокаНормыПоОкончательномуУровню = СтрокаНормыСтоимостиПоТрудовомуРесурсу;
			СтрокиНормыСтоимостиПоОкончательномуУровню =  СтрокиНормыСтоимостиПоТрудовомуРесурсу;
		Иначе
			СтрокаНормыПоОкончательномуУровню = СтрокаНормыСтоимостиПоРоли;
			СтрокиНормыСтоимостиПоОкончательномуУровню =  СтрокиНормыСтоимостиПоРоли;
		КонецЕсли;
		
		//
		
		// Кеширование
		мПроектныеЗадачи = Новый Массив;
		Для Каждого СтрокаТаблицы Из РабочиеЗадания Цикл
			Если ТипЗнч(СтрокаТаблицы.РабочееЗадание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
				мПроектныеЗадачи.Добавить(СтрокаТаблицы.РабочееЗадание);
			КонецЕсли;
		КонецЦикла;
		СправочникПроектПоДокументуПЗ = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(мПроектныеЗадачи,, Истина);
		
		Для Каждого СтрокаДень Из ТаблицаДней Цикл
			
			ТрудозатратыДня = СтрокаЗадача[СтрокаДень.ИмяДня];
			РабочийДень = НачалоДня(ДанныеДокумента.ДеньНачалаНедели) + 86400 * СтрокаДень.Смещение;
			
			Если ТрудозатратыДня = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			лЗадачаПричина = Неопределено;
			
			Если ТипЗнч(СтрокаЗадача.РабочееЗадание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
				лЗадачаПричина = СправочникПроектПоДокументуПЗ.Получить(СтрокаЗадача.РабочееЗадание);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(лЗадачаПричина) Тогда
				лЗадачаПричина = СтрокаЗадача.Проект;
			КонецЕсли;
			
			// Ранее если использовали расшифровку, то движения делались только с использованием расшифровки,
			// теперь если за какой-то день по ПЗ есть расшифровка, то пишем в регистр расшифровку, 
			// иначе пишем по вкладке Проектные задачи.
			Если ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда 
				
				ОтборПоискРасшифровок = Новый Структура();
				ОтборПоискРасшифровок.Вставить("РабочееЗадание", СтрокаЗадача.РабочееЗадание);
				ОтборПоискРасшифровок.Вставить("Задание", СтрокаЗадача.Задание);
				ОтборПоискРасшифровок.Вставить("Подразделение", СтрокаЗадача.Подразделение);
				ОтборПоискРасшифровок.Вставить("РольРесурса", СтрокаЗадача.РольРесурса);
				ОтборПоискРасшифровок.Вставить("ДеньНедели", СтрокаДень.ИмяДня);
				
				СтрокиРасшифровки = ДанныеДокумента.РасшифровкаТрудозатрат.НайтиСтроки(ОтборПоискРасшифровок);
				
				// По проектной задаче нет расшифровок.
				Если СтрокиРасшифровки.Количество() = 0  Тогда 
					ПроведениеБезРасшифровки = Истина;
				Иначе 
					СуммаЗаДеньПоВсемРасшифровкам = 0;
					Для каждого ЭлементРасшифровки Из СтрокиРасшифровки Цикл
						Если ЭлементРасшифровки.ДеньНедели = СтрокаДень.ИмяДня Тогда
							СуммаЗаДеньПоВсемРасшифровкам = СуммаЗаДеньПоВсемРасшифровкам + ЭлементРасшифровки.ИтогоПоСтроке;
						КонецЕсли;
					КонецЦикла;
					Если СуммаЗаДеньПоВсемРасшифровкам > 0 Тогда 
						ПроведениеБезРасшифровки = Ложь;
					Иначе	                           
						ПроведениеБезРасшифровки = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если Не ДанныеДокумента.ИспользоватьРасшифровкуТрудозатрат Тогда
				
				// ДанныеДвижений.упоФактТрудозатратПоДням - Окончательный уровень.			
