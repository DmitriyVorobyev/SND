						ПараметрыДанных.ДатаИзмененияНормы = ДатаИзмененияНормыПоПредварительномуУровню;
						ПараметрыДанных.СтрокиНормыСтоимостиПоУровню = СтрокиНормыСтоимостиПоПредварительномуУровню;
						
						ДобавитьДвижениеВРегистрыФактаТрудозатрат(ДанныеДвижений.упоФактТрудозатратПоДням, СтрокаЗадача, 
							ПараметрыДанных);
				
					КонецЦикла;  
					
				КонецЕсли; 
			КонецЕсли; 			
		КонецЦикла; 		
		
		упоФункцииОбщегоНазначенияСервер.СвернутьТаблицуДвижений(ДанныеДвижений.упоИспользованиеРабочегоВремени,
			"упоИспользованиеРабочегоВремени");
				
	КонецЦикла;  
	
	// По регистру общих фактических затрат трудовых ресурсов
	// движения делаются без разбиения по дням.	
	ЗаполнитьДвиженияПоФактуТрудозатратСводно(ДанныеДвижений);	
	
КонецПроцедуры

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный - значение, которое используется как основание для заполнения.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если Основание = Неопределено Тогда 
		
		// Новый документ заполняем связанным трудовым ресурсом для текущего сотрудника
		// текущего пользователя.
		МассивТрудовыхРесурсов = упоРесурсыИРолиСервер.ПолучитьТрудовыеРесурсыТекущегоСотрудника();				
		Если МассивТрудовыхРесурсов.Количество() = 1 Тогда
			ТрудовойРесурс = МассивТрудовыхРесурсов[0];	
		КонецЕсли;		
				
	Иначе
		
		упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
		
		Если ТипЗнч(Основание) = Тип("СправочникСсылка.упоТрудовыеРесурсы") Тогда
			
			// Необходимо выполнить проверку на владение трудовым
			// ресурсом для текущего пользователя.			
			Если упоРесурсыИРолиСервер.РесурсУправляетсяТекущимПользователем(Основание) Тогда
				ТрудовойРесурс = Основание;
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Обработчик события ПриУстановкеНовогоНомера модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - СправочникОбъект, содержит сам объект.
