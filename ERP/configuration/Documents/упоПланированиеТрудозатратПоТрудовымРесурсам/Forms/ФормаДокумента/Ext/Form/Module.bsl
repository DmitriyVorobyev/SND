		Элемент.УстановитьДействие("ПриИзменении", "ПриИзмененииКолонки");
		//Элемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
		//Элемент.ПутьКДаннымПодвала = "ПодвалНовоеЗначение"+СтрокаКолонки.ИмяКолонки;
		Элемент.ПутьКДаннымПодвала = "ИтогоНовоеЗначение" + СтрокаКолонки.ИмяКолонки;
		
