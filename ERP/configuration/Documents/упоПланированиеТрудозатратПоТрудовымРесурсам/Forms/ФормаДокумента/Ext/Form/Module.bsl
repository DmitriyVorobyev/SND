&НаКлиенте
Процедура ДеревоФормыНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)	

	Если ЭтаФорма.ТолькоПросмотр Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;

	ТекСтрока = Элементы.ДеревоФормы.ТекущиеДанные;
	Если Элемент.ТекущийЭлемент = Неопределено ИЛИ ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТекСтрока.ЕстьПраваНаРедактирование Тогда
		Возврат;
	КонецЕсли;	

	ИмяКолонки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ДеревоФормы", "");
	ПараметрыПеретаскивания.Значение.Очистить();
	Если ТекСтрока = Неопределено Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	ИдСтроки = ТекСтрока.ПолучитьИдентификатор();
	Если ТипЗнч(ТекСтрока[ИмяКолонки]) = Тип("Число") Тогда
		ПараметрыПеретаскивания.Значение.Добавить("Перетаскивание" + ЭтаФорма.УникальныйИдентификатор);
		ПараметрыПеретаскивания.Значение.Добавить(ИдСтроки);
		ПараметрыПеретаскивания.Значение.Добавить(ИмяКолонки);
	ИначеЕсли ИмяКолонки = "Группировка" Тогда
		Если ЗначениеЗаполнено(ТекСтрока.ТрудовойРесурс) И НЕ ЗначениеЗаполнено(ТекСтрока.ПроектнаяЗадачаЗеркало) Тогда
			ПараметрыПеретаскивания.Значение.Добавить("НазначитьНаЗадачу" + ЭтаФорма.УникальныйИдентификатор);
			ПараметрыПеретаскивания.Значение.Добавить(ТекСтрока.ТрудовойРесурс);	
		ИначеЕсли НЕ ЗначениеЗаполнено(ТекСтрока.ТрудовойРесурс) И ЗначениеЗаполнено(ТекСтрока.ПроектнаяЗадачаЗеркало) Тогда
			ПараметрыПеретаскивания.Значение.Добавить("НазначитьРесурс" + ЭтаФорма.УникальныйИдентификатор);
			ПараметрыПеретаскивания.Значение.Добавить(ИдСтроки);
			ПараметрыПеретаскивания.Значение.Добавить(ТекСтрока.ПроектнаяЗадачаЗеркало);			
		Иначе
			Выполнение = Ложь;	
		КонецЕсли;
	Иначе
		Выполнение = Ложь;
	КонецЕсли;       

КонецПроцедуры

