&НаКлиенте
Процедура ДеревоФормыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Не Поле.Имя = "ДеревоФормыГруппировка" Тогда
		Возврат; 
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ДеревоФормы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ВыборИзМеню = Ложь;		
	
	Если ТекДанные.ПоследнийУровень Тогда
		
		ВыборИзМеню = Истина;
		
		Варианты = ВариантыВыбораДляПоследнегоУровня(ТекДанные);									     
		
	ИначеЕсли Объект.ПорядокГруппировок = 2 Тогда
		
		Если ЗначениеЗаполнено(ТекДанные.ТрудовойРесурс) Тогда // И ТекДанные.ИтогНовоеЗначение <> 0 Тогда
			
			ВыборИзМеню = Истина;
						
			Варианты = ВариантыВыбораДляГруппировки(ТекДанные);
																					
		КонецЕсли;
		
	Иначе
		
		ПоказатьЗначение(, ТекДанные[ТекДанные.ИмяГруппировки]);
		
	КонецЕсли;
	
	Если ВыборИзМеню Тогда
		
		ПараметрыОповещения = Новый Структура;
		ПараметрыОповещения.Вставить("ИдСтроки", ТекДанные.ПолучитьИдентификатор());
		ПараметрыОповещения.Вставить("Поле", Поле);
		ОписаниеОповещенияЗавершениеВыборИзМенюГруппировка = Новый ОписаниеОповещения("ЗавершениеВыборИзМенюГруппировка", 
															ЭтаФорма, ПараметрыОповещения);
															
		ПоказатьВыборИзМеню(ОписаниеОповещенияЗавершениеВыборИзМенюГруппировка, Варианты, Поле);
								
	КонецЕсли;			

КонецПроцедуры

&НаКлиенте
Процедура ДеревоФормыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

	СтандартнаяОбработка = Ложь;

	Если ЭтаФорма.ТолькоПросмотр Или Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СтрокаПриемник = ДеревоФормы.НайтиПоИдентификатору(Строка);	
	Если Не СтрокаПриемник.ЕстьПраваНаРедактирование Тогда
		Возврат;	
	КонецЕсли;	

	Значение = ПараметрыПеретаскивания.Значение;

	Если Поле.Имя = "ДеревоФормыГруппировка" Тогда
		
		Если ТипЗнч(Значение) <> Тип("Массив") ИЛИ
			Значение.Количество() = 0  ИЛИ
			СтрНайти(Значение[0], ЭтаФорма.УникальныйИдентификатор) = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Если СтрНайти(Значение[0], "НазначитьНаЗадачу") <> 0 Тогда
			ТрудовойРесурс = Значение[1];
			Если Объект.ПорядокГруппировок = 1 Тогда
				Если СтрокаПриемник.ИмяГруппировки = "Роль"	
					Или СтрокаПриемник.ИмяГруппировки = "ТрудовойРесурс" Тогда
					
					НазначитьРесурсНаЗадачуКлиент(Строка, ТрудовойРесурс);
					
				КонецЕсли;	
			ИначеЕсли СтрокаПриемник.ИмяГруппировки = "ПроектнаяЗадачаЗеркало" 
				И ЗначениеЗаполнено(СтрокаПриемник.ПроектнаяЗадачаЗеркало) Тогда
				
				НазначитьРесурсНаЗадачуКлиент(Строка, ТрудовойРесурс);
				
			КонецЕсли;
		ИначеЕсли Найти(Значение[0], "НазначитьРесурс") <> 0 Тогда
			ИдСтрокиПЗ = Значение[1]; 
			Если ЗначениеЗаполнено(СтрокаПриемник.ТрудовойРесурс) Тогда
				
				НазначитьРесурсНаЗадачуКлиент(ИдСтрокиПЗ, СтрокаПриемник.ТрудовойРесурс);
				
			КонецЕсли;
		КонецЕсли;			
		
	Иначе
				
		ПроверитьУстановитьТрудозатратыВСтрокеПоИсточнику(СтрокаПриемник, Значение, Поле.Имя);
					
	КонецЕсли;

КонецПроцедуры

