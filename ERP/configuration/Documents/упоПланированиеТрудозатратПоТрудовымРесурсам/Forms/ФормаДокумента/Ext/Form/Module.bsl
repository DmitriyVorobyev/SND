&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяОсновнойКолонкиПоДате(Дата) 
	
	Возврат "Колонка" + Формат(Дата, "ДФ=yyyyMMdd");	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяОсновнойКолонкиПоИмениЭлемента(ИмяЭлемента) 
	
	Если СтрНайти(ИмяЭлемента, "Колонка") = 0 Тогда
		Возврат Неопределено;
	Иначе
		ИмяПустойКолонки = ПолучитьИмяОсновнойКолонкиПоДате(ПолучитьТекущуюДатуСеанса());
		Индекс = СтрНайти(ИмяПустойКолонки, "Колонка");
		Длина = СтрДлина(ИмяПустойКолонки);
		Возврат Сред(ИмяЭлемента, Индекс, Длина);
	КонецЕсли;
	
КонецФункции

