&НаСервере
Функция ВыгрузитьРезультатЗапросаВДерево(РезультатЗапроса)
	
	Дерево = РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КЧ = Новый КвалификаторыЧисла(15, 2);
	ОписаниеТипаКолонки = Новый ОписаниеТипов("Число", КЧ);
	
	ОписаниеТипаКолонкиСтрока = Новый ОписаниеТипов("Строка");
	
	Дерево.Колонки.Добавить("Группировка");
	Дерево.Колонки.Добавить("ИндексКартинки", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("УровеньДерева", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("ПоследнийУровень", Новый ОписаниеТипов("Булево"));	
	Дерево.Колонки.Добавить("ИмяГруппировки", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ПредставлениеЗадачи", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("ИтогПоПериодуПоРоли", ОписаниеТипаКолонки);
	Дерево.Колонки.Добавить("ИтогПоПериодуТекущееЗначение", ОписаниеТипаКолонки);
	Дерево.Колонки.Добавить("ИтогПоПериодуНовоеЗначение", ОписаниеТипаКолонки);
	Дерево.Колонки.Добавить("ИтогПоПериодуОтклонение", ОписаниеТипаКолонки);
	Дерево.Колонки.Добавить("ИтогПоПериодуФакт", ОписаниеТипаКолонки);
	Дерево.Колонки.Добавить("ДатаПервойЗагруки", Новый ОписаниеТипов("Дата"));	

	Для Каждого СтрокаКолонки Из КолонкиДат Цикл
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "НовоеЗначение", ОписаниеТипаКолонки);	
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ДляРасчетаРазницы", ОписаниеТипаКолонки);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ТекущееЗначение", ОписаниеТипаКолонки);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "Отклонение", ОписаниеТипаКолонки);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ПоРоли", ОписаниеТипаКолонки);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "Факт", ОписаниеТипаКолонки);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ПоКалендарю", ОписаниеТипаКолонки);
	КонецЦикла;

	Возврат Дерево;
	
КонецФункции

&НаСервере
Функция ЗагрузитьДанныеФормыИзОбъекта(ТолькоШапку = Ложь, СниматьПризнакЗаписьДляНедоступныхСтрок = Ложь) 
	
	ИзмененыСроки = КолонкиДат.Количество() = 0 ИЛИ 
		КолонкиДат[0].Дата <> Объект.НачалоПериода ИЛИ 
		КолонкиДат[КолонкиДат.Количество() - 1].Дата <> Объект.КонецПериода;

	НачалоПериодаНаФорме = Объект.НачалоПериода;
	КонецПериодаНаФорме = Объект.КонецПериода;

	УстановитьЗаголовокВыбораПериода(ЭтаФорма);

	МассивРолей = Объект.Роли.Выгрузить().ВыгрузитьКолонку("Роль");
	СписокРолей.ЗагрузитьЗначения(МассивРолей);

	МассивПодразделений = Объект.Подразделения.Выгрузить().ВыгрузитьКолонку("Подразделение");
	СписокПодразделений.ЗагрузитьЗначения(МассивПодразделений);

	МассивПроектов = Объект.Проекты.Выгрузить().ВыгрузитьКолонку("Проект");
	СписокПроектов.ЗагрузитьЗначения(МассивПроектов);

	//

	Если ТолькоШапку Тогда
		Возврат Неопределено;
	КонецЕсли;

	//

	ОчиститьДанные(ЭтаФорма);
	ОчиститьИтоги(ЭтаФорма);		

	Если ИзмененыСроки Тогда
		
		ОбновитьДопДанные();
		
		ВывестиПериодыНаФорму();				
		
		ДобавитьУФ();				
		
	КонецЕсли;
					
	МассивГруппировок = ПолучитьМассивГруппировок(Объект.ПорядокГруппировок);
	
	Отбор = Новый Структура("ТрудовойРесурс, ТипДанных", Справочники.упоТрудовыеРесурсы.ПустаяСсылка(), "НовоеЗначение");
	ТаблицаДанныеПоПериоду = Объект.РаспределениеПоПериоду.Выгрузить(Отбор);
	
	Отбор = Новый Структура("Ресурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
	ТаблицаДанныеЗаПериоду = Объект.ТрудозатратыЗаПериодомПланирования.Выгрузить(Отбор);
	
	Запрос = Новый Запрос;
	УстановитьПараметрыРазграниченияДоступа(Запрос, СниматьПризнакЗаписьДляНедоступныхСтрок);
	Запрос.УстановитьПараметр("ТаблицаДанные", Объект.Данные.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаДанныеПоПериоду", ТаблицаДанныеПоПериоду);	
	Запрос.УстановитьПараметр("ТаблицаДанныеЗаПериоду", ТаблицаДанныеЗаПериоду);								

	Запрос.Текст = ТекстЗапросаДерева(МассивГруппировок);
					   
	РезультатПакета = Запрос.ВыполнитьПакет(); 				   
	
	Дерево = ВыгрузитьРезультатЗапросаВДерево(РезультатПакета[РезультатПакета.Количество()-1]);
	
	ТаблицаПоРолям = РезультатПакета[РезультатПакета.Количество()-2].Выгрузить();

	Если Объект.ПорядокГруппировок = 1 Тогда
		Отбор = Новый Структура("ТрудовойРесурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
		НайденныеСтроки = Дерево.Строки.НайтиСтроки(Отбор, Истина);
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если Строка.ТрудозатратыПланДоПериода = 0 И Строка.ТрудозатратыПланПослеПериода = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока = Строка.Родитель;
			Пока ТекСтрока <> Неопределено Цикл
				ТекСтрока.ТрудозатратыПланДоПериода = 
					ТекСтрока.ТрудозатратыПланДоПериода - Строка.ТрудозатратыПланДоПериода;
				ТекСтрока.ТрудозатратыПланПослеПериода = 
					ТекСтрока.ТрудозатратыПланПослеПериода - Строка.ТрудозатратыПланПослеПериода;
				
				ТекСтрока = ТекСтрока.Родитель;
			КонецЦикла;
		КонецЦикла;	
	КонецЕсли;

	СтрокиДерева = Дерево.Строки;
	ОбщийИтогФакт = СтрокиДерева.Итог("Факт");
	ОбщийИтогТрудозатратыПланДоПериода = СтрокиДерева.Итог("ТрудозатратыПланДоПериода");
	ОбщийИтогТрудозатратыПланПослеПериода = СтрокиДерева.Итог("ТрудозатратыПланПослеПериода");
	НайденныеСтроки = СтрокиДерева.НайтиСтроки(Новый Структура("ТрудовойРесурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка()));
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ОбщийИтогТрудозатратыПланДоПериода = ОбщийИтогТрудозатратыПланДоПериода - НайденнаяСтрока.ТрудозатратыПланДоПериода;
		ОбщийИтогТрудозатратыПланПослеПериода = ОбщийИтогТрудозатратыПланПослеПериода - НайденнаяСтрока.ТрудозатратыПланПослеПериода;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоФормы");

	ОбновитьСтрокиНижнегоУровня(МассивГруппировок);

	Для Каждого КлючЗначение Из ЭтаФорма.мКэшЗначений.СтрокиРесурса_НижнийУровень Цикл
		Для Каждого ИД Из КлючЗначение.Значение Цикл
			СтрокаДерева = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИД);
			Пока СтрокаДерева <> Неопределено Цикл
				Для Каждого СтрокаДня Из Объект.ДанныеКалендаря Цикл
					ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаДня.День);	
					
					СтрокаДерева[ИмяКолонки + "ПоКалендарю"] = СтрокаДня.КоличествоЧасов;
					ЭтаФорма["ИтогоПоКалендарю" + ИмяКолонки] = ЭтаФорма["ИтогоПоКалендарю" + ИмяКолонки] + СтрокаДня.КоличествоЧасов;
				КонецЦикла;
				
				СтрокаДерева = СтрокаДерева.ПолучитьРодителя();
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
			
	РекурсивноЗаполнитьДерево(ЭтаФорма, Объект, ДеревоФормы.ПолучитьЭлементы(), 0, МассивГруппировок);

	СчитатьВычисляемыеИтогиДерева(ЭтаФорма);

	Если Объект.ПорядокГруппировок = 2 Тогда
		ЭлементыДерева = ДеревоФормы.ПолучитьЭлементы();
		Для Каждого Элемент Из ЭлементыДерева Цикл
			Если ЗначениеЗаполнено(Элемент.ТрудовойРесурс) Тогда
				СортроватьСтрокиПоДатеПервойЗагрузки(ЭтаФорма, Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	//СтрокиВыходных = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("КоличествоЧасов", 0));
	//Для Каждого СтрокаВыходного Из СтрокиВыходных Цикл
	//	ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаВыходного.День);
	//	Элемент = Элементы.Найти(ИмяКолонки+"Группа");
	//	Если Элемент <> Неопределено Тогда
	//		Элемент.ШрифтЗаголовка = Новый Шрифт(,,Истина);
	//	КонецЕсли;
	//КонецЦикла;	

	ПосчитатьОбщийИтогПоРоли(ТаблицаПоРолям);

	ОбновитьПодвалИтогов(ЭтаФорма);

	упоПланированиеТрудозатратКлиентСервер.ПостроитьДиаграмму(ЭтаФорма, "ПоРесурсам");
	ПостроитьДиаграммуГанта(ЭтаФорма);

КонецФункции

&НаСервере
Процедура УстановитьПараметрыРазграниченияДоступа(Запрос, Знач СниматьПризнакЗаписьДляНедоступныхСтрок = Ложь)

	ЭтаФорма.ОтключитьРазграничениеДоступаКДокументам = 
		упоРазграничениеДоступаВызовСервера.РазграничениеДоступаОтключено();		
	Если ОтключитьРазграничениеДоступаКДокументам Тогда
		СниматьПризнакЗаписьДляНедоступныхСтрок = Ложь;
	КонецЕсли;	
		
	СписокСотрудниковДиспетчера = ПараметрыСеанса.упоСписокСотрудниковДиспетчера;	

	СтатусыНеРедактируемыхЗадач = Новый Массив;
	СтатусыНеРедактируемыхЗадач.Добавить(ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Завершена"));
	СтатусыНеРедактируемыхЗадач.Добавить(ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Закрыта"));		
	СтатусыНеРедактируемыхЗадач.Добавить(ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.ПустаяСсылка"));

	Запрос.УстановитьПараметр("ОтключитьРазграничениеДоступаКДокументам", ОтключитьРазграничениеДоступаКДокументам);					
	Запрос.УстановитьПараметр("СниматьПризнакЗаписьДляНедоступныхСтрок", СниматьПризнакЗаписьДляНедоступныхСтрок);					
	Запрос.УстановитьПараметр("СтатусыНеРедактируемыхЗадач", СтатусыНеРедактируемыхЗадач);					
	Запрос.УстановитьПараметр("СписокСотрудниковДиспетчера", СписокСотрудниковДиспетчера);					

КонецПроцедуры	

&НаСервере
Процедура ПосчитатьОбщийИтогПоРоли(ТаблицаПоРолям) 

	ОбщийИтогПоРоли = 0;
	ТаблицаОбщийИтог = ТаблицаПоРолям.Скопировать();
	ОтборПустойТР = Новый Структура("ТрудовойРесурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
	НайденныеСтроки = ТаблицаОбщийИтог.НайтиСтроки(ОтборПустойТР);
	Для Каждого Строка Из НайденныеСтроки Цикл
		ТаблицаОбщийИтог.Удалить(Строка);
	КонецЦикла;	
	ТаблицаОбщийИтог.Свернуть("Подразделение, Роль, ПроектнаяЗадачаЗеркало, ИтогПоРоли");

	Для Каждого СтрокаТаблицы Из ТаблицаОбщийИтог Цикл
		ОбщийИтогПоРоли = ОбщийИтогПоРоли + СтрокаТаблицы.ИтогПоРоли;	
	КонецЦикла;

	ОбщийИтогПоПериодуПоРоли = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	тз.Дата КАК Дата,
	               |	тз.Значение КАК Значение,
	               |	тз.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	тз.Роль КАК Роль
	               |ПОМЕСТИТЬ вт
	               |ИЗ
	               |	&тз КАК тз
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	вт.Дата КАК Дата,
	               |	вт.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	вт.Роль КАК Роль,
	               |	МАКСИМУМ(вт.Значение) КАК Значение
	               |ПОМЕСТИТЬ вт_ПоРоли
	               |ИЗ
	               |	вт КАК вт
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	вт.Дата,
	               |	вт.ПроектнаяЗадача,
	               |	вт.Роль
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(вт_ПоРоли.Значение) КАК Значение
	               |ИЗ
	               |	вт_ПоРоли КАК вт_ПоРоли";
	Запрос.УстановитьПараметр("тз", Объект.РаспределениеПоПериоду.Выгрузить(Новый Структура("ТипДанных", "ПоРоли")));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОбщийИтогПоПериодуПоРоли = Выборка.Значение;	
	КонецЕсли;

	СопоставитьИтогПоРоли(ДеревоФормы, ТаблицаПоРолям, Новый Структура);																	

КонецПроцедуры

&НаСервере
Процедура СопоставитьИтогПоРоли(ВходящийЭлементДерева, ТаблицаПоРолям, ТекущийОтбор) 

	СтруктураОтборУровня = Новый Структура;
	Для Каждого КлючЗначение Из ТекущийОтбор Цикл
		СтруктураОтборУровня.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
	КонецЦикла;

	ОтборПустойТР = Новый Структура("ТрудовойРесурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
	Для Каждого ЭлементДерева Из ВходящийЭлементДерева.ПолучитьЭлементы() Цикл
		Если ЭлементДерева.ПоследнийУровень Тогда
			Прервать;
		КонецЕсли;
		//Если ЭлементДерева.ИмяГруппировки <> "ТрудовойРесурс" Тогда
		СтруктураОтборУровня.Вставить(ЭлементДерева.ИмяГруппировки, ЭлементДерева.Группировка);
		//КонецЕсли;
		//СтрокиОтбора = ТаблицаПоРолям.НайтиСтроки(СтруктураОтборУровня);
		ТаблицаОтбора = ТаблицаПоРолям.Скопировать(СтруктураОтборУровня);
		Если Объект.ПорядокГруппировок = 1 И ЭлементДерева.ИмяГруппировки <> "ТрудовойРесурс" Тогда			
			НайденныеСтроки = ТаблицаОтбора.НайтиСтроки(ОтборПустойТР);
			Для Каждого Строка Из НайденныеСтроки Цикл
				ТаблицаОтбора.Удалить(Строка);
			КонецЦикла;	
		КонецЕсли;
		ТаблицаОтбора.Свернуть("Подразделение, Роль, ПроектнаяЗадачаЗеркало, ИтогПоРоли, Проект");
		ЭлементДерева.ИтогПоРоли = 0;
		Для Каждого СтрокаОтбора Из ТаблицаОтбора Цикл
			ЭлементДерева.ИтогПоРоли = ЭлементДерева.ИтогПоРоли + СтрокаОтбора.ИтогПоРоли;
		КонецЦикла;
		СопоставитьИтогПоРоли(ЭлементДерева, ТаблицаПоРолям, СтруктураОтборУровня);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПостроитьДиаграммуГанта(ЭтаФорма) 

	Если НЕ ЭтаФорма.Объект.ПоказатьДиаграммуГанта Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ДеревоФормы.ПолучитьЭлементы()) Тогда
		Возврат;	
	КонецЕсли;

	Диаграмма = ЭтаФорма.ДиаграммаГанта; 	
	Диаграмма.Очистить();	

	Диаграмма.Обновление = Ложь;
	Диаграмма.АвтоОпределениеПолногоИнтервала = Ложь;	
	Диаграмма.ОбластьЛегенды.Расположение = РасположениеЛегендыДиаграммы.Нет;	
	Диаграмма.ОтображениеТекстаЗначения = ОтображениеТекстаЗначенияДиаграммыГанта.Право;

	Пока Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы.Количество() > 1 Цикл
		Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы.Удалить(Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы[1]);
	КонецЦикла;
	Шкала1 = Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы[0];
	Шкала1.Единица = ТипЕдиницыШкалыВремени.Неделя;
	Шкала2 = Диаграмма.ОбластьПостроения.ШкалаВремени.Элементы.Добавить();
	Шкала2.Единица = ТипЕдиницыШкалыВремени.День;
	Шкала2.ФорматДня = ФорматДняШкалыВремени.ДеньМесяца;	
		
	СерияНовоеЗначение = Диаграмма.УстановитьСерию(НСтр("ru = 'Новые значения'"));
	СерияНовоеЗначение.Цвет = Новый Цвет(225,255,225);
	Если ЭтаФорма.Объект.ПоказыватьТекущиеЗначенияНаДГ Тогда 		
		СерияТекущееЗначение = Диаграмма.УстановитьСерию(НСтр("ru = 'Текущие значения'"));
		СерияТекущееЗначение.Цвет = Новый Цвет(220,220,220);
	КонецЕсли;

	СписокСтрокПЗ = Новый СписокЗначений;

	Если ЗначениеЗаполнено(ЭтаФорма.РесурсДиаграммыПоРесурсу) И ЭтаФорма.Объект.ПорядокГруппировок = 2 Тогда
		ЭлементыДерева = ЭтаФорма.ДеревоФормы.ПолучитьЭлементы();
		МассивОбрПЗ = Новый Массив;
		Для Каждого Элемент Из ЭлементыДерева Цикл
			Если Элемент.ТрудовойРесурс = ЭтаФорма.РесурсДиаграммыПоРесурсу Тогда
				ЭлементыТР = Элемент.ПолучитьЭлементы();
				Для Каждого ЭлементТР Из ЭлементыТР Цикл
					Если НЕ ЗначениеЗаполнено(ЭлементТР.ПроектнаяЗадача) ИЛИ МассивОбрПЗ.Найти(ЭлементТР.ПроектнаяЗадача) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					СписокСтрокПЗ.Добавить(Новый Структура("ПЗ, ИдСтроки", ЭлементТР.ПроектнаяЗадача, ЭлементТР.ПолучитьИдентификатор()));	
					МассивОбрПЗ.Добавить(ЭлементТР.ПроектнаяЗадача);
				КонецЦикла;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе           		
		Для Каждого КлючЗначение Из ЭтаФорма.мКэшЗначений.СтрокиПЗ_УровеньПЗ Цикл
			ПЗ = КлючЗначение.Ключ;			
			Если Не ЗначениеЗаполнено(ПЗ) Тогда
				Продолжить;
			КонецЕсли;
			ИдСтроки = КлючЗначение.Значение[0];
			СтрокаПЗ = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
			СписокСтрокПЗ.Добавить(Новый Структура("ПЗ, ИдСтроки", ПЗ, ИдСтроки), "" + СтрокаПЗ.КодПроекта + СтрокаПЗ.КодСДР);
		КонецЦикла;
		СписокСтрокПЗ.СортироватьПоПредставлению();
	КонецЕсли;

	Для Каждого ДанныеПЗ Из СписокСтрокПЗ Цикл
		
		ПЗ = ДанныеПЗ.Значение.ПЗ;	
		
		ИдСтроки = ДанныеПЗ.Значение.ИдСтроки;
		СтрокаПЗ = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
				
		Точка = Диаграмма.УстановитьТочку(СтрокаПЗ.ПроектнаяЗадачаЗеркало);		
		Точка.Текст = "" + СтрокаПЗ.КодСДР + " " + СтрокаПЗ.ПроектнаяЗадачаЗеркало + " ["+СтрокаПЗ.Проект+"]";
		Точка.Расшифровка = СтрокаПЗ.ПроектнаяЗадачаЗеркало;
		
		Значение = Диаграмма.ПолучитьЗначение(Точка, СерияНовоеЗначение);
		Интервал = Значение.Добавить();
		Интервал.Начало = ?(ЗначениеЗаполнено(СтрокаПЗ.ДатаНачалаНП), СтрокаПЗ.ДатаНачалаНП, СтрокаПЗ.ДатаНачалаТП);
		Интервал.Конец = КонецДня(?(ЗначениеЗаполнено(СтрокаПЗ.ДатаЗавершенияНП), СтрокаПЗ.ДатаЗавершенияНП, СтрокаПЗ.ДатаЗавершенияТП));
		Значение.Текст = НСтр("ru = 'Новое значение'")+" ["+Формат(Интервал.Начало, "ДФ=dd.MM.yy")+"-"+Формат(Интервал.Конец, "ДФ=dd.MM.yy")+"]";
		Интервал.Текст = Значение.Текст;      	
		
		Если ЭтаФорма.Объект.ПоказыватьТекущиеЗначенияНаДГ Тогда
			Значение = Диаграмма.ПолучитьЗначение(Точка, СерияТекущееЗначение);
			Интервал = Значение.Добавить();
			Интервал.Начало = СтрокаПЗ.ДатаНачалаТП;
			Интервал.Конец = КонецДня(СтрокаПЗ.ДатаЗавершенияТП);
			Значение.Текст = НСтр("ru = 'Текущее значение'")+" ["+Формат(Интервал.Начало, "ДФ=dd.MM.yy")+"-"+Формат(Интервал.Конец, "ДФ=dd.MM.yy")+"]";
			Интервал.Текст = Значение.Текст;
		КонецЕсли;
				
	КонецЦикла;

	Диаграмма.УстановитьПолныйИнтервал(ЭтаФорма.НачалоПериодаНаФорме, КонецДня(ЭтаФорма.КонецПериодаНаФорме));
	Диаграмма.Обновление = Истина;	

	//упоПечатьДиаграммыГанта.УниверсальноНапечататьДиаграммуГанта(Диаграмма, "", ЭтаФорма.ДГДок);

	//п = ПолучитьИнформациюЭкрановКлиента();

КонецПроцедуры

