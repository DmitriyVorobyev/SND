	               |			ТОГДА ЕСТЬNULL(ТаблицаДанныеРазграничениеПравДоступа.ЕстьДоступСтатусЗадачи, ИСТИНА)
	               |					И ЕСТЬNULL(ТаблицаДанныеРазграничениеПравДоступа.ЕстьДоступРПЗ, ИСТИНА)
	               |		ИНАЧЕ ТаблицаДанныеСДопДанными.Записывать
	               |	КОНЕЦ КАК Записывать,
	               |	ТаблицаДанныеСДопДанными.Редактируется КАК Редактируется,
	               |	ТаблицаДанныеСДопДанными.ИтогНовоеЗначение КАК ИтогНовоеЗначение,
	               |	ТаблицаДанныеСДопДанными.ИтогТекущееЗначение КАК ИтогТекущееЗначение,
	               |	ТаблицаДанныеСДопДанными.ИтогПоРоли КАК ИтогПоРоли,
	               |	ТаблицаДанныеСДопДанными.ПрофильРаспределенияРоли КАК ПрофильРаспределенияРоли,
	               |	ТаблицаДанныеСДопДанными.ДатаНачалаТП КАК ДатаНачалаТП,
	               |	ТаблицаДанныеСДопДанными.ДатаЗавершенияТП КАК ДатаЗавершенияТП,
	               |	ТаблицаДанныеСДопДанными.ДатаНачалаНП КАК ДатаНачалаНП,
	               |	ТаблицаДанныеСДопДанными.ДатаЗавершенияНП КАК ДатаЗавершенияНП,
	               |	ТаблицаДанныеСДопДанными.Проект КАК Проект,
	               |	ТаблицаДанныеСДопДанными.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
	               |	ТаблицаДанныеСДопДанными.Факт КАК Факт,
	               |	ВЫБОР
	               |		КОГДА ТаблицаДанныеСДопДанными.ТрудовойРесурс = ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЗаполненТР,
	               |	ТаблицаДанныеСДопДанными.КрайнийСрок КАК КрайнийСрок,
	               |	ТаблицаДанныеСДопДанными.ПроектПредставление КАК ПроектПредставление,
	               |	ТаблицаДанныеСДопДанными.КодПроекта КАК КодПроекта,
	               |	ТаблицаДанныеСДопДанными.Роль.Наименование КАК РольПредставление,
	               |	ТаблицаДанныеСДопДанными.ТрудовойРесурс.Наименование КАК ТрудовойРесурсПредставление,
	               |	ТаблицаДанныеСДопДанными.ТрудозатратыПланПослеПериода КАК ТрудозатратыПланПослеПериода,
	               |	ТаблицаДанныеСДопДанными.ТрудозатратыПланДоПериода КАК ТрудозатратыПланДоПериода,
	               |	ВЫБОР
	               |		КОГДА &ОтключитьРазграничениеДоступаКДокументам
	               |			ТОГДА ИСТИНА
	               |		КОГДА ТаблицаДанныеСДопДанными.ПроектнаяЗадачаЗеркало = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЕСТЬNULL(ТаблицаДанныеРазграничениеПравДоступа.ЕстьДоступСтатусЗадачи, ИСТИНА)
	               |				И ЕСТЬNULL(ТаблицаДанныеРазграничениеПравДоступа.ЕстьДоступРПЗ, ИСТИНА)
	               |	КОНЕЦ КАК ЕстьПраваНаРедактирование,
	               |	СтатусыЗадач.НомерСтатусаЗадачи КАК НомерСтатусаЗадачи,
	               |	ЕСТЬNULL(СвойстваВерсииЗадач.ТипЗадачи, -1) КАК ТипЗадачи,
	               |	ТаблицаДанныеСДопДанными.ТрудовойРесурс = ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |		ИЛИ ТаблицаДанныеСДопДанными.ПроектнаяЗадачаЗеркало = ЗНАЧЕНИЕ(Справочник.Проекты.ПустаяСсылка) КАК ЭтоСтрокаОстатка,
	               |	НЕ ЗадачиРедактируются.ПроектнаяЗадача ЕСТЬ NULL КАК ОстатокРедактируется
	               |ИЗ
	               |	ТаблицаДанныеСДопДанными КАК ТаблицаДанныеСДопДанными
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаДанныеНеРаспределенныеСгруппированные КАК ТаблицаДанныеНеРаспределенныеСгруппированные
	               |		ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ТаблицаДанныеНеРаспределенныеСгруппированные.ПроектнаяЗадача1
	               |			И ТаблицаДанныеСДопДанными.Роль = ТаблицаДанныеНеРаспределенныеСгруппированные.Роль1
	               |			И ТаблицаДанныеСДопДанными.Подразделение = ТаблицаДанныеНеРаспределенныеСгруппированные.Подразделение1
	               |			И ТаблицаДанныеСДопДанными.ТрудовойРесурс = ТаблицаДанныеНеРаспределенныеСгруппированные.ТрудовойРесурс1
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаДанныеРазграничениеПравДоступа КАК ТаблицаДанныеРазграничениеПравДоступа
	               |		ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ТаблицаДанныеРазграничениеПравДоступа.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СтатусыЗадач КАК СтатусыЗадач
	               |		ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = СтатусыЗадач.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваВерсииЗадач КАК СвойстваВерсииЗадач
	               |		ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = СвойстваВерсииЗадач.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЗадачиРедактируются КАК ЗадачиРедактируются
	               |		ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ЗадачиРедактируются.ПроектнаяЗадача
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА ТаблицаДанныеСДопДанными.ТрудовойРесурс = ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |					И ЕСТЬNULL(ТаблицаДанныеНеРаспределенныеСгруппированные.Трудозатраты, 0) = 0
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ				   
				   |УПОРЯДОЧИТЬ ПО
	               |	" + УпорядочитьПо + "
	               |ИТОГИ
				   |	МАКСИМУМ(КодСДР),
				   |	МАКСИМУМ(Редактируется),
				   |	МАКСИМУМ(КодПроекта),
	               |	МИНИМУМ(ДатаНачалаТП),
	               |	МАКСИМУМ(ДатаЗавершенияТП),
	               |	МИНИМУМ(ДатаНачалаНП),
	               |	МАКСИМУМ(ДатаЗавершенияНП),	
				   |	МАКСИМУМ(ЗаполненТР),	
	               |	СУММА(Факт),
				   |	СУММА(ИтогПоРоли),
				   |	СУММА(ИтогНовоеЗначение),
				   |	СУММА(ИтогТекущееЗначение),
				   |	СУММА(ТрудозатратыПланДоПериода),
				   |	СУММА(ТрудозатратыПланПослеПериода),
				   |	МАКСИМУМ(ЕстьПраваНаРедактирование),
				   |	МАКСИМУМ(НомерСтатусаЗадачи),
				   |	МИНИМУМ(ТипЗадачи),
				   |	МИНИМУМ(ЭтоСтрокаОстатка),
				   |	МИНИМУМ(ОстатокРедактируется)
	               |ПО
	               |	&СтрокаИтогов";

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СтрокаИтогов", СтрокаГруппировокВЗапросе);

	Возврат ТекстЗапроса;

КонецФункции		

&НаКлиенте
Процедура ОбновитьСоответствиеУровнейДерева()

	врСоотвУровняДерева = Новый Соответствие;
	КоличествоУровней = упоОперацииСДеревьямиКлиент.ПолучитьКоличествоУровнейДерева(ДеревоФормы,, врСоотвУровняДерева);
	СоотвУровняДерева = Новый ФиксированноеСоответствие(врСоотвУровняДерева);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьПраваНаРедактированиеТекДанных(ЭтаФорма, ТекДанные)
	
	Возврат НЕ ЭтаФорма.ТолькоПросмотр 
			И ТекДанные.ЕстьПраваНаРедактирование;
	
КонецФункции

&НаКлиенте
Функция ВариантыВыбораДляПоследнегоУровня(ТекДанные)
			
	Варианты = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ТекДанные[ТекДанные.ИмяГруппировки]) Тогда
		Варианты.Добавить("Открыть", НСтр("ru = 'Открыть объект'"));
	КонецЕсли;
	
	Если ЕстьПраваНаРедактированиеТекДанных(ЭтаФорма, ТекДанные) Тогда					
		
		Если ЗначениеЗаполнено(ТекДанные.ТрудовойРесурс) И ЗначениеЗаполнено(ТекДанные.ПроектнаяЗадачаЗеркало) 
			И ТекДанные.Редактируется Тогда					
			Варианты.Добавить("ОтменитьНазначение", НСтр("ru = 'Отменить назначение'"));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекДанные.ТрудовойРесурс) Тогда
			Варианты.Добавить("НазначитьРесурс", НСтр("ru = 'Назначить ресурс'"));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекДанные.ПроектнаяЗадачаЗеркало) Тогда
			Варианты.Добавить("НазначитьНаЗадачу", НСтр("ru = 'Назначить на задачу'"));
		КонецЕсли;				
		
	КонецЕсли;
	
	Возврат Варианты;
	
КонецФункции

&НаКлиенте
Функция ВариантыВыбораДляГруппировки(ТекДанные)
	
	Варианты = Новый СписокЗначений;
	
	Варианты.Добавить("Открыть", НСтр("ru = 'Открыть объект'"));
	
	Если ЕстьПраваНаРедактированиеТекДанных(ЭтаФорма, ТекДанные) Тогда
		
		Варианты.Добавить("ПереназначитьЗадачи", НСтр("ru = 'Переназначить задачи'"));
		
	КонецЕсли;
	
	Возврат Варианты;
	
КонецФункции

&НаКлиенте
Функция ЗавершениеВыборИзМенюГруппировка(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокаДерева = ДеревоФормы.НайтиПоИдентификатору(ДополнительныеПараметры.ИдСтроки);
	Если ВыбранныйЭлемент.Значение = "Открыть" Тогда		
		ПоказатьЗначение(, СтрокаДерева[СтрокаДерева.ИмяГруппировки]);
	ИначеЕсли ВыбранныйЭлемент.Значение = "НазначитьРесурс" Тогда
		ВыбратьИНазначитьРесурсНаЗадачу(СтрокаДерева, ДополнительныеПараметры.Поле);	
	ИначеЕсли ВыбранныйЭлемент.Значение = "НазначитьНаЗадачу" Тогда
		ВыбратьЗадачуИНазначитьНаНееРесурс(СтрокаДерева, ДополнительныеПараметры.Поле); 	
	ИначеЕсли ВыбранныйЭлемент.Значение = "ОтменитьНазначение" Тогда
		ОтменитьНазначениеНаЗадачу(СтрокаДерева); 
	ИначеЕсли ВыбранныйЭлемент.Значение = "ПереназначитьЗадачи" Тогда
		ПереназначитьЗадачиКлиент(СтрокаДерева.ТрудовойРесурс);		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьИНазначитьРесурсНаЗадачу(СтрокаДерева, Поле = Неопределено)
	
	// Режим совместимости 8.3.24 или "Не использовать".
	СписокРесурсов = СписокРесурсовПоРолиВДокументе(СтрокаДерева.Роль);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдСтроки", СтрокаДерева.ПолучитьИдентификатор());
	ОписаниеОповещенияЗавершениеВыборТР_Назначение = Новый ОписаниеОповещения("ЗавершениеВыборТР_Назначение",
			ЭтаФорма, ПараметрыОповещения);
	ПоказатьВыборИзМеню(ОписаниеОповещенияЗавершениеВыборТР_Назначение, СписокРесурсов, Поле);
	
КонецПроцедуры

&НаСервере
Функция СписокРесурсовПоРолиВДокументе(Роль)
	
	СписокРесурсов = Новый СписокЗначений;
	СтрокиРесурса = Объект.Ресурсы.НайтиСтроки(Новый Структура("Роль", Роль));
	Для Каждого СтрокаРесурса Из СтрокиРесурса Цикл
		СписокРесурсов.Добавить(СтрокаРесурса.ТрудовойРесурс);
	КонецЦикла;
	
	Возврат СписокРесурсов;
	
КонецФункции

&НаКлиенте
Процедура ОтменитьНазначениеНаЗадачу(СтрокаДерева) 

	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ИдСтроки", СтрокаДерева.ПолучитьИдентификатор());
	ОписаниеОповещенияЗавершениеОтменитьНазначениеНаЗадачу = Новый ОписаниеОповещения(
																	"ЗавершениеОтменитьНазначениеНаЗадачу", 
																	ЭтаФорма, 
																	ПараметрыОповещения);	
	ПоказатьВопрос(ОписаниеОповещенияЗавершениеОтменитьНазначениеНаЗадачу, 
					НСтр("ru = 'Отменить назначение ресурса на задачу?'"), 
					РежимДиалогаВопрос.ДаНет); 	

КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеОтменитьНазначениеНаЗадачу(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ОтменитьНазначениеНаЗадачуСервер(ДополнительныеПараметры.ИдСтроки);
	РазвернутьДерево();	

КонецПроцедуры

&НаСервере
Процедура ОтменитьНазначениеНаЗадачуСервер(ИдСтрокиПЗНижнегоУровня) 

	ИдСтроки = ИдСтрокиПЗНижнегоУровня;

	СтрокаДерева = ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
	СтруктураДанных = Новый Структура("ПроектнаяЗадача, ПроектнаяЗадачаЗеркало, Роль, ТрудовойРесурс, Подразделение,
	| ДатаЗавершенияТП, ДатаЗавершенияНП, ДатаНачалаТП, ДатаНачалаНП, ИтогПоПериодуПоРоли, ПрофильРаспределенияРоли");
	ЗаполнитьЗначенияСвойств(СтруктураДанных, СтрокаДерева);

	ЗагрузитьДанныеОбъектаИзФормы(Объект);

	Отбор = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, Роль");
	ЗаполнитьЗначенияСвойств(Отбор, СтруктураДанных);

	Строки = Объект.Данные.НайтиСтроки(Отбор);

	Отбор.ТрудовойРесурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	СтрокиБезРесурса = Объект.Данные.НайтиСтроки(Отбор);
	Если СтрокиБезРесурса.Количество() = 0 И Строки.Количество() > 0 Тогда 
		СтрокаБезРесурса = Объект.Данные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаБезРесурса, Строки[0]);
		СтрокаБезРесурса.ТрудовойРесурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
		СтрокаБезРесурса.Редактируется = Ложь;
		СтрокаБезРесурса.Записывать = Ложь;
		
		Отбор = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, Роль, ТипДанных");
		ЗаполнитьЗначенияСвойств(Отбор, СтруктураДанных);
		Отбор.ТипДанных = "ПоРоли";
		СтрокиРаспределения = Объект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
		Для Каждого Строка Из СтрокиРаспределения Цикл
			Строка.ТрудовойРесурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
		КонецЦикла;
	Иначе
		СтрокаБезРесурса = СтрокиБезРесурса[0];
	КонецЕсли;		

	Для Каждого Строка Из Строки Цикл
		СтрокаБезРесурса.ИтогНовоеЗначение = СтрокаБезРесурса.ИтогНовоеЗначение + Строка.ИтогНовоеЗначение;
		СтрокаБезРесурса.ТрудозатратыПланДоПериода = СтрокаБезРесурса.ТрудозатратыПланДоПериода 
													+ Строка.ТрудозатратыПланДоПериода;
		СтрокаБезРесурса.ТрудозатратыПланПослеПериода = СтрокаБезРесурса.ТрудозатратыПланПослеПериода 
													+ Строка.ТрудозатратыПланПослеПериода;
		Объект.Данные.Удалить(Строка);		
	КонецЦикла;

	Отбор = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, Роль");
	ЗаполнитьЗначенияСвойств(Отбор, СтруктураДанных);
	Отбор.Вставить("ТипДанных", "НовоеЗначение");	
	Строки = Объект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
	Отбор.ТрудовойРесурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	Отбор.Вставить("Дата");
	Для Каждого Строка Из Строки Цикл
		Отбор.Дата = Строка.Дата;
		СтрокиБезРесурса = Объект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
		Если СтрокиБезРесурса.Количество() > 0 Тогда
			СтрокиБезРесурса[0].Значение = СтрокиБезРесурса[0].Значение + Строка.Значение;
		Иначе
			СтрокаБезРесурса = Объект.РаспределениеПоПериоду.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаБезРесурса, Отбор);
			СтрокаБезРесурса.Подразделение = Строка.Подразделение;
			СтрокаБезРесурса.Значение = Строка.Значение;
		КонецЕсли;	
		Объект.РаспределениеПоПериоду.Удалить(Строка);		
	КонецЦикла;

	СтрокаОтмены = Объект.ОтменаНазначения.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаОтмены, СтруктураДанных);
	СтрокаОтмены.Записывать = Истина;

	Отбор = Новый Структура("ТрудовойРесурс");
	ЗаполнитьЗначенияСвойств(Отбор, СтруктураДанных);
	Если Объект.Данные.НайтиСтроки(Отбор).Количество() = 0 Тогда
		СтрокаДанных = Объект.Данные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанных, СтруктураДанных, "ТрудовойРесурс, Роль, Подразделение");	
		СтрокаДанных.Редактируется = Ложь;
		СтрокаДанных.Записывать = Ложь;		
	КонецЕсли;

	Отбор = Новый Структура("Подразделение, ПроектнаяЗадача, Роль, Ресурс");
	ЗаполнитьЗначенияСвойств(Отбор, СтруктураДанных);
	Отбор.Ресурс = СтруктураДанных.ТрудовойРесурс;
	СтрокиЗаПериодом = Объект.ТрудозатратыЗаПериодомПланирования.НайтиСтроки(Отбор);
	Если СтрокиЗаПериодом.Количество() > 0 Тогда
		Отбор.Ресурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
		Отбор.Вставить("Дата");
		Для Каждого Строка Из СтрокиЗаПериодом Цикл
			Отбор.Дата = Строка.Дата;
			СтрокиЗаПериодомБезРесурса = Объект.ТрудозатратыЗаПериодомПланирования.НайтиСтроки(Отбор);
			Если СтрокиЗаПериодомБезРесурса.Количество() = 0 Тогда
				СтрокаБезРесурса = Объект.ТрудозатратыЗаПериодомПланирования.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаБезРесурса, Отбор);
				СтрокаБезРесурса.Трудозатраты = Строка.Трудозатраты;
			Иначе
				Для Каждого СтрокаБезРесурса Из СтрокиЗаПериодомБезРесурса Цикл
					СтрокаБезРесурса.Трудозатраты = СтрокаБезРесурса.Трудозатраты + Строка.Трудозатраты;
				КонецЦикла;	
			КонецЕсли;	
			Объект.ТрудозатратыЗаПериодомПланирования.Удалить(Строка);
		КонецЦикла;	
	КонецЕсли;	

	ДанныеОбъекта_ОпределитьНовыеДатыПЗ(СтруктураДанных.ПроектнаяЗадача);

	ЗагрузитьДанныеФормыИзОбъекта();
	АдаптироватьЭлементы(ЭтаФорма);
	УстановитьВидимостьДоступностьЭлементовКлиентСервер(ЭтаФорма);	

КонецПроцедуры

&НаКлиенте
Процедура ПереназначитьЗадачиКлиент(ТрудовойРесурс) 

	ПереназначитьЗадачиСервер(ТрудовойРесурс);
	РазвернутьДерево();

КонецПроцедуры

&НаСервере
Процедура ПереназначитьЗадачиСервер(ТрудовойРесурс) 

	Если НЕ Объект.ПорядокГруппировок = 2 Тогда
		Возврат;	
	КонецЕсли;

	МассивДанныхПЗ = Новый Массив;
	МассивСтрок = Новый Массив;

	Для Каждого СтрокаВерхнегоУровня Из ДеревоФормы.ПолучитьЭлементы() Цикл
		Если НЕ СтрокаВерхнегоУровня.ТрудовойРесурс = ТрудовойРесурс Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаПЗ Из СтрокаВерхнегоУровня.ПолучитьЭлементы() Цикл
			Если Не ЗначениеЗаполнено(СтрокаПЗ.ПроектнаяЗадачаЗеркало) Тогда
				Продолжить;
			КонецЕсли;	
			СтруктураДанныхПЗ = ПолучитьСтруктуруДанныхДляНазначенияПоЗадаче();
			ЗаполнитьЗначенияСвойств(СтруктураДанныхПЗ, СтрокаПЗ);
			МассивДанныхПЗ.Добавить(СтруктураДанныхПЗ);
		КонецЦикла;
		Прервать;
	КонецЦикла;

	ПредСчетчик = Неопределено;
	Пока Истина Цикл
		СтрокиРесурса = мКэшЗначений.СтрокиРесурса_НижнийУровень.Получить(ТрудовойРесурс);
		БылаНепустаяСтрока = Ложь;
		Если ПредСчетчик <> Неопределено И ПредСчетчик = СтрокиРесурса.Количество() Тогда
			Прервать;
		КонецЕсли;
		ПредСчетчик = СтрокиРесурса.Количество();
		Для Каждого ИДСтрокиРесурса Из СтрокиРесурса Цикл
			СтрокаРесурса = ДеревоФормы.НайтиПоИдентификатору(ИДСтрокиРесурса);
			Если ЗначениеЗаполнено(СтрокаРесурса.ПроектнаяЗадача) Тогда
				ОтменитьНазначениеНаЗадачуСервер(СтрокаРесурса.ПолучитьИдентификатор());
				БылаНепустаяСтрока = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ БылаНепустаяСтрока Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтруктураДанныхПЗ Из МассивДанныхПЗ Цикл
		НазначитьРесурсНаЗадачуСервер(ТрудовойРесурс, , СтруктураДанныхПЗ);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗадачуИНазначитьНаНееРесурс(СтрокаДерева, Поле = Неопределено)
	
	// Режим совместимости 8.3.24 или "Не использовать".
	СписокПЗ = СписокПроектныхЗадачДляНазначенияТРПоРоли(СтрокаДерева.Роль);
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ТрудовойРесурс", СтрокаДерева.ТрудовойРесурс);
	ОписаниеОповещенияЗавершениеВыборПЗ_Назначение = Новый ОписаниеОповещения("ЗавершениеВыборПЗ_Назначение",
			ЭтаФорма, ПараметрыОповещения);
	ПоказатьВыборИзМеню(ОписаниеОповещенияЗавершениеВыборПЗ_Назначение, СписокПЗ, Поле);
	
КонецПроцедуры

&НаСервере
Функция СписокПроектныхЗадачДляНазначенияТРПоРоли(Роль)
	
	СписокПЗ = Новый СписокЗначений;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Роль", Роль);
	Отбор.Вставить("ТрудовойРесурс", ПредопределенноеЗначение("Справочник.упоТрудовыеРесурсы.ПустаяСсылка"));
	
	СтрокиПЗ = Объект.Данные.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаПЗ Из СтрокиПЗ Цикл
		
		МассивИД = мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(СтрокаПЗ.ПроектнаяЗадачаЗеркало);
		Для Каждого ИД Из МассивИД Цикл
			
			СтрокаПоИД = ДеревоФормы.НайтиПоИдентификатору(ИД);
			
			РазрешенныйНомерСтатуса = 2; // ПЗ не закрыта и не завершена.
			
			МожноРедактировать = СтрокаПоИД.ЕстьПраваНаРедактирование
				И СтрокаПоИД.НомерСтатусаЗадачи >= РазрешенныйНомерСтатуса;
			ЕстьОстатокПоРоли = (СтрокаПоИД.Роль = Роль)
				И Не ЗначениеЗаполнено(СтрокаПоИД.ТрудовойРесурс);
			
			Если МожноРедактировать И ЕстьОстатокПоРоли Тогда
				СписокПЗ.Добавить(ИД, ПредставлениеЗадачиВСтрокеДерева(СтрокаПоИД));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СписокПЗ;
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеВыборТР_Назначение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НазначитьРесурсНаЗадачуКлиент(ДополнительныеПараметры.ИдСтроки, ВыбранныйЭлемент.Значение);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыборПЗ_Назначение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НазначитьРесурсНаЗадачуКлиент(ВыбранныйЭлемент.Значение, ДополнительныеПараметры.ТрудовойРесурс);
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьРесурсНаЗадачуКлиент(УИДСтрокиЗадачи, ТрудовойРесурс)
	
	СтрокаДерева = ДеревоФормы.НайтиПоИдентификатору(УИДСтрокиЗадачи);
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТрудовойРесурсНазначенНаРоль = ТрудовойРесурсНазначенНаРоль(ТрудовойРесурс, СтрокаДерева.Роль);
	Если Не ТрудовойРесурсНазначенНаРоль Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ПараметрыНазначения = Новый Структура();
	// Режим совместимости 8.3.24 или "Не использовать".
	ЗаполнитьПараметрыНазначенияРесурсаНаЗадачу(ПараметрыНазначения, УИДСтрокиЗадачи,
		ТрудовойРесурс, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Документ.упоПланированиеТрудозатратПоТрудовымРесурсам.Форма.ПараметрыНазначения",
		ПараметрыНазначения, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыНазначенияРесурсаНаЗадачу(ПараметрыНазначения,
													УИДСтрокиЗадачи,
													ТрудовойРесурс,
													Отказ = Ложь)
	
	СтрокаДерева = ДеревоФормы.НайтиПоИдентификатору(УИДСтрокиЗадачи);
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыНазначения.Вставить("УИДСтрокиЗадачи", УИДСтрокиЗадачи);
	ПараметрыНазначения.Вставить("ТрудовойРесурс", ТрудовойРесурс);
	ПараметрыНазначения.Вставить("ПроектнаяЗадачаЗеркало", СтрокаДерева.ПроектнаяЗадачаЗеркало);
	ПараметрыНазначения.Вставить("Роль", СтрокаДерева.Роль);
	ПараметрыНазначения.Вставить("МинимальнаяДатаСтарта", Макс(СтрокаДерева.ДатаНачалаТП, НачалоПериодаНаФорме));
	Если ЗначениеЗаполнено(СтрокаДерева.ПрофильРаспределенияРоли) Тогда
		ПараметрыНазначения.Вставить("ПрофильРаспределения", СтрокаДерева.ПрофильРаспределенияРоли);
	Иначе
		ПараметрыНазначения.Вставить("ПрофильРаспределения", 
			ПредопределенноеЗначение("Справочник.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение"));
	КонецЕсли;
	Отбор = Новый Структура("ПроектнаяЗадача, Роль, ТрудовойРесурс");
	Если Объект.ПорядокГруппировок = 1 И Не ЗначениеЗаполнено(СтрокаДерева.ПроектнаяЗадача) Тогда
		ОтборЗеркало = Новый Структура("ПроектнаяЗадачаЗеркало", СтрокаДерева.ПроектнаяЗадачаЗеркало);
		мНайденныеСтроки = Объект.Данные.НайтиСтроки(ОтборЗеркало); 
		Если мНайденныеСтроки.Количество() = 0 Тогда
			Отказ = Истина;
			Возврат;
		Иначе
			Отбор.ПроектнаяЗадача = мНайденныеСтроки[0].ПроектнаяЗадача;
		КонецЕсли;	
	Иначе	
		Отбор.ПроектнаяЗадача = СтрокаДерева.ПроектнаяЗадача;
	КонецЕсли;	
	Отбор.Роль = СтрокаДерева.Роль;
	Отбор.ТрудовойРесурс = ПредопределенноеЗначение("Справочник.упоТрудовыеРесурсы.ПустаяСсылка");
	мНайденныеСтроки = Объект.Данные.НайтиСтроки(Отбор);
	Если мНайденныеСтроки.Количество() > 0 Тогда
		ПараметрыНазначения.Вставить("КоличествоЧасовПоРоли", мНайденныеСтроки[0].ИтогПоРоли);
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	мНайденныеСтроки = Объект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
	ИтогПоПериодуНовоеЗначение = 0;

	ИтогПоПериодуПоРоли = 0;
	Для Каждого НайденнаяСтрока Из мНайденныеСтроки Цикл
		Если НайденнаяСтрока.ТипДанных = "НовоеЗначение" Тогда
			ИтогПоПериодуНовоеЗначение = ИтогПоПериодуНовоеЗначение + НайденнаяСтрока.Значение; 	
		ИначеЕсли НайденнаяСтрока.ТипДанных = "ПоРоли" Тогда
			ИтогПоПериодуПоРоли = ИтогПоПериодуПоРоли + НайденнаяСтрока.Значение;
		КонецЕсли;	
	КонецЦикла;	

	ОстатокПоРолиЗаВсеВремя = ПараметрыНазначения.КоличествоЧасовПоРоли;
	мСтрокНижнегоУровня = мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(СтрокаДерева.ПроектнаяЗадачаЗеркало);
	Для каждого СтрокаНижнегоУровня Из мСтрокНижнегоУровня Цикл
		СтрокаНижнегоУровняДерева = ДеревоФормы.НайтиПоИдентификатору(СтрокаНижнегоУровня);
		Если Не ЗначениеЗаполнено(СтрокаНижнегоУровняДерева.ТрудовойРесурс) 
			И СтрокаНижнегоУровняДерева.Роль = СтрокаДерева.Роль Тогда
			ОстатокПоРолиЗаВсеВремя = СтрокаНижнегоУровняДерева.ИтогНовоеЗначение; 
			Прервать;
		КонецЕсли;	
	КонецЦикла;	

	ПараметрыНазначения.Вставить("КоличествоЧасов", Мин(ИтогПоПериодуНовоеЗначение, ОстатокПоРолиЗаВсеВремя));
	ПараметрыНазначения.Вставить("КоличествоЧасовПоРолиЗаПериод", ИтогПоПериодуПоРоли);

КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруДанныхДляНазначенияПоЗадаче() 
	
	СтруктураДанных = Новый Структура("ПроектнаяЗадача, ПроектнаяЗадачаЗеркало, Роль, Подразделение,
					| ДатаЗавершенияТП, ДатаЗавершенияНП, ДатаНачалаТП, ДатаНачалаНП, 
					| ИтогПоПериодуПоРоли, ИтогПоПериодуНовоеЗначение, ПрофильРаспределенияРоли");
	Возврат СтруктураДанных;
	
КонецФункции

&НаСервереБезКонтекста
Функция НоваяТаблицаРесурсов()
	
	ТаблицаРесурсов = Новый ТаблицаЗначений;
	ТаблицаРесурсов.Колонки.Добавить("ПрофильРаспределения");
	ТаблицаРесурсов.Колонки.Добавить("ЕдиницаНормирования");
	ТаблицаРесурсов.Колонки.Добавить("Количество");
	ТаблицаРесурсов.Колонки.Добавить("Ресурс");
	ТаблицаРесурсов.Колонки.Добавить("Роль");
	ТаблицаРесурсов.Колонки.Добавить("СпособПривязки");
	ТаблицаРесурсов.Колонки.Добавить("ОбщСтоимость");
	ТаблицаРесурсов.Колонки.Добавить("ОбщВнешняяСтоимость");		
	ТаблицаРесурсов.Колонки.Добавить("Стоимость");
	ТаблицаРесурсов.Колонки.Добавить("ВнешняяСтоимость");
	ТаблицаРесурсов.Колонки.Добавить("УровеньПланирования");
	ТаблицаРесурсов.Колонки.Добавить("Подразделение");
    ТаблицаРесурсов.Колонки.Добавить("ИсточникПлана");

	Возврат ТаблицаРесурсов;
	
КонецФункции	

&НаСервере
Функция НайтиСоздатьСтрокуДанныхРесурса(СтруктураДанных, Ресурс)
	
	СтрокаДанных = Неопределено;
	
	ИтогПоРоли = 0;
	Отбор = Новый Структура("ПроектнаяЗадача, Роль", СтруктураДанных.ПроектнаяЗадача, СтруктураДанных.Роль);
	СтрокиПоПЗ = Объект.Данные.Выгрузить(Отбор, "ИтогПоРоли");
	Если СтрокиПоПЗ.Количество() > 0 Тогда
		СтрокиПоПЗ.Сортировать("ИтогПоРоли Убыв");
		ИтогПоРоли = СтрокиПоПЗ[0].ИтогПоРоли;
	КонецЕсли;
	
	Отбор = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс", СтруктураДанных.ПроектнаяЗадача, Ресурс);
	мНайденныеСтроки = Объект.Данные.НайтиСтроки(Отбор);
	Если мНайденныеСтроки.Количество() = 0 Тогда
		СтрокаДанных = Объект.Данные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанных, СтруктураДанных);
		СтрокаДанных.Редактируется = Истина;
		СтрокаДанных.Записывать = Истина;
		СтрокаДанных.ТрудовойРесурс = Ресурс;
		СтрокаДанных.ИтогПоРоли = ИтогПоРоли;
	Иначе
		Если мНайденныеСтроки[0].Роль <> СтруктураДанных.Роль Тогда
			ШаблонСообщения = НСтр("ru = 'Трудовой ресурс ""%1"" уже выделен на задачу ""%2"" по роли ""%3.""'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения,
					Ресурс,
					СтруктураДанных.ПроектнаяЗадачаЗеркало,
					мНайденныеСтроки[0].Роль);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат СтрокаДанных;
		Иначе
			СтрокаДанных = мНайденныеСтроки[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаДанных;
	
КонецФункции

&НаСервере
Функция ДатаЗавершенияПоПараметрамНазначения(ПараметрыНазначения, ЭтоДобавлениеВОчередь, ДатаЗавершенияТП)
	
	Если ПараметрыНазначения = Неопределено Или ЭтоДобавлениеВОчередь Тогда																																																						
		ДатаЗавершения = Неопределено;																									
	ИначеЕсли ПараметрыНазначения.Свойство("РаспределятьНаПериодПланирования") 
		И ПараметрыНазначения.РаспределятьНаПериодПланирования Тогда
		ДатаЗавершения = Мин(ДатаЗавершенияТП, Объект.КонецПериода);																									
	Иначе																													
		ДатаЗавершения = ДатаЗавершенияТП;																									
	КонецЕсли;
	
	Возврат ДатаЗавершения;
	
КонецФункции

&НаСервере
Функция РассчитатьНазначенныеЧасы(ПараметрыНазначения, СтруктураДанных, Ресурс)
	
	КоличествоЧасовНазначено = 0;
	СтруктураОтбора = Новый Структура("ПроектнаяЗадача, Роль, ТрудовойРесурс, ТипДанных", 
										СтруктураДанных.ПроектнаяЗадача, 
										СтруктураДанных.Роль, 
										Ресурс,
										"НовоеЗначение");
	СтрокиРаспределения = Объект.РаспределениеПоПериоду.НайтиСтроки(СтруктураОтбора);
	Для Каждого Строка Из СтрокиРаспределения Цикл
		КоличествоЧасовНазначено = КоличествоЧасовНазначено + Строка.Значение;	
	КонецЦикла;
	
	НеРаспределятьНаПериодПланирования = ПараметрыНазначения <> Неопределено 
		И ПараметрыНазначения.Свойство("РаспределятьНаПериодПланирования") 
		И Не ПараметрыНазначения.РаспределятьНаПериодПланирования; 
	
	Если НеРаспределятьНаПериодПланирования Тогда
		
		мУдалить = Новый Массив;
		СтруктураОтбора = Новый Структура("ПроектнаяЗадача, Роль, Ресурс", 
											СтруктураДанных.ПроектнаяЗадача, 
											СтруктураДанных.Роль, 
											Ресурс);
		СтрокиРаспределения = Объект.ТрудозатратыЗаПериодомПланирования.НайтиСтроки(СтруктураОтбора);
		СтруктураОтбора = Новый Структура("ПроектнаяЗадача, Роль, Ресурс, Дата", 
											СтруктураДанных.ПроектнаяЗадача, 
											СтруктураДанных.Роль, 
											Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
		Для Каждого Строка Из СтрокиРаспределения Цикл
			Если Строка.Дата > Объект.НачалоПериода Тогда
				КоличествоЧасовНазначено = КоличествоЧасовНазначено + Строка.Трудозатраты;
				СтруктураОтбора.Дата = Строка.Дата;
				СтрокиРаспределенияБезРесурса = Объект.ТрудозатратыЗаПериодомПланирования.НайтиСтроки(СтруктураОтбора);
				Для Каждого СтрокаБезРесурса Из СтрокиРаспределенияБезРесурса Цикл
					СтрокаБезРесурса.Трудозатраты = СтрокаБезРесурса.Трудозатраты + Строка.Трудозатраты;
				КонецЦикла;	
				мУдалить.Добавить(Строка);
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Строка Из мУдалить Цикл
			Объект.ТрудозатратыЗаПериодомПланирования.Удалить(Строка);	
		КонецЦикла;	
		
	КонецЕсли;	
	
	Возврат КоличествоЧасовНазначено;
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьСтрокуРесурса(СтрокаРесурсов, СтруктураДанных, Ресурс, ПараметрыНазначения, ЭтоДобавлениеВОчередь)
	
	СтрокаРесурсов.ЕдиницаНормирования = Справочники.упоЕдиницыВремени.Час;

	СтрокаРесурсов.Ресурс = Ресурс;
	СтрокаРесурсов.Роль = СтруктураДанных.Роль;	
	СтрокаРесурсов.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;
	СтрокаРесурсов.УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
	СтрокаРесурсов.ОбщСтоимость = 0;
	СтрокаРесурсов.Стоимость = 0;
	СтрокаРесурсов.ОбщВнешняяСтоимость = 0;
	СтрокаРесурсов.ВнешняяСтоимость = 0;		
    СтрокаРесурсов.ИсточникПлана = Перечисления.упоИсточникПланаТрудозатратРолей.Трудозатраты;
		
	Если ПараметрыНазначения = Неопределено Тогда 
		СтрокаРесурсов.ПрофильРаспределения = Справочники.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение;
		СтрокаРесурсов.Количество = СтруктураДанных.ИтогПоПериодуНовоеЗначение; // ИтогПоПериодуПоРоли
	Иначе
		Если ЭтоДобавлениеВОчередь Тогда
			СтрокаРесурсов.ПрофильРаспределения = Справочники.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение;
			СтрокаРесурсов.Количество = ПараметрыНазначения.КоличествоЧасов;
		Иначе	
			СтрокаРесурсов.ПрофильРаспределения = ПараметрыНазначения.ПрофильРаспределения;
						
			КоличествоЧасовНазначено = РассчитатьНазначенныеЧасы(ПараметрыНазначения, СтруктураДанных, Ресурс);												
			СтрокаРесурсов.Количество = ПараметрыНазначения.КоличествоЧасов + КоличествоЧасовНазначено;			
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры	

&НаСервере
Процедура НазначитьРесурсНаЗадачуСервер(Ресурс, 
									ИдСтрокиПЗНижнегоУровня = Неопределено, 
									СтруктураДанных = Неопределено, 										
									ПараметрыНазначения = Неопределено) 

	Если НЕ ИдСтрокиПЗНижнегоУровня = Неопределено Тогда

		ИдСтроки = ИдСтрокиПЗНижнегоУровня;

		СтрокаДерева = ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
		Если Объект.ПорядокГруппировок = 1 И СтрокаДерева.ИмяГруппировки = "Роль" Тогда
			ЭлементыСтрокиДерева = СтрокаДерева.ПолучитьЭлементы();
			Если ЭлементыСтрокиДерева.Количество() = 0 Тогда
				Возврат;
			Иначе
				СтрокаДерева = ЭлементыСтрокиДерева[0];
			КонецЕсли;	
		КонецЕсли;	
		СтруктураДанных = ПолучитьСтруктуруДанныхДляНазначенияПоЗадаче();
		ЗаполнитьЗначенияСвойств(СтруктураДанных, СтрокаДерева);
		
	ИначеЕсли СтруктураДанных = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;

	ЗагрузитьДанныеОбъектаИзФормы(Объект);

	СтрокаДанных = НайтиСоздатьСтрокуДанныхРесурса(СтруктураДанных, Ресурс);
	Если СтрокаДанных = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;		
	
	СтруктураОтбора = Новый Структура("ТрудовойРесурс, ТипДанных", Ресурс, "НовоеЗначение");
	СтрокиРаспределения = Объект.РаспределениеПоПериоду.НайтиСтроки(СтруктураОтбора);
	
	ЭтоДобавлениеВОчередь = ПараметрыНазначения <> Неопределено И ПараметрыНазначения.ДобавитьВОчередь;		

	Если ПараметрыНазначения = Неопределено Или ЭтоДобавлениеВОчередь Тогда
		МаксДата = Дата(1, 1, 1);
		Для Каждого Строка Из СтрокиРаспределения Цикл
			Если ЗначениеЗаполнено(Строка.Значение) И МаксДата < Строка.Дата Тогда
				МаксДата = Строка.Дата;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗначениеЗаполнено(МаксДата) Тогда
			МаксДата = Объект.НачалоПериода;
		Иначе
			ДеньВСекундах = 24 * 3600;
			МаксДата = МаксДата + ДеньВСекундах;
		КонецЕсли;
	Иначе
		МаксДата = ПараметрыНазначения.ДатаСтарта;
	КонецЕсли;

	ТаблицаРесурсов = НоваяТаблицаРесурсов();
	
	СтрокаРесурсов = ТаблицаРесурсов.Добавить();
	
	ЗаполнитьСтрокуРесурса(СтрокаРесурсов, СтруктураДанных, Ресурс, ПараметрыНазначения, ЭтоДобавлениеВОчередь);

	// 		
	
	КалендарьЗадачи = КалендарьЗадачи(СтруктураДанных.ПроектнаяЗадача);
	
	ДатаЗавершения = ДатаЗавершенияПоПараметрамНазначения(ПараметрыНазначения, 
														ЭтоДобавлениеВОчередь, 
														КонецДня(СтрокаДанных.ДатаЗавершенияТП));	
	
	РезультатРаспределения = упоРаспределениеТрудозатратВызовСервера.РаспределитьТрудозатратыПоПрофилям(ТаблицаРесурсов, 
																										КалендарьЗадачи, 
																										МаксДата, 
																										ДатаЗавершения, 
																										Ложь);		
																										
	ОбработатьРезультатРаспределения(РезультатРаспределения, СтруктураДанных, Ресурс, МаксДата);																				
		
	Если Объект.КонецПериода < МаксДата Тогда
		
		ПересчитатьТрудозатратыПриРасширенииПериода(МаксДата);
		
		Объект.КонецПериода = МаксДата;
		
	КонецЕсли;

	Отбор = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс", СтруктураДанных.ПроектнаяЗадача, Ресурс);	
	СтрокиОтмены = Объект.ОтменаНазначения.НайтиСтроки(Отбор);
	Для Каждого СтрокаОтмены Из СтрокиОтмены Цикл
		Объект.ОтменаНазначения.Удалить(СтрокаОтмены);	
	КонецЦикла;

	ДанныеОбъекта_ОпределитьНовыеДатыПЗ(СтруктураДанных.ПроектнаяЗадача);

	ДанныеОбъекта_УдалитьПустыеДанныеПоТР(Ресурс);

	ЗагрузитьДанныеФормыИзОбъекта();
	АдаптироватьЭлементы(ЭтаФорма);
	УстановитьВидимостьДоступностьЭлементовКлиентСервер(ЭтаФорма);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КалендарьЗадачи(ПроектнаяЗадача)
	
	КалендарьЗадачи = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача, 
																			"КалендарьЗадачи");
	Если ЗначениеЗаполнено(КалендарьЗадачи) Тогда
		Календарь = КалендарьЗадачи;
	Иначе
		ПроектЗадачи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "Проект");
		Календарь = Справочники.Проекты.ПолучитьРабочийКалендарь(ПроектЗадачи);
	КонецЕсли;
	
	Возврат Календарь;
	
КонецФункции

&НаСервере
Процедура ОбработатьРезультатРаспределения(РезультатРаспределения, СтруктураДанных, Ресурс, МаксДата)
	
	Если РезультатРаспределения = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	Если РезультатРаспределения.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	ОтборСтрокиРаспределения = Новый Структура("ПроектнаяЗадача, Роль, Подразделение, ТрудовойРесурс, Дата, ТипДанных");
	ЗаполнитьЗначенияСвойств(ОтборСтрокиРаспределения, СтруктураДанных);
	ОтборСтрокиРаспределения.ТипДанных = "НовоеЗначение";
	ОтборСтрокиРаспределения.ТрудовойРесурс = Ресурс;
	
	ОтборСтрокиБезРесурса = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, Роль, Подразделение, ТипДанных, Дата");
	ЗаполнитьЗначенияСвойств(ОтборСтрокиБезРесурса, СтруктураДанных);
	ОтборСтрокиБезРесурса.ТрудовойРесурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	ОтборСтрокиБезРесурса.ТипДанных = "НовоеЗначение";	
		
	Для Каждого СтрокаЗагрузки Из РезультатРаспределения.Строки[0].Строки Цикл
		
		Разница = 0;
		ОтборСтрокиРаспределения.Дата = СтрокаЗагрузки.День;
		СтрокиРаспределения = Объект.РаспределениеПоПериоду.НайтиСтроки(ОтборСтрокиРаспределения);
		Если СтрокиРаспределения.Количество() > 0 Тогда
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл
				Разница = СтрокаЗагрузки.Трудозатраты - СтрокаРаспределения.Значение;
				СтрокаРаспределения.Значение = СтрокаЗагрузки.Трудозатраты; 
			КонецЦикла;	
		Иначе				
			СтрокаНов = Объект.РаспределениеПоПериоду.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНов, ОтборСтрокиРаспределения);
			СтрокаНов.Значение = СтрокаЗагрузки.Трудозатраты;
			Разница = СтрокаЗагрузки.Трудозатраты;
		КонецЕсли;
		
		МаксДата = Макс(МаксДата, СтрокаЗагрузки.День);
		
		ОтборСтрокиБезРесурса.Дата = СтрокаЗагрузки.День;
		СтрокиБезРесурса = Объект.РаспределениеПоПериоду.НайтиСтроки(ОтборСтрокиБезРесурса);
		Если СтрокиБезРесурса.Количество() > 0 Тогда
			СтрокиБезРесурса[0].Значение = СтрокиБезРесурса[0].Значение - Разница; // СтрокаЗагрузки.Трудозатраты;
		Иначе	
			СтрокаБезРесурсаНов = Объект.РаспределениеПоПериоду.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаБезРесурсаНов, ОтборСтрокиБезРесурса);
			СтрокаБезРесурсаНов.Значение = - Разница; // СтрокаЗагрузки.Трудозатраты;
		КонецЕсли;	
		
	КонецЦикла;			
	
КонецПроцедуры

&НаСервере
Процедура ДанныеОбъекта_УдалитьПустыеДанныеПоТР(Ресурс) 

	СтруктураОтбора = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс", 
									Документы.упоПроектнаяЗадача.ПустаяСсылка(), Ресурс);
	Строки = Объект.РаспределениеПоПериоду.НайтиСтроки(СтруктураОтбора);	
	Для Каждого Строка Из Строки Цикл
		Объект.РаспределениеПоПериоду.Удалить(Строка);	
	КонецЦикла;
	Строки = Объект.Данные.НайтиСтроки(СтруктураОтбора);	
	Для Каждого Строка Из Строки Цикл
		Объект.Данные.Удалить(Строка);	
	КонецЦикла;	

КонецПроцедуры

&НаСервере
Процедура ДанныеОбъекта_УдалитьДанныеРаспределения(Ресурс, ПроектнаяЗадача, 
	ТипДанных = "НовоеЗначение", Роль = Неопределено) 

	СтруктураОтбора = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, ТипДанных", ПроектнаяЗадача, Ресурс, ТипДанных);
	Если Роль <> Неопределено Тогда
		СтруктураОтбора.Вставить("Роль", Роль);	
	КонецЕсли;
	Строки = Объект.РаспределениеПоПериоду.НайтиСтроки(СтруктураОтбора);	
	Для Каждого Строка Из Строки Цикл
		Объект.РаспределениеПоПериоду.Удалить(Строка);	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУстановитьТрудозатратыВСтрокеПоИсточнику(СтрокаПриемник, Значение, ИмяПоля)

	Если Не СтрокаПриемник.ЕстьПраваНаРедактирование Тогда
		Возврат;		
	КонецЕсли;

	ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоИмениЭлемента(ИмяПоля); 
	Если ИмяКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПолеПриемник = ИмяКолонки + "НовоеЗначение";

	Если ЯчейкуМожноРедактировать(СтрокаПриемник, ПолеПриемник) Тогда
		РазмерМассиваЗначенияПриПеретаскивании = 3;
		Если ТипЗнч(Значение) = Тип("Массив") 
			И Значение.Количество() = РазмерМассиваЗначенияПриПеретаскивании 
			И Значение[0] = ("Перетаскивание" + ЭтаФорма.УникальныйИдентификатор) Тогда
			
			СтрокаИсточник = ДеревоФормы.НайтиПоИдентификатору(Значение[1]); 
			ПолеИсточник = Значение[2];
			УстановитьТрудозатраты(ЭтаФорма, 
									СтрокаПриемник, 
									ПолеПриемник, 
									СтрокаПриемник[ПолеПриемник] + СтрокаИсточник[ПолеИсточник]);
			Если ЯчейкуМожноРедактировать(СтрокаИсточник, ПолеИсточник) Тогда
				СтрокаИсточник[ПолеИсточник] = 0;	
				УстановитьТрудозатраты(ЭтаФорма, СтрокаИсточник, ПолеИсточник, 0);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() > 0 И ТипЗнч(Значение[0]) = Тип("Число") Тогда
			УстановитьТрудозатраты(ЭтаФорма, СтрокаПриемник, ПолеПриемник, СтрокаПриемник[ПолеПриемник] + Значение[0]);
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
			УстановитьТрудозатраты(ЭтаФорма, СтрокаПриемник, ПолеПриемник, СтрокаПриемник[ПолеПриемник] + Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда	
			Попытка
				Значение = Число(Значение);
				УстановитьТрудозатраты(ЭтаФорма, СтрокаПриемник, ПолеПриемник, СтрокаПриемник[ПолеПриемник] + Значение);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры	

&НаКлиенте
Функция ЯчейкуМожноРедактировать(Строка, Поле) 
	
	Возврат Строка.Редактируется 
			И Строка.ПоследнийУровень 
			И Прав(Поле, 13) = "НовоеЗначение";

КонецФункции

&НаКлиенте
Процедура УдалитьПустыеСтрокиИзСпискаПроектов()

	Если Не ЗначениеЗаполнено(СписокПроектов) Тогда
		Возврат;	
	КонецЕсли;
	
	СтрокиКУдалению = Новый Массив;
	
	Для каждого Строка Из СписокПроектов Цикл
		Если Не ЗначениеЗаполнено(Строка.Значение) Тогда
			СтрокиКУдалению.Добавить(Строка);
		КонецЕсли;
	КонецЦикла; 
	
	Для Каждого УдалаяемаяСтрока Из СтрокиКУдалению Цикл
		СписокПроектов.Удалить(УдалаяемаяСтрока);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОтборыИзФормы(тОбъект)

	тОбъект.Роли.Очистить();
	Для Каждого ЭлементРоли Из СписокРолей Цикл	
		СтрокаРоли = тОбъект.Роли.Добавить();	
		СтрокаРоли.Роль = ЭлементРоли.Значение;
	КонецЦикла;
	
	тОбъект.Подразделения.Очистить();
	Для Каждого ЭлементПодразделение Из СписокПодразделений Цикл
		СтрокаПроекта = тОбъект.Подразделения.Добавить();	
		СтрокаПроекта.Подразделение = ЭлементПодразделение.Значение;
	КонецЦикла;
	
	тОбъект.Проекты.Очистить();
	Для Каждого ЭлементПроект Из СписокПроектов Цикл
		Если ЗначениеЗаполнено(ЭлементПроект.Значение) Тогда
			СтрокаПроекта = тОбъект.Проекты.Добавить();	
			СтрокаПроекта.Проект = ЭлементПроект.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ТрудовойРесурсНазначенНаРоль(ТрудовойРесурс, Роль)
	
	РолиРесурса = упоРесурсыИРолиВызовСервера.обПолучитьТекщиеРолиТрудовогоРесурса(ТрудовойРесурс);
	ТрудовойРесурсНазначенНаРоль = РолиРесурса.Найти(Роль) <> Неопределено;
	
	Возврат ТрудовойРесурсНазначенНаРоль;
	
КонецФункции

&НаСервере
Функция СписокТрудовыхРесурсовИзТаблицы()
	
	ДанныеВыбора = Новый СписокЗначений;
	
	Для Каждого Строка Из Объект.Ресурсы Цикл
		Если ДанныеВыбора.НайтиПоЗначению(Строка.ТрудовойРесурс) = Неопределено Тогда
			ДанныеВыбора.Добавить(Строка.ТрудовойРесурс);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеВыбора;
	
КонецФункции

#КонецОбласти
