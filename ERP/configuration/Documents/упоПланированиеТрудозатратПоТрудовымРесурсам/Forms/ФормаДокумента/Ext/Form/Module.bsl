&НаКлиенте
Процедура СдвинутьНаПериод(Вперед = Истина) 
	
	ПоследовательностьКолонок = ПолучитьПоследовательностьКолонок(Вперед);		
	КоличествоКолонок = ПоследовательностьКолонок.Количество();
	МассивВыделенныхСтрок = ПолучитьМассивВыделенныхСтрок();
	Для Каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл
		Если Не ВыделеннаяСтрока.ЕстьПраваНаРедактирование Тогда
			Продолжить;
		КонецЕсли;	
		сч = ПоследовательностьКолонок.Количество()-1;
		Пока сч >= 1 Цикл			
			ТекКолонка = ПоследовательностьКолонок[сч];
			ПредКолонка = ПоследовательностьКолонок[сч-1];			
			Если ВыделеннаяСтрока[ПредКолонка+"НовоеЗначение"] <> 0 Тогда
				УстановитьТрудозатраты(ЭтаФорма, ВыделеннаяСтрока, ТекКолонка, 
						ВыделеннаяСтрока[ТекКолонка+"НовоеЗначение"] + ВыделеннаяСтрока[ПредКолонка+"НовоеЗначение"]);
				УстановитьТрудозатраты(ЭтаФорма, ВыделеннаяСтрока, ПредКолонка, 0);						
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМассивВыделенныхСтрок(МассивСтрок = Неопределено, Строка = Неопределено) 

	Если МассивСтрок = Неопределено Тогда
		МассивСтрок = Новый Массив;				
	КонецЕсли;

	Если Строка = Неопределено Тогда
		Для Каждого Ид Из Элементы.ДеревоФормы.ВыделенныеСтроки Цикл
			тСтрока = ДеревоФормы.НайтиПоИдентификатору(Ид);
			ПолучитьМассивВыделенныхСтрок(МассивСтрок, тСтрока);
		КонецЦикла;		
	ИначеЕсли НЕ Строка.ПоследнийУровень Тогда
		тЭлементы = Строка.ПолучитьЭлементы();
		Для Каждого тЭлемент Из тЭлементы Цикл
			ПолучитьМассивВыделенныхСтрок(МассивСтрок, тЭлемент);
		КонецЦикла;
	Иначе
		МассивСтрок.Добавить(Строка);	
	КонецЕсли;

	Возврат МассивСтрок;

КонецФункции

&НаКлиенте
Функция ПолучитьПоследовательностьКолонок(Вперед = Истина, УчитыватьВыходные = Ложь) 
	
	ПоследовательностьКолонок = Новый Массив;
	Если Вперед Тогда
		Для Каждого СтрокаКолонок Из КолонкиДат Цикл
			Если НЕ СтрокаКолонок.Выходной ИЛИ УчитыватьВыходные Тогда
				ПоследовательностьКолонок.Добавить(СтрокаКолонок.ИмяКолонки);
			КонецЕсли;
		КонецЦикла;
	Иначе
		сч = КолонкиДат.Количество() - 1;
		Пока сч >= 0 Цикл
			СтрокаКолонок = КолонкиДат[сч]; 
			Если НЕ СтрокаКолонок.Выходной ИЛИ УчитыватьВыходные Тогда
				ПоследовательностьКолонок.Добавить(СтрокаКолонок.ИмяКолонки);	
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПоследовательностьКолонок;
	
КонецФункции

&НаКлиенте
Процедура РесурсДиаграммыПоРесурсуПриИзменении(Элемент)
	
	упоПланированиеТрудозатратКлиентСервер.ПостроитьДиаграмму(ЭтаФорма, "ПоРесурсам");
	ПостроитьДиаграммуГанта(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьЗадачуСервер(ИдСтрокиНижнегоУровня, Направление) 

	ИдСтроки = ИдСтрокиНижнегоУровня;

	СтрокаДерева = ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
	ДанныеПЗ = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, ПроектнаяЗадачаЗеркало, Роль, Подразделение,
					| ДанныеПЗ, ДатаЗавершенияНП, ДатаНачалаТП, ДатаНачалаНП, ИтогПоПериодуПоРоли");
	ЗаполнитьЗначенияСвойств(ДанныеПЗ, СтрокаДерева);

	ЗагрузитьДанныеОбъектаИзФормы(Объект);	

	ГраницыЗагрузки = ДанныеОбъекта_ОпределитьГраницыЗагрузки(ДанныеПЗ.ПроектнаяЗадача, ДанныеПЗ.ТрудовойРесурс, ДанныеПЗ.Роль, "НовоеЗначение", Истина);

	Если ГраницыЗагрузки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеПредПЗ = ДанныеОбъекта_ОпределитьЗадачуПред(ДанныеПЗ.ТрудовойРесурс, ГраницыЗагрузки.Начало, ГраницыЗагрузки.Конец, Направление, "НовоеЗначение"); 

	Если ДанныеПредПЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если НЕ ДанныеОбъекта_ДанныеМожноРедактировать(ДанныеПредПЗ.ПроектнаяЗадача, ДанныеПЗ.ТрудовойРесурс, ДанныеПредПЗ.Роль) Тогда
		Возврат;		
	КонецЕсли;

	ГраницыЗагрузкиПредПЗ = ДанныеОбъекта_ОпределитьГраницыЗагрузки(ДанныеПредПЗ.ПроектнаяЗадача, ДанныеПЗ.ТрудовойРесурс, ДанныеПредПЗ.Роль, "НовоеЗначение", Истина);

	Если ГраницыЗагрузкиПредПЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеОбъекта_УдалитьДанныеРаспределения(ДанныеПЗ.ТрудовойРесурс, ДанныеПЗ.ПроектнаяЗадача, "НовоеЗначение", ДанныеПЗ.Роль);
	ДанныеОбъекта_УдалитьДанныеРаспределения(ДанныеПЗ.ТрудовойРесурс, ДанныеПредПЗ.ПроектнаяЗадача, "НовоеЗначение", ДанныеПредПЗ.Роль);

	Если Объект.ДанныеКалендаря.Количество() Тогда
		Объект.ДанныеКалендаря.Сортировать("День"); 
		КалендарьПоДату = Объект.ДанныеКалендаря[Объект.ДанныеКалендаря.Количество()-1]; 
	Иначе
		КалендарьПоДату = Неопределено;
	КонецЕсли;		

	МассивЗагрузкиПервый = ?(Направление = -1, ГраницыЗагрузки.МассивЗагрузки, ГраницыЗагрузкиПредПЗ.МассивЗагрузки);
	МассивЗагрузкиВторой = ?(Направление = 1, ГраницыЗагрузки.МассивЗагрузки, ГраницыЗагрузкиПредПЗ.МассивЗагрузки);

	ДанныеПервой = ?(Направление = -1, ДанныеПЗ, ДанныеПредПЗ);
	ДанныеВторой = ?(Направление = 1, ДанныеПЗ, ДанныеПредПЗ);

	Начало = Мин(ГраницыЗагрузкиПредПЗ.Начало, ГраницыЗагрузки.Начало);
	ПоследняяДата = Начало; 
	сч = 0;

	ТекДата = Начало;

	КалендарьПоДату = Неопределено;

	Пока сч <= МассивЗагрузкиПервый.Количество() - 1 Цикл
		
		СтрокаКалендрая = Неопределено;
		СтрокиКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", ТекДата));
		Если СтрокиКалендаря.Количество() = 0 Тогда
			Если КалендарьПоДату = Неопределено ИЛИ КалендарьПоДату < ТекДата Тогда
				КалендарьПоДату = ДобавитьМесяц(ТекДата, 1);
				ОбновитьДопДанные(КалендарьПоДату);
				СтрокиКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", ТекДата));
				Если СтрокиКалендаря.Количество() <> 0 Тогда
					СтрокаКалендаря = СтрокиКалендаря[0]; 	
				КонецЕсли;
			КонецЕсли;
		Иначе
			СтрокаКалендаря = СтрокиКалендаря[0]; 	
		КонецЕсли;
		
		Если НЕ СтрокаКалендаря = Неопределено И СтрокаКалендаря.КоличествоЧасов = 0 Тогда
			ТекДата = ТекДата + 24*3600;
			Продолжить;
		КонецЕсли;
			
		СтрокаНов = Объект.РаспределениеПоПериоду.Добавить();
		СтрокаНов.Дата = ТекДата;
		СтрокаНов.Значение = МассивЗагрузкиПервый[сч];
		СтрокаНов.Подразделение = ДанныеПервой.Подразделение;
		СтрокаНов.ТрудовойРесурс = ДанныеПЗ.ТрудовойРесурс;
		СтрокаНов.Роль = ДанныеПервой.Роль;
		СтрокаНов.ПроектнаяЗадача = ДанныеПервой.ПроектнаяЗадача;			
		СтрокаНов.ТипДанных = "НовоеЗначение";
		
		ПоследняяДата = ТекДата;
		сч = сч +1;		
		
		ТекДата = ТекДата + 24*3600;
		
	КонецЦикла;
		
	Начало = ПоследняяДата + 24*3600;
	ПоследняяДата = Начало; 
	ТекДата = Начало;
	сч = 0;

	Пока сч <= МассивЗагрузкиВторой.Количество() - 1 Цикл
				
		СтрокаКалендрая = Неопределено;
		СтрокиКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", ТекДата));
		Если СтрокиКалендаря.Количество() = 0 Тогда
			Если КалендарьПоДату = Неопределено ИЛИ КалендарьПоДату < ТекДата Тогда
				КалендарьПоДату = ДобавитьМесяц(ТекДата, 1);
				ОбновитьДопДанные(КалендарьПоДату);
				СтрокиКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", ТекДата));
				Если СтрокиКалендаря.Количество() <> 0 Тогда
					СтрокаКалендаря = СтрокиКалендаря[0]; 	
				КонецЕсли;
			КонецЕсли;
		Иначе
			СтрокаКалендаря = СтрокиКалендаря[0]; 	
		КонецЕсли;
			
		Если НЕ СтрокаКалендаря = Неопределено И СтрокаКалендаря.КоличествоЧасов = 0 Тогда
			ТекДата = ТекДата + 24*3600;
			Продолжить;
		КонецЕсли;
			
		СтрокаНов = Объект.РаспределениеПоПериоду.Добавить();
		СтрокаНов.Дата = ТекДата;
		СтрокаНов.Значение = МассивЗагрузкиВторой[сч];
		СтрокаНов.Подразделение = ДанныеВторой.Подразделение;
		СтрокаНов.ТрудовойРесурс = ДанныеПЗ.ТрудовойРесурс;
		СтрокаНов.Роль = ДанныеВторой.Роль;
		СтрокаНов.ПроектнаяЗадача = ДанныеВторой.ПроектнаяЗадача;			
		СтрокаНов.ТипДанных = "НовоеЗначение";
		
		ПоследняяДата = ТекДата;
		сч = сч +1;		
		
		ТекДата = ТекДата + 24*3600;
		
	КонецЦикла;


	Объект.КонецПериода = Макс(Объект.КонецПериода, ПоследняяДата);

	ДанныеОбъекта_ОпределитьНовыеДатыПЗ(ДанныеПЗ.ПроектнаяЗадача);
	ДанныеОбъекта_ОпределитьНовыеДатыПЗ(ДанныеПредПЗ.ПроектнаяЗадача);

	//	

	ЗагрузитьДанныеФормыИзОбъекта();
	АдаптироватьЭлементы(ЭтаФорма);
	УстановитьВидимостьДоступностьЭлементовКлиентСервер(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПереместитьЗадачуКлиент(Направление)
	
	ТекДанные = Элементы.ДеревоФормы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ЭтоПоследнийУровеньГруппировки = ТекДанные.ПоследнийУровень 
			И Объект.ПорядокГруппировок = 2 
			И ЗначениеЗаполнено(ТекДанные.ТрудовойРесурс)
			И ЗначениеЗаполнено(ТекДанные.ПроектнаяЗадача);
			
		Если ЭтоПоследнийУровеньГруппировки Тогда
			ПереместитьЗадачуСервер(ТекДанные.ПолучитьИдентификатор(), Направление);
			РазвернутьДерево();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ДанныеОбъекта_ДанныеМожноРедактировать(ПЗ, Ресурс, Роль) 

	СтруктураОтбора = Новый Структура("ТрудовойРесурс, ПроектнаяЗадача, Роль, Редактируется", Ресурс, ПЗ, Роль, Истина);

	Возврат Объект.Данные.НайтиСтроки(СтруктураОтбора).Количество();

КонецФункции

&НаСервере
Функция ДанныеОбъекта_ОпределитьГраницыЗагрузки(ПЗ, Ресурс, Роль, ТипДанных = "НовоеЗначение", ПолучитьМассивЗагрузки = Ложь) 

	Результат = Неопределено;

	СтруктураОтбора = Новый Структура("ТрудовойРесурс, ПроектнаяЗадача, Роль, ТипДанных", Ресурс, ПЗ, Роль, ТипДанных);
	Если ПолучитьМассивЗагрузки Тогда		
		СтрокиРаспределения = Объект.РаспределениеПоПериоду.Выгрузить(СтруктураОтбора);
		СтрокиРаспределения.Сортировать("Дата");
		МассивЗагрузки = Новый Массив;
	Иначе		
		СтрокиРаспределения = Объект.РаспределениеПоПериоду.НайтиСтроки(СтруктураОтбора);
	КонецЕсли;
		
	МаксДата = Дата(1,1,1);
	МинДата = Объект.КонецПериода + 24*3600;

	ПредДата = Неопределено;

	Для Каждого Строка Из СтрокиРаспределения Цикл
		Если ПолучитьМассивЗагрузки Тогда
			Если ПредДата <> Неопределено Тогда
				НоваяОжидаемаяДата = ПредДата + 24*3600;
				Если Строка.Дата > НоваяОжидаемаяДата Тогда
					ДатаДобавленияПустого = НоваяОжидаемаяДата;
					Пока ДатаДобавленияПустого < Строка.Дата Цикл
						СтрокаКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", ДатаДобавленияПустого));
						Если СтрокаКалендаря.Количество() И СтрокаКалендаря[0].КоличествоЧасов <> 0 Тогда					
							МассивЗагрузки.Добавить(0);	
						КонецЕсли;
						ДатаДобавленияПустого = ДатаДобавленияПустого + 24 * 3600;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Значение) Тогда
				МассивЗагрузки.Добавить(Строка.Значение);	
			Иначе
				СтрокаКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", Строка.Дата));
				Если СтрокаКалендаря.Количество() И СтрокаКалендаря[0].КоличествоЧасов <> 0 Тогда					
					МассивЗагрузки.Добавить(Строка.Значение);	
				КонецЕсли;
			КонецЕсли;
			ПредДата = Строка.Дата;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.Значение) Тогда
			МаксДата = Макс(Строка.Дата, МаксДата);
			МинДата = Мин(Строка.Дата, МинДата);
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(МаксДата) Тогда
		Результат = Новый Структура("Начало, Конец", МинДата, МаксДата);
		Если ПолучитьМассивЗагрузки Тогда
			Результат.Вставить("МассивЗагрузки", МассивЗагрузки);
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция ДанныеОбъекта_ОпределитьЗадачуПред(Ресурс, Начало, Конец, Направление, ТипДанных = "НовоеЗначение") 

	СтруктураОтбора = Новый Структура("ТрудовойРесурс, ТипДанных", Ресурс, ТипДанных);
	СтрокиРаспределения = Объект.РаспределениеПоПериоду.НайтиСтроки(СтруктураОтбора);

	МаксДата = Дата(1,1,1);
	МинДата = Объект.КонецПериода+24*3600;
	ПроектнаяЗадача = Неопределено;
	Роль = Неопределено;
	Подразделение = Неопределено;

	Если Направление = -1 Тогда
		Для Каждого Строка Из СтрокиРаспределения Цикл
			Если НЕ Строка.Дата < Начало ИЛИ НЕ ЗначениеЗаполнено(Строка.Значение) Тогда
				Продолжить;
			КонецЕсли;	
			Если Строка.Дата > МаксДата Тогда
				МаксДата = Строка.Дата;
				ПроектнаяЗадача = Строка.ПроектнаяЗадача;
				Роль = Строка.Роль;
				Подразделение = Строка.Подразделение; 
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Направление = 1 Тогда
		Для Каждого Строка Из СтрокиРаспределения Цикл
			Если Строка.Дата <= Конец ИЛИ НЕ ЗначениеЗаполнено(Строка.Значение) Тогда
				Продолжить;
			КонецЕсли;	
			Если Строка.Дата < МинДата Тогда
				МинДата = Строка.Дата;
				ПроектнаяЗадача = Строка.ПроектнаяЗадача;
				Роль = Строка.Роль;
				Подразделение = Строка.Подразделение; 
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;

	Если ПроектнаяЗадача <> Неопределено Тогда
		Возврат Новый Структура("ПроектнаяЗадача, Роль, Подразделение", 
									ПроектнаяЗадача, Роль, Подразделение);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ЗаписатьНастройкуЗаписыватьСрокиЗадач()
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить("Документ.упоПланированиеТрудозатратПоТрудовымРесурсам", 
		"НеЗаписыватьСрокиЗадач", Объект.НеЗаписыватьСрокиЗадач,, ИмяПользователя());
	
КонецПроцедуры

&НаСервере
Процедура РаспределениеПоПериодуПоСтрокамБезРесурса(КонецПериодаНовый = Неопределено)

	Если Объект.Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	

	// Распределение по проектным задачам без ресурсов.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Данные.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Данные.Подразделение КАК Подразделение,
	               |	Данные.Роль КАК Роль,
	               |	Данные.ПрофильРаспределенияРоли КАК ПрофильРаспределенияРоли,
	               |	Данные.ДатаНачалаТП КАК ДатаНачала,
	               |	Данные.ДатаЗавершенияТП КАК ДатаЗавершения,
	               |	Данные.ИтогПоРоли КАК ИтогПоРоли
	               |ПОМЕСТИТЬ Данные
	               |ИЗ
	               |	&Данные КАК Данные
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Данные.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Данные.Подразделение КАК Подразделение,
	               |	Данные.Роль КАК Роль,
	               |	Данные.ПрофильРаспределенияРоли КАК ПрофильРаспределенияРоли,
	               |	Данные.ДатаНачала КАК ДатаНачала,
	               |	Данные.ДатаЗавершения КАК ДатаЗавершения,
	               |	Данные.ИтогПоРоли КАК ИтогПоРоли,
	               |	упоВерсииПроекта.Версия КАК Версия
	               |ПОМЕСТИТЬ ДанныеСВерсией
	               |ИЗ
	               |	Данные КАК Данные
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО Данные.ПроектнаяЗадача.Проект = упоВерсииПроекта.Проект
	               |			И (упоВерсииПроекта.Текущая)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеСВерсией.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДанныеСВерсией.Подразделение КАК Подразделение,
	               |	ДанныеСВерсией.Роль КАК Роль,
	               |	ДанныеСВерсией.ПрофильРаспределенияРоли КАК ПрофильРаспределенияРоли,
	               |	МИНИМУМ(ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан, ДанныеСВерсией.ДатаНачала)) КАК ДатаНачала,
	               |	МАКСИМУМ(ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан, ДанныеСВерсией.ДатаЗавершения)) КАК ДатаЗавершения,
	               |	ДанныеСВерсией.ИтогПоРоли КАК ИтогПоРоли,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи, ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
	               |				ТОГДА ЕСТЬNULL(упоКалендариПроектовСрезПоследних.КалендарьПроекта, ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка))
	               |			ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи
	               |		КОНЕЦ) КАК Календарь
	               |ИЗ
	               |	ДанныеСВерсией КАК ДанныеСВерсией
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ПО ДанныеСВерсией.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоКалендариПроектов.СрезПоследних КАК упоКалендариПроектовСрезПоследних
	               |		ПО ДанныеСВерсией.ПроектнаяЗадача.Проект = упоКалендариПроектовСрезПоследних.Проект
	               |			И ДанныеСВерсией.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК упоСрокиПроектныхЗадачСрезПоследних
	               |		ПО ДанныеСВерсией.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И ДанныеСВерсией.Версия = упоСрокиПроектныхЗадачСрезПоследних.Версия
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДанныеСВерсией.ПроектнаяЗадача,
	               |	ДанныеСВерсией.Подразделение,
	               |	ДанныеСВерсией.Роль,
	               |	ДанныеСВерсией.ПрофильРаспределенияРоли,
	               |	ДанныеСВерсией.ИтогПоРоли";
	Запрос.УстановитьПараметр("Данные", Объект.Данные.Выгрузить());               

	Выборка = Запрос.Выполнить().Выбрать();

	ТаблицаРесурсов = Новый ТаблицаЗначений;
	ТаблицаРесурсов.Колонки.Добавить("ПрофильРаспределения");
	ТаблицаРесурсов.Колонки.Добавить("ЕдиницаНормирования");
	ТаблицаРесурсов.Колонки.Добавить("Количество");
	ТаблицаРесурсов.Колонки.Добавить("Ресурс");
	ТаблицаРесурсов.Колонки.Добавить("Роль");
	ТаблицаРесурсов.Колонки.Добавить("СпособПривязки");
	ТаблицаРесурсов.Колонки.Добавить("ОбщСтоимость");
	ТаблицаРесурсов.Колонки.Добавить("ОбщВнешняяСтоимость");		
	ТаблицаРесурсов.Колонки.Добавить("Стоимость");
	ТаблицаРесурсов.Колонки.Добавить("ВнешняяСтоимость");
	ТаблицаРесурсов.Колонки.Добавить("УровеньПланирования");
	ТаблицаРесурсов.Колонки.Добавить("Подразделение");
	ТаблицаРесурсов.Колонки.Добавить("ИсточникПлана");
	СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;;
	УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
	Ресурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	ИсточникПлана = Перечисления.упоИсточникПланаТрудозатратРолей.Трудозатраты;

	Пока Выборка.Следующий() Цикл

		ТаблицаРесурсов.Очистить();
		
		СтрокаРесурсов = ТаблицаРесурсов.Добавить();
		СтрокаРесурсов.ЕдиницаНормирования = Справочники.упоЕдиницыВремени.Час;
		СтрокаРесурсов.Подразделение = Выборка.Подразделение;
		СтрокаРесурсов.Роль = Выборка.Роль;	
		СтрокаРесурсов.Ресурс = Ресурс;	
		СтрокаРесурсов.СпособПривязки = СпособПривязки;
		СтрокаРесурсов.УровеньПланирования = УровеньПланирования;
		СтрокаРесурсов.ОбщСтоимость = 0;
		СтрокаРесурсов.Стоимость = 0;
		СтрокаРесурсов.ОбщВнешняяСтоимость = 0;
		СтрокаРесурсов.ВнешняяСтоимость = 0;		
		СтрокаРесурсов.ПрофильРаспределения = Выборка.ПрофильРаспределенияРоли;
		СтрокаРесурсов.Количество = Выборка.ИтогПоРоли;
		СтрокаРесурсов.ИсточникПлана = ИсточникПлана;
		
		РезультатРаспределения = упоРаспределениеТрудозатратВызовСервера.РаспределитьТрудозатратыПоПрофилям(ТаблицаРесурсов, Выборка.Календарь, Выборка.ДатаНачала, Выборка.ДатаЗавершения, Ложь); 
		
		Если РезультатРаспределения <> Неопределено И РезультатРаспределения.Строки.Количество() > 0 Тогда
			
			Для Каждого СтрокаЗагрузки Из РезультатРаспределения.Строки[0].Строки Цикл
				
				Если КонецПериодаНовый = Неопределено Тогда
					Если СтрокаЗагрузки.День < Объект.НачалоПериода ИЛИ СтрокаЗагрузки.День > Объект.КонецПериода Тогда
						СтрокаНов = Объект.ТрудозатратыЗаПериодомПланирования.Добавить();
						СтрокаНов.Дата = СтрокаЗагрузки.День;
						СтрокаНов.Трудозатраты = СтрокаЗагрузки.Трудозатраты;
						СтрокаНов.Подразделение = Выборка.Подразделение;
						СтрокаНов.Ресурс = Ресурс;
						СтрокаНов.Роль = Выборка.Роль;
						СтрокаНов.ПроектнаяЗадача = Выборка.ПроектнаяЗадача;			
					Иначе	
						СтрокаНов = Объект.РаспределениеПоПериоду.Добавить();
						СтрокаНов.Дата = СтрокаЗагрузки.День;
						СтрокаНов.Значение = СтрокаЗагрузки.Трудозатраты;
						СтрокаНов.Подразделение = Выборка.Подразделение;
						СтрокаНов.ТрудовойРесурс = Ресурс;
						СтрокаНов.Роль = Выборка.Роль;
						СтрокаНов.ПроектнаяЗадача = Выборка.ПроектнаяЗадача;			
						СтрокаНов.ТипДанных = "НовоеЗначение";
					КонецЕсли;
				Иначе
					Если СтрокаЗагрузки.День > Объект.КонецПериода И СтрокаЗагрузки.День <= КонецПериодаНовый Тогда
						СтрокаНов = Объект.РаспределениеПоПериоду.Добавить();
						СтрокаНов.Дата = СтрокаЗагрузки.День;
						СтрокаНов.Значение = СтрокаЗагрузки.Трудозатраты;
						СтрокаНов.Подразделение = Выборка.Подразделение;
						СтрокаНов.ТрудовойРесурс = Ресурс;
						СтрокаНов.Роль = Выборка.Роль;
						СтрокаНов.ПроектнаяЗадача = Выборка.ПроектнаяЗадача;			
						СтрокаНов.ТипДанных = "ПоРоли";
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;

	Если КонецПериодаНовый <> Неопределено Тогда
		Возврат;
	КонецЕсли;	

	// Распределение по проектным задачам без ресурсов с учетом назначений.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РаспределениеПоПериоду.Дата КАК Дата,
	               |	РаспределениеПоПериоду.Значение КАК Значение,
	               |	РаспределениеПоПериоду.Подразделение КАК Подразделение,
	               |	РаспределениеПоПериоду.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	РаспределениеПоПериоду.Роль КАК Роль,
	               |	РаспределениеПоПериоду.ТипДанных КАК ТипДанных,
	               |	РаспределениеПоПериоду.ТрудовойРесурс КАК ТрудовойРесурс
	               |ПОМЕСТИТЬ РаспределениеПоПериоду
	               |ИЗ
	               |	&РаспределениеПоПериоду КАК РаспределениеПоПериоду
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РаспределениеПоПериоду.Дата КАК Дата,
	               |	РаспределениеПоПериоду.Значение КАК Значение,
	               |	РаспределениеПоПериоду.Подразделение КАК Подразделение,
	               |	РаспределениеПоПериоду.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	РаспределениеПоПериоду.Роль КАК Роль,
	               |	РаспределениеПоПериоду.ТипДанных КАК ТипДанных,
	               |	РаспределениеПоПериоду.ТрудовойРесурс КАК ТрудовойРесурс
	               |ПОМЕСТИТЬ РаспределениеПоПериодуНеСгруппированное
	               |ИЗ
	               |	РаспределениеПоПериоду КАК РаспределениеПоПериоду
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	РаспределениеПоПериоду.Дата,
	               |	-РаспределениеПоПериоду.Значение,
	               |	РаспределениеПоПериоду.Подразделение,
	               |	РаспределениеПоПериоду.ПроектнаяЗадача,
	               |	РаспределениеПоПериоду.Роль,
	               |	РаспределениеПоПериоду.ТипДанных,
	               |	ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |ИЗ
	               |	РаспределениеПоПериоду КАК РаспределениеПоПериоду
	               |ГДЕ
	               |	РаспределениеПоПериоду.ТрудовойРесурс <> ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |	И РаспределениеПоПериоду.ТипДанных <> ""ТекущееЗначение""
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РаспределениеПоПериодуНеСгруппированное.Дата КАК Дата,
	               |	СУММА(РаспределениеПоПериодуНеСгруппированное.Значение) КАК Значение,
	               |	РаспределениеПоПериодуНеСгруппированное.Подразделение КАК Подразделение,
	               |	РаспределениеПоПериодуНеСгруппированное.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	РаспределениеПоПериодуНеСгруппированное.Роль КАК Роль,
	               |	РаспределениеПоПериодуНеСгруппированное.ТипДанных КАК ТипДанных,
	               |	РаспределениеПоПериодуНеСгруппированное.ТрудовойРесурс КАК ТрудовойРесурс
	               |ИЗ
	               |	РаспределениеПоПериодуНеСгруппированное КАК РаспределениеПоПериодуНеСгруппированное
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РаспределениеПоПериодуНеСгруппированное.ТипДанных,
	               |	РаспределениеПоПериодуНеСгруппированное.ТрудовойРесурс,
	               |	РаспределениеПоПериодуНеСгруппированное.Дата,
	               |	РаспределениеПоПериодуНеСгруппированное.ПроектнаяЗадача,
	               |	РаспределениеПоПериодуНеСгруппированное.Роль,
	               |	РаспределениеПоПериодуНеСгруппированное.Подразделение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТрудозатратыЗаПериодомПланирования.Дата КАК Дата,
	               |	ТрудозатратыЗаПериодомПланирования.Трудозатраты КАК Трудозатраты,
	               |	ТрудозатратыЗаПериодомПланирования.Подразделение КАК Подразделение,
	               |	ТрудозатратыЗаПериодомПланирования.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТрудозатратыЗаПериодомПланирования.Роль КАК Роль,
	               |	ТрудозатратыЗаПериодомПланирования.Ресурс КАК Ресурс
	               |ПОМЕСТИТЬ ТрудозатратыЗаПериодомПланирования
	               |ИЗ
	               |	&ТрудозатратыЗаПериодомПланирования КАК ТрудозатратыЗаПериодомПланирования
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТрудозатратыЗаПериодомПланирования.Дата КАК Дата,
	               |	ТрудозатратыЗаПериодомПланирования.Трудозатраты КАК Трудозатраты,
	               |	ТрудозатратыЗаПериодомПланирования.Подразделение КАК Подразделение,
	               |	ТрудозатратыЗаПериодомПланирования.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТрудозатратыЗаПериодомПланирования.Роль КАК Роль,
	               |	ТрудозатратыЗаПериодомПланирования.Ресурс КАК Ресурс
	               |ПОМЕСТИТЬ ТрудозатратыЗаПериодомПланированияНеСгруппированная
	               |ИЗ
	               |	ТрудозатратыЗаПериодомПланирования КАК ТрудозатратыЗаПериодомПланирования
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ТрудозатратыЗаПериодомПланирования.Дата,
	               |	-ТрудозатратыЗаПериодомПланирования.Трудозатраты,
	               |	ТрудозатратыЗаПериодомПланирования.Подразделение,
	               |	ТрудозатратыЗаПериодомПланирования.ПроектнаяЗадача,
	               |	ТрудозатратыЗаПериодомПланирования.Роль,
	               |	ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |ИЗ
	               |	ТрудозатратыЗаПериодомПланирования КАК ТрудозатратыЗаПериодомПланирования
	               |ГДЕ
	               |	ТрудозатратыЗаПериодомПланирования.Ресурс <> ЗНАЧЕНИЕ(Справочник.упоТрудовыеРесурсы.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Дата КАК Дата,
	               |	СУММА(ТрудозатратыЗаПериодомПланированияНеСгруппированная.Трудозатраты) КАК Трудозатраты,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Подразделение КАК Подразделение,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Роль КАК Роль,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Ресурс КАК Ресурс
	               |ИЗ
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная КАК ТрудозатратыЗаПериодомПланированияНеСгруппированная
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Подразделение,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.ПроектнаяЗадача,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Ресурс,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Дата,
	               |	ТрудозатратыЗаПериодомПланированияНеСгруппированная.Роль";
	Запрос.УстановитьПараметр("РаспределениеПоПериоду", Объект.РаспределениеПоПериоду.Выгрузить());
	Запрос.УстановитьПараметр("ТрудозатратыЗаПериодомПланирования", Объект.ТрудозатратыЗаПериодомПланирования.Выгрузить());
	Запрос.УстановитьПараметр("Данные", Объект.Данные.Выгрузить());
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	Объект.РаспределениеПоПериоду.Загрузить(РезультатЗапроса[2].Выгрузить());
	Объект.ТрудозатратыЗаПериодомПланирования.Загрузить(РезультатЗапроса[5].Выгрузить());

	Отбор = Новый Структура("ТрудовойРесурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
	СтрокиБезРесурса = Объект.Данные.НайтиСтроки(Отбор);
	Отбор = Новый Структура("Ресурс, Роль, ПроектнаяЗадача", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
	Для Каждого Строка Из СтрокиБезРесурса Цикл
		Отбор.ПроектнаяЗадача = Строка.ПроектнаяЗадача;
		Отбор.Роль = Строка.Роль;
		НайденныеСтроки = Объект.ТрудозатратыЗаПериодомПланирования.НайтиСтроки(Отбор);
		ТрудозатратыПланДоПериода = 0;
		ТрудозатратыПланПослеПериода = 0;
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если НайденнаяСтрока.Дата < Объект.НачалоПериода Тогда
				ТрудозатратыПланДоПериода = ТрудозатратыПланДоПериода + НайденнаяСтрока.Трудозатраты;
			Иначе	
				ТрудозатратыПланПослеПериода = ТрудозатратыПланПослеПериода + НайденнаяСтрока.Трудозатраты;
			КонецЕсли;	
		КонецЦикла;	
		Строка.ТрудозатратыПланДоПериода = ТрудозатратыПланДоПериода;
		Строка.ТрудозатратыПланПослеПериода = ТрудозатратыПланПослеПериода;
		Строка.ИтогНовоеЗначение = Строка.ИтогПоРоли;
	КонецЦикла;	

КонецПроцедуры	

&НаСервере
Процедура ПересчитатьТрудозатратыПриРасширенииПериода(КонецПериодаНовый)//СтруктураДанных, Ресурс)

	// Заполним распределение по роли для строк без ресурса.
	РаспределениеПоПериодуПоСтрокамБезРесурса(КонецПериодаНовый);

	// Перенесем трудозатраты за периодом в распределение. 
	мУдалить = Новый Массив;
	ОтборТрудозатраты = Новый Структура("Подразделение, ПроектнаяЗадача, Роль, Ресурс");
	ОтборРаспределение = Новый Структура("Дата, Подразделение, ПроектнаяЗадача, Роль, ТрудовойРесурс, ТипДанных");
	ОтборРаспределение.ТипДанных = "НовоеЗначение"; 
		
	Для Каждого СтрокаДанные Из Объект.Данные Цикл
		
		СтрокаДанные.ТрудозатратыПланДоПериода = 0;
		СтрокаДанные.ТрудозатратыПланПослеПериода = 0;
		
		ДатаНачала = Макс(СтрокаДанные.ДатаНачалаНП, Объект.НачалоПериода); 
		ДатаЗавершения = Мин(СтрокаДанные.ДатаЗавершенияНП, КонецПериодаНовый);
		
		ЗаполнитьЗначенияСвойств(ОтборТрудозатраты, СтрокаДанные);
		ОтборТрудозатраты.Ресурс = СтрокаДанные.ТрудовойРесурс;
		НайденныеСтроки = Объект.ТрудозатратыЗаПериодомПланирования.НайтиСтроки(ОтборТрудозатраты);
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			Если Строка.Дата > ДатаЗавершения Тогда
				СтрокаДанные.ТрудозатратыПланПослеПериода = СтрокаДанные.ТрудозатратыПланПослеПериода + Строка.Трудозатраты;
				Продолжить;
			ИначеЕсли Строка.Дата < ДатаНачала Тогда
				СтрокаДанные.ТрудозатратыПланДоПериода = СтрокаДанные.ТрудозатратыПланДоПериода + Строка.Трудозатраты;
				Продолжить;
			КонецЕсли;	
			
			ЗаполнитьЗначенияСвойств(ОтборРаспределение, Строка);
			ОтборРаспределение.ТрудовойРесурс = Строка.Ресурс;
			
			СтрокиРаспределениеПоПериоду = Объект.РаспределениеПоПериоду.НайтиСтроки(ОтборРаспределение);
			Если СтрокиРаспределениеПоПериоду.Количество() > 0 Тогда
				Для Каждого СтрокаРаспределениеПоПериоду Из СтрокиРаспределениеПоПериоду Цикл
					СтрокаРаспределениеПоПериоду.Значение = СтрокаРаспределениеПоПериоду.Значение + Строка.Трудозатраты; 
				КонецЦикла;
			Иначе
				СтрокаРаспределениеПоПериоду = Объект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределениеПоПериоду, ОтборРаспределение);
				СтрокаРаспределениеПоПериоду.Значение = Строка.Трудозатраты;
				Если ЗначениеЗаполнено(СтрокаРаспределениеПоПериоду.ТрудовойРесурс) Тогда
					СтрокаРаспределениеПоПериодуТекЗначение = Объект.РаспределениеПоПериоду.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРаспределениеПоПериодуТекЗначение, СтрокаРаспределениеПоПериоду);
					СтрокаРаспределениеПоПериодуТекЗначение.ТипДанных = "ТекущееЗначение";
				КонецЕсли;	
			КонецЕсли;	
			
			мУдалить.Добавить(Строка);
		
		КонецЦикла;

	КонецЦикла;

	Для Каждого Строка Из мУдалить Цикл
		Объект.ТрудозатратыЗаПериодомПланирования.Удалить(Строка);
	КонецЦикла;	

КонецПроцедуры

&НаКлиенте
Функция ПолучитьСтрокуБезРесурса(ПараметрыОтбора, СтрокиПоиска)

	Для Каждого Строка Из СтрокиПоиска Цикл
		Если Строка.ПоследнийУровень Тогда
			СтрокаНайдена = Истина;
			Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
				Если Строка[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
					СтрокаНайдена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаНайдена Тогда
				Возврат Строка;
			КонецЕсли;
		Иначе
			СтрокаБезРесурса = ПолучитьСтрокуБезРесурса(ПараметрыОтбора, Строка.ПолучитьЭлементы());
			Если СтрокаБезРесурса <> Неопределено Тогда
				Возврат СтрокаБезРесурса;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ДобавитьСтрокуБезРесурса(ИзмененнаяСтрока, ИмяКолонкиИзмененная, РазницаИзменения)
                         
	мСтрок = Новый Массив;
	ТекСтрока = ИзмененнаяСтрока;
	Пока Истина Цикл
		мСтрок.Вставить(0, ТекСтрока);
		ТекСтрока = ТекСтрока.ПолучитьРодителя();
		Если ТекСтрока = Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	СтрокаСвойств = "Группировка, ДатаЗавершенияНП, ДатаЗавершенияТП, ДатаНачалаНП, ДатаНачалаТП, ИмяГруппировки, ИтогПоПериодуПоРоли, ИтогПоРоли, 
					|КодПроекта, КодСДР, КрайнийСрок, Подразделение, ПоследнийУровень, ПредставлениеЗадачи, Проект, ПроектнаяЗадача, ПроектнаяЗадачаЗеркало, 
					|ПрофильРаспределенияРоли, Роль, УровеньДерева";

	СтрокиДерева = ДеревоФормы.ПолучитьЭлементы();
	Отбор = Новый Структура("ПроектнаяЗадачаЗеркало, Подразделение, Роль, ТрудовойРесурс");

	Для Каждого Строка Из мСтрок Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, Строка);
		Отбор.ТрудовойРесурс = ПредопределенноеЗначение("Справочник.упоТрудовыеРесурсы.ПустаяСсылка");
		
		СтрокаНайдена = Ложь;
		Для Каждого СтрокаДерева Из СтрокиДерева Цикл
			СтрокаНайдена = Истина;
			Для Каждого КлючИЗначение Из Отбор Цикл
				Если СтрокаДерева[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
					СтрокаНайдена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаНайдена Тогда
				СтрокиДерева = СтрокаДерева.ПолучитьЭлементы(); 
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		
		Если Не СтрокаНайдена Тогда
			
			Если СтрокиДерева.Количество() <> 0 И Объект.ПорядокГруппировок <> 1 И Строка.ИмяГруппировки = "ПроектнаяЗадачаЗеркало" Тогда
				Индекс = 0;
				Для Каждого СтрокаПЗ Из СтрокиДерева Цикл
					Если СтрокаПЗ.ПредставлениеЗадачи < Строка.ПредставлениеЗадачи Тогда
						Индекс = Индекс + 1;
					Иначе
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
				НоваяСтрокаДерева = СтрокиДерева.Вставить(Индекс);
			Иначе
				НоваяСтрокаДерева = СтрокиДерева.Добавить();
			КонецЕсли;	
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, Строка, СтрокаСвойств);
			НоваяСтрокаДерева.Записывать = Ложь;
			НоваяСтрокаДерева.Редактируется = Ложь;
			НоваяСтрокаДерева.ТрудовойРесурс = ПредопределенноеЗначение("Справочник.упоТрудовыеРесурсы.ПустаяСсылка");
			
			СтрокиДерева = НоваяСтрокаДерева.ПолучитьЭлементы();
			
		КонецЕсли;
		
	КонецЦикла;	

	Парам = Новый Структура("ПроектнаяЗадача, Проект, Роль, Подразделение, ПрофильРаспределенияРоли, ИтогПоРоли, ДатаНачалаТП, ДатаЗавершенияТП");
	ЗаполнитьЗначенияСвойств(Парам, НоваяСтрокаДерева);
	Результат = РаспределениеПоПериодуПоСтрокиБезРесурса(Парам);
	Для Каждого СтрокаЗагрузки Из Результат Цикл
		Если СтрокаЗагрузки.День < Объект.НачалоПериода Тогда
			НоваяСтрокаДерева.ТрудозатратыПланДоПериода = НоваяСтрокаДерева.ТрудозатратыПланДоПериода + СтрокаЗагрузки.Трудозатраты;
		ИначеЕсли СтрокаЗагрузки.День > Объект.КонецПериода Тогда
			НоваяСтрокаДерева.ТрудозатратыПланПослеПериода = НоваяСтрокаДерева.ТрудозатратыПланПослеПериода + СтрокаЗагрузки.Трудозатраты;
		Иначе	
			ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаЗагрузки.День);
			НоваяСтрокаДерева[ИмяКолонки + "ПоРоли"] = СтрокаЗагрузки.Трудозатраты;
			НоваяСтрокаДерева[ИмяКолонки + "НовоеЗначение"] = СтрокаЗагрузки.Трудозатраты;
			НоваяСтрокаДерева[ИмяКолонки + "Отклонение"] = СтрокаЗагрузки.Трудозатраты;
			НоваяСтрокаДерева[ИмяКолонки + "ДляРасчетаРазницы"] = СтрокаЗагрузки.Трудозатраты;
		КонецЕсли;	
	КонецЦикла;	

	НоваяСтрокаДерева[ИмяКолонкиИзмененная + "НовоеЗначение"] = НоваяСтрокаДерева[ИмяКолонкиИзмененная + "ПоРоли"] + РазницаИзменения;
	НоваяСтрокаДерева[ИмяКолонкиИзмененная + "Отклонение"] = НоваяСтрокаДерева[ИмяКолонкиИзмененная + "НовоеЗначение"];
	НоваяСтрокаДерева[ИмяКолонкиИзмененная + "ДляРасчетаРазницы"] = НоваяСтрокаДерева[ИмяКолонкиИзмененная + "НовоеЗначение"];

	Отбор = Новый Структура("ПроектнаяЗадача, Роль");
	ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрокаДерева);
	РасчитатьНераспределенныйОстатокПоСтрокеБезРесурса(ДеревоФормы.ПолучитьЭлементы(), НоваяСтрокаДерева, Отбор);

	МассивГруппировок = ПолучитьМассивГруппировок(Объект.ПорядокГруппировок);
	ОбновитьСтрокиНижнегоУровня(МассивГруппировок);

	 Если Объект.ПорядокГруппировок = 1 Тогда
		Возврат НоваяСтрокаДерева;
	КонецЕсли;	
		
	ТекСтрока = НоваяСтрокаДерева.ПолучитьРодителя();
	Пока ТекСтрока <> Неопределено Цикл
		Для каждого СтрокаДата Из КолонкиДат Цикл
			ИмяКолонки = СтрокаДата.ИмяКолонки;
			Разница = НоваяСтрокаДерева[ИмяКолонки + "НовоеЗначение"];
			ТекСтрока[ИмяКолонки+"НовоеЗначение"] = ТекСтрока[ИмяКолонки+"НовоеЗначение"] + Разница;	
			ТекСтрока[ИмяКолонки+"Отклонение"] = ТекСтрока[ИмяКолонки+"НовоеЗначение"] - ТекСтрока[ИмяКолонки+"ТекущееЗначение"];		
			ТекСтрока[ИмяКолонки+"ДляРасчетаРазницы"] = ТекСтрока[ИмяКолонки+"ДляРасчетаРазницы"] + Разница;		
			ТекСтрока.ИтогПоПериодуНовоеЗначение = ТекСтрока.ИтогПоПериодуНовоеЗначение + Разница;
			ТекСтрока.ИтогПоПериодуОтклонение =  ТекСтрока.ИтогПоПериодуНовоеЗначение - ТекСтрока.ИтогПоПериодуТекущееЗначение;
		КонецЦикла;
		СчитатьВычисляемыеИтогиСтроки(ТекСтрока);	
		ТекСтрока = ТекСтрока.ПолучитьРодителя();
	КонецЦикла;

	Возврат НоваяСтрокаДерева;

КонецФункции	

&НаКлиенте
Процедура РасчитатьНераспределенныйОстатокПоСтрокеБезРесурса(СтрокиДерева, НоваяСтрокаДерева, Отбор)

	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.ПоследнийУровень И ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда
			СтрокаНайдена = Истина;
			Для Каждого КлючИЗначение Из Отбор Цикл
				Если СтрокаДерева[КлючИЗначение.Ключ] <> КлючИЗначение.Значение Тогда
					СтрокаНайдена = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаНайдена Тогда
				Для Каждого СтрокаДата Из КолонкиДат Цикл
					ИмяКолонки = СтрокаДата.ИмяКолонки;
					НоваяСтрокаДерева[ИмяКолонки + "НовоеЗначение"] = НоваяСтрокаДерева[ИмяКолонки + "НовоеЗначение"] - СтрокаДерева[ИмяКолонки + "НовоеЗначение"];
					НоваяСтрокаДерева[ИмяКолонки + "Отклонение"] = НоваяСтрокаДерева[ИмяКолонки + "НовоеЗначение"];
					НоваяСтрокаДерева[ИмяКолонки + "ДляРасчетаРазницы"] = НоваяСтрокаДерева[ИмяКолонки + "НовоеЗначение"];
				КонецЦикла;	
			КонецЕсли;	
		Иначе
			РасчитатьНераспределенныйОстатокПоСтрокеБезРесурса(СтрокаДерева.ПолучитьЭлементы(), НоваяСтрокаДерева, Отбор);	
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция РаспределениеПоПериодуПоСтрокиБезРесурса(СтрокаДерева)

	// Распределение по проектным задачам без ресурсов.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВерсииПроекта.Версия КАК Версия
	               |ПОМЕСТИТЬ вт_Версия
	               |ИЗ
	               |	РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |ГДЕ
	               |	упоВерсииПроекта.Проект = &Проект
	               |	И упоВерсииПроекта.Текущая
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи, ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
	               |				ТОГДА ЕСТЬNULL(упоКалендариПроектовСрезПоследних.КалендарьПроекта, ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка))
	               |			ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи
	               |		КОНЕЦ) КАК Календарь,
	               |	МИНИМУМ(упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан) КАК ДатаНачала,
	               |	МАКСИМУМ(упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан) КАК ДатаЗавершения
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача = &ПроектнаяЗадача
	               |				И Версия В
	               |					(ВЫБРАТЬ
	               |						вт_Версия.Версия КАК Версия
	               |					ИЗ
	               |						вт_Версия КАК вт_Версия)) КАК упоСвойстваПроектныхЗадачСрезПоследних,
	               |	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК упоКалендариПроектовСрезПоследних,
	               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача = &ПроектнаяЗадача
	               |				И Версия В
	               |					(ВЫБРАТЬ
	               |						вт_Версия.Версия КАК Версия
	               |					ИЗ
	               |						вт_Версия КАК вт_Версия)) КАК упоСрокиПроектныхЗадачСрезПоследних";
	Запрос.УстановитьПараметр("Проект", СтрокаДерева.Проект);               
	Запрос.УстановитьПараметр("ПроектнаяЗадача", СтрокаДерева.ПроектнаяЗадача);               

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Календарь = Выборка.Календарь;
		ДатаНачала= Выборка.ДатаНачала;
		ДатаЗавершения = Выборка.ДатаЗавершения;
	Иначе
		Календарь = Справочники.упоРабочиеКалендари.ПустаяСсылка();
		ДатаНачала = СтрокаДерева.ДатаНачалаТП;
		ДатаЗавершения = СтрокаДерева.ДатаЗавершенияТП;
	КонецЕсли;

	ТаблицаРесурсов = Новый ТаблицаЗначений;
	ТаблицаРесурсов.Колонки.Добавить("ПрофильРаспределения");
	ТаблицаРесурсов.Колонки.Добавить("ЕдиницаНормирования");
	ТаблицаРесурсов.Колонки.Добавить("Количество");
	ТаблицаРесурсов.Колонки.Добавить("Ресурс");
	ТаблицаРесурсов.Колонки.Добавить("Роль");
	ТаблицаРесурсов.Колонки.Добавить("СпособПривязки");
	ТаблицаРесурсов.Колонки.Добавить("ОбщСтоимость");
	ТаблицаРесурсов.Колонки.Добавить("ОбщВнешняяСтоимость");		
	ТаблицаРесурсов.Колонки.Добавить("Стоимость");
	ТаблицаРесурсов.Колонки.Добавить("ВнешняяСтоимость");
	ТаблицаРесурсов.Колонки.Добавить("УровеньПланирования");
	ТаблицаРесурсов.Колонки.Добавить("Подразделение");
	ТаблицаРесурсов.Колонки.Добавить("ИсточникПлана");
	СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;;
	УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
	Ресурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	ИсточникПлана = Перечисления.упоИсточникПланаТрудозатратРолей.Трудозатраты;
	
	СтрокаРесурсов = ТаблицаРесурсов.Добавить();
	СтрокаРесурсов.ЕдиницаНормирования = Справочники.упоЕдиницыВремени.Час;
	СтрокаРесурсов.Подразделение = СтрокаДерева.Подразделение;
	СтрокаРесурсов.Роль = СтрокаДерева.Роль;	
	СтрокаРесурсов.Ресурс = Ресурс;	
	СтрокаРесурсов.СпособПривязки = СпособПривязки;
	СтрокаРесурсов.УровеньПланирования = УровеньПланирования;
	СтрокаРесурсов.ОбщСтоимость = 0;
	СтрокаРесурсов.Стоимость = 0;
	СтрокаРесурсов.ОбщВнешняяСтоимость = 0;
	СтрокаРесурсов.ВнешняяСтоимость = 0;		
	СтрокаРесурсов.ПрофильРаспределения = СтрокаДерева.ПрофильРаспределенияРоли;
	СтрокаРесурсов.Количество = СтрокаДерева.ИтогПоРоли;
	СтрокаРесурсов.ИсточникПлана = ИсточникПлана;
	
	РезультатРаспределения = упоРаспределениеТрудозатратВызовСервера.РаспределитьТрудозатратыПоПрофилям(ТаблицаРесурсов, Календарь, ДатаНачала, ДатаЗавершения, Ложь); 

	мРезультат = Новый Массив;

	Если РезультатРаспределения <> Неопределено И РезультатРаспределения.Строки.Количество() > 0 Тогда
		Для Каждого СтрокаЗагрузки Из РезультатРаспределения.Строки[0].Строки Цикл
			Структура = Новый Структура("День, Трудозатраты");
			ЗаполнитьЗначенияСвойств(Структура, СтрокаЗагрузки);
			мРезультат.Добавить(Структура);
		КонецЦикла;
	КонецЕсли;

	Возврат мРезультат;

