	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоСтатусыПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
	               |		ПО ВсеТрудозатратыПлан.ПроектнаяЗадача = упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |ГДЕ
	               |	ВсеТрудозатратыПлан.Значение <> 0
	               |	И ВЫБОР
	               |			КОГДА НЕ &ОтключитьРазграничениеДоступаКДокументам
	               |					И упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи В (&СтатусыНеРедактируемыхЗадач)
	               |					И НЕ ВсеТрудозатратыПлан.Редактируется
	               |				ТОГДА ЛОЖЬ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";

	РезультатЗапроса = Запрос.ВыполнитьПакет();				   				  
	ИндексПоследнегоРезультат = РезультатЗапроса.Количество()-1;
		
	Объект.Данные.Очистить();
	Объект.РаспределениеПоПериоду.Очистить();
	Объект.Ресурсы.Очистить();
	Объект.ДанныеКалендаря.Очистить();
	Объект.ТрудозатратыЗаПериодомПланирования.Очистить();
	Объект.ОтменаНазначения.Очистить();

	Если Не РезультатЗапроса[ИндексПоследнегоРезультат-5].Пустой() Тогда 				
		Выборка = РезультатЗапроса[ИндексПоследнегоРезультат-5].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.ТрудозатратыЗаПериодомПланирования.Добавить(), Выборка);				
		КонецЦикла;
	КонецЕсли;
		
	Если Не РезультатЗапроса[ИндексПоследнегоРезультат-4].Пустой() Тогда 			
		Выборка = РезультатЗапроса[ИндексПоследнегоРезультат-4].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.ДанныеКалендаря.Добавить(), Выборка);				
		КонецЦикла;		
	КонецЕсли;

	Если Не РезультатЗапроса[ИндексПоследнегоРезультат-3].Пустой() Тогда					
		Выборка = РезультатЗапроса[ИндексПоследнегоРезультат-3].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.Ресурсы.Добавить(), Выборка);				
		КонецЦикла;			
	КонецЕсли;	

	Если Не РезультатЗапроса[ИндексПоследнегоРезультат-2].Пустой() Тогда		
		Выборка = РезультатЗапроса[ИндексПоследнегоРезультат-2].Выбрать();		
		Пока Выборка.Следующий() Цикл			
			Если Выборка.ТипДанных = "ТрудозатратыФакт" Тогда
				СтрокаРаспределения = Объект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Выборка);
				СтрокаРаспределения.ТипДанных = "Факт";		
			КонецЕсли;				
		КонецЦикла;		
	КонецЕсли;	

	Если Не РезультатЗапроса[ИндексПоследнегоРезультат-1].Пустой() Тогда		
		Выборка = РезультатЗапроса[ИндексПоследнегоРезультат-1].Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект.Данные.Добавить(), Выборка);
		КонецЦикла;						
	КонецЕсли;
		
	Если Не РезультатЗапроса[ИндексПоследнегоРезультат].Пустой() Тогда	
		Выборка = РезультатЗапроса[ИндексПоследнегоРезультат].Выбрать();		
		Пока Выборка.Следующий() Цикл
			Если Выборка.ТипДанных = "ПоРоли" Тогда
				СтрокаРаспределения = Объект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Выборка);
				СтрокаРаспределения.ТипДанных = "ПоРоли";
			ИначеЕсли Выборка.ТипДанных = "ТрудозатратыПлан" Тогда
				СтрокаРаспределения = Объект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Выборка);
				СтрокаРаспределения.ТипДанных = "НовоеЗначение";	
				СтрокаРаспределения = Объект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Выборка);
				СтрокаРаспределения.ТипДанных = "ТекущееЗначение";				
			ИначеЕсли Выборка.ТипДанных = "ТрудозатратыФакт" Тогда
				СтрокаРаспределения = Объект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Выборка);
				СтрокаРаспределения.ТипДанных = "Факт";				
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;
			
	РаспределениеПоПериодуПоСтрокамБезРесурса();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДопДанные(ПоДату = Неопределено) 

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Если ПоДату = Неопределено Тогда
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));
	Иначе
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПоДату));
	КонецЕсли;
	Запрос.УстановитьПараметр("Календарь", Константы.упоРабочийКалендарьПоУмолчанию.Получить());
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоРабочиеКалендариСрезПоследних.День,
	               |	упоРабочиеКалендариСрезПоследних.КоличествоЧасов
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	               |			,
	               |			Календарь = &Календарь
	               |				И День >= &НачалоПериода
	               |				И День <= &КонецПериода) КАК упоРабочиеКалендариСрезПоследних";
				   
	РезультатЗапроса = Запрос.Выполнить();				   
	Объект.ДанныеКалендаря.Загрузить(РезультатЗапроса.Выгрузить());
			   	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГруппировокСервер() 
	
	ЗагрузитьДанныеОбъектаИзФормы(Объект);
	ЗагрузитьДанныеФормыИзОбъекта();
	АдаптироватьЭлементы(ЭтаФорма);
	УстановитьВидимостьДоступностьЭлементовКлиентСервер(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеОбъектаИзФормы(тОбъект, ТолькоШапку = Ложь) 
	
	ЗагрузитьОтборыИзФормы(тОбъект);
	
	тОбъект.НачалоПериода = НачалоПериодаНаФорме;
	тОбъект.КонецПериода = КонецПериодаНаФорме;
	
	Если ТолькоШапку Тогда
		Возврат;	
	КонецЕсли;
	
	тОбъект.РаспределениеПоПериоду.Очистить();
	тОбъект.Данные.Очистить();
	
	СтрокиНижнегоУровня = ПолучитьСтрокиНижнегоУровня(ДеревоФормы,,,,Истина);
	
	Отбор = Новый Структура("ПроектнаяЗадача, ТрудовойРесурс, Роль");
	
	Для Каждого СрокаДерева Из СтрокиНижнегоУровня Цикл
		
		СтрокаДанных = тОбъект.Данные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанных, СрокаДерева);
		
		Для Каждого СтрокаКолонки Из КолонкиДат Цикл
			
			//Если ЗначениеЗаполнено(СрокаДерева[СтрокаКолонки.ИмяКолонки+"НовоеЗначение"]) 
			//	ИЛИ ЗначениеЗаполнено(СрокаДерева[СтрокаКолонки.ИмяКолонки+"ТекущееЗначение"]) Тогда
			//	
			//	СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
			//	ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СрокаДерева);
			//	СтрокаРаспределения.Дата = СтрокаКолонки.Дата;
			//	СтрокаРаспределения.ТипДанных = "НовоеЗначение";
			//	СтрокаРаспределения.Значение = СрокаДерева[СтрокаКолонки.ИмяКолонки+"НовоеЗначение"];
			//	
			//	СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
			//	ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СрокаДерева);
			//	СтрокаРаспределения.Дата = СтрокаКолонки.Дата;					
			//	СтрокаРаспределения.ТипДанных = "ТекущееЗначение";
			//	СтрокаРаспределения.Значение = СрокаДерева[СтрокаКолонки.ИмяКолонки+"ТекущееЗначение"];
			//	
			//КонецЕсли;
			
			Если ЗначениеЗаполнено(СрокаДерева[СтрокаКолонки.ИмяКолонки+"НовоеЗначение"]) Тогда
				
				СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СрокаДерева);
				СтрокаРаспределения.Дата = СтрокаКолонки.Дата;
				СтрокаРаспределения.ТипДанных = "НовоеЗначение";
				СтрокаРаспределения.Значение = СрокаДерева[СтрокаКолонки.ИмяКолонки+"НовоеЗначение"];
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СрокаДерева[СтрокаКолонки.ИмяКолонки+"ТекущееЗначение"]) Тогда
				
				СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СрокаДерева);
				СтрокаРаспределения.Дата = СтрокаКолонки.Дата;
				СтрокаРаспределения.ТипДанных = "ТекущееЗначение";
				СтрокаРаспределения.Значение = СрокаДерева[СтрокаКолонки.ИмяКолонки+"ТекущееЗначение"];
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СрокаДерева[СтрокаКолонки.ИмяКолонки+"ПоРоли"]) Тогда
				
				СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СрокаДерева);
				СтрокаРаспределения.Дата = СтрокаКолонки.Дата;					
				СтрокаРаспределения.ТипДанных = "ПоРоли";
				СтрокаРаспределения.Значение = СрокаДерева[СтрокаКолонки.ИмяКолонки+"ПоРоли"];
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СрокаДерева[СтрокаКолонки.ИмяКолонки+"Факт"]) Тогда
				
				СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СрокаДерева);
