&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		
		Если ВыбранноеЗначение.Свойство("ВыборПараметровНазначения") Тогда
			
			НазначитьРесурсНаЗадачуСервер(ВыбранноеЗначение.ТрудовойРесурс,
										ВыбранноеЗначение.УИДСтрокиЗадачи, 
										, 
							  			ВыбранноеЗначение);
			ОбновитьСоответствиеУровнейДерева();
			РазвернутьДерево();
			
		КонецЕсли;
		
	КонецЕсли;

	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора);

