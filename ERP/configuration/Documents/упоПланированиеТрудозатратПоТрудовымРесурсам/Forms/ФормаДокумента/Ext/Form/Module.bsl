Функция ПолучитьТекущуюДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьИтоги(ЭтаФорма)

	ЭтаФорма.ОбщийИтогФакт = 0;
	ЭтаФорма.ОбщийИтогПоРоли = 0;

	ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение = 0;
	ЭтаФорма.ОбщийИтогПоПериодуОтклонение = 0;
	ЭтаФорма.ОбщийИтогПоПериодуПоРоли = 0;
	ЭтаФорма.ОбщийИтогПоПериодуТекущееЗначение = 0;
	ЭтаФорма.ОбщийИтогПоПериодуФакт = 0;

	ЭтаФорма.ОбщийИтогТрудозатратыПланПослеПериода = 0;
	ЭтаФорма.ОбщийИтогТрудозатратыПланДоПериода = 0;

	ОбновитьПодвалИтогов(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПодвалИтогов(ЭтаФорма) 

	ФорматПодвала = "ЧДЦ=1; ЧН=";

	ЭтаФорма.ПодвалОбщийИтогФакт = Формат(ЭтаФорма.ОбщийИтогФакт, ФорматПодвала); 

	ЭтаФорма.ПодвалОбщийИтогПоРоли = Формат(ЭтаФорма.ОбщийИтогПоРоли, ФорматПодвала); 

	ЭтаФорма.ПодвалОбщийИтогТрудозатратыПланДоПериода = 
		Формат(ЭтаФорма.ОбщийИтогТрудозатратыПланДоПериода, ФорматПодвала); 
	ЭтаФорма.ПодвалОбщийИтогТрудозатратыПланПослеПериода = 
		Формат(ЭтаФорма.ОбщийИтогТрудозатратыПланПослеПериода, ФорматПодвала); 

	ЭтаФорма.ПодвалОбщийИтогПоПериодуНовоеЗначение = Формат(ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение, ФорматПодвала);
	ЭтаФорма.ПодвалОбщийИтогПоПериодуФакт = Формат(ЭтаФорма.ОбщийИтогПоПериодуФакт, ФорматПодвала);
	ЭтаФорма.ПодвалОбщийИтогПоПериодуТекущееЗначение = Формат(ЭтаФорма.ОбщийИтогПоПериодуТекущееЗначение, ФорматПодвала);
	ЭтаФорма.ПодвалОбщийИтогПоПериодуПоРоли = Формат(ЭтаФорма.ОбщийИтогПоПериодуПоРоли, ФорматПодвала);
	ЭтаФорма.ПодвалОбщийИтогПоПериодуОтклонение = Формат(ЭтаФорма.ОбщийИтогПоПериодуОтклонение, ФорматПодвала);

	ЭтаФорма.ПодвалОбщийИтогТекущееЗначение = Формат(ЭтаФорма.ОбщийИтогТекущееЗначение, ФорматПодвала);
	ЭтаФорма.ПодвалОбщийИтогНовоеЗначение = Формат(ЭтаФорма.ОбщийИтогНовоеЗначение, ФорматПодвала);
 	
КонецПроцедуры

&НаСервере
Процедура ВывестиПериодыНаФорму()
	
	МассивУдаляемых = Новый Массив;
	Для Каждого СтрокаКолонки Из КолонкиДат Цикл
		Элементы.Удалить(Элементы[СтрокаКолонки.ИмяКолонки + "Группа"]);
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "НовоеЗначение");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ТекущееЗначение");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Отклонение");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ПоРоли");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ПоКалендарю");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Факт");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ДляРасчетаРазницы");		
		МассивУдаляемых.Добавить("ИтогоНовоеЗначение" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ИтогоПоРоли" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ИтогоОтклонение" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ИтогоТекущееЗначение" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ИтогоФакт" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ИтогоПоКалендарю" + СтрокаКолонки.ИмяКолонки);
		//МассивУдаляемых.Добавить("ПодвалНовоеЗначение" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ПодвалПоРоли" + СтрокаКолонки.ИмяКолонки);
		//МассивУдаляемых.Добавить("ПодвалОтклонение" + СтрокаКолонки.ИмяКолонки);
		//МассивУдаляемых.Добавить("ПодвалТекущееЗначение" + СтрокаКолонки.ИмяКолонки);		
		//МассивУдаляемых.Добавить("ПодвалФакт"+СтрокаКолонки.ИмяКолонки);
	КонецЦикла;	
	//Если МассивУдаляемых.Количество() Тогда
	//	ИзменитьРеквизиты(, МассивУдаляемых);
	//КонецЕсли;
	КолонкиДат.Очистить();	
	
	Если ПериодПоДням() Тогда  
		ТекДата = Объект.НачалоПериода;
		//ФорматЗаголовкаКолонки = "ДФ=dd.MM.yy";
		ФорматЗаголовкаКолонки = "ДФ='dd.MM ddd'";
	Иначе		
		ТекДата = НачалоМесяца(Объект.НачалоПериода);
		ФорматЗаголовкаКолонки = "ДФ='MMM yy'";
	КонецЕсли;		
	
	КЧ = Новый КвалификаторыЧисла(15, 2);
	ОписаниеТипаКолонки = Новый ОписаниеТипов("Число", КЧ);
	
	ОписаниеТипаКолонкиСтрока = Новый ОписаниеТипов("Строка");
	
	МассивРеквизитов = Новый Массив;
	Пока ТекДата <= Объект.КонецПериода Цикл
		
		ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(ТекДата);
		
		СтрокаКолонки = КолонкиДат.Добавить();
		СтрокаКолонки.Дата = ТекДата;
		СтрокаКолонки.ИмяКолонки = ИмяКолонки;
		
		СтрокиКалендаря = Объект.ДанныеКалендаря.НайтиСтроки(Новый Структура("День", ТекДата));
		СтрокаКолонки.Выходной = СтрокиКалендаря.Количество() = 0 ИЛИ СтрокиКалендаря[0].КоличествоЧасов = 0;
		
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "НовоеЗначение", 
										ОписаниеТипаКолонки, 
										"ДеревоФормы", 
										НСтр("ru = 'Нов.'")); 
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "ДляРасчетаРазницы", ОписаниеТипаКолонки, "ДеревоФормы"); 
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "ТекущееЗначение", 
										ОписаниеТипаКолонки, 
										"ДеревоФормы", 
										НСтр("ru = 'Тек.'")); 
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "Отклонение", 
										ОписаниеТипаКолонки, 
										"ДеревоФормы", 
										НСтр("ru = 'Откл.'")); 
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "ПоРоли", 
										ОписаниеТипаКолонки, 
										"ДеревоФормы", 
										НСтр("ru = 'Роль'"));		
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "Факт", 
										ОписаниеТипаКолонки, 
										"ДеревоФормы", 
										НСтр("ru = 'Факт'"));		
		МассивРеквизитов.Добавить(Реквизит);	
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "ПоКалендарю", 
										ОписаниеТипаКолонки, 
										"ДеревоФормы", 
										НСтр("ru = 'По календарю'"));		
		МассивРеквизитов.Добавить(Реквизит);			
		Реквизит = Новый РеквизитФормы("ИтогоНовоеЗначение" + ИмяКолонки, ОписаниеТипаКолонки); 
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы("ИтогоПоРоли" + ИмяКолонки, ОписаниеТипаКолонки); 
		МассивРеквизитов.Добавить(Реквизит);			
		Реквизит = Новый РеквизитФормы("ИтогоОтклонение" + ИмяКолонки, ОписаниеТипаКолонки); 
		МассивРеквизитов.Добавить(Реквизит);			
		Реквизит = Новый РеквизитФормы("ИтогоТекущееЗначение" + ИмяКолонки, ОписаниеТипаКолонки); 		
		МассивРеквизитов.Добавить(Реквизит);	   
		Реквизит = Новый РеквизитФормы("ИтогоФакт" + ИмяКолонки, ОписаниеТипаКолонки); 		
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы("ИтогоПоКалендарю" + ИмяКолонки, ОписаниеТипаКолонки); 		
		МассивРеквизитов.Добавить(Реквизит);
		//Реквизит = Новый РеквизитФормы("ПодвалНовоеЗначение" + ИмяКолонки, ОписаниеТипаКолонкиСтрока); 
		//МассивРеквизитов.Добавить(Реквизит);	
		Реквизит = Новый РеквизитФормы("ПодвалПоРоли" + ИмяКолонки, ОписаниеТипаКолонкиСтрока); 
		МассивРеквизитов.Добавить(Реквизит);	
		//Реквизит = Новый РеквизитФормы("ПодвалОтклонение" + ИмяКолонки, ОписаниеТипаКолонкиСтрока); 
		//МассивРеквизитов.Добавить(Реквизит);	
		//Реквизит = Новый РеквизитФормы("ПодвалТекущееЗначение" + ИмяКолонки, ОписаниеТипаКолонкиСтрока); 		
		//МассивРеквизитов.Добавить(Реквизит);
		//Реквизит = Новый РеквизитФормы("ПодвалФакт" + ИмяКолонки, ОписаниеТипаКолонкиСтрока); 		
		//МассивРеквизитов.Добавить(Реквизит);		
		Если ПериодПоДням() Тогда 
			ТекДата = ТекДата + 3600 * 24;
		Иначе
			ТекДата = ДобавитьМесяц(ТекДата, 1);
		КонецЕсли;
	КонецЦикла;
			
	ИзменитьРеквизиты(МассивРеквизитов, МассивУдаляемых);
	
	ФорматЭлемента = "ЧДЦ=1; ЧГ=";
	ШиринаЭлемента = 6;
	
	Для Каждого СтрокаКолонки Из КолонкиДат Цикл
		
		Группа = Элементы.Добавить(СтрокаКолонки.ИмяКолонки + "Группа", 
									Тип("ГруппаФормы"), 
									Элементы.ДеревоФормыГруппаТрудозатраты);
		Группа.Вид = ВидГруппыФормы.ГруппаКолонок;
		Группа.Заголовок = Формат(СтрокаКолонки.Дата, ФорматЗаголовкаКолонки);
		Группа.Группировка = ГруппировкаКолонок.Горизонтальная;
		Группа.ОтображатьВШапке = Истина;			
		
		Элемент = Элементы.Добавить(СтрокаКолонки.ИмяКолонки + "Факт", Тип("ПолеФормы"), Группа);
		Элемент.Вид = ВидПоляФормы.ПолеНадписи;
		Элемент.ПутьКДанным = "ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Факт";		
