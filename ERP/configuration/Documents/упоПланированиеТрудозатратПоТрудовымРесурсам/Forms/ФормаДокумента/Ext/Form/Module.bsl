&НаСервере
Процедура ОбновитьСтрокиНижнегоУровня(МассивГруппировок)

	ПолучитьСтрокиНижнегоУровня(ДеревоФормы, , -1, МассивГруппировок);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивГруппировок(ПорядокГруппировок)

	МассивГруппировок = Новый Массив;
	Если ПорядокГруппировок = 0 Тогда
		МассивГруппировок.Добавить("ТрудовойРесурс");
		МассивГруппировок.Добавить("Роль");	
		МассивГруппировок.Добавить("Проект");
		МассивГруппировок.Добавить("ПроектнаяЗадачаЗеркало");
	ИначеЕсли ПорядокГруппировок = 1 Тогда
		МассивГруппировок.Добавить("Проект");
		МассивГруппировок.Добавить("ПроектнаяЗадачаЗеркало");
		МассивГруппировок.Добавить("Роль");
		МассивГруппировок.Добавить("ТрудовойРесурс");
	ИначеЕсли ПорядокГруппировок = 2 Тогда
		МассивГруппировок.Добавить("ТрудовойРесурс");
		МассивГруппировок.Добавить("ПроектнаяЗадачаЗеркало");
	КонецЕсли;

	Возврат МассивГруппировок;

КонецФункции

&НаСервере
Функция ПолучитьСтрокиНижнегоУровня(Дерево, МассивСтрокНижнегоУровня = Неопределено, СчетчикГруппировки= Неопределено, МассивГруппировок = Неопределено, ТолькоНайтиСтроки = Ложь) 
			
	Если МассивСтрокНижнегоУровня = Неопределено Тогда
		МассивСтрокНижнегоУровня = Новый Массив;
		Если НЕ ТолькоНайтиСтроки Тогда
			мКэшЗначений.СтрокиПЗ_НижнийУровень.Очистить();
			мКэшЗначений.СтрокиПЗ_УровеньПЗ.Очистить();
			мКэшЗначений.СтрокиРесурса_НижнийУровень.Очистить();
		КонецЕсли;
	КонецЕсли;
	 ЭлементыДерева = Дерево.ПолучитьЭлементы();
	Если НЕ ТолькоНайтиСтроки И ТипЗнч(Дерево) <> Тип("ДанныеФормыДерево") Тогда
		Дерево.ИмяГруппировки = МассивГруппировок[СчетчикГруппировки];
		Если Дерево.ИмяГруппировки = "ПроектнаяЗадачаЗеркало" Тогда	
			МассивСтрокПЗ = мКэшЗначений.СтрокиПЗ_УровеньПЗ.Получить(Дерево.ПроектнаяЗадачаЗеркало);
			Если МассивСтрокПЗ = Неопределено Тогда
				МассивСтрокПЗ = Новый Массив;
				ОбновитьПревышениеКрайнегоСрокаПЗ(ЭтаФорма, Дерево.ПроектнаяЗадача, Дерево.ДатаЗавершенияНП, Дерево.КрайнийСрок);
			КонецЕсли;
			МассивСтрокПЗ.Добавить(Дерево.ПолучитьИдентификатор()); 
			мКэшЗначений.СтрокиПЗ_УровеньПЗ.Вставить(Дерево.ПроектнаяЗадачаЗеркало, МассивСтрокПЗ);		
		КонецЕсли;
	КонецЕсли;
	//Если ТипЗнч(Дерево) <> Тип("ДанныеФормыДерево") И Дерево.ИмяГруппировки = "ТрудовойРесурс" Тогда	
	//	Если СписокРесурсов.НайтиПоЗначению(Дерево.ТрудовойРесурс) = Неопределено Тогда
	//	КонецЕсли;
	//КонецЕсли;
	Если ЭлементыДерева.Количество() = 0 Тогда
		Если ТипЗнч(Дерево) <> Тип("ДанныеФормыДерево") Тогда
			
			МассивСтрокНижнегоУровня.Добавить(Дерево);
			
			Если НЕ ТолькоНайтиСтроки Тогда
			
				МассивСтрокПЗ = мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(Дерево.ПроектнаяЗадачаЗеркало);
				Если МассивСтрокПЗ = Неопределено Тогда
					МассивСтрокПЗ = Новый Массив;
				КонецЕсли;
				МассивСтрокПЗ.Добавить(Дерево.ПолучитьИдентификатор()); 
				мКэшЗначений.СтрокиПЗ_НижнийУровень.Вставить(Дерево.ПроектнаяЗадачаЗеркало, МассивСтрокПЗ);
				
				Если ЗначениеЗаполнено(Дерево.ТрудовойРесурс) Тогда
					МассивСтрокРесурса = мКэшЗначений.СтрокиРесурса_НижнийУровень.Получить(Дерево.ТрудовойРесурс);
					Если МассивСтрокРесурса = Неопределено Тогда
						МассивСтрокРесурса = Новый Массив;
					КонецЕсли;
					МассивСтрокРесурса.Добавить(Дерево.ПолучитьИдентификатор()); 
					мКэшЗначений.СтрокиРесурса_НижнийУровень.Вставить(Дерево.ТрудовойРесурс, МассивСтрокРесурса);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			Если НЕ ТолькоНайтиСтроки Тогда
				ПолучитьСтрокиНижнегоУровня(ЭлементДерева, МассивСтрокНижнегоУровня, СчетчикГруппировки+1, МассивГруппировок);	
			Иначе
				ПолучитьСтрокиНижнегоУровня(ЭлементДерева, МассивСтрокНижнегоУровня, ,, Истина);	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСтрокНижнегоУровня; 

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСписокВыбораУровнейГруппировок(ЭтаФорма, ЗаполнитьУровень = Ложь)

	СписокВыбора = ЭтаФорма.Элементы.УровеньГруппировок.СписокВыбора;
	СписокВыбора.Очистить();

	Если ЭтаФорма.Объект.ПорядокГруппировок = 0 Тогда
		СписокВыбора.Добавить(0, НСтр("ru = 'Трудовые ресурсы'"));
		СписокВыбора.Добавить(1, НСтр("ru = 'Роли'"));
		СписокВыбора.Добавить(2, НСтр("ru = 'Проекты'"));
		СписокВыбора.Добавить(3, НСтр("ru = 'Задачи'"));
	ИначеЕсли ЭтаФорма.Объект.ПорядокГруппировок = 1 Тогда
		СписокВыбора.Добавить(0, НСтр("ru = 'Проекты'"));
		СписокВыбора.Добавить(1, НСтр("ru = 'Задачи'"));
		СписокВыбора.Добавить(2, НСтр("ru = 'Роли'"));
		СписокВыбора.Добавить(3, НСтр("ru = 'Трудовые ресурсы'"));
	ИначеЕсли ЭтаФорма.Объект.ПорядокГруппировок = 2 Тогда
		СписокВыбора.Добавить(0, НСтр("ru = 'Трудовые ресурсы'"));
		СписокВыбора.Добавить(1, НСтр("ru = 'Задачи'"));
	КонецЕсли;

	Если ЗаполнитьУровень Тогда
		ЭтаФорма.Объект.УровеньГруппировок = ?(ЭтаФорма.Объект.ПорядокГруппировок = 2, 0, 3);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоДоУровня()
	
	упоОперацииСДеревьямиКлиент.РазвернутьДеревоДоУровня(Элементы.ДеревоФормы, 
		Объект.УровеньГруппировок, 
		ЭтотОбъект.СоотвУровняДерева);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция АдаптироватьЭлементы(ЭтаФорма) 
	
	Если ЭтаФорма.Объект.ПорядокГруппировок = 0	Тогда
		ЭтаФорма.Элементы.ДеревоФормыГруппировка.Заголовок = 
			НСтр("ru = 'Трудовой ресурс / Роль / Проект / Задача'");
	ИначеЕсли ЭтаФорма.Объект.ПорядокГруппировок = 1 Тогда
		ЭтаФорма.Элементы.ДеревоФормыГруппировка.Заголовок = 
			НСтр("ru = 'Проект / Задача / Роль / Трудовой ресурс'");
	ИначеЕсли ЭтаФорма.Объект.ПорядокГруппировок = 2 Тогда
		ЭтаФорма.Элементы.ДеревоФормыГруппировка.Заголовок = 
			НСтр("ru = 'Трудовой ресурс / Задача'");			
	КонецЕсли;
	ЭтаФорма.Элементы.ФормаКомандаПоказатьДиаграмму.Пометка = ЭтаФорма.Объект.ПоказатьДиаграмму;	
	ЭтаФорма.Элементы.ФормаКомандаПоказатьДиаграммуГанта.Пометка = ЭтаФорма.Объект.ПоказатьДиаграммуГанта;	
	ЭтаФорма.Элементы.ФормаКомандаПоказатьКолонкиРолей.Пометка = ЭтаФорма.Объект.ПоказатьКолонкиРолей;		
	//ЭтаФорма.Элементы.ФормаКомандаПоказатьКолонкиРолей.Пометка = ЭтаФорма.ПоказатьКолонкиРолей;		
	ЭтаФорма.Элементы.ФормаКомандаПоказатьКолонкиФакта.Пометка = ЭтаФорма.Объект.ПоказатьКолонкиФакта;		
	ЭтаФорма.Элементы.ФормаКомандаПоказатьПланЗаПериодом.Пометка = ЭтаФорма.Объект.ПоказатьПланЗаПериодом;		
	ЭтаФорма.Элементы.ФормаКомандаПоказатьКолонкиТекущееЗначение.Пометка = ЭтаФорма.Объект.ПоказатьКолонкиТекущееЗначение;			
	ЭтаФорма.Элементы.ФормаКомандаПоказатьТекущиеСроки.Пометка = ЭтаФорма.Объект.ПоказатьТекущиеСроки;
	ЭтаФорма.Элементы.ФормаКомандаПоказатьТекущиеЗначенияНаДГ.Пометка = ЭтаФорма.Объект.ПоказыватьТекущиеЗначенияНаДГ;
	ЭтаФорма.Элементы.ФормаКомандаПоказыватьВыходные.Пометка = ЭтаФорма.Объект.ПоказыватьВыходные; 

КонецФункции

&НаКлиенте
Функция ПриИзмененииФильтров(Заполнение = Ложь) 

	Если ДеревоФормы.ПолучитьЭлементы().Количество() Тогда        
		ОписаниеОповещенияВопросОчисткиТаблицыЗавершение = Новый ОписаниеОповещения("ВопросОчисткиТаблицыЗавершение", 
																									ЭтаФорма, Заполнение);
		ТекстВопроса = НСтр("ru = 'Данные таблицы будут очищены. Продолжить?'");	
		ПоказатьВопрос(ОписаниеОповещенияВопросОчисткиТаблицыЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);		
	Иначе
		ВопросОчисткиТаблицыЗавершение(КодВозвратаДиалога.Да, Заполнение);
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ВопросОчисткиТаблицыЗавершение(РезультатВопроса, Заполнение) Экспорт 

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда		
		Если Заполнение Тогда
			ЗаполнитьИзБазыКлиент();
		Иначе
			ОчиститьДанные(ЭтаФорма);
			ОбновитьСоответствиеУровнейДерева();
		КонецЕсли;
	Иначе
		ЗагрузитьДанныеФормыИзОбъекта(Истина);
	КонецЕсли;

КонецФункции

&НаКлиенте
Функция ЗаполнитьИзБазыКлиент() 
	
	Если НЕ ПроверитьЗаполнение() Тогда
		ОчиститьДанные(ЭтаФорма);
		Возврат Неопределено;
	КонецЕсли;

	ОчиститьДанные(ЭтаФорма);
	ЗаполнитьСервер();
	ОбновитьСоответствиеУровнейДерева();
	РазвернутьДерево();

	упоРаботаСОчередямиКлиент.ВывестиОповещения(СписокОповещений);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОчиститьДанные(ЭтаФорма) 
	
	ЭтаФорма.ДеревоФормы.ПолучитьЭлементы().Очистить();
	ЭтаФорма.Диаграмма.Очистить();
	ОчиститьИтоги(ЭтаФорма);
	ЭтаФорма.ОбщаяПерегрузка = 0;
	ЭтаФорма.ОбщаяНедозагрузка = 0;
	ЭтаФорма.ОбщееПревышениеКритическихСроков = 0;
	Для Каждого СтрокаКолонок Из ЭтаФорма.КолонкиДат Цикл
		//Элементы[СтрокаКолонок.ИмяКолонки+"Группа"].Видимость = Ложь;
		
		ЭтаФорма["ИтогоНовоеЗначение"+СтрокаКолонок.ИмяКолонки] = 0;
		ЭтаФорма["ИтогоПоРоли"+СтрокаКолонок.ИмяКолонки] = 0;
		ЭтаФорма["ИтогоОтклонение"+СтрокаКолонок.ИмяКолонки] = 0;
		ЭтаФорма["ИтогоТекущееЗначение"+СтрокаКолонок.ИмяКолонки] = 0;
		ЭтаФорма["ИтогоФакт"+СтрокаКолонок.ИмяКолонки] = 0;

	КонецЦикла;
	ЭтаФорма.мКэшЗначений.СтрокиПЗ_НижнийУровень.Очистить();
	ЭтаФорма.мКэшЗначений.СтрокиПЗ_УровеньПЗ.Очистить();
	ЭтаФорма.мКэшЗначений.СтрокиРесурса_НижнийУровень.Очистить();
	
КонецФункции

&НаКлиенте
Функция УстановитьПризнакЗаписи(Признак, Строки = Неопределено) 
	
	Если Строки = Неопределено Тогда
		Строки = ДеревоФормы.ПолучитьЭлементы();
	КонецЕсли;
	ЭтоНижнегоУровняЭлементы = Неопределено;
	Для Каждого Строка Из Строки Цикл 
		СтрокиПодч = Строка.ПолучитьЭлементы();
		Если ЭтоНижнегоУровняЭлементы = Неопределено Тогда
			ЭтоНижнегоУровняЭлементы = СтрокиПодч.Количество() = 0;	
		КонецЕсли;
		Если ЭтоНижнегоУровняЭлементы Тогда
			Если Строка.Редактируется И Строка.ЕстьПраваНаРедактирование Тогда
				Строка.Записывать = Признак;
			КонецЕсли;	
		Иначе
			УстановитьПризнакЗаписи(Признак, СтрокиПодч);
		КонецЕсли;		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт

	Если Период <> Неопределено Тогда
		
		Если ПериодПоДням() Тогда
			НачалоПериодаНаФорме = НачалоДня(Период.ДатаНачала);
			КонецПериодаНаФорме = КонецДня(Период.ДатаОкончания);	
		Иначе
			НачалоПериодаНаФорме = НачалоМесяца(Период.ДатаНачала);
			КонецПериодаНаФорме = КонецМесяца(Период.ДатаОкончания);	
		КонецЕсли;
		
		УстановитьЗаголовокВыбораПериода(ЭтаФорма);
		
		ПриИзмененииФильтров();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокВыбораПериода(ЭтаФорма)

	Если ПериодПоДням() Тогда
		Формат = "ДФ='dd MMMM yyyy'";
	Иначе
		Формат = "ДФ='MMMM yyyy ""г.""'";
	КонецЕсли;

	ЭтаФорма.Элементы.ФормаВыбратьПериод.Заголовок = НСтр("ru = 'Период с'") + " "  
										+ Формат(ЭтаФорма.НачалоПериодаНаФорме, Формат)  
										+  " " + НСтр("ru = 'по'") + " " 
										+ Формат(ЭтаФорма.КонецПериодаНаФорме, Формат);
		
КонецПроцедуры
								
