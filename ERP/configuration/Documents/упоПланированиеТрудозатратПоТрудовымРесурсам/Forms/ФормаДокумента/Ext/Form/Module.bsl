КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТрудозатраты(ЭтаФорма, СтрокаДерева, Знач ИмяКолонки, ЗначениеТрудозатрат = Неопределено,
	СчитатьИтогиСтроки = Истина, СчитатьИтогиДерева = Истина, ИнтерактивноеИзменение = Истина) 
	
	ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоИмениЭлемента(ИмяКолонки);	
	Если ИмяКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если ЗначениеТрудозатрат <> Неопределено Тогда		
		СтрокаДерева[ИмяКолонки+"НовоеЗначение"] = ЗначениеТрудозатрат;
	Иначе
		ЗначениеТрудозатрат = СтрокаДерева[ИмяКолонки+"НовоеЗначение"];
	КонецЕсли;

	ПредыдущееЗначение = СтрокаДерева[ИмяКолонки+"ДляРасчетаРазницы"];
	Разница = ЗначениеТрудозатрат - ПредыдущееЗначение;

	Если Разница = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ИнтерактивноеИзменение Тогда
		Если НужноОбновитьДатыПЗ(ЭтаФорма, СтрокаДерева, ИмяКолонки) Тогда
			ОпределитьНовыеДатыПЗ(ЭтаФорма, СтрокаДерева.ПроектнаяЗадачаЗеркало);			
			СортроватьСтрокиПоДатеПервойЗагрузки(ЭтаФорма, СтрокаДерева.ПолучитьРодителя());
		КонецЕсли;
	КонецЕсли;

	ТекСтрока = СтрокаДерева;

	Пока ТекСтрока <> Неопределено Цикл
		
		Если ТекСтрока.ИмяГруппировки = "ТрудовойРесурс" И ЭтаФорма.Объект.ПорядокГруппировок = 2 И ИнтерактивноеИзменение Тогда

			Превышение = ?(ТекСтрока[ИмяКолонки + "НовоеЗначение"] > ТекСтрока[ИмяКолонки + "ПоКалендарю"],
							ТекСтрока[ИмяКолонки + "НовоеЗначение"] - ТекСтрока[ИмяКолонки + "ПоКалендарю"],
							0);
			Простой = ?(ТекСтрока[ИмяКолонки + "НовоеЗначение"] < ТекСтрока[ИмяКолонки + "ПоКалендарю"],
							ТекСтрока[ИмяКолонки + "ПоКалендарю"] - ТекСтрока[ИмяКолонки + "НовоеЗначение"],
							0);	
			ЭтаФорма.ОбщаяНедозагрузка = Макс(ЭтаФорма.ОбщаяНедозагрузка - Простой, 0);							
	 		ЭтаФорма.ОбщаяПерегрузка = ЭтаФорма.ОбщаяПерегрузка - Превышение;
			
		КонецЕсли;
		
		Если Не ТекСтрока.ПоследнийУровень И Не (ЭтаФорма.Объект.ПорядокГруппировок = 1 И Не ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс)) Тогда
			ТекСтрока[ИмяКолонки+"НовоеЗначение"] = ТекСтрока[ИмяКолонки+"НовоеЗначение"] + Разница;	
		КонецЕсли;		
						
		ТекСтрока[ИмяКолонки+"Отклонение"] = ТекСтрока[ИмяКолонки+"НовоеЗначение"] - ТекСтрока[ИмяКолонки+"ТекущееЗначение"];		
		Если Не (ЭтаФорма.Объект.ПорядокГруппировок = 1 
			И Не ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) 
			И Не ТекСтрока.ПоследнийУровень) Тогда
			
			ТекСтрока[ИмяКолонки+"ДляРасчетаРазницы"] = ТекСтрока[ИмяКолонки+"ДляРасчетаРазницы"] + Разница;		
			ТекСтрока.ИтогПоПериодуНовоеЗначение = ТекСтрока.ИтогПоПериодуНовоеЗначение + Разница;
			
		КонецЕсли;	
		ТекСтрока.ИтогПоПериодуОтклонение =  ТекСтрока.ИтогПоПериодуНовоеЗначение - ТекСтрока.ИтогПоПериодуТекущееЗначение;
		
		Если СчитатьИтогиСтроки Тогда
			СчитатьВычисляемыеИтогиСтроки(ТекСтрока);	
		КонецЕсли;		
		
		Если ТекСтрока.ИмяГруппировки = "ТрудовойРесурс" И ЭтаФорма.Объект.ПорядокГруппировок = 2 Тогда
			Превышение = ?(ТекСтрока[ИмяКолонки+"НовоеЗначение"] > ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							ТекСтрока[ИмяКолонки+"НовоеЗначение"] - ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							0);
			Простой = ?(ТекСтрока[ИмяКолонки+"НовоеЗначение"] < ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							ТекСтрока[ИмяКолонки+"ПоКалендарю"] - ТекСтрока[ИмяКолонки+"НовоеЗначение"],
							0);	
			ЭтаФорма.ОбщаяНедозагрузка = ЭтаФорма.ОбщаяНедозагрузка + Простой;							
			ЭтаФорма.ОбщаяПерегрузка = ЭтаФорма.ОбщаяПерегрузка + Превышение;
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока) = Тип("ДанныеФормыЭлементДерева") Тогда
			ТекСтрока = ТекСтрока.ПолучитьРодителя();
		Иначе
			ТекСтрока = ТекСтрока.Родитель;
		КонецЕсли;		
		
	КонецЦикла;

	Если ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда 
		ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки] = ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки] + Разница;						
		ЭтаФорма["ИтогоОтклонение" + ИмяКолонки] = ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки] - ЭтаФорма["ИтогоТекущееЗначение" + ИмяКолонки];	
		
		ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение = ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение + Разница; 
		ЭтаФорма.ОбщийИтогПоПериодуОтклонение = ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение - ЭтаФорма.ОбщийИтогПоПериодуТекущееЗначение; 	
	КонецЕсли;	

	Если СчитатьИтогиДерева Тогда 
		СчитатьВычисляемыеИтогиДерева(ЭтаФорма);
		ОбновитьПодвалИтогов(ЭтаФорма);
		упоПланированиеТрудозатратКлиентСервер.ПостроитьДиаграмму(ЭтаФорма, "ПоРесурсам", ИмяКолонки);		
		ПостроитьДиаграммуГанта(ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьТрудозатраты(ЭтаФорма, СтрокаДерева, Знач ИмяКолонки, ЗначениеТрудозатрат = Неопределено,
	СчитатьИтогиСтроки = Истина, СчитатьИтогиДерева = Истина, ИнтерактивноеИзменение = Истина, ИзменениеЯчейки = Ложь) 
	
	ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоИмениЭлемента(ИмяКолонки);	
	Если ИмяКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Если ЗначениеТрудозатрат <> Неопределено Тогда		
		СтрокаДерева[ИмяКолонки+"НовоеЗначение"] = ЗначениеТрудозатрат;
	Иначе
		ЗначениеТрудозатрат = СтрокаДерева[ИмяКолонки+"НовоеЗначение"];
	КонецЕсли;

	ПредыдущееЗначение = СтрокаДерева[ИмяКолонки+"ДляРасчетаРазницы"];
	Разница = ЗначениеТрудозатрат - ПредыдущееЗначение;

	Если Разница = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ИнтерактивноеИзменение Тогда
		Если НужноОбновитьДатыПЗ(ЭтаФорма, СтрокаДерева, ИмяКолонки) Тогда
			ОпределитьНовыеДатыПЗ(ЭтаФорма, СтрокаДерева.ПроектнаяЗадачаЗеркало);			
			СортроватьСтрокиПоДатеПервойЗагрузки(ЭтаФорма, СтрокаДерева.ПолучитьРодителя());
		КонецЕсли;
	КонецЕсли;

	ТекСтрока = СтрокаДерева;

	Отбор = Новый Структура("ПроектнаяЗадачаЗеркало, Подразделение, Роль, ТрудовойРесурс");
	ЗаполнитьЗначенияСвойств(Отбор, ТекСтрока);
	Отбор.ТрудовойРесурс = ПредопределенноеЗначение("Справочник.упоТрудовыеРесурсы.ПустаяСсылка");
	ТекСтрокаБезРесурса = ПолучитьСтрокуБезРесурса(Отбор, ДеревоФормы.ПолучитьЭлементы());
	Если ТекСтрокаБезРесурса = Неопределено И ИзменениеЯчейки Тогда
		// Добавляем новую ТекСтрокуБезРесурсов
		ТекСтрокаБезРесурса = ДобавитьСтрокуБезРесурса(ТекСтрока, ИмяКолонки, Разница);
	КонецЕсли;
	Если ТекСтрокаБезРесурса <> Неопределено Тогда
		ТекСтрокаБезРесурса[ИмяКолонки+"НовоеЗначение"] = ТекСтрокаБезРесурса[ИмяКолонки+"НовоеЗначение"] - Разница;
	КонецЕсли;	
		
	Пока ТекСтрока <> Неопределено Цикл
		
		Если ТекСтрока.ИмяГруппировки = "ТрудовойРесурс" И ЭтаФорма.Объект.ПорядокГруппировок = 2 И ИнтерактивноеИзменение Тогда

			Превышение = ?(ТекСтрока[ИмяКолонки+"НовоеЗначение"] > ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							ТекСтрока[ИмяКолонки+"НовоеЗначение"] - ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							0);
			Простой = ?(ТекСтрока[ИмяКолонки+"НовоеЗначение"] < ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							ТекСтрока[ИмяКолонки+"ПоКалендарю"] - ТекСтрока[ИмяКолонки+"НовоеЗначение"],
							0);	
			ЭтаФорма.ОбщаяНедозагрузка = Макс(ЭтаФорма.ОбщаяНедозагрузка - Простой, 0);							
	 		ЭтаФорма.ОбщаяПерегрузка = ЭтаФорма.ОбщаяПерегрузка - Превышение;
		КонецЕсли;
		
		Если Не ТекСтрока.ПоследнийУровень И ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда //Не (ЭтаФорма.Объект.ПорядокГруппировок = 1 И Не ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс)) Тогда
			ТекСтрока[ИмяКолонки+"НовоеЗначение"] = ТекСтрока[ИмяКолонки+"НовоеЗначение"] + Разница;
			Если ТекСтрокаБезРесурса <> Неопределено И ТекСтрокаБезРесурса <> ТекСтрока Тогда
				ТекСтрокаБезРесурса[ИмяКолонки+"НовоеЗначение"] = ТекСтрокаБезРесурса[ИмяКолонки+"НовоеЗначение"] - Разница;
			КонецЕсли;	
		КонецЕсли;		
						
		ТекСтрока[ИмяКолонки+"Отклонение"] = ТекСтрока[ИмяКолонки+"НовоеЗначение"] - ТекСтрока[ИмяКолонки+"ТекущееЗначение"];		
		Если ТекСтрокаБезРесурса <> Неопределено И ТекСтрокаБезРесурса <> ТекСтрока Тогда
			ТекСтрокаБезРесурса[ИмяКолонки+"Отклонение"] = ТекСтрокаБезРесурса[ИмяКолонки+"НовоеЗначение"] - ТекСтрокаБезРесурса[ИмяКолонки+"ТекущееЗначение"];		
		КонецЕсли;	
		Если Не (ЭтаФорма.Объект.ПорядокГруппировок = 1 И Не ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) И Не ТекСтрока.ПоследнийУровень) Тогда
			ТекСтрока[ИмяКолонки+"ДляРасчетаРазницы"] = ТекСтрока[ИмяКолонки+"ДляРасчетаРазницы"] + Разница;		
			ТекСтрока.ИтогПоПериодуНовоеЗначение = ТекСтрока.ИтогПоПериодуНовоеЗначение + Разница;
			Если ТекСтрокаБезРесурса <> Неопределено  И ТекСтрокаБезРесурса <> ТекСтрока Тогда
				ТекСтрокаБезРесурса[ИмяКолонки+"ДляРасчетаРазницы"] = ТекСтрокаБезРесурса[ИмяКолонки+"ДляРасчетаРазницы"] - Разница;		
				ТекСтрокаБезРесурса.ИтогПоПериодуНовоеЗначение = ТекСтрокаБезРесурса.ИтогПоПериодуНовоеЗначение - Разница;
			КонецЕсли;	
		КонецЕсли;	
		ТекСтрока.ИтогПоПериодуОтклонение =  ТекСтрока.ИтогПоПериодуНовоеЗначение - ТекСтрока.ИтогПоПериодуТекущееЗначение;
		Если ТекСтрокаБезРесурса <> Неопределено И ТекСтрокаБезРесурса <> ТекСтрока Тогда
			ТекСтрокаБезРесурса.ИтогПоПериодуОтклонение =  ТекСтрокаБезРесурса.ИтогПоПериодуНовоеЗначение - ТекСтрокаБезРесурса.ИтогПоПериодуТекущееЗначение;
		КонецЕсли;	
		
		Если СчитатьИтогиСтроки Тогда
			СчитатьВычисляемыеИтогиСтроки(ТекСтрока);	
			Если ТекСтрокаБезРесурса <> Неопределено И ТекСтрокаБезРесурса <> ТекСтрока Тогда
				СчитатьВычисляемыеИтогиСтроки(ТекСтрокаБезРесурса);	
			КонецЕсли;	
		КонецЕсли;		
		
		Если ТекСтрока.ИмяГруппировки = "ТрудовойРесурс" И ЭтаФорма.Объект.ПорядокГруппировок = 2 Тогда
			Превышение = ?(ТекСтрока[ИмяКолонки+"НовоеЗначение"] > ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							ТекСтрока[ИмяКолонки+"НовоеЗначение"] - ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							0);
			Простой = ?(ТекСтрока[ИмяКолонки+"НовоеЗначение"] < ТекСтрока[ИмяКолонки+"ПоКалендарю"],
							ТекСтрока[ИмяКолонки+"ПоКалендарю"] - ТекСтрока[ИмяКолонки+"НовоеЗначение"],
							0);	
			ЭтаФорма.ОбщаяНедозагрузка = ЭтаФорма.ОбщаяНедозагрузка + Простой;							
			ЭтаФорма.ОбщаяПерегрузка = ЭтаФорма.ОбщаяПерегрузка + Превышение;
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока) = Тип("ДанныеФормыЭлементДерева") Тогда
			ТекСтрока = ТекСтрока.ПолучитьРодителя();
			Если ТекСтрокаБезРесурса <> Неопределено Тогда
				ТекСтрокаБезРесурса = ТекСтрокаБезРесурса.ПолучитьРодителя();
			КонецЕсли;	
		Иначе
			ТекСтрока = ТекСтрока.Родитель;
			Если ТекСтрокаБезРесурса <> Неопределено Тогда
				ТекСтрокаБезРесурса = ТекСтрокаБезРесурса.Родитель;
			КонецЕсли;	
		КонецЕсли;		
		
	КонецЦикла;

	Если ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда 
		ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки] = ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки] + Разница;		
		//ЭтаФорма["ПодвалНовоеЗначение" + ИмяКолонки] = Формат(ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки], "ЧДЦ=1; ЧН=");
		
		ЭтаФорма["ИтогоОтклонение" + ИмяКолонки] = ЭтаФорма["ИтогоНовоеЗначение" + ИмяКолонки] - ЭтаФорма["ИтогоТекущееЗначение" + ИмяКолонки]; 			
		//ЭтаФорма["ПодвалОтклонение" + ИмяКолонки] = Формат(ЭтаФорма["ИтогоОтклонение" + ИмяКолонки], "ЧДЦ=1; ЧН=");	
		
		ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение = ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение + Разница; 
		ЭтаФорма.ОбщийИтогПоПериодуОтклонение = ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение - ЭтаФорма.ОбщийИтогПоПериодуТекущееЗначение; 	
	КонецЕсли;	

	Если СчитатьИтогиДерева Тогда 
		СчитатьВычисляемыеИтогиДерева(ЭтаФорма);
		ОбновитьПодвалИтогов(ЭтаФорма);
		упоПланированиеТрудозатратКлиентСервер.ПостроитьДиаграмму(ЭтаФорма, "ПоРесурсам", ИмяКолонки);		
		ПостроитьДиаграммуГанта(ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СортроватьСтрокиПоДатеПервойЗагрузки(ЭтаФорма, СтрокаРодителя)
	
	Если ЭтаФорма.Объект.ПорядокГруппировок <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Элементы = СтрокаРодителя.ПолучитьЭлементы();
	КоличествоЭлементов = Элементы.Количество();
	сч = 1;
	БылОбмен = Ложь;
	Пока сч < КоличествоЭлементов Цикл	
		внутр_сч = 1;
		Пока внутр_сч < КоличествоЭлементов Цикл
			Элемент1 = Элементы[внутр_сч-1];
			Элемент2 = Элементы[внутр_сч];	
			Если Элемент1.ДатаПервойЗагруки > Элемент2.ДатаПервойЗагруки Тогда
				Элементы.Сдвинуть(внутр_сч-1, 1);
				БылОбмен = Истина; 	
			КонецЕсли;			
			внутр_сч = внутр_сч + 1;
		КонецЦикла;	
		сч = сч + 1;
		Если Не БылОбмен Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НужноОбновитьДатыПЗ(ЭтаФорма, ТекСтрокаДерева, ИмяИзмененнойКолонки)

	НужноеИзменение = Неопределено;

	НовоеЗначение = ТекСтрокаДерева[ИмяИзмененнойКолонки+"НовоеЗначение"]; 
	ЗначениеДоИзменения = ТекСтрокаДерева[ИмяИзмененнойКолонки+"ДляРасчетаРазницы"]; 

	Если НовоеЗначение = 0 И ЗначениеДоИзменения <> 0 Тогда
		НужноеИзменение = "УбралиЗначение";
	ИначеЕсли НовоеЗначение <> 0 И ЗначениеДоИзменения = 0 Тогда
		НужноеИзменение = "ДобавилиЗначение";
	КонецЕсли;

	Если НужноеИзменение = Неопределено Тогда
		Возврат Ложь;	
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьНовыеДатыПЗ(ЭтаФорма, ПроектнаяЗадачаЗеркало) 
	
	СтрокиПЗ_НижнийУровень = ЭтаФорма.мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(ПроектнаяЗадачаЗеркало);
	СтрокиПЗ_УровеньПЗ = ЭтаФорма.мКэшЗначений.СтрокиПЗ_УровеньПЗ.Получить(ПроектнаяЗадачаЗеркало);

	ТрудозатратыДоПериода = 0;
	ТрудозатратыПослеПериода = 0;

	ПерваяКолонкаСоЗначением = Неопределено;
	ПоследняяКолонкаСоЗначением = Неопределено;
	ДатаПервойКолонки = ЭтаФорма.КонецПериодаНаФорме + 24*3600;
	ДатаПоследнейКолонки = Дата(1,1,1);

	Строка_УровеньПЗ = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(СтрокиПЗ_УровеньПЗ[0]);

	Если ЗначениеЗаполнено(Строка_УровеньПЗ.ДатаЗавершенияНП) Тогда
		ДатаЗавершения = Строка_УровеньПЗ.ДатаЗавершенияНП;
	Иначе
		ДатаЗавершения = Строка_УровеньПЗ.ДатаЗавершенияТП;
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка_УровеньПЗ.ДатаНачалаНП) Тогда
		ДатаНачала = Строка_УровеньПЗ.ДатаНачалаНП;
	Иначе
		ДатаНачала = Строка_УровеньПЗ.ДатаНачалаТП;
	КонецЕсли;
		
	МассивСтрокПЗ = Новый Массив;
	Для Каждого ИдСтроки Из СтрокиПЗ_НижнийУровень Цикл
		
		ДатаПервойКолонкиЭтойСтроки = ЭтаФорма.КонецПериодаНаФорме + 24*3600;
		
		СтрокаДерева = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
		МассивСтрокПЗ.Добавить(СтрокаДерева);
		
		Если Не ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДерева.ДатаПервойЗагруки = ЭтаФорма.КонецПериодаНаФорме + 24*3600;
		
		ТрудозатратыДоПериода = ТрудозатратыДоПериода + СтрокаДерева.ТрудозатратыПланДоПериода;
		ТрудозатратыПослеПериода = ТрудозатратыПослеПериода + СтрокаДерева.ТрудозатратыПланПослеПериода;
		
		Для Каждого СтрокаКолонок Из ЭтаФорма.КолонкиДат Цикл
			Если ЗначениеЗаполнено(СтрокаДерева[СтрокаКолонок.ИмяКолонки+"НовоеЗначение"]) Тогда
				СтрокаДерева.ДатаПервойЗагруки = Мин(СтрокаДерева.ДатаПервойЗагруки, СтрокаКолонок.Дата);
				Если ДатаПервойКолонки > СтрокаКолонок.Дата Тогда
					ДатаПервойКолонки = СтрокаКолонок.Дата;
					ПоследняяКолонкаСоЗначением = СтрокаКолонок.ИмяКолонки;
				КонецЕсли;
				Если ДатаПоследнейКолонки < СтрокаКолонок.Дата Тогда
					ДатаПоследнейКолонки = СтрокаКолонок.Дата;
					ПерваяКолонкаСоЗначением = СтрокаКолонок.ИмяКолонки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
			
	КонецЦикла;

	ОбновитьПревышениеКрайнегоСрокаПЗ(ЭтаФорма, Строка_УровеньПЗ.ПроектнаяЗадача, ДатаПоследнейКолонки, Строка_УровеньПЗ.КрайнийСрок);

	//Если ДатаПервойКолонки = Строка_УровеньПЗ.ДатаНачалаТП Тогда
	//	ДатаПервойКолонки = Дата(1,1,1);
	//КонецЕсли;
	//Если ДатаПоследнейКолонки = Строка_УровеньПЗ.ДатаЗавершенияТП Тогда
	//	ДатаПоследнейКолонки = Дата(1,1,1);
	//КонецЕсли;

	ИзменитьДатуНачала = НЕ ЗначениеЗаполнено(ТрудозатратыДоПериода) И
						ДатаПервойКолонки <> ДатаНачала И ПерваяКолонкаСоЗначением <> Неопределено;
	ИзменитьДатуЗавершения = НЕ ЗначениеЗаполнено(ТрудозатратыПослеПериода) И
						ДатаПоследнейКолонки <> ДатаЗавершения И ПоследняяКолонкаСоЗначением <> Неопределено;

	Если ИзменитьДатуНачала ИЛИ ИзменитьДатуЗавершения Тогда
		Для Каждого СтрокаДерева Из МассивСтрокПЗ Цикл
			Пока Истина Цикл
				Если СтрокаДерева = Неопределено Тогда
					Прервать;
				КонецЕсли;
				ДатаНачалаУжеИменена = НЕ ИзменитьДатуНачала;
				ДатаЗавершенияУжеИзменена = Не ИзменитьДатуЗавершения;
				Если ИзменитьДатуНачала Тогда		
					Если СтрокаДерева.ДатаНачалаНП = ДатаПервойКолонки Тогда
						ДатаНачалаУжеИзменена = Истина;
					Иначе
						СтрокаДерева.ДатаНачалаНП = ДатаПервойКолонки;
					КонецЕсли;		
				КонецЕсли;
				Если ИзменитьДатуЗавершения Тогда
					Если СтрокаДерева.ДатаЗавершенияНП = ДатаПоследнейКолонки Тогда
						ДатаЗавершенияУжеИзменена = Истина;
					Иначе
						СтрокаДерева.ДатаЗавершенияНП = ДатаПоследнейКолонки;
					КонецЕсли;					
				КонецЕсли;
				СтрокаБылаОбработанаРаньше = ДатаНачалаУжеИменена И ДатаЗавершенияУжеИзменена;
				Если СтрокаБылаОбработанаРаньше Тогда
					Прервать;
				КонецЕсли;
				СтрокаДерева = СтрокаДерева.ПолучитьРодителя();
			КонецЦикла;
		КонецЦикла;				
	КонецЕсли;
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбновитьПревышениеКрайнегоСрокаПЗ(ЭтаФорма, ПроектнаяЗадача, Знач ДатаЗавершения, КрайнийСрок) 

	Возврат Неопределено;

	ДатаЗавершения = НачалоДня(ДатаЗавершения);

	Отбор = Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача);
	Строки = ЭтаФорма.ПревышениеКрайнихСроков.НайтиСтроки(Отбор);
	Если Строки.Количество() Тогда
		СтрокаПревышения = Строки[0];
	Иначе
		СтрокаПревышения = ЭтаФорма.ПревышениеКрайнихСроков.Добавить();
		СтрокаПревышения.ПроектнаяЗадача = ПроектнаяЗадача;
	КонецЕсли;

	ЭтаФорма.ОбщееПревышениеКритическихСроков = ЭтаФорма.ОбщееПревышениеКритическихСроков - СтрокаПревышения.Превышение;

	Если ЗначениеЗаполнено(КрайнийСрок) И ДатаЗавершения > КрайнийСрок Тогда
		СтрокаПревышения.Превышение = (ДатаЗавершения - КрайнийСрок) / (24*3600) ;
		ЭтаФорма.ОбщееПревышениеКритическихСроков = ЭтаФорма.ОбщееПревышениеКритическихСроков + СтрокаПревышения.Превышение;
	Иначе
		СтрокаПревышения.Превышение = 0;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ДанныеОбъекта_ОпределитьНовыеДатыПЗ(ПроектнаяЗадача) 
		
	СтрокиПЗ = Объект.Данные.НайтиСтроки(Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача));
	ТрудозатратыПланДоПериода = 0;
	ТрудозатратыПланПослеПериода = 0;
	Для Каждого ТекСтрока Из СтрокиПЗ Цикл
		ТрудозатратыПланДоПериода = ТрудозатратыПланДоПериода + ТекСтрока.ТрудозатратыПланДоПериода;
		ТрудозатратыПланПослеПериода = ТрудозатратыПланПослеПериода + ТекСтрока.ТрудозатратыПланПослеПериода;
	КонецЦикла;	
	СтрокаПЗ = СтрокиПЗ[0];

	СтрокиРаспределенияПЗ = Объект.РаспределениеПоПериоду.Выгрузить(Новый Структура("ПроектнаяЗадача, ТипДанных", ПроектнаяЗадача, "НовоеЗначение"));
	СтрокиРаспределенияПЗ.Сортировать("Дата");

	МаксимальнаяДата = Дата(1,1,1);
	МинимальнаяДата = Объект.КонецПериода + 24*3600;

	Для Каждого СтрокаРаспределения Из СтрокиРаспределенияПЗ Цикл
		Если ЗначениеЗаполнено(СтрокаРаспределения.Значение) Тогда
			МаксимальнаяДата = Макс(МаксимальнаяДата, СтрокаРаспределения.Дата);  
			МинимальнаяДата = Мин(МинимальнаяДата, СтрокаРаспределения.Дата);  
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(ТрудозатратыПланДоПериода) 
		И МинимальнаяДата <= МаксимальнаяДата
		И СтрокаПЗ.ДатаНачалаНП <> МинимальнаяДата Тогда
		
		Для Каждого ТекСтрока Из СтрокиПЗ Цикл
			ТекСтрока.ДатаНачалаНП = МинимальнаяДата;	
		КонецЦикла;
		
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТрудозатратыПланПослеПериода) 
		И ЗначениеЗаполнено(МаксимальнаяДата)
		И СтрокаПЗ.ДатаЗавершенияНП <> МаксимальнаяДата Тогда
		
		Для Каждого ТекСтрока Из СтрокиПЗ Цикл
			ТекСтрока.ДатаЗавершенияНП = МаксимальнаяДата;	
		КонецЦикла;
		
	КонецЕсли;

	ОбновитьПревышениеКрайнегоСрокаПЗ(ЭтаФорма, СтрокаПЗ.ПроектнаяЗадача, СтрокаПЗ.ДатаЗавершенияНП, СтрокаПЗ.КрайнийСрок);	
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчитатьВычисляемыеИтогиСтроки(СтрокаДерева) 
	
	СтрокаДерева.ИтогНовоеЗначение = СтрокаДерева.ИтогПоПериодуНовоеЗначение + 
			СтрокаДерева.ТрудозатратыПланДоПериода + СтрокаДерева.ТрудозатратыПланПослеПериода;
	Если ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда
		СтрокаДерева.ИтогТекущееЗначение = СтрокаДерева.ИтогПоПериодуТекущееЗначение + 
				СтрокаДерева.ТрудозатратыПланДоПериода + СтрокаДерева.ТрудозатратыПланПослеПериода;			
			КонецЕсли;			
			
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчитатьВычисляемыеИтогиДерева(ЭтаФорма) 
	
	ЭтаФорма.ОбщийИтогТекущееЗначение = ЭтаФорма.ОбщийИтогПоПериодуТекущееЗначение + 
					ЭтаФорма.ОбщийИтогТрудозатратыПланДоПериода + ЭтаФорма.ОбщийИтогТрудозатратыПланПослеПериода;
	ЭтаФорма.ОбщийИтогНовоеЗначение = ЭтаФорма.ОбщийИтогПоПериодуНовоеЗначение + 
					ЭтаФорма.ОбщийИтогТрудозатратыПланДоПериода + ЭтаФорма.ОбщийИтогТрудозатратыПланПослеПериода;
					
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеИзБДВОбъект() 	

	ЗагрузитьДанныеОбъектаИзФормы(Объект, Истина);

	Роли = Объект.Роли.Выгрузить().ВыгрузитьКолонку("Роль"); 
	ВсеРоли = Роли.Количество() = 0;

	Проекты = Объект.Проекты.Выгрузить().ВыгрузитьКолонку("Проект"); 
	ВсеПроекты = Проекты.Количество() = 0;

	Подразделения = Объект.Подразделения.Выгрузить().ВыгрузитьКолонку("Подразделение"); 
	ВсеПодразделения = Подразделения.Количество() = 0;

	Если ВсеПроекты Тогда
		упоРаботаСОчередями.ДобавитьОповещениеПоОчередиТрудозатратПоОтбору(Неопределено, СписокОповещений, Ложь);
	Иначе
		упоРаботаСОчередями.ДобавитьОповещениеПоОчередиТрудозатратПоОтбору(Проекты, СписокОповещений, Ложь);
	КонецЕсли;

	Запрос = Новый Запрос;
	УстановитьПараметрыРазграниченияДоступа(Запрос);
	Запрос.УстановитьПараметр("УровеньПланированияОкончательный", Перечисления.упоУровеньПланирования.Окончательный);
	Запрос.УстановитьПараметр("УровеньПланированияПредварительный", Перечисления.упоУровеньПланирования.Предварительный);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));
	Запрос.УстановитьПараметр("СписокРолей", Роли);
	Запрос.УстановитьПараметр("ВсеРоли", ВсеРоли);
	Запрос.УстановитьПараметр("СписокПроектов", Проекты);
	Запрос.УстановитьПараметр("ВсеПроекты", ВсеПроекты);
	Запрос.УстановитьПараметр("СписокПодразделений", Подразделения);
	Запрос.УстановитьПараметр("ВсеПодразделения", ВсеПодразделения);
	Запрос.УстановитьПараметр("Календарь", Константы.упоРабочийКалендарьПоУмолчанию.Получить());
		
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс КАК Ресурс,
	               |	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Роль КАК Роль,
	               |	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение КАК Подразделение,
	               |	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День КАК День,
	               |	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Трудозатраты КАК Трудозатраты,
	               |	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция КАК ПроектнаяЗадача,
	               |	ИСТИНА КАК Редактируется
	               |ПОМЕСТИТЬ ТрудозатратыПланТР
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
