&НаКлиенте
Процедура ОткрытьАнализИзменений(Команда)

	Если ЭтотОбъект.Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для формирования отчета документ необходимо записать.'"));
		Возврат;
	КонецЕсли;	

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Документ", Объект.Ссылка);	

	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыОткрытия.Вставить("ПараметрыОтчета", ПараметрыОтчета);

	ИмяОтчета = "упоАнализИзмененийПоПланированиюТрудозатратПоТрудовымРесурсам";
	Если  Объект.ПорядокГруппировок = 0 Тогда // Трудовой ресурс / Роль / Проект / Задача
		КлючВарианта = "ТрудовойРесурс_Роль_Проект_Задача";	
	ИначеЕсли Объект.ПорядокГруппировок = 1 Тогда // Проект / Задача / Роль / Трудовой ресурс 		
		КлючВарианта = "Проект_Задача_Роль_ТрудовойРесурс";
	Иначе // Трудовой ресурс / Задача
	    КлючВарианта = "ТрудовойРесурс_Задача";
	КонецЕсли;

	ВариантСсылка = упоФункцииБСП.ВариантОтчетаПоИмениОтчетаКлючуВарианта(ИмяОтчета, КлючВарианта);
				
	ВариантыОтчетовКлиент.ОткрытьФормуОтчета(Неопределено, ВариантСсылка, ПараметрыОткрытия);

