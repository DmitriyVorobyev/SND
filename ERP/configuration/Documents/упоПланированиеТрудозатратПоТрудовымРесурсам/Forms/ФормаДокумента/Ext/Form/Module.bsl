&НаКлиенте
Процедура ДиаграммаВыбор(Элемент, ЗначениеДиаграммы, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ЗначениеДиаграммы) <> Тип("ЗначениеДиаграммы") Тогда
		Возврат;
	КонецЕсли;
	ДатаТочки = ЗначениеДиаграммы.Расшифровка;
	ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(ДатаТочки);
	Элементы.ДеревоФормы.ТекущийЭлемент = Элементы[ИмяКолонки + "НовоеЗначение"];
	Если ЗначениеЗаполнено(РесурсДиаграммыПоРесурсу) Тогда
		мСтрокРесурса = мКэшЗначений.СтрокиРесурса_НижнийУровень.Получить(РесурсДиаграммыПоРесурсу);
		Если ТипЗнч(мСтрокРесурса) = Тип("Массив") И мСтрокРесурса.Количество() > 0 Тогда
			Элементы.ДеревоФормы.ТекущаяСтрока = мСтрокРесурса[0];
		КонецЕсли;	
	КонецЕсли;
	ЭтаФорма.ТекущийЭлемент = Элементы.ДеревоФормы;
	Элементы.ДеревоФормы.ИзменитьСтроку();
	
КонецПроцедуры

