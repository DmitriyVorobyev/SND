
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();

	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Объект.Ссылка.Метаданные());

	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаКоманднаяПанель;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЭтоНовый = Не ЗначениеЗаполнено(Объект.Ссылка);	
	
	УстановитьСписокВыбораУровнейГруппировок(ЭтаФорма);

	Если ЭтоНовый Тогда
		
		Если Параметры.Свойство("Основание") И ЗначениеЗаполнено(Параметры.Основание) Тогда
		
			СписокПроектов.ЗагрузитьЗначения(Объект.Проекты.Выгрузить().ВыгрузитьКолонку("Проект"));		
			СписокПодразделений.ЗагрузитьЗначения(Объект.Подразделения.Выгрузить().ВыгрузитьКолонку("Подразделение"));		
			СписокРолей.ЗагрузитьЗначения(Объект.Роли.Выгрузить().ВыгрузитьКолонку("Роль"));		
			НачалоПериодаНаФорме = Объект.НачалоПериода;
			КонецПериодаНаФорме = Объект.КонецПериода;
			
			ЗагрузитьДанныеИзБДВОбъект();
		
		КонецЕсли;
		
		ЭтоКопирование = ЗначениеЗаполнено(Параметры.ЗначениеКопирования);
		
		ИнициализацияФормы(ЭтоКопирование);
		
	Иначе
		
		упоПланированиеТрудозатратКлиентСервер.УстановитьТекущуюСтраницуПанели(ЭтотОбъект, "СтраницаТрудозатраты");	
		
	КонецЕсли;	

	
	ПроверятьРазграничениеДоступа = ЗначениеЗаполнено(Объект.Ссылка) И Объект.Проведен;				
	// Вместо сообщений о разграничении прав доступа может использоваться цветовое выделение в условном оформлении строк.
	// - оставлено оповещение для случая большого количества строк.
	ВыводитьСообщенияОРазграниченииПравДоступа = Истина;
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, 
														Объект, 
														Отказ, 
														СтандартнаяОбработка, 
														ВыводитьСообщенияОРазграниченииПравДоступа, 
														ПроверятьРазграничениеДоступа); 		

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом

КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормы(ЭтоКопирование)

	Если мКэшЗначений = Неопределено Тогда
		мКэшЗначений = Новый Структура;
		мКэшЗначений.Вставить("СтрокиПЗ_НижнийУровень", Новый Соответствие);
		мКэшЗначений.Вставить("СтрокиПЗ_УровеньПЗ", Новый Соответствие);
		мКэшЗначений.Вставить("СтрокиРесурса_НижнийУровень", Новый Соответствие);
		
		ЦветДиаграммыЗагрузка = Новый Цвет(182, 162, 255);
		ЦветДиаграммыПерегрузка = Новый Цвет(255, 119, 50);
		ЦветДиаграммыПростой = Новый Цвет(184, 248, 194);
	КонецЕсли;	

	ЗагрузитьДанныеФормыИзОбъекта(, ЭтоКопирование);
	АдаптироватьЭлементы(ЭтаФорма);
	УстановитьВидимостьДоступностьЭлементовКлиентСервер(ЭтаФорма);

КонецПроцедуры	

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если СписокПодразделений.Количество() > 0 Тогда
		упоУправлениеФормамиКлиент.СписокРолейПриИзмененииСпискаПодразделений(ЭтаФорма);
	КонецЕсли;

	ОбновитьСоответствиеУровнейДерева();
	РазвернутьДерево();

	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)

	Если Не Отказ И НачалоПериодаНаФорме > КонецПериодаНаФорме И ЗначениеЗаполнено(КонецПериодаНаФорме) Тогда
		Сообщение = Новый СообщениеПользователю;
		//Сообщение.УстановитьДанные(Объект);
		//Сообщение.Поле = "НачалоПериода";
		//Сообщение.ПутьКДанным = "Объект";
		Сообщение.Текст = НСтр("ru = 'Начало периода не может быть позже окончания'");
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	упоОбработчикиСобытийСервер.ФормаОбработкаПроверкиЗаполненияНаСервере(ЭтаФорма, Объект, Отказ, ПроверяемыеРеквизиты);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ЗагрузитьДанныеОбъектаИзФормы(ТекущийОбъект);

	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом

КонецПроцедуры

