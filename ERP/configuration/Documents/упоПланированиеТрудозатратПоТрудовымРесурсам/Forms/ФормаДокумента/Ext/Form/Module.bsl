		//Элемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
		//Элемент.ПутьКДаннымПодвала = "ПодвалФакт"+СтрокаКолонки.ИмяКолонки;		
		Элемент.ПутьКДаннымПодвала = "ИтогоФакт" + СтрокаКолонки.ИмяКолонки;		
		
		//Элемент = Элементы.Добавить(СтрокаКолонки.ИмяКолонки+"ПоРоли", Тип("ПолеФормы"), Группа);
		//Элемент.Вид = ВидПоляФормы.ПолеНадписи;
		//Элемент.ПутьКДанным = "ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ПоРоли";		
		//Элемент.Ширина = ШиринаЭлемента;
		//Элемент.Формат = ФорматЭлемента;
		//Элемент.РастягиватьПоГоризонтали = Ложь;
		//Элемент.ТолькоПросмотр = Истина;			
		////Элемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
		////Элемент.ПутьКДаннымПодвала = "ПодвалПоРоли"+СтрокаКолонки.ИмяКолонки;
		//Элемент.ПутьКДаннымПодвала = "ИтогоПоРоли"+СтрокаКолонки.ИмяКолонки;
		
		Элемент = Элементы.Добавить(СтрокаКолонки.ИмяКолонки + "НовоеЗначение", Тип("ПолеФормы"), Группа);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = "ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "НовоеЗначение";		
		Элемент.Ширина = ШиринаЭлемента + 6; // обход бага, приводящего к падению
		Элемент.Формат = ФорматЭлемента;
