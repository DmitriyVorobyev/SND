Функция ТекстЗапросаДерева(МассивГруппировок)

	Если Объект.ПорядокГруппировок = 0 Тогда
		УпорядочитьПо = "Редактируется УБЫВ, ТрудовойРесурсПредставление, РольПредставление, ПроектПредставление, КодСДР";
	ИначеЕсли Объект.ПорядокГруппировок = 1 Тогда
		УпорядочитьПо = "Редактируется УБЫВ, ПроектПредставление, КодСДР, РольПредставление, ТрудовойРесурсПредставление";
	ИначеЕсли Объект.ПорядокГруппировок = 2 Тогда
		УпорядочитьПо = "Редактируется УБЫВ, ЗаполненТР УБЫВ, ТрудовойРесурсПредставление, ПроектПредставление, ДатаНачалаНП, КодСДР";		
	КонецЕсли;

	ПоследняяГруппировкаВЗапросе = МассивГруппировок.Количество() - 2;
	сч = 0;
	СтрокаГруппировокВЗапросе = "";
	Пока сч <= ПоследняяГруппировкаВЗапросе Цикл
		СтрокаГруппировокВЗапросе = СтрокаГруппировокВЗапросе + ?(ЗначениеЗаполнено(СтрокаГруппировокВЗапросе), ", ", "") + МассивГруппировок[сч];
		сч = сч + 1;
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВЫРАЗИТЬ(ТаблицаДанные.ПроектнаяЗадачаЗеркало КАК Справочник.Проекты) КАК ПроектнаяЗадачаЗеркало,
	               |	ТаблицаДанные.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВЫРАЗИТЬ(ТаблицаДанные.Роль КАК Справочник.упоРоли) КАК Роль,
	               |	ВЫРАЗИТЬ(ТаблицаДанные.ТрудовойРесурс КАК Справочник.упоТрудовыеРесурсы) КАК ТрудовойРесурс,
	               |	ТаблицаДанные.Факт КАК Факт,
	               |	ТаблицаДанные.ТрудозатратыПланДоПериода КАК ТрудозатратыПланДоПериода,
	               |	ТаблицаДанные.ТрудозатратыПланПослеПериода КАК ТрудозатратыПланПослеПериода,
	               |	ТаблицаДанные.Подразделение КАК Подразделение,
	               |	ТаблицаДанные.Записывать КАК Записывать,
	               |	ТаблицаДанные.Редактируется КАК Редактируется,
	               |	ТаблицаДанные.КрайнийСрок КАК КрайнийСрок,
	               |	ТаблицаДанные.ДатаНачалаТП КАК ДатаНачалаТП,
	               |	ТаблицаДанные.ДатаЗавершенияТП КАК ДатаЗавершенияТП,
	               |	ТаблицаДанные.ДатаНачалаНП КАК ДатаНачалаНП,
	               |	ТаблицаДанные.ИтогНовоеЗначение КАК ИтогНовоеЗначение,
	               |	ТаблицаДанные.ИтогПоРоли КАК ИтогПоРоли,
	               |	ТаблицаДанные.ПрофильРаспределенияРоли КАК ПрофильРаспределенияРоли,
	               |	ТаблицаДанные.ИтогТекущееЗначение КАК ИтогТекущееЗначение,
	               |	ТаблицаДанные.ДатаЗавершенияНП КАК ДатаЗавершенияНП
	               |ПОМЕСТИТЬ ТаблицаДанные
	               |ИЗ
	               |	&ТаблицаДанные КАК ТаблицаДанные
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПроектнаяЗадача
