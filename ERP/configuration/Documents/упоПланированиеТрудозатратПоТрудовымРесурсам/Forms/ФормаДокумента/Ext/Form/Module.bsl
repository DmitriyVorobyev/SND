&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеЗадачиВСтрокеДерева(СтрокаДерева) 
	
	ПредставлениеЗадачи = "" + СтрокаДерева.КодСДР + " " + СтрокаДерева.ПроектнаяЗадачаЗеркало;
	//ПредставлениеЗадачи = ПредставлениеЗадачи + " ";
	Если ЗначениеЗаполнено(СтрокаДерева.Роль) Тогда
		ПредставлениеЗадачи = ПредставлениеЗадачи + " (" + СтрокаДерева.Роль + ")";
	КонецЕсли;
	ПредставлениеЗадачи = ПредставлениеЗадачи + " [" + СтрокаДерева.Проект + "]";
	
	Возврат ПредставлениеЗадачи; 	
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РекурсивноЗаполнитьДерево(ЭтаФорма, тОбъект, Строки, СчетчикГруппировки, МассивГруппировок, ПоследняяГруппировка = Неопределено) 

	Если ПоследняяГруппировка = Неопределено Тогда
		ПоследняяГруппировка = МассивГруппировок[МассивГруппировок.Количество()-1];
	КонецЕсли;

	ИмяГруппировки = МассивГруппировок[СчетчикГруппировки];

	ЭтоПоследняяГруппировка = ИмяГруппировки = ПоследняяГруппировка; 

	Для Каждого СтрокаДерева Из Строки Цикл	
		
		СтрокаДерева.Группировка = СтрокаДерева[ИмяГруппировки];     
		СтрокаДерева.ИмяГруппировки = ИмяГруппировки;     
		//СтрокаДерева.УровеньДерева = СтрокаДерева.Уровень();
		СтрокаДерева.УровеньДерева = СчетчикГруппировки;
						
		// Сводное выражение УО формы для блеклых строк приведено к логической форме CNF.
		// Не ((Редактируется И НЕ ЕстьПраваНаРедактирование)
		//		ИЛИ (ЭтоСтрокаОстатка И НЕ ЕстьПраваНаРедактирование)
		//		ИЛИ (НЕ Редактируется И НЕ ЭтоСтрокаОстатка));				
		ЯркаяКартинка = СтрокаДерева.ЕстьПраваНаРедактирование 
			И (СтрокаДерева.Редактируется ИЛИ СтрокаДерева.ЭтоСтрокаОстатка);
		
		СтрокаДерева.ИндексКартинки = 
			упоРаботаСФормамиКлиентСервер.ИндексКартинкиДокументаПланирования(ИмяГруппировки, СтрокаДерева, ЯркаяКартинка);
		
		Если ИмяГруппировки = "ПроектнаяЗадачаЗеркало" И ЗначениеЗаполнено(СтрокаДерева.ПроектнаяЗадачаЗеркало) Тогда
			СтрокаДерева.ПредставлениеЗадачи = ПредставлениеЗадачиВСтрокеДерева(СтрокаДерева);  
		КонецЕсли;    
		
		Если (ИмяГруппировки = "ПроектнаяЗадачаЗеркало" ИЛИ ИмяГруппировки = "Проект") И НЕ ЗначениеЗаполнено(СтрокаДерева[ИмяГруппировки]) Тогда
			СтрокаДерева.ПредставлениеЗадачи = НСтр("ru = 'Нет назначенной ПЗ'");
			Если ЗначениеЗаполнено(СтрокаДерева.Роль) Тогда
				СтрокаДерева.ПредставлениеЗадачи = СтрокаДерева.ПредставлениеЗадачи + " (" + СтрокаДерева.Роль + ")";
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоПоследняяГруппировка Тогда
						
			СтрокаДерева.ПоследнийУровень = Истина;
			
			Отбор = Новый Структура("ТрудовойРесурс, Роль, ПроектнаяЗадача, Подразделение");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаДерева); 
					
			Отбор.Вставить("ТипДанных", "ТекущееЗначение");	
			СтрокиРаспределения = тОбъект.РаспределениеПоПериоду.НайтиСтроки(Отбор);	
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл			
				ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаРаспределения.Дата);									
				УстановитьЗначениеЯчейки(ЭтаФорма, СтрокаДерева, ИмяКолонки, "ТекущееЗначение", СтрокаРаспределения.Значение);				
			КонецЦикла;	
			
			//
				
			Отбор.Вставить("ТипДанных", "НовоеЗначение");	
			СтрокиРаспределения = тОбъект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
			СтрокаДерева.ДатаПервойЗагруки = тОбъект.КонецПериода + 24*3600;
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл	
				Если ЗначениеЗаполнено(СтрокаРаспределения.Значение) Тогда
					СтрокаДерева.ДатаПервойЗагруки = Мин(СтрокаРаспределения.Дата, СтрокаДерева.ДатаПервойЗагруки);
				КонецЕсли;
				ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаРаспределения.Дата);									
				ЗаполнитьТрудозатраты(ЭтаФорма, СтрокаДерева, ИмяКолонки, СтрокаРаспределения.Значение, Истина, Ложь, Ложь);					
			КонецЦикла;	
			
			//
			
			Отбор.Вставить("ТипДанных", "Факт");	
			СтрокиРаспределения = тОбъект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл			
				ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаРаспределения.Дата);									
				УстановитьЗначениеЯчейки(ЭтаФорма, СтрокаДерева, ИмяКолонки, "Факт", СтрокаРаспределения.Значение);	
			КонецЦикла;				
				
			//
			
			Отбор = Новый Структура("Роль, ПроектнаяЗадача, Подразделение");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаДерева);
			Отбор.Вставить("ТипДанных", "ПоРоли");	
			
			Если тОбъект.ПорядокГруппировок = 1 Тогда
				Если ТипЗнч(СтрокаДерева) = Тип("ДанныеФормыЭлементДерева") Тогда
					Родитель = СтрокаДерева.ПолучитьРодителя();
				Иначе
					Родитель = СтрокаДерева.Родитель;
				КонецЕсли;		
				УчитыватьВОбщемИтоге = Родитель.ИтогПоПериодуПоРоли = 0 И ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс);
			Иначе	
				УчитыватьВОбщемИтоге = ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс);
			КонецЕсли;	
			СтрокиРаспределения = тОбъект.РаспределениеПоПериоду.НайтиСтроки(Отбор);						
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл
				
				ИмяКолонки = ПолучитьИмяОсновнойКолонкиПоДате(СтрокаРаспределения.Дата);			
				
				УстановитьЗначениеЯчейки(ЭтаФорма, СтрокаДерева, ИмяКолонки, 
													"ПоРоли", СтрокаРаспределения.Значение,,Истина, УчитыватьВОбщемИтоге);
						
			КонецЦикла;																
						
		Иначе
			
			РекурсивноЗаполнитьДерево(ЭтаФорма, тОбъект, СтрокаДерева.ПолучитьЭлементы(), СчетчикГруппировки+1, МассивГруппировок, ПоследняяГруппировка);			
			
		КонецЕсли;
		
		
		СчитатьВычисляемыеИтогиСтроки(СтрокаДерева);
		
	КонецЦикла;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьЗначениеЯчейки(ЭтаФорма, СтрокаДерева, ИмяОсновнойКолонки, ТипКолонки, 
																НовоеЗначение, УчитыватьТекЗначение = Истина, 
																УстанавливатьВГруппировкахТекЗначение = Ложь,
																УчитыватьВОбщемИтоге = Истина) 	
	Если УчитыватьТекЗначение Тогда
		ТекЗначение = СтрокаДерева[ИмяОсновнойКолонки+ТипКолонки];
		Изменение = НовоеЗначение - ТекЗначение; 
	Иначе
		Изменение = НовоеЗначение;
	КонецЕсли;

	ТекСтрока = СтрокаДерева;

	Если УстанавливатьВГруппировкахТекЗначение Тогда
		сч = 0;
	КонецЕсли;
		
	Пока ТекСтрока <> Неопределено Цикл
		
		Если УстанавливатьВГруппировкахТекЗначение И Не ТекСтрока.ПоследнийУровень Тогда 
			
			Если ЭтаФорма.Объект.ПорядокГруппировок = 1 И ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда
				ТекСтрока[ИмяОсновнойКолонки+ТипКолонки] = ТекСтрока[ИмяОсновнойКолонки+ТипКолонки] + Изменение;
				Если ТипКолонки <> "ПоРоли" Или (ТипКолонки = "ПоРоли" И УчитыватьВОбщемИтоге) Тогда
					ТекСтрока["ИтогПоПериоду"+ТипКолонки] = ТекСтрока["ИтогПоПериоду"+ТипКолонки] + Изменение;
				
					Если сч = 0 И УстанавливатьВГруппировкахТекЗначение И УчитыватьВОбщемИтоге Тогда
						ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки] = ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки] + Изменение;
						ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки] = ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки] + Изменение;
					КонецЕсли;
				КонецЕсли;	
			ИначеЕсли Не ЭтаФорма.Объект.ПорядокГруппировок = 1 Тогда//И ЗначениеЗаполнено(СтрокаДерева.ТрудовойРесурс) Тогда
				ТекСтрока[ИмяОсновнойКолонки+ТипКолонки] = ТекСтрока[ИмяОсновнойКолонки+ТипКолонки] + Изменение;		
				ТекСтрока["ИтогПоПериоду"+ТипКолонки] = ТекСтрока["ИтогПоПериоду"+ТипКолонки] + Изменение;
				
				Если сч = 0 И УстанавливатьВГруппировкахТекЗначение И УчитыватьВОбщемИтоге Тогда
					ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки] = ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки] + Изменение;
					ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки] = ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки] + Изменение;
				КонецЕсли;
			КонецЕсли;	
			
			сч = сч + 1;

		Иначе
			
			ТекСтрока[ИмяОсновнойКолонки+ТипКолонки] = ТекСтрока[ИмяОсновнойКолонки+ТипКолонки] + Изменение;	
			ТекСтрока["ИтогПоПериоду"+ТипКолонки] = ТекСтрока["ИтогПоПериоду"+ТипКолонки] + Изменение;	
			
		КонецЕсли;
			
		Если ТипЗнч(ТекСтрока) = Тип("ДанныеФормыЭлементДерева") Тогда
			ТекСтрока = ТекСтрока.ПолучитьРодителя();
		Иначе
			ТекСтрока = ТекСтрока.Родитель;
		КонецЕсли;		
		
	КонецЦикла;	

	Если НЕ УстанавливатьВГруппировкахТекЗначение Тогда	
		ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки] = ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки] + Изменение;		
		ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки] = ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки] + Изменение;
	КонецЕсли;

	//ЭтаФорма["Подвал"+ТипКолонки+ИмяОсновнойКолонки] = Формат(ЭтаФорма["Итого"+ТипКолонки+ИмяОсновнойКолонки], "ЧДЦ=1; ЧН=");
	ЭтаФорма["ПодвалОбщийИтогПоПериоду"+ТипКолонки] = Формат(ЭтаФорма["ОбщийИтогПоПериоду"+ТипКолонки], "ЧДЦ=1; ЧН=");	

