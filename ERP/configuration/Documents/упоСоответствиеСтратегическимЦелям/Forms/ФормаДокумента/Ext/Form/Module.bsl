#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаФормыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Неопределено ИЛИ ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	Если Поле.Имя = "ТаблицаФормыПроект" Тогда
		СтандартнаяОбработка = Ложь;
		Данные = ТаблицаФормы.НайтиПоИдентификатору(ВыбраннаяСтрока);
		ПоказатьЗначение(, Данные.Проект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокЦелейПриИзменении(Элемент)
	
	Если СписокЦелей.Количество() > 1 Тогда
		СписокЦелей.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.СвернутьМассив(СписокЦелей.ВыгрузитьЗначения()));
	КонецЕсли;	
	
	СписокЦелейПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КолонкаПриИзменении(Элемент) 
	
	ТекДанные = Элементы.ТаблицаФормы.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		СтрокиКолонок = ТаблицаКолонок.НайтиСтроки(Новый Структура("ИмяКолонки", Элемент.Имя));
		Если СтрокиКолонок.Количество() > 0 Тогда
			Влияние = ТекДанные[Элемент.Имя];
			Вес = ОпределитьВесПоВлиянию(Влияние);
			ТекДанные[СтрокиКолонок[0].ИмяКолонкиВес] = Вес;
			ПосчитатьБаллВСтроке(ЭтаФорма, ТекДанные);
			ПостроитьДиаграмму(ЭтаФорма);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_КолонкаВесПриИзменении(Элемент) 
	
	ТекДанные = Элементы.ТаблицаФормы.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		СтрокиКолонок = ТаблицаКолонок.НайтиСтроки(Новый Структура("ИмяКолонкиВес", Элемент.Имя));
		Если СтрокиКолонок.Количество() > 0 Тогда
			Вес = ТекДанные[Элемент.Имя];
			Влияние = ОпределитьВлияниеПоВесу(Вес);
			ТекДанные[СтрокиКолонок[0].ИмяКолонки] = Влияние;
			ПосчитатьБаллВСтроке(ЭтаФорма, ТекДанные);
			ПостроитьДиаграмму(ЭтаФорма);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

