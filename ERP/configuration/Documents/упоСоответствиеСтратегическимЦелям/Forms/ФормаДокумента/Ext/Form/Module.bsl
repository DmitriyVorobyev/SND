// Конец СтандартныеПодсистемы.Свойства

&НаСервере
Функция ПостроитьТаблицуФормыПоДаннымОбъекта(ПересчитатьИтоговыйБалл = Истина) 
	
	СоответствиеЦелейКолонкам = Новый Соответствие;
	
	ТипВлияние = Новый ОписаниеТипов("ПеречислениеСсылка.упоВлияниеЦелей");
	ТипВес = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3,0));
	
	МассивРеквизитов = Новый Массив;
	Для Каждого СтрокаКолонки Из ТаблицаКолонок Цикл
		МассивРеквизитов.Добавить("ТаблицаФормы." + СтрокаКолонки.ИмяКолонки);	
		МассивРеквизитов.Добавить("ТаблицаФормы." + СтрокаКолонки.ИмяКолонкиВес);
		Элементы.Удалить(Элементы.Найти(СтрокаКолонки.ИмяКолонки));
		Элементы.Удалить(Элементы.Найти(СтрокаКолонки.ИмяКолонкиВес));
	КонецЦикла;
	
	ИзменитьРеквизиты(, МассивРеквизитов);
	
	ТаблицаКолонок.Очистить();
	ТаблицаФормы.Очистить();
	СписокЦелей.Очистить();
		
	МассивРеквизитов = Новый Массив;
	Сч = 1;
	Для Каждого СтрокаЦели Из Объект.Цели Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаЦели.Цель) Тогда 
			Продолжить; 
		КонецЕсли;
		
		СписокЦелей.Добавить(СтрокаЦели.Цель);
		
		Имя = "КолонкаЦели" + Формат(Сч, "ЧН=; ЧГ=");
		ИмяВес = "КолонкаЦелиВес" + Формат(Сч, "ЧН=; ЧГ=");
					
		Реквизит = Новый РеквизитФормы(Имя, ТипВлияние, "ТаблицаФормы", Строка(СтрокаЦели.Цель), Истина);
		МассивРеквизитов.Добавить(Реквизит);		
		Реквизит = Новый РеквизитФормы(ИмяВес, ТипВес, "ТаблицаФормы", "Вес", Истина);
		МассивРеквизитов.Добавить(Реквизит);	
		
		СтрокаКолонки = ТаблицаКолонок.Добавить();
		СтрокаКолонки.Цель = СтрокаЦели.Цель;
		СтрокаКолонки.ИмяКолонки = Имя;
		СтрокаКолонки.ИмяКолонкиВес = ИмяВес;
		
		СоответствиеЦелейКолонкам.Вставить(СтрокаЦели.Цель, Новый Структура("ИмяКолонки, ИмяКолонкиВес", Имя, ИмяВес));
						
		Сч = Сч +1;
	КонецЦикла;	
	
	ИзменитьРеквизиты(МассивРеквизитов);
		
	УстановитьУсловноеОформлениеТаблицыФормы();	
		
	Для Каждого Строка Из Объект.БаллыПроектов Цикл
		
		СтрокаТаблицы = ТаблицаФормы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Строка);
		
		ЦветПроекта = СтрокаТаблицы.Проект.ЦветПроекта;
		Если ЗначениеЗаполнено(ЦветПроекта) Тогда
			КСЗ = упоФункцииОбщегоНазначенияСервер.ОписаниеЦвета(ЦветПроекта, 2);		
			СтрокаТаблицы.Цвет = Новый Цвет(КСЗ.Красный, КСЗ.Зеленый, КСЗ.Синий); 
		КонецЕсли;
				
		Для Каждого СтрокаКолонки Из ТаблицаКолонок Цикл
			СтрокаТаблицы[СтрокаКолонки.ИмяКолонки]	= Перечисления.упоВлияниеЦелей.нет;												
		КонецЦикла;	
				
		СтрокиРасчета = Объект.Расчет.НайтиСтроки(Новый Структура("Проект", СтрокаТаблицы.Проект));
		Для Каждого СтрокаРасчета Из СтрокиРасчета Цикл
			СтруктураИменКолонок = СоответствиеЦелейКолонкам.Получить(СтрокаРасчета.Цель);
			
			Если СтруктураИменКолонок <> Неопределено Тогда			
				СтрокаТаблицы[СтруктураИменКолонок.ИмяКолонки] = СтрокаРасчета.Влияние;
				СтрокаТаблицы[СтруктураИменКолонок.ИмяКолонкиВес] = СтрокаРасчета.Вес;			
			КонецЕсли;			
		КонецЦикла;
		
		Если ПересчитатьИтоговыйБалл Тогда
			ПосчитатьБаллВСтроке(ЭтаФорма, СтрокаТаблицы);
		КонецЕсли;	
		
	КонецЦикла;
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВесВлияния(Влияние)
	
	Если Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.критичное") Тогда
		Делитель = 2;
	ИначеЕсли Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.сильное") Тогда		
		Делитель = 3;
	ИначеЕсли Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.среднее") Тогда		
		Делитель = 4;
	ИначеЕсли Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.незначительное") Тогда
		Делитель = 5;
	Иначе
		Делитель = 0;	
	КонецЕсли;
	
	Если Делитель = 0 Тогда
		Возврат 0;
	Иначе
		Возврат 100 / (Делитель*Делитель);
	КонецЕсли;	
		
КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьВлияниеПоВесу(Вес) 
	
	Если Вес > 0 И Вес <= 10 Тогда
		Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.незначительное")
	ИначеЕсли Вес > 10 И Вес <= 25 Тогда
		Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.среднее")
	ИначеЕсли Вес > 25 И Вес <= 50 Тогда
		Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.сильное")
	ИначеЕсли Вес > 50 Тогда 			
		Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.критичное")
	Иначе
		Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.нет")
	КонецЕсли;

	Возврат Влияние;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьВесПоВлиянию(Влияние) 
	
	Если Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.критичное") Тогда
		Вес = 100;
	ИначеЕсли Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.незначительное") Тогда
		Вес = 10;
	ИначеЕсли Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.сильное") Тогда
		Вес = 50;
	ИначеЕсли Влияние = ПредопределенноеЗначение("Перечисление.упоВлияниеЦелей.среднее") Тогда
		Вес = 25;
	Иначе                                                                                     	
		Вес = 0;	
	КонецЕсли;
	
	Возврат Вес;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПостроитьДиаграмму(ЭтаФорма) 
	
	Диаграмма = ЭтаФорма.Диаграмма;
	Диаграмма.Очистить();	
	
	Диаграмма.ОписаниеПалитрыЦветов.ПалитраЦветов = ПалитраЦветовДиаграммы.Мягкая; 	
	Диаграмма.ПорядокСерийВЛегенде = ПорядокСерийВЛегендеДиаграммы.Обратный;
	
	СоответствиеТочек = Новый Соответствие;
	
	Для Каждого ЭлементСписка Из ЭтаФорма.СписокЦелей Цикл
		
		Точка = Диаграмма.Точки.Добавить();
		Точка.Значение = ЭлементСписка.Значение;
		Точка.Текст = ЭлементСписка.Значение;
		СоответствиеТочек.Вставить(ЭлементСписка.Значение, Точка);
		
	КонецЦикла;
	
	сч = ЭтаФорма.ТаблицаФормы.Количество() - 1;
	Пока сч >= 0 Цикл
		
		СтрокаПроекта = ЭтаФорма.ТаблицаФормы[сч];
		сч = сч - 1;	
		
		Серия = Диаграмма.Серии.Добавить(СтрокаПроекта.Проект);
		Если СтрокаПроекта.Цвет.Зеленый = 0 И СтрокаПроекта.Цвет.Синий = 0 И СтрокаПроекта.Цвет.Красный = 0 Тогда
		Иначе
			Серия.Цвет = СтрокаПроекта.Цвет;
		КонецЕсли;
		Серия.Текст = СтрокаПроекта.Проект;
		
		Для Каждого СтрокаКолонки Из ЭтаФорма.ТаблицаКолонок Цикл
			
			Точка = СоответствиеТочек.Получить(СтрокаКолонки.Цель);	
			Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаПроекта[СтрокаКолонки.ИмяКолонкиВес]);
			
		КонецЦикла;

	КонецЦикла;			
	
КонецФункции

&НаСервере
Функция ЗагрузитьТаблицуФормыВОбъект(пОбъект)
	
	пОбъект.Расчет.Очистить();
	пОбъект.БаллыПроектов.Очистить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
		СтрокаПроект = пОбъект.БаллыПроектов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПроект, СтрокаТаблицы);
		Для Каждого СтрокаКолонки Из ТаблицаКолонок Цикл
			СтрокаОбъекта = пОбъект.Расчет.Добавить();
			СтрокаОбъекта.Цель = СтрокаКолонки.Цель;
			СтрокаОбъекта.Проект = СтрокаТаблицы.Проект;
			СтрокаОбъекта.Заявка = СтрокаТаблицы.Заявка;
			СтрокаОбъекта.Влияние = СтрокаТаблицы[СтрокаКолонки.ИмяКолонки];
			СтрокаОбъекта.Вес = СтрокаТаблицы[СтрокаКолонки.ИмяКолонкиВес];
		КонецЦикла;
	КонецЦикла;
	
	ОбновитьЦелиОбъекта();
		
КонецФункции

&НаСервере
Процедура ОбновитьЦелиОбъекта()
	
	Объект.Цели.Очистить();
	
	Для Каждого Элемент Из СписокЦелей Цикл
		НовСтр = Объект.Цели.Добавить();
		НовСтр.Цель = Элемент.Значение;
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура СписокЦелейПриИзмененииСервер()
	
	ОбновитьЦелиОбъекта();	 
	
	ПостроитьТаблицуФормыПоДаннымОбъекта();		
	ПостроитьДиаграмму(ЭтаФорма);
	
КонецПроцедуры	

&НаСервере
Функция ЗаполнитьИнициативыСервер() 
	
	ОбновитьПроектыОбъекта();		
	
	ПостроитьТаблицуФормыПоДаннымОбъекта();   
	ПостроитьДиаграмму(ЭтаФорма);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПосчитатьБаллВСтроке(ЭтаФорма, СтрокаТаблицы)
	
	СтрокаТаблицы.Балл = 0;
		
	Для Каждого СтрокаКолонок Из ЭтаФорма.ТаблицаКолонок Цикл				
		ВесВлияния = ВесВлияния(СтрокаТаблицы[СтрокаКолонок.ИмяКолонки]);				
		СтрокаТаблицы.Балл = СтрокаТаблицы.Балл + ВесВлияния;				
	КонецЦикла;		
	
КонецПроцедуры

&НаСервере
Функция ОбновитьПроектыОбъекта() 
	
	Запрос = Новый Запрос;
		
	ТекстЗапроса =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	упоСтатусыЗаявокНаПроектСрезПоследних.ЗаявкаНаПроект.Проект КАК Проект,
	                |	упоСтатусыЗаявокНаПроектСрезПоследних.ЗаявкаНаПроект КАК ЗаявкаНаПроект
	                |ИЗ
	                |	РегистрСведений.упоСтатусыЗаявокНаПроект.СрезПоследних(, ) КАК упоСтатусыЗаявокНаПроектСрезПоследних";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
								
	ПоляОтбора = Новый Массив;
	ПоляОтбора.Добавить("Подразделение");
	ПоляОтбора.Добавить("ПортфельПроектов");
	ПоляОтбора.Добавить("ПрограммаПроектов");
	
	ЕстьОтбор = Ложь;
	
	ШаблонУсловия = "Проекты.%1 = &%1";		
	МассивОтборов = Новый Массив;
	Для Каждого ПолеОтбора Из ПоляОтбора Цикл		
		Если ЗначениеЗаполнено(Объект[ПолеОтбора]) Тогда
			Запрос.УстановитьПараметр(ПолеОтбора, Объект[ПолеОтбора]);	
			МассивОтборов.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонУсловия, ПолеОтбора));			
			ЕстьОтбор = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьОтбор Тогда
		ТекстОтбора = "ЗаявкаНаПроект.Проект В (ВЫБРАТЬ
	              |	Проекты.Ссылка КАК Ссылка
	              |ИЗ
	              |	Справочник.Проекты КАК Проекты ГДЕ " + СтрСоединить(МассивОтборов, " И ") + ")";								
		
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Источники[0].Источник.Параметры[1].Выражение = 
			Новый ВыражениеСхемыЗапроса(ТекстОтбора);
	КонецЕсли;	
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Объект.БаллыПроектов.Очистить();		
	Иначе
		Объект.БаллыПроектов.Загрузить(Результат.Выгрузить());
	КонецЕсли;	
		
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформлениеТаблицыФормы()
		
	МассивУОДляУдаления = Новый Массив;
	Для Каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если Элемент.Представление = "#СЛУЖЕБНОЕ#" Тогда
			МассивУОДляУдаления.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из МассивУОДляУдаления Цикл
		УсловноеОформление.Элементы .Удалить(Элемент);	
	КонецЦикла;
	
	ЦветКрит = Новый Цвет(91, 155, 213);
	ЦветСил =  Новый Цвет(210, 222, 239);
	ЦветСред = Новый Цвет(234, 239, 247);
	ЦветСлаб = ЦветСил;
	ЦветНет = ЦветСред; 
	
	Для Каждого СтрокаКолонки Из ТаблицаКолонок Цикл
		
		Элемент = Элементы.Добавить(СтрокаКолонки.ИмяКолонки, Тип("ПолеФормы"), Элементы.ТаблицаФормыГруппаКолонок);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = "ТаблицаФормы." + СтрокаКолонки.ИмяКолонки;
		Элемент.РастягиватьПоГоризонтали = Ложь;
		Элемент.Ширина = 14;
		Элемент.БыстрыйВыбор = Истина;
		Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_КолонкаПриИзменении");
		
		Элемент = Элементы.Добавить(СтрокаКолонки.ИмяКолонкиВес, Тип("ПолеФормы"), Элементы.ТаблицаФормыГруппаКолонок);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = "ТаблицаФормы." + СтрокаКолонки.ИмяКолонкиВес;
		Элемент.РастягиватьПоГоризонтали = Ложь;
		Элемент.Ширина = 4;
		Элемент.БыстрыйВыбор = Истина;
		Элемент.УстановитьДействие("ПриИзменении", "Подключаемый_КолонкаВесПриИзменении");
	
		ДобавитьУОПоПолю(СтрокаКолонки, Перечисления.упоВлияниеЦелей.критичное, ЦветКрит);
		ДобавитьУОПоПолю(СтрокаКолонки, Перечисления.упоВлияниеЦелей.сильное, ЦветСил);
		ДобавитьУОПоПолю(СтрокаКолонки, Перечисления.упоВлияниеЦелей.среднее, ЦветСред);
		ДобавитьУОПоПолю(СтрокаКолонки, Перечисления.упоВлияниеЦелей.незначительное, ЦветСлаб);
		ДобавитьУОПоПолю(СтрокаКолонки, Перечисления.упоВлияниеЦелей.нет, ЦветНет);
			
		НовоеУО = УсловноеОформление.Элементы.Добавить();	
		НовоеУО.Представление = "#СЛУЖЕБНОЕ#";
		НовоеУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		НовоеУО.Использование = Истина;
		Поле = НовоеУО.Поля.Элементы.Добавить();
		Поле.Использование = Истина;
		Поле.Поле = Новый ПолеКомпоновкиДанных(СтрокаКолонки.ИмяКолонки);
		НовыйЭлементУООтбор = НовоеУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
		НовыйЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПоВесам");
		НовыйЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлементУООтбор.ПравоеЗначение = Истина;	
		
		НовоеУО = УсловноеОформление.Элементы.Добавить();	
		НовоеУО.Представление = "#СЛУЖЕБНОЕ#";
		НовоеУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		НовоеУО.Использование = Истина;
		Поле = НовоеУО.Поля.Элементы.Добавить();
		Поле.Использование = Истина;
		Поле.Поле = Новый ПолеКомпоновкиДанных(СтрокаКолонки.ИмяКолонкиВес);
		НовыйЭлементУООтбор = НовоеУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
		НовыйЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПоВесам");
		НовыйЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлементУООтбор.ПравоеЗначение = Ложь;		
		
	КонецЦикла;	
	
КонецПроцедуры	
	
&НаСервере
Функция ДобавитьУОПоПолю(СтрокаКолонки, Влияние, Цвет) 
	
	НовоеУО = УсловноеОформление.Элементы.Добавить();	
	НовоеУО.Представление = "#СЛУЖЕБНОЕ#";
	НовоеУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);
	НовоеУО.Использование = Истина;
	Поле = НовоеУО.Поля.Элементы.Добавить();
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных(СтрокаКолонки.ИмяКолонки);
	Поле = НовоеУО.Поля.Элементы.Добавить();
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных(СтрокаКолонки.ИмяКолонкиВес);
	НовыйЭлементУООтбор = НовоеУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	НовыйЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаФормы."+СтрокаКолонки.ИмяКолонки);
	НовыйЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементУООтбор.ПравоеЗначение = Влияние;
	
КонецФункции

&НаКлиенте
Процедура СнятьВыделениеСтрок()
	
	Элементы.ТаблицаФормы.ТекущаяСтрока = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеФормы(Отказ)
	
	Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Проект) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'В строке %1 не заполнен проект'"),
				СтрокаТаблицы.ПолучитьИдентификатор());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,);
			Отказ = Истина;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПриоритетПроектов(БаллыПроектов)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого КлючЗначение Из БаллыПроектов Цикл
		ПроектОбъект = КлючЗначение.Ключ.ПолучитьОбъект();
		Если ПроектОбъект.Приоритет <> КлючЗначение.Значение Тогда
			ПроектОбъект.Приоритет = КлючЗначение.Значение;
			ПроектОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция БаллыПроектов()
	
	БаллыПроектов = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ТаблицаФормы Цикл
		БаллыПроектов.Вставить(СтрокаТаблицы.Проект, СтрокаТаблицы.Балл);
	КонецЦикла;
	
	Возврат БаллыПроектов;
	
КонецФункции

#КонецОбласти
