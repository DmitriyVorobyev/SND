	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ДляВсехСтрок(ЗначениеРазрешено(Данные.ПроектнаяЗадачаЗеркало.упоКорневойПроект, NULL КАК ИСТИНА))";

