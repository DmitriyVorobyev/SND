// Функция получает изменяемые задачи и проекты.
//
// Параметры:
//  ДокументСсылка	- ДокументСсылка - Документ прогноза. 
// 
// Возвращаемое значение:
//  Структура 		- содержит два поля с типом массив: МассивПроектов и МассивЗадач.
//
Функция ПолучитьИзменяемыеЗадачиИПроекты(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоПрогнозТрудозатратДанные.ПроектнаяЗадачаЗеркало.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
	               |	упоПрогнозТрудозатратДанные.ПроектнаяЗадачаЗеркало.упоКорневойПроект КАК Проект
	               |ИЗ
	               |	Документ.упоПрогнозТрудозатратПоРолям.Данные КАК упоПрогнозТрудозатратДанные
	               |ГДЕ
	               |	упоПрогнозТрудозатратДанные.Ссылка = &Ссылка
	               |	И упоПрогнозТрудозатратДанные.Записывать
				   |	И НЕ упоПрогнозТрудозатратДанные.ПроектнаяЗадачаЗеркало.СсылкаНаПроектнуюЗадачу ЕСТЬ NULL";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ТаблицаПЗ = Запрос.Выполнить().Выгрузить();
	МассивЗадач = ТаблицаПЗ.ВыгрузитьКолонку("ПроектнаяЗадача");
	ТаблицаПЗ.Свернуть("Проект");
	МассивПроектов = ТаблицаПЗ.ВыгрузитьКолонку("Проект");
	
	Результат = Новый Структура("МассивПроектов, МассивЗадач", МассивПроектов, МассивЗадач);
	
	Возврат Результат;
	
КонецФункции

