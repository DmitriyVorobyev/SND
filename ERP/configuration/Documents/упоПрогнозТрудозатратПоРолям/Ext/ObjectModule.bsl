Функция ПоследнийРабочийДеньПериодаДокумента(НачалоОтчетногоПериода, КонецОтчетногоПериода)
	
	ПоследнийРабочийДеньПериодаДокумента = КонецОтчетногоПериода;
	
	Если Не ЗаписыватьПроцентГотовности Тогда
		Возврат ПоследнийРабочийДеньПериодаДокумента;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонецОтчетногоПериода", КонецОтчетногоПериода);
	Запрос.УстановитьПараметр("НачалоОтчетногоПериода", НачалоОтчетногоПериода);
	Запрос.УстановитьПараметр("РабочийКалендарь", Константы.упоРабочийКалендарьПоУмолчанию.Получить());
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегКалендарь.День КАК День
	|ИЗ
	|	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	|			,
	|			(День МЕЖДУ &НачалоОтчетногоПериода И &КонецОтчетногоПериода)
	|				И Календарь = &РабочийКалендарь) КАК РегКалендарь
	|ГДЕ
	|	РегКалендарь.КоличествоЧасов > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	День УБЫВ";
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ПоследнийРабочийДеньПериодаДокумента = Выборка.День;
	КонецЕсли;
	
	Возврат ПоследнийРабочийДеньПериодаДокумента;
	
КонецФункции

Функция СформироватьДвижения_ПланаТрудовыхРесурсов(ДеревоТрудозатрат, ТекущийПланТРПоЗадачам, ТекущийПланРаспределенияТРПоЗадачам, ТаблицаИндексовСтрокРаспределения)
	
	врРаспределениеТР = ТекущийПланРаспределенияТРПоЗадачам.СкопироватьКолонки();
	
	Измерения_упоДанныеПлановТрудозатратРолей = "";
	Для Каждого Измерение Из Метаданные.РегистрыСведений.упоДанныеПлановТрудозатратРолей.Измерения Цикл
		Измерения_упоДанныеПлановТрудозатратРолей = Измерения_упоДанныеПлановТрудозатратРолей + ?(ЗначениеЗаполнено(Измерения_упоДанныеПлановТрудозатратРолей), ", ", "") + Измерение.Имя;
	КонецЦикла;
	
	Измерения_упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам = "";
	Для Каждого Измерение Из Метаданные.РегистрыСведений.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Измерения Цикл
		Измерения_упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам = Измерения_упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам + ?(ЗначениеЗаполнено(Измерения_упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам), ", ", "") + Измерение.Имя;
	КонецЦикла;
		
	Для Каждого СтрокаПроекта Из ДеревоТрудозатрат.Строки Цикл       
		Для Каждого СтрокаПЗ Из СтрокаПроекта.Строки Цикл
			
			НайденнаяСтрока = ТаблицаИндексовСтрокРаспределения.Найти(СтрокаПЗ.ПроектнаяЗадача, "ПроектнаяЗадача");
			Если НайденнаяСтрока = Неопределено Или НайденнаяСтрока.ИндексСтрокРаспределения = Неопределено Тогда
				СчетчикИндекса = 1;
			Иначе
				СчетчикИндекса = НайденнаяСтрока.ИндексСтрокРаспределения + 1;
			КонецЕсли;	
			
			Для Каждого СтрокаРоли Из СтрокаПЗ.Строки Цикл
				Для Каждого СтрокаПодразделения Из СтрокаРоли.Строки Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("Ресурс", СтрокаРоли.Роль);
					Отбор.Вставить("УровеньПланирования", УровеньПланированияРолей);
					Отбор.Вставить("Подразделение", СтрокаПодразделения.Подразделение);
					Отбор.Вставить("ПроектнаяЗадача", СтрокаПЗ.ПроектнаяЗадача);
					
					СтрокиТекущегоПлана = ТекущийПланТРПоЗадачам.НайтиСтроки(Отбор);
					
					Запись = Движения.упоДанныеПлановТрудозатратРолей.Добавить();
					Запись.Период = Дата;
					Запись.Активность = Истина;
					Запись.Версия = СтрокаПЗ.Версия;
					Запись.ПроектнаяЗадача = СтрокаПЗ.ПроектнаяЗадача;
					Запись.УровеньПланирования = УровеньПланированияРолей;
					Запись.Ресурс = СтрокаПодразделения.Роль;
					Запись.Подразделение = СтрокаПодразделения.Подразделение;
					Запись.ИсточникПлана = Перечисления.упоИсточникПланаТрудозатратРолей.Трудозатраты;
					
					Запись.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.Вручную;
					Запись.ИндексСтрокРаспределения = СчетчикИндекса;														
					СчетчикИндекса = СчетчикИндекса + 1;
					
					Если СтрокиТекущегоПлана.Количество() > 0 Тогда
						Запись.ПрофильРаспределения = СтрокиТекущегоПлана[0].ПрофильРаспределения;
						Если ЗначениеЗаполнено(СтрокиТекущегоПлана[0].КоэффициентЕдИзмерения) Тогда
							Запись.Количество = СтрокаПодразделения.Трудозатраты / СтрокиТекущегоПлана[0].КоэффициентЕдИзмерения;
						Иначе
							Запись.Количество = 0;
						КонецЕсли;
						Запись.Стоимость = СтрокиТекущегоПлана[0].Стоимость;
						Запись.ВнешняяСтоимость = СтрокиТекущегоПлана[0].ВнешняяСтоимость;
						Запись.Основной = СтрокиТекущегоПлана[0].Основной;
						Запись.ЕдиницаНормирования = СтрокиТекущегоПлана[0].ЕдиницаНормирования;
					Иначе
						Запись.ПрофильРаспределения = Справочники.упоПрофилиРаспределенияТрудозатрат.РавномерноеРаспределение;
						Запись.Количество = СтрокаПодразделения.Трудозатраты / СтрокаПодразделения.КоэффициентЕдНормирования;
						Запись.ЕдиницаНормирования = Справочники.упоЕдиницыВремени.Час;
						Запись.Стоимость = СтрокаПодразделения.ЕдСтоимость / СтрокаПодразделения.КоэффициентЕдНормирования;				
						Запись.ВнешняяСтоимость = СтрокаПодразделения.ВнешняяЕдСтоимость / СтрокаПодразделения.ВнешняяКоэффициентЕдНормирования;
					КонецЕсли;		
					
					Запись.ОбщСтоимость = Запись.Стоимость * Окр(Запись.Количество, 2);  
					Запись.ОбщВнешняяСтоимость = Запись.ВнешняяСтоимость * Окр(Запись.Количество, 2);  
					
					врРаспределениеТР.Очистить();
					ЗаписьРаспределение = Неопределено;
					
					Для Каждого СтрокаДетальная Из СтрокаПодразделения.Строки Цикл
						ЗаписьРаспределение = Движения.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Добавить();
						ЗаписьРаспределение.Активность = Истина;
						ЗаписьРаспределение.Период = Дата;
						ЗаписьРаспределение.Версия = Запись.Версия;
						ЗаписьРаспределение.ПроектнаяЗадача =  Запись.ПроектнаяЗадача;
						ЗаписьРаспределение.ПериодРаспределения =  КонецМесяца(СтрокаДетальная.Месяц);
						ЗаписьРаспределение.ИндексСтрокиРаспределениеПоРолям =  Запись.ИндексСтрокРаспределения;			
						ЗаписьРаспределение.Количество =  СтрокаДетальная.Трудозатраты / Запись.ЕдиницаНормирования.Коэффициент;
						ЗаполнитьЗначенияСвойств(врРаспределениеТР.Добавить(), ЗаписьРаспределение);
					КонецЦикла;
					
					Для Каждого СтрокаТекущегоПлана Из СтрокиТекущегоПлана Цикл
						
						ПолноеСовпадение = Истина;						
						СтруктураИзмерений = Новый Структура(Измерения_упоДанныеПлановТрудозатратРолей);
						
						Для Каждого КлючЗначение Из СтруктураИзмерений Цикл
							Если СтрокаТекущегоПлана[КлючЗначение.Ключ] <> Запись[КлючЗначение.Ключ] Тогда
								ПолноеСовпадение = Ложь;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
						Если НЕ ПолноеСовпадение Тогда
							ЗаписьОбнуления = Движения.упоДанныеПлановТрудозатратРолей.Добавить();
							ЗаполнитьЗначенияСвойств(ЗаписьОбнуления, СтрокаТекущегоПлана, Измерения_упоДанныеПлановТрудозатратРолей);
							ЗаписьОбнуления.Активность = Истина;
							ЗаписьОбнуления.Период = Дата;
						КонецЕсли;
						
						СтруктураИзмерений = Новый Структура(Измерения_упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам);
						
						СтрокиРаспределения = ТекущийПланРаспределенияТРПоЗадачам.НайтиСтроки(Новый Структура("ИндексСтрокиРаспределениеПоРолям, ПроектнаяЗадача", СтрокаТекущегоПлана.ИндексСтрокРаспределения, СтрокаТекущегоПлана.ПроектнаяЗадача));
						Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл
													
							ЗаполнитьЗначенияСвойств(СтруктураИзмерений, СтрокаРаспределения, Измерения_упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам); 
							Если врРаспределениеТР.НайтиСтроки(СтруктураИзмерений).Количество() = 0 Тогда
								ЗаписьОбнуления = Движения.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Добавить();
								ЗаполнитьЗначенияСвойств(ЗаписьОбнуления, СтруктураИзмерений);	
								ЗаписьОбнуления.Активность = Истина;
								ЗаписьОбнуления.Период = Дата;
							КонецЕсли;
									
							ТекущийПланРаспределенияТРПоЗадачам.Удалить(СтрокаРаспределения);
							
						КонецЦикла;
						
						ТекущийПланТРПоЗадачам.Удалить(СтрокаТекущегоПлана);
						
					КонецЦикла;
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
		
КонецФункции 

Функция СформироватьДвижения_ТрудозатратыРесурсовПоДням(МассивЗадач)
		
	упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(МассивЗадач, ЭтотОбъект.Ссылка);	
		   	
КонецФункции 

Процедура НачальноеЗаполнениеТекДокументаПоПроекту(Проект)

	ЭтотОбъект.Проекты.Добавить().Проект = Проект;
	ЭтотОбъект.ПорядокГруппировок = Перечисления.упоПорядокГруппировокПрогнозированиеТрудозатрат.ПроектЗадачаРольПодразделение;
	
	лСрокиПроекта = ПолучитьСрокиПроектаДляЗаполнения(Проект);
	
	ЭтотОбъект.НачалоПериода = лСрокиПроекта.НачалоПериода;
	ЭтотОбъект.КонецПериода = лСрокиПроекта.КонецПериода;	
	
КонецПроцедуры	

Процедура НачальноеЗаполнениеТекДокументаПоСтруктуре(Структура)
	
	Если Структура.Свойство("Проект") Тогда
		Проекты.Очистить();
		Проекты.Добавить().Проект = Структура.Проект;	
	КонецЕсли;
	Если Структура.Свойство("ПорядокГруппировок") Тогда
		ЭтотОбъект.ПорядокГруппировок = Структура.ПорядокГруппировок;	
	КонецЕсли;
	Если Структура.Свойство("НачалоПериода") И Структура.Свойство("КонецПериода") Тогда
		ЭтотОбъект.НачалоПериода = Структура.НачалоПериода;	
		ЭтотОбъект.КонецПериода = Структура.КонецПериода;	
	ИначеЕсли Структура.Свойство("Проект") Тогда
		СрокиПроекта = ПолучитьСрокиПроектаДляЗаполнения(Структура.Проект);
		ЭтотОбъект.НачалоПериода = СрокиПроекта.НачалоПериода;	
		ЭтотОбъект.КонецПериода = СрокиПроекта.КонецПериода;	
	Иначе
		СрокиПоУмолчанию = ПолучитьСрокиПоУмолчанию();
		ЭтотОбъект.НачалоПериода = СрокиПоУмолчанию.НачалоПериода;	
		ЭтотОбъект.КонецПериода = СрокиПоУмолчанию.КонецПериода;
	КонецЕсли;
	Если Структура.Свойство("Роли") Тогда
		ЭтотОбъект.Роли.Очистить();
		Для Каждого Роль ИЗ Структура.Роли Цикл
			ЭтотОбъект.Роли.Добавить().Роль = Роль;	
		КонецЦикла;
	КонецЕсли;
	Если Структура.Свойство("Проекты") Тогда
		ЭтотОбъект.Проекты.Очистить();
		Для Каждого Проект ИЗ Структура.Проекты Цикл
			ЭтотОбъект.Проекты.Добавить().Проект = Проект;	
		КонецЦикла;
	КонецЕсли;
	Если Структура.Свойство("УровеньПланированияРолей") Тогда
		ЭтотОбъект.УровеньПланированияРолей = Структура.УровеньПланированияРолей;
	КонецЕсли;
	Если Структура.Свойство("Комментарий") Тогда
		ЭтотОбъект.Комментарий = Структура.Комментарий;
	КонецЕсли;
	Если Структура.Свойство("ПоказатьДиаграмму") Тогда
		ЭтотОбъект.ПоказатьДиаграмму = Структура.ПоказатьДиаграмму;
	КонецЕсли;
	Если Структура.Свойство("АктуализироватьПланПоФактическимДанным") Тогда
		ЭтотОбъект.АктуализироватьПланПоФактическимДанным = Структура.АктуализироватьПланПоФактическимДанным;
	КонецЕсли;
	Если Структура.Свойство("ИсключатьЗадачиСПодчиненнымиПроектами") Тогда
		ЭтотОбъект.ИсключатьЗадачиСПодчиненнымиПроектами = Структура.ИсключатьЗадачиСПодчиненнымиПроектами;
	КонецЕсли;
	Если Структура.Свойство("Подразделения") Тогда
		ЭтотОбъект.ПодразделенияОтбор.Очистить();
		Для Каждого Подразделение Из Структура.Подразделения Цикл
			ЭтотОбъект.ПодразделенияОтбор.Добавить().Подразделение = Подразделение;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры	

Функция ПолучитьСрокиПроектаДляЗаполнения(Проект) 
	
	лНачалоПериода = НачалоМесяца(упоПоказателиПроектовСервер.ПолучитьТекДатуДляПоказателейФОТ());
	лСрокиПроекта = упоПроектыИЗадачиСервер.ПолучитьПланируемыеСрокиПроекта(Проект, Неопределено, Ложь);
	лКонецПериода = лСрокиПроекта.ДатаЗавершенияПлан;	
	лКонецПериода = ?(ЗначениеЗаполнено(лКонецПериода), КонецМесяца(лКонецПериода), лКонецПериода);
	
	Возврат Новый Структура("НачалоПериода, КонецПериода", лНачалоПериода, лКонецПериода);
	
КонецФункции 

Функция ПолучитьСрокиПоУмолчанию() 
	
	лНачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	лКонецПериода = КонецМесяца(ДобавитьМесяц(лНачалоПериода, 5));
		
	Возврат Новый Структура("НачалоПериода, КонецПериода", лНачалоПериода, лКонецПериода);
	
КонецФункции 

Функция ПакетДляФормированияДвиженийПредварительныйПоОкончательному()
		
	ТаблицаТрудозатратыОконч = Движения.упоДанныеПлановТрудозатратРолей.Выгрузить(,
		"ПроектнаяЗадача, Подразделение, ЕдиницаНормирования, ИндексСтрокРаспределения, Количество");
	ТаблицаТрудозатратыОконч.Свернуть("ПроектнаяЗадача, Подразделение, ЕдиницаНормирования, ИндексСтрокРаспределения", 
		"Количество");
	
	ТаблицаТрудозатратыПоПериодамОконч = Движения.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Выгрузить(,
		"ПроектнаяЗадача, ПериодРаспределения,ИндексСтрокиРаспределениеПоРолям, Количество");
	ТаблицаТрудозатратыПоПериодамОконч.Свернуть("ПроектнаяЗадача, ПериодРаспределения,ИндексСтрокиРаспределениеПоРолям",
	    "Количество");
	//
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Ссылка);		
	Запрос.УстановитьПараметр("УровеньПланированияПредварительный", Перечисления.упоУровеньПланирования.Предварительный);	
	Запрос.УстановитьПараметр("УровеньПланированияОкончательный", 	Перечисления.упоУровеньПланирования.Окончательный);	
	Запрос.УстановитьПараметр("РезервРПЗ", 							Справочники.упоСобственныеСилыСубподряд.РПО);		
	Запрос.УстановитьПараметр("СпособПривязкиВручную", 				Перечисления.упоСпособПривязкиРаспределения.Вручную);		
	Запрос.УстановитьПараметр("ТаблицаТрудозатратыОконч", 			ТаблицаТрудозатратыОконч);		
	Запрос.УстановитьПараметр("ТаблицаТрудозатратыПоПериодамОконч", ТаблицаТрудозатратыПоПериодамОконч);		
		
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Таблица.Подразделение КАК Подразделение,
	               |	ВЫРАЗИТЬ(Таблица.ЕдиницаНормирования КАК Справочник.упоЕдиницыВремени) КАК ЕдиницаНормирования,
	               |	ВЫРАЗИТЬ(Таблица.ИндексСтрокРаспределения КАК ЧИСЛО) КАК ИндексСтрокРаспределения,
	               |	Таблица.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаТрудозатратыОкончательный
	               |ИЗ
	               |	&ТаблицаТрудозатратыОконч КАК Таблица
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПроектнаяЗадача,
	               |	ИндексСтрокРаспределения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Таблица.ПериодРаспределения КАК ПериодРаспределения,
	               |	ВЫРАЗИТЬ(Таблица.ИндексСтрокиРаспределениеПоРолям КАК ЧИСЛО) КАК ИндексСтрокиРаспределениеПоРолям,
	               |	Таблица.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаТрудозатратыПоПериодамОкончательный
	               |ИЗ
	               |	&ТаблицаТрудозатратыПоПериодамОконч КАК Таблица
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПроектнаяЗадача,
	               |	ИндексСтрокиРаспределениеПоРолям
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПрогнозТрудозатратПоРолямДанные.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
	               |	упоПрогнозТрудозатратПоРолямДанные.Подразделение КАК Подразделение,
	               |	упоПрогнозТрудозатратПоРолямДанные.Подразделение.Родитель КАК ПодразделениеРодитель,
	               |	упоПрогнозТрудозатратПоРолямДанные.ПроектнаяЗадачаЗеркало.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадачаДокумент
	               |ПОМЕСТИТЬ ВТ_ДанныеДокумента
	               |ИЗ
	               |	Документ.упоПрогнозТрудозатратПоРолям.Данные КАК упоПрогнозТрудозатратПоРолямДанные
	               |ГДЕ
	               |	упоПрогнозТрудозатратПоРолямДанные.Ссылка = &Документ
	               |	И упоПрогнозТрудозатратПоРолямДанные.Записывать
	               |;
