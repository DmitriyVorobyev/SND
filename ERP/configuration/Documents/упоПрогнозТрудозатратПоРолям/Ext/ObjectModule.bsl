	               |		ВТ_ПланЭтаповПоПредварительномуУровню.ИндексСтрокРаспределения КАК ИндексСтрокРаспределения
	               |	ИЗ
	               |		ВТ_ПланЭтаповПоПредварительномуУровню КАК ВТ_ПланЭтаповПоПредварительномуУровню
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТаблицаТрудозатратыОкончательный.ПроектнаяЗадача,
	               |		ТаблицаТрудозатратыОкончательный.ИндексСтрокРаспределения
	               |	ИЗ
	               |		ТаблицаТрудозатратыОкончательный КАК ТаблицаТрудозатратыОкончательный) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.ПроектнаяЗадача";	
	
	// Сборка текста запроса для подчиненных этапов.	
	упоПроектыИЗадачиСервер.ВставитьВТекстЗапросаПодчиненныеЗадачи(ТекстЗапроса, "ВТ_ПодчиненныеЗадачи", Истина, 5);
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос;
			
КонецФункции	

Процедура СформироватьДвижения_ТрудозатратыФакт(ТаблицаЗадачФакта)
	
	ТаблицаДвижений = упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру("упоФактТрудозатратПоДням");
	
	СводныйРесурс = Справочники.упоТрудовыеРесурсы.СводныйРесурс;	
	ВидОперацииЯвка = Справочники.упоВидыОпераций.Явка;
	
	Для Каждого СтрокаЗадачи Из ТаблицаЗадачФакта Цикл
		НоваяСтрока = ТаблицаДвижений.Добавить();		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗадачи,, "Роль");		
		НоваяСтрока.Период = Дата;
		НоваяСтрока.УровеньПланирования = Перечисления.упоУровеньПланирования.Предварительный;
		НоваяСтрока.Роль = Неопределено;
		НоваяСтрока.Ресурс = СтрокаЗадачи.Роль;
		ЗаполнитьВидОперацииДвижения(НоваяСтрока, СтрокаЗадачи, ВидОперацииЯвка);
		
		НоваяСтрока = ТаблицаДвижений.Добавить();		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗадачи);		
		НоваяСтрока.Период = Дата;
		НоваяСтрока.УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный;
		НоваяСтрока.Роль = СтрокаЗадачи.Роль;
		НоваяСтрока.Ресурс = СводныйРесурс;
		ЗаполнитьВидОперацииДвижения(НоваяСтрока, СтрокаЗадачи, ВидОперацииЯвка);
		
	КонецЦикла;	
	
	Движения.упоФактТрудозатратПоДням.Загрузить(ТаблицаДвижений);
	
	ТаблицаДвижений.Колонки.Операция.Имя = "ПроектнаяЗадача";		
	ТаблицаДвижений.Колонки.Трудозатраты.Имя = "КоличествоЧасов";		
	упоФункцииОбщегоНазначенияСервер.СвернутьТаблицуДвижений(ТаблицаДвижений, "упоФактТрудозатратСводно",, Ложь);
	
	Движения.упоФактТрудозатратСводно.Загрузить(ТаблицаДвижений);
	
	Если ТаблицаДвижений.Количество() Тогда
		Движения.упоФактТрудозатратПоДням.Записать();
		Движения.упоФактТрудозатратСводно.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьДвижения_ПроцентыГотовности(ДеревоПроцентГотовности, РежимПроведения, Отказ)
	
	Движения.упоСтатусыПроектныхЗадач.Записывать 							= Истина;
	Движения.упоПроцентыГотовностиПроектныхЗадач.Записывать 				= Истина;
	Движения.упоПроцентыГотовностиПроектов.Записывать 						= Истина;
	Движения.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.Записывать 	= Истина;	
	
	НастройкиРасчета = Новый Структура;
	НастройкиРасчета.Вставить("УчитыватьТрудозатратыПриРасчетеГотовности", 
		Константы.упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности.Получить());
	НастройкиРасчета.Вставить("ИспДлитВместоПустТрудЗатДляРасчГотовности", 
		Константы.упоИспДлитВместоПустТрудЗатДляРасчГотовности.Получить());	
		
	МассивСообщений = Новый Массив;
	ШаблонТекстаПЗ = " - %1 %2: %3% (записанный %4%)";
	
	ТаблицаРучнойПроцентГотовности = ЭтотОбъект.Движения.упоПроцентыГотовностиПроектныхЗадач;
	
	Для Каждого СтрокаПроекта Из ДеревоПроцентГотовности.Строки Цикл				
		
		Для Каждого СтрокаПЗ Из СтрокаПроекта.Строки ЦИкл							
			Движение = ТаблицаРучнойПроцентГотовности.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, СтрокаПЗ);
			Движение.Регистратор = Ссылка;
			Движение.Период = Дата;
			
			Если НеУменьшатьЗаписанныйПроцентГотовности
				И СтрокаПЗ.ЭтоПроцентГотовностиИзРегистра Тогда
				
				ТекстСобщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаПЗ,					
					СтрокаПЗ.КодСДР,
					СтрокаПЗ.ПроектнаяЗадачаЗеркало,
					СтрокаПЗ.ПроцентГотовности,
					СтрокаПЗ.ПроцентГотовностиЗаписанный);
				МассивСообщений.Добавить(ТекстСобщения);	
				
				Движение.ПроцентГотовности = СтрокаПЗ.ПроцентГотовностиЗаписанный;
				
			КонецЕсли;

		КонецЦикла;
		
		упоПроведениеДокументовСервер.АвтоматическийРасчетГотовности(ЭтотОбъект, Отказ, РежимПроведения, 
			, СтрокаПроекта.Проект, НастройкиРасчета);
			
		упоЗакрытиеЭтапа.УдалитьИзДвиженийСтатусовИПроцентовЗакрытыеЗадачи(ЭтотОбъект);
		
	КонецЦикла;
	
	Если МассивСообщений.Количество() > 0 Тогда
		ЗаголовокСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'В документе %1 установлена опция ""Не уменьшать записанный процент готовности"". 
				|Для следующих задач проценты готовности не были изменены:'"),
			ЭтотОбъект.Ссылка);
		МассивСообщений.Вставить(0,ЗаголовокСообщения);
			
		ОбщегоНазначения.СообщитьПользователю(СтрСоединить(МассивСообщений, Символы.ПС));
	КонецЕсли;	
		
КонецПроцедуры	

Процедура СформироватьДвижения_ФактическиеДатыНачалаИОкончанияПроектныхЗадач(ФактическиеДатыНачалаИОкончания)
	
	Движения.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.Записывать = Истина;
	Для Каждого СтрокаПЗ Из ФактическиеДатыНачалаИОкончания Цикл
		Движение = Движения.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, СтрокаПЗ);
		Движение.Регистратор = Ссылка;
		Движение.Период = Дата;		
	КонецЦикла;	
		
КонецПроцедуры

Процедура СформироватьДвижения_ПредварительныйПоОкончательному(МассивЗадачАктуализации)
	
	Пакет = ПакетДляФормированияДвиженийПредварительныйПоОкончательному();
	РезультатВыполненияПакета = Пакет.ВыполнитьПакет(); 	
	ИндексПоследнего = РезультатВыполненияПакета.Количество() - 1;
	
	РезультатДанные 				= РезультатВыполненияПакета[ИндексПоследнего - 2];
	РезультатДанныеРаспределения 	= РезультатВыполненияПакета[ИндексПоследнего - 1];
	РезультатИндексыРаспределения 	= РезультатВыполненияПакета[ИндексПоследнего];
	
	Если РезультатДанные.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРегистра = "упоДанныеПлановТрудозатратРолей";
	ТаблицаДвиженийТрудозатратыПредв = 
		упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру(ИмяРегистра,, Истина, Истина);			
		
	ИмяРегистра = "упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам";	
	ТаблицаДвиженийТрудозатратыПоПериодамПредв = 
		упоФункцииОбщегоНазначенияСервер.ШаблонТаблицыЗначенийПоРегистру(ИмяРегистра,, Истина, Истина);
		
	ТаблицаРаспределения = РезультатДанныеРаспределения.Выгрузить();
	ТаблицаРаспределения.Индексы.Добавить("ПроектнаяЗадача, Подразделение");
	
	СоответствиеПоследнихИндексовРаспределения = Новый Соответствие;
	Если Не РезультатИндексыРаспределения.Пустой() Тогда
		Выборка = РезультатИндексыРаспределения.Выбрать();		
		Пока Выборка.Следующий() Цикл
			СоответствиеПоследнихИндексовРаспределения.Вставить(Выборка.ПроектнаяЗадача, Выборка.ИндексСтрокРаспределения);	
		КонецЦикла;
	КонецЕсли;		
	
	Отбор = Новый Структура("ПроектнаяЗадача, Подразделение");
	Выборка = РезультатДанные.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ОбщиеДанныеЗаполнения = Новый Структура("Регистратор, Период, Активность", 
		Ссылка, Дата, Истина);
	
	СпособПривязкиВручную = Перечисления.упоСпособПривязкиРаспределения.Вручную;
	
	Пока Выборка.Следующий() Цикл
		                                                                           
		ВыборкаДетально = Выборка.Выбрать();		 
		Пока ВыборкаДетально.Следующий() Цикл 				
						
			Движение = ТаблицаДвиженийТрудозатратыПредв.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, ОбщиеДанныеЗаполнения);
			ЗаполнитьЗначенияСвойств(Движение, ВыборкаДетально);
					
			Если ВыборкаДетально.СпособПривязки <> СпособПривязкиВручную Тогда					
				Движение.СпособПривязки = СпособПривязкиВручную;
				упоПроектыИЗадачиСервер.УстановитьИндексРаспределенияПоСоответствию(Движение, 
																					СоответствиеПоследнихИндексовРаспределения);
			КонецЕсли;
																				
			ИндексСтрокРаспределения = Движение.ИндексСтрокРаспределения;													
			
			ЗаполнитьЗначенияСвойств(Отбор,ВыборкаДетально); 			
			НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(Отбор);			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 				
				Движение = ТаблицаДвиженийТрудозатратыПоПериодамПредв.Добавить();
				ЗаполнитьЗначенияСвойств(Движение, ОбщиеДанныеЗаполнения);
				ЗаполнитьЗначенияСвойств(Движение, НайденнаяСтрока);
				Движение.ИндексСтрокиРаспределениеПоРолям = ИндексСтрокРаспределения;
			КонецЦикла;
			
		КонецЦикла;
		
		МассивЗадачАктуализации.Добавить(Выборка.ПроектнаяЗадача);
		
	КонецЦикла;			
		
	// Актуализация.
	
	ДанныеАктуализацииРегистра = Новый Структура("Регистратор, Период, МассивЗадач, ИмяРегистра",
		Ссылка, 
		Дата, 
		МассивЗадачАктуализации);
		
	УсловиеОтбора = "УровеньПланирования = ЗНАЧЕНИЕ(Перечисление.упоУровеньПланирования.Предварительный)";
	
	ДанныеАктуализацииРегистра.ИмяРегистра = "упоДанныеПлановТрудозатратРолей";	
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(
															ТаблицаДвиженийТрудозатратыПредв,
															ДанныеАктуализацииРегистра,
															,
															,
															УсловиеОтбора);																
														
	ДанныеАктуализацииРегистра.ИмяРегистра = "упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам";			
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(
															ТаблицаДвиженийТрудозатратыПоПериодамПредв,
															ДанныеАктуализацииРегистра);
															
	Для Каждого СтрокаТаблицы Из ТаблицаДвиженийТрудозатратыПредв Цикл
		ЗаполнитьЗначенияСвойств(Движения.упоДанныеПлановТрудозатратРолей.Добавить(), СтрокаТаблицы);
	КонецЦикла;															
															
	Для Каждого СтрокаТаблицы Из ТаблицаДвиженийТрудозатратыПоПериодамПредв Цикл
		ЗаполнитьЗначенияСвойств(Движения.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Добавить(), СтрокаТаблицы);
	КонецЦикла;																

КонецПроцедуры	

Процедура СформироватьДвижения_ИспользованиеРабочегоВремени(ТаблицаЗадачФакта)
	
	СводныйРесурс = Справочники.упоТрудовыеРесурсы.СводныйРесурс;	
	РазделУчетаПроектнаяЗадача = Перечисления.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача;
	ВидОперацииЯвка = Справочники.упоВидыОпераций.Явка;
	
	ТаблицаДвижений = Движения.упоИспользованиеРабочегоВремени;
	ТаблицаДвижений.Записывать = Истина;
	
	Для Каждого СтрокаЗадачи Из ТаблицаЗадачФакта Цикл
		
		Движение = ТаблицаДвижений.Добавить();				
	    ЗаполнитьЗначенияСвойств(Движение, СтрокаЗадачи);		
		Движение.Регистратор = Ссылка;
		Движение.Период = Дата;
		Движение.ТрудовойРесурс = СводныйРесурс;
		Движение.РазделУчета = РазделУчетаПроектнаяЗадача;		
		Движение.ЗадачаПричина = СтрокаЗадачи.ПроектнаяЗадачаЗеркало;
		Движение.РабочееЗадание = СтрокаЗадачи.Операция;
		Движение.РольРесурса = СтрокаЗадачи.Роль;
		Движение.РасшифровкаТрудозатрат = "БезРасшифровки";
		ЗаполнитьВидОперацииДвижения(Движение, СтрокаЗадачи, ВидОперацииЯвка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВидОперацииДвижения(Движение, СтрокаЗадачи, ВидОперацииЯвка)
	
	Если Не ЗначениеЗаполнено(СтрокаЗадачи.РазделУчетаВидаОперации) 
		Или Не ЗначениеЗаполнено(Движение.ВидОперации) Тогда
		Движение.ВидОперации = ВидОперацииЯвка;
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьЗадачиИзБазыДляОбновленияТрудозатрат(РежимЗаписи)
	
	Если Не Проведен Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	упоДанныеПлановТрудозатратРолей.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей КАК упоДанныеПлановТрудозатратРолей
	               |ГДЕ
	               |	упоДанныеПлановТрудозатратРолей.Регистратор = &Ссылка";
			
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	ДопЗадачиДляАктуализацииТрудозатрат = Новый Массив;
	Пока Выборка.Следующий() Цикл		
		ДопЗадачиДляАктуализацииТрудозатрат.Добавить(Выборка.ПроектнаяЗадача);		
	КонецЦикла;
	
	ДополнительныеСвойства.Вставить("ДопЗадачиДляАктуализацииТрудозатрат", ДопЗадачиДляАктуализацииТрудозатрат);
	
КонецПроцедуры

#Область РаспределениеЗаПериодомДокумента

Функция ТаблицаРаспределениеОстатковПоПериодам()
	
	РаспределениеОстатковПоПериодам = РаспределениеПоПериоду.ВыгрузитьКолонки();
	
	ДатаЗаПериодомДокумента = КонецДня(КонецПериода) + 1;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", ДатаЗаПериодомДокумента);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("УровеньПланирования", УровеньПланированияРолей);
	Запрос.УстановитьПараметр("ПрофильОтклонениеНаСледМесяц",
		Перечисления.упоПрофильПересчетаТрудозатрат.ОтклонениеНаМесяцПослеПериодаДокумента);
	// Проведение в привилегированном режиме.
	Запрос.Текст = "ВЫБРАТЬ
		|    Проекты.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|    упоПрогнозТрудозатратПоРолямДанные.Роль КАК Роль,
		|    упоПрогнозТрудозатратПоРолямДанные.Подразделение КАК Подразделение,
		|    упоПрогнозТрудозатратПоРолямДанные.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    упоПрогнозТрудозатратПоРолямДанные.ОстатокДоЗавершения КАК ОстатокДоЗавершения,
		|    упоПрогнозТрудозатратПоРолямДанные.Распределять КАК Распределять,
		|    упоПрогнозТрудозатратПоРолямДанные.ПрофильПересчетаТрудозатрат КАК ПрофильПересчетаТрудозатрат,
		|    Проекты.упоКорневойПроект КАК Проект,
		|    упоВерсииПроекта.Версия КАК ТекущаяВерсия,
		|    ВЫБОР
		|        КОГДА упоПрогнозТрудозатратПоРолямДанные.ПрофильПересчетаТрудозатрат = &ПрофильОтклонениеНаСледМесяц
		|            ТОГДА упоПрогнозТрудозатратПоРолямДанные.ТекущийПланДоОтчетногоПериода - упоПрогнозТрудозатратПоРолямДанные.ТекущийПланДоОтчетногоПериодаТрансляция + упоПрогнозТрудозатратПоРолямДанные.ТекущийПланОтчетногоПериода - упоПрогнозТрудозатратПоРолямДанные.ТекущийПланОтчетногоПериодаТрансляция - (упоПрогнозТрудозатратПоРолямДанные.ФактДоОтчетногоПериода + упоПрогнозТрудозатратПоРолямДанные.ФактОтчетногоПериода)
		|        ИНАЧЕ 0
		|    КОНЕЦ КАК ОтклонениеНаСледМесяцДоПериода
		|ПОМЕСТИТЬ втДанныеДокумента
		|ИЗ
		|    Документ.упоПрогнозТрудозатратПоРолям.Данные КАК упоПрогнозТрудозатратПоРолямДанные
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|            ПО Проекты.упоКорневойПроект = упоВерсииПроекта.Проект
		|                И (упоВерсииПроекта.Текущая)
		|        ПО упоПрогнозТрудозатратПоРолямДанные.ПроектнаяЗадачаЗеркало = Проекты.Ссылка
		|ГДЕ
		|    упоПрогнозТрудозатратПоРолямДанные.Ссылка = &Ссылка
		|    И упоПрогнозТрудозатратПоРолямДанные.Записывать
		|    И упоПрогнозТрудозатратПоРолямДанные.ОстатокДоЗавершения > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    втДанныеДокумента.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|    втДанныеДокумента.Роль КАК Роль,
		|    втДанныеДокумента.Подразделение КАК Подразделение,
		|    втДанныеДокумента.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    втДанныеДокумента.ОстатокДоЗавершения КАК ОстатокДоЗавершения,
		|    втДанныеДокумента.Распределять КАК Распределять,
		|    втДанныеДокумента.ПрофильПересчетаТрудозатрат КАК ПрофильПересчетаТрудозатрат,
		|    ВЫБОР
		|        КОГДА упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи ЕСТЬ NULL
		|                ИЛИ упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи = ЗНАЧЕНИЕ(Справочник.упоРабочиеКалендари.ПустаяСсылка)
		|            ТОГДА упоКалендариПроектовСрезПоследних.КалендарьПроекта
		|        ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи
		|    КОНЕЦ КАК Календарь,
		|    КОНЕЦПЕРИОДА(ЕСТЬNULL(упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан, &Дата), ДЕНЬ) КАК ДатаЗавершения
		|ПОМЕСТИТЬ втДопДанныеДокумента
		|ИЗ
		|    втДанныеДокумента КАК втДанныеДокумента
		|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоКалендариПроектов.СрезПоследних КАК упоКалендариПроектовСрезПоследних
		|        ПО втДанныеДокумента.Проект = упоКалендариПроектовСрезПоследних.Проект
		|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		|        ПО втДанныеДокумента.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|            И втДанныеДокумента.ТекущаяВерсия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
		|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК упоСрокиПроектныхЗадачСрезПоследних
		|        ПО втДанныеДокумента.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|            И втДанныеДокумента.ТекущаяВерсия = упоСрокиПроектныхЗадачСрезПоследних.Версия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Роль КАК Роль,
		|    упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Подразделение КАК Подразделение,
		|    втДанныеДокумента.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    СУММА(упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.ТрудозатратыТекущийПлан - упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.ТрудозатратыТекущийПланТрансляция - упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Трудозатраты - упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.ТрудозатратыТрансляция) КАК ОтклонениеНаСледующийМесяц,
		|    втДанныеДокумента.ОтклонениеНаСледМесяцДоПериода КАК ОтклонениеНаСледМесяцДоПериода
		|ПОМЕСТИТЬ втОтклонениеНаСледующийМесяц
		|ИЗ
		|    втДанныеДокумента КАК втДанныеДокумента
		|        ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоПрогнозТрудозатратПоРолям.РаспределениеПоПериоду КАК упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду
		|        ПО втДанныеДокумента.Роль = упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Роль
		|            И втДанныеДокумента.Подразделение = упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Подразделение
		|            И втДанныеДокумента.ПроектнаяЗадачаЗеркало = упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.ПроектнаяЗадачаЗеркало
		|ГДЕ
		|    упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Ссылка = &Ссылка
		|    И НЕ втДанныеДокумента.Распределять
		|    И втДанныеДокумента.ПрофильПересчетаТрудозатрат = &ПрофильОтклонениеНаСледМесяц
		|    И упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Дата >= &НачалоПериода
		|    И упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Дата <= &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|    упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Роль,
		|    упоПрогнозТрудозатратПоРолямРаспределениеПоПериоду.Подразделение,
		|    втДанныеДокумента.ПроектнаяЗадачаЗеркало,
		|    втДанныеДокумента.ОтклонениеНаСледМесяцДоПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ВложенныйЗапрос.Подразделение КАК Подразделение,
		|    ВложенныйЗапрос.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    ВложенныйЗапрос.Роль КАК Роль,
		|    ВложенныйЗапрос.Дата КАК Дата,
		|    СУММА(ВложенныйЗапрос.Трудозатраты) КАК Трудозатраты,
		|    МАКСИМУМ(ВложенныйЗапрос.ОстатокДоЗавершения) КАК ОстатокДоЗавершения,
		|    ВложенныйЗапрос.Календарь КАК Календарь,
		|    ВложенныйЗапрос.ДатаЗавершения КАК ДатаЗавершения
		|ПОМЕСТИТЬ втТрудозатратыПоПериодам
		|ИЗ
		|    (ВЫБРАТЬ
		|        втДопДанныеДокумента.Подразделение КАК Подразделение,
		|        втДопДанныеДокумента.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|        втДопДанныеДокумента.Роль КАК Роль,
		|        ЕСТЬNULL(НАЧАЛОПЕРИОДА(упоРабочиеКалендариСрезПоследних.День, МЕСЯЦ), ДАТАВРЕМЯ(1, 1, 1)) КАК Дата,
		|        СУММА(0) КАК Трудозатраты,
		|        втДопДанныеДокумента.ОстатокДоЗавершения КАК ОстатокДоЗавершения,
		|        втДопДанныеДокумента.Календарь КАК Календарь,
		|        втДопДанныеДокумента.ДатаЗавершения КАК ДатаЗавершения
		|    ИЗ
		|        втДопДанныеДокумента КАК втДопДанныеДокумента
		|            ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРабочиеКалендари.СрезПоследних(
		|                    ,
		|                    Календарь В
		|                            (ВЫБРАТЬ
		|                                втДопДанныеДокумента.Календарь КАК Календарь
		|                            ИЗ
		|                                втДопДанныеДокумента КАК втДопДанныеДокумента)
		|                        И День > &КонецПериода) КАК упоРабочиеКалендариСрезПоследних
		|            ПО втДопДанныеДокумента.ДатаЗавершения >= упоРабочиеКалендариСрезПоследних.День
		|                И втДопДанныеДокумента.Календарь = упоРабочиеКалендариСрезПоследних.Календарь
		|    ГДЕ
		|        НЕ втДопДанныеДокумента.Распределять
		|    
		|    СГРУППИРОВАТЬ ПО
		|        втДопДанныеДокумента.ПроектнаяЗадачаЗеркало,
		|        втДопДанныеДокумента.Роль,
		|        втДопДанныеДокумента.Подразделение,
		|        втДопДанныеДокумента.ОстатокДоЗавершения,
		|        ЕСТЬNULL(НАЧАЛОПЕРИОДА(упоРабочиеКалендариСрезПоследних.День, МЕСЯЦ), ДАТАВРЕМЯ(1, 1, 1)),
		|        втДопДанныеДокумента.Календарь,
		|        втДопДанныеДокумента.ДатаЗавершения
		|    
		|    ОБЪЕДИНИТЬ ВСЕ
		|    
		|    ВЫБРАТЬ
		|        втДопДанныеДокумента.Подразделение,
		|        втДопДанныеДокумента.ПроектнаяЗадачаЗеркало,
		|        втДопДанныеДокумента.Роль,
		|        ЕСТЬNULL(НАЧАЛОПЕРИОДА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День, МЕСЯЦ), ДАТАВРЕМЯ(1, 1, 1)),
		|        СУММА(ЕСТЬNULL(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Трудозатраты, 0)),
		|        0,
		|        втДопДанныеДокумента.Календарь,
		|        втДопДанныеДокумента.ДатаЗавершения
		|    ИЗ
		|        втДопДанныеДокумента КАК втДопДанныеДокумента
		|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия
		|            ПО втДопДанныеДокумента.ПроектнаяЗадача = упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция
		|                И втДопДанныеДокумента.Роль = упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс
		|                И втДопДанныеДокумента.Подразделение = упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение
		|    ГДЕ
		|        НЕ втДопДанныеДокумента.Распределять
		|        И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.УровеньПланирования = &УровеньПланирования
		|        И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День > &КонецПериода
		|        И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.ИсточникПлана <> ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаТрудозатратРолей.Объемы)
		|    
		|    СГРУППИРОВАТЬ ПО
		|        втДопДанныеДокумента.ПроектнаяЗадачаЗеркало,
		|        втДопДанныеДокумента.Роль,
		|        втДопДанныеДокумента.Подразделение,
		|        ЕСТЬNULL(НАЧАЛОПЕРИОДА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День, МЕСЯЦ), ДАТАВРЕМЯ(1, 1, 1)),
		|        втДопДанныеДокумента.Календарь,
		|        втДопДанныеДокумента.ДатаЗавершения) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|    ВложенныйЗапрос.Подразделение,
		|    ВложенныйЗапрос.ПроектнаяЗадачаЗеркало,
		|    ВложенныйЗапрос.Роль,
		|    ВложенныйЗапрос.Дата,
		|    ВложенныйЗапрос.Календарь,
		|    ВложенныйЗапрос.ДатаЗавершения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    втТрудозатратыПоПериодам.Подразделение КАК Подразделение,
		|    втТрудозатратыПоПериодам.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    втТрудозатратыПоПериодам.Роль КАК Роль,
		|    втТрудозатратыПоПериодам.Дата КАК Дата,
		|    втТрудозатратыПоПериодам.Трудозатраты КАК Трудозатраты,
		|    втТрудозатратыПоПериодам.ОстатокДоЗавершения КАК ОстатокДоЗавершения,
		|    ЕСТЬNULL(втОтклонениеНаСледующийМесяц.ОтклонениеНаСледМесяцДоПериода, 0) + ЕСТЬNULL(втОтклонениеНаСледующийМесяц.ОтклонениеНаСледующийМесяц, 0) КАК ОтклонениеНаСледующийМесяц,
		|    втТрудозатратыПоПериодам.Календарь КАК Календарь,
		|    втТрудозатратыПоПериодам.ДатаЗавершения КАК ДатаЗавершения
		|ИЗ
		|    втТрудозатратыПоПериодам КАК втТрудозатратыПоПериодам
		|        ЛЕВОЕ СОЕДИНЕНИЕ втОтклонениеНаСледующийМесяц КАК втОтклонениеНаСледующийМесяц
		|        ПО втТрудозатратыПоПериодам.Роль = втОтклонениеНаСледующийМесяц.Роль
		|            И втТрудозатратыПоПериодам.Подразделение = втОтклонениеНаСледующийМесяц.Подразделение
		|            И втТрудозатратыПоПериодам.ПроектнаяЗадачаЗеркало = втОтклонениеНаСледующийМесяц.ПроектнаяЗадачаЗеркало
		|
		|УПОРЯДОЧИТЬ ПО
		|    Дата
		|ИТОГИ
		|    СУММА(Трудозатраты),
		|    МАКСИМУМ(ОстатокДоЗавершения),
		|    МАКСИМУМ(ОтклонениеНаСледующийМесяц),
		|    МАКСИМУМ(Календарь),
		|    МАКСИМУМ(ДатаЗавершения)
		|ПО
		|    ПроектнаяЗадачаЗеркало,
		|    Подразделение,
		|    Роль
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    втДопДанныеДокумента.Подразделение КАК Подразделение,
		|    втДопДанныеДокумента.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    втДопДанныеДокумента.Роль КАК Роль,
		|    втДопДанныеДокумента.Календарь КАК Календарь,
		|    &Дата КАК ДатаНачала,
		|    втДопДанныеДокумента.ДатаЗавершения КАК ДатаЗавершения,
		|    СУММА(втДопДанныеДокумента.ОстатокДоЗавершения) КАК Трудозатраты
		|ИЗ
		|    втДопДанныеДокумента КАК втДопДанныеДокумента
		|ГДЕ
		|    втДопДанныеДокумента.Распределять
		|
		|СГРУППИРОВАТЬ ПО
		|    втДопДанныеДокумента.Подразделение,
		|    втДопДанныеДокумента.ПроектнаяЗадачаЗеркало,
		|    втДопДанныеДокумента.Роль,
		|    втДопДанныеДокумента.Календарь,
		|    втДопДанныеДокумента.ДатаЗавершения";;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ИндексПоследнего = РезультатЗапроса.Количество() - 1;
	
	// 1. Распределение остатка без флага Распределять (с версии 4.2.14 флаг не используется).
	
	ВыборкаПодразделения = РезультатЗапроса[ИндексПоследнего - 1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПодразделения.Следующий() Цикл
		
		ВыборкаПЗ = ВыборкаПодразделения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПЗ.Следующий() Цикл
			
			ВыборкаРоль = ВыборкаПЗ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаРоль.Следующий() Цикл
				
				мТрудозатратыТекущийПлан = Новый Массив;
				мДаты = Новый Массив;
				
				ВыборкаДетально = ВыборкаРоль.Выбрать();
				Пока ВыборкаДетально.Следующий() Цикл
					мТрудозатратыТекущийПлан.Добавить(ВыборкаДетально.Трудозатраты);
					мДаты.Добавить(ВыборкаДетально.Дата);
				КонецЦикла;
				
				мТрудозатраты = МассивТрудозатратПоБазеПлановыхТрудозатрат(мТрудозатратыТекущийПлан,
						ВыборкаРоль.ОстатокДоЗавершения,
						ВыборкаРоль.ОтклонениеНаСледующийМесяц);
				
				// Если нет базы по трудозатратам, тогда распределяем по базе рабочих часов.
				Если мТрудозатраты = Неопределено Тогда
					// 4.2.15: включить расчет базы в запрос.
					Результат = упоПланированиеТрудозатратВызовСервера.МассивТрудозатратРавномерноПоМесяцамВПериоде(
							ДатаЗаПериодомДокумента,
							ВыборкаПЗ.ДатаЗавершения,
							ВыборкаПЗ.Календарь,
							ВыборкаРоль.ОстатокДоЗавершения,
							Истина);
					мДаты = Результат.Периоды;
					мТрудозатраты = Результат.Трудозатраты;
					
				КонецЕсли;
				
				ЗаполнитьРаспределениеОстатковПоПериодамПоБазеРаспределения(РаспределениеОстатковПоПериодам,
					ВыборкаРоль,
					мТрудозатраты,
					мДаты);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// 2. Распределение остатка по флагу Распределять (до версии 4.2.14).
	
	Если Не РезультатЗапроса[ИндексПоследнего].Пустой() Тогда
		
		Выборка = РезультатЗапроса[ИндексПоследнего].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Результат = упоПланированиеТрудозатратВызовСервера.МассивТрудозатратРавномерноПоМесяцамВПериоде(
					Выборка.ДатаНачала,
					Выборка.ДатаЗавершения,
					Выборка.Календарь,
					Выборка.Трудозатраты,
					Истина);
			
			ЗаполнитьРаспределениеОстатковПоПериодамПоБазеРаспределения(РаспределениеОстатковПоПериодам,
				Выборка,
				Результат.Трудозатраты,
				Результат.Периоды);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РаспределениеОстатковПоПериодам;
	
КонецФункции

Процедура ЗаполнитьРаспределениеОстатковПоПериодамПоБазеРаспределения(РаспределениеОстатковПоПериодам, 
																	СтрокаЗаполнения, 
																	МассивТрудозатрат, 
																	МассивДат)
	
	КоличествоДат = МассивДат.Количество()-1;
	Для ИндексЭлемента = 0 По КоличествоДат Цикл
		НоваяСтрока = РаспределениеОстатковПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаполнения);
		НоваяСтрока.Дата = МассивДат[ИндексЭлемента];
		НоваяСтрока.Трудозатраты = МассивТрудозатрат[ИндексЭлемента];
	КонецЦикла;
	
КонецПроцедуры

Функция МассивТрудозатратПоБазеПлановыхТрудозатрат(мТрудозатратыТекущийПлан, 
													Знач ОстатокДоЗавершения, 
													Знач ОтклонениеНаСледующийМесяц)
			
	Если мТрудозатратыТекущийПлан.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	// Если по роли отработал профиль ОтклонениеНаМесяцПослеПериодаДокумента, то сумма отклонения 
	// переходит на следующий месяц после периода документа, а остаток до завершения за вычетом суммы отклонения 
	// распределяется после периода документа.										
	
	ЕстьОтклонениеНаСледМесяц = ОтклонениеНаСледующийМесяц > 0;					
	
	Если ЕстьОтклонениеНаСледМесяц Тогда
		
		СуммаПеренесенныхТрудозатрат = 0;
		мПеренесенныеТрудозатраты = ПеренестиОтклонениеТрудозатратНаСледующийМесяц(мТрудозатратыТекущийПлан, 
																				ОтклонениеНаСледующийМесяц,
																				СуммаПеренесенныхТрудозатрат);
				
		ОстатокДоЗавершения = ОстатокДоЗавершения - СуммаПеренесенныхТрудозатрат;
		Если ОстатокДоЗавершения < 0 Тогда 
			ОстатокДоЗавершения = 0;
		КонецЕсли;															
		
	КонецЕсли;	
	
	мТрудозатраты = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
																			ОстатокДоЗавершения, 
																			мТрудозатратыТекущийПлан, 
																			2);		
	
	Если ЕстьОтклонениеНаСледМесяц 
 		И мТрудозатраты <> Неопределено Тогда		
		
		Сч = мПеренесенныеТрудозатраты.Количество() - 1;
		Пока Сч >=0 Цикл
			мТрудозатраты.Вставить(0, мПеренесенныеТрудозатраты[Сч]);
			Сч = Сч - 1;
		КонецЦикла;															
		
	КонецЕсли;	
	
	Возврат мТрудозатраты; 
	
КонецФункции
 
Функция ПеренестиОтклонениеТрудозатратНаСледующийМесяц(МассивТрудозатрат, 
														ОтклонениеКРаспределению, 
														СуммаПеренесенныхТрудозатрат)
	
	МассивПеренесенныеОтклонения = Новый Массив;	
	
	КоличествоЭлементов = МассивТрудозатрат.Количество();
	Сч = -1;	
	Пока Сч < КоличествоЭлементов Цикл
		
		Если ОтклонениеКРаспределению = 0 Тогда
			Прервать;
		КонецЕсли;	
		
		Сч = Сч + 1;				
		
		Отклонение = МассивТрудозатрат[Сч] + ОтклонениеКРаспределению;	
		СуммаПеренесенныхТрудозатрат = СуммаПеренесенныхТрудозатрат + Отклонение;
		
		Если МассивТрудозатрат[Сч] < 0 Тогда
			ОтклонениеКРаспределению = ОтклонениеКРаспределению - МассивТрудозатрат[Сч];
			Отклонение = 0;
		Иначе 
			ОтклонениеКРаспределению = 0;	
		КонецЕсли;
		
		МассивПеренесенныеОтклонения.Добавить(Отклонение);		
					
	КонецЦикла;
	
	// Убираем перенесенный элемент из массива коэффициентов распределения.
	Пока Сч >=0 Цикл 
		МассивТрудозатрат.Удалить(Сч);
		Сч = Сч - 1;
	КонецЦикла;		
			
	Возврат МассивПеренесенныеОтклонения;
	
КонецФункции

