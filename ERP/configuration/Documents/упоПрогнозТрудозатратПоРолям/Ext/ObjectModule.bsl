
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если НЕ	(ДополнительныеСвойства.Свойство("НеПроверятьРазграничениеДоступа")
		И ДополнительныеСвойства.НеПроверятьРазграничениеДоступа) Тогда 
		Заголовок = обСформироватьЗаголовокОшибкиПриПроведении(ЭтотОбъект);	
		упоРазграничениеДоступаВызовСервера.обПроверитьПравилаРазграничения(ЭтотОбъект, РежимЗаписиДокумента.Проведение, Отказ, Заголовок, Истина);
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.ПроверитьДокументНаОтмененныеПЗ(ЭтотОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьВозможностьСписанияФактическихЗатрат(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	упоПроведениеДокументовВызовСервера.обУдалитьДвиженияДокумента(Отказ, ЭтотОбъект);
		
	Пакет = ПолучитьПакетДляФормированияДвижений();
	РезультатПакета = Пакет.ВыполнитьПакет();
	ИндексПоследнего = РезультатПакета.Количество() - 1;
	
	ДеревоТрудозатрат 					= РезультатПакета[ИндексПоследнего - 7].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТекущийПланТРПоЗадачам 				= РезультатПакета[ИндексПоследнего - 6].Выгрузить();
	ТекущийПланРаспределенияТРПоЗадачам = РезультатПакета[ИндексПоследнего - 5].Выгрузить();
	МассивЗадач 						= РезультатПакета[ИндексПоследнего - 4].Выгрузить().ВыгрузитьКолонку("ПроектнаяЗадача");
	ТаблицаИндексовСтрокРаспределения 	= РезультатПакета[ИндексПоследнего - 3].Выгрузить();
	ТаблицаЗадачФакта 					= РезультатПакета[ИндексПоследнего - 2].Выгрузить();
	ДеревоПроцентГотовности 			= РезультатПакета[ИндексПоследнего - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ФактическиеДатыНачалаИОкончания		= РезультатПакета[ИндексПоследнего].Выгрузить();
	
	// РС упоДанныеПлановТрудозатратРолей И упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.
			
	СформироватьДвижения_ПланаТрудовыхРесурсов(ДеревоТрудозатрат, ТекущийПланТРПоЗадачам, 
		ТекущийПланРаспределенияТРПоЗадачам, ТаблицаИндексовСтрокРаспределения);	
								 				
	Если АктуализироватьПланПредварительногоУровняПоОкончательному Тогда	
		
		МассивЗадачАктуализации = Новый Массив;
		СформироватьДвижения_ПредварительныйПоОкончательному(МассивЗадачАктуализации);	
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗадач, МассивЗадачАктуализации, Истина);
		
	КонецЕсли;	
	
	// Проверка отложенных трудозатрат.
	
	// Если очередь создана текущим проведенным документом, то ее не проверяем,
	// а если распроведенным, то очередь необходимо отразить.
	ДокументОтбора = Неопределено;
	Если ДополнительныеСвойства.Свойство("ДокументПроведенПередЗаписью") 
		И ДополнительныеСвойства.ДокументПроведенПередЗаписью Тогда
		ДокументОтбора = ЭтотОбъект.Ссылка;
	КонецЕсли;
	
	ЕстьОтложенныеТрудозатраты = 
		упоРаботаСОчередямиВызовСервера.ЕстьОтложенныеТрудозатраты(МассивЗадач, ДокументОтбора, Истина);
	
	Если ЕстьОтложенныеТрудозатраты Тогда
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;			
	
	//
	
	Если Движения.упоДанныеПлановТрудозатратРолей.Количество() Тогда
		Движения.упоДанныеПлановТрудозатратРолей.Записать();
	КонецЕсли;
	Если Движения.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Количество() Тогда
		Движения.упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам.Записать();
	КонецЕсли;	
	
	ДопЗадачиДляАктуализацииТрудозатрат = Неопределено;
	Если ДополнительныеСвойства.Свойство("ДопЗадачиДляАктуализацииТрудозатрат", ДопЗадачиДляАктуализацииТрудозатрат) 
		И ДопЗадачиДляАктуализацииТрудозатрат <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивЗадач, ДопЗадачиДляАктуализацииТрудозатрат, Истина);	
	КонецЕсли;
	
	// РС упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия И упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.		
	СформироватьДвижения_ТрудозатратыРесурсовПоДням(МассивЗадач);
	
	// Факт трудозатрат.
	Если ЗаписыватьФактОтчетногоПериода Тогда	 	
		СформироватьДвижения_ТрудозатратыФакт(ТаблицаЗадачФакта);
		СформироватьДвижения_ИспользованиеРабочегоВремени(ТаблицаЗадачФакта);
	КонецЕсли;	
	
	// Проценты готовности и фактические сроки.
	Если ЗаписыватьПроцентГотовности Тогда		
		СформироватьДвижения_ПроцентыГотовности(ДеревоПроцентГотовности, РежимПроведения, Отказ);
		СформироватьДвижения_ФактическиеДатыНачалаИОкончанияПроектныхЗадач(ФактическиеДатыНачалаИОкончания);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НЕ Отказ Тогда		
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			Если ДополнительныеСвойства.Свойство("НеОбновлятьДатуДокумента") Тогда
				НеОбновлятьДатуДокумента = ДополнительныеСвойства.НеОбновлятьДатуДокумента;
			Иначе
				НеОбновлятьДатуДокумента = Ложь;
			КонецЕсли;
			Если НЕ НеОбновлятьДатуДокумента Тогда
				Дата = ТекущаяДатаСеанса();
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьЗадачиИзБазыДляОбновленияТрудозатрат(РежимЗаписи);
		
		ДополнительныеСвойства.Вставить("ДокументПроведенПередЗаписью", ЭтотОбъект.Проведен);
		
	КонецЕсли;
				
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ДанныеЗаполнения = Неопределено Тогда
		
		СрокиПоУмолчанию = ПолучитьСрокиПоУмолчанию();
		ЭтотОбъект.НачалоПериода = СрокиПоУмолчанию.НачалоПериода;	
		ЭтотОбъект.КонецПериода = СрокиПоУмолчанию.КонецПериода;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Проекты") Тогда
		
		НачальноеЗаполнениеТекДокументаПоПроекту(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		НачальноеЗаполнениеТекДокументаПоСтруктуре(ДанныеЗаполнения);	
				
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры 
 
Процедура ПриКопировании(ОбъектКопирования)
	
	УровеньГруппировок = 3;
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередУдалением(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
			
	МассивЗадач = Неопределено;
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ДопЗадачиДляАктуализацииТрудозатрат", МассивЗадач) Тогда	
		упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(МассивЗадач, ЭтотОбъект.Ссылка);	
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВозможностьСписанияФактическихЗатрат(Отказ)

	Если Не ЗаписыватьФактОтчетногоПериода Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляПроверки = Данные.Выгрузить(Новый Структура("ФактДругихДокументов, Записывать", Ложь, Истина), "ПроектнаяЗадачаЗеркало");
	Если Не ЗначениеЗаполнено(ДанныеДляПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	// Проведение в привилегированном режиме.
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПЗ.ПроектнаяЗадачаЗеркало КАК Задача
	               |ПОМЕСТИТЬ ПЗ
	               |ИЗ
	               |	&ПЗ КАК ПЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПЗ.Задача.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
				   |	ПЗ.Задача.упоКорневойПроект КАК Проект,
				   |	&ДатаПроверкиСтатуса КАК ДатаСтатуса
				   |ИЗ
	               |	ПЗ КАК ПЗ";
				   
	ДатаПроверкиСтатуса = ДобавитьМесяц(НачалоПериода, - 1);
	Запрос.УстановитьПараметр("ДатаПроверкиСтатуса", ДатаПроверкиСтатуса);
	Запрос.УстановитьПараметр("ПЗ", ДанныеДляПроверки);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	КонецПериодаПроверкиСтатуса = КонецМесяца(ДатаПроверкиСтатуса);
	
	упоРаспределениеТрудозатратВызовСервера.ПроверитьВозможностьСписанияФактическихЗатратПоОстановленнымПроектамЗаПериод(
		ТЗ, ДатаПроверкиСтатуса, КонецПериодаПроверкиСтатуса, Отказ);
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	упоРаспределениеТрудозатратВызовСервера.ПроверитьВозможностьСписанияФактическихЗатратПоПроектамСУчетомСтатуса(
			ТЗ, ПараметрыСеанса.упоТекущийСотрудник, "ЗапланированУтвержден", Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Константы.упоРазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПЗ = ТЗ.ВыгрузитьКолонку("ПроектнаяЗадача");  
	МассивЗаданий = Новый Массив;
	упоРаспределениеТрудозатратВызовСервера.ПроверитьВозможностьСписанияФактическихЗатратПоЗакрытымЗадачам(
		МассивПЗ, 
		МассивЗаданий,
		Отказ);
		
КонецПроцедуры

Функция ПолучитьПакетДляФормированияДвижений()
	
	РаспределениеОстатковПоПериодам = ТаблицаРаспределениеОстатковПоПериодам();
	
	Если ЗаписыватьФактОтчетногоПериода Тогда
		НачалоОтчетногоПериода = ДобавитьМесяц(ЭтотОбъект.НачалоПериода, -1);
	Иначе
		НачалоОтчетногоПериода = ЭтотОбъект.НачалоПериода;
	КонецЕсли;
	КонецОтчетногоПериода = КонецМесяца(НачалоОтчетногоПериода);
	
	ПоследнийРабочийДеньПериодаДокумента =
		ПоследнийРабочийДеньПериодаДокумента(НачалоОтчетногоПериода, КонецОтчетногоПериода);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("УровеньПланирования", УровеньПланированияРолей);
	Запрос.УстановитьПараметр("УровеньПланированияПредварительный", Перечисления.упоУровеньПланирования.Предварительный);
	Запрос.УстановитьПараметр("АктуализироватьПланПоФактическимДанным", АктуализироватьПланПоФактическимДанным);
	Запрос.УстановитьПараметр("РаспределениеОстатковПоПериодам", РаспределениеОстатковПоПериодам);
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Запрос.УстановитьПараметр("ЗаписыватьФактОтчетногоПериода", ЗаписыватьФактОтчетногоПериода);
	Запрос.УстановитьПараметр("КонецОтчетногоПериода", КонецОтчетногоПериода);
	Запрос.УстановитьПараметр("НачалоОтчетногоПериода", НачалоОтчетногоПериода);
	Запрос.УстановитьПараметр("ЗаписыватьПроцентГотовности", ЗаписыватьПроцентГотовности);
	Запрос.УстановитьПараметр("НеУменьшатьЗаписанныйПроцентГотовности", НеУменьшатьЗаписанныйПроцентГотовности);
	Запрос.УстановитьПараметр("ПоследнийРабочийДеньПериодаДокумента", ПоследнийРабочийДеньПериодаДокумента);
	// Проведение в привилегированном режиме.
	Запрос.Текст = "ВЫБРАТЬ
		|    РаспределениеОстатковПоПериодам.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    РаспределениеОстатковПоПериодам.Подразделение КАК Подразделение,
		|    РаспределениеОстатковПоПериодам.Роль КАК Роль,
		|    РаспределениеОстатковПоПериодам.Дата КАК Дата,
		|    РаспределениеОстатковПоПериодам.Трудозатраты КАК Трудозатраты
		|ПОМЕСТИТЬ РаспределениеОстатковПоПериодам
		|ИЗ
		|    &РаспределениеОстатковПоПериодам КАК РаспределениеОстатковПоПериодам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    ЗадачиДокумента.Подразделение КАК Подразделение,
		|    ЗадачиДокумента.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало,
		|    ЗадачиДокумента.ПроектнаяЗадачаЗеркало.СсылкаНаПроектнуюЗадачу КАК ПроектнаяЗадача,
		|    ЗадачиДокумента.Роль КАК Роль,
		|    ЗадачиДокумента.ДатаЗавершенияТП КАК ДатаЗавершенияТП,
		|    упоСвойстваПроектныхЗадачСрезПоследних.НормаСтоимостиТрудовыхРесурсов КАК НормаСтоимостиТрудовыхРесурсов,
		|    упоСвойстваПроектныхЗадачСрезПоследних.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов,
		|    упоВерсииПроекта.Версия КАК Версия,
		|    ЗадачиДокумента.ФактОтчетногоПериода КАК ФактОтчетногоПериода,
		|    упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации КАК ВидОперации,
		|    ЗадачиДокумента.ПроцентГотовностиЗадачи КАК ПроцентГотовности,
		|    ЗадачиДокумента.ФактДругихДокументов КАК ФактДругихДокументов,
		|    упоВерсииПроекта.Проект КАК Проект,
		|    ЗадачиДокумента.ДатаНачалаФакт КАК ДатаНачалаФакт,
		|    ЗадачиДокумента.ДатаЗавершенияФакт КАК ДатаЗавершенияФакт
		|ПОМЕСТИТЬ ЗадачиДокумента
		|ИЗ
		|    Документ.упоПрогнозТрудозатратПоРолям.Данные КАК ЗадачиДокумента
		|        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|            ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		|                И (упоВерсииПроекта.Текущая)
		|        ПО ЗадачиДокумента.ПроектнаяЗадачаЗеркало.СсылкаНаПроектнуюЗадачу = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
