	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, Реквизиты);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьНадписьСводки(ЭтаФорма)
		
	ЧастиСводки = Новый Массив;	

	СписокКоличество = ЭтаФорма.СписокПроектов.Количество();
	Если СписокКоличество Тогда
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Проекты(%1): %2'"),
			СписокКоличество,
			СтрСоединить(ЭтаФорма.СписокПроектов.ВыгрузитьЗначения(), ", "));					
		ЧастиСводки.Добавить(Лев(Текст, 100));
	КонецЕсли;
	СписокКоличество = ЭтаФорма.СписокПодразделений.Количество();
	Если СписокКоличество Тогда		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Подразделения(%1): %2'"),
			СписокКоличество,
			СтрСоединить(ЭтаФорма.СписокПодразделений.ВыгрузитьЗначения(), ", "));				
		ЧастиСводки.Добавить(Лев(Текст, 100));
	КонецЕсли;
	СписокКоличество = ЭтаФорма.СписокРолей.Количество();
	Если СписокКоличество Тогда				
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Роли(%1): %2'"),
			СписокКоличество,
			СтрСоединить(ЭтаФорма.СписокРолей.ВыгрузитьЗначения(), ", "));		
		ЧастиСводки.Добавить(Лев(Текст, 100));
	КонецЕсли;

	ЭтаФорма.Сводка = СтрСоединить(ЧастиСводки, "; ");

КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНастройкиОбъектаПоПрофилю(ЭтаФорма, НачальноеЗаполнение = Ложь)

	ПрофильНастроек = ЭтаФорма.Объект.ПрофильНастроек;

	Если ЗначениеЗаполнено(ПрофильНастроек) Тогда

		Реквизиты = ЗначенияРеквизитовОбъекта(ПрофильНастроек, 
			"АвтоматическийРасчетПроцентаГотовности, АктуализироватьПланПредварительногоУровняПоОкончательному,
			|АктуализироватьПланПоФактическимДанным, АктуализироватьТекущиеСрокиПоСрокамПоЗагрузке, 
			|ЗаписыватьПроцентГотовности, ЗаписыватьФактОтчетногоПериода,  
			|НеУменьшатьЗаписанныйПроцентГотовности, УровеньПланированияРолей");
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма.Объект, Реквизиты);
		
		Если НачальноеЗаполнение Тогда
			ЭтаФорма.УровеньПланированияНаФорме = ЭтаФорма.Объект.УровеньПланированияРолей;
		КонецЕсли;	
		
	КонецЕсли;	

	УстановитьДоступностьВидимостьЭлементовФормыПоНастройкам(ЭтаФорма);

КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьВидимостьЭлементовФормыПоНастройкам(ЭтаФорма)

	Элементы 	= ЭтаФорма.Элементы;
	Объект 		= ЭтаФорма.Объект;

	Элементы.ДеревоФормыФактОтчетногоПериода.ТолькоПросмотр = Не Объект.ЗаписыватьФактОтчетногоПериода;		

	ПрофильЗаполнен = ЗначениеЗаполнено(Объект.ПрофильНастроек);	
	Элементы.АктуализироватьПланПоФактическимДанным.Доступность 		= Не ПрофильЗаполнен;
	Элементы.АктуализироватьТекущиеСрокиПоСрокамПоЗагрузке.Доступность 	= Не ПрофильЗаполнен;
	Элементы.ЗаписыватьФактОтчетногоПериода.Доступность 				= Не ПрофильЗаполнен;
	Элементы.ЗаписыватьПроцентГотовности.Доступность 					= Не ПрофильЗаполнен;
	Элементы.АвтоматическийРасчетПроцентаГотовности.Доступность 		= Не ПрофильЗаполнен;
	Элементы.НеУменьшатьЗаписанныйПроцентГотовности.Доступность 		= Не ПрофильЗаполнен;

	упоРаботаСФормамиКлиентСервер.НастройкаПрогнозаПоУровнюПланирования(ЭтаФорма, ЭтаФорма.УровеньПланированияНаФорме);		
	упоРаботаСФормамиКлиентСервер.НастройкаПрогнозаПоПроцентуГотовности(ЭтаФорма);

КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСписокВыбораУровнейГруппировок(ЭтаФорма, ЗаполнитьУровень = Ложь)

	СписокВыбора = ЭтаФорма.Элементы.УровеньГруппировок.СписокВыбора;
	СписокВыбора.Очистить();

	Если ЭтаФорма.Объект.ПорядокГруппировок = 
		ПредопределенноеЗначение("Перечисление.упоПорядокГруппировокПрогнозированиеТрудозатрат.ПроектЗадачаРольПодразделение") Тогда
		СписокВыбора.Добавить(0, НСтр("ru = 'Проекты'"));
		СписокВыбора.Добавить(1, НСтр("ru = 'Задачи'"));
		СписокВыбора.Добавить(2, НСтр("ru = 'Роли'"));
		СписокВыбора.Добавить(3, НСтр("ru = 'Подразделения'"));
	ИначеЕсли ЭтаФорма.Объект.ПорядокГруппировок = 
		ПредопределенноеЗначение("Перечисление.упоПорядокГруппировокПрогнозированиеТрудозатрат.РольПодразделениеПроектЗадача") Тогда
		СписокВыбора.Добавить(0, НСтр("ru = 'Роли'"));
		СписокВыбора.Добавить(1, НСтр("ru = 'Подразделения'"));
		СписокВыбора.Добавить(2, НСтр("ru = 'Проекты'"));
		СписокВыбора.Добавить(3, НСтр("ru = 'Задачи'"));
	КонецЕсли;

	Если ЗаполнитьУровень Тогда
		ЭтаФорма.Объект.УровеньГруппировок = 3;
	КонецЕсли;

КонецПроцедуры	

