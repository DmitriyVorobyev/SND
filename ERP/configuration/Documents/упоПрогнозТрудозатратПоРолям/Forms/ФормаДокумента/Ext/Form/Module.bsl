		|    ТаблицаДанныеСДопДанными.ФактОтчетногоПериода КАК ФактОтчетногоПериодаДоп,
		|    ТаблицаДанныеСДопДанными.ФактДоОтчетногоПериода КАК ФактДоОтчетногоПериода,
		|    ТаблицаДанныеСДопДанными.ФактДругихДокументов КАК ФактДругихДокументов,
		|    ТаблицаДанныеСДопДанными.ТипЗадачи КАК ТипЗадачи,
		|    ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ЗадачаЗавершена, ЛОЖЬ) КАК ЗадачаЗавершена,
		|    ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ЗадачаЗакрыта, ЛОЖЬ) КАК ЗадачаЗакрыта,
		|    ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.Статус, НЕОПРЕДЕЛЕНО) КАК Статус,
		|    ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ТекПользовательЯвляетсяРПЗИлиРП, ЛОЖЬ) КАК ТекПользовательЯвляетсяРПЗИлиРП,
		|    ТаблицаДанныеСДопДанными.ПроцентГотовности КАК ПроцентГотовности,
		|    ТаблицаДанныеСДопДанными.ПроцентГотовностиРучноеРедактирование КАК ПроцентГотовностиРучноеРедактирование,
		|    ДанныеНаРедактированиеПроектныхЗадач.ПроектВыполняется КАК ПроектВыполняется,
		|    ТаблицаДанныеСДопДанными.ДатаНачалаФакт КАК ДатаНачалаФакт,
		|    ТаблицаДанныеСДопДанными.ДатаЗавершенияФакт КАК ДатаЗавершенияФакт,
		|    ТаблицаДанныеСДопДанными.ПрофильПересчетаТрудозатрат КАК ПрофильПересчетаТрудозатрат,
		|    ПроектныеЗадачиСоСвойствами.Календарь КАК Календарь,
		|    ТаблицаДанныеСДопДанными.ПроцентГотовностиЗадачи КАК ПроцентГотовностиЗадачи,
		|    ПроцентыГотовности.ПроцентГотовности КАК ПроцентГотовностиЗадачиТекущийПлан,
		|    ЕСТЬNULL(ПланТрудозатрат.ПланПоЗадаче, 0) КАК ПланДоПолногоПоЗадаче,
		|    ЕСТЬNULL(ПланТрудозатрат.ПланПоЗадачеТрансляция, 0) КАК ПланДоПолногоПоЗадачеТрансляция,
		|    ЕСТЬNULL(ФактТрудозатрат.ФактПоЗадаче, 0) КАК ФактДоПолногоПоЗадаче
		|ИЗ
		|    ТаблицаДанныеСДопДанными КАК ТаблицаДанныеСДопДанными
		|        ЛЕВОЕ СОЕДИНЕНИЕ ДанныеНаРедактированиеПроектныхЗадач КАК ДанныеНаРедактированиеПроектныхЗадач
		|        ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ДанныеНаРедактированиеПроектныхЗадач.ПроектнаяЗадача
		|        ЛЕВОЕ СОЕДИНЕНИЕ ПроектныеЗадачиСоСвойствами КАК ПроектныеЗадачиСоСвойствами
		|        ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ПроектныеЗадачиСоСвойствами.ПроектнаяЗадача
		|        ЛЕВОЕ СОЕДИНЕНИЕ ПланТрудозатрат КАК ПланТрудозатрат
		|        ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ПланТрудозатрат.ПроектнаяЗадача
		|        ЛЕВОЕ СОЕДИНЕНИЕ ФактТрудозатрат КАК ФактТрудозатрат
		|        ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ФактТрудозатрат.ПроектнаяЗадача
		|        ЛЕВОЕ СОЕДИНЕНИЕ ПроцентыГотовности КАК ПроцентыГотовности
		|        ПО ТаблицаДанныеСДопДанными.ПроектнаяЗадача = ПроцентыГотовности.ПроектнаяЗадача
		|
		|УПОРЯДОЧИТЬ ПО
		|    Роль,
		|    Проект,
		|    КодСДР
		|ИТОГИ
		|    СУММА(БазовыйПлан),
		|    СУММА(БазовыйПланТрансляция),
		|    СУММА(ТекущийПлан),
		|    СУММА(ТекущийПланТрансляция),
		|    СУММА(ТекущийПланДоОтчетногоПериода),
		|    СУММА(ТекущийПланДоОтчетногоПериодаТрансляция),
		|    СУММА(ТекущийПланОтчетногоПериода),
		|    СУММА(ТекущийПланОтчетногоПериодаТрансляция),
		|    МАКСИМУМ(КодСДР),
		|    МИНИМУМ(ДатаНачалаТП),
		|    МАКСИМУМ(ДатаЗавершенияТП),
		|    МИНИМУМ(ДатаНачалаТП_Месяц),
		|    МАКСИМУМ(ДатаЗавершенияТП_Месяц),
		|    МИНИМУМ(ДатаНачалаПоЗагрузке),
		|    МАКСИМУМ(ДатаЗавершенияПоЗагрузке),
		|    МИНИМУМ(ДатаНачалаПоЗагрузкеТП),
		|    МАКСИМУМ(ДатаЗавершенияПоЗагрузкеТП),
		|    СУММА(ТрудозатратыДоНачалаПериода),
		|    СУММА(ТрудозатратыДоНачалаПериодаТрансляция),
		|    СУММА(ОстатокДоЗавершения),
		|    СУММА(ОстатокДоЗавершенияДоп),
		|    СУММА(Факт),
		|    СУММА(ФактИсходный),
		|    СУММА(ФактОтчетногоПериода),
		|    СУММА(ФактОтчетногоПериодаДоп),
		|    СУММА(ФактДоОтчетногоПериода),
		|    МИНИМУМ(ФактДругихДокументов),
		|    МАКСИМУМ(ТипЗадачи),
		|    МАКСИМУМ(ЗадачаЗавершена),
		|    МАКСИМУМ(ЗадачаЗакрыта),
		|    МАКСИМУМ(Статус),
		|    МАКСИМУМ(ТекПользовательЯвляетсяРПЗИлиРП),
		|    МАКСИМУМ(ПроцентГотовности),
		|    МАКСИМУМ(ПроцентГотовностиРучноеРедактирование),
		|    МАКСИМУМ(ПроектВыполняется),
		|    МИНИМУМ(ДатаНачалаФакт),
		|    МАКСИМУМ(ДатаЗавершенияФакт),
		|    МАКСИМУМ(Календарь),
		|    МАКСИМУМ(ПроцентГотовностиЗадачи),
		|    МАКСИМУМ(ПроцентГотовностиЗадачиТекущийПлан),
		|    МАКСИМУМ(ПланДоПолногоПоЗадаче),
		|    МАКСИМУМ(ПланДоПолногоПоЗадачеТрансляция),
		|    МАКСИМУМ(ФактДоПолногоПоЗадаче)
		|ПО
		|    &СтрокаИтогов";
	
	Если ЗаполнениеПоКомандеЗаполнить Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДанныеСДопДанными.Записывать", "ТаблицаДанныеСДопДанными.Записывать
				|		И НЕ ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ЗадачаЗавершена, ЛОЖЬ)
				|		И НЕ ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ЗадачаЗакрыта, ЛОЖЬ)
				|		И ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ТекПользовательЯвляетсяРПЗИлиРП, ЛОЖЬ)");
	ИначеЕсли НЕ ДокументПроведен Тогда
		// Если документ не проведен, то при включенном ограничении доступа снимаем выставленные отметки записи по закрытым и
		// завершенным ПЗ, т.к. у пользователя нет прав на изменение этих строк интерактивно и он не сможет провести документ.
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДанныеСДопДанными.Записывать", "ТаблицаДанныеСДопДанными.Записывать
				|		И ВЫБОР 
				|			КОГДА НЕ &ОтключитьРазграничениеДоступаКПроектнымДокументам 
				|				ТОГДА НЕ ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ЗадачаЗавершена, ЛОЖЬ)
				|					И НЕ ЕСТЬNULL(ДанныеНаРедактированиеПроектныхЗадач.ЗадачаЗакрыта, ЛОЖЬ)
				|			ИНАЧЕ ИСТИНА
				|		КОНЕЦ");
	КонецЕсли;
	
	Возврат СтрЗаменить(ТекстЗапроса, "&СтрокаИтогов", СтрокаГруппировокВЗапросе);
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаДанныеОбъектаИзБД()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    упоВерсииПроекта.Версия КАК Версия,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция КАК ПроектнаяЗадача,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение КАК Подразделение,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс КАК Ресурс,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День КАК День,
		|    СУММА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Трудозатраты) КАК Трудозатраты,
		|    СУММА(ВЫБОР
		|            КОГДА упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.ИсточникПлана = ЗНАЧЕНИЕ(Перечисление.упоИсточникПланаТрудозатратРолей.Объемы)
		|                ТОГДА упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Трудозатраты
		|            ИНАЧЕ 0
		|        КОНЕЦ) КАК ТрудозатратыТрансляция
		|ПОМЕСТИТЬ ТрудозатратыПланПоПрогнозу
		|ИЗ
		|    РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		|            ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|            ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		|                И (упоВерсииПроекта.Текущая)
		|        ПО упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|            И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		|ГДЕ
		|    (&ВсеПроекты
		|            ИЛИ упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Проект В (&СписокПроектов))
		|    И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.УровеньПланирования = &УровеньПланирования
		|    И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс ССЫЛКА Справочник.упоРоли
		|    И (&ВсеРоли
		|            ИЛИ упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс В (&СписокРолей))
		|    И (&ВсеПодразделения
		|            ИЛИ упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение В (&СписокПодразделений))
		|
		|СГРУППИРОВАТЬ ПО
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение,
		|    упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День,
		|    упоВерсииПроекта.Версия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|    НАЧАЛОПЕРИОДА(ТрудозатратыПланПоПрогнозу.День, МЕСЯЦ) КАК Дата,
		|    ТрудозатратыПланПоПрогнозу.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|    ТрудозатратыПланПоПрогнозу.Ресурс КАК Роль,
		|    ТрудозатратыПланПоПрогнозу.Подразделение КАК Подразделение,
		|    СУММА(ТрудозатратыПланПоПрогнозу.Трудозатраты) КАК Трудозатраты,
		|    СУММА(ТрудозатратыПланПоПрогнозу.ТрудозатратыТрансляция) КАК ТрудозатратыТрансляция
		|ПОМЕСТИТЬ ТрудозатратыПланЗаПериод
		|ИЗ
		|    ТрудозатратыПланПоПрогнозу КАК ТрудозатратыПланПоПрогнозу
		|ГДЕ
		|    ТрудозатратыПланПоПрогнозу.День >= &НачалоПериода
		|    И ТрудозатратыПланПоПрогнозу.День <= &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|    НАЧАЛОПЕРИОДА(ТрудозатратыПланПоПрогнозу.День, МЕСЯЦ),
		|    ТрудозатратыПланПоПрогнозу.ПроектнаяЗадача,
		|    ТрудозатратыПланПоПрогнозу.Ресурс,
		|    ТрудозатратыПланПоПрогнозу.Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|    упоФактТрудозатратПоДням.Операция КАК ПроектнаяЗадача,
		|    упоФактТрудозатратПоДням.Роль КАК Роль,
		|    упоФактТрудозатратПоДням.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ПодходящиеЗадачиПоФакту
		|ИЗ
		|    РегистрСведений.упоФактТрудозатратПоДням КАК упоФактТрудозатратПоДням
		|ГДЕ
		|    (&ВсеПроекты
		|            ИЛИ упоФактТрудозатратПоДням.Операция.Проект В (&СписокПроектов))
		|    И упоФактТрудозатратПоДням.Ресурс ССЫЛКА Справочник.упоРоли
		|    И (упоФактТрудозатратПоДням.Ресурс В (&СписокРолей)
		|            ИЛИ &ВсеРоли)
		|    И (упоФактТрудозатратПоДням.Подразделение В (&СписокПодразделений)
		|            ИЛИ &ВсеПодразделения)
		|    И упоФактТрудозатратПоДням.День >= &НачалоПериода
		|    И упоФактТрудозатратПоДням.День <= &КонецПериода
		|    И упоФактТрудозатратПоДням.Трудозатраты <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
		|ПОМЕСТИТЬ ПодходящиеЗадачиПоСрокам
		|ИЗ
		|    РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
		|            ,
		|            &ВсеПроекты
		|                ИЛИ ПроектнаяЗадача.Проект В (&СписокПроектов)) КАК упоСрокиПроектныхЗадачСрезПоследних
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|        ПО упоСрокиПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		|            И (упоВерсииПроекта.Текущая)
		|        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
		|        ПО упоСрокиПроектныхЗадачСрезПоследних.Версия = упоСвойстваПроектныхЗадачСрезПоследних.Версия
		|            И упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|            И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
		|ГДЕ
		|    упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан <= &КонецПериода
		|    И упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан >= &НачалоОтчетногоПериода
		|
		|СГРУППИРОВАТЬ ПО
		|    упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|    упоВерсииПроекта.Версия КАК Версия,
		|    упоВерсииПроекта.Проект КАК Проект,
		|    ВложенныйЗапрос.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|    ВЫБОР
		|        КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ЭтоВеха
		|            ТОГДА 5
		|        КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ЭтоМодельПакетаРабот
		|            ТОГДА 0
		|        ИНАЧЕ 1
		|    КОНЕЦ КАК ТипЗадачи
		|ПОМЕСТИТЬ ВсеНужныеЗадачиДоПроверкиСтатуса
		|ИЗ
		|    (ВЫБРАТЬ
