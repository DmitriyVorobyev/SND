&НаКлиенте
Процедура ДиаграммаВыбор(Элемент, ЗначениеДиаграммы, СтандартнаяОбработка)		

	СтандартнаяОбработка = Ложь;
	ДатаТочки = ЗначениеДиаграммы.Расшифровка;
	Если ДатаТочки < Объект.НачалоПериода Тогда
		ИмяКолонки = "ДеревоФормыФакт";
	Иначе	
		ИмяКолонки = ПолучитьИмяОсновнойКолонки(ДатаТочки);
	КонецЕсли;
	Элементы.ДеревоФормы.ТекущийЭлемент = Элементы[ИмяКолонки];
	Если ЗначениеЗаполнено(РольДиаграммыПоРоли) Тогда
		мСтрокРесурса = мКэшЗначений.СтрокиРесурса_НижнийУровень.Получить(РольДиаграммыПоРоли);
		Если ТипЗнч(мСтрокРесурса) = Тип("Массив") И мСтрокРесурса.Количество() > 0 Тогда
			Элементы.ДеревоФормы.ТекущаяСтрока = мСтрокРесурса[0];
		КонецЕсли;	
	КонецЕсли;
	ЭтаФорма.ТекущийЭлемент = Элементы.ДеревоФормы;
	Элементы.ДеревоФормы.ИзменитьСтроку();

