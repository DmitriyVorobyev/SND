КонецПроцедуры

&НаКлиенте
Функция МожноРедактироватьСтроку(Строка)

	Возврат ОтключитьРазграничениеДоступаКПроектнымДокументам 
			Или (Не Строка.ЗадачаЗавершена 
				И Не Строка.ЗадачаЗакрыта 
				И Строка.ТекПользовательЯвляетсяРПЗИлиРП);

КонецФункции	

&НаСервере
Процедура УстановитьДоступностьДокумента(Дерево, ОтключитьРазграничениеДоступаКПроектнымДокументам)

	Если ОтключитьРазграничениеДоступаКПроектнымДокументам Или Дерево.Строки.Количество() = 0 
		Или Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;	
	КонецЕсли;

	РежимТолькоПросмотр = Истина;	
	СтрокиПоследнегоУровня = Дерево.Строки.НайтиСтроки(Новый Структура("ПоследнийУровень", Истина), Истина);
	Для Каждого Строка Из СтрокиПоследнегоУровня Цикл
		Если Не Строка.ЗадачаЗавершена И Не Строка.ЗадачаЗакрыта И Строка.ТекПользовательЯвляетсяРПЗИлиРП Тогда
			РежимТолькоПросмотр	= Ложь;
			Прервать;
		КонецЕсли;			
	КонецЦикла;

	ЭтотОбъект.ТолькоПросмотр = РежимТолькоПросмотр;	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыОткрытияАнализаВыполнимости(ПараметрыОткрытия)

	ПараметрыОткрытия.Вставить("ДатаНачПериода", Объект.НачалоПериода);
	ПараметрыОткрытия.Вставить("ДатаКонПериода", КонецДня(Объект.КонецПериода));
	ПараметрыОткрытия.Вставить("УровеньПланирования", Объект.УровеньПланированияРолей);

	Проекты = Новый СписокЗначений;
	Для Каждого Строка Из Объект.Проекты Цикл
		Проекты.Добавить(Строка.Проект);	
	КонецЦикла;

	Роли = Новый Соответствие;
	Для Каждого Строка Из Объект.Роли Цикл
		Роли.Вставить(Строка.Роль, Истина);	
	КонецЦикла;
	ПараметрыОткрытия.Вставить("Роли", Роли);

	Подразделения = Новый Соответствие;
	Для Каждого Строка Из Объект.ПодразделенияОтбор Цикл
		Подразделения.Вставить(Строка.Подразделение, Истина);	
	КонецЦикла;
		
	ПроверяемыеДанные = Новый Структура;
	Если Проекты.Количество() = 0 Тогда
		ПроверяемыеДанные.Вставить("Проект", Новый Соответствие);
	КонецЕсли;

	ПолучатьПодразделенияРоли = Ложь;
	Если Подразделения.Количество() = 0 И Роли.Количество() = 0 Тогда		
		ПолучатьПодразделенияРоли = Истина;
		ПроверяемыеДанные.Вставить("Роль", Роли);
	Иначе		
		Если Подразделения.Количество() = 0 Тогда
			ПроверяемыеДанные.Вставить("Подразделение", Подразделения);	
		КонецЕсли;		
		Если Роли.Количество() = 0 Тогда
			ПроверяемыеДанные.Вставить("Роль", Роли);	
		КонецЕсли;		
	КонецЕсли; 

	ПолучитьПараметрыИзДерева(ПроверяемыеДанные, ПолучатьПодразделенияРоли, Проекты);	
		
	ПараметрыОткрытия.Вставить("СписокПроектовДляАнализа", Проекты);
	ПараметрыОткрытия.Вставить("Роли", Роли);
	ПараметрыОткрытия.Вставить("Подразделения", Подразделения);

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметрыИзДерева(ПроверяемыеДанные, ПолучатьПодразделенияРоли, Проекты)

	Если ПроверяемыеДанные.Количество() = 0 Тогда		
		Возврат;		
	КонецЕсли;	

	ПолучитьДанныеИзДереваРекурсивно(ДеревоФормы, ПроверяемыеДанные, ПолучатьПодразделенияРоли);		
	Если ПроверяемыеДанные.Свойство("Проект") Тогда
		Для Каждого Проект Из ПроверяемыеДанные.Проект Цикл
			Проекты.Добавить(Проект.Ключ);		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры	

&НаКлиенте
Процедура ПолучитьДанныеИзДереваРекурсивно(СтрокаДерева, ПроверяемыеДанные, ПолучатьПодразделенияРоли,
	Роль = Неопределено)

	Для Каждого Строка Из СтрокаДерева.ПолучитьЭлементы() Цикл
		Для Каждого Элемент Из ПроверяемыеДанные Цикл
			Если Строка.ИмяГруппировки = Элемент.Ключ И Элемент.Значение[Строка.Группировка] = Неопределено Тогда				 
				Элемент.Значение.Вставить(Строка.Группировка, Истина);				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЗаполнитьПодразделенияРоли(Строка, Элемент, ПроверяемыеДанные, ПолучатьПодразделенияРоли, Роль) Тогда
			Продолжить;		
		КонецЕсли;
		ПолучитьДанныеИзДереваРекурсивно(Строка, ПроверяемыеДанные, ПолучатьПодразделенияРоли);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПодразделенияРоли(Строка, Элемент, ПроверяемыеДанные, ПолучатьПодразделенияРоли, Роль)

	Если Не ПолучатьПодразделенияРоли Тогда
		Возврат Ложь;	
	КонецЕсли;

	Если Строка.ИмяГруппировки = "Роль" Тогда
		Если Элемент.Значение[Строка.Группировка] = Истина Тогда
			Элемент.Значение.Вставить(Строка.Группировка, Новый Соответствие);
		КонецЕсли;
		ПолучитьДанныеИзДереваРекурсивно(Строка, ПроверяемыеДанные, ПолучатьПодразделенияРоли, Строка.Группировка);
		Возврат Истина;
	Иначе
		Если Строка.ИмяГруппировки = "Подразделение" И Роль <> Неопределено Тогда
			ПроверяемыеДанные.Роль[Роль].Вставить(Строка.Группировка, Истина);
		КонецЕсли;
	КонецЕсли;			

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиДереваИДиаграмму(ЭтаФорма, ИмяКолонки = Неопределено)

	СчитатьВычисляемыеИтогиДерева(ЭтаФорма);
	ОбновитьПодвалИтогов(ЭтаФорма);	
	ЭтаФорма.ДиаграммаПостроена = 
		упоПланированиеТрудозатратКлиентСервер.ПостроитьДиаграмму(ЭтаФорма, "ПоРолям", ИмяКолонки);

КонецПроцедуры

&НаСервере
Процедура ДобавитьНовыеРеквизитыДерева()
	
	МассивУдаляемых = Новый Массив;
	КолонкиСодержащиеДанныеТрансляции = КолонкиСодержащиеДанныеТрансляции();
	ИменаКолонокДерева = ИменаРеквизитовДереваФормы();
	
	Для Каждого СтрокаКолонки Из КолонкиДат Цикл
		Элементы.Удалить(Элементы[СтрокаКолонки.ИмяКолонки]);
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("Итого" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("Отклонение" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("Мощность" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("Подвал" + СтрокаКолонки.ИмяКолонки);
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Трансляция");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "СТрансляцией");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Доп");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "РучноеРедактирование");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ТекущийПлан");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ТекущийПланТрансляция");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "ТекущийПланСТрансляцией");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Мощность");
		МассивУдаляемых.Добавить("ДеревоФормы." + СтрокаКолонки.ИмяКолонки + "Прогноз");
	КонецЦикла;
	
	Если МассивУдаляемых.Количество() Тогда
		ИзменитьРеквизиты( , МассивУдаляемых);
	КонецЕсли;
	
	КолонкиДат.Очистить();
	
	ТекДата = НачалоМесяца(Объект.НачалоПериода);
	
	КЧ = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
	ОписаниеТипаКолонкиЧислоНеотриц = Новый ОписаниеТипов("Число", КЧ);
	
	КЧ = Новый КвалификаторыЧисла(15, 2);
	ОписаниеТипаКолонки = Новый ОписаниеТипов("Число", КЧ);
	
	ОписаниеТипаКолонкиСтрока = Новый ОписаниеТипов("Строка");
	ОписаниеТипаКолонкиБулево = Новый ОписаниеТипов("Булево");
	
	МассивРеквизитов = Новый Массив;
	
	Для каждого ИмяКолонки Из КолонкиСодержащиеДанныеТрансляции Цикл
		КолонкаДобавлена = ИменаКолонокДерева.Найти(ИмяКолонки + "СТрансляцией") <> Неопределено;
		Если Не КолонкаДобавлена Тогда
			Реквизит = Новый РеквизитФормы(ИмяКолонки + "СТрансляцией", ОписаниеТипаКолонкиСтрока, "ДеревоФормы");
			МассивРеквизитов.Добавить(Реквизит);
		КонецЕсли;
		
		//
		
		КолонкаДобавлена = ИменаКолонокДерева.Найти(ИмяКолонки + "Трансляция") <> Неопределено;
		Если Не КолонкаДобавлена Тогда
			Реквизит = Новый РеквизитФормы(ИмяКолонки + "Трансляция", ОписаниеТипаКолонкиЧислоНеотриц, "ДеревоФормы");
			МассивРеквизитов.Добавить(Реквизит);
		КонецЕсли;
	КонецЦикла;
	
	Пока ТекДата <= Объект.КонецПериода Цикл
		ИмяКолонки = ПолучитьИмяОсновнойКолонки(ТекДата);
		СтрокаКолонки = КолонкиДат.Добавить();
		СтрокаКолонки.Дата = ТекДата;
		СтрокаКолонки.ИмяКолонки = ИмяКолонки;
		ДатаВФормате = Формат(ТекДата, "ДФ='MMM yy'");
		Реквизит = Новый РеквизитФормы(ИмяКолонки, ОписаниеТипаКолонкиЧислоНеотриц, "ДеревоФормы", ДатаВФормате);
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "Трансляция", ОписаниеТипаКолонкиЧислоНеотриц, "ДеревоФормы");
		МассивРеквизитов.Добавить(Реквизит);
		Реквизит = Новый РеквизитФормы(ИмяКолонки + "СТрансляцией", ОписаниеТипаКолонкиСтрока, "ДеревоФормы");
		МассивРеквизитов.Добавить(Реквизит);
