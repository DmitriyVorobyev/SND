&НаКлиентеНаСервереБезКонтекста
Процедура ДатыПервойПоследнейКолонокСтроки(КолонкиДат, СтрокаДерева, 
	ДатаПервойКолонки, ДатаПоследнейКолонки, 
	ДатаОстаткаДоЗавершения, БылаКолонкаСоЗначением)
	
	Для Каждого СтрокаКолонок Из КолонкиДат Цикл
			Если ЗначениеЗаполнено(СтрокаДерева[СтрокаКолонок.ИмяКолонки]) Тогда
				ДатаКолонки = НачалоМесяца(СтрокаКолонок.Дата);
				БылаКолонкаСоЗначением = Истина;
				Если ДатаПервойКолонки > ДатаКолонки Тогда
					ДатаПервойКолонки = ДатаКолонки;					
				КонецЕсли;
				Если ДатаПоследнейКолонки < ДатаКолонки Тогда
					ДатаПоследнейКолонки = ДатаКолонки;					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(СтрокаДерева.ОстатокДоЗавершения) Тогда
			ДатаКолонки = ДатаОстаткаДоЗавершения;
			БылаКолонкаСоЗначением = Истина;
			Если ДатаПервойКолонки > ДатаКолонки Тогда
				ДатаПервойКолонки = ДатаКолонки;				
			КонецЕсли;
			Если ДатаПоследнейКолонки < ДатаКолонки Тогда
				ДатаПоследнейКолонки = ДатаКолонки;				
			КонецЕсли;
		КонецЕсли;
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ОпределитьНовыеДатыПЗ(ЭтаФорма, ПроектнаяЗадачаЗеркало) 
	
	ПустаяДата = Дата(1, 1, 1);
	
	СтрокиПЗ_НижнийУровень = ЭтаФорма.мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(ПроектнаяЗадачаЗеркало);
	Строка_УровеньПЗ = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(СтрокиПЗ_НижнийУровень[0]);

	ДатаОстаткаДоЗавершения = НачалоМесяца(ДобавитьМесяц(ЭтаФорма.КонецПериодаНаФорме, 1)); 
	ДатаПослеОстатка = НачалоМесяца(ДобавитьМесяц(ДатаОстаткаДоЗавершения, 1));

	НужноОпределитьДатуНачала = Ложь;
	НужноОпределитьДатуЗавершения = Ложь;
	НужноДелатьОбход = Ложь;
	БылаКолонкаСоЗначением = Ложь;

	Если ЗначениеЗаполнено(Строка_УровеньПЗ.ДатаНачалаПоЗагрузкеТП) 
		И Строка_УровеньПЗ.ДатаНачалаПоЗагрузкеТП < ЭтаФорма.НачалоПериодаНаФорме Тогда
		ДатаПервойКолонки = Строка_УровеньПЗ.ДатаНачалаПоЗагрузкеТП;	
	Иначе
		ДатаПервойКолонки = ДатаПослеОстатка;
		НужноОпределитьДатуНачала = Истина;	
	КонецЕсли;

	ДатаПоследнейКолонки = ПустаяДата;
	НужноОпределитьДатуЗавершения = Истина;		

	НужноДелатьОбход = НужноОпределитьДатуНачала ИЛИ НужноОпределитьДатуЗавершения; 

	Если НЕ НужноДелатьОбход Тогда
		Возврат Неопределено;
	КонецЕсли;

	МассивСтрокПЗ = Новый Массив;
	Для Каждого ИдСтроки Из СтрокиПЗ_НижнийУровень Цикл
		
		ДатаПервойКолонкиЭтойСтроки = ДатаПослеОстатка;
		
		СтрокаДерева = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИдСтроки);
		МассивСтрокПЗ.Добавить(СтрокаДерева);
				
		ДатыПервойПоследнейКолонокСтроки(ЭтаФорма.КолонкиДат, СтрокаДерева, 
										ДатаПервойКолонки, ДатаПоследнейКолонки, 
										ДатаОстаткаДоЗавершения, БылаКолонкаСоЗначением);
		
	КонецЦикла;

	Если НЕ БылаКолонкаСоЗначением Тогда
		Если НужноОпределитьДатуНачала Тогда
			ДатаПервойКолонки = ПустаяДата;
			ДатаПоследнейКолонки = ПустаяДата; 			
		Иначе
			ДатаПоследнейКолонки = НачалоМесяца(ДобавитьМесяц(ЭтаФорма.НачалоПериодаНаФорме, -1));
		КонецЕсли;
	КонецЕсли;
		
	ИзменитьДатуНачала = НужноОпределитьДатуНачала 
							И ДатаПервойКолонки <> Строка_УровеньПЗ.ДатаНачалаПоЗагрузке;
	ИзменитьДатуЗавершения = НужноОпределитьДатуЗавершения 
							И ДатаПоследнейКолонки <> Строка_УровеньПЗ.ДатаЗавершенияПоЗагрузке;
		
	ИзменитьДатуНачалаДатуЗавершенияВСтроках(МассивСтрокПЗ, 
											ИзменитьДатуНачала, ИзменитьДатуЗавершения, 
											ДатаПервойКолонки, ДатаПоследнейКолонки);
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьДатуНачалаДатуЗавершенияВСтроках(МассивСтрокПЗ, ИзменитьДатуНачала, ИзменитьДатуЗавершения, 
	ДатаПервойКолонки, ДатаПоследнейКолонки)
	
	НадоМенятьДаты = ИзменитьДатуНачала Или ИзменитьДатуЗавершения;	
	Если Не НадоМенятьДаты Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДатаПоследнейКолонки) Тогда
		ДатаПервойКолонки = Дата(1, 1, 1);		
	КонецЕсли;
	
	Для Каждого СтрокаДерева Из МассивСтрокПЗ Цикл
		
		Пока Истина Цикл
			
			Если СтрокаДерева = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			ДатаНачалаУжеИзменена = Не ИзменитьДатуНачала;
			ДатаЗавершенияУжеИзменена = Не ИзменитьДатуЗавершения;
			
			Если ИзменитьДатуНачала Тогда		
				Если СтрокаДерева.ДатаНачалаПоЗагрузке = ДатаПервойКолонки Тогда
					ДатаНачалаУжеИзменена = Истина;
				Иначе
					СтрокаДерева.ДатаНачалаПоЗагрузке = ДатаПервойКолонки;
				КонецЕсли;		
			КонецЕсли;
			
			Если ИзменитьДатуЗавершения Тогда
				Если СтрокаДерева.ДатаЗавершенияПоЗагрузке = ДатаПоследнейКолонки Тогда
					ДатаЗавершенияУжеИзменена = Истина;
				Иначе
					СтрокаДерева.ДатаЗавершенияПоЗагрузке = ДатаПоследнейКолонки;
				КонецЕсли;					
			КонецЕсли;
			
			СтрокаБылаОбработанаРаньше = ДатаНачалаУжеИзменена И ДатаЗавершенияУжеИзменена;
			
			Если СтрокаБылаОбработанаРаньше Тогда
				Прервать;
			КонецЕсли;
			
			СтрокаДерева = СтрокаДерева.ПолучитьРодителя();
			
		КонецЦикла;
		
	КонецЦикла;				
		
КонецПроцедуры	

