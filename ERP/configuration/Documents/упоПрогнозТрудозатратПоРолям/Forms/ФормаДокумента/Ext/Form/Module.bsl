		НовоеУсловноеОформление = ЭтотОбъект.УсловноеОформление.Элементы.Добавить();
		НовоеУсловноеОформление.Представление = "ВозможностьРедактированияТрудозатратПрогнозаСТрансляцией";
		
		ОтборЭлемента = НовоеУсловноеОформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоФормы.ТекущийПлан");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ОтборЭлемента.ПравоеЗначение = 0;
		
		ПолеЭлемента = НовоеУсловноеОформление.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДеревоФормы");
		
		НовоеУсловноеОформление.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		НовоеУсловноеОформление.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.НедоступныеДанныеЦвет);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_РучноеРедактирование(ИмяПоля, ПредставлениеЭлементаУО, ПрефиксИмениПоля = "")

	ШрифтЖирный = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина);

	НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = ПредставлениеЭлементаУО; 
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);

	НовыйЭлементУООтбор = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));		
	НовыйЭлементУООтбор.ЛевоеЗначение = 
		Новый ПолеКомпоновкиДанных("ДеревоФормы." + ИмяПоля + "РучноеРедактирование");
	НовыйЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	НовыйЭлементУООтбор.ПравоеЗначение = Истина;

	НовоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(ПрефиксИмениПоля + ИмяПоля);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СчитатьВычисляемыеИтогиСтрокиСОбновлениемРодителей(СтрокаДерева)
		
	ТекСтрока = СтрокаДерева;	
	Пока ТекСтрока <> Неопределено Цикл
							
		СчитатьВычисляемыеИтогиСтроки(ТекСтрока);	
				
		Если ТипЗнч(ТекСтрока) = Тип("ДанныеФормыЭлементДерева") Тогда
			ТекСтрока = ТекСтрока.ПолучитьРодителя();
		Иначе
			ТекСтрока = ТекСтрока.Родитель;
		КонецЕсли;		
		
	КонецЦикла;

