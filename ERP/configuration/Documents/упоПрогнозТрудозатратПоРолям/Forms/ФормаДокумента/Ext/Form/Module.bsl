&НаКлиенте
Функция ПолучитьМассивВыделенныхСтрокНижнегоУровня(МассивСтрок = Неопределено, Строка = Неопределено) 

	Если МассивСтрок = Неопределено Тогда
		МассивСтрок = Новый Массив;				
	КонецЕсли;

	Если Строка = Неопределено Тогда
		Для Каждого Ид Из Элементы.ДеревоФормы.ВыделенныеСтроки Цикл
			тСтрока = ДеревоФормы.НайтиПоИдентификатору(Ид);
			ПолучитьМассивВыделенныхСтрокНижнегоУровня(МассивСтрок, тСтрока);
		КонецЦикла;		
	ИначеЕсли НЕ Строка.ПоследнийУровень Тогда
		тЭлементы = Строка.ПолучитьЭлементы();
		Для Каждого тЭлемент Из тЭлементы Цикл
			ПолучитьМассивВыделенныхСтрокНижнегоУровня(МассивСтрок, тЭлемент);
		КонецЦикла;
	Иначе
		Если МожноРедактироватьСтроку(Строка) Тогда
			МассивСтрок.Добавить(Строка);
		КонецЕсли;
	КонецЕсли;

	Возврат МассивСтрок;

КонецФункции

&НаКлиенте
Процедура ИзменитьДоступностьКомандРекурсивно(Элемент, ДоступностьКоманд)

	Для Каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда
			ИзменитьДоступностьКомандРекурсивно(ПодчиненныйЭлемент, ДоступностьКоманд);	
		Иначе
			Если ТипЗнч(ПодчиненныйЭлемент) = Тип("КнопкаФормы") Тогда
				ПодчиненныйЭлемент.Доступность = ДоступностьКоманд;		
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЯчейкуМожноРедактировать(Строка, Поле) 

	МожноРедактировать = Ложь;

	Если Строка.ПоследнийУровень И МожноРедактироватьСтроку(Строка) Тогда
		МожноРедактировать = Лев(Поле, 7) = "Колонка" 
							Или Поле = "ОстатокДоЗавершения"
							Или (Объект.ЗаписыватьФактОтчетногоПериода И Поле = "ФактОтчетногоПериода"); 				
	КонецЕсли;			
								
	Возврат МожноРедактировать;			

КонецФункции

