КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериод(Команда)

	ВыборПериода = Новый СтандартныйПериод(НачалоПериодаНаФорме, КонецПериодаНаФорме);

	ДиалогРедактирования = Новый ДиалогРедактированияСтандартногоПериода();
	ДиалогРедактирования.Период = ВыборПериода;

	ОписаниеОповещенияВыбратьПериодЗавершение = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтаФорма);

	ДиалогРедактирования.Показать(ОписаниеОповещенияВыбратьПериодЗавершение);
	 
КонецПроцедуры    

&НаКлиенте
Процедура КомандаПоказатьДиаграмму(Команда)

	Объект.ПоказатьДиаграмму = Не Объект.ПоказатьДиаграмму;
	Элементы.ФормаКомандаПоказатьДиаграмму.Пометка = Объект.ПоказатьДиаграмму; 

	Если Объект.ПоказатьДиаграмму И Не ЭтаФорма.ДиаграммаПостроена Тогда
		ЭтаФорма.ДиаграммаПостроена = упоПланированиеТрудозатратКлиентСервер.ПостроитьДиаграмму(ЭтаФорма, "ПоРолям");
	КонецЕсли;	

	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАнализВыполнимости(Команда)

	ПараметрыОткрытия = Новый Структура;				
	ЗаполнитьПараметрыОткрытияАнализаВыполнимости(ПараметрыОткрытия);	

	ОткрытьФорму("Обработка.упоАнализВыполнимостиПроектов.Форма", ПараметрыОткрытия, ЭтотОбъект,
		ЭтотОбъект.УникальныйИдентификатор);

КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)

	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);

КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

&НаКлиенте
Процедура ПоказатьЛегенду(Команда)

	Элементы.ДеревоФормыПоказатьЛегенду.Пометка = Не Элементы.ДеревоФормыПоказатьЛегенду.Пометка;

	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАнализИзменений(Команда)

	Если ЭтотОбъект.Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Для формирования отчета документ необходимо записать.'"));
		Возврат;
	КонецЕсли;	

	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Документ", Объект.Ссылка);	

	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыОткрытия.Вставить("ПараметрыОтчета", ПараметрыОтчета);

	ИмяОтчета = "упоАнализИзмененийПоПрогнозуТрудозатратПоРолям";
	Если Объект.ПорядокГруппировок = 
		ПредопределенноеЗначение("Перечисление.упоПорядокГруппировокПрогнозированиеТрудозатрат.ПроектЗадачаРольПодразделение") Тогда		
		КлючВарианта = "Проект_Задача_Роль_Подразделение";
	Иначе	
	    КлючВарианта = "Роль_Подразделение_Проект_Задача";
	КонецЕсли;

	ВариантСсылка = упоФункцииБСП.ВариантОтчетаПоИмениОтчетаКлючуВарианта(ИмяОтчета, КлючВарианта);
				
	ВариантыОтчетовКлиент.ОткрытьФормуОтчета(Неопределено, ВариантСсылка, ПараметрыОткрытия);

КонецПроцедуры

