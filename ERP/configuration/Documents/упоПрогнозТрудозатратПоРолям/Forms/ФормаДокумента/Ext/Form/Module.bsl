&НаКлиенте
Процедура ДеревоФормыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоФормы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДеревоФормыГруппировка" Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ТекДанные[ТекДанные.ИмяГруппировки]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФормыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

	СтандартнаяОбработка = Ложь;

	Если ЭтотОбъект.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;

	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Значение = ПараметрыПеретаскивания.Значение;
	
	ТипЗнчСтрока = ТипЗнч(Строка);
	ЭтоРазрешенныйТип = ТипЗнчСтрока = Тип("Число") 
						ИЛИ ТипЗнчСтрока = Тип("УникальныйИдентификатор") 
						ИЛИ ТипЗнчСтрока = Тип("Строка");
	Если Не ЭтоРазрешенныйТип Тогда
		Возврат;
	КонецЕсли;

	СтрокаПриемник = ДеревоФормы.НайтиПоИдентификатору(Строка);
	ПолеПриемник = СтрЗаменить(Поле.Имя, "ДеревоФормы", "");

	Если Не ЯчейкуМожноРедактировать(СтрокаПриемник, ПолеПриемник) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") 
		И Значение.Количество() = 3 
		И Значение[0] = ("Перетаскивание" + ЭтотОбъект.УникальныйИдентификатор) Тогда
		
		СтрокаИсточник = ДеревоФормы.НайтиПоИдентификатору(Значение[1]); 
		ПолеИсточник = Значение[2];
		УстановитьТрудозатраты(ЭтотОбъект, 
								СтрокаПриемник, 
								ПолеПриемник, 
								СтрокаПриемник[ПолеПриемник] + СтрокаИсточник[ПолеИсточник]
								,
								,
								,
								, 
								Истина);
		Если ЯчейкуМожноРедактировать(СтрокаИсточник, ПолеИсточник) Тогда
			СтрокаИсточник[ПолеИсточник] = 0;	
			УстановитьТрудозатраты(ЭтотОбъект, СтрокаИсточник, ПолеИсточник, 0);
		КонецЕсли;
		
		Если ПолеПриемник = "ФактОтчетногоПериода" Тогда
			ВыполнитьАвтоматическийРасчетПроцентаГотовностиПоСтроке(СтрокаПриемник);
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() > 0 И ТипЗнч(Значение[0]) = Тип("Число") Тогда
		
		УстановитьТрудозатраты(ЭтотОбъект, 
								СтрокаПриемник, 
								ПолеПриемник, 
								СтрокаПриемник[ПолеПриемник] + Значение[0],
								,
								,
								, 
								Истина);
								
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		
		УстановитьТрудозатраты(ЭтотОбъект, 
								СтрокаПриемник, 
								ПолеПриемник, 
								СтрокаПриемник[ПолеПриемник] + Значение,
								,
								,
								, 
								Истина);
								
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда	
		Попытка
			Значение = Число(Значение);
			УстановитьТрудозатраты(ЭтотОбъект, 
									СтрокаПриемник, 
									ПолеПриемник, 
									СтрокаПриемник[ПолеПриемник] + Значение
									,
									,
									,
									, 
									Истина);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	ЭтоКолонкаПериод = Истина;
	ПосчитатьДанныеКолонкиСТрансляцией(СтрокаПриемник, ПолеПриемник, ИспользуетсяТрансляцияТрудозатрат, ЭтоКолонкаПериод); 
	ПосчитатьДанныеКолонкиСТрансляцией(СтрокаИсточник, ПолеИсточник, ИспользуетсяТрансляцияТрудозатрат, ЭтоКолонкаПериод);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФормыПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФормыФактОтчетногоПериодаПриИзменении(Элемент)

	ТекДанные = Элементы.ДеревоФормы.ТекущиеДанные;		
		
	УстановитьТрудозатраты(ЭтаФорма, 
							ТекДанные, 
							"ФактОтчетногоПериода", 
							ТекДанные.ФактОтчетногоПериода,
							,
							, 
							Ложь, 
							Истина);

	ПересчитатьСтрокуТрудозатратПоПрофилю(ТекДанные, "ФактОтчетногоПериода");
		
	ВыполнитьАвтоматическийРасчетПроцентаГотовностиПоСтроке(ТекДанные);
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоФормыПроцентГотовностиПриИзменении(Элемент)

	ТекДанные = Элементы.ДеревоФормы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	

	ТекДанные.ПроцентГотовностиРучноеРедактирование = Истина;

	ПриИзмененииПроцентаГотовностиПоСтроке(ТекДанные);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКолонки(Элемент)
	
	ТекДанные = Элементы.ДеревоФормы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = Элемент.Имя;
	
	УстановитьТрудозатраты(ЭтаФорма, ТекДанные, ИмяКолонки);
	
	Если ИспользуетсяТрансляцияТрудозатрат И ТекДанные[ИмяКолонки + "Трансляция"] > 0 Тогда 
		ЭтоКолонкаПериод = Истина;
		ПосчитатьДанныеКолонкиСТрансляцией(ТекДанные, ИмяКолонки, ИспользуетсяТрансляцияТрудозатрат, ЭтоКолонкаПериод);
	КонецЕсли;
	                                                                                                                       
	ИмяКолонкиРучноеРедактирование = ИмяКолонки + "РучноеРедактирование";
	Если ТекДанные.Свойство(ИмяКолонкиРучноеРедактирование) Тогда
		ТекДанные[ИмяКолонкиРучноеРедактирование] = Истина;
	КонецЕсли;
	ПересчитатьСтрокуТрудозатратПоПрофилю(ТекДанные, ИмяКолонки);
	
	ВыполнитьАвтоматическийРасчетПроцентаГотовностиПоСтроке(ТекДанные);
	
КонецПроцедуры

