	ИменаКолонок.Добавить("БазовыйПлан");
	ИменаКолонок.Добавить("ТекущийПлан");
	ИменаКолонок.Добавить("ТекущийПланДоОтчетногоПериода");
	ИменаКолонок.Добавить("ТекущийПланОтчетногоПериода");
	ИменаКолонок.Добавить("ФактПлюсПрогноз");
	ИменаКолонок.Добавить("ИтогоПрогноз");
	ИменаКолонок.Добавить("ПланМинусФакт");
	ИменаКолонок.Добавить("ПланМинусФактИПрогноз");
	ИменаКолонок.Добавить("БазовыйПланМинусФактИПрогноз");
	ИменаКолонок.Добавить("ОстатокДоЗавершения");
	ИменаКолонок.Добавить("ОстатокДоЗавершенияРучноеРедактирование");
	
	Возврат ИменаКолонок;
	
КонецФункции

&НаСервере
Функция ИменаРеквизитовДереваФормы()
	
	КолонкиДерева = ЭтотОбъект.ПолучитьРеквизиты("ДеревоФормы");
	ИменаКолонокДерева = Новый Массив;
