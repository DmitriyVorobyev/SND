&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьИтоги(ЭтаФорма)

	ЭтаФорма.ИтогоБазовыйПлан = 0;
	ЭтаФорма.ИтогоТекущийПлан = 0;
	ЭтаФорма.ИтогоФактПлюсПрогноз = 0;
	ЭтаФорма.ИтогоФакт = 0;
	ЭтаФорма.ИтогоПланМинусФактИПрогноз = 0;
	ЭтаФорма.ИтогоБазовыйПланМинусФактИПрогноз = 0;
	ЭтаФорма.ИтогоПрогноз = 0;
	ЭтаФорма.ИтогоОстатокДоЗавершения = 0;
	ЭтаФорма.ИтогоМощность = 0;
	ЭтаФорма.ИтогоОстатокМощности = 0;
	ЭтаФорма.ИтогоФактДоОтчетногоПериода = 0;
	ЭтаФорма.ИтогоФактОтчетногоПериода = 0;
	ЭтаФорма.ИтогоПланМинусФакт = 0;

	ОбновитьПодвалИтогов(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПодвалИтогов(ЭтаФорма) 

	ФорматПодвала = ЭтаФорма.ФорматПодвала;

	ЭтаФорма.ПодвалБазовыйПлан = Символы.ПС + Формат(ЭтаФорма.ИтогоБазовыйПлан, ФорматПодвала);
	ЭтаФорма.ПодвалТекущийПлан = Символы.ПС + Формат(ЭтаФорма.ИтогоТекущийПлан, ФорматПодвала);
	ЭтаФорма.ПодвалТекущийПланОтчетногоПериода = Символы.ПС + 
								Формат(ЭтаФорма.ИтогоТекущийПланОтчетногоПериода, ФорматПодвала);
	ЭтаФорма.ПодвалТекущийПланДоОтчетногоПериода = Символы.ПС + 
								Формат(ЭтаФорма.ИтогоТекущийПланДоОтчетногоПериода, ФорматПодвала);
	ЭтаФорма.ПодвалФактПлюсПрогноз = Символы.ПС + Формат(ЭтаФорма.ИтогоФактПлюсПрогноз, ФорматПодвала);
	ЭтаФорма.ПодвалФакт = Символы.ПС + Формат(ЭтаФорма.ИтогоФакт, ФорматПодвала);
	ЭтаФорма.ПодвалПланМинусФактИПрогноз = Символы.ПС + Формат(ЭтаФорма.ИтогоПланМинусФактИПрогноз, ФорматПодвала);
	ЭтаФорма.ПодвалБазовыйПланМинусФактИПрогноз = Символы.ПС + 
								Формат(ЭтаФорма.ИтогоБазовыйПланМинусФактИПрогноз, ФорматПодвала);
	ЭтаФорма.ПодвалПрогноз = Формат(ЭтаФорма.ИтогоМощность, ФорматПодвала) + Символы.ПС +
								Формат(ЭтаФорма.ИтогоПрогноз, ФорматПодвала) + Символы.ПС + 
								Формат(ЭтаФорма.ИтогоОстатокМощности, ФорматПодвала);
	ЭтаФорма.ПодвалОстатокДоЗавершения = Символы.ПС + Формат(ЭтаФорма.ИтогоОстатокДоЗавершения, ФорматПодвала);

	ЭтаФорма.ПодвалФактДоОтчетногоПериода = Символы.ПС + Формат(ЭтаФорма.ИтогоФактДоОтчетногоПериода, ФорматПодвала);
	ЭтаФорма.ПодвалФактОтчетногоПериода = Символы.ПС + Формат(ЭтаФорма.ИтогоФактОтчетногоПериода, ФорматПодвала);
	ЭтаФорма.ПодвалПланМинусФакт = Символы.ПС + Формат(ЭтаФорма.ИтогоПланМинусФакт, ФорматПодвала);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормыИзКонстант()

	ОтключитьРазграничениеДоступаКПроектнымДокументам 		= Ложь;
	СтрогийКонтрольИзмененияЗакрытыхЭтапов 					= Ложь;
	РазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам 	= Ложь;
	Если Не ТолькоПросмотр Тогда	
		ОтключитьРазграничениеДоступаКПроектнымДокументам = 
			упоРазграничениеДоступаВызовСервера.РазграничениеДоступаОтключено();
		Если ОтключитьРазграничениеДоступаКПроектнымДокументам Тогда	
			СтрогийКонтрольИзмененияЗакрытыхЭтапов = 
				упоЗакрытиеЭтапаПовтИспСеанс.СтрогийКонтрольИзмененияЗакрытыхЭтапов();
			РазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам = 
				Константы.упоРазрешитьРаспределениеРабочегоВремениПоЗакрытымЗадачам.Получить();
		КонецЕсли;		
	КонецЕсли;		

КонецПроцедуры	

&НаСервере
Функция ПредставлениеПорядкаГруппировок()

	МассивГруппировок = Новый Массив;
	Если Объект.ПорядокГруппировок = Перечисления.упоПорядокГруппировокПрогнозированиеТрудозатрат.РольПодразделениеПроектЗадача Тогда
		МассивГруппировок.Добавить("Роль");
		МассивГруппировок.Добавить("Подразделение");		
		МассивГруппировок.Добавить("Проект");
		МассивГруппировок.Добавить("ПроектнаяЗадачаЗеркало");		
	Иначе
		МассивГруппировок.Добавить("Проект");
		МассивГруппировок.Добавить("ПроектнаяЗадачаЗеркало");
		МассивГруппировок.Добавить("Роль");
		МассивГруппировок.Добавить("Подразделение");
	КонецЕсли;

	ПоследняяГруппировкаВЗапросе = МассивГруппировок.Количество() - 2;
	сч = 0;
	СтрокаГруппировокВЗапросе = "";
	Пока сч <= ПоследняяГруппировкаВЗапросе Цикл
		СтрокаГруппировокВЗапросе = СтрокаГруппировокВЗапросе + 
			?(ЗначениеЗаполнено(СтрокаГруппировокВЗапросе), ", ", "") + МассивГруппировок[сч];
		сч = сч + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Массив", МассивГруппировок);
	Результат.Вставить("Строка", СтрокаГруппировокВЗапросе);
		
	Возврат Результат;

КонецФункции	

&НаСервере
Процедура ЗаполнитьОтборыНаФорме(Проекты, Роли, Подразделения)

	УровеньПланированияНаФорме 	= Объект.УровеньПланированияРолей;
	НачалоПериодаНаФорме 		= Объект.НачалоПериода;
	КонецПериодаНаФорме 		= Объект.КонецПериода;

	УстановитьЗаголовокВыбораПериода(ЭтаФорма);

	СписокПроектов.ЗагрузитьЗначения(Проекты);
	СписокРолей.ЗагрузитьЗначения(Роли);							
	СписокПодразделений.ЗагрузитьЗначения(Подразделения);

	УстановитьПараметрыВыбораРолей(Элементы.СписокРолей, СписокПодразделений);

КонецПроцедуры	

&НаСервере
Функция ВыгрузитьРезультатЗапросаВДерево(Запрос)
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам); 
	
	КЧ = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
	ОписаниеТипаКолонкиЧислоНеотриц = Новый ОписаниеТипов("Число", КЧ);
	
	КЧ = Новый КвалификаторыЧисла(15, 2);
	ОписаниеТипаКолонкиЧисло = Новый ОписаниеТипов("Число", КЧ);
	
	ОписаниеТипаКолонкиСтрока = Новый ОписаниеТипов("Строка");
	ОписаниеТипаКолонкиБулево = Новый ОписаниеТипов("Булево");
	
	Дерево.Колонки.Добавить("Группировка");
	Дерево.Колонки.Добавить("ИндексКартинки", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("УровеньДерева", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("ПоследнийУровень", ОписаниеТипаКолонкиБулево);	
	Дерево.Колонки.Добавить("ИмяГруппировки", ОписаниеТипаКолонкиСтрока);
	Дерево.Колонки.Добавить("ПредставлениеЗадачи", ОписаниеТипаКолонкиСтрока);
	Дерево.Колонки.Добавить("ИтогоПрогноз", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("ИтогоПрогнозТрансляция", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("ФактПлюсПрогноз", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("ФактПлюсПрогнозТрансляция", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("ПланМинусФактИПрогноз", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("БазовыйПланМинусФактИПрогноз", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("ПланМинусФакт", ОписаниеТипаКолонкиЧисло);
	Дерево.Колонки.Добавить("ПланМинусФактТрансляция", ОписаниеТипаКолонкиЧисло);
	
	КолонкиСодержащиеДанныеТрансляции = КолонкиСодержащиеДанныеТрансляции();
	Для каждого ИмяКолонки Из КолонкиСодержащиеДанныеТрансляции Цикл
		Если Дерево.Колонки.Найти(ИмяКолонки + "СТрансляцией") = Неопределено Тогда
			Дерево.Колонки.Добавить(ИмяКолонки + "СТрансляцией", ОписаниеТипаКолонкиСтрока);
		КонецЕсли;
		
		Если Дерево.Колонки.Найти(ИмяКолонки + "Трансляция") = Неопределено Тогда
			Дерево.Колонки.Добавить(ИмяКолонки + "Трансляция", ОписаниеТипаКолонкиЧислоНеотриц);
		КонецЕсли;
    КонецЦикла;
	
	Для Каждого СтрокаКолонки Из КолонкиДат Цикл
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки, ОписаниеТипаКолонкиЧислоНеотриц);	
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "Трансляция", ОписаниеТипаКолонкиЧислоНеотриц);	
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "СТрансляцией", ОписаниеТипаКолонкиСтрока);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "Доп", ОписаниеТипаКолонкиЧислоНеотриц); 
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "РучноеРедактирование", ОписаниеТипаКолонкиБулево);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ТекущийПлан", ОписаниеТипаКолонкиЧислоНеотриц);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ТекущийПланТрансляция", ОписаниеТипаКолонкиЧислоНеотриц);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "ТекущийПланСТрансляцией", ОписаниеТипаКолонкиСтрока);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "Мощность", ОписаниеТипаКолонкиЧислоНеотриц);
		Дерево.Колонки.Добавить(СтрокаКолонки.ИмяКолонки + "Прогноз", ОписаниеТипаКолонкиЧислоНеотриц);
	КонецЦикла;

	Возврат Дерево;
	
КонецФункции	

&НаСервере
Функция ЗагрузитьДанныеФормыИзОбъекта(ТолькоШапку = Ложь, ОбновитьШапку = Истина) 

	Проекты = Объект.Проекты.Выгрузить().ВыгрузитьКолонку("Проект");
	ВсеПроекты = Проекты.Количество() = 0;

	Роли = Объект.Роли.Выгрузить().ВыгрузитьКолонку("Роль");
	ВсеРоли = Роли.Количество() = 0;

	Подразделения = Объект.ПодразделенияОтбор.Выгрузить().ВыгрузитьКолонку("Подразделение");
	ВсеПодразделения = Подразделения.Количество() = 0;

	Если ОбновитьШапку Тогда
		
		ЗаполнитьОтборыНаФорме(Проекты, Роли, Подразделения);								
		
		Если ТолькоШапку Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;				

	ОчиститьИтоги(ЭтаФорма);

	ДобавитьНовыеРеквизитыДерева();	
		
	ЗаполнитьРеквизитыФормыИзКонстант();
	
	// Дерево и диаграмма.
			
	ПредставлениеГруппировок = ПредставлениеПорядкаГруппировок();
			
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанные", Объект.Данные.Выгрузить());
	Запрос.УстановитьПараметр("СписокСотрудниковДиспетчера", ПараметрыСеанса.упоСписокСотрудниковДиспетчера);
	Запрос.УстановитьПараметр("Завершена", Перечисления.упоСостояниеСтатусаЗадачи.Завершена);
	Запрос.УстановитьПараметр("Закрыта", Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	Запрос.УстановитьПараметр("СтатусПроектВыполняется", Перечисления.упоСостояниеСтатусаПроекта.Выполняется);	
	Запрос.УстановитьПараметр("УровеньПланированияРолей", Объект.УровеньПланированияРолей);
	Запрос.УстановитьПараметр("ОтключитьРазграничениеДоступаКПроектнымДокументам", 
		ОтключитьРазграничениеДоступаКПроектнымДокументам);
	Запрос.УстановитьПараметр("СписокРолей", Роли);
	Запрос.УстановитьПараметр("ВсеРоли", ВсеРоли);
	Запрос.УстановитьПараметр("СписокПодразделений", Подразделения);
	Запрос.УстановитьПараметр("ВсеПодразделения", ВсеПодразделения);
					
	Запрос.Текст = ТекстЗапросаДанныеДереваИзОбъекта(ПредставлениеГруппировок.Строка, 
														ЗаполнениеПоКомандеЗаполнить, 
														Объект.Проведен);			
		
	Дерево = ВыгрузитьРезультатЗапросаВДерево(Запрос);		
	
	ЗаполнениеПоКомандеЗаполнить = Ложь;	
	
	ТаблицаМощности = Объект.Мощности.Выгрузить();
	ТаблицаМощности.Свернуть("Дата", "Мощность");
	Для Каждого СтрокаМощности Из ТаблицаМощности Цикл
		СтрокиКолонок = КолонкиДат.НайтиСтроки(Новый Структура("Дата", СтрокаМощности.Дата));
		Если СтрокиКолонок.Количество() Тогда
			ЭтаФорма["Мощность" + СтрокиКолонок[0].ИмяКолонки] = СтрокаМощности.Мощность;
			ЭтаФорма.ИтогоМощность = ЭтаФорма.ИтогоМощность + СтрокаМощности.Мощность; 
		КонецЕсли;
	КонецЦикла;
		
	ПодготовитьДерево(ЭтаФорма, Дерево, ПредставлениеГруппировок.Массив);
	КолонкиСодержащиеДанныеТрансляции = КолонкиСодержащиеДанныеТрансляции();
	РекурсивноЗаполнитьДерево(ЭтаФорма, Дерево.Строки, КолонкиСодержащиеДанныеТрансляции, ИспользуетсяТрансляцияТрудозатрат);

	Дерево.Строки.Сортировать("Проект, Роль, КодСДР", Истина);

	УстановитьДоступностьДокумента(Дерево, ОтключитьРазграничениеДоступаКПроектнымДокументам);

	ЗначениеВРеквизитФормы(Дерево, "ДеревоФормы");

	ПолучитьСтрокиНижнегоУровня(ДеревоФормы);
		
	Для Каждого КлючЗначение Из ЭтаФорма.мКэшЗначений.СтрокиРесурса_НижнийУровень Цикл
		Для Каждого ИД Из КлючЗначение.Значение Цикл
			СтрокаДерева = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИД);
			Пока СтрокаДерева <> Неопределено Цикл
				Для Каждого СтрокаМощность Из Объект.Мощности Цикл
					Если КлючЗначение.Ключ <> СтрокаМощность.Роль Тогда
						Продолжить;	
					КонецЕсли; 
					ИмяКолонки = ПолучитьИмяОсновнойКолонки(СтрокаМощность.Дата);
					НовоеИмяКолонки = ИмяКолонки + "Мощность";
					СтрокаДерева[НовоеИмяКолонки] = СтрокаДерева[НовоеИмяКолонки] + СтрокаМощность.Мощность;
				КонецЦикла;
				СтрокаДерева = СтрокаДерева.ПолучитьРодителя();
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	ИтогоФакт 					= Дерево.Строки.Итог("Факт");
	ИтогоФактДоОтчетногоПериода = Дерево.Строки.Итог("ФактДоОтчетногоПериода"); 
	ИтогоФактОтчетногоПериода 	= Дерево.Строки.Итог("ФактОтчетногоПериода");
	ИтогоТекущийПлан 			= Дерево.Строки.Итог("ТекущийПлан");
	ИтогоТекущийПланДоОтчетногоПериода 	= Дерево.Строки.Итог("ТекущийПланДоОтчетногоПериода");
	ИтогоТекущийПланОтчетногоПериода	= Дерево.Строки.Итог("ТекущийПланОтчетногоПериода");
	ИтогоБазовыйПлан 			= Дерево.Строки.Итог("БазовыйПлан");

	ОбновитьИтогиДереваИДиаграмму(ЭтаФорма);

	// Информационные надписи.

	СформироватьНадписьСводки(ЭтаФорма);

	ПроверитьОтложенныеТрудозатраты(ЭтаФорма);
	
	ДобавитьУсловноеОформление();
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьОтложенныеТрудозатраты(ЭтаФорма)
	
	ПроектныеЗадачи = ЗадачиДокумента(ЭтаФорма.Объект);
	
	// Если очередь создана текущим проведенным документом, то ее не проверяем,
	// а если распроведенным, то очередь необходимо отразить.
	ДокументОтбора = Неопределено;
	Если ЭтаФорма.Объект.Проведен Тогда
		ДокументОтбора = ЭтаФорма.Объект.Ссылка;
	КонецЕсли;
	
	ЕстьОтложенныеТрудозатраты = упоРаботаСОчередямиВызовСервера.ЕстьОтложенныеТрудозатраты(ПроектныеЗадачи,
		ДокументОтбора);
	
	ЭтаФорма.Элементы.ГруппаОтложенноеОтражениеТрудозатрат.Видимость = ЕстьОтложенныеТрудозатраты;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПодготовитьДерево(ЭтаФорма, Дерево, МассивГруппировок, СчетчикГруппировки = 0) 

	ИмяГруппировки = МассивГруппировок[СчетчикГруппировки];

	ЭтоПоследняяГруппировка = МассивГруппировок.Количество() = СчетчикГруппировки + 1; 

	Строки = Дерево.Строки;

	ОтключитьРазграничениеДоступаКПроектнымДокументам = ЭтаФорма.ОтключитьРазграничениеДоступаКПроектнымДокументам;
	ЗаписыватьФактОтчетногоПериода = ЭтаФорма.Объект.ЗаписыватьФактОтчетногоПериода;

	Для Каждого СтрокаДерева Из Строки Цикл	
		
		СтрокаДерева.Группировка = СтрокаДерева[ИмяГруппировки];     
		СтрокаДерева.ИмяГруппировки = ИмяГруппировки;     
		СтрокаДерева.УровеньДерева = СтрокаДерева.Уровень();
				
		ЯркаяКартинка = ОтключитьРазграничениеДоступаКПроектнымДокументам
			 				Или СтрокаДерева.ТекПользовательЯвляетсяРПЗИлиРП;
			
		СтрокаДерева.ИндексКартинки = 
			упоРаботаСФормамиКлиентСервер.ИндексКартинкиДокументаПланирования(ИмяГруппировки, СтрокаДерева, ЯркаяКартинка);

		Если ИмяГруппировки = "ПроектнаяЗадачаЗеркало" Тогда
			СтрокаДерева.ПредставлениеЗадачи = "" + СтрокаДерева.КодСДР + " " + СтрокаДерева.ПроектнаяЗадачаЗеркало;						
		КонецЕсли;
		
		Если ЭтоПоследняяГруппировка Тогда
			
			СтрокаДерева.ПоследнийУровень = Истина;
						
		Иначе
			
			ПодготовитьДерево(ЭтаФорма, СтрокаДерева, МассивГруппировок, СчетчикГруппировки + 1);			
						
		КонецЕсли;
				
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РекурсивноЗаполнитьДерево(ЭтаФорма, Строки, КолонкиСодержащиеДанныеТрансляции, ИспользуетсяТрансляцияТрудозатрат)
	
	Для Каждого СтрокаДерева Из Строки Цикл
		
		Если СтрокаДерева.ПоследнийУровень Тогда
			
			ЭтаФорма["ИтогоОстатокДоЗавершения"] = ЭтаФорма["ИтогоОстатокДоЗавершения"] + СтрокаДерева.ОстатокДоЗавершения;
			СтрокаДерева["ИтогоПрогноз"] = СтрокаДерева["ИтогоПрогноз"] + СтрокаДерева.ОстатокДоЗавершения;
			ЭтаФорма.ИтогоПрогноз = ЭтаФорма.ИтогоПрогноз + СтрокаДерева.ОстатокДоЗавершения;
			
			//
			
			Отбор = Новый Структура("Роль, ПроектнаяЗадачаЗеркало, Подразделение",
					СтрокаДерева.Роль, СтрокаДерева.ПроектнаяЗадачаЗеркало, СтрокаДерева.Подразделение);
			СтрокиРаспределения = ЭтаФорма.Объект.РаспределениеПоПериоду.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаРаспределения Из СтрокиРаспределения Цикл
				
				ИмяКолонки = ПолучитьИмяОсновнойКолонки(СтрокаРаспределения.Дата);
				ЭтоКолонкаПериод = Истина;
				
				СтрокаДерева[ИмяКолонки + "Трансляция"] = СтрокаРаспределения.ТрудозатратыТрансляция;
				СтрокаДерева[ИмяКолонки + "ТекущийПлан"] = СтрокаРаспределения.ТрудозатратыТекущийПлан;
				СтрокаДерева[ИмяКолонки + "ТекущийПланТрансляция"] = СтрокаРаспределения.ТрудозатратыТекущийПланТрансляция;
				
				УстановитьТрудозатраты(ЭтаФорма,
					СтрокаДерева,
					ИмяКолонки,
					СтрокаРаспределения.Трудозатраты - СтрокаРаспределения.ТрудозатратыТрансляция,
					Ложь,
					Ложь,
					Ложь,
					СтрокаРаспределения.РучноеРедактирование,
					ЭтоКолонкаПериод);
				
				СтрокаДерева.ИтогоПрогнозТрансляция = СтрокаДерева.ИтогоПрогнозТрансляция + СтрокаДерева[ИмяКолонки + "Трансляция"]; 
				
				ПосчитатьДанныеКолонкиСТрансляцией(СтрокаДерева, ИмяКолонки, ИспользуетсяТрансляцияТрудозатрат, ЭтоКолонкаПериод);
				
			КонецЦикла;
			
		Иначе
			
			РекурсивноЗаполнитьДерево(ЭтаФорма, СтрокаДерева.Строки, КолонкиСодержащиеДанныеТрансляции, ИспользуетсяТрансляцияТрудозатрат);
			
			СтрокаДерева["ИтогоПрогноз"] = СтрокаДерева["ИтогоПрогноз"] + СтрокаДерева.ОстатокДоЗавершения;
			
		КонецЕсли;
		
		СчитатьВычисляемыеИтогиСтроки(СтрокаДерева);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево() 

	упоОперацииСДеревьямиКлиент.РазвернутьСтрокиДерева(ЭтаФорма, "ДеревоФормы");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьТрудозатраты(ЭтаФорма, 
							СтрокаДерева, 
							Знач ИмяКолонки, 
							ЗначениеТрудозатрат = Неопределено,
							СчитатьИтогиСтроки = Истина, 
							СчитатьИтогиДерева = Истина, 
							ИнтерактивноеИзменение = Истина, 
							РучноеРедактирование = Ложь,
							ЭтоКолонкаПериод = Ложь) 
	
	ФорматПодвала = ЭтаФорма.ФорматПодвала;
		
	ИмяКолонки = СтрЗаменить(ИмяКолонки, "ДеревоФормы", "");	

	Если ИмяКолонки <> "ФактОтчетногоПериода" Тогда
		СтрокаДерева[ИмяКолонки + "РучноеРедактирование"] = РучноеРедактирование;
	КонецЕсли;	

	Если ЗначениеТрудозатрат <> Неопределено Тогда		
		СтрокаДерева[ИмяКолонки] = ЗначениеТрудозатрат;
	Иначе
		ЗначениеТрудозатрат = СтрокаДерева[ИмяКолонки];
	КонецЕсли;
	
	Если ЭтоКолонкаПериод Тогда
		ЗначениеТрансляции = СтрокаДерева[ИмяКолонки + "Трансляция"]; 
	Иначе
		ЗначениеТрансляции = 0;
	КонецЕсли;
	
	ПредыдущееЗначение = СтрокаДерева[ИмяКолонки + "Доп"];
	
	Разница = ЗначениеТрудозатрат - ПредыдущееЗначение;
	
	Если Разница = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ИнтерактивноеИзменение Тогда
		Если НужноОбновитьДатыПЗ(ЭтаФорма, СтрокаДерева, ИмяКолонки, ПредыдущееЗначение, ЗначениеТрудозатрат) Тогда
			ОпределитьНовыеДатыПЗ(ЭтаФорма, СтрокаДерева.ПроектнаяЗадачаЗеркало);
		КонецЕсли;
	КонецЕсли;
			
	ЭтаФорма["Итого" + ИмяКолонки] = ЭтаФорма["Итого" + ИмяКолонки] + Разница;	

	Если ИмяКолонки <> "ФактОтчетногоПериода"
		И ИмяКолонки <> "ОстатокДоЗавершения" Тогда								
			
		СтрокаДерева[ИмяКолонки + "Прогноз"] = СтрокаДерева[ИмяКолонки + "Прогноз"] + Разница; 
		
		ЭтаФорма["Отклонение" + ИмяКолонки]	= ЭтаФорма["Мощность" + ИмяКолонки] - ЭтаФорма["Итого" + ИмяКолонки]; 					
		
		ТекстыПодвала = Новый Массив;
		ТекстыПодвала.Добавить(Формат(ЭтаФорма["Мощность" + ИмяКолонки], ФорматПодвала));
		ТекстыПодвала.Добавить(Формат(ЭтаФорма["Итого" + ИмяКолонки], ФорматПодвала));
		ТекстыПодвала.Добавить(Формат(ЭтаФорма["Отклонение" + ИмяКолонки], ФорматПодвала));
						
		ЭтаФорма["Подвал" + ИмяКолонки] = СтрСоединить(ТекстыПодвала, Символы.ПС); 													
		
	КонецЕсли;	

	ТекСтрока = СтрокаДерева;	
	Пока ТекСтрока <> Неопределено Цикл
		
		Если Не ТекСтрока.ПоследнийУровень Тогда
			ТекСтрока[ИмяКолонки] = ТекСтрока[ИмяКолонки] + Разница;
			
			Если ЭтоКолонкаПериод Тогда
				ТекСтрока[ИмяКолонки] = ТекСтрока[ИмяКолонки] + ЗначениеТрансляции;
			КонецЕсли;
		КонецЕсли;
		
		ТекСтрока[ИмяКолонки + "Доп"] = ТекСтрока[ИмяКолонки + "Доп"] + Разница;		
		Если ИмяКолонки = "ФактОтчетногоПериода" Тогда			
			ТекСтрока.Факт = ТекСтрока.ФактДоОтчетногоПериода + ТекСтрока.ФактОтчетногоПериода;	
		Иначе	
			ТекСтрока.ИтогоПрогноз = ТекСтрока.ИтогоПрогноз + Разница;
			
			Если ЭтоКолонкаПериод Тогда
				ТекСтрока.ИтогоПрогноз = ТекСтрока.ИтогоПрогноз + ЗначениеТрансляции;
			КонецЕсли;
		КонецЕсли;
		
		Если СчитатьИтогиСтроки Тогда
			СчитатьВычисляемыеИтогиСтроки(ТекСтрока);	
		КонецЕсли;		
		
		Если ТипЗнч(ТекСтрока) = Тип("ДанныеФормыЭлементДерева") Тогда
			ТекСтрока = ТекСтрока.ПолучитьРодителя();
		Иначе
			ТекСтрока = ТекСтрока.Родитель;
		КонецЕсли;		
		
	КонецЦикла;

	Если ИмяКолонки = "ФактОтчетногоПериода" Тогда		
		ЭтаФорма.ИтогоФакт 	= ЭтаФорма.ИтогоФактДоОтчетногоПериода + ЭтаФорма.ИтогоФактОтчетногоПериода;			
	Иначе	
		ЭтаФорма.ИтогоПрогноз = ЭтаФорма.ИтогоПрогноз + Разница; 	
	КонецЕсли;	

	Если СчитатьИтогиДерева Тогда 				
		ОбновитьИтогиДереваИДиаграмму(ЭтаФорма, ИмяКолонки);		
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НужноОбновитьДатыПЗ(ЭтаФорма, ТекСтрокаДерева, ИмяКолонки, ЗначениеДоИзменения, НовоеЗначение)

	НужноеИзменение = Неопределено;

	Если НовоеЗначение = 0 И ЗначениеДоИзменения <> 0 Тогда
		НужноеИзменение = "УбралиЗначение";
	ИначеЕсли НовоеЗначение <> 0 И ЗначениеДоИзменения = 0 Тогда
		НужноеИзменение = "ДобавилиЗначение";
	КонецЕсли;

	Если НужноеИзменение = Неопределено Тогда
		Возврат Ложь;	
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СчитатьВычисляемыеИтогиСтроки(СтрокаДерева) 
	
	СтрокаДерева.ФактПлюсПрогноз = СтрокаДерева.Факт + СтрокаДерева.ИтогоПрогноз;
	СтрокаДерева.ФактПлюсПрогнозТрансляция = СтрокаДерева.ИтогоПрогнозТрансляция;
	СтрокаДерева.ПланМинусФактИПрогноз = СтрокаДерева.ТекущийПлан - СтрокаДерева.ФактПлюсПрогноз;
	СтрокаДерева.ПланМинусФактИПрогнозТрансляция = СтрокаДерева.ТекущийПланТрансляция;
	СтрокаДерева.БазовыйПланМинусФактИПрогноз = СтрокаДерева.БазовыйПлан - СтрокаДерева.ФактПлюсПрогноз;
	СтрокаДерева.БазовыйПланМинусФактИПрогнозТрансляция = СтрокаДерева.БазовыйПланТрансляция;
	СтрокаДерева.ПланМинусФакт = СтрокаДерева.ТекущийПлан - СтрокаДерева.Факт;
	СтрокаДерева.ПланМинусФактТрансляция = СтрокаДерева.ТекущийПланТрансляция;
	СтрокаДерева.Записывать = СтрокаДерева.ТекущийПлан > 0 И СтрокаДерева.ПоследнийУровень;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СчитатьВычисляемыеИтогиДерева(ЭтаФорма)
	
	ЭтаФорма.ИтогоФактПлюсПрогноз = ЭтаФорма.ИтогоПрогноз + ЭтаФорма.ИтогоФакт;
	ЭтаФорма.ИтогоПланМинусФактИПрогноз = ЭтаФорма.ИтогоТекущийПлан - ЭтаФорма.ИтогоФактПлюсПрогноз;
	ЭтаФорма.ИтогоБазовыйПланМинусФактИПрогноз = ЭтаФорма.ИтогоБазовыйПлан - ЭтаФорма.ИтогоФактПлюсПрогноз;
	ЭтаФорма.ИтогоОстатокМощности = ЭтаФорма.ИтогоМощность - ЭтаФорма.ИтогоПрогноз;
	ЭтаФорма.ИтогоПланМинусФакт = ЭтаФорма.ИтогоТекущийПлан - ЭтаФорма.ИтогоФакт;
	
	// Посчитаем итоговые значения на нижнем уровне строк дерева.
	ИспользуетсяТрансляцияТрудозатрат = ЭтаФорма.ИспользуетсяТрансляцияТрудозатрат;
	Если Не ИспользуетсяТрансляцияТрудозатрат Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиНижнегоУровня = ЭтаФорма.мКэшЗначений.СтрокиРесурса_НижнийУровень;
	КолонкиСодержащиеДанныеТрансляции = КолонкиСодержащиеДанныеТрансляции();
	Для Каждого СтрокаРоль Из СтрокиНижнегоУровня Цикл
		Для Каждого ИДСтрокиДерева Из СтрокаРоль.Значение Цикл
			СтрокаДерева = ЭтаФорма.ДеревоФормы.НайтиПоИдентификатору(ИДСтрокиДерева);
			
			Для Каждого ИмяКолонки Из КолонкиСодержащиеДанныеТрансляции Цикл
				ПосчитатьДанныеКолонкиСТрансляцией(СтрокаДерева, ИмяКолонки, ИспользуетсяТрансляцияТрудозатрат);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеИзБДВОбъект()

	ЗагрузитьДанныеОбъектаИзФормы(, Истина);

	//

	Роли = Объект.Роли.Выгрузить().ВыгрузитьКолонку("Роль"); 
	ВсеРоли = Не ЗначениеЗаполнено(Роли);

	Проекты = Объект.Проекты.Выгрузить().ВыгрузитьКолонку("Проект"); 
	ВсеПроекты = Не ЗначениеЗаполнено(Проекты);

	Подразделения = Объект.ПодразделенияОтбор.Выгрузить().ВыгрузитьКолонку("Подразделение"); 
	ВсеПодразделения = Не ЗначениеЗаполнено(Подразделения);

	НачалоОтчетногоПериода = ДобавитьМесяц(Объект.НачалоПериода, -1);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяВерсия", Документы.упоВерсияПланаПроекта.ПустаяСсылка());
	Запрос.УстановитьПараметр("УровеньПланирования", Объект.УровеньПланированияРолей);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("НачалоОтчетногоПериода", НачалоОтчетногоПериода);
	Запрос.УстановитьПараметр("КонецОтчетногоПериода", КонецМесяца(НачалоОтчетногоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));
	Запрос.УстановитьПараметр("СписокРолей", Роли);
	Запрос.УстановитьПараметр("ВсеРоли", ВсеРоли);
	Запрос.УстановитьПараметр("СписокПроектов", Проекты);
	Запрос.УстановитьПараметр("ВсеПроекты", ВсеПроекты);
	Запрос.УстановитьПараметр("СписокПодразделений", Подразделения);
	Запрос.УстановитьПараметр("ВсеПодразделения", ВсеПодразделения);
	Запрос.УстановитьПараметр("СтатусЗадачаЗавершена", Перечисления.упоСостояниеСтатусаЗадачи.Завершена);
	Запрос.УстановитьПараметр("СтатусЗадачаЗакрыта", Перечисления.упоСостояниеСтатусаЗадачи.Закрыта);
	Запрос.УстановитьПараметр("СтатусПроектаЗавершен", Перечисления.упоСостояниеСтатусаПроекта.Завершен);
	Запрос.УстановитьПараметр("ИсключатьЗадачиСПодчиненнымиПроектами", Объект.ИсключатьЗадачиСПодчиненнымиПроектами);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ПрофильПересчетаТрудозатрат", 
							Константы.упоПрофильПересчетаТрудозатратПоУмолчанию.Получить());

	Запрос.Текст = ТекстЗапросаДанныеОбъектаИзБД();
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ИндексПоследнего = РезультатЗапроса.Количество() - 1;

	ТаблицаТрудозатратПроект = РезультатЗапроса[ИндексПоследнего - 1].Выгрузить();
	Объект.Данные.Загрузить(ТаблицаТрудозатратПроект);
	
	ТаблицаПериода = РезультатЗапроса[ИндексПоследнего].Выгрузить();
	ИспользуетсяТрансляцияТрудозатрат = ТаблицаПериода.Итог("ТрудозатратыТрансляция") <> 0;
	Объект.РаспределениеПоПериоду.Загрузить(ТаблицаПериода);

	// Мощность.
	ЗагрузитьМощностьРолейВОбъект(ТаблицаТрудозатратПроект, Объект);

	ЗаполнениеПоКомандеЗаполнить = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМощностьРолейВОбъект(ТаблицаТрудозатратПроект, Объект)
	
	ТаблицаРолейПодразделение = ТаблицаТрудозатратПроект.Скопировать(, "Роль, Подразделение");
	ТаблицаРолейПодразделение.Свернуть("Роль, Подразделение");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаРолейПодразделение", ТаблицаРолейПодразделение);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода)); 
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаРолейПодразделение.Роль КАК Роль,
	               |	ТаблицаРолейПодразделение.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ТаблицаРолейПодразделение
	               |ИЗ
	               |	&ТаблицаРолейПодразделение КАК ТаблицаРолейПодразделение
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Роль,
	               |	Подразделение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоМощностьРесурсов.Ресурс КАК Роль,
	               |	упоМощностьРесурсов.Подразделение КАК Подразделение,
	               |	упоМощностьРесурсов.Календарь КАК Календарь,
	               |	упоМощностьРесурсов.Период КАК Период
	               |ПОМЕСТИТЬ ТаблицаРолей
	               |ИЗ
	               |	РегистрСведений.упоМощностьРесурсов КАК упоМощностьРесурсов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаРолейПодразделение КАК ТаблицаРолейПодразделение
	               |		ПО упоМощностьРесурсов.Ресурс = ТаблицаРолейПодразделение.Роль
	               |			И упоМощностьРесурсов.Подразделение = ТаблицаРолейПодразделение.Подразделение
	               |ГДЕ
	               |	упоМощностьРесурсов.Период >= &НачалоПериода
	               |	И упоМощностьРесурсов.Период <= &КонецПериода
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	упоМощностьРесурсовСрезПоследних.Ресурс,
	               |	упоМощностьРесурсовСрезПоследних.Подразделение,
	               |	упоМощностьРесурсовСрезПоследних.Календарь,
	               |	упоМощностьРесурсовСрезПоследних.Период
	               |ИЗ
	               |	РегистрСведений.упоМощностьРесурсов.СрезПоследних(
	               |			&НачалоПериода,
	               |			(Ресурс, Подразделение) В
	               |				(ВЫБРАТЬ
	               |					ТаблицаРолейПодразделение.Роль,
	               |					ТаблицаРолейПодразделение.Подразделение
	               |				ИЗ
	               |					ТаблицаРолейПодразделение)) КАК упоМощностьРесурсовСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоРабочиеКалендариСрезПоследних.КоличествоЧасов КАК КоличествоЧасов,
	               |	упоРабочиеКалендариСрезПоследних.Календарь КАК Календарь,
	               |	упоРабочиеКалендариСрезПоследних.День КАК День
	               |ПОМЕСТИТЬ Календари
	               |ИЗ
	               |	РегистрСведений.упоРабочиеКалендари.СрезПоследних(
	               |			,
	               |			Календарь В
	               |					(ВЫБРАТЬ
	               |						ТаблицаРолей.Календарь
	               |					ИЗ
	               |						ТаблицаРолей)
	               |				И День >= &НачалоПериода
	               |				И День <= &КонецПериода) КАК упоРабочиеКалендариСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоМощностьРесурсов.Ресурс КАК Роль,
	               |	упоМощностьРесурсов.Подразделение КАК Подразделение,
	               |	упоМощностьРесурсов.Календарь КАК Календарь,
	               |	упоМощностьРесурсов.Мощность КАК Мощность,
	               |	МАКСИМУМ(упоМощностьРесурсов.Период) КАК Период,
	               |	Календари.День КАК День,
	               |	Календари.КоличествоЧасов КАК КоличествоЧасов
	               |ПОМЕСТИТЬ МощностьРолей
	               |ИЗ
	               |	РегистрСведений.упоМощностьРесурсов КАК упоМощностьРесурсов
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Календари КАК Календари
	               |		ПО упоМощностьРесурсов.Период <= Календари.День
	               |			И упоМощностьРесурсов.Календарь = Календари.Календарь
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаРолей КАК ТаблицаРолей
	               |		ПО (ТаблицаРолей.Роль = упоМощностьРесурсов.Ресурс)
	               |			И (ТаблицаРолей.Подразделение = упоМощностьРесурсов.Подразделение)
	               |			И (ТаблицаРолей.Календарь = упоМощностьРесурсов.Календарь)
	               |			И (ТаблицаРолей.Период = упоМощностьРесурсов.Период)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоМощностьРесурсов.Ресурс,
	               |	упоМощностьРесурсов.Подразделение,
	               |	упоМощностьРесурсов.Календарь,
	               |	упоМощностьРесурсов.Мощность,
	               |	Календари.День,
	               |	Календари.КоличествоЧасов
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МощностьРолей.Роль КАК Роль,
	               |	МощностьРолей.Подразделение КАК Подразделение,
	               |	МАКСИМУМ(МощностьРолей.Период) КАК Период,
	               |	МощностьРолей.День КАК День
	               |ПОМЕСТИТЬ РолиСПериодами
	               |ИЗ
	               |	МощностьРолей КАК МощностьРолей
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	МощностьРолей.Роль,
	               |	МощностьРолей.Подразделение,
	               |	МощностьРолей.День
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	РолиСпериодами.Роль КАК Роль,
	               |	РолиСпериодами.Подразделение КАК Подразделение,
	               |	МощностьРолей.Календарь КАК Календарь,
	               |	РолиСпериодами.День КАК День,
	               |	РолиСпериодами.Период КАК Период,
	               |	МощностьРолей.КоличествоЧасов КАК КоличествоЧасов,
	               |	МощностьРолей.Мощность КАК Мощность
	               |ПОМЕСТИТЬ МощностьПоДням
	               |ИЗ
	               |	РолиСПериодами КАК РолиСпериодами
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МощностьРолей КАК МощностьРолей
	               |		ПО РолиСпериодами.Роль = МощностьРолей.Роль
	               |			И РолиСпериодами.Подразделение = МощностьРолей.Подразделение
	               |			И РолиСпериодами.День = МощностьРолей.День
	               |			И РолиСпериодами.Период = МощностьРолей.Период
	               |ГДЕ
	               |	МощностьРолей.КоличествоЧасов > 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МощностьПоДням.Роль КАК Роль,
	               |	МощностьПоДням.Подразделение КАК Подразделение,
	               |	МощностьПоДням.Календарь КАК Календарь,
	               |	СУММА(МощностьПоДням.КоличествоЧасов * МощностьПоДням.Мощность) КАК Мощность,
	               |	НАЧАЛОПЕРИОДА(МощностьПоДням.День, МЕСЯЦ) КАК Дата
	               |ИЗ
	               |	МощностьПоДням КАК МощностьПоДням
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НАЧАЛОПЕРИОДА(МощностьПоДням.День, МЕСЯЦ),
	               |	МощностьПоДням.Подразделение,
	               |	МощностьПоДням.Календарь,
	               |	МощностьПоДням.Роль
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Роль,
	               |	Дата";
	
	ТаблицаМощности = Запрос.Выполнить().Выгрузить();
	Объект.Мощности.Загрузить(ТаблицаМощности);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГруппировокСервер() 
	
	ЗагрузитьДанныеОбъектаИзФормы();
	ЗагрузитьДанныеФормыИзОбъекта();
	АдаптироватьЭлементы(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеОбъектаИзФормы(тОбъект = Неопределено, ТолькоШапку = Ложь) 

	Если тОбъект = Неопределено Тогда
		тОбъект = Объект;
	КонецЕсли;
	
	ЗагрузитьОтборыИзФормы(тОбъект);

	тОбъект.НачалоПериода = НачалоПериодаНаФорме;
	тОбъект.КонецПериода = КонецПериодаНаФорме;

	тОбъект.УровеньПланированияРолей = УровеньПланированияНаФорме;

	Если ТолькоШапку Тогда
		Возврат;	
	КонецЕсли;
	
	тОбъект.РаспределениеПоПериоду.Очистить();
	тОбъект.Данные.Очистить();
	
	СтрокиНижнегоУровня = ПолучитьСтрокиНижнегоУровня(ДеревоФормы, , Истина);
	
	Для Каждого СтрокаДерева Из СтрокиНижнегоУровня Цикл
		СтрокаДанных = тОбъект.Данные.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанных, СтрокаДерева);
		Для Каждого СтрокаКолонки Из КолонкиДат Цикл
			Если ЗначениеЗаполнено(СтрокаДерева[СтрокаКолонки.ИмяКолонки]) Тогда
				СтрокаРаспределения = тОбъект.РаспределениеПоПериоду.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, СтрокаДерева);
				СтрокаРаспределения.Дата 					= СтрокаКолонки.Дата;
				СтрокаРаспределения.Трудозатраты 			= СтрокаДерева[СтрокаКолонки.ИмяКолонки];
				СтрокаРаспределения.ТрудозатратыТрансляция	= СтрокаДерева[СтрокаКолонки.ИмяКолонки + "Трансляция"];
				СтрокаРаспределения.РучноеРедактирование 	= СтрокаДерева[СтрокаКолонки.ИмяКолонки + "РучноеРедактирование"];
				СтрокаРаспределения.ТрудозатратыТекущийПлан = СтрокаДерева[СтрокаКолонки.ИмяКолонки + "ТекущийПлан"];
				СтрокаРаспределения.ТрудозатратыТекущийПланТрансляция = СтрокаДерева[СтрокаКолонки.ИмяКолонки + "ТекущийПланТрансляция"];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	

КонецПроцедуры

&НаСервере
Функция ПолучитьСтрокиНижнегоУровня(Дерево, МассивСтрокНижнегоУровня = Неопределено, ТолькоНайтиСтроки = Ложь) 
	
	Если МассивСтрокНижнегоУровня = Неопределено Тогда
		МассивСтрокНижнегоУровня = Новый Массив;
		Если НЕ ТолькоНайтиСтроки Тогда
			мКэшЗначений.СтрокиПЗ_НижнийУровень.Очистить();
			мКэшЗначений.СтрокиПЗ_УровеньПЗ.Очистить();
			мКэшЗначений.СтрокиРесурса_НижнийУровень.Очистить();
		КонецЕсли;
	КонецЕсли;
	ЭлементыДерева = Дерево.ПолучитьЭлементы();
	Если НЕ ТолькоНайтиСтроки И ТипЗнч(Дерево) <> Тип("ДанныеФормыДерево") Тогда
		Если Дерево.ИмяГруппировки = "ПроектнаяЗадачаЗеркало" Тогда	
			МассивСтрокПЗ = мКэшЗначений.СтрокиПЗ_УровеньПЗ.Получить(Дерево.ПроектнаяЗадачаЗеркало);
			Если МассивСтрокПЗ = Неопределено Тогда
				МассивСтрокПЗ = Новый Массив;
			КонецЕсли;
			МассивСтрокПЗ.Добавить(Дерево.ПолучитьИдентификатор()); 
			мКэшЗначений.СтрокиПЗ_УровеньПЗ.Вставить(Дерево.ПроектнаяЗадачаЗеркало, МассивСтрокПЗ);		
		КонецЕсли;
	КонецЕсли;	
	Если ЭлементыДерева.Количество() = 0 Тогда
		Если ТипЗнч(Дерево) <> Тип("ДанныеФормыДерево") Тогда
			МассивСтрокНижнегоУровня.Добавить(Дерево);	
			
			Если НЕ ТолькоНайтиСтроки Тогда
			
				МассивСтрокПЗ = мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(Дерево.ПроектнаяЗадачаЗеркало);
				Если МассивСтрокПЗ = Неопределено Тогда
					МассивСтрокПЗ = Новый Массив;
				КонецЕсли;
				МассивСтрокПЗ.Добавить(Дерево.ПолучитьИдентификатор()); 
				мКэшЗначений.СтрокиПЗ_НижнийУровень.Вставить(Дерево.ПроектнаяЗадачаЗеркало, МассивСтрокПЗ);
				
				Если ЗначениеЗаполнено(Дерево.Роль) Тогда
					МассивСтрокРесурса = мКэшЗначений.СтрокиРесурса_НижнийУровень.Получить(Дерево.Роль);
					Если МассивСтрокРесурса = Неопределено Тогда
						МассивСтрокРесурса = Новый Массив;
					КонецЕсли;
					МассивСтрокРесурса.Добавить(Дерево.ПолучитьИдентификатор()); 
					мКэшЗначений.СтрокиРесурса_НижнийУровень.Вставить(Дерево.Роль, МассивСтрокРесурса);
				КонецЕсли;
				
			КонецЕсли;

		КонецЕсли;
	Иначе
		Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
			ПолучитьСтрокиНижнегоУровня(ЭлементДерева, МассивСтрокНижнегоУровня, ТолькоНайтиСтроки);	
		КонецЦикла;
	КонецЕсли;

	Возврат МассивСтрокНижнегоУровня;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура АдаптироватьЭлементы(ЭтаФорма) 
	
	Если ЭтаФорма.Объект.ПорядокГруппировок = 
		ПредопределенноеЗначение("Перечисление.упоПорядокГруппировокПрогнозированиеТрудозатрат.РольПодразделениеПроектЗадача") 
		Тогда
		ЭтаФорма.Элементы.ДеревоФормыГруппа1.Заголовок = 
			НСтр("ru = 'Роль / Подразделение / Проект / Задача'");
	Иначе
		ЭтаФорма.Элементы.ДеревоФормыГруппа1.Заголовок = 
			НСтр("ru = 'Проект / Задача / Роль / Подразделение'");
	КонецЕсли;
	ЭтаФорма.Элементы.ФормаКомандаПоказатьДиаграмму.Пометка = ЭтаФорма.Объект.ПоказатьДиаграмму;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФильтров(Заполнение = Ложь, ЗадаватьВопрос = Ложь) 

	Если ЗадаватьВопрос И ЗначениеЗаполнено(ДеревоФормы.ПолучитьЭлементы()) Тогда        
		ОписаниеОповещенияВопросОчисткиТаблицыЗавершение = Новый ОписаниеОповещения("ВопросОчисткиТаблицыЗавершение", 
																									ЭтаФорма, Заполнение);
		ТекстВопроса = НСтр("ru = 'Данные таблицы будут очищены. Продолжить?'");	
		ПоказатьВопрос(ОписаниеОповещенияВопросОчисткиТаблицыЗавершение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);		
	Иначе
		ВопросОчисткиТаблицыЗавершение(КодВозвратаДиалога.Да, Заполнение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросОчисткиТаблицыЗавершение(РезультатВопроса, Заполнение) Экспорт 

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьИзБазыКлиент(Заполнение);		
	ИначеЕсли НЕ Заполнение Тогда
		ЗагрузитьДанныеФормыИзОбъекта(Истина);	
	КонецЕсли;

	упоРаботаСФормамиКлиентСервер.НастройкаПрогнозаПоУровнюПланирования(ЭтаФорма, ЭтаФорма.УровеньПланированияНаФорме);
	упоРаботаСФормамиКлиентСервер.НастройкаПрогнозаПоПроцентуГотовности(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзБазыКлиент(Заполнение = Ложь) 
	
	Если НЕ ПроверитьЗаполнение() ИЛИ НЕ Заполнение Тогда
		ОчиститьДанные();
		Возврат;
	КонецЕсли;

	ЗаполнитьСервер();
	ОбновитьСоответствиеУровнейДерева();
	РазвернутьДерево();			

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДанные() 
	
	ДеревоФормы.ПолучитьЭлементы().Очистить();
	Диаграмма.Очистить();
	ОчиститьИтоги(ЭтаФорма);
	Для Каждого СтрокаКолонок Из КолонкиДат Цикл
		Элементы[СтрокаКолонок.ИмяКолонки].Видимость = Ложь;
	КонецЦикла;
	мКэшЗначений.СтрокиПЗ_НижнийУровень.Очистить();
	мКэшЗначений.СтрокиПЗ_УровеньПЗ.Очистить();
	мКэшЗначений.СтрокиРесурса_НижнийУровень.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакЗаписи(Признак, Строки = Неопределено) 
	
	Если Строки = Неопределено Тогда
		Строки = ДеревоФормы.ПолучитьЭлементы();
	КонецЕсли;
	ЭтоНижнегоУровняЭлементы = Неопределено;
	Для Каждого Строка Из Строки Цикл 
		СтрокиПодч = Строка.ПолучитьЭлементы();
		Если ЭтоНижнегоУровняЭлементы = Неопределено Тогда
			ЭтоНижнегоУровняЭлементы = СтрокиПодч.Количество() = 0;	
		КонецЕсли;		
		Если ЭтоНижнегоУровняЭлементы Тогда
			Если МожноРедактироватьСтроку(Строка) Тогда			
				Строка.Записывать = Признак;
			КонецЕсли;
			Если ИспользуетсяТрансляцияТрудозатрат И Строка.ТекущийПлан > 0 Тогда
				Строка.Записывать = Ложь;
			КонецЕсли;
		Иначе
			УстановитьПризнакЗаписи(Признак, СтрокиПодч);
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт

	Если Период <> Неопределено Тогда
		
		НачалоПериодаНаФорме = НачалоМесяца(Период.ДатаНачала);
		КонецПериодаНаФорме = ?(ЗначениеЗаполнено(Период.ДатаОкончания), 
								КонецМесяца(Период.ДатаОкончания), 
								Период.ДатаОкончания);	
		
		УстановитьЗаголовокВыбораПериода(ЭтаФорма);
		
		ПриИзмененииФильтров();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокВыбораПериода(ЭтаФорма)

	ЭтаФорма.Элементы.ФормаВыбратьПериод.Заголовок = НСтр("ru = 'Период с'") + " "  
										+ Формат(ЭтаФорма.НачалоПериодаНаФорме, "ДФ='MMMM yyyy ""г"".'")  
										+  " " + НСтр("ru = 'по'") + " " 
										+ Формат(ЭтаФорма.КонецПериодаНаФорме, "ДФ='MMMM yyyy ""г"".'");
										
	// Отчетный период.									
	ПериодФ = ДобавитьМесяц(ЭтаФорма.НачалоПериодаНаФорме, - 1);
	СтандартныйПериодМесяц = Новый СтандартныйПериод;
	СтандартныйПериодМесяц.ДатаНачала = ПериодФ;

	ЭтаФорма.ОтчетныйПериод = упоФункцииБСПКлиентСервер.ПредставлениеСтандартногоПериода(СтандартныйПериодМесяц, 
		ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"));
		
	ЭтаФорма.Элементы.ДеревоФормыФактОтчетногоПериода.Заголовок 		= Формат(ПериодФ, "ДФ='MMM yy'");									
	ЭтаФорма.Элементы.ДеревоФормыТекущийПланОтчетногоПериода.Заголовок 	= Формат(ПериодФ, "ДФ='MMM yy'");									
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДоступностьЭлементов(ЭтаФорма)

	упоРаботаСФормамиКлиентСервер.ВидимостьЭлемента(ЭтаФорма.Элементы.ГруппаДиаграмма, 
													ЭтаФорма.Объект.ПоказатьДиаграмму);	
	упоРаботаСФормамиКлиентСервер.ВидимостьЭлемента(ЭтаФорма.Элементы.ГруппаЛегенда, 
													ЭтаФорма.Элементы.ДеревоФормыПоказатьЛегенду.Пометка);	

КонецПроцедуры

&НаКлиенте
Процедура ДеревоФормыНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)	
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.ДеревоФормы.ТекущиеДанные;
	Если ТекСтрока.ЗадачаЗавершена Или ТекСтрока.ЗадачаЗакрыта Или Не ТекСтрока.ТекПользовательЯвляетсяРПЗИлиРП Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитовДереваФормы = ИменаРеквизитовДереваФормы();
	
	ИмяКолонки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, "ДеревоФормы", "");
	Если ТекСтрока = Неопределено Или ТипЗнч(ТекСтрока[ИмяКолонки]) <> Тип("Число") Тогда
		Выполнение = Ложь;
	Иначе
		Если ИменаРеквизитовДереваФормы.Найти(ИмяКолонки + "Трансляция") <> Неопределено
			И ТекСтрока[ИмяКолонки + "Трансляция"] > 0 Тогда
			Выполнение = Ложь;
			Возврат;
		КонецЕсли;
		
		ИдСтроки = ТекСтрока.ПолучитьИдентификатор();
		ПараметрыПеретаскивания.Значение.Очистить();
		ПараметрыПеретаскивания.Значение.Добавить("Перетаскивание" + ЭтаФорма.УникальныйИдентификатор);
		ПараметрыПеретаскивания.Значение.Добавить(ИдСтроки);
		ПараметрыПеретаскивания.Значение.Добавить(ИмяКолонки);
	КонецЕсли;    
	
КонецПроцедуры

&НаКлиенте
Процедура СдвинутьНаПериод(Вперед = Истина)
	
	ПоследовательностьКолонок = ПолучитьПоследовательностьКолонок(Вперед);
	
	МассивВыделенныхСтрок = ПолучитьМассивВыделенныхСтрокНижнегоУровня();
	Для Каждого ВыделеннаяСтрока Из МассивВыделенныхСтрок Цикл
		сч = ПоследовательностьКолонок.Количество() - 1;
		Пока сч >= 1 Цикл
			ТекКолонка = ПоследовательностьКолонок[сч];
			ПредКолонка = ПоследовательностьКолонок[сч - 1];
			Если ВыделеннаяСтрока[ПредКолонка] <> 0 Тогда
				УстановитьТрудозатраты(ЭтаФорма,
					ВыделеннаяСтрока,
					ТекКолонка,
					ВыделеннаяСтрока[ТекКолонка] + ВыделеннаяСтрока[ПредКолонка],
					,
					,
					,
					ВыделеннаяСтрока[ПредКолонка + "РучноеРедактирование"]);
				УстановитьТрудозатраты(ЭтаФорма, ВыделеннаяСтрока, ПредКолонка, 0);
				
				Если ИспользуетсяТрансляцияТрудозатрат Тогда
					Попытка
						ШаблонКолонкиДанныеСТрансляцией = НСтр("ru = '%1 (ТТ %2)'");
						ВыделеннаяСтрока[ТекКолонка + "СТрансляцией"] = СтрШаблон(ШаблонКолонкиДанныеСТрансляцией,
								ВыделеннаяСтрока[ТекКолонка] + ВыделеннаяСтрока[ТекКолонка + "Трансляция"],
								ВыделеннаяСтрока[ТекКолонка + "Трансляция"]);
					Исключение
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
			сч = сч - 1;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПоследовательностьКолонок(Вперед = Истина, БезОстаткаДоЗавершения = Ложь) 
	
	ПоследовательностьКолонок = Новый Массив;
	
	Если Вперед Тогда
		Для Каждого СтрокаКолонок Из КолонкиДат Цикл
			ПоследовательностьКолонок.Добавить(СтрокаКолонок.ИмяКолонки);
		КонецЦикла;
		ПоследовательностьКолонок.Добавить("ОстатокДоЗавершения");
	Иначе
		ПоследовательностьКолонок.Добавить("ОстатокДоЗавершения");
		сч = КолонкиДат.Количество() - 1;
		Пока сч >= 0 Цикл
			ПоследовательностьКолонок.Добавить(КолонкиДат[сч].ИмяКолонки);	
			сч = сч - 1;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПоследовательностьКолонок;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыВыбораРолей(ЭлементСписокРолей, СписокПодразделений)

	ЭлементСписокРолей.ПараметрыВыбора = ПодготовитьПараметрыВыбораРолейСервер(СписокПодразделений);		 
	
КонецПроцедуры		

&НаСервереБезКонтекста
Функция ПодготовитьПараметрыВыбораРолейСервер(СписокПодразделений)

	мПараметрыВыбора = Новый Массив;

	Если СписокПодразделений.Количество() Тогда
		Отбор = Новый Структура;
		// Открытие списка через обработчик ОбработкаПолученияДанныхВыбора.	
		Отбор.Вставить("ПодразделенияРолей", СписокПодразделений);
		// Открытие списка без обработчика ОбработкаПолученияДанныхВыбора.	
		Отбор.Вставить("Ссылка", Справочники.упоРоли.РолиПодразделений(СписокПодразделений));
			
		мПараметрыВыбора = Новый Массив;
		мПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор", Отбор));
	КонецЕсли;	
			
	Возврат Новый ФиксированныйМассив(мПараметрыВыбора);

КонецФункции

