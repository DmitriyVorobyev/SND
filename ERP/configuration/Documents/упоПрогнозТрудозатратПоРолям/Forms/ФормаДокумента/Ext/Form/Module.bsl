&НаКлиенте
Процедура РольДиаграммыПоРолиАвтоПодбор(Элемент, 
										Текст, 
										ДанныеВыбора, 
										ПараметрыПолученияДанных, 
										Ожидание, 
										СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	МассивЭлементовОтбора = Новый Массив;

	СтрокиРесурса_НижнийУровень = ЭтаФорма.мКэшЗначений.СтрокиРесурса_НижнийУровень;

	Для Каждого СтрокаСоответствия Из СтрокиРесурса_НижнийУровень Цикл
		МассивЭлементовОтбора.Добавить(СтрокаСоответствия.Ключ);	
	КонецЦикла; 

	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Отбор", Новый Структура("ОтборПоРолям", МассивЭлементовОтбора));
	СтруктураОтбора.Вставить("СтрокаПоиска", Текст);	

	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("СправочникСсылка.упоРоли"), СтруктураОтбора);

