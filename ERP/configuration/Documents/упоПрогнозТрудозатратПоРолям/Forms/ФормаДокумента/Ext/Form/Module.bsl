	Возврат ИменаКолонокДерева;
	
КонецФункции

#Область РасчетТрудозатратПоПрофилям

&НаКлиенте
Процедура ПеренестиОтклонениеНаСледующийМесяц(ТекСтрока, ИмяКолонки = "ФактОтчетногоПериода")
	
	ПереносНаСледующуюКолонку = Ложь;
	
	СуммаПереносаДоПериода = ТекСтрока.ТрудозатратыДоНачалаПериода
		- ТекСтрока.ТрудозатратыДоНачалаПериодаТрансляция
		- (ТекСтрока.ФактДоОтчетногоПериода + ТекСтрока.ФактОтчетногоПериода);
	
	Если ИмяКолонки = "ФактОтчетногоПериода" Тогда
		Если СуммаПереносаДоПериода = 0 Тогда
			Возврат;
		КонецЕсли;
		ПереносНаСледующуюКолонку = Истина;
		СуммаПереноса = СуммаПереносаДоПериода;
	КонецЕсли;
	
	СуммаТекущийПлан = 0;
	СуммаПланДокумента = 0;
	
	ПереносВПериодеЗавершен = Ложь;
	
	// Период документа.
	
	Для Каждого СтрокаКолонки Из КолонкиДат Цикл
		
		СуммаТекущийПлан = СуммаТекущийПлан + ТекСтрока[СтрокаКолонки.ИмяКолонки + "ТекущийПлан"]
			- ТекСтрока[СтрокаКолонки.ИмяКолонки + "ТекущийПланТрансляция"];
		
		Если Не ПереносВПериодеЗавершен Тогда
			
			Если ПереносНаСледующуюКолонку Тогда
				
				СуммаПереноса = ПроверитьУстановитьТрудозатратыВКолонкеБезРасчетаИтогов(ТекСтрока,
						СтрокаКолонки.ИмяКолонки,
						СуммаПереноса);
				Если СуммаПереноса = 0 Тогда
					ПереносВПериодеЗавершен = Истина;
				КонецЕсли;
				
			Иначе
				
				СуммаПереноса = СуммаПереносаДоПериода +
					(СуммаТекущийПлан - (СуммаПланДокумента + ТекСтрока[СтрокаКолонки.ИмяКолонки]));
				
				Если СтрокаКолонки.ИмяКолонки = ИмяКолонки Тогда
					ПереносНаСледующуюКолонку = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		СуммаПланДокумента = СуммаПланДокумента + ТекСтрока[СтрокаКолонки.ИмяКолонки];
		
		ЭтоКолонкаПериод = Истина;
		ПосчитатьДанныеКолонкиСТрансляцией(ТекСтрока, СтрокаКолонки.ИмяКолонки, ИспользуетсяТрансляцияТрудозатрат, ЭтоКолонкаПериод);
		
	КонецЦикла;
	
	// Остаток до завершения.
	
	Если Не ТекСтрока["ОстатокДоЗавершенияРучноеРедактирование"] Тогда
		
		ОстатокДоЗавершения = ТекСтрока.ТекущийПлан - ТекСтрока.ТекущийПланТрансляция -
			(ТекСтрока.ТекущийПланДоОтчетногоПериода + ТекСтрока.ФактОтчетногоПериода + СуммаПланДокумента);
		Если ОстатокДоЗавершения < 0 Тогда
			ОстатокДоЗавершения = 0;
		КонецЕсли;
		
		УстановитьТрудозатраты(ЭтаФорма,
			ТекСтрока,
			"ОстатокДоЗавершения",
			ОстатокДоЗавершения,
			Ложь,
			Ложь,
			Ложь);
	КонецЕсли;
	
	// Итоги по строке.
	
	СчитатьВычисляемыеИтогиСтрокиСОбновлениемРодителей(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьОтклонениеРавномерноВПериодеЗадачи(ТекСтрока, Знач ИмяКолонки = "")

	ПараметрыРаспределения = ПараметрыРаспределенияТрудозатратВПериоде(ТекСтрока, ИмяКолонки);	
		
	ОстатокКРаспределению = ТекСтрока.ТекущийПлан - ТекСтрока.ТекущийПланТрансляция 
		 - (ТекСтрока.ФактДоОтчетногоПериода + ТекСтрока.ФактОтчетногоПериода)
		 - ПараметрыРаспределения.НераспределяемаяСумма;
		 
	РаспределитьСуммуПоБазеРаспределенияТрудозатрат(ТекСтрока, ПараметрыРаспределения, ОстатокКРаспределению);
 		 
КонецПроцедуры	

&НаКлиенте
Процедура РаспределитьОтклонениеРавномерноВПериодеДокумента() 
	
	МассивВыделенныхСтрок = ПолучитьМассивВыделенныхСтрокНижнегоУровня();
		
	Для Каждого ТекСтрока Из МассивВыделенныхСтрок Цикл       				
		
		СуммаКРаспределению = ТекСтрока.ПланМинусФактИПрогноз;
		Если СуммаКРаспределению = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		ПараметрыРаспределения = ПараметрыРаспределенияТрудозатратВПериоде(ТекСтрока);								 							
		ПараметрыРаспределения.СохранятьВведенныеЗначения = Истина;
		
		РаспределитьСуммуПоБазеРаспределенияТрудозатрат(ТекСтрока, ПараметрыРаспределения, СуммаКРаспределению);
						
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Функция ПараметрыРаспределенияТрудозатратВПериоде(ТекСтрока, ИмяКолонки = "")
		
	// Часть базы в периоде документа. 
	БазаРаспределенияВПериоде = Новый Массив;	

	НераспределяемаяСумма = 0;
	// Если редактируется не колонка периода, то включаем в базу все колонки периода, 
	// иначе - только те, что справа (более поздних периодов).	
	ФормироватьБазу = Не ЗначениеЗаполнено(ИмяКолонки) Или ИмяКолонки = "ФактОтчетногоПериода";	

	НачалоРасчета = Макс(ТекСтрока.ДатаНачалаТП, Объект.НачалоПериода);
	Если Не ФормироватьБазу Тогда
		КоллекцияСтрокКолонок = КолонкиДат.НайтиСтроки(Новый Структура("ИмяКолонки", ИмяКолонки));
		Если КоллекцияСтрокКолонок.Количество() Тогда
			НачалоРасчета = Макс(НачалоРасчета, ДобавитьМесяц(КоллекцияСтрокКолонок[0].Дата, 1));	
		КонецЕсли;	
	КонецЕсли;

	ЯчейкаДоПериодаЗадачи = Ложь;
	ЯчейкаПослеПериодаЗадачи = Ложь;
	Для Каждого СтрокаКолонки Из КолонкиДат Цикл											
								
		ЯчейкаДоПериодаЗадачи = ТекСтрока.ДатаНачалаТП > КонецМесяца(СтрокаКолонки.Дата);
		Если Не ЯчейкаДоПериодаЗадачи И Не ЯчейкаПослеПериодаЗадачи Тогда
			ЯчейкаПослеПериодаЗадачи = ТекСтрока.ДатаЗавершенияТП < СтрокаКолонки.Дата;
		КонецЕсли;	
		// Если до или после периода ПЗ в ячейку введена сумма, то период ячейки в базу распределения периодов не попадет, 
		// но введенная сумма должна быть учтена как нераспределяемая.								
		Если ЯчейкаДоПериодаЗадачи Или ЯчейкаПослеПериодаЗадачи Тогда
			НераспределяемаяСумма = НераспределяемаяСумма + ТекСтрока[СтрокаКолонки.ИмяКолонки];
			Продолжить;
		КонецЕсли;									
		
		Если ФормироватьБазу Тогда
			БазаРаспределенияВПериоде.Добавить(СтрокаКолонки.ИмяКолонки);	
		Иначе
			НераспределяемаяСумма = НераспределяемаяСумма + ТекСтрока[СтрокаКолонки.ИмяКолонки];
			Если СтрокаКолонки.ИмяКолонки = ИмяКолонки Тогда
				ФормироватьБазу = Истина;	
			КонецЕсли;
		КонецЕсли;	
												
	КонецЦикла;

	ПараметрыРаспределения = Новый Структура;	
	ПараметрыРаспределения.Вставить("БазаРаспределения", БазаРаспределенияВПериоде);
	ПараметрыРаспределения.Вставить("НачалоРасчета", НачалоРасчета);
	ПараметрыРаспределения.Вставить("НераспределяемаяСумма", НераспределяемаяСумма);
	ПараметрыРаспределения.Вставить("СохранятьВведенныеЗначения", Ложь);

	Возврат ПараметрыРаспределения;

КонецФункции	

&НаКлиенте
Процедура РаспределитьСуммуПоБазеРаспределенияТрудозатрат(ТекСтрока, ПараметрыРаспределения, Знач СуммаКРаспределению)
	
	БазаРаспределенияВПериоде = ПараметрыРаспределения.БазаРаспределения;
	НачалоРасчета = ПараметрыРаспределения.НачалоРасчета;
	СохранятьВведенныеЗначения = ПараметрыРаспределения.СохранятьВведенныеЗначения;
	
	ОбнулитьПлан = СуммаКРаспределению <= 0;
	
	Если Не ОбнулитьПлан Тогда
		Результат = упоПланированиеТрудозатратВызовСервера.МассивТрудозатратРавномерноПоМесяцамВПериоде(
				НачалоРасчета,
				ТекСтрока.ДатаЗавершенияТП,
				ТекСтрока.Календарь,
				СуммаКРаспределению);
		мТрудозатраты = Результат.Трудозатраты;
	КонецЕсли;
	
	// Период документа.
	РаспределеннаяСумма = 0;
	Сч = 0;
	Для Каждого ИмяКолонки Из БазаРаспределенияВПериоде Цикл
		Если ОбнулитьПлан Тогда
			УстановитьТрудозатраты(ЭтаФорма, ТекСтрока, ИмяКолонки, 0, Ложь, Ложь, Ложь);
		Иначе
			КоличествоТрудозатрат = мТрудозатраты[Сч];
			Если СохранятьВведенныеЗначения Тогда
				КоличествоТрудозатрат = ТекСтрока[ИмяКолонки] + КоличествоТрудозатрат;
			КонецЕсли;
			
			УстановитьТрудозатраты(ЭтаФорма, ТекСтрока, ИмяКолонки, КоличествоТрудозатрат, Ложь, Ложь, Ложь);
			РаспределеннаяСумма = РаспределеннаяСумма + мТрудозатраты[Сч];
		КонецЕсли;
		
		ЭтоКолонкаПериод = Истина;
		ПосчитатьДанныеКолонкиСТрансляцией(ТекСтрока, ИмяКолонки, ИспользуетсяТрансляцияТрудозатрат, ЭтоКолонкаПериод);
		
		Сч = Сч + 1;
	КонецЦикла;
	
	// Остаток до завершения.
	Если Не ТекСтрока["ОстатокДоЗавершенияРучноеРедактирование"] Тогда
		
		НераспределеннаяСумма = СуммаКРаспределению - РаспределеннаяСумма;
		Если СохранятьВведенныеЗначения Тогда
			НераспределеннаяСумма = ТекСтрока["ОстатокДоЗавершения"] + НераспределеннаяСумма;
		КонецЕсли;
		Если НераспределеннаяСумма < 0 Тогда
			НераспределеннаяСумма = 0;
		КонецЕсли;
		УстановитьТрудозатраты(ЭтаФорма, ТекСтрока, "ОстатокДоЗавершения", НераспределеннаяСумма, Ложь, Ложь, Ложь);
		
	КонецЕсли;
	
	// Итоги по строке.
	
	СчитатьВычисляемыеИтогиСтрокиСОбновлениемРодителей(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуТрудозатратПоПрофилю(ТекДанные, Знач ИмяКолонки = "")

	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
							
	// Если по строке есть ручное распределение, то сохраняем его и делаем пересчет вправо, 
	// как при ручном редактировании колонки.
	Если ИмяКолонки = "" Тогда		
		ИмяКолонки = ПоследняяКолонкаСРучнымРаспределением(ТекДанные);			
	КонецЕсли;	
		
	Если ТекДанные.ПрофильПересчетаТрудозатрат =
			ПредопределенноеЗначение("Перечисление.упоПрофильПересчетаТрудозатрат.ОтклонениеРавномерноВПериодеЗадачи") Тогда
			
			РаспределитьОтклонениеРавномерноВПериодеЗадачи(ТекДанные, ИмяКолонки);
			
	ИначеЕсли ТекДанные.ПрофильПересчетаТрудозатрат = 
			ПредопределенноеЗначение("Перечисление.упоПрофильПересчетаТрудозатрат.ОтклонениеНаМесяцПослеПериодаДокумента") Тогда	
			
		Если ИмяКолонки = "" Тогда
			ИмяКолонки = "ФактОтчетногоПериода";
		КонецЕсли;	
		ПеренестиОтклонениеНаСледующийМесяц(ТекДанные, ИмяКолонки);
		
	Иначе
		
		Возврат;	
		
	КонецЕсли;		

	// Итоги.	
	ОбновитьИтогиДереваИДиаграмму(ЭтаФорма, ИмяКолонки);	

КонецПроцедуры

&НаКлиенте
Функция ПоследняяКолонкаСРучнымРаспределением(ТекДанные)

	ИмяКолонки = ""; 

	Сч = КолонкиДат.Количество() - 1;	
	Пока Сч >= 0 Цикл 	
		КолонкаДаты = КолонкиДат[Сч];
		Если ТекДанные[КолонкаДаты.ИмяКолонки + "РучноеРедактирование"] Тогда
			ИмяКолонки = КолонкаДаты.ИмяКолонки;
			Прервать;
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла;	

	Возврат ИмяКолонки;

КонецФункции	

&НаКлиенте
Процедура ПересчитатьСтрокиТрудозатратПоПрофилям(СтрокиТрудозатрат) 

	Для Каждого СтрокаТрудозатрат Из СтрокиТрудозатрат Цикл
		Если МожноРедактироватьСтроку(СтрокаТрудозатрат) Тогда
			ПересчитатьСтрокуТрудозатратПоПрофилю(СтрокаТрудозатрат);
		КонецЕсли;	
	КонецЦикла;	

КонецПроцедуры

#КонецОбласти

#Область ОтложенноеОтражениеТрудозатрат

// Вызывает фоновую процедуру отражения трудозатрат.
&НаКлиенте
Процедура ВыполнитьОтложенноеОтражениеТрудозатратКлиент()

	ТекстСостояния = НСтр("ru = 'Отражение 
								|плановых 
								|трудозатрат.'");
	Состояние(ТекстСостояния);					

	ПараметрыЗадания = Новый Структура("ПроектныеЗадачи", 
		ЗадачиДокумента(Объект));
		
	Задание = упоПланированиеТрудозатратВызовСервера.ЗапуститьФоновоеОтражениеДокументовКонтекстКлиента(		
		ПараметрыЗадания, 
		УникальныйИдентификатор);

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтаФорма);
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
	НастройкиОжидания.ТекстСообщения = ТекстСостояния;
		
	Обработчик = Новый ОписаниеОповещения("ПослеЗавершенияФоновогоЗадания", ЭтотОбъект, Параметры);

	ДлительныеОперацииКлиент.ОжидатьЗавершение(Задание, Обработчик, НастройкиОжидания);
	
КонецПроцедуры

// Принимает результат выполнения фонового задания.
&НаКлиенте
Процедура ПослеЗавершенияФоновогоЗадания(Задание, Параметры) Экспорт

	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Задание.Статус = "Выполнено" Тогда
			    																						
		ПроверитьОтложенныеТрудозатраты(ЭтаФорма);
		
	Иначе		

		СообщениеОбОшибке = Новый Массив;
		СообщениеОбОшибке.Добавить(НСтр("ru = 'Не удалось выполнить отражение документа.'"));
		СообщениеОбОшибке.Добавить(Задание.КраткоеПредставлениеОшибки);
		
		ТекстПредупреждения = СтрСоединить(СообщениеОбОшибке, Символы.ПС);
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);								
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗадачиДокумента(Объект)

	ПроектныеЗадачи = Новый Массив;
	Для Каждого СтрокаДанных Из Объект.Данные Цикл
		Если ПроектныеЗадачи.Найти(СтрокаДанных.ПроектнаяЗадачаЗеркало) = Неопределено Тогда
			ПроектныеЗадачи.Добавить(СтрокаДанных.ПроектнаяЗадачаЗеркало);
		КонецЕсли;				
	КонецЦикла;	

	Возврат ПроектныеЗадачи;

КонецФункции	

#КонецОбласти

#Область РасчетПроцентаГотовности

&НаКлиенте
Функция СтрокаСвойствЗаполненияДляПроцентаГотовности()
	
	Возврат "ДатаНачалаФакт, ДатаЗавершенияФакт, ЗадачаЗавершена,,
			|ПроцентГотовностиЗадачи, Статус";

КонецФункции

&НаКлиенте
Процедура РассчитатьПроцентГотовностиПоСтроке(СтрокаДанных)

	РасчетДоступен = СтрокаДанных <> Неопределено
		И ЗначениеЗаполнено(СтрокаДанных.ПроектнаяЗадачаЗеркало)
		И СтрокаДанных.ПроектВыполняется
		И МожноРедактироватьСтроку(СтрокаДанных);

	Если Не РасчетДоступен Тогда
		Возврат;
	КонецЕсли;	
				
	ПроцентГотовности = 0;		
	Если СтрокаДанных.ФактПлюсПрогноз > 0 Тогда
		Процент100 = 100;
		ПроцентГотовности = Процент100 * СтрокаДанных.Факт / СтрокаДанных.ФактПлюсПрогноз;
	КонецЕсли;						

	СтрокаДанных.ПроцентГотовности = ПроцентГотовности;	
	СтрокаДанных.ПроцентГотовностиРучноеРедактирование = Ложь;
		
	ПриИзмененииПроцентаГотовностиПоСтроке(СтрокаДанных);	

КонецПроцедуры 	

&НаКлиенте
Функция ПодготовитьДанныеРасчета(СтрокиРасчета)	
	
	Если ТипЗнч(СтрокиРасчета) <> Тип("Массив") Тогда			
		МассивСтрокРасчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокиРасчета);				
	Иначе
		МассивСтрокРасчета = СтрокиРасчета;
	КонецЕсли;				
	
	Возврат МассивСтрокРасчета;
	
КонецФункции

&НаКлиенте
Функция РазделитьСтрокиСРучнымИАвтоматическимРасчетом(МассивСтрокРасчета)

	СтрокиРучноеРедактирование = Новый Соответствие;
	СтрокиАвтоРасчет = Новый Соответствие;
	МассивТекстов = Новый Массив;
	МаксимальноеКоличествоЗадачВСообщении = 5;
	КоличествоЗадач = 0;
	
	Для Каждого СтрокаРасчета Из МассивСтрокРасчета Цикл		
		
		Если Не СтрокаРасчета.ПоследнийУровень Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СтрокаРасчета.ПроцентГотовностиРучноеРедактирование Тогда			
			
			Если КоличествоЗадач < МаксимальноеКоличествоЗадачВСообщении Тогда
				МассивТекстов.Добавить(" - " + СтрокаРасчета.ПроектнаяЗадачаЗеркало);			
			ИначеЕсли КоличествоЗадач = МаксимальноеКоличествоЗадачВСообщении Тогда
				МассивТекстов.Добавить("   ...  (и другие)");
			КонецЕсли;				
			
			СтрокиРучноеРедактирование.Вставить(СтрокаРасчета);
			
			КоличествоЗадач = КоличествоЗадач + 1;
		Иначе	
			СтрокиАвтоРасчет.Вставить(СтрокаРасчета);	
		КонецЕсли;	
				
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("СтрокиРучноеРедактирование", СтрокиРучноеРедактирование);
	Результат.Вставить("СтрокиАвтоРасчет", СтрокиАвтоРасчет);
	Результат.Вставить("МассивТекстов", МассивТекстов);
	
	Возврат Результат;
	
КонецФункции
 
&НаКлиенте
Процедура РассчитатьПроцентГотовностиСУведомлением(СтрокиРасчета)
	
	МассивСтрокРасчета = ПодготовитьДанныеРасчета(СтрокиРасчета);
	
	КоличествоСтрокРасчета = МассивСтрокРасчета.Количество();	
	Если КоличествоСтрокРасчета = 0 Тогда
		Возврат;
	КонецЕсли;	

	ОднаСтрокаРасчета = КоличествоСтрокРасчета = 1;
		
	Результат = РазделитьСтрокиСРучнымИАвтоматическимРасчетом(МассивСтрокРасчета);
	
	СтрокиРучноеРедактирование = Результат.СтрокиРучноеРедактирование;
	СтрокиАвтоРасчет = Результат.СтрокиАвтоРасчет;
	МассивТекстов = Результат.МассивТекстов;
			
	Если СтрокиРучноеРедактирование.Количество() Тогда
		
		Если ОднаСтрокаРасчета Тогда
			ТекстВопроса = НСтр("ru = 'Для следующей проектной задачи процент готовности введен 
								|вручную. Обновить ручной процент готовности?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Для следующих проектных задач процент готовности введен 
								|вручную. Обновить ручные проценты готовности?'");
		КонецЕсли;
		
		МассивТекстов.Вставить(0, ТекстВопроса);
		ТекстВопроса = СтрСоединить(МассивТекстов, Символы.ПС);
		
		ДопПараметры = Новый Структура("СтрокиАвтоРасчет, СтрокиРучноеРедактирование", 
										СтрокиАвтоРасчет, СтрокиРучноеРедактирование); 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("РассчитатьПроцентГотовностиЗавершение", ЭтаФорма, ДопПараметры);
																												
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		
	Иначе			
		
		ПроектыНеВыполняются = Новый Массив;
		
		Для Каждого КлючЗначение Из СтрокиАвтоРасчет Цикл			
			СтрокаДанных = КлючЗначение.Ключ;
			РассчитатьПроцентГотовностиПоСтроке(СтрокаДанных);	
			Если Не СтрокаДанных.ПроектВыполняется Тогда
				Если ПроектыНеВыполняются.Найти(СтрокаДанных.Проект) = Неопределено Тогда
					ПроектыНеВыполняются.Добавить(СтрокаДанных.Проект);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;		
		
		СообщитьПроектыНеВыполняютсяДляПроцентаГотовности(ПроектыНеВыполняются);
		
	КонецЕсли;

КонецПроцедуры	

&НаКлиенте
Процедура СообщитьПроектыНеВыполняютсяДляПроцентаГотовности(ПроектыНеВыполняются)

	КоличествоПроектов = ПроектыНеВыполняются.Количество();

	Если КоличествоПроектов = 0 Тогда
		Возврат;
	ИначеЕсли КоличествоПроектов = 1 Тогда						
		ТекстВставки = НСтр("ru = 'проект находился'"); 	
	Иначе
		ТекстВставки = НСтр("ru = 'проекты находились'");
	КонецЕсли;	
		
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Для установки процента готовности необходимо, чтобы %1 в статусе ""Выполняется"": %2.'"),
		ТекстВставки,
		СтрСоединить(ПроектыНеВыполняются, ","));
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	

КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииПроцентаГотовностиПоСтроке(СтрокаДанных)

	упоПроектыИЗадачиКлиент.ПриИзмененииПроцентаГотовностиПроектнойЗадачиВТаблицеФормы(СтрокаДанных, Ложь);
		
	ПланСтроки = 0;
	ФактСтроки = 0;

	СтрокиПЗ_УровеньПЗ = мКэшЗначений.СтрокиПЗ_УровеньПЗ.Получить(СтрокаДанных.ПроектнаяЗадачаЗеркало);
	Для Каждого ИдСтроки Из СтрокиПЗ_УровеньПЗ Цикл
		СтрокаДанных = Элементы.ДеревоФормы.ДанныеСтроки(ИдСтроки);
				
		ПланСтроки = ПланСтроки + СтрокаДанных.ФактПлюсПрогноз;
		
		Если СтрокаДанных.ПроцентГотовностиРучноеРедактирование Тогда
			Процент100 = 100;
			ФактСтроки = ФактСтроки + СтрокаДанных.ФактПлюсПрогноз * СтрокаДанных.ПроцентГотовности / Процент100;
		Иначе
			ФактСтроки = ФактСтроки + СтрокаДанных.ФактДоОтчетногоПериода + СтрокаДанных.ФактОтчетногоПериода;
		КонецЕсли;
				
	КонецЦикла;

	ПересчитатьПроцентГотовностиЗадачиПоПроцентуГотовностиВСтроке(СтрокаДанных, ПланСтроки, ФактСтроки);
		
	// Данные ПЗ спускаем на нижний уровень, который фактически записывается в документ.			
	СтрокаСвойств = СтрокаСвойствЗаполненияДляПроцентаГотовности();

	СтрокиПЗ_НижнийУровень = мКэшЗначений.СтрокиПЗ_НижнийУровень.Получить(СтрокаДанных.ПроектнаяЗадачаЗеркало);
	Для Каждого ИдСтроки Из СтрокиПЗ_НижнийУровень Цикл
		ДанныеСтроки = Элементы.ДеревоФормы.ДанныеСтроки(ИдСтроки);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаДанных, СтрокаСвойств);				
	КонецЦикла;	

КонецПроцедуры	

&НаКлиенте
Процедура ПересчитатьПроцентГотовностиЗадачиПоПроцентуГотовностиВСтроке(СтрокаДанных, ПланСтроки, Знач ФактСтроки)

	ПроцентГотовностиЗадачи = 0;
				
	ПланЗадачи = ПланСтроки + СтрокаДанных.ПланДоПолногоПоЗадаче;
	Если ПланЗадачи > 0 Тогда						
		Процент100 = 100;
		ПроцентГотовностиЗадачи = Процент100 * (ФактСтроки + СтрокаДанных.ФактДоПолногоПоЗадаче) / ПланЗадачи;					
	КонецЕсли;

	Если Объект.НеУменьшатьЗаписанныйПроцентГотовности 
		И СтрокаДанных.ПроцентГотовностиЗадачиТекущийПлан >= ПроцентГотовностиЗадачи Тогда
		ПроцентГотовностиЗадачи = СтрокаДанных.ПроцентГотовностиЗадачиТекущийПлан;
	КонецЕсли;
		
	СтрокаДанных.ПроцентГотовностиЗадачи = ПроцентГотовностиЗадачи;

	упоПроектыИЗадачиКлиент.ПриИзмененииПроцентаГотовностиПроектнойЗадачиВТаблицеФормы(СтрокаДанных,
																					,
																					"ПроцентГотовностиЗадачи");	

	// Признак для раскраски.
	СтрокаДанных.ЗадачаЗавершена = СтрокаДанных.Статус = 
		ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаЗадачи.Завершена"); 						
	Если Объект.ПорядокГруппировок = 
		ПредопределенноеЗначение("Перечисление.упоПорядокГруппировокПрогнозированиеТрудозатрат.ПроектЗадачаРольПодразделение") Тогда
		ПодчЭлементы = СтрокаДанных.ПолучитьЭлементы();
		Для Каждого ПодчЭлемент Из ПодчЭлементы Цикл
			ПодчЭлемент.ЗадачаЗавершена = СтрокаДанных.ЗадачаЗавершена;	
		КонецЦикла;
		
		СтрокаСвойств = СтрокаСвойствЗаполненияДляПроцентаГотовности();
		
		// Если редактируется не группировка задачи, а идет пересчет при редактировании факта подчиненных, 
		// то  поднимаем данные на уровень группировки задачи.
		ИдСтроки = СтрокаДанных.ПолучитьИдентификатор();		
		ИдЗадачи = мКэшЗначений.СтрокиПЗ_УровеньПЗ.Получить(СтрокаДанных.ПроектнаяЗадачаЗеркало)[0];		
		Если ИдСтроки <> ИдЗадачи Тогда
			ДанныеСтроки = Элементы.ДеревоФормы.ДанныеСтроки(ИдЗадачи);
			ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаДанных, СтрокаСвойств);							
		КонецЕсли;
		
	КонецЕсли;	
		
	упоРаботаСФормамиКлиент.УстановитьФактическиеСрокиПоУмолчанию(СтрокаДанных, "ДатаНачалаТП", "ДатаЗавершенияТП");

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьАвтоматическийРасчетПроцентаГотовностиПоСтроке(ТекДанные)

	Если Не (Объект.ЗаписыватьПроцентГотовности 
		И Объект.АвтоматическийРасчетПроцентаГотовности) Тогда
		Возврат;
	КонецЕсли;
			
	РассчитатьПроцентГотовностиСУведомлением(ТекДанные);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОтложенноеОтражениеТрудозатрат(Команда)

	ВыполнитьОтложенноеОтражениеТрудозатратКлиент();

КонецПроцедуры

&НаКлиенте
Процедура НайтиВСтрокахПроектыНеВыполняются(СтрокиРасчета, ПроектыНеВыполняются)

	Для Каждого КлючЗначение Из СтрокиРасчета Цикл			
		
		СтрокаДанных = КлючЗначение.Ключ;
		РассчитатьПроцентГотовностиПоСтроке(СтрокаДанных);
		
		Если Не СтрокаДанных.ПроектВыполняется Тогда
			Если ПроектыНеВыполняются.Найти(СтрокаДанных.Проект) = Неопределено Тогда
				ПроектыНеВыполняются.Добавить(СтрокаДанных.Проект);
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьПустыеСтрокиИзСпискаПроектов()

	Если Не ЗначениеЗаполнено(СписокПроектов) Тогда
		Возврат;	
	КонецЕсли;
	
	СтрокиКУдалению = Новый Массив;
	
	Для каждого Строка Из СписокПроектов Цикл
		Если Не ЗначениеЗаполнено(Строка.Значение) Тогда
			СтрокиКУдалению.Добавить(Строка);
		КонецЕсли;
	КонецЦикла; 
	
	Для Каждого УдалаяемаяСтрока Из СтрокиКУдалению Цикл
		СписокПроектов.Удалить(УдалаяемаяСтрока);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОтборыИзФормы(тОбъект)
	
	тОбъект.Роли.Очистить();
	Для Каждого ЭлементСписка Из СписокРолей Цикл
		СтрокаТЧ = тОбъект.Роли.Добавить();	
		СтрокаТЧ.Роль = ЭлементСписка.Значение;
	КонецЦикла;
	
	тОбъект.ПодразделенияОтбор.Очистить();
	Для Каждого ЭлементСписка Из СписокПодразделений Цикл
		СтрокаТЧ = тОбъект.ПодразделенияОтбор.Добавить();	
		СтрокаТЧ.Подразделение = ЭлементСписка.Значение;
	КонецЦикла;
	
	тОбъект.Проекты.Очистить();
	Для Каждого ЭлементСписка Из СписокПроектов Цикл
		Если ЗначениеЗаполнено(ЭлементСписка.Значение) Тогда
			СтрокаТЧ = тОбъект.Проекты.Добавить();	
			СтрокаТЧ.Проект = ЭлементСписка.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти

#КонецОбласти
