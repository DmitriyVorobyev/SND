		Если ДанныеВыбора.НайтиПоЗначению(СтрокаСоответствия.Ключ) = Неопределено Тогда
			ДанныеВыбора.Добавить(СтрокаСоответствия.Ключ);
		КонецЕсли;
	КонецЦикла;

