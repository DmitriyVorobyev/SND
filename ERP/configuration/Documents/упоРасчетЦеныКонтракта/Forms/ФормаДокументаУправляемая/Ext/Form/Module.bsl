&НаСервере
Процедура ОбновитьПараметрыРасчета(ВыбранноеЗначение)
	
	ТаблицаПараметры.Загрузить(ВыбранноеЗначение.ТаблицаПараметры.Выгрузить());  
	Для Каждого СтрокаПараметр Из ТаблицаПараметры Цикл 
		НайденныеСтроки = Объект.ПараметрыРасчета.НайтиСтроки(Новый Структура("ВидОперации", СтрокаПараметр.ВидОперации));
		Если СтрокаПараметр.Пометка И НайденныеСтроки.Количество() = 0 Тогда
			СтрокаПараметрРасчета = Объект.ПараметрыРасчета.Добавить();
			СтрокаПараметрРасчета.ВидОперации = СтрокаПараметр.ВидОперации;
			СтрокаПараметрРасчета.ПроцентНаценкиРедактируетсяВручную = Истина;
		ИначеЕсли НЕ СтрокаПараметр.Пометка И НайденныеСтроки.Количество() > 0 Тогда
			Объект.ПараметрыРасчета.Удалить(НайденныеСтроки[0]);
		КонецЕсли;
		Элементы["Страница" + Строка(СтрокаПараметр.ИмяСтраницы)].Видимость = СтрокаПараметр.Пометка;
	КонецЦикла; 
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтавкиПоСпециальности(Элемент)
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	ТекущиеДанные.СтавкаВнутренняя = ПолучитьСтавкуПоНорме(ТекущиеДанные.Специальность, Объект.НормаСтоимостиВнутренняя);
	ТекущиеДанные.СтавкаВнешняя = ПолучитьСтавкуПоНорме(ТекущиеДанные.Специальность, Объект.НормаСтоимостиВнешняя);
	ПересчитатьСуммуПоВнутреннейСтавке(ТекущиеДанные);
	ПересчитатьСуммуПоВнешнейСтавке(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделение(Элемент) 
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	ТекущиеДанные.Подразделение = ПолучитьПодразделениеДляРоли(ТекущиеДанные.Специальность);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПодразделениеДляРоли(Роль)	
	
	Запрос = Новый Запрос();
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоСоставПодразделенийСрезПоследних.Подразделение
	               |ИЗ
	               |	РегистрСведений.упоСоставПодразделений.СрезПоследних(, Роль = &Роль) КАК упоСоставПодразделенийСрезПоследних
	               |ГДЕ
	               |	упоСоставПодразделенийСрезПоследних.ВходитВСостав";
				   
	Запрос.УстановитьПараметр("Роль", Роль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Подразделение = Выборка.Подразделение;
	Иначе
		Подразделение = ПредопределенноеЗначение("Справочник.упоПодразделения.ПустаяСсылка");
	КонецЕсли;
	
	Возврат Подразделение;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтавкуПоНорме(Роль, НормаСтоимости)

	Ставка = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоНормыСтоимостиРесурсовСрезПоследних.ЕдСтоимость
	               |ИЗ
	               |	РегистрСведений.упоНормыСтоимостиРесурсов.СрезПоследних(
	               |			,
	               |			Норма = &НормаСтоимости
	               |				И Ресурс = &Роль) КАК упоНормыСтоимостиРесурсовСрезПоследних";
				   
	Запрос.УстановитьПараметр("НормаСтоимости", НормаСтоимости);
	Запрос.УстановитьПараметр("Роль", Роль);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Ставка = Выборка.ЕдСтоимость;
	КонецЕсли;
	
	Возврат Ставка;   	

КонецФункции

&НаКлиенте
Процедура ПересчитатьСуммуПоВнешнейСтавке(ТекущиеДанные)
	
	ТекущиеДанные.СуммаПоВнешнейСтавке = ТекущиеДанные.СтавкаВнешняя * ТекущиеДанные.КоличествоЧасов;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуПоВнутреннейСтавке(ТекущиеДанные)
	
	ТекущиеДанные.СуммаПоВнутреннейСтавке = ТекущиеДанные.СтавкаВнутренняя * ТекущиеДанные.КоличествоЧасов;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииТипаРасчета(ИмяТабличнойЧасти, Элемент)
	
	ТекущиеДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;	
	ПересчитатьСуммуДополнительныхЗатрат(ИмяТабличнойЧасти, ТекущиеДанные);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуТрудозатратПоОтбору(ИмяТабличнойЧасти, ПараметрыОтбора, ИмяКолонки)
	
	НайденныеСтроки = Объект[СтрЗаменить(ИмяТабличнойЧасти, "ДополнительныеЗатраты", "Трудозатраты")].НайтиСтроки(ПараметрыОтбора);
	СуммаПоКолонке = 0;
	Для Каждого СтрокаТрудозатраты Из НайденныеСтроки Цикл
		СуммаПоКолонке = СуммаПоКолонке + СтрокаТрудозатраты[ИмяКолонки];
	КонецЦикла;	
	Возврат СуммаПоКолонке;
	
КонецФункции

&НаСервере
Функция РассчитатьПроцентОтГруппыЗатрат(ИмяТабличнойЧасти, НомерТекущейСтроки, ГруппаСтатейЗатрат, ВидОперации)
	
	СуммаБаза = 0;
	
	Если ИмяТабличнойЧасти = "ДополнительныеЗатратыОборудование" Тогда
		ТаблицаЗатраты = Объект.ОборудованиеПродаваемое.Выгрузить();
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоСобственныеСилыСубподряд"));
		ТаблицаЗатраты.Колонки.Добавить("СобственныеСилыСубподряд", Новый ОписаниеТипов(МассивТипов));
		ТаблицаЗатраты.ЗаполнитьЗначения(ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы"),
			"СобственныеСилыСубподряд");
		ИмяРеквизитаСумма  = "СтоимостьЗакупкиCIP";
	Иначе	
		ТаблицаЗатраты = Объект[СтрЗаменить(ИмяТабличнойЧасти, "ДополнительныеЗатраты", "Трудозатраты")].Выгрузить();
		ИмяРеквизитаСумма = "СуммаПоВнутреннейСтавке";
	КонецЕсли;	
	
	// Добавление дополнительных затрат.
	Для Каждого СтрокаДопЗатраты Из Объект[ИмяТабличнойЧасти] Цикл
		Если СтрокаДопЗатраты.НомерСтроки <> НомерТекущейСтроки Тогда
			СтрокаЗатраты = ТаблицаЗатраты.Добавить();
			СтрокаЗатраты.СтатьяЗатрат = СтрокаДопЗатраты.СтатьяЗатрат;
			СтрокаЗатраты.СобственныеСилыСубподряд = ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");
			СтрокаЗатраты.СуммаПоВнутреннейСтавке = СтрокаДопЗатраты.Сумма;
		КонецЕсли;
	КонецЦикла;	
	
	// Расчет суммы.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаТрудозатраты.СтатьяЗатрат,
				   |	ТаблицаТрудозатраты.ВидОперации,
	               |	ТаблицаТрудозатраты.СобственныеСилыСубподряд,
	               |	ТаблицаТрудозатраты." + ИмяРеквизитаСумма
				   + ?(ИмяТабличнойЧасти = "ДополнительныеЗатратыОборудование", ",
				   |ТаблицаТрудозатраты.СуммаТаможенныхПлатежей", "") + "
	               |ПОМЕСТИТЬ втТрудозатраты
	               |ИЗ
	               |	&ТаблицаТрудозатраты КАК ТаблицаТрудозатраты
				   |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ГруппаСтатейЗатрат.СтатьяЗатрат
				   |ПОМЕСТИТЬ втСтатьиЗатрат
	               |ИЗ
	               |	Справочник.упоГруппыСтатейЗатрат.СтатьиЗатрат КАК ГруппаСтатейЗатрат
	               |ГДЕ
	               |	ГруппаСтатейЗатрат.Ссылка = &ГруппаСтатейЗатрат
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕСТЬNULL(СУММА(втТрудозатраты." + ИмяРеквизитаСумма + "), 0)" + ?(ИмяТабличнойЧасти = "ДополнительныеЗатратыОборудование", " + ЕСТЬNULL(СУММА(втТрудозатраты.СуммаТаможенныхПлатежей), 0)", "") + " КАК Сумма
	               |ИЗ
	               |	втТрудозатраты КАК втТрудозатраты
	               |ГДЕ
	               |	втТрудозатраты.СобственныеСилыСубподряд = &СобственныеСилы
	               |	И втТрудозатраты.СтатьяЗатрат В ИЕРАРХИИ(Выбрать СтатьяЗатрат ИЗ втСтатьиЗатрат КАК втСтатьиЗатрат)
				   |	И втТрудозатраты.ВидОперации = &ВидОперации";
				   
	Запрос.УстановитьПараметр("ТаблицаТрудозатраты", ТаблицаЗатраты);
	Запрос.УстановитьПараметр("СобственныеСилы", ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы"));
	Запрос.УстановитьПараметр("ГруппаСтатейЗатрат", ГруппаСтатейЗатрат);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммаБаза = Выборка.Сумма;
	КонецЕсли;	
	
	Возврат СуммаБаза;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьОбщиеСуммы(СтрокаВидОперации)
	
	Если СтрокаВидОперации = "Оборудование" Тогда
		
		ТЧЗатраты = Объект["ОборудованиеПродаваемое"]; 
		СуммаЗатраты  = ТЧЗатраты.Итог("СтоимостьЗакупкиCIP") + ТЧЗатраты.Итог("СуммаТаможенныхПлатежей");
		
	Иначе
		
		СуммаЗатраты = Объект["Трудозатраты" + СтрокаВидОперации].Итог("СуммаПоВнутреннейСтавке");
		
	КонецЕсли;
	
	СуммаДопЗатраты = Объект["ДополнительныеЗатраты" + СтрокаВидОперации].Итог("Сумма");
	
	ПараметрыОтбора = Новый Структура("ВидОперации", ПредопределенноеЗначение("Справочник.упоВидыОпераций." + СтрокаВидОперации));
	НайденныеСтроки = Объект.ПараметрыРасчета.НайтиСтроки(ПараметрыОтбора);
	Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	НайденнаяСтрока = НайденныеСтроки[0];
	
	НайденнаяСтрока.Затраты = СуммаЗатраты + СуммаДопЗатраты;
	
	Если НайденнаяСтрока.ПроцентНаценкиРедактируетсяВручную Тогда
		ПересчитатьСуммуКонтрактаВСтроке(НайденнаяСтрока);	
	ИначеЕсли НайденнаяСтрока.СуммаКонтрактаРедактируетсяВручную Тогда
		Если НайденнаяСтрока.ПересчитыватьСУчетомПеревыставляемыхДопЗатрат Тогда
			ПересчитатьСуммуКонтрактаВСтроке(НайденнаяСтрока);	
		КонецЕсли;	
		ПересчитатьСуммуПроцентНаценкиВСтроке(НайденнаяСтрока);
	КонецЕсли;
	
	ПересчитатьОбщуюСуммуОтклонение();		
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуКонтрактаВСтроке(Строка)
	
	Если Строка.ПересчитыватьСУчетомПеревыставляемыхДопЗатрат Тогда
		
		ПараметрыОтбора = Новый Структура("ВидОперации", Строка.ВидОперации);
		НайденныеСтроки = ТаблицаПараметры.НайтиСтроки(ПараметрыОтбора);
		
		Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
			Возврат;
		КонецЕсли;
		СтрокаВидОперации = НайденныеСтроки[0].ИмяСтраницы;
		
		СуммаЗатраты = 0;
		Если СтрокаВидОперации = "Оборудование" Тогда
			
			ТЧЗатраты = Объект["ОборудованиеПродаваемое"]; 
			СуммаЗатраты  = ТЧЗатраты.Итог("СтоимостьПродажиCIP"); //{Вопрос аналитику, надо ли таможенные платежи вклчать?} + ТЧЗатраты.Итог("СуммаТаможенныхПлатежей");
			
		Иначе
			
			СуммаЗатраты = Объект["Трудозатраты" + СтрокаВидОперации].Итог("СуммаПоВнешнейСтавке");
			
		КонецЕсли;
		
		СуммаДопЗатраты = 0;
		ПараметрыОтбора = Новый Структура("Перевыставляемые", Истина);
		СтрокиПеревыставляемыеДопЗатраты = Объект["ДополнительныеЗатраты" + СтрокаВидОперации].НайтиСтроки(ПараметрыОтбора);
		
		Для Каждого СтрокаПеревыставляемыеДопЗатраты из СтрокиПеревыставляемыеДопЗатраты Цикл
			СуммаДопЗатраты = СуммаДопЗатраты +	СтрокаПеревыставляемыеДопЗатраты.Сумма;	
		КонецЦикла;
		
		Строка.СуммаКонтракта = СуммаЗатраты + СуммаДопЗатраты;
				
	Иначе	
		Строка.СуммаКонтракта = Строка.Затраты + Строка.Затраты * Строка.ПроцентНаценки / 100;
	КонецЕсли;
	
	Строка.СуммаНаценки = Строка.СуммаКонтракта - Строка.Затраты;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуПроцентНаценкиВСтроке(Строка)
	
	Строка.СуммаНаценки = Строка.СуммаКонтракта - Строка.Затраты;
	Если Строка.Затраты = 0 Тогда 
		Строка.ПроцентНаценки = 0;
	Иначе
		Строка.ПроцентНаценки = 100 * Строка.СуммаНаценки / Строка.Затраты;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОбщуюСуммуОтклонение()
	
	КоэффициентПоправкаНаИнфляцию = Объект.ПоправкаНаИнфляцию / 100;
	ИтогСуммаКонтракта = Объект.ПараметрыРасчета.Итог("СуммаКонтракта");
	Объект.СуммаКонтракта = ИтогСуммаКонтракта + ИтогСуммаКонтракта * КоэффициентПоправкаНаИнфляцию;
	ПересчитатьОтклонениеОтЛимита();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОтклонениеОтЛимита()
	Объект.ОтклонениеОтЛимита = Объект.ЛимитКонкурса - Объект.СуммаКонтракта;	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуДополнительныхЗатрат(ИмяТабличнойЧасти, ТекущиеДанные)
	
	Если ТекущиеДанные.ТипРасчета = ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.Вручную") Тогда
		
		ТекущиеДанные.КоличествоЧасов = 0;

	ИначеЕсли ТекущиеДанные.ТипРасчета = 
		ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.СтавкаЧаса") Тогда 
		
		ТекущиеДанные.Сумма = ТекущиеДанные.Показатель * ТекущиеДанные.КоличествоЧасов;
		
	ИначеЕсли ТекущиеДанные.ТипРасчета = 
		ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.СтавкаЧасаОтСобственныхТрудозатрат") Тогда
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("КоличествоЧасов", ТекущиеДанные.КоличествоЧасов);
		СтруктураДанных.Вставить("Показатель", ТекущиеДанные.Показатель);
		СтруктураДанных.Вставить("Сумма");
		СтруктураДанных.Вставить("ВидОперации", ТекущиеДанные.ВидОперации);
				
		ПересчитатьСуммуПоСтавкеЧасаОтСобственныхТрудозатрат(СтруктураДанных, ИмяТабличнойЧасти);
		ТекущиеДанные.Сумма = СтруктураДанных.Сумма;
		ТекущиеДанные.КоличествоЧасов = СтруктураДанных.КоличествоЧасов;
		
	ИначеЕсли ТекущиеДанные.ТипРасчета =
		ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.ПроцентОтСобственныхТрудозатрат") Тогда	
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("КоличествоЧасов", ТекущиеДанные.КоличествоЧасов);
		СтруктураДанных.Вставить("Показатель", ТекущиеДанные.Показатель);
		СтруктураДанных.Вставить("Сумма");
		СтруктураДанных.Вставить("ВидОперации", ТекущиеДанные.ВидОперации);
				
		ПересчитатьСуммуПоПроцентуОтСобственныхТрудозатрат(СтруктураДанных, ИмяТабличнойЧасти);
		ТекущиеДанные.Сумма = СтруктураДанных.Сумма;
		ТекущиеДанные.КоличествоЧасов = 0;
		
	ИначеЕсли ТекущиеДанные.ТипРасчета = 
		ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.ПроцентОтГруппыЗатрат") Тогда
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("КоличествоЧасов", ТекущиеДанные.КоличествоЧасов);
		СтруктураДанных.Вставить("Показатель", ТекущиеДанные.Показатель);
		СтруктураДанных.Вставить("НомерСтроки", ТекущиеДанные.НомерСтроки);
		СтруктураДанных.Вставить("ГруппаСтатейЗатрат", ТекущиеДанные.ГруппаСтатейЗатрат);
		СтруктураДанных.Вставить("ВидОперации", ТекущиеДанные.ВидОперации);
		СтруктураДанных.Вставить("Сумма");   		
		
		ПересчитатьСуммуПоПроцентуОтГруппыСтатейЗатрат(СтруктураДанных, ИмяТабличнойЧасти);
		ТекущиеДанные.Сумма = СтруктураДанных.Сумма;
		ТекущиеДанные.КоличествоЧасов = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКоличестваЧасовДополнительныеЗатраты(Элемент)
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	Если ТекущиеДанные.ТипРасчета =
		ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.СтавкаЧасаОтСобственныхТрудозатрат") Тогда
		
		ТекущиеДанные.ТипРасчета = ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.СтавкаЧаса");
		
	КонецЕсли;
	ПересчитатьСуммуДополнительныхЗатрат(Элемент.Родитель.Имя, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначенияПоУмолчаниюВСтрокеТрудозатраты(Элемент, НоваяСтрока, Копирование, ВидОперации)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		ТекущиеДанные.ВидОперации = ВидОперации;
		ТекущиеДанные.СобственныеСилыСубподряд = ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");
		НайденныеСтроки = ТаблицаПараметры.НайтиСтроки(Новый Структура("ВидОперации", ВидОперации)); 	
		ТекущиеДанные.СтатьяЗатрат = НайденныеСтроки[0].СтатьяЗатрат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначенияПоУмолчаниюВСтрокеДополнительныеЗатраты(Элемент, НоваяСтрока, Копирование, ВидОперации = Неопределено)
	
	Если НоваяСтрока И НЕ Копирование Тогда	
		ТекущиеДанные = Элемент.ТекущиеДанные;
		Если ВидОперации <> Неопределено Тогда
			ТекущиеДанные.ВидОперации = ВидОперации;
		КонецЕсли;	
		ТекущиеДанные.ТипРасчета = ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.Вручную");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтоимостьЗакупкиEXW() 
	ТекущиеДанные = Элементы.ОборудованиеПродаваемое.ТекущиеДанные;
	ТекущиеДанные.СтоимостьЗакупкиEXW = ТекущиеДанные.ЦенаЗакупки * ТекущиеДанные.Количество;
	ПересчитатьСтоимостьЗакупкиCIP();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЦенуПродажи() 
	ТекущиеДанные = Элементы.ОборудованиеПродаваемое.ТекущиеДанные;
	ТекущиеДанные.ЦенаПродажи = ТекущиеДанные.ЦенаЗакупки + ТекущиеДанные.ЦенаЗакупки * ТекущиеДанные.НаценкаСкидка / 100;
	ПересчитатьСтоимостьПродажиEXW();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтоимостьПродажиEXW() 
	ТекущиеДанные = Элементы.ОборудованиеПродаваемое.ТекущиеДанные;
	ТекущиеДанные.СтоимостьПродажиEXW = ТекущиеДанные.ЦенаПродажи * ТекущиеДанные.Количество;
	ПересчитатьСтоимостьПродажиCIP();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтоимостьЗакупкиCIP() 
	ТекущиеДанные = Элементы.ОборудованиеПродаваемое.ТекущиеДанные;
	ТекущиеДанные.СтоимостьЗакупкиCIP = ТекущиеДанные.СтоимостьЗакупкиEXW + ТекущиеДанные.СтоимостьЗакупкиEXW * ТекущиеДанные.ПроцентДоставки / 100;	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтоимостьПродажиCIP() 
	ТекущиеДанные = Элементы.ОборудованиеПродаваемое.ТекущиеДанные;
	ТекущиеДанные.СтоимостьПродажиCIP = ТекущиеДанные.СтоимостьПродажиEXW + ТекущиеДанные.СтоимостьПродажиEXW * ТекущиеДанные.ПроцентДоставки / 100;	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаможеннуюСтоимостьЗакупки() 
	ТекущиеДанные = Элементы.ОборудованиеПродаваемое.ТекущиеДанные;
	ТекущиеДанные.ТаможеннаяСтоимостьЗакупки = ТекущиеДанные.ЦенаЗакупки * ТекущиеДанные.Количество * ТекущиеДанные.ПроцентТаможеннойСтоимости / 100;
	ПересчитатьСтоимостьОформления(ТекущиеДанные);
	ПересчитатьСтоимостьПошлины(ТекущиеДанные);
	ПересчитатьСуммуНДС(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтоимостьОформления(Строка) 
	Строка.СтоимостьОформления = Строка.ТаможеннаяСтоимостьЗакупки * Объект.СтавкаТаможенногоОформления / 100;
	ПересчитатьСуммуНДС(Строка);   
	ПересчитатьСуммуТаможенныхПлатежей(Строка);
КонецПроцедуры

&НаКлиенте
Процедура СтавкаТаможенногоОформленияПриИзменении(Элемент)
	ОборудованиеПродаваемое = Объект.ОборудованиеПродаваемое;
	Для Каждого СтрокаОборудование Из ОборудованиеПродаваемое Цикл
		ПересчитатьСтоимостьОформления(СтрокаОборудование);	
	КонецЦикла; 	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтоимостьПошлины(ТекущиеДанные) 
	ТекущиеДанные.СтоимостьПошлины = ТекущиеДанные.ТаможеннаяСтоимостьЗакупки * ТекущиеДанные.ТаможеннаяПошлина / 100;
	ПересчитатьСуммуНДС(ТекущиеДанные);
	ПересчитатьСуммуТаможенныхПлатежей(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуНДС(Строка) 
	СтавкаНДСЧислом = упоФункцииОбщегоНазначенияКлиентСервер.ПолучитьСтавкуНДСЧислом(Строка.СтавкаНДС);
	Строка.СуммаНДС = (Строка.ТаможеннаяСтоимостьЗакупки + Строка.СтоимостьОформления + Строка.СтоимостьПошлины) * СтавкаНДСЧислом;
	ПересчитатьСуммуТаможенныхПлатежей(Строка);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуТаможенныхПлатежей(Строка) 
	Строка.СуммаТаможенныхПлатежей = Строка.СтоимостьОформления + Строка.СтоимостьПошлины + Строка.СуммаНДС;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммыПараметровРасчета() 
	Для Каждого СтрокаПараметрРасчета Из ТаблицаПараметры Цикл
		Если СтрокаПараметрРасчета.Пометка Тогда
			ПересчитатьОбщиеСуммы(СтрокаПараметрРасчета.ИмяСтраницы);
		КонецЕсли;	
	КонецЦикла;
	ПересчитатьОбщуюСуммуОтклонение();
КонецПроцедуры

&НаКлиенте
Процедура СортироватьСтрокиПоВидамОпераций() 
	
	Для Каждого СтрокаПараметрРасчета Из Объект.ПараметрыРасчета Цикл
		Если СтрокаПараметрРасчета.ВидОперации = ПредопределенноеЗначение("Справочник.упоВидыОпераций.ПИРНИР") Тогда
			СтрокаПараметрРасчета.Порядок = 1;
		ИначеЕсли СтрокаПараметрРасчета.ВидОперации = ПредопределенноеЗначение("Справочник.упоВидыОпераций.Оборудование") Тогда
			СтрокаПараметрРасчета.Порядок = 2; 
		ИначеЕсли СтрокаПараметрРасчета.ВидОперации = ПредопределенноеЗначение("Справочник.упоВидыОпераций.ПНР") Тогда
			СтрокаПараметрРасчета.Порядок = 3; 
		ИначеЕсли СтрокаПараметрРасчета.ВидОперации = ПредопределенноеЗначение("Справочник.упоВидыОпераций.СМР") Тогда
			СтрокаПараметрРасчета.Порядок = 4; 	
		ИначеЕсли СтрокаПараметрРасчета.ВидОперации = ПредопределенноеЗначение("Справочник.упоВидыОпераций.Прочие") Тогда
			СтрокаПараметрРасчета.Порядок = 5;
		КонецЕсли;	
	КонецЦикла;
	Объект.ПараметрыРасчета.Сортировать("Порядок");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПроект(Команда)  	
	
	Если Модифицированность Тогда 		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьПроектЗавершение",ЭтотОбъект);
		Режим = РежимДиалогаВопрос.ДаНет;
		
		ПоказатьВопрос(ОписаниеОповещения,НСтр("ru = 'Документ изменен. Записать изменения?';"
		     + " en = 'Do you want to continue?'"), Режим, 0);
			 
	Иначе
			 
		СоздатьПроектЗавершение(Неопределено,Неопределено);	 
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПроектЗавершение(Ответ,ДополнительныеПараметры) Экспорт
	
	Если Модифицированность Тогда 		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Записать();	
		Иначе
			Возврат;
		КонецЕсли; 		
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СохранитьСоответствие", Истина);
	ПараметрыФормы.Вставить("КоэффициентМасштабирования", 1);
	ПараметрыФормы.Вставить("ОткрытьПанельПроекта", Истина);
	ПараметрыФормы.Вставить("РасчетЦеныКонтракта", Объект.Ссылка);
	
	ОткрытьФорму("Обработка.упоСозданиеПроектаИзШаблона.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуКонтрактаЗавершение(Ответ, ДополнительныеПараметры) Экспорт  	
	
	ДополнительныеПараметры.ТекущиеДанные.ПересчитыватьСУчетомПеревыставляемыхДопЗатрат = Ответ = КодВозвратаДиалога.Да;
	ПересчитатьСуммуКонтрактаПоВидуОперацииТекДанных(ДополнительныеПараметры.ТекущиеДанные);
	
КонецПроцедуры
 
 &НаКлиенте
Процедура ПересчитатьСуммуКонтрактаПоВидуОперацииТекДанных(ТекущиеДанные) Экспорт  	

	ПараметрыОтбора = Новый Структура("ВидОперации", ТекущиеДанные.ВидОперации);

	НайденныеСтроки = ТаблицаПараметры.НайтиСтроки(ПараметрыОтбора);
	
	Если Не ЗначениеЗаполнено(НайденныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	СтрокаВидОперации = НайденныеСтроки[0].ИмяСтраницы;
	
	ПересчитатьОбщиеСуммы(СтрокаВидОперации);

	ТекущиеДанные.ПересчитыватьСУчетомПеревыставляемыхДопЗатрат = Ложь;
	 
КонецПроцедуры 

&НаСервере
Процедура ПересчитатьДопЗатратыНаСервере(ИмяТабличнойЧасти)
	
	ТаблицаДопЗатраты = Объект[ИмяТабличнойЧасти];
	
	Для Каждого СтрокаДопЗатраты Из ТаблицаДопЗатраты Цикл
		
		Если СтрокаДопЗатраты.ТипРасчета = 
			ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.СтавкаЧасаОтСобственныхТрудозатрат") Тогда
			ПересчитатьСуммуПоСтавкеЧасаОтСобственныхТрудозатрат(СтрокаДопЗатраты, ИмяТабличнойЧасти)
			
		ИначеЕсли СтрокаДопЗатраты.ТипРасчета =
			ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.ПроцентОтСобственныхТрудозатрат") Тогда	
			ПересчитатьСуммуПоПроцентуОтСобственныхТрудозатрат(СтрокаДопЗатраты, ИмяТабличнойЧасти);
			
		ИначеЕсли СтрокаДопЗатраты.ТипРасчета = 
			ПредопределенноеЗначение("Перечисление.упоТипыРасчетаЦеныКонтракта.ПроцентОтГруппыЗатрат") Тогда
			ПересчитатьСуммуПоПроцентуОтГруппыСтатейЗатрат(СтрокаДопЗатраты, ИмяТабличнойЧасти);
			
		КонецЕсли;
		
	КонецЦикла; 	
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуПоСтавкеЧасаОтСобственныхТрудозатрат(Данные, ИмяТабличнойЧасти)
	
	ПараметрыОтбора = Новый Структура("СобственныеСилыСубподряд",
		ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы"));
		
	Если ЗначениеЗаполнено(Данные.ВидОперации) Тогда
		ПараметрыОтбора.Вставить("ВидОперации", Данные.ВидОперации); 	
	КонецЕсли;

	Данные.КоличествоЧасов = ПолучитьСуммуТрудозатратПоОтбору(ИмяТабличнойЧасти, ПараметрыОтбора, "КоличествоЧасов");
	Данные.Сумма = Данные.Показатель * Данные.КоличествоЧасов;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуПоПроцентуОтСобственныхТрудозатрат(Данные, ИмяТабличнойЧасти)
	
	ПараметрыОтбора = Новый Структура("СобственныеСилыСубподряд",
		ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы"));
		
	Если ЗначениеЗаполнено(Данные.ВидОперации) Тогда
		ПараметрыОтбора.Вставить("ВидОперации", Данные.ВидОперации); 	
	КонецЕсли;

	СуммаБаза = ПолучитьСуммуТрудозатратПоОтбору(ИмяТабличнойЧасти, ПараметрыОтбора, "СуммаПоВнутреннейСтавке");
	Данные.Сумма = СуммаБаза * Данные.Показатель / 100;
	Данные.КоличествоЧасов = 0;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуПоПроцентуОтГруппыСтатейЗатрат(Данные, ИмяТабличнойЧасти)
	
	СуммаБаза = РассчитатьПроцентОтГруппыЗатрат(ИмяТабличнойЧасти,
												Данные.НомерСтроки, 
												Данные.ГруппаСтатейЗатрат,
												Данные.ВидОперации);		
	Данные.Сумма = СуммаБаза * Данные.Показатель / 100;
	Данные.КоличествоЧасов = 0;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Для Каждого СтрокаПараметр Из ТаблицаПараметры Цикл 
		НайденныеСтроки = Объект.ПараметрыРасчета.НайтиСтроки(Новый Структура("ВидОперации", СтрокаПараметр.ВидОперации));
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			СтрокаПараметр.Пометка = Истина;
			СтрокаПараметр.СтатьяЗатрат = НайденнаяСтрока.СтатьяЗатрат; 
		КонецЕсли;
		Элементы["Страница" + Строка(СтрокаПараметр.ИмяСтраницы)].Видимость = СтрокаПараметр.Пометка;
	КонецЦикла;
	
	Элементы.НадписьИзмененыДанныеПИРНИР.Видимость = Ложь;
	Элементы.НадписьИзмененыДанныеПНР.Видимость = Ложь;
	Элементы.НадписьИзмененыДанныеСМР.Видимость = Ложь;
	Элементы.НадписьИзмененыДанныеПрочие.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиПересчитатьСуммуКонтрактаПоВнешнейСтавке(ПараметрыРасчета, ЭлементФормы)
	
	ПараметрыОтбора = Новый Структура("СуммаКонтрактаРедактируетсяВручную", Истина);
	СтрокиДляПерерасчета = ПараметрыРасчета.НайтиСтроки(ПараметрыОтбора);
	
	Если ЗначениеЗаполнено(СтрокиДляПерерасчета) Тогда
		ЭлементФормы.Доступность = Истина;
	Иначе
		ЭлементФормы.Доступность = Ложь;
	КонецЕсли;		
			
КонецПроцедуры

#Область УниверсальныеОбработчики

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);	
	
КонецФункции

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);	
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3, П4,
		П5, П5, П6);
	
КонецФункции

