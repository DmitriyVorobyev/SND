КонецПроцедуры

&НаКлиенте
Процедура ОбработкаАктивизации(АктивныйОбъект, Источник)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаАктивизации(ЭтаФорма, АктивныйОбъект, Источник);		
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаЗаписиНового(ЭтаФорма, НовыйОбъект, Источник, СтандартнаяОбработка);		
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПередЗагрузкойДанныхИзНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОграничениеТипов(Элемент)
	
	ТекущиеДанные = Элементы.Индикаторы.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Элемент.ПодчиненныеЭлементы.ИндикаторыЗначениеИндикатора.ОграничениеТипа = ТекущиеДанные.ТипЗначенияИндикатора;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектнаяЗадачаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Проект) Тогда
		Сообщение = НСтр("ru = 'Укажите проект'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		Возврат;
	КонецЕсли;
	
	Пар = Новый Структура;
	Пар.Вставить("Проект",Проект);
	Пар.Вставить("ТекЗадача",ПроектнаяЗадача);
	Пар.Вставить("ВыбиратьТолькоЭтапы",Ложь);
	Пар.Вставить("ВозвращатьСсылкуНаЗеркальныйПроект",Истина);
	ОткрытьФорму("Обработка.упоВыборПроектнойЗадачи.Форма.ОсновнаяФормаУправляемая",Пар,ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектнаяЗадачаПриИзменении(Элемент)
	
	ЗаполнитьГруппуПроект(ПроектнаяЗадача);
		
КонецПроцедуры

&НаКлиенте
Процедура ПроектНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбораПроекта = Новый Структура("РежимВыбора", Истина);
	ПараметрыВыбораПроекта.Вставить("ЭтоФормаВыбораПроекта", Истина);
	ПараметрыВыбораПроекта.Вставить("ТекущаяСтрока", ЭтаФорма.Проект);
			
	ФормаВыбора = ПолучитьФорму("Справочник.Проекты.ФормаВыбора", ПараметрыВыбораПроекта, ЭтаФорма);	
		
	ФормаВыбора.Открыть();	
		
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Проект) Тогда
		ПроектнаяЗадача = Неопределено;
		Объект.Проект = Неопределено;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИндикаторы

&НаКлиенте
Процедура ИндикаторыИндикаторПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Индикаторы.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		ПривестиТипИндикатораВСтроке(ТекущаяСтрока);
		
	КонецЕсли;           
	
	ТекущаяСтрока.ЗначениеИндикатора = Неопределено;
	УстановитьДляЭлементаОграничениеТипа(Элементы.ИндикаторыЗначениеИндикатора, ТекущаяСтрока.Индикатор);

КонецПроцедуры

&НаКлиенте
Процедура ИндикаторыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	УстановитьОграничениеТипов(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ИндикаторыПередНачаломИзменения(Элемент, Отказ)
	
	УстановитьОграничениеТипов(Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ИндикаторыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, "Индикатор",
		Объект.Индикаторы, ЭтаФорма, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ИндикаторыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение, "Индикатор",
		Объект.Индикаторы, ЭтаФорма, Истина);		

КонецПроцедуры

&НаКлиенте
Процедура ИндикаторыЗначениеИндикатораНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Индикаторы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	УстановитьДляЭлементаОграничениеТипа(Элементы.ИндикаторыЗначениеИндикатора, ТекДанные.Индикатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ИндикаторыПриАктивизацииСтроки(Элемент)  
	
	ТекДанные = Элементы.Индикаторы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	УстановитьДляЭлементаОграничениеТипа(Элементы.ИндикаторыЗначениеИндикатора, ТекДанные.Индикатор);    

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТаблицаИндикаторыПодобрать(Команда)
	
	ПараметрыПодбора = ПодготовитьДопПараметры(Команда.Имя);
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);		

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндикаторыЗаполнить(Команда)
	
	Если Объект.Индикаторы.Количество() > 0 Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ТаблицаИндикаторыЗаполнитьЗавершение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения,"Табличная часть будет очищена и заполнена заново. Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ТаблицаИндикаторыЗаполнитьЗавершение(Неопределено,Неопределено);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндикаторыЗаполнитьЗавершение(Ответ,ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		Объект.Индикаторы.Очистить();
	КонецЕсли;
	
	ТаблицаИндикаторыЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИндикаторыЗаполнитьНаСервере()
	
	Результат = РезультатЗапросаПолучитьИндикаторыПроекта(Объект.Проект);
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Индикаторы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ПривестиТипИндикатораВСтроке(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндикаторыПересчитать(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И Объект.Проведен Тогда 
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ТаблицаИндикаторыПересчитатьЗавершение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения, "Для пересчета данных табличной части необходимо отменить проведение документа. Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ТаблицаИндикаторыПересчитатьЗавершение(Неопределено, Неопределено);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндикаторыПересчитатьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда		
		ВызватьОтменуПроведения();
		Прочитать();
	КонецЕсли;	
	
	ТаблицаИндикаторыПересчитатьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИндикаторыПересчитатьНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ПересчитатьИндикаторы();
		
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	Для каждого СтрИндикатор Из Объект.Индикаторы Цикл
		ПривестиТипИндикатораВСтроке(СтрИндикатор);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВызватьОтменуПроведения()
	
	Если Объект.Проведен Тогда
		ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ОтменитьПроведениеДокумента();
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруСвойствИндикатора(ИндикаторСсылка)
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("ТипЗначенияИндикатора");
	
	ДанныеИндикатора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИндикаторСсылка, "ВидЗаполнения, ТипИндикатора, ТипСсылки");
	
	СтруктураСвойств.Вставить("ВидЗаполненияИндикатора", ДанныеИндикатора.ВидЗаполнения);
	
	МассивТипов =  Новый Массив;
	КЧ = Новый КвалификаторыЧисла(15, 3);
	КД = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	КС = Новый КвалификаторыСтроки(100);

	
	Если ДанныеИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
		
		МассивТипов.Добавить(Тип("Число"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов, КЧ);
		
	ИначеЕсли ДанныеИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
		
		МассивТипов.Добавить(Тип("Дата"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов,,, КД);
		
	ИначеЕсли ДанныеИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
		
		МассивТипов.Добавить(Тип("Булево"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов);
		
	ИначеЕсли ДанныеИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
		
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов,, КС);		
		
	ИначеЕсли ДанныеИндикатора.ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда
		
		МассивТипов = упоПанельПоказателейКлиентСервер.ПолучитьМассивТиповПоТипуСсылки(ДанныеИндикатора.ТипСсылки);
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов);	
		
	Иначе
		
		МассивТипов.Добавить(Тип("Число"));
		МассивТипов.Добавить(Тип("Дата"));
		МассивТипов.Добавить(Тип("Булево"));
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТиповВсеСсылки = ОбщегоНазначения.ОписаниеТипаВсеСсылки();
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(ОписаниеТиповВсеСсылки, МассивТипов,, КЧ, КС, КД);		
		
	КонецЕсли;
	
	СтруктураСвойств.ТипЗначенияИндикатора = ОписаниеТиповИндикатор;
	
	Возврат СтруктураСвойств;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьКорректностьЗаполнения(Отказ)
		
	МассивПоказателей = ПолучитьПоказателиПроекта(Объект.Проект);
	
	МассивСтрокНесоответствующихПоказателей = Новый Массив();
	Для каждого СтрПоказатель Из Объект.Индикаторы Цикл
		Индикатор = СтрПоказатель.Индикатор;
		Если МассивПоказателей.Найти(Индикатор) = Неопределено Тогда
			МассивСтрокНесоответствующихПоказателей.Добавить(СтрПоказатель.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Ошибки = Неопределено;
	Для Инд = 0 По МассивСтрокНесоответствующихПоказателей.ВГраница() Цикл
		СтрокаОшибки = МассивСтрокНесоответствующихПоказателей[Инд];
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.Индикаторы[%1].Индикатор",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Принадлежность показателя ""%1"" не соответствует выбранному проекту/проектной задаче.'"),
				Объект.Индикаторы[СтрокаОшибки - 1].Индикатор),
			"Объект.Индикаторы",
			СтрокаОшибки - 1,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Принадлежность показателя ""%1"" не соответствует выбранному проекту/проектной задаче.'"),
				Объект.Индикаторы[СтрокаОшибки - 1].Индикатор));
	КонецЦикла;
			
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоказателиПроекта(Проект)
		
	РезультатЗапроса = РезультатЗапросаПолучитьИндикаторыПроекта(Проект);
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Индикатор");
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатЗапросаПолучитьИндикаторыПроекта(Проект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ПоказателиПроектов.Ссылка КАК Индикатор
					|ИЗ
					|	Справочник.упоПоказателиПроектов КАК ПоказателиПроектов
					|ГДЕ
					|	(НЕ ПоказателиПроектов.ЭтоГруппа)
					|	И НЕ ПоказателиПроектов.ВидЗаполнения = &ВидЗаполнения 
					|	И (ПринадлежностьПоказателя = Значение(Перечисление.упоПринадлежностьПоказателя.Общий)
					|		ИЛИ ПринадлежностьПоказателя В  (&ПринадлежностьПоказателя))
					|	И (НЕ ПоказателиПроектов.ПометкаУдаления)";
	
	Запрос.УстановитьПараметр("ВидЗаполнения", Перечисления.упоВидЗаполненияИндикатора.Автоматически);
	МассивПринадлежностьПоказателя = Новый Массив;
	МассивПринадлежностьПоказателя.Добавить(?(Проект.ЭтоПроектнаяЗадача,
		Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроектнойЗадачи,
		Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроекта));	
	Запрос.УстановитьПараметр("ПринадлежностьПоказателя", МассивПринадлежностьПоказателя);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПривестиТипИндикатораВСтроке(СтрокаТаблицы) 
	
	СтруктураДопСвойствИндикатора = ПолучитьСтруктуруСвойствИндикатора(СтрокаТаблицы.Индикатор);
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураДопСвойствИндикатора);
	ТипЗнчИндикатора = ТипЗнч(СтрокаТаблицы.ЗначениеИндикатора);
	
	Если Не СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(ТипЗнчИндикатора) Тогда
		
		Если СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Булево")) Тогда
			
			СтрокаТаблицы.ЗначениеИндикатора = Ложь;
			
		ИначеЕсли СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Число")) Тогда 
			
			СтрокаТаблицы.ЗначениеИндикатора = 0;
			
		ИначеЕсли СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Дата")) Тогда 
			
			СтрокаТаблицы.ЗначениеИндикатора = Дата(1, 1, 1);
			
		ИначеЕсли СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Строка")) Тогда 	
			
			СтрокаТаблицы.ЗначениеИндикатора = "";
			
		Иначе
		
			СтрокаТаблицы.ЗначениеИндикатора = Неопределено;
			
		КонецЕсли;			
		
	КонецЕсли;
	
КонецФункции

