// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#Область УниверсальныеОбработчики

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);	
	
КонецФункции

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);	
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3, П4,
		П5, П5, П6);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДляЭлементаОграничениеТипа(Элемент, Индикатор)
	
	Элемент.ОграничениеТипа = Новый ОписаниеТипов;
	Элемент.ВыбиратьТип = Истина;  
	
	Если Не ЗначениеЗаполнено(Индикатор) Тогда     
		Возврат;
	КонецЕсли;     

	ОграничениеТипа = ПолучитьТипИндикатора(Индикатор);    
	
	Если ОграничениеТипа = Неопределено Тогда     
		Возврат;
	КонецЕсли;     
	
	Элемент.ОграничениеТипа = ОграничениеТипа;
	Элемент.ВыбиратьТип = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипИндикатора(Индикатор)
	
	ОграничениеТипа = Неопределено;
	Если Индикатор.ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
		ОграничениеТипа = Новый ОписаниеТипов("Дата");
	ИначеЕсли Индикатор.ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
		ОграничениеТипа = Новый ОписаниеТипов("Булево");
	ИначеЕсли Индикатор.ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
		ОграничениеТипа = Новый ОписаниеТипов("Строка");
	ИначеЕсли Индикатор.ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
		ОграничениеТипа = Новый ОписаниеТипов("Число");
	ИначеЕсли Индикатор.ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда
		СсылкаИндикатор = ТипЗнч(Индикатор.ТипСсылки); 
		Если СсылкаИндикатор = Тип("Неопределено") Тогда
			Возврат ОграничениеТипа;
		КонецЕсли;
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(СсылкаИндикатор);	
		ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);	
	КонецЕсли;
	
	Возврат ОграничениеТипа;
	
КонецФункции

