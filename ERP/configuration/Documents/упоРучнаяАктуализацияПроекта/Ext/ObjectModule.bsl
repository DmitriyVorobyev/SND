// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	ПравилаНаложения = Новый Структура();
	
	// Для каждого из регистров описывается, по какой из таблиц документа
	// строится список движений, и какие реквизиты куда записать.
	
	// Правила для регистра "СтатусыПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСтатусыПроектныхЗадач.Метаданные().Имя, Правила);
	
	// Правила для табличной части "ПроектныеЗадачи" документа.
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить(Метаданные().ТабличныеЧасти.ПроектныеЗадачи.Имя, ПравилаТаблицы);
		
	// Делаем одно движение по ТЧ документа.
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ИзменениеСтатуса", ПравилаДвижения);
		
	// Правила связи.
	ПравилаДвижения.Вставить("Версия", Новый Структура("Значение", текущаяВерсия));
	ПравилаДвижения.Вставить("ПроектнаяЗадача", "ПроектнаяЗадача");
	ПравилаДвижения.Вставить("СтатусЗадачи"   , "Статус");
	
	// Правила для регистра "ПроцентыГотовностиПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоПроцентыГотовностиПроектныхЗадач.Метаданные().Имя, Правила);
	
	// Правила для табличной части "ПроектныеЗадачи" документа.
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить(Метаданные().ТабличныеЧасти.ПроектныеЗадачи.Имя, ПравилаТаблицы);
	
	// Правила для регистра "ПроцентыГотовностиПроектов".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоПроцентыГотовностиПроектов.Метаданные().Имя, Правила);
		
	// Делаем одно движение по ТЧ документа.
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ИзменениеПроцентаГотовности", ПравилаДвижения);
		
	// Правила связи.
	ПравилаДвижения.Вставить("Версия", Новый Структура("Значение", текущаяВерсия));
	ПравилаДвижения.Вставить("ПроектнаяЗадача"  , "ПроектнаяЗадача");
	ПравилаДвижения.Вставить("ПроцентГотовности", "ПроцентГотовности");
	
	// Правила для регистра "упоФактическиеДатыНачалаИОкончанияПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.Метаданные().Имя, Правила);
	
	// Правила для табличной части "ПроектныеЗадачи" документа.
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить(Метаданные().ТабличныеЧасти.ПроектныеЗадачи.Имя, ПравилаТаблицы);
	
	// Делаем одно движение по ТЧ документа.
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ИзменениеФактическихДат", ПравилаДвижения);
	
	// Правила связи.
	ПравилаДвижения.Вставить("Версия", Новый Структура("Значение", текущаяВерсия));
	ПравилаДвижения.Вставить("ПроектнаяЗадача"  , "ПроектнаяЗадача");
	ПравилаДвижения.Вставить("ДатаНачала", "ДатаНачалаФакт");
	ПравилаДвижения.Вставить("ДатаЗавершения", "ДатаЗавершенияФакт");
	
	// Возвращаем полученные правила.
	Возврат ПравилаНаложения; 

КонецФункции
 
