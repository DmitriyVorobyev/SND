// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный - значение, которое используется как основание для заполнения.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если ТипЗнч(Основание) = Тип("Неопределено") Тогда
		Проект = ПараметрыСеанса.упоТекущийПроект;
		Возврат;
    КонецЕсли; 
    
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
    
    Если ТипЗнч(Основание) = Тип("Структура") Тогда
        Если Основание.Свойство("Проект") Тогда
            Проект = Основание.Проект;
            упоПроектыИЗадачиСервер.ПроверитьТипПроекта(Проект);
        КонецЕсли;        
    КонецЕсли;
    
	Если ТипЗнч(Основание) = Тип("СправочникСсылка.Проекты") Тогда
		Проект = Основание;
		упоПроектыИЗадачиСервер.ПроверитьТипПроекта(Проект);
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда 
		
		ЭтотОбъект.Проект = Основание.Проект;
		ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ЭтотОбъект.Проект);
		
		НоваяСтрока = ПроектныеЗадачи.Добавить();
		НоваяСтрока.ПроектнаяЗадача = Основание;
		
		ДанныеПроектнойЗадачи = ПолучитьДанныеПроектнойЗадачи(Основание, ТекущаяВерсия);
		
		Если ДанныеПроектнойЗадачи <> Неопределено Тогда 
			НоваяСтрока.Статус				= ДанныеПроектнойЗадачи.СтатусЗадачи;
			НоваяСтрока.ПроцентГотовности 	= ДанныеПроектнойЗадачи.ПроцентГотовности; 
			НоваяСтрока.ДатаНачалаФакт		= ДанныеПроектнойЗадачи.ДатаНачалаФакт;
			НоваяСтрока.ДатаЗавершенияФакт 	= ДанныеПроектнойЗадачи.ДатаЗавершенияФакт;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

