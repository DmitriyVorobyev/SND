Функция ПолучитьДанныеПроектнойЗадачи(ПроектнаяЗадача, ТекущаяВерсия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ДатаНачала КАК ДатаНачала,
	               |	упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ДатаЗавершения КАК ДатаЗавершения,
	               |	упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ПОМЕСТИТЬ втФактическиеСроки
	               |ИЗ
	               |	РегистрСведений.упоФактическиеДатыНачалаИОкончанияПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоФактическиеДатыНачалаИОкончанияПроектныхЗадачСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачи,
	               |	упоПроцентыГотовностиПроектныхЗадачСрезПоследних.ПроцентГотовности КАК ПроцентГотовности,
	               |	втФактическиеСроки.ДатаНачала КАК ДатаНачалаФакт,
	               |	втФактическиеСроки.ДатаЗавершения КАК ДатаЗавершенияФакт
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних(
	               |				,
	               |				Версия = &Версия
	               |					И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоПроцентыГотовностиПроектныхЗадачСрезПоследних
	               |		ПО упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача = упоПроцентыГотовностиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втФактическиеСроки КАК втФактическиеСроки
	               |		ПО упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача = втФактическиеСроки.ПроектнаяЗадача";
	
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("Версия", ТекущаяВерсия);
	
	Результат = Запрос.Выполнить();
	
	Возврат ?(Результат.Пустой(), Неопределено, Результат.Выгрузить()[0]);
	
КонецФункции

