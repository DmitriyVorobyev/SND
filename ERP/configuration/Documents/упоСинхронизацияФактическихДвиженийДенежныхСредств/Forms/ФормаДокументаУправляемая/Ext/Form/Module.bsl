#Область ОбработчикиСобытийЭлементовТаблицыФормыДвиженияДенежныхСредств

&НаКлиенте
Процедура ДвиженияДенежныхСредствНаправлениеДвиженияПриИзменении(Элемент)
	
	текДанные = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	упоРаботаСФормамиКлиент.УстановитьИконкуНаправленияВТаблицеДДС(текДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствСтатьяДДСПриИзменении(Элемент)
	
	текДанные = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	
	УстановитьНаправлениеДС(текДанные);	
		
	упоРаботаСФормамиКлиент.УстановитьИконкуНаправленияВТаблицеДДС(текДанные);
			
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекСтрока = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
		
		Если ТекСтрока <> Неопределено И НоваяСтрока Тогда
			
			ПараметрыПодбораСтруктура = Неопределено;
			ПодготовитьДопПараметрыСтруктурыПодбора(ПараметрыПодбораСтруктура, "ДвиженияДенежныхСредств");		
			
			ЗаполнитьЗначенияСвойств(ПараметрыПодбораСтруктура.СтруктураСтроки, ТекСтрока);			
			упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодборе(ПараметрыПодбораСтруктура.СтруктураСтроки,
				ПараметрыПодбораСтруктура.ПараметрыПодбораСписок, ПараметрыПодбораСтруктура.СвойстваОбъекта);
			ЗаполнитьЗначенияСвойств(ТекСтрока, ПараметрыПодбораСтруктура.СтруктураСтроки);
			
			Если ПараметрыПодбораСтруктура.СтруктураСтроки.Свойство("НаправлениеДвижения") Тогда
				
				упоРаботаСФормамиКлиент.УстановитьИконкуНаправленияВТаблицеДДС(ТекСтрока);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПроектнаяЗадачаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	       
	ЗаполнитьНаименованиеВСтрокеТЧ(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствСсылкаНаРегистраторОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	 	  
	ТекДанные = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
			
	СтрокаТЧ = "Объект.ДвиженияДенежныхСредств[" + Строка(ТекДанные.НомерСтроки - 1) + "].СсылкаНаРегистратор";
	ПараметрыПерехода = Новый Структура;
	ПараметрыПерехода.Вставить("СсылкаНаРегистратор", 	  		 ТекДанные.СсылкаНаРегистратор);
	ПараметрыПерехода.Вставить("ПолеНаФормеСсылкаНаРегистратор", СтрокаТЧ);
	ПараметрыПерехода.Вставить("ИсточникДанных", 		  		 Объект.ИсточникДанных);
	ПараметрыПерехода.Вставить("ПолеНаФормеИсточникДанных", 	 "Объект.ИсточникДанных");
	упоИнтеграцияКлиент.ПерейтиПоСсылкеНаРегистратор(ПараметрыПерехода);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствДоговорПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПриИзмененииДоговора(ЭтаФорма,"ДвиженияДенежныхСредств");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборВТЧФормы(Команда)
	
	ПараметрыПодбора = ПодготовитьДопПараметры(Команда.Имя);
	
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);		
	
КонецПроцедуры

&НаКлиенте
Процедура ДДС_ПараметрыПодбора_Направление(Команда)
	
	Если Команда.Имя = "ДДС_ПараметрыПодбора_НаправлениеВыплата" Тогда
		
		Элементы.ДДС_ПараметрыПодбора_НаправлениеВыплата.Пометка = Истина;
		Элементы.ДДС_ПараметрыПодбора_НаправлениеПоступление.Пометка = Ложь;
		
	ИначеЕсли Команда.Имя = "ДДС_ПараметрыПодбора_НаправлениеПоступление" Тогда
		
		Элементы.ДДС_ПараметрыПодбора_НаправлениеВыплата.Пометка = Ложь;
		Элементы.ДДС_ПараметрыПодбора_НаправлениеПоступление.Пометка = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры(имяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	
	АдресХранилища = "";
	
	Если  имяКоманды = "ДействиеПодобрать_ДДС_ПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ДвиженияДенежныхСредств;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.СтатьиДвиженияДенежныхСредств";
		ТаблицаФормы = Объект.ДвиженияДенежныхСредств;
		ИмяКолонки = "СтатьяДДС";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ДДС_ПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ДвиженияДенежныхСредств;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.Контрагенты";
		ТаблицаФормы = Объект.ДвиженияДенежныхСредств;
		ИмяКолонки = "Контрагент";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	КонецЕсли;
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы, ИмяКолонки,
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
	
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
	
	Возврат ПараметрыПодбора;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьНаименованиеВСтрокеТЧ(СтрокаТЧ) 
	
	Если ЗначениеЗаполнено(СтрокаТЧ.ПроектнаяЗадача) Тогда
		СтрокаТЧ.НазваниеПроектнойЗадачи = упоПроектыИЗадачиВызовСервера.НазваниеПроектнойЗадачи(СтрокаТЧ.ПроектнаяЗадача);
	Иначе
		СтрокаТЧ.НазваниеПроектнойЗадачи = "";
	КонецЕсли;
	
КонецФункции

#Область УниверсальныеОбработчики

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);	
	
