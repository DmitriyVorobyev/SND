
#Область ОписаниеПеременных

&НаКлиенте
Перем ПеременныеКлиента; // Хранит настройки выбора для поля ПериодПредставление.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства   
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтотОбъект, Объект, Отказ, СтандартнаяОбработка);
	
	ИнициализацияФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбновитьНадписьПоследняяМодификация();
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтотОбъект, Объект);
	
	ОбновитьСоответствиеУровнейДерева();
	НастроитьСписокВыбораУровнейГруппировок(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтотОбъект, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтотОбъект, ВыбранноеЗначение, ИсточникВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтотОбъект, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства 
    
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
		
	ЗаписатьДеревоПроектныхЗадачВТабличнуюЧасть(ДеревоПроектныеЗадачи, ТекущийОбъект.ПроектныеЗадачи, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
    
    // СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды     
    
    ОбновитьНадписьПоследняяМодификация();
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗакрытием(ЭтотОбъект, Объект, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриЗакрытии(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаОповещения(ЭтотОбъект, Объект, ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "Задания_СтатусЗаданияИзменен" Тогда        
        ОбновитьСтатусСогласования();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	упоОбработчикиСобытийКлиент.ФормаВнешнееСобытие(ЭтотОбъект, Объект, Источник, Событие, Данные);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПриЗагрузкеДанныхИзНастроекНаСервере(ЭтотОбъект, Объект, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПриСохраненииДанныхВНастройкахНаСервере(ЭтотОбъект, Объект, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, Объект, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаАктивизации(АктивныйОбъект, Источник)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаАктивизации(ЭтотОбъект, АктивныйОбъект, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаЗаписиНового(ЭтотОбъект, НовыйОбъект, Источник, СтандартнаяОбработка);
	
    Если ТипЗнч(Источник) = Тип("ФормаКлиентскогоПриложения") 
        И Источник.ИмяФормы = "Справочник.упоЗадания.Форма.ФормаЭлемента" 
        И Источник.Объект.ОбъектБазы = Объект.Ссылка Тогда        
        ОбновитьСтатусСогласования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	ОбновитьСтатусСогласования();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПередЗагрузкойДанныхИзНастроекНаСервере(ЭтотОбъект, Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбораФормы = Новый Структура;
	
	// Для выбора значения.
	ЗначениеПериода = Новый СтандартныйПериод;
	ЗначениеПериода.ДатаНачала = Объект.НачалоПериода;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПериода.ДатаНачала) Тогда
		ЗначениеПериода.ДатаНачала = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;
	
	ПараметрыВыбораФормы.Вставить("Значение", ЗначениеПериода);
	ПараметрыВыбораФормы.Вставить("Элемент", Элемент);
	
	// Для загрузки значения.
	ПараметрыВыбораФормы.Вставить("ПериодПредставлениеИмя", "ПериодПредставление");
	ПараметрыВыбораФормы.Вставить("ПериодЗначениеИмя", "НачалоПериода");
	ПараметрыВыбораФормы.Вставить("ИспользованиеИмя", "ПериодИспользование");
	Если ПериодСогласованияЧасов = ПредопределенноеЗначение("Перечисление.упоПериодыСогласованияТрудозатрат.Неделя") Тогда
		ПараметрыВыбораФормы.Вставить("ВидПериода", ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Неделя"));
	Иначе
		ПараметрыВыбораФормы.Вставить("ВидПериода", ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"));
	КонецЕсли;
	
	ВыборПериодаИзВыпадающегоСписка(-1, ПараметрыВыбораФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПредставлениеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПроектНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.РуководительПроекта) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("РуководительПроекта", Объект.РуководительПроекта));
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("СкрыватьЭтапы", Истина);
		
		ОткрытьФорму("Справочник.Проекты.Форма.упоФормаСпискаУправляемая", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
		ОбновитьТаблицуСДанными(Истина); 
		Возврат;
	КонецЕсли;
	
	Объект.РуководительПроекта = упоИерархияИПолномочияСервер.ПолучитьРуководителяПроекта(Объект.Проект);
	
	ОбновитьТаблицуСДанными();
	
КонецПроцедуры 

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
    
    Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
        ОбновитьТаблицуСДанными(Истина); 
        Возврат;
    КонецЕсли;
    
	Объект.РуководительПодразделения = упоИерархияИПолномочияСервер.ПолучитьРуководителяПодразделенияПоИерархии(
        Объект.Подразделение);
        
	ОбновитьТаблицуСДанными();
        
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.РуководительПодразделения) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		МассивПодразделенийРуководителя = 
        упоИерархияИПолномочияСервер.ПолучитьПодразделенияРуководителяБезИерархии(Объект.РуководительПодразделения);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Ссылка", МассивПодразделенийРуководителя));
		
		ОткрытьФорму("Справочник.упоПодразделения.ФормаВыбора", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтатусСогласованияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, СогласованиеСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура УровеньГруппировокПриИзменении(Элемент)
	
	упоОперацииСДеревьямиКлиент.РазвернутьДеревоДоУровня(Элементы.ДеревоПроектныеЗадачи, 
		ЭтотОбъект.УровеньГруппировок, 
		ЭтотОбъект.СоотвУровняДерева);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоПроектныеЗадачи

&НаКлиенте
Процедура ДеревоПроектныеЗадачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ДеревоПроектныеЗадачиАктируемыйЭтап" Тогда
		Если ТекДанные.ЭтоТрудовойРесурс Тогда
			ПоказатьЗначение(, ТекДанные.Сотрудник);
		ИначеЕсли ТекДанные.ЭтоПроект Тогда
			ПоказатьЗначение(, ТекДанные.ПроектнаяЗадача);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПроектныеЗадачиАктируемыйЭтапНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПроектныеЗадачиАктируемыйЭтапОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПроектныеЗадачиЧасыПризнОкончПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоПроектныеЗадачи.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДоступноЧасов = ТекДанные.ЧасыУказанные - ТекДанные.ЧасыНеПризнОконч;
	Если ТекДанные.ЧасыПризнОконч > ДоступноЧасов Тогда
		ТекДанные.ЧасыПризнОконч = ДоступноЧасов;
	КонецЕсли;
	
	ТекДанные.ЧасыОтклОконч = 
		ТекДанные.ЧасыУказанные - ТекДанные.ЧасыПризнОконч - ТекДанные.ЧасыНеПризнОконч;
	ТекДанные.СтоимостьПризнОконч = ТекДанные.ЧасыПризнОконч * ТекДанные.СтавкаПризнОконч;
	
	ПересчитатьИтогиТаблицыПроектныеЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПроектныеЗадачиЧасыНеПризнОкончПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоПроектныеЗадачи.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДоступноЧасов = ТекДанные.ЧасыУказанные - ТекДанные.ЧасыПризнОконч;
	Если ТекДанные.ЧасыНеПризнОконч > ДоступноЧасов Тогда
		ТекДанные.ЧасыНеПризнОконч = ДоступноЧасов;
	КонецЕсли;
	
	ТекДанные.ЧасыОтклОконч = ТекДанные.ЧасыУказанные - ТекДанные.ЧасыПризнОконч - ТекДанные.ЧасыНеПризнОконч;
	ТекДанные.СтоимостьНеПризнОконч = ТекДанные.ЧасыНеПризнОконч * ТекДанные.СтавкаНеПризнОконч;
	
	ПересчитатьИтогиТаблицыПроектныеЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПроектныеЗадачиНормаСтоимостиПризнОкончПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоПроектныеЗадачи.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.СтавкаПризнОконч = ПолучитьСтоимостьПоНорме(ТекДанные.Сотрудник, 
		ТекДанные.НормаСтоимостиПризнОконч, ПериодСогласованияЧасов, Объект.НачалоПериода);
	ТекДанные.СтоимостьПризнОконч = ТекДанные.ЧасыПризнОконч * ТекДанные.СтавкаПризнОконч;
	
	ПересчитатьИтогиТаблицыПроектныеЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПроектныеЗадачиНормаСтоимостиНеПризнОкончПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоПроектныеЗадачи.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.СтавкаНеПризнОконч = ПолучитьСтоимостьПоНорме(ТекДанные.Сотрудник, 
		ТекДанные.НормаСтоимостиНеПризнОконч, ПериодСогласованияЧасов, Объект.НачалоПериода);
	ТекДанные.СтоимостьНеПризнОконч = ТекДанные.ЧасыНеПризнОконч * ТекДанные.СтавкаНеПризнОконч;
	
	ПересчитатьИтогиТаблицыПроектныеЗадачи();
	
КонецПроцедуры

