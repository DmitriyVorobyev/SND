&НаКлиенте
Процедура КомандаСогласоватьТрудозатраты(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекстСообщения = НСтр("ru = 'Для согласования необходимо записать документ.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	СогласующийРуководитель = ПолучитьОдинИзТрудовыхРесурсовРуководителяПодразделения(Объект.Подразделение);
	
	ПараметрыСогласования = Новый Структура;
	ПараметрыСогласования.Вставить("ОбъектБазы", Объект.Ссылка);
	ПараметрыСогласования.Вставить("Наименование", НСтр("ru = 'Согласовать документ: '") + Объект.Ссылка);
	ПараметрыСогласования.Вставить("ВидЗадания", ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование"));
	ПараметрыСогласования.Вставить("СогласующийРуководитель", СогласующийРуководитель);
	
	ОткрытьФорму("Справочник.упоЗадания.Форма.ФормаЭлемента", 
		Новый Структура("ЗначенияЗаполнения", ПараметрыСогласования), ЭтотОбъект);
	
КонецПроцедуры

