&НаСервере
Процедура ИнициализацияФормы()
	
	ЗаполнитьСтруктуруНастроек(Настройки);
	
	ЗаполнитьПериодНаФорме();
	
	ВыводитьИерархиюЗадач = Ложь;
	ВыводитьПодразделение = Истина;
	ВыводитьВидыОпераций = Константы.упоУчетСогласованныхТрудозатратПоВидамОпераций.Получить();
	
	Элементы.ДеревоПроектныеЗадачиВыводитьИерархиюЗадач.Пометка = ВыводитьИерархиюЗадач;
	Элементы.ДеревоПроектныеЗадачиВыводитьПодразделение.Пометка = ВыводитьПодразделение;
	
	УстановитьВидимостьДоступностьЭлементовФормы();
	
		
	ДанныеФормыИзОбъекта();
	
	АдаптироватьНаименованияКолонок();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементовФормы()
	
	Если ЭтотОбъект.ТолькоПросмотр Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
			"СогласоватьРуководителемПодразделения", "Доступность", Ложь);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьДатыЗапретаИзменения") Тогда
		Если Не ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.ДатыЗапретаИзменения) Тогда
			Элементы.КомандаОткрытьДатыЗапретаИзмененияДанных.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АдаптироватьНаименованияКолонок()
	
	СтруктураКолонок = СтруктураКолонокСПереносомЗаголовков();
	
	Для Каждого КлючЗначение Из СтруктураКолонок Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
			"ДеревоПроектныеЗадачи" + КлючЗначение.Ключ, "Заголовок", КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СтруктураКолонокСПереносомЗаголовков()
	
	СтруктураКолонок = Новый Структура;
	СтруктураКолонок.Вставить("СтоимостьИтог", НСтр("ru = 'Стоимость
		|итог'"));
	СтруктураКолонок.Вставить("ПлановыйОбъем", НСтр("ru = 'Объем
		|(план)'"));
	СтруктураКолонок.Вставить("ЧасыУказанные", НСтр("ru = 'Часы
		|указанные'"));
	СтруктураКолонок.Вставить("ЧасыПризнОконч", НСтр("ru = 'Часы
		|согласованные'"));
	СтруктураКолонок.Вставить("ЧасыНеПризнОконч", НСтр("ru = 'Часы
		|по затратной'"));
	СтруктураКолонок.Вставить("СтавкаНеПризнОконч", НСтр("ru = 'Ставка
		|(по затратной)'")); 
		СтруктураКолонок.Вставить("НормаСтоимостиНеПризнОконч", НСтр("ru = 'Норма стоимости
		|(по затратной)'"));
	СтруктураКолонок.Вставить("СтоимостьНеПризнОконч", НСтр("ru = 'Стоимость
		|(по затратной)'"));
	СтруктураКолонок.Вставить("ЧасыОтклОконч", НСтр("ru = 'Часы
		|отклонены'"));
	
	Возврат СтруктураКолонок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОдинИзТрудовыхРесурсовРуководителяПодразделения(пПодразделение) 
	
	Результат = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(пПодразделение) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СпрПодр.Родитель = ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)
		|			ТОГДА СпрПодр.Ссылка
		|		КОГДА СпрПодр.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)
		|			ТОГДА СпрПодр.Родитель
		|		КОГДА СпрПодр.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)
		|			ТОГДА СпрПодр.Родитель.Родитель
		|		КОГДА СпрПодр.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)
		|			ТОГДА СпрПодр.Родитель.Родитель.Родитель
		|		КОГДА СпрПодр.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.упоПодразделения.ПустаяСсылка)
		|			ТОГДА СпрПодр.Родитель.Родитель.Родитель.Родитель
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК Родитель
		|ПОМЕСТИТЬ ПодрРодитель
		|ИЗ
		|	Справочник.упоПодразделения КАК СпрПодр
		|ГДЕ
		|	СпрПодр.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	упоРуководителиПодразделенийСрезПоследних.Руководитель
		|ПОМЕСТИТЬ Руководители
		|ИЗ
		|	РегистрСведений.упоРуководителиПодразделений.СрезПоследних(
		|			,
		|			Подразделение В
		|				(ВЫБРАТЬ
		|					ПодрРодитель.Родитель
		|				ИЗ
		|					ПодрРодитель КАК ПодрРодитель)) КАК упоРуководителиПодразделенийСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(упоВладениеРесурсамиСрезПоследних.Ресурс) КАК Ресурс
		|ИЗ
		|	РегистрСведений.упоВладениеРесурсами.СрезПоследних(
		|			,
		|			Сотрудник В
		|				(ВЫБРАТЬ
		|					Руководители.Руководитель
		|				ИЗ
		|					Руководители)) КАК упоВладениеРесурсамиСрезПоследних
		|ГДЕ
		|	упоВладениеРесурсамиСрезПоследних.ВладеетРесурсом";
		
		Запрос.УстановитьПараметр("Ссылка", пПодразделение);	
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Результат = Выборка.Ресурс;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьСтатусСогласования()
	
	СсылкаНаОбъект = Объект.Ссылка;
	СогласованиеСтатусЭлемент = Элементы.СогласованиеСтатус;
	
	Результат = Перечисления.упоСтатусыЗаданий.ПустаяСсылка();
	РезультатСсылка = Справочники.упоЗадания.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	упоЗадания.Ссылка КАК Ссылка
		               |ПОМЕСТИТЬ втЗадания
		               |ИЗ
		               |	Справочник.упоЗадания КАК упоЗадания
		               |ГДЕ
		               |	упоЗадания.ОбъектБазы = &СогласуемыйДокумент
		               |	И упоЗадания.ЭтоСогласованиеРодитель
		               |	И НЕ упоЗадания.ПометкаУдаления
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	упоЗаданияСтатусыСрезПоследних.Задание КАК Задание,
		               |	упоЗаданияСтатусыСрезПоследних.Статус КАК Статус,
		               |	упоЗаданияСтатусыСрезПоследних.Период КАК Период
		               |ИЗ
		               |	РегистрСведений.упоЗаданияСтатусы.СрезПоследних(
		               |			,
		               |			Задание В
		               |				(ВЫБРАТЬ
		               |					втЗадания.Ссылка КАК Ссылка
		               |				ИЗ
		               |					втЗадания КАК втЗадания)) КАК упоЗаданияСтатусыСрезПоследних
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Период УБЫВ";
		
		Запрос.УстановитьПараметр("СогласуемыйДокумент", СсылкаНаОбъект);
		
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			Результат = Выборка.Статус;
			РезультатСсылка = Выборка.Задание;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		СогласованиеСтатусЭлемент.Видимость = Истина;
		СогласованиеСтатус = Результат;
	Иначе
		СогласованиеСтатусЭлемент.Видимость = Ложь;
		СогласованиеСтатус = НСтр("ru = ''");
	КонецЕсли;
	СогласованиеСсылка = РезультатСсылка;
	
КонецПроцедуры

