#Область УровниГруппировки

&НаКлиенте
Процедура ОбновитьСоответствиеУровнейДерева()
	
	врСоотвУровняДерева = Новый Соответствие;
	КоличествоУровней = 
		упоОперацииСДеревьямиКлиент.ПолучитьКоличествоУровнейДерева(ДеревоПроектныеЗадачи, , врСоотвУровняДерева);
	СоотвУровняДерева = Новый ФиксированноеСоответствие(врСоотвУровняДерева);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьСписокВыбораУровнейГруппировок(Форма, ЗаполнитьУровень = Истина)
	
	Элемент_УровеньГруппировок = Форма.Элементы.УровеньГруппировок;
	
	Элемент_УровеньГруппировок.Доступность = Не Форма.ВыводитьИерархиюЗадач;
	
	СписокВыбора = Элемент_УровеньГруппировок.СписокВыбора;
	СписокВыбора.Очистить();
	
	МассивГруппировок = Новый Массив;
	МассивГруппировок.Добавить(НСтр("ru = 'Проекты'"));
	МассивГруппировок.Добавить(НСтр("ru = 'Задачи'"));
	Если Форма.ВыводитьПодразделение Тогда
		МассивГруппировок.Добавить(НСтр("ru = 'Подразделения'"));
	КонецЕсли;
	Если Форма.ВыводитьВидыОпераций Тогда
		МассивГруппировок.Добавить(НСтр("ru = 'Вид операции'"));
	КонецЕсли;
	МассивГруппировок.Добавить(НСтр("ru = 'Ресурс'"));
	
	КоличествоУровней = Форма.СоотвУровняДерева.Количество();
	КоличествоГруппировок = МассивГруппировок.Количество();
	КоличествоДобавленныхЗадачИерархии = КоличествоУровней - КоличествоГруппировок;
	
	Сч = -1;
	ИндексСписка = 0;
	Для Каждого Группировка Из МассивГруппировок Цикл
		Сч = Сч + 1;
		Если Сч > 0 Тогда
			ИндексСписка = Сч + КоличествоДобавленныхЗадачИерархии;// Группировка "Проект" всегда первая.
		КонецЕсли;
		СписокВыбора.Добавить(ИндексСписка, Группировка);
	КонецЦикла;
	
	Если ЗаполнитьУровень Тогда
		УстановитьУровеньГруппировок(Форма, ИндексСписка)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьУровеньГруппировок(Форма, Уровень)
	
	 Форма.УровеньГруппировок = Уровень;
	
КонецПроцедуры

#КонецОбласти

