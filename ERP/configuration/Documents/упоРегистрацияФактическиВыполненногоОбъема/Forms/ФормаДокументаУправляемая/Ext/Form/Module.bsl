&НаКлиенте	
Процедура КомандаКопироватьСтрокуВладельцаВРаспределение(Команда)
	
	Результат = НастройкиПоИмениКоманды(Команда.Имя);
	Если Результат = Неопределено Тогда
		Возврат; // Возврат
	КонецЕсли;

	ИмяОсновнойТаблицы		= Результат.ИмяОсновнойТаблицы;
	ИмяТаблицыРаспределения = Результат.ИмяТаблицыРаспределения;
	ИмяКолонкиСумма 		= Результат.ИмяКолонкиСумма;
	УчитыватьКоличество		= Результат.УчитыватьКоличество;
	
	упоАналитикаПоПодразделениямКлиент.СкопироватьСтрокуВладельцаВРаспределениеСОчисткой(ЭтаФорма, 
		ИмяОсновнойТаблицы, 
		ИмяТаблицыРаспределения, 
		ИмяКолонкиСумма, 
		УчитыватьКоличество);
	
КонецПроцедуры

&НаКлиенте	
Процедура КомандаЗаполнитьОбъемы(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите проект'"), , "Проект");
		Возврат; // Возврат
	КонецЕсли;
	
	//
	
	Если Команда.Имя  = "ЗаполнитьДоходныеОбъемыПоТекущемуПлануБДР"
		Или Команда.Имя  = "ЗаполнитьРасходныеОбъемыПоТекущемуПлануБДР" Тогда
		
		ТаблицаОбъекта = ?(Команда.Имя  = "ЗаполнитьДоходныеОбъемыПоТекущемуПлануБДР", "ДоходныеОбъемы", "РасходныеОбъемы");
		ЗаполнитьПоТекущемуПлану(,ТаблицаОбъекта);
		
	ИначеЕсли Команда.Имя  = "ЗаполнитьДоходныеОбъемыОстатковОбъемов"
		Или Команда.Имя = "ЗаполнитьРасходныеОбъемыОстатковОбъемов" Тогда
		
		ТаблицаОбъекта = ?(Команда.Имя  = "ЗаполнитьДоходныеОбъемыОстатковОбъемов", "ДоходныеОбъемы", "РасходныеОбъемы");
		ЗаполнитьОстаткамиОбъемов(ТаблицаОбъекта);
		
	Иначе
		
		ЗаполнитьВыполненнойПроектнойПродукциейНаДату();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДоходныеОбъемы) Тогда
		Элементы.ДоходныеОбъемы.ТекущаяСтрока = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РасходныеОбъемы) Тогда
		Элементы.РасходныеОбъемы.ТекущаяСтрока = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьНДС(Команда)
	
	Результат = НастройкиПоИмениКоманды(Команда.Имя);	
	Если Результат = Неопределено Тогда
		Возврат;  // Возврат.
	КонецЕсли;	
	
	ИмяОсновнойТаблицы		= Результат.ИмяОсновнойТаблицы;
	ИмяТаблицыРаспределения = Результат.ИмяТаблицыРаспределения;
	ИмяКолонкиСумма 		= Результат.ИмяКолонкиСумма;
	УчитыватьКоличество		= Результат.УчитыватьКоличество;
			
	ТекущиеДанные = Элементы[ИмяОсновнойТаблицы].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;  // Возврат.
	КонецЕсли;		
	
	// Заполнение по умолчанию.
	СтрокиРаспределенияПоПодразделениям = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПодразделениям(
																								ТекущиеДанные, 
																								Объект[ИмяТаблицыРаспределения], 
																								Истина);
	Если СтрокиРаспределенияПоПодразделениям.Количество() = 0 Тогда									
		упоАналитикаПоПодразделениямКлиент.СкопироватьСтрокуВладельцаВРаспределениеСОчисткой(ЭтаФорма, 
																							ИмяОсновнойТаблицы, 
																							ИмяТаблицыРаспределения, 
																							ИмяКолонкиСумма, 
																							УчитыватьКоличество);		
	КонецЕсли;					
	
	// НДС.
	СтрокаВладелец = Новый Структура;
	СтрокаВладелец.Вставить("Валюта", ТекущиеДанные.Валюта); 
	СтрокаВладелец.Вставить("Договор", ТекущиеДанные.Договор);
	СтрокаВладелец.Вставить("ИндексСтрокРаспределения", ТекущиеДанные.ИндексСтрокРаспределения);
	СтрокаВладелец.Вставить("Сумма", ТекущиеДанные[ИмяКолонкиСумма]);			
						
	ВыделитьНДС(СтрокаВладелец, ИмяОсновнойТаблицы);		
	
	// Итоги.
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, 
																		ИмяОсновнойТаблицы, 
																		ИмяТаблицыРаспределения, 
																		ИмяКолонкиСумма,
																		Истина);
			
КонецПроцедуры

