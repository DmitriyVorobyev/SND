#Область ПодключаемыеСтандартныйПериод
 
&НаКлиенте
Процедура Подключаемый_СтандартныйПериод_Значение_НачалоВыбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Формирование сведений по элементу.
	ПериодПредставлениеИмя = "ПериодПредставление";
	
	ПериодЗначениеИмя = "ПериодЗначение";
	
	Значение   = ЭтаФорма[ПериодЗначениеИмя];
	ВидПериода = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц");
	
	НачалоПериода = Значение.ДатаНачала;
	Если НачалоПериода = '00010101' Тогда
		НачалоПериода = упоФункцииБСПКлиентСервер.НачалоПериодаОтчета(ВидПериода, 
			НачалоМесяца(ОбщегоНазначенияКлиент.ДатаСеанса()) - 1);
	КонецЕсли;
	
	// Параметры для чтения из обработчиков.
	ПараметрыПериода = Новый Структура;
	// Для выбора значения.
	ПараметрыПериода.Вставить("Значение",               Значение);
	ПараметрыПериода.Вставить("Элемент",                Элемент);
	// Для загрузки значения.
	ПараметрыПериода.Вставить("ПериодПредставлениеИмя", ПериодПредставлениеИмя);
	ПараметрыПериода.Вставить("ПериодЗначениеИмя",      ПериодЗначениеИмя);
	ПараметрыПериода.Вставить("ВидПериода",             ВидПериода);
	
	ВыборПериодаИзВыпадающегоСписка(-1, ПараметрыПериода);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПериодаИзВыпадающегоСписка(Результат, ПараметрыПериода)
	
	Если Результат = Неопределено Тогда
		Возврат; // Отмена выбора.
	КонецЕсли;
	
	Если Результат = -1 Тогда // Начало выбора.
		// Чтение параметров для формирования списка из сохраненного значения периода.
		ПараметрыПериода.Вставить("НачалоПериода", ПараметрыПериода.Значение.ДатаНачала);
		ПараметрыПериода.Вставить("Вариант",       ПараметрыПериода.Значение.Вариант);
		ИндексНачальногоЗначения = Неопределено;
	ИначеЕсли ТипЗнч(Результат.Значение) = Тип("Структура") Тогда
		// Чтение параметров для формирования списка из выбранного значения.
		ПараметрыПериода.Вставить("НачалоПериода", Результат.Значение.НачалоПериода);
		ПараметрыПериода.Вставить("Вариант",       Результат.Значение.Вариант);
		ИндексНачальногоЗначения = Результат.Значение.ИндексНачальногоЗначения;
	Иначе
		// Загрузка результата выбора.
		ЗагрузитьРезультатВыбораПериодаИзВыпадающегоСписка(Результат, ПараметрыПериода);
		Возврат;
	КонецЕсли;
	
	// Формирование списка выбора.
		
	СписокПериодов = упоФункцииБСПКлиентСервер.СписокФиксированныхПериодов(
		ПараметрыПериода.НачалоПериода, ПараметрыПериода.ВидПериода);
	
	Если ИндексНачальногоЗначения = Неопределено Тогда
		ИндексНачальногоЗначения = СписокПериодов.НайтиПоЗначению(ПараметрыПериода.НачалоПериода);
	КонецЕсли;
	
	ОписаниеНавигационногоЭлемента = Новый Структура;
	ОписаниеНавигационногоЭлемента.Вставить("НачалоПериода",            СписокПериодов[0].Значение);
	ОписаниеНавигационногоЭлемента.Вставить("Вариант",                  Неопределено);
	ОписаниеНавигационногоЭлемента.Вставить("ИндексНачальногоЗначения", 0);
	СписокПериодов[0].Значение = ОписаниеНавигационногоЭлемента;
	
	ОписаниеНавигационногоЭлемента = Новый Структура;
	ОписаниеНавигационногоЭлемента.Вставить("НачалоПериода",            СписокПериодов[8].Значение);
	ОписаниеНавигационногоЭлемента.Вставить("Вариант",                  Неопределено);
	ОписаниеНавигационногоЭлемента.Вставить("ИндексНачальногоЗначения", 8);
	СписокПериодов[8].Значение = ОписаниеНавигационногоЭлемента;
	
	Если Не ПараметрыПериода.Свойство("ВариантСтандартногоПериодаПоВиду") Тогда
		ПараметрыПериода.Вставить("ВариантСтандартногоПериодаПоВиду",
			ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"));
	КонецЕсли;
		
	Если ИндексНачальногоЗначения = Неопределено Тогда
		ИндексНачальногоЗначения = СписокПериодов.Количество() - 1;
	КонецЕсли;
	Если ПеременныеКлиента = Неопределено Тогда
		ПеременныеКлиента = Новый Структура;
	КонецЕсли;
		
	ПеременныеКлиента.Вставить("ВыборПериодаИзВыпадающегоСписка", Новый Структура);
	ПеременныеКлиента.ВыборПериодаИзВыпадающегоСписка.Вставить("ПараметрыВыбора", ПараметрыПериода);
	ПеременныеКлиента.ВыборПериодаИзВыпадающегоСписка.Вставить("СписокПериодов", СписокПериодов);
	ПеременныеКлиента.ВыборПериодаИзВыпадающегоСписка.Вставить("ИндексНачальногоЗначения", ИндексНачальногоЗначения);
	Если Результат = -1 Тогда
		НачатьВыборПериодаИзВыпадающегоСписка();
	Иначе
		ПодключитьОбработчикОжидания("НачатьВыборПериодаИзВыпадающегоСписка", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРезультатВыбораПериодаИзВыпадающегоСписка(Результат, ПараметрыПериода)
	
	Значение = ПараметрыПериода.Значение;
	
	// Запись результата выбора в данные формы и пользовательские настройки КД.
	Если ТипЗнч(Результат.Значение) = Тип("ВариантСтандартногоПериода") Тогда
		ЭтаФорма[ПараметрыПериода.ПериодПредставлениеИмя] = ?(ПустаяСтрока(Результат.Представление), Строка(Результат.Значение), Результат.Представление);
		Значение.Вариант = Результат.Значение;
	Иначе
		НачалоПериода = упоФункцииБСПКлиентСервер.НачалоПериодаОтчета(ПараметрыПериода.ВидПериода, Результат.Значение);
		КонецПериода  = упоФункцииБСПКлиентСервер.КонецПериодаОтчета(ПараметрыПериода.ВидПериода, Результат.Значение);
		
		ЭтаФорма[ПараметрыПериода.ПериодПредставлениеИмя] = Результат.Представление;
		
		Значение.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
		Значение.ДатаНачала    = НачалоПериода;
		Значение.ДатаОкончания = КонецПериода;
	КонецЕсли;
	
	ЭтаФорма[ПараметрыПериода.ПериодЗначениеИмя] = Значение;
	Объект.ПериодРегистрации = Значение.ДатаНачала;
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборПериодаИзВыпадающегоСписка()
	Если ПеременныеКлиента.Свойство("ВыборПериодаИзВыпадающегоСписка") Тогда
		Контекст = ПеременныеКлиента.ВыборПериодаИзВыпадающегоСписка;
		ПеременныеКлиента.Удалить("ВыборПериодаИзВыпадающегоСписка");
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыВыбора",Контекст.ПараметрыВыбора);
		ОписаниеОповещения = Новый ОписаниеОповещения("НачатьВыборПериодаИзВыпадающегоСпискаЗавершение",ЭтотОбъект,ДополнительныеПараметры); 
		ПоказатьВыборИзСписка(ОписаниеОповещения,Контекст.СписокПериодов, Контекст.ПараметрыВыбора.Элемент, Контекст.ИндексНачальногоЗначения);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборПериодаИзВыпадающегоСпискаЗавершение(ВыбранныйЭлемент,ДополнительныеПараметры) Экспорт
	ВыборПериодаИзВыпадающегоСписка(ВыбранныйЭлемент, ДополнительныеПараметры.ПараметрыВыбора);	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПереключитьПериодИЕгоПредставление(ЭтаФорма)
		
	ВидПериодаИмя = "ПериодВид";
	
	ПериодЗначениеИмя       = "ПериодЗначение";
	ПериодПредставлениеИмя  = "ПериодПредставление";
	
	Значение = ЭтаФорма[ПериодЗначениеИмя];
	
	ВидПериода = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц");
		
	// Приведение значения периода в соответствие с выбранным видом.
	НачалоПериода = НачалоДня(Значение.ДатаНачала);
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоДня(ПолучитьТекущуюДатуСеанса());
	КонецЕсли;
	
	НачалоПериода = упоФункцииБСПКлиентСервер.НачалоПериодаОтчета(ВидПериода, НачалоПериода);
	КонецПериода  = упоФункцииБСПКлиентСервер.КонецПериодаОтчета(ВидПериода, НачалоПериода);
		
	Значение.ДатаНачала    = НачалоПериода;
	Значение.ДатаОкончания = КонецПериода;
	
	
	Представление = упоФункцииБСПКлиентСервер.ПредставлениеСтандартногоПериода(Значение, ВидПериода);
	ЭтаФорма[ПериодПредставлениеИмя] = Представление;
	ЭтаФорма[ПериодЗначениеИмя]      = Значение;

КонецФункции 

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗначенияПериода(ЭтотОбъект, РегистрацияПП)
	
	Если РегистрацияПП Тогда
		ВидПериода = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц");
		Если ЗначениеЗаполнено(ЭтотОбъект.Объект.ПериодРегистрации) Тогда
			НеобходимыйПериод = ЭтотОбъект.Объект.ПериодРегистрации;
		Иначе
			НеобходимыйПериод = НачалоМесяца(ПолучитьТекущуюДатуСеанса()) - 1;
		КонецЕсли;
		НачалоПериода = упоФункцииБСПКлиентСервер.НачалоПериодаОтчета(ВидПериода, НеобходимыйПериод);
		КонецПериода = упоФункцииБСПКлиентСервер.КонецПериодаОтчета(ВидПериода, НеобходимыйПериод);
	Иначе
		НачалоПериода = '00010101';
		КонецПериода = НачалоПериода;
	КонецЕсли;
	
	ЭтотОбъект.Объект.ПериодРегистрации = НачалоПериода;
	ЭтотОбъект.ПериодЗначение.ДатаНачала = НачалоПериода;
	ЭтотОбъект.ПериодЗначение.ДатаОкончания = КонецПериода;
	
КонецПроцедуры

#КонецОбласти

