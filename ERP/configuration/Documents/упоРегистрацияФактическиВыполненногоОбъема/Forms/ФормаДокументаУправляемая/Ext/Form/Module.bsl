&НаСервере
Процедура ИнициализацияФормы()
	
	ЗаполнитьОбработатьЗаполнениеРеквизитовФормы();
	
	УстановитьДоступКФинансовойИнформации();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбработатьЗаполнениеРеквизитовФормы()
	
	Проект = Объект.Проект;
	ОбработатьЗаполнениеПроекта(Истина);
	
	//
	
	РегистрацияНоменклатуры = Не Объект.РегистрацияПроектнойПродукции;
	ИзменитьЭлементыПриИзмененииППНоменклатура(ЭтотОбъект, Объект.РегистрацияПроектнойПродукции);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступКФинансовойИнформации()
	
	ДоступКФинИнформации = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	Если ДоступКФинИнформации = "Отсутствует" Тогда
		СкрытьФинансовуюИнформацию();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СкрытьФинансовуюИнформацию()
	
	КолонкиСОграничениемДоступа = Новый Массив;
	
	ИмяТЧ = "ДоходныеОбъемы";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Стоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Сумма");
	
	ИмяТЧ = "РаспределениеДоходныхОбъемов";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Сумма");
		
	ИмяТЧ = "РасходныеОбъемы";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Стоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Сумма");
	
	ИмяТЧ = "РаспределениеРасходныхОбъемов";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Сумма");
	
	упоРазграничениеДоступаВызовСервера.УстановитьДоступККолонкамТабличнойЧасти(Элементы,
		КолонкиСОграничениемДоступа,
		"Отсутствует");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьВсеТабличныеЧасти(Объект)
	
	Объект.ДоходныеОбъемы.Очистить();
	Объект.РаспределениеДоходныхОбъемов.Очистить();
	Объект.РасходныеОбъемы.Очистить();
	Объект.РаспределениеРасходныхОбъемов.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрироватьПроектнуюПродукциюПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Объект.Проект = Проект;
		Объект.РегистрацияПроектнойПродукции = РегистрацияНоменклатуры;
		РегистрацияНоменклатуры = Не РегистрацияНоменклатуры;
		Возврат;
	КонецЕсли;
	Объект.РегистрацияПроектнойПродукции = Не РегистрацияНоменклатуры;
	ОчиститьВсеТабличныеЧасти(Объект);
	ИзменитьЭлементыПриИзмененииППНоменклатура(ЭтотОбъект, Объект.РегистрацияПроектнойПродукции);
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчисткиТаблицыЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Проект = Объект.Проект;
		Возврат;
	КонецЕсли;
	
	ОчиститьВсеТабличныеЧасти(Объект);
	
	Объект.Проект = Проект;
	ОбработатьЗаполнениеПроекта();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоТекущемуПлану(ТекВерсия = Неопределено, ТаблицаОбъекта)
		
	Если ТекВерсия = Неопределено Тогда
		ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	КонецЕсли;
	
	ЭтоДоход = (ТаблицаОбъекта = "ДоходныеОбъемы"); 
	
	Документы.упоРегистрацияФактическиВыполненногоОбъема.ЗаполнитьОбъектПоОснованию(
		Объект, ТекВерсия, ЭтоДоход, Не ЭтоДоход);
	
	Если ЗначениеЗаполнено(Объект.ДоходныеОбъемы) Тогда
		Элементы.ДоходныеОбъемы.ТекущаяСтрока = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РасходныеОбъемы) Тогда
		Элементы.РасходныеОбъемы.ТекущаяСтрока = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткамиОбъемов(ТаблицаОбъекта)
	
	ЭтоДоход = (ТаблицаОбъекта = "ДоходныеОбъемы"); 
	
	Документы.упоРегистрацияФактическиВыполненногоОбъема.ЗаполнитьОбъектПоОснованию(
		Объект, "ОстаткиОбъемов", ЭтоДоход, Не ЭтоДоход);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВыполненнойПроектнойПродукциейНаДату()
	
	Документы.упоРегистрацияФактическиВыполненногоОбъема.ЗаполнитьОбъектПоОснованию(
		Объект, "ВыполненнаяПроектнаяПродукцияНаДату", Истина, Ложь);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста	
Процедура КоличествоСуммаПриИзменении(ТекущаяСтрока, ИзменяемаяКолонка)
	
	упоРаботаСФормамиКлиентСервер.КоличествоСуммаПриИзменении(ТекущаяСтрока, ИзменяемаяКолонка);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьЭлементыПриИзмененииППНоменклатура(ЭтотОбъект, РегистрацияПП)
	
	Элементы = ЭтотОбъект.Элементы;
	
	ЭлементыВключитьВидимостьПП = Новый Массив;
	ЭлементыВключитьВидимостьПП.Добавить("ДоходныеОбъемыЗаполнитьДоходныеОбъемыОборотамиЗаПериод");
	ЭлементыВключитьВидимостьПП.Добавить("ПериодРегистрации");
	упоФункцииБСПКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Элементы, ЭлементыВключитьВидимостьПП, "Видимость", РегистрацияПП);
	
	ЭлементыВыключитьВидимостьПП = Новый Массив;
	
	ЭлементыВыключитьВидимостьПП.Добавить("ДоходныеОбъемыЗаполнитьДоходныеОбъемыОстатковОбъемов");
	ЭлементыВыключитьВидимостьПП.Добавить("ДоходныеОбъемыЗаполнитьДоходныеОбъемыПоТекущемуПлануБДР");
	упоФункцииБСПКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Элементы, ЭлементыВыключитьВидимостьПП, "Видимость", Не РегистрацияПП);
	
	УстановитьЗначенияПериода(ЭтотОбъект, РегистрацияПП);
	
	Если РегистрацияПП Тогда
		ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.упоПроектнаяПродукция");
		ЗаголовокНоменклатуры = НСтр("ru = 'Проектная продукция'");
		ПереключитьПериодИЕгоПредставление(ЭтотОбъект);
	Иначе
		ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
		ЗаголовокНоменклатуры = НСтр("ru = 'Номенклатура'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДоходныеОбъемыНоменклатура", "ОграничениеТипа", ОграничениеТипа);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДоходныеОбъемыНоменклатура", "Заголовок", ЗаголовокНоменклатуры);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияИВидимостьПроектныхОпцийВДокументе(ОткрытиеФормы = Ложь)
	
	СтруктураСвойств = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	ИспользоватьАналитикуКонтрагентДляСС = СтруктураСвойств.ИспользоватьАналитикуКонтрагентДляСС;
	
	ДоходыПоНатуральнымПоказателям = СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	РасходыПоНатуральнымПоказателям = СтруктураСвойств.РасходыПоНатуральнымПоказателям;
	
	Элементы.ДоходныеОбъемыНоменклатура.Видимость = ДоходыПоНатуральнымПоказателям;
	Элементы.ДоходныеОбъемыЕдиницаИзмерения.Видимость = ДоходыПоНатуральнымПоказателям;
	Элементы.ДоходныеОбъемыКоличество.Видимость = ДоходыПоНатуральнымПоказателям;
	Элементы.ДоходныеОбъемыСтоимость.Видимость = ДоходыПоНатуральнымПоказателям;
	
	Элементы.РаспределениеДоходныхОбъемовКоличество.Видимость = ДоходыПоНатуральнымПоказателям;
	
	Элементы.РасходныеОбъемыНоменклатура.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РасходныеОбъемыЕдиницаИзмерения.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РасходныеОбъемыКоличество.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РасходныеОбъемыСтоимость.Видимость = РасходыПоНатуральнымПоказателям;
	
	Элементы.РаспределениеРасходныхОбъемовКоличество.Видимость = РасходыПоНатуральнымПоказателям;
	
	Если Не ОткрытиеФормы Тогда
		Объект.ЗаписыватьПроцентГотовности = СтруктураСвойств.РассчитыватьПроцентГотовностиПоФактическимДоходнымОбъемам; 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере	
Процедура ДоходныеОбъемыПроектнаяЗадачаПриИзмененииСервер(ДанныеЗаполнения)
							
	ДанныеЗаполнения.ПроектнаяЗадача = ДокументПЗПоПроектуПЗ(ДанныеЗаполнения.ПроектнаяЗадачаПроект);
			
	ПроектнаяЗадачаНоменклатураПриИзмененииВДоходныхОбъемах(ДанныеЗаполнения);
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ДокументПЗПоПроектуПЗ(ПроектнаяЗадачаПроект)
	
	ПроектнаяЗадача = Неопределено;
	Если ЗначениеЗаполнено(ПроектнаяЗадачаПроект) Тогда		
		ПроектнаяЗадача = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадачаПроект, "СсылкаНаПроектнуюЗадачу");			
	КонецЕсли;
		
	Возврат ПроектнаяЗадача;
	
КонецФункции

&НаСервереБезКонтекста 
Функция ЗаполнитьСтоимостьНоменклатуры(ПроектнаяЗадача, Номенклатура, ТекущаяВерсия)
	 
	 ЗапросСтоимости = Новый Запрос;
	 ЗапросСтоимости.Текст = "ВЫБРАТЬ
	                         |	ИсточникЦенНоменклатуры.Цена КАК Цена,
	                         |	ИсточникЦенНоменклатуры.Номенклатура КАК Номенклатура
	                         |ИЗ
	                         |	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
	                         |			,
	                         |			Версия = &ТекущаяВерсия
	                         |				И ПроектнаяЗадача = &ПроектнаяЗадача
	                         |				И Номенклатура = &Номенклатура) КАК ИсточникЦенНоменклатуры
	                         |ГДЕ
	                         |	(ИсточникЦенНоменклатуры.Количество <> 0
	                         |			ИЛИ ИсточникЦенНоменклатуры.Сумма <> 0
	                         |			ИЛИ ИсточникЦенНоменклатуры.СуммаВалютная <> 0)";
	 
	 ЗапросСтоимости.УстановитьПараметр("ТекущаяВерсия", 	ТекущаяВерсия);
	 ЗапросСтоимости.УстановитьПараметр("ПроектнаяЗадача", 	ПроектнаяЗадача);
	 ЗапросСтоимости.УстановитьПараметр("Номенклатура", 	Номенклатура);
	 
	 Результат = ЗапросСтоимости.Выполнить();	 
	 
	 Если Не Результат.Пустой() Тогда
		 
		 Выборка = Результат.Выбрать();
		 Выборка.Следующий();
		 
		 Возврат Выборка.Цена;
		 
	 Иначе
		 
		 Возврат 0;
		 
	 КонецЕсли;	

КонецФункции

&НаСервере
Процедура ВыделитьНДС(СтрокаВладелец, ИмяТаблицы)
			
	ПараметрыРаспределения = упоДоходыИРасходыСервер.ПараметрыВыделенияНДСВРаспределенииПоУмолчанию();
	ПараметрыРаспределения.Проект 		= Объект.Проект;
	ПараметрыРаспределения.СтавкаНДС 	= упоДоходыИРасходыСервер.ЗначениеСтавкиНДС(СтрокаВладелец.Договор, Объект.Проект);
	
	упоДоходыИРасходыСервер.ВыделитьНДСВРаспределении(Объект, 
													СтрокаВладелец, 
													ИмяТаблицы,
													, 
													ПараметрыРаспределения);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОсновнойТаблицыПоИмениКоманды(ИмяКоманды)
			
	Если ИмяКоманды = "ВыделитьНДСДоходныеОбъемы"
		Или ИмяКоманды = "ЗаполнитьПоВладельцуДоходныеОбъемы" Тогда				
		ИмяТаблицы = "ДоходныеОбъемы";										
	ИначеЕсли ИмяКоманды = "ВыделитьНДСРасходныеОбъемы"
		Или ИмяКоманды = "ЗаполнитьПоВладельцуРасходныеОбъемы" Тогда 	
		ИмяТаблицы = "РасходныеОбъемы";					
	Иначе
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Возврат ИмяТаблицы;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы)			
		
	ИмяКолонкиСумма = "Сумма";
	
	Если ИмяОсновнойТаблицы = "ДоходныеОбъемы" Тогда						
		ИмяТаблицыРаспределения = "РаспределениеДоходныхОбъемов";		
	ИначеЕсли ИмяОсновнойТаблицы = "РасходныеОбъемы" Тогда 			
		ИмяТаблицыРаспределения = "РаспределениеРасходныхОбъемов";
	Иначе
		Возврат Неопределено; // Возврат.
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ИмяТаблицыРаспределения", 	ИмяТаблицыРаспределения);
	Результат.Вставить("ИмяКолонкиСумма", 			ИмяКолонкиСумма);	
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиПоИмениКоманды(ИмяКоманды)
		
	ИмяОсновнойТаблицы = ИмяОсновнойТаблицыПоИмениКоманды(ИмяКоманды);
	Если ИмяОсновнойТаблицы = Неопределено Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Результат = ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы);	
	Если Результат = Неопределено Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Результат.Вставить("ИмяОсновнойТаблицы", 	ИмяОсновнойТаблицы);
	Результат.Вставить("УчитыватьКоличество", 	Истина);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьТекущуюВерсию(Проект)

	Если ЗначениеЗаполнено(Проект) Тогда
		ЭтотОбъект.ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	Иначе
		ЭтотОбъект.ТекущаяВерсия = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

// Если в проекте нет запланированной проектной продукции, то тип номенклатуры факта будет ограничен типом Номенклатура.
// Иначе при ручном добавлении пользователю необходимо будет выбрать тип номенклатуры: 
// Номенклатура или Проектная продукция.
//
&НаСервере
Процедура ОбновитьТипНоменклатуры()
	
	ВидимостьЭлементовПП = упоРаботаСФормамиСервер.ВидимостьЭлементовПроектнаяПродукция(Объект.РегистрацияПроектнойПродукции);
	
	Если Не ВидимостьЭлементовПП Тогда
		УстановитьВидимостьЭлементовПроектнаяПродукция();
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекВерсия", ТекущаяВерсия);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	Таблица.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ИЗ
	               |	РегистрСведений.упоДанныеПроектнойПродукции.СрезПоследних(, Версия = &ТекВерсия) КАК Таблица";
	Результат = Запрос.Выполнить();
	
	ВыбиратьТип = Не Результат.Пустой();
	
	упоРаботаСФормамиКлиентСервер.УстановитьТипСубпродуктаДляЭлемента(Элементы.ДоходныеОбъемыНоменклатура, , ВыбиратьТип);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПроектнаяПродукция()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаППНоменклатура", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДоходныеОбъемыЗаполнитьДоходныеОбъемыОборотамиЗаПериод", "Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ДоходныеОбъемыНоменклатураПриИзмененииСервер(ДанныеЗаполнения);
	
	ДанныеЗаполнения.ЕдиницаИзмерения = 
		упоЗаполнениеИПодборСервер.ПолучитьЕдиницуИзмеренияНоменклатуры(ДанныеЗаполнения.Номенклатура);
	
	ПроектнаяЗадачаНоменклатураПриИзмененииВДоходныхОбъемах(ДанныеЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЗаполнениеПроекта(ОткрытиеФормы = Ложь)
	
	УстановитьЗначенияИВидимостьПроектныхОпцийВДокументе(ОткрытиеФормы);
	ОбновитьТекущуюВерсию(Проект);
	ОбновитьТипНоменклатуры();
	
КонецПроцедуры

&НаСервере
Процедура ПроектнаяЗадачаНоменклатураПриИзмененииВДоходныхОбъемах(ТекДанные)
	
	Если ЗначениеЗаполнено(ТекДанные.ПроектнаяЗадача) И ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
		ТекДанные.Стоимость = ЗаполнитьСтоимостьНоменклатуры(ТекДанные.ПроектнаяЗадача, 
			ТекДанные.Номенклатура,
			ЭтотОбъект.ТекущаяВерсия);
		
		КоличествоСуммаПриИзменении(ТекДанные, "Стоимость");
	КонецЕсли
	
КонецПроцедуры	

&НаКлиенте
Функция ДоходныеОбъемыДанныеЗаполнения()
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("ПроектнаяЗадачаПроект");
	ДанныеЗаполнения.Вставить("ПроектнаяЗадача");
	ДанныеЗаполнения.Вставить("ЕдиницаИзмерения");
	ДанныеЗаполнения.Вставить("Номенклатура");
	ДанныеЗаполнения.Вставить("Количество");
	ДанныеЗаполнения.Вставить("Стоимость");
	ДанныеЗаполнения.Вставить("Сумма");
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТипСубпродуктаПоТипуРегистрации(РегистрацияПроектнойПродукции)
	
	Если РегистрацияПроектнойПродукции Тогда
		ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция");
	Иначе
		ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.Номенклатура");
	КонецЕсли;
	
	Возврат ТипСубпродукта;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекущуюДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаКлиенте
Процедура РаспределениеСтоимостиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	Если (ДополнительныеПараметры.ИмяТаблицыВладельца = "ДоходныеОбъемы" И Не ДоходыПоНатуральнымПоказателям)
		Или (ДополнительныеПараметры.ИмяТаблицыВладельца = "РасходныеОбъемы" И Не РасходыПоНатуральнымПоказателям) Тогда
		ДополнительныеПараметры.Вставить("ПересчитыватьКоличество", Ложь);
	КонецЕсли;

	упоРаботаСФормамиКлиент.ПересчитатьТаблицуРаспределенияЗавершение(ДополнительныеПараметры);			
	
	ВосстановитьОбнуленныйНДСПослеПересчета(ДополнительныеПараметры.ТаблицаРаспределения,
											ДополнительныеПараметры.ТекДанные,
											ДополнительныеПараметры.ИмяТаблицыВладельца);

	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, 
																		ДополнительныеПараметры.ИмяТаблицыВладельца, 
																		ДополнительныеПараметры.ИмяТаблицыРаспределения, 
																		ДополнительныеПараметры.ИмяКолонкиОбщСтоимость,
																		ДополнительныеПараметры.ПересчитыватьКоличество);																	
КонецПроцедуры 

// Если в подчиненных строках был НДС, его сумма обнулится при пересчете по коэффициентам, т.к. в строке НДС Количество = 0. 
// Для восстановления делаем пересчет НДС.
&НаКлиенте
Процедура ВосстановитьОбнуленныйНДСПослеПересчета(ТаблицаРаспределения, СтрокаВладелец, ИмяТаблицыВладельца)
	
	СтруктураСтрокаВладелец = упоРаботаСФормамиКлиент.СтруктураСтрокиДляРасчетаНДС(ТаблицаРаспределения, СтрокаВладелец, 
		ИмяТаблицыВладельца);
		
	Если Не ЗначениеЗаполнено(СтруктураСтрокаВладелец) Тогда
		Возврат;
	КонецЕсли;
	
	ВыделитьНДС(СтруктураСтрокаВладелец, ИмяТаблицыВладельца);
		
КонецПроцедуры

#КонецОбласти																	
