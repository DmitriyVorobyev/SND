// Процедура для вызова при подборе ресурсов в табличную часть "МатериальныеРесурсы".
//
// Параметры:
//  СтрокаТабличнойЧасти - СтрокаТабличнойЧасти	 - строка табличной части "МатериальныеРесурсы". 
//  ПараметрыПодбора	 - Структура - не используется.
//
Процедура ВыполнитьДействияПриПодборе(Знач СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт
	
	КодОшибки = ЗаполнитьСтрокуТЧДанными(СтрокаТабличнойЧасти.ПроектнаяЗадача, СтрокаТабличнойЧасти, Истина);	
	Если Не КодОшибки = Неопределено Тогда
		обПредупреждение(КодОшибки);
		СтрокаТабличнойЧасти.Владелец().Удалить(СтрокаТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует структуру обязательных реквизитов шапки или заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	СвойстваПроекта = Неопределено;
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("СвойстваПроекта", СвойстваПроекта) Тогда
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ЭтотОбъект.Проект);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("СвойстваПроекта", СвойстваПроекта);
	КонецЕсли;	
			
	Если ИмяТабличнойЧасти = "ДоходныеОбъемы" Тогда		
		СтруктураОбязательныхПолей.Вставить("ПроектнаяЗадачаПроект");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		Если СвойстваПроекта.ДоходыПоНатуральнымПоказателям Тогда
			СтруктураОбязательныхПолей.Вставить("Количество");
		КонецЕсли;	
	ИначеЕсли ИмяТабличнойЧасти = "РасходныеОбъемы" Тогда		
		СтруктураОбязательныхПолей.Вставить("ПроектнаяЗадачаПроект");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		Если СвойстваПроекта.РасходыПоНатуральнымПоказателям Тогда
			СтруктураОбязательныхПолей.Вставить("Количество");
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет все необходимые данные документа для его записи в ИБ.
// 
// Параметры:
//  Отказ        - Булево - Признак отказа от выполнения операции.
// 
Процедура ПроверитьДанныеПередЗаписью(Отказ) Экспорт
	
	// Получим заголовок для сообщения об ошибках при записи объекта.
	Заголовок = обСформироватьЗаголовокОшибкиПриЗаписи(ЭтотОбъект);
	
	// Проверяем заполненность обязательных реквизитов.
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет все необходимые данные документа для его проведения.
// 
// Параметры: 
//  ДанныеДокумента - Структура - содержит слепок документа.
//  Отказ           - Булево	- признак отказа от выполнения операции.
//  Заголовок       - Строка	- содержит заголовок сообщения.
// 
Процедура ПроверитьДанные(ДанныеДокумента, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// Отказ проведения, если есть документы, проведенные после текущей даты для текущих ПЗ.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Факт.Регистратор
	               |ИЗ
	               |	РегистрСведений.упоФактВыполненияОбъемовПоДням КАК Факт
	               |ГДЕ
	               |	Факт.День > &текДень
	               |	И Факт.ПроектнаяЗадача В(&ПроектныеЗадачи)";
	
	Запрос.УстановитьПараметр("ПроектныеЗадачи", );
	Запрос.УстановитьПараметр("текДень", Дата);
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		обСообщитьОбОшибке("Документ не будет проведен, так как есть документы ""Регистрация фактического освоенного объема""
			|за следующие дни, что противоречит логике.", Отказ);
	КонецЕсли;
	
КонецПроцедуры

