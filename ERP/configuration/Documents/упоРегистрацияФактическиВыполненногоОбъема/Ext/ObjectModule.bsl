// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт
	
	ПравилаНаложения = Новый Структура();
	
	// Правила для регистра "ФактВыполненияОбъемов".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактВыполненияОбъемовПоДням.Метаданные().Имя, Правила);
	
	// Правила для регистра "СтатусыПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСтатусыПроектныхЗадач.Метаданные().Имя, Правила);
	
	// Правила для регистра "ПроцентыГотовностиПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоПроцентыГотовностиПроектныхЗадач.Метаданные().Имя, Правила);
	
	// Правила для регистра "ПроцентыГотовностиПроектов".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоПроцентыГотовностиПроектов.Метаданные().Имя, Правила);
	
	// Правила для регистра "упоВыполненныеПринятыеОбъемы".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить("упоВыполненныеПринятыеОбъемы", Правила);
	
	// Правила для регистра "упоФактВыполненияОбъемовОбороты".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить("упоФактВыполненияОбъемовОбороты", Правила);
	
	// Правила для регистра "упоФактическиеДатыНачалаИОкончанияПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить("упоФактическиеДатыНачалаИОкончанияПроектныхЗадач", Правила);
	
	Возврат ПравилаНаложения; 
	
КонецФункции

Процедура ДобавитьВРегистрыПроцентИСтатус(ДанныеДвижений,
										  КЭШПроцентов,
										  Версия,
										  пПроектнаяЗадача, 
										  Знач пПроцентГотовности,
										  пСтатусЗадачиТекущий,
										  пСтатусЗадачи = Неопределено)
										  
	Если пСтатусЗадачи = Неопределено Тогда
		пСтатусЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Выполняется;
	КонецЕсли;
	
	Если пПроцентГотовности > 100 Тогда
		пПроцентГотовности = 100;
	КонецЕсли;
	
	Если пПроцентГотовности = 100 Тогда
		пСтатусЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Завершена;
	КонецЕсли;
	
	Если пСтатусЗадачиТекущий = Перечисления.упоСостояниеСтатусаЗадачи.Закрыта Тогда
		пСтатусЗадачи = Перечисления.упоСостояниеСтатусаЗадачи.Закрыта;
		пПроцентГотовности = 100;
	КонецЕсли;
	
	ОчиститьДанныеГотовностиИСтатусаДляОбновления(пПроектнаяЗадача, ДанныеДвижений);
	
	Движение = ДанныеДвижений[Движения.упоПроцентыГотовностиПроектныхЗадач.Метаданные().Имя].Добавить();
	Движение.Версия = Версия;
	Движение.ПроектнаяЗадача = пПроектнаяЗадача;
	Движение.ПроцентГотовности = пПроцентГотовности;
	
	Движение = ДанныеДвижений[Движения.упоСтатусыПроектныхЗадач.Метаданные().Имя].Добавить();
	Движение.Версия = Версия;
	Движение.ПроектнаяЗадача = пПроектнаяЗадача;
	Движение.СтатусЗадачи = пСтатусЗадачи;
	
	КЭШПроцентов.Вставить(пПроектнаяЗадача, пПроцентГотовности);
	
КонецПроцедуры

// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт
	
	// Начало проценты и статусы.
	Родители = Новый Массив;
	КЭШПроцентов = Новый Соответствие;
	ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	СчитатьПроцентыГотовностиПоДоходнымОбъемам(ДанныеДвижений, ТекущаяВерсия, КЭШПроцентов, Родители, Отказ);
	
	// Теперь еще для родителей надо сделать.
	СчитатьПроцентыГотовностиРодителей(ДанныеДвижений, ТекущаяВерсия, КЭШПроцентов, Родители);
	
	ЗапросФактСубпродуктов = Новый Запрос;
	ЗапросФактСубпродуктов.Текст = "ВЫБРАТЬ
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Ссылка.Проект,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ПроектнаяЗадача,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Номенклатура КАК Субпродукт,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ДатаПоступления КАК День,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ЕдиницаИзмерения,
	                               |	1 КАК Коэффициент,
	                               |	СУММА(упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Количество) КАК Количество,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Валюта,
	                               |	СУММА(упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Сумма) КАК СуммаВалютная
	                               |ИЗ
	                               |	Документ.упоРегистрацияФактическиВыполненногоОбъема.ДоходныеОбъемы КАК упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы
	                               |ГДЕ
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Ссылка = &Ссылка
	                               |
	                               |СГРУППИРОВАТЬ ПО
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Ссылка.Проект,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ПроектнаяЗадача,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Номенклатура,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ДатаПоступления,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ЕдиницаИзмерения,
	                               |	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Валюта";
	ЗапросФактСубпродуктов.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = ЗапросФактСубпродуктов.Выполнить().Выбрать();
	пВалютаУпр = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	
	Пока Выборка.Следующий() Цикл
		
		Движение = ДанныеДвижений.упоФактВыполненияОбъемовПоДням.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Выборка);
		Движение.Сумма = упоМодульВалютногоУчета.ПересчитатьСумму(Выборка.СуммаВалютная, Выборка.Валюта, пВалютаУпр, Дата);
		
	КонецЦикла;
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	
	СвойстваПроведения = Новый Структура;
	СвойстваПроведения.Вставить("Проект", Проект);
	СвойстваПроведения.Вставить("Версия", текущаяВерсия);
	СвойстваПроведения.Вставить("ПроектнаяЗадача", текущаяВерсия);
	СвойстваПроведения.Вставить("КонтрагентЗатрат", Проект.КонтрагентДоходов);
	СвойстваПроведения.Вставить("ДоговорЗатрат", Проект.ДоговорДоходов);
	
	упоАналитикаПоПодразделениямСервер.ЗаполнитьОбщиеНастройкиУчетаПоПодразделениям(ЭтотОбъект, СвойстваПроведения);
	упоАналитикаПоПодразделениямСервер.ПодготовитьТаблицыДвижений(ЭтотОбъект, ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);
	
КонецПроцедуры

