// Обработчик события ПриУстановкеНовогоНомера модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - СправочникОбъект - содержит сам объект.
//  СтандартнаяОбработка – Булево - признак выполнения стандартной (системной) обработки события.
//  Префикс      – Строка - префикс, который будет использоваться для генерации номера.
// 
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры

// Обработчик события ПриКопировании модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект - содержит сам объект.
//  ОбъектКопирования – ДокументОбъект - исходный документ, который является источником копирования. 
// 
Процедура ПриКопировании(ОбъектКопирования)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	
КонецПроцедуры

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Основание    - Произвольный 	- значение, которое используется как основание для заполнения.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		ДокументОснование = Основание;
		Проект = Основание.Проект;
		Документы.упоРегистрацияФактическиВыполненногоОбъема.ЗаполнитьОбъектПоОснованию(ЭтотОбъект, 
			Основание, 
			Истина, 
			Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
//  РежимЗаписи  - РежимЗаписиДокумента, в параметр передается текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)	
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);	
	
КонецПроцедуры

// Обработчик события ПриЗаписи модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Отказ        - Булево 			- признак отказа от записи документа.
// 
Процедура ПриЗаписи(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриЗаписи(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Обработчик события ПередУдалением модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Отказ        - Булево 			- признак удаления документа.
// 
Процедура ПередУдалением(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередУдалением(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Обработчик события ОбработкаПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект - содержит сам объект.
//  Отказ        - Булево - признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента - в данный параметр передается текущий режим проведения.
// 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
	// Закомментированно, т.к. создаёт записи по всем задачам структуры. Если дата документа больше
	// текущей даты, то мы просто не можем изменить процент готовности/статус задачи из-за наличия
	// этих записей.
	//упоПроведениеДокументовСервер.АвтоматическийРасчетГотовности(ЭтотОбъект, Отказ, РежимПроведения);
	
	упоЗакрытиеЭтапа.УдалитьИзДвиженийСтатусовИПроцентовЗакрытыеЗадачи(ЭтотОбъект);
	
	упоПроведениеДокументовСервер.РасчетФактическихДатНачалаИОкончанияПроектныхЗадач(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Отказ        - Булево			- признак отмены проведения документа.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Добавить("ДоходныеОбъемы.ДатаПоступления");	
	ПроверяемыеРеквизиты.Добавить("РасходныеОбъемы.ДатаПоступления");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// См. описание в комментарии к одноименной процедуре в модуле УправлениеДоступом.
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокаТаб = Таблица.Добавить();
	Если ЗначениеЗаполнено(Проект) Тогда
		СтрокаТаб.ЗначениеДоступа = Проект;
	Иначе
		СтрокаТаб.ЗначениеДоступа = Справочники.Проекты.ПустаяСсылка();
	КонецЕсли;
		
КонецПроцедуры


#Область ПроцентыГотовностиИСтатусы

Процедура СчитатьПроцентыГотовностиПоДоходнымОбъемам(ДанныеДвижений, ТекущаяВерсия, КЭШПроцентов, Родители, Отказ)
	
	Если Не МожноРассчитатьПроцентГотовностиИСтатус(Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	//
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ДоходныеОбъемы.ВыгрузитьКолонку("ПроектнаяЗадача"));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ТекущаяВерсия", ТекущаяВерсия);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	план.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	план.Номенклатура КАК Субпродукт,
	               |	план.Количество КАК ПланВсего
	               |ПОМЕСТИТЬ ПланВыпускаСубпродуктов
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
	               |			,
	               |			Версия = &ТекущаяВерсия
	               |				И ПроектнаяЗадача В (&ПроектныеЗадачи)
	               |				И Основной) КАК план
	               |ГДЕ
	               |	план.Количество <> 0
	               |	ИЛИ план.Сумма <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДокОсвоения.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ДокОсвоения.Номенклатура КАК Субпродукт,
	               |	0 КАК ПланВсего,
	               |	СУММА(ДокОсвоения.Количество) КАК УжеОсвоено
	               |ПОМЕСТИТЬ ОсвоеноПоДокументу
	               |ИЗ
	               |	Документ.упоРегистрацияФактическиВыполненногоОбъема.ДоходныеОбъемы КАК ДокОсвоения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВыпускаСубпродуктов КАК План
	               |		ПО ДокОсвоения.Номенклатура = План.Субпродукт
	               |			И ДокОсвоения.ПроектнаяЗадача = План.ПроектнаяЗадача
	               |ГДЕ
	               |	ДокОсвоения.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДокОсвоения.ПроектнаяЗадача,
	               |	ДокОсвоения.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Влож.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Влож.Субпродукт КАК Субпродукт,
	               |	СУММА(Влож.ПланВсего) КАК ПланВсего,
	               |	СУММА(Влож.УжеОсвоено) КАК УжеОсвоено,
	               |	ВЫБОР
	               |		КОГДА НЕ СУММА(ЕСТЬNULL(Влож.ПланВсего, 0)) = 0
	               |			ТОГДА ВЫРАЗИТЬ(СУММА(ЕСТЬNULL(Влож.УжеОсвоено, 0)) / СУММА(Влож.ПланВсего) * 100 КАК ЧИСЛО(15, 2))
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПроцентГотовности,
	               |	ВЫБОР
	               |		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача ЕСТЬ NULL
	               |			ТОГДА Влож.ПроектнаяЗадача.ЗадачаРодитель
	               |		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель
	               |	КОНЕЦ КАК Родитель,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачиТекущий
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		План.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |		План.Субпродукт КАК Субпродукт,
	               |		План.ПланВсего КАК ПланВсего,
	               |		0 КАК УжеОсвоено
	               |	ИЗ
	               |		ПланВыпускаСубпродуктов КАК План
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		Факт.ПроектнаяЗадача,
	               |		Факт.Субпродукт,
	               |		0,
	               |		СУММА(Факт.Количество)
	               |	ИЗ
	               |		РегистрСведений.упоФактВыполненияОбъемовПоДням КАК Факт
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВыпускаСубпродуктов КАК ДанныеПлана
	               |			ПО Факт.ПроектнаяЗадача = ДанныеПлана.ПроектнаяЗадача
	               |				И Факт.Субпродукт = ДанныеПлана.Субпродукт
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		Факт.ПроектнаяЗадача,
	               |		Факт.Субпродукт
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ДокОсвоения.ПроектнаяЗадача,
	               |		ДокОсвоения.Субпродукт,
	               |		ДокОсвоения.ПланВсего,
	               |		ДокОсвоения.УжеОсвоено
	               |	ИЗ
	               |		ОсвоеноПоДокументу КАК ДокОсвоения) КАК Влож
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	               |				,
	               |				Версия = &ТекущаяВерсия
	               |					И ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ПО Влож.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
	               |				,
	               |				Версия = &ТекущаяВерсия
	               |					И ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |		ПО Влож.ПроектнаяЗадача = упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |ГДЕ
	               |	Влож.Субпродукт В
	               |			(ВЫБРАТЬ
	               |				ОсвоеноПоДокументу.Субпродукт
	               |			ИЗ
	               |				ОсвоеноПоДокументу)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Влож.ПроектнаяЗадача,
	               |	Влож.Субпродукт,
	               |	ВЫБОР
	               |		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача ЕСТЬ NULL
	               |			ТОГДА Влож.ПроектнаяЗадача.ЗадачаРодитель
	               |		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель
	               |	КОНЕЦ,
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не записал проценты готовности задач: '"), Ссылка)
			+ НСтр("ru = 'в плане выпуска не найдена номенклатура с признаком ""Основной результат"", '")
			+ НСтр("ru = 'нет базы для расчета процента готовности.'");
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	Иначе
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.ПроцентГотовности) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьВРегистрыПроцентИСтатус(ДанныеДвижений, КЭШПроцентов, ТекущаяВерсия, Выборка.ПроектнаяЗадача,
				Выборка.ПроцентГотовности, Выборка.СтатусЗадачиТекущий);
			Родитель = Выборка.Родитель;
			Если ЗначениеЗаполнено(Родитель) И Родители.Найти(Родитель) = Неопределено Тогда
				Родители.Добавить(Родитель);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

Процедура СчитатьПроцентыГотовностиРодителей(ДанныеДвижений, ТекущаяВерсия, КЭШПроцентов, Родители)
	
	// Теперь еще для родителей надо сделать. Как?
	// Думаю, надо следующим образом: если у родителя % готовности складывается из % готовности детей, 
	// то один % готовности ребенка меняется и все.
	Пока Родители.Количество() > 0 Цикл
		новыеРодители = Новый Массив;
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачи
		               |ИЗ
		               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
		               |			,
		               |			Версия = &ТекущаяВерсия
		               |				И ПроектнаяЗадача В (&Родители)) КАК упоСтатусыПроектныхЗадачСрезПоследних";
		Запрос.УстановитьПараметр("Родители", Родители);
		Запрос.УстановитьПараметр("ТекущаяВерсия", ТекущаяВерсия);
		ВыборкаТекущихСтатусовРодителей = Запрос.Выполнить().Выбрать();
		СоответствиеТекущихСтатусовРодителей = Новый Соответствие;
		Пока ВыборкаТекущихСтатусовРодителей.Следующий() Цикл
			СоответствиеТекущихСтатусовРодителей.Вставить(ВыборкаТекущихСтатусовРодителей.ПроектнаяЗадача, ВыборкаТекущихСтатусовРодителей.СтатусЗадачи);
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	задачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	задачи.ЗадачаРодитель КАК ЗадачаРодитель
		               |ПОМЕСТИТЬ СвойстваПроектныхЗадач
		               |ИЗ
		               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		               |			,
		               |			Версия = &ТекущаяВерсия
		               |				И ЗадачаРодитель В (&ЗадачаРодитель)) КАК задачи
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	задачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	ЕСТЬNULL(проценты.ПроцентГотовности, 0) КАК ПроцентГотовности,
		               |	задачи.ЗадачаРодитель КАК Родитель,
		               |	задачи.ЗадачаРодитель.ЗадачаРодитель КАК НовыйРодитель,
		               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК ТекущийСтатусЗадачи
		               |ИЗ
		               |	СвойстваПроектныхЗадач КАК задачи
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних(
		               |				,
		               |				Версия = &ТекущаяВерсия
		               |					И ПроектнаяЗадача В
		               |						(ВЫБРАТЬ
		               |							СвойстваПроектныхЗадач.ПроектнаяЗадача
		               |						ИЗ
		               |							СвойстваПроектныхЗадач)) КАК проценты
		               |		ПО (проценты.ПроектнаяЗадача = задачи.ПроектнаяЗадача)
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
		               |				,
		               |				Версия = &ТекущаяВерсия
		               |					И ПроектнаяЗадача В
		               |						(ВЫБРАТЬ
		               |							СвойстваПроектныхЗадач.ПроектнаяЗадача
		               |						ИЗ
		               |							СвойстваПроектныхЗадач)) КАК упоСтатусыПроектныхЗадачСрезПоследних
		               |		ПО задачи.ПроектнаяЗадача = упоСтатусыПроектныхЗадачСрезПоследних.ПроектнаяЗадача";
		
		Запрос.УстановитьПараметр("ЗадачаРодитель", Родители);
		Запрос.УстановитьПараметр("ТекущаяВерсия", ТекущаяВерсия);
		
		Выборка = Запрос.Выполнить().Выгрузить();
		Выборка.Индексы.Добавить("Родитель");
		
		Для каждого Родитель Из Родители Цикл
			
			ТекущийСтатусРодителя = СоответствиеТекущихСтатусовРодителей.Получить(Родитель);
			
			Дети = Выборка.НайтиСтроки(Новый Структура("Родитель", Родитель));
			Если Дети.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			суммаПроцентов = 0;
			
			ДобавилиРодителя = Ложь;
			Для каждого ребенок Из Дети Цикл
				ужеУстановленныйПроцент = КЭШПроцентов[ребенок.ПроектнаяЗадача];
				Если ужеУстановленныйПроцент = Неопределено Тогда
					суммаПроцентов = суммаПроцентов + ребенок.ПроцентГотовности;
				Иначе
					суммаПроцентов = суммаПроцентов + ужеУстановленныйПроцент;
				КонецЕсли;
				
				Если НЕ ДобавилиРодителя Тогда
					Если ЗначениеЗаполнено(ребенок.НовыйРодитель) Тогда
						новыеРодители.Добавить(ребенок.НовыйРодитель);
					КонецЕсли;
					
					ДобавилиРодителя = Истина
				КонецЕсли;
			КонецЦикла;			
			
			ДобавитьВРегистрыПроцентИСтатус(ДанныеДвижений, КЭШПроцентов, ТекущаяВерсия, Родитель,
				суммаПроцентов / дети.Количество(), ТекущийСтатусРодителя);
			
		КонецЦикла;
		
		Родители = новыеРодители;
	КонецЦикла;

КонецПроцедуры

// Очищает раннее заполненные данные по проектной задаче для обновления в вызываемом методе.
//
// Параметры:
//  ПроектнаяЗадача     - ДокументСсылка.упоПроектнаяЗадача
//  ДанныеДвижений     - Структура
//
Процедура ОчиститьДанныеГотовностиИСтатусаДляОбновления(ПроектнаяЗадача, ДанныеДвижений)
	
	Отбор = Новый Структура("ПроектнаяЗадача", ПроектнаяЗадача);
	ТаблицаПроцентыГотовности = ДанныеДвижений[Движения.упоПроцентыГотовностиПроектныхЗадач.Метаданные().Имя];
	ТаблицаСтатусы = ДанныеДвижений[Движения.упоСтатусыПроектныхЗадач.Метаданные().Имя];
	
	Строки = ТаблицаПроцентыГотовности.НайтиСтроки(Отбор);
	Для каждого Строка Из Строки Цикл
		ТаблицаПроцентыГотовности.Удалить(Строка);
	КонецЦикла;
	
	Строки = ТаблицаСтатусы.НайтиСтроки(Отбор);
	Для каждого Строка Из Строки Цикл
		ТаблицаСтатусы.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПроектВСтатусеВыполняется(Проект, СтатусПроекта)
	
	ПроектВСтатусеВыполняется = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("ДатаДокумента", КонецДня(ЭтотОбъект.Дата));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Т.СтатусПроекта КАК СтатусПроекта
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектов.СрезПоследних(&ДатаДокумента, Проект = &Проект) КАК Т";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат ПроектВСтатусеВыполняется;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	СтатусПроекта = Выборка.СтатусПроекта;
	Если СтатусПроекта = Перечисления.упоСостояниеСтатусаПроекта.Выполняется Тогда
		ПроектВСтатусеВыполняется = Истина;
	КонецЕсли;
	
	Возврат ПроектВСтатусеВыполняется;
	
КонецФункции

Функция МожноРассчитатьПроцентГотовностиИСтатус(Отказ)
	
	Результат = Ложь;
	
	Если Не ЭтотОбъект.ЗаписыватьПроцентГотовности Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтатусПроекта = Неопределено;
	Если Не ПроектВСтатусеВыполняется(ЭтотОбъект.Проект, СтатусПроекта) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru = 'Для записи процента готовности проект ""%1"" должен находиться в статусе ""Выполняется""'")
			 + НСтр("ru = ' на дату документа (на %2 проект находится в статусе ""%3"").'"),
			ЭтотОбъект.Проект,
			Формат(ЭтотОбъект.Дата, "ДЛФ=Д"),
			СтатусПроекта);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		Возврат Результат;
	КонецЕсли;
	
	Результат = Истина;
	
	Возврат Результат;
	
КонецФункции

