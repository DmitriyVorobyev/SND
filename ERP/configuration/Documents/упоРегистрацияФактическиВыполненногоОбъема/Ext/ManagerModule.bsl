
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	 
#Область ПрограммныйИнтерфейс

// Процедура заполняет объект по выбранному основанию
// 
// Параметры:
//	Объект        	- ДокументОбъект.упоРегистрацияФактическиВыполненногоОбъема, ДанныеФормыСтруктура - 
//					  объект, который надо заполнить.
//	Основание    	- Произвольный - Данные, на основании которых нужно заполнить Объект.
//	ЗаполнятьДоходы - Булево - Признак того, что нужно заполнить ТЧ "Доходные объемы".
//	ЗаполнятьРасходы- Булево - Признак того, что нужно заполнить ТЧ "Расходные объемы".
// 
Процедура ЗаполнитьОбъектПоОснованию(Объект, Основание, ЗаполнятьДоходы = Ложь, ЗаполнятьРасходы = Ложь) Экспорт
	
	Если ЗаполнятьДоходы Или ЗаполнятьРасходы Тогда
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоВерсияПланаПроекта") 
		Или ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		Если упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПроектнаяПродукция() И 
			ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			
			ТипСубпродукта = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(Основание, "ТипСубпродукта");
			Если ТипСубпродукта = Перечисления.упоТипСубпродукта.ПроектнаяПродукция Тогда
				Объект.РегистрацияПроектнойПродукции = Истина;
			КонецЕсли;
			
		КонецЕсли;

		ТаблицаРезультат = ПолучитьТаблицуОснованиеВерсии(Объект, Основание,  ЗаполнятьДоходы, ЗаполнятьРасходы); 
				
	ИначеЕсли Основание = "ВыполненнаяПроектнаяПродукцияНаДату" Тогда
		
		ТаблицаРезультат = ПолучитьТаблицуПоВыполненнойПроектнойПродукцииНаДату(Объект);
		
	Иначе
		
		ТаблицаРезультат = ПолучитьТаблицуОстатковОбъемов(Объект, ЗаполнятьДоходы, ЗаполнятьРасходы);
		
	КонецЕсли;
	
	ТаблицаОбъемы = ТаблицаРезультат.Скопировать();
	ТаблицаОбъемы.Свернуть(
		"ПроектнаяЗадача, Статья, Контрагент, Договор, Валюта, Номенклатура, ЕдиницаИзмерения, ВидОбъема, ДатаПоступления",
		"Сумма, Количество");
	
	Если ЗаполнятьДоходы Тогда
		
		УстановитьПериодРегистрацииПоДатеПоступлений(Объект, ТаблицаОбъемы);
	
		Объект.ДоходныеОбъемы.Очистить();
		Объект.РаспределениеДоходныхОбъемов.Очистить();
		
		Отбор = Новый Структура;
		Отбор.Вставить("ВидОбъема", Перечисления.упоВидЭлементаОбъемов.Доход);
		
		ТаблицаДоходы = ТаблицаРезультат.Скопировать(Отбор);
		ТаблицаДоходы.Свернуть(
			"ПроектнаяЗадача, Статья, Контрагент, Договор, Валюта, Номенклатура, ЕдиницаИзмерения, ДатаПоступления",
			"Сумма,Количество");
		
		// Кеширование
		мПроектныеЗадачи = Новый Массив;
		Для Каждого СтрокаО Из ТаблицаДоходы Цикл
			мПроектныеЗадачи.Добавить(СтрокаО.ПроектнаяЗадача);
		КонецЦикла;
		СправочникПроектПоДокументуПЗ = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(мПроектныеЗадачи,, Истина);
		
		Счетчик = 0;
		
		Для Каждого СтрокаО Из  ТаблицаДоходы Цикл
			
			НоваяСтрока = Объект.ДоходныеОбъемы.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаО);
			
			НоваяСтрока.ПроектнаяЗадачаПроект = СправочникПроектПоДокументуПЗ.Получить(НоваяСтрока.ПроектнаяЗадача);
			
			НоваяСтрока.Стоимость = ?(НоваяСтрока.Количество = 0, 0, НоваяСтрока.Сумма / НоваяСтрока.Количество);
			
			Если СвойстваПроекта.ДоходыПоПодразделениям Тогда
				
				ОтборРаспределения = Новый Структура;
				
				ОтборРаспределения.Вставить("ПроектнаяЗадача", СтрокаО.ПроектнаяЗадача);
				ОтборРаспределения.Вставить("Статья", СтрокаО.Статья);
				ОтборРаспределения.Вставить("Контрагент", СтрокаО.Контрагент);
				ОтборРаспределения.Вставить("Договор", СтрокаО.Договор);
				ОтборРаспределения.Вставить("Валюта", СтрокаО.Валюта);
				ОтборРаспределения.Вставить("Номенклатура", СтрокаО.Номенклатура);
				ОтборРаспределения.Вставить("ЕдиницаИзмерения", СтрокаО.ЕдиницаИзмерения);
				ОтборРаспределения.Вставить("ДатаПоступления", СтрокаО.ДатаПоступления);
				ОтборРаспределения.Вставить("ВидОбъема", Перечисления.упоВидЭлементаОбъемов.Доход);
				
				НайденныеСтроки = ТаблицаРезультат.НайтиСтроки(ОтборРаспределения); 
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					
					НоваяСтрока.ИндексСтрокРаспределения = Неопределено;
					
				Иначе
					
					НоваяСтрока.ИндексСтрокРаспределения = Счетчик;
					
					ЕстьРаспределение = Ложь;
					
					Для Каждого НайденнаяСтрокаРаспределения Из НайденныеСтроки Цикл
						
						Если ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.КонтрагентПодрядчик) 
							+ ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.ЗаказДоговорПодрядчика)
							+ ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.Подразделение)
							+ ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.СобствСилы_Субподряд)
							+ ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.Роль) > 0 Тогда
							
							ЕстьРаспределение = Истина;
							
							НоваяСтрокаРаспределения = Объект.РаспределениеДоходныхОбъемов.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, НайденнаяСтрокаРаспределения);
							НоваяСтрокаРаспределения.ИндексСтрокиВладельца = Счетчик;
							
						КонецЕсли;
						
					КонецЦикла;
					
					Счетчик = Счетчик + 1;
					
					Если Не ЕстьРаспределение Тогда
						НоваяСтрока.ИндексСтрокРаспределения = Неопределено;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗаполнятьРасходы Тогда
		
		Объект.РасходныеОбъемы.Очистить();
		Объект.РаспределениеРасходныхОбъемов.Очистить();
		
		Отбор = Новый Структура;
		Отбор.Вставить("ВидОбъема", Перечисления.упоВидЭлементаОбъемов.Расход);
		
		ТаблицаРасходы = ТаблицаРезультат.Скопировать(Отбор);
		ТаблицаРасходы.Свернуть("ПроектнаяЗадача, Статья, Контрагент, Договор, Валюта, Номенклатура, ЕдиницаИзмерения, ДатаПоступления",
			"Сумма,Количество");
		
		// Кеширование
		мПроектныеЗадачи = Новый Массив;
		Для Каждого СтрокаО Из ТаблицаРасходы Цикл
			мПроектныеЗадачи.Добавить(СтрокаО.ПроектнаяЗадача);
		КонецЦикла;
		СправочникПроектПоДокументуПЗ = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(мПроектныеЗадачи,, Истина);
		
		Счетчик = 0;
		
		Для Каждого СтрокаО Из  ТаблицаРасходы Цикл
			
			НоваяСтрока = Объект.РасходныеОбъемы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаО);
			
			НоваяСтрока.ПроектнаяЗадачаПроект = СправочникПроектПоДокументуПЗ.Получить(НоваяСтрока.ПроектнаяЗадача);
			НоваяСтрока.Стоимость = ?(НоваяСтрока.Количество = 0, 0, НоваяСтрока.Сумма / НоваяСтрока.Количество);
			
			Если СвойстваПроекта.РасходыПоПодразделениям Тогда
				
				ОтборРаспределения = Новый Структура;
				
				ОтборРаспределения.Вставить("ПроектнаяЗадача", СтрокаО.ПроектнаяЗадача);
				ОтборРаспределения.Вставить("Статья", СтрокаО.Статья);
				ОтборРаспределения.Вставить("Контрагент", СтрокаО.Контрагент);
				ОтборРаспределения.Вставить("Договор", СтрокаО.Договор);
				ОтборРаспределения.Вставить("Валюта", СтрокаО.Валюта);
				ОтборРаспределения.Вставить("Номенклатура", СтрокаО.Номенклатура);
				ОтборРаспределения.Вставить("ЕдиницаИзмерения", СтрокаО.ЕдиницаИзмерения);
				ОтборРаспределения.Вставить("ДатаПоступления", СтрокаО.ДатаПоступления);
				ОтборРаспределения.Вставить("ВидОбъема", Перечисления.упоВидЭлементаОбъемов.Расход);
				
				НайденныеСтроки = ТаблицаРезультат.НайтиСтроки(ОтборРаспределения); 
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					
					НоваяСтрока.ИндексСтрокРаспределения = Неопределено;
					
				Иначе
					
					НоваяСтрока.ИндексСтрокРаспределения = Счетчик;
					
					ЕстьРаспределение = Ложь;
	
					Для Каждого НайденнаяСтрокаРаспределения Из НайденныеСтроки Цикл
						
						Если ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.Подразделение)
							+ ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.СобствСилы_Субподряд)
							+ ЗначениеЗаполнено(НайденнаяСтрокаРаспределения.Роль) > 0 Тогда
							
							ЕстьРаспределение = Истина;

						НоваяСтрокаРаспределения = Объект.РаспределениеРасходныхОбъемов.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, НайденнаяСтрокаРаспределения);
						НоваяСтрокаРаспределения.ИндексСтрокиВладельца = Счетчик;
						
						КонецЕсли;
					
					КонецЦикла;
					
					Если Не ЕстьРаспределение Тогда 
						
						НоваяСтрока.ИндексСтрокРаспределения = Неопределено;
							
					КонецЕсли;
					Счетчик = Счетчик + 1;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

#Область Печать

// Переопределяет настройки печати для объекта.
//
// Параметры:
//  Настройки - см. УправлениеПечатью.НастройкиПечатиОбъекта.
//
Процедура ПриОпределенииНастроекПечати(Настройки) Экспорт
	Настройки.ПриДобавленииКомандПечати = Истина;
КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив    - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр).
//  ОбъектыПечати         - СписокЗначений  - значение - ссылка на объект;
//                                            представление - имя области в которой 
//											  был выведен объект (выходной параметр).
//  ПараметрыВывода       - Структура       - дополнительные параметры сформированных
//											  табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяМакета = "ВедомостьПоВыполненнымОбъемам";
	НужноПечататьМакет = УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета);
	Если НужноПечататьМакет Тогда
		ТабличныйДокумент = ПечатьНесколькихВедомостей(МассивОбъектов);
		СинонимМакета = НСтр("ru = 'Ведомость по выполненным объемам'");
		ПолныйПутьКМакету = ПолныйПутьКМакету("ПФ_MXL_ВедомостьПоВыполненнымОбъемам");
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			ИмяМакета,
			СинонимМакета,
			ТабличныйДокумент,
			,
			ПолныйПутьКМакету);
	КонецЕсли;
КонецПроцедуры

// Заполняет список команд печати.
//
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	ДоступКФинИнформации = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	Если ДоступКФинИнформации = "Отсутствует" Тогда
		Возврат;
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;
	КонецЕсли;
	
	КомандаПечати = КомандыПечати.Добавить();
	
	КомандаПечати.Идентификатор = "ВедомостьПоВыполненнымОбъемам";
	КомандаПечати.Представление = НСтр("ru='Ведомость по выполненным объемам'");
	КомандаПечати.МенеджерПечати = "Документ.упоРегистрацияФактическиВыполненногоОбъема";
	МассивТипов = Новый Массив();
	МассивТипов.Добавить(Тип("ДокументСсылка.упоРегистрацияФактическиВыполненногоОбъема"));
	КомандаПечати.ТипыОбъектовПечати = МассивТипов;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	
КонецПроцедуры

#КонецОбласти

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Проект)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// СтандартныеПодсистемы.ПодключаемыеКоманды

// Определяет список команд создания на основании.
//
// Параметры:
//  КомандыСозданияНаОсновании - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании.КомандыСозданияНаОсновании
//  Параметры - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании.Параметры
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Документы.упоРегистрацияФактическихДоходовИРасходов.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
КонецПроцедуры

// Для использования в процедуре ДобавитьКомандыСозданияНаОсновании других модулей менеджеров объектов.
// Добавляет в список команд создания на основании этот объект.
//
// Параметры:
//  КомандыСозданияНаОсновании - см. СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании.КомандыСозданияНаОсновании
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - описание добавленной команды.
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт
	
	Возврат СозданиеНаОсновании.ДобавитьКомандуСозданияНаОсновании(КомандыСозданияНаОсновании, Метаданные.Документы.упоРегистрацияФактическиВыполненногоОбъема);
	
КонецФункции

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТаблицуОснованиеВерсии(Объект, Основание,  ЗаполнятьДоходы, ЗаполнятьРасходы)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
		ТекстУсловия = ",	Версия = &ТекущаяВерсия И ПроектнаяЗадача = &Основание";
		ОтборНеОтмененых = "";
		
	Иначе
		
		текущаяВерсия = Основание;		 
		ТекстУсловия = ",Версия = &ТекущаяВерсия";
		ОтборНеОтмененых = "		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	                       |		ПО упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	                       |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)";
		
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача,
	|	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Статья,
