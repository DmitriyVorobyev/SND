	                       |ГДЕ
	                       |	(ВложенныйЗапрос.Количество <> 0
						   |			ИЛИ ВложенныйЗапрос.Сумма <> 0)";
	
	ТаблицаРезультат = ЗапросОстатков.Выполнить().Выгрузить();
	
	ТаблицаКопия = ТаблицаЗаполненияПоТаблицеЗапроса(ТаблицаРезультат, ЗаполнятьДоходы, ЗаполнятьРасходы);
	
	Возврат ТаблицаКопия;
	
КонецФункции

Функция ПолучитьТаблицуПоВыполненнойПроектнойПродукцииНаДату(Объект)
	
	ДатаНачала = Объект.ПериодРегистрации;
	ДатаОкончания = КонецМесяца(ДатаНачала);
	Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекВерсия", Версия);
	Запрос.УстановитьПараметр("Проект", Объект.Проект);
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСтатусыПроектнойПродукцииСрезПоследних.ПроектнаяПродукция КАК ПроектнаяПродукция,
	               |	упоСтатусыПроектнойПродукцииСрезПоследних.Период КАК ДатаПоступления
	               |ПОМЕСТИТЬ ВТ_ПроектнаяПродукция
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектнойПродукции.СрезПоследних(, Версия = &ТекВерсия) КАК упоСтатусыПроектнойПродукцииСрезПоследних
	               |ГДЕ
	               |	упоСтатусыПроектнойПродукцииСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.упоСтатусыПроектнойПродукции.Закрыто)
	               |	И упоСтатусыПроектнойПродукцииСрезПоследних.Период <= &ДатаОкончания
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Статья КАК Статья,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ВидОбъема КАК ВидОбъема,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Контрагент КАК Контрагент,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Договор КАК Договор,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Валюта КАК Валюта,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Подразделение КАК Подразделение,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Роль КАК Роль,
	               |	ВЫБОР
	               |		КОГДА упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Номенклатура = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |		ИНАЧЕ упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Номенклатура
	               |	КОНЕЦ КАК Номенклатура,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	               |	упоАктуальныеПланыВыполненияОбъемовСрезПоследних.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	ВЫБОР
