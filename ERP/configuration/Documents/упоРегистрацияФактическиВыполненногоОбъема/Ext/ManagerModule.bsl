	               |	ВТ_Факт.Контрагент,
	               |	ВТ_Факт.Договор,
	               |	ВТ_Факт.Валюта,
	               |	ВТ_Факт.Подразделение,
	               |	ВТ_Факт.Роль,
	               |	ВТ_Факт.Номенклатура,
	               |	ВТ_Факт.ЕдиницаИзмерения,
	               |	ВТ_Факт.Заказ_ДоговорПодрядчика,
	               |	ВТ_Факт.СобствСилы_Субподряд,
	               |	ВТ_Факт.КонтрагентПодрядчик,
	               |	0,
	               |	0,
	               |	ВТ_Факт.СуммаФакт,
	               |	ВТ_Факт.КоличествоФакт,
	               |	ВТ_Факт.ДатаПоступления
	               |ИЗ
	               |	ВТ_Факт КАК ВТ_Факт
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВложенныйЗапрос.Статья КАК Статья,
	               |	ВложенныйЗапрос.ВидОбъема КАК ВидОбъема,
	               |	ВложенныйЗапрос.Контрагент КАК Контрагент,
	               |	ВложенныйЗапрос.Договор КАК Договор,
	               |	ВложенныйЗапрос.Валюта КАК Валюта,
	               |	ВложенныйЗапрос.Подразделение КАК Подразделение,
	               |	ВложенныйЗапрос.Роль КАК Роль,
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	ВложенныйЗапрос.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВложенныйЗапрос.ЗаказДоговорПодрядчика КАК ЗаказДоговорПодрядчика,
	               |	ВложенныйЗапрос.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	ВложенныйЗапрос.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	               |	ВложенныйЗапрос.Сумма КАК Сумма,
	               |	ВложенныйЗапрос.Количество КАК Количество,
	               |	ВложенныйЗапрос.ДатаПоступления КАК ДатаПоступления
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТ_СводнаяТаблица.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |		ВТ_СводнаяТаблица.Статья КАК Статья,
	               |		ВТ_СводнаяТаблица.ВидОбъема КАК ВидОбъема,
	               |		ВТ_СводнаяТаблица.Контрагент КАК Контрагент,
	               |		ВТ_СводнаяТаблица.Договор КАК Договор,
	               |		ВТ_СводнаяТаблица.Валюта КАК Валюта,
	               |		ВТ_СводнаяТаблица.Подразделение КАК Подразделение,
	               |		ВТ_СводнаяТаблица.Роль КАК Роль,
	               |		ВТ_СводнаяТаблица.Номенклатура КАК Номенклатура,
	               |		ВТ_СводнаяТаблица.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |		ВТ_СводнаяТаблица.Заказ_ДоговорПодрядчика КАК ЗаказДоговорПодрядчика,
	               |		ВТ_СводнаяТаблица.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |		ВТ_СводнаяТаблица.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	               |		СУММА(ВТ_СводнаяТаблица.СуммаПлан - ВТ_СводнаяТаблица.СуммаФакт) КАК Сумма,
	               |		СУММА(ВТ_СводнаяТаблица.КоличествоПлан - ВТ_СводнаяТаблица.КоличествоФакт) КАК Количество,
	               |		ВТ_СводнаяТаблица.ДатаПоступления КАК ДатаПоступления
	               |	ИЗ
	               |		ВТ_СводнаяТаблица КАК ВТ_СводнаяТаблица
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ВТ_СводнаяТаблица.ПроектнаяЗадача,
	               |		ВТ_СводнаяТаблица.Статья,
	               |		ВТ_СводнаяТаблица.ВидОбъема,
	               |		ВТ_СводнаяТаблица.Контрагент,
	               |		ВТ_СводнаяТаблица.Договор,
	               |		ВТ_СводнаяТаблица.Валюта,
	               |		ВТ_СводнаяТаблица.Подразделение,
	               |		ВТ_СводнаяТаблица.Роль,
	               |		ВТ_СводнаяТаблица.Номенклатура,
	               |		ВТ_СводнаяТаблица.ЕдиницаИзмерения,
	               |		ВТ_СводнаяТаблица.Заказ_ДоговорПодрядчика,
	               |		ВТ_СводнаяТаблица.СобствСилы_Субподряд,
	               |		ВТ_СводнаяТаблица.КонтрагентПодрядчик,
	               |		ВТ_СводнаяТаблица.ДатаПоступления) КАК ВложенныйЗапрос
	               |ГДЕ
	               |	(ВложенныйЗапрос.Количество <> 0
	               |			ИЛИ ВложенныйЗапрос.Сумма <> 0)";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	ТаблицаКопия = ТаблицаЗаполненияПоТаблицеЗапроса(ТаблицаРезультат, Истина, Ложь);
	
	Возврат ТаблицаКопия;
	
КонецФункции

Функция ТаблицаЗаполненияПоТаблицеЗапроса(ТаблицаРезультат, ЗаполнятьДоходы, ЗаполнятьРасходы)
	
	ТаблицаКопия = ТаблицаРезультат.СкопироватьКолонки();
	
	Для Каждого СтрокаТР Из ТаблицаРезультат Цикл
		
		ДобавитьДоход = ЗаполнятьДоходы И СтрокаТР.ВидОбъема = Перечисления.упоВидЭлементаОбъемов.Доход;
		ДобавитьРасход = ЗаполнятьРасходы И СтрокаТР.ВидОбъема = Перечисления.упоВидЭлементаОбъемов.Расход;
		
		Если ДобавитьДоход Или ДобавитьРасход Тогда
			НоваяСтрока = ТаблицаКопия.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТР);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаКопия;
	
КонецФункции

Процедура УстановитьПериодРегистрацииПоДатеПоступлений(Объект, ТаблицаОбъемы)
	
	ЗаполнитьПериодРегистрации = Объект.РегистрацияПроектнойПродукции И ЗначениеЗаполнено(ТаблицаОбъемы)
		И Не ЗначениеЗаполнено(Объект.ПериодРегистрации);
	
	Если Не ЗаполнитьПериодРегистрации Тогда
		Возврат;
	КонецЕсли;
	
	ДатыПоступлений = ТаблицаОбъемы.ВыгрузитьКолонку("ДатаПоступления");
	
	МаксДата = '00010101';
	Для Каждого ДатаПоступления из ДатыПоступлений Цикл
		МаксДата = Макс(МаксДата, ДатаПоступления); 
	КонецЦикла;
	
	Объект.ПериодРегистрации = МаксДата;
	
КонецПроцедуры

#Область Печать

Функция ПолныйПутьКМакету(ИмяМакета)
	
	ПолныйПутьКМакету = СтрШаблон("Документ.упоРегистрацияФактическиВыполненногоОбъема.%1", ИмяМакета);
	
	Возврат ПолныйПутьКМакету;
	
КонецФункции

Функция МакетПечатнойФормы(ИмяМакета)
	
	ПолныйПутьКМакету = ПолныйПутьКМакету(ИмяМакета);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы(ПолныйПутьКМакету);
	
	Возврат Макет;
	
КонецФункции

Функция ПечатьНесколькихВедомостей(МассивОбъектов)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Для Каждого Ссылка Из МассивОбъектов Цикл
		ТабличныйДокументСсылки = ПечатьВедомостиПоВыполненнымОбъемам(Ссылка);
		Если ТабличныйДокумент.ВысотаТаблицы > 0 И ТабличныйДокументСсылки.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ТабличныйДокумент.Вывести(ТабличныйДокументСсылки);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьВедомостиПоВыполненнымОбъемам(Ссылка)
	
	ДанныеШапки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Проект, ПериодРегистрации, Дата");
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ДанныеШапки.Проект);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	Макет = МакетПечатнойФормы("ПФ_MXL_ВедомостьПоВыполненнымОбъемам");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.НомерСтроки КАК НомерСтроки,
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ПроектнаяЗадача КАК ПроектнаяЗадачаПроект,
		|	ПРЕДСТАВЛЕНИЕ(упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Номенклатура) КАК ПроектнаяПродукция,
		|	ПРЕДСТАВЛЕНИЕ(упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Количество КАК Количество,
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.ДатаПоступления КАК ПериодС,
		|	ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Номенклатура) = ТИП(Справочник.упоПроектнаяПродукция)
		|			ТОГДА упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Номенклатура.КодПП
		|		ИНАЧЕ упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Номенклатура.Код
		|	КОНЕЦ КАК КодПП,
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Сумма КАК Сумма,
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Ссылка.РегистрацияПроектнойПродукции КАК РегистрацияПроектнойПродукции
		|ПОМЕСТИТЬ ВТ_ДанныеДокумента
		|ИЗ
		|	Документ.упоРегистрацияФактическиВыполненногоОбъема.ДоходныеОбъемы КАК упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы
		|ГДЕ
		|	упоРегистрацияФактическиВыполненногоОбъемаДоходныеОбъемы.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ДанныеДокумента.НомерСтроки КАК НомерСтроки,
		|	ВТ_ДанныеДокумента.Количество КАК Количество,
		|	ЕСТЬNULL(СвойстваПЗ.НазваниеЗадачи, ПРЕДСТАВЛЕНИЕ(ВТ_ДанныеДокумента.ПроектнаяЗадачаПроект)) КАК ПроектнаяЗадача,
		|	ЕСТЬNULL(СвойстваЭтапа.НазваниеЗадачи, """") КАК Этап,
		|	ВТ_ДанныеДокумента.ПроектнаяПродукция КАК ПроектнаяПродукция,
		|	ВТ_ДанныеДокумента.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ВТ_ДанныеДокумента.ПериодС КАК ПериодС,
		|	ВТ_ДанныеДокумента.КодПП КАК КодПП,
		|	ВТ_ДанныеДокумента.Сумма КАК Сумма,
		|	ВТ_ДанныеДокумента.РегистрацияПроектнойПродукции КАК РегистрацияПроектнойПродукции
		|ИЗ
		|	ВТ_ДанныеДокумента КАК ВТ_ДанныеДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК СвойстваПЗ
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК СвойстваЭтапа
		|			ПО СвойстваПЗ.ЗадачаРодитель = СвойстваЭтапа.ПроектнаяЗадача
		|		ПО ВТ_ДанныеДокумента.ПроектнаяЗадача = СвойстваПЗ.ПроектнаяЗадача
		|ИТОГИ
		|	МИНИМУМ(ПериодС),
		|	СУММА(Сумма),
		|	МИНИМУМ(РегистрацияПроектнойПродукции)
		|ПО
		|	ОБЩИЕ";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ТекВерсия", ТекВерсия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ДоходныеОбъемыОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ДоходныеОбъемыШапкаТаблицы");
	ДоходныеОбъемыОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("ДоходныеОбъемыДетали");
	ДоходныеОбъемыОбластьИтоги = Макет.ПолучитьОбласть("ДоходныеОбъемыИтоги");
	ТабДок.Очистить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТабДок.Вывести(ОбластьЗаголовок);
		
		ОбластьШапка.Параметры.ПериодС = Формат(ВыборкаДетальныеЗаписи.ПериодС, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.ПериодПо = Формат(?(ЗначениеЗаполнено(ДанныеШапки.ПериодРегистрации),
			ДанныеШапки.ПериодРегистрации, ДанныеШапки.Дата), "ДФ=dd.MM.yyyy");
		ТабДок.Вывести(ОбластьШапка);
		
		Если ВыборкаДетальныеЗаписи.РегистрацияПроектнойПродукции Тогда
			ДоходныеОбъемыОбластьШапкаТаблицы.Параметры.ЗаголовокНоменклатура = НСтр("ru = 'Проектная продукция'");
			ДоходныеОбъемыОбластьШапкаТаблицы.Параметры.ЗаголовокКод = НСтр("ru = 'Код ПП'");
		Иначе
			ДоходныеОбъемыОбластьШапкаТаблицы.Параметры.ЗаголовокНоменклатура = НСтр("ru = 'Номенклатура'");
			ДоходныеОбъемыОбластьШапкаТаблицы.Параметры.ЗаголовокКод = НСтр("ru = 'Код'");
		КонецЕсли;
		ТабДок.Вывести(ДоходныеОбъемыОбластьШапкаТаблицы);
		
		ДоходныеОбъемыВыборкаДетальныеЗаписи = ВыборкаДетальныеЗаписи.Выбрать(ОбходРезультатаЗапроса.Прямой);
		Пока ДоходныеОбъемыВыборкаДетальныеЗаписи.Следующий() Цикл
			ДоходныеОбъемыОбластьДетальныхЗаписей.Параметры.Заполнить(ДоходныеОбъемыВыборкаДетальныеЗаписи);
			ТабДок.Вывести(ДоходныеОбъемыОбластьДетальныхЗаписей);
		КонецЦикла;
		ДоходныеОбъемыОбластьИтоги.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
		
		ТабДок.Вывести(ДоходныеОбъемыОбластьИтоги);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

