	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ТекстУсловия%", ТекстУсловия);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ОтборНеОтмененых%", ОтборНеОтмененых);
	
	ЗапросОбъемов = Новый Запрос;
	ЗапросОбъемов.УстановитьПараметр("Основание", Основание);
	ЗапросОбъемов.УстановитьПараметр("ТекущаяВерсия", текущаяВерсия);
	ЗапросОбъемов.УстановитьПараметр("ТолькоПП", Объект.РегистрацияПроектнойПродукции);
	
	ЗапросОбъемов.Текст = ТекстЗапроса;
	
	ТаблицаРезультат = ЗапросОбъемов.Выполнить().Выгрузить();
	
	ТаблицаКопия = ТаблицаЗаполненияПоТаблицеЗапроса(ТаблицаРезультат, ЗаполнятьДоходы, ЗаполнятьРасходы);
	
	Возврат ТаблицаКопия;
	
КонецФункции

Функция ПолучитьТаблицуОстатковОбъемов(Объект, ЗаполнятьДоходы, ЗаполнятьРасходы)
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	
	ЗапросОстатков = Новый Запрос;
