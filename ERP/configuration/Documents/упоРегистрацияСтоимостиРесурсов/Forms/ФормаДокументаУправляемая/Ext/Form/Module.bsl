&НаКлиенте
Процедура ТипРесурсовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("МожноМенятьТип", Ложь);
	ДопПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	Если ТипРесурсовДоИзменения <> ВыбранноеЗначение
		И Не ПустаяСтрока(ВыбранноеЗначение)
		И Не (Объект.РегистрируемыеРесурсы.Количество() = 0) Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ТипРегистрируемыхРесуровОбработкаВыбораЗавершение", ЭтотОбъект, ДопПараметры);
		
		ТекстВопроса = НСтр("ru = 'Табличная часть будет очищена. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 120, КодВозвратаДиалога.Нет, НСтр("ru = 'Внимание'"));
		Возврат;
		
	ИначеЕсли Объект.РегистрируемыеРесурсы.Количество() = 0 Тогда
		
		ДопПараметры.МожноМенятьТип = Истина;
		
	КонецЕсли;
	
	ТипРегистрируемыхРесуровОбработкаВыбораЗавершение(Неопределено, ДопПараметры);
		
КонецПроцедуры

&НаКлиенте
Процедура ТипРегистрируемыхРесуровОбработкаВыбораЗавершение(Ответ, ДопПараметры) Экспорт
	
	МожноМенятьТип = ДопПараметры.МожноМенятьТип;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		МожноМенятьТип = Истина;
	КонецЕсли;
	
	Если МожноМенятьТип Тогда
		
		Объект.ТипРесурсов = ДопПараметры.ВыбранноеЗначение;
		ТипРесурсовДоИзменения = ДопПараметры.ВыбранноеЗначение;
		
		Объект.РегистрируемыеРесурсы.Очистить();
		
		ПрименитьОсобенностиВидаРесурса(ЭтаФорма);
		
	Иначе // Вернемся к прежнему состоянию
						
		Объект.ТипРесурсов = ТипРесурсовДоИзменения;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьРесурсы(Команда)
	
	Если ПустаяСтрока(Объект.ТипРесурсов) Тогда
		Сообщение = НСтр("ru = 'Сначала необходимо выбрать тип ресурсов.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		Возврат;
	КонецЕсли;
	
	ПараметрыПодбора = ПодготовитьДопПараметры();
	
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры()
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	
	ПараметрыПодбора.ЭлементВладелец = Элементы.РегистрируемыеРесурсы;
	ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники." + СокрЛП(Объект.ТипРесурсов);
	ТаблицаФормы = Объект.РегистрируемыеРесурсы;
	ИмяКолонки = "Ресурс";
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(ТаблицаФормы,  ИмяКолонки,
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
	
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
	
	Возврат ПараметрыПодбора;
		
КонецФункции

&НаКлиенте
Процедура РегистрируемыеРесурсыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПараметрыПодбораСтруктура = Неопределено;
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, "Ресурс",
		Объект.РегистрируемыеРесурсы, ЭтаФорма, Ложь, ПараметрыПодбораСтруктура);
	
	Если Объект.ТипРесурсов = ВидРесурсаНоменклатура Тогда
		
		КоллекцияНоменклатуры = Новый Массив;
		
		Для каждого Строка Из Объект.РегистрируемыеРесурсы Цикл
			КоллекцияНоменклатуры.Добавить(Строка.Ресурс);
		КонецЦикла;
		
		ЕдиницыИзмеренияНоменклатурСоответствие = ЕдиницыИзмеренияНоменклатур(КоллекцияНоменклатуры);
		
		Для каждого Строка Из Объект.РегистрируемыеРесурсы Цикл
			
			Строка.ЕдиницаНормирования = ЕдиницыИзмеренияНоменклатурСоответствие[Строка.Ресурс];
			
			упоРаботаСФормамиКлиент.ПроверитьНоменклатуруСтрокиНаЗаполнениеЕдИзмВТаблице(Объект, "РегистрируемыеРесурсы", Строка);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Функция ДополнительныеПараметрыПодбора(ТаблицаФормы,  ИмяКолонки, СписокВидимыхКолонок)
		
	СтруктураДоп = Новый Структура;
	СтруктураДоп.Вставить("АдресХранилищаВыбранных");
	СтруктураДоп.Вставить("АдресХранилищаОтбора");	
			
	СтруктураДоп.АдресХранилищаВыбранных  = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(
																			ЭтаФорма.УникальныйИдентификатор,
																			ТаблицаФормы, 
																			ИмяКолонки, 
																			СписокВидимыхКолонок);	
	СтруктураДоп.АдресХранилищаОтбора = ПодготовитьТаблицуОтбораПодбора();
		
	Возврат СтруктураДоп;
			
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗначениевТЧОбщая(ИмяКоманды)

	Если ИмяКоманды = "ЗаполнитьНормуСтоимости" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоНормыСтоимости"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "РегистрируемыеРесурсы";
		ИмяКолонки = "НормаСтоимости";
		
	ИначеЕсли ИмяКоманды = "ЗаполнитьЕдиницуНормирования" Тогда
			
		ОписаниеТиповП = Элементы.РегистрируемыеРесурсыЕдиницаНормирования.ОграничениеТипа;
		ИмяТЧ = "РегистрируемыеРесурсы";
		ИмяКолонки = "ЕдиницаНормирования";
		
	ИначеЕсли ИмяКоманды = "ЗаполнитьСтоимость" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Число"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов, , , Новый КвалификаторыЧисла(15, 2));
		ИмяТЧ = "РегистрируемыеРесурсы";
		ИмяКолонки = "Стоимость";		
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
		
	ВведенноеЗначение = упоРаботаСФормамиКлиент.ЗаполнитьЗначениеВТЧ(Объект, ИмяТЧ, ИмяКолонки, ОписаниеТиповП);
	
КонецПроцедуры

