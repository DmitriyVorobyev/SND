&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьОсобенностиВидаРесурса(ЭтаФорма) 
	
	МассивТипов = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Объект.ТипРесурсов) Тогда
		Для Каждого ВидРесурса Из ЭтаФорма.мКэшЗначений.МассивВозможныхВидовРесурсов Цикл
			МассивТипов.Добавить("СправочникСсылка." + ВидРесурса);
		КонецЦикла;
	Иначе
		МассивТипов.Добавить("СправочникСсылка." + ЭтаФорма.Объект.ТипРесурсов);
	КонецЕсли;	
	
	ОграничениеТипа = Новый ОписаниеТипов(СтрСоединить(МассивТипов, ", "));
	
	ЭтаФорма.Элементы.РегистрируемыеРесурсыРесурс.ОграничениеТипа = ОграничениеТипа;
	
	//
		
	ОграничениеТипаНормирования = Неопределено;
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.ТипРесурсов) Тогда
		ВидНормирования = ЭтаФорма.мКэшЗначений.СоответствиеВидовЕдиницНормирования.Получить(ЭтаФорма.Объект.ТипРесурсов);
		Если ЗначениеЗаполнено(ВидНормирования) Тогда
			ОграничениеТипаНормирования = Новый ОписаниеТипов("СправочникСсылка." + ВидНормирования);	
		КонецЕсли;
	КонецЕсли;	
	
	Если ОграничениеТипаНормирования = Неопределено Тогда
		МассивТипов = Новый Массив;
		Для Каждого КлючЗначение Из ЭтаФорма.мКэшЗначений.СоответствиеВидовЕдиницНормирования Цикл
			МассивТипов.Добавить("СправочникСсылка." + КлючЗначение.Значение);	
		КонецЦикла;
		МассивТипов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивТипов);
		ОграничениеТипаНормирования = Новый ОписаниеТипов(СтрСоединить(МассивТипов, ", "));
	КонецЕсли;
	
	ЭтаФорма.Элементы.РегистрируемыеРесурсыЕдиницаНормирования.ОграничениеТипа = ОграничениеТипаНормирования;
	
КонецПроцедуры

