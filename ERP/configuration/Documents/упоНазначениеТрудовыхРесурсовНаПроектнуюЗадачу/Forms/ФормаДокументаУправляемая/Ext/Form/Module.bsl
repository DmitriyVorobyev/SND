#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыделяемыеРесурсы

&НаКлиенте
Процедура ВыделяемыеРесурсыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ Копирование Тогда
		
		Отказ = Истина;
		
		Если ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
			ПараметрыПодбора = ПодготовитьДопПараметры();
			упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
			ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);
		Иначе 
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите проектную задачу'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделяемыеРесурсыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	УдалитьДублиРесурсовИзВыбранныхЗначений(ВыбранноеЗначение);
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, "Ресурс", Объект.ВыделяемыеРесурсы, ЭтаФорма);
	
	ПараметрыПодбора = Новый СписокЗначений;
	ПараметрыПодбора.Добавить(АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	
	ЗаполнитьДопДанныеВыделяемыхРесурсов(ВыбранноеЗначение, ПараметрыПодбора);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыделяемыеРесурсыРольРесурсаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ВыделяемыеРесурсы.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		
		РольРесурса = ТекДанные.РольРесурса;
		
		МассивПодразделений = ПолучитьМассивПодразделений(РольРесурса, АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
		КоличествоПодразделений = МассивПодразделений.Количество();
		Если КоличествоПодразделений > 0
			И МассивПодразделений.Найти(ТекДанные.Подразделение) = Неопределено Тогда
			
			ПодобранноеПодразделение = МассивПодразделений[0];
			
			//ТекстСообщения = НСтр("ru='Выбранное подразделение " + ТекДанные.Подразделение 
			//	+ " не соответствует подразделениям, определенным в проектной задаче для роли " 
			//	+ ТекДанные.РольРесурса + "
			//	|Системой было автоматически установлено подразделение " + ПодобранноеПодразделение + "'");
			//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			ТекДанные.Подразделение = ПодобранноеПодразделение;
			
		ИначеЕсли КоличествоПодразделений > 0
			И (НЕ МассивПодразделений.Найти(ТекДанные.Подразделение) = Неопределено) Тогда
			
			// Все ок, оставляем
			
		Иначе // Если в плане ПЗ нет подходящих подразделений, подбираем по дате регистрации.
			
			ТекДанные.Подразделение = ПодразделениеРолиПроектнойЗадачи(РольРесурса, Объект.ПроектнаяЗадача);
								
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодразделениеРолиПроектнойЗадачи(Роль, ПроектнаяЗадача)
	
	СрокиПЗ = упоПроектыИЗадачиСервер.ПолучитьСрокиПроектнойЗадачи(ПроектнаяЗадача);
	
	Подразделение = упоРесурсыИРолиВызовСервера.обПолучитьПодразделениеРоли(Роль, СрокиПЗ.ДатаНачалаПлан);
	
	Возврат Подразделение;
	
КонецФункции	


&НаКлиенте
Процедура ВыделяемыеРесурсыВариантРаспределенияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ВыделяемыеРесурсы.ТекущиеДанные;
	Если ТекущиеДанные.ВариантРаспределения = ПредопределенноеЗначение("Перечисление.упоВариантыРаспределенияТрудозатрат.ПоОперативнойЗагрузке") Тогда
		ТекущиеДанные.ДоляТрудозатрат = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделяемыеРесурсыРольРесурсаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ВыделяемыеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда      
		Возврат;
	КонецЕсли; 
	
	ОткрытьПодборРолиРесурса(ТекДанные.Ресурс, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделяемыеРесурсыПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ВыделяемыеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьПодборПодразделенияРолиРесурса(ТекДанные.РольРесурса, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделяемыеРесурсыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ВыбранноеЗначение = ПараметрыПеретаскивания.Значение;
	
	МассивРесурсов = Новый СписокЗначений;
	
	ТипВыбранногоЗначения = ТипЗнч(ВыбранноеЗначение);
	Если ТипВыбранногоЗначения = Тип("СписокЗначений") Тогда
		МассивРесурсов = ВыбранноеЗначение.ВыгрузитьЗначения();
	ИначеЕсли ТипВыбранногоЗначения = Тип("Массив") Тогда
		МассивРесурсов = ВыбранноеЗначение;
	Иначе
		МассивРесурсов.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	ИмяКолонки = "Ресурс";
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(МассивРесурсов, ИмяКолонки, Объект.ВыделяемыеРесурсы, ЭтаФорма);
	
	ПараметрыПодбора = Новый СписокЗначений;
	ПараметрыПодбора.Добавить(АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	
	ЗаполнитьДопДанныеВыделяемыхРесурсов(МассивРесурсов, ПараметрыПодбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыделяемыеРесурсыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ИмяПоля = СтрЗаменить(Поле.Имя, Элемент.Имя, "");
	Если ИмяПоля = "Ресурс" Тогда
		СтандартнаяОбработка = Ложь;
		СтрокаТаблицы = Объект.ВыделяемыеРесурсы.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если СтрокаТаблицы <> Неопределено Тогда
			ПоказатьЗначение(, СтрокаТаблицы[ИмяПоля]);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры   

&НаКлиенте
Процедура ВыделяемыеРесурсыАктивизироватьСтроку()
	
	// После добавления строк - ни одна из них не активна, при этом заголовки колонок выглядят некорректно.
	Если (Объект.ВыделяемыеРесурсы.Количество() > 0) И (Элементы.ВыделяемыеРесурсы.ТекущаяСтрока = Неопределено) Тогда
		Элементы.ВыделяемыеРесурсы.ТекущаяСтрока = Объект.ВыделяемыеРесурсы[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсвобождаемыеРесурсы

&НаКлиенте
Процедура ОсвобождаемыеРесурсыРольРесурсаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ОсвобождаемыеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда      
		Возврат;
	КонецЕсли; 
	
	ОткрытьПодборРолиРесурса(ТекДанные.Ресурс, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсвобождаемыеРесурсыПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ОсвобождаемыеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьПодборПодразделенияРолиРесурса(ТекДанные.РольРесурса, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсвобождаемыеРесурсыРесурсПриИзменении(Элемент)
	
	ТекДанные = Элементы.ОсвобождаемыеРесурсы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		СтруктураДанныхСтроки = ПолучитьСтруктуруДанныхСтрокиОсвобождаемыеРесурсы();
		ЗаполнитьЗначенияСвойств(СтруктураДанныхСтроки, ТекДанные);
		
		ПараметрыПодбора = Новый СписокЗначений;
		ПараметрыПодбора.Добавить(АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
		ДополнитьСтрокуОсвобождаемыеРесурсы(СтруктураДанныхСтроки, ПараметрыПодбора);
		
		ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураДанныхСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсвобождаемыеРесурсыПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Ресурс = Элемент.ТекущиеДанные.Ресурс;
	ПроверитьДублиРесурсов(Ресурс, Объект.ОсвобождаемыеРесурсы, Объект.ВыделяемыеРесурсы, ОтменаРедактирования, Отказ);
	
	Если Не Отказ Тогда
		Возврат;
	КонецЕсли;

	НайденнаяСтрока = Объект.ОсвобождаемыеРесурсы.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
	Если НайденнаяСтрока <> Неопределено Тогда
		НайденнаяСтрока.Ресурс = Неопределено;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьТР(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите проектную задачу'"));
		Возврат;
	КонецЕсли;
	ПараметрыПодбора = ПодготовитьДопПараметры();
		  	
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);
	
	ВыделяемыеРесурсыАктивизироватьСтроку();
	
КонецПроцедуры

