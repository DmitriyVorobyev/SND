&НаСервере
Процедура ИнициализироватьРеквизиты()
	
	АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ = 
		ДоступныеРолиПЗ(Объект.ПроектнаяЗадача, ЭтотОбъект.УникальныйИдентификатор);
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	
	УказыватьПодразделениеРолиПриПланированииТР = СвойстваПроекта.УказыватьПодразделениеРолиПриПланированииТР;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	// Перенаправим заполнение реквизитов документа
	// процедуре модуля.
	тОбъект = упоУправлениеФормамиСервер.ПолучитьОбъектПоДаннымФормы(Объект);
	тОбъект.ОбработкаЗаполнения(ВыбранноеЗначение);
	ЗначениеВДанныеФормы(тОбъект, Объект);
	
	// И приведем гиперссылку в правильный вид.
	упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "ПроектнаяЗадача");
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТабличнуюЧастьДокумента(ИмяТЧ)
	
	ТаблицаДанных = Документы[Объект.Ссылка.Метаданные().Имя].СформироватьТаблицуДанныхДляОперацииЗаполнить(Объект, ИмяТЧ);
	Объект[ИмяТЧ].Загрузить(ТаблицаДанных);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДопДанныеВыделяемыхРесурсов(СписокРесурсов, ПараметрыПодбора)
	
	Если ПараметрыПодбора.Количество() > 0 Тогда
		
		ТЗПараметры = ПолучитьИзВременногоХранилища(ПараметрыПодбора[0].Значение);
		
		Если НЕ ТипЗнч(ТЗПараметры) = Тип("ТаблицаЗначений") Тогда
			ВызватьИсключение НСтр("ru = 'НЕ ТипЗнч(ТЗПараметры) = Тип(""ТаблицаЗначений"")'");
			Возврат;
		КонецЕсли;
		
		Если ТЗПараметры.Количество() > 0 Тогда
			
			Для Каждого СтрокаТЧ Из Объект.ВыделяемыеРесурсы Цикл
				Если СписокРесурсов.НайтиПоЗначению(СтрокаТЧ.Ресурс) = Неопределено Тогда
					Продолжить;					
				КонецЕсли;	
				ЗаполнитьСтрокуВыделяемыеРесурсы(СтрокаТЧ, ТЗПараметры);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборРолиРесурса(Ресурс, РодительскийЭлементУправления)
		
	МассивРолей = ПолучитьМассивРолейТР(Ресурс, АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	СписокРолей = Новый СписокЗначений();
	СписокРолей.ЗагрузитьЗначения(МассивРолей);
	
	СтруктураОтбора = Новый Структура("Ссылка", СписокРолей);
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
	СтруктураПараметров.Вставить("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.упоРоли.ФормаВыбора", СтруктураПараметров, РодительскийЭлементУправления);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПодборПодразделенияРолиРесурса(РольРесурса, РодительскийЭлементУправления)
	
	МассивПодразделений = ПолучитьМассивПодразделений(РольРесурса, АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	
	СтруктураОтбора = Новый Структура("Ссылка", МассивПодразделений);
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Отбор", СтруктураОтбора);
	СтруктураПараметров.Вставить("РежимОтображенияТаблицы", "Список");
	ОткрытьФорму("Справочник.упоПодразделения.ФормаВыбора", СтруктураПараметров, РодительскийЭлементУправления);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры()
	
	Перем ПараметрыПодбора;
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	
	ПараметрыПодбора.ЭлементВладелец = Элементы.ВыделяемыеРесурсы;
	ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоТрудовыеРесурсы";
    ТаблицаФормы = Объект.ВыделяемыеРесурсы;
	ИмяКолонки = "Ресурс"; 
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(ТаблицаФормы, ИмяКолонки, ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
			
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
	ПараметрыПодбора.ДопПараметры.КоллекцияДоступныеДляВыбора = СтруктураДоп.АдресХранилищаДоступныеДляВыбора;
	ПараметрыПодбора.ДопПараметры.ШаблонТекстаОшибки = СтруктураДоп.ШаблонТекстаОшибки;
		
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Функция ДополнительныеПараметрыПодбора(ТаблицаФормы,  ИмяКолонки, СписокВидимыхКолонок)
	
	СтруктураДоп = Новый Структура;
	СтруктураДоп.Вставить("АдресХранилищаВыбранных");
	СтруктураДоп.Вставить("АдресХранилищаОтбора");
	СтруктураДоп.Вставить("АдресХранилищаДоступныеДляВыбора");
	СтруктураДоп.Вставить("ШаблонТекстаОшибки",
		НСтр("ru = 'Трудовому ресурсу %1 не назначена ни одна роль текущей проектной задачи.'"));
	
	СтруктураДоп.АдресХранилищаОтбора = ПодготовитьТаблицуОтбораПодбора();

	АдресХранилища = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(ЭтаФорма.УникальныйИдентификатор,
		ТаблицаФормы, ИмяКолонки, СписокВидимыхКолонок);
	СтруктураДоп.АдресХранилищаВыбранных = АдресХранилища;
	
	СтруктураДоп.АдресХранилищаДоступныеДляВыбора = ПодготовитьТаблицуДоступныхРесурсов();
	
	Возврат СтруктураДоп;
	
КонецФункции

&НаСервере
Функция ПодготовитьТаблицуОтбораПодбора()
	
	АдресВХ = Документы.упоНазначениеТрудовыхРесурсовНаПроектнуюЗадачу.ПодготовитьТаблицуТрудовыхРесурсовПроектнойЗадачи(
		Объект.ПроектнаяЗадача, ЭтаФорма.УникальныйИдентификатор);
		
	Возврат АдресВХ;
	  
КонецФункции

&НаСервере
Функция ПодготовитьТаблицуДоступныхРесурсов()
	
	МассивРесурсов = Новый Массив;
	
	ИмяКолонки = "Ресурс";
	
	ТЗРесурсыИРоли = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	
	ВХранилищеЕстьДанные = ЗначениеЗаполнено(ТЗРесурсыИРоли)
		И ТЗРесурсыИРоли.Колонки.Найти(ИмяКолонки) <> Неопределено;
	
	Если ВХранилищеЕстьДанные Тогда
		
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Роли.Ресурс КАК Ресурс
			|ИЗ
			|	РегистрСведений.упоРолиТрудовыхРесурсов.СрезПоследних(, Роль В (&СписокРолей)) КАК Роли
			|ГДЕ
			|	Роли.РольНазначена";
		Запрос.УстановитьПараметр("СписокРолей", ТЗРесурсыИРоли.ВыгрузитьКолонку(ИмяКолонки));
		
		Результат = Запрос.Выполнить();
		Если Не Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				МассивРесурсов.Добавить(Выборка.Ресурс);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(МассивРесурсов);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеРолиПЗ(ПроектнаяЗадача, Адрес)
	
	Если Не ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Сначала необходимо указать проектную задачу.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	Рег.Ресурс КАК Ресурс,
	               |	Рег.Подразделение КАК Подразделение,
	               |	Рег.УровеньПланирования КАК УровеньПланирования,
	               |	упоРолиТрудовыхРесурсовСрезПоследних.Ресурс КАК ТрудовойРесурс
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	               |			,
	               |			Версия = &ТекВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК Рег
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРолиТрудовыхРесурсов.СрезПоследних КАК упоРолиТрудовыхРесурсовСрезПоследних
	               |		ПО Рег.Ресурс = упоРолиТрудовыхРесурсовСрезПоследних.Роль
	               |			И (упоРолиТрудовыхРесурсовСрезПоследних.РольНазначена)
	               |ГДЕ
	               |	(Рег.Количество <> 0
	               |			ИЛИ Рег.Стоимость <> 0
	               |			ИЛИ Рег.ВнешняяСтоимость <> 0)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Рег.Ресурс";
	
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ТекВерсия", ТекВерсия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДоступныхРолей = РезультатЗапроса.Выгрузить();
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ТаблицаДоступныхРолей, Адрес);
	
	Возврат АдресХранилища;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьСтрокуВыделяемыеРесурсы(СтрокаТабличнойЧасти, ТЗПараметры)
	
	СтрокаТабличнойЧасти.ВариантРаспределения = ПредопределенноеЗначение("Перечисление.упоВариантыРаспределенияТрудозатрат.ПоДолеТрудозатрат");
	СтрокаТабличнойЧасти.ДоляТрудозатрат = 100;
	СтрокаТабличнойЧасти.ДоляТрудозатратПоУровнюПланирования = Перечисления.упоУровеньПланирования.Окончательный;
	
	Если НЕ СтрокаТабличнойЧасти.РольРесурса.Пустая() И НЕ СтрокаТабличнойЧасти.Подразделение.Пустая() Тогда
		Возврат;	   
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТрудовойРесурс", СтрокаТабличнойЧасти.Ресурс);
	Отбор.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
	
	Роль = Неопределено;
	Подразделение = Неопределено;
	ПоУровнюПланирования = Неопределено;
	
	НайденныеСтроки = ТЗПараметры.НайтиСтроки(Отбор); 
	Если НайденныеСтроки.Количество() Тогда
		Роль = НайденныеСтроки[0].Ресурс;
		Подразделение = НайденныеСтроки[0].Подразделение;
		ПоУровнюПланирования = НайденныеСтроки[0].УровеньПланирования;
	Иначе
		Отбор.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Предварительный);
		НайденныеСтроки = ТЗПараметры.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() Тогда
			Роль = НайденныеСтроки[0].Ресурс;
			Подразделение = НайденныеСтроки[0].Подразделение;
			ПоУровнюПланирования = НайденныеСтроки[0].УровеньПланирования;				
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.РольРесурса = Роль;
	СтрокаТабличнойЧасти.Подразделение = Подразделение;
	СтрокаТабличнойЧасти.ДоляТрудозатратПоУровнюПланирования = ПоУровнюПланирования;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнитьСтрокуОсвобождаемыеРесурсы(ДанныеСтроки, ПараметрыПодбора)
	
	ТаблицаДоступныхРолей = ПолучитьИзВременногоХранилища(ПараметрыПодбора[0].Значение); // ПараметрыПодбора[0].Значение - это
																						 // АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ
	Если НЕ ТипЗнч(ТаблицаДоступныхРолей) = Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение НСтр("ru = 'НЕ ТипЗнч(ТаблицаДоступныхРолей) = Тип(""ТаблицаЗначений"")'");
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ТрудовойРесурс", ДанныеСтроки.Ресурс);
	НайденныеСтроки = ТаблицаДоступныхРолей.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ДанныеСтроки.Подразделение = НайденныеСтроки[0].Подразделение;
		ДанныеСтроки.РольРесурса = НайденныеСтроки[0].Ресурс;
	Иначе
		ДанныеСтроки.Подразделение = Справочники.упоПодразделения.ПустаяСсылка();
		ДанныеСтроки.РольРесурса = Справочники.упоРоли.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивРолейТР(ТрудовойРесурс, АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ)
	
	ТаблицаДоступныхРолей = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	МассивРолей = ?(ЗначениеЗаполнено(ТрудовойРесурс),
					ТаблицаДоступныхРолей.Скопировать(Новый Структура("ТрудовойРесурс", ТрудовойРесурс)).ВыгрузитьКолонку("Ресурс"),
					ТаблицаДоступныхРолей.ВыгрузитьКолонку("Ресурс"));
					
	Возврат МассивРолей;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивПодразделений(РольРесурса, АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ)
	
	МассивПодразделений = Новый Массив;
	
	ТаблицаДоступныхРолей = ПолучитьИзВременногоХранилища(АдресВременногоХранилищаДанныеОДоступныхРоляхПЗ);
	
	Если ЗначениеЗаполнено(РольРесурса) Тогда
		НайденныеСтроки = ТаблицаДоступныхРолей.НайтиСтроки(Новый Структура("Ресурс", РольРесурса));
		Для каждого СтрокаДанные Из НайденныеСтроки Цикл
			Подразделение = СтрокаДанные.Подразделение;
			Если МассивПодразделений.Найти(Подразделение) = Неопределено Тогда
				МассивПодразделений.Добавить(Подразделение);
			КонецЕсли;
		КонецЦикла;
	Иначе
		МассивПодразделений = ТаблицаДоступныхРолей.ВыгрузитьКолонку("Подразделение");
	КонецЕсли;
	
	Возврат МассивПодразделений;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруДанныхСтрокиОсвобождаемыеРесурсы()
	
	Возврат Новый Структура("НомерСтроки, Ресурс, РольРесурса, Подразделение");
	
КонецФункции

&НаКлиенте
Процедура ПроверитьДублиРесурсов(Ресурс, ПроверяемаяТаблица1, ПроверяемаяТаблица2, ОтменаРедактирования, Отказ)

	упоРаботаСФормамиКлиент.ПроверитьДублиРесурсов("Ресурс", Ресурс, ПроверяемаяТаблица1, ОтменаРедактирования, Отказ);			
	упоРаботаСФормамиКлиент.ПроверитьДублиРесурсов("Ресурс", Ресурс, ПроверяемаяТаблица2, ОтменаРедактирования, 
		Отказ, , Истина);	
		
КонецПроцедуры

&НаКлиенте
Процедура УдалитьДублиРесурсовИзВыбранныхЗначений(ВыбранноеЗначение)

	ДублиРесурсов = Новый Массив;
	Для каждого Ресурс Из ВыбранноеЗначение Цикл
		Отказ = Ложь;
		ПроверитьДублиРесурсов(Ресурс.Значение, Объект.ВыделяемыеРесурсы, Объект.ОсвобождаемыеРесурсы, Ложь, Отказ);
		Если Отказ Тогда
			ДублиРесурсов.Добавить(Ресурс.Значение);	
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ДубльРесурса Из ДублиРесурсов Цикл
		НайденныйТР = ВыбранноеЗначение.НайтиПоЗначению(ДубльРесурса);	
		ВыбранноеЗначение.Удалить(НайденныйТР);
	КонецЦикла;
			
КонецПроцедуры

#КонецОбласти
