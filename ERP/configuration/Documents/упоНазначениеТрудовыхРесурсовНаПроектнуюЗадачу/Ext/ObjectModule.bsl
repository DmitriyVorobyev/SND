// Обработчик события ОбработкаПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
	Если НЕ Отказ Тогда
		
		Движения.упоВыделенныеТрудовыеРесурсы.Записать();		
		
		Если ДополнительныеСвойства.Свойство("ВыполнитьДвиженияПоРегиструТрудозатратыПоДням") Тогда
			ВыполнитьДвиженияПоРегиструТрудозатратыПоДням = ДополнительныеСвойства.ВыполнитьДвиженияПоРегиструТрудозатратыПоДням;	
		Иначе
			ВыполнитьДвиженияПоРегиструТрудозатратыПоДням = Истина;
		КонецЕсли;
		Если ВыполнитьДвиженияПоРегиструТрудозатратыПоДням Тогда		
			упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(ПроектнаяЗадача, ЭтотОбъект.Ссылка);
		КонецЕсли;
		
		упоЗадания.СинхронизироватьПорученияЗадач(ПроектнаяЗадача, ПроектнаяЗадача);
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроведения()

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отмены проведения документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
	упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(ПроектнаяЗадача, ЭтотОбъект.Ссылка);
	
	упоЗадания.СинхронизироватьПорученияЗадач(ПроектнаяЗадача, Неопределено);
	
КонецПроцедуры // ОбработкаУдаленияПроведения()

