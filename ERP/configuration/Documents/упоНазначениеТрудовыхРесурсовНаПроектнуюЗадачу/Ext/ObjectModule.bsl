// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	ПравилаНаложения = Новый Структура();
	
	// Правила для регистра "ВыделенныеТрудовыеРесурсы"
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоВыделенныеТрудовыеРесурсы.Метаданные().Имя, Правила);
	
	// Правила для табличной части "ВыделяемыеРесурсы" документа
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить("ВыделяемыеРесурсы", ПравилаТаблицы);
	
	// Делаем одно движение по данной ТЧ
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ВыделениеРесурсовНаПроект", ПравилаДвижения);
	
	// Правила связи
	ПравилаДвижения.Вставить("Версия", 		Новый Структура("Значение", текущаяВерсия));
	ПравилаДвижения.Вставить("Проект", "Шапка_Проект");
	ПравилаДвижения.Вставить("ПроектнаяЗадача", "Шапка_ПроектнаяЗадача");
	ПравилаДвижения.Вставить("Ресурс", "Ресурс");
	ПравилаДвижения.Вставить("РольРесурса", "РольРесурса");
	ПравилаДвижения.Вставить("Подразделение", "Подразделение");
	ПравилаДвижения.Вставить("РесурсВыделен", Новый Структура("Значение", Истина));
	ПравилаДвижения.Вставить("ДоляТрудозатрат", "ДоляТрудозатрат");
	ПравилаДвижения.Вставить("ВариантРаспределения", "ВариантРаспределения");
	ПравилаДвижения.Вставить("ДоляТрудозатратПоУровнюПланирования", "ДоляТрудозатратПоУровнюПланирования");
	
	// Правила для табличной части "ОсвобождаемыеРесурсы" документа
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить("ОсвобождаемыеРесурсы", ПравилаТаблицы);
	
	// Делаем одно движение по данной ТЧ
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ОсвобождениеРесурсовСПроекта", ПравилаДвижения);
	
	// Правила связи
	ПравилаДвижения.Вставить("Версия", 		Новый Структура("Значение", текущаяВерсия));
	ПравилаДвижения.Вставить("Проект", "Шапка_Проект");
	ПравилаДвижения.Вставить("ПроектнаяЗадача", "Шапка_ПроектнаяЗадача");
	ПравилаДвижения.Вставить("Ресурс", "Ресурс");
	ПравилаДвижения.Вставить("РольРесурса", "РольРесурса");
	ПравилаДвижения.Вставить("Подразделение", "Подразделение");
	ПравилаДвижения.Вставить("РесурсВыделен", Новый Структура("Значение", Ложь));
	ПравилаДвижения.Вставить("ДоляТрудозатрат", Новый Структура("Значение", 0));	
	
	// Правила готовы
	Возврат ПравилаНаложения; 

КонецФункции // ПолучитьПравилаНаложенияРеквизитовНаРегистр()
 
