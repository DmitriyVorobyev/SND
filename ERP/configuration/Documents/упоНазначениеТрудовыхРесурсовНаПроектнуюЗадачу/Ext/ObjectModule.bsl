// Функция формирует структуру обязательных реквизитов шапки или заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	СтруктураОбязательныхПолей = Новый Структура;
	
	Если ИмяТабличнойЧасти = Неопределено Тогда
		// Формирование структуры обязательных реквизитов шапки.
		СтруктураОбязательныхПолей.Вставить("Проект");
		СтруктураОбязательныхПолей.Вставить("ПроектнаяЗадача");
	ИначеЕсли ИмяТабличнойЧасти = "ВыделяемыеРесурсы" Тогда
		// Формирование структуры обязательных реквизитов табличной части ВыделяемыеРесурсы.
		СтруктураОбязательныхПолей.Вставить("Ресурс");
		СтруктураОбязательныхПолей.Вставить("РольРесурса");
		Если СвойстваПроекта.УказыватьПодразделениеРолиПриПланированииТР Тогда
			СтруктураОбязательныхПолей.Вставить("Подразделение");	
		КонецЕсли;
	ИначеЕсли ИмяТабличнойЧасти = "ОсвобождаемыеРесурсы" Тогда
		// Формирование структуры обязательных реквизитов табличной части ОсвобождаемыеРесурсы.
		СтруктураОбязательныхПолей.Вставить("Ресурс");
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет заполнение обязательных реквизитов объекта.
// Если хотя бы один реквизит не заполнен, то выставляется флаг отказа от выполнения операции.
// 
// Параметры:
//  Отказ        - Булево - Признак отказа от выполнения операции.
// 
Процедура лмПроверитьЗаполнениеРеквизитов(Отказ) Экспорт
	
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Процедура проверяет корректность данных документа для записи в базу.
// 
// Параметры:
//	ДанныеДокумента - Структура - Данные документа.
//  Отказ        - Булево - Признак отказа от выполнения операции.
//  Заголовок    - Строка - Содержит заголовок сообщения.
// 
Процедура ПроверитьДанные(ДанныеДокумента, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеДокумента) = Тип("Структура") И ДанныеДокумента.Свойство("ЭтотОбъект")
		И ТипЗнч(ДанныеДокумента.ЭтотОбъект) = Тип("ДокументОбъект.упоНазначениеТрудовыхРесурсовНаПроектнуюЗадачу") 
		И ДанныеДокумента.ЭтотОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	РесурсыВыделенные = ВыделяемыеРесурсы.Выгрузить(, "Ресурс, РольРесурса");
	РесурсыСнятые = ОсвобождаемыеРесурсы.Выгрузить(, "Ресурс, РольРесурса");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РД.Ресурс,
	               |	РД.РольРесурса
	               |ПОМЕСТИТЬ ВТРесурсыВыделенные
	               |ИЗ
	               |	&РесурсыВыделенные КАК РД
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РД.Ресурс,
	               |	РД.РольРесурса
	               |ПОМЕСТИТЬ ВТРесурсыСнятые
	               |ИЗ
	               |	&РесурсыСнятые КАК РД
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Влож.Ресурс
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВТРесурсыВыделенные.Ресурс КАК Ресурс
	               |	ИЗ
	               |		ВТРесурсыВыделенные КАК ВТРесурсыВыделенные
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ВТРесурсыСнятые.Ресурс
	               |	ИЗ
	               |		ВТРесурсыСнятые КАК ВТРесурсыСнятые) КАК Влож
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Влож.Ресурс
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(Влож.Ресурс) > 1";
	Запрос.УстановитьПараметр("РесурсыВыделенные", РесурсыВыделенные);
	Запрос.УстановитьПараметр("РесурсыСнятые", РесурсыСнятые);
		
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		// Все в порядке, ресурсы еще не были назначены на роли ПЗ.
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	МассивСообщениеОшибки = Новый Массив(3);
	МассивСообщениеОшибки[0] = НСтр("ru = 'Ресурс '");
	МассивСообщениеОшибки[2] = НСтр("ru = ' присутствует в документе несколько раз'");
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСообщениеОшибки[1] = Выборка.Ресурс;
				
		ТекстОшибки = СтрСоединить(МассивСообщениеОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЦикла;
			
КонецПроцедуры

// Функция формирует структуру обязательных реквизитов при заполнении заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизитыДляВыполненияОперацииЗаполнить(ИмяТабличнойЧасти) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	// Заполенние структуры обязательных полей шапки.
	СтруктураОбязательныхПолей.Вставить("Проект");
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Функция формирует данные для заполнения заданной табличной части.
// 
// Параметры:
//  ИмяТабличнойЧасти - Строка - Имя табличной части.
// Возвращаемое значение:
//  ТаблицаЗначений - Готовая таблица значений.
// 
Функция СформироватьТаблицуДанныхДляОперацииЗаполнить(ИмяТабличнойЧасти) Экспорт
	
	// Формируем запрос
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("текВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Ресурс,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатрат,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.Подразделение,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ВариантРаспределения,
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатратПоУровнюПланирования
	               |ИЗ
	               |	РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача = &ПроектнаяЗадача
	               |				И Версия = &текВерсия) КАК упоВыделенныеТрудовыеРесурсыСрезПоследних
	               |ГДЕ
	               |	упоВыделенныеТрудовыеРесурсыСрезПоследних.РесурсВыделен
	               |АВТОУПОРЯДОЧИВАНИЕ";
			
	// Запускаем запрос
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

