#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьИсключенияПоРучномуВводу(Команда)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ИмяТЧ", "Исключения");
	ПараметрыЗаполнения.Вставить("ТипЗаполнения", "ПоПлану");
	ПараметрыЗаполнения.Вставить("ПоДаннымРегистра", Ложь);
	
	ЗаполнитьТабличнуюЧастьДокумента(ПараметрыЗаполнения);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИсключенияПоФактуВыполнения(Команда)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ИмяТЧ", "Исключения");
	ПараметрыЗаполнения.Вставить("ТипЗаполнения", "ПоФакту");
	ПараметрыЗаполнения.Вставить("ПоДаннымРегистра", Неопределено);
	
	ЗаполнитьТабличнуюЧастьДокумента(ПараметрыЗаполнения);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИсключенияПоТекущемуПлану(Команда)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ИмяТЧ", "Исключения");
	ПараметрыЗаполнения.Вставить("ТипЗаполнения", "ПоПлану");
	ПараметрыЗаполнения.Вставить("ПоДаннымРегистра", Истина);
	
	ЗаполнитьТабличнуюЧастьДокумента(ПараметрыЗаполнения);
	
КонецПроцедуры  

&НаКлиенте
Процедура ПодобратьИсключения(Команда)
	
	ПараметрыПодбора = ПодготовитьДопПараметры(Команда.Имя);
		  	
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры(ИмяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	
	АдресХранилища = "";
	
	Если ИмяКоманды = "ПодобратьИсключения" Тогда
		
		ПараметрыПодбора.ЭлементВладелец = Элементы.Исключения;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Документы.упоПроектнаяЗадача";
        ТаблицаФормы = Объект.Исключения;
	    ИмяКолонки = "Задача"; 
				
	КонецЕсли;
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(ИмяКоманды, ТаблицаФормы, ИмяКолонки,
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
			
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
		
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	// Перенаправим заполнение реквизитов документа
	// процедуре модуля.
	тОбъект = упоУправлениеФормамиСервер.ПолучитьОбъектПоДаннымФормы(Объект);
	тОбъект.ОбработкаЗаполнения(ВыбранноеЗначение);
	ЗначениеВДанныеФормы(тОбъект, Объект);
	
	// И приведем гиперссылку в правильный вид.
	упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "Проект");
	
	УстановитьДатуРасчетаПроекта();
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()	
	
	НадписьПоследняяМодификация = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	Элементы.ГруппаПланироватьОтДатыОкончания.Видимость = Истина;
	Элементы.НадписьИнформационная.Видимость = Истина;
	
	Если Объект.ПланироватьОтДатыОкончания Тогда
		Элементы.НадписьИнформационная.Заголовок = "Все задачи начинаются как можно позже.";
		Элементы.ДатаРасчетаПроекта.Заголовок = "Дата окончания проекта";
	Иначе
		Элементы.НадписьИнформационная.Заголовок = "Все задачи начинаются как можно раньше.";
		Элементы.ДатаРасчетаПроекта.Заголовок = "Дата начала проекта";
	КонецЕсли;
	                  
КонецПроцедуры

// Заполняет таблицу исключений проектными задачами с установленным
// признаком "ручной ввод сроков".
//
// Параметры:
//  ПоДаннымРегистра  - Булево - указывает, на основании каких именно данных
// 						заполнять табличную часть (из документа или из регистра).
//
&НаСервере
Процедура ЗаполнитьТаблицуИсключений(ПараметрыЗаполнения)

	Проект = Объект.Проект;
	
	Если Не ЗначениеЗаполнено(Проект) Тогда      
		обПредупреждение(НСтр("ru = 'Сначала необходимо выбрать проект.'"), 120);
		Возврат;
	КонецЕсли; 
	
	Если ПараметрыЗаполнения.ТипЗаполнения = "ПоПлану" Тогда
		
		ПоДаннымРегистра = ПараметрыЗаполнения.ПоДаннымРегистра;
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	РегСроки.ПроектнаяЗадача КАК ПроектнаяЗадача,
		               |	РегСроки.ДатаНачалаПлан КАК ДатаНачалаРег,
		               |	РегСроки.ДатаЗавершенияПлан КАК ДатаЗавершенияРег
		               |ИЗ
		               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &ТекВерсия) КАК РегСроки
		               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = РегСроки.ПроектнаяЗадача
		               |ГДЕ
		               |	(&ПоДаннымРегистра
		               |			ИЛИ упоСвойстваПроектныхЗадачСрезПоследних.РучнойВводСроков)
		               |	И упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача.Проведен";
					   
		ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);					   
					   
		ПараметрыЗапроса = Новый Структура("Проект, ПоДаннымРегистра, ТекВерсия", Проект, ПоДаннымРегистра, ТекВерсия);
		РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ПЗ = Выборка.ПроектнаяЗадача;
			
			ПараметрыОтбора = Новый Структура("Задача", ПЗ);
			НайденныеСтроки = Объект.Исключения.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()<>0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Исключения.Добавить();
			НоваяСтрока.Задача = ПЗ;
			    
			НоваяСтрока.ДатаНачала = Выборка.ДатаНачалаРег;
			НоваяСтрока.ДатаЗавершения = Выборка.ДатаЗавершенияРег;
				
		КонецЦикла;
		
	ИначеЕсли ПараметрыЗаполнения.ТипЗаполнения = "ПоФакту" Тогда	
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	РегСроки.ПроектнаяЗадача КАК Задача,
		               |	РегСроки.ДатаНачалаПлан КАК ДатаНачала,
		               |	РегСроки.ДатаЗавершенияПлан КАК ДатаЗавершения,
		               |	ИСТИНА КАК Завершенная
		               |ИЗ
		               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК РегСроки
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК РегСтатусы
		               |		ПО РегСроки.ПроектнаяЗадача = РегСтатусы.ПроектнаяЗадача
		               |ГДЕ
		               |	(РегСтатусы.СтатусЗадачи = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Завершена)
		               |			ИЛИ РегСтатусы.СтатусЗадачи = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаЗадачи.Закрыта))";
		
		Запрос.УстановитьПараметр("Версия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));
		Запрос.УстановитьПараметр("Проект", Проект);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПараметрыОтбора = Новый Структура("Задача", Выборка.Задача);
			НайденныеСтроки = Объект.Исключения.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()<>0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.Исключения.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначенияДопКолонокВИсключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатуДокумента()
	
	Если Объект.ОбновлятьДатуДокумента Тогда      
		Если НЕ ЭтаФорма.ТолькоПросмотр Тогда      
			Объект.Дата = ОбщегоНазначенияКлиент.ДатаСеанса();
		КонецЕсли; 
	КонецЕсли; 	

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияДопКолонокВИсключения()
	
	Проект = Объект.Проект;
	
	Если НЕ Проект.Пустая() Тогда      
		НужныеТаблицы = Новый Структура("ДанныеЗадачи");
		ДанныеЗадач = упоПроектыИЗадачиВызовСервера.обПолучитьДанныеПроектнойЗадачи(Проект, НужныеТаблицы);
	Иначе
		ДанныеЗадач = Неопределено;
	КонецЕсли;
	
	Для каждого СтрокаТЧ Из Объект.Исключения Цикл
		
		Задача = СтрокаТЧ.Задача;
		
		ДанныеЗадачи = ДанныеЗадач.Найти(Задача, "ПроектнаяЗадача");
		Если НЕ ДанныеЗадачи = Неопределено Тогда
			СтрокаТЧ.НазваниеЗадачи = ДанныеЗадачи.ДанныеЗадачи.Наименование;
			СтрокаТЧ.КодСДР = ДанныеЗадачи.ДанныеЗадачи.КодСДР;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьДатуРасчетаПроекта()
	
	СрокиПроекта = Справочники.Проекты.ПолучитьСроки(Объект.Проект);
	Объект.ДатаРасчетаПроекта = СрокиПроекта.ДатаНачала;
		
КонецПроцедуры

