&НаКлиенте
Процедура ИсключенияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ПараметрыПодбора = ПодготовитьДопПараметры("ПодобратьИсключения");
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы,  ИмяКолонки, СписокВидимыхКолонок)
	
	СтруктураДоп  = Новый Структура;
	
	СтруктураДоп.Вставить("АдресХранилищаВыбранных");
	СтруктураДоп.Вставить("АдресХранилищаОтбора");
	
	СтруктураДоп.АдресХранилищаОтбора = ПодготовитьТаблицуОтбораПодбора(ИмяКоманды);
	
	СписокВидимыхКолонок.Добавить("КодСДР", "Код СДР");
	СписокВидимыхКолонок.Добавить("НазваниеПроектнойЗадачи", "Название проектной задачи");
	
	АдресХранилища = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(ЭтаФорма.УникальныйИдентификатор,
		ТаблицаФормы, ИмяКолонки, СписокВидимыхКолонок);
	СтруктураДоп.АдресХранилищаВыбранных = АдресХранилища;
	
	Возврат СтруктураДоп;
	
КонецФункции

&НаСервере
Функция ПодготовитьТаблицуОтбораПодбора(имяКоманды)
	
	Перем ТаблицаОтбора;
	
	упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуОтбора(ТаблицаОтбора);	  
	
	НоваяСтрока = ТаблицаОтбора.Добавить();
	НоваяСтрока.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	НоваяСтрока.ВидСравнения  = ВидСравненияКомпоновкиДанных.ВСписке;
	НоваяСтрока.Применение =  ТипПримененияОтбораКомпоновкиДанных.Элементы;
	НоваяСтрока.Использование  = Истина;
	НоваяСтрока.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	ПЗ.Ссылка
	                |ИЗ
	                |	Документ.упоПроектнаяЗадача КАК ПЗ
	                |ГДЕ
	                |	ПЗ.Проект = &Проект";
	Запрос.УстановитьПараметр("Проект", Объект.Проект);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Массив = Таблица.ВыгрузитьКолонку("Ссылка");
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Массив);
	
	НоваяСтрока.ПравоеЗначение = Список;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОтбора, ЭтаФорма.УникальныйИдентификатор);
	  
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТабличнуюЧастьДокумента(ПараметрыЗаполнения)
	
	СтрокаСообщений = "Операция ""Заполнить"" не выполнена: ";
	Результат = упоПроверкаЗаполненияКлиент.ПроверитьЗаполнениеПолейШапки(Объект, ПараметрыЗаполнения.ИмяТЧ, СтрокаСообщений);
	Если Результат = Ложь Тогда
		упоРаботаСДиалогамиКлиент.упоПредупреждение(СтрокаСообщений);
		Возврат;
	КонецЕсли;	
	
	Если Объект[ПараметрыЗаполнения.ИмяТЧ].Количество() > 0 Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТабличнуюЧастьДокументаЗавершение", ЭтотОбъект,ПараметрыЗаполнения);  
		упоРаботаСДиалогамиКлиент.упоВопрос("Очистить табличную часть перед заполнением?", РежимДиалогаВопрос.ДаНетОтмена,,,,,ОписаниеОповещения);
		
	Иначе
		ЗаполнитьТабличнуюЧастьДокументаЗавершение(Неопределено,ПараметрыЗаполнения);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТабличнуюЧастьДокументаЗавершение(Результат,ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		Объект[ДополнительныеПараметры.ИмяТЧ].Очистить();
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура("ТипЗаполнения", ДополнительныеПараметры.ТипЗаполнения);
	ПараметрыЗаполнения.Вставить("ПоДаннымРегистра", ДополнительныеПараметры.ПоДаннымРегистра);
	
	ЗаполнитьТаблицуИсключений(ПараметрыЗаполнения);
	
КонецПроцедуры

