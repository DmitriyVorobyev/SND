&НаКлиенте
Процедура ИсключенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
		
		Для каждого ВыбрЗнач Из ВыбранноеЗначение Цикл
						
			ТекЗнач = ВыбрЗнач.Значение;
			
			ИскомыеСтроки = Объект.Исключения.НайтиСтроки(Новый Структура("Задача", ТекЗнач));
			Если ИскомыеСтроки.Количество() = 0 Тогда
				НоваяСтрока = Объект.Исключения.Добавить();
				НоваяСтрока.Задача = ТекЗнач;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьЗначенияДопКолонокВИсключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключенияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	УстановитьЗначенияДопКолонокВИсключения();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсключенияПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение, "Задача",
		Объект.Исключения, ЭтаФорма);
	
	УстановитьЗначенияДопКолонокВИсключения();
	
КонецПроцедуры

