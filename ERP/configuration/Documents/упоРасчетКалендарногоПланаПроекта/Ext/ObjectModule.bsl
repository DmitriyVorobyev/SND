// Обработчик события ПередУдалением модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Отказ        - Булево			- признак удаления документа.
// 
Процедура ПередУдалением(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередУдалением(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Обработчик события ОбработкаПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Отказ        - Булево			- признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента - в данный параметр передается текущий режим проведения.
// 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
	ИспользоватьАвтоматическийРасчетСроковСвязанныхПроектов =
		Константы.упоАвтоматическийРасчетСроковСвязанныхПроектов.Получить();
	Если Не ИспользоватьАвтоматическийРасчетСроковСвязанныхПроектов Тогда
		Возврат;
	КонецЕсли;
	ПроектныеЗадачиСНовымиСроками = Движения.упоСрокиПроектныхЗадач.ВыгрузитьКолонку("ПроектнаяЗадача");
	упоРасчетКалендарныхСроковРедакция3Сервер.ПриИзмененииСроковЗадачНеобходимоПересчитатьПроекты(ПроектныеЗадачиСНовымиСроками);
	
КонецПроцедуры

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект 	- содержит сам объект.
//  Отказ        - Булево			- признак отмены проведения документа.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ 
	               |	упоСрокиПроектныхЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача
	               |ИЗ
	               |	РегистрСведений.упоСрокиПроектныхЗадач КАК упоСрокиПроектныхЗадач
	               |ГДЕ
	               |	упоСрокиПроектныхЗадач.Регистратор = &Регистратор";
	
	МассивЗадач = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ПроектнаяЗадача");
	
	упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(МассивЗадач, ЭтотОбъект.Ссылка);
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Функция ПолучитьТекущиеСрокиПроектныхЗадач(Проект, ВерсияПроекта)
	
	ТаблицаРезультат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача,
	|	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан,
	|	упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан
	|ИЗ
	|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
	|			,
	|			ПроектнаяЗадача.Проект = &Проект
	|				И Версия = &Версия) КАК упоСрокиПроектныхЗадачСрезПоследних";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("Версия", ВерсияПроекта);
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		ТаблицаРезультат = Результат.Выгрузить();		
	КонецЕсли;
	
	Возврат ТаблицаРезультат;
		
КонецФункции

Функция ПолучитьРуководителяПроекта(Проект)
	
	РуководительПроекта = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	РуководителиПроектов.РуководительПроекта
	|ИЗ
	|	РегистрСведений.упоРуководителиПроектов.СрезПоследних(&Дата, Проект = &Проект) КАК РуководителиПроектов";
	
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("Дата"  , '00010101');
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		РуководительПроекта = Результат.Выгрузить()[0].РуководительПроекта;
	КонецЕсли;
	
	Возврат РуководительПроекта;
	
КонецФункции

Процедура ПроверитьИзменениеСроковЗапрещенныхНаРедактированиеЗадач(СоответствиеСроковЗадач, ТаблицаТекущихСроковПЗ,
																   РуководительПроекта, РуководителиПЗ, СписокСотрудников,
																   Отказ, ТекстОшибки)
																   
	Если СписокСотрудников.НайтиПоЗначению(РуководительПроекта) <> Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаголовокТекстаОшибки = НСтр("ru = 'В проекте ""%1"" обнаружены ошибки:
								 |При расчете календарного плана затронуты сроки следующих задач,
								 |на изменение которых у текущего пользователя нет полномочий:
								 |'");
																	   
	Для Каждого СтрокаДанных Из СоответствиеСроковЗадач Цикл
		
		РассчитанныеПоказатели = СтрокаДанных.Значение.Результат;
		
		Если ТипЗнч(СтрокаДанных.Ключ) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			
			Если ТипЗнч(ТаблицаТекущихСроковПЗ) = Тип("ТаблицаЗначений") Тогда
				СтрокаПредСроков = ТаблицаТекущихСроковПЗ.Найти(СтрокаДанных.Ключ, "ПроектнаяЗадача");
			Иначе
				СтрокаПредСроков = Неопределено;
			КонецЕсли;
			РуководительПЗ = ?(РуководителиПЗ = Неопределено, Неопределено,
				РуководителиПЗ.Найти(СтрокаДанных.Ключ, "ПроектнаяЗадача"));
			
			ПользовательЯвляетсяРуководителемПЗ = РуководительПЗ <> Неопределено И
				СписокСотрудников.НайтиПоЗначению(РуководительПЗ.РуководительПроектнойЗадачи) <> Неопределено;
			
			Если Не ПользовательЯвляетсяРуководителемПЗ
				И (СтрокаПредСроков = Неопределено
					Или НачалоДня(РассчитанныеПоказатели.ДатаНачала) <> НачалоДня(СтрокаПредСроков.ДатаНачалаПлан)
					Или НачалоДня(РассчитанныеПоказатели.ДатаЗавершения) <> НачалоДня(СтрокаПредСроков.ДатаЗавершенияПлан)) Тогда
				
				Отказ = Истина;
				
				СвязанныйЭлементПроекта = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(СтрокаДанных.Ключ);
				
				ТекстОшибки = ТекстОшибки + "
					|" + СвязанныйЭлементПроекта.КодСДР + " " + СтрокаДанных.Ключ.НазваниеПроектнойЗадачи;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		ТекстОшибки = ЗаголовокТекстаОшибки + ТекстОшибки;			
	КонецЕсли; 
	
КонецПроцедуры
 
