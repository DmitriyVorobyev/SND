// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	ПравилаНаложения = Новый Структура();
	
	// Правила для регистра "СрокиПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСрокиПроектныхЗадач.Метаданные().Имя, Правила);
	
	// Правила для регистра "РасчетныеСрокиПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоРасчетныеСрокиПроектныхЗадач.Метаданные().Имя, Правила);
		
	// Правила для финансовых регистров (актуальные планы БДР и БДДС).
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоАктуальныеПланыДвиженийДенежныхСредств.Метаданные().Имя, Правила);
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоАктуальныеПланыДоходовИРасходов.Метаданные().Имя, Правила);
		
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоАктуальныеПланыДоходовИРасходовПодразделения.Метаданные().Имя, Правила);
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоАктуальныеПланыВыполненияОбъемов.Метаданные().Имя, Правила);
	
	// Правила для регистра "упоСвойстваПроектов"
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСвойстваПроектов.Метаданные().Имя, Правила);
	 	
	ПравилаТаблицы = Новый Структура();	
	Правила.Вставить("ШапкаДокумента", ПравилаТаблицы);
	
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("упоСвойстваПроектов", ПравилаДвижения);
	
	ТекВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ДанныеДокумента.Проект);
	
	ПравилаДвижения.Вставить("Версия", Новый Структура("Значение", ТекВерсияПроекта));
	ПравилаДвижения.Вставить("Проект", "Шапка_Проект");
	ПравилаДвижения.Вставить("ДатаСтарта", "Шапка_ДатаРасчетаПроекта");
	
	// Правила для регистра "ПланПоставкиМатРесурсовПроектныхЗадач"
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоДанныеПлановПотребностейМатериальныхРесурсов.Метаданные().Имя, Правила);
	
	Возврат ПравилаНаложения; 

КонецФункции
 
// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт
	
	текущаяВерсияПроекта   = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	ТаблицаТекущихСроковПЗ = ПолучитьТекущиеСрокиПроектныхЗадач(Проект, текущаяВерсияПроекта);
	РуководительПроекта	   = ПолучитьРуководителяПроекта(Проект);
	РуководителиПЗ		   = упоИерархияИПолномочияСервер.ПолучитьРуководителейПроектныхЗадачПроекта(Проект);
	СписокСотрудников 	   = упоИерархияИПолномочияВызовСервера.обПолучитьСписокСотрудниковДиспетчера(
		ПользователиКлиентСервер.АвторизованныйПользователь());
	
	// Сформируем таблицу задач.
	ТаблицаЗадач = упоРасчетКалендарныхСроковРедакция3Сервер.ПодготовитьТаблицуЗадач(Проект);
	
	ТаблицаЗадач.ЗаполнитьЗначения(Ложь, "ЭтоИсключение");
	Для Каждого СтрокаИсключения Из Исключения Цикл
		СтрокаЗадачи = ТаблицаЗадач.Найти(СтрокаИсключения.Задача, "ЭлементПроекта");		
		Если СтрокаЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗадачи.ЭтоИсключение = Истина;
		СтрокаЗадачи.ДатаНачала = СтрокаИсключения.ДатаНачала;
		СтрокаЗадачи.ДатаЗавершения = СтрокаИсключения.ДатаЗавершения;
	КонецЦикла;
	
	// Сформируем структуру параметров для расчета.
	СтруктураДанных = упоРасчетКалендарныхСроковРедакция3Сервер.ПодготовитьСтруктуруДанныхПроекта(Проект, ДатаРасчетаПроекта,
																										ПланироватьОтДатыОкончания);																									
	//
	
	ТаблицаПредусловий = упоРасчетКалендарныхСроковРедакция3Сервер.ПодготовитьТаблицуПредусловий(Проект);
	
	СвойстваЭлеменов = Новый Соответствие;
	ПредшественникиМеждуПроектами = упоРасчетКалендарныхСроковРедакция3Сервер.ПолучитьДанныеПредусловийМеждуПроектами(ТаблицаПредусловий, СвойстваЭлеменов);
	Для Каждого КлючЗначение Из СвойстваЭлеменов Цикл
		НоваяСтрока = ТаблицаЗадач.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, КлючЗначение.Значение);	
		НоваяСтрока.ЭлементПроекта = КлючЗначение.Ключ;
		НоваяСтрока.НазваниеПЗ = КлючЗначение.Значение.НазваниеЗадачи;
		НоваяСтрока.ЭтоИсключение = Истина;
		НоваяСтрока.ЭтоФантом = Истина;
		Если ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			НоваяСтрока.Длительность = НоваяСтрока.Длительность * НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
		Иначе
			НоваяСтрока.Длительность = 0;
		КонецЕсли;
	КонецЦикла;
	
	//																										
	
	ТаблицаИсключений = упоРасчетКалендарныхСроковРедакция3Сервер.ПолучитьТаблицуИсключенийПоТаблицеЭлементов(ТаблицаЗадач);
	
	//
		
	Ошибки      = Неопределено;
	ТекстОшибки = "";
	
	СоответствиеСроковЗадач = упоРасчетКалендарныхСроковРедакция3Сервер.РассчитатьСрокиЗадачEx(ТаблицаЗадач, ТаблицаИсключений,
																								ТаблицаПредусловий, СтруктураДанных, Ошибки);
		
	Если ТипЗнч(СоответствиеСроковЗадач) = Тип("Дата") Тогда
		
		мТаблицаОшибки = Ошибки;
		
		ТекстОшибки = НСтр("ru = 'Календарный день, необходимый для расчета, не был найден в рабочем календаре. 
                            |Корректный расчет невозможен: %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Формат(СоответствиеСроковЗадач, "ДФ=dd.MM.yyyy"));
		обСообщитьОбОшибке(ТекстОшибки, Отказ, НСтр("ru = 'Операция не выполнена'"));
		
		Возврат;
		
	ИначеЕсли (НЕ Ошибки = Неопределено) И 
			(Ошибки.НайтиСтроки(Новый Структура("ТипОшибки", "Ошибка")).Количество() > 0) Тогда      		
			
			обСообщитьОбОшибке(НСтр("ru = 'В проекте обнаружен конфликт сроков, корректный расчет невозможен'"),
				Отказ, НСтр("ru = 'Операция не выполнена'"));
			
			ТекстОшибки = "";
			ТекстОшибки = упоРасчетКалендарныхСроковРедакция3Сервер.СобратьСообщениеОбОшибке(ТекстОшибки, Ошибки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			
			Возврат;
			
	ИначеЕсли (НЕ Ошибки = Неопределено) И (Ошибки.Количество() > 0) Тогда
			
			ТекстОшибки = "";
			ТекстОшибки = упоРасчетКалендарныхСроковРедакция3Сервер.СобратьСообщениеОбОшибке(ТекстОшибки, Ошибки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			
	КонецЕсли;
	Если Не (ДополнительныеСвойства.Свойство("ОтложенноеПроведение") Или ОбменДанными.Загрузка) Тогда
		ПроверитьИзменениеСроковЗапрещенныхНаРедактированиеЗадач(СоответствиеСроковЗадач, ТаблицаТекущихСроковПЗ,
			РуководительПроекта, РуководителиПЗ, СписокСотрудников, Отказ, ТекстОшибки);
	КонецЕсли;
		
	Если Отказ Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Проект);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли; 
	
	ТаблицаДвиженияСроки          = ДанныеДвижений[Движения.упоСрокиПроектныхЗадач.Метаданные().Имя];
	ТаблицаДвиженияРасчетныеСроки = ДанныеДвижений[Движения.упоРасчетныеСрокиПроектныхЗадач.Метаданные().Имя];      
		
	Для Каждого СтрокаДанных Из СоответствиеСроковЗадач Цикл
		
		рассчитанныеПоказатели = СтрокаДанных.Значение.Результат;
		
		// Сроки записываются только для ПЗ.
		
		Если ТипЗнч(СтрокаДанных.Ключ) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			Движение = ТаблицаДвиженияСроки.Добавить();
			Движение.Версия    			= текущаяВерсияПроекта;
			Движение.ПроектнаяЗадача    = СтрокаДанных.Ключ;
			Движение.ДатаНачалаПлан     = рассчитанныеПоказатели.ДатаНачала;
			Движение.ДатаЗавершенияПлан = рассчитанныеПоказатели.ДатаЗавершения;
		КонецЕсли; 
		
		// Расчетные сроки могут быть записаны и для операций.
		
		Движение = ТаблицаДвиженияРасчетныеСроки.Добавить();
		Движение.Версия    			= текущаяВерсияПроекта;
		Движение.ПроектнаяЗадача    = СтрокаДанных.Ключ;
		Движение.ДатаРаннегоСтарта  = рассчитанныеПоказатели.РаннийСтарт;
		Движение.ДатаРаннегоФиниша  = рассчитанныеПоказатели.РаннийФиниш;
		Движение.ДатаПозднегоСтарта = рассчитанныеПоказатели.ПозднийСтарт;
		Движение.ДатаПозднегоФиниша = рассчитанныеПоказатели.ПозднийФиниш;
		
	КонецЦикла;							   										   	
	
	// Актуализация финансовых планов проекта.
	
	упоАктуализацияПроектаВызовСервера.РассчитатьФинансовыеПланы(ЭтотОбъект,
																  ДанныеДвижений,
																  ДанныеДокумента,
																  СоответствиеСроковЗадач,
																  Неопределено,																
																  ТекущаяВерсияПроекта,
																  Отказ); 
																  													  
	// Бизнес-логика дополнительной обработки данных движения по регистру "ТрудозатратыРесурсовПоДням".
		
	МассивЗадач = ТаблицаЗадач.ВыгрузитьКолонку("ЭлементПроекта");
	
	упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(МассивЗадач, ЭтотОбъект.Ссылка);
																		  
КонецПроцедуры
 
#КонецОбласти

#Область ОбработчикиСобытий

// Обработчик события ПриУстановкеНовогоНомера модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - СправочникОбъект - содержит сам объект.
//  СтандартнаяОбработка – Булево - признак выполнения стандартной (системной) обработки события..
//                 продолжение описания параметра. 
//  Префикс      – Строка - префикс, который будет использоваться для генерации номера.
// 
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
