// Функция формирует структуру обязательных реквизитов шапки или заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	Если ИмяТабличнойЧасти = Неопределено Тогда
		// Формирование структуры обязательных реквизитов шапки.
		СтруктураОбязательныхПолей.Вставить("Проект");
		СтруктураОбязательныхПолей.Вставить("ДатаРасчетаПроекта");
	ИначеЕсли ИмяТабличнойЧасти = "Исключения" Тогда
		СтруктураОбязательныхПолей.Вставить("Задача");
		СтруктураОбязательныхПолей.Вставить("ДатаНачала");
		СтруктураОбязательныхПолей.Вставить("ДатаЗавершения");
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет заполнение обязательных реквизитов объекта.
// Если хотя бы один реквизит не заполнен, то выставляется флаг отказа от выполнения операции.
// 
// Параметры:
//  Отказ        - Булево - Признак отказа от выполнения операции.
//  Заголовок    - Строка - Содержит заголовок сообщения.
// 
Процедура лмПроверитьЗаполнениеРеквизитов(Отказ, Заголовок) Экспорт
	
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет все необходимые данные документа для его записи в ИБ.
// 
// Параметры:
//  Отказ        - Булево - Признак отказа от выполнения операции.
// 
Процедура ПроверитьДанныеПередЗаписью(Отказ) Экспорт
	
	// Получим заголовок для сообщения об ошибках при записи объекта.
	Заголовок = обСформироватьЗаголовокОшибкиПриЗаписи(ЭтотОбъект);
	
	// Проверяем заполненность обязательных реквизитов.
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет все необходимые данные документа для его проведения.
// 
// Параметры: 
//  ДанныеДокумента - Структура - содержит слепок документа.
//  Отказ           - Булево 	- Признак отказа от выполнения операции.
//  Заголовок       - Строка	- Содержит заголовок сообщения.
// 
Процедура ПроверитьДанные(ДанныеДокумента, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПроверки = Новый Структура;
	СтруктураПроверки.Вставить("Проект"                        , Проект);
	СтруктураПроверки.Вставить("ПроверятьСтруктуруЗадач"       , Ложь);
	СтруктураПроверки.Вставить("ПроверятьСрокиЗадач"           , Ложь);
	СтруктураПроверки.Вставить("ПроверятьЗаполнениеСроковЗадач", Ложь);
	СтруктураПроверки.Вставить("ПроверятьПредУсловияЗадач"     , Ложь);
	СтруктураПроверки.Вставить("ПроверятьЗацикливание"         , Истина);
	
	ТаблицаОшибок = упоПроектыИЗадачиВызовСервера.обКомплекснаяПроверкаСтруктурыПроекта(СтруктураПроверки, Истина);
	
	Если Не ТаблицаОшибок = Неопределено Тогда
		Если ТаблицаОшибок.Задачи.Количество() = 0 И ТаблицаОшибок.Общие.Количество() = 0 Тогда
			
			Возврат;
			
		КонецЕсли;
	Иначе
		СтрокаСообщения = "Не выбран проект!";
		обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		Возврат;
	КонецЕсли;
	
	СтрокаСообщения = "При проверке проекта """ + ДанныеДокумента.Проект + """ обнаружены ошибки!";
	обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
	
	упоПроектыИЗадачиВызовСервера.обОтобразитьСписокОшибок(ТаблицаОшибок, Проект);
	
КонецПроцедуры

