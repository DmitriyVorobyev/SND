&НаКлиенте
Процедура ТрудовыеРесурсыСпособПривязкиПриИзменении(Элемент)
	
	ТекущиеДанныеТР = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	
	Если ТекущиеДанныеТР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
		
		упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(ТекущиеДанныеТР, , , , УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат);
		упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(ТекущиеДанныеТР, , "ВнешняяСтоимость",
			"ОбщВнешняяСтоимость", УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат);
		
	КонецЕсли;
	
	ИндексСтрокРаспределенияПоПериодамДляУдаления = Неопределено;
	
	Если ТекущиеДанныеТР.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную")
		И ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам = Неопределено Тогда
		ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам =
			упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(
				Объект.ТрудовыеРесурсы, "ИндексСтрокРаспределенияПоПериодам")
	КонецЕсли;
	
	ПроверитьОбнулитьРаспределениеТрудозатратПриИзмененииСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
    
    ПроверитьОбнулитьРаспределениеТрудозатратПриИзмененииСтроки();
    
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыПослеУдаления(Элемент)
	
	ПересчитатьИтогиПоТрудовымРесурсам(ЭтаФорма);
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "ТрудовыеРесурсы",,,Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсполнителиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТаблицаИсполнители.ТекущиеДанные;
	
	Если Поле.Имя = "ТаблицаИсполнителиДокументРучногоРаспределения" И ТекДанные <> Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ТекДанные.ДокументРучногоРаспределения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыЕдиницаНормированияПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТрудовыеРесурсы_ПересчитатьСтоимости(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕдиницаНормированияДо = ТекущаяСтрока.ЕдиницаНормирования;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПланРасходов

&НаКлиенте
Процедура ПланРасходовСуммаПриИзменении(Элемент)
			
	ТекДанные = Элементы.ПланРасходов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	ИмяТаблицы = "ПланРасходов";
	
	РассчитатьИтогиПоТаблице(ИмяТаблицы, , Ложь, "Сумма");
	
	ПоказыватьОкноВопроса = ПроектныеОпции.РасходыПоПодразделениям;

	упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы, 
		ПоказыватьОкноВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовКонтрагентПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПроверитьДоговор(ЭтаФорма,"ПланРасходов");
	ПланРасходовДоговорПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовКонтрагентОчистка(Элемент, СтандартнаяОбработка)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланРасходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовДоговорПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПриИзмененииДоговора(ЭтаФорма,"ПланРасходов");
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланРасходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовДоговорОчистка(Элемент, СтандартнаяОбработка)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланРасходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, "ПланРасходов", "РаспределениеРасходов");	
	
	Если Объект.ВключитьПланРасходовВБДДС Тогда
		ОбновитьРасходыВДДС = Истина;	
	КонецЕсли;	
	
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПриАктивизацииСтроки(Элемент)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланРасходов");
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланРасходов",
		"РаспределениеРасходов");	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеРасходов", "ПланРасходов",
		"ИндексСтрокиРаспределенияРасходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПослеУдаления(Элемент)
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	
	Если Объект.ВключитьПланРасходовВБДДС Тогда
		ОбновитьРасходыВДДС = Истина;	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекСтрока = Элементы.ПланРасходов.ТекущиеДанные;
	                 
	Если ТекСтрока <> Неопределено И НоваяСтрока И (НЕ Копирование) Тогда
		
		ИмяТабличнойЧасти = "ПланРасходов";
		ПараметрыПодбораСтруктура = Неопределено;
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));		
		ЗаполнитьЗначенияСвойств(ПараметрыПодбораСтруктура.СтруктураСтроки, ТекСтрока);
		
		ПараметрыПодбораФормы = Новый Структура("НачалоПлан, ЗавершениеПлан", 
			мДанные_Сроки_НачалоПлан, мДанные_Сроки_ЗавершениеПлан);   		
		СтруктураДанныеСтроки = упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодборе(ПараметрыПодбораСтруктура.СтруктураСтроки,
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок, ПараметрыПодбораСтруктура.СвойстваОбъекта, ПараметрыПодбораФормы);
		ЗаполнитьЗначенияСвойств(ТекСтрока, ПараметрыПодбораСтруктура.СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(ТекСтрока, СтруктураДанныеСтроки, "СпособПривязки");
				
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланРасходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") 
		И ВыбранноеЗначение.Количество() > 0 Тогда
		
		Если ТипЗнч(ВыбранноеЗначение[0].Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			ИмяПоля = "Контрагент";
		Иначе 
			ИмяПоля = "Статья";
		КонецЕсли;
		
		ИмяТабличнойЧасти = "ПланРасходов";
		ПараметрыПодбораСтруктура = Неопределено;
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));	
		
		упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение,
			ИмяПоля, Объект.ПланРасходов, ЭтаФорма, Истина, ПараметрыПодбораСтруктура);
		
	КонецЕсли;
	
	Если Объект.ВключитьМатРесурсыВПланРасходов Тогда
		ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();
		СформироватьИтогПоФинПланам(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если ПараметрыПеретаскивания.Значение.Количество() > 0 Тогда
		
		Если ТипЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("СправочникСсылка.Контрагенты") Тогда
			имяПоля =  "Контрагент";
		Иначе 
			имяПоля =  "Статья";
		КонецЕсли;
		
		ИмяТабличнойЧасти = "ПланРасходов";
		ПараметрыПодбораСтруктура = Неопределено;
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));	
		
		упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение,
			имяПоля, Объект.ПланРасходов, ЭтаФорма, Истина, ПараметрыПодбораСтруктура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ПланРасходов.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Если НЕ ТекДанные.ИндексСтрокРаспределенияИсходнойТЧ = Неопределено 
			ИЛИ ТекДанные.ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты") Тогда
			Отказ = Истина;
			Возврат; // Строка "пришла" через автозаполнение.
		КонецЕсли;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокаРаспределяемаяПередУдалением(ЭтаФорма, Объект, "ПланРасходов",
		"РаспределениеРасходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ИмяТаблицы = "ПланРасходов";
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если Не Отказ И Копирование И упоРаботаСФормамиКлиент.ЭтоПеренесеннаяСтрокаОсновнойТаблицы(ИмяТаблицы, ТекДанные) Тогда 
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Копирование И ТекДанные <> Неопределено 
		И ТекДанные.ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределяемыеПередНачалоДобавления(ЭтаФорма, Объект,
		ИмяТаблицы, "РаспределениеРасходов", Копирование, Отказ);
		
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовПередУдалением(Элемент, Отказ)
	
	Если упоРаботаСФормамиКлиент.ЭтоПеренесеннаяСтрокаПодчиненнойТаблицы(Объект, Элемент.ТекущиеДанные, "ПланРасходов") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		
	упоАналитикаПоПодразделениямКлиент.ОчиститьСтрокиРаспределенияПоПериодам(Объект, ЭтаФорма,
		"РаспределениеРасходов", "РаспределениеРасходовПоПериодам", "ИндексСтрокиРаспределенияРасходов");

КонецПроцедуры

&НаКлиенте
Процедура ПланРасходовСтатьяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПланРасходов.ТекущиеДанные;
	
	ИменаКолонокОтражения = СтруктураИменКолонокОтражения();
	ИменаКолонокОтражения.СтатьяЗатрат = "Статья";
	ЗаполнитьНастройкиОтраженияСтатьиВБДР(ТекущиеДанные, ИменаКолонокОтражения);
	
	ДанныеПоУмолчанию = ПолучитьДанныеПоСтатьеЗатратНаСервере(ТекущиеДанные.Статья);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеПоУмолчанию);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДвиженияДенежныхСредств

&НаКлиенте
Процедура ДвиженияДенежныхСредствПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Если ТекДанные.ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДДС.Доходы") 
			ИЛИ ТекДанные.ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДДС.Расходы") Тогда
			Отказ = Истина;
			Возврат; // Строка "пришла" через автозаполнение.
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПослеУдаления(Элемент)
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекСтрока = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если НоваяСтрока Тогда
		
		Если Копирование Тогда
			
			УстановитьДоступностьДатыПривязкиДДС();	
			
		Иначе
			
			ИмяТабличнойЧасти = "ДвиженияДенежныхСредств";
			ПараметрыПодбораСтруктура = Неопределено;
			упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
				ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
			
			ЗаполнитьЗначенияСвойств(ПараметрыПодбораСтруктура.СтруктураСтроки, ТекСтрока);
			
			ПараметрыПодбораФормы = Новый Структура("НачалоПлан, ЗавершениеПлан, НачалоПланПроект, ЗавершениеПланПроект", 
				мДанные_Сроки_НачалоПлан, мДанные_Сроки_ЗавершениеПлан, СрокиПроекта.ДатаНачалаПлан, 
					СрокиПроекта.ДатаЗавершенияПлан);			
			СтруктураДанныеСтроки = упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодборе(
				ПараметрыПодбораСтруктура.СтруктураСтроки, ПараметрыПодбораСтруктура.ПараметрыПодбораСписок,
				ПараметрыПодбораСтруктура.СвойстваОбъекта, ПараметрыПодбораФормы);
			ЗаполнитьЗначенияСвойств(ТекСтрока, ПараметрыПодбораСтруктура.СтруктураСтроки);
			ЗаполнитьЗначенияСвойств(ТекСтрока, СтруктураДанныеСтроки, "ДатаПривязки,НаправлениеДвижения,СпособПривязки,СтатьяДДС");
			
			СписокЗаполняемыхСвойств = "СпособПривязки";
			Если СтруктураДанныеСтроки.Свойство("НаправлениеДвижения") Тогда
				СписокЗаполняемыхСвойств = СписокЗаполняемыхСвойств + ", НаправлениеДвижения";
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТекСтрока, СтруктураДанныеСтроки, СписокЗаполняемыхСвойств);
			
			Если ПараметрыПодбораСтруктура.СтруктураСтроки.Свойство("НаправлениеДвижения") Тогда
				
				упоРаботаСФормамиКлиент.УстановитьИконкуНаправленияВТаблицеДДС(ТекСтрока);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СформироватьИтогПоФинПланам(ЭтаФорма);	
	упоРаботаСФормамиКлиент.УстановитьИконкуНаправленияВТаблицеДДС(Элементы.ДвиженияДенежныхСредств.ТекущиеДанные);
	
