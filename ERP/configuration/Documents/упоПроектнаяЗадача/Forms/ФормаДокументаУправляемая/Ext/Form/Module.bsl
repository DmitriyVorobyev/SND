		ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));		
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение, "Ресурс",
