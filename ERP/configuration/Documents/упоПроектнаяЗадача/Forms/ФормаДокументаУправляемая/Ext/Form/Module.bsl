&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТекущийУровеньПланированияТР(ЭтаФорма) 
	
	Если ЭтаФорма.УровеньПланированияОкончательный Тогда
		Возврат ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный");
	Иначе
		Возврат ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный");
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Функция УстановитьОтборСтрокВТЧТрудовыеРесурсы(ПриОткрытии = Ложь)
	
	НуженПересчетИтогов = Истина; 
	
	Если ПриОткрытии Тогда
		
		УровеньПланированияОкончательный = Неопределено;
		Если Не мКэшПараметров.Свойство("УровеньПланированияОкончательный", УровеньПланированияОкончательный) Тогда
			
			Отбор = Новый Структура("УровеньПланирования",
					ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный"));
			СтрокиОкончательный = Объект.ТрудовыеРесурсы.НайтиСтроки(Отбор);
			
			УровеньПланированияОкончательный = СтрокиОкончательный.Количество();
			
			// При обычном открытии задачи без параметров пересчет не нужен - он произойдет позже при переключении страниц.
			НуженПересчетИтогов = Ложь; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ТрудовыеРесурсыКомандаТрудовыеРесурсыПредварительный.Пометка = Не УровеньПланированияОкончательный; 
	Элементы.ТрудовыеРесурсыКомандаТрудовыеРесурсыОкончательный.Пометка = УровеньПланированияОкончательный;
	
	Отбор = Новый Структура;
	Отбор.Вставить("УровеньПланирования", ПолучитьТекущийУровеньПланированияТР(ЭтаФорма));
	
	ФиксОтбор = Новый ФиксированнаяСтруктура(Отбор);
	
	Элементы.ТрудовыеРесурсы.ОтборСтрок = ФиксОтбор;
	
	Возврат НуженПересчетИтогов;
	
КонецФункции

&НаКлиенте
Процедура АктуализироватьРаспределениеОбъемовВТекСтроке(ВидРаспределения) 
	
	ТекДанные = Элементы.РаспределениеОбъемов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекДанные.СпособПривязки <> ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
		Возврат;
	КонецЕсли;
		
	Если СписокПериодовОбъемов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокПериодовОбъемов.СортироватьПоЗначению();	
	ПоследняяДатаФакта = Неопределено;	
	КоличествоМесяцевФакта = 0;
	
	Для Каждого ЭлементПериод Из СписокПериодовОбъемов Цикл
		
		ИмяКолонкиКоличествоФакт = "КоличествоФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
				
		ИмяКолонкиСуммаФакт = "СуммаФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
			
		Если ЗначениеЗаполнено(ТекДанные[ИмяКолонкиКоличествоФакт]) Или ЗначениеЗаполнено(ТекДанные[ИмяКолонкиСуммаФакт]) Тогда
			ПоследняяДатаФакта = ЭлементПериод.Значение;
			КоличествоМесяцевФакта = СписокПериодовОбъемов.Индекс(ЭлементПериод) + 1;
		КонецЕсли;
			
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ПоследняяДатаФакта) Тогда
		Возврат;
	КонецЕсли;
	
	МесяцевПослеФакта = СписокПериодовОбъемов.Количество() - КоличествоМесяцевФакта;
	
	Если МесяцевПослеФакта = 0 Или ПоследняяДатаФакта = СписокПериодовОбъемов[СписокПериодовОбъемов.Количество()-1].Значение Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Для актуализации увеличьте срок задачи'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	СуммаФакт = 0;
	СуммаПлан = 0;
	КоличествоФакт = 0;
	КоличествоПлан = 0;
	
	Для Каждого ЭлементПериод Из СписокПериодовОбъемов Цикл
		
		Если ЭлементПериод.Значение > ПоследняяДатаФакта Тогда
			Прервать;
		КонецЕсли;
		
		ИмяКолонкиКоличествоФакт = "КоличествоФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
				
		ИмяКолонкиСуммаФакт = "СуммаФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
				
		ИмяКолонкиКоличество = "Количество_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
				
		ИмяКолонкиСумма = "Сумма_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
				
				
		СуммаФакт = СуммаФакт + ТекДанные[ИмяКолонкиСуммаФакт];
		СуммаПлан = СуммаПлан + ТекДанные[ИмяКолонкиСумма];
		КоличествоФакт = КоличествоФакт + ТекДанные[ИмяКолонкиКоличествоФакт];
		КоличествоПлан = КоличествоПлан + ТекДанные[ИмяКолонкиКоличество];
		
	КонецЦикла;	
	
	ОстатокСумма = СуммаПлан - СуммаФакт;
	ОстатокКоличество = КоличествоПлан - КоличествоФакт; 
	
	Если ВидРаспределения = "Пропорционально" Тогда	
		
		МесяцевПослеФакта = СписокПериодовОбъемов.Количество() - КоличествоМесяцевФакта;
		
		ЧастьСумма = ОстатокСумма / МесяцевПослеФакта;
		ЧастьКоличество = ОстатокКоличество / МесяцевПослеФакта; 
		
		Для Каждого ЭлементПериод Из СписокПериодовОбъемов Цикл 
			
			ИмяКолонкиКоличество = "Количество_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");		
			ИмяКолонкиСумма = "Сумма_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
			ИмяКолонкиКоличествоФакт = "КоличествоФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");				
			ИмяКолонкиСуммаФакт = "СуммаФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
				
			//	
				
			Если ЭлементПериод.Значение <= ПоследняяДатаФакта Тогда
				ТекДанные[ИмяКолонкиСумма] = ТекДанные[ИмяКолонкиСуммаФакт];	
				ТекДанные[ИмяКолонкиКоличество] = ТекДанные[ИмяКолонкиКоличествоФакт];			
				Продолжить;
			КонецЕсли;	
						
			//
			
			ТекСумма = ТекДанные[ИмяКолонкиСумма];	
			ТекДанные[ИмяКолонкиСумма] = ЧастьСумма;			
            ОстатокСумма = ОстатокСумма - ТекДанные[ИмяКолонкиСумма];
			ТекДанные[ИмяКолонкиСумма] = ТекДанные[ИмяКолонкиСумма] + ТекСумма;
			
			ТекКоличество = ТекДанные[ИмяКолонкиКоличество];
			ТекДанные[ИмяКолонкиКоличество] = ЧастьКоличество;
			ОстатокКоличество = ОстатокКоличество - ТекДанные[ИмяКолонкиКоличество]; 
			ТекДанные[ИмяКолонкиКоличество] = ТекДанные[ИмяКолонкиКоличество] + ТекКоличество;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОстатокСумма) Или ЗначениеЗаполнено(ОстатокКоличество) Тогда
			ТекДанные[ИмяКолонкиСумма] = ТекДанные[ИмяКолонкиСумма] + ОстатокСумма;
			ТекДанные[ИмяКолонкиКоличество] = ТекДанные[ИмяКолонкиКоличество] + ОстатокКоличество;
		КонецЕсли;
		
	ИначеЕсли ВидРаспределения = "ОстатокНаСледМесяц" Тогда
		
		Для Каждого ЭлементПериод Из СписокПериодовОбъемов Цикл 
					
			ИмяКолонкиКоличество = "Количество_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");		
			ИмяКолонкиСумма = "Сумма_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");
			ИмяКолонкиКоличествоФакт = "КоличествоФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");				
			ИмяКолонкиСуммаФакт = "СуммаФакт_" + "РаспределениеОбъемов" + "_" 
				+ Формат(ЭлементПериод.Значение, "ДФ=MM_yyyy");		
				
			//	
				
			Если ЭлементПериод.Значение <= ПоследняяДатаФакта Тогда
				ТекДанные[ИмяКолонкиСумма] = ТекДанные[ИмяКолонкиСуммаФакт];	
				ТекДанные[ИмяКолонкиКоличество] = ТекДанные[ИмяКолонкиКоличествоФакт];
				Продолжить;
			КонецЕсли;	
										
			//
			
			ТекДанные[ИмяКолонкиСумма] = ТекДанные[ИмяКолонкиСумма] + ОстатокСумма;
			ТекДанные[ИмяКолонкиКоличество] = ТекДанные[ИмяКолонкиКоличество] + ОстатокКоличество;
			
			//
			
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
	РаспределениеОбъемовПриОкончанииРедактирования(Элементы.РаспределениеОбъемов, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИнформационныеСтрокиВТрудовыеРесурсы();
	
	Если Не Объект.ТранслироватьЗатратыПоСубпродуктам Тогда
		Возврат;
	КонецЕсли;
	Если Не ПроектныеОпции.ПланироватьТрудозатратыПоПроекту Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.ЕстьОбновлениеТрудозатратДляБДР = ПеренестиСтрокиПоПроектнойПродукции();
	
КонецПроцедуры

