&НаКлиенте
Процедура РолиТРЗаполнитьПоПредварительномуУровнюПланирования(Команда)
	
	Отбор = Новый Структура("УровеньПланирования",
		ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный"));
    СтрокиОкончательный = Объект.ТрудовыеРесурсы.НайтиСтроки(Отбор);

	ОписаниеОповещения = Новый ОписаниеОповещения("РолиТРЗаполнитьПоПредварительномуУровнюПланированияЗавершение",
			ЭтотОбъект);
	
	Если ЗначениеЗаполнено(СтрокиОкончательный) Тогда
		ТекстВопроса = НСтр("ru = 'Для заполнения необходимо очистить табличную часть ""Роли трудовых ресурсов"" '") 
			+ НСтр("ru = 'по окончательному уровню планирования. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса,
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		
		Возврат;
	КонецЕсли;
	
	РолиТРЗаполнитьПоПредварительномуУровнюПланированияЗавершение(КодВозвратаДиалога.Да);
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаКлиенте
Процедура ОбновитьПризнакПрохожденияПроверокПередЗаписью(Отказ)
	
	ЭтотОбъект.ПроверкиПередЗаписьюПройдены = Не Отказ И Не ЭтотОбъект.ПроверкиПередЗаписьюПройдены;
	
КонецПроцедуры

&НаКлиенте
Функция ДополнительныеПараметрыДляПроверокПередЗаписьюПоУмолчанию()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	ДополнительныеПараметры.Вставить("ЗакрытьФормуПослеЗаписи", Ложь);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьОбязательныеДействияИПроверкиПередЗаписью(Отказ, ДополнительныеПараметры = Неопределено)
	
	Если Не ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		ДополнительныеПараметры = ДополнительныеПараметрыДляПроверокПередЗаписьюПоУмолчанию();
	КонецЕсли;
	
	РежимЗаписи = ДополнительныеПараметры.РежимЗаписи;
	ЗакрытьФормуПослеЗаписи = ДополнительныеПараметры.ЗакрытьФормуПослеЗаписи;
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписи);
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
	ЗаполнитьОписаниеЗадачи();
	
	Если Не Отказ Тогда
		Если Модифицированность Тогда
			ОбновитьДатуДокумента();
		КонецЕсли;
	КонецЕсли;
	
	// Обновим трансляцию ручного распределения мат. затрат в расходы.
	ТребуетсяОбновлениеРучногоРаспределения = Ложь;
	Если ВключитьМатРесурсыВПланРасходов() И Не ПроектныеОпции.РасходыПоНатуральнымПоказателям Тогда
		ТребуетсяОбновлениеРучногоРаспределения = ВТаблицеЕстьСтрокиСРучнымРаспределениемПоПериодам(Объект, 
			"РаспределениеРасходов");
	КонецЕсли;
	Если ТребуетсяОбновлениеРучногоРаспределения Тогда
		упоРаботаСФормамиКлиент.ОбновитьРучноеРаспределениеЗатратВРасходы(Объект,
			"ПланРасходов",
			"РаспределениеРасходов",
			"РаспределениеПотребностей",
			"РаспределениеРасходовПоПериодам",
			СоответствиеРазделовКолонкиПоПериодам.РаспределениеРасходов);
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("РежимЗаписи", РежимЗаписи);
	ДополнительныеПараметры.Вставить("ЗакрытьФормуПослеЗаписи", ЗакрытьФормуПослеЗаписи);
	ДополнительныеПараметры.Вставить("УжеБылаПроверкаРаспределения", Истина);
	ПроверитьРаспределение(Отказ, ДополнительныеПараметры);
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	ПроверитьЗаполненностьСпособаПривязки(Отказ, СвойстваПроекта);
	
	Если ДоступенФункционалПроектнаяПродукция Тогда
		ОбновитьПризнакПроектнойПродукцииВПланеВыпуска();
		ОбновитьТрансляциюПроектнойПродукцииВТрудозатраты();
	КонецЕсли;
	
	ПроверитьЗаполнениеТЧРолиТрудовыхРесурсов(Отказ, СвойстваПроекта);
	
	ОбновитьПризнакПрохожденияПроверокПередЗаписью(Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДопДанныеЗадачи()
	
	СтатусИГотовность = ПолучитьДопДанныеЗадачи(Объект.Проект, Объект.Ссылка, ЭтотОбъект.ТекущаяВерсия);
	СтатусЗадачи = СтатусИГотовность.Статус;
	ПроцентГотовности = СтатусИГотовность.Готовность; 
	РуководительЗадачи = СтатусИГотовность.РуководительЗадачи;
	
	ПредставлениеСтатуса = Строка(СтатусЗадачи) + " (" + Формат(ПроцентГотовности, "ЧН=") + "%)"; 
	
	Элементы.РуководительЗадачи.Видимость = ЗначениеЗаполнено(РуководительЗадачи);
		
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьЕдиницыВремениПроектаПоУмолчанию(ЭтаФорма)
	
	ЗначенияРеквизитов = упоФункцииБСП.ПолучитьЗначенияРеквизитов(ЭтаФорма.Объект.Проект,
		"упоЕдиницаВремениПоУмолчанию, упоЕдиницаТрудоемкостиПоУмолчанию");
	
	Если ЗначенияРеквизитов.Количество() <> 0 Тогда
		ЭтаФорма.ЕдиницаВремениПоУмолчанию = ЗначенияРеквизитов.упоЕдиницаВремениПоУмолчанию;
		ЭтаФорма.ЕдиницаТрудоемкостиПоУмолчанию = ЗначенияРеквизитов.упоЕдиницаТрудоемкостиПоУмолчанию;
	КонецЕсли;
		
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Функция ЕдИзмеренияТрудоемкостиПоУмолчанию(ЭтаФорма)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ЕдиницаТрудоемкостиПоУмолчанию) Тогда
		Возврат ЭтаФорма.ЕдиницаТрудоемкостиПоУмолчанию;
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.Час");
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДопДанныеЗадачи(Проект, ПроектнаяЗадача, ТекущаяВерсия) 
	
	Результат = Новый Структура("Готовность, Статус, РуководительЗадачи", 
															0, 
															Перечисления.упоСостояниеСтатусаЗадачи.ПустаяСсылка(),
															Справочники.упоСотрудники.ПустаяСсылка());
	
	Если Не ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектнаяЗадача", 	ПроектнаяЗадача);
	Запрос.УстановитьПараметр("Проект", 			Проект);
	Запрос.УстановитьПараметр("ТекущаяВерсия", 		ТекущаяВерсия);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоСтатусыПроектныхЗадачСрезПоследних.СтатусЗадачи КАК СтатусЗадачи
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &ТекущаяВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСтатусыПроектныхЗадачСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоПроцентыГотовностиПроектныхЗадачСрезПоследних.ПроцентГотовности КАК ПроцентГотовности
	               |ИЗ
	               |	РегистрСведений.упоПроцентыГотовностиПроектныхЗадач.СрезПоследних(
	               |			,
	               |			Версия = &ТекущаяВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоПроцентыГотовностиПроектныхЗадачСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоРуководителиПроектныхЗадачАктуальные.РуководительПроектнойЗадачи КАК РуководительПроектнойЗадачи
	               |ИЗ
	               |	РегистрСведений.упоРуководителиПроектныхЗадачАктуальные КАК упоРуководителиПроектныхЗадачАктуальные
	               |ГДЕ
	               |	упоРуководителиПроектныхЗадачАктуальные.ПроектнаяЗадача = &ПроектнаяЗадача";
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	КоличествоЗапросов = РезультатПакета.ВГраница();
	
	Выборка = РезультатПакета[КоличествоЗапросов - 2].Выбрать(); 
	Если Выборка.Следующий() Тогда
		Результат.Статус = Выборка.СтатусЗадачи;
	КонецЕсли;
	Выборка = РезультатПакета[КоличествоЗапросов - 1].Выбрать(); 
	Если Выборка.Следующий() Тогда
		Результат.Готовность = Выборка.ПроцентГотовности;
	КонецЕсли;
	Выборка = РезультатПакета[КоличествоЗапросов].Выбрать(); 
	Если Выборка.Следующий() Тогда
		Результат.РуководительЗадачи = Выборка.РуководительПроектнойЗадачи;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ИнициализироватьНаКлиентеПриНеобходиомости() Экспорт 
	
	Если НеобходимаПереинициализацияНаКлиенте Тогда
		ИнициализацияФормыКлиент();
	КонецЕсли;
	
	ПодключитьОбработчикОжидания("ИнициализироватьНаКлиентеПриНеобходиомости", 1, Истина);
	
КонецФункции

// Завершение программной записи.
//
// Параметры:
//  Результат				 - Булево	 - результат предыдущих действий.
//  ДополнительныеПараметры	 - Структура - дополнительные параметры.
//
&НаКлиенте
Процедура ЗаписатьПрограммноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат = Истина Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("РежимЗаписи", ДополнительныеПараметры.РежимЗаписи);
	ПараметрыЗаписи.Вставить("УжеБылаПроверкаРаспределения", ДополнительныеПараметры.УжеБылаПроверкаРаспределения);
	Записать(ПараметрыЗаписи);
	РассчитатьИтогиПоТаблицам();
	
	Если ДополнительныеПараметры.Свойство("ОткрытьФормированиеЗаказов") Тогда
		ПроверитьЗаполненностьСсылкиОбъекта(ДополнительныеПараметры.ОткрытьФормированиеЗаказов);
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ЗакрытьФормуПослеЗаписи И ЭтаФорма.Открыта() Тогда
		ЭтаФорма.Закрыть();
	КонецЕсли;
	
КонецПроцедуры

// Заполянет ТЧ "План затрат" по плану доходов - завершение.
//
// Параметры:
//  Ответ					 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ПланЗатратЗаполнитьПоПлануДоходовЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьПланРасходов = Истина;
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		ОчиститьПланРасходов = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	ПланРасходовЗаполнитьПоПлануДоходовНаСервере(ОчиститьПланРасходов);
	
	Если ОчиститьПланРасходов И Объект.ВключитьМатРесурсыВПланРасходов  Тогда
		ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();
	КонецЕсли;
	
	Оповестить("ЗаполнениеТЧ_ПланРасходов", , Объект.Ссылка);
	
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбнулитьРаспределениеТрудозатратПриИзмененииСтроки()
	
	ТекущиеДанныеТР = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	
	Если ТекущиеДанныеТР = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьИтогиПоТрудовымРесурсам(ЭтаФорма);
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "ТрудовыеРесурсы", , , Ложь);
	
	Если Не ТекущиеДанныеТР.СпособПривязки = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
		
		ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам = Неопределено;
		
		ОбнулитьКоличествоИСуммуРучногоРаспределенияТрудовыхРесурсовЗаПериод(ТекущиеДанныеТР);
		
	КонецЕсли;
	
	СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Ложь, Ложь, Истина, Ложь);
	
КонецПроцедуры

// Распределение объемов заполнить по ролям завершение.
//
// Параметры:
//  ОтветПользователя		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьПоРолямЗавершение(Ответ, ДополнительныеПараметры) Экспорт
    
	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
    
    Очищать = Ложь;
    
    Если Ответ = КодВозвратаДиалога.Да Тогда
        Очищать = Истина;
    КонецЕсли;
    
    ДополнительныеПараметры.Вставить("Очищать", Очищать);
    
    ЗаполнитьРаспределениеОбъемовПоРолямСервер(ДополнительныеПараметры);
				
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
		"РаспределениеОбъемов", "ОбщСтоимость", Истина);
		
	упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект,
		"ПланДоходов", "РаспределениеДоходов");
	Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
		ПеренестиСтрокиОбъемовВДоходыДляИнформации();
	КонецЕсли;
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	СоздатьДопЭлементыРаспределенияДоходов(Истина, Ложь, Ложь, Ложь, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РасходыЗаполнитьПоТрудовымРесурсамЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Очищать = Ответ = КодВозвратаДиалога.Да;
	
	ИмяКоманды = ДополнительныеПараметры.КомандаИмя;
	
	ДобавитьИнформационныеСтрокиВПланДоходовИРасходов(Истина, Ложь, Истина, Ложь, Ложь);
	
	Свернуть = Истина;
	Если ДополнительныеПараметры.КомандаИмя = "ПланРасходовЗаполнитьПоТрудовымРесурсамНеСворачивать" Тогда
		Свернуть = Ложь;
	КонецЕсли;
	
	ПланРасходовЗаполнитьПоТрудовымРесурсамНаСервере(Очищать, Свернуть);
	
	Оповестить("ЗаполнениеТЧ_ПланРасходов", , Объект.Ссылка);
	
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	
	// Сняли флаг "Изменяет сохраняемые данные" у команды, необходимо установить признак модифицированности вручную.
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоходыЗаполнитьПоТрудовымМатериальнымРесурсамЗавершение(Ответ, ДополнительныеПараметры) Экспорт
    
	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
        
	Очищать = Ответ = КодВозвратаДиалога.Да;		
    ТолькоТрудовыеРесурсы = Истина;
    ТолькоМатРесурсы = Ложь;
	
    ИмяКоманды = ДополнительныеПараметры.ИмяКоманды; 
    
    Если ИмяКоманды = "ПланДоходовЗаполнитьПоПланамРесурсовПредварительныйУровень" 
        Или ИмяКоманды = "ПланДоходовЗаполнитьПоПланамРесурсовОкончательныйУровень" 
        Или ИмяКоманды = "ПланДоходовЗаполнитьПоПланамРесурсовАвтоматически" Тогда
        ТолькоТрудовыеРесурсы = Ложь;
	ИначеЕсли ИмяКоманды = "ПланДоходовЗаполнитьПоПлануМатериальныхРесурсов" Тогда
		ТолькоТрудовыеРесурсы = Ложь;
    	ТолькоМатРесурсы = Истина;
    КонецЕсли;
    
    УровеньПланирования = Неопределено;
    Если Прав(ИмяКоманды, 22) = "ПредварительныйУровень" Тогда
        УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный");    
    ИначеЕсли Прав(ИмяКоманды, 20) = "ОкончательныйУровень" Тогда
        УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный");    
    КонецЕсли;
    
    СтруктураПараметров = Новый Структура("Очищать, УровеньПланирования, ТолькоТрудовыеРесурсы, ТолькоМатРесурсы",
        Очищать, УровеньПланирования, ТолькоТрудовыеРесурсы, ТолькоМатРесурсы);
    
    ЗаполнитьДоходыПоМатериальнымТрудовымРесурсам(СтруктураПараметров);  
    
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовЗаполнитьПоТрудовымМатериальнымРесурсамЗавершение(Ответ, ДополнительныеПараметры) Экспорт
    
	Если Ответ = КодВозвратаДиалога.Отмена ИЛИ Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
        
	Очищать = Ответ = КодВозвратаДиалога.Да;		
    ТолькоТрудовыеРесурсы = Истина;
    ТолькоМатРесурсы = Ложь;

    ИмяКоманды = ДополнительныеПараметры.ИмяКоманды; 
    
    Если ИмяКоманды = "РаспределениеДоходовЗаполнитьПоПланамРесурсовПредварительныйУровень" 
        Или ИмяКоманды = "РаспределениеДоходовЗаполнитьПоПланамРесурсовОкончательныйУровень" 
        Или ИмяКоманды = "РаспределениеДоходовЗаполнитьПоПланамРесурсовАвтоматически" Тогда
        ТолькоТрудовыеРесурсы = Ложь;
	ИначеЕсли ИмяКоманды = "РаспределениеДоходовЗаполнитьПоПлануМатериальныхРесурсов" Тогда
		ТолькоТрудовыеРесурсы = Ложь;
    	ТолькоМатРесурсы = Истина;
    КонецЕсли;
    
    УровеньПланирования = Неопределено;
    Если Прав(ИмяКоманды, 22) = "ПредварительныйУровень" Тогда
        УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный");    
    ИначеЕсли Прав(ИмяКоманды, 20) = "ОкончательныйУровень" Тогда
        УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный");    
    КонецЕсли;
    
    СтруктураПараметров = Новый Структура("Очищать, УровеньПланирования, ТолькоТрудовыеРесурсы, ТолькоМатРесурсы",
        Очищать, УровеньПланирования, ТолькоТрудовыеРесурсы, ТолькоМатРесурсы);
    
    ЗаполнитьРаспределениеДоходовПоМатериальнымТрудовымРесурсам(СтруктураПараметров);  
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДоходыПоМатериальнымТрудовымРесурсам(СтруктураПараметров)
        
    ЗаполнитьДоходыПоМатериальнымТрудовымРесурсамНаСервере(СтруктураПараметров);
    
    Оповестить("ЗаполнениеТЧ_ПланДоходов", , Объект.Ссылка);
        
    РассчитатьИтогиПоТаблице("ПланДоходов", , Ложь, "Сумма");		
    
КонецПроцедуры     

&НаКлиенте
Процедура ЗаполнитьРаспределениеДоходовПоМатериальнымТрудовымРесурсам(СтруктураПараметров)
    
    ТекущиеДанныеСтрокиРаспределения = Элементы.ПланДоходов.ТекущиеДанные;
    
    Если ТекущиеДанныеСтрокиРаспределения.ИндексСтрокРаспределения = Неопределено Тогда
        упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект,
            ТекущиеДанныеСтрокиРаспределения, "ПланДоходов");    
    КонецЕсли;
    
    ДанныеСтрокиРаспределения = Новый Структура("ИндексСтрокРаспределения, Сумма");
    ЗаполнитьЗначенияСвойств(ДанныеСтрокиРаспределения, ТекущиеДанныеСтрокиРаспределения);
    СтруктураПараметров.Вставить("ДанныеСтрокиРаспределения", ДанныеСтрокиРаспределения);
    
    ЗаполнитьРаспределениеДоходовПоМатериальнымТрудовымРесурсамНаСервере(СтруктураПараметров);
    
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтотОбъект, "ПланДоходов",
		"РаспределениеДоходов") ;	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтотОбъект, "РаспределениеДоходов", "ПланДоходов",
		"ИндексСтрокиРаспределенияДоходов", Ложь);
    
КонецПроцедуры

// Исполнители кнопка изменить завершение.
//
// Параметры:
//  ВозвратДиалога			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура Исполнители_КнопкаИзменитьЗавершение(ВозвратДиалога,ДополнительныеПараметры) Экспорт
	
	Если ЭтаФорма.Модифицированность Тогда
		
		Если ВозвратДиалога = КодВозвратаДиалога.Да Тогда  			
			ЭтаФорма.Записать();  			
		Иначе
			Возврат; 						
		КонецЕсли;	
		
	КонецЕсли;
	
	СтруктураОснование = Новый Структура;
	СтруктураОснование.Вставить("Основание", Объект.Ссылка);
	
	ОткрытьФорму("Документ.упоНазначениеТрудовыхРесурсовНаПроектнуюЗадачу.ФормаОбъекта", СтруктураОснование);
	
КонецПроцедуры

// Подготовить доп. параметры структуры подбора.
//
// Параметры:
//  ПараметрыПодбораСтруктура	 - 	 - 
//  ИмяТЧ						 - 	 - 
//
&НаКлиенте
Процедура ПодготовитьДопПараметрыСтруктурыПодбора(ПараметрыПодбораСтруктура, ИмяТЧ) Экспорт
	
	Если ПараметрыПодбораСтруктура = Неопределено Тогда
		ПараметрыПодбораСтруктура = Новый Структура;
	КонецЕсли;	
	
	ПараметрыПодбораСписок = Новый СписокЗначений();
	ПараметрыПодбораСписок.Добавить(ИмяТЧ, "ИмяТабличнойЧасти");
	
	СтруктураДанных = ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТЧ); 
	
	ПараметрыПодбораСтруктура.Вставить("ПараметрыПодбораСписок", ПараметрыПодбораСписок);
	ПараметрыПодбораСтруктура.Вставить("СтруктураСтроки", СтруктураДанных.СтруктураСтрокиТЧ);
	
	ПараметрыПодбораСтруктура.Вставить("СвойстваОбъекта", СтруктураДанных.СтруктураОбъекта);	
	
	Если ИмяТЧ = "ДвиженияДенежныхСредств" Тогда
		
		Если Элементы.ДДС_ПараметрыПодбора_НаправлениеПоступление.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление"),"НаправлениеДвижения");
			
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_НаправлениеВыплата.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата"), "НаправлениеДвижения");
			
		КонецЕсли;
		
		Если Элементы.ДДС_ПараметрыПодбора_ПривязкаКНачалу.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоЗадачи"),"СпособПривязки");
			
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКЗавершению.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеЗадачи"), "СпособПривязки");
				
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКНачалуПроекта.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоПроекта"), "СпособПривязки");
				
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКЗавершениюПроекта.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеПроекта"), "СпособПривязки");
			
		КонецЕсли;
		
	ИначеЕсли ИмяТЧ = "ТрудовыеРесурсы" Тогда		
		
		ПараметрыПодбораСтруктура.Вставить("УровеньПланированияТР", ПолучитьТекущийУровеньПланированияТР(ЭтаФорма));
		ПараметрыПодбораСтруктура.Вставить("ЕдиницаНормирования", ЕдИзмеренияТрудоемкостиПоУмолчанию(ЭтаФорма));
		Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
			СтрокаПоляИсключенияЗаполнения = "";
			ПоляИсключенияЗаполнения = Новый Массив();
			Если ПараметрыПодбораСтруктура.Свойство("ПоляИсключенияЗаполнения", СтрокаПоляИсключенияЗаполнения) Тогда
				ПоляИсключенияЗаполнения.Добавить(СтрокаПоляИсключенияЗаполнения);
			КонецЕсли;
			ПоляИсключенияЗаполнения.Добавить("Стоимость");
			ПоляИсключенияЗаполнения.Добавить("ОбщСтоимость");
			ПоляИсключенияЗаполнения.Добавить("ВнешняяСтоимость");
			ПоляИсключенияЗаполнения.Добавить("ОбщВнешняяСтоимость");
			ПараметрыПодбораСтруктура.Вставить("ПоляИсключенияЗаполнения", СтрСоединить(ПоляИсключенияЗаполнения, ", ")); 
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормыСервер(ПервыйЗапуск = Истина)
	
	ДополнительныеСвойства = Новый Структура;
	СсылкаКопирования = Неопределено;
	
	Если ПервыйЗапуск Тогда
		
		мКэшПараметров = Новый Структура;
		
		СсылкаКопирования = Параметры.ЗначениеКопирования;	
		
		Если ЗначениеЗаполнено(СсылкаКопирования) 
			И ТипЗнч(СсылкаКопирования) = Тип("ДокументСсылка.упоПроектнаяЗадача") 
			Или ТипЗнч(СсылкаКопирования) = Тип("СправочникСсылка.Проекты") Тогда
			
			ДополнительныеСвойства.Вставить("СсылкаКопирования", СсылкаКопирования);
			
		КонецЕсли;
		
		Параметры.Свойство("РежимВыбораЗеркала", РежимВыбораЗеркала);
		
		// Надпись Трансляция трудозатрат в БДР.
		ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат = 
			упоРаботаСОчередямиВызовСервера.ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат();
		ЗаголовокТрудозатратыДляБДР = упоРаботаСФормамиКлиентСервер.СообщениеДляБДРТрудозатратыИзменены(
			ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
			"НадписьТрудозатратыДляБДР", 
			"Заголовок", 
			ЗаголовокТрудозатратыДляБДР); 
		
	КонецЕсли;
	
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриСозданииНаСервере: Перед получением данных версии");
	
	Если ЗначениеЗаполнено(Объект.Проект) Тогда
		ЭтотОбъект.ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	КонецЕсли;	
	
	Документы.упоПроектнаяЗадача.ПолучитьДанныеВерсии(ЭтаФорма, Объект, ДополнительныеСвойства);
		
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриСозданииНаСервере: После получения данных версии");
	
	ЭтоНовый = НЕ ЗначениеЗаполнено(Объект.Ссылка);
	мВалютаУправленческогоУчета = упоПроектноеБюджетированиеПовтИсп.ВалютаУправленческогоУчета();
		
	ФункцииОтображения_Инициализация();
	
	Если ПервыйЗапуск Тогда      
		
		мФлагМодификации = Ложь;
		
		Если ЭтоНовый И НЕ ЗначениеЗаполнено(СсылкаКопирования) Тогда	
			
			Объект.ОбновлятьДатуДокумента = Истина;     
			
			Если НЕ ЗначениеЗаполнено(Объект.ТипПроектнойЗадачи) Тогда
				Объект.ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Этап;
			КонецЕсли;
			Объект.ЕдиницаНормированияДлительности = упоПроектыИЗадачиОбщие.ЕдИзмеренияПоУмолчанию(ЭтаФорма);
			
			упоПроектыИЗадачиОбщие.ЗаписатьТипЗадачи(Объект);
			
			Объект.СпособПривязкиДопЗатрат = упоПользователиВызовСервера.обПолучитьНастройкуПользователя("СпособПривязкиДопЗатратКПериоду");
			Если НЕ ЗначениеЗаполнено(Объект.СпособПривязкиДопЗатрат) Тогда      
				Объект.СпособПривязкиДопЗатрат = Перечисления.упоСпособПривязкиДопЗатрат.КЗавершениюЗадачи;	
			КонецЕсли; 
			
		Иначе
			// В документах, которые были введены в редакции 1, не было нужного реквизита
			// его нужно установить.
			
			Если НЕ ЗначениеЗаполнено(Объект.ТипПроектнойЗадачи) И НЕ ЭтаФорма.ТолькоПросмотр Тогда		
				упоПроектыИЗадачиОбщие.УстановитьТипЗадачи(Объект);
				мФлагМодификации = Истина;
			КонецЕсли;
			
		КонецЕсли; 
		
		// Выставим настройки подбора ДДС по умолчанию
		
		Элементы.ДДС_ПараметрыПодбора_ПривязкаКНачалу.Пометка = Ложь; 
		Элементы.ДДС_ПараметрыПодбора_ПривязкаКЗавершению.Пометка = Истина;
		Элементы.ДДС_ПараметрыПодбора_НаправлениеВыплата.Пометка = Истина;
		Элементы.ДДС_ПараметрыПодбора_НаправлениеПоступление.Пометка = Ложь;
		
		упоРаботаСФормамиСервер.ДобавитьПараметрыИсключитьПроект(Элементы.ПодчиненныйПроект, Объект.Проект);
		упоРаботаСФормамиСервер.ДобавитьПараметрыИсключитьПроект(Элементы.ПодчиненнаяПроектнаяЗадача, Объект.Проект);
		
		// Проектная продукция
		УстановитьОграниченияИспользованияФункционала();
		
	КонецЕсли; 
		
	УстановитьОтборИсполнителей();
	
	// Если документ введен не на основании,
	// то интерфейс должен отработать эту ситуацию.
	упоУправлениеФормамиСервер.ЗаполнитьГиперссылку(Объект, ЭтаФорма, "Проект");
	
	Если ЭтоНовый Тогда
		ЗаполнитьГиперссылкуСервер("ЗадачаРодитель", НСтр("ru = 'задача-родитель'"), НСтр("ru = 'выбрана'"));
	Иначе
		ЗаполнитьГиперссылкуСервер("ЗадачаРодитель", , , Ложь);
	КонецЕсли;
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_ДобавитьФункцииСобытияВПулНаВыполнение("ОбновитьВсе", ЭтаФорма);
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
	// Покажем на форме код СДР.
	УстановитьКодСДР();
	
	// Получим и закешируем проектные опции.
	ЗаполнитьПроектныеОпцииЗадачи();
	
	// Установим доступность редактирования сроков.
	УстановитьДоступностьРедактированияСроков();
	
	// Определяем видимость элементов управления.
	упоПроектыИЗадачиОбщие.УстановитьВидимостьЭлементовФормыПроектнойЗадачи(Объект, ЭтаФорма, ЭтаФорма.ПроектныеОпции);
	
	// Определяем возможность изменения типа задачи.
	УстановитьДоступностьТипаЗадачи();
	
	// Отмечаем выбранный тип задачи на форме.
	УстановитьАктивныйТипЗадачи();
	
	// Выведем итоговые финансовые показатели.
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	// Удалим на всякий случай ссылку копирования, она больше не требуется.
	СсылкаКопирования = Документы.упоПроектнаяЗадача.ПустаяСсылка();
	
	// Установка параметров дин. списка "ВыполненныеОбъемы".
	ВыполненныеОбъемы.Параметры.УстановитьЗначениеПараметра("ПроектнаяЗадача", Объект.Ссылка);
	
	// Ограничение типа для ТЧ "МатериальныеРесурсы". Почему-то у реквизита "ресурс" два типа,
	// а по факту используется один. Уберем лишний.
	МассивТиповМ = Новый Массив;
	МассивТиповМ.Добавить(Тип("СправочникСсылка.Номенклатура"));
	ОписаниеТиповМ = Новый ОписаниеТипов(МассивТиповМ);
	Элементы.МатериальныеРесурсыРесурс.ОграничениеТипа = ОписаниеТиповМ;
	
	ИмяКонфигурации = Метаданные.Имя;
	
	Если ПервыйЗапуск Тогда
		
		ОбработатьКопированиеВСводныйПроект();
		
		ИнициализацияФормыСерверEPM();
		
	КонецЕсли;	
	
	ЗагрузитьФорматированныйДокумент();
	
	Элементы.ЕдиницаНормированияДлительности.СписокВыбора.ЗагрузитьЗначения(
		упоРаботаСФормамиСервер.ПолучитьМассивЕдиницНормированияДлительности());

	ДоступКФинИнформации = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	Если ДоступКФинИнформации = "РедактированиеТолько_ДР_ДДС" Тогда
		ТолькоФинансоваяИнформация();
	Иначе
		СкрытьФинансовуюИнформацию();
	КонецЕсли;
	
	УстановитьТекущуюСтраницу();
	
	// Признак необходимости отображения информационных строк в ТЧ "План доходов" и "План расходов".
	ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС =
		Константы.упоПоказыватьНаЗакладкахПланДоходовПланРасходовДДСДанныеОтраженияСДругихЗакладок.Получить();
	ОбновитьНаименованиеКолонокТРСтоимости();
		
	Элементы.ТаблицаИсполнителиИсполнители_КнопкаИзменить.Доступность = Не ЭтаФорма.ТолькоПросмотр;
	
	ЗаполнитьПараметрыДинамическихСписков();
	
	ЗаполнитьЗеркало();
	
	// Проектная продукция.
	
	ДоступенФункционалПроектнаяПродукция = упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция();
	
	упоРаботаСФормамиСервер.ЗаполнитьРеквизитыТипПродукта(Объект.ТипСубпродукта, ЭтотОбъект.ТипПродуктаЧисло);
	упоРаботаСФормамиКлиентСервер.НастроитьСубпродуктыНаФормеПоТипуСубпродукта(Элементы, 
		Объект.ТипСубпродукта);
						
	// Причины отклонений
	ИспользуетсяФункционалПричинОтклонения = упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПричиныОтклонений();
	Элементы.СтраницаПричиныОтклонений.Доступность 	= ИспользуетсяФункционалПричинОтклонения;
	Элементы.СтраницаПричиныОтклонений.Видимость 	= ИспользуетсяФункционалПричинОтклонения;
	
	// Опция Задача отменена
	УстановитьВидимостьГруппыЗадачаОтменена(Элементы.ГруппаЗадачаОтменена, Объект.ЗадачаОтменена);
	
	УстановитьЗаголовокФормы(ЭтаФорма, Объект.НазваниеПроектнойЗадачи, Объект.ЗадачаОтменена);
	
	ОбновитьДопДанныеЗадачи();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыЗадачаОтменена(ЭлементГруппаЗадачаОтменена, ЗадачаОтменена)
	
	ЭлементГруппаЗадачаОтменена.Видимость = ЗадачаОтменена;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекущуюСтраницу()
	
	Если Параметры.Свойство("ОткрытьРолиПредвУровень") Тогда
		
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаРесурсы;
		мКэшПараметров.Вставить("УровеньПланированияОкончательный", Ложь);
		
	ИначеЕсли Параметры.Свойство("ОткрытьРолиОкончУровень") Тогда
		
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаРесурсы;
		мКэшПараметров.Вставить("УровеньПланированияОкончательный", Истина);
		
	ИначеЕсли Параметры.Свойство("ОткрытьИсполнители") Тогда
		
		Элементы.СтраницыОсновное.ТекущаяСтраница = Элементы.СтраницаРесурсы;
		Элементы.СтраницыРесурсы.ТекущаяСтраница = Элементы.СтраницаИсполнители;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграниченияИспользованияФункционала()
	
	ДанныеОбъекта = Новый Структура("ТипСубпродукта");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Объект);
	
	упоРаботаСФормамиСервер.УстановитьОграниченияИспользованияФункционала(Элементы, ДанныеОбъекта);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьКопированиеВСводныйПроект()
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;
	КонецЕсли;			
	
	Если Не ЗначениеЗаполнено(Объект.СкопированаВСводныйИзЗадачи) Тогда
		Возврат;
	КонецЕсли;	
	
	Группа = Элементы.Добавить("ГруппаКопированияВСводный", Тип("ГруппаФормы"), Элементы.СтраницаПараметры); 
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Заголовок = НСтр("ru = 'Информация о копировании'");
	Группа.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	Группа.РастягиватьПоГоризонтали = Истина; 	
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ГруппаЗадачи = Элементы.Добавить("ГруппаКопированияВСводныйГруппаЗадачи", Тип("ГруппаФормы"), Группа); 
	ГруппаЗадачи.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаЗадачи.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаЗадачи.ОтображатьЗаголовок = Ложь;
	ГруппаЗадачи.РастягиватьПоГоризонтали = Истина; 	
	ГруппаЗадачи.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Элемент = Элементы.Добавить("СкопированаВСводныйИзЗадачи", Тип("ПолеФормы"), ГруппаЗадачи);			
	Элемент.Вид = ВидПоляФормы.ПолеНадписи;
	Элемент.ПутьКДанным = "ОткудаСкопирована";
	Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Элемент.РастягиватьПоГоризонтали = Истина;
	Элемент.АвтоМаксимальнаяШирина = Ложь;
	
	ЗаполнитьОткудаСкопирована();
	
	Если ПравоДоступа("Чтение", Метаданные.Документы.упоКопированиеЗадачВСводныйПроект) Тогда
		
		Элемент = Элементы.Добавить("ДокументОснование", Тип("ПолеФормы"), Группа);
		Элемент.Вид = ВидПоляФормы.ПолеНадписи;
		Элемент.ПутьКДанным = "Объект.ДокументОснование";	
		Элемент.Заголовок = НСтр("ru = 'Документ копирования'");
		Элемент.Гиперссылка = Истина;
		Элемент.РастягиватьПоГоризонтали = Истина; 	
		Элемент.АвтоМаксимальнаяШирина = Ложь;
		
	КонецЕсли;					
	
КонецПроцедуры	

&НаСервере
Функция СкрытьФинансовуюИнформацию()
	
	Если ДоступКФинИнформации = "Отсутствует" Тогда
		СкрытьФинИнформацию_ДоступОтсутствует();
	ИначеЕсли ДоступКФинИнформации = "Просмотр" Тогда
		СкрытьФинИнформацию_ДоступНаПросмотр();
	КонецЕсли;
	
КонецФункции

