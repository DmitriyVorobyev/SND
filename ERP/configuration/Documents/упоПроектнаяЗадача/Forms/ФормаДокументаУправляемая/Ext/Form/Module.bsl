&НаСервереБезКонтекста
Функция ПолучитьЕдиницуНормПоНорме(Роль, НормаСтоимости)

	Ставка = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоНормыСтоимостиРесурсовСрезПоследних.ЕдиницаНормирования
	               |ИЗ
	               |	РегистрСведений.упоНормыСтоимостиРесурсов.СрезПоследних(
	               |			,
	               |			Норма = &НормаСтоимости
	               |				И Ресурс = &Роль) КАК упоНормыСтоимостиРесурсовСрезПоследних";
				   
	Запрос.УстановитьПараметр("НормаСтоимости", НормаСтоимости);
	Запрос.УстановитьПараметр("Роль", Роль);
	
	Рез = Запрос.Выполнить();
	
	Если Рез.Пустой() Тогда
		Возврат Справочники.упоНормыСтоимости.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = Рез.Выбрать();	
	Выборка.Следующий();
	
	Возврат Выборка.ЕдиницаНормирования;  	

КонецФункции

&НаСервереБезКонтекста
Функция РассчитатьВнешСтоимостьПосле(ТрудовойРесурс, НормаСтоимости, ЕдиницаНормирования, ВнешСтоимостьДо)
	
	Результат = Новый Структура("ИзменитьВнешСтоимость, ЗначениеВнешСтоимости, Сообщение");
	
	ЕдНормВнешнейСтоимости = ПолучитьЕдиницуНормПоНорме(ТрудовойРесурс, НормаСтоимости);
	
	Если Не ЗначениеЗаполнено(ЕдНормВнешнейСтоимости) Тогда
		Результат.ИзменитьВнешСтоимость = Ложь;
		Возврат Результат;
	КонецЕсли;
		
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(ЕдНормВнешнейСтоимости);
	МассивСсылок.Добавить(ЕдиницаНормирования);
	
	Коэффициенты = ЗначениеРеквизитаОбъектов(МассивСсылок, "Коэффициент");
	КоэффЕдНормВнешСт 	= Коэффициенты[ЕдНормВнешнейСтоимости];
	КоэффЕдНорм 		= Коэффициенты[ЕдиницаНормирования];
	
	Если КоэффЕдНормВнешСт = 0 Тогда
		Результат.ИзменитьВнешСтоимость = Ложь;
		Результат.Сообщение = СтрШаблон(НСтр("ru = 'Не задан коэффициент для единицы измерения ""%1""'"), ЕдНормВнешнейСтоимости);	
	Иначе
		Результат.ИзменитьВнешСтоимость = Истина;
		Результат.ЗначениеВнешСтоимости = ВнешСтоимостьДо * (КоэффЕдНорм/КоэффЕдНормВнешСт);
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ФункцииПоСтраницамИСобытиямИсполняемые

&НаСервере
Процедура ОбновитьСвязанныеДанные()
	
	// Обновляем актуальные данные проектной задачи
	
	Если Объект.Проведен И НЕ Объект.ЭтоПакетРабот Тогда      
		ЗначениеВРеквизитФормы(упоПредставлениеПроектаВызовСервера.обПолучитьСписокПрямыхПотомковЗадачи(Объект.Ссылка), "мСписокПотомков");
	Иначе
		мСписокПотомков.Очистить();
	КонецЕсли;                         
	
	Если НЕ Объект.ЭтоПакетРабот Тогда      
		ПостроитьСоставЗадачи();
	КонецЕсли; 
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ОбновитьСвязанныеДанные", ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьСоставЗадачи()
	
	ТаблицаСоставЗадач.Очистить();
	
	Если мСписокПотомков.Количество() = 0 Тогда      
		ГантПотомкиЗадачи.Очистить();
		Возврат;
	КонецЕсли; 	
	
	// первым делом заполняем связанную таблицу данными
	
	Для каждого СтрокаЗадача Из мСписокПотомков Цикл
		НоваяЗадача = ТаблицаСоставЗадач.Добавить();
		НоваяЗадача.ПроектнаяЗадача = СтрокаЗадача.ПроектнаяЗадача;
		НоваяЗадача.ДатаНачала = СтрокаЗадача.ДатаНачалаПлан;
		НоваяЗадача.ДатаЗавершения = СтрокаЗадача.ДатаЗавершенияПлан;
		
		ТипПроектнойЗадачи = упоПроектыИЗадачиОбщие.ПолучитьТипЗадачи(СтрокаЗадача);
		
		Если ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Этап") Тогда
			НоваяЗадача.Иконка = БиблиотекаКартинок.упоЗадачаЭтапЗаписанная;
		ИначеЕсли ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.ПакетРабот") Тогда
			НоваяЗадача.Иконка = БиблиотекаКартинок.упоЗадачаПакетРабот;
		ИначеЕсли ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.МодельПакетаРабот") Тогда
			НоваяЗадача.Иконка = БиблиотекаКартинок.упоЗадачаМодельПакетаРаботЗаписанная;
		ИначеЕсли ТипПроектнойЗадачи = ПредопределенноеЗначение("Перечисление.упоТипПроектнойЗадачи.Веха") Тогда	
			НоваяЗадача.Иконка = БиблиотекаКартинок.упоЗадачаВехаЗаписанная;
		КонецЕсли; 
		
	КонецЦикла; 
	
	// На самом деле список задач-потомков уже построен, осталось вывести их в диаграмму Ганта.
	
	ДеревоЗадач = упоПредставлениеПроектаВызовСервера.обПолучитьПустоеДеревоДанныхГанта();
	Для каждого СтрокаЗадача Из мСписокПотомков Цикл
		
		СтрокаДерева = ДеревоЗадач.Строки.Добавить();
		СтрокаДерева.Объект = СтрокаЗадача.ПроектнаяЗадача;
		СтрокаДерева.Имя = СтрокаЗадача.НазваниеЗадачи;
		
		Если НЕ ЗначениеЗаполнено(СтрокаЗадача.ДатаНачалаПлан) Тогда      
			СтрокаДерева.Начало = '00010101';
		Иначе
			СтрокаДерева.Начало = НачалоДня(СтрокаЗадача.ДатаНачалаПлан);	
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(СтрокаЗадача.ДатаЗавершенияПлан) Тогда      
			СтрокаДерева.Конец = '00010101';
		Иначе
			СтрокаДерева.Конец = КонецДня(СтрокаЗадача.ДатаЗавершенияПлан);	
		КонецЕсли; 
		
		СтрокаДерева.Подпись = Строка(СтрокаЗадача.ПроцентГотовности) + "%";
		
		Если СтрокаЗадача.ПроцентГотовности = 0 Тогда      
			СтрокаДерева.Цвет = WebЦвета.СветлоНебесноГолубой;
		ИначеЕсли СтрокаЗадача.ПроцентГотовности < 100 Тогда
			СтрокаДерева.Цвет =  WebЦвета.НейтральноГрифельноСиний;
		ИначеЕсли СтрокаЗадача.ПроцентГотовности >= 100 Тогда
			СтрокаДерева.Цвет =  WebЦвета.НейтральноСиний;
		Иначе
			СтрокаДерева.Цвет = WebЦвета.Фуксин;
		КонецЕсли; 
		
	КонецЦикла; 
	
	упоПредставлениеПроектаВызовСервера.обПостроитьПростуюДиаграммуГанта(ГантПотомкиЗадачи, ДеревоЗадач, , , , Истина);
	
	мТекКомандаСоставЗадачи = "ГантПотомки_ДействиеВесьПериод";
	Элементы[мТекКомандаСоставЗадачи].Пометка = Истина;
	РегуляторГантаСоставаЗадачи = 10;
	
	// фикс для тонкого
	ГантПотомкиЗадачи.ОтображатьЛегенду = Ложь;
	ГантПотомкиЗадачи.ОтображатьЗаголовок = Ложь;
	ГантПотомкиЗадачи.ОбластьПостроения.ШкалаВремени.ЦветФона = WebЦвета.СветлоЖелтыйЗолотистый;
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ПостроитьСоставЗадачи", ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьМДанные()
	
	ЗаполнитьРеквизитыФормы_мДанные_Сроки();
	
	ЗаполнитьРеквизитыФормы_СрокиПроекта();
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ПолучитьМДанные", ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатуВыпуска(текСтрока = Неопределено)
	
	Сроки = Новый Структура("НачалоПлан, ЗавершениеПлан",
			мДанные_Сроки_НачалоПлан, мДанные_Сроки_ЗавершениеПлан);
	
	Если текСтрока = Неопределено Тогда
		Для каждого лСтрока Из Объект.Субпродукты Цикл
			упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаВСтроке(Сроки, Объект.Проект, лСтрока);
		КонецЦикла;
		упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ОбновитьДатуВыпуска", ЭтаФорма);
	Иначе
		упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаВСтроке(Сроки, Объект.Проект, лСтрока);
	КонецЕсли;
	
КонецПроцедуры

//

&НаКлиенте
Функция Новый_ПриИзмененииДаты_Клиент(ИзмениласьДата) 
	
	Если Не Объект.РучнойВводСроков Тогда
		ВызватьИсключение НСтр("ru = 'Изменение сроков вручную возможно только в режиме ручного ввода сроков.'");
	КонецЕсли;
	
	Новый_ПриИзмененииДаты(ЭтаФорма, ИзмениласьДата);
	
	Новый_ОбновитьРасчетнуюДатуЗавершения(ЭтаФорма);
	
	Если ИзмениласьДата = "ДатаНачалаПлан" Тогда
		
		Новый_ОбновитьДатуЗавершенияПоРасчетнойДате(ЭтаФорма);
		
	КонецЕсли;
	
	Новый_СтандартныеДействияПослеИзмененияСроков();
	
КонецФункции

&НаКлиенте
Функция Новый_СтандартныеДействияПослеИзмененияСроков() 
	
	Новый_ПроверитьСроки(ЭтаФорма);

	упоУправлениеФормамиКлиент.ОбновитьДатуЗаказаПотребности(Объект);
	упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаПланВыпуска(Объект);
	ОбновитьДатуПривязкиДДС(Объект, ЭтаФорма);	
	СоздатьДопЭлементыРаспределенияДоходов(Истина, Истина, Истина, Истина, Истина, Истина);

КонецФункции

&НаКлиенте
Функция Новый_ПриИзмененииДлительности_Клиент() 
	
	Новый_ПриИзмененииДлительности(ЭтаФорма);
	
	Новый_ОбновитьРасчетнуюДатуЗавершения(ЭтаФорма);
	
	Новый_СтандартныеДействияПослеИзмененияСроков();

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ОбновитьРасчетнуюДатуЗавершения(ЭтаФорма)
	
	ДлительностьДляПересчета = ПолучитьДлительностьВЧасах(ЭтаФорма);	
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи(ЭтаФорма);
			
	Если ЭтаФорма.Объект.ДлительностьБезУчетаКалендаряПроекта Тогда
		ЭтаФорма.РасчетнаяДатаЗавершения = ЭтаФорма.Объект.ДатаНачалаПлан + ДлительностьДляПересчета * 3600 - 1;
	Иначе
		ЭтаФорма.РасчетнаяДатаЗавершения = ДобавитьЧасыКДате(ЭтаФорма.Объект.ДатаНачалаПлан, ДлительностьДляПересчета, 
														КалендарьДляПересчета, ЭтаФорма.Объект.ДлительностьБезУчетаКалендаряПроекта); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста 
Процедура Новый_ПроверитьКонфликтПоДлительности(ЭтаФорма)
				
	ЭтаФорма.НадписьКонфликтДлительности = "";
	
	ЭтаФорма.Элементы.РасчетнаяДатаЗавершения.ЦветТекста = ПолучитьЦветСтиля("ТекстИнформационнойНадписи");
	 
	Если Не ЗначениеЗаполнено(ЭтаФорма.РасчетнаяДатаЗавершения) Тогда
		Возврат;
	КонецЕсли; 
	
	ОбнаруженКонфликт = Ложь;
	
	Если НачалоДня(ЭтаФорма.РасчетнаяДатаЗавершения) > НачалоДня(ЭтаФорма.Объект.ДатаЗавершенияПлан) Тогда
		ОбнаруженКонфликт = Истина;
		ОписаниеКонфликта = НСтр("ru = 'Дата завершения проектной задачи, рассчитанная по общей длительности и рабочему
			|календарю проекта, противоречит дате завершения по текущему плану.'");
	ИначеЕсли НачалоДня(ЭтаФорма.РасчетнаяДатаЗавершения) < НачалоДня(ЭтаФорма.Объект.ДатаЗавершенияПлан) Тогда
		ОбнаруженКонфликт = Истина;
		ОписаниеКонфликта = НСтр("ru = 'Дата завершения проектной задачи, рассчитанная по общей длительности и рабочему
			|календарю проекта, противоречит дате начала по текущему плану.'");
	КонецЕсли; 
	
	Если ОбнаруженКонфликт Тогда
		ЭтаФорма.НадписьКонфликтДлительности = ОписаниеКонфликта;
		ЭтаФорма.Элементы.РасчетнаяДатаЗавершения.ЦветТекста = ПолучитьЦветСтиля("упоТекстПредупреждающейНадписи");
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ОбновитьДатуЗавершенияПоРасчетнойДате(ЭтаФорма)
	
	ЭтаФорма.Объект.ДатаЗавершенияПлан = ЭтаФорма.РасчетнаяДатаЗавершения;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ПодсчитатьДлительность(ЭтаФорма)
	
	Объект = ЭтаФорма.Объект;

	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаПлан) И НЕ ЗначениеЗаполнено(Объект.ДатаЗавершенияПлан) Тогда
		Объект.ДлительностьМоделиПакетаРабот = 0;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаПлан) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДатаЗавершенияПлан) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Ошибка расчета длительности задачи.'"));
		Возврат;
	КонецЕсли;
	
	ЕдиницаНормированияДлительности = Объект.ЕдиницаНормированияДлительности;
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи(ЭтаФорма);
	КалендарьПроекта = ПолучитьРабочийКалендарьПроекта(Объект.Проект); 
	
	Объект.ДлительностьМоделиПакетаРабот = РассчитатьДлительностьСервер(
		Объект.ДатаНачалаПлан,	Объект.ДатаЗавершенияПлан, ЕдиницаНормированияДлительности,
		КалендарьДляПересчета, КалендарьПроекта, Объект.ДлительностьБезУчетаКалендаряПроекта);
 	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ПриИзмененииДаты(ЭтаФорма, ИзмениласьДата)
	
	Если ИзмениласьДата <> "ДатаЗавершенияПлан" И ИзмениласьДата <> "ДатаНачалаПлан" Тогда
		Возврат;
	КонецЕсли;	
	
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи(ЭтаФорма);
	
	Если ИзмениласьДата = "ДатаНачалаПлан" Тогда
		
		Если ЗначениеЗаполнено(ЭтаФорма.Объект.ДатаНачалаПлан) Тогда
			ДатаСтартаПроекта = упоПроектыИЗадачиВызовСервера.ДатаСтартаПроекта(ЭтаФорма.Объект.Проект, Ложь);
			Если ДатаСтартаПроекта > ЭтаФорма.Объект.ДатаНачалаПлан Тогда
				ЭтаФорма.Объект.ДатаНачалаПлан = ДатаСтартаПроекта;
				
				ТекстСообщенияШаблон = НСтр("ru = 'Дата начала работ не может быть меньше даты начала проекта - %1.
					|Дата начала работ скорректирована.'");
				ТекстСообщения = СтрШаблон(ТекстСообщенияШаблон, Формат(ДатаСтартаПроекта, "ДФ=dd.MM.yyyy"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;	
		Иначе
			ЭтаФорма.Объект.ДатаНачалаПлан = ПолучитьТекущуюДатуСеанса();
		КонецЕсли;
		ЭтаФорма.Объект.ДатаНачалаПлан = НачалоДня(ЭтаФорма.Объект.ДатаНачалаПлан);	
		
		Если ЭтаФорма.Объект.ЭтоВеха Тогда
			ЭтаФорма.Объект.ДатаЗавершенияПлан = ЭтаФорма.Объект.ДатаНачалаПлан;	
			Возврат;
		КонецЕсли;	
		
		ДлительностьДляПересчета = ПолучитьДлительностьВЧасах(ЭтаФорма);
		
		ЭтаФорма.Объект.ДатаЗавершенияПлан = ДобавитьЧасыКДате(ЭтаФорма.Объект.ДатаНачалаПлан, ДлительностьДляПересчета, 
												КалендарьДляПересчета, ЭтаФорма.Объект.ДлительностьБезУчетаКалендаряПроекта); 
					
	Иначе
			
		Если Не ЗначениеЗаполнено(ЭтаФорма.Объект.ДатаЗавершенияПлан) Тогда
			ЭтаФорма.Объект.ДатаЗавершенияПлан = ЭтаФорма.Объект.ДатаНачалаПлан;
		КонецЕсли;	
		
		Если ЭтаФорма.Объект.ДатаНачалаПлан > ЭтаФорма.Объект.ДатаЗавершенияПлан Тогда
			ЭтаФорма.Объект.ДатаНачалаПлан = ЭтаФорма.Объект.ДатаЗавершенияПлан;	
		КонецЕсли;
		
		Если ЭтаФорма.Объект.ЭтоВеха Тогда
			ЭтаФорма.Объект.ДатаНачалаПлан = ЭтаФорма.Объект.ДатаЗавершенияПлан;	
			Возврат;
		КонецЕсли;
			
		ЭтаФорма.Объект.ДатаНачалаПлан = НачалоДня(ЭтаФорма.Объект.ДатаНачалаПлан);
		
		ЭтаФорма.Объект.ДатаЗавершенияПлан = КалендарныйКонецДня(НачалоДня(ЭтаФорма.Объект.ДатаЗавершенияПлан), 
												КалендарьДляПересчета, ЭтаФорма.Объект.ДлительностьБезУчетаКалендаряПроекта);
										
		Новый_ПодсчитатьДлительность(ЭтаФорма);								
			
	КонецЕсли;
					
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ПриИзмененииДлительности(ЭтаФорма)
	
	Если ЭтаФорма.Объект.ЭтоВеха Тогда
		ЭтаФорма.Объект.ДлительностьМоделиПакетаРабот = 0;
		ЭтаФорма.Объект.ДатаЗавершенияПлан = ЭтаФорма.Объект.ДатаНачалаПлан;
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.Объект.ДлительностьМоделиПакетаРабот <= 0 Тогда
		ЭтаФорма.Объект.ДлительностьМоделиПакетаРабот = 1;
	КонецЕсли;
		
	ДлительностьВЧасах = ПолучитьДлительностьВЧасах(ЭтаФорма);
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи(ЭтаФорма);
							
	ДатаОшибки = Неопределено;
	ОшибкиИПредупреждения = Неопределено;
	
	ЭтаФорма.Объект.ДатаЗавершенияПлан = ДобавитьЧасыКДате(ЭтаФорма.Объект.ДатаНачалаПлан, 
						ДлительностьВЧасах, КалендарьДляПересчета, ЭтаФорма.Объект.ДлительностьБезУчетаКалендаряПроекта);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ПриИзмененииЕдиницаНормированияДлительности(ЭтаФорма)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Объект.ЕдиницаНормированияДлительности) Тогда
		Возврат;
	КонецЕсли;
	
	Новый_ПодсчитатьДлительность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ПроверитьСроки(ЭтаФорма)
	
	Новый_ПроверитьКонфликтПоДлительности(ЭтаФорма);
	ПроверитьСрокиПроектаКлиентСервер(ЭтаФорма);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура Новый_ЗаполнитьДлительностьПоПлануРолей(ЭтаФорма)
	
	Если ЭтаФорма.Объект.ЭтоВеха Тогда
		Возврат;
	КонецЕсли;
	
	КоэффициентыЕдИзмеренияВремени = ПолучитьКоэффициентыЕдИзмеренияВремени();
	
	МаксимальнаяДлительность = 0;
	
	Для Каждого СтрокаТЧ Из ЭтаФорма.Объект.ТрудовыеРесурсы Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаНормирования) Тогда
			Продолжить;
		КонецЕсли;
		
		Коэффициент = КоэффициентыЕдИзмеренияВремени.Получить(СтрокаТЧ.ЕдиницаНормирования);
		
		ДлительностьСтроки = СтрокаТЧ.Количество * Коэффициент;
		
		Если ДлительностьСтроки > МаксимальнаяДлительность Тогда
			МаксимальнаяДлительность = ДлительностьСтроки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МаксимальнаяДлительность) Тогда
		
		Если Не ЗначениеЗаполнено(ЭтаФорма.Объект.ЕдиницаНормированияДлительности) Тогда
			ЭтаФорма.Объект.ЕдиницаНормированияДлительности = упоПроектыИЗадачиОбщие.ЕдИзмеренияПоУмолчанию(ЭтаФорма);		
		КонецЕсли;
		
		ЭтаФорма.Объект.ДлительностьМоделиПакетаРабот = ПересчитатьЕдВремениИзЧасов(МаксимальнаяДлительность, ЭтаФорма.Объект.ЕдиницаНормированияДлительности); 
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Ошибка расчета длительности по плану трудозатрат.'");
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоэффициентыЕдИзмеренияВремени() 
	Результат = Новый Соответствие;
	Выборка = Справочники.упоЕдиницыВремени.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.Коэффициент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦветСтиля(ИмяЦвета) 
	Возврат ЦветаСтиля[ИмяЦвета];
КонецФункции

&НаСервереБезКонтекста
Функция ПересчитатьЕдВремениИзЧасов(Знач Часы, Знач ЕдиницаНормированияДлительности) 
	
	Возврат упоРабочиеКалендариВызовСервера.обПересчитатьЕдВремениИзЧасов(
			Часы, 
			ЕдиницаНормированияДлительности); 
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьДлительностьВЧасах(ЭтаФорма) 

	Возврат ПересчитьЕдВремениВЧасы(ЭтаФорма.Объект.ДлительностьМоделиПакетаРабот,
						?(Не ЗначениеЗаполнено(ЭтаФорма.Объект.ЕдиницаНормированияДлительности),
						упоПроектыИЗадачиОбщие.ЕдИзмеренияПоУмолчанию(ЭтаФорма),
						ЭтаФорма.Объект.ЕдиницаНормированияДлительности));	
	
КонецФункции
					
&НаСервереБезКонтекста
Функция ПересчитьЕдВремениВЧасы(Знач Значение, Знач ЕдВремени) 
	Возврат упоРабочиеКалендариВызовСервера.обПересчитатьЕдВремениВЧасы(Значение, ЕдВремени);	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьЧасыКДате(Знач Дата, Знач Длительность, Знач КалендарьДляПересчета, Знач ДлительностьБезУчетаКалендаряПроекта) 
	
	ДатаОшибки = Неопределено;
	ОшибкиИПредупреждения = Неопределено;
	
	НоваяДата = упоРасчетКалендарныхСроковРедакция3Сервер.ДобавитьЧасыКДате(Дата, Длительность,
			, КалендарьДляПересчета, ДатаОшибки, Истина, ДлительностьБезУчетаКалендаряПроекта, , ОшибкиИПредупреждения);

	 Если ОшибкиИПредупреждения <> Неопределено Тогда
		Для Каждого СтрокаОшибки Из ОшибкиИПредупреждения Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки.ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НоваяДата;
	
КонецФункции

&НаСервереБезКонтекста
Функция КалендарныйКонецДня(Знач Дата, Знач КалендарьДляПересчета, Знач ДлительностьБезУчетаКалендаряПроекта) 
	
	ДатаОшибки = Неопределено;
	ОшибкиИПредупреждения = Неопределено;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		
		НоваяДата = Дата;
		
	ИначеЕсли ДлительностьБезУчетаКалендаряПроекта Тогда
		
		НоваяДата = КонецДня(Дата);
		
	Иначе
	
	 	НоваяДата = упоРасчетКалендарныхСроковРедакция3Сервер.КалендарныйКонецДня(
								НачалоДня(Дата), , КалендарьДляПересчета, ДатаОшибки, ОшибкиИПредупреждения);
								
	КонецЕсли;

	 Если ОшибкиИПредупреждения <> Неопределено Тогда
		Для Каждого СтрокаОшибки Из ОшибкиИПредупреждения Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки.ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НоваяДата;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКалендарьЗадачи(ЭтаФорма) 
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.КалендарьЗадачи) Тогда
		КалендарьЗадачи = ЭтаФорма.Объект.КалендарьЗадачи;	
	Иначе		
		КалендарьЗадачи = ПолучитьРабочийКалендарьПроекта(ЭтаФорма.Объект.Проект);
	КонецЕсли;
	Возврат КалендарьЗадачи;
КонецФункции

