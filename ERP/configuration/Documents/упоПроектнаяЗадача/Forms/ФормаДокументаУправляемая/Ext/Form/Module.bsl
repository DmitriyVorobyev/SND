&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДатуПривязкиДДС(Объект, Форма, текСтрока = Неопределено, УдалитьФункциюИзПулаНаВыполнение = Ложь)
	
	Данные = Новый Структура;
	
	Сроки = упоПроектыИЗадачиОбщие.СтруктураСроки(Объект.ДатаНачалаПлан, Объект.ДатаЗавершенияПлан);
	Если ТипЗнч(Форма.СрокиПроекта) = Тип("Структура") И Форма.СрокиПроекта.Свойство("ДатаНачалаПлан") Тогда
		Сроки.Вставить("НачалоПланПроект", Форма.СрокиПроекта.ДатаНачалаПлан);
	КонецЕсли;
	Если ТипЗнч(Форма.СрокиПроекта) = Тип("Структура") И Форма.СрокиПроекта.Свойство("ДатаЗавершенияПлан") Тогда
		Сроки.Вставить("ЗавершениеПланПроект", Форма.СрокиПроекта.ДатаЗавершенияПлан);
	КонецЕсли;
	
	Данные.Вставить("Сроки", Сроки);
	
	Если текСтрока = Неопределено Тогда
		Для каждого лСтрока Из Объект.ДвиженияДенежныхСредств Цикл
			упоПроектыИЗадачиОбщие.ОбновитьДатуПривязкиВСтроке(Данные.Сроки, Объект.Проект, лСтрока);
		КонецЦикла;
	Иначе
		упоПроектыИЗадачиОбщие.ОбновитьДатуПривязкиВСтроке(Данные.Сроки, Объект.Проект, текСтрока);
	КонецЕсли;
	
	Если УдалитьФункциюИзПулаНаВыполнение Тогда
		упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ОбновитьДатуПривязкиДДС", Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИконкуНаправленияВТаблицеДДС()
		
	Для каждого СтрокаДДС Из Объект.ДвиженияДенежныхСредств Цикл
		СтрокаДДС.Иконка = ?(СтрокаДДС.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление,
			0, 1);
	КонецЦикла;
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение(
		"ОбновитьИконкуНаправленияВТаблицеДДС", ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСрокиЗадачиРодителя(Знач Проект, Знач ЗадачаРодитель, ТекущаяВерсия) 

	Результат = Новый Структура("КрайнийСрок, ДатаНачалаПлан, ДатаЗавершенияПлан");	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗадачаРодитель", ЗадачаРодитель);
	Запрос.УстановитьПараметр("текВерсия", ТекущаяВерсия);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегСвойства.ПроектнаяЗадача,
		|	РегСвойства.ЗадачаРодитель,
		|	РегСвойства.КрайнийСрок,
		|	РегСроки.ДатаНачалаПлан,
		|	РегСроки.ДатаЗавершенияПлан
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, 
		|		Версия = &текВерсия
		|   И ПроектнаяЗадача = &ЗадачаРодитель
		|	) КАК РегСвойства
		|ЛЕВОЕ СОЕДИНЕНИЕ 
		|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, 
		|		Версия = &текВерсия
		|	) КАК РегСроки
		|ПО 
		|	РегСвойства.ПроектнаяЗадача = РегСроки.ПроектнаяЗадача";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьСрокиПроектнойЗадачиПоРодительскойЗадаче(ЭтаФорма) 
			
	Результат = Новый Структура;
	Результат.Вставить("ВылезаетСрокНачала"    , "");
	Результат.Вставить("ВылезаетСрокЗавершения", "");
	Результат.Вставить("ВылезаетКрайнийСрок"   , "");
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Объект.ЗадачаРодитель) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СрокиРодителя = ПолучитьСрокиЗадачиРодителя(ЭтаФорма.Объект.Проект, 
												ЭтаФорма.Объект.ЗадачаРодитель, 
												ЭтаФорма.ТекущаяВерсия);        
	
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.ДатаНачалаПлан) Тогда		
		Если ЗначениеЗаполнено(СрокиРодителя.ДатаНачалаПлан) 
			И ЭтаФорма.Объект.ДатаНачалаПлан < СрокиРодителя.ДатаНачалаПлан Тогда			
			СообщениеДНП = "Эта задача по плану начинается раньше своего родителя ("
								+ Формат(СрокиРодителя.ДатаНачалаПлан, "ДФ=dd.MM.yy") + ")";								
		КонецЕсли;		
		Если ЗначениеЗаполнено(СрокиРодителя.ДатаЗавершенияПлан) 
			И ЭтаФорма.Объект.ДатаНачалаПлан > СрокиРодителя.ДатаЗавершенияПлан Тогда			
			СообщениеДНП = "Эта задача по плану начинается после того, как заканчивается "
								+ "задача-родитель (" + Формат(СрокиРодителя.ДатаЗавершенияПлан, "ДФ=dd.MM.yy") + ")";							
		КонецЕсли;																	
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.ДатаЗавершенияПлан) Тогда		
		Если ЗначениеЗаполнено(СрокиРодителя.ДатаНачалаПлан) 
			И ЭтаФорма.Объект.ДатаЗавершенияПлан < СрокиРодителя.ДатаНачалаПлан Тогда		
			СообщениеДЗП = "Эта задача по плану заканчивается раньше старта задачи-родителя ("
								+ Формат(СрокиРодителя.ДатаНачалаПлан, "ДФ=dd.MM.yy") + ")";							
		КонецЕсли;	
		Если ЗначениеЗаполнено(СрокиРодителя.ДатаНачалаПлан) 
			И ЭтаФорма.Объект.ДатаЗавершенияПлан > СрокиРодителя.ДатаЗавершенияПлан Тогда			
			СообщениеДЗП = "Эта задача завершается позже, чем завершается задача-родитель ("
								+ Формат(СрокиРодителя.ДатаЗавершенияПлан, "ДФ=dd.MM.yy") + ")";								
		КонецЕсли;																		
	КонецЕсли;

	Если ЗначениеЗаполнено(ЭтаФорма.Объект.КрайнийСрок) Тогда		
		Если ЗначениеЗаполнено(СрокиРодителя.КрайнийСрок)
			И ЭтаФорма.Объект.КрайнийСрок > СрокиРодителя.КрайнийСрок Тогда
			СообщениеКС = "Крайний срок этой задачи превышает крайний срок задачи-родителя ("
									+ Формат(СрокиРодителя.КрайнийСрок, "ДФ=dd.MM.yy") + ")";
		КонецЕсли;		
	КонецЕсли;
	
	Результат.Вставить("ВылезаетСрокНачала"    , СообщениеДНП);
	Результат.Вставить("ВылезаетСрокЗавершения", СообщениеДЗП);
	Результат.Вставить("ВылезаетКрайнийСрок"   , СообщениеКС);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьСрокиПроектаКлиентСервер(ЭтаФорма) 
	
	Результат = ПроверитьСрокиПроектнойЗадачиПоРодительскойЗадаче(ЭтаФорма);	
	ЭтаФорма.мСписокОшибок = Новый Структура("ДатаНачала,ДатаЗавершения,КрайнийСрок");
	
	Если НЕ ПустаяСтрока(Результат.ВылезаетСрокНачала) Тогда      
		ЭтаФорма.мСписокОшибок.ДатаНачала = Результат.ВылезаетСрокНачала;
		ЭтаФорма.Элементы.КнопкаЛупаДатаНачала.Видимость = Истина;
	Иначе
		ЭтаФорма.Элементы.КнопкаЛупаДатаНачала.Видимость = Ложь;
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(Результат.ВылезаетСрокЗавершения) Тогда      
		ЭтаФорма.мСписокОшибок.ДатаЗавершения = Результат.ВылезаетСрокЗавершения;
		ЭтаФорма.Элементы.КнопкаЛупаДатаОкончания.Видимость = Истина;
	Иначе
		ЭтаФорма.Элементы.КнопкаЛупаДатаОкончания.Видимость = Ложь;
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(Результат.ВылезаетКрайнийСрок) Тогда      
		ЭтаФорма.мСписокОшибок.КрайнийСрок = Результат.ВылезаетКрайнийСрок;
		ЭтаФорма.Элементы.КнопкаЛупаКрайнийСрок.Видимость = Истина;
	Иначе
		ЭтаФорма.Элементы.КнопкаЛупаКрайнийСрок.Видимость = Ложь;
	КонецЕсли;
	
	Если ЭтаФорма.Элементы.КнопкаЛупаДатаНачала.Видимость
		Или ЭтаФорма.Элементы.КнопкаЛупаДатаОкончания.Видимость
		Или ЭтаФорма.Элементы.КнопкаЛупаКрайнийСрок.Видимость Тогда
		ЭтаФорма.Элементы.ДекорацияНадписьРучнойВвод.Ширина = 14;
	Иначе
		ЭтаФорма.Элементы.ДекорацияНадписьРучнойВвод.Ширина = 10;		
	КонецЕсли; 
	
	ЭтаФорма.НадписьКонфликтСроков = ""; 

КонецПроцедуры

&НаСервере
Процедура ПроверитьСрокиПроекта()
	
	ПроверитьСрокиПроектаКлиентСервер(ЭтаФорма);
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ПроверитьСрокиПроекта", ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДопДанныеТЧ_ПредусловияЗадачи(КонкретнаяЗадача = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Кэширование данных задач для обработки таблицы предусловий.
	ЗадачиДляПолученияСроков = Новый Массив;
	ЗадачиДляПолученияРеквизитаПроект = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.ПредусловияЗадачи Цикл
		Если КонкретнаяЗадача = Неопределено ИЛИ КонкретнаяЗадача = СтрокаТЧ.ЗадачаПредшественник Тогда
			ЗадачиДляПолученияСроков.Добавить(СтрокаТЧ.ЗадачаПредшественник);
			Если СтрокаТЧ.СвязьМеждуПроектами Тогда
				ЗадачиДляПолученияРеквизитаПроект.Добавить(СтрокаТЧ.ЗадачаПредшественник);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СрокиПредшественников = упоПроектыИЗадачиСервер.СрокиПроектныхЗадач(ЗадачиДляПолученияСроков);
	ПроектыПредшественников = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ЗадачиДляПолученияРеквизитаПроект, "Проект");
	
	Для Каждого СтрокаТЧ Из Объект.ПредусловияЗадачи Цикл
		Если КонкретнаяЗадача = Неопределено ИЛИ КонкретнаяЗадача = СтрокаТЧ.ЗадачаПредшественник Тогда
			СрокиПредусловия = СрокиПредшественников.Получить(СтрокаТЧ.ЗадачаПредшественник);
			Если СрокиПредусловия <> Неопределено Тогда
				СтрокаТЧ.ДатаПредусловия = Формат(СрокиПредусловия.ДатаЗавершенияПлан, "ДФ=dd.MM.yyyy");
			Иначе
				СтрокаТЧ.ДатаПредусловия = "";
			КонецЕсли; 
			КодПредусловия = упоПроектыИЗадачиВызовСервера.обПолучитьКодСДРПроектнойЗадачи(СтрокаТЧ.ЗадачаПредшественник);
			Если КодПредусловия <> Неопределено Тогда
				СтрокаТЧ.КодСДР = КодПредусловия;
			Иначе
				СтрокаТЧ.КодСДР = "";
			КонецЕсли;
			НазваниеЗадачаПредшественник = упоПроектыИЗадачиСервер.НазваниеПроектнойЗадачи(СтрокаТЧ.ЗадачаПредшественник);
			Если НазваниеЗадачаПредшественник <> Неопределено Тогда
				СтрокаТЧ.НазваниеЗадачаПредшественник = НазваниеЗадачаПредшественник;
			Иначе
				СтрокаТЧ.НазваниеЗадачаПредшественник = "";
			КонецЕсли;
			Если СтрокаТЧ.СвязьМеждуПроектами Тогда
				СтрокаТЧ.Проект = ПроектыПредшественников[СтрокаТЧ.ЗадачаПредшественник];
				СтрокаТЧ.ПроектПредставление = Строка(СтрокаТЧ.Проект);
			Иначе
				СтрокаТЧ.ПроектПредставление = "";
				СтрокаТЧ.Проект = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение(
		"ОбновитьДопДанныеТЧ_ПредусловияЗадачи", ЭтаФорма); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы_мДанные_Сроки()
	
	мДанные = Документы.упоПроектнаяЗадача.ПолучитьДанные(Объект.Ссылка);
	
	РеквизитыФормы = МассивИменРеквизитовФормы(ЭтотОбъект.ПолучитьРеквизиты());
	ПрефиксСрок = "мДанные_Сроки_%1";
	Для Каждого КлючЗначение Из мДанные.Сроки Цикл
		ИмяРеквизитаСрок = СтрШаблон(ПрефиксСрок, КлючЗначение.Ключ);
		НайденныйРеквизит = РеквизитыФормы.Найти(ИмяРеквизитаСрок);
		Если НайденныйРеквизит <> Неопределено Тогда
			ЭтотОбъект[ИмяРеквизитаСрок] = КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыФормы_СрокиПроекта()
	
	ТипДата = Новый ОписаниеТипов("Дата");
	
	ТаблицаСроки = Новый ТаблицаЗначений;
	ТаблицаСроки.Колонки.Добавить("ДатаНачала", 	ТипДата);
	ТаблицаСроки.Колонки.Добавить("ДатаЗавершения", ТипДата);
	
	НоваяСтрока = ТаблицаСроки.Добавить();
	НоваяСтрока.ДатаНачала 		= Объект.ДатаНачалаПлан;
	НоваяСтрока.ДатаЗавершения 	= Объект.ДатаЗавершенияПлан;
	
	ЭтотОбъект.СрокиПроекта = упоПроектыИЗадачиСервер.ПолучитьПланируемыеСрокиПроектаСУчетомТекущихДанных(Объект.Проект, 
		ТаблицаСроки);
	
КонецПроцедуры

