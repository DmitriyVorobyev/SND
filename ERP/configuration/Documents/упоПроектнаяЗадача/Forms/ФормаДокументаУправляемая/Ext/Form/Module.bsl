&НаКлиенте
Процедура ДвиженияДенежныхСредствОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") 
		И ВыбранноеЗначение.Количество() > 0 Тогда
		
		Если ТипЗнч(ВыбранноеЗначение[0].Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			имяПоля =  "Контрагент";
		Иначе 
			имяПоля =  "СтатьяДДС";
		КонецЕсли;
				
		ИмяТабличнойЧасти = "ДвиженияДенежныхСредств";
		ПараметрыПодбораСтруктура = Неопределено;
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
		
		упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение,
			имяПоля, Объект.ДвиженияДенежныхСредств, ЭтаФорма, Истина, ПараметрыПодбораСтруктура);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если ПараметрыПеретаскивания.Значение.Количество() > 0 Тогда
		
		Если ТипЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("СправочникСсылка.Контрагенты") Тогда
			имяПоля = "Контрагент";
		Иначе 
			имяПоля = "СтатьяДДС";
		КонецЕсли;
		
		ИмяТабличнойЧасти = "ДвиженияДенежныхСредств";
		ПараметрыПодбораСтруктура = Неопределено;
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));	
		
		Если Элементы.ДДС_ПараметрыПодбора_НаправлениеПоступление.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление"),
				"НаправлениеДвижения");
			
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_НаправлениеВыплата.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата"),
				"НаправлениеДвижения");
			
		КонецЕсли;
		
		Если Элементы.ДДС_ПараметрыПодбора_ПривязкаКНачалу.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоЗадачи"),"СпособПривязки");
			
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКЗавершению.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеЗадачи"), "СпособПривязки");
				
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКНачалуПроекта.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоПроекта"), "СпособПривязки");
				
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКЗавершениюПроекта.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеПроекта"), "СпособПривязки");
			
		КонецЕсли;
		
		упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение, имяПоля,
			Объект.ДвиженияДенежныхСредств, ЭтаФорма, Истина, ПараметрыПодбораСтруктура);
		
	КонецЕсли;            
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДенежныхСредствПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не Отказ И Копирование 
		И ЗначениеЗаполнено(Элемент.ТекущиеДанные.ИсточникПлана)
		И Элемент.ТекущиеДанные.ИсточникПлана <> ПредопределенноеЗначение("Перечисление.упоИсточникПланаДДС.ДДС") Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

