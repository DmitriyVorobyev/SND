КонецПроцедуры

&НаСервереБезКонтекста
Функция СуществуютОтличияРеквизитаОбъектОтРодительского(ЗначениеРеквизитаОбъект, СписокПЗ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&СписокПЗ)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
		|			И (упоВерсииПроекта.Текущая)
		|ГДЕ
		|	упоСвойстваПроектныхЗадачСрезПоследних.Объект <> &Объект
		|	И ЕСТЬNULL(упоСвойстваПроектныхЗадачСрезПоследних.Объект, ЗНАЧЕНИЕ(Справочник.упоОбъекты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.упоОбъекты.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("СписокПЗ", СписокПЗ);
	Запрос.УстановитьПараметр("Объект", ЗначениеРеквизитаОбъект);

	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе 
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПерейтиПоСсылке(ИмяТаблицы, ИмяКолонки)
	
	ТекДанные = Элементы[ИмяТаблицы].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда      
		Возврат;
	КонецЕсли; 
	
	ПоказатьЗначение(,ТекДанные[ИмяКолонки]);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДатыПривязкиДДС()
	
	текСтрока = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	Если текСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	упоДвиженияДенежныхСредствКлиентСервер.УстановитьДоступностьДатыПривязкиВСтрокеДДС(текСтрока, 
	                            "СпособПривязки",
								Элементы.ДвиженияДенежныхСредствДатаПривязки, 
								Элементы.ДвиженияДенежныхСредствЗадержка);
		
КонецПроцедуры 

