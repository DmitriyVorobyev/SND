		Возврат;
	КонецЕсли;
	
	Элемент.ОграничениеТипа = ПолучитьОграничениеТиповЕдИзм(ТекДанные.Ресурс);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОграничениеТиповЕдИзм(Ресурс)
	
	МассивТипов = Новый Массив;
	
	Если НЕ ЕстьРежимИнтеграции_УПО_EPM() Тогда
		
		Если Ресурс.упоВидМатериальногоРесурса = ПредопределенноеЗначение("Перечисление.упоВидМатериальногоРесурса.Материал") Тогда
			МассивТипов.Добавить(Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		ИначеЕсли Ресурс.упоВидМатериальногоРесурса = ПредопределенноеЗначение("Перечисление.упоВидМатериальногоРесурса.Оборудование") Тогда
			МассивТипов.Добавить(Тип("СправочникСсылка.упоЕдиницыВремени"));
		Иначе
			МассивТипов.Добавить(Тип("СправочникСсылка.упоЕдиницыВремени"));
			МассивТипов.Добавить(Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		КонецЕсли;
		
	Иначе
		
		МассивТипов.Добавить(Тип("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
		
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

