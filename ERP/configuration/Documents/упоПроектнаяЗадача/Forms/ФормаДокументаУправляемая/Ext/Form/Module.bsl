		Возврат;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределяемыеПередНачалоДобавления(ЭтаФорма, Объект, ИмяТаблицы,
		"РаспределениеДоходов",Копирование, Отказ);
	
	РассчитатьИтогиПоТаблице("ПланДоходов", , Ложь, "Сумма");
	
