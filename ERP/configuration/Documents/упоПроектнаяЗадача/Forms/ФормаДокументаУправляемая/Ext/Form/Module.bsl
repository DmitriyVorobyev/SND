&НаКлиенте
Процедура ДоходыЗаполнитьПоТрудовымМатериальнымРесурсам(Команда)
	
	ИмяКоманды = Команда.Имя;
	
	// Проверить модификацию документа, а затем очередь расчета трудозатрат.
	Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
		СписокОповещений = Новый СписокЗначений;
		ТекстСообщения = НСтр("ru = 'Заполнение может быть некорректным. '");
		
		Если ЭтотОбъект.Модифицированность Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения + НСтр("ru = 'Для корректного заполнения по трудовым ресурсам проектная задача должна быть проведена!'");
			Сообщение.Сообщить();
		ИначеЕсли ПроверкаСостоянияУПООчередьОтраженияПлановыхТрудозатратЗадач(Объект.Проект, СписокОповещений) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СписокОповещений[0].Значение.ТекстПояснения;
			Сообщение.Текст = Сообщение.Текст + ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
	
	ЭтотОбъект.Модифицированность = Истина;
	
	Если НЕ ЕстьДанныеВИсточникеЗаполнения(ИмяКоманды) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ИмяКоманды", ИмяКоманды);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ДоходыЗаполнитьПоТрудовымМатериальнымРесурсамЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
	
	Если Объект.ПланДоходов.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Очищать табличную часть ""План доходов"" при заполнении?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса,
			РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		
		Возврат;
	КонецЕсли;
	
	ДоходыЗаполнитьПоТрудовымМатериальнымРесурсамЗавершение(КодВозвратаДиалога.Нет, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовЗаполнитьПоТрудовымМатериальнымРесурсам(Команда)
	
	ИмяКоманды = Команда.Имя;
	
	ТекущиеДанныеСтрокиРаспределения = Элементы.ПланДоходов.ТекущиеДанные;
	Если ТекущиеДанныеСтрокиРаспределения = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана строка для распределения в табличной части ""Доходы"".'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ПроверитьДоступностьРедактированияСтрокРаспределения("ПланДоходов", ТекущиеДанныеСтрокиРаспределения, Отказ);
	Если Отказ Тогда
		ЭтотОбъект.Модифицированность = Ложь;
		Возврат;
	КонецЕсли;
	
	// Проверить модификацию документа, а затем очередь расчета трудозатрат.
	Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
		СписокОповещений = Новый СписокЗначений;
		ТекстСообщения = НСтр("ru = ' Заполнение может быть некорректным.'");
		
		Если ЭтотОбъект.Модифицированность Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения + НСтр("ru = 'Для корректного заполнения по трудовым ресурсам проектная задача должна быть проведена!'");
			Сообщение.Сообщить();
		ИначеЕсли ПроверкаСостоянияУПООчередьОтраженияПлановыхТрудозатратЗадач(Объект.Проект, СписокОповещений) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = СписокОповещений[0].Значение.ТекстПояснения;
			Сообщение.Текст = Сообщение.Текст + ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЕсли;
	
	ЭтотОбъект.Модифицированность = Истина;
	
	Если Не ЕстьДанныеВИсточникеЗаполнения(ИмяКоманды) Тогда		
		Возврат;			
	КонецЕсли;

	ДополнительныеПараметры = Новый Структура("ИмяКоманды", ИмяКоманды);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("РаспределениеДоходовЗаполнитьПоТрудовымМатериальнымРесурсамЗавершение",
			ЭтотОбъект, ДополнительныеПараметры);
		
	ОтборОчистка = Новый Структура("ИндексСтрокиВладельца",
			ТекущиеДанныеСтрокиРаспределения.ИндексСтрокРаспределения);
	СтрокиКУдалению = Объект.РаспределениеДоходов.НайтиСтроки(ОтборОчистка);
	
	Если СтрокиКУдалению.Количество() Тогда
		ТекстВопроса = НСтр("ru = 'Очищать табличную часть ""Распределение доходов"" при заполнении?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса,
			РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;
	
	РаспределениеДоходовЗаполнитьПоТрудовымМатериальнымРесурсамЗавершение(КодВозвратаДиалога.Нет,
		ДополнительныеПараметры);
	
КонецПроцедуры

