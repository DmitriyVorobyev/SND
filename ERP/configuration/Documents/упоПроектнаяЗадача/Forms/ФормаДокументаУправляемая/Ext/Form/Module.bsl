	ДопПараметры.Вставить("РежимЗаполнения", "ПоОкончательномуУровню");	
	РаспределениеОбъемовЗаполнитьПоРолям(ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОткрытьЗамененнуюФормуПроекта(Команда)
	 
	упоИнтеграцияКлиент.ПроверитьНаМодифицированностьИОткрытьЗамененнуюФормуПроекта(ЭтотОбъект, Истина);  	
	
КонецПроцедуры

&НаКлиенте	
Процедура КомандаКопироватьСтрокуВладельцаВРаспределение(Команда)
		
	ИмяКоманды = Команда.Имя;	
	
	ДополнительныеПараметрыОбработкиФормы = упоАналитикаПоПодразделениямКлиентСервер.ПараметрыОбработкиДанныхРаспределения(Ложь);
	ДополнительныеПараметрыОбработкиФормы.Вставить("ИспользоватьАналитикуКонтрагентДляСС", ИспользоватьАналитикуКонтрагентДляСС);
	ПараметрыКопирования = упоРаботаСФормамиКлиент.КопироватьСтрокуВладельцаВРаспределение(Объект, 
																			ЭтаФорма, 
																			ИмяКоманды, 
																			ДополнительныеПараметрыОбработкиФормы);
	
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, 
																			ЭтаФорма, 
																			ПараметрыКопирования.ТаблицаПодчиненная,
																			"ИндексСтрокиРаспределениеПоРолям",
																			ПараметрыКопирования.КопироватьКоличество);
	
	Результат = НастройкиПоИмениКоманды(Команда.Имя);	
	Если Результат = Неопределено Тогда
		Возврат; // Возврат.
	КонецЕсли;	
	
	ИмяОсновнойТаблицы		= Результат.ИмяОсновнойТаблицы;
	ИмяТаблицыРаспределения = Результат.ИмяТаблицыРаспределения;
	ИмяКолонкиСумма 		= Результат.ИмяКолонкиСумма;
	УчитыватьКоличество		= Результат.УчитыватьКоличество;	
		
	// Заполнение связанных таблиц.	
	Если ИмяОсновнойТаблицы = "МатериальныеРесурсы" Тогда
		
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты");
		ОсновнаяСвязаннаяТаблица = "ПланРасходов";
		СвязаннаяТаблицаРаспределения = "РаспределениеРасходов";
		упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
																			ОсновнаяСвязаннаяТаблица, 
																			СвязаннаяТаблицаРаспределения,
																			ИсточникПлана);
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, 
																			ИмяОсновнойТаблицы,
																			ИмяТаблицыРаспределения, 
																			ИмяКолонкиСумма,
																			УчитыватьКоличество);
		Если Объект.ВключитьМатРесурсыВПланРасходов Тогда
			ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();
			СформироватьИтогПоФинПланам(ЭтаФорма);
		КонецЕсли;
		
	ИначеЕсли ИмяОсновнойТаблицы = "Субпродукты" Тогда
		
		ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы");
		ОсновнаяСвязаннаяТаблица = "ПланДоходов";
		СвязаннаяТаблицаРаспределения = "РаспределениеДоходов";
		упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
																			ОсновнаяСвязаннаяТаблица,
																			СвязаннаяТаблицаРаспределения,
																			ИсточникПлана);
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, 
																			ИмяОсновнойТаблицы,
																			ИмяТаблицыРаспределения, 
																			ИмяКолонкиСумма, 
																			УчитыватьКоличество);	
		Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
			ПеренестиСтрокиОбъемовВДоходыДляИнформации();
			СформироватьИтогПоФинПланам(ЭтаФорма);
		КонецЕсли;
		СоздатьДопЭлементыРаспределенияДоходов(Истина, Ложь, Ложь, Ложь, Ложь, Ложь);
		
	ИначеЕсли ИмяОсновнойТаблицы = "ДополнительныеЗатраты" Тогда	
		
		ОсновнаяСвязаннаяТаблица = "ПланРасходов";
		СвязаннаяТаблицаРаспределения = "РаспределениеРасходов";
		упоРаботаСФормамиКлиент.УдалитьДанныеТекущейСтрокиИзСвязаннойПодчиненнойТаблицы(Объект, 
																			ЭтаФорма, 
																			ИмяТаблицыРаспределения, 
																			ОсновнаяСвязаннаяТаблица, 
																			СвязаннаяТаблицаРаспределения, 
																			ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС);	
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, 
																			ИмяОсновнойТаблицы,
																			ИмяТаблицыРаспределения, 
																			ИмяКолонкиСумма,
																			УчитыватьКоличество);
		Если Объект.ВключитьДопЗатратыВПланРасходов Тогда
			упоРаботаСФормамиКлиент.ЗаполнитьСвязаннуюПодчиненнуюТаблицу(Объект, 
																			ЭтаФорма, 
																			ИмяТаблицыРаспределения,
																			ОсновнаяСвязаннаяТаблица,
																			СвязаннаяТаблицаРаспределения,
																			ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС);
		КонецЕсли;
		
	ИначеЕсли ИмяОсновнойТаблицы = "ПланДоходов" 
			Или ИмяОсновнойТаблицы = "ПланРасходов" Тогда 
		
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, 
																			ИмяОсновнойТаблицы,
																			ИмяТаблицыРаспределения,
																			ИмяКолонкиСумма,
																			УчитыватьКоличество);				

	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьНДС(Команда)
	
	Результат = НастройкиПоИмениКоманды(Команда.Имя);
	Если Результат = Неопределено Тогда
		Возврат; // Возврат.
	КонецЕсли;
	
	ИмяОсновнойТаблицы		= Результат.ИмяОсновнойТаблицы;
	ИмяТаблицыРаспределения = Результат.ИмяТаблицыРаспределения;
	ИмяКолонкиСумма 		= Результат.ИмяКолонкиСумма;
	УчитыватьКоличество		= Результат.УчитыватьКоличество;
	ИмяКомандыКопирования 	= Результат.ИмяКомандыКопирования;
	
	ТекущиеДанные = Элементы[ИмяОсновнойТаблицы].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат; // Возврат.
	КонецЕсли;
	
	// Контроль трансляции.
	Если упоРаботаСФормамиКлиент.ЭтоПеренесеннаяСтрокаОсновнойТаблицы(ИмяОсновнойТаблицы, 
																	ТекущиеДанные, 
																	Истина, 
																	Истина) Тогда
		Возврат; // Возврат.
	КонецЕсли;	
	
	// Заполнение по умолчанию.
	СтрокиРаспределенияПоПодразделениям = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПодразделениям(
																				ТекущиеДанные, 
																				Объект[ИмяТаблицыРаспределения], 
																				Истина);
	Если СтрокиРаспределенияПоПодразделениям.Количество() = 0 Тогда					
		ПараметрыКоманды = Новый Структура("Имя", ИмяКомандыКопирования);
		КомандаКопироватьСтрокуВладельцаВРаспределение(ПараметрыКоманды);		
	КонецЕсли;					
	
	// НДС.
	СтрокаВладелец = упоРаботаСФормамиКлиент.СтрокаДанныхДляРасчетаНДС(ТекущиеДанные, ИмяКолонкиСумма);
	ВыделитьНДССервер(СтрокаВладелец, ИмяОсновнойТаблицы);
	
	// Итоги.
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, 
																		ИмяОсновнойТаблицы, 
																		ИмяТаблицыРаспределения, 
																		ИмяКолонкиСумма);
																		
	ТранслироватьСтрокиВБДР(ИмяОсновнойТаблицы, ИмяТаблицыРаспределения);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВосстановитьОтмененнуюЗадачу(Команда)
	
	ВосстановитьОтмененнуюЗадачу();
	
КонецПроцедуры

