&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокФормы(Форма, ИмяПЗ, ЗадачаОтменена)
					
	ОтмененнаяПЗ = "";
	Если ЗадачаОтменена Тогда
		ОтмененнаяПЗ = упоПроектыИЗадачиОбщие.ПрефиксОтмененнойЗадачи();	
	КонецЕсли;	
	
	Если ПустаяСтрока(ИмяПЗ) Тогда
		НазваниеПЗ = НСтр("ru = '<БЕЗ НАЗВАНИЯ>'");
	Иначе
		НазваниеПЗ = СтрШаблон("""%1""", СокрЛП(ИмяПЗ));
	КонецЕсли;
	
	НоваяПЗ = "";	
	Если Форма.ЭтоНовый Тогда
		НоваяПЗ = НСтр("ru = '(создание)'");
	КонецЕсли;	
	
	Форма.Заголовок = СтрШаблон(НСтр("ru = 'ПЗ %1%2 %3'"), ОтмененнаяПЗ, НазваниеПЗ, НоваяПЗ);
			
КонецПроцедуры

&НаСервере
Функция ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТЧ)
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("СтруктураСтрокиТЧ", Новый Структура);
	ДопПараметры.Вставить("СтруктураОбъекта", Новый Структура);
	
	ПодготовитьКопиюДанныхОбъекта(ДопПараметры.СтруктураСтрокиТЧ, ИмяТЧ);
	ПодготовитьКопиюДанныхОбъекта(ДопПараметры.СтруктураОбъекта);
	
	Возврат ДопПараметры;
	
КонецФункции

&НаСервере
Процедура ПодготовитьКопиюДанныхОбъекта(СтруктураПустая, ИмяТЧ = Неопределено)
	
	// Перенести код в модуль с повторным использованием значений.
	
	СтруктураПустая = Новый Структура;
	
	Если ИмяТЧ = Неопределено Тогда 
		
		Для Каждого РеквизитМетаданных Из Метаданные.Документы.упоПроектнаяЗадача.Реквизиты Цикл
			
			СтруктураПустая.Вставить(РеквизитМетаданных.Имя);
			
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(СтруктураПустая, Объект);
		
	Иначе 
		
		Для Каждого РеквизитМетаданных Из Метаданные.Документы.упоПроектнаяЗадача.ТабличныеЧасти[ИмяТЧ].Реквизиты Цикл
			
			СтруктураПустая.Вставить(РеквизитМетаданных.Имя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасшифровкуКонфликтаСроков(ИмяПараметра)
	
	ТекстОшибки = Неопределено;
	Если ТипЗнч(мСписокОшибок) = Тип("Структура") И мСписокОшибок.Свойство(ИмяПараметра, ТекстОшибки) Тогда     
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки	= "Не удается установить точную причину конфликта сроков. "
				+ "Для получения точной информации нужно воспользоваться функцией "
				+ "проверки проекта.";
		КонецЕсли; 
		НадписьКонфликтСроков = ТекстОшибки;
	Иначе
		ТекстОшибки = ""; 
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИтогПоФинПланам(ЭтаФорма)
	
	ЭтаФорма.ИтогоДоходы = ЭтаФорма.Объект.ПланДоходов.Итог("Сумма");
	ЭтаФорма.ИтогоРасходы = ЭтаФорма.Объект.ПланРасходов.Итог("Сумма");
	
	Если НЕ ЭтаФорма.ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС Тогда
		
		Если ЭтаФорма.Объект.ВключитьСубпродуктыВПланДоходов Тогда
			ЭтаФорма.ИтогоДоходы = ЭтаФорма.ИтогоДоходы + ЭтаФорма.Объект.Субпродукты.Итог("ОбщСтоимость");
		КонецЕсли;
		Если ЭтаФорма.Объект.ВключитьМатРесурсыВПланРасходов Тогда
			ЭтаФорма.ИтогоРасходы = ЭтаФорма.ИтогоРасходы + ЭтаФорма.Объект.МатериальныеРесурсы.Итог("ОбщСтоимость");
		КонецЕсли;
		
	КонецЕсли;
		
	ЭтаФорма.ИтогоВыплаты = 0;
	ЭтаФорма.ИтогоПоступления = 0;
	
	Для каждого СтрокаДДС Из ЭтаФорма.Объект.ДвиженияДенежныхСредств Цикл
		Если СтрокаДДС.НаправлениеДвижения = ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата") Тогда
			ЭтаФорма.ИтогоВыплаты = ЭтаФорма.ИтогоВыплаты + СтрокаДДС.Сумма;
		ИначеЕсли СтрокаДДС.НаправлениеДвижения = 
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление") Тогда
			ЭтаФорма.ИтогоПоступления = ЭтаФорма.ИтогоПоступления + СтрокаДДС.Сумма;
		КонецЕсли; 
	КонецЦикла; 
	
	ЭтаФорма.ИтогоРасходы = ЭтаФорма.ИтогоРасходы * - 1;
	ЭтаФорма.ИтогоВыплаты = ЭтаФорма.ИтогоВыплаты * - 1;
	
	ЭтаФорма.ИтогоБДР = ЭтаФорма.ИтогоДоходы + ЭтаФорма.ИтогоРасходы;
	ЭтаФорма.ИтогоБДДС = ЭтаФорма.ИтогоПоступления + ЭтаФорма.ИтогоВыплаты;
	
	ЭтаФорма.ИтогоРазностьДоходы = ЭтаФорма.ИтогоДоходы - ЭтаФорма.ИтогоПоступления;
	ЭтаФорма.ИтогоРазностьРасходы = ЭтаФорма.ИтогоРасходы - ЭтаФорма.ИтогоВыплаты;
	ЭтаФорма.ИтогоРазностьБДР = ЭтаФорма.ИтогоБДР - ЭтаФорма.ИтогоБДДС;
	
	ЭтаФорма.ИтогоРазностьПоступления = ЭтаФорма.ИтогоПоступления - ЭтаФорма.ИтогоДоходы;
	ЭтаФорма.ИтогоРазностьВыплаты = ЭтаФорма.ИтогоВыплаты - ЭтаФорма.ИтогоРасходы;
	ЭтаФорма.ИтогоРазностьБДДС = ЭтаФорма.ИтогоБДДС - ЭтаФорма.ИтогоБДР;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюЗадачу()
	
	Если НЕ Объект.Проведен Тогда      
		Возврат;
	ИначеЕсли Объект.ЭтоПакетРабот Тогда
		Возврат;
	КонецЕсли; 	
	
	ОткрытьФорму("Документ.упоПроектнаяЗадача.ФормаОбъекта", Новый Структура("Основание",Объект.Ссылка));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщийПрофиль(ИмяТаблицы)
	
	ТабличнаяЧасть = Неопределено;
	
	Если ИмяТаблицы = "Доходы" Тогда      
		ТабличнаяЧасть = Объект.ПланДоходов;
	ИначеЕсли ИмяТаблицы = "Расходы" Тогда      
		ТабличнаяЧасть = Объект.ПланРасходов;
	ИначеЕсли ИмяТаблицы = "ТрудовыеРесурсы" Тогда
		ТабличнаяЧасть = Объект.ТрудовыеРесурсы;
	ИначеЕсли ИмяТаблицы = "Субпродукты" Тогда
		ТабличнаяЧасть = Объект.Субпродукты;	
	Иначе
		Возврат;
	КонецЕсли; 
	
	Если ТабличнаяЧасть.Количество() = 0 Тогда      
		Возврат;
	КонецЕсли; 
	
	// выбираем профиль распределения
	Если ИмяТаблицы = "ТрудовыеРесурсы" Тогда
		ИмяФормыВыбора = "Справочник.упоПрофилиРаспределенияТрудозатрат.ФормаВыбора";
	Иначе 
		ИмяФормыВыбора = "Справочник.упоПрофилиРаспределенияДоходовИРасходов.ФормаВыбора";			
	КонецЕсли; 		
	
	Контекст = Новый Структура;
	Контекст.Вставить("ИмяТаблицы",ИмяТаблицы);
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщийПрофильОсновная",ЭтотОбъект,Контекст);
	ОткрытьФорму(ИмяФормыВыбора,,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПланРасходов()
	
	Если Объект.ПланРасходов.Количество() > 0 Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПланРасходовЗавершение", ЭтотОбъект);
		
		НСтрока = НСтр("ru = 'Очистить табличную часть ""План расходов"" при заполнении?'");
		ПоказатьВопрос(ОписаниеОповещения, НСтрока, РежимДиалогаВопрос.ДаНетОтмена, 120, КодВозвратаДиалога.Да);
			
		Возврат;
		
	КонецЕсли; 	
	
	ЗаполнитьПланРасходовЗавершение(Неопределено, Неопределено);
	
КонецПроцедуры

// Заполнить план расходов завершение.
//
// Параметры:
//  Ответ					 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЗаполнитьПланРасходовЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ОчищатьОсновнуюТаблицу = Истина;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ОчищатьОсновнуюТаблицу = Ложь;
	КонецЕсли;
	
	Если ОчищатьОсновнуюТаблицу Тогда
		ОчиститьПланРасходовРаспределениеРасходовКромеИсточникаТрудозатраты();
	КонецЕсли;
	
	// Проверим запись задачи и очередь отражения трудозатрат.
	Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат И ЭтотОбъект.Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПланРасходовТрудовымиРесурсамиПослеЗаписи",
				ЭтотОбъект);
		
		ТекстСообщения = НСтр("ru = 'Необходимо провести проектную задачу для продолжения. Провести задачу сейчас?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	ИначеЕсли УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат И ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат
		И ЗадачаНаходитсяВОчередиОтраженияТрудозатрат() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПланРасходовТрудовымиРесурсамиПослеОтраженияТрудозатрат",
			ЭтотОбъект);
		
		ТекстСообщения = НСтр("ru = 'Требуется отражение плановых трудозатрат по задаче.
			|Выполнить отражение сейчас?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПланРасходовЗаполнитьПоТрудовымРесурсамНаСервере(Ложь);
	КонецЕсли;
	
	ЗаполнитьПланРасходовЗатратами(ОчищатьОсновнуюТаблицу);
	
	ИмяТабличнойЧасти = "ПланРасходов";
	
	ДобавитьИнформационныеСтрокиВПланДоходовИРасходов(Истина, Ложь, Истина, Ложь, Ложь);
	
	Оповестить("ЗаполнениеТЧ_ПланРасходов", , Объект.Ссылка);
	
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	
	// Сняли флаг "Изменяет сохраняемые данные" у команды, необходимо установить признак модифицированности вручную.
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПланРасходовЗатратами(ОчищатьОсновнуюТаблицу)
	
	// Добавим остальные планы (мат. и доп. затраты).
	ДанныеПлана = обСформироватьРасходыПроектнойЗадачи(Объект.Ссылка);
	ЗначенияПоУмолчанию_Проект = 
		упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Объект.Проект);
	КэшЗначенийПоУмолчанию_СтатьиЗатрат = Новый Соответствие;
	Для каждого СтрокаДанные Из ДанныеПлана Цикл
		
		СтрокаРасход = Объект.ПланРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРасход, СтрокаДанные);
		
		СтатьяЗатрат = ?(ЗначениеЗаполнено(СтрокаДанные.СтатьяЗатрат), 
			СтрокаДанные.СтатьяЗатрат, ЗначенияПоУмолчанию_Проект.СтатьяЗатратПоУмолчанию);
		
		ЗначенияПоУмолчанию_СтатьяЗатрат = КэшЗначенийПоУмолчанию_СтатьиЗатрат.Получить(СтатьяЗатрат);
		Если ЗначенияПоУмолчанию_СтатьяЗатрат = Неопределено Тогда
			ЗначенияПоУмолчанию_СтатьяЗатрат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяЗатрат, 
				"СпособПривязкиРасходовПоУмолчанию, ПрофильРаспределенияПоУмолчанию");
			КэшЗначенийПоУмолчанию_СтатьиЗатрат.Вставить(СтатьяЗатрат, ЗначенияПоУмолчанию_СтатьяЗатрат);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанные.СпособПривязки) Тогда
			СпособПривязки = СтрокаДанные.СпособПривязки;
		ИначеЕсли ЗначениеЗаполнено(ЗначенияПоУмолчанию_СтатьяЗатрат.СпособПривязкиРасходовПоУмолчанию) 
			И Не СтрокаДанные.ЭтоРольТрудовогоРесурса Тогда
			СпособПривязки = ЗначенияПоУмолчанию_СтатьяЗатрат.СпособПривязкиРасходовПоУмолчанию;
		Иначе
			СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанные.ПрофильРаспределения) Тогда
			ПрофильРаспределения = СтрокаДанные.ПрофильРаспределения;
		ИначеЕсли ЗначениеЗаполнено(ЗначенияПоУмолчанию_СтатьяЗатрат.ПрофильРаспределенияПоУмолчанию) 
			И Не СтрокаДанные.ЭтоРольТрудовогоРесурса Тогда
			ПрофильРаспределения = ЗначенияПоУмолчанию_СтатьяЗатрат.ПрофильРаспределенияПоУмолчанию;
		Иначе
			ПрофильРаспределения = ЗначенияПоУмолчанию_Проект.ПрофильРасходовПоУмолчанию;
		КонецЕсли;
		
		СтрокаРасход.СпособПривязки = СпособПривязки;
		СтрокаРасход.Статья = СтатьяЗатрат;
		СтрокаРасход.ПрофильРаспределения = ПрофильРаспределения;
		СтрокаРасход.Валюта = мВалютаУправленческогоУчета;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПланРасходовТрудовымиРесурсамиПослеЗаписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбъектЗаписан = ЭтотОбъект.Записать();
		Если НЕ ОбъектЗаписан Тогда
			Возврат;
		КонецЕсли;
		ЭтотОбъект.Прочитать();
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат
		И ЗадачаНаходитсяВОчередиОтраженияТрудозатрат() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПланРасходовТрудовымиРесурсамиПослеОтраженияТрудозатрат",
			ЭтотОбъект);
		
		ТекстСообщения = НСтр("ru = 'Требуется отражение плановых трудозатрат по задаче.
			|Выполнить отражение сейчас?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	Очищать = Ложь;
	ПланРасходовЗаполнитьПоТрудовымРесурсамНаСервере(Очищать);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПланРасходовТрудовымиРесурсамиПослеОтраженияТрудозатрат(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗадачиВОчереди = Новый Массив;
		ЗадачиВОчереди.Добавить(Объект.Ссылка);
		упоРаспределениеТрудозатратВызовСервера.ОбработатьПорциюОтраженияПлановыхТрудозатратЗадач(ЗадачиВОчереди);
		
		ЕстьОбновлениеТрудозатратДляБДР = Ложь;
		ПоказатьПредупреждениеИзмененияТрудозатратДляБДР();
		
		ЭтотОбъект.Прочитать();
	Иначе
		Возврат;
	КонецЕсли;
	
	Очищать = Ложь;
	ПланРасходовЗаполнитьПоТрудовымРесурсамНаСервере(Очищать);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНаправлениеДС()
	
	ТекДанные = Элементы.ДвиженияДенежныхСредств.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтатьяДДС = ТекДанные.СтатьяДДС;
	Если Не ЗначениеЗаполнено(СтатьяДДС) Тогда
		НД = ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.ПустаяСсылка");
	Иначе
		НД = ПолучитьНаправлениеДвиженияСтатьиДДС(СтатьяДДС);
	КонецЕсли;
	ТекДанные.НаправлениеДвижения = НД;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборИсполнителей()
	
	Если НЕ ЭтоНовый Тогда		
		упоРаботаСДинамическимиСписками.УдалитьОтборСписка(ТаблицаИсполнители, "Ресурс");	
		
		Отбор = Новый Структура("ПроектнаяЗадача, РесурсВыделен, Версия", Объект.Ссылка, Истина, ЭтотОбъект.ТекущаяВерсия);
		упоРаботаСДинамическимиСписками.УстановитьОтборВСписке(ТаблицаИсполнители, Отбор);
	Иначе
		Отбор = Новый Структура("Ресурс", Справочники.упоТрудовыеРесурсы.ПустаяСсылка());
		упоРаботаСДинамическимиСписками.УстановитьОтборВСписке(ТаблицаИсполнители, Отбор);
	КонецЕсли;  	
	
	Элементы.ТаблицаИсполнители.Обновить();	
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()	
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);			
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатуДокумента()

	Объект.Дата = ОбщегоНазначенияКлиент.ДатаСеанса();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущуюДатуСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаСервере
Процедура ЗаполнитьГиперссылкуСервер(ИмяРеквизита = "Проект", ПредставлениеРеквизита = "проект",
	ПредставлениеСостояния = "выбран", ПроверятьПустойРеквизит = Истина)
	
	упоУправлениеФормамиСервер.ЗаполнитьГиперссылку(Объект, ЭтаФорма, ИмяРеквизита, ПредставлениеРеквизита,
		ПредставлениеСостояния, ПроверятьПустойРеквизит);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьТипаЗадачи()
	
	МожноИзменитьТип = Истина;
	ИмяЭлемента = "";
	
	Если Объект.ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Этап Тогда
		Если Не ЭтотОбъект.ЭтоНовый Тогда
			// Можно менять, если нет ни одной задачи нижнего уровня.
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ЗадачаРодитель", Объект.Ссылка);
			Запрос.УстановитьПараметр("ТекущаяВерсия", ЭтотОбъект.ТекущаяВерсия);
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			               |	табл.ПроектнаяЗадача КАК ПроектнаяЗадача
			               |ИЗ
			               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК табл
			               |ГДЕ
			               |	табл.ЗадачаРодитель = &ЗадачаРодитель
			               |	И НЕ табл.ЗадачаОтменена";
			
			Результат = Запрос.Выполнить();
			Если Не Результат.Пустой() Тогда
				МожноИзменитьТип = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		ИмяЭлемента = "Этап";
	ИначеЕсли Объект.ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.ПакетРабот Тогда
		МожноИзменитьТип = Истина;
		ИмяЭлемента = "ПакетРабот";
	ИначеЕсли Объект.ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.МодельПакетаРабот Тогда
		МожноИзменитьТип = Истина;
		ИмяЭлемента = "МодельПакетаРабот";
	ИначеЕсли Объект.ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Веха Тогда
		МожноИзменитьТип = Истина;
		ИмяЭлемента = "Веха";
	КонецЕсли; 
	
	Элементы.ТипПроектнойЗадачи.Доступность = МожноИзменитьТип;
	
	Элементы.СтраницаВыбораТипаПроектнойЗадачи.Видимость = МожноИзменитьТип И Не ЭтотОбъект.ТолькоПросмотр; 
	
	НадоПоказатьОписаниеТипа = Не Элементы.СтраницаВыбораТипаПроектнойЗадачи.Видимость;
	
	Элементы.СтраницаТипаПроектнойЗадачи.Видимость = НадоПоказатьОписаниеТипа;
	
	ПоказатьОписаниеТипаПроектнойЗадачи(ИмяЭлемента, НадоПоказатьОписаниеТипа);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьРедактированияСроков()
		
	Если Не ЗапретитьРПЗИзменятьСрокиЧужихЗадач Тогда 
		Возврат;	
	КонецЕсли;
	
	Если РольДоступна("ПолныеПрава") Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтоРП = упоИерархияИПолномочияСервер.ПользовательЯвляетсяРуководителемПроекта(Объект.Проект);
	
	Если ЭтоРП Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ДекорацияНадписьЗапрещеноРедактироватьСроки.Видимость = Истина;
	
	Элементы.ГруппаТипПроектнойЗадачи.Доступность                                         = Ложь;
	Элементы.ГруппаПодмениюЗаполнитьДлительность.Доступность                              = Ложь;
	Элементы.ЗадачаОтменена.Доступность                                                   = Ложь;
	Элементы.КнопкаСменитьРодителя.Доступность                                            = Ложь;
	Элементы.КнопкаУдалитьРодителя.Доступность                                            = Ложь;
	Элементы.СтраницаСроки.ТолькоПросмотр                                                 = Истина;
	Элементы.СтраницаПредусловия.ТолькоПросмотр                                           = Истина;
	Элементы.ПредусловияЗадачиДействиеПодобрать_Предусловия_ПроектныеЗадачи.Доступность   = Ложь;
	Элементы.ПредусловияЗадачиКомандаДобавитьСвязьСЗадачейДругогоПроекта.Доступность      = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьОписаниеТипаПроектнойЗадачи(ИмяЭлемента, НадоПоказатьОписаниеТипа)
  	
	Если Не НадоПоказатьОписаниеТипа Тогда
		Возврат;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ИмяЭлемента) Тогда		
		
		// Необходимо для совместимости с редакцией 1, в случае,
		// когда проектная задача уже закрыта (форма открывается только
		// на чтение и перезаписать реквизит с типом задачи
		// не представляется возможным, а показать его нужно).
		
		Если Объект.ЭтоВеха Тогда
			ИмяЭлемента = "Веха";
		ИначеЕсли Объект.ЭтоПакетРабот И Объект.ЭтоМодельПакетаРабот Тогда
			ИмяЭлемента = "МодельПакетаРабот";
		ИначеЕсли Объект.ЭтоПакетРабот Тогда
			ИмяЭлемента = "ПакетРабот";
		Иначе
			ИмяЭлемента = "Этап";
		КонецЕсли; 
		
	КонецЕсли; 

	ТекстШаблона = НСтр("ru = 'Проектная задача является %1'");		
	
	Если ИмяЭлемента = "ПакетРабот" Тогда
		НадписьТипПроектнойЗадачи = СтрШаблон(ТекстШаблона, НСтр("ru = 'пакетом работ'"));			
		ОписаниеТипаЗадачи = НСтр("ru = 'Находится на нижнем уровне декомпозиции.'");
	ИначеЕсли ИмяЭлемента = "МодельПакетаРабот" Тогда
		НадписьТипПроектнойЗадачи = СтрШаблон(ТекстШаблона, НСтр("ru = 'моделью пакета работ'"));
		ОписаниеТипаЗадачи = НСтр("ru = 'Находится на нижнем уровне декомпозиции.'");
	ИначеЕсли ИмяЭлемента = "Веха" Тогда
		НадписьТипПроектнойЗадачи = СтрШаблон(ТекстШаблона, НСтр("ru = 'вехой'"));		
		ОписаниеТипаЗадачи = НСтр("ru = 'Имеет нулевую длительность и фиксированную дату прохождения по плану.'");
	Иначе // Этап 
		НадписьТипПроектнойЗадачи = СтрШаблон(ТекстШаблона, НСтр("ru = 'этапом или подэтапом проекта'"));
		ОписаниеТипаЗадачи = НСтр("ru = 'Является ""контейнером"" для проектных задач более низкого уровня.'");
	КонецЕсли;	
		
	Элементы.НадписьПояснениеТипЗадачи.Заголовок = ОписаниеТипаЗадачи;
	
	ИмяКартинки = СтрШаблон("упоЗадача%1Записанная", ИмяЭлемента);
	Элементы.ПолеКартинкиТипЗадачи.Картинка = БиблиотекаКартинок[ИмяКартинки];
		
КонецПроцедуры	

&НаСервере
Процедура УстановитьАктивныйТипЗадачи()
	
	упоПроектыИЗадачиОбщие.УстановитьВидимостьЭлементовФормыПроектнойЗадачи(Объект, ЭтаФорма, ЭтаФорма.ПроектныеОпции);     
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПериодГанта(Диаграмма, Период, Регулятор, Команда, ТекКоманда = Неопределено,
	СброситьМасштаб = Ложь)
	
	Если ЗначениеЗаполнено(ТекКоманда) Тогда      
		Элементы[ТекКоманда].Пометка = Ложь;
	КонецЕсли; 
	
	упоПредставлениеПроектаВызовСервера.обИзменитьМасштабДиаграммыГанта(Диаграмма, Период, Регулятор, СброситьМасштаб);
	
	Если ЗначениеЗаполнено(Команда) Тогда      
		ТекКоманда = Команда;
		Элементы[ТекКоманда].Пометка = Истина;	
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьМасштабГанта(Диаграмма, Регулятор, ТекКоманда = Неопределено)
	
	Если Регулятор <= 0 Тогда      
		Возврат;
	КонецЕсли; 
	
	Диаграмма.ПоддержкаМасштаба = ПоддержкаМасштабаДиаграммыГанта.Период;
	Диаграмма.КратностьПериодическогоВарианта = Регулятор; 		
	
	Если ЗначениеЗаполнено(ТекКоманда) Тогда      
		Элементы[ТекКоманда].Пометка = Ложь;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры(имяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	
	АдресХранилища = "";
	
	Если имяКоманды = "ДействиеПодобрать_Предусловия_ПроектныеЗадачи" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПредусловияЗадачи;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Документы.упоПроектнаяЗадача";
		ТаблицаФормы = Объект.ПредусловияЗадачи;
		ИмяКолонки = "ЗадачаПредшественник";		
		
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок.Добавить("КодСДР", НСтр("ru = 'Код СДР'")); 
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок.Добавить("НазваниеПроектнойЗадачи", НСтр("ru = 'Название задачи'")); 	
		
	ИначеЕсли имяКоманды = "ДействиеПодобрать_Ресурсы_РолиТР" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ТрудовыеРесурсы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоРоли";
		ТаблицаФормы = Объект.ТрудовыеРесурсы;
		ИмяКолонки = "Ресурс";			
		
	ИначеЕсли имяКоманды = "ДействиеПодобрать_Ресурсы_МатериалыИОборудование" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.МатериальныеРесурсы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.Номенклатура";		
		ТаблицаФормы = Объект.МатериальныеРесурсы;
		ИмяКолонки = "Ресурс";
		
	ИначеЕсли имяКоманды = "ДействиеПодобрать_Субпродукты_ПланВыпуска" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.Субпродукты;
		Если Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
			ИмяОбъектаВМетаданных =  "Справочники.упоПроектнаяПродукция";
			ПараметрыПодбора.ДопПараметры.Вставить("УстановитьПользовательскиеНастройки", Истина);
		Иначе
			ИмяОбъектаВМетаданных =  "Справочники.Номенклатура";
		КонецЕсли;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = ИмяОбъектаВМетаданных;
		ТаблицаФормы = Объект.Субпродукты;
		ИмяКолонки = "Ресурс";
		
	ИначеЕсли имяКоманды = "ДействиеПодобрать_ПланДоходов_ПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланДоходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоСтатьиДоходов";
		ТаблицаФормы = Объект.ПланДоходов;
		ИмяКолонки = "Статья";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ПланДоходов_ПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланДоходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.Контрагенты";
		ТаблицаФормы = Объект.ПланДоходов;
		ИмяКолонки = "Контрагент";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ПланРасходов_ПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланРасходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоСтатьиЗатрат";
		ТаблицаФормы = Объект.ПланРасходов;
		ИмяКолонки = "Статья";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ПланРасходов_ПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланРасходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.Контрагенты";
		ТаблицаФормы = Объект.ПланРасходов;
		ИмяКолонки = "Контрагент";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ДДС_ПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ДвиженияДенежныхСредств;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.СтатьиДвиженияДенежныхСредств";
		ТаблицаФормы = Объект.ДвиженияДенежныхСредств;
		ИмяКолонки = "СтатьяДДС";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ДДС_ПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ДвиженияДенежныхСредств;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.Контрагенты";
		ТаблицаФормы = Объект.ДвиженияДенежныхСредств;
		ИмяКолонки = "Контрагент";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ДопРесурсы" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ДополнительныеЗатраты;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоСтатьиЗатрат";
		ТаблицаФормы = Объект.ДополнительныеЗатраты;
		ИмяКолонки = "СтатьяЗатрат";
		
	КонецЕсли;
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы,  ИмяКолонки,
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
	
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
	ПараметрыПодбора.ДопПараметры.ДеревоОтбор = СтруктураДоп.АдресХранилищаДеревоОтбора;
	
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Функция ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы,  ИмяКолонки, СписокВидимыхКолонок)
	
	Отбор = Новый Структура;
	СтруктураДоп  = Новый Структура;
	
	СтруктураДоп.Вставить("АдресХранилищаВыбранных");
	СтруктураДоп.Вставить("АдресХранилищаОтбора");
	СтруктураДоп.Вставить("АдресХранилищаДеревоОтбора");

	Если имяКоманды = "ДействиеПодобрать_Предусловия_ПроектныеЗадачи" Тогда
		
		СтруктураДоп.АдресХранилищаОтбора = ПодготовитьТаблицуОтбораПодбора(имяКоманды);
		Отбор.Вставить("СвязьМеждуПроектами", Ложь);
		
	ИначеЕсли имяКоманды = "ДействиеПодобрать_Ресурсы_РолиТР" Тогда
		
		Отбор.Вставить("УровеньПланирования", ПолучитьТекущийУровеньПланированияТР(ЭтаФорма));
		
	ИначеЕсли имяКоманды = "ДействиеПодобрать_Субпродукты_ПланВыпуска"
				И Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
		
		СтруктураДоп.АдресХранилищаДеревоОтбора = ПодготовитьДеревоОтбораПодбора(имяКоманды);
		
	КонецЕсли;
	
	АдресХранилища  = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(ЭтаФорма.УникальныйИдентификатор,
		ТаблицаФормы, ИмяКолонки, СписокВидимыхКолонок, Отбор);
	СтруктураДоп.АдресХранилищаВыбранных = АдресХранилища;
	
	Возврат СтруктураДоп;
	
КонецФункции

&НаСервере
Функция ПодготовитьТаблицуОтбораПодбора(имяКоманды)
	
	Перем ТаблицаОтбора;
	
	упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуОтбора(ТаблицаОтбора);	  
	
	Если имяКоманды ="ДействиеПодобрать_Предусловия_ПроектныеЗадачи" Тогда
		
		НоваяСтрока =  ТаблицаОтбора.Добавить();
		
		НоваяСтрока.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
		НоваяСтрока.ВидСравнения  = ВидСравненияКомпоновкиДанных.ВСписке;
		НоваяСтрока.Применение =  ТипПримененияОтбораКомпоновкиДанных.Элементы;
		НоваяСтрока.Использование  = Истина;
		НоваяСтрока.РежимОтображения =  РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
		
		СписокЗадач = упоПроектыИЗадачиСервер.СписокЗадачПроектаИсключаяТекущую(Объект.Проект, Объект.Ссылка);
		
		НоваяСтрока.ПравоеЗначение = СписокЗадач;
				
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОтбора, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПодготовитьДеревоОтбораПодбора(имяКоманды)
	
	ДеревоОтбора = упоПодборВТабличнуюЧастьСервер.НовоеДеревоОтбора();	  
	
	Если имяКоманды = "ДействиеПодобрать_Субпродукты_ПланВыпуска"
				И Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
				
		ОтборПометкаУдаления = ДеревоОтбора.Строки.Добавить();
		ОтборПометкаУдаления.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
		ОтборПометкаУдаления.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборПометкаУдаления.Использование  = Истина;
		ОтборПометкаУдаления.ПравоеЗначение = Ложь;
		ОтборПометкаУдаления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		ОтборГруппаИЛИ = ДеревоОтбора.Строки.Добавить();
		ОтборГруппаИЛИ.Использование = Истина;
		ОтборГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		НоваяСтрокаШаблон = ОтборГруппаИЛИ.Строки.Добавить();
		НоваяСтрокаШаблон.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Шаблон");
		НоваяСтрокаШаблон.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НоваяСтрокаШаблон.Использование = Истина;
		НоваяСтрокаШаблон.ПравоеЗначение = Истина;
		НоваяСтрокаШаблон.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		НоваяСтрокаШаблон.ИмяПоля = "Шаблон";
		
		Если ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
			НоваяСтрокаПЗ = ОтборГруппаИЛИ.Строки.Добавить();
			НоваяСтрокаПЗ.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ПроектнаяЗадача");
			НоваяСтрокаПЗ.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
			НоваяСтрокаПЗ.Использование  = Истина;
			НоваяСтрокаПЗ.ПравоеЗначение = Объект.ПроектнаяЗадача;
			НоваяСтрокаПЗ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
			НоваяСтрокаПЗ.ИмяПоля = "ПроектнаяЗадача";
		КонецЕсли;

		ОтборГруппаИ = ОтборГруппаИЛИ.Строки.Добавить();
		ОтборГруппаИ.Использование = Истина;
		ОтборГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;

		НоваяСтрокаПроект = ОтборГруппаИ.Строки.Добавить();
		НоваяСтрокаПроект.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Проект");
		НоваяСтрокаПроект.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		НоваяСтрокаПроект.Использование  = Истина;
		НоваяСтрокаПроект.ПравоеЗначение = Объект.Проект;
		НоваяСтрокаПроект.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		НоваяСтрокаПроект.ИмяПоля = "Проект";
		
		НоваяСтрокаПустаяПЗ = ОтборГруппаИ.Строки.Добавить();
		НоваяСтрокаПустаяПЗ.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ПроектнаяЗадача");
		НоваяСтрокаПустаяПЗ.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		НоваяСтрокаПустаяПЗ.Использование  = Истина;
		НоваяСтрокаПустаяПЗ.ПравоеЗначение = Документы.упоПроектнаяЗадача.ПустаяСсылка();
		НоваяСтрокаПустаяПЗ.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ДеревоОтбора, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

