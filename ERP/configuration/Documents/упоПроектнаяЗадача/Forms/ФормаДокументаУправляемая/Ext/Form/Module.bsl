Процедура ДополнительныеЗатратыПриАктивизацииСтроки(Элемент)
	
	//УстановитьТолькоПросмотрВалюте("ПланРасходов");
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ДополнительныеЗатраты",
		"РаспределениеДополнительныхЗатрат", "Стоимость");	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеДополнительныхЗатрат", 
		"ДополнительныеЗатраты", "ИндексСтрокиРаспределенияПоРолям", Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеЗатратыСтатьяЗатратПриИзменении(Элемент)		
	
	Если Объект.ВключитьДопЗатратыВПланРасходов Тогда							
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("ПрофильРаспределенияДоходовРасходов", "ПрофильРаспределенияРасходовЗатраты");
		Реквизиты.Вставить("КонтрагентДоходовРасходов", "КонтрагентРасходовЗатраты");
		Реквизиты.Вставить("ДоговорДоходовРасходов", "ДоговорРасходовЗатраты");
		
		ИменаКолонокОтражения = СтруктураИменКолонокОтражения();
		ИменаКолонокОтражения.СпособПривязки = "СпособПривязкиДоходовРасходов";	
		ИменаКолонокОтражения.Контрагент = "КонтрагентДоходовРасходов";	
		ИменаКолонокОтражения.Договор = "ДоговорДоходовРасходов";			
		
		ЗаполнитьНастройкиОтраженияСтатьиВБДР(Элементы.ДополнительныеЗатраты.ТекущиеДанные, ИменаКолонокОтражения, Реквизиты);
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаспределениеДоходов

&НаКлиенте
Процедура РаспределениеДоходовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если упоРаботаСФормамиКлиент.ЭтоПеренесеннаяСтрокаПодчиненнойТаблицы(Объект, Элемент.ТекущиеДанные, "ПланДоходов") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияПередНачаломДобавления(Элементы.ПланДоходов, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовПередУдалением(Элемент, Отказ)
	
	Если упоРаботаСФормамиКлиент.ЭтоПеренесеннаяСтрокаПодчиненнойТаблицы(Объект, Элемент.ТекущиеДанные, "ПланДоходов") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.ОчиститьСтрокиРаспределенияПоПериодам(Объект,ЭтаФорма, "РаспределениеДоходов",
		"РаспределениеДоходовПоПериодам","ИндексСтрокиРаспределенияДоходов");
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
		
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланДоходов",
		"РаспределениеДоходов");	
	
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеДоходов", 
		"ИндексСтрокиРаспределенияДоходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ЭтаФорма.Модифицированность = ЭтаФорма.Модифицированность Или ВыбранноеЗначение.Модифицированность;
	ОбработатьВыборРаспределения(ВыбранноеЗначение, "ИндексСтрокиРаспределенияДоходов");
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовПослеУдаления(Элемент)
		
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланДоходов",
		"РаспределениеДоходов");	
	
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеДоходов", 
		"ИндексСтрокиРаспределенияДоходов", Ложь);

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовРольПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияРольПриИзменении(Элементы.РаспределениеДоходов.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовСобствСилы_СубподрядПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.РаспределениеОбъемовСубподрядСобсСилыПриИзменении(Элементы, 
																						"РаспределениеДоходов", 
																						ИспользоватьАналитикуКонтрагентДляСС);	

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовСпособПривязкиПриИзменении(Элемент)
	
	СтрокаРаспределенияСпособПривязкиПриИзменении(Элементы.РаспределениеДоходов.ТекущиеДанные, "РаспределениеДоходов",
		"РаспределениеДоходовПоПериодам","ИндексСтрокиРаспределенияДоходов");	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеДоходов","ПланДоходов", "ИндексСтрокиРаспределенияДоходов", Ложь, Ложь);
	
	СоздатьДопЭлементыРаспределенияДоходов(Ложь, Истина, Ложь, Ложь, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияПриНачалеРедактирования(Элементы.ПланДоходов,
		Элементы.РаспределениеДоходов, Объект, НоваяСтрока, Копирование);	
	Если Копирование Тогда 
		ТекущиеДанные = Элементы.РаспределениеДоходов.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ТекущиеДанные.ИндексСтрокРаспределенияПоПериодам = Неопределено;
			СтрокаРаспределенияСпособПривязкиПриИзменении(ТекущиеДанные, "РаспределениеДоходов",
				"РаспределениеДоходовПоПериодам","ИндексСтрокиРаспределенияДоходов");
		КонецЕсли;		
		
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланДоходов",
			"РаспределениеДоходов",,, Истина);
		
		упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеДоходов", 
			"ИндексСтрокиРаспределенияДоходов", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеДоходовКонтрагентПодрядчикПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПроверитьДоговор(ЭтаФорма, "РаспределениеДоходов", "КонтрагентПодрядчик", "ЗаказДоговорПодрядчика"); 
	
КонецПроцедуры

&НаКлиенте	
Процедура Подключаемый_РаспределениеДоходовПоМесяцамКоличествоПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.РаспределениеПоМесяцамКоличествоПриИзменении(ЭтаФорма, Элемент.Имя, 
		"Субпродукты", "РаспределениеОбъемов", Объект.РаспределениеОбъемов);
		
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, 
		"РаспределениеОбъемов", "Субпродукты", "ИндексСтрокиРаспределениеПоРолям", Истина, Ложь);
																	
КонецПроцедуры

&НаКлиенте	
Процедура Подключаемый_РаспределениеДоходовПоМесяцамСуммаПриИзменении(Элемент)
						
 	упоАналитикаПоПодразделениямКлиент.РаспределениеПоМесяцамСуммаПриИзменении(ЭтаФорма, Элемент.Имя, 
		"Субпродукты", "РаспределениеОбъемов", Объект.РаспределениеОбъемов);
		
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, 
		"РаспределениеОбъемов", "Субпродукты", "ИндексСтрокиРаспределениеПоРолям", Истина, Ложь);
		
КонецПроцедуры	

&НаКлиенте	
Процедура Подключаемый_РаспределениеРасходовПоМесяцамСуммаПриИзменении(Элемент)
			
	упоАналитикаПоПодразделениямКлиент.РаспределениеПоМесяцамСуммаПриИзменении(ЭтаФорма, Элемент.Имя, 
		"МатериальныеРесурсы", "РаспределениеПотребностей", Объект.РаспределениеПотребностей);
		
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, 
		"РаспределениеПотребностей", "МатериальныеРесурсы", "ИндексСтрокиРаспределениеПоРолям", Истина, Ложь);

КонецПроцедуры

&НаКлиенте	
Процедура Подключаемый_РаспределениеРасходовПоМесяцамКоличествоПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.РаспределениеПоМесяцамКоличествоПриИзменении(ЭтаФорма, Элемент.Имя, 
		"МатериальныеРесурсы", "РаспределениеПотребностей", Объект.РаспределениеПотребностей);
	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, 
		"РаспределениеПотребностей", "МатериальныеРесурсы", "ИндексСтрокиРаспределениеПоРолям", Истина, Ложь);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаспределениеОбъемов

&НаКлиенте
Процедура РаспределениеОбъемовПриАктивизацииСтроки(Элемент)
	
	УстановитьДоступностьКнопокАктуализацияОбъемов();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ПроверитьВозможностьДобавленияДанныхРаспределенияПроектнойПродукции(Отказ);
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияПередНачаломДобавления(Элементы.Субпродукты, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовПередУдалением(Элемент, Отказ)
	
	ПроверитьВозможностьДобавленияДанныхРаспределенияПроектнойПродукции(Отказ);
	
	упоАналитикаПоПодразделениямКлиент.ОчиститьСтрокиРаспределенияПоПериодам(Объект, ЭтаФорма, "РаспределениеОбъемов",
		"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределениеПоРолям");
		
	упоРаботаСФормамиКлиент.УдалитьДанныеТекущейСтрокиИзСвязаннойПодчиненнойТаблицы(Объект, ЭтаФорма, 
		"РаспределениеОбъемов", "ПланДоходов", "РаспределениеДоходов",
		ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияПриНачалеРедактирования(Элементы.Субпродукты,
		Элементы.РаспределениеОбъемов, Объект,НоваяСтрока, Копирование);
	
	Если Копирование Тогда
		ТекущиеДанные = Элементы.РаспределениеОбъемов.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ТекущиеДанные.ИндексСтрокРаспределенияПоПериодам = Неопределено;
			СтрокаРаспределенияСпособПривязкиПриИзменении(ТекущиеДанные, "РаспределениеОбъемов",
				"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределениеПоРолям");
		КонецЕсли;
		
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
			"РаспределениеОбъемов", "Стоимость", Истина, Истина);
		
		упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеОбъемов");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
				
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
		"РаспределениеОбъемов", "ОбщСтоимость", Истина);	
	
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеОбъемов");
	
	упоРаботаСФормамиКлиент.УдалитьДанныеТекущейСтрокиИзСвязаннойПодчиненнойТаблицы(Объект, ЭтаФорма, 
		"РаспределениеОбъемов", "ПланДоходов", "РаспределениеДоходов",
		ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС);
	Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
		упоРаботаСФормамиКлиент.ЗаполнитьСвязаннуюПодчиненнуюТаблицу(Объект, ЭтаФорма, 
			"РаспределениеОбъемов", "ПланДоходов", "РаспределениеДоходов",
			ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ЭтаФорма.Модифицированность = ЭтаФорма.Модифицированность Или ВыбранноеЗначение.Модифицированность;
	ОбработатьВыборРаспределения(ВыбранноеЗначение, "ИндексСтрокиРаспределениеПоРолям");
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовПослеУдаления(Элемент)
				
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
		"РаспределениеОбъемов", "ОбщСтоимость", Истина);	
	
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеОбъемов");
	Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
		упоРаботаСФормамиКлиент.ЗаполнитьСвязаннуюПодчиненнуюТаблицу(Объект, ЭтаФорма, 
			"РаспределениеОбъемов", "ПланДоходов", "РаспределениеДоходов",
			ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС);
	КонецЕсли;
	
	Если Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
		ПересчитатьИтогиКолонокПП();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовРольПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияРольПриИзменении(Элементы.РаспределениеОбъемов.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовСобствСилы_СубподрядПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.РаспределениеОбъемовСубподрядСобсСилыПриИзменении(Элементы, 
																						"РаспределениеОбъемов", 
																						ИспользоватьАналитикуКонтрагентДляСС);

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовКоличествоПриИзменении(Элемент)
		
	упоАналитикаПоПодразделениямКлиент.ПересчитатьСуммуПоКоличеству(ЭтотОбъект, 
																	"Субпродукты", 
																	"РаспределениеОбъемов");
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовСпособПривязкиПриИзменении(Элемент)
	
	СтрокаРаспределенияСпособПривязкиПриИзменении(Элементы.РаспределениеОбъемов.ТекущиеДанные, "РаспределениеОбъемов",
		"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределениеПоРолям");	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеОбъемов", "Субпродукты", "ИндексСтрокиРаспределениеПоРолям", Истина, Ложь);	
	Если Элементы.РаспределениеОбъемов.ТекущиеДанные <> Неопределено 
		И Элементы.РаспределениеОбъемов.ТекущиеДанные.СпособПривязки = 
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
		
		СоздатьДопЭлементыРаспределенияДоходов(Истина, Ложь, Ложь, Ложь, Ложь, Ложь);
		
	КонецЕсли;
	
	УстановитьДоступностьКнопокАктуализацияОбъемов();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовКонтрагентПодрядчикПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПроверитьДоговор(ЭтаФорма, "РаспределениеОбъемов", "КонтрагентПодрядчик", "ЗаказДоговорПодрядчика"); 

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Если Элемент.ТекущийЭлемент = Неопределено Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	ПереносИзОстатка = Элемент.ТекущийЭлемент.Имя = "РаспределениеОбъемовСуммаОстаток" ИЛИ Элемент.ТекущийЭлемент.Имя = "РаспределениеОбъемовКоличествоОстаток";
	ПереносИзКолонокПериодов = Найти(Элемент.ТекущийЭлемент.Имя, "_РаспределениеОбъемов_") <> 0;
	Если Найти(Элемент.ТекущийЭлемент.Имя, "_РаспределениеОбъемов_") = 0 И НЕ Элемент.ТекущийЭлемент.Имя = "РаспределениеОбъемовСуммаОстаток" И НЕ Элемент.ТекущийЭлемент.Имя = "РаспределениеОбъемовКоличествоОстаток" Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	ПараметрыПеретаскивания.Значение = Новый Структура("УИДСтроки, ИмяПоляОткуда", ПараметрыПеретаскивания.Значение, Элемент.ТекущийЭлемент.Имя);
КонецПроцедуры                                                                                                       

&НаКлиенте
Процедура РаспределениеОбъемовПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	
	Если Строка = Неопределено ИЛИ Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыПеретаскивания.Значение.УИДСтроки <> Строка Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоляКуда = Поле.Имя; 
	ИмяПоляОткуда = ПараметрыПеретаскивания.Значение.ИмяПоляОткуда; 
	
	СтрокаДанные = Объект.РаспределениеОбъемов.НайтиПоИдентификатору(Строка);
	
	ПереносИзОстатка = ИмяПоляОткуда = "РаспределениеОбъемовСуммаОстаток" ИЛИ ИмяПоляОткуда = "РаспределениеОбъемовКоличествоОстаток";
	ПереносИзФакта = Найти(ИмяПоляОткуда, "Факт_РаспределениеОбъемов") <> 0;
	ПереносИзПлана = НЕ ПереносИзОстатка И НЕ ПереносИзФакта;
	
	Если ПереносИзОстатка Тогда		
		ИмяПоляСуммаОткуда = "СуммаОстаток";
		ИмяПоляКоличествоОткуда = "КоличествоОстаток";
	ИначеЕсли ПереносИзФакта Тогда 
		ДопИмяКолонки = Сред(ИмяПоляОткуда, Найти(ИмяПоляОткуда, "Факт_РаспределениеОбъемов"));		
		ИмяПоляСуммаОткуда = "Сумма" + ДопИмяКолонки;
		ИмяПоляКоличествоОткуда = "Количество" + ДопИмяКолонки;
	ИначеЕсли ПереносИзПлана Тогда
		ДопИмяКолонки = Сред(ИмяПоляОткуда, Найти(ИмяПоляОткуда, "_РаспределениеОбъемов"));	
		ИмяПоляСуммаОткуда = "Сумма" + ДопИмяКолонки;
		ИмяПоляКоличествоОткуда = "Количество" + ДопИмяКолонки;
	Иначе
		Возврат;
	КонецЕсли;	
	
	ДопИмяКолонкиКуда = Сред(ИмяПоляКуда, Найти(ИмяПоляКуда, "_РаспределениеОбъемов"));
	ИмяПоляСуммаКуда = "Сумма" + ДопИмяКолонкиКуда;
	ИмяПоляКоличествоКуда = "Количество" + ДопИмяКолонкиКуда;
	
	//
	
	СуммаОткуда = СтрокаДанные[ИмяПоляСуммаОткуда];
	КоличествоОткуда = СтрокаДанные[ИмяПоляКоличествоОткуда];
	
	//
	
	ОчищаемИсточник = НЕ ПереносИзФакта;
	Заменяем = ПереносИзФакта;
	
	//
	
	Если ОчищаемИсточник Тогда
		СтрокаДанные[ИмяПоляСуммаОткуда] = 0;
		СтрокаДанные[ИмяПоляКоличествоОткуда] = 0;			
	КонецЕсли;
	
	Если Заменяем Тогда
		СтрокаДанные[ИмяПоляСуммаКуда] = 0;
		СтрокаДанные[ИмяПоляКоличествоКуда] = 0;
	КонецЕсли;
	
	СтрокаДанные[ИмяПоляСуммаКуда] = СтрокаДанные[ИмяПоляСуммаКуда] + СуммаОткуда;
	СтрокаДанные[ИмяПоляКоличествоКуда] = СтрокаДанные[ИмяПоляКоличествоКуда] + КоличествоОткуда;
		
	//
	 	
	РаспределениеОбъемовПриОкончанииРедактирования(Элементы.РаспределениеОбъемов, Ложь, Ложь);
	
КонецПроцедуры                                                               

&НаКлиенте                 
Процедура РаспределениеОбъемовПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовНормированиеПриИзменении(Элемент)

	ТекущиеДанныеВладельца = Элементы.Субпродукты.ТекущиеДанные;
	Если ТекущиеДанныеВладельца = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Нормирование");
	ТекущиеДанныеВладельца.Нормирование = ИтогРаспределенияПП_Нормирование;
	
	Для Каждого СтрокаРоли Из Объект.РаспределениеОбъемов Цикл
		Если СтрокаРоли.ИндексСтрокиВладельца <> ТекущиеДанныеВладельца.ИндексСтрокРаспределения Тогда
			Продолжить;
		КонецЕсли; 
		
		упоПроектнаяПродукцияКлиент.ПересчитатьДанныеСтрокиРаспределенияПриИзмененииНомирования(СтрокаРоли,
			ТекущиеДанныеВладельца.Нормирование, ТекущиеДанныеВладельца.Количество);

	КонецЦикла;
		
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	
	ТекущиеДанныеВладельца.Трудоемкость = ИтогРаспределенияПП_Трудоемкость;	
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовКоэффициентСложностиПриИзменении(Элемент)

	ПриИзмененииРаспределениеОбъемовКоэффициентСложности();
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовПроцентРаспределенияПриИзменении(Элемент)

 	ПриИзмененииРаспределениеОбъемовПроцентТрудоемкости();
	
КонецПроцедуры
 
&НаКлиенте
Процедура ПриИзмененииРаспределениеОбъемовПроцентТрудоемкости()
	 
	ТекущиеДанныеРаспределения = ЭтотОбъект.Элементы["РаспределениеОбъемов"].ТекущиеДанные;
	Если ТекущиеДанныеРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеВладельца = ЭтотОбъект.Элементы["Субпродукты"].ТекущиеДанные;
	Если ТекущиеДанныеВладельца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеРаспределения.Количество = ТекущиеДанныеВладельца.Количество * (ТекущиеДанныеРаспределения.ПроцентРаспределения / 100);
	ТекущиеДанныеРаспределения.Нормирование = ТекущиеДанныеВладельца.Нормирование * (ТекущиеДанныеРаспределения.ПроцентРаспределения / 100);
	ТекущиеДанныеРаспределения.Трудоемкость = ТекущиеДанныеВладельца.Нормирование * ТекущиеДанныеРаспределения.КоэффициентСложности * (ТекущиеДанныеРаспределения.ПроцентРаспределения/100);
	ТекущиеДанныеРаспределения.Сумма = ТекущиеДанныеРаспределения.Количество * ТекущиеДанныеВладельца.Стоимость;
	
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "ПроцентРаспределения");
	Разница = 100 - ЭтотОбъект.ИтогРаспределенияПП_ПроцентРаспределения;
	
	Если Разница <> 0 Тогда
		
		ПараметрыОтбора = Новый Структура("ИндексСтрокиВладельца", ТекущиеДанныеВладельца.ИндексСтрокРаспределения); 
		ЗаписиРаспределения = ЭтотОбъект.Объект["РаспределениеОбъемов"].НайтиСтроки(ПараметрыОтбора);
		КоличествоЗаписей = ЗаписиРаспределения.Количество();
		ПоследняяСтрока = ЗаписиРаспределения[КоличествоЗаписей - 1];
		ПоследняяСтрока.ПроцентРаспределения = ПоследняяСтрока.ПроцентРаспределения + Разница;
		
		ПоследняяСтрока.Количество = ТекущиеДанныеВладельца.Количество * (ПоследняяСтрока.ПроцентРаспределения / 100);
		ПоследняяСтрока.Нормирование = ТекущиеДанныеВладельца.Нормирование * (ПоследняяСтрока.ПроцентРаспределения / 100);
		ПоследняяСтрока.Трудоемкость = ТекущиеДанныеВладельца.Нормирование * ПоследняяСтрока.КоэффициентСложности * (ПоследняяСтрока.ПроцентРаспределения/100);
		ПоследняяСтрока.Сумма = ПоследняяСтрока.Количество * ТекущиеДанныеВладельца.Стоимость;
		
	КонецЕсли; 
	
	ПересчитатьИтогиКолонокПП();
	ТекущиеДанныеВладельца.Трудоемкость = ИтогРаспределенияПП_Трудоемкость;
	ТекущиеДанныеВладельца.КоэффициентСложности = ИтогРаспределенияПП_КоэффициентСложности;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРаспределениеОбъемовКоэффициентСложности()
	
	ТекущиеДанныеРаспределения = ЭтотОбъект.Элементы["РаспределениеОбъемов"].ТекущиеДанные;
	Если ТекущиеДанныеРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеВладельца = ЭтотОбъект.Элементы["Субпродукты"].ТекущиеДанные;
	Если ТекущиеДанныеВладельца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеРаспределения.Трудоемкость = ТекущиеДанныеВладельца.Нормирование * ТекущиеДанныеРаспределения.КоэффициентСложности * (ТекущиеДанныеРаспределения.ПроцентРаспределения/100);
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	ТекущиеДанныеВладельца.Трудоемкость = ЭтотОбъект.ИтогРаспределенияПП_Трудоемкость;
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "КоэффициентСложности");
	ТекущиеДанныеВладельца.КоэффициентСложности = ЭтотОбъект.ИтогРаспределенияПП_КоэффициентСложности;
	
КонецПроцедуры //

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаспределениеРасходов

&НаКлиенте
Процедура РаспределениеРасходовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если упоРаботаСФормамиКлиент.ЭтоПеренесеннаяСтрокаПодчиненнойТаблицы(Объект, Элемент.ТекущиеДанные, "ПланРасходов") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияПередНачаломДобавления(Элементы.ПланРасходов, Отказ);
	
	Если НЕ Отказ Тогда
		ТекущиеДанныеРодитель = Элементы.ПланРасходов.ТекущиеДанные;
		Если ТекущиеДанныеРодитель.ИсточникПлана = 
			ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты") Тогда
			Отказ = Истина; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияПриНачалеРедактирования(Элементы.ПланРасходов,
		Элементы.РаспределениеРасходов, Объект, НоваяСтрока, Копирование);		
	
	Если Копирование Тогда
		ТекущиеДанные = Элементы.РаспределениеРасходов.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		ТекущиеДанные.ИндексСтрокРаспределенияПоПериодам = Неопределено;
		СтрокаРаспределенияСпособПривязкиПриИзменении(ТекущиеДанные, "РаспределениеРасходов",
			"РаспределениеРасходовПоПериодам", "ИндексСтрокиРаспределенияРасходов");
		
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланРасходов",
			"РаспределениеРасходов",,, Истина);
		
		упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеРасходов", 
			"ИндексСтрокиРаспределенияРасходов", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
		
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланРасходов",
		"РаспределениеРасходов");		
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеРасходов", 
		"ИндексСтрокиРаспределенияРасходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовПослеУдаления(Элемент)
		
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланРасходов", 
		"РаспределениеРасходов");
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, ЭтаФорма, "РаспределениеРасходов", 
		"ИндексСтрокиРаспределенияРасходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовРольПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияРольПриИзменении(Элементы.РаспределениеРасходов.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовСобствСилы_СубподрядПриИзменении(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.РаспределениеОбъемовСубподрядСобсСилыПриИзменении(Элементы, 
																						"РаспределениеРасходов");		
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеРасходовСпособПривязкиПриИзменении(Элемент)
	
	СтрокаРаспределенияСпособПривязкиПриИзменении(Элементы.РаспределениеРасходов.ТекущиеДанные, "РаспределениеРасходов",
		"РаспределениеРасходовПоПериодам", "ИндексСтрокиРаспределенияРасходов");	
	
	СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Ложь, Истина, Ложь, Ложь);
	
