&НаКлиенте
Процедура УстановитьПараметрыВыбораПодразделенияРоли(ТекущийРесурс, ТекущийЭлементТабл)
	
	НовыйМассив = Новый Массив;
	НовыйМассив.Добавить(Новый ПараметрВыбора("РесурсПодразделения", ТекущийРесурс));
	НовыйМассив.Добавить(Новый ПараметрВыбора("ДатаАктуальности", Объект.ДатаНачалаПлан));
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
