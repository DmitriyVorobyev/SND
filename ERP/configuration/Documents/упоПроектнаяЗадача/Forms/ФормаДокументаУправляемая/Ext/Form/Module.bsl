&НаКлиенте
Процедура ТрудовыеРесурсыРесурсОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
		
	// Скорее всего, имеет смысл отказаться от этого обработчика и перенести код в обработчик ПриИзменении,
	// пока же программно актуализирую Ресурс в строке, чтобы все расчет проводились на выбранном значении
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ТекущаяСтрока.Ресурс = ВыбранноеЗначение;
	КонецЕсли;

	ПоляИсключенияЗаполнения = Новый Массив();
	Если ЗначениеЗаполнено(ТекущаяСтрока.Количество) Тогда
		ПоляИсключенияЗаполнения.Добавить("Количество");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ЕдиницаНормирования) Тогда
		ПоляИсключенияЗаполнения.Добавить("ЕдиницаНормирования");
	КонецЕсли;
	ПараметрыПодбораСтруктура = Новый Структура("ПоляИсключенияЗаполнения", СтрСоединить(ПоляИсключенияЗаполнения, ", ")); 		
	
	ИмяТабличнойЧасти = "ТрудовыеРесурсы";
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
		ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
	
	ВыполнитьДействияПриПодборе(ТекущаяСтрока, ПараметрыПодбораСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыРесурсПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	Если СтрокаТабличнойЧасти <> Неопределено Тогда
		
		СтруктураСтрокиТабличнойЧасти = Неопределено;
		ЗаполнитьСтруктуруСтрокиТЧТрудовыеРесурсы(СтруктураСтрокиТабличнойЧасти);
		
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиТабличнойЧасти, СтрокаТабличнойЧасти);
		
		ТрудовыеРесурсыРесурсПриИзмененииНаСервере(СтруктураСтрокиТабличнойЧасти);
				
		ПоляИсключенияЗаполнения = "Количество, ОбщСтоимость, ОбщВнешняяСтоимость";
		Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ЕдиницаНормирования) Тогда
			ПоляИсключенияЗаполнения = ПоляИсключенияЗаполнения + ", ЕдиницаНормирования";	
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураСтрокиТабличнойЧасти, ,
			ПоляИсключенияЗаполнения);
		
		ЕдиницаНормированияДо = СтруктураСтрокиТабличнойЧасти.ЕдиницаНормирования;
		
	КонецЕсли;
		
	ИмяТаблицы = "ТрудовыеРесурсы";			
	ПараметрыОтбора = Новый Структура("УровеньПланирования, Ресурс, ИсточникПлана");
		
	упоРаботаСФормамиКлиент.ПроверитьСтрокуНаДублирование(ЭтаФорма, ПараметрыОтбора, ИмяТаблицы, Элемент.Имя);
	
	Если Объект.ВключитьТрудРесурсыВПланРасходов Тогда
		ПроверитьДостаточностьДанныхТрансляции();																
	КонецЕсли;
	
КонецПроцедуры

