&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено)
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено)
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3,
		П4, П5, П5, П6);
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура ЗаполнитьОткудаСкопирована()
	
	МассивДляПолученияСтроки = Новый Массив;
	МассивДляПолученияСтроки.Добавить(НСтр("ru = 'Скопирована в сводный проект из задачи '"));
	НазваниеСкопированнойПроектнойЗадачи = упоПроектыИЗадачиСервер.НазваниеПроектнойЗадачи(Объект.СкопированаВСводныйИзЗадачи);
	НавигационнаяСсылкаНаСкопированнуюПЗ = ПолучитьНавигационнуюСсылку(Объект.СкопированаВСводныйИзЗадачи);
	ПредставлениеСкопированнойПЗ = Новый ФорматированнаяСтрока(НазваниеСкопированнойПроектнойЗадачи,,,,
																НавигационнаяСсылкаНаСкопированнуюПЗ);
	МассивДляПолученияСтроки.Добавить(ПредставлениеСкопированнойПЗ);
	
	МассивДляПолученияСтроки.Добавить(НСтр("ru = ' проекта '"));
	ПроектСкопированнойПЗ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СкопированаВСводныйИзЗадачи, "Проект");
	НавигационнаяСсылкаНаПроектИзСкопированнойПЗ = ПолучитьНавигационнуюСсылку(ПроектСкопированнойПЗ);
	ПредставлениеПроекта = Новый ФорматированнаяСтрока(Строка(ПроектСкопированнойПЗ),,,, 
														НавигационнаяСсылкаНаПроектИзСкопированнойПЗ);
	МассивДляПолученияСтроки.Добавить(ПредставлениеПроекта);	
	
	ОткудаСкопирована = Новый ФорматированнаяСтрока(МассивДляПолученияСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполненностьСсылкиОбъекта(ВидДокумента, ДопПараметры = Неопределено) Экспорт
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВидДокумента", ВидДокумента);
	
	Если ДопПараметры <> Неопределено И ДопПараметры.Свойство("ИмяКоманды") Тогда
		СтруктураПараметров.Вставить("ИмяКоманды", ДопПараметры.ИмяКоманды);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И Не Модифицированность Тогда
		СтруктураПараметров.Вставить("ПроектнаяЗадача", Объект.Ссылка);
		ОткрытьФорму("Обработка.упоФормированиеЗаказовПроектнойЗадачи.Форма.Форма", 
			СтруктураПараметров, 
			ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);		
		Возврат;			
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Заказы_СформироватьЗавершение", ЭтаФорма, СтруктураПараметров);			
	ТекстВопроса = ПолучитьТекстСообщенияОНеобходимостиПроведенияДокумента();
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);		
	
КонецПроцедуры

&НаКлиенте
Процедура Заказы_СформироватьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("РежимЗаписи", РежимЗаписиДокумента.Проведение);
	ПараметрыЗаписи.Вставить("ОткрытьФормированиеЗаказов", ДополнительныеПараметры.ВидДокумента);
	Успешно = Записать(ПараметрыЗаписи);
	
	Если Успешно Тогда
		ПроверитьЗаполненностьСсылкиОбъекта(ДополнительныеПараметры.ВидДокумента, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗакэшироватьДопРеквизитыПредусловияЗадачиПередЗаписью(ТекущийОбъект)

	КэшДопРеквизитыПредусловияЗадачи = Новый Соответствие;
    
    Для Каждого СтрокаЗадачи Из Объект.ПредусловияЗадачи Цикл
        СтруктураСвойст = Новый Структура("
        |НазваниеЗадачаПредшественник,
        |КодСДР,
        |ДатаПредусловия,
        |Проект,
        |ПроектПредставление");
                             
        Если ЗначениеЗаполнено(СтрокаЗадачи.ЗадачаПредшественник) Тогда
            ЗаполнитьЗначенияСвойств(СтруктураСвойст, СтрокаЗадачи); 
			КэшДопРеквизитыПредусловияЗадачи.Вставить(СтрокаЗадачи.ЗадачаПредшественник, СтруктураСвойст);		
		КонецЕсли;	
    КонецЦикла;
    
	Если КэшДопРеквизитыПредусловияЗадачи.Количество() > 0 Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ДопРеквизитыПредусловияЗадачи", КэшДопРеквизитыПредусловияЗадачи);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ПеречитатьКэшДопРеквизитыПредусловияЗадачиПослеЗаписи(ТекущийОбъект)

	КэшДопРеквизитыПредусловияЗадачи = Неопределено;
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("ДопРеквизитыПредусловияЗадачи", КэшДопРеквизитыПредусловияЗадачи) Тогда
		Для Каждого СтрокаЗадачи Из Объект.ПредусловияЗадачи Цикл
			ДопРеквизиты = КэшДопРеквизитыПредусловияЗадачи.Получить(СтрокаЗадачи.ЗадачаПредшественник);
            Если ДопРеквизиты <> Неопределено Тогда
                ЗаполнитьЗначенияСвойств(СтрокаЗадачи, ДопРеквизиты);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	 	

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита, ВыбиратьРазрешенные = Ложь)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита, ВыбиратьРазрешенные);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьДостаточностьДанныхТрансляцииНаСервере(	Знач КонтейнерТаблица,
															Знач УровеньПланированияТрудозатратДляБДР)
															
	ИменаКолонок = "Ресурс, Подразделение, УровеньПланирования, Количество";
	ТаблицаТрудовыеРесурсы = КонтейнерТаблица.Выгрузить(, ИменаКолонок);
	Возврат Документы.упоПроектнаяЗадача.СформироватьСообщениеОНедостаткеДанныхТрансляции(ТаблицаТрудовыеРесурсы,
																			УровеньПланированияТрудозатратДляБДР);
КонецФункции

&НаКлиенте
Процедура ПроверитьДостаточностьДанныхТрансляции()
	
	ТекстСообщения = ПроверитьДостаточностьДанныхТрансляцииНаСервере(Объект.ТрудовыеРесурсы, 
		Объект.УровеньПланированияТрудозатратДляБДР);
		
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьПоРолям(ДопПараметры)
    
    ТекущиеДанныеСтрокиРаспределения = Элементы.Субпродукты.ТекущиеДанные;
    
    Если ТекущиеДанныеСтрокиРаспределения = Неопределено Тогда
        ТекстСообщения = НСтр("ru = 'Не выбрана строка для распределения в табличной части ""Субпродукты"".'");
        ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
        Возврат;
    КонецЕсли;
    
    Если ТекущиеДанныеСтрокиРаспределения.ИндексСтрокРаспределения = Неопределено Тогда
        упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект,
            ТекущиеДанныеСтрокиРаспределения, "Субпродукты");    
    КонецЕсли;
    
    ДанныеСтрокиРаспределения = Новый Структура("СпособПривязки, ИндексСтрокРаспределения, ОбщСтоимость, Количество");
    ЗаполнитьЗначенияСвойств(ДанныеСтрокиРаспределения, ТекущиеДанныеСтрокиРаспределения);
    
    ДопПараметры.Вставить("ДанныеСтрокиРаспределения", ДанныеСтрокиРаспределения);
            
    Отбор = Новый Структура("ИндексСтрокиВладельца", 
        ТекущиеДанныеСтрокиРаспределения.ИндексСтрокРаспределения);
    НайденныеСтроки = Объект.РаспределениеОбъемов.НайтиСтроки(Отбор);

    Если НайденныеСтроки.Количество() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("РаспределениеОбъемовЗаполнитьПоРолямЗавершение", ЭтотОбъект, ДопПараметры);		
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Табличная часть ""Распределение объемов"" уже содержит данные. Очистить?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);		
	Иначе		
		РаспределениеОбъемовЗаполнитьПоРолямЗавершение("БезОтвета", ДопПараметры);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогиПоТаблицам()
	
	РассчитатьИтогиПоТаблице("МатериальныеРесурсы");
	РассчитатьИтогиПоТаблице("Субпродукты");
	РассчитатьИтогиПоТаблице("ПланДоходов", , Ложь, "Сумма");
	РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
	РассчитатьИтогиПоТаблицеДвиженияДенежныхСредств();
	
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьИтогиПоТаблице(ИмяТаблицы, ЕстьКолонкиСуммы = Истина, ЕстьКолонкиКоличества = Истина, ИмяКолонкиСумма = "ОбщСтоимость")
	
	Результат = упоСтруктураПроектаКлиент.РассчитатьИтогиПоТаблице(Объект[ИмяТаблицы], ЕстьКолонкиСуммы, ЕстьКолонкиКоличества, ИмяКолонкиСумма);
	
	Если ЕстьКолонкиКоличества Тогда
		ЭтаФорма[ИмяТаблицы + "КоличествоИтог"] = Результат.Количество;
	КонецЕсли;
	Если ЕстьКолонкиСуммы Тогда
		ЭтаФорма[ИмяТаблицы + "СуммаИтог"] = Результат.Сумма
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогиПоТаблицеДвиженияДенежныхСредств()
	
	ИмяТаблицы = "ДвиженияДенежныхСредств";
	Итоги = упоСтруктураПроектаКлиент.ПолучитьСтроковоеЗначениеИтогиДДС(Объект[ИмяТаблицы], "Сумма");
	
	Элементы.ИтогиДДС.Заголовок = Итоги;
		
КонецПроцедуры

&НаСервере
Процедура ВыделитьНДССервер(СтрокаВладелец, ИмяТаблицы)

	ПараметрыРаспределения = упоДоходыИРасходыСервер.ПараметрыВыделенияНДСВРаспределенииПоУмолчанию();
	ПараметрыРаспределения.Проект 		= Объект.Проект;
	ПараметрыРаспределения.СтавкаНДС 	= упоДоходыИРасходыСервер.ЗначениеСтавкиНДС(СтрокаВладелец.Договор, Объект.Проект);
	ПараметрыРаспределения.ПериодыВТаблицеРаспределения = Ложь;	
	ПараметрыРаспределения.ПлановыеДанные 				= Истина;
	
	упоДоходыИРасходыСервер.ВыделитьНДСВРаспределении(Объект, 
														СтрокаВладелец, 
														ИмяТаблицы,
														, 
														ПараметрыРаспределения);
															
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИмяОсновнойТаблицыПоИмениКоманды(ИмяКоманды)
		
	Если ИмяКоманды = "ВыделитьНДСДоходы" 
		Или ИмяКоманды = "ЗаполнитьПоВладельцуПланДоходов"
		Или ИмяКоманды = "РаспределитьПоПериодамПланДоходов" Тогда				
		ИмяТаблицы = "ПланДоходов";							
	ИначеЕсли ИмяКоманды = "ВыделитьНДСРасходы" 
		Или ИмяКоманды = "ЗаполнитьПоВладельцуПланРасходов"
		Или ИмяКоманды = "РаспределитьПоПериодамПланРасходов" Тогда 	
		ИмяТаблицы = "ПланРасходов";	
	ИначеЕсли ИмяКоманды = "ВыделитьНДССубпродукты" 
		Или ИмяКоманды = "ЗаполнитьПоВладельцуСубпродукты"
		Или ИмяКоманды = "РаспределитьПоПериодамСубпродукты" Тогда 	
		ИмяТаблицы = "Субпродукты";	
	ИначеЕсли ИмяКоманды = "ВыделитьНДСМатериальныеРесурсы" 
		Или ИмяКоманды = "ЗаполнитьПоВладельцуПотребности"
		Или ИмяКоманды = "РаспределитьПоПериодамМатРесурсы" Тогда 	
		ИмяТаблицы = "МатериальныеРесурсы";	
	ИначеЕсли ИмяКоманды = "ЗаполнитьПоВладельцуДопЗатраты" Тогда
		ИмяТаблицы = "ДополнительныеЗатраты";
	Иначе	
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Возврат ИмяТаблицы;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы)
		
	ИмяКолонкиСумма = "Сумма";
	УчитыватьКоличество = Ложь;
	
	Если ИмяОсновнойТаблицы = "ПланДоходов" Тогда											
		ИмяТаблицыРаспределения = "РаспределениеДоходов";
		ИмяКомандыКопирования = "ЗаполнитьПоВладельцуПланДоходов";
	ИначеЕсли ИмяОсновнойТаблицы = "ПланРасходов" Тогда 					
		ИмяТаблицыРаспределения = "РаспределениеРасходов";
		ИмяКомандыКопирования = "ЗаполнитьПоВладельцуПланРасходов";
	ИначеЕсли ИмяОсновнойТаблицы = "Субпродукты" Тогда 	
		ИмяТаблицыРаспределения = "РаспределениеОбъемов";
		ИмяКомандыКопирования = "ЗаполнитьПоВладельцуСубпродукты";
		ИмяКолонкиСумма = "ОбщСтоимость";
		УчитыватьКоличество = Истина;
	ИначеЕсли ИмяОсновнойТаблицы = "МатериальныеРесурсы" Тогда 	
		ИмяТаблицыРаспределения = "РаспределениеПотребностей";
		ИмяКомандыКопирования = "ЗаполнитьПоВладельцуПотребности";
		ИмяКолонкиСумма = "ОбщСтоимость";
		УчитыватьКоличество = Истина;
	ИначеЕсли ИмяОсновнойТаблицы = "ДополнительныеЗатраты" Тогда
		ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат";
		ИмяКомандыКопирования = "ЗаполнитьПоВладельцуДопЗатраты";
		ИмяКолонкиСумма = "Стоимость";							
	Иначе
		Возврат Неопределено; // Возврат.
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ИмяТаблицыРаспределения", 	ИмяТаблицыРаспределения);
	Результат.Вставить("ИмяКолонкиСумма", 			ИмяКолонкиСумма);	
	Результат.Вставить("УчитыватьКоличество", 		УчитыватьКоличество);
	Результат.Вставить("ИмяКомандыКопирования", 	ИмяКомандыКопирования);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиПоИмениКоманды(ИмяКоманды)
		
	ИмяОсновнойТаблицы = ИмяОсновнойТаблицыПоИмениКоманды(ИмяКоманды);
	Если ИмяОсновнойТаблицы = Неопределено Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
				
	Результат = ИменаТаблицРеквизитовПоИмениОсновнойТаблицы(ИмяОсновнойТаблицы);	
	Если Результат = Неопределено Тогда
		Возврат Неопределено; // Возврат.
	КонецЕсли;
	
	Результат.Вставить("ИмяОсновнойТаблицы", 	ИмяОсновнойТаблицы);	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиТрансляции()
	
	// Удалить перенесенные строки, используемые для визуализации, перез записью
	// во избежание влияния на движения.
	упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, "ПланДоходов", "РаспределениеДоходов");
	упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, "ПланРасходов", "РаспределениеРасходов");
	
	УдалитьСтрокиОтраженияТрудозатратВБДР();
	
	УдалитьСтрокиОтраженияБДРвДДС(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеТаблиц(Отказ)
		
	ПроверитьЗаполнение_МатериальныеРесурсы(Отказ);
	ПроверитьЗаполнение_Субпродукты(Отказ);
	ПроверитьЗаполнение_ПланРасходов(Отказ);
	ПроверитьЗаполнение_ПланДоходов(Отказ);
	ПроверитьЗаполнение_ПричиныОтклонений(Отказ);
	ПроверитьЗаполнение_ДопЗатраты(Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнение_ПричиныОтклонений(Отказ)
	
	Если Не ЗначениеЗаполнено(Объект.ПричиныОтклонений) Тогда
		Возврат;
	КонецЕсли;
	
	СписокПричин = Новый Соответствие;
	Индекс = -1;
	
	Для Каждого СтрокаПричиныОтклонений Из Объект.ПричиныОтклонений Цикл
		
		Индекс = Индекс + 1;
		
		Если СтрокаПричиныОтклонений.Отмена Тогда
			Продолжить;
		КонецЕсли;
				
		ПричинаВСписке = СписокПричин.Получить(СтрокаПричиныОтклонений.Причина);
		Если ПричинаВСписке = Неопределено Тогда
			СписокПричин.Вставить(СтрокаПричиныОтклонений.Причина, Истина);
			Продолжить;
		КонецЕсли;
		
		Отказ = Истина;
		
		ТекстСообщения = нСтр("ru='В таблице ""Причины отклонений"" есть одинаковые строки. Необходимо удалить дубли.'", "ru");
		Поле = "Объект.ПричиныОтклонений[" + Индекс + "].Причина";
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , Поле);
		
	КонецЦикла;
	
КонецПроцедуры //

&НаКлиенте
Процедура ПроверитьЗаполнение_ПланДоходов(Отказ)
	
	ИмяТаблицы 			= "ПланДоходов";                                                
	ЕстьОсновнаяТаблица = Элементы.СтраницаПланДоходов.Видимость; 											
		
	Если Не ЕстьОсновнаяТаблица Тогда
		Возврат; // Возврат.
	КонецЕсли;	
		
	ЕстьТаблицаРаспределения 			= Элементы.РамкаГруппыРаспределениеПоПодразделениям.Видимость;
	ЕстьОбъемыВРаспределенииРасходов 	= Ложь;
	Если ЕстьТаблицаРаспределения Тогда
		ЕстьОбъемыВРаспределенииДоходов	= Элементы.РаспределениеДоходовГруппаОбъемыПоПодразделениям.Видимость;	                                             
	Иначе
		ЕстьОбъемыВРаспределенииДоходов = Ложь;
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект, 
						                                                ИмяТаблицы, 
																		ЕстьТаблицаРаспределения, 
																		Отказ,
																		Истина,
																		ЕстьОбъемыВРаспределенииДоходов, 
																		ЕстьОбъемыВРаспределенииРасходов);
						
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьЗаполнение_МатериальныеРесурсы(Отказ)
	
	ИмяТаблицы 			= "МатериальныеРесурсы";
	ЕстьОсновнаяТаблица = Элементы.СтраницаПотребности.Видимость;
	
	Если Не ЕстьОсновнаяТаблица Тогда
		Возврат; // Возврат.
	КонецЕсли;
	
	ЕстьТаблицаРаспределения 			= Элементы.ГруппаРаспределениеПотребностей.Видимость;
	ЕстьОбъемыВРаспределенииРасходов 	= Ложь;
	ЕстьОбъемыВРаспределенииДоходов		= Ложь;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект, 
		ИмяТаблицы, 
		ЕстьТаблицаРаспределения, 
		Отказ,
		Истина,
		ЕстьОбъемыВРаспределенииДоходов, 
		ЕстьОбъемыВРаспределенииРасходов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнение_Субпродукты(Отказ)
	
	ИмяТаблицы = "Субпродукты";
	ЕстьОсновнаяТаблица = Элементы.СтраницаПланВыпуска.Видимость;
	
	Если Не ЕстьОсновнаяТаблица Тогда
		Возврат; // Возврат.
	КонецЕсли;
	
	ЕстьТаблицаРаспределения = Элементы.ГруппаРаспределениеОбъемовПоПодразделениям.Видимость;
	ЕстьОбъемыВРаспределенииРасходов = Ложь;
	ЕстьОбъемыВРаспределенииДоходов = Ложь;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект,
		ИмяТаблицы,
		ЕстьТаблицаРаспределения,
		Отказ,
		Истина,
		ЕстьОбъемыВРаспределенииДоходов,
		ЕстьОбъемыВРаспределенииРасходов);
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() И Объект.ТранслироватьЗатратыПоСубпродуктам Тогда
		МодульПроектнаяПродукцияВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("упоПроектнаяПродукцияВызовСервера");
		МодульПроектнаяПродукцияВызовСервера.ПроверитьЗаполнениеРаспределенияПроектнойПродукцииПередТрансляцией(Объект.Субпродукты,
			Объект.РаспределениеОбъемов, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		ПредупредитьПользователяБезПравОтключитьОпцию();
	КонецЕсли;
	
КонецПроцедуры

