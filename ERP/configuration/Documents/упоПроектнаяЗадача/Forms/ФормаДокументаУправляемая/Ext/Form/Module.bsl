&НаСервере
Процедура ЗаполнитьПроектныеОпцииЗадачи()
	
	ПроектныеОпции = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	
	ЗапретитьРПЗИзменятьСрокиЧужихЗадач = ПроектныеОпции.ЗапретитьРПЗИзменятьСрокиЧужихЗадач;
	УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат = 
		ПроектныеОпции.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат;
	УказыватьПодразделениеРолиПриПланированииТР = ПроектныеОпции.УказыватьПодразделениеРолиПриПланированииТР;
	
КонецПроцедуры

&НаСервере
Процедура СменаНастроекУчетаПодразделений(ОбновитьПроектныеОпции = Ложь)
	
	Если ОбновитьПроектныеОпции Тогда
		ЗаполнитьПроектныеОпцииЗадачи();
	КонецЕсли;	
	
	упоПроектыИЗадачиОбщие.УстановитьВидимостьЭлементовФормыПроектнойЗадачи(Объект, ЭтаФорма, ЭтаФорма.ПроектныеОпции);
	ОбновитьНаименованиеКолонокТРСтоимости();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаспределениеОбъемовПоРолямСервер(ДополнительныеПараметры)
	
	Очищать = ДополнительныеПараметры.Очищать; 
	РежимЗаполнения = ДополнительныеПараметры.РежимЗаполнения;
	ДанныеСтрокиРаспределения = ДополнительныеПараметры.ДанныеСтрокиРаспределения;
	
	Если Очищать Тогда
		ОчиститьДанныеРаспределения(ДанныеСтрокиРаспределения.ИндексСтрокРаспределения, "ИндексСтрокиВладельца",
			"РаспределениеОбъемов");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ТрудовыеРесурсы) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Предварительный);
	СтрокиДляЗаполненияПредварительный = Объект.ТрудовыеРесурсы.НайтиСтроки(СтруктураОтбора);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
	СтрокиДляЗаполненияОкончательный = Объект.ТрудовыеРесурсы.НайтиСтроки(СтруктураОтбора);
	
	Если РежимЗаполнения = "ПоПредварительномуУровню" Тогда
		СтрокиДляЗаполнения = СтрокиДляЗаполненияПредварительный;
	ИначеЕсли РежимЗаполнения = "ПоОкончательномуУровню" Тогда 
		СтрокиДляЗаполнения = СтрокиДляЗаполненияОкончательный;
	ИначеЕсли РежимЗаполнения = "Автоматически" Тогда
		Если ЗначениеЗаполнено(СтрокиДляЗаполненияОкончательный) Тогда
			СтрокиДляЗаполнения = СтрокиДляЗаполненияОкончательный;
		Иначе
			СтрокиДляЗаполнения = СтрокиДляЗаполненияПредварительный;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокиДляЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	ТрудовыеРесурсы = Объект.ТрудовыеРесурсы.Выгрузить(СтрокиДляЗаполнения);
	
	ЗначенияПроектаПоУмолчанию = 
		упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Объект.Проект);
	
	Если ТрудовыеРесурсы.Итог("ОбщВнешняяСтоимость") <> 0 Тогда
		БазаРасчетаРаспределенияСуммИКоличества = ТрудовыеРесурсы.ВыгрузитьКолонку("ОбщВнешняяСтоимость");
	ИначеЕсли ТрудовыеРесурсы.Итог("ОбщСтоимость") <> 0 Тогда
		БазаРасчетаРаспределенияСуммИКоличества = ТрудовыеРесурсы.ВыгрузитьКолонку("ОбщСтоимость");
	Иначе
		БазаРасчетаРаспределенияСуммИКоличества = ТрудовыеРесурсы.ВыгрузитьКолонку("Количество");
	КонецЕсли;
	
	КоэффициентыКоличества= ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		ДанныеСтрокиРаспределения.Количество, БазаРасчетаРаспределенияСуммИКоличества, 2);
	КоэффициентыСумм = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		ДанныеСтрокиРаспределения.ОбщСтоимость, КоэффициентыКоличества, 2);
	
	Сч = 0;
	Для Каждого СтрокаРоли Из ТрудовыеРесурсы Цикл
		НоваяСтрока = Объект.РаспределениеОбъемов.Добавить();
		НоваяСтрока.ИндексСтрокиВладельца = ДанныеСтрокиРаспределения.ИндексСтрокРаспределения;
		НоваяСтрока.Роль = СтрокаРоли.Ресурс;
		НоваяСтрока.Подразделение = СтрокаРоли.Подразделение;
		НоваяСтрока.СобствСилы_Субподряд = СтрокаРоли.Ресурс.СобствСилы_Субподряд;
		НоваяСтрока.Количество = КоэффициентыКоличества[Сч];
		НоваяСтрока.Сумма = ?(КоэффициентыСумм = Неопределено, 0, КоэффициентыСумм[Сч]);
		НоваяСтрока.ПрофильРаспределения = ЗначенияПроектаПоУмолчанию.ПрофильДоходовПоУмолчанию;
		
		Если ДанныеСтрокиРаспределения.СпособПривязки = 
			Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения Тогда
			НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;
		ИначеЕсли ДанныеСтрокиРаспределения.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.НаДату Тогда
			НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.НаДату;
		КонецЕсли;
		Сч = Сч + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьКоличествоСумму()
	
	СтрокаВладелец = СтруктураСтрокиВладельцаСубпродуктыПоТекущимДанным();
	
	Если СтрокаВладелец = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СуммаОбщая 		= СтрокаВладелец.Сумма;
	КоличествоОбщее = СтрокаВладелец.Количество;
	
	ОтборСтрокРаспределения = Новый Структура("ИндексСтрокиВладельца", СтрокаВладелец.ИндексСтрокРаспределения);	
	НайденныеСтроки = Объект.РаспределениеОбъемов.НайтиСтроки(ОтборСтрокРаспределения);							
	
	КоличествоНайденных = НайденныеСтроки.Количество();
			
	// 1. Убираем НДС из строк к расчету.
	Сч = КоличествоНайденных - 1;
	ЕстьНДС = Ложь;
	
	Пока Сч >= 0 Цикл
		
		НайденнаяСтрока = НайденныеСтроки[Сч];
		
		ЭтоСтрокаНДС = НайденнаяСтрока.СобствСилы_Субподряд 
			= ПредопределенноеЗначение("Справочник.упоСобственныеСилыСубподряд.НДС");			
		Если ЭтоСтрокаНДС Тогда
			НайденнаяСтрока.Сумма = 0; // Зануляем сумму НДС, чтобы отработал расчет НДС.
			НайденныеСтроки.Удалить(Сч);
			КоличествоНайденных = КоличествоНайденных - 1;
			ЕстьНДС = Истина;
		КонецЕсли;	
		
		Сч = Сч - 1;
		
	КонецЦикла;	
	
	// 2. Распределяем сумму по строкам без НДС.
	Сч = 1;		
	РаспределенноеКолво = 0;
	РаспределеннаяСумма = 0;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
								
		Если Сч = КоличествоНайденных Тогда			
			НайденнаяСтрока.Количество 	= КоличествоОбщее - РаспределенноеКолво;
			НайденнаяСтрока.Сумма 		= СуммаОбщая - РаспределеннаяСумма;			
		Иначе			
			НайденнаяСтрока.Количество 	= КоличествоОбщее/КоличествоНайденных;
			НайденнаяСтрока.Сумма 		= СуммаОбщая/КоличествоНайденных;
			РаспределенноеКолво = РаспределенноеКолво + НайденнаяСтрока.Количество;
			РаспределеннаяСумма = РаспределеннаяСумма + НайденнаяСтрока.Сумма;			
		КонецЕсли;
		
		Сч = Сч + 1;
		
	КонецЦикла;	
	
	// 3. Выделяем НДС.
	Если ЕстьНДС Тогда
											
		ВыделитьНДССервер(СтрокаВладелец, "Субпродукты");

	КонецЕсли;				
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, ТаблицаРаспределения, ТаблицаПериоды,
	КолонкаИндекса, РаспределятьКоличество = Истина, ПроверятьИсточникПлана = Ложь, КвалификаторыЧисла = Неопределено)
	
	ПараметрыРаспределения = Новый Структура;
	
	МассивСтрок = Новый Массив;
	СписокКолонокПрограммно = Новый СписокЗначений;
	СписокКолонокИтогов = Новый СписокЗначений;
	
	Для каждого СтрокаРаспределения Из Объект[ТаблицаРаспределения] Цикл 
		
		Если СтрокаРаспределения.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.Вручную Тогда
			
			МассивСтрок.Добавить(СтрокаРаспределения);
			
		КонецЕсли;
		
	КонецЦикла;
	                     
	ТаблицаДляРаспределения = Объект[ТаблицаРаспределения].Выгрузить(МассивСтрок);	 
		
	Если ПроверятьИсточникПлана Тогда
		ИсточникПлана = упоРаботаСФормамиКлиентСервер.ИсточникПланаПоТаблице(ТаблицаРаспределения);
	КонецЕсли;
	
	МассивСтрокРаспределенияПоПериодам = Новый Массив;
	
	Для каждого СтрокаРаспределеннаяПоМесяцам Из Объект[ТаблицаПериоды] Цикл
		
		Если СтрокаРаспределеннаяПоМесяцам[КолонкаИндекса] <> Неопределено Тогда
			
			Если ПроверятьИсточникПлана И СтрокаРаспределеннаяПоМесяцам.ИсточникПлана <> ИсточникПлана Тогда
				Продолжить;
			КонецЕсли;
			МассивСтрокРаспределенияПоПериодам.Добавить(СтрокаРаспределеннаяПоМесяцам);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	СрокиЗадачи = Новый Структура;
	
	СрокиЗадачи.Вставить("ДатаНачала", Объект.ДатаНачалаПлан);
	СрокиЗадачи.Вставить("ДатаОкончания", Объект.ДатаЗавершенияПлан);
	
	ТаблицаРаспределениеПоПериодам = Объект[ТаблицаПериоды].Выгрузить(МассивСтрокРаспределенияПоПериодам);
	
	Если ТаблицаРаспределениеПоПериодам.Количество() > 0 Тогда
		
		ТаблицаРаспределениеПоПериодам.Сортировать("Период убыв");
		КрайнийСрокКонец = ТаблицаРаспределениеПоПериодам.Получить(0).Период;
		ТаблицаРаспределениеПоПериодам.Сортировать("Период возр");
		КрайнийСрокНачало = ТаблицаРаспределениеПоПериодам.Получить(0).Период;
		
		Если КрайнийСрокКонец > Объект.ДатаЗавершенияПлан Тогда
			
			СрокиЗадачи.Вставить("ДатаОкончания", КрайнийСрокКонец);
			
		КонецЕсли;
		
		ПустаяДата = Дата(1, 1, 1);
		Если (НЕ КрайнийСрокНачало = ПустаяДата И НЕ Объект.ДатаНачалаПлан = ПустаяДата И КрайнийСрокНачало < Объект.ДатаНачалаПлан)
			ИЛИ (Объект.ДатаНачалаПлан = ПустаяДата И НЕ КрайнийСрокНачало = ПустаяДата) Тогда
			
			СрокиЗадачи.Вставить("ДатаНачала", КрайнийСрокНачало);
			
		ИначеЕсли Объект.ДатаНачалаПлан = ПустаяДата И КрайнийСрокНачало = ПустаяДата Тогда
			
			СрокиЗадачи.Вставить("ДатаНачала", Объект.Дата);
			
		КонецЕсли;
		
	ИначеЕсли ТаблицаРаспределениеПоПериодам.Количество() = 0 Тогда
		
		Если Не ЗначениеЗаполнено(СрокиЗадачи.ДатаНачала) Тогда
			СрокиЗадачи.ДатаНачала = Объект.Дата;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СрокиЗадачи.ДатаОкончания) Тогда
			СрокиЗадачи.ДатаОкончания = Объект.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаРаспределения =  "РаспределениеОбъемов" И ФактВыполненияОбъемов.Количество() Тогда
		Для Каждого СтрокаФактВыполненияОбъемов Из ФактВыполненияОбъемов Цикл
			Если ЗначениеЗаполнено(СтрокаФактВыполненияОбъемов.Месяц) Тогда
				Если СтрокаФактВыполненияОбъемов.Месяц < СрокиЗадачи.ДатаНачала Тогда
					СрокиЗадачи.Вставить("ДатаНачала", СтрокаФактВыполненияОбъемов.Месяц);
				КонецЕсли;
				Если СтрокаФактВыполненияОбъемов.Месяц > СрокиЗадачи.ДатаОкончания Тогда
					СрокиЗадачи.Вставить("ДатаОкончания", СтрокаФактВыполненияОбъемов.Месяц);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	КонецМесяцаНачало = КонецМесяца(СрокиЗадачи.ДатаНачала);
	КонецМесяцаКонец = КонецМесяца(СрокиЗадачи.ДатаОкончания);
	
	СписокПериодов = Новый СписокЗначений;
	
	СчетчикПериодов = КонецМесяцаНачало;
	
	Пока СчетчикПериодов <= КонецМесяцаКонец Цикл
		
		СписокПериодов.Добавить(СчетчикПериодов);
		СчетчикПериодов = КонецМесяца(СчетчикПериодов + 1);
		
	КонецЦикла;
	
	Если ТаблицаРаспределения =  "РаспределениеОбъемов" Тогда
		СписокПериодовОбъемов = СписокПериодов;
	КонецЕсли;
	
	МассивТиповКолво = Новый Массив;
	МассивТиповКолво.Добавить(Тип("Число"));
	
	Если КвалификаторыЧисла = Неопределено Тогда
		КЧКоличество = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
	Иначе
		КЧКоличество = КвалификаторыЧисла;
	КонецЕсли;	
	ОписаниеТиповКоличество = Новый ОписаниеТипов(МассивТиповКолво , , , КЧКоличество);
	
	КЧСумма = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
	ОписаниеТиповСумма = Новый ОписаниеТипов(МассивТиповКолво , , , КЧСумма);
	
	Для каждого СтрокаСпискаПериодов Из СписокПериодов Цикл
		
		Если РаспределятьКоличество Тогда
			
			ИмяКолонкиКоличество = "Количество_" + ТаблицаРаспределения + "_" 
				+ Формат(СтрокаСпискаПериодов.Значение, "ДФ=MM_yyyy");
			Если ТаблицаДляРаспределения.Колонки.Найти(ИмяКолонкиКоличество) = Неопределено Тогда
				НоваяКолонка = ТаблицаДляРаспределения.Колонки.Добавить(ИмяКолонкиКоличество, ОписаниеТиповКоличество,
					Формат(СтрокаСпискаПериодов.Значение,"ДФ='MMMM yyyy'") + "(кол.)");
			КонецЕсли;
			
			СписокКолонокИтогов.Добавить("Всего_" + ИмяКолонкиКоличество);		
			СписокКолонокПрограммно.Добавить(СтрокаСпискаПериодов.Значение, ИмяКолонкиКоличество);
			
		КонецЕсли;
		
		Если ТаблицаРаспределения <> "ТрудовыеРесурсы" Тогда
			
			ИмяКолонкиСумма = "Сумма_" + ТаблицаРаспределения + "_" + Формат(СтрокаСпискаПериодов.Значение, "ДФ=MM_yyyy");		
			Если ТаблицаДляРаспределения.Колонки.Найти(ИмяКолонкиСумма) = Неопределено Тогда
				НоваяКолонка = ТаблицаДляРаспределения.Колонки.Добавить(ИмяКолонкиСумма, ОписаниеТиповСумма,
					Формат(СтрокаСпискаПериодов.Значение,"ДФ='MMMM yyyy'"));
			КонецЕсли;
			
			СписокКолонокПрограммно.Добавить(СтрокаСпискаПериодов.Значение, ИмяКолонкиСумма);
			
			СписокКолонокИтогов.Добавить("Всего_" + ИмяКолонкиСумма);
			
		КонецЕсли;
			
		Если ТаблицаРаспределения = "РаспределениеОбъемов" Тогда
			
			ИмяКолонкиСуммаФакт = "СуммаФакт_" + ТаблицаРаспределения + "_" 
				+ Формат(СтрокаСпискаПериодов.Значение, "ДФ=MM_yyyy");
			Если ТаблицаДляРаспределения.Колонки.Найти(ИмяКолонкиСуммаФакт) = Неопределено Тогда
				НоваяКолонка = ТаблицаДляРаспределения.Колонки.Добавить(ИмяКолонкиСуммаФакт, ОписаниеТиповСумма,
					Формат(СтрокаСпискаПериодов.Значение,"ДФ='MMMM yyyy'") + "(сум. факт)");
			КонецЕсли;
			
			СписокКолонокИтогов.Добавить("Всего_" + ИмяКолонкиСуммаФакт);
			СписокКолонокПрограммно.Добавить(СтрокаСпискаПериодов.Значение, ИмяКолонкиСуммаФакт, Истина);
			
			//
			
			ИмяКолонкиКоличествоФакт = "КоличествоФакт_" + ТаблицаРаспределения + "_" 
				+ Формат(СтрокаСпискаПериодов.Значение, "ДФ=MM_yyyy");
			Если ТаблицаДляРаспределения.Колонки.Найти(ИмяКолонкиКоличествоФакт) = Неопределено Тогда
				НоваяКолонка = ТаблицаДляРаспределения.Колонки.Добавить(ИмяКолонкиКоличествоФакт, ОписаниеТиповКоличество,
					Формат(СтрокаСпискаПериодов.Значение, "ДФ='MMMM yyyy'") + "(кол. факт)");
			КонецЕсли;
			
			СписокКолонокИтогов.Добавить("Всего_" + ИмяКолонкиКоличествоФакт);
			СписокКолонокПрограммно.Добавить(СтрокаСпискаПериодов.Значение, ИмяКолонкиКоличествоФакт, Истина);
						                   
		КонецЕсли;
		
		
	КонецЦикла;
	
	Если ТаблицаРаспределения = "РаспределениеОбъемов" Тогда
		ЗаполнитьФактВыполненияОбъемов(ТаблицаДляРаспределения, ТаблицаРаспределения);
	КонецЕсли;
		
	Для Каждого СтрокаРаспределеннаяПоПериодам Из ТаблицаРаспределениеПоПериодам Цикл
		
		НайденнаяСтрока = ТаблицаДляРаспределения.Найти(СтрокаРаспределеннаяПоПериодам[КолонкаИндекса],
			"ИндексСтрокРаспределенияПоПериодам");
		
		Если НайденнаяСтрока <> Неопределено Тогда
			Если РаспределятьКоличество Тогда
				ИмяКолонки = "Количество_" + ТаблицаРаспределения + "_" 
					+ Формат(СтрокаРаспределеннаяПоПериодам.Период, "ДФ=MM_yyyy");
				НайденнаяСтрока[ИмяКолонки]  =  СтрокаРаспределеннаяПоПериодам.Количество;
			КонецЕсли;
			Если ТаблицаРаспределения <> "ТрудовыеРесурсы" Тогда
				ИмяКолонки = "Сумма_" + ТаблицаРаспределения + "_" + Формат(СтрокаРаспределеннаяПоПериодам.Период, "ДФ=MM_yyyy");
				НайденнаяСтрока[ИмяКолонки] = СтрокаРаспределеннаяПоПериодам.Сумма;
			КонецЕсли;
				
			//Если ТаблицаРаспределения = "РаспределениеОбъемов" Тогда
			//	
			//	СубпродуктыСтроки = Объект.Субпродукты.НайтиСтроки(Новый Структура("ИндексСтрокРаспределения", НайденнаяСтрока.ИндексСтрокиВладельца));
			//	
			//	ОтборСтрукт = Новый Структура("Номенклатура, Подразделение, Роль, Месяц");
			//	ОтборСтрукт.Номенклатура = СубпродуктыСтроки[0].Ресурс;
			//	ОтборСтрукт.Месяц = НачалоМесяца(СтрокаРаспределеннаяПоПериодам.Период);
			//	ОтборСтрукт.Подразделение = НайденнаяСтрока.Подразделение;
			//	ОтборСтрукт.Роль = НайденнаяСтрока.Роль;
			//	СтрокиФакт = ФактВыполненияОбъемов.НайтиСтроки(ОтборСтрукт);
			//	Если СтрокиФакт.Количество() Тогда
			//		ИмяКолонки = "СуммаФакт_" + ТаблицаРаспределения + "_" + Формат(СтрокаРаспределеннаяПоПериодам.Период, "ДФ=MM_yyyy");
			//		НайденнаяСтрока[ИмяКолонки] = СтрокиФакт[0].Сумма;	
			//		ИмяКолонки = "КоличествоФакт_" + ТаблицаРаспределения + "_" + Формат(СтрокаРаспределеннаяПоПериодам.Период, "ДФ=MM_yyyy");
			//		НайденнаяСтрока[ИмяКолонки] = СтрокиФакт[0].Количество;	
			//	КонецЕсли;
			//КонецЕсли;

		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыРаспределения.Вставить("СрокиЗадачи", СрокиЗадачи);
	ПараметрыРаспределения.Вставить("АдресТР", ТаблицаДляРаспределения);
	ПараметрыРаспределения.Вставить("РаспределятьКоличество", РаспределятьКоличество);
	ПараметрыРаспределения.Вставить("СписокКолонокПрограммно", СписокКолонокПрограммно);
	ПараметрыРаспределения.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыРаспределения.Вставить("СписокПериодов", СписокПериодов);
	ПараметрыРаспределения.Вставить("КолонкаИндекса", КолонкаИндекса);
	ПараметрыРаспределения.Вставить("РаспределятьКоличество", РаспределятьКоличество);
	ПараметрыРаспределения.Вставить("СписокКолонокИтогов", СписокКолонокИтогов);
	
	Если Не ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам.Свойство(ТаблицаРаспределения) Тогда
		ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам.Вставить(ТаблицаРаспределения);
	КонецЕсли;
	ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам[ТаблицаРаспределения] = СписокКолонокПрограммно;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФактВыполненияОбъемов(ТаблицаДляРаспределения, ТаблицаРаспределения)
	
	Если ТаблицаДляРаспределения = Неопределено Тогда
		ОтборСтрокРаспределения = Новый Структура("СпособПривязки, ИндексСтрокиВладельца", Перечисления.упоСпособПривязкиРаспределения.Вручную);
	Иначе
		ОтборСтрокРаспределения = Новый Структура("ИндексСтрокиВладельца");
	КонецЕсли;	
	
	ФактВыполненияОбъемовСгруппированная = ФактВыполненияОбъемов.Выгрузить();
	Если Не Объект.ВключитьСубпродуктыВПланДоходов Тогда
		ФактВыполненияОбъемовСгруппированная.Свернуть("Номенклатура, Подразделение, Роль, Месяц", "Сумма, Количество");
	КонецЕсли;
	
	ФактМесяцы = ФактВыполненияОбъемов.Выгрузить(, "Месяц");
	ФактМесяцы.Свернуть("Месяц");
	
	Для Каждого СтрокаСуб Из Объект.Субпродукты Цикл
		
		ОтборСтрокРаспределения.ИндексСтрокиВладельца = СтрокаСуб.ИндексСтрокРаспределения;
		Если ТаблицаДляРаспределения = Неопределено Тогда
			СтрокиРаспр = Объект[ТаблицаРаспределения].НайтиСтроки(ОтборСтрокРаспределения);
		Иначе
			СтрокиРаспр = ТаблицаДляРаспределения.НайтиСтроки(ОтборСтрокРаспределения);
		КонецЕсли;
		
		Для Каждого СтрокаРаспр Из СтрокиРаспр Цикл
			Для Каждого ФактМесяц Из ФактМесяцы Цикл
				ИмяКолонки = "СуммаФакт_" + ТаблицаРаспределения + "_" + Формат(ФактМесяц.Месяц, "ДФ=MM_yyyy");
				СтрокаРаспр[ИмяКолонки] = 0;	
				ИмяКолонки = "КоличествоФакт_" + ТаблицаРаспределения + "_" + Формат(ФактМесяц.Месяц, "ДФ=MM_yyyy");
				СтрокаРаспр[ИмяКолонки] = 0;	
			КонецЦикла;
			ОтборСтрукт = Новый Структура("Номенклатура, Подразделение, Роль");
			ОтборСтрукт.Номенклатура = СтрокаСуб.Ресурс;
			ОтборСтрукт.Подразделение = СтрокаРаспр.Подразделение;
			ОтборСтрукт.Роль = СтрокаРаспр.Роль;
			Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
				ОтборСтрукт.Вставить("Статья", СтрокаСуб.СтатьяДоходов);
			КонецЕсли;
			СтрокиФакт = ФактВыполненияОбъемовСгруппированная.НайтиСтроки(ОтборСтрукт);
			Для Каждого СтрокаФакт Из СтрокиФакт Цикл
				ИмяКолонки = "СуммаФакт_" + ТаблицаРаспределения + "_" + Формат(СтрокаФакт.Месяц, "ДФ=MM_yyyy");
				СтрокаРаспр[ИмяКолонки] = СтрокаФакт.Сумма;	
				ИмяКолонки = "КоличествоФакт_" + ТаблицаРаспределения + "_" + Формат(СтрокаФакт.Месяц, "ДФ=MM_yyyy");
				СтрокаРаспр[ИмяКолонки] = СтрокаФакт.Количество;	
			КонецЦикла;
		КонецЦикла;

	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Процедура ОбработатьВыборРаспределения(ВыбранноеЗначение, КолонкаИндекса)
	
	ТаблицаРаспределенная = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТР);
	
	МассивСтрокНаУдаление = Новый Массив;
	
	Для Каждого СтрокаТР Из Объект.РаспределениеДоходовПоПериодам Цикл
		
		Если СтрокаТР[КолонкаИндекса] <> Неопределено Тогда
			
			МассивСтрокНаУдаление.Добавить(СтрокаТР);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаНаУдаление Из МассивСтрокНаУдаление Цикл
		
		Объект.РаспределениеДоходовПоПериодам.Удалить(Объект.РаспределениеДоходовПоПериодам.Индекс(СтрокаНаУдаление));
		
	КонецЦикла;
	
	Для Каждого ВыбраннаяСтрока Из ТаблицаРаспределенная Цикл
		
		НоваяСтрока =  Объект.РаспределениеДоходовПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыбраннаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

// Создает доп. элементы распределения доходов.
//
// Параметры:
//  ПроверятьОбъемы					 - 	 - 
//  ПроверятьДоходы					 - 	 - 
//  ПроверятьПотребности			 - 	 - 
//  ПроверятьРасходы				 - 	 - 
//  ПроверятьРолиТрудовыхРесурсов	 - 	 - 
//  СоздатьДопКолонки				 - 	 - 
//
&НаСервере
Процедура СоздатьДопЭлементыРаспределенияДоходов(ПроверятьОбъемы, ПроверятьДоходы, ПроверятьПотребности,
	ПроверятьРасходы, ПроверятьРолиТрудовыхРесурсов, ПроверятьДопЗатраты, СоздатьДопКолонки = Неопределено)
	
	Перем ПараметрыРаспределения;
	
	Если ПроверятьОбъемы Тогда
		
		Если СоздатьДопКолонки = Неопределено Тогда
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);
			НеобходимоСоздатьДопКолонки = Объект.РаспределениеОбъемов.НайтиСтроки(ОтборСтрок).Количество() > 0;
		Иначе
			НеобходимоСоздатьДопКолонки = СоздатьДопКолонки;
		КонецЕсли;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			Элементы.РаспределениеОбъемовГруппаКоличествоСуммаРаспределение.Видимость = Истина;
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеОбъемов",
				"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределениеПоРолям",,, Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Неотрицательный));
		Иначе
			Элементы.РаспределениеОбъемовГруппаКоличествоСуммаРаспределение.Видимость = Ложь;
		КонецЕсли;
		Элементы.РаспределениеОбъемовГруппаАктуализировать.Видимость = Элементы.РаспределениеОбъемовГруппаКоличествоСуммаРаспределение.Видимость;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеОбъемов", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьРолиТрудовыхРесурсов Тогда
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.ТрудовыеРесурсы.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			Элементы.ТрудовыеРесурсыГруппаКоличествоРаспределение.Видимость = Истина;
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "ТрудовыеРесурсы",
				"ТрудовыеРесурсыПоПериодам", "ИндексСтрокиРаспределениеПоРолям",,, Новый КвалификаторыЧисла(15, 5, ДопустимыйЗнак.Неотрицательный));
		Иначе
			Элементы.ТрудовыеРесурсыГруппаКоличествоРаспределение.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "ТрудовыеРесурсы", НеобходимоСоздатьДопКолонки, "ЧДЦ=2");
		
	КонецЕсли;
	
	Если ПроверятьДоходы Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.РаспределениеДоходов.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеДоходов",
				"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределенияДоходов", Ложь);
			Элементы.РаспределениеДоходовГруппаСуммаКоличествоРаспределено.Видимость = Истина;
		Иначе
			Элементы.РаспределениеДоходовГруппаСуммаКоличествоРаспределено.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеДоходов", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьПотребности Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		ДопКолонкиВидимы = Ложь;
		Если СоздатьДопКолонки = Неопределено Тогда 
			Если ПроектныеОпции.РасходыПоНатуральнымПоказателям 
				Или (ПроектныеОпции.РасходыПоОбъемам И Объект.ВключитьМатРесурсыВПланРасходов) Тогда
				ДопКолонкиВидимы = Истина;
			Иначе
				СоздатьДопКолонки = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если СоздатьДопКолонки = Неопределено И ДопКолонкиВидимы Тогда
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
			НеобходимоСоздатьДопКолонки = Объект.РаспределениеПотребностей.НайтиСтроки(ОтборСтрок).Количество() > 0;
		Иначе
			НеобходимоСоздатьДопКолонки = СоздатьДопКолонки;
		КонецЕсли;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеПотребностей", 
				"РаспределениеРасходовПоПериодам", "ИндексСтрокиРаспределениеПоРолям", , Истина, Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Неотрицательный));
			Элементы.РаспределениеПотребностейГруппаКоличествоСуммаРаспределение.Видимость = Истина;
		Иначе
			Элементы.РаспределениеПотребностейГруппаКоличествоСуммаРаспределение.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеПотребностей", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьДопЗатраты Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.РаспределениеДополнительныхЗатрат.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеДополнительныхЗатрат", 
				"РаспределениеРасходовПоПериодам","ИндексСтрокиРаспределениеПоРолям", Ложь, Истина);
			Элементы.РаспределениеДополнительныхЗатратГруппаСуммаКоличествоРаспределено.Видимость = Истина;
		Иначе
			Элементы.РаспределениеДополнительныхЗатратГруппаСуммаКоличествоРаспределено.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеДополнительныхЗатрат", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьРасходы Тогда
		
		ПараметрыРаспределения = Неопределено;
		ПроверятьИсточникПлана = Истина;
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.РаспределениеРасходов.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеРасходов", 
				"РаспределениеРасходовПоПериодам","ИндексСтрокиРаспределенияРасходов", Ложь, Истина);
			Элементы.РаспределениеРасходовГруппаСуммаКоличествоРаспределено.Видимость = Истина;
		Иначе
			Элементы.РаспределениеРасходовГруппаСуммаКоличествоРаспределено.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеРасходов", НеобходимоСоздатьДопКолонки, ,
			ПроверятьИсточникПлана);
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, ИмяТаблицыРаспределения,
	НеобходимоСоздатьДопКолонки = Истина, ФорматРедактирования = Неопределено, ПроверятьИсточникПлана = Ложь)
	
	Если НеобходимоСоздатьДопКолонки Тогда
		
		ТаблицаРаспределения = ПараметрыРаспределения.АдресТР;
		
	КонецЕсли;
	
	СписокЭлементовДляДобавления = Новый СписокЗначений;
	МассивРеквизитов = Новый Массив;
	
	МассивРеквизитовНаУдаление = Новый Массив;
	СписокЭлементовДляУдаления = Новый СписокЗначений;
	
	Если ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат"
		Или ИмяТаблицыРаспределения = "РаспределениеДоходов"
		Или ИмяТаблицыРаспределения = "РаспределениеРасходов" Тогда
		ИмяЭлементаТаблицыРаспределения = ИмяТаблицыРаспределения + "ГруппаПрограммно";
	Иначе
		ИмяЭлементаТаблицыРаспределения = "";
	КонецЕсли;
	
	ПрограммноСозданныеЭлементы = упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(ЭтаФорма, 
										ИмяТаблицыРаспределения, ИмяЭлементаТаблицыРаспределения);	
	Для Каждого ЭлементПрограммно Из ПрограммноСозданныеЭлементы Цикл
	
		СписокЭлементовДляУдаления.Добавить(ЭлементПрограммно);		
		
		Если ЭлементПрограммно.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
			
			Для Каждого ЭлементПодчиненный Из ЭлементПрограммно.ПодчиненныеЭлементы Цикл
				
				МассивРеквизитовНаУдаление.Добавить(ЭлементПодчиненный.ПутьКДанным);
				
				Если СтрДлина(ЭлементПодчиненный.ПутьКДаннымПодвала) > 0 Тогда
					
					МассивРеквизитовНаУдаление.Добавить(ЭлементПодчиненный.ПутьКДаннымПодвала);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			МассивРеквизитовНаУдаление.Добавить(ЭлементПрограммно.ПутьКДанным);
			
			Если СтрДлина(ЭлементПрограммно.ПутьКДаннымПодвала) > 0 Тогда
				
				МассивРеквизитовНаУдаление.Добавить(ЭлементПрограммно.ПутьКДаннымПодвала);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НеобходимоСоздатьДопКолонки Тогда
		Для Каждого КолонкаПрограммно Из ПараметрыРаспределения.СписокКолонокПрограммно Цикл
			
			КолонкаТаблицы = ТаблицаРаспределения.Колонки.Найти(КолонкаПрограммно.Представление);	 
			НоваяКолонка = Новый РеквизитФормы(КолонкаТаблицы.Имя, КолонкаТаблицы.ТипЗначения, "Объект." 
				+ ИмяТаблицыРаспределения, КолонкаТаблицы.Заголовок, Истина);
			МассивРеквизитов.Добавить(НоваяКолонка);
			СписокЭлементовДляДобавления.Добавить(КолонкаТаблицы.Имя, КолонкаТаблицы.Заголовок, КолонкаПрограммно.Пометка);
			
		КонецЦикла;
		
		МассивТиповЧисло = Новый Массив;
		МассивТиповЧисло.Добавить(Тип("Число"));
		
		Если ИмяТаблицыРаспределения <> "ТрудовыеРесурсы" Тогда
			Точность = 3;
		Иначе
			Точность = 2;
		КонецЕсли;
		
		КЧ = Новый КвалификаторыЧисла(15, Точность, ДопустимыйЗнак.Неотрицательный);
		ОписаниеТиповКоличество = Новый ОписаниеТипов(МассивТиповЧисло, , , КЧ);
		
		КЧ = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
		ОписаниеТиповСумма = Новый ОписаниеТипов(МассивТиповЧисло, , , КЧ);
		
		Для Каждого КолонкаИтогов Из ПараметрыРаспределения.СписокКолонокИтогов Цикл
			
			Если ИмяТаблицыРаспределения <> "ТрудовыеРесурсы" И СтрНайти(КолонкаИтогов.Значение, "Количество") > 0 Тогда
				ОписаниеТиповЧ = ОписаниеТиповКоличество;
			Иначе
				ОписаниеТиповЧ = ОписаниеТиповСумма;
			КонецЕсли;
			
			НоваяКолонкаИтогов = Новый РеквизитФормы(КолонкаИтогов.Значение, ОписаниеТиповЧ, , Истина);
			МассивРеквизитов.Добавить(НоваяКолонкаИтогов);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов, МассивРеквизитовНаУдаление);	
	
	Для Каждого ЭлементНаУдаление Из СписокЭлементовДляУдаления Цикл
		
		Элементы.Удалить(ЭлементНаУдаление.Значение);
		
	КонецЦикла;
	
	ШаблонИмениГруппы = "Группа_%1_";	
	ШаблонИмениГруппы = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмениГруппы,
		ИмяТаблицыРаспределения);
	
	Если НеобходимоСоздатьДопКолонки Тогда
		Если ПараметрыРаспределения.РаспределятьКоличество Тогда
			
			Если  ИмяТаблицыРаспределения = "РаспределениеОбъемов" Тогда
				ЭлементВладелец = Элементы.РаспределениеОбъемов;
			ИначеЕсли ИмяТаблицыРаспределения = "ТрудовыеРесурсы" Тогда
				ЭлементВладелец = Элементы.ТрудовыеРесурсы;
			Иначе
				ЭлементВладелец = Элементы.РаспределениеПотребностей;
			КонецЕсли;
			
			Для Каждого ЭлементСпискаПериодов Из ПараметрыРаспределения.СписокПериодов Цикл
				
				НоваяГруппа = Элементы.Добавить(ШаблонИмениГруппы 
					+ Формат(ЭлементСпискаПериодов.Значение,"ДФ=MM_yyyy"), Тип("ГруппаФормы"), ЭлементВладелец);
				НоваяГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
				НоваяГруппа.Группировка =  ГруппировкаКолонок.Горизонтальная;
				НоваяГруппа.ОтображатьВШапке = Истина;
				НоваяГруппа.Заголовок=Формат(ЭлементСпискаПериодов.Значение, "ДФ='MMMM yyyy'");
				
				ИмяКолонкиКоличество = "Количество_" + ИмяТаблицыРаспределения + "_"
					+ Формат(ЭлементСпискаПериодов.Значение,"ДФ=MM_yyyy");
				
				НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиКоличество, Тип("ПолеФормы"), НоваяГруппа);			
				НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиКоличество;
				НоваяКолонкаЭлемент.Доступность = Истина;
				НоваяКолонкаЭлемент.Заголовок = "Количество";
				НоваяКолонкаЭлемент.ОтображатьВШапке = Не ИмяТаблицыРаспределения = "ТрудовыеРесурсы";
				НоваяКолонкаЭлемент.Ширина = 8;
				НоваяКолонкаЭлемент.РастягиватьПоГоризонтали = Ложь;
				//НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
				НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиКоличество;
				НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
				
				Если ИмяТаблицыРаспределения = "РаспределениеОбъемов" Тогда
					
					ИмяОбработчика1 = "Подключаемый_РаспределениеДоходовПоМесяцамКоличествоПриИзменении";
					ИмяОбработчика2 = "Подключаемый_РаспределениеДоходовПоМесяцамСуммаПриИзменении";
					
				ИначеЕсли ИмяТаблицыРаспределения = "ТрудовыеРесурсы" Тогда
					
					ИмяОбработчика1 = "Подключаемый_РаспределениеТрудовыхРесурсовПоМесяцамКоличествоПриИзменении";
					
				Иначе
					
					ИмяОбработчика1 = "Подключаемый_РаспределениеРасходовПоМесяцамКоличествоПриИзменении";
					ИмяОбработчика2 = "Подключаемый_РаспределениеРасходовПоМесяцамСуммаПриИзменении";      
					
				КонецЕсли;
			
				НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", ИмяОбработчика1);
				Если ИмяТаблицыРаспределения <> "ТрудовыеРесурсы" Тогда

					ИмяКолонкиСумма = "Сумма_" + ИмяТаблицыРаспределения + "_"
						+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
					
					НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиСумма, Тип("ПолеФормы"), НоваяГруппа);			
					НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
					НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиСумма;
					НоваяКолонкаЭлемент.Доступность = Истина;
					НоваяКолонкаЭлемент.Заголовок = "Сумма";				
					НоваяКолонкаЭлемент.Ширина = 8;
					НоваяКолонкаЭлемент.РастягиватьПоГоризонтали = Ложь;
					//НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
					НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиСумма;
					НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
					НоваяКолонкаЭлемент.Формат = "ЧДЦ=2";
					НоваяКолонкаЭлемент.ФорматРедактирования = "ЧДЦ=2";
					
					НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", ИмяОбработчика2);
					
				КонецЕсли;
								
				Если ИмяТаблицыРаспределения = "РаспределениеОбъемов" Тогда
									
					ИмяКолонкиКоличествоФакт_ = "КоличествоФакт_" + ИмяТаблицыРаспределения + "_"
						+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
					
					НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиКоличествоФакт_, Тип("ПолеФормы"), НоваяГруппа);			
					НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
					НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиКоличествоФакт_;
					//НоваяКолонкаЭлемент.Доступность = Ложь;
					НоваяКолонкаЭлемент.ТолькоПросмотр = Истина;
					НоваяКолонкаЭлемент.Заголовок = "Количество (факт)";
					НоваяКолонкаЭлемент.Ширина = 8;
					НоваяКолонкаЭлемент.РастягиватьПоГоризонтали = Ложь;
					//НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
					НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиКоличествоФакт_;
					НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
										
					//

					ИмяКолонкиСуммаФакт_ = "СуммаФакт_" + ИмяТаблицыРаспределения + "_"
						+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
					
					НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиСуммаФакт_, Тип("ПолеФормы"), НоваяГруппа);			
					НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
					НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиСуммаФакт_;
					//НоваяКолонкаЭлемент.Доступность = Ложь;
					НоваяКолонкаЭлемент.ТолькоПросмотр = Истина;
					НоваяКолонкаЭлемент.Заголовок = "Сумма (факт)";
					НоваяКолонкаЭлемент.Ширина = 8;
					НоваяКолонкаЭлемент.РастягиватьПоГоризонтали = Ложь;
					//НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
					НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиСуммаФакт_;
					НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
					НоваяКолонкаЭлемент.Формат = "ЧДЦ=2";
					НоваяКолонкаЭлемент.ФорматРедактирования = "ЧДЦ=2";
					
				КонецЕсли;
				
				Если ФорматРедактирования <> Неопределено Тогда
					НоваяКолонкаЭлемент.Формат = ФорматРедактирования;
					НоваяКолонкаЭлемент.ФорматРедактирования = ФорматРедактирования;
				КонецЕсли;

			КонецЦикла;
			
		ИначеЕсли ИмяТаблицыРаспределения <> "ТрудовыеРесурсы" Тогда	 		 
			
			Если ИмяТаблицыРаспределения = "РаспределениеДоходов" Тогда
				ЭлементВладелец = Элементы.РаспределениеДоходовГруппаПрограммно;
			ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат" Тогда
				ЭлементВладелец = Элементы.РаспределениеДополнительныхЗатратГруппаПрограммно;	
			Иначе
				ЭлементВладелец = Элементы.РаспределениеРасходовГруппаПрограммно;
			КонецЕсли;
			
			Для Каждого ЭлементСпискаПериодов Из ПараметрыРаспределения.СписокПериодов Цикл
				
				ИмяКолонкиСумма = "Сумма_" + ИмяТаблицыРаспределения + "_"
					+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
				
				НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиСумма, Тип("ПолеФормы"), ЭлементВладелец);			
				НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиСумма;
				НоваяКолонкаЭлемент.Доступность = Истина;
				НоваяКолонкаЭлемент.Заголовок = Формат(ЭлементСпискаПериодов.Значение, "ДФ='MMMM yyyy'");
				НоваяКолонкаЭлемент.Ширина = 8;
				НоваяКолонкаЭлемент.РастягиватьПоГоризонтали = Ложь;
				//НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 				
				НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиСумма;
				НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
				НоваяКолонкаЭлемент.Формат = "ЧДЦ=2";
				НоваяКолонкаЭлемент.ФорматРедактирования = "ЧДЦ=2";
				
			КонецЦикла;
			
		КонецЕсли;
		
		Для Каждого СтрокаРаспределения Из Объект[ИмяТаблицыРаспределения] Цикл
			Если СтрокаРаспределения.ИндексСтрокРаспределенияПоПериодам = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НайденнаяСтрока = ТаблицаРаспределения.Найти(СтрокаРаспределения.ИндексСтрокРаспределенияПоПериодам,
				"ИндексСтрокРаспределенияПоПериодам");
			
			Если НайденнаяСтрока <> Неопределено Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, НайденнаяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ВыделятьОтрицательные", Истина);
		
		ЭлементУОГруппа = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ЭлементУОГруппа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		ЭлементУООтбор = ЭлементУОГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицыРаспределения 
			+ ".СпособПривязки");
		ЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		ЭлементУООтбор.ПравоеЗначение = Перечисления.упоСпособПривязкиРаспределения.Вручную;
		
		Если ПроверятьИсточникПлана Тогда
			// Для проверки трансляции.
			ИсточникПлана = упоРаботаСФормамиКлиентСервер.ИсточникПланаПоТаблице(ИмяТаблицыРаспределения);
			// Если добавлена новая строка вручную.
			ПустойИсточникПлана = Перечисления.упоИсточникПланаДоходовИРасходов.ПустаяСсылка();
			
			ПроверяемыеИсточникиПлана = Новый СписокЗначений;
			ПроверяемыеИсточникиПлана.Добавить(ИсточникПлана);
			ПроверяемыеИсточникиПлана.Добавить(ПустойИсточникПлана);
			
			ЭлементУООтбор = ЭлементУОГруппа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицыРаспределения
				+ ".ИсточникПлана");
			ЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
			ЭлементУООтбор.ПравоеЗначение = ПроверяемыеИсточникиПлана;
		КонецЕсли;
		
		Для Каждого НоваяКолонка Из СписокЭлементовДляДобавления Цикл
			
			НовоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(НоваяКолонка.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьКоличествоИСуммуРучногоРаспределенияТрудовыхРесурсовЗаПериод(ТекСтрока)
	
	ТаблицаРаспределения = "ТрудовыеРесурсы";
	
	ТекСтрока.КоличествоОстаток = 0;
	ТекСтрока.КоличествоРаспределено = 0;	
		
	ПрограммноСозданныеЭлементы = упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(ЭтаФорма, ТаблицаРаспределения);		
	Для каждого ЭлементСпискаПрограммно Из ПрограммноСозданныеЭлементы Цикл
		
		ПериодЗашифрованный = упоРаботаСФормамиКлиентСервер.ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
		
		ИмяКолонкиКоличество = "Количество_" + ТаблицаРаспределения + "_" + Формат(ПериодЗашифрованный,"ДФ=MM_yyyy");				
		ТекСтрока[ИмяКолонкиКоличество] = 0;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПланРасходовРаспределениеРасходовКромеИсточникаТрудозатраты()
	
	Документы.упоПроектнаяЗадача.ОчиститьПланРасходовРаспределениеРасходовКромеИсточникаТрудозатраты(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПланРасходовЗаполнитьПоТрудовымРесурсамНаСервере(Очищать = Истина, Свернуть = Истина)
	
	Документы.упоПроектнаяЗадача.ЗаполнитьПланРасходовПоТрудовымРесурсам(Объект, Очищать, Свернуть,
		ПроектныеОпции.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат);
	
КонецПроцедуры

&НаСервере
Процедура ПланРасходовЗаполнитьПоПлануДоходовНаСервере(ОчиститьПланРасходов)
	
	Документы.упоПроектнаяЗадача.ЗаполнитьПланРасходовПоПлануДоходов(Объект, , , , ОчиститьПланРасходов);
	
КонецПроцедуры

&НаСервере
Процедура ОбъемыЗаполнитьПоТрудовымРесурсамНаСервере(Очищать = Истина, УровеньПланирования = Неопределено)
	
	Если Очищать Тогда
		Объект.Субпродукты.Очистить();
		Объект.РаспределениеОбъемов.Очистить();
	КонецЕсли;
	
	ЗначенияПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Объект.Проект);
	
	НоменклатураПоУмолчанию = ЗначенияПоУмолчанию.НатуральныйПоказательДоходовПоУмолчанию;
	СтатьяПоУмолчанию = ЗначенияПоУмолчанию.СтатьяДоходовПоУмолчанию;
	ПрофильПоУмолчанию = ЗначенияПоУмолчанию.ПрофильДоходовПоУмолчанию;
	
	РеквизитыПроекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Проект, "КонтрагентДоходов, ДоговорДоходов, 
			|   упоЕдиницаТрудоемкостиПоУмолчанию");
	ЕдиницаНормирования = ?(ЗначениеЗаполнено(РеквизитыПроекта.упоЕдиницаТрудоемкостиПоУмолчанию),
			РеквизитыПроекта.упоЕдиницаТрудоемкостиПоУмолчанию, Справочники.упоЕдиницыВремени.Час);
	Контрагент = РеквизитыПроекта.КонтрагентДоходов;
	Договор = РеквизитыПроекта.ДоговорДоходов;
	
	ВалютаПоУмолчанию = упоУправлениеДоговорамиСервер.ВалютаДоговораКонтрагента(Договор);
	
	Если Не ЗначениеЗаполнено(ВалютаПоУмолчанию) Тогда
		ВалютаПоУмолчанию = мВалютаУправленческогоУчета;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Предварительный);
	СтрокиДляЗаполненияПредварительный = Объект.ТрудовыеРесурсы.НайтиСтроки(СтруктураОтбора);
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("УровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
	СтрокиДляЗаполненияОкончательный = Объект.ТрудовыеРесурсы.НайтиСтроки(СтруктураОтбора);
	
	Если УровеньПланирования = Перечисления.упоУровеньПланирования.Предварительный Тогда
		СтрокиДляЗаполнения = СтрокиДляЗаполненияПредварительный;
	ИначеЕсли УровеньПланирования = Перечисления.упоУровеньПланирования.Окончательный Тогда
		СтрокиДляЗаполнения = СтрокиДляЗаполненияОкончательный;
	Иначе
		Если СтрокиДляЗаполненияОкончательный.Количество() > 0 Тогда
			СтрокиДляЗаполнения = СтрокиДляЗаполненияОкончательный;
		Иначе
			СтрокиДляЗаполнения = СтрокиДляЗаполненияПредварительный;
		КонецЕсли;
	КонецЕсли;
	
	ТрудовыеРесурсы = Объект.ТрудовыеРесурсы.Выгрузить(СтрокиДляЗаполнения);
	
	// Распределение может быть "Вручную, по месяцам", тогда полявляются програмно добавленные колонки.
	// Чтобы корректно заполнить ТЧ на основании такой таблицы, надо перенести и значение этих колонок.
	ТЗСоответствияКолонок = Новый ТаблицаЗначений;
	ТЗСоответствияКолонок.Колонки.Добавить("КолонкаТрудовыеРесурсы");
	ТЗСоответствияКолонок.Колонки.Добавить("КолонкаРаспределениеОбъемов");
	
	КолонкиСуммирования = "Количество, ВнешняяСтоимость, ОбщВнешняяСтоимость";
	// Если надо, добавим программно колонки.
	ПараметрыОтбора = Новый Структура("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);
	ИскомыеСтроки = ТрудовыеРесурсы.НайтиСтроки(ПараметрыОтбора);
	Если ИскомыеСтроки.Количество() > 0 Тогда
		МассивТиповКолво = Новый Массив;
		МассивТиповКолво.Добавить(Тип("Число"));
		ДобавляемыКолонки = Новый Массив;
		КЧКоличество = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Неотрицательный);
		ОписаниеТиповКоличество = Новый ОписаниеТипов(МассивТиповКолво, , , КЧКоличество);
		
		СоответствиеКолонокКоличествоСуммаВнешняя = Новый Соответствие;
		
		Для Каждого Колонка Из ТрудовыеРесурсы.Колонки Цикл
			ИмяКолонки = Колонка.Имя;
			Если Найти(ИмяКолонки, "Количество_") Тогда
				ИмяКолонкиСуммаВнешняя = СтрЗаменить(ИмяКолонки, "Количество_", "СуммаВнешняя_");
				НоваяКолонка = ТрудовыеРесурсы.Колонки.Добавить(ИмяКолонкиСуммаВнешняя, ОписаниеТиповКоличество);
				СоответствиеКолонокКоличествоСуммаВнешняя.Вставить(ИмяКолонки, ИмяКолонкиСуммаВнешняя)
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Строка Из ИскомыеСтроки Цикл
			
			Если УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
				ТЗСуммаВнешняя = ПолучитьДанныеупоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия(Объект.Проект,
						Объект.Ссылка,
						Строка.Ресурс,
						Строка.Подразделение,
						Строка.УровеньПланирования);
				Для Каждого ЭлементТЗ Из ТЗСуммаВнешняя Цикл
					ИмяКолонки = "Количество_ТрудовыеРесурсы_" + Формат(ЭлементТЗ.Период, "ДФ=MM_yyyy");
					ИмяСуммаВнешняя = СоответствиеКолонокКоличествоСуммаВнешняя.Получить(ИмяКолонки);
					Если ИмяСуммаВнешняя <> Неопределено Тогда
						Строка[ИмяСуммаВнешняя] = ЭлементТЗ.ВнешняяСтоимость;
					КонецЕсли;
				КонецЦикла;
			Иначе
				МассивКоэффициентов = Новый Массив;
				Для Каждого КлючЗначение Из СоответствиеКолонокКоличествоСуммаВнешняя Цикл
					МассивКоэффициентов.Добавить(Строка[КлючЗначение.Ключ]);
				КонецЦикла;
				
				МассивСуммаВнешняя = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Строка.ОбщВнешняяСтоимость,
						МассивКоэффициентов,
						2);
				Если МассивСуммаВнешняя <> Неопределено Тогда
					Сч = 0;
					Для Каждого КлючЗначение Из СоответствиеКолонокКоличествоСуммаВнешняя Цикл
						Строка[КлючЗначение.Значение] = МассивСуммаВнешняя[Сч];
						Сч = Сч + 1;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого КолонкаТЗ Из ТрудовыеРесурсы.Колонки Цикл
			ИмяКолонки = КолонкаТЗ.Имя;
			Если Не ПустаяСтрока(ИмяКолонки)
				И (Найти(ИмяКолонки, "Количество_") > 0
					Или Найти(ИмяКолонки, "СуммаВнешняя_") > 0) Тогда
				КолонкиСуммирования = КолонкиСуммирования + ", " + ИмяКолонки;
				НоваяСтрокаСоответствияКолонок = ТЗСоответствияКолонок.Добавить();
				НоваяСтрокаСоответствияКолонок.КолонкаТрудовыеРесурсы = ИмяКолонки;
				Если Найти(ИмяКолонки, "Количество_") > 0 Тогда
					НоваяСтрокаСоответствияКолонок.КолонкаРаспределениеОбъемов =
						СтрЗаменить(ИмяКолонки, "ТрудовыеРесурсы", "РаспределениеОбъемов");
				Иначе // СуммаВнешняя
					НоваяСтрокаСоответствияКолонок.КолонкаРаспределениеОбъемов =
						СтрЗаменить(ИмяКолонки, "СуммаВнешняя_ТрудовыеРесурсы", "Сумма_РаспределениеОбъемов");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СоздатьДопКолонки = Истина;
	Иначе
		СоздатьДопКолонки = Ложь;
	КонецЕсли;
	
	СоздатьДопЭлементыРаспределенияДоходов(Истина, Ложь, Ложь, Ложь, Ложь, Ложь, СоздатьДопКолонки);
	
	КолонкаСтоимость = "ОбщВнешняяСтоимость";
	ОбщаяСумма = ТрудовыеРесурсы.Итог(КолонкаСтоимость);
	
	ИндексСтрокРаспределения =
		упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(Объект.Субпродукты);
	
	НоваяСтрока = Объект.Субпродукты.Добавить();
	НоваяСтрока.Ресурс = НоменклатураПоУмолчанию;
	ЗаполнитьЕдИзмеренияВСтрокеИлиСтруктуре(НоваяСтрока);
	НоваяСтрока.ОбщСтоимость = ОбщаяСумма;
	НоваяСтрока.Контрагент = Контрагент;
	НоваяСтрока.Договор = Договор;
	НоваяСтрока.Валюта = ВалютаПоУмолчанию;
	НоваяСтрока.СпособПривязкиВыпуска = Перечисления.упоСпособПривязкиПоставокИСубпродуктов.ЗавершениеЗадачи;
	НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
	НоваяСтрока.ПрофильРаспределения = ПрофильПоУмолчанию;
	НоваяСтрока.СтатьяДоходов = СтатьяПоУмолчанию;
	НоваяСтрока.ИндексСтрокРаспределения = ИндексСтрокРаспределения;
	
	ТрудовыеРесурсы.Свернуть("Ресурс, ЕдиницаНормирования, Подразделение, СпособПривязки", КолонкиСуммирования);
	
	Для каждого СтрокаТрудозатраты Из ТрудовыеРесурсы Цикл
		
		НоваяСтрокаРаспределения = Объект.РаспределениеОбъемов.Добавить();
		НоваяСтрокаРаспределения.Роль = СтрокаТрудозатраты.Ресурс;
		НоваяСтрокаРаспределения.СобствСилы_Субподряд = НоваяСтрокаРаспределения.Роль.СобствСилы_Субподряд;
		НоваяСтрокаРаспределения.Подразделение = СтрокаТрудозатраты.Подразделение;
		
		Количество = СтрокаТрудозатраты.Количество * СтрокаТрудозатраты.ЕдиницаНормирования.Коэффициент /
			ЕдиницаНормирования.Коэффициент;
		НоваяСтрока.Количество = НоваяСтрока.Количество + Количество;
		НоваяСтрокаРаспределения.Количество = Количество;
		
		НоваяСтрокаРаспределения.Сумма = СтрокаТрудозатраты.ОбщВнешняяСтоимость;
		НоваяСтрокаРаспределения.СпособПривязки = СтрокаТрудозатраты.СпособПривязки;
		НоваяСтрокаРаспределения.ПрофильРаспределения = ПрофильПоУмолчанию;
		НоваяСтрокаРаспределения.ИндексСтрокиВладельца = НоваяСтрока.ИндексСтрокРаспределения;
		
		// Заполним программно добавленные колонки.
		Для каждого СтрокаТЗСоответствияКолонок Из ТЗСоответствияКолонок Цикл
			Если Лев(СтрокаТЗСоответствияКолонок.КолонкаТрудовыеРесурсы, 10) = "Количество" Тогда
				НоваяСтрокаРаспределения[СтрокаТЗСоответствияКолонок.КолонкаРаспределениеОбъемов] =
					СтрокаТрудозатраты[СтрокаТЗСоответствияКолонок.КолонкаТрудовыеРесурсы] * СтрокаТрудозатраты.ЕдиницаНормирования.Коэффициент /
					?(ЕдиницаНормирования.Коэффициент = 0, 1, ЕдиницаНормирования.Коэффициент);
				Продолжить;
			КонецЕсли;
			НоваяСтрокаРаспределения[СтрокаТЗСоответствияКолонок.КолонкаРаспределениеОбъемов] =
				СтрокаТрудозатраты[СтрокаТЗСоответствияКолонок.КолонкаТрудовыеРесурсы];
		КонецЦикла;
		
		// Если способ привязки - вручную, тогда надо установить ИндексСтрокРаспределенияПоПериодам в строке распределения.
		Если НоваяСтрокаРаспределения.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.Вручную Тогда
			НоваяСтрокаРаспределения.ИндексСтрокРаспределенияПоПериодам =
				упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(
					Объект.ТрудовыеРесурсы, "ИндексСтрокРаспределенияПоПериодам");
		КонецЕсли;
		
	КонецЦикла;
	
	НоваяСтрока.Стоимость = ОбщаяСумма / НоваяСтрока.Количество;
	
КонецПроцедуры

&НаКлиенте	
Процедура УстановитьОграничениеТиповМатериальныеРесурсы()
	
	МассивТипов = Новый Массив;	
	МассивТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));	
	ОписаниеТиповМатериальныеРесурсы = Новый ОписаниеТипов(МассивТипов);	
	Элементы.МатериальныеРесурсыРесурс.ОграничениеТипа = ОписаниеТиповМатериальныеРесурсы;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормыСерверEPM()
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		
		СкрытьЭлементыСвязиСЗаказами();
		
		Возврат; // Возврат
		
	КонецЕсли;
	
	ПроектПЗ = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(Объект.Ссылка);
	
	упоРаботаСФормамиСервер.СоздатьТаблицыДокументовЗаказ(ЭтаФорма, ПроектПЗ);
	упоРаботаСФормамиКлиентСервер.УстановитьВидимостьСтраницЗаказовВыпускаПоТипуСубпродукта(Элементы, 
		Объект.ТипСубпродукта);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоходыПоМатериальнымТрудовымРесурсамНаСервере(СтруктураПараметров)    
    
    СтруктураПараметров.Вставить("Объект", Объект);
            
    Документы.упоПроектнаяЗадача.ЗаполнитьПланДоходовПоПланамТрудовыхМатериальныхРесурсов(СтруктураПараметров);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаспределениеДоходовПоМатериальнымТрудовымРесурсамНаСервере(СтруктураПараметров)    
    
    СтруктураПараметров.Вставить("Объект", Объект);
            
    Документы.упоПроектнаяЗадача.ЗаполнитьРаспределениеДоходовПоТрудовымМатериальнымРесурсам(СтруктураПараметров);

КонецПроцедуры

&НаСервере
Процедура СубпродуктыРесурсПриИзмененииНаСервере(СтруктураСтрокиСубпродукты, МассивРаспределенияОбъемов)
	
	СтруктураСтрокиСубпродукты.ЭтоПП = 
		упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(СтруктураСтрокиСубпродукты.Ресурс);
	
	Если СтруктураСтрокиСубпродукты.ЭтоПП Тогда
		
		ПустаяПроектнаяЗадача = ПредопределенноеЗначение("Документ.упоПроектнаяЗадача.ПустаяСсылка");
		
		РеквизитыРесурса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураСтрокиСубпродукты.Ресурс, 
			"Шаблон, ПроектнаяЗадача");
		
		Если РеквизитыРесурса.Шаблон = Ложь И Не (РеквизитыРесурса.ПроектнаяЗадача = Объект.Ссылка Или  
			РеквизитыРесурса.ПроектнаяЗадача = ПустаяПроектнаяЗадача) Тогда
			
			СтруктураСтрокиСубпродукты.Ресурс = ПредопределенноеЗначение("Справочник.упоПроектнаяПродукция.ПустаяСсылка");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураСтрокиСубпродукты.Ресурс) Тогда 

			МодульПроектнаяПродукцияВызовСервера = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукцияВызовСервера");
			МодульПроектнаяПродукцияВызовСервера.ЗаполнитьПланВыпускаПоПроектнойПродукции(СтруктураСтрокиСубпродукты,
				МассивРаспределенияОбъемов);
								
		КонецЕсли;
		
	Иначе
		
		упоРесурсыИНормыВызовСервера.обПриИзмененииРесурсаТабЧасти(СтруктураСтрокиСубпродукты,
			Неопределено, Объект.НормаСтоимостиОбъемы);
		
		Если Не ЗначениеЗаполнено(СтруктураСтрокиСубпродукты.ЕдиницаНормирования) Тогда
			ЗаполнитьЕдИзмеренияСубпродуктов(СтруктураСтрокиСубпродукты);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьЕдИзмеренияСубпродуктов(СтруктураСтрокиСубпродукты) 
	
	СтруктураСтрокиСубпродукты.ЕдиницаНормирования = 
		упоЗаполнениеИПодборСервер.ПолучитьЕдиницуИзмеренияНоменклатуры(СтруктураСтрокиСубпродукты.Ресурс);
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста	
Процедура ПересчитатьИтогиПоТрудовымРесурсам(ЭтаФорма, ПризнакФактаПересчета = Неопределено)
	
	// Возможно, не всегда потребуется пересчитывать.
	Если ТипЗнч(ПризнакФактаПересчета) = Тип("Булево") И ПризнакФактаПересчета = Истина Тогда
		Возврат;
	КонецЕсли;
	
	//
	
	СтраницаРесурсовАктивнаИДоступна = ЭтаФорма.Элементы.СтраницыОсновное.ТекущаяСтраница = 
		ЭтаФорма.Элементы.СтраницаРесурсы
			И ЭтаФорма.Элементы.СтраницаТрудовыеРесурсы.Видимость;
	
	Если Не СтраницаРесурсовАктивнаИДоступна Тогда
		Возврат; // Возврат
	КонецЕсли;
		
	ТемпИтогоОбщаяВнешняяСтоимостьТР = 0;
	ТемпИтогоОбщаяСтоимостьТР = 0;
	ТемпИтогоТрудозатратыКоличество = 0;
		
	Если ЭтаФорма.УровеньПланированияОкончательный Тогда
		НайденныеСтроки = ЭтаФорма.Объект.ТрудовыеРесурсы.НайтиСтроки(
			Новый Структура("УровеньПланирования",
			ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный")));
	Иначе
		НайденныеСтроки = ЭтаФорма.Объект.ТрудовыеРесурсы.НайтиСтроки(
			Новый Структура("УровеньПланирования",
			ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный")));
		НайденныеСтрокиПустые = ЭтаФорма.Объект.ТрудовыеРесурсы.НайтиСтроки(
			Новый Структура("УровеньПланирования",
			ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.ПустаяСсылка")));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НайденныеСтроки, НайденныеСтрокиПустые);
	КонецЕсли;
	
	Для Каждого Стр Из НайденныеСтроки Цикл
		
		ТемпИтогоОбщаяВнешняяСтоимостьТР = ТемпИтогоОбщаяВнешняяСтоимостьТР + Стр.ОбщВнешняяСтоимость;
		ТемпИтогоОбщаяСтоимостьТР = ТемпИтогоОбщаяСтоимостьТР + Стр.ОбщСтоимость;
		
		КоэффициентНормирования = КоэффициентЕдиницыНормирования(ЭтаФорма, Стр.ЕдиницаНормирования);
		ТемпИтогоТрудозатратыКоличество = ТемпИтогоТрудозатратыКоличество + Стр.Количество * КоэффициентНормирования;
		
	КонецЦикла;
	
	ЭтаФорма.ИтогоОбщаяВнешняяСтоимостьТР = ТемпИтогоОбщаяВнешняяСтоимостьТР;
	ЭтаФорма.ИтогоОбщаяСтоимостьТР = ТемпИтогоОбщаяСтоимостьТР;
	ЭтаФорма.ИтогоТрудозатратыКоличество = ТемпИтогоТрудозатратыКоличество;
	
	//
	
	// Вертикальные итоги
	
	// Установим флаг факта пересчета в Истина,чтобы в некоторых случаях не выполнять код лишний раз.
	Если НЕ ПризнакФактаПересчета = Неопределено Тогда
		ПризнакФактаПересчета = Истина;
	КонецЕсли;
	
	ТаблицаРаспределения = "ТрудовыеРесурсы";
	
	ЭтаФорма[ТаблицаРаспределения + "КоличествоОстатокИтог"] = 0;
	ЭтаФорма[ТаблицаРаспределения + "КоличествоРаспределеноИтог"] = 0;
	
	Если ЭтаФорма.УровеньПланированияОкончательный Тогда
		НайденныеСтроки = ЭтаФорма.Объект[ТаблицаРаспределения].НайтиСтроки(
			Новый Структура("УровеньПланирования",
			ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный")));
	Иначе
		НайденныеСтроки = ЭтаФорма.Объект[ТаблицаРаспределения].НайтиСтроки(
			Новый Структура("УровеньПланирования",
			ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный")));
		НайденныеСтрокиПустые = ЭтаФорма.Объект[ТаблицаРаспределения].НайтиСтроки(
			Новый Структура("УровеньПланирования",
			ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.ПустаяСсылка")));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НайденныеСтроки, НайденныеСтрокиПустые);
	КонецЕсли;
	
	ПрограммноСозданныеЭлементы = упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(ЭтаФорма, ТаблицаРаспределения);		
	Для каждого ЭлементСпискаПрограммно Из ПрограммноСозданныеЭлементы Цикл

		Счетчик = 0;
		ПериодЗашифрованный = упоРаботаСФормамиКлиентСервер.ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
		ИмяКолонкиКоличество = "Количество_" + ТаблицаРаспределения + "_" + Формат(ПериодЗашифрованный, "ДФ=MM_yyyy");				
		
		ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = 0;		 
		
		Для каждого СтрокаРаспределения Из НайденныеСтроки Цикл
			
			Если Счетчик = 0 Тогда
				ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = 0;		 
			КонецЕсли;
			
			Если Не СтрокаРаспределения.СпособПривязки =
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда 
				Продолжить;
			КонецЕсли;
			
			КоэффициентНормирования = КоэффициентЕдиницыНормирования(ЭтаФорма, СтрокаРаспределения.ЕдиницаНормирования);
			ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = ЭтаФорма["Всего_" + ИмяКолонкиКоличество] 
				+ СтрокаРаспределения[ИмяКолонкиКоличество] * КоэффициентНормирования;
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Горизонтальные итоги	
	
	Для Каждого СтрокаРаспределения Из НайденныеСтроки Цикл
		
		Если Не СтрокаРаспределения.СпособПривязки = 
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда 
			Продолжить;
		КонецЕсли;
		
		ВсегоРаспределеноКоличество = 0;
		
		Для Каждого ЭлементСпискаПрограммно Из ПрограммноСозданныеЭлементы Цикл
		
			ПериодЗашифрованный = упоРаботаСФормамиКлиентСервер.ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
			
			ИмяКолонкиКоличество = "Количество_" + ТаблицаРаспределения + "_" + Формат(ПериодЗашифрованный, "ДФ=MM_yyyy");				
			ВсегоРаспределеноКоличество = ВсегоРаспределеноКоличество + СтрокаРаспределения[ИмяКолонкиКоличество];
			
			ВременноеИтоговоеКоличество = 0;
			Для Каждого СтрДляРасчетаИтоговогоКоличества Из НайденныеСтроки Цикл
				КоэффициентНормирования = КоэффициентЕдиницыНормирования(ЭтаФорма, СтрДляРасчетаИтоговогоКоличества.ЕдиницаНормирования);
				ВременноеИтоговоеКоличество = ВременноеИтоговоеКоличество + СтрДляРасчетаИтоговогоКоличества[ИмяКолонкиКоличество] 
					* КоэффициентНормирования;
			КонецЦикла;
			ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = Формат(ВременноеИтоговоеКоличество, "ЧДЦ=2");
							
		КонецЦикла;
		
		СтрокаРаспределения.КоличествоРаспределено = ВсегоРаспределеноКоличество;
		СтрокаРаспределения.КоличествоОстаток = СтрокаРаспределения.Количество - ВсегоРаспределеноКоличество;
		
		КоэффициентНормирования = КоэффициентЕдиницыНормирования(ЭтаФорма, СтрокаРаспределения.ЕдиницаНормирования);
		ЭтаФорма[ТаблицаРаспределения + "КоличествоОстатокИтог"] = ЭтаФорма[ТаблицаРаспределения + "КоличествоОстатокИтог"] 
			+ СтрокаРаспределения.КоличествоОстаток * КоэффициентНормирования;
		ЭтаФорма[ТаблицаРаспределения + "КоличествоРаспределеноИтог"] = ЭтаФорма[ТаблицаРаспределения + "КоличествоРаспределеноИтог"]
			+ СтрокаРаспределения.КоличествоРаспределено * КоэффициентНормирования;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуВПериодахРаспределенияТрудовыхРесурсовПоСтроке(СтрокаРаспределения)
	
	Если СтрокаРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПрограммноСозданныеЭлементы = упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(ЭтаФорма, "ТрудовыеРесурсы");
	Для каждого ЭлементСпискаПрограммно Из ПрограммноСозданныеЭлементы Цикл
		
		ПериодЗашифрованный = упоРаботаСФормамиКлиентСервер.ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
		
		ИмяКолонкиКоличество = "Количество_ТрудовыеРесурсы_" + Формат(ПериодЗашифрованный, "ДФ=MM_yyyy");
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриСменеУровняПланирования(ПриОткрытии = Ложь)
	
	НуженПересчетИтогов = УстановитьОтборСтрокВТЧТрудовыеРесурсы(ПриОткрытии);
	Если НуженПересчетИтогов Тогда
		ПересчитатьИтогиПоТрудовымРесурсам(ЭтаФорма);
	КонецЕсли;
	
	УстановитьВидимостьКомандыРолиТРЗаполнитьПоПредварительномуУровнюПланирования();
		
КонецПроцедуры

&НаКлиенте	
Процедура Подключаемый_РаспределениеТрудовыхРесурсовПоМесяцамКоличествоПриИзменении(Элемент)
		
	ТекущиеДанныеТР = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	Если ТекущиеДанныеТР <> Неопределено Тогда
		
		СтоимостьТекущая = ТекущиеДанныеТР.Стоимость;
		ВнешняяСтоимостьТекущая = ТекущиеДанныеТР.ВнешняяСтоимость;
		
		ИмяРеквизитаТекущее = Элемент.Имя;
		
		КоличествоТекущее  = ТекущиеДанныеТР[ИмяРеквизитаТекущее];
		ОбщСтоимостьТекущая = КоличествоТекущее * СтоимостьТекущая;
		ОбщВнешняяСтоимостьТекущая = КоличествоТекущее * ВнешняяСтоимостьТекущая;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФиксациюКолонок(ИмяТЧ)
	
	КоличествоКолонокДляФиксацииСлева = 3;
	Элементы[ИмяТЧ].ФиксацияСлева = КоличествоКолонокДляФиксацииСлева;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗадачуРодителя()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗапретВыбораЧужойЗадачи", Истина);
	ПараметрыФормы.Вставить("ВыбиратьТолькоЭтапы", Истина);
	ПараметрыФормы.Вставить("Проект", Объект.Проект);
	ПараметрыФормы.Вставить("ТекЗадача", Объект.ЗадачаРодитель);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьЗадачуРодителяОсновная", ЭтотОбъект);
	ОткрытьФорму("Обработка.упоВыборПроектнойЗадачи.Форма.ОсновнаяФормаУправляемая", ПараметрыФормы,,,,, ОписаниеОповещения);
		
КонецПроцедуры

// Установить общий профиль основная.
//
// Параметры:
//  ОбщийПрофиль			 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура УстановитьОбщийПрофильОсновная(ОбщийПрофиль, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ОбщийПрофиль) Тогда      
		Возврат;
	КонецЕсли; 
	
	ИмяТаблицы = ДополнительныеПараметры.ИмяТаблицы;
	ТабличнаяЧасть = Неопределено;
	
	Если ИмяТаблицы = "Доходы" Тогда      
		ТабличнаяЧасть = Объект.ПланДоходов;
	ИначеЕсли ИмяТаблицы = "Расходы" Тогда      
		ТабличнаяЧасть = Объект.ПланРасходов;
	ИначеЕсли ИмяТаблицы = "ТрудовыеРесурсы" Тогда
		ТабличнаяЧасть = Объект.ТрудовыеРесурсы;
	ИначеЕсли ИмяТаблицы = "Субпродукты" Тогда
		ТабличнаяЧасть = Объект.Субпродукты;	
	Иначе
		Возврат;
	КонецЕсли; 
	
	Если ТабличнаяЧасть.Количество() = 0 Тогда      
		Возврат;
	КонецЕсли; 
	
	ДополнительныеПараметры2 = Новый Структура;
	ДополнительныеПараметры2.Вставить("ТабличнаяЧасть",ТабличнаяЧасть);
	ДополнительныеПараметры2.Вставить("ОбщийПрофиль",ОбщийПрофиль);
	
	Для каждого СтрокаДанных Из ТабличнаяЧасть Цикл
		
		Если НЕ СтрокаДанных.ПрофильРаспределения = ОбщийПрофиль И ЗначениеЗаполнено(СтрокаДанных.ПрофильРаспределения) Тогда 
			
			ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщийПрофильОсновнаяЗавершение", ЭтотОбъект,ДополнительныеПараметры2);
			
			ПоказатьВопрос(ОписаниеОповещения, "Заменить уже установленные профили распределения на" + Символы.ПС + "'" + ОбщийПрофиль 
					+ "'?", РежимДиалогаВопрос.ДаНет, 360, КодВозвратаДиалога.Да);
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьОбщийПрофильОсновнаяЗавершение(КодВозвратаДиалога.Да,ДополнительныеПараметры2);
		
КонецПроцедуры

// Установить общий профиль основная завершение.
//
// Параметры:
//  Ответ					 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура УстановитьОбщийПрофильОсновнаяЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда      
		ЗаменятьТекущие = Истина;
	Иначе
		ЗаменятьТекущие = Ложь;
	КонецЕсли;
	
	Для каждого СтрокаДанных Из ДополнительныеПараметры.ТабличнаяЧасть Цикл
		
		Если (СтрокаДанных.ПрофильРаспределения = ДополнительныеПараметры.ОбщийПрофиль И ЗначениеЗаполнено(СтрокаДанных.ПрофильРаспределения))
			Или ЗаменятьТекущие Тогда      
			
			СтрокаДанных.ПрофильРаспределения = ДополнительныеПараметры.ОбщийПрофиль;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Выбрать задачу родителя основная.
//
// Параметры:
//  ВыбранныйРодитель		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ВыбратьЗадачуРодителяОсновная(ВыбранныйРодитель, ДополнительныеПараметры) Экспорт
	
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(ВыбранныйРодитель) Тогда
		Если ВыбранныйРодитель = Объект.Ссылка Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru = 'Нельзя выбрать в качестве родителя эту же проектную задачу!'");
			Сообщение.Сообщить();
		Иначе
			Объект.ЗадачаРодитель = ВыбранныйРодитель;     
			ОбработкаВыбораРодителяЗадачиСервер();
						
			Если ПроектныеОпции.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя Тогда
				Свойство = "Объект";
				ЗначениеСвойство = упоПроектыИЗадачиВызовСервера.ПолучитьСвойствоПроектнойЗадачи(ВыбранныйРодитель, Свойство);
				Если Объект.Объект <> ЗначениеСвойство Тогда 
					ТекстВопроса = упоРаботаСФормамиКлиент.ПолучитьТекстВопросаОЗаменеЗначенияРеквизитаОбъект();
					ДопПараметры = Новый Структура("Объект", ЗначениеСвойство);
					
					ОписаниеОповещения = Новый ОписаниеОповещения("ЗаменитьЗначениеОбъектИзРодительскойЗадачиЗавершение", ЭтотОбъект, ДопПараметры);	
					ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПараметрыДинамическихСписков()
	
	ПроектПЗ = Неопределено;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Проекты.Ссылка
		|ИЗ
		|	Справочник.Проекты КАК Проекты
		|ГДЕ
		|	Проекты.СсылкаНаПроектнуюЗадачу = &СсылкаНаПроектнуюЗадачу";
		Запрос.УстановитьПараметр("СсылкаНаПроектнуюЗадачу", Объект.Ссылка);
		РезЗапроса = Запрос.Выполнить();
		Если Не РезЗапроса.Пустой() Тогда
			Выборка = РезЗапроса.Выбрать();
			Если Выборка.Следующий() Тогда
				ПроектПЗ = Выборка.ссылка;		
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Показатели.Параметры.УстановитьЗначениеПараметра("Проект", ПроектПЗ);
	
КонецФункции

&НаСервере
Функция ЗаполнитьЗеркало()
	
	Зеркало = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(Объект.Ссылка);
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьЕдИзмеренияВСтрокеИлиСтруктуре(СтрокаИлиСтруктура) 
	
	СтрокаИлиСтруктура.ЕдиницаНормирования = 
		упоЗаполнениеИПодборСервер.ПолучитьЕдиницуИзмеренияНоменклатуры(СтрокаИлиСтруктура.Ресурс);
		
КонецФункции

&НаКлиенте
Процедура ПересчитатьИтогиПоТаблицеПП() 
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
		"РаспределениеОбъемов", "ОбщСтоимость", Истина, Ложь);
	
	РассчитатьИтогиПоТаблице("Субпродукты");
	ПересчитатьИтогиКолонокПП();

КонецПроцедуры

&НаСервере
Процедура СкрытьЭлементыСвязиСЗаказами()
	
	ЭлементыСвязи = Новый Массив;
	ЭлементыСвязи.Добавить("МатериальныеРесурсыКомандыСвязьСЗаказом");
	ЭлементыСвязи.Добавить("МатериальныеРесурсыКомандаЗаполнитьМатЗатратыПоПлануВыпуска");
	ЭлементыСвязи.Добавить("МатериальныеРесурсыСвязьСЗаказом");
	ЭлементыСвязи.Добавить("Субпродукты_СпособПривязки");
	ЭлементыСвязи.Добавить("Субпродукты_ЗадержкаЗаказа");
	ЭлементыСвязи.Добавить("СубпродуктыСвязьСЗаказом");
	
	Для Каждого ЭлементСвязи Из ЭлементыСвязи Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
			ЭлементСвязи, "Видимость", Ложь);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОтображениеДополнительныхСтрокВПланеДоходовИПланеРасходов

&НаКлиенте
Процедура ДобавитьИнформационныеСтрокиВПланДоходовИРасходов(ОбновитьПланРасходов = Истина, ОбновитьПланДоходов = Истина, 
	ПредварительноОчищатьИнформационныеСтроки = Ложь, ТранслироватьБДРВБДДС = Истина, СформироватьИтогПоФинПланам = Истина)
	
	Если Не ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбновитьПланДоходов Тогда
		Если ПредварительноОчищатьИнформационныеСтроки Тогда
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланДоходов", "РаспределениеДоходов");
		КонецЕсли;
		
		Если ВключитьСубпродуктыВПланДоходов() Тогда
			ПеренестиСтрокиОбъемовВДоходыДляИнформации(); 
			РассчитатьИтогиПоТаблице("ПланДоходов", , Ложь, "Сумма");
		КонецЕсли;
	КонецЕсли;
	
	Если ОбновитьПланРасходов Тогда
		
		Если ПредварительноОчищатьИнформационныеСтроки Тогда
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланРасходов", "РаспределениеРасходов");
		КонецЕсли;
		
		Если ВключитьМатРесурсыВПланРасходов() Тогда
			ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();
			РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
		КонецЕсли;
		Если ВключитьДопЗатратыВПланРасходов() Тогда
			ПеренестиСтрокиДопЗатратВРасходыДляИнформации();
			РассчитатьИтогиПоТаблице("ПланРасходов", , Ложь, "Сумма");
		КонецЕсли;
		
		Для каждого Строка Из Объект.ПланРасходов Цикл
			Строка.ЭтоРольТрудовогоРесурса = Строка.ИсточникПлана =
				ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты");
		КонецЦикла;
		
	КонецЕсли;
	
	// Отсортируем данные в ТЧ Плана расходов.
	ТекстСортировки = "ЭтоРольТрудовогоРесурса Возр, Сумма Убыв";
	Объект.ПланРасходов.Сортировать(ТекстСортировки);
	
	// Перенос данных для варианта без прав на модификацию формы (режим "Только просмотр").
	Если ЗначениеЗаполнено(СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными) Тогда 
		 
		МассивДанныхЗаполнения = Новый Массив;
		Для каждого ЭлементСтруктуры Из СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными Цикл
			Если ЗначениеЗаполнено(ЭлементСтруктуры.Значение) Тогда
				СтруктураЗаполнения = Новый Структура("ИмяТаблицы, Таблица, СтрокиЗаполнения",
									ЭлементСтруктуры.Ключ,
									Объект[ЭлементСтруктуры.Ключ],
									ЭлементСтруктуры.Значение);
				МассивДанныхЗаполнения.Добавить(СтруктураЗаполнения);
			КонецЕсли;
		КонецЦикла;
		
		МассивДанныхЗаполненых = ДобавитьЗаполнитьНовыеСтрокиТаблицНаСервере(МассивДанныхЗаполнения);
		
		Для Каждого СтруктураДанныхЗаполненые Из МассивДанныхЗаполненых Цикл
			КопироватьДанныеФормы(СтруктураДанныхЗаполненые.ТаблицаЗаполненая, Объект[СтруктураДанныхЗаполненые.ИмяТаблицы]);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТранслироватьБДРВБДДС Тогда
		Если ВключитьПланДоходовВБДДС() Или ВключитьПланРасходовВБДДС() Тогда
			ИмяТаблицы = ИмяТаблицыБДРДляОбновленияДДС(Объект.ВключитьПланДоходовВБДДС, Объект.ВключитьПланРасходовВБДДС); 
			ПеренестиСтрокиДоходовРасходовВДДСДляИнформации(ИмяТаблицы);
		КонецЕсли;
	КонецЕсли;
	
	Если СформироватьИтогПоФинПланам Тогда
		СформироватьИтогПоФинПланам(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСтрокиОбъемовВДоходыДляИнформации()
	
	Если НЕ ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИсходнаяСтрока Из Объект.Субпродукты Цикл
		упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект, ИсходнаяСтрока, "Субпродукты");
		
		упоРаботаСФормамиКлиент.ПеренестиСтрокуИзОсновнойТаблицыВСвязаннуюСПодчиненными(Объект, ИсходнаяСтрока,
			"РаспределениеОбъемов", "ПланДоходов", "РаспределениеДоходов",
			ТолькоПросмотр, СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными);
	КонецЦикла;
	
	СвернутьСтрокиРаспределенияДоходовРасходов("РаспределениеДоходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСтрокиМатРесурсовВРасходыДляИнформации()
	
	Если НЕ ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИсходнаяСтрока Из Объект.МатериальныеРесурсы Цикл
		упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект, ИсходнаяСтрока, "МатериальныеРесурсы");
		
		упоРаботаСФормамиКлиент.ПеренестиСтрокуИзОсновнойТаблицыВСвязаннуюСПодчиненными(Объект, ИсходнаяСтрока,
			"РаспределениеПотребностей", "ПланРасходов", "РаспределениеРасходов",
			ТолькоПросмотр, СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными);
	КонецЦикла;
	
	СвернутьСтрокиРаспределенияДоходовРасходов("РаспределениеРасходов");
	
	// Обновим ручную трансляцию в распределении расходов.
	ЕстьРучноеРаспределение = ВТаблицеЕстьСтрокиСРучнымРаспределениемПоПериодам(Объект, "РаспределениеРасходов");
	НеобходимоТранслироватьРучноеРаспределениеМатЗатратВРасходы = Не ПроектныеОпции.РасходыПоНатуральнымПоказателям;
	СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Истина, НеобходимоТранслироватьРучноеРаспределениеМатЗатратВРасходы,
		Ложь, Ложь, ЕстьРучноеРаспределение);
	Если НеобходимоТранслироватьРучноеРаспределениеМатЗатратВРасходы И ЕстьРучноеРаспределение Тогда
		упоРаботаСФормамиКлиент.ОбновитьРучноеРаспределениеЗатратВРасходы(Объект,
			"ПланРасходов",
			"РаспределениеРасходов",
			"РаспределениеПотребностей",
			"РаспределениеРасходовПоПериодам",
			СоответствиеРазделовКолонкиПоПериодам.РаспределениеРасходов);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСтрокиДопЗатратВРасходыДляИнформации()
	
	Если Не ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС Тогда
		Возврат;
	КонецЕсли;
			
	ДополнительныеЗначения = Новый Структура("Валюта", мВалютаУправленческогоУчета);
	
	Для Каждого ИсходнаяСтрока Из Объект.ДополнительныеЗатраты Цикл		
		упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект, ИсходнаяСтрока, "ДополнительныеЗатраты");		
		
		упоРаботаСФормамиКлиент.ПеренестиСтрокуИзОсновнойТаблицыВСвязаннуюСПодчиненными(Объект, ИсходнаяСтрока,
			"РаспределениеДополнительныхЗатрат", "ПланРасходов", "РаспределениеРасходов", 
			ТолькоПросмотр, СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными, ДополнительныеЗначения);
	КонецЦикла;
	
	СвернутьСтрокиРаспределенияДоходовРасходов("РаспределениеРасходов");

	ЕстьРучноеРаспределение = ВТаблицеЕстьСтрокиСРучнымРаспределениемПоПериодам(Объект, "РаспределениеРасходов");
	СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Ложь, Истина, Ложь, Истина, ЕстьРучноеРаспределение);
	
	Если ЕстьРучноеРаспределение Тогда
		упоРаботаСФормамиКлиент.ОбновитьРучноеРаспределениеЗатратВРасходы(Объект,
			"ПланРасходов",
			"РаспределениеРасходов",
			"РаспределениеДополнительныхЗатрат",
			"РаспределениеРасходовПоПериодам",
			СоответствиеРазделовКолонкиПоПериодам.РаспределениеРасходов);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтрокиОтраженияТрудозатратВБДР()
	
	Отбор = Новый Структура("ИсточникПлана", ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Трудозатраты"));
	НайденныеСтроки = Объект.ПланРасходов.НайтиСтроки(Отбор);	
	
	МассивУдаляемыхОсновных = Новый Массив;
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		МассивУдаляемыхОсновных.Добавить(НайденнаяСтрока);		
		упоРаботаСФормамиКлиент.ОчиститьПеренесенныеСтрокиВПодчиненнойТЧ(НайденнаяСтрока.ИндексСтрокРаспределения, Объект.РаспределениеРасходов);		
	КонецЦикла;	
	
	Для Каждого УдаляемаяОсновная Из МассивУдаляемыхОсновных Цикл
		Объект.ПланРасходов.Удалить(УдаляемаяОсновная);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УдалитьСтрокиОтраженияБДРвДДС(Объект, ИмяТаблицы = Неопределено)
	
	ОчиститьПланРасходов = ИмяТаблицы = Неопределено Или ИмяТаблицы = "ПланРасходов";
	ОчиститьПланДоходов = ИмяТаблицы = Неопределено Или ИмяТаблицы = "ПланДоходов";
	
	Если ОчиститьПланРасходов Тогда
		Отбор = Новый Структура("ИсточникПлана", ПредопределенноеЗначение("Перечисление.упоИсточникПланаДДС.Расходы"));
		НайденныеСтроки = Объект.ДвиженияДенежныхСредств.НайтиСтроки(Отбор);	
		
		Сч = НайденныеСтроки.ВГраница();
		Пока Сч >= 0 Цикл
			Объект.ДвиженияДенежныхСредств.Удалить(НайденныеСтроки[Сч]);
			Сч = Сч - 1;
		КонецЦикла;
	КонецЕсли;	
	
	Если ОчиститьПланДоходов Тогда
		Отбор = Новый Структура("ИсточникПлана", ПредопределенноеЗначение("Перечисление.упоИсточникПланаДДС.Доходы"));
		НайденныеСтроки = Объект.ДвиженияДенежныхСредств.НайтиСтроки(Отбор);	
		
		Сч = НайденныеСтроки.ВГраница();
		Пока Сч >= 0 Цикл
			Объект.ДвиженияДенежныхСредств.Удалить(НайденныеСтроки[Сч]);
			Сч = Сч - 1;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТЧОтПеренесенныхСтрок(ИмяКоманды)
	
	Если ИмяКоманды = "ДействиеПодобрать_ПланДоходов_ПоСтатьям"
		Или ИмяКоманды = "ДействиеПодобрать_ПланДоходов_ПоКонтрагентам" Тогда
		
		упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
			"ПланДоходов", "РаспределениеДоходов");
	
	ИначеЕсли ИмяКоманды = "ДействиеПодобрать_ПланРасходов_ПоСтатьям"
		Или ИмяКоманды = "ДействиеПодобрать_ПланРасходов_ПоКонтрагентам" Тогда
				
		упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
			"ПланРасходов", "РаспределениеРасходов");
		
	КонецЕсли;
	
КонецПроцедуры

