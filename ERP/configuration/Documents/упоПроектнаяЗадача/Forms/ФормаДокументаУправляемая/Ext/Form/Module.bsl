
#Область ОписаниеПеременных

&НаКлиенте
Перем ОбновитьДоходыВДДС, ОбновитьРасходыВДДС, ЕдиницаНормированияДо, ВСубпродуктахИзмененаПроектнаяПродукция;

&НаКлиенте
Перем СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриСозданииНаСервере: Начало процедуры");
	
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриСозданииНаСервере: Перед проверкой защиты");
	
 	упоФункцииЗащитыСервер.МожноИспользоватьОбъектИспользующийЗащищенныйКод(ЭтаФорма);
	
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриСозданииНаСервере: После проверки защиты");
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка);
	
	ОбновитьЕдиницыВремениПроектаПоУмолчанию(ЭтаФорма);
	ИнициализацияФормыСервер();
	
	ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам = Новый Структура;
	
	ПроверятьОбъемы = Истина;
	ПроверятьДоходы = Истина;
	ПроверятьПотребности = Истина;
	ПроверятьРасходы = Истина;
	ПроверятьРолиТрудовыхРесурсов = Истина;
	ПроверятьДопЗатраты = Истина;
	СоздатьДопЭлементыРаспределенияДоходов(ПроверятьОбъемы, ПроверятьДоходы, ПроверятьПотребности, 
		ПроверятьРасходы, ПроверятьРолиТрудовыхРесурсов, ПроверятьДопЗатраты);
	
	упоРаботаСФормамиСервер.ДобавитьВызовОтчетовПроектаНаФорму(ЭтаФорма, 
		Элементы.ПодменюОтчеты, "КомандаОтчетаПроекта", "ОткрытьОтчет");
		
	упоИнтеграция.ДобавитьКомандуОткрытияЗамененнойФормыПроекта(ЭтотОбъект);
	
	упоРаботаСФормамиСервер.ПроверитьВерсияПрограммыОбновленаДинамическиЗаблокироватьОбъект(ЭтотОбъект);
	
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриСозданииНаСервере: Конец процедуры");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриОткрытии: Начало процедуры");
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);
	
	ИнициализацияФормыКлиент(Истина);
	
	ФормаОткрыта = Истина;
	
	ИнициализироватьНаКлиентеПриНеобходиомости();
			
	упоОтладкаКлиентСервер.ФиксВремя("упоПроектнаяЗадача.ФормаДокументаУправляемая.ПриОткрытии: Конец процедуры");
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") 
		И ВыбранноеЗначение.Свойство("ИмяСобытия") 
		И ВыбранноеЗначение.ИмяСобытия = "Закрытие_ФормаВыборПланаВыпуска" Тогда
		
		ЗаполнитьПланМатЗатратПоВыбранномуПлануВыпуска(ВыбранноеЗначение);
		
	Иначе
		
		ОбработкаВыбораНаСервере(ВыбранноеЗначение);
			
	КонецЕсли;
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПланМатЗатратПоВыбранномуПлануВыпуска(ВыбранноеЗначение)
	
	Объект.МатериальныеРесурсы.Очистить();
	Объект.РаспределениеПотребностей.Очистить();  
	
	упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, "ПланРасходов", "РаспределениеРасходов", 
							ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты"));
							
	ЗаполнитьПланМатЗатратПоВыбранномуПлануВыпускаСервер(ВыбранноеЗначение);
	
	Если Объект.ВключитьМатРесурсыВПланРасходов Тогда
		ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();									
	КонецЕсли;
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
							
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПланМатЗатратПоВыбранномуПлануВыпускаСервер(ВыбранноеЗначение)
	
	НоменклатураБезКомплектаций = Новый Массив;
	
	Для Каждого ДанныеНоменклатуры Из ВыбранноеЗначение.ПланВыпуска Цикл
		Комплектация = ДанныеНоменклатуры.Комплектация;
		Если Не ЗначениеЗаполнено(Комплектация) Тогда
			НоменклатураБезКомплектаций.Добавить(ДанныеНоменклатуры.Номенклатура);
			Продолжить;
		КонецЕсли;
		ПараметрыКомплектации = Новый Структура("ВариантКомплектацииНоменклатуры", Комплектация);
		ПараметрыКомплектации.Вставить("НоменклатураНабора", ДанныеНоменклатуры.Номенклатура);
		ПараметрыКомплектации.Вставить("ХарактеристикаНабора", Неопределено);
		МодульНаборов = ОбщегоНазначения.ОбщийМодуль("НаборыВызовСервера");
		Комплектующие = МодульНаборов.Комплектующие(ПараметрыКомплектации, Новый Структура); 		
		Для Каждого ДанныеКомплектующего Из Комплектующие Цикл
			СтрокаМатЗатрат = Объект.МатериальныеРесурсы.Добавить();
			ВалютаСтруктура = Новый Структура("мВалютаУправленческогоУчета", мВалютаУправленческогоУчета);
			упоФункцииОбщегоНазначенияСервер.ЗаполнитьСтрокуПоУмолчанию(ВалютаСтруктура,
				Объект.Проект, "КонтрагентЗатрат", "ДоговорЗатрат", СтрокаМатЗатрат, "МатериальныеРесурсы");
			СтрокаМатЗатрат.Ресурс = ДанныеКомплектующего.Номенклатура;
			СтрокаМатЗатрат.Количество = ДанныеНоменклатуры.Количество * ДанныеКомплектующего.Количество;
			СтрокаМатЗатрат.Стоимость = ДанныеКомплектующего.Цена;
			СтрокаМатЗатрат.ОбщСтоимость = СтрокаМатЗатрат.Стоимость * СтрокаМатЗатрат.Количество;
			СтрокаМатЗатрат.ЕдиницаНормирования = ДанныеКомплектующего.ЕдиницаИзмерения;
		КонецЦикла;			
	КонецЦикла;
	
	МатериалыИОборудование_ПересчитатьПоНормеСервер();
	
	Если НоменклатураБезКомплектаций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоменклатураСтрокой = СтрСоединить(НоменклатураБезКомплектаций, ",");
	ТекстСообщения = НСтр("ru = 'Не заполнен план потребностей по  ''''%1'''' по причине отсутствия комплектации'"); 
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НоменклатураСтрокой);
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтотОбъект.ПроверкиПередЗаписьюПройдены Тогда
		ВыполнитьОбязательныеДействияИПроверкиПередЗаписью(Отказ);
	Иначе
		ОбновитьПризнакПрохожденияПроверокПередЗаписью(Отказ);
	КонецЕсли;
	
	ПроверитьЗаполнениеТаблиц(Отказ);
	
	УжеБылаПроверкаРаспределения = ПараметрыЗаписи.Свойство("УжеБылаПроверкаРаспределения")
								И ПараметрыЗаписи.УжеБылаПроверкаРаспределения; 
	
	Если Не УжеБылаПроверкаРаспределения Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("РежимЗаписи", ПараметрыЗаписи.РежимЗаписи);
		ДопПараметры.Вставить("Закрыть", Истина);
		ДопПараметры.Вставить("УжеБылаПроверкаРаспределения", Истина);
		Если ПараметрыЗаписи.Свойство("ОткрытьФормированиеЗаказов") Тогда
			ДопПараметры.Вставить("ОткрытьФормированиеЗаказов", ПараметрыЗаписи.ОткрытьФормированиеЗаказов);
		КонецЕсли;
		ПроверитьРаспределение(Отказ, ДопПараметры);
		
	КонецЕсли;
	
	ТекущийОбъект = Объект;
	ПроверитьТрансляциюБДРПередЗаписьюНаСервере(ТекущийОбъект, Отказ, ПараметрыЗаписи);
	
	Если Не Отказ Тогда
		УдалитьСтрокиТрансляции();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ТекущийОбъект.ПроверитьДанныеПередЗаписью(Отказ);
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	Если ЗначениеЗаполнено(АдресСтруктурыКартинокОписания) Тогда
		ТекущийОбъект.СтруктураКартинокОписания = Новый ХранилищеЗначения(
				ПолучитьИзВременногоХранилища(АдресСтруктурыКартинокОписания));
	КонецЕсли;
	
	Если мЗаменятьЗначениеРеквизитаОбъектУПотомков Тогда
		Если ТекущийОбъект.ДополнительныеСвойства.Свойство("ЗаменятьЗначениеРеквизитаОбъектУПотомков") Тогда
			ТекущийОбъект.ДополнительныеСвойства.ЗаменятьЗначениеРеквизитаОбъектУПотомков = мЗаменятьЗначениеРеквизитаОбъектУПотомков;
		Иначе
			ТекущийОбъект.ДополнительныеСвойства.Вставить("ЗаменятьЗначениеРеквизитаОбъектУПотомков ", мЗаменятьЗначениеРеквизитаОбъектУПотомков);
		КонецЕсли;
	КонецЕсли;
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоИнтерактивнаяЗапись", Истина);
	
	ЗакэшироватьДопРеквизитыПредусловияЗадачиПередЗаписью(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	УстановитьКодСДР();
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_ДобавитьФункцииСобытияВПулНаВыполнение("ОбновитьВсе", ЭтаФорма);
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
	СоздатьДопЭлементыРаспределенияДоходов(Истина, Истина, Истина, Истина, Истина, Истина);
	
	ЗаполнитьПараметрыДинамическихСписков();
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	ЗаполнитьЗеркало();
	
	ОбновитьДопДанныеЗадачи();
	
	ПеречитатьКэшДопРеквизитыПредусловияЗадачиПослеЗаписи(ТекущийОбъект);
	
	ЭтоНовый = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьНадписьПоследняяМодификация();
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтаФорма);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УстановитьЗаголовокФормы(ЭтаФорма, Объект.НазваниеПроектнойЗадачи, Объект.ЗадачаОтменена);
		
	ПересчитатьИтогиВПодчиненныхТаблицах();
	
	// Сброим флаг пересчета в распределении ТР, чтоб первый "пересчет" снова мог произойти.
	ЕстьПересчетИтоговВРаспределенииТрудовыхРесурсовПоПериодам = Ложь;
	ПересчитатьИтогиПоТрудовымРесурсам(ЭтаФорма);
	
	// Оповещаем до добавления информационных строк в ПланДоходов и ПланРасходов, иначе строки затрутся.
	Оповестить("ЗаписанаЗадачаПроекта", Новый Структура("ПроектнаяЗадача, Проект", Объект.Ссылка, Объект.Проект), ЭтаФорма);
	
	Если РежимВыбораЗеркала Тогда
		РежимВыбораЗеркала = Ложь;
		ЗакрыватьПриВыборе = Ложь;
		ОповеститьОВыборе(Зеркало);
		ЭтаФорма.ВладелецФормы = Неопределено;
		ЗакрыватьПриВыборе = Истина;
	КонецЕсли;
	
	// После записи снова перенесем строки из других ТЧ в ПланДоходов и ПланРасходов
	// для визуализации, если установлен соответствующий признак.
	ДобавитьИнформационныеСтрокиВПланДоходовИРасходов();
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект,
																	ЭтотОбъект,
																	"РаспределениеРасходов",
																	"ПланРасходов",
																	"ИндексСтрокиРаспределенияРасходов",
																	Ложь);
	
	УстановитьДоступностьДоговоровИсполнителей();
	
	упоПроектыИЗадачиКлиент.ОбновитьКэшСвязанныхЭлементов("ПроектнаяЗадача", Объект.Ссылка);
	
	Если ДоступенФункционалПроектнаяПродукция Тогда
		ОбновитьПризнакПроектнойПродукцииВПланеВыпуска();
	КонецЕсли;

	УстановитьВозможностьРедактированияСтрокиПроектнойПродукции();
	
	// {УПФ}
	ПерезаполнитьЗаказы();
	// {/УПФ}
	
КонецПроцедуры 

&НаКлиенте
Процедура СобытиеИзмененияПоляОбъектаЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		мЗаменятьЗначениеРеквизитаОбъектУПотомков = Истина;
	Иначе
		мЗаменятьЗначениеРеквизитаОбъектУПотомков = Ложь;
	КонецЕсли;

КонецПроцедуры
	
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗакрытием(ЭтаФорма, 
													Объект, 
													Отказ, 
													СтандартнаяОбработка, 
													ЗавершениеРаботы, 
													ТекстПредупреждения);
	
КонецПроцедуры

