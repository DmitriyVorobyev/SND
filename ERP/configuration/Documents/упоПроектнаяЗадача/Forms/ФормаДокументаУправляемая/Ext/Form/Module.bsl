	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ОбработкаСроковПриОбновлении", ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСрокиЗадачи()
	
	ТекстНетДанны = НСтр("ru = 'нет данных'");
	
	Если НЕ ЗначениеЗаполнено(мДанные_Сроки_НачалоПлан) Тогда      
		ТекПланНачало = ТекстНетДанны;
	Иначе
		ТекПланНачало = Формат(мДанные_Сроки_НачалоПлан, "ДФ=dd.MM.yyyy");
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(мДанные_Сроки_ЗавершениеПлан) Тогда      
		ТекПланОкончание = ТекстНетДанны;
	Иначе
		ТекПланОкончание = Формат(мДанные_Сроки_ЗавершениеПлан, "ДФ=dd.MM.yyyy");
	КонецЕсли; 	
	
	
	НадписьТекПланНачалоЗадачи = ТекПланНачало;
	НадписьТекПланОкончаниеЗадачи = ТекПланОкончание; 
	
	НадписьКритическийПуть = "";
	
	// также покажем на форме расчетные сроки проектной задачи
	
	РасчетныеСроки = Документы.упоПроектнаяЗадача.ПолучитьРасчетныеСроки(Объект.Ссылка);
	Если РасчетныеСроки = Неопределено Тогда      
		НадписьДатаРаннийСтарт = ТекстНетДанны;  
		НадписьДатаРаннийФиниш = ТекстНетДанны;  
		НадписьДатаПозднийСтарт = ТекстНетДанны;  
		НадписьДатаПозднийФиниш = ТекстНетДанны;  
	Иначе
		
		Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(РасчетныеСроки.ДатаРаннегоСтарта) Тогда      
			НадписьДатаРаннийСтарт = Формат(РасчетныеСроки.ДатаРаннегоСтарта, "ДФ=dd.MM.yyyy");  
		Иначе
			НадписьДатаРаннийСтарт = ТекстНетДанны;  
		КонецЕсли; 
		
		Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(РасчетныеСроки.ДатаРаннегоФиниша) Тогда      
			НадписьДатаРаннийФиниш = Формат(РасчетныеСроки.ДатаРаннегоФиниша, "ДФ=dd.MM.yyyy");  
		Иначе
			НадписьДатаРаннийФиниш = ТекстНетДанны;  
		КонецЕсли; 
		
		Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(РасчетныеСроки.ДатаПозднегоСтарта) Тогда      
			НадписьДатаПозднийСтарт = Формат(РасчетныеСроки.ДатаПозднегоСтарта, "ДФ=dd.MM.yyyy");  
		Иначе
			НадписьДатаПозднийСтарт = ТекстНетДанны;  
		КонецЕсли; 
		
		Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(РасчетныеСроки.ДатаПозднегоФиниша) Тогда      
			НадписьДатаПозднийФиниш = Формат(РасчетныеСроки.ДатаПозднегоФиниша, "ДФ=dd.MM.yyyy");  
		Иначе
			НадписьДатаПозднийФиниш = ТекстНетДанны;  
		КонецЕсли; 
		
		// Критический путь.
		ЗадачаНаКП = ЗначениеЗаполнено(РасчетныеСроки.ДатаРаннегоСтарта) И ЗначениеЗаполнено(РасчетныеСроки.ДатаПозднегоСтарта)
			И НачалоДня(РасчетныеСроки.ДатаПозднегоСтарта) = НачалоДня(РасчетныеСроки.ДатаРаннегоСтарта);
		Элементы.НадписьКритическийПуть.Видимость = ЗадачаНаКП;
		Если ЗадачаНаКП Тогда
			НадписьКритическийПуть = НСтр("ru = 'Задача находится на критическом пути'"); 
		КонецЕсли; 
		
	КонецЕсли;
	
	упоОтображениеУправляемойФормы.ФункцииОтображения_УдалитьФункциюИзПулаНаВыполнение("ВывестиСрокиЗадачи", ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатуЗаказаПотребности(текСтрока = Неопределено)
		
	упоУправлениеФормамиКлиент.ОбновитьДатуЗаказаПотребности(Объект, ТекСтрока);	
	
