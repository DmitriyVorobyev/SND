&НаКлиенте
Процедура ЗаполнитьСтруктуруСтрокиТЧТрудовыеРесурсы(СтруктураСтрокиТабличнойЧасти)
			
	СтруктураСтрокиТабличнойЧасти = Новый Структура();
	СтруктураСтрокиТабличнойЧасти.Вставить("Ресурс");
	СтруктураСтрокиТабличнойЧасти.Вставить("ЕдиницаНормирования");
	СтруктураСтрокиТабличнойЧасти.Вставить("Количество");	
	СтруктураСтрокиТабличнойЧасти.Вставить("Подразделение");
	СтруктураСтрокиТабличнойЧасти.Вставить("Стоимость");
	СтруктураСтрокиТабличнойЧасти.Вставить("ОбщСтоимость");
	СтруктураСтрокиТабличнойЧасти.Вставить("ВнешняяСтоимость");
	СтруктураСтрокиТабличнойЧасти.Вставить("ОбщВнешняяСтоимость");
	СтруктураСтрокиТабличнойЧасти.Вставить("СпособПривязки");
	
КонецПроцедуры

// Заполняет значение в ТЧ Общая завершение.
//
// Параметры:
//  Результат				 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ЗаполнитьЗначениевТЧОбщаяЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ДополнительныеПараметры.ИмяКоманды = "МатериалыИОборудование_ЗадержкаЗаказа" 
		 ИЛИ ДополнительныеПараметры.ИмяКоманды = "МатериалыИОборудование_СпособПривязки" Тогда
			
			упоУправлениеФормамиКлиент.ОбновитьДатуЗаказаПотребности(Объект);
			
		ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "Субпродукты_СпособПривязки"
			  ИЛИ ДополнительныеПараметры.ИмяКоманды = "Субпродукты_ЗадержкаЗаказа" Тогда
			
			упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаПланВыпуска(Объект);
			
		ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ПланДоходов_УстановитьОбщийПрофиль" Тогда
			
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланДоходов", "РаспределениеДоходов");
			Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
				ПеренестиСтрокиОбъемовВДоходыДляИнформации();
			КонецЕсли;
			
		ИначеЕсли ДополнительныеПараметры.ИмяКоманды = "ПланРасходов_УстановитьОбщийПрофиль" Тогда
			
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланРасходов", "РаспределениеРасходов");
			Если Объект.ВключитьМатРесурсыВПланРасходов Тогда
				ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПоНормеТРСервер()
	
	ЕстьНормаСтоимости 			= Не Объект.НормаСтоимостиТрудовыхРесурсов.Пустая();
	ЕстьВнешняяНормаСтоимости 	= Не Объект.ВнешняяНормаСтоимостиТрудовыхРесурсов.Пустая();
	НормыСтоимостиНеУказаны 	= Не (ЕстьНормаСтоимости Или ЕстьВнешняяНормаСтоимости);
	
	Если НормыСтоимостиНеУказаны Тогда
		Возврат;
	КонецЕсли;

	ТрудовыеРесурсы = Объект.ТрудовыеРесурсы.Выгрузить();
	
	Если ЕстьНормаСтоимости Тогда
		РассчитатьСтоимостьРесурсовПоНорме(ТрудовыеРесурсы, Объект.НормаСтоимостиТрудовыхРесурсов);
	КонецЕсли; 
	
	Если ЕстьВнешняяНормаСтоимости Тогда
		
		КолонкаСтоимость 		= ТрудовыеРесурсы.Колонки.Найти("Стоимость");
		КолонкаСтоимость.Имя 	= "Стоимость1";
		
		КолонкаОбщСтоимость 	= ТрудовыеРесурсы.Колонки.Найти("ОбщСтоимость");
		КолонкаОбщСтоимость.Имя = "ОбщСтоимость1";
		
		КолонкаСтоимостьВн 		= ТрудовыеРесурсы.Колонки.Найти("ВнешняяСтоимость");
		КолонкаСтоимостьВн.Имя 	= "Стоимость";
		КолонкаОбщСтоимостьВн 		= ТрудовыеРесурсы.Колонки.Найти("ОбщВнешняяСтоимость");
		КолонкаОбщСтоимостьВн.Имя 	= "ОбщСтоимость";
		
		РассчитатьСтоимостьРесурсовПоНорме(ТрудовыеРесурсы, 
			Объект.ВнешняяНормаСтоимостиТрудовыхРесурсов);
		
		КолонкаСтоимостьВн.Имя 		= "ВнешняяСтоимость";
		КолонкаОбщСтоимостьВн.Имя 	= "ОбщВнешняяСтоимость";
		КолонкаСтоимость.Имя 		= "Стоимость";
		КолонкаОбщСтоимость.Имя 	= "ОбщСтоимость";
				
	КонецЕсли;

	Объект.ТрудовыеРесурсы.Загрузить(ТрудовыеРесурсы);
	
КонецПроцедуры

// Расчет стоимости ресурсов по норме. Выполняется в привилегированном режиме в связи с тем, что для РПЗ
// с ограниченными правами роль упоЧтениеНормСтоимостиРесурсовРЛС дает права чтения норм только для сотрудников,
// диспетчером которых является РПЗ. Для избежания избыточной диспетчеризации снимаем ограничения RLS
// конкретно для этой кнопки заполнения.
//
// Параметры:
//  ТрудовыеРесурсы	 - 	ТаблицаЗначений - таблица ресурсов для пересчета.
//  НормаСтоимости	 - СправочикСсылка.упоНормыСтоимост	 - норма стоимости для пересчета.
//
&НаСервере
Процедура РассчитатьСтоимостьРесурсовПоНорме(ТрудовыеРесурсы, НормаСтоимости)
	
	УстановитьПривилегированныйРежим(Истина);
	упоРесурсыИНормыВызовСервера.обРассчитатьСтоимостьРесурсовПоНорме(ТрудовыеРесурсы,
		Объект,
		НормаСтоимости);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура МатериалыИОборудование_ПересчитатьПоНормеСервер()
	
	упоРаботаСФормамиСервер.ТаблицаРесурсов_ПересчитатьПоНормеСервер(Объект, "МатериальныеРесурсы");
	
КонецПроцедуры

&НаСервере
Процедура Субпродукты_ПересчитатьПоНормеСервер()
	
	упоРаботаСФормамиСервер.ТаблицаРесурсов_ПересчитатьПоНормеСервер(Объект, "Субпродукты", "НормаСтоимостиОбъемы", 
		Истина, "РаспределениеОбъемов");

КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
		
	// Перенаправим заполнение реквизитов документа
	// процедуре модуля.	
	тОбъект = упоУправлениеФормамиСервер.ПолучитьОбъектПоДаннымФормы(Объект);
	тОбъект.ОбработкаЗаполнения(ВыбранноеЗначение);
	ЗначениеВДанныеФормы(тОбъект, Объект);
	
	// И приведем гиперссылку в правильный вид.
	упоУправлениеФормамиСервер.ЗаполнитьГиперссылку(Объект, ЭтаФорма);
	упоПроектыИЗадачиОбщие.УстановитьВидимостьЭлементовФормыПроектнойЗадачи(Объект, ЭтаФорма, ЭтаФорма.ПроектныеОпции);
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Проекты") Тогда
		
		Если Объект.ПодчиненныйПроект = ВыбранноеЗначение Тогда
			Объект.ПодчиненныйПроект = Неопределено;
			Объект.ПодчиненнаяПроектнаяЗадача = Неопределено;
		КонецЕсли;	
		упоРаботаСФормамиСервер.ДобавитьПараметрыИсключитьПроект(Элементы.ПодчиненныйПроект, ВыбранноеЗначение);
		упоРаботаСФормамиСервер.ДобавитьПараметрыИсключитьПроект(Элементы.ПодчиненнаяПроектнаяЗадача, ВыбранноеЗначение);
		
		ЭтотОбъект.ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
		
	КонецЕсли;	
			
КонецПроцедуры

&НаСервере
Процедура УстановитьКодСДР()
	
	КодСДР = упоПроектыИЗадачиВызовСервера.обПолучитьКодСДРПроектнойЗадачи(Объект.Ссылка);
	Если КодСДР = Неопределено Тогда      
		КодСДР = "не определен";
	КонецЕсли; 
	
	НадписьКодСДР = КодСДР;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализацияФормыКлиент(ПриОткрытии = Ложь)
	
	ОбновитьНадписьПоследняяМодификация();
	
	СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными = Новый Структура;
	
	// Фиксируем колонки для некоторых таблиц формы.
	УстановитьФиксациюКолонок("ТрудовыеРесурсы");
	
	Если ДоступенФункционалПроектнаяПродукция Тогда
		ОбновитьПризнакПроектнойПродукцииВПланеВыпуска();
		ДобавитьИнформационныеСтрокиВТрудовыеРесурсы();
	КонецЕсли;
	
	УстановитьОтборСтокПодчиненныхТЧ();
	
	ПриСменеУровняПланирования(ПриОткрытии);
	
	ПересчитатьИтогиВРаспределенияхПоПериодам();
	
	// Перенесем строки из других ТЧ в ПланДоходов и ПланРасходов для визуализации.
	ДобавитьИнформационныеСтрокиВПланДоходовИРасходов();
	// Перенесем строки из других ТЧ в ТрудовыеРесурсы.
	ОбновитьРасходыВДДС = Ложь;
	ОбновитьДоходыВДДС = Ложь;
	ВСубпродуктахИзмененаПроектнаяПродукция = Ложь;
	
	РассчитатьИтогиПоТаблицам();
	
	УстановитьДоступностьДоговоровИсполнителей();
	
	НеобходимаПереинициализацияНаКлиенте = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРодителяЗадачиСервер()
	
	ЗаполнитьГиперссылкуСервер("ЗадачаРодитель",,,Ложь);
	Документы.упоПроектнаяЗадача.ЗаполнитьПЗПоОснованию(Объект.ЗадачаРодитель, Объект);		
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьЗадачаРодительНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.ЗадачаРодитель) Тогда
		ВыбратьЗадачуРодителя();
	Иначе
		ПоказатьЗначение(,Объект.ЗадачаРодитель);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьВТЧ_ПредусловияЗадач()
	
	ФормаВыбора = ПолучитьФорму("Документ.упоПроектнаяЗадача.Форма.ФормаВыбораУправляемая",
		Новый Структура("Отбор", Новый Структура("Проект", Объект.Проект))); 
	ВыбраннаяЗадача = ФормаВыбора.ОткрытьМодально();
	Если ВыбраннаяЗадача = Объект.Ссылка Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Нельзя выбрать в качестве предшественника эту же проектную задачу!'");
		Сообщение.Сообщить();
	ИначеЕсли ЗначениеЗаполнено(ВыбраннаяЗадача) Тогда
		НоваяСтрока = Объект.ПредусловияЗадачи.Добавить();
		НоваяСтрока.ЗадачаПредшественник = ВыбраннаяЗадача;
		ОбновитьДопДанныеТЧ_ПредусловияЗадачи(ВыбраннаяЗадача);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НаСервере_СоставЗадачи_ОбновитьСписок()
	
	мСписокПотомков.Загрузить(упоПредставлениеПроектаВызовСервера.обПолучитьСписокПрямыхПотомковЗадачи(Объект.Ссылка));
	ПостроитьСоставЗадачи();
	
