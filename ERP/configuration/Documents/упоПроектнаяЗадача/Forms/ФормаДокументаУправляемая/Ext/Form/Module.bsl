КонецПроцедуры

&НаКлиенте
Процедура ВключитьПланДоходовПланРасходовВБДДСПриИзменении(ИмяТаблицы)
	
	Если ИмяТаблицы = "ПланРасходов" Тогда
		РеквизитВключить = "ВключитьПланРасходовВБДДС";
		ОбновитьРасходыВДДС = Ложь;
	Иначе	
		РеквизитВключить = "ВключитьПланДоходовВБДДС";
		ОбновитьДоходыВДДС = Ложь;
	КонецЕсли;
	
	Если Объект[РеквизитВключить] Тогда		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВключитьПланДоходовПланРасходовВБДДСЗавершение", ЭтаФорма, ИмяТаблицы);			
			ТекстВопроса = НСтр("ru = 'Для выполнения команды Проектную задачу необходимо записать.
	                             |Продолжить?'");
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
				
			Возврат;			
		КонецЕсли;	
		ПеренестиСтрокиДоходовРасходовВДДСДляИнформации(ИмяТаблицы);
	Иначе		
		УдалитьСтрокиОтраженияБДРвДДС(Объект, ИмяТаблицы);
	КонецЕсли;	 
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьПланДоходовПланРасходовВБДДСЗавершение(Результат, ИмяТаблицы) Экспорт 			
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЭтаФорма.Записать();
		ПеренестиСтрокиДоходовРасходовВДДСДляИнформации(ИмяТаблицы);				
	Иначе
		Если ИмяТаблицы = "ПланРасходов" Тогда
			РеквизитВключить = "ВключитьПланРасходовВБДДС";
		Иначе	
			РеквизитВключить = "ВключитьПланДоходовВБДДС";
		КонецЕсли;
				
		Объект[РеквизитВключить] = Ложь;
	КонецЕсли;			
	
КонецПроцедуры	

