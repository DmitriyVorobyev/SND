&НаКлиенте
Функция СтруктураСтрокиВладельцаСубпродуктыПоТекущимДанным()
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаВладелец = Новый Структура;
	
	СтрокаВладелец.Вставить("ИндексСтрокРаспределения", ТекДанные.ИндексСтрокРаспределения);		
	СтрокаВладелец.Вставить("Валюта", 		ТекДанные.Валюта); 
	СтрокаВладелец.Вставить("Договор", 		ТекДанные.Договор);	
	СтрокаВладелец.Вставить("Сумма", 		ТекДанные.ОбщСтоимость);	
	СтрокаВладелец.Вставить("Количество", 	ТекДанные.Количество);	
	
	Возврат СтрокаВладелец;
	
КонецФункции	

