	КонецЕсли;
	
	ИмяТаблицы = "МатериальныеРесурсы";
	
	упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(ТекДанные);
	
	РассчитатьИтогиПоТаблице(ИмяТаблицы);
	
	Если Не ПроектныеОпции.РасходыПоПодразделениям Тогда
		Возврат;	
	КонецЕсли;

	упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеРесурсыОбщСтоимостьПриИзменении(Элемент)
	
	ТекДанные = Элементы.МатериальныеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблицы = "МатериальныеРесурсы";
	
	Таблица_ПриИзмененииОбщСтоимости(ТекДанные, "Стоимость", Ложь);
	
	РассчитатьИтогиПоТаблице("МатериальныеРесурсы");
	
	Если Не ПроектныеОпции.РасходыПоПодразделениям Тогда
		Возврат;	
	КонецЕсли;

	упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеРесурсыРесурсПриИзменении(Элемент)
	
	ТекДанные = Элементы.МатериальныеРесурсы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = "МатериальныеРесурсы";
	ПараметрыПодбораСтруктура = Неопределено;
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма,
		ПараметрыПодбораСтруктура,
		ИмяТабличнойЧасти,
		ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
	ВыполнитьДействияПриПодборе(ТекДанные, ПараметрыПодбораСтруктура);
	
	Если Не ЗначениеЗаполнено(ТекДанные.ЕдиницаНормирования) Тогда
		СтруктураСтрокиМатериальныеРесурсы = Новый Структура;
		СтруктураСтрокиМатериальныеРесурсы.Вставить("Ресурс", 				ТекДанные.Ресурс);
		СтруктураСтрокиМатериальныеРесурсы.Вставить("ЕдиницаНормирования", 	ТекДанные.ЕдиницаНормирования);
		ЗаполнитьЕдИзмеренияВСтрокеИлиСтруктуре(СтруктураСтрокиМатериальныеРесурсы);
		ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураСтрокиМатериальныеРесурсы);
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ПроверитьНоменклатуруСтрокиНаЗаполнениеЕдИзмВТаблице(Объект, ИмяТабличнойЧасти, ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеРесурсыЕдиницаНормированияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
