&НаСервереБезКонтекста
Функция ПолучитьДанныеупоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия(Проект, ПроектнаяЗадача, Роль, Подразделение, УровеньПланирования)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Проект КАК Проект,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция КАК Операция,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.УровеньПланирования КАК УровеньПланирования,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс КАК Ресурс,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Роль КАК Роль,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение КАК Подразделение,
		|	НАЧАЛОПЕРИОДА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День, МЕСЯЦ) КАК Период,
		|	СУММА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Трудозатраты) КАК Трудозатраты,
		|	СУММА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Стоимость) КАК Стоимость,
		|	СУММА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.ВнешняяСтоимость) КАК ВнешняяСтоимость
		|ИЗ
		|	РегистрСведений.упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия КАК упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия
		|ГДЕ
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Проект = &Проект
		|	И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция = &Операция
		|	И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.УровеньПланирования = &УровеньПланирования
		|	И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс = &Роль
		|	И упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение = &Подразделение
		|
		|СГРУППИРОВАТЬ ПО
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.УровеньПланирования,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Подразделение,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Операция,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Проект,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Роль,
		|	упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.Ресурс,
		|	НАЧАЛОПЕРИОДА(упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия.День, МЕСЯЦ)";
	
	Запрос.УстановитьПараметр("Операция", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("Роль", Роль);
	Запрос.УстановитьПараметр("УровеньПланирования", УровеньПланирования);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();

КонецФункции

