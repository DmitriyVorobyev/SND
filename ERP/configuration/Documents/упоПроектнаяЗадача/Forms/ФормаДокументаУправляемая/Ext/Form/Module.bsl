&НаСервере
Функция ТаблицаБДРДляПереносаВДДС(ДобавитьПланДоходов, ДобавитьПланРасходов, ПоместитьВХранилище = Ложь)
	
	ПланДоходов = Неопределено;
	Если ДобавитьПланДоходов Тогда
		ПланДоходов = Объект.ПланДоходов;
	КонецЕсли;	
	
	ПланРасходов = Неопределено;
	Если ДобавитьПланРасходов Тогда
		ПланРасходов = Объект.ПланРасходов;
	КонецЕсли;	
	
	ТаблицаБДР = упоДоходыИРасходыСервер.СводнаяТаблицаДоходыРасходы(ПланДоходов, ПланРасходов, Истина);
	
	ТаблицаБДР.Колонки.Сумма.Имя = "СуммаВалютная";
	ТаблицаБДР.Колонки.Добавить("Сумма");
	
	Если ПоместитьВХранилище Тогда
		Возврат ПоместитьВоВременноеХранилище(ТаблицаБДР, УникальныйИдентификатор);		
	КонецЕсли;	
		
	Возврат ТаблицаБДР;
	
КонецФункции	

&НаСервере
Процедура ПеренестиСтрокиДоходовРасходовВДДСДляИнформации(ИмяТаблицы, Очищать = Ложь, ОбновитьОтображение = Истина)
	
	Если Очищать Тогда
		УдалитьСтрокиОтраженияБДРвДДС(Объект, ИмяТаблицы);
	КонецЕсли;
	
	ЕстьПланДоходов = ИмяТаблицы = Неопределено ИЛИ ИмяТаблицы = "ПланДоходов";
	ЕстьПланРасходов = ИмяТаблицы = Неопределено ИЛИ ИмяТаблицы = "ПланРасходов";
	
	ТаблицаБДР = ТаблицаБДРДляПереносаВДДС(ЕстьПланДоходов, ЕстьПланРасходов);
	
	ПараметрыРасчетаДДС = упоДвиженияДенежныхСредствКлиентСервер.ПараметрыРасчетаДДСПоБДР(Объект.Ссылка,
		Объект.Проект,
		мВалютаУправленческогоУчета,
		Объект.СхемаОплатыПоУмолчаниюДоходы,
		Объект.СхемаОплатыПоУмолчаниюРасходы); 
	
	упоДвиженияДенежныхСредствСервер.ДополнитьДанныеПланаДДСДаннымиПланаБДР(Объект.ДвиженияДенежныхСредств, 
		ТаблицаБДР, 
		ПараметрыРасчетаДДС);
	
	Если ОбновитьОтображение Тогда
		ОбновитьИконкуНаправленияВТаблицеДДС();
		
		СформироватьИтогПоФинПланам(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНастройкиОтраженияСтатьиВБДР(СтрокаДанных, ИменаКолонок = Неопределено, Реквизиты = Неопределено)
	
	Если СтрокаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИменаКолонок = Неопределено Тогда
		ИменаКолонок = СтруктураИменКолонокОтражения();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаДанных[ИменаКолонок.СтатьяЗатрат]) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОтраженияСтатьиВБДР = НастройкиОтраженияСтатьиВБДР(СтрокаДанных[ИменаКолонок.СтатьяЗатрат], Реквизиты);
	НастройкиОтраженияСтатьиВБДР.Вставить(ИменаКолонок.СпособПривязки,
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения"));
	
	//
	
	Если ЗначениеЗаполнено(СтрокаДанных[ИменаКолонок.Контрагент])
		И СтрокаДанных[ИменаКолонок.Контрагент] <> НастройкиОтраженияСтатьиВБДР[ИменаКолонок.Контрагент] Тогда
		НастройкиОтраженияСтатьиВБДР.Удалить(ИменаКолонок.Контрагент);
		НастройкиОтраженияСтатьиВБДР.Удалить(ИменаКолонок.Договор);
	КонецЕсли;
	
	//
	
	Для Каждого КлючЗначение Из НастройкиОтраженияСтатьиВБДР Цикл
		Если ЗначениеЗаполнено(СтрокаДанных[КлючЗначение.Ключ]) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДанных[КлючЗначение.Ключ] = КлючЗначение.Значение;
	КонецЦикла;
	
КонецПроцедуры

