	ПараметрыВыбораЗадачи = Новый Структура;
	ПараметрыВыбораЗадачи.Вставить("РежимВыбора", Истина);
	ПараметрыВыбораЗадачи.Вставить("ЭтоФормаВыбораПроектнойЗадачи", Истина);
	ПараметрыВыбораЗадачи.Вставить("Проект", Объект.Проект);
	ПараметрыВыбораЗадачи.Вставить("ИсключитьПроект", Истина);
	
	ОткрытьФорму("Справочник.Проекты.ФормаВыбора", ПараметрыВыбораЗадачи,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаДобавитьСвязьСЗадачейДругогоПроектаЗавершение(ВыбраннаяЗадача, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ВыбраннаяЗадача) Тогда
		Возврат;
	КонецЕсли;	
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ДобавлениеПредшественника", Истина);
	ПараметрыПодбора.Вставить("СвязьМеждуПроектами", Истина);
	
	ВыбранныеЗначения = Новый СписокЗначений;
	ВыбранныеЗначения.Добавить(ВыбраннаяЗадача,,Истина);
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранныеЗначения, "ЗадачаПредшественник",
														Объект.ПредусловияЗадачи, ЭтаФорма, Истина, ПараметрыПодбора);
	
	ОбновитьДопДанныеТЧ_ПредусловияЗадачи();
	
КонецПроцедуры

