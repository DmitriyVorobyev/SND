&НаКлиенте
Процедура ДвиженияДенежныхСредствДействиеЗаполнитьПоБДР(Команда)
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;		
	КонецЕсли;
	
	ЗаполнитьБДДС = Не Объект.ВключитьПланДоходовВБДДС Или Не Объект.ВключитьПланРасходовВБДДС;
		
	Если Не ЗаполнитьБДДС Или Объект.ПланДоходов.Количество() = 0 И Объект.ПланРасходов.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Данные БДР включены в ДДС трансляцией. Повторного заполнения не выполнено.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;	
	КонецЕсли; 
	
	НеинформационныеСтроки = ПолучитьНеинформационныеСтрокиДДС();
	ДопПараметры = Новый Структура("НеинформационныеСтроки", НеинформационныеСтроки);
	Если НеинформационныеСтроки.Количество() <> 0 Тогда		
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеДиалогаОчисткиДвиженияДенежныхСредств", 
			ЭтотОбъект, ДопПараметры);
			
		ТекстВопроса = НСтр("ru = 'Очищать табличную часть ""Движения денежных средств"" при заполнении?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		
		Возврат;
			
	КонецЕсли;
	
	ПослеДиалогаОчисткиДвиженияДенежныхСредств(КодВозвратаДиалога.Да, ДопПараметры);
	
КонецПроцедуры

