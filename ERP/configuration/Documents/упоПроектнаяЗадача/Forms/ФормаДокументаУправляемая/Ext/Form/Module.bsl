	Если ТекДанные.ЭтоПП Тогда
		упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределенияПроектнойПродукции(ЭтаФорма, ТекДанные,
			ИмяТаблицы);
	Иначе
		упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
 	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаИсточник = "Субпродукты";
	
	СтрокиНайдены = Ложь;
	
	Если Не НоваяСтрока Тогда
		
		// Обновим данные в строке.
		Если ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС И Объект.ВключитьСубпродуктыВПланДоходов Тогда
			// Если изменили Проектную продукцию, то надо перезаполнить и подчиненную таблицу трансляции.
			Если ВСубпродуктахИзмененаПроектнаяПродукция Тогда 
				упоРаботаСФормамиКлиент.УдалитьДанныеТекущейСтрокиИзСвязаннойОсновнойТаблицы(Объект, Этаформа,
					ТаблицаИсточник, "ПланДоходов", "РаспределениеДоходов");
		    Иначе
				СтрокиНайдены = упоРаботаСФормамиКлиентСервер.ОбновитьДанныеСвязаннойСтрокиОсновнойТаблицы(Объект, ТекДанные, 
					"ПланДоходов", ТаблицаИсточник);
				Если Объект.ВключитьПланДоходовВБДДС Тогда
					ОбновитьДоходыВДДС = Истина; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НоваяСтрока Или Не СтрокиНайдены Тогда
		
		упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект, ТекДанные, ТаблицаИсточник);
		
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
			"РаспределениеОбъемов","ОбщСтоимость", Истина);
		
		// Переносим строку.
		Если ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС И Объект.ВключитьСубпродуктыВПланДоходов Тогда
			упоРаботаСФормамиКлиент.ПеренестиСтрокуИзОсновнойТаблицыВСвязаннуюСПодчиненными(Объект, ТекДанные,
				"РаспределениеОбъемов", "ПланДоходов", "РаспределениеДоходов", 
				ТолькоПросмотр, СтруктураДляПереносаСтрокИзОсновнойТаблицыВСвязаннуюСПодчиненными);
			Если Объект.ВключитьПланДоходовВБДДС Тогда
				ОбновитьДоходыВДДС = Истина; 
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДоступенФункционалПроектнаяПродукция Тогда
		
		Если Объект.ТранслироватьЗатратыПоСубпродуктам Тогда
			
			упоРаботаСФормамиКлиент.УдалитьДанныеТекущейСтрокиИзСвязаннойОсновнойТаблицы(Объект, ЭтотОбъект,
				"Субпродукты", "ТрудовыеРесурсы");
			
			Если ЗначениеЗаполнено(ТекДанные.Ресурс) Тогда
				ПроектнаяПродукцияДляПроверкиПривязки = Новый Массив;
				ПроектнаяПродукцияДляПроверкиПривязки.Добавить(ТекДанные.Ресурс);
				ДанныеПроектнойПродукции = ДанныеПроектнойПродукцииДляПроверкиПривязкиКЗадаче(ПроектнаяПродукцияДляПроверкиПривязки);
				Свойства = ДанныеПроектнойПродукции.Получить(ТекДанные.Ресурс);
				Если Не Свойства.Шаблон И ЗначениеЗаполнено(Свойства.ПроектнаяЗадача) Тогда
					ОбновитьТрансляциюПроектнойПродукцииВТрудозатраты();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	РассчитатьИтогиПоТаблице(ТаблицаИсточник);
	
	ВСубпродуктахИзмененаПроектнаяПродукция = Ложь;
	
КонецПроцедуры

