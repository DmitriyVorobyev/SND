	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ОбновитьИконкуНаправленияВТаблицеДДС", ЭтаФорма);
		
	ИмяСтраницы = "СтраницаСубпродукты"; 
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ПолучитьМДанные", ЭтаФорма);
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ОбновитьДатуВыпуска", ЭтаФорма);
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ОбновитьЗаголовкиЗаказов_КлиентовНаПроизводство", ЭтаФорма);
	
	ИмяСтраницы = "СтраницаРесурсы"; 
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ПолучитьМДанные", ЭтаФорма);
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ОбновитьДатуЗаказаПотребности", ЭтаФорма);
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ОбновитьЗаголовкиЗаказов_Поставщикам", ЭтаФорма);
		
	ИмяСтраницы = "СтраницаТрудовыеРесурсы"; 
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ЗаполнитьКоэффициентыЕдиницНормирования", ЭтаФорма);
	
	ИмяСтраницы = "СтраницаЗадачи";
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
		"ОбновитьДопДанныеТЧ_ПредусловияЗадачи", ЭтаФорма);
		
	ИмяСтраницы = "СтраницаПредусловия";
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСтраницеФункцию(ИмяСтраницы,
        "ОбновитьДопДанныеТЧ_ПредусловияЗадачи", ЭтаФорма);
		
	// Процедуры и функции событий.
		
	ИмяСобытия = "ОбновитьВсе"; 
	упоОтображениеУправляемойФормы.ФункцииОтображения_Инициализация_ДобавитьСобытиюФункцию(ИмяСобытия,
