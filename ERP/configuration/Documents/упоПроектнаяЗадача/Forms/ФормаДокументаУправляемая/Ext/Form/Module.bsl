		Возврат;
	КонецЕсли;
	
	Если Объект.Субпродукты.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Очищать табличную часть ""План выпуска"" при заполнении?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса,
