Процедура ДвиженияДенежныхСредствПриИзменении(Элемент)

	РассчитатьИтогиПоТаблицеДвиженияДенежныхСредств();
 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСубпродукты

&НаКлиенте
Процедура СубпродуктыПриАктивизацииСтроки(Элемент)
	
	ИмяТаблицыВладельца 	= "Субпродукты";
	ИмяТаблицыРаспределения = "РаспределениеОбъемов";
	ИмяКолонкиСумма 		= "ОбщСтоимость";
	ИмяКолонкиИндекса 		= "ИндексСтрокиРаспределениеПоРолям";
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, 
		ИмяТаблицыВладельца,
		ИмяТаблицыРаспределения,
		ИмяКолонкиСумма, 
		Истина, 
		Ложь);
	
	ПересчитатьИтогиВПодчиненнойТаблице(ИмяТаблицыВладельца, 
		ИмяТаблицыРаспределения, 
		ИмяКолонкиСумма, 
		ИмяКолонкиИндекса);
		
	ПересчитатьИтогиКолонокПП();
	
	УстановитьВозможностьРедактированияСтрокиПроектнойПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Если Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
		УдалитьСтрокиПроектнойПродукции();
	Иначе
		УдалитьСтрокиСубпродуктовЗавершение(КодВозвратаДиалога.Да);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыДоговорПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПриИзмененииДоговора(ЭтаФорма,"Субпродукты"); 
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "Субпродукты");
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыДоговорОчистка(Элемент, СтандартнаяОбработка)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "Субпродукты", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(ТекДанные);
	
	ИмяТаблицы = "Субпродукты";
	
	РассчитатьИтогиПоТаблице(ИмяТаблицы); 
			
	Если упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(ТекДанные.Ресурс) Тогда
		упоРаботаСФормамиКлиент.ПересчитатьДлительностьПоПроектнойПродукции(ТекДанные);
		упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределенияПроектнойПродукции(ЭтаФорма, ТекДанные,
			ИмяТаблицы);
	Иначе
		упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыСтоимостьПриИзменении(Элемент)
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(ТекДанные);
	
	ИмяТаблицы = "Субпродукты";
	
	РассчитатьИтогиПоТаблице(ИмяТаблицы);
		
	Если упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(ТекДанные.Ресурс) Тогда
		упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределенияПроектнойПродукции(ЭтаФорма, ТекДанные,
			ИмяТаблицы);
	Иначе
		упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	упоРаботаСФормамиКлиент.ОбработатьВыборПоляВалюта(Элемент, Поле);		
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВключенПереключательПроектнаяПродукция() Тогда
		ПроверитьПривязкуПроектнойПродукцииПриДобавленииВПланВыпуска(ВыбранноеЗначение);
	Иначе
		ВыполнитьДействияПриПодбореСубпродукты(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ИмяТабличнойЧасти = "Субпродукты";
	ПараметрыПодбораСтруктура = Неопределено;
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
		ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение, "Ресурс",
		Объект.Субпродукты, ЭтаФорма, Истина, ПараметрыПодбораСтруктура);		
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование И УстановленФлагЭтоПроектнаяПродукция() Тогда
		упоРаботаСФормамиКлиент.ПроверитьНаДублиПроектнуюПродукцию(Объект.Субпродукты, Элементы, Отказ, Копирование);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределяемыеПередНачалоДобавления(ЭтаФорма,
		Объект,
		"Субпродукты",
		"РаспределениеОбъемов",
		Копирование,
		Отказ);
		
	РассчитатьИтогиПоТаблице("Субпродукты");
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ = "Субпродукты";
	
	Если НоваяСтрока Тогда
		
		СтрокаТЧ = Неопределено;
		ПодготовитьКопиюДанныхОбъекта(СтрокаТЧ, ИмяТЧ);
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекДанные);
		упоФункцииОбщегоНазначенияВызовСервера.ЗаполнитьСтрокуПоУмолчанию(
			Новый Структура("мВалютаУправленческогоУчета", мВалютаУправленческогоУчета),
			Объект.Проект,
			"КонтрагентДоходов",
			"ДоговорДоходов",
			СтрокаТЧ,
			ИмяТЧ);
			
		Если Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
			Исключения = "ЕдиницаНормирования, Количество, Ресурс";
		Иначе
			Исключения = "";
		КонецЕсли;	
		
		ЗаполнитьЗначенияСвойств(ТекДанные, СтрокаТЧ, , Исключения);
		
		упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаПланВыпуска(Объект, ТекДанные);
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтотОбъект, ИмяТЧ);
	
	Если ТекДанные.ЭтоПП Тогда
		ВСубпродуктахИзмененаПроектнаяПродукция = Истина;
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыРесурсПриИзменении(Элемент)
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВключенПереключательПроектнаяПродукция() Тогда
		ПроверитьПривязкуПроектнойПродукцииПриДобавленииВПланВыпуска();
	Иначе
		ОбработатьИзменениеРесурсаВПланеВыпуска(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

