// Выполнить действия при подборе.
//
// Параметры:
//  СтрокаТабличнойЧасти - 	 - 
//  ПараметрыПодбора	 - 	 - 
//
&НаКлиенте
Процедура ВыполнитьДействияПриПодборе(СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт
	
	ПараметрыПодбораФормы = Новый Структура("НачалоПлан, ЗавершениеПлан", 
		мДанные_Сроки_НачалоПлан, мДанные_Сроки_ЗавершениеПлан);
		
	// Добавляем сроки проекта для обработки данных ДДС.	
	Если ЗначениеЗаполнено(СрокиПроекта) Тогда
		ПараметрыПодбораФормы.Вставить("НачалоПланПроект", СрокиПроекта.ДатаНачалаПлан);
		ПараметрыПодбораФормы.Вставить("ЗавершениеПланПроект", СрокиПроекта.ДатаЗавершенияПлан);		
	КонецЕсли;	
	
	упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодбореВПроектнойЗадаче(СтрокаТабличнойЧасти, ПараметрыПодбора, ПараметрыПодбораФормы);

	Если ПараметрыПодбора.Свойство("МассивРаспределенияОбъемов") И
		упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(СтрокаТабличнойЧасти.Ресурс) Тогда
		ПересчитатьИтогиПоТаблицеПП(); 
	КонецЕсли;
	
	Если ПараметрыПодбора.Свойство("СтатьяЗатрат") Тогда
		
		Если Объект.ВключитьДопЗатратыВПланРасходов Тогда		
			Реквизиты = Новый Структура;
			Реквизиты.Вставить("ПрофильРаспределенияДоходовРасходов", "ПрофильРаспределенияРасходовЗатраты");
			Реквизиты.Вставить("КонтрагентДоходовРасходов", "КонтрагентРасходовЗатраты");
			Реквизиты.Вставить("ДоговорДоходовРасходов", "ДоговорРасходовЗатраты");
			
			ИменаКолонокОтражения = СтруктураИменКолонокОтражения();
			ИменаКолонокОтражения.СпособПривязки = "СпособПривязкиДоходовРасходов";	
			ИменаКолонокОтражения.Контрагент = "КонтрагентДоходовРасходов";	
			ИменаКолонокОтражения.Договор = "ДоговорДоходовРасходов";
			
			ЗаполнитьНастройкиОтраженияСтатьиВБДР(СтрокаТабличнойЧасти, ИменаКолонокОтражения, Реквизиты);				
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействияПриПодбореСубпродукты(СписокРесурсов)
	
	ИмяТабличнойЧасти = "Субпродукты";
	ПараметрыПодбораСтруктура = Неопределено;
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти,
		ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
	
	Если ВключенПереключательПроектнаяПродукция() Тогда
		ПараметрыПодбораСтруктура.Вставить("РаспределениеОбъемов", Объект.РаспределениеОбъемов);
		ПараметрыПодбораСтруктура.Вставить("Субпродукты", Объект.Субпродукты);
	КонецЕсли;
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(СписокРесурсов,
		"Ресурс",
		Объект.Субпродукты,
		ЭтаФорма,
		Истина,
		ПараметрыПодбораСтруктура);
	
	упоРаботаСФормамиКлиент.ПроверитьНоменклатуруСтрокиНаЗаполнениеЕдИзмВТаблице(Объект, ИмяТабличнойЧасти);
	
	РассчитатьИтогиПоТаблице(ИмяТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеРесурсаВПланеВыпуска(ТекДанные)
	
	СтруктураСтрокиСубпродукты = Новый Структура;
	СтруктураСтрокиСубпродукты.Вставить("Ресурс", 				ТекДанные.Ресурс);
	СтруктураСтрокиСубпродукты.Вставить("Количество", 			ТекДанные.Количество);
	СтруктураСтрокиСубпродукты.Вставить("Стоимость", 			ТекДанные.Стоимость);
	СтруктураСтрокиСубпродукты.Вставить("ОбщСтоимость", 		ТекДанные.ОбщСтоимость);
	СтруктураСтрокиСубпродукты.Вставить("ЕдиницаНормирования", 	ТекДанные.ЕдиницаНормирования);
	СтруктураСтрокиСубпродукты.Вставить("ЭтоПП", ТекДанные.ЭтоПП);
	Если ДоступенФункционалПроектнаяПродукция Тогда
		СтруктураСтрокиСубпродукты.Вставить("СкоростьВыполнения", ТекДанные.СкоростьВыполнения);
		СтруктураСтрокиСубпродукты.Вставить("Трудоемкость", ТекДанные.Трудоемкость);
		СтруктураСтрокиСубпродукты.Вставить("Нормирование", ТекДанные.Нормирование);
		СтруктураСтрокиСубпродукты.Вставить("КоэффициентСложности", ТекДанные.КоэффициентСложности);
	КонецЕсли;
	
	МассивРаспределенияОбъемов = Новый Массив;
	СубпродуктыРесурсПриИзмененииНаСервере(СтруктураСтрокиСубпродукты, МассивРаспределенияОбъемов);
	
	упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(СтруктураСтрокиСубпродукты);	

	ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураСтрокиСубпродукты);
	
	Если ТекДанные.ЭтоПП Тогда
		Отказ = Ложь;
		упоРаботаСФормамиКлиент.ПроверитьНаДублиПроектнуюПродукцию(Объект.Субпродукты, Элементы, Отказ);
		Если Отказ Тогда
			ТекДанные.Ресурс = Неопределено;
			Возврат;
		КонецЕсли;
		
		упоПодборВТабличнуюЧастьКлиент.СубпродуктыЗаполнитьРаспределениеОбъемовПП(ТекДанные,
			МассивРаспределенияОбъемов,	Объект.РаспределениеОбъемов, Объект.Субпродукты, Объект.Проект);

		ПересчитатьИтогиПоТаблицеПП(); 
	КонецЕсли;

	упоРаботаСФормамиКлиент.ПроверитьНоменклатуруСтрокиНаЗаполнениеЕдИзмВТаблице(Объект, "Субпродукты", ТекДанные);
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
			"РаспределениеОбъемов","ОбщСтоимость", Истина);
	
	УстановитьВозможностьРедактированияСтрокиПроектнойПродукции();
	
КонецПроцедуры

