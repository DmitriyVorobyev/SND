&НаКлиенте
Функция ОпцииТрансляцииПоУмолчанию()

	ОпцииТрансляции = Новый Структура;
	ОпцииТрансляции.Вставить("Объемы", Ложь);
	ОпцииТрансляции.Вставить("МатРесурсы", Ложь);
	ОпцииТрансляции.Вставить("Трудозатраты", Ложь);
	ОпцииТрансляции.Вставить("Допзатраты", Ложь);
	
	Возврат ОпцииТрансляции;

КонецФункции

&НаКлиенте
Процедура ОбработатьОпцииТрансляцииВИнтерфейсе(ОпцииТрансляции)
	
	ИзменениеТрансляцииОбъемов = ОпцииТрансляции.Свойство("Объемы") И ОпцииТрансляции.Объемы;
	ИзменениеТрансляцииМатРесурсов = ОпцииТрансляции.Свойство("МатРесурсы") И ОпцииТрансляции.МатРесурсы;
	ИзменениеТрансляцииТрудозатрат = ОпцииТрансляции.Свойство("Трудозатраты") И ОпцииТрансляции.Трудозатраты;
	ИзменениеТрансляцииДопзатрат = ОпцииТрансляции.Свойство("Допзатраты") И ОпцииТрансляции.Допзатраты;
	
	Если ИзменениеТрансляцииОбъемов Тогда
		Если ВключитьСубпродуктыВПланДоходов() Тогда
			ПеренестиСтрокиОбъемовВДоходыДляИнформации();
		Иначе
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланДоходов", 
				"РаспределениеДоходов",
				ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы"));
			ОчиститьПоляКонтрагентДоговорТабличнойЧасти("Субпродукты");
		КонецЕсли;
 	КонецЕсли;
	
	Если ИзменениеТрансляцииМатРесурсов Тогда
		Если ВключитьМатРесурсыВПланРасходов() Тогда
			ПеренестиСтрокиМатРесурсовВРасходыДляИнформации();
		Иначе
			ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты");
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланРасходов", 
				"РаспределениеРасходов", 
				ИсточникПлана);
			ОчиститьПоляКонтрагентДоговорТабличнойЧасти("МатериальныеРесурсы");
			Если Не ПроектныеОпции.РасходыПоНатуральнымПоказателям Тогда
				ОчиститьРаспределениеЗатратПоПериодам(ИсточникПлана);
			КонецЕсли;
			СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Истина, Ложь, Ложь, Ложь);
		КонецЕсли; 
	КонецЕсли;
	
	Если ИзменениеТрансляцииТрудозатрат Тогда
		Если Не (ВключитьТрудРесурсыВПланРасходов()) Тогда
			УдалитьСтрокиОтраженияТрудозатратВБДР();
		КонецЕсли;
	КонецЕсли;
	
	Если ИзменениеТрансляцииДопзатрат Тогда
		Если Объект.ВключитьДопЗатратыВПланРасходов Тогда
			ПеренестиСтрокиДопЗатратВРасходыДляИнформации();
		Иначе
			ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.ДополнительныеЗатраты");
			упоРаботаСФормамиКлиент.УдалитьПеренесенныеСтрокиИзСвязанныхТаблиц(Объект, 
				"ПланРасходов", 
				"РаспределениеРасходов",
				ПредопределенноеЗначение("Перечисление.упоИсточникПланаДоходовИРасходов.ДополнительныеЗатраты"));
			ОчиститьРаспределениеЗатратПоПериодам(ИсточникПлана);
			СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Ложь, Ложь, Ложь, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИзмененияОпцийТрансляци(ПроектныеОпции, 
	ПроектныеОпцииДоИзменения, ОпцииТрансляцииПоУмолчанию)
	
	ЕстьИзменения = Ложь;
	
	Если ПроектныеОпции.ДоходыПоНатуральнымПоказателям <> 
		ПроектныеОпцииДоИзменения.ДоходыПоНатуральнымПоказателям Тогда
		ОпцииТрансляцииПоУмолчанию.Объемы = Истина;
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ПроектныеОпции.ПланироватьЗатратыНаМатериалы <> 
		ПроектныеОпцииДоИзменения.ПланироватьЗатратыНаМатериалы Тогда
		ОпцииТрансляцииПоУмолчанию.МатРесурсы = Истина;
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ПроектныеОпции.ПланироватьТрудозатратыПоПроекту <> 
		ПроектныеОпцииДоИзменения.ПланироватьТрудозатратыПоПроекту Тогда
		ОпцииТрансляцииПоУмолчанию.Трудозатраты = Истина;
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Если ПроектныеОпции.ПланироватьДополнительныеЗатратыПоЗадаче <> 
		ПроектныеОпцииДоИзменения.ПланироватьДополнительныеЗатратыПоЗадаче Тогда
		ОпцииТрансляцииПоУмолчанию.Допзатраты = Истина;
		ЕстьИзменения = Истина;
	КонецЕсли;
	
	Возврат ЕстьИзменения;
	
КонецФункции

