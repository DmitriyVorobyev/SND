&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаОповещения(ЭтаФорма, Объект, ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "СменаНастроекУчетаПодразделений" Тогда
		
		ПроектныеОпцииДоИзменения = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПроектныеОпции);
		СменаНастроекУчетаПодразделений(Истина);
		
		// Включение/отключение информационных строк.
		ОпцииТрансляции = ОпцииТрансляцииПоУмолчанию();
		ЕстьИзмененияОпцийТрансляции = ПолучитьИзмененияОпцийТрансляци(ПроектныеОпции, 
			ПроектныеОпцииДоИзменения, ОпцииТрансляции);
		Если ЕстьИзмененияОпцийТрансляции Тогда
			ОбработатьОпцииТрансляцииВИнтерфейсе(ОпцииТрансляции);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменилисьПоказателиПроекта" И Параметр = ПроектПЗ Тогда
		Элементы.Показатели.Обновить();
	КонецЕсли;
	
	Если ИмяСобытия = "НазначениеТрудовыхРесурсов" И Параметр = Объект.Ссылка Тогда
		Если Не Модифицированность Тогда
			Прочитать();
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяСобытия = "ЗаписанаЗадачаПроекта" И Параметр.ПроектнаяЗадача = Объект.Ссылка 
			И Объект.ВключитьТрудРесурсыВПланРасходов Тогда
	
		Если НЕ ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат Тогда
			ПолучитьДанныеПланаРасходовВерсии();
			СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Ложь, Истина, Истина, Ложь);
		КонецЕсли;			
		
		ЕстьОбновлениеТрудозатратДляБДР = ИспользоватьОтложенноеОтражениеПлановыхТрудозатрат;
		ПоказатьПредупреждениеИзмененияТрудозатратДляБДР();

	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеЕдиницВремениПоУмолчанию" И Источник = Объект.Проект Тогда
		ОбновитьЕдиницыВремениПроектаПоУмолчанию(ЭтаФорма);
	КонецЕсли;
	
	Если ИмяСобытия = "ПриЗаписиСтруктурыПроекта" Тогда
		// Когда форма документа не модифицирована и относится к проекту, записанному в структуре.
		Если Объект.Проект = Параметр.Проект И Не ЭтаФорма.Модифицированность Тогда
			Прочитать();
		КонецЕсли;
		
	КонецЕсли;
        
    Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Свойство("ЭтоФормированиеЗаказов") Тогда
        ОбработкаЗаголовковСписковЗаказов(ИмяСобытия, Параметр);
	КонецЕсли;
	
    ЗаполнениеТЧОбработкаОповещения(ИмяСобытия, Источник);
                
	упоПроектыИЗадачиКлиент.УдалениеПроектнойЗадачиОбработкаОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

