&НаКлиенте
Процедура КнопкаСменитьРодителя(Команда)
	
	ВыбратьЗадачуРодителя();
	
КонецПроцедуры

&НаКлиенте
Процедура КнопкаУдалитьРодителя(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЗадачаРодитель) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ЗадачаРодитель    = ПредопределенноеЗначение("Документ.упоПроектнаяЗадача.ПустаяСсылка");
	Объект.ДокументОснование = Объект.ЗадачаРодитель;	
	ЗаполнитьГиперссылкуСервер("ЗадачаРодитель", "задача-родитель", "выбрана");
		
