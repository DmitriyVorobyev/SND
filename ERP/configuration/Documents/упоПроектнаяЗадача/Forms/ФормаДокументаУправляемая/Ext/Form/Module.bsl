Процедура КалендарьЗадачиПриИзменении(Элемент)
		
	Если Объект.РучнойВводСроков Тогда
		Новый_ПриИзмененииДаты_Клиент("ДатаЗавершенияПлан");
	Иначе
		Новый_ПриИзмененииДлительности_Клиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненныйПроектПриИзменении(Элемент)
	
	упоПроектыИЗадачиКлиент.ПриВыбореПодчиненногоПроекта(Объект.Проект, Объект.ПодчиненныйПроект);
	
	Объект.ПодчиненнаяПроектнаяЗадача = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненнаяПроектнаяЗадачаПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.ПодчиненнаяПроектнаяЗадача) Тогда
		Возврат;
	КонецЕсли;	
	
	ПроектПодчиненнойЗадачи = ЗначениеРеквизитаОбъекта(Объект.ПодчиненнаяПроектнаяЗадача, "упоКорневойПроект");	
	Если Объект.ПодчиненныйПроект <> ПроектПодчиненнойЗадачи Тогда
		Объект.ПодчиненныйПроект = ПроектПодчиненнойЗадачи;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектПриИзменении(Элемент)
	
	Если ПроектныеОпции.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя Тогда
		СписокПотомков = Новый СписокЗначений;
		ПолучитьПолныйСписокПотомков(Объект.Ссылка, СписокПотомков);
		Если СписокПотомков.Количество() Тогда
			
			ДопПараметры = Новый Структура;
			Если СуществуютОтличияРеквизитаОбъектОтРодительского(Объект.Объект, СписокПотомков) Тогда
				ТекстВопроса = НСтр("ru = 'Реквизит ""Объект"" был изменен. Заменить ""Объект"" во всех подчиненных задачах?'");
			
				ОписаниеОповещения = Новый ОписаниеОповещения("СобытиеИзмененияПоляОбъектаЗавершение", ЭтотОбъект, ДопПараметры);	
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Иначе
				СобытиеИзмененияПоляОбъектаЗавершение(КодВозвратаДиалога.Да, ДопПараметры);
			КонецЕсли;
			
		Иначе
			мЗаменятьЗначениеРеквизитаОбъектУПотомков = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область ПереключениеСтраниц

&НаКлиенте
Процедура СтраницыОсновноеПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.СтраницаСубпродукты Тогда
		ИмяФункции = "ОбновитьЗаголовкиЗаказов_КлиентовНаПроизводство";
		Если ЭтаФорма._ПулФункций.НайтиПоЗначению(ИмяФункции) = Неопределено Тогда
			ЭтаФорма._ПулФункций.Добавить(ИмяФункции);
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаРесурсы Тогда
		ИмяФункции = "ОбновитьЗаголовкиЗаказов_Поставщикам";
		Если ЭтаФорма._ПулФункций.НайтиПоЗначению(ИмяФункции) = Неопределено Тогда
			ЭтаФорма._ПулФункций.Добавить(ИмяФункции);
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаФинансы Тогда
		МассивОткрытыхСтраниц = упоОтображениеУправляемойФормы.ФункцииОтображения_ПолучитьСписокОткрытыхСейчасСтраниц(ЭтаФорма);
		Для каждого ИмяОткрытойСтраницы Из МассивОткрытыхСтраниц Цикл
			Если ИмяОткрытойСтраницы = "СтраницаПланДоходов" Или ИмяОткрытойСтраницы = "СтраницаПланРасходов" Тогда
				упоРаботаСФормамиКлиент.УстановитьТекущуюСтрокуДляРасчетаИтоговПриТрансляции(ЭтаФорма, Объект, 
					ИмяОткрытойСтраницы, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
	// Пересчет итогов в распределении ТР нужен только первый раз при перпеключении вкладок.
	// Для этого добавлен флаг ЕстьПересчетИтоговВРаспределенииТрудовыхРесурсовПоПериодам.
	// Если флаг = Истина, то пересчет не будет производиться.
	ПересчитатьИтогиПоТрудовымРесурсам(ЭтаФорма, ЕстьПересчетИтоговВРаспределенииТрудовыхРесурсовПоПериодам);
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыСоставЗадачиПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыРесурсыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыМатериалыИОборудованиеПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыСубпродуктыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыФинансыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Модифицированность И ТекущаяСтраница.Имя = "СтраницаИтого" Тогда
		
		Элементы.СтраницыФинансы.ТекущаяСтраница = Элементы.СтраницаДДС;
		
		ТекстСообщения = НСтр("ru = 'Документ не сохранен. Отображение информации по финансовым итогам невозможно'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	ИначеЕсли ТекущаяСтраница.Имя = "СтраницаДДС" И 				
		ВключеныИнформационныеСтрокиВПланДоходовИРасходовИДДС И (ОбновитьДоходыВДДС Или ОбновитьРасходыВДДС) Тогда		
		
		// ДДС обновляем при выставленных флагах изменения доходов расходов, а не сразу,
		// т.к. ДиР включаются не построчно, а сводно по статьям ДДС, 
		// и при редактировании строки надо было бы полностью обновлять ДДС раздела.
					
		ИмяТаблицы = ИмяТаблицыБДРДляОбновленияДДС(ОбновитьДоходыВДДС, ОбновитьРасходыВДДС);				
		ПеренестиСтрокиДоходовРасходовВДДСДляИнформации(ИмяТаблицы, Истина);								
		
		Если НЕ Модифицированность Тогда
			СформироватьИтогПоФинПланам(ЭтаФорма);
		КонецЕсли;	
		
		ОбновитьДоходыВДДС = Ложь;
		ОбновитьРасходыВДДС = Ложь;
		
	ИначеЕсли ТекущаяСтраница.Имя = "СтраницаПланДоходов" Или ТекущаяСтраница.Имя = "СтраницаПланРасходов" Тогда
		упоРаботаСФормамиКлиент.УстановитьТекущуюСтрокуДляРасчетаИтоговПриТрансляции(ЭтаФорма, Объект, 
			ТекущаяСтраница.Имя, Истина);	
	КонецЕсли;
	
	ВыполнитьФункцииОбновленияВЗависимостиОтПулаИОткрытыхСейчасСтраниц();
	
КонецПроцедуры

#КонецОбласти

// Устарела. См.КомандаВосстановитьОтмененнуюЗадачу
// 
&НаКлиенте
Процедура ЗадачаОтмененаПриИзменении(Объект)
        
    ЗадачаОтмененаПриИзмененииСервер();
    
КонецПроцедуры

// Устарела. См.КомандаВосстановитьОтмененнуюЗадачу 
//
&НаСервере
Процедура ЗадачаОтмененаПриИзмененииСервер()
    
    ТипЗадачи = упоПроектыИЗадачиОбщие.ПолучитьТипЗадачи(Объект.Ссылка);
    
    Если ТипЗадачи = Перечисления.упоТипПроектнойЗадачи.Этап
        И ЭтапЗаполненЗадачами(Объект.Ссылка) Тогда
        
        НазваниеПЗ = упоПроектыИЗадачиВызовСервера.обПолучитьНазваниеПроектнойЗадачи(Объект.Ссылка);
        
        ТекстСообщения = НСтр("ru = 'Нельзя изменить статус по причине: этап ''%1'' заполнен задачами.'"); 
        ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НазваниеПЗ);
        ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
        
        Объект.ЗадачаОтменена = Ложь;
        Модифицированность = Ложь;
        Возврат;
    
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Объект.ЗадачаРодитель) И 
        упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(Объект.ЗадачаРодитель, "ЗадачаОтменена") Тогда
                
        ТекстСообщения = НСтр("ru = 'Нельзя изменить статус по причине: отменен этап ''%1'''"); 
        ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
            упоПроектыИЗадачиВызовСервера.обПолучитьНазваниеПроектнойЗадачи(Объект.ЗадачаРодитель));
        ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
        
        Объект.ЗадачаОтменена = Истина;
        Модифицированность = Ложь;
        Возврат;
        
    КонецЕсли; 
        
	УстановитьЗаголовокФормы(ЭтотОбъект, Объект.НазваниеПроектнойЗадачи, Объект.ЗадачаОтменена);
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗадачаОтмененаМожноВосстановить(ЗадачаРодитель)
	
	МожноВосстановить = Истина;
	
	Если ЗначениеЗаполнено(ЗадачаРодитель) И 
		упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ЗадачаРодитель, "ЗадачаОтменена") Тогда
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Нельзя восстановить задачу по причине: отменен этап-родитель ""%1""'"),
			упоПроектыИЗадачиВызовСервера.обПолучитьНазваниеПроектнойЗадачи(ЗадачаРодитель));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		МожноВосстановить = Ложь;
	КонецЕсли;
	
	Возврат МожноВосстановить;
	
КонецФункции

&НаКлиенте
Процедура ТранслироватьЗатратыПоСубпродуктамПриИзменении(Элемент)
	
	ОбновитьТрансляциюПроектнойПродукцииВТрудозатраты();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПредусловияЗадачи

&НаКлиенте
Процедура ПредусловияЗадачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ПредусловияЗадачиТипСвязи"
		ИЛИ Поле.Имя = "ПредусловияЗадачиЗадержка"
		ИЛИ Поле.Имя = "ПредусловияЗадачиЕдиницаНормированияДлительности" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	// ВыбраннаяСтрока - передается номер строки в файловой базе и индекс в серверной.
	ВыбраннаяПЗ = Объект.ПредусловияЗадачи.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Не ВыбраннаяПЗ = Неопределено Тогда
		ПоказатьЗначение(,ВыбраннаяПЗ.ЗадачаПредшественник);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредусловияЗадачиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ПодборВТЧФормы(Команды.Найти("ДействиеПодобрать_Предусловия_ПроектныеЗадачи"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПредусловияЗадачиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ДобавлениеПредшественника", Истина);
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, "ЗадачаПредшественник",
		Объект.ПредусловияЗадачи, ЭтаФорма, Истина, ПараметрыПодбора);
	
	ОбновитьДопДанныеТЧ_ПредусловияЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредусловияЗадачиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущаяСтрока = Элементы.ПредусловияЗадачи.ТекущиеДанные;
		
		Если ТекущаяСтрока <> Неопределено Тогда
			ПараметрыПодбора = Новый Структура;
			ПараметрыПодбора.Вставить("ДобавлениеПредшественника", Истина);
			ВыполнитьДействияПриПодборе(ТекущаяСтрока,  ПараметрыПодбора);
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредусловияЗадачиПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ДобавлениеПредшественника", Истина);
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение,
																"ЗадачаПредшественник",
																Объект.ПредусловияЗадачи,
																ЭтаФорма,
																Истина,
																ПараметрыПодбора);		
	ОбновитьДопДанныеТЧ_ПредусловияЗадачи();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредусловияЗадачиТипСвязиОчистка(Элемент, СтандартнаяОбработка)
	
