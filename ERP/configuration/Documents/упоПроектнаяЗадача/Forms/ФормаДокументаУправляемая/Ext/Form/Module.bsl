&НаКлиенте
Процедура ЗаписатьПрограммно(РежимЗаписи, Закрыть)
	
	Отказ = Ложь;
	
	ДополнительныеПараметры = ДополнительныеПараметрыДляПроверокПередЗаписьюПоУмолчанию();
	ДополнительныеПараметры.РежимЗаписи = РежимЗаписи;
	ДополнительныеПараметры.ЗакрытьФормуПослеЗаписи = Закрыть;
	ВыполнитьОбязательныеДействияИПроверкиПередЗаписью(Отказ, ДополнительныеПараметры);
	
	Если Не Отказ Тогда
		ЗаписатьПрограммноЗавершение(Истина, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеТЧРолиТрудовыхРесурсов(Отказ, СвойстваПроекта)
		
	СписокОбязательныхРеквизитов = Новый СписокЗначений;
	СписокОбязательныхРеквизитов.Добавить("Ресурс", "Ресурс");
	СписокОбязательныхРеквизитов.Добавить("Количество", "Количество");
	СписокОбязательныхРеквизитов.Добавить("ЕдиницаНормирования", "Ед. изм.");
	СписокОбязательныхРеквизитов.Добавить("ПрофильРаспределения", "Профиль распределения");
	СписокОбязательныхРеквизитов.Добавить("СпособПривязки", "Способ привязки");
	Если СвойстваПроекта.УказыватьПодразделениеРолиПриПланированииТР Тогда
		СписокОбязательныхРеквизитов.Добавить("Подразделение", "Подразделение");	
	КонецЕсли;
	
	ТекстСообщенияШаблон = НСтр("ru = 'В строке %1 табличной части ""Трудовые ресурсы"" для уровня планирования ""%2"": необходимо заполнить значение реквизита ""%3""!'");
	
	СтруктураПоиска = Новый Структура("УровеньПланирования");
		
	СтруктураПоиска.УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Предварительный");	
	ПроверитьЗаполнениеТЧРолиТрудовыхРесурсовПродолжение(Отказ, СписокОбязательныхРеквизитов, СтруктураПоиска, "Предварительный", ТекстСообщенияШаблон); 
	
	СтруктураПоиска.УровеньПланирования = ПредопределенноеЗначение("Перечисление.упоУровеньПланирования.Окончательный");
	ПроверитьЗаполнениеТЧРолиТрудовыхРесурсовПродолжение(Отказ, СписокОбязательныхРеквизитов, СтруктураПоиска, "Окончательный", ТекстСообщенияШаблон);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеТЧРолиТрудовыхРесурсовПродолжение(Отказ, СписокОбязательныхРеквизитов,
														СтруктураПоиска, НазваниеУровняПланирования, ТекстСообщенияШаблон)
	
	НайденныеСтроки = Объект.ТрудовыеРесурсы.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Сч = 0;
		Для Каждого ТекСтрока Из Объект.ТрудовыеРесурсы Цикл			
			Если Не ТекСтрока.УровеньПланирования = СтруктураПоиска.УровеньПланирования Тогда
				Продолжить;
			КонецЕсли;
			Сч = Сч + 1;			
			
			Для Каждого ТекЗначениеСписка Из СписокОбязательныхРеквизитов Цикл
				Если Не ЗначениеЗаполнено(ТекСтрока[ТекЗначениеСписка.Значение]) Тогда
					Отказ = Истина;
					
					ТекстСообщения = СтрШаблон(ТекстСообщенияШаблон, Сч, НазваниеУровняПланирования, ТекЗначениеСписка.Представление);			
					// Вывод сообщения у поля табличной части закомментировал, т.к. выводимое сообщение закрывается только со второго раза.
					//ПолеСообщения = "Объект.ТрудовыеРесурсы" + "[" + Формат(Объект.ТрудовыеРесурсы.Индекс(ТекСтрока), "ЧН=0; ЧГ=0") + "]." + ТекЗначениеСписка.Значение;			
					//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, ПолеСообщения);
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;	
			КонецЦикла;			
		КонецЦикла;
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте 
Функция ПодготовитьСоответствиеЭлементовФормыРазделамПроверки()
	
	ГруппыРазделов = Новый Структура;
	ГруппыРазделов.Вставить("ГруппаРаспределениеОбъемовПоПодразделениям", "РаспределениеОбъемов");
	ГруппыРазделов.Вставить("ГруппаРаспределениеПотребностей", "РаспределениеПотребностей");
	ГруппыРазделов.Вставить("ГруппаРаспределениеДополнительныхЗатрат", "РаспределениеДополнительныхЗатрат");
	ГруппыРазделов.Вставить("ГруппаДополнительныеЗатраты", "ДополнительныеЗатраты");
	ГруппыРазделов.Вставить("ГруппаРаспределениеПланДоходов", "РаспределениеДоходов");
	ГруппыРазделов.Вставить("ГруппаРаспределениеРасходов", "РаспределениеРасходов");
	ГруппыРазделов.Вставить("МатериальныеРесурсы", "МатериальныеРесурсы");
	ГруппыРазделов.Вставить("Субпродукты", "Субпродукты");
	ГруппыРазделов.Вставить("СтраницаДДС", "ДвиженияДенежныхСредств");
	
	Возврат ГруппыРазделов;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьРаспределение(Отказ, ДопПараметры)
	
	// 1. Проверка дублей в таблицах распределения.
	ДопПараметры.Вставить("ГруппыРазделов", ПодготовитьСоответствиеЭлементовФормыРазделамПроверки());	
	ДопПараметры.Вставить("ГруппыРазделовКолонкиПоПериодам", ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам);
	ДопПараметры.Вставить("ПредставлениеДляДокумента", Истина);		
	ДопПараметры.Вставить("КолонкаСуммыДДС", "Сумма");
	
	упоРаботаСФормамиКлиент.ПроверитьТаблицыНаДубли(Объект, ЭтаФорма, ДопПараметры, Отказ);	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Проверка сумм и количества в таблицах распределения и родительских таблицах.				
	КлючиТаблиц = "ТаблицаВладелец, ТаблицаПодчиненная, ИмяКолонкиВладелец,
		|ИмяКолонкиПодчиненная, ЕстьКоличество, ЕстьИсточникПлана, ПредставлениеТаблицыРаспределения";
	ПараметрыТаблиц = Новый Массив;	
	
	Если Элементы.ГруппаРаспределениеОбъемовПоПодразделениям.Видимость Тогда
		ИмяТЧ = "Субпродукты";
		ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
		ПараметрыТаблиц.Добавить(
			Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеОбъемов", "ОбщСтоимость", "Сумма", Истина, Ложь, 
				ПредставлениеТаблицы));				
	КонецЕсли;
	
	Если Элементы.ГруппаРаспределениеПотребностей.Видимость Тогда
		ИмяТЧ = "МатериальныеРесурсы";
		ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
		ПараметрыТаблиц.Добавить(
			Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеПотребностей", "ОбщСтоимость", "Сумма", Истина, Ложь, 
				ПредставлениеТаблицы));
	КонецЕсли;
		
	Если Элементы.ГруппаРаспределениеДополнительныхЗатрат.Видимость Тогда
		ИмяТЧ = "ДополнительныеЗатраты";
		ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
		ПараметрыТаблиц.Добавить(
			Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеДополнительныхЗатрат", "Стоимость", "Сумма", Ложь, Ложь, 
				ПредставлениеТаблицы));
	КонецЕсли;	
	
	Если Элементы.РамкаГруппыРаспределениеПоПодразделениям.Видимость Тогда
		ИмяТЧ = "ПланДоходов";
		ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
		ПараметрыТаблиц.Добавить(
			Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеДоходов", "Сумма", "Сумма", Ложь, Истина, 
				ПредставлениеТаблицы));
	КонецЕсли;
	
	Если Элементы.ГруппаРаспределениеРасходов.Видимость Тогда
		ИмяТЧ = "ПланРасходов";
		ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
		ПараметрыТаблиц.Добавить(
			Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеРасходов", "Сумма", "Сумма", Ложь, Истина, 
				ПредставлениеТаблицы));
	КонецЕсли;
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ОбновитьИтогиТаблицыВладельца", Истина);
	ПараметрыПроверки.Вставить("Форма", ЭтаФорма);

	ОписаниеОповещенияДляЗаписи = Новый ОписаниеОповещения("ЗаписатьПрограммноЗавершение", ЭтотОбъект, ДопПараметры);
	упоАналитикаПоПодразделениямКлиент.ПроверитьРаспределениеПередЗаписью(Объект, ПараметрыТаблиц, Отказ,
		ОписаниеОповещенияДляЗаписи, ПараметрыПроверки);	
	
КонецПроцедуры

&НаКлиенте
