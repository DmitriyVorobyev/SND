Функция ДобавитьЗаполнитьНовыеСтрокиТаблицНаСервере(МассивДанныхЗаполнения)
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивДанныхЗаполненых = Новый Массив;
	
	Для каждого СтруктураДанныхЗаполнения Из МассивДанныхЗаполнения Цикл
		
		Таблица = СтруктураДанныхЗаполнения.Таблица;
		СтрокиЗаполнения = СтруктураДанныхЗаполнения.СтрокиЗаполнения;
		
		Для Каждого Строка Из СтрокиЗаполнения Цикл
			НоваяСтрока = Таблица.Добавить(); 
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;	
		
		МассивДанныхЗаполненых.Добавить(Новый Структура("ИмяТаблицы, ТаблицаЗаполненая", СтруктураДанныхЗаполнения.ИмяТаблицы, Таблица));
		
	КонецЦикла;
	
	Возврат МассивДанныхЗаполненых;
	
КонецФункции

