&НаКлиенте
Процедура ЗаполнениеТЧОбработкаОповещения(ИмяСобытия, Источник);

	Если Источник <> Объект.Ссылка Тогда
		Возврат;
	КонецЕсли;	
	
	Если ИмяСобытия = "ЗаполнениеТЧ_ПланРасходов" Тогда
		Элементы.ПланРасходов.Обновить();
	КонецЕсли;
	Если ИмяСобытия = "ЗаполнениеТЧ_ПланДоходов" Тогда
		Элементы.ПланДоходов.Обновить();
	КонецЕсли;
	Если ИмяСобытия = "ЗаполнениеТЧ_ДвиженияДенежныхСредств" Тогда
		Элементы.ДвиженияДенежныхСредств.Обновить();
	КонецЕсли;
	Если ИмяСобытия = "ЗаполнениеТЧ_Субпродукты" Тогда
		Элементы.Субпродукты.Обновить();
	КонецЕсли;
	Если ИмяСобытия = "ЗаполнениеТЧ_МатериальныеРесурсы" Тогда
		Элементы.МатериальныеРесурсы.Обновить();
	КонецЕсли;
	Если ИмяСобытия = "ЗаполнениеТЧ_ТрудовыеРесурсы" Тогда
		Элементы.ТрудовыеРесурсы.Обновить();
	КонецЕсли;		
	Если ИмяСобытия = "ЗаполнениеТЧ_ДополнительныеЗатраты" Тогда
		Элементы.ДополнительныеЗатраты.Обновить();
	КонецЕсли;	
		
КонецПроцедуры	

