#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПланДоходов

&НаКлиенте
Процедура ПланДоходовСуммаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ПланДоходов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	ИмяТаблицы = "ПланДоходов";
	
	РассчитатьИтогиПоТаблице(ИмяТаблицы, , Ложь, "Сумма");
	
	ПоказыватьОкноВопроса = ПроектныеОпции.ДоходыПоПодразделениям;
	
	упоРаботаСФормамиКлиент.ПроверитьНеобходимостьПересчетаРаспределения(ЭтаФорма, ТекДанные, ИмяТаблицы, 
		ПоказыватьОкноВопроса);

КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовКонтрагентПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПроверитьДоговор(ЭтаФорма,"ПланДоходов"); 
	ПланДоходовДоговорПриИзменении(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовКонтрагентОчистка(Элемент, СтандартнаяОбработка)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланДоходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовДоговорПриИзменении(Элемент)
	
	упоРаботаСФормамиКлиент.ПриИзмененииДоговора(ЭтаФорма,"ПланДоходов"); 
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланДоходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовДоговорОчистка(Элемент, СтандартнаяОбработка)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланДоходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовПослеУдаления(Элемент)
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	РассчитатьИтогиПоТаблице("ПланДоходов", , Ложь, "Сумма");  
	
	Если Объект.ВключитьПланДоходовВБДДС Тогда
		ОбновитьДоходыВДДС = Истина;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекСтрока = Элементы.ПланДоходов.ТекущиеДанные;
	Если ТекСтрока <> Неопределено И НоваяСтрока И (НЕ Копирование) Тогда
		
		ИмяТабличнойЧасти = "ПланДоходов";
		ПараметрыПодбораСтруктура = Неопределено;   
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
			
		ЗаполнитьЗначенияСвойств(ПараметрыПодбораСтруктура.СтруктураСтроки, ТекСтрока);
								
		ПараметрыПодбораФормы = Новый Структура("НачалоПлан, ЗавершениеПлан", 
			мДанные_Сроки_НачалоПлан, мДанные_Сроки_ЗавершениеПлан);   
		СтруктураДанныеСтроки = упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодборе(ПараметрыПодбораСтруктура.СтруктураСтроки,
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок, ПараметрыПодбораСтруктура.СвойстваОбъекта, ПараметрыПодбораФормы);
		ЗаполнитьЗначенияСвойств(ТекСтрока, ПараметрыПодбораСтруктура.СтруктураСтроки);
		ЗаполнитьЗначенияСвойств(ТекСтрока, СтруктураДанныеСтроки, "СпособПривязки");
		
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланДоходов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СформироватьИтогПоФинПланам(ЭтаФорма);
	
	РассчитатьИтогиПоТаблице("ПланДоходов", , Ложь, "Сумма");
	
	Если Объект.ВключитьПланДоходовВБДДС Тогда
		ОбновитьДоходыВДДС = Истина;
	КонецЕсли;	
				
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовПриАктивизацииСтроки(Элемент)
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтаФорма, "ПланДоходов");	
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "ПланДоходов",
		"РаспределениеДоходов") ;	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеДоходов", "ПланДоходов",
		"ИндексСтрокиРаспределенияДоходов", Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") 
		И ВыбранноеЗначение.Количество() > 0 Тогда
		
		Если ТипЗнч(ВыбранноеЗначение[0].Значение) = Тип("СправочникСсылка.Контрагенты") Тогда
			имяПоля = "Контрагент";
		Иначе 
			имяПоля = "Статья";
		КонецЕсли;
					
		ИмяТабличнойЧасти = "ПланДоходов";
		ПараметрыПодбораСтруктура = Неопределено;   
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
		
		упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, имяПоля, Объект.ПланДоходов,
			ЭтаФорма, Истина, ПараметрыПодбораСтруктура);
		
	КонецЕсли;
	
	Если Объект.ВключитьСубпродуктыВПланДоходов Тогда
		ПеренестиСтрокиОбъемовВДоходыДляИнформации();
		СформироватьИтогПоФинПланам(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если ПараметрыПеретаскивания.Значение.Количество() > 0 Тогда
		
		Если ТипЗнч(ПараметрыПеретаскивания.Значение[0]) = Тип("СправочникСсылка.Контрагенты") Тогда
			имяПоля =  "Контрагент";
		Иначе 
			имяПоля =  "Статья";
		КонецЕсли;
		
		ИмяТабличнойЧасти = "ПланДоходов";
		ПараметрыПодбораСтруктура = Неопределено;   
		упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
			ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));		
		
		упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьПеретаскивание(ПараметрыПеретаскивания.Значение, имяПоля,
			Объект.ПланДоходов, ЭтаФорма, Истина, ПараметрыПодбораСтруктура);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланДоходовПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ПланДоходов.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Если НЕ ТекДанные.ИндексСтрокРаспределенияИсходнойТЧ = Неопределено Тогда
			Отказ = Истина;
			Возврат; // Строка "пришла" через автозаполнение.
		КонецЕсли;
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокаРаспределяемаяПередУдалением(ЭтаФорма, Объект, "ПланДоходов",
		"РаспределениеДоходов");
	
КонецПроцедуры

