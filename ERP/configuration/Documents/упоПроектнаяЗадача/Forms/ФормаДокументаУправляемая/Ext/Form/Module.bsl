		Возврат;
	КонецЕсли;
	
	ОбъемыЗаполнитьПоТрудовымРесурсамЗавершение(КодВозвратаДиалога.Нет, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПоказателиПЗ(Команда)
	
	// Открываем новый документ упоРегистрацияПоказателейПроекта
	Если ЗначениеЗаполнено(ПроектПЗ) Тогда
		
		ДанныеОснования = Новый Структура();
		ДанныеОснования.Вставить("Проект", ПроектПЗ);
		ДанныеОснования.Вставить("ЗаполнитьТЧИндикаторы", Истина);
		
		ОткрытьФорму("Документ.упоРегистрацияПоказателейПроекта.ФормаОбъекта", Новый Структура("Основание", ДанныеОснования)); 
		
	Иначе
		
		ТекстПредупреждения = НСтр("ru = 'Для новых проектов изменение показателей недоступно.
			|Необходимо записать проект.'");
