&НаКлиенте
Процедура ТрудовыеРесурсыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
					
	Если Копирование Тогда
		
		Если ТекДанные.СпособПривязки =
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
			ТекДанные.ИндексСтрокРаспределенияПоПериодам =
				упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(
					Объект.ТрудовыеРесурсы, "ИндексСтрокРаспределенияПоПериодам")
			КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекДанные.Ресурс) Тогда
			ТекДанные.Ресурс = Неопределено;
			ТекДанные.Подразделение = Неопределено;
		КонецЕсли;
		
		Если ТекДанные.Основной И
			упоРаботаСФормамиКлиентСервер.ВТаблицеЕстьСтрокаСПризнакомОсновной(Объект, "ТрудовыеРесурсы") Тогда
			ТекДанные.Основной = Ложь;
		КонецЕсли;
		
	Иначе
		
		ТекДанные.УровеньПланирования = ПолучитьТекущийУровеньПланированияТР(ЭтаФорма);
		ТекДанные.ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаТрудозатратРолей.Трудозатраты");
		
		Если ЗначениеЗаполнено(ТекДанные.Ресурс) Тогда
			ТекРесурс = ТекДанные.Ресурс;
		Иначе
			ТекРесурс = ПредопределенноеЗначение("Справочник.упоРоли.ПустаяСсылка");
		КонецЕсли;
		
		УстановитьПараметрыВыбораПодразделенияРоли(ТекДанные.Ресурс, Элементы.ТрудовыеРесурсыПодразделение);
		
	КонецЕсли;
	
	УстанавливатьПризнакОсновнаяПриДобавленииРоли = ПроектныеОпции.НазначатьРСПОсновнойРолиКакРПЗ 
		И ПроектныеОпции.УстанавливатьПризнакОсновнаяПриДобавленииРоли;
	
	Если УстанавливатьПризнакОсновнаяПриДобавленииРоли 
 		И Не упоРаботаСФормамиКлиентСервер.ВТаблицеЕстьСтрокаСПризнакомОсновной(Объект, "ТрудовыеРесурсы") Тогда		
		ТекДанные.Основной = Истина;					
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.упоПодразделения") Тогда
			Элементы.ТрудовыеРесурсы.ТекущиеДанные.Подразделение = ВыбранноеЗначение;
		Иначе						
			ИмяТабличнойЧасти = "ТрудовыеРесурсы";
			ПараметрыПодбораСтруктура = Неопределено;
			упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
				ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
				
			ТекущийУровеньПланирования = ПолучитьТекущийУровеньПланированияТР(ЭтотОбъект);
			ДополнительныйОтбор = Новый Структура("УровеньПланирования", ТекущийУровеньПланирования);

			упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, "Ресурс",
				Объект.ТрудовыеРесурсы, ЭтаФорма, Истина, ПараметрыПодбораСтруктура,, ДополнительныйОтбор);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТрудовыеРесурсыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ Копирование Тогда
		//Отказ = Истина;
		//ПодборВТЧФормы(Команды.Найти("ДействиеПодобрать_Ресурсы_РолиТР"));
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Копирование  
		И ЗначениеЗаполнено(ТекДанные.ИсточникПлана)
		И ТекДанные.ИсточникПлана <> ПредопределенноеЗначение("Перечисление.упоИсточникПланаТрудозатратРолей.Трудозатраты") Тогда
			Отказ = Истина;
			Возврат;
	КонецЕсли;

