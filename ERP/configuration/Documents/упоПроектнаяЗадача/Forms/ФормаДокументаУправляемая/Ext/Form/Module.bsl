&НаКлиенте
Процедура МатериальныеРесурсыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.МатериальныеРесурсы.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьОграничениеТиповМатериальныеРесурсы();
	
	ИмяТЧ = "МатериальныеРесурсы";
	
	Если НоваяСтрока Тогда
		
		СтрокаТЧ = Неопределено;
		ПодготовитьКопиюДанныхОбъекта(СтрокаТЧ, ИмяТЧ);
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекДанные);
		упоФункцииОбщегоНазначенияВызовСервера.ЗаполнитьСтрокуПоУмолчанию(
			Новый Структура("мВалютаУправленческогоУчета", мВалютаУправленческогоУчета),
			Объект.Проект,
			"КонтрагентЗатрат",
			"ДоговорЗатрат",
			СтрокаТЧ,
			ИмяТЧ);
		ЗаполнитьЗначенияСвойств(ТекДанные, СтрокаТЧ);
		
		упоУправлениеФормамиКлиент.ОбновитьДатуЗаказаПотребности(Объект, ТекДанные);
		
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.УстановитьТолькоПросмотрВалюте(ЭтотОбъект, ИмяТЧ);
	
