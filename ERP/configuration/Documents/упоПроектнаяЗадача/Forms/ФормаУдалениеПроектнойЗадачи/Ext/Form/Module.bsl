#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОтветДа(Команда)
	ПодтверждениеУдаления(); 	
КонецПроцедуры

&НаКлиенте
Процедура ОтветНет(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеУдаления()
	
	ТекстОшибки = "";
	УдалитьПроектнуюЗадачу(ПроектнаяЗадача, СтруктураУдаляемыеОбъекты, ТекстОшибки);
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ТекстСообщения = НСтр("ru = 'Удаление завершено!'");
		Элементы.ОтветДа.Доступность = Ложь;
		
		ОповеститьОбИзменении(ПроектнаяЗадача);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не удалось провести расчет календарного плана!
			|Для корректной работы рекомендуется провести расчет календарного плана вручную!'"); 		
	КонецЕсли;
	
	Элементы.ДекорацияСообщение.Заголовок = ТекстСообщения;
	Элементы.ДекорацияПредупреждение.Видимость = Ложь;
	
	Оповестить("УдалениеПроектнойЗадачи", , ВладелецФормы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьПроектнуюЗадачу(Знач ПроектнаяЗадача, СтруктураУдаляемыеОбъекты, ТекстОшибки)
	
	упоПроектыИЗадачиСервер.УдалитьПроектнуюЗадачу(ПроектнаяЗадача, СтруктураУдаляемыеОбъекты, ТекстОшибки);
	
КонецПроцедуры

#Область УниверсальныеОбработчики

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено)
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);	
	
КонецФункции

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено)
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено)
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3,
		П4, П5, П5, П6);
	
КонецФункции

#КонецОбласти

