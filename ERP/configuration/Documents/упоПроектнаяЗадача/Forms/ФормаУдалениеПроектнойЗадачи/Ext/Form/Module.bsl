
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, , Отказ, СтандартнаяОбработка);
	
	ПроектнаяЗадача = Параметры.ПроектнаяЗадача;
	СтруктураУдаляемыеОбъекты = Параметры.СтруктураУдаляемыеОбъекты;
	ПеречитатьОбъектНаФорме = Параметры.ПеречитатьОбъектНаФорме;
	ЭтоАвтоТест = Параметры.ЭтоАвтоТест;
	
	Заголовок = "Удаление проектной задачи """ + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "НазваниеПроектнойЗадачи") + """";
	Элементы.ДекорацияСообщение.Заголовок = Параметры.ТекстСообщения; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЭтоАвтоТест Тогда
		ПодтверждениеУдаления();
	КонецЕсли;
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, , Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗакрытием(ЭтаФорма, 
													Неопределено, 
													Отказ, 
													СтандартнаяОбработка, 
													ЗавершениеРаботы, 
													ТекстПредупреждения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриЗакрытии(ЭтаФорма);
	
КонецПроцедуры

