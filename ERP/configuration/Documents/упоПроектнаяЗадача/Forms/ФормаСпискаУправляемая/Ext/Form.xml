	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументупоПроектнаяЗадача.Номер КАК Номер,
	ДокументупоПроектнаяЗадача.Дата КАК Дата,
	ДокументупоПроектнаяЗадача.Проект КАК Проект,
	ВЫБОР
		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача ЕСТЬ NULL
			ТОГДА ДокументупоПроектнаяЗадача.ЗадачаРодитель
		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель
	КОНЕЦ КАК ЗадачаРодитель,
	ВЫБОР
		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача ЕСТЬ NULL
			ТОГДА ДокументупоПроектнаяЗадача.НазваниеПроектнойЗадачи
		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи
	КОНЕЦ КАК НазваниеПроектнойЗадачи,
	ВЫБОР
		КОГДА упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена
	КОНЕЦ КАК ЗадачаОтменена,
	ДокументупоПроектнаяЗадача.Ссылка КАК Ссылка,
	ДокументупоПроектнаяЗадача.КодПроектногоДокумента КАК КодПроектногоДокумента,
	НаличиеФайлов.ЕстьФайлы КАК ЕстьФайлы
ИЗ
	Документ.упоПроектнаяЗадача КАК ДокументупоПроектнаяЗадача
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
				,
				Версия В
					(ВЫБРАТЬ
						упоВерсииПроекта.Версия КАК Версия
					ИЗ
						РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
					ГДЕ
						упоВерсииПроекта.Текущая)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		ПО ДокументупоПроектнаяЗадача.Ссылка = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача  
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
        ПО ДокументупоПроектнаяЗадача.Ссылка = НаличиеФайлов.ОбъектСФайлами}</QueryText>
				<MainTable>Document.упоПроектнаяЗадача</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
