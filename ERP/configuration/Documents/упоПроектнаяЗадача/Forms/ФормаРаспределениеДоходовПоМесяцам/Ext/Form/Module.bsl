	ПересчитатьОстаткиВСтрокахРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДоходовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте	
Процедура Подключаемый_РаспределениеДоходовПоМесяцамКоличествоПриИзменении(Элемент)
	
	ТекущиеДанныеОбъемов = Элементы.ТаблицаДоходов.ТекущиеДанные;
	
	Если ТекущиеДанныеОбъемов <> Неопределено Тогда
		
		ТекущаяСтоимость = ТекущиеДанныеОбъемов.Стоимость;
				
		ИмяРеквизитаТекущее = Элемент.Имя;
		
		КоличествоТекущее  = ТекущиеДанныеОбъемов[ИмяРеквизитаТекущее];
		ОбщСтоимостьТекущая = КоличествоТекущее * ТекущаяСтоимость;
		
		ИмяРеквизитаСумма = СтрЗаменить(ИмяРеквизитаТекущее,"Количество_"  ,"Сумма_");
		ТекущиеДанныеОбъемов[ИмяРеквизитаСумма]  = ОбщСтоимостьТекущая;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте	
Процедура Подключаемый_РаспределениеДоходовПоМесяцамСуммаПриИзменении(Элемент)
	
	ТекущиеДанныеОбъемов = Элементы.ТаблицаДоходов.ТекущиеДанные;
	
	Если ТекущиеДанныеОбъемов <> Неопределено Тогда
			
		ИмяРеквизитаТекущее = Элемент.Имя;
		
		ТекущиеДанныеРаспределенияПоПериодам = Элементы.ТаблицаДоходов.ТекущиеДанные;
		СтоимостьТекущая = ТекущиеДанныеРаспределенияПоПериодам[ИмяРеквизитаТекущее];
		ТекущаяСтоимость = ТекущиеДанныеОбъемов.Стоимость;
		
		Если ТекущаяСтоимость <> 0 Тогда
			
			КоличествоТекущее = СтоимостьТекущая/ТекущаяСтоимость;			
			ИмяРеквизитаКоличество = СтрЗаменить(ИмяРеквизитаТекущее, "Сумма_","Количество_");
			ТекущиеДанныеРаспределенияПоПериодам[ИмяРеквизитаКоличество]  = КоличествоТекущее;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗавершитьИЗакрыть(Команда)
	
	Перем РезультатРаспределения;
	ПодготовитьРезультатРаспределения(РезультатРаспределения);
	
	Отказ = Ложь;
	
	Для Каждого СтрокаДоходов Из ТаблицаДоходов Цикл
		
		Если РаспределятьКоличество Тогда
			
			Если СтрокаДоходов.КоличествоОстаток <> 0 Тогда
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = НСтр("ru = 'Количество, распределенное по месяцам, не соответствует общему количеству'");
				Сообщение.Сообщить();
				
				Отказ = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрокаДоходов.ОстатокКРаспределению <> 0 Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru = 'Сумма, распределенная по месяцам, не соответствует общей сумме'");
			Сообщение.Сообщить();
			
			Отказ = Истина;			
		
		КонецЕсли;		
		
	КонецЦикла;
	
	Если Не Отказ Тогда
		ОповеститьОВыборе(РезультатРаспределения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте	
Процедура  ПересчитатьОстаткиВСтрокахРаспределения()
	
	Для Каждого СтрокаРаспределения Из ТаблицаДоходов Цикл
		
		СуммаВсего = СтрокаРаспределения.Сумма;
		СуммаОстаток = 0;
		
		Если РаспределятьКоличество Тогда
			
			КоличествоВсего = СтрокаРаспределения.Количество;
			КоличествоОстаток = 0;
			
		КонецЕсли;
		
		Для Каждого ПериодРаспределения Из СписокПериодов Цикл
			
			ИмяКолонкиСумма =        "Сумма_"+Формат(ПериодРаспределения.Значение,"ДФ=MM_yyyy");
			СуммаОстаток =  СуммаОстаток + СтрокаРаспределения[ИмяКолонкиСумма];
			
			Если РаспределятьКоличество Тогда
				
				ИмяКолонкиКоличество = "Количество_"+Формат(ПериодРаспределения.Значение,"ДФ=MM_yyyy");
				КоличествоОстаток = КоличествоОстаток + СтрокаРаспределения[ИмяКолонкиКоличество];
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаРаспределения.ОстатокКРаспределению = СуммаВсего- СуммаОстаток;
		СтрокаРаспределения.СуммаРаспределено = СуммаОстаток;
		
		Если РаспределятьКоличество Тогда
			
			СтрокаРаспределения.КоличествоОстаток = КоличествоВсего - КоличествоОстаток;
			СтрокаРаспределения.КоличествоРаспределено = КоличествоВсего;
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте	
Процедура ПересчитатьИтогиВРаспределенииПоПериодам(РаспределятьКоличество = Ложь)
		
	Если РаспределятьКоличество Тогда
		ЭтаФорма.КоличествоОстатокИтог = 0;
		ЭтаФорма.КоличествоРаспределеноИтог = 0;		 
	КонецЕсли;
		
	ЭтаФорма.СуммаОстатокИтог = 0;
	ЭтаФорма.СуммаРаспределеноИтог = 0;		 
	
		// Вертикальные итоги.
		Для Каждого ЭлементСпискаПрограммно Из Элементы.ТаблицаДоходовГруппаПрограммно.ПодчиненныеЭлементы Цикл
			
			Счетчик = 0;
			ПериодЗашифрованный = ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
			ИмяКолонкиСумма = "Сумма_"+Формат(ПериодЗашифрованный,"ДФ=MM_yyyy");
			ИмяКолонкиКоличество = "Количество_"+Формат(ПериодЗашифрованный,"ДФ=MM_yyyy");				
			
			ЭтаФорма["Всего_" + ИмяКолонкиСумма] = 0; 
			Если РаспределятьКоличество Тогда
				ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = 0;		 
			КонецЕсли;
					
			Для Каждого СтрокаРаспределения Из ТаблицаДоходов Цикл
				
				Если Счетчик = 0 Тогда
					ЭтаФорма["Всего_" + ИмяКолонкиСумма] = 0;					 
					Если РаспределятьКоличество Тогда
						ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = 0;		 
					КонецЕсли;
					
				КонецЕсли;				
				
				ЭтаФорма["Всего_" + ИмяКолонкиСумма] = ЭтаФорма["Всего_" + ИмяКолонкиСумма] + СтрокаРаспределения[ИмяКолонкиСумма]; 
				
				Если РаспределятьКоличество Тогда
					ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = ЭтаФорма["Всего_" + ИмяКолонкиКоличество] 
						+ СтрокаРаспределения[ИмяКолонкиКоличество];		 
				КонецЕсли;
				
				Счетчик = Счетчик + 1;
				
			КонецЦикла;
			
		КонецЦикла;
		
		// Горизонтальные итоги.
	
		Для Каждого СтрокаРаспределения Из ТаблицаДоходов Цикл
						
			ВсегоРаспределеноСумма = 0;
			ВсегоРаспределеноКоличество = 0;
			
			Для Каждого ЭлементСпискаПрограммно Из Элементы.ТаблицаДоходовГруппаПрограммно.ПодчиненныеЭлементы Цикл
				
				ПериодЗашифрованный = ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
				
				Если РаспределятьКоличество Тогда
					
					ИмяКолонкиКоличество = "Количество_"+Формат(ПериодЗашифрованный,"ДФ=MM_yyyy");				
					ВсегоРаспределеноКоличество = ВсегоРаспределеноКоличество + СтрокаРаспределения[ИмяКолонкиКоличество];
					ЭтаФорма["Всего_" + ИмяКолонкиКоличество] = Формат(ТаблицаДоходов.Итог(ИмяКолонкиКоличество),"ЧДЦ=2");
					
				КонецЕсли;
				
				ИмяКолонкиСумма = "Сумма_"+Формат(ПериодЗашифрованный,"ДФ=MM_yyyy");
				ВсегоРаспределеноСумма = ВсегоРаспределеноСумма + СтрокаРаспределения[ИмяКолонкиСумма];
				
				ЭтаФорма["Всего_" + ИмяКолонкиСумма ] = Формат(ТаблицаДоходов.Итог(ИмяКолонкиСумма), "ЧДЦ=2");
				
			КонецЦикла;
			
			СтрокаРаспределения.СуммаРаспределено =  ВсегоРаспределеноСумма;
			Если РаспределятьКоличество Тогда
				СтрокаРаспределения.КоличествоРаспределено  =  ВсегоРаспределеноКоличество;
				СтрокаРаспределения.КоличествоОстаток  =  СтрокаРаспределения.Количество - ВсегоРаспределеноКоличество;
			КонецЕсли;
			
			СтрокаРаспределения.ОстатокКРаспределению =  СтрокаРаспределения.Сумма - ВсегоРаспределеноСумма;
			
			Если РаспределятьКоличество Тогда
				ЭтаФорма.КоличествоОстатокИтог = ЭтаФорма.КоличествоОстатокИтог  + СтрокаРаспределения.КоличествоОстаток;
				ЭтаФорма.КоличествоРаспределеноИтог = ЭтаФорма.КоличествоРаспределеноИтог  + СтрокаРаспределения.КоличествоРаспределено;;		 
			КонецЕсли;
						
			ЭтаФорма.СуммаОстатокИтог = ЭтаФорма.СуммаОстатокИтог + СтрокаРаспределения.ОстатокКРаспределению;
			ЭтаФорма.СуммаРаспределеноИтог = ЭтаФорма.СуммаРаспределеноИтог + СтрокаРаспределения.СуммаРаспределено;		 

		КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте	
Функция ПолучитьЗашифрованныйПериод(Знач ЭлементСпискаПрограммноИмя)
	
	// Например, "Группа_РаспределениеОбъемов_Март_2014".
	Если РаспределятьКоличество Тогда
		ЭлементСпискаПрограммноИмя = СтрЗаменить(ЭлементСпискаПрограммноИмя,"Группа_", "");
	Иначе
		ЭлементСпискаПрограммноИмя = СтрЗаменить(ЭлементСпискаПрограммноИмя,"Сумма_", "");
	КонецЕсли;

	Позиция_ = Найти(ЭлементСпискаПрограммноИмя, "_");
	
	ПодстрокаМесяц = Лев(ЭлементСпискаПрограммноИмя, Позиция_);
	ПодстрокаГод = СтрЗаменить(ЭлементСпискаПрограммноИмя,  ПодстрокаМесяц, "");
	
	ПодстрокаМесяц = СтрЗаменить(ПодстрокаМесяц, "_", "");	  
	МесяцЧислом = Число(ПодстрокаМесяц);
	ГодЧислом = Число(ПодстрокаГод);
	
	ЗашифрованныйПериод = КонецМесяца(Дата(ГодЧислом, МесяцЧислом, 1));
	
	Возврат ЗашифрованныйПериод;
	
КонецФункции

