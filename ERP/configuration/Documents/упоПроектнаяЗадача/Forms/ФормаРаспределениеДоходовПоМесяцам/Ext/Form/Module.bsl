
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, , Отказ, СтандартнаяОбработка);
	
	ТаблицаРаспределения = ПолучитьИзВременногоХранилища(Параметры.АдресТР);
	КолонкаИндекса = Параметры.КолонкаИндекса;
	РаспределятьКоличество = Параметры.РаспределятьКоличество;
	
	СписокПериодов.ЗагрузитьЗначения(Параметры.СписокПериодов.ВыгрузитьЗначения());
	СписокЭлементовДляДобавления = Новый СписокЗначений;
	МассивРеквизитов = Новый Массив;
	
	Если Параметры.РаспределятьКоличество Тогда
		
		Элементы.ГруппаТекущиеДанныеРаспределения.Видимость = Истина;
				
	Иначе 
		
		Элементы.ГруппаТекущиеДанныеРаспределения.Видимость = Ложь;
	
	КонецЕсли;
	
	Для Каждого КолонкаПрограммно Из Параметры.СписокКолонокПрограммно Цикл
		
		КолонкаТаблицы = ТаблицаРаспределения.Колонки.Найти(КолонкаПрограммно.Представление);	 
		НоваяКолонка = Новый РеквизитФормы(КолонкаТаблицы.Имя,КолонкаТаблицы.ТипЗначения,"ТаблицаДоходов",
			КолонкаТаблицы.Заголовок, Истина);
		МассивРеквизитов.Добавить(НоваяКолонка);
		СписокЭлементовДляДобавления.Добавить(КолонкаТаблицы.Имя, КолонкаТаблицы.Заголовок);
		
	КонецЦикла;
	
	МассивТиповЧ = Новый Массив;
	МассивТиповЧ.Добавить(Тип("Число"));
	
	КЧ = Новый КвалификаторыЧисла(15,2);
	
	ОписаниеТиповЧ =  Новый ОписаниеТипов(МассивТиповЧ,,,КЧ);
	
	Для Каждого РеквизитИтогов Из Параметры.СписокКолонокИтогов Цикл
		
		НоваяКолонкаИтогов = Новый РеквизитФормы(РеквизитИтогов.Значение,ОписаниеТиповЧ,,, Истина);	
		МассивРеквизитов.Добавить(НоваяКолонкаИтогов);
		
	КонецЦикла;
		
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов);	
	
	Если РаспределятьКоличество Тогда
		
		Для Каждого ЭлементСпискаПериодов Из СписокПериодов Цикл
			
			НоваяГруппа = Элементы.Добавить("Группа_" + Формат(ЭлементСпискаПериодов.Значение,"ДФ=MM_yyyy"),
				Тип("ГруппаФормы"), Элементы.ТаблицаДоходов.ПодчиненныеЭлементы.ТаблицаДоходовГруппаПрограммно);
			НоваяГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
			НоваяГруппа.Группировка =  ГруппировкаКолонок.Горизонтальная;
			НоваяГруппа.ОтображатьВШапке = Истина;
			НоваяГруппа.Заголовок=Формат(ЭлементСпискаПериодов.Значение, "ДФ='MMMM yyyy'");
			НоваяГруппа.ЦветФонаЗаголовка = ЦветаСтиля.упоЦветДиаграммыГантаРабочееЗаданиеЗапланировано;
			
			ИмяКолонкиКоличество = "Количество_"+Формат(ЭлементСпискаПериодов.Значение,"ДФ=MM_yyyy");
			
			НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиКоличество, Тип("ПолеФормы"), НоваяГруппа);			
			НоваяКолонкаЭлемент.ПутьКДанным = "ТаблицаДоходов" + "." + ИмяКолонкиКоличество;
			НоваяКолонкаЭлемент.Доступность = Истина;
			НоваяКолонкаЭлемент.Заголовок = "Количество";
			НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
			НоваяКолонкаЭлемент.ПутьКДаннымПодвала =  "Всего_" + ИмяКолонкиКоличество;
			НоваяКолонкаЭлемент.ЦветФонаЗаголовка = ЦветаСтиля.упоЦветДиаграммыГантаРабочееЗаданиеЗапланировано;
			
			НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", "ТаблицаДоходовКоличествоПриИзменении");
			
			ИмяКолонкиСумма = "Сумма_"+Формат(ЭлементСпискаПериодов.Значение,"ДФ=MM_yyyy");
			
			НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиСумма, Тип("ПолеФормы"), НоваяГруппа);			
			НоваяКолонкаЭлемент.ПутьКДанным = "ТаблицаДоходов" + "." + ИмяКолонкиСумма;
			НоваяКолонкаЭлемент.Доступность = Истина;
			НоваяКолонкаЭлемент.Заголовок = "Сумма";
			НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
			НоваяКолонкаЭлемент.ПутьКДаннымПодвала =  "Всего_" + ИмяКолонкиСумма;
			НоваяКолонкаЭлемент.ЦветФонаЗаголовка = ЦветаСтиля.упоЦветДиаграммыГантаРабочееЗаданиеЗапланировано;
		
			НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", "ТаблицаДоходовСуммаПриИзменении");
			
		КонецЦикла;
		
	Иначе	 		 
		
		Для Каждого ГодПланирования Из СписокЭлементовДляДобавления Цикл
			
			НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ГодПланирования.Значение, Тип("ПолеФормы"),
				Элементы.ТаблицаДоходов.ПодчиненныеЭлементы.ТаблицаДоходовГруппаПрограммно);			
			НоваяКолонкаЭлемент.ПутьКДанным = "ТаблицаДоходов" + "." + ГодПланирования.Значение;
			НоваяКолонкаЭлемент.Доступность = Истина;
			НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
			НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", "ТаблицаДоходовСуммаПриИзменении");
			НоваяКолонкаЭлемент.ПутьКДаннымПодвала =  "Всего_" + ГодПланирования.Значение;
			НоваяКолонкаЭлемент.ЦветФонаЗаголовка = ЦветаСтиля.упоЦветДиаграммыГантаРабочееЗаданиеЗапланировано;
	
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СтрокаТР Из ТаблицаРаспределения Цикл
		
		НоваяСтрока = ТаблицаДоходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТР);		 
		НоваяСтрока.Роль = СтрокаТР.Роль;
		НоваяСтрока.Подразделение = СтрокаТР.Подразделение;
		НоваяСтрока.ИсходныйНомерСтроки=СтрокаТР.НомерСтроки;
		
	КонецЦикла;
		
КонецПроцедуры

