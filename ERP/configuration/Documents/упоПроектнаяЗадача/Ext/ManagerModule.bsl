#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Копирует проектную задачу.
//
// Параметры:
//  пСсылка	 - ДокументСсылка.упоПроектнаяЗадача - копируемая ПЗ.
//
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция Скопировать(пСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(пСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	новыйОбъект = пСсылка.Скопировать();
	новыйОбъект.ДополнительныеСвойства.Вставить("СсылкаКопирования", пСсылка);
	
	новыйОбъект.ПолучитьФорму().Открыть();
	
КонецФункции

// Возвращает актуальные на текущий момент времени сроки проектной
//  задачи (без учета реквизита "Ручной ввод сроков"), данные в любом случае берутся из регистра сведений.
//
// Параметры:
//  пСсылка	 - ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой надо получить актуальные сроки.
// 
// Возвращаемое значение:
//  Структура - сроки проектной задачи. Ключи структуры: "ДатаНачала" и "ДатаЗавершения".
//
Функция ПолучитьСроки(пСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рег.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	Рег.ДатаНачалаПлан КАК ДатаНачала,
		|	Рег.ДатаЗавершенияПлан КАК ДатаЗавершения
		|ИЗ
		|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &Ссылка) КАК Рег
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
		|		ПО Рег.Версия = Версии.Версия
		|			И (Версии.Текущая)";
	
	Если ТипЗнч(пСсылка) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПроектнаяЗадача = &Ссылка", "ПроектнаяЗадача В (&Ссылка)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", пСсылка);
	
	// Если пользователь имеет доступ к проектной задаче, то он должен иметь доступ к просмотру ее сроков.
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	МассивСроков = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Сроки = Новый Структура();
		Сроки.Вставить("ПроектнаяЗадача", Выборка.ПроектнаяЗадача);
		Сроки.Вставить("ДатаНачала", Выборка.ДатаНачала);
		Сроки.Вставить("ДатаЗавершения", Выборка.ДатаЗавершения);
		МассивСроков.Добавить(Сроки);
	КонецЦикла;
	
	Если ТипЗнч(пСсылка) = Тип("Массив") Тогда
		Результат = МассивСроков;
	Иначе
		Результат = МассивСроков[0];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает расчетные сроки проектной задачи.
//
// Параметры:
//  ПроектнаяЗадача	 - ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой надо получить сроки.
// 
// Возвращаемое значение:
//  Структура - структура сроков:
//  * ДатаРаннегоСтарта - Дата - дата раннего старта,
//  * ДатаПозднегоСтарта - Дата - дата позднего старта,
//  * ДатаРаннегоФиниша - Дата - дата раннего финиша,
//  * ДатаПозднегоФиниша - Дата - дата позднего финиша.
//
Функция ПолучитьРасчетныеСроки(ПроектнаяЗадача) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	РегСроки.ДатаРаннегоСтарта,
		|	РегСроки.ДатаРаннегоФиниша,
		|	РегСроки.ДатаПозднегоСтарта,
		|	РегСроки.ДатаПозднегоФиниша
		|ИЗ
		|	РегистрСведений.упоРасчетныеСрокиПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &Ссылка) КАК РегСроки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
		|		ПО РегСроки.Версия = Версии.Версия И Версии.Текущая";
	#Если Не ТолстыйКлиентУправляемоеПриложение Тогда
	РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, Новый Структура("Ссылка", ПроектнаяЗадача));
	#Иначе
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ПроектнаяЗадача);
	РезультатЗапроса = Запрос.Выполнить();
	#КонецЕсли
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СрокиЗадачи = Новый Структура("ДатаРаннегоСтарта, ДатаПозднегоСтарта, ДатаРаннегоФиниша, ДатаПозднегоФиниша");
	Пока Выборка.Следующий() Цикл
		Для каждого Срок Из СрокиЗадачи Цикл
			СрокиЗадачи[Срок.Ключ] = Выборка[Срок.Ключ];
		КонецЦикла;
		Возврат СрокиЗадачи;
	КонецЦикла;
	
КонецФункции

// Получает данные версии проектной задачи.
//
// Параметры:
//  ЭтаФорма				 - УправляемаяФорма - форма документа.
//  Объект					 - ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой надо получить данные версии.
//  ДополнительныеСвойства	 - Структура - дополнительные свойства.
//
Процедура ПолучитьДанныеВерсии(ЭтаФорма, Объект, ДополнительныеСвойства) Экспорт
	
	ОграничитьКопированиеИзУпрощенногоВвода = ДополнительныеСвойства.Свойство("ОграничитьКопированиеИзУпрощенногоВвода")
		И ДополнительныеСвойства.ОграничитьКопированиеИзУпрощенногоВвода;
	
	ЗагрузитьТрудовыеРесурсы = ДополнительныеСвойства.Свойство("ЗагрузитьТрудовыеРесурсы")
		И ДополнительныеСвойства.ЗагрузитьТрудовыеРесурсы;
	
	СсылкаКопирования = Неопределено;
	ДополнительныеСвойства.Свойство("СсылкаКопирования", СсылкаКопирования);
	
	//
	
	текВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	
	Если ЗначениеЗаполнено(СсылкаКопирования) Тогда
		СсылкаДанных = СсылкаКопирования;
	Иначе
		СсылкаДанных = Объект.Ссылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("текВерсия", текВерсия);
	Запрос.УстановитьПараметр("Ссылка", СсылкаДанных);
	
	// ПредусловияЗадачи
	Если Не ОграничитьКопированиеИзУпрощенногоВвода Тогда
		
		ТекстЗапроса = ТекстЗапросаПредусловия();
		Запрос.Текст = ТекстЗапроса;
		
		УстановитьПривилегированныйРежим(Истина);
		Результат = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат, Объект, "ПредусловияЗадачи");
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапросаДанныеВерсии();
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.ВыполнитьПакет();
	Выборка = Результат[1].Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
		
		Объект.НазваниеПроектнойЗадачи = Выборка.НазваниеЗадачи;
		Объект.ДлительностьМоделиПакетаРаботВЧасах = Выборка.Длительность;
		
		// Данные получили по источнику копирования, возвращаем ссылку на объект.
		Если ЗначениеЗаполнено(СсылкаКопирования) Тогда
			Объект.ПроектнаяЗадача = Объект.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	// ДвиженияДенежныхСредств
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[2], Объект, "ДвиженияДенежныхСредств");
	
	// Субпродукты
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[3], Объект, "Субпродукты");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[5], Объект, "РаспределениеОбъемов");
	
	// Проектная продукция
	ЗаполнитьТабличнуюЧастьПоДаннымПроектнойПродукции(Объект, ЭтаФорма);
	
	// МатериальныеРесурсы
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[6], Объект, "МатериальныеРесурсы");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[7], Объект, "РаспределениеПотребностей");
	
	// ТрудовыеРесурсы
	Если Не ОграничитьКопированиеИзУпрощенногоВвода Или ЗагрузитьТрудовыеРесурсы Тогда
		ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[8], Объект, "ТрудовыеРесурсы");
		ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[9], Объект, "ТрудовыеРесурсыПоПериодам");
	КонецЕсли;
	
	// ДополнительныеЗатраты
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[10], Объект, "ДополнительныеЗатраты");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[11], Объект, "РаспределениеДополнительныхЗатрат");
	
	// ПланДоходов
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[12], Объект, "ПланДоходов");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[14], Объект, "РаспределениеДоходов");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[15], Объект, "РаспределениеДоходовПоПериодам");
	
	// ПланРасходов
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[16], Объект, "ПланРасходов");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[17], Объект, "РаспределениеРасходов");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[18], Объект, "РаспределениеРасходовПоПериодам");
	
	// ПричиныОтклонений
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПричиныОтклонений() Тогда
		ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[19], Объект, "ПричиныОтклонений");
	КонецЕсли;
	
	упоПроектыИЗадачиОбщие.УстановитьТипЗадачи(Объект);
	
	Если ЭтаФорма <> Неопределено Тогда
		ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ДанныеВерсииПолучены", Истина);
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьПоДаннымПроектнойПродукции(Объект, ЭтаФорма)
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;

	СписокСвойств = "ПроцентРаспределения, Количество, КоэффициентСложности, Трудоемкость, Нормирование";
	Для Каждого СтрокаПП Из Объект.Субпродукты Цикл
        
        Если Не ТипЗнч(СтрокаПП.Ресурс) = Тип("СправочникСсылка.упоПроектнаяПродукция") Тогда
            Продолжить;	
        КонецЕсли;
        
		Для Каждого СтрокаРоли Из СтрокаПП.Ресурс.РолиТР Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Роль", СтрокаРоли.РольТР);
			ПараметрыОтбора.Вставить("Подразделение", СтрокаРоли.Подразделение);
			ПараметрыОтбора.Вставить("ИндексСтрокиВладельца", СтрокаПП.ИндексСтрокРаспределения);
			СтрокиРаспределения = Объект.РаспределениеОбъемов.НайтиСтроки(ПараметрыОтбора);
			
			Если СтрокиРаспределения.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокиРаспределения[0], СтрокаРоли, СписокСвойств);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Получает данные плана расходов версии проектной задачи.
//
// Параметры:
//  ЭтаФорма				 - УправляемаяФорма - форма документа.
//  Объект					 - ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой надо получить данные версии.
//
Процедура ПолучитьДанныеПланаРасходовВерсии(ЭтаФорма, Объект) Экспорт
	
	ФормаМодифицирована = ЭтаФорма <> Неопределено И ЭтаФорма.Модифицированность;
	
	текВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПланРасходов();
	
	Запрос.УстановитьПараметр("текВерсия", текВерсия);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИменаКолонок = "Ресурс, Подразделение, УровеньПланирования, Количество";
	ТекстСообщения = СформироватьСообщениеОНедостаткеДанныхТрансляции(Объект.ТрудовыеРесурсы.Выгрузить( , ИменаКолонок),
			Объект.УровеньПланированияТрудозатратДляБДР);
	
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	// ПланРасходов.
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[0], Объект, "ПланРасходов");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[1], Объект, "РаспределениеРасходов");
	ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(Результат[2], Объект, "РаспределениеРасходовПоПериодам");
	
	Если ЭтаФорма <> Неопределено И Не ФормаМодифицирована Тогда
		ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет наличие данных, необходимых для трансляции данных в таблицу плана расходов
//
// Параметры:
//  Таблица						 - ТаблицаЗначений - проверяемая таблица трудовых ресурсов.
//  УровеньПланированияДляБДР	 - ПеречислениеСсылка.упоУровеньПланированияТрудозатратДляБДР -
//		уровень планирования трудозатрат для трансляции.
//
// Возвращаемое значение:
//   - Строка
//
Функция СформироватьСообщениеОНедостаткеДанныхТрансляции(Таблица, УровеньПланированияДляБДР) Экспорт
	
	ТекстСообщения = НСтр("ru = ''");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УровеньПланированияДляБДР", УровеньПланированияДляБДР);
	Запрос.УстановитьПараметр("УровеньПланированияДляБДР_Авто", Перечисления.упоУровеньПланированияТрудозатратДляБДР.Авто);
	Запрос.УстановитьПараметр("УровеньПланированияДляБДР_Предв", Перечисления.упоУровеньПланированияТрудозатратДляБДР.ПредварительныйПоРолям);
	Запрос.УстановитьПараметр("УровеньПланированияДляБДР_Оконч", Перечисления.упоУровеньПланированияТрудозатратДляБДР.ОкончательныйПоРолям);
	Запрос.УстановитьПараметр("УровеньПредварительный", Перечисления.упоУровеньПланирования.Предварительный);
	Запрос.УстановитьПараметр("УровеньОкончательный", Перечисления.упоУровеньПланирования.Окончательный);
	Запрос.УстановитьПараметр("Таблица", Таблица);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Ресурс КАК Ресурс,
		|	Таблица.УровеньПланирования КАК Уровень
		|ПОМЕСТИТЬ втТаблицаПредварительный
		|ИЗ
		|	&Таблица КАК Таблица
		|ГДЕ
		|	Таблица.УровеньПланирования = &УровеньПредварительный
		|	И НЕ Таблица.Ресурс = ЗНАЧЕНИЕ(Справочник.упоРоли.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Ресурс КАК Ресурс,
		|	Таблица.УровеньПланирования КАК Уровень
		|ПОМЕСТИТЬ втТаблицаОкончательный
		|ИЗ
		|	&Таблица КАК Таблица
		|ГДЕ
		|	Таблица.УровеньПланирования = &УровеньОкончательный
		|	И НЕ Таблица.Ресурс = ЗНАЧЕНИЕ(Справочник.упоРоли.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ТаблицаОкончательный.Ресурс, ТаблицаПредварительный.Ресурс) КАК Ресурс,
		|	ВЫБОР
		|		КОГДА &УровеньПланированияДляБДР = &УровеньПланированияДляБДР_Авто
		|			ТОГДА ЕСТЬNULL(ТаблицаОкончательный.Уровень, ТаблицаПредварительный.Уровень)
		|		КОГДА &УровеньПланированияДляБДР = &УровеньПланированияДляБДР_Предв
		|			ТОГДА ТаблицаПредварительный.Уровень
		|		КОГДА &УровеньПланированияДляБДР = &УровеньПланированияДляБДР_Оконч
		|			ТОГДА ТаблицаОкончательный.Уровень
		|	КОНЕЦ КАК Уровень
		|ПОМЕСТИТЬ втТаблица
		|ИЗ
		|	втТаблицаПредварительный КАК ТаблицаПредварительный
		|		ПОЛНОЕ СОЕДИНЕНИЕ втТаблицаОкончательный КАК ТаблицаОкончательный
		|		ПО ТаблицаПредварительный.Ресурс = ТаблицаОкончательный.Ресурс
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &УровеньПланированияДляБДР = &УровеньПланированияДляБДР_Авто
		|				ТОГДА ИСТИНА
		|			КОГДА &УровеньПланированияДляБДР = &УровеньПланированияДляБДР_Предв
		|				ТОГДА ТаблицаПредварительный.Уровень = &УровеньПредварительный
		|			КОГДА &УровеньПланированияДляБДР = &УровеньПланированияДляБДР_Оконч
		|				ТОГДА ТаблицаОкончательный.Уровень = &УровеньОкончательный
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	втТаблица.Ресурс КАК Ресурс,
		|	втТаблица.Уровень КАК Уровень,
		|	РесурсыПоСтатьямЗатрат.СтатьяЗатрат КАК СтатьяЗатрат,
		|	РесурсыПоСтатьямЗатрат.СтатьяЗатрат.СпособПривязкиРасходовТрудозатраты КАК СпособПривязки,
		|	РесурсыПоСтатьямЗатрат.ДоляСуммы КАК ДоляСуммы
		|ИЗ
		|	втТаблица КАК втТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРаспределениеРесурсовПоСтатьямЗатрат КАК РесурсыПоСтатьямЗатрат
		|		ПО (РесурсыПоСтатьямЗатрат.Ресурс = втТаблица.Ресурс)";
	
	Рез = Запрос.Выполнить();
	
	Если Рез.Пустой() Тогда
		Возврат ТекстСообщения;
	КонецЕсли;
	
	Ш_НетСтатьи = НСтр("ru = 'Для ресурса %1 (уровень планирования %2) не указаны статьи затрат.'");
	Ш_НетПривязки = НСтр("ru = 'Для ресурса %1 (уровень планирования %2) в статье %3 не указан способ привязки.'");
	Ш_НетДоли = НСтр("ru = 'Для ресурса %1 (уровень планирования %2) для статьи %3 не указана доля суммы (%).'");
	
	Выборка = Рез.Выбрать();
	МассивСтрокКОбъединению = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.СтатьяЗатрат) Тогда
			тТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Ш_НетСтатьи,
					Выборка.Ресурс,
					Выборка.Уровень);
			МассивСтрокКОбъединению.Добавить(тТекст);
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.СпособПривязки) Тогда
			тТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Ш_НетПривязки,
					Выборка.Ресурс,
					Выборка.Уровень,
					Выборка.СтатьяЗатрат);
			МассивСтрокКОбъединению.Добавить(тТекст);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.ДоляСуммы) Тогда
			тТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Ш_НетДоли,
					Выборка.Ресурс,
					Выборка.Уровень,
					Выборка.СтатьяЗатрат);
			МассивСтрокКОбъединению.Добавить(тТекст);
		КонецЕсли;
	КонецЦикла;
	Если МассивСтрокКОбъединению.Количество() > 0 Тогда
		ТекстСообщения = СтрСоединить(МассивСтрокКОбъединению, Символы.ПС);
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

// Заполняет проектную задачу по основанию.
//
// Параметры:
//  ДанныеЗаполнения	- ДокументСсылка, СправочникСсылка - основание для заполнения.
//  Объект		 		- ДокументСсылка.упоПроектнаяЗадача - заполняемая ПЗ.
//
Процедура ЗаполнитьПЗПоОснованию(ДанныеЗаполнения, Объект) Экспорт
	
	Основание = ДанныеЗаполнения;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		Если ДанныеЗаполнения.Свойство("Проект") Тогда
			Основание = ДанныеЗаполнения.Проект;
		ИначеЕсли ДанныеЗаполнения.Свойство("ПроектнаяЗадача") Тогда
			Основание = ДанныеЗаполнения.ПроектнаяЗадача;
		КонецЕсли;
		
		ЗаписатьТипЗадачи = Ложь;
		Если ДанныеЗаполнения.Свойство("ЭтоВеха") Тогда
			Объект.ЭтоВеха = ДанныеЗаполнения.ЭтоВеха;
			ЗаписатьТипЗадачи = Истина;
		ИначеЕсли ДанныеЗаполнения.Свойство("ЭтоМодельПакетаРабот") Тогда
			Объект.ЭтоМодельПакетаРабот = ДанныеЗаполнения.ЭтоМодельПакетаРабот;
			ЗаписатьТипЗадачи = Истина;
		КонецЕсли;
		Если ЗаписатьТипЗадачи Тогда
			упоПроектыИЗадачиОбщие.ЗаписатьТипЗадачи(Объект);
		КонецЕсли;
		
	КонецЕсли;
	
	Объект.НормаСтоимости = Константы.упоНормаСтоимостиПоУмолчанию.Получить();
	Объект.НормаСтоимостиТрудовыхРесурсов = Константы.упоНормаСтоимостиПоУмолчанию.Получить();
	Объект.ВнешняяНормаСтоимостиТрудовыхРесурсов = Константы.упоНормаСтоимостиПоУмолчаниюВнешняя.Получить();
	Объект.ПланироватьТрудозатратыНаИсполнителей = Истина;
	
	// Этот реквизит всегда истина по умолчанию.
	Объект.ОбновлятьДатуДокумента = Истина;
	
	ЭтоPM_Проф = упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф();
	Если Не ЭтоPM_Проф Тогда
		ТипПроектнойЗадачи = Объект.ТипПроектнойЗадачи;
		Если Не ЗначениеЗаполнено(ТипПроектнойЗадачи) Тогда
			ТипПроектнойЗадачи = упоПроектыИЗадачиОбщие.ПолучитьТипЗадачи(Объект);
		КонецЕсли;
		Объект.ВыводитьВСводныйСтатусОтчет = ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Этап;
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(Объект, Основание);
	
	//
	
	ЗаполнитьРеквизитыЗадачиПоПроекту = Ложь;
	
	Если ТипЗнч(Основание) = Тип("СправочникСсылка.Проекты") Тогда
		Объект.ДокументОснование = Основание;
		Объект.Проект = Основание;
		упоПроектыИЗадачиСервер.ПроверитьТипПроекта(Объект.Проект);
		
		ЗаполнитьРеквизитыЗадачиПоПроекту = Истина;
		
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		Проект = упоФункцииБСП.ЗначениеРеквизитаОбъектаВызовСервера(Основание, "Проект");
		
		Объект.ДокументОснование = Основание;
		Объект.Проект = Проект;
		Объект.ЗадачаРодитель = Основание;
		
		ТекВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
		Если ЗначениеЗаполнено(ТекВерсияПроекта) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьСубпродуктыВПланДоходов,
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьМатРесурсыВПланРасходов,
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьТрудРесурсыВПланРасходов,
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьДопЗатратыВПланРасходов,
				|	упоСвойстваПроектныхЗадачСрезПоследних.НормаСтоимостиТрудовыхРесурсов,
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьПланДоходовВБДДС,
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьПланРасходовВБДДС,
				|	упоСвойстваПроектныхЗадачСрезПоследних.СхемаОплатыПоУмолчаниюРасходы,
				|	упоСвойстваПроектныхЗадачСрезПоследних.СхемаОплатыПоУмолчаниюДоходы,
				|	упоСвойстваПроектныхЗадачСрезПоследних.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов
				|ИЗ
				|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
				|			,
				|			Версия = &ТекВерсия
				|				И ПроектнаяЗадача = &ПЗ) КАК упоСвойстваПроектныхЗадачСрезПоследних";
			Запрос.УстановитьПараметр("ТекВерсия", ТекВерсияПроекта);
			Запрос.УстановитьПараметр("ПЗ", Основание);
			
			Результат = Запрос.Выполнить();
			Если Результат.Пустой() Тогда
				ЗаполнитьРеквизитыЗадачиПоПроекту = Истина;
			Иначе
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				ЗаполнитьЗначенияСвойств(Объект, Выборка);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаполнитьРеквизитыЗадачиПоПроекту Тогда
		
		РеквизитыПроекта = упоФункцииБСП.ЗначенияРеквизитовОбъектаВызовСервера(Объект.Проект,
				"ВключитьСубпродуктыВПланДоходов, ВключитьМатРесурсыВПланРасходов, 
				|ВключитьТрудРесурсыВПланРасходов, ВключитьДопЗатратыВПланРасходов,
				|упоВключитьПланДоходовВБДДС, упоВключитьПланРасходовВБДДС,
				|упоСхемаОплатыПоУмолчаниюДоходы, упоСхемаОплатыПоУмолчаниюРасходы, 
				|упоТипСубпродукта");
		ЗаполнитьЗначенияСвойств(Объект, РеквизитыПроекта);
		Объект.ВключитьПланДоходовВБДДС = РеквизитыПроекта.упоВключитьПланДоходовВБДДС;
		Объект.ВключитьПланРасходовВБДДС = РеквизитыПроекта.упоВключитьПланРасходовВБДДС;
		Объект.СхемаОплатыПоУмолчаниюРасходы = РеквизитыПроекта.упоСхемаОплатыПоУмолчаниюРасходы;
		Объект.СхемаОплатыПоУмолчаниюДоходы = РеквизитыПроекта.упоСхемаОплатыПоУмолчаниюДоходы;
		Объект.ТипСубпродукта = РеквизитыПроекта.упоТипСубпродукта;
		
		ПроектныеОпции = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
		Объект.НормаСтоимостиТрудовыхРесурсов = ПроектныеОпции.НормаСтоимостиТрудовыхРесурсов;
		Объект.ВнешняяНормаСтоимостиТрудовыхРесурсов = ПроектныеОпции.ВнешняяНормаСтоимостиТрудовыхРесурсов;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает список трудовых ресурсов, которые были назначены
//  на выполнение работ по задаче.
//
// Параметры:
//  ПроектнаяЗадача	 - ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой надо получить список трудовых ресурсов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - сформированный список исполнителей. Колонки:
//  * РольРесурса - СправочникСсылка.упоРоли - роль ресурса.
//  * Ресурс - СправочникСсылка.упоТрудовыеРесурсы - ресурс.
//
Функция ПолучитьСписокИсполнителей(ПроектнаяЗадача) Экспорт
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.РольРесурса,
		|	Рег.Ресурс
		|ИЗ
		|	РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадача И Версия = &текВерсия) КАК Рег
		|ГДЕ
		|	Рег.РесурсВыделен = ИСТИНА
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача.Проект);
	СтруктураПараметров = Новый Структура("ПроектнаяЗадача, текВерсия", ПроектнаяЗадача, текущаяВерсия);
	#Если Не ТолстыйКлиентУправляемоеПриложение Тогда
	РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, СтруктураПараметров);
	#Иначе
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("текВерсия", текущаяВерсия);
	РезультатЗапроса = Запрос.Выполнить();
	#КонецЕсли
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

// Процедура получает все необходимые данные документа.
//
// Параметры:
//  ПроектнаяЗадача	 - ДокументСсылка.упоПроектнаяЗадача - проектная задача, для которой надо получить все данные.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - сформированная структура данных.
//
Функция ПолучитьДанные(ПроектнаяЗадача) Экспорт
	
	НужныеТаблицы = Новый Структура("ДанныеЗадачи");
	
	Возврат упоПроектыИЗадачиСервер.ПолучитьДанныеПроектнойЗадачи(ПроектнаяЗадача, НужныеТаблицы);
	
КонецФункции

// Заполняет план расходов по трудовым ресурсам.
//
// Параметры:
//  Объект	- ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой заполняется план расходов по трудовым ресурсам.
//  Очищать	- Булево - признак предварительной очистки табличных частей "ПланРасходов" и "РаспределениеРасходов".
//
Процедура ЗаполнитьПланРасходовПоТрудовымРесурсам(Объект, Очищать = Истина, Свернуть = Истина,
		УчитыватьПериодРегистрацииНормСтоимости = Ложь) Экспорт
	
	Если Очищать Тогда
		ОчиститьПланРасходовРаспределениеРасходовКромеИсточникаТрудозатраты(Объект);
	КонецЕсли;
	
	Проект = Объект.Проект;
	ПроектнаяЗадача = Объект.Ссылка;
	
	ТаблицаТрудовыеРесурсы = Объект.ТрудовыеРесурсы.Выгрузить();
	ТаблицаТрудовыеРесурсыПоПериодам = Объект.ТрудовыеРесурсыПоПериодам.Выгрузить();
	ТаблицаПланРасходов = Объект.ПланРасходов.Выгрузить(Новый Массив);
	
	СтартовыйИндекс = упоАналитикаПоПодразделениямКлиентСервер.
		ПолучитьИндексСтрокРаспределенияНовойСтроки(Объект.ПланРасходов);
	
	упоРаспределениеТрудозатратВызовСервера.ЗаполнитьПланРасходовПоТрудовымРесурсам(Проект,
		ПроектнаяЗадача,
		ТаблицаТрудовыеРесурсы,
		ТаблицаТрудовыеРесурсыПоПериодам,
		ТаблицаПланРасходов,
		Объект.РаспределениеРасходов,
		СтартовыйИндекс,
		Свернуть,
		УчитыватьПериодРегистрацииНормСтоимости);
	
	Для Каждого Строка Из ТаблицаПланРасходов Цикл
		ЗаполнитьЗначенияСвойств(Объект.ПланРасходов.Добавить(), Строка);
	КонецЦикла;
	
КонецПроцедуры

// Очищает план расходов задачи: оставляет только строки, добавленные трансляцией трудозатрат.
//
// Параметры:
//  Объект					 - ДокументОбъект.упоПроектнаяЗадача, Структура - обрабатываемая задача.
//  ИмяТаблицы				 - Строка - Имя таблицы плана расходов.
//  ИмяПодчиненнойТаблицы	 - Строка - Имя таблицы распределения плана расходов.
//
Процедура ОчиститьПланРасходовРаспределениеРасходовКромеИсточникаТрудозатраты(Объект,
		ИмяТаблицы = "ПланРасходов",
		ИмяПодчиненнойТаблицы = "РаспределениеРасходов") Экспорт
	// Строки, добавленные трансляцией трудозатрат, не должны очищаться.
	
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаРасход Из Объект[ИмяТаблицы] Цикл
		Если СтрокаРасход.ИсточникПлана <> Перечисления.упоИсточникПланаДоходовИРасходов.Трудозатраты Тогда
			СтрокиКУдалению.Добавить(СтрокаРасход);
		КонецЕсли;
	КонецЦикла;
	Если СтрокиКУдалению.Количество() = Объект[ИмяТаблицы].Количество() Тогда
		Объект[ИмяТаблицы].Очистить();
		Объект[ИмяПодчиненнойТаблицы].Очистить();
	Иначе
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			НайденныеСтроки = Объект[ИмяПодчиненнойТаблицы].НайтиСтроки(
					Новый Структура("ИндексСтрокиВладельца", СтрокаКУдалению.ИндексСтрокРаспределения));
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Объект[ИмяПодчиненнойТаблицы].Удалить(НайденнаяСтрока);
			КонецЦикла;
			Объект[ИмяТаблицы].Удалить(СтрокаКУдалению);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет план расходов по плану доходов.
//
// Параметры:
//  Объект					 - ДокументОбъект.упоПроектнаяЗадача - ПЗ, для которой заполняется план расходов по трудовым ресурсам.
//  ИмяТаблицы				 - Строка							 - Имя таблицы плана расходов.
//  ИмяПодчиненнойТаблицы	 - Строка							 - Имя таблицы распределения плана расходов.
//  ИмяСсылки				 - Строка							 - Имя реквизита, содержащего ссылку на проектную задачу.
//  ОчиститьПланРасходов	 - 									 - Ложь - новые записи будут добавлены в таблицу без очистки существующих.
//
Процедура ЗаполнитьПланРасходовПоПлануДоходов(Объект,
		ИмяТаблицы = "ПланРасходов",
		ИмяПодчиненнойТаблицы = "РаспределениеРасходов",
		ИмяСсылки = "Ссылка",
		ОчиститьПланРасходов) Экспорт
		
	Если ОчиститьПланРасходов Тогда
		ОчиститьПланРасходовРаспределениеРасходовКромеИсточникаТрудозатраты(Объект, ИмяТаблицы, ИмяПодчиненнойТаблицы);
	КонецЕсли;
	
	СтруктураСвойствПоУмолчанию = упоАналитикаПоПодразделениямСервер.
		ПолучитьЗначенияДляПодстановкиПоУмолчанию(Объект.Проект);
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Валюта КАК Валюта,
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Подразделение КАК Подразделение,
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Роль КАК Роль,
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная КАК Сумма
	               |ПОМЕСТИТЬ втПланДоходов
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И ПроектнаяЗадача = &Ссылка
	               |				И ВидЭлемента = &ВидЭлементаДоход) КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних
	               |ГДЕ
	               |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Сумма <> 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоПроцентыЗатратСрезПоследних.СтатьяЗатрат КАК СтатьяЗатрат,
	               |	СУММА(упоПроцентыЗатратСрезПоследних.Процент) КАК Процент
	               |ПОМЕСТИТЬ втПроцентыЗатрат
	               |ИЗ
	               |	РегистрСведений.упоПроцентыЗатрат.СрезПоследних КАК упоПроцентыЗатратСрезПоследних
	               |ГДЕ
	               |	упоПроцентыЗатратСрезПоследних.Процент <> 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоПроцентыЗатратСрезПоследних.СтатьяЗатрат
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втПланДоходов.Валюта КАК Валюта,
	               |	втПланДоходов.Подразделение КАК Подразделение,
	               |	втПланДоходов.Роль КАК Роль,
	               |	втПланДоходов.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	               |	СУММА(втПланДоходов.Сумма) КАК СуммаДоход,
	               |	СУММА(втПроцентыЗатрат.Процент * втПланДоходов.Сумма / 100) КАК Сумма,
	               |	втПроцентыЗатрат.СтатьяЗатрат КАК Статья,
	               |	ВЫБОР
	               |		КОГДА втПроцентыЗатрат.СтатьяЗатрат.ПрофильРаспределенияПоУмолчанию = ЗНАЧЕНИЕ(Справочник.упоПрофилиРаспределенияДоходовИРасходов.ПустаяСсылка)
	               |			ТОГДА &ПрофильРасходовПоУмолчанию
	               |		ИНАЧЕ втПроцентыЗатрат.СтатьяЗатрат.ПрофильРаспределенияПоУмолчанию
	               |	КОНЕЦ КАК ПрофильРаспределения,
	               |	ВЫБОР
	               |		КОГДА втПроцентыЗатрат.СтатьяЗатрат.СпособПривязкиРасходовПоУмолчанию = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПустаяСсылка)
	               |			ТОГДА &СпособПривязкиПоУмолчанию
	               |		ИНАЧЕ втПроцентыЗатрат.СтатьяЗатрат.СпособПривязкиРасходовПоУмолчанию
	               |	КОНЕЦ КАК СпособПривязки
	               |ИЗ
	               |	втПланДоходов КАК втПланДоходов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втПроцентыЗатрат КАК втПроцентыЗатрат
	               |		ПО (ИСТИНА)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втПланДоходов.Валюта,
	               |	втПланДоходов.Подразделение,
	               |	втПланДоходов.Роль,
	               |	втПланДоходов.СобствСилы_Субподряд,
	               |	втПроцентыЗатрат.СтатьяЗатрат,
	               |	ВЫБОР
	               |		КОГДА втПроцентыЗатрат.СтатьяЗатрат.ПрофильРаспределенияПоУмолчанию = ЗНАЧЕНИЕ(Справочник.упоПрофилиРаспределенияДоходовИРасходов.ПустаяСсылка)
	               |			ТОГДА &ПрофильРасходовПоУмолчанию
	               |		ИНАЧЕ втПроцентыЗатрат.СтатьяЗатрат.ПрофильРаспределенияПоУмолчанию
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА втПроцентыЗатрат.СтатьяЗатрат.СпособПривязкиРасходовПоУмолчанию = ЗНАЧЕНИЕ(Перечисление.упоСпособПривязкиДоходаРасхода.ПустаяСсылка)
	               |			ТОГДА &СпособПривязкиПоУмолчанию
	               |		ИНАЧЕ втПроцентыЗатрат.СтатьяЗатрат.СпособПривязкиРасходовПоУмолчанию
	               |	КОНЕЦ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СУММА(втПроцентыЗатрат.Процент * втПланДоходов.Сумма / 100) КАК Сумма
	               |ИЗ
	               |	втПланДоходов КАК втПланДоходов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втПроцентыЗатрат КАК втПроцентыЗатрат
	               |		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("Ссылка", Объект[ИмяСсылки]);
	Запрос.УстановитьПараметр("Версия", ТекВерсия);
	Запрос.УстановитьПараметр("ВидЭлементаДоход",
		ПредопределенноеЗначение("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход"));
	Запрос.УстановитьПараметр("ПрофильРасходовПоУмолчанию", СтруктураСвойствПоУмолчанию.ПрофильРасходовПоУмолчанию);
	Запрос.УстановитьПараметр("СпособПривязкиПоУмолчанию",
		ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения"));
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ТаблицаРаспределения = Результаты[2].Выгрузить();
	ВыборкаДоходы = Результаты[3].Выбрать();
	
	Если ВыборкаДоходы.Следующий() Тогда
		ОбщаяСуммаРаспределения = ВыборкаДоходы.Сумма;
	КонецЕсли;
	
	ТаблицаСтатей = ТаблицаРаспределения.Скопировать();
	ТаблицаСтатей.Свернуть("Статья, Валюта, ПрофильРаспределения, СпособПривязки", "Сумма");
	ТаблицаСтатей.Колонки.Добавить("ИндексСтрокРаспределения");
	ТаблицаРаспределения.Колонки.Добавить("ИндексСтрокиВладельца");
	
	МассивКоэфСтатей = Новый Массив;
	Для Каждого СтрокаСтатья Из ТаблицаСтатей Цикл
		МассивКоэфСтатей.Добавить(СтрокаСтатья.Сумма);
	КонецЦикла;
	
	МассивСуммСтатей = упоФункцииОбщегоНазначенияСервер.РаспределитьПропорционально(ОбщаяСуммаРаспределения,
		МассивКоэфСтатей);
	Если МассивСуммСтатей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НачальныйИндекс = упоАналитикаПоПодразделениямКлиентСервер.
		ПолучитьИндексСтрокРаспределенияНовойСтроки(Объект.ПланРасходов);
	
	КоличествоСтатей = ТаблицаСтатей.Количество();
	
	Отбор = Новый Структура("Статья, Валюта");
	Для Индекс = 0 По КоличествоСтатей - 1 Цикл
		
		ТаблицаСтатей[Индекс].Сумма = МассивСуммСтатей[Индекс];
		
		ИндексСтрокРаспределения = Индекс + НачальныйИндекс + 1; 
		ТаблицаСтатей[Индекс].ИндексСтрокРаспределения = ИндексСтрокРаспределения;
		
		Если СвойстваПроекта.РасходыПоПодразделениям Тогда
			
			МассивКоэф = Новый Массив;
			
			Отбор.Статья = ТаблицаСтатей[Индекс].Статья;
			Отбор.Валюта = ТаблицаСтатей[Индекс].Валюта;
			НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(Отбор);
			Для Каждого СтрокаРаспределение Из НайденныеСтроки Цикл
				СтрокаРаспределение.ИндексСтрокиВладельца = ИндексСтрокРаспределения;
				МассивКоэф.Добавить(СтрокаРаспределение.СуммаДоход);
			КонецЦикла;
			
			МассивСумм = упоФункцииОбщегоНазначенияСервер.РаспределитьПропорционально(ТаблицаСтатей[Индекс].Сумма, МассивКоэф);
			
			КоличествоНайденныхСтрок = НайденныеСтроки.Количество();
			Для ИндексСтрокиВМассиве = 0 По КоличествоНайденныхСтрок - 1 Цикл
				НайденныеСтроки[ИндексСтрокиВМассиве].Сумма = МассивСумм[ИндексСтрокиВМассиве];
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицыСтатей ИЗ ТаблицаСтатей Цикл
		ЗаполнитьЗначенияСвойств(Объект[ИмяТаблицы].Добавить(), СтрокаТаблицыСтатей);
	КонецЦикла;
	
	Если СвойстваПроекта.РасходыПоПодразделениям Тогда
		Для каждого СтрокаТаблицыРаспределения ИЗ ТаблицаРаспределения	Цикл
			СтрокаДобавления = Объект[ИмяПодчиненнойТаблицы].Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДобавления, СтрокаТаблицыРаспределения);
			СтрокаДобавления.СпособПривязки = упоАналитикаПоПодразделениямКлиентСервер.
				СпособПривязкиРаспределенияПоСпособуПривязкиДоходаРасхода(СтрокаТаблицыРаспределения.СпособПривязки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет распределение плана доходов по трудовым ресурсам.
//
// Параметры:
//  СтруктураПараметров - Структура:
//      * Объект	- ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой заполняется план доходов по трудовым ресурсам.
//      * Очищать	- Булево - признак предварительной очистки табличных частей "ПланДоходов" и "РаспределениеДоходов".
//      * УровеньПланирования	- Перечисление.упоУровеньПланирования
//      * ДанныеСтрокиРаспределения - Структура:
//          * ИндексСтрокРаспределения - Число
//          * Сумма - Число
//
Процедура ЗаполнитьРаспределениеДоходовПоТрудовымМатериальнымРесурсам(СтруктураПараметров) Экспорт
	
	Объект = Неопределено;
	Очищать = Неопределено;
	УровеньПланирования = Неопределено;
	ТолькоТрудовыеРесурсы = Неопределено;
	ДанныеСтрокиРаспределения = Неопределено;
	ТолькоМатРесурсы = Неопределено;
	
	СтруктураПараметров.Свойство("Объект", Объект);
	СтруктураПараметров.Свойство("Очищать", Очищать);
	СтруктураПараметров.Свойство("УровеньПланирования", УровеньПланирования);
	СтруктураПараметров.Свойство("ТолькоТрудовыеРесурсы", ТолькоТрудовыеРесурсы);
	СтруктураПараметров.Свойство("ДанныеСтрокиРаспределения", ДанныеСтрокиРаспределения);
	СтруктураПараметров.Свойство("ТолькоМатРесурсы", ТолькоМатРесурсы);
		
	Если Очищать Тогда       
        ОчиститьДанныеРаспределения(Объект, ДанныеСтрокиРаспределения.ИндексСтрокРаспределения, "ИндексСтрокиВладельца",
            "РаспределениеДоходов");
	КонецЕсли;
	
	// Если есть данные по уровню планирования "Предварительный" и нет по "Окончательный",
	// то заполнять по "Предварительный".
	// Если есть данные по уровню планирования "Окончательный", то заполнять по "Окончательный".
    Если ТолькоТрудовыеРесурсы Тогда
    	КолонкаСтоимость = "ОбщВнешняяСтоимость";
        ТаблицаРесурсы = ТаблицаТрудовыхРесурсовПоУровням(Объект.ТрудовыеРесурсы.Выгрузить(), УровеньПланирования, 
            КолонкаСтоимость);
	Иначе
    	КолонкаСтоимость = "Стоимость";
        ТаблицаРесурсы = ТаблицаПлановРесурсов(Объект, УровеньПланирования, ТолькоМатРесурсы);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаРесурсы) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщаяСумма = ДанныеСтрокиРаспределения.Сумма;
	ОбщаяСуммаДляРасчетаДоли = ТаблицаРесурсы.Итог(КолонкаСтоимость);
	ВалютаУпрУчета = упоПроектноеБюджетированиеПовтИсп.ВалютаУправленческогоУчета();
	
	ЗначенияПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Объект.Проект);
	
	НастройкиУчета = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	Для Каждого СтрокаТР Из ТаблицаРесурсы Цикл
		Если СтрокаТР[КолонкаСтоимость] = 0 Тогда
			Продолжить;
        КонецЕсли;
		НоваяСтрокаРаспределения = Объект.РаспределениеДоходов.Добавить();
		НоваяСтрокаРаспределения.ИндексСтрокиВладельца = ДанныеСтрокиРаспределения.ИндексСтрокРаспределения;
		НоваяСтрокаРаспределения.КонтрагентПодрядчик = ЗначенияПоУмолчанию.КонтрагентДоходовПоУмолчанию;
		НоваяСтрокаРаспределения.ЗаказДоговорПодрядчика = ЗначенияПоУмолчанию.ДоговорДоходовПоУмолчанию;
		НоваяСтрокаРаспределения.Роль = СтрокаТР.Ресурс;
		НоваяСтрокаРаспределения.Подразделение = СтрокаТР.Подразделение;
        Если ТолькоТрудовыеРесурсы Тогда
             НоваяСтрокаРаспределения.СобствСилы_Субподряд = упоАналитикаПоПодразделениямСервер.СССП_Роли(СтрокаТР.Ресурс);	
        Иначе
            НоваяСтрокаРаспределения.СобствСилы_Субподряд = ?(ЗначениеЗаполнено(СтрокаТР.СобствСилы_Субподряд), 
                СтрокаТР.СобствСилы_Субподряд, упоАналитикаПоПодразделениямСервер.СССП_Роли(СтрокаТР.Ресурс));
		КонецЕсли;
		НоваяСтрокаРаспределения.Сумма = СтрокаТР[КолонкаСтоимость] / ОбщаяСуммаДляРасчетаДоли * ОбщаяСумма;
		Если Не НастройкиУчета.ДоходыПоНатуральнымПоказателям Тогда
			НоваяСтрокаРаспределения.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;
			НоваяСтрокаРаспределения.ПрофильРаспределения = ЗначенияПоУмолчанию.ПрофильДоходовПоУмолчанию;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет план доходов по планам ресурсов (материальные, трудовые).
//
// Параметры:
//  СтруктураПараметров - Структура:
//      * Объект	- ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой заполняется план доходов по трудовым ресурсам.
//      * Очищать	- Булево - признак предварительной очистки табличных частей "ПланДоходов" и "РаспределениеДоходов".
//      * УровеньПланирования	- Перечисление.упоУровеньПланирования
//      * ТолькоТрудовыеРесурсы - Булево
//
Процедура ЗаполнитьПланДоходовПоПланамТрудовыхМатериальныхРесурсов(СтруктураПараметров) Экспорт
	
	Объект = Неопределено;
	Очищать = Неопределено;
	УровеньПланирования = Неопределено;
	ТолькоТрудовыеРесурсы = Неопределено;
	ТолькоМатРесурсы = Неопределено;
	
	СтруктураПараметров.Свойство("Объект", Объект);
	СтруктураПараметров.Свойство("Очищать", Очищать);
	СтруктураПараметров.Свойство("УровеньПланирования", УровеньПланирования);
	СтруктураПараметров.Свойство("ТолькоТрудовыеРесурсы", ТолькоТрудовыеРесурсы);
	СтруктураПараметров.Свойство("ТолькоМатРесурсы", ТолькоМатРесурсы);
	
	Если Очищать Тогда
		Объект.ПланДоходов.Очистить();
		Объект.РаспределениеДоходов.Очистить();
	КонецЕсли;
	
	// Если есть данные по уровню планирования "Предварительный" и нет по "Окончательный",
	// то заполнять по "Предварительный".
	// Если есть данные по уровню планирования "Окончательный", то заполнять по "Окончательный".
    Если ТолькоТрудовыеРесурсы Тогда
    	КолонкаСтоимость = "ОбщВнешняяСтоимость";
        ТаблицаРесурсы = ТаблицаТрудовыхРесурсовПоУровням(Объект.ТрудовыеРесурсы.Выгрузить(), УровеньПланирования, 
            КолонкаСтоимость);
	Иначе
    	КолонкаСтоимость = "Стоимость";
        ТаблицаРесурсы = ТаблицаПлановРесурсов(Объект, УровеньПланирования, ТолькоМатРесурсы);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТаблицаРесурсы) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщаяСумма = ТаблицаРесурсы.Итог(КолонкаСтоимость);
	ВалютаУпрУчета = упоПроектноеБюджетированиеПовтИсп.ВалютаУправленческогоУчета();
	
	ЗначенияПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Объект.Проект);
	
	НоваяСтрока = Объект.ПланДоходов.Добавить();
	ИндексСтрокРаспределения =
		упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(Объект.ПланДоходов);
	НоваяСтрока.ИндексСтрокРаспределения = ИндексСтрокРаспределения;
	НоваяСтрока.Сумма = ОбщаяСумма;
	НоваяСтрока.Валюта = ВалютаУпрУчета;
	НоваяСтрока.Статья = ЗначенияПоУмолчанию.СтатьяДоходовПоУмолчанию;
	НоваяСтрока.СпособПривязки = Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения;
	НоваяСтрока.ПрофильРаспределения = ЗначенияПоУмолчанию.ПрофильДоходовПоУмолчанию;
	НоваяСтрока.Договор = ЗначенияПоУмолчанию.ДоговорДоходовПоУмолчанию;
	НоваяСтрока.Контрагент = ЗначенияПоУмолчанию.КонтрагентДоходовПоУмолчанию;
	
	ИндексСтроки = Объект.ПланДоходов.Индекс(НоваяСтрока);
	
	РесурсыБезСтоимости = Новый Массив;
	
	НастройкиУчета = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	Если НастройкиУчета.ДоходыПоПодразделениям Тогда
		
		Для Каждого СтрокаТР Из ТаблицаРесурсы Цикл
			
			НоваяСтрокаРаспределения = Объект.РаспределениеДоходов.Добавить();
			НоваяСтрокаРаспределения.ИндексСтрокиВладельца = ИндексСтрокРаспределения;
			НоваяСтрокаРаспределения.КонтрагентПодрядчик = ЗначенияПоУмолчанию.КонтрагентДоходовПоУмолчанию;
			НоваяСтрокаРаспределения.ЗаказДоговорПодрядчика = ЗначенияПоУмолчанию.ДоговорДоходовПоУмолчанию;
			НоваяСтрокаРаспределения.Роль = СтрокаТР.Ресурс;
			НоваяСтрокаРаспределения.Подразделение = СтрокаТР.Подразделение;
			Если ТолькоТрудовыеРесурсы Тогда
				НоваяСтрокаРаспределения.СобствСилы_Субподряд = упоАналитикаПоПодразделениямСервер.СССП_Роли(СтрокаТР.Ресурс);
			Иначе
				НоваяСтрокаРаспределения.СобствСилы_Субподряд = ?(ЗначениеЗаполнено(СтрокаТР.СобствСилы_Субподряд), 
					СтрокаТР.СобствСилы_Субподряд,
					упоАналитикаПоПодразделениямСервер.СССП_Роли(СтрокаТР.Ресурс));
			КонецЕсли;
			НоваяСтрокаРаспределения.Сумма = СтрокаТР[КолонкаСтоимость];
			Если СтрокаТР[КолонкаСтоимость] = 0 Тогда
				РесурсыБезСтоимости.Добавить(СтрокаТР.Ресурс);
			КонецЕсли;
			Если Не НастройкиУчета.ДоходыПоНатуральнымПоказателям Тогда
				НоваяСтрокаРаспределения.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.ПоПрофилюРаспределения;
				НоваяСтрокаРаспределения.ПрофильРаспределения = ЗначенияПоУмолчанию.ПрофильДоходовПоУмолчанию;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РесурсыБезСтоимости) Тогда
		ШаблонСообщения = НСтр("ru = 'В строке №%1 таблицы ""План доходов"" не заполнена стоимость по ресурсам:
		|%2.
		|Суммы дохода необходимо заполнить вручную.'");
		НомерСтрокиДляТекстаСообщения = ИндексСтроки + 1;
		РолиСтрокой = СтрСоединить(РесурсыБезСтоимости, Символы.ПС);
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, 
			НомерСтрокиДляТекстаСообщения, РолиСтрокой);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет СписокПотомков полным перечнем зависимых проектных задач
//
// Параметры:
//  Объект	- ДокументСсылка.упоПроектнаяЗадача - ПЗ, для которой собирается список потомков.
//  СписокПотомков	- СписокЗначений - хранит весь список потомков.
//
Процедура ПолучитьПолныйСписокПотомков(Объект, СписокПотомков) Экспорт
	
	Если ТипЗнч(Объект) <> Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		Возврат;
	КонецЕсли;
	
	ПрямыеПотомки = упоПредставлениеПроектаВызовСервера.обПолучитьСписокПрямыхПотомковЗадачи(Объект);
	Для Каждого ПЗПотомок Из ПрямыеПотомки Цикл
		СписокПотомков.Добавить(ПЗПотомок.ПроектнаяЗадача);
		ПолучитьПолныйСписокПотомков(ПЗПотомок.ПроектнаяЗадача, СписокПотомков)
	КонецЦикла;
	
КонецПроцедуры

#Область Интеграция_с_ДО

// Возвращает неинтегрируемые реквизиты задачи для Документооборота.
//
// Возвращаемое значение:
//  Массив - реквизиты, которые не должны участвовать в интеграции ДО
//
Функция НеинтегрируемыеРеквизитыОбъектаИС() Экспорт
	
	НеинтегрируемыеРеквизиты = Новый Массив;
	НеинтегрируемыеРеквизиты.Добавить("Дата");
	НеинтегрируемыеРеквизиты.Добавить("ОбновлятьДатуДокумента");
	НеинтегрируемыеРеквизиты.Добавить("Номер");
	НеинтегрируемыеРеквизиты.Добавить("Автор");
	// Не меняем тип ПЗ и положение в иерархии.
	НеинтегрируемыеРеквизиты.Добавить("ТипПроектнойЗадачи");
	НеинтегрируемыеРеквизиты.Добавить("ЭтоВеха");
	НеинтегрируемыеРеквизиты.Добавить("ЭтоМодельПакетаРабот");
	НеинтегрируемыеРеквизиты.Добавить("ЭтоПакетРабот");
	НеинтегрируемыеРеквизиты.Добавить("ЗадачаРодитель");
	// Не меняем сроки ПЗ.
	НеинтегрируемыеРеквизиты.Добавить("ДатаНачалаПлан");
	НеинтегрируемыеРеквизиты.Добавить("ДатаЗавершенияПлан");
	НеинтегрируемыеРеквизиты.Добавить("РучнойВводСроков");
	НеинтегрируемыеРеквизиты.Добавить("КрайнийСрок");
	НеинтегрируемыеРеквизиты.Добавить("ДлительностьБезУчетаКалендаряПроекта");
	НеинтегрируемыеРеквизиты.Добавить("ДлительностьМоделиПакетаРабот");
	НеинтегрируемыеРеквизиты.Добавить("ДлительностьМоделиПакетаРаботВЧасах");
	НеинтегрируемыеРеквизиты.Добавить("МетодРасчетаМоделиПакетаРабот");
	НеинтегрируемыеРеквизиты.Добавить("ЗапретитьАвтоЗапуск");
	// Не меняем флаги импорта.
	НеинтегрируемыеРеквизиты.Добавить("ФлагИмпортаMSP");
	НеинтегрируемыеРеквизиты.Добавить("СкопированаВСводныйИзЗадачи");
	
	Возврат НеинтегрируемыеРеквизиты;
	
КонецФункции

