Функция ТекстЗапросаДанныеВерсии()
	
	ТекстыЗапроса = Новый Массив;
	
	ТекстЗапроса = упоПроектыИЗадачиСервер.ТекстЗапросаВременнаяТаблицаПрогнозныеСроки();
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = ТекстЗапросаСвойстваПЗ();
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = ТекстЗапросаДанныеТабличныхЧастей();
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	ТекстЗапроса = ТекстЗапросаПланРасходов();
	ТекстыЗапроса.Добавить(ТекстЗапроса);
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПричиныОтклонений() Тогда
		ТекстЗапроса = ТекстЗапросаПричиныОтклонений();
		ТекстыЗапроса.Добавить(ТекстЗапроса);
	КонецЕсли;
	
	Возврат СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
КонецФункции

Функция ТекстЗапросаПредусловия()
	
	Возврат "ВЫБРАТЬ
	|	предУсловия.ПроектнаяЗадача КАК ПроектнаяЗадача,
	|	предУсловия.ЗадачаПредшественник КАК ЗадачаПредшественник,
	|	предУсловия.НомерСтроки КАК НомерСтроки,
	|	предУсловия.СвязьСуществует КАК СвязьСуществует,
