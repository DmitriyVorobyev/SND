Функция ТаблицаТрудовыхРесурсовПоУровням(ИсходнаяТаблицаТрудовыхРесурсов, УровеньПланирования, КолонкаСтоимости)
	
	ТаблицаТрудовыхРесурсовПоУровням =
		упоРаспределениеТрудозатратВызовСервера.ТаблицаТрудовыхРесурсовПоУровням(ИсходнаяТаблицаТрудовыхРесурсов,
			КолонкаСтоимости, УровеньПланирования);
	
	Возврат ТаблицаТрудовыхРесурсовПоУровням;
	
КонецФункции

Функция ТаблицаПлановРесурсов(Объект, УровеньПланирования, ТолькоМатРесурсы)
	
	ТаблицаПлановРесурсов = СтруктураТаблицыПлановРесурсов();
		
	Если Не ТолькоМатРесурсы Тогда
	
		ТаблицаТрудовыхРесурсовПоУровням =
			упоРаспределениеТрудозатратВызовСервера.ТаблицаТрудовыхРесурсовПоУровням(Объект.ТрудовыеРесурсы.Выгрузить(),
				"ОбщВнешняяСтоимость", УровеньПланирования);
		
		Если ТаблицаТрудовыхРесурсовПоУровням.Количество() Тогда
			ЗаполнитьТаблицуПлановРесурсов("ОбщВнешняяСтоимость", ТаблицаТрудовыхРесурсовПоУровням, ТаблицаПлановРесурсов);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаМатериальныхРесурсов = ТаблицаМатериальныхРесурсов(Объект.РаспределениеПотребностей.Выгрузить());
	
	Если ТаблицаМатериальныхРесурсов.Количество() Тогда
		ЗаполнитьТаблицуПлановРесурсов("ОбщСтоимость", ТаблицаМатериальныхРесурсов, ТаблицаПлановРесурсов);
	КонецЕсли;
	
	Возврат ТаблицаПлановРесурсов;
	
КонецФункции

Процедура ЗаполнитьТаблицуПлановРесурсов(ИмяКолонкиСтоимость, ТаблицаИсточник, ТаблицаПриемник)
	
	Для каждого РесурсИсточник Из ТаблицаИсточник Цикл
		СтрокаРесурс = ТаблицаПриемник.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРесурс, РесурсИсточник);
		СтрокаРесурс.Стоимость = РесурсИсточник[ИмяКолонкиСтоимость];
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаМатериальныхРесурсов(ИсходнаяТаблицаМатериальныхРесурсов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|   ИсходнаяТаблицаМатериальныхРесурсов.Роль КАК Роль,
		|   ИсходнаяТаблицаМатериальныхРесурсов.Подразделение КАК Подразделение,
		|   ИсходнаяТаблицаМатериальныхРесурсов.Количество КАК Количество,
		|   ИсходнаяТаблицаМатериальныхРесурсов.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   ИсходнаяТаблицаМатериальныхРесурсов.Сумма КАК ОбщСтоимость
		|ПОМЕСТИТЬ ВТ_МатериальныеРесурсы
		|ИЗ
		|   &ИсходнаяТаблицаМатериальныхРесурсов КАК ИсходнаяТаблицаМатериальныхРесурсов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|   ВТ_МатериальныеРесурсы.Роль КАК Ресурс,
		|   ВТ_МатериальныеРесурсы.Подразделение КАК Подразделение,
		|   ВТ_МатериальныеРесурсы.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
		|   СУММА(ВТ_МатериальныеРесурсы.Количество) КАК Количество,
		|   СУММА(ВТ_МатериальныеРесурсы.ОбщСтоимость) КАК ОбщСтоимость
		|ИЗ
		|   ВТ_МатериальныеРесурсы КАК ВТ_МатериальныеРесурсы
		|
		|СГРУППИРОВАТЬ ПО
		|   ВТ_МатериальныеРесурсы.Подразделение,
		|   ВТ_МатериальныеРесурсы.Роль,
		|   ВТ_МатериальныеРесурсы.СобствСилы_Субподряд";
	
	Запрос.УстановитьПараметр("ИсходнаяТаблицаМатериальныхРесурсов", ИсходнаяТаблицаМатериальныхРесурсов);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Функция СтруктураТаблицыПлановРесурсов()
	
	СтруктураТаблицыПлановРесурсов = Новый ТаблицаЗначений;
	СтруктураТаблицыПлановРесурсов.Колонки.Добавить("Количество",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 5)));
	СтруктураТаблицыПлановРесурсов.Колонки.Добавить("Стоимость",
		Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 2)));
	СтруктураТаблицыПлановРесурсов.Колонки.Добавить("СобствСилы_Субподряд",
		Новый ОписаниеТипов("СправочникСсылка.упоСобственныеСилыСубподряд"));
	СтруктураТаблицыПлановРесурсов.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.упоПодразделения"));
	СтруктураТаблицыПлановРесурсов.Колонки.Добавить("Ресурс", Новый ОписаниеТипов("СправочникСсылка.упоРоли"));
	
	Возврат СтруктураТаблицыПлановРесурсов;
	
КонецФункции

Процедура ЗаполнитьТабличнуюЧастьПоДаннымЗапроса(РезультатЗапроса, Объект, ИмяТабличнойЧасти)
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Объект[ИмяТабличнойЧасти].Очистить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(Объект[ИмяТабличнойЧасти].Добавить(), Выборка);
		КонецЦикла;
	ИначеЕсли Объект.Проведен Тогда
		Объект[ИмяТабличнойЧасти].Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьДанныеРаспределения(Объект, ИндексСтрокРаспределения, ИмяКолонкиРаспределения, ИмяТЧ)

    ОтборОчистка = Новый Структура(ИмяКолонкиРаспределения, 
        ИндексСтрокРаспределения);
    СтрокиКУдалению = Объект[ИмяТЧ].НайтиСтроки(ОтборОчистка);

    Если СтрокиКУдалению.Количество() Тогда
        Для каждого Строка Из СтрокиКУдалению Цикл
            Объект[ИмяТЧ].Удалить(Строка);	
        КонецЦикла;    	
    КонецЕсли;
    
КонецПроцедуры

