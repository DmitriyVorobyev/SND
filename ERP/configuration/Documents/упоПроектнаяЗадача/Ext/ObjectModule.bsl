Функция ЗаменитьРеквизитОбъектУПотомков(СписокПотомков, ЗначениеРеквизитаОбъект)
	
	Если текущаяВерсия = Неопределено Тогда
		текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	&ТекущаяДата КАК Период,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК Регистратор,
		|	упоСвойстваПроектныхЗадачСрезПоследних.Версия КАК Версия,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации КАК ВидОперации,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьДопЗатратыВПланРасходов КАК ВключитьДопЗатратыВПланРасходов,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьМатРесурсыВПланРасходов КАК ВключитьМатРесурсыВПланРасходов,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьСубпродуктыВПланДоходов КАК ВключитьСубпродуктыВПланДоходов,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьТрудРесурсыВПланРасходов КАК ВключитьТрудРесурсыВПланРасходов,
		|	упоСвойстваПроектныхЗадачСрезПоследних.Длительность КАК Длительность,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ДлительностьБезУчетаКалендаряПроекта КАК ДлительностьБезУчетаКалендаряПроекта,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ДлительностьМоделиПакетаРабот КАК ДлительностьМоделиПакетаРабот,
		|	упоСвойстваПроектныхЗадачСрезПоследних.УдалитьДлительностьПоОсвоенномуОбъему КАК УдалитьДлительностьПоОсвоенномуОбъему,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЕдиницаНормированияДлительности КАК ЕдиницаНормированияДлительности,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель КАК ЗадачаРодитель,
		|	упоСвойстваПроектныхЗадачСрезПоследних.КалендарьЗадачи КАК КалендарьЗадачи,
		|	упоСвойстваПроектныхЗадачСрезПоследних.КодПроектногоДокумента КАК КодПроектногоДокумента,
		|	упоСвойстваПроектныхЗадачСрезПоследних.КрайнийСрок КАК КрайнийСрок,
		|	упоСвойстваПроектныхЗадачСрезПоследних.КритерийРезультата КАК КритерийРезультата,
		|	упоСвойстваПроектныхЗадачСрезПоследних.МетодРасчетаМоделиПакетаРабот КАК МетодРасчетаМоделиПакетаРабот,
		|	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК НазваниеЗадачи,
		|	упоСвойстваПроектныхЗадачСрезПоследних.НормаСтоимости КАК НормаСтоимости,
		|	упоСвойстваПроектныхЗадачСрезПоследних.НормаСтоимостиТрудовыхРесурсов КАК НормаСтоимостиТрудовыхРесурсов,
		|	&Объект КАК Объект,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ОписаниеЗадачи КАК ОписаниеЗадачи,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ОписаниеРезультата КАК ОписаниеРезультата,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПланироватьТрудозатратыНаИсполнителей КАК ПланироватьТрудозатратыНаИсполнителей,
		|	упоСвойстваПроектныхЗадачСрезПоследних.РучнойВводСроков КАК РучнойВводСроков,
		|	упоСвойстваПроектныхЗадачСрезПоследних.СпособПланированияРасходов КАК СпособПланированияРасходов,
		|	упоСвойстваПроектныхЗадачСрезПоследних.СпособПривязкиДопЗатрат КАК СпособПривязкиДопЗатрат,
		|	упоСвойстваПроектныхЗадачСрезПоследних.СуммаСанкцийЗаДеньЗадержки КАК СуммаСанкцийЗаДеньЗадержки,
		|	упоСвойстваПроектныхЗадачСрезПоследних.СхемаОплатыПоУмолчаниюРасходы КАК СхемаОплатыПоУмолчаниюРасходы,
		|	упоСвойстваПроектныхЗадачСрезПоследних.СхемаОплатыПоУмолчаниюДоходы КАК СхемаОплатыПоУмолчаниюДоходы,
		|	упоСвойстваПроектныхЗадачСрезПоследних.УдалитьОписаниеРезультатаФакт КАК УдалитьОписаниеРезультатаФакт,
		|	упоСвойстваПроектныхЗадачСрезПоследних.УчестьРучнойВводСроковПриАктуализации КАК УчестьРучнойВводСроковПриАктуализации,
		|	упоСвойстваПроектныхЗадачСрезПоследних.УровеньПланированияТрудозатратДляБДР КАК УровеньПланированияТрудозатратДляБДР,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоВеха КАК ЭтоВеха,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьПланРасходовВБДДС КАК ВключитьПланРасходовВБДДС,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВключитьПланДоходовВБДДС КАК ВключитьПланДоходовВБДДС,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоМодельПакетаРабот КАК ЭтоМодельПакетаРабот,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоПакетРабот КАК ЭтоПакетРабот,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненныйПроект КАК ПодчиненныйПроект,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ПодчиненнаяПроектнаяЗадача КАК ПодчиненнаяПроектнаяЗадача,
		|	упоСвойстваПроектныхЗадачСрезПоследних.НеВыводитьВСтатусОтчет КАК НеВыводитьВСтатусОтчет,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВыводитьВСводныйСтатусОтчет КАК ВыводитьВСводныйСтатусОтчет,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ЭтоАктируемаяЗадача КАК ЭтоАктируемаяЗадача,
		|	упоСвойстваПроектныхЗадачСрезПоследних.ВнешняяНормаСтоимостиТрудовыхРесурсов КАК ВнешняяНормаСтоимостиТрудовыхРесурсов
		|ИЗ
		|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &ТекВерсия
		|				И ПроектнаяЗадача В (&СписокПЗ)) КАК упоСвойстваПроектныхЗадачСрезПоследних
		|ГДЕ
		|	упоСвойстваПроектныхЗадачСрезПоследних.Объект <> &Объект";
	
	Запрос.УстановитьПараметр("СписокПЗ", СписокПотомков);
	Запрос.УстановитьПараметр("ТекВерсия", текущаяВерсия);
	Запрос.УстановитьПараметр("Объект", ЗначениеРеквизитаОбъект);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НЗ = РегистрыСведений.упоСвойстваПроектныхЗадач.СоздатьНаборЗаписей();
		НЗ.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
		НЗ.Прочитать();
		
		НоваяЗапись = Неопределено;
		Для Каждого Запись Из НЗ Цикл
			Если Запись.Версия = ВыборкаДетальныеЗаписи.Версия Тогда 
				НоваяЗапись = Запись;
			КонецЕсли;
		КонецЦикла;
	    Если НоваяЗапись = Неопределено Тогда
			НоваяЗапись = НЗ.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
		
		Попытка 
			НЗ.Записать();
		Исключение 
			
			Возврат Ложь;
		КонецПопытки;

	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьСообщениеПользователю(ТекстСообщения, ИмяПроверяемойТЧ, стрПроверяемойТЧ, ПолеИмя, Отказ)
	
	Поле = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Объект.%1[%2].%3Остаток", 
								ИмяПроверяемойТЧ, 
								Формат(ЭтотОбъект[ИмяПроверяемойТЧ].Индекс(стрПроверяемойТЧ), "ЧН=0; ЧГ=0"),
								ПолеИмя);
								
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , Поле, , Отказ);	
	
КонецПроцедуры

// Создает документ упоИзменениеРуководителяПроектнойЗадачи в случае проведения ПЗ при условии,
// что в ПЗ есть основная роль. Если основной роли нет, действий по снятию РПЗ не производится.
// Снятие основной роли отрабатывается в форме ПЗ.
//
Процедура СоздатьДокументНазначениеРуководителяПЗ(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СвойстваПроекта.НазначатьРСПОсновнойРолиКакРПЗ Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееПодразделениеОсновнойРоли = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("НазначитьРПЗИзПодразделения", ТекущееПодразделениеОсновнойРоли) Тогда
		Возврат;
	КонецЕсли;
	
	НеобходимоОбновитьРПЗ = Истина;
	
	Если ЗначениеЗаполнено(ТекущееПодразделениеОсновнойРоли) Тогда
		АвтоНазначенныйРПЗ = упоИерархияИПолномочияВызовСервера.НепосредственныйРуководительПодразделения(
			ТекущееПодразделениеОсновнойРоли);
		РПЗ = упоИерархияИПолномочияСервер.ПолучитьРуководителяПроектнойЗадачиПоИерархии(Ссылка);
		
		НеобходимоОбновитьРПЗ = АвтоНазначенныйРПЗ <> РПЗ;
	Иначе
		АвтоНазначенныйРПЗ = Справочники.упоСотрудники.ПустаяСсылка();
	КонецЕсли;
	
	Если Не НеобходимоОбновитьРПЗ Тогда
		Возврат;
	КонецЕсли;
	
	//
	
	ДокументНазначение = Документы.упоИзменениеРуководителяПроектнойЗадачи.СоздатьДокумент();
	ДокументНазначение.ДополнительныеСвойства.Вставить("ОтключитьПроверкуАвтоматическогоНазначенияРПЗ", Истина);
	ДокументНазначение.Дата = ТекущаяДатаСеанса();
	ДокументНазначение.Проект = Проект;
	ДокументНазначение.ПроектнаяЗадача = Ссылка;
	ДокументНазначение.РуководительПроектнойЗадачи = АвтоНазначенныйРПЗ;
	
	Попытка
		ДокументНазначение.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("ОшибкаЗаписиПроектнойЗадачи", УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.упоПроектнаяЗадача,, ПредставлениеОшибки);
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Ошибка записи структуры проекта. Подробнее см. журнал регистрации.'"),
			,,, Отказ);
	КонецПопытки;
	
КонецПроцедуры

Функция ИсходноеПодразделениеОсновнойРоли()
	
	ИсходноеПодразделение = Справочники.упоПодразделения.ПустаяСсылка();	
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версия", текущаяВерсия);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", Ссылка);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Подразделение КАК Подразделение
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	               |			,
	               |			Версия = &Версия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	               |ГДЕ
	               |	(упоДанныеПлановТрудозатратРолейСрезПоследних.Количество <> 0
	               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.Стоимость <> 0
	               |			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.ОбщСтоимость <> 0)
	               |	И упоДанныеПлановТрудозатратРолейСрезПоследних.Основной";
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		ИсходноеПодразделение = Выборка.Подразделение;
	КонецЕсли;	
	
	Возврат ИсходноеПодразделение;
	
КонецФункции

Функция ТекущееПодразделениеОсновнойРоли()
	
	ТекущееПодразделение = Справочники.упоПодразделения.ПустаяСсылка();
			
	СтрокаОсновнойРоли = ТрудовыеРесурсы.Найти(Истина, "Основной");
	Если СтрокаОсновнойРоли <> Неопределено Тогда
		ТекущееПодразделение = СтрокаОсновнойРоли.Подразделение;
	КонецЕсли;	

	Возврат ТекущееПодразделение;
		
КонецФункции

// Удаление "чужих" строк трансляции, добавленных при отображени на форме. 
// Заполнение реквизита ИсточникПлана в "родных" строках.
//
// Параметры:
//	ДанныеДвижений	– Структура – структура с данными движений документа.
//
Процедура ОбработатьИсточникиПлана_ДоходыИРасходы(ДанныеДвижений)
	
	Отбор = Новый Структура("ВидЭлемента, ИндексСтрокиВладельца");
	
	ИсточникПланаМенеджер = Перечисления.упоИсточникПланаДоходовИРасходов;
	ИсключаемыеИсточникиПлана = Новый Соответствие;
	ИсключаемыеИсточникиПлана.Вставить(ИсточникПланаМенеджер.Трудозатраты, 			Истина);
	ИсключаемыеИсточникиПлана.Вставить(ИсточникПланаМенеджер.Объемы, 				Истина);
	ИсключаемыеИсточникиПлана.Вставить(ИсточникПланаМенеджер.МатериальныеЗатраты, 	Истина);
	ИсключаемыеИсточникиПлана.Вставить(ИсточникПланаМенеджер.ДополнительныеЗатраты, Истина);
	
	ВидЭлементаДоход = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход;
	ВидЭлементаРасход = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход;
	
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаПланДР Из ДанныеДвижений.упоДанныеПлановДоходовИРасходов Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПланДР.ИсточникПлана) Тогда
			// Заполнение источника плана.
			СтрокаПланДР.ИсточникПлана = ИсточникПланаМенеджер.ДоходыРасходы;
			Продолжить; // Продолжить
		КонецЕсли;
		
		Если ИсключаемыеИсточникиПлана.Получить(СтрокаПланДР.ИсточникПлана) = Неопределено Тогда
			// "Родная" строка
			Продолжить; // Продолжить
		КонецЕсли;
		
		НужнаОбработкаПодразделений = 
			(СвойстваПроекта.РасходыПоПодразделениям И СтрокаПланДР.ВидЭлемента = ВидЭлементаРасход)
			Или (СвойстваПроекта.ДоходыПоПодразделениям И СтрокаПланДР.ВидЭлемента = ВидЭлементаДоход);
		
		// Удаление из движений строк трансляции трудозатрат.
		Если НужнаОбработкаПодразделений Тогда
			
			Отбор.ВидЭлемента = СтрокаПланДР.ВидЭлемента;
			Отбор.ИндексСтрокиВладельца = СтрокаПланДР.ИндексСтрокРаспределения;
			
			СтрокиПоПодразделениям = ДанныеДвижений.упоДанныеПлановДоходовИРасходовПодразделения.НайтиСтроки(Отбор);
			Для Каждого СтрокаПоПодразделению Из СтрокиПоПодразделениям Цикл
				ДанныеДвижений.упоДанныеПлановДоходовИРасходовПодразделения.Удалить(СтрокаПоПодразделению);
			КонецЦикла;
			
		КонецЕсли;
		
		СтрокиКУдалению.Добавить(СтрокаПланДР);
		
	КонецЦикла;
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		ДанныеДвижений.упоДанныеПлановДоходовИРасходов.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Отбор = Новый Структура("ИсточникПлана", ИсточникПланаМенеджер.ПустаяСсылка());
	ПустыеИсточники = ДанныеДвижений.упоДанныеПлановДоходовИРасходовПодразделения.НайтиСтроки(Отбор);
	Для Каждого ПустойИсточник Из ПустыеИсточники Цикл
		ПустойИсточник.ИсточникПлана = ИсточникПланаМенеджер.ДоходыРасходы;
	КонецЦикла;
	
КонецПроцедуры

Функция ТранслироватьОбъемыВТрудозатраты()
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИсточникПлана", ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаТрудозатратРолей.Объемы"));
	
	Результат = ЭтотОбъект.ТрудовыеРесурсы.НайтиСтроки(ПараметрыОтбора).Количество() <> 0;
	
	Возврат Результат;

КонецФункции //

Процедура КонтрольПриОтменеСписанФакт(Отказ)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗадачаОтменена Тогда
		Возврат;
	КонецЕсли;
	
	// Входящие в этап задачи не проверяем, т.к. для этапа установлен запрет отмены из документа.
	СписокПроверяемыхЗадач = Новый СписокЗначений;
	СписокПроверяемыхЗадач.Добавить(Ссылка);
	
	СписокЗадачиСписанФакт = упоПроектыИЗадачиСервер.ПолучитьЗадачиСписанФакт(СписокПроверяемыхЗадач);
	Если Не ЗначениеЗаполнено(СписокЗадачиСписанФакт) Тогда
		Возврат; // Возврат
	КонецЕсли;
	
	Представление = СтрШаблон("%1. %2",
		упоПроектыИЗадачиВызовСервера.обПолучитьКодСДРПроектнойЗадачи(Ссылка),
		НазваниеПроектнойЗадачи);
		
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'По задаче ""%1"" списан факт. Нельзя отменить проектные задачи, по которым списан факт.'"),
		Представление);
		
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
	
КонецПроцедуры

Функция ОтключитьПроверкуЦикличности(Объект)
	
    Отключено = Объект.ДополнительныеСвойства.Свойство("ОтключитьПроверкуЦикличности") И Объект.ДополнительныеСвойства.ОтключитьПроверкуЦикличности;
	Возврат Отключено;

КонецФункции

#Область ЗаписьИПроведение

Процедура ОбработатьПроектнуюПродукциюПриПроведении()
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	ПроектнаяПродукция = ПолучитьСоздатьЭлементыПроектнойПродукции();
	
	УстановитьСтатусУдаленнойПроектнойПродукции();
	
КонецПроцедуры

Функция ПолучитьСоздатьЭлементыПроектнойПродукции()
	
	СозданныеСПД = МодульупоПроектнаяПродукция.СоздатьОбновитьПроектнуюПродукциюВСубпродуктах(ЭтотОбъект.Ссылка,
		ЭтотОбъект.Субпродукты,
		ЭтотОбъект.РаспределениеОбъемов);
	
	Возврат СозданныеСПД.Получить(ЭтотОбъект.Ссылка);
	
КонецФункции

Процедура УстановитьСтатусУдаленнойПроектнойПродукции()
	
	УдаленнаяПП = Неопределено;
	ДополнительныеСвойства.Свойство("УдаленнаяПП", УдаленнаяПП);
	
	Если ЗначениеЗаполнено(УдаленнаяПП) Тогда
		МодульупоПроектнаяПродукция.УстановитьСтатусПроектнойПродукции(УдаленнаяПП, Дата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаменитьЗначениеРеквизитаОбъектУПотомков(Отказ)
	
	УпрощенноеСоздание = ЭтоСозданиеИзСтруктуры();
	
	ЗаменятьЗначениеРеквизитаОбъектУПотомков = 
		СвойствоСтруктуры(ДополнительныеСвойства, "ЗаменятьЗначениеРеквизитаОбъектУПотомков");
		
	Если Не УпрощенноеСоздание И ЗаменятьЗначениеРеквизитаОбъектУПотомков Тогда
		СписокПотомков = Новый СписокЗначений;
		ПолучитьПолныйСписокПотомков(СписокПотомков);
		Если ЗаменитьРеквизитОбъектУПотомков(СписокПотомков, ЭтотОбъект.Объект) Тогда
			ЭтотОбъект.ДополнительныеСвойства.ЗаменятьЗначениеРеквизитаОбъектУПотомков = Ложь;
		Иначе
			ТекстОШибки = НСтр("ru = 'Изменение реквизита ""Объект"" у потомков %1 не выполнено.'");
			ТекстОШибки = СтрШаблон(ТекстОШибки, ЭтотОбъект.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура АктуализироватьРПЗИПоручения(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	АктуализироватьРПЗ = Не СвойствоСтруктуры(ДополнительныеСвойства, "НеАктуализироватьРПЗ");
	Если АктуализироватьРПЗ Тогда
		упоИерархияИПолномочияСервер.АктуализироватьРуководителейПроектныхЗадачПоИерархии(Ссылка, , , текущаяВерсия);
	КонецЕсли;
	
	АктуализироватьЗадания = Не СвойствоСтруктуры(ДополнительныеСвойства, "НеАктуализироватьЗадания");
	Если АктуализироватьЗадания Тогда
		упоЗадания.СинхронизироватьПорученияЗадач(Ссылка, Неопределено, текущаяВерсия);
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольУдаления(РежимЗаписи, Отказ)
	
	ЭтоУдалениеПроектнойЗадачи = СвойствоСтруктуры(ДополнительныеСвойства, "УдалениеПроектнойЗадачи");
	
	Если ЭтоУдалениеПроектнойЗадачи Тогда
		Возврат;
	КонецЕсли;
	
	Если (ПометкаУдаления И НЕ Ссылка.ПометкаУдаления)
		Или РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ОбщегоНазначения.СообщитьПользователю(
			Нстр("ru = 'Для запрашиваемого действия воспользуйтесь кнопкой ""Удалить задачу""!'")
			, , , , Отказ);
	КонецЕсли;
		
КонецПроцедуры

Процедура ОчиститьДанныеПриОтключенииПроектныхОпций()
	
	Если СвойстваПроекта = Неопределено Тогда
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	КонецЕсли;
	
	Если Не СвойстваПроекта.ПланироватьЗатратыНаМатериалы И ЗначениеЗаполнено(ЭтотОбъект.МатериальныеРесурсы) Тогда
		ЭтотОбъект.МатериальныеРесурсы.Очистить();
		упоПроектыИЗадачиОбщие.ОчиститьСтрокиРаспределенияПоПодразделениям(ЭтотОбъект.РаспределениеПотребностей, 
			ЭтотОбъект.РаспределениеРасходовПоПериодам, "ИндексСтрокиРаспределениеПоРолям", 
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.МатериальныеЗатраты"));
	КонецЕсли;
	Если Не СвойстваПроекта.ДоходыПоНатуральнымПоказателям И ЗначениеЗаполнено(ЭтотОбъект.Субпродукты) Тогда
		ЭтотОбъект.Субпродукты.Очистить();
		упоПроектыИЗадачиОбщие.ОчиститьСтрокиРаспределенияПоПодразделениям(ЭтотОбъект.РаспределениеОбъемов, 
			ЭтотОбъект.РаспределениеДоходовПоПериодам, "ИндексСтрокиРаспределениеПоРолям",
			ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаДоходовИРасходов.Объемы"));
	КонецЕсли;
	Если Не СвойстваПроекта.ПланироватьДополнительныеЗатратыПоЗадаче 
		И ЗначениеЗаполнено(ЭтотОбъект.ДополнительныеЗатраты) Тогда
		ЭтотОбъект.ДополнительныеЗатраты.Очистить();
		упоПроектыИЗадачиОбщие.ОчиститьСтрокиРаспределенияПоПодразделениям(ЭтотОбъект.РаспределениеДополнительныхЗатрат, 
			ЭтотОбъект.РаспределениеРасходовПоПериодам, "ИндексСтрокиРаспределениеПоРолям");
	КонецЕсли;
	Если Не СвойстваПроекта.ВедетсяБюджетДоходов И ЗначениеЗаполнено(ЭтотОбъект.ПланДоходов) Тогда
		ЭтотОбъект.ПланДоходов.Очистить();
		упоПроектыИЗадачиОбщие.ОчиститьСтрокиРаспределенияПоПодразделениям(ЭтотОбъект.РаспределениеДоходов, 
			ЭтотОбъект.РаспределениеДоходовПоПериодам, "ИндексСтрокиРаспределенияДоходов");
	КонецЕсли;
	Если Не СвойстваПроекта.ВедетсяБюджетРасходов И ЗначениеЗаполнено(ЭтотОбъект.ПланРасходов) Тогда
		ЭтотОбъект.ПланРасходов.Очистить();
		упоПроектыИЗадачиОбщие.ОчиститьСтрокиРаспределенияПоПодразделениям(ЭтотОбъект.РаспределениеРасходов, 
			ЭтотОбъект.РаспределениеРасходовПоПериодам, "ИндексСтрокиРаспределенияРасходов");
	КонецЕсли;
	Если Не СвойстваПроекта.ПланироватьТрудозатратыПоПроекту И ЗначениеЗаполнено(ЭтотОбъект.ТрудовыеРесурсы) Тогда
		ЭтотОбъект.ТрудовыеРесурсы.Очистить();
		ЭтотОбъект.ТрудовыеРесурсыПоПериодам.Очистить();
	КонецЕсли;
	Если Не СвойстваПроекта.ВедетсяБюджетДвиженияДенежныхСредств И ЗначениеЗаполнено(ЭтотОбъект.ДвиженияДенежныхСредств) Тогда
		ЭтотОбъект.ДвиженияДенежныхСредств.Очистить();
	КонецЕсли;

КонецПроцедуры

Процедура КонтрольВозможностиПроведенияПоСвойствам(РежимЗаписи, Отказ)
	
	Если Не РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеСвойства.Свойство("ДанныеВерсииПолучены")
		И Не ДополнительныеСвойства.Свойство("ЭтоИнтерактивнаяЗапись") Тогда
		
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Проведение проектной задачи невозможно: данные версии не получены.'"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьПредусловия()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для каждого предусловие Из ПредусловияЗадачи Цикл
		Если НЕ ЗначениеЗаполнено(предусловие.ТипСвязи) Тогда
			предусловие.ТипСвязи = Перечисления.упоТипСвязи.ОкончаниеНачало;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(предусловие.ЕдиницаНормированияДлительности) Тогда
			предусловие.ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.Час;
		КонецЕсли;
		Если предусловие.СвязьМеждуПроектами Тогда
			ПроектСвязи = упоФункцииБСП.ЗначениеРеквизитаОбъектаВызовСервера(предусловие.ЗадачаПредшественник, "Проект");
			Если ПроектСвязи = Проект Тогда
				предусловие.СвязьМеждуПроектами = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		предусловие.ЗадержкаВЧасах = предусловие.Задержка * предусловие.ЕдиницаНормированияДлительности.Коэффициент;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПроверитьЗаполнитьТабличныеЧастиРаспределений(Отказ)
	
	// При записи из шаблона не проверяем заполнение и не добавляем лишние строки.
	Если НужноНеПроверятьЗаполнятьТабличныеЧастиРаспределений() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметрыОбработки = упоАналитикаПоПодразделениямКлиентСервер.ПараметрыОбработкиДанныхРаспределения(Ложь);
	упоАналитикаПоПодразделениямСервер.ПроверитьЗаполнитьТабличныеЧастиРаспределений(ЭтотОбъект, ДополнительныеПараметрыОбработки, 
		СвойстваПроекта,,Отказ);
	
КонецПроцедуры

Процедура ПоставитьПроектыПредусловийВОчередьПересчетаСроков(РежимЗаписи)
	
	ИспользоватьАвтоматическийРасчетСроковСвязанныхПроектов =
		Константы.упоАвтоматическийРасчетСроковСвязанныхПроектов.Получить();
	Если Не ИспользоватьАвтоматическийРасчетСроковСвязанныхПроектов Тогда
		Возврат;
	КонецЕсли;
	
	УпрощенноеСоздание = ЭтоСозданиеИзСтруктуры();
	ЭтоУдалениеПроектнойЗадачи = СвойствоСтруктуры(ДополнительныеСвойства, "УдалениеПроектнойЗадачи");
	Если НЕ УпрощенноеСоздание И ЗначениеЗаполнено(Ссылка) И (РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ ЭтоУдалениеПроектнойЗадачи) Тогда
		упоРасчетКалендарныхСроковРедакция3Сервер.ПриИзмененииСроковЗадачНеобходимоПересчитатьПроекты(Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДатуДокумента(РежимЗаписи)
	
	Если Не РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	НеОбновлятьДатуДокумента = СвойствоСтруктуры(ДополнительныеСвойства, "НеОбновлятьДатуДокумента");
	Если НЕ НеОбновлятьДатуДокумента Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДлительностьМоделиПакетаРабот()
	
	Если ЭтоВеха Тогда
		ДлительностьМоделиПакетаРабот = 0;
	КонецЕсли;
	ДлительностьМоделиПакетаРаботВЧасах = ДлительностьМоделиПакетаРабот * ЕдиницаНормированияДлительности.Коэффициент;
	
КонецПроцедуры

Процедура ПрименитьПроектныеОпции()
	
	// При отключении проектных опций очищаем соответствующие ТЧ.
	ОчиститьДанныеПриОтключенииПроектныхОпций();
	
	ОбработатьНаследованиеОбъектаИзРодителя();
	
	СнятьФлагиТрансляцииПриОтключенииПроектныхОпций();
	
	ЗапомнитьПодразделениеОсновнойРоли();
	
КонецПроцедуры

Процедура ОбработатьНаследованиеОбъектаИзРодителя()
	
	Если Не ДополнительныеСвойства.ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗадачаРодитель) Тогда
		Возврат;
	КонецЕсли;
	
	НаследоватьЗначениеПоляОбъектИзЗадачиРодителя = СвойстваПроекта.НаследоватьЗначениеПоляОбъектИзЗадачиРодителя;
	Если НаследоватьЗначениеПоляОбъектИзЗадачиРодителя Тогда
		Свойство = "Объект";
		ЭтотОбъект[Свойство] = упоПроектыИЗадачиСервер.ПолучитьСвойстваПроектнойЗадачи(ЗадачаРодитель, Свойство)[Свойство];
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьВыводВСтатусОтчет()

	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеСвойства.Свойство("НеНужноДелатьПроверкуНаТипЗадачи")
		И (ДополнительныеСвойства.ЭтоНовый И Не ДополнительныеСвойства.Свойство("ЭтоИнтерактивнаяЗапись")) Тогда
		упоПроектыИЗадачиСервер.ЗаполнитьРеквизитВыводитьВСводныйСтатусОтчет(ТипПроектнойЗадачи, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапомнитьСвойстваНовогоДокумента()
	
	Если Не ДополнительныеСвойства.ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ДанныеВерсииПолучены", Истина);
	ДополнительныеСвойства.Вставить("ИспользоватьРодителяИзДокумента", Истина);
	
КонецПроцедуры

Процедура ЗапомнитьПодразделениеОсновнойРоли()

	Если Не СвойстваПроекта.НазначатьРСПОсновнойРолиКакРПЗ Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.ЭтоНовый Тогда
		ИсходноеОсновноеПодразделение = Справочники.упоПодразделения.ПустаяСсылка();
	Иначе
		ИсходноеОсновноеПодразделение = ИсходноеПодразделениеОсновнойРоли();
	КонецЕсли;
	ТекущееОсновноеПодразделение = ТекущееПодразделениеОсновнойРоли();

	Если ИсходноеОсновноеПодразделение <> ТекущееОсновноеПодразделение Тогда
		ДополнительныеСвойства.Вставить("НазначитьРПЗИзПодразделения", ТекущееОсновноеПодразделение);
	КонецЕсли;
	
КонецПроцедуры

// Формирует список удаленной ПП для изменения статуса ПП при проведении ПЗ.
//
Процедура ЗапомнитьУдаленнуюПроектнуюПродукцию()
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	МодульупоПроектнаяПродукция = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукция");
	
	Если ДополнительныеСвойства.Свойство("ЭтоНовый") И ДополнительныеСвойства.ЭтоНовый Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("НеПроверятьУдалениеПП") И ДополнительныеСвойства.НеПроверятьУдалениеПП Тогда
		Возврат;
	КонецЕсли;
	
	СубпродуктыТЧ = Субпродукты.ВыгрузитьКолонку("Ресурс");
	УдаленнаяПП = МодульупоПроектнаяПродукция.СписокУдаленныхПроектныхПродуктов(СубпродуктыТЧ, Ссылка, текущаяВерсия);
	ДополнительныеСвойства.Вставить("УдаленнаяПП", УдаленнаяПП);
	
КонецПроцедуры

Процедура ПоставитьПроектВОчередьПересчетаСроков(РежимЗаписи);
	
	УпрощенноеСоздание = ЭтоСозданиеИзСтруктуры();
	Если УпрощенноеСоздание Тогда
		Возврат;
	КонецЕсли;	
	
	ЭтоУдалениеПроектнойЗадачи = СвойствоСтруктуры(ДополнительныеСвойства, "УдалениеПроектнойЗадачи");	
	ЭтоПроведениеУдалениеПроектнойЗадачи = ЗначениеЗаполнено(Ссылка) 
		И (РежимЗаписи = РежимЗаписиДокумента.Проведение ИЛИ ЭтоУдалениеПроектнойЗадачи);
		
	Если Не ЭтоПроведениеУдалениеПроектнойЗадачи Тогда
		Возврат;
	КонецЕсли;
	
	Если Не НеобходимоПоставитьПроектВОчередьРасчетаСроков() Тогда
		Возврат;
	КонецЕсли;
	
	упоРасчетКалендарныхСроковРедакция3Сервер.ДобавитьВОчередьРасчетаСроковПроектов(ЭтотОбъект.Проект);
	
КонецПроцедуры

Функция НеобходимоПоставитьПроектВОчередьРасчетаСроков()
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЭтотОбъект.РучнойВводСроков Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ИзменилисьСрокиПроектнойЗадачи() Тогда
		Возврат Ложь;
	КонецЕсли;

	Если упоРасчетКалендарныхСроковРедакция3Сервер.ПроектВОчередиРасчетаСроков(ЭтотОбъект.Проект) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если Не СвойстваПроекта.ЗапретитьРПЗИзменятьСрокиЧужихЗадач Тогда
		Возврат Истина;
	КонецЕсли;
	
	Пользователь = ПользователиКлиентСервер.АвторизованныйПользователь();
	РуководительПроекта = упоИерархияИПолномочияСервер.ПолучитьРуководителяПроекта(ЭтотОбъект.Проект);
	
	Если Пользователь = РуководительПроекта Тогда
		Возврат Истина;
	КонецЕсли;
	
	СписокСотрудниковДиспетчера = упоИерархияИПолномочияВызовСервера.обПолучитьСписокСотрудниковДиспетчера(
		Пользователь);
	ЭтоДиспетчер = СписокСотрудниковДиспетчера.НайтиПоЗначению(РуководительПроекта) <> Неопределено;
	
	Если ЭтоДиспетчер Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ИзменилисьСрокиПроектнойЗадачи()
	
	ИзменилисьСроки = Истина;
	
	СрокиПЗИзБазы = ПолучитьСроки();
	Если СрокиПЗИзБазы <> Неопределено
		И ЭтотОбъект.ДатаНачалаПлан = СрокиПЗИзБазы.ДатаНачала
		И ЭтотОбъект.ДатаЗавершенияПлан = СрокиПЗИзБазы.ДатаЗавершения Тогда
		ИзменилисьСроки = Ложь;
	КонецЕсли;
	
	Возврат ИзменилисьСроки;
	
КонецФункции

Процедура СнятьФлагиТрансляцииПриОтключенииПроектныхОпций()

	Если ЭтотОбъект.ВключитьДопЗатратыВПланРасходов И Не СвойстваПроекта.ПланироватьДополнительныеЗатратыПоЗадаче Тогда
		ЭтотОбъект.ВключитьДопЗатратыВПланРасходов = Ложь;
	КонецЕсли;
	Если ЭтотОбъект.ВключитьМатРесурсыВПланРасходов И Не СвойстваПроекта.ПланироватьЗатратыНаМатериалы Тогда
		ЭтотОбъект.ВключитьМатРесурсыВПланРасходов = Ложь;
	КонецЕсли;
	Если ЭтотОбъект.ВключитьСубпродуктыВПланДоходов И Не СвойстваПроекта.ДоходыПоНатуральнымПоказателям Тогда
		ЭтотОбъект.ВключитьСубпродуктыВПланДоходов = Ложь;
	КонецЕсли;	
	Если ЭтотОбъект.ВключитьТрудРесурсыВПланРасходов И Не СвойстваПроекта.ПланироватьТрудозатратыПоПроекту Тогда
		ЭтотОбъект.ВключитьТрудРесурсыВПланРасходов = Ложь;
	КонецЕсли;
	Если ЭтотОбъект.ВключитьПланДоходовВБДДС и Не СвойстваПроекта.ВедетсяБюджетДвиженияДенежныхСредств Тогда
		ЭтотОбъект.ВключитьПланДоходовВБДДС = Ложь;	
	КонецЕсли;
	Если ЭтотОбъект.ВключитьПланРасходовВБДДС и Не СвойстваПроекта.ВедетсяБюджетДвиженияДенежныхСредств Тогда
		ЭтотОбъект.ВключитьПланРасходовВБДДС = Ложь;	
	КонецЕсли;
	Если Не СвойстваПроекта.ВедетсяБюджетРасходов Тогда
		Если ЭтотОбъект.ВключитьПланРасходовВБДДС Тогда
			ЭтотОбъект.ВключитьПланРасходовВБДДС = Ложь;		
		КонецЕсли; 
		Если ЭтотОбъект.ВключитьМатРесурсыВПланРасходов Тогда
			ЭтотОбъект.ВключитьМатРесурсыВПланРасходов = Ложь;		
		КонецЕсли; 
		Если ЭтотОбъект.ВключитьДопЗатратыВПланРасходов Тогда
			ЭтотОбъект.ВключитьДопЗатратыВПланРасходов = Ложь;		
		КонецЕсли; 
		Если ЭтотОбъект.ВключитьТрудРесурсыВПланРасходов Тогда
			ЭтотОбъект.ВключитьТрудРесурсыВПланРасходов = Ложь;		
		КонецЕсли;
	КонецЕсли;
 	Если Не СвойстваПроекта.ВедетсяБюджетДоходов Тогда
		Если ЭтотОбъект.ВключитьПланДоходовВБДДС Тогда
			ЭтотОбъект.ВключитьПланДоходовВБДДС = Ложь;		
		КонецЕсли; 
		Если ЭтотОбъект.ВключитьСубпродуктыВПланДоходов Тогда
			ЭтотОбъект.ВключитьСубпродуктыВПланДоходов = Ложь;		
		КонецЕсли; 
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьПроектнуюПродукциюВРегистрахСкопированнойЗадачи()
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗагрузитьДанныеИзРегистров") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРегистров = ЭтотОбъект.ДополнительныеСвойства.ЗагрузитьДанныеИзРегистров;
	
	ЕстьДанныеСубпродуктов = ДанныеРегистров.Свойство("упоДанныеПлановВыпускаСубпродуктов") 
		И ДанныеРегистров.упоДанныеПлановВыпускаСубпродуктов.Количество();
		
	Если Не ЕстьДанныеСубпродуктов Тогда
		Возврат;
	КонецЕсли;
		
	ЗаменяемаяСозданнаяПП = МодульупоПроектнаяПродукция.НоваяПроектнаяПродукцияДляКопируемойЗадачи(ЭтотОбъект.Ссылка, 
		ДанныеРегистров.упоДанныеПлановВыпускаСубпродуктов);
		
	Если Не ЗначениеЗаполнено(ЗаменяемаяСозданнаяПП) Тогда
		Возврат;	
	КонецЕсли;
	
	ЗаменитьПроектнуюПродукциюВРегистреНаНовую(ДанныеРегистров.упоДанныеПлановВыпускаСубпродуктов,
		ЗаменяемаяСозданнаяПП, "Номенклатура");
	
	ЗаменитьПроектнуюПродукциюВРегистреНаНовую(ДанныеРегистров.упоАктуальныеПланыВыполненияОбъемов,
		ЗаменяемаяСозданнаяПП, "Номенклатура");
	
	ЗаменитьПроектнуюПродукциюВРегистреНаНовую(ДанныеРегистров.упоДанныеПроектнойПродукции,
		ЗаменяемаяСозданнаяПП, "ПроектнаяПродукция");
		
КонецПроцедуры

Процедура ЗаменитьПроектнуюПродукциюВРегистреНаНовую(ТаблицаРегистра, ЗаменяемаяСозданнаяПП, ИмяКолонкиПП)

	Для каждого СтрокаРегистра Из ТаблицаРегистра Цикл
		СозданнаяПП = ЗаменяемаяСозданнаяПП.Получить(СтрокаРегистра[ИмяКолонкиПП]); 
		СтрокаРегистра[ИмяКолонкиПП] = СозданнаяПП;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроверкаЗаполнения

Функция ПолучитьСписокОшибокЗаполненияПроектнойПродукции()
	
	Ошибки = Неопределено;
	
	Если ТипСубпродукта <> ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
		Возврат Ошибки;
	КонецЕсли;
	
	ОбработанныеРесурсыОбъемов = Новый Соответствие;
	ИсточникОбъемы = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоИсточникПланаТрудозатратРолей.Объемы");
	
	ШаблонОшибки = нСтр("ru='Для транслируемого из проектной продукции ресурса ""%1"" в строке №%2 уже указаны трудозатраты по подразделению ""%3"".'", "ru");
	
	Для Каждого СтрокаТрудовойРесурс Из ТрудовыеРесурсы Цикл
		
		Если СтрокаТрудовойРесурс.ИсточникПлана <> ИсточникОбъемы Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбработанныеРесурсыОбъемов[СтрокаТрудовойРесурс.Ресурс] = Неопределено Тогда
			ОбработанныеРесурсыОбъемов.Вставить(СтрокаТрудовойРесурс.Ресурс, СтрокаТрудовойРесурс.Подразделение);
		Иначе
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОшибки, 
				СтрокаТрудовойРесурс.Ресурс, СтрокаТрудовойРесурс.НомерСтроки, ОбработанныеРесурсыОбъемов[СтрокаТрудовойРесурс.Ресурс]);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"ТрудовыеРесурсы[%1].Ресурс",
				ТекстОшибки, 
				"ТрудовыеРесурсы",
				СтрокаТрудовойРесурс.НомерСтроки,
				ТекстОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции //

Функция ПроверяемыеТабличныеЧастиПоПроектнымОпциямИСвойствам()
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ЭтотОбъект.Проект);
	
	МассивПроверяемыхТЧ = Новый Массив;
	МассивПроверяемыхТЧ.Добавить("ПланРасходов");
	МассивПроверяемыхТЧ.Добавить("ТрудовыеРесурсы");
	МассивПроверяемыхТЧ.Добавить("ПланДоходов");
	МассивПроверяемыхТЧ.Добавить("ДвиженияДенежныхСредств");
	Если СвойстваПроекта.ДоходыПоНатуральнымПоказателям Тогда 
		МассивПроверяемыхТЧ.Добавить("РаспределениеОбъемов");
		Если ВключитьСубпродуктыВПланДоходов Тогда
			МассивПроверяемыхТЧ.Добавить("Субпродукты");
		КонецЕсли;
	ИначеЕсли СвойстваПроекта.ДоходыПоОбъемам Тогда
		МассивПроверяемыхТЧ.Добавить("РаспределениеДоходов");
	КонецЕсли;
	Если СвойстваПроекта.РасходыПоОбъемам Тогда 
		Если СвойстваПроекта.РасходыПоНатуральнымПоказателям Или ВключитьМатРесурсыВПланРасходов Тогда
			МассивПроверяемыхТЧ.Добавить("РаспределениеПотребностей");
		Иначе
			МассивПроверяемыхТЧ.Добавить("РаспределениеРасходов");
		КонецЕсли;
	КонецЕсли;
	Если СвойстваПроекта.ПланироватьЗатратыНаМатериалы И ВключитьМатРесурсыВПланРасходов Тогда
		МассивПроверяемыхТЧ.Добавить("МатериальныеРесурсы");
	КонецЕсли;
	Если СвойстваПроекта.ПланироватьДополнительныеЗатратыПоЗадаче И ВключитьДопЗатратыВПланРасходов Тогда
		МассивПроверяемыхТЧ.Добавить("ДополнительныеЗатраты");
		Если СвойстваПроекта.РасходыПоОбъемам И Не СвойстваПроекта.РасходыПоНатуральнымПоказателям Тогда
			МассивПроверяемыхТЧ.Добавить("РаспределениеДополнительныхЗатрат");
		КонецЕсли
	КонецЕсли;
	
	ПроверяемыеТЧ = Новый СписокЗначений;
	Для Каждого ПроверямаяТЧ Из МассивПроверяемыхТЧ Цикл
		ПроверяемыеТЧ.Добавить(ПроверямаяТЧ, 
			упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ПроверямаяТЧ));
	КонецЦикла;
	
	Возврат ПроверяемыеТЧ;
	
КонецФункции

