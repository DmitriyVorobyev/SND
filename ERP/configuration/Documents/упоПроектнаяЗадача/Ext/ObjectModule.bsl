// Получает таблицу правил наложения реквизитов документа
//  на измерения, ресурсы и реквизиты регистров
//  Правила передаются в виде иерархическая структуры.
//  Структура описывает, КУДА положить ЧТО.
//
// Параметры:
//  ДанныеДокумента	 - ДанныеФормыСтруктура	 - содержит слепок документа.
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар ИмяРеквизитаДокумента:ИмяРеквизитаРегистра.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	УпрощенноеСоздание = ЭтоСозданиеИзСтруктуры();
	
	//
	
	ПравилаНаложения = Новый Структура();
	
	// Для каждого из регистров описывается, по какой из таблиц документа
	// строится список движений, и какие реквизиты куда записать,
	// для одной таблицы может быть сформировано произвольное число движений
	// Если требуется добавлять в запись реквизиты шапки, отмечаем их
	// префиксом "Шапка_" .
	
	// Базовый регистр. На основании него получать актуальность задачи и ее параметров.
	// Правила для регистра "упоСвойстваПроектныхЗадач".
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСвойстваПроектныхЗадач.Метаданные().Имя, Правила);
	
