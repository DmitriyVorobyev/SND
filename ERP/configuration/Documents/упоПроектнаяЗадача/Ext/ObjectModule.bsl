// Возвращает актуальные на текущий момент времени сроки проектной
//  задачи (без учета реквизита "Ручной ввод сроков"), данные в
//  любом случае берутся из регистра сведений.
// 
// Возвращаемое значение:
//  Структура - сроки проектной задачи, свойства: "ДатаНачала" и "ДатаЗавершения".
//
Функция ПолучитьСроки() Экспорт
	
	Если текущаяВерсия = Неопределено Тогда
		текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Рег.ДатаНачалаПлан КАК ДатаНачала,
		|	Рег.ДатаЗавершенияПлан КАК ДатаЗавершения
		|ИЗ
		|	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
		|			,
		|			Версия = &ТекущаяВерсия
		|				И ПроектнаяЗадача = &Ссылка) КАК Рег";
	
	Запрос.УстановитьПараметр("ТекущаяВерсия", текущаяВерсия);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	СтрокаЗапроса = РезультатЗапроса.Выгрузить()[0];
	Результат = Новый Структура();
	Результат.Вставить("ДатаНачала", СтрокаЗапроса.ДатаНачала);
	Результат.Вставить("ДатаЗавершения", СтрокаЗапроса.ДатаЗавершения);
	
	Возврат Результат;

КонецФункции

// Получает строку с данными основного результат субпродуктов.
//
// Возвращаемое значение:
//	Неопределено, ДанныеФормыЭлементКоллекции - данные строки табличной части.
//
Функция ПолучитьСтрокуОсновногоРезультатСубпродуктов() Экспорт
	
	строкаОсновногоРезультата = Неопределено;
	Для каждого строкаТЧ Из Субпродукты Цикл
	    Если строкаТЧ.Основной Тогда
			строкаОсновногоРезультата = строкаТЧ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат строкаОсновногоРезультата;
	
КонецФункции

// Функция формирует структуру обязательных реквизитов шапки или заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
		
	Если ИмяТабличнойЧасти = Неопределено Тогда
		// Формирование структуры обязательных реквизитов шапки.
		СтруктураОбязательныхПолей.Вставить("ТипПроектнойЗадачи");
		
		Если ДополнительныеЗатраты.Количество() > 0 Тогда      
			СтруктураОбязательныхПолей.Вставить("СпособПривязкиДопЗатрат");
		КонецЕсли; 
		
		Если ЭтоМодельПакетаРабот Тогда
			СтруктураОбязательныхПолей.Вставить("ДлительностьМоделиПакетаРабот");	
			СтруктураОбязательныхПолей.Вставить("ЕдиницаНормированияДлительности");
		КонецЕсли; 
		
		// При ручном вводе сроков необходимо заполнить даты начала и завершения.
		Если РучнойВводСроков = Истина Тогда
			Если Не ЭтоВеха Тогда
				СтруктураОбязательныхПолей.Вставить("ДатаНачалаПлан");
			КонецЕсли;
			СтруктураОбязательныхПолей.Вставить("ДатаЗавершенияПлан");
		КонецЕсли;
	ИначеЕсли ИмяТабличнойЧасти = "ПредусловияЗадачи" Тогда
		СтруктураОбязательныхПолей.Вставить("ЗадачаПредшественник");
	ИначеЕсли ИмяТабличнойЧасти = "МатериальныеРесурсы" И СвойстваПроекта.ПланироватьЗатратыНаМатериалы Тогда
		СтруктураОбязательныхПолей.Вставить("Ресурс");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		СтруктураОбязательныхПолей.Вставить("Количество");
		СтруктураОбязательныхПолей.Вставить("ЕдиницаНормирования");
		Если ВключитьМатРесурсыВПланРасходов Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязки");
			СтруктураОбязательныхПолей.Вставить("СтатьяЗатрат");
			СтруктураОбязательныхПолей.Вставить("Стоимость");
		КонецЕсли;
		Если ЭтоEPM Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязкиПотребности");
		КонецЕсли;	
	ИначеЕсли ИмяТабличнойЧасти = "ДополнительныеЗатраты" И СвойстваПроекта.ПланироватьДополнительныеЗатратыПоЗадаче Тогда
		СтруктураОбязательныхПолей.Вставить("СтатьяЗатрат");
		СтруктураОбязательныхПолей.Вставить("Стоимость");
		Если ВключитьДопЗатратыВПланРасходов Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязкиДоходовРасходов");
		КонецЕсли;
	ИначеЕсли ИмяТабличнойЧасти = "ДвиженияДенежныхСредств" Тогда
		СтруктураОбязательныхПолей.Вставить("СтатьяДДС");
		СтруктураОбязательныхПолей.Вставить("НаправлениеДвижения");
		СтруктураОбязательныхПолей.Вставить("СпособПривязки");
		СтруктураОбязательныхПолей.Вставить("Сумма");
		СтруктураОбязательныхПолей.Вставить("Валюта");
	ИначеЕсли ИмяТабличнойЧасти = "ПланДоходов" Тогда
		СтруктураОбязательныхПолей.Вставить("Статья");
		СтруктураОбязательныхПолей.Вставить("Сумма");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		СтруктураОбязательныхПолей.Вставить("СпособПривязки");
	ИначеЕсли ИмяТабличнойЧасти = "ПланРасходов" Тогда
		СтруктураОбязательныхПолей.Вставить("Статья");
		СтруктураОбязательныхПолей.Вставить("СпособПривязки");
		СтруктураОбязательныхПолей.Вставить("Сумма");
		СтруктураОбязательныхПолей.Вставить("Валюта");
	ИначеЕсли ИмяТабличнойЧасти = "Субпродукты" И СвойстваПроекта.ДоходыПоНатуральнымПоказателям Тогда
		СтруктураОбязательныхПолей.Вставить("Ресурс");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		СтруктураОбязательныхПолей.Вставить("Количество");
		СтруктураОбязательныхПолей.Вставить("ЕдиницаНормирования");
		Если ВключитьСубпродуктыВПланДоходов Тогда
			СтруктураОбязательныхПолей.Вставить("СтатьяДоходов");
			СтруктураОбязательныхПолей.Вставить("СпособПривязки");
		КонецЕсли;
		Если ЭтоEPM Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязкиВыпуска");
		КонецЕсли;
	ИначеЕсли ИмяТабличнойЧасти = "ТрудовыеРесурсы" Тогда
		СтруктураОбязательныхПолей.Вставить("Ресурс");		
		СтруктураОбязательныхПолей.Вставить("Количество");
		СтруктураОбязательныхПолей.Вставить("ЕдиницаНормирования");
		СтруктураОбязательныхПолей.Вставить("ПрофильРаспределения");
	ИначеЕсли ИмяТабличнойЧасти = "РаспределениеОбъемов" Тогда
		Если ТранслироватьОбъемыВТрудозатраты() Тогда
			ПараметрыПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ЭтотОбъект.Проект);
			Если ПараметрыПроекта.УказыватьПодразделениеРолиПриПланированииТР Тогда
				СтруктураОбязательныхПолей.Вставить("Подразделение");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

