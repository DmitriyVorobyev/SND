// Получает подготовленные данные для движений по регистрам
//  и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт

	Если ЭтоСозданиеИзСтруктуры() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДокумента.Вставить("ТекущаяВерсияПроекта", текущаяВерсия);
	
	// Предусловия проектных задач
	
	упоПроведениеДокументовСервер.ДобавитьДвиженияОчисткиНеактуальныхСвязей(ДанныеДвижений.упоПредусловияПроектныхЗадач, 
		ДанныеДокумента.Ссылка, ТекущаяВерсия);
	
	// Свертка данных по упоДанныеПлановТрудозатратРолей
	колонкиСуммы = Новый Соответствие;
	колонкиСуммы.Вставить("Количество", Истина);
	колонкиСуммы.Вставить("ОбщСтоимость", Истина);
	колонкиСуммы.Вставить("ОбщВнешняяСтоимость", Истина);
	
	Если СвойстваПроекта.УчитыватьПериодРегистрацииНормСтоимостиПриРасчетеТрудозатрат Тогда
		колонкиСуммы.Вставить("Стоимость", Истина);
		колонкиСуммы.Вставить("ВнешняяСтоимость", Истина);
	КонецЕсли;
	
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ДанныеДвижений.упоДанныеПлановТрудозатратРолей, колонкиСуммы);
	
	// Актуализация данных табличных частей ПЗ.
	// "упоДанныеПлановПотребностейМатериальныхРесурсов" не актуализируем: это произойдет при актуализации фин.планов.
	
	МассивЗадач = Новый Массив;
	МассивЗадач.Добавить(ДанныеДокумента.Ссылка);
	
	ДанныеАктуализации = Новый Структура ("Регистратор, Период, МассивЗадач, ИмяРегистра",
		ДанныеДокумента.Ссылка, ДанныеДокумента.Дата, МассивЗадач, "");
	УсловиеОтбора = "Версия = &Версия";
	ПараметрОтбора = Новый Структура("Версия", текущаяВерсия);
	
	ИмяРегистра = "упоДанныеПлановТрудозатратРолей";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
		
	ИмяРегистра = "упоДанныеРаспределенияПланаТрудозатратРолейПоПериодам";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
		
	ИмяРегистра = "упоДанныеПлановВыпускаСубпродуктов";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		ИмяРегистра = "упоДанныеПроектнойПродукции";
		ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
		упоСервисныеФункцииВызовСервера.УдалитьНоменклатуруИзРегистра(ДанныеДвижений[ИмяРегистра], 
			ДанныеДокумента.Ссылка, текущаяВерсия);
		упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
			ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь); 
	КонецЕсли;
	
	ИмяРегистра = "упоДанныеПлановОбъемовПодразделения";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
		
	ИмяРегистра = "упоДанныеРаспределенияДоходовПоПериодам";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
		
	ИмяРегистра = "упоДанныеРаспределенияРасходовПоПериодам";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
		
	// Свертка данных по Данным планов доходов и расходов. Обработка источника плана и трансляции трудозатрат.
	
	колонкиСуммы = Новый Соответствие;
	колонкиСуммы.Вставить("Сумма", Истина);
	колонкиСуммы.Вставить("СуммаВалютная", Истина);
	
	колонкиИсключения = Новый Соответствие;
	колонкиИсключения.Вставить("УдалитьПрофильРаспределения", Истина);
	
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ДанныеДвижений.упоДанныеПлановДоходовИРасходов, 
		колонкиСуммы, колонкиИсключения);
	
	ОбработатьИсточникиПлана_ДоходыИРасходы(ДанныеДвижений);
	
	УсловиеОтбора = "Версия = &Версия И ИсточникПлана = &ИсточникПлана";
	ПараметрОтбора = Новый Структура("Версия, ИсточникПлана", 
		текущаяВерсия, Перечисления.упоИсточникПланаДоходовИРасходов.ДоходыРасходы);
	
	ИмяРегистра = "упоДанныеПлановДоходовИРасходов";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , ,УсловиеОтбора, ПараметрОтбора, Ложь);
		
	ИмяРегистра = "упоДанныеПлановДоходовИРасходовПодразделения";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);

	//
	
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ДанныеДвижений.упоДанныеПлановДвиженияДенежныхСредств, колонкиСуммы);
	
	ДанныеДокумента.ДвиженияДенежныхСредств.Колонки.Удалить(ДанныеДокумента.ДвиженияДенежныхСредств.Колонки.НомерСтроки);
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ДанныеДокумента.ДвиженияДенежныхСредств, колонкиСуммы);
	
	УсловиеОтбора = "Версия = &Версия";
	ПараметрОтбора = Новый Структура("Версия", текущаяВерсия);
	
	ИмяРегистра = "упоДанныеПлановДвиженияДенежныхСредств";
	ДанныеАктуализации.ИмяРегистра = ИмяРегистра;
	упоАктуализацияПроектаВызовСервера.АктуализироватьДанныеРегистраСведений(ДанныеДвижений[ИмяРегистра], 
		ДанныеАктуализации, , , УсловиеОтбора, ПараметрОтбора, Ложь);
	
	// Для актуализации информации и дальнейших манипуляций свойства и сроки ПЗ должны быть уже записаны.
	ЗаписатьДвиженияРегистраПринудительно(ДанныеДвижений, "упоСвойстваПроектныхЗадач", Отказ);
	ЗаписатьДвиженияРегистраПринудительно(ДанныеДвижений, "упоСрокиПроектныхЗадач", Отказ);
	
	ЗаполнитьСуммуУправленческогоУчета(ДанныеДокумента, ДанныеДвижений);
	
	// Расчет актуальных финансовых планов.
	
	ИспользоватьСрокиИзДокумента = Истина;
	Если НЕ (ДанныеДокумента.РучнойВводСроков Или НужноЗаписатьСрокиПринудительно()) Тогда
		СрокиЗадачи = ПолучитьСроки();
		Если СрокиЗадачи <> Неопределено Тогда
			ИспользоватьСрокиИзДокумента = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если ИспользоватьСрокиИзДокумента Тогда
		СрокиЗадачи = Новый Структура("ДатаНачала, ДатаЗавершения",
			ДанныеДокумента.ДатаНачалаПлан,
			ДанныеДокумента.ДатаЗавершенияПлан)
	КонецЕсли;
	
	СрокиСоответствие = Новый Соответствие;
	СрокиСоответствие.Вставить(Ссылка, Новый Структура("Результат", СрокиЗадачи));
	
	ТаблицаДвиженийБДДС = ДанныеДвижений.упоДанныеПлановДвиженияДенежныхСредств;
	ТаблицаДвиженийБДДСАктуальные = ДанныеДвижений.упоАктуальныеПланыДвиженийДенежныхСредств;
	ТаблицаДвиженияПланБДР = ДанныеДвижений.упоАктуальныеПланыДоходовИРасходов;
	ТаблицаДвиженияПланПоставкиМатРесурсовПЗ = ДанныеДвижений.упоДанныеПлановПотребностейМатериальныхРесурсов;
	
	Если Не НужноНеФормироватьАктуальныеДвижения() Тогда 
		
		// Подготовим таблицу сроков задачи для обновления движений по регистру 
		// упоДанныеПлановПотребностейМатериальныхРесурсов.
		
		ТаблицаДвиженияСрокиПЗ = Новый ТаблицаЗначений;
		ТаблицаДвиженияСрокиПЗ.Колонки.Добавить("ПроектнаяЗадача");
		ТаблицаДвиженияСрокиПЗ.Колонки.Добавить("ДатаНачалаПлан");
		ТаблицаДвиженияСрокиПЗ.Колонки.Добавить("ДатаЗавершенияПлан");
		
		СтрокаТаблицы = ТаблицаДвиженияСрокиПЗ.Добавить();
		СтрокаТаблицы.ПроектнаяЗадача = ДанныеДокумента.Ссылка;
		СтрокаТаблицы.ДатаНачалаПлан = СрокиЗадачи.ДатаНачала;
		СтрокаТаблицы.ДатаЗавершенияПлан = СрокиЗадачи.ДатаЗавершения;
		
		ДанныеДляАктуализации = Новый Структура("ТаблицаДвиженийБДР,
			|ТаблицаДвиженийБДДС,
			|ТаблицаДвиженийБДДСАктуальные,
			|ТаблицаДвиженийСрокиПЗ,
			|ТаблицаДвиженияПланПоставкиМатРесурсовПЗ",
			ТаблицаДвиженияПланБДР,
			ТаблицаДвиженийБДДС,
			ТаблицаДвиженийБДДСАктуальные,
			ТаблицаДвиженияСрокиПЗ,
			ТаблицаДвиженияПланПоставкиМатРесурсовПЗ);
		упоАктуализацияПроектаВызовСервера.обАктуализацияФинансовыхПлановПроекта(ЭтотОбъект, 
			ДанныеДокумента, СрокиСоответствие, ДанныеДляАктуализации, Истина);
		
	КонецЕсли;
	
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ТаблицаДвиженийБДДСАктуальные, колонкиСуммы);
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ТаблицаДвиженияПланБДР, колонкиСуммы);
	
	// Дополнительная обработка данных движения по регистру "ЗатратыМатериальныхРесурсовПлан".
	
	колонкиСуммы = Новый Соответствие;
	колонкиСуммы.Вставить("Количество", Истина);
	колонкиСуммы.Вставить("Сумма", Истина);
	колонкиСуммы.Вставить("СуммаВалютная", Истина);
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ДанныеДвижений.упоДанныеПлановПотребностейМатериальныхРесурсов, 
		колонкиСуммы, колонкиИсключения);
		
	// Регистр упоАктуальныеПланыЗатратМатериальныхРесурсов.
	
	колонкиСуммы = Новый Соответствие;
	колонкиСуммы.Вставить("Количество", Истина);
	колонкиСуммы.Вставить("Стоимость", Истина);
	колонкиСуммы.Вставить("КоличествоЕдНормирования", Истина);
	упоСервисныеФункцииВызовСервера.СвернутьТЗ(ДанныеДвижений.упоАктуальныеПланыЗатратМатериальныхРесурсов, 
		колонкиСуммы, колонкиИсключения);
	
	упоПроектыИЗадачиСервер.ЗаполнитьКоличествоПоКоличествуЕдНормированияМатериальныхЗатрат(
		ДанныеДвижений.упоАктуальныеПланыЗатратМатериальныхРесурсов);
	
	// Регистр сведений "Плановые объемы" по подразделениям.
	
	СтрокаПараметрыКонтрагентовПроекта = "КонтрагентДоходов, КонтрагентЗатрат, ДоговорДоходов, ДоговорЗатрат";
	ПараметрыПроекта = упоФункцииБСП.ЗначенияРеквизитовОбъектаВызовСервера(Проект, СтрокаПараметрыКонтрагентовПроекта);
	
	Если ЗначениеЗаполнено(ДанныеДокумента.КалендарьЗадачи) Тогда
		Календарь = ДанныеДокумента.КалендарьЗадачи;
	Иначе
		Календарь = Справочники.Проекты.ПолучитьРабочийКалендарь(Проект);
	КонецЕсли;
	
	// Регистры упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия И упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.
	Если Не НужноНеФормироватьАктуальныеДвижения() Тогда
		НезаписанныеДанныеЗадач = Новый Соответствие;
		НезаписанныеДанныеЗадач.Вставить(Ссылка, ДанныеДокумента);
		упоРаспределениеТрудозатратВызовСервера.ОтразитьПлановыеТрудозатратыЗадачи(Ссылка, Ссылка, 
			СрокиСоответствие, НезаписанныеДанныеЗадач, ДанныеДвижений);
	КонецЕсли;
	
	СвойстваПроведения = Новый Структура(СтрокаПараметрыКонтрагентовПроекта);
	
	ЗаполнитьЗначенияСвойств(СвойстваПроведения, ПараметрыПроекта);
	
	СвойстваПроведения.Вставить("Проект", Проект);
	СвойстваПроведения.Вставить("Версия", текущаяВерсия);
	СвойстваПроведения.Вставить("ПроектнаяЗадача", Ссылка);
	СвойстваПроведения.Вставить("НачДата", СрокиЗадачи.ДатаНачала);
	СвойстваПроведения.Вставить("КонДата", СрокиЗадачи.ДатаЗавершения);
	СвойстваПроведения.Вставить("Календарь", Календарь);
	
	упоАналитикаПоПодразделениямСервер.ЗаполнитьОбщиеНастройкиУчетаПоПодразделениям(Ссылка, СвойстваПроведения);

	упоАналитикаПоПодразделениямСервер.ПодготовитьТаблицыДвижений(ЭтотОбъект, 
		ДанныеДвижений, СвойстваПроекта, СвойстваПроведения, Отказ);

КонецПроцедуры

// Устанавливает субпродукт по умолчанию. В случае, если субпродукт еще
// не был установлен, берется первый из списка.
//
// Возвращаемое значение:
//	Неопределено - не возвращает значение.
//
Функция УстановитьОсновнойСубпродуктПоУмолчанию() Экспорт
	
	Если Субпродукты.Количество() > 0 И Субпродукты.Найти(Истина, "Основной") = Неопределено Тогда
		Субпродукты[0].Основной = Истина;		
	КонецЕсли;	
	
КонецФункции 

// Заполняет СписокПотомков полным перечнем зависимых проектных задач
//
// Параметры:
//  СписокПотомков	- СписокЗначений - хранит весь список потомков.
//
Процедура ПолучитьПолныйСписокПотомков(СписокПотомков) Экспорт
	
	Документы.упоПроектнаяЗадача.ПолучитьПолныйСписокПотомков(ЭтотОбъект.Ссылка, СписокПотомков);	
	
КонецПроцедуры

// Описание в комментарии к одноименной процедуре в модуле УправлениеДоступом.
//
// Параметры:
//  Таблица	 - ТаблицаЗначений - см. УправлениеДоступом.ТаблицаНаборыЗначенийДоступа
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокаТаб = Таблица.Добавить();
	СтрокаТаб.ЗначениеДоступа = Проект;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Обработчик события ПриУстановкеНовогоНомера модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - СправочникОбъект, содержит сам объект.
//  СтандартнаяОбработка – Булево, признак выполнения стандартной (системной) обработки события..
//                 продолжение описания параметра. 
//  Префикс      – Строка, префикс, который будет использоваться для генерации номера.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриУстановкеНовогоНомера(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры // ПриУстановкеНовогоНомера()

// Обработчик события ПриКопировании модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  ОбъектКопирования – ДокументОбъект, исходный документ, который является источником копирования. 
//  
Процедура ПриКопировании(ОбъектКопирования)
		 	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	
КонецПроцедуры // ПриКопировании()

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  Отказ        - Булево, признак отказа от записи документа.
//  РежимЗаписи  - РежимЗаписиДокумента, в параметр передается текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	упоФункцииЗащитыСервер.МожноИспользоватьОбъектИспользующийЗащищенныйКод(,Отказ);
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	упоУправлениеСсылкамиСервер.СоздатьСсылкуПроектнойЗадачи(ЭтотОбъект); 
	
	//
	
	текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	ДополнительныеСвойства.Вставить("Версия", текущаяВерсия);

	упоЗакрытиеЭтапа.ПроверкаПередЗаписью_упоПроектнаяЗадачаПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	ЗапомнитьСвойстваНовогоДокумента();
	
		
	// Контроль удаления проектной задачи - задача может быть удалена только специальной командой.
	КонтрольУдаления(РежимЗаписи, Отказ);
	
	// Контроль списания факта при отмене задачи.
	КонтрольПриОтменеСписанФакт(Отказ);
	
	КонтрольВозможностиПроведенияПоСвойствам(РежимЗаписи, Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//
	
	ЗаполнитьДатуДокумента(РежимЗаписи);
	
	ЗаписатьТипЗадачи();
	ЗаполнитьДлительностьМоделиПакетаРабот();
	НазваниеОперации = НазваниеПроектнойЗадачи;
	
	ПрименитьПроектныеОпции();
	ПроверитьЗаполнитьТабличныеЧастиРаспределений(Отказ);
	
	ОбработатьПредусловия();
	
	ОбработатьВыводВСтатусОтчет();
	
	ЗапомнитьУдаленнуюПроектнуюПродукцию();
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
КонецПроцедуры

// Обработчик события ПриЗаписи модуля объекта.
// 
// Параметры: 
//  Отказ        - Булево, признак отказа от записи документа.
// 
Процедура ПриЗаписи(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриЗаписи(ЭтотОбъект, Отказ);
	
	РежимЗаписи = ЭтотОбъект.ДополнительныеСвойства.РежимЗаписи;
	ПоставитьПроектыПредусловийВОчередьПересчетаСроков(РежимЗаписи);
	
	ПоставитьПроектВОчередьПересчетаСроков(РежимЗаписи);
	
	ОбновитьПроектнуюПродукциюВРегистрахСкопированнойЗадачи();
		
КонецПроцедуры // ПриЗаписи()

// Обработчик события ПередУдалением модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак удаления документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередУдалением(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередУдалением(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПередУдалением()

// Обработчик события ОбработкаПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак проведения документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	УпрощенноеСоздание = ЭтоСозданиеИзСтруктуры();
	Если НЕ ДополнительныеСвойства.ЭтоНовый И НЕ УпрощенноеСоздание Тогда
		// Удалим лишние движения версии по данной проектной задаче.
		ОчиститьДвиженияДокумента();
	КонецЕсли;
	
	ОбработатьПроектнуюПродукциюПриПроведении();
	
	// Необходимо принимать во внимание, что при вызове процедуры "ПодготовитьДанныеДляДвижений"
	// из модуля объекта свойства проектных задач принудительно записываются
	// (до записи всех остальных движений), иначе дальнейшее обращение к данным регистра будет некорректным.
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Для актуализации информации свойства должны быть уже записаны.
	ЗаменитьЗначениеРеквизитаОбъектУПотомков(Отказ);
	
	СоздатьДокументНазначениеРуководителяПЗ(Отказ); 
	
	АктуализироватьРПЗИПоручения(Отказ);
	
КонецПроцедуры

// Обработчик события ОбработкаУдаленияПроведения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отмены проведения документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ОчиститьДвиженияДокумента();
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
	упоИерархияИПолномочияСервер.АктуализироватьРуководителейПроектныхЗадачПоИерархии(Ссылка, , , текущаяВерсия);
	
КонецПроцедуры // ОбработкаУдаленияПроведения()

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Проверка дубликатов трудовых ресурсов. 
	// Ограничение: не должны дублироваться роли на одном уровне планирования, даже в разных подразделениях. 
	Ошибки = Неопределено;
	ОбработанныеРесурсы = Новый Соответствие;
	ОбработанныеРесурсы.Вставить(Перечисления.упоУровеньПланирования.Предварительный, Новый Соответствие);
	ОбработанныеРесурсы.Вставить(Перечисления.упоУровеньПланирования.Окончательный, Новый Соответствие);
	Для Каждого СтрокаТрудовойРесурс Из ТрудовыеРесурсы Цикл
		
		Если СтрокаТрудовойРесурс.ИсточникПлана = ПредопределенноеЗначение("Перечисление.упоИсточникПланаТрудозатратРолей.Объемы") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбработанныеРесурсы[СтрокаТрудовойРесурс.УровеньПланирования][СтрокаТрудовойРесурс.Ресурс] = Неопределено Тогда
			ОбработанныеРесурсы[СтрокаТрудовойРесурс.УровеньПланирования].Вставить(СтрокаТрудовойРесурс.Ресурс, Истина);
		Иначе
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ресурс ""%1"" (уровень планирования %2) в строке №%3 является дубликатом.'"), 
				СтрокаТрудовойРесурс.Ресурс, СтрокаТрудовойРесурс.УровеньПланирования, СтрокаТрудовойРесурс.НомерСтроки);
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				"ТрудовыеРесурсы[%1].Ресурс",
				ТекстОшибки, 
				"ТрудовыеРесурсы",
				СтрокаТрудовойРесурс.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	ОбработанныеРесурсы = Неопределено;
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
	//
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		МодульупоПроектнаяПродукция = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукцияВызовСервера");
		МодульупоПроектнаяПродукция.СообщитьОшибкиТрансляцииПроектнойПродукции(ТрудовыеРесурсы, Отказ);
	КонецЕсли;
	
	//
	ПроверяемыеТЧ = ПроверяемыеТабличныеЧастиПоПроектнымОпциямИСвойствам();
	
	упоАналитикаПоПодразделениямСервер.ПроверитьЗаполнениеТабличныхЧастей(ЭтотОбъект, ПроверяемыеТЧ, Отказ, СвойстваПроекта);
			
КонецПроцедуры

// Обработчик события ОбработкаЗаполнения модуля объекта.
//
// Параметры: 
//   ДанныеЗаполнения - Произвольный - данные заполнения.
// 
Процедура ОбработкаЗаполнения(ДанныеЗаполнения) Экспорт
	
	Документы.упоПроектнаяЗадача.ЗаполнитьПЗПоОснованию(ДанныеЗаполнения, ЭтотОбъект);
		
КонецПроцедуры // ОбработкаЗаполнения()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

Функция ОчиститьДвиженияДокумента()
	
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоПредусловияПроектныхЗадач", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоАктуальныеПланыЗатратМатериальныхРесурсов", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоАктуальныеПланыДополнительныхЗатрат", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановДвиженияДенежныхСредств", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановДоходовИРасходов", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановВыпускаСубпродуктов", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановПотребностейМатериальныхРесурсов", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановТрудозатратРолей", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановДоходовИРасходовПодразделения", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановОбъемовПодразделения", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеРаспределенияДоходовПоПериодам", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеРаспределенияРасходовПоПериодам", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоАктуальныеПланыДоходовИРасходовПодразделения", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоАктуальныеПланыВыполненияОбъемов", Ссылка, текущаяВерсия);
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановДополнительныхЗатрат", Ссылка, текущаяВерсия);	
	упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоДанныеПлановДополнительныхЗатратПодразделения", Ссылка, текущаяВерсия);
	
	// Лишнее удаление сроков проектных задач.
	Если РучнойВводСроков Тогда 
		упоЗаписьИПроведениеПривилегированный.ОчиститьДвиженияВерсии("упоСрокиПроектныхЗадач", Ссылка, текущаяВерсия);
	КонецЕсли;
	
КонецФункции 

// Функция получает дату документа "Регистрация проекта".
//
Функция ПолучитьДатуРегистрацииПроекта()
 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоСтатусыПроектовСрезПоследних.Период КАК Дата
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектов.СрезПоследних(
	               |			,
	               |			Проект = &Проект
	               |				И СтатусПроекта = ЗНАЧЕНИЕ(Перечисление.упоСостояниеСтатусаПроекта.Запланирован)) КАК упоСтатусыПроектовСрезПоследних";
				   
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПериодСтатусЗадачи 	= Выборка.Дата;
	КонецЕсли;              
	
	Возврат ПериодСтатусЗадачи;

КонецФункции // ПолучитьДатуРегистрацииПроекта()

Процедура ЗаполнитьСуммуУправленческогоУчета(ДанныеДокумента, ДанныеДвижений)
	
	Если НЕ ЗначениеЗаполнено(мВалютаУправленческогоУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Движение Из Движения Цикл
		ТаблицаДвижения = ДанныеДвижений[Движение.Метаданные().Имя];
		упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвижения, мВалютаУправленческогоУчета);
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПроверитьВозможностьАктуализацииФинансовыхПлановПроекта(ДанныеДокумента)
	
	НеПроверятьВозможностьАктуализацииФинПланов = 
		СвойствоСтруктуры(ДополнительныеСвойства, "НеПроверятьВозможностьАктуализацииФинПланов");
	Если НеПроверятьВозможностьАктуализацииФинПланов Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуСроковИзДокумента = Истина;	
	
	ТаблицаСроков = Новый ТаблицаЗначений();
	ТаблицаСроков.Колонки.Добавить("Задача");
	ТаблицаСроков.Колонки.Добавить("ДатаНачала");
	ТаблицаСроков.Колонки.Добавить("ДатаЗавершения");
		
	Если НЕ (ДанныеДокумента.РучнойВводСроков ИЛИ НужноЗаписатьСрокиПринудительно()) Тогда
		
		Если текущаяВерсия = Неопределено Тогда
			текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ДанныеДокумента.Ссылка);
		Запрос.УстановитьПараметр("ТекВерсия", текущаяВерсия);
		Запрос.Текст = "ВЫБРАТЬ
		               |	РегСроки.ДатаНачалаПлан КАК ДатаНачала,
		               |	РегСроки.ДатаЗавершенияПлан КАК ДатаЗавершения,
		               |	РегСроки.ПроектнаяЗадача КАК Задача
		               |ИЗ
		               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(
		               |			,
		               |			Версия = &ТекВерсия
		               |				И ПроектнаяЗадача = &Ссылка) КАК РегСроки";
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ТаблицаСроков = РезультатЗапроса.Выгрузить();
			ЗаполнитьТаблицуСроковИзДокумента = Ложь;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗаполнитьТаблицуСроковИзДокумента Тогда	
		СтрокаСроки = ТаблицаСроков.Добавить();
		СтрокаСроки.Задача = ДанныеДокумента.Ссылка;
		СтрокаСроки.ДатаНачала = ДанныеДокумента.ДатаНачалаПлан;
		СтрокаСроки.ДатаЗавершения = ДанныеДокумента.ДатаЗавершенияПлан;
	КонецЕсли;
	
	ПроверитьВозможностьАктуализацииДДСПроекта(ДанныеДокумента, ТаблицаСроков);
	ПроверитьВозможностьАктуализацииБДРПроекта(ДанныеДокумента, ТаблицаСроков);
	
КонецПроцедуры

Процедура ПроверитьВозможностьАктуализацииДДСПроекта(ДанныеДокумента, ТаблицаСроков)
	
	УспехДДС = Истина;
	
	ДанныеПланаДДС = ДанныеДокумента.ДвиженияДенежныхСредств;
	Если НЕ ДанныеПланаДДС.Количество() = 0 Тогда
		
		Для каждого СтрокаДанных Из ДанныеПланаДДС Цикл
			
			Если НЕ СтрокаДанных.СпособПривязки = Перечисления.упоСпособПривязкиДДС.НаДату Тогда
				
				Если ТипЗнч(ТаблицаСроков) = Тип("ТаблицаЗначений") Тогда
					Если ТаблицаСроков.Количество() = 0 Тогда
						СтрокаДанныеПЗ = Неопределено;
					Иначе
						СтрокаДанныеПЗ = ТаблицаСроков.Найти(ДанныеДокумента.Ссылка, "Задача");
					КонецЕсли;
				Иначе
					СтрокаДанныеПЗ = ТаблицаСроков[ДанныеДокумента.Ссылка];
				КонецЕсли;
				
				Если СтрокаДанныеПЗ = Неопределено Тогда
					УспехДДС = Ложь;
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ УспехДДС Тогда
			ТекстСообщения = НСтр("ru = 'Расчет актуальных данных ДДС проектной задачи ""%1"" проекта ""%2"" невозможен:
                                   |у проектной задачи не указаны сроки начала и завершения работ.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
				ДанныеДокумента.НазваниеПроектнойЗадачи, ДанныеДокумента.Проект.ПолноеНаименование);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВозможностьАктуализацииБДРПроекта(ДанныеДокумента, ТаблицаСроков)
	
	УспехБДР = Истина;
	
	ПланДоходовКолво = ДанныеДокумента.ПланДоходов.Количество();
	ПланРасходовКолво = ДанныеДокумента.ПланРасходов.Количество();
	Если СвойстваПроекта.ПланироватьЗатратыНаМатериалы И ДанныеДокумента.ВключитьМатРесурсыВПланРасходов Тогда
		МатериальныеРесурсыКолво = ДанныеДокумента.МатериальныеРесурсы.Количество();
	Иначе
		МатериальныеРесурсыКолво = 0;
	КонецЕсли;
	Если СвойстваПроекта.ДоходыПоНатуральнымПоказателям И ДанныеДокумента.ВключитьСубпродуктыВПланДоходов Тогда
		СубпродуктыКолво = ДанныеДокумента.Субпродукты.Количество();
	Иначе
		СубпродуктыКолво = 0;
	КонецЕсли;
	Если Ложь И ДанныеДокумента.ВключитьТрудРесурсыВПланРасходов Тогда // Пока что данный функционал не запущен
		ТрудРесурсыКолво = ДанныеДокумента.ТрудовыеРесурсы.Количество();
	Иначе
		ТрудРесурсыКолво = 0;
	КонецЕсли;
	
	Если (ПланДоходовКолво + ПланРасходовКолво + МатериальныеРесурсыКолво + СубпродуктыКолво + ТрудРесурсыКолво) > 0 Тогда
				
		Если ТипЗнч(ТаблицаСроков) = Тип("ТаблицаЗначений") Тогда
			Если ТаблицаСроков.Количество() = 0 Тогда
				СтрокаДанныеПЗ = Неопределено;
			Иначе
				СтрокаДанныеПЗ = ТаблицаСроков.Найти(ДанныеДокумента.Ссылка, "Задача");
			КонецЕсли;
		Иначе
			СтрокаДанныеПЗ = ТаблицаСроков[ДанныеДокумента.Ссылка];	
		КонецЕсли;
		
		Если СтрокаДанныеПЗ = Неопределено Тогда      
			УспехБДР = Ложь;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если НЕ УспехБДР Тогда
		ТекстСообщения = НСтр("ru = 'Расчет актуальных данных БДР проектной задачи ""%1"" проекта ""%2"" невозможен:
                               |у проектной задачи не указаны сроки начала и завершения работ.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
			ДанныеДокумента.НазваниеПроектнойЗадачи, ДанныеДокумента.Проект.ПолноеНаименование);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗаписатьДвиженияРегистраПринудительно(ДанныеДвижений, ИмяРегистра, Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
				
	ТаблицаДвижений = ДанныеДвижений[ИмяРегистра];
	ТаблицаДвижений.ЗаполнитьЗначения(Истина, "Активность");
	Для каждого СтрокаТЧ Из ТаблицаДвижений Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Период) Тогда
			СтрокаТЧ.Период = Дата;
		КонецЕсли;
	КонецЦикла;
	ТаблицаДвижений.ЗаполнитьЗначения(Ссылка, "Регистратор");
	
	Движения[ИмяРегистра].Загрузить(ТаблицаДвижений);
	Движения[ИмяРегистра].Записать();	

КонецПроцедуры

