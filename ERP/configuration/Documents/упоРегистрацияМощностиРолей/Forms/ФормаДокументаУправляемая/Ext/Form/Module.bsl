#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОпределениеМощностиРолейПодобрать(Команда)
	
	ПараметрыПодбора = ПодготовитьДопПараметры(Команда.Имя);
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных, 
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);			
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры(имяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	 		
	АдресХранилища = "";
	
	Если имяКоманды = "ОпределениеМощностиРолейПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.МощностьРолей;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоРоли";
        ТаблицаФормы = Объект.МощностьРолей;
	    ИмяКолонки = "Роль";		
				
	КонецЕсли;
		
	СтруктураДоп = ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы, ИмяКолонки,
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
		
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
	
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Функция ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы, ИмяКолонки, СписокВидимыхКолонок)
	
	СтруктураДоп  = Новый Структура;
	
	СтруктураДоп.Вставить("АдресХранилищаВыбранных");
	СтруктураДоп.Вставить("АдресХранилищаОтбора");
	
	АдресХранилища  = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(ЭтаФорма.УникальныйИдентификатор,
		ТаблицаФормы, ИмяКолонки, СписокВидимыхКолонок);
	СтруктураДоп.АдресХранилищаВыбранных = АдресХранилища;
	
	Возврат СтруктураДоп;
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораРолейНаСервере(СписокРолей)
	
	Если НЕ ТипЗнч(СписокРолей) = Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	// Заполним подразделение роли по умолчанию
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Рег.Роль,
	               |	Рег.Подразделение
	               |ИЗ
	               |	РегистрСведений.упоСоставПодразделений.СрезПоследних(, Роль В (&Роли)) КАК Рег
	               |ГДЕ
	               |	Рег.ВходитВСостав = ИСТИНА
	               |";
	               
	Запрос.УстановитьПараметр("Роли", СписокРолей);
	
	РолиИПодразделения = Запрос.Выполнить().Выгрузить();
	
	Для каждого Роль Из СписокРолей Цикл
		РольСсылка = Роль.Значение;
		ИскомаяСтрокаПодразделение = РолиИПодразделения.НайтиСтроки(Новый Структура("Роль",РольСсылка));
		Если ИскомаяСтрокаПодразделение.Количество() Тогда 
			СтрокиМощностьРолей = Объект.МощностьРолей.НайтиСтроки(Новый Структура("Роль", РольСсылка));
			Если СтрокиМощностьРолей.Количество() > 0 Тогда 
				СтрокиМощностьРолей[0].Подразделение = ИскомаяСтрокаПодразделение[0].Подразделение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
