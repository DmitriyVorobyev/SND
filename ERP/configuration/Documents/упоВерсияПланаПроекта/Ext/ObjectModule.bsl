Функция СформироватьЗапросПоРегистру(имяРегистра, ПоляПоУмолчанию, УсловиеНаПроект)
		
	Непериодический = Метаданные.РегистрыСведений[имяРегистра].ПериодичностьРегистраСведений 
										= Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический;										
	
	новыйТекстЗапроса = "ВЫБРАТЬ 
						|";
	ПервоеПоле = Истина;					
	Для каждого полеПоУмолчанию Из ПоляПоУмолчанию Цикл
		Если НЕ ПервоеПоле Тогда
			новыйТекстЗапроса = новыйТекстЗапроса + ","
		КонецЕсли;
		новыйТекстЗапроса = новыйТекстЗапроса + полеПоУмолчанию.Ключ + " КАК " + полеПоУмолчанию.Значение +"
												|";
		Если ПервоеПоле Тогда
			ПервоеПоле = Ложь;
		КонецЕсли;
	КонецЦикла;
	Для каждого измерение Из Метаданные.РегистрыСведений[имяРегистра].Измерения Цикл
		Если НЕ ПервоеПоле Тогда
			новыйТекстЗапроса = новыйТекстЗапроса + ","
		КонецЕсли;
		новыйТекстЗапроса = новыйТекстЗапроса + измерение.Имя +"
												|";
		Если ПервоеПоле Тогда
			ПервоеПоле = Ложь;
		КонецЕсли;
	КонецЦикла;
	Для каждого ресурс Из Метаданные.РегистрыСведений[имяРегистра].Ресурсы Цикл
		Если НЕ ПервоеПоле Тогда
			новыйТекстЗапроса = новыйТекстЗапроса + ","
		КонецЕсли;
		новыйТекстЗапроса = новыйТекстЗапроса + ресурс.Имя +"
												|";
		Если ПервоеПоле Тогда
			ПервоеПоле = Ложь;
		КонецЕсли;
	КонецЦикла;
	Для каждого реквизит Из Метаданные.РегистрыСведений[имяРегистра].Реквизиты Цикл
		Если НЕ ПервоеПоле Тогда
			новыйТекстЗапроса = новыйТекстЗапроса + ","
		КонецЕсли;
		новыйТекстЗапроса = новыйТекстЗапроса + реквизит.Имя +"
												|";
		Если ПервоеПоле Тогда
			ПервоеПоле = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если Непериодический Тогда
		
		новыйТекстЗапроса = новыйТекстЗапроса + "
		|ИЗ
		|	РегистрСведений."+ имяРегистра +" КАК табличка
		|ГДЕ 
		|" + УсловиеНаПроект;
		
	Иначе
		
		новыйТекстЗапроса = новыйТекстЗапроса + "
		|ИЗ
		|	РегистрСведений."+ имяРегистра +".СрезПоследних(, "+УсловиеНаПроект+") КАК табличка";
		
	КонецЕсли;
			
	Возврат новыйТекстЗапроса;
	
КонецФункции

// Сохранение базового плана проекта.
// Берется актуальный срез данных некоторых регистров и переписывается этим документом.
Процедура СохранитьВерсиюПланаПроекта(Отказ)
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяВерсияПроекта = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
	
	Если НЕ ЗначениеЗаполнено(ВерсияОснование) Тогда
		ВерсияОснование = ТекущаяВерсияПроекта;
	КонецЕсли;	
	
	ВерсияОснованиеЭтоТекущая = ТекущаяВерсияПроекта = ВерсияОснование;
	
	//
	
	Запросы = Новый Структура;
	
	//
	
	ПоляПоУмолчанию = Новый Соответствие;
	ПоляПоУмолчанию.Вставить("&ДатаДокумента"		, "Период");
	ПоляПоУмолчанию.Вставить("&Версия"				, "Версия");
	
	УсловиеНаПроект = "Версия = &ВерсияОснование";
	
	РегистрыДанныхВыполнения = Новый Соответствие;
	РегистрыДанныхВыполнения.Вставить("упоПроцентыГотовностиПроектныхЗадач", Истина);
	РегистрыДанныхВыполнения.Вставить("упоПроцентыГотовностиПроектов", Истина);
	РегистрыДанныхВыполнения.Вставить("упоСтатусыПроектныхЗадач", Истина);
	РегистрыДанныхВыполнения.Вставить("упоФактическиеДатыНачалаИОкончанияПроектныхЗадач", Истина);
	
	РегистрыСОграничениемФункциональности = Новый Соответствие;
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		РегистрыСОграничениемФункциональности.Вставить("упоСтатусыПроектнойПродукции",Истина);
		РегистрыСОграничениемФункциональности.Вставить("упоДанныеПроектнойПродукции", Истина);
	КонецЕсли;
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПричиныОтклонений() Тогда 
		РегистрыСОграничениемФункциональности.Вставить("упоПричиныОтклонений", Истина);
	КонецЕсли;
	
	Для Каждого Движение Из Движения Цикл
		имяРегистра = Движение.Метаданные().Имя;
		Если Не ВерсияВключаетДанныеВыполнения И РегистрыДанныхВыполнения[имяРегистра] <> Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		Если РегистрыДанныхВыполнения[имяРегистра] <> Неопределено И ПредыдущаяТекущаяВерсия <> Неопределено Тогда
			Запросы.Вставить(имяРегистра, СформироватьЗапросПоРегистру(имяРегистра, ПоляПоУмолчанию,
				"Версия = &ПредыдущаяТекущая"));
			Продолжить;
		КонецЕсли;
		
		ЭтоРегистрСОграничением = РегистрыСОграничениемФункциональности[имяРегистра];
		Если ЭтоРегистрСОграничением = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Запросы.Вставить(имяРегистра, СформироватьЗапросПоРегистру(имяРегистра, ПоляПоУмолчанию, УсловиеНаПроект));
	КонецЦикла;
	
	//
	
	ПоляПоУмолчанию = Новый Соответствие;
	ПоляПоУмолчанию.Вставить("&Версия"				, "Версия");
	ПоляПоУмолчанию.Вставить("&Проект"				, "Проект");
	
	СтруктураНезависимыхРегистров = Новый Структура;
	
	Если ВерсияОснованиеЭтоТекущая Тогда
		УсловиеНаПроект = "табличка.Проект = &Проект";
		Если Текущая Тогда
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратСводноТекущаяВерсия", 
				"упоАктуальныеПланыТрудозатратСводноТекущаяВерсия");	
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия", 
				"упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия");
		Иначе
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратСводноТекущаяВерсия", 
				"упоАктуальныеПланыТрудозатратСводноВерсии");
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия", 
				"упоАктуальныеПланыТрудозатратПоДнямВерсии");
		КонецЕсли;
	Иначе
		УсловиеНаПроект = "табличка.Версия = &ВерсияОснование";
		Если Текущая Тогда
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратСводноВерсии", 
				"упоАктуальныеПланыТрудозатратСводноТекущаяВерсия");
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратПоДнямВерсии", 
				"упоАктуальныеПланыТрудозатратПоДнямТекущаяВерсия");
		Иначе
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратСводноВерсии", 
				"упоАктуальныеПланыТрудозатратСводноВерсии");
			СтруктураНезависимыхРегистров.Вставить("упоАктуальныеПланыТрудозатратПоДнямВерсии", 
				"упоАктуальныеПланыТрудозатратПоДнямВерсии");
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из СтруктураНезависимыхРегистров Цикл
		Запросы.Вставить(КлючЗначение.Значение, 
			СформироватьЗапросПоРегистру(КлючЗначение.Ключ, ПоляПоУмолчанию, УсловиеНаПроект));
	КонецЦикла;
	
	//
	
	ТекстЗапроса = "";
	
	ПервыйЗапрос = Истина;
	Для Каждого текЗапрос Из Запросы Цикл
		Если НЕ ЗначениеЗаполнено(текЗапрос.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ПервыйЗапрос Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|;
				|";
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + текЗапрос.Значение;
		
		Если ПервыйЗапрос Тогда
			ПервыйЗапрос = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект"       	, Проект);
	Запрос.УстановитьПараметр("ДатаДокумента"	, Дата);
	Запрос.УстановитьПараметр("Версия"			, Ссылка);
	Запрос.УстановитьПараметр("ВерсияОснование"	, ВерсияОснование);
	Если ПредыдущаяТекущаяВерсия <> Неопределено Тогда
		Запрос.УстановитьПараметр("ПредыдущаяТекущая", ПредыдущаяТекущаяВерсия);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	
	//
	
	сч = 0;
	Для Каждого текЗапрос Из Запросы Цикл
		ТаблицаРегистра = РезультатыЗапросов[сч].Выгрузить();
		ТаблицаДвижения = Движения.Найти(текЗапрос.Ключ);
		Если ТаблицаДвижения <> Неопределено Тогда
			ТаблицаДвижения.Загрузить(ТаблицаРегистра);
		Иначе
			НаборЗаписей = РегистрыСведений[текЗапрос.Ключ].СоздатьНаборЗаписей();
			Если Текущая И НаборЗаписей.Отбор.Найти("Проект") <> Неопределено Тогда
				НаборЗаписей.Отбор.Проект.Установить(Проект);
			Иначе
				НаборЗаписей.Отбор.Версия.Установить(Ссылка);
			КонецЕсли;
			НаборЗаписей.Загрузить(ТаблицаРегистра);
			НаборЗаписей.Записать(Истина);
		КонецЕсли;		
		сч = сч + 1;
	КонецЦикла;
	
	//
	
	Если НЕ Текущая Тогда
		// Сохраним текущие КОДЫ СДР
		ТемпИерархия = Новый Соответствие;
		ТемпКодыСДР = Новый Соответствие;
		упоПроектыИЗадачиВызовСервера.ЗаполнитьИерархию(Проект, ТемпИерархия, ТемпКодыСДР);
		Движения.упоКодыСДР.Очистить();
		Для каждого киз Из ТемпКодыСДР Цикл
			новоеДвижение = Движения.упоКодыСДР.Добавить();
			новоеДвижение.Период 			= Дата;
			новоеДвижение.Версия 			= ссылка;
			новоеДвижение.ПроектнаяЗадача 	= киз.Ключ;
			новоеДвижение.КодСДР 			= киз.Значение;
		КонецЦикла;
	КонецЕсли;
	
	//
	
	НаименованиеВерсииОснования = упоВерсионирование.ПолучитьНаименованиеВерсии(ВерсияОснование);
	
	КомментарийВерсии =  НСтр("ru = 'Данные загружены из версии ""%1"" %2 %3'");
	
	Если Комментарий = "" Тогда
		КомментарийВерсии = СокрП(СтрШаблон(КомментарийВерсии, НаименованиеВерсииОснования, ДатаМодификации));
	Иначе 
		КомментарийВерсии = СтрШаблон(КомментарийВерсии, НаименованиеВерсииОснования, ДатаМодификации, 
			"(" + Комментарий + ")");
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.упоВерсииПроекта.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Версия.Установить(Ссылка);
	НаборЗаписей.Отбор.Проект.Установить(Проект);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда 
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.Комментарий = КомментарийВерсии;
		КонецЦикла;
		НаборЗаписей.Записать();
	КонецЕсли;

	//

	СохранитьВерсиюДополнительныхРеквизитов(Ссылка, ВерсияОснование, ТекущаяВерсияПроекта);

КонецПроцедуры

#Область ВерсионированиеДополнительныхРеквизитов

Процедура СохранитьВерсиюДополнительныхРеквизитов(ВерсияПриемник, ВерсияИсточник, ТекущаяВерсияПроекта)
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалВерсионированиеДопРеквизитов() Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьВерсионируемыеДополнительныеРеквизиты = ЕстьВерсионируемыеДополнительныеРеквизиты();
	Если Не ЕстьВерсионируемыеДополнительныеРеквизиты Тогда
		Возврат;
	КонецЕсли;

	//

	ДатаСеанса = ТекущаяДатаСеанса();
	ДатаСеансаУниверсальная = УниверсальноеВремя(ДатаСеанса, ЧасовойПоясСеанса());
	
	ВерсияОснованиеЭтоТекущая = ВерсияИсточник = ТекущаяВерсияПроекта;
	ОбновитьТекущиеДанныеСправочников = ТекущаяВерсияПроекта = ВерсияПриемник;

	//

	Если ВерсияОснованиеЭтоТекущая Тогда
		ТекстЗапросаНовыеЗначенияДополнительныеРеквизиты = ТекстЗапросаНовыеЗначенияДополнительныхРеквизитыТекущейВерсии();
	Иначе
		ТекстЗапросаНовыеЗначенияДополнительныеРеквизиты = ТекстЗапросаНовыеЗначенияДополнительныхРеквизитыВерсии();
	КонецЕсли;

	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(ТекстЗапросаНовыеЗначенияДополнительныеРеквизиты);
	ТекстыЗапроса.Добавить(ТекстЗапросаТекущиеЗначенияДополнительныхРеквизитов());
	ТекстыЗапроса.Добавить(ОсновнаяЧастьЗапросаДополнительныеРеквизитыПроектнойПродукцииИзменения());

	ТекстЗапроса = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Автор", Автор);
	Запрос.УстановитьПараметр("Дата", ДатаСеансаУниверсальная);
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.УстановитьПараметр("ВерсияПриемник", ВерсияПриемник);
	Запрос.УстановитьПараметр("ВерсияИсточник", ВерсияИсточник);
	Запрос.УстановитьПараметр("ОбновитьТекущиеДанныеСправочников", ОбновитьТекущиеДанныеСправочников);

	РезультатПакета = Запрос.ВыполнитьПакет();

	//

	ВыборкаДанныхОбновленияРС = РезультатПакета[РезультатПакета.Количество() - 1].Выбрать();

	НаборЗаписей = РегистрыСведений["упоДополнительныеРеквизитыВерсии"].СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Версия.Установить(ВерсияПриемник);
	НаборЗаписей.Отбор.Период.Установить(ДатаСеансаУниверсальная);

	Пока ВыборкаДанныхОбновленияРС.Следующий() Цикл
		ЗаписьНабора = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(ЗаписьНабора, ВыборкаДанныхОбновленияРС);
	КонецЦикла;

	НаборЗаписей.Записать();

	//

	Если Не ОбновитьТекущиеДанныеСправочников Тогда
		Возврат;
	КонецЕсли;

	ВыборкаОбъект = РезультатПакета[РезультатПакета.Количество() - 2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаОбъект.Следующий() Цикл

		ОбъектВладелец = ВыборкаОбъект.Объект.ПолучитьОбъект();
		ОбъектВладелец.ДополнительныеРеквизиты.Очистить();

		Если Не ВыборкаОбъект.Удалить = Истина Тогда
			Выборка = ВыборкаОбъект.Выбрать();
			Пока Выборка.Следующий() Цикл
				НоваяСтрока = ОбъектВладелец.ДополнительныеРеквизиты.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			КонецЦикла;
		КонецЕсли;

		ОбъектВладелец.Записать();

	КонецЦикла;

КонецПроцедуры

Функция ЕстьВерсионируемыеДополнительныеРеквизиты()

	ЕстьВерсионируемыеДополнительныеРеквизиты = упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция();
	Возврат ЕстьВерсионируемыеДополнительныеРеквизиты;

КонецФункции

Функция ОсновнаяЧастьЗапросаДополнительныеРеквизитыПроектнойПродукцииИзменения()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	упоДополнительныеРеквизитыВерсииСрезПоследних.Объект КАК Объект,
	|	упоДополнительныеРеквизитыВерсииСрезПоследних.Свойство КАК Свойство,
	|	упоДополнительныеРеквизитыВерсииСрезПоследних.Значение КАК Значение,
	|	упоДополнительныеРеквизитыВерсииСрезПоследних.Действует КАК Действует
	|ПОМЕСТИТЬ СтарыеЗначенияДополнительныхРеквизитов
	|ИЗ
	|	РегистрСведений.упоДополнительныеРеквизитыВерсии.СрезПоследних(, Версия = &ВерсияПриемник) КАК упоДополнительныеРеквизитыВерсииСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ТекущиеЗначенияДР.Объект, НовыеЗначенияДР.Объект) КАК Объект,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТекущиеЗначенияДР.Действует, ЛОЖЬ) = ИСТИНА
	|					И ЕСТЬNULL(НовыеЗначенияДР.Действует, ЛОЖЬ) = ЛОЖЬ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК УдалитьДополнительныеРеквизиты,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ТекущиеЗначенияДР.Значение, ""_ПустоеЗначение_"") <> ЕСТЬNULL(НовыеЗначенияДР.Значение, ""_ПустоеЗначение_"")
	|						И ЕСТЬNULL(ТекущиеЗначенияДР.Действует, ЛОЖЬ) = ЕСТЬNULL(НовыеЗначенияДР.Действует, ЛОЖЬ)
	|					ИЛИ ЕСТЬNULL(ТекущиеЗначенияДР.Действует, ЛОЖЬ) <> ЕСТЬNULL(НовыеЗначенияДР.Действует, ЛОЖЬ)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьИзменения
	|ПОМЕСТИТЬ ОбъектыДляОбновления
	|ИЗ
	|	ТекущиеЗначенияДополнительныхРеквизитов КАК ТекущиеЗначенияДР
	|		ПОЛНОЕ СОЕДИНЕНИЕ НовыеЗначенияДополнительныхРеквизитов КАК НовыеЗначенияДР
	|		ПО ТекущиеЗначенияДР.Объект = НовыеЗначенияДР.Объект
	|			И ТекущиеЗначенияДР.Свойство = НовыеЗначенияДР.Свойство
