// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Основание    - Произвольный, значение, которое используется как основание для заполнения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если ТипЗнч(Основание)=Тип("Неопределено") Тогда 
		Возврат;
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
//  РежимЗаписи  - РежимЗаписиДокумента, в параметр передается текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)	
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);	
	
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;    
	КонецЕсли; 
	
	Если Текущая Тогда
		ВерсияВключаетДанныеВыполнения = Истина;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ЭтоВосстановлениеВерсии") 
		И Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВерсияОснование, "ВерсияВключаетДанныеВыполнения") Тогда
		ПредыдущаяТекущаяВерсия	= упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);	
	КонецЕсли;
	
	Дата = ТекущаяДатаСеанса();
	
КонецПроцедуры // ПередЗаписью()

// Обработчик события ПриЗаписи модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриЗаписи(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПриЗаписи(ЭтотОбъект, Отказ);
	
	Если НЕ ЗначениеЗаполнено(НаименованиеВерсии) Тогда
		НаименованиеВерсии = упоВерсионирование.ПолучитьНаименованиеНовойВерсии(Проект);
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;    
	КонецЕсли; 
	
	
	// Запишем версию в список
	наборЗаписей = РегистрыСведений.упоВерсииПроекта.СоздатьНаборЗаписей();
		
	Если Текущая ИЛИ Базовая Тогда   	
		
		наборЗаписей.Отбор.Проект.Установить(Проект);
		наборЗаписей.Прочитать();
			
		Таблица = наборЗаписей.Выгрузить();
		Таблица.Индексы.Добавить("Версия");
		
		Если Текущая Тогда
			строкаТекущейВерсии = Таблица.Найти(Истина, "Текущая");
			Если НЕ строкаТекущейВерсии = Неопределено Тогда
				строкаТекущейВерсии.Текущая = Ложь;
				строкаТекущейВерсии.Системная = Истина;
			КонецЕсли;
		КонецЕсли;
		Если Базовая Тогда
			Таблица.ЗаполнитьЗначения(Ложь, "Базовая");
		КонецЕсли;
		
		СтрокаВерсии = Таблица.Найти(Ссылка, "Версия");
		Если СтрокаВерсии = Неопределено Тогда
			СтрокаВерсии = Таблица.Добавить();
		
			СтрокаВерсии.Проект = Проект;
			СтрокаВерсии.Версия = Ссылка;
			СтрокаВерсии.НаименованиеВерсии = НаименованиеВерсии;
			СтрокаВерсии.Автор = Автор;
			СтрокаВерсии.ДатаСоздания = ДатаМодификации;
			СтрокаВерсии.Системная = Системная;
			СтрокаВерсии.ВерсияВключаетДанныеВыполнения = ВерсияВключаетДанныеВыполнения;
		КонецЕсли;	
		
		Если Текущая Тогда
			СтрокаВерсии.Текущая = Текущая;
		КонецЕсли;
		Если Базовая Тогда
			СтрокаВерсии.Базовая = Базовая;
			Если Текущая И СтрокаВерсии.Системная = Истина Тогда
				СтрокаВерсии.Системная = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаВерсии.ДатаОбновления = ТекущаяДатаСеанса();
		
		наборЗаписей.Загрузить(Таблица);
		наборЗаписей.Записать();
		
	Иначе
		наборЗаписей.Отбор.Проект.Установить(Проект);
		наборЗаписей.Отбор.Версия.Установить(Ссылка);
		наборЗаписей.Прочитать();
			
		Таблица = наборЗаписей.Выгрузить();
		
		Если Таблица.Количество() = 0 Тогда
			новаяСтрока = Таблица.Добавить();
		
			новаяСтрока.Проект = Проект;
			новаяСтрока.Версия = Ссылка;
			новаяСтрока.НаименованиеВерсии = НаименованиеВерсии;
			новаяСтрока.Автор = Автор;
			новаяСтрока.ДатаСоздания = ДатаМодификации;
			новаяСтрока.Системная = Системная;
			новаяСтрока.Текущая = Текущая;
			новаяСтрока.Базовая = Базовая;
			новаяСтрока.ДатаОбновления = ТекущаяДатаСеанса();
			новаяСтрока.ВерсияВключаетДанныеВыполнения = ВерсияВключаетДанныеВыполнения;
			
			наборЗаписей.Загрузить(Таблица);
			наборЗаписей.Записать();
		Иначе
			Таблица.ЗаполнитьЗначения(ТекущаяДатаСеанса(), "ДатаОбновления");
			Таблица.ЗаполнитьЗначения(ВерсияВключаетДанныеВыполнения, "ВерсияВключаетДанныеВыполнения");
			наборЗаписей.Загрузить(Таблица);
			наборЗаписей.Записать();			
		КонецЕсли;
	КонецЕсли;
	
	#Если Клиент Тогда
	Оповестить("ПанельПроекта_ЗаписьВерсии", , Ссылка);
	#КонецЕсли

КонецПроцедуры // ПриЗаписи()

