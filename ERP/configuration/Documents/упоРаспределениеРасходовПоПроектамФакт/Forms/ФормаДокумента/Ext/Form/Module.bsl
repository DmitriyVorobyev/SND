Функция ПолучитьСтруктуруПоиска(Строка)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ПроектнаяЗадача", Строка.ПроектнаяЗадача);
	СтруктураПоиска.Вставить("Подразделение", Строка.Подразделение);
	СтруктураПоиска.Вставить("СобствСилы_Субподряд", Строка.СобствСилы_Субподряд);
	СтруктураПоиска.Вставить("СтатьяРасходов", Строка.СтатьяРасходов);
	СтруктураПоиска.Вставить("ИндексСтрокиРасходов", Строка.ИндексСтрокиРасходов);
	СтруктураПоиска.Вставить("КоэффициентПроекта", Строка.КоэффициентПроекта);
	СтруктураПоиска.Вставить("КоэффициентПодразделения", Строка.КоэффициентПодразделения);
	
	Возврат СтруктураПоиска;
	
