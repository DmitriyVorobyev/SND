#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьЭлементыФормы()
	
	СхемаКомпоновки = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ПроектыДляРаспределения");
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(СхемаКомпоновки , УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресВоВременномХранилище);
	
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ПостроитьПериодыРасходовКРаспределению();
		ПостроитьПериодыРаспределенныхРасходов();
		ЗаполнитьКолонкиПериодовПоТаблицеРасходов();		
		ЗаполнитьКолонкиПериодовПоТаблицеРаспределения();
		УстановитьЗаголовокВыбораПериода();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицыРаспределения()
	
	Объект.РасходыКРаспределению.Очистить();
	Объект.РасходыКРаспределениюПоПериодам.Очистить();
	Объект.РаспределенныеРасходы.Очистить();
	Объект.РаспределенныеРасходыПоПериодам.Очистить();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНаименованияВТаблицах()
	
	МассивПЗ = Новый Массив;

	Для Каждого СтрокаТЧ Из Объект.РаспределенныеРасходы Цикл
		МассивПЗ.Добавить(СтрокаТЧ.ПроектнаяЗадача);
	КонецЦикла;
	
	НазванияПЗ = упоПроектыИЗадачиСервер.НазванияПроектныхЗадач(МассивПЗ);
	
	Для Каждого СтрокаТЧ Из Объект.РаспределенныеРасходы Цикл
		СтрокаТЧ.НазваниеПроектнойЗадачи = НазванияПЗ[СтрокаТЧ.ПроектнаяЗадача];
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция МассивПроектов(ИмяТЧ)
	
	Массив = Новый Массив;
	
	Для Каждого Строка Из Объект[ИмяТЧ] Цикл
		
		Если Строка.Распределять Тогда
			Массив.Добавить(Строка.Проект);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции	

&НаКлиенте
Процедура ВыборПериодаЗавершение(Период, ДополнительныеПараметры) Экспорт
	
    ВыборПериодаМесяц = ДополнительныеПараметры.ДиалогВыборПериода;

    Если ЗначениеЗаполнено(Период) Тогда
        ВыбранныйПериод = ВыборПериодаМесяц.Период;
        Объект.НачалоПериода = НачалоМесяца(ВыбранныйПериод.ДатаНачала);
        Объект.ОкончаниеПериода = КонецМесяца(ВыбранныйПериод.ДатаОкончания);
	КонецЕсли;
	
	УстановитьЗаголовокВыбораПериода();
	ОбновитьВидимостьЭлементов();

КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокВыбораПериода()
	
	Если НачалоМесяца(Объект.НачалоПериода) = НачалоМесяца(Объект.ОкончаниеПериода) Тогда
		
		Элементы.КнопкаВыборПериода.Заголовок = НСтр("ru = 'Период '") + " "  
			+ Формат(Объект.ОкончаниеПериода, НСтр("ru='ДФ=''ММММ гггг ""г.""'''"));
			
	Иначе
										
		Элементы.КнопкаВыборПериода.Заголовок = НСтр("ru = 'Период с'") + " "  
			+ Формат(Объект.НачалоПериода, НСтр("ru='ДФ=''ММММ гггг ""г.""'''"))  
			+  " " + НСтр("ru = 'по'") + " " 
			+ Формат(Объект.ОкончаниеПериода, НСтр("ru='ДФ=''ММММ гггг ""г.""'''"));
			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСнятьФлажки(Пометка, ИмяТЧ)
	
	Для Каждого ТекСтрока Из Объект[ИмяТЧ] Цикл
		ТекСтрока.Распределять = Пометка;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьСтруктуруПараметров(ОсновнаяТаблица, ТаблицаСПериодами, СоответствиеКолонок, ИндексОсновнойТЧ,
	ИндексТЧПериодов)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ОсновнаяТаблица", ОсновнаяТаблица);
	СтруктураПараметров.Вставить("ТаблицаСПериодами", ТаблицаСПериодами);
	СтруктураПараметров.Вставить("СоответствиеКолонок", СоответствиеКолонок);
	СтруктураПараметров.Вставить("ИндексОсновнойТЧ", ИндексОсновнойТЧ);
	СтруктураПараметров.Вставить("ИндексТЧПериодов", ИндексТЧПериодов);
	
	Возврат СтруктураПараметров;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаРасходыВсе()
	
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	        |	НАЧАЛОПЕРИОДА(упоФактДоходовИРасходовОборотыОбороты.Период, МЕСЯЦ) КАК Период,
	        |	упоФактДоходовИРасходовОборотыОбороты.Подразделение КАК Подразделение,
	        |	упоФактДоходовИРасходовОборотыОбороты.Статья КАК СтатьяРасходов,
	        |	упоФактДоходовИРасходовОборотыОбороты.Статья.СпособыРаспределенияРасходовПоПроектам КАК СпособРаспределенияРасходов,
	        |	СУММА(упоФактДоходовИРасходовОборотыОбороты.СуммаОборот) КАК Сумма,
