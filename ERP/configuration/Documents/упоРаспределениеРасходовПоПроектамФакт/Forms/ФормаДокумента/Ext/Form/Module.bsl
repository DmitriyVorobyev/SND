Функция СтруктураТаблицыРаспределение()

 	ТаблицаРаспределение = Новый ТаблицаЗначений;
	ТаблицаРаспределение.Колонки.Добавить("ПроектнаяЗадача", Новый ОписаниеТипов("ДокументСсылка.упоПроектнаяЗадача"));
	ТаблицаРаспределение.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.упоПодразделения"));
	ТаблицаРаспределение.Колонки.Добавить("СобствСилы_Субподряд", Новый ОписаниеТипов("СправочникСсылка.упоСобственныеСилыСубподряд"));
	ТаблицаРаспределение.Колонки.Добавить("СтатьяРасходов", Новый ОписаниеТипов("СправочникСсылка.упоСтатьиЗатрат"));
	ТаблицаРаспределение.Колонки.Добавить("Сумма", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	ТаблицаРаспределение.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаРаспределение.Колонки.Добавить("КоэффициентПроекта", ОбщегоНазначения.ОписаниеТипаЧисло(15, 4));
	ТаблицаРаспределение.Колонки.Добавить("КоэффициентПодразделения", ОбщегоНазначения.ОписаниеТипаЧисло(15, 4));
	ТаблицаРаспределение.Колонки.Добавить("ИндексСтрокиРасходов", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));

	Возврат ТаблицаРаспределение;
	
