#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределенныеРасходыПроектнаяЗадачаПриИзменении(Элемент)
	
	ТекДанные = Элементы.РаспределенныеРасходы.ТекущиеДанные;	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.ПроектнаяЗадача) Тогда
		Возврат;
	КонецЕсли;

	МассивПЗ = Новый Массив;
	МассивПЗ.Добавить(ТекДанные.ПроектнаяЗадача);
	НазванияПЗ = упоПроектыИЗадачиВызовСервера.НазванияПроектныхЗадач(МассивПЗ);
	ТекДанные.НазваниеПроектнойЗадачи = НазванияПЗ[ТекДанные.ПроектнаяЗадача];

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаПеречитать(Команда)
	
	ЭтотОбъект.Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыборПериода(Команда)
	
	ВыборПериодаМесяц = Новый ДиалогРедактированияСтандартногоПериода();
	ВыборПериодаМесяц.Период = Новый СтандартныйПериод(Объект.НачалоПериода, Объект.ОкончаниеПериода);
	СтруктураПараметров = Новый Структура("ДиалогВыборПериода", ВыборПериодаМесяц);
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыборПериодаЗавершение", ЭтаФорма, СтруктураПараметров);
	ВыборПериодаМесяц.Показать(ОповещениеВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроектыОбщефирменнойДеятельности()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Проекты.Ссылка КАК Проект
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |ГДЕ
	               |	Проекты.Компонент = ЗНАЧЕНИЕ(Перечисление.упоКомпоненты.ОбщефирменнаяДеятельность)";	
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ТекстСообщения = НСтр("ru = 'Нет проектов с компонентой ""Общефирменная деятельность"".'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.СлужебныеПроекты.Добавить();
		НоваяСтрока.Проект = Выборка.Проект;
		НоваяСтрока.Распределять = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьСлужебныеПроекты(Команда)

	Объект.СлужебныеПроекты.Очистить(); 
	ЗаполнитьПроектыОбщефирменнойДеятельности();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроектыДляРаспределения()
	
	СхемаКомпоновки     = Документы.упоРаспределениеРасходовПоПроектамФакт.ПолучитьМакет("ПроектыДляРаспределения");
	НастройкиКомпоновки = КомпоновщикНастроек.ПолучитьНастройки();
	
	КомпоновщикМакета 	= Новый КомпоновщикМакетаКомпоновкиДанных;
	Тип					= Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений");
	МакетКомпоновки 	= КомпоновщикМакета.Выполнить(СхемаКомпоновки, НастройкиКомпоновки, , , Тип);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ТабЗнач = Новый ТаблицаЗначений;
	
	ПроцессорВывода.УстановитьОбъект(ТабЗнач);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);

	Для Каждого СтрокаТЗ Из ТабЗнач Цикл
		НоваяСтрока = Объект.ПроектыДляРаспределения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);		
	КонецЦикла;		
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПроектыДляРаспределения(Команда)
	
	Объект.ПроектыДляРаспределения.Очистить();	 
	ЗаполнитьПроектыДляРаспределения();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасходыКРаспределению(ТекстЗапроса)
	
	Если Не (ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода)) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран период'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;	
	КонецЕсли;
	
	МассивСлужебныхПроектов = МассивПроектов("СлужебныеПроекты"); 

	Если Не ЗначениеЗаполнено(МассивСлужебныхПроектов) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбраны проекты общефирменной деятельности.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.СлужебныеПроекты");
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;	
		
	Запрос.УстановитьПараметр("СлужебныеПроекты", МассивСлужебныхПроектов);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.ОкончаниеПериода));
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Если Результат.Пустой() Тогда
		ТекстСообщения = НСтр("ru = 'Нет фактических расходов к распределению по проектам общефирменной деятельности.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ИндексСтрок = 0;		 
	ВыборкаПодразделения = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПодразделения.Следующий() Цикл			
		
		ВыборкаСтатьиРасходов = ВыборкаПодразделения.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСтатьиРасходов.Следующий() Цикл
			
			ВыборкаСС_СП = ВыборкаСтатьиРасходов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаСС_СП.Следующий() Цикл
				
				ИндексСтрок = ИндексСтрок + 1;
				НоваяСтрока = Объект.РасходыКРаспределению.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСС_СП);				
				НоваяСтрока.ИндексСтрокРаспределения = ИндексСтрок;
				ВыборкаПериоды = ВыборкаСС_СП.Выбрать();
				
				Пока ВыборкаПериоды.Следующий() Цикл
					НоваяСтрока = Объект.РасходыКРаспределениюПоПериодам.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПериоды);
					НоваяСтрока.ИндексСтрокиРасходов = ИндексСтрок;				
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПостроитьПериодыРасходовКРаспределению();
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияОПРОХР() Тогда
		
		СпособыРаспределения = Объект.РасходыКРаспределению.Выгрузить(, "СпособРаспределенияРасходов");
		МассивСпособов = СпособыРаспределения.ВыгрузитьКолонку("СпособРаспределенияРасходов");
		упоРаспределениеКосвенныхРасходов.ПроверитьСпособыРаспределения(МассивСпособов, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьПериодыРасходовКРаспределению()

	ТаблицаСПериодами = Объект.РасходыКРаспределениюПоПериодам.Выгрузить();	
	ТаблицаИтогов = упоРаботаСФормамиСервер.ПолучитьТаблицуПериодов(ТаблицаПериодов, ТаблицаСПериодами, Истина);
	
	упоРаботаСФормамиСервер.РаспределениеПоПериодам(ЭтаФорма, ТаблицаПериодов, "РасходыКРаспределению", ТаблицаИтогов);
	Элементы.РасходыКРаспределениюСумма.ТекстПодвала = Формат(Объект.РасходыКРаспределению.Итог("Сумма"), "ЧДЦ=2");

КонецПроцедуры

&НаСервере
Процедура ПостроитьПериодыРаспределенныхРасходов()

	ТаблицаСПериодами = Объект.РаспределенныеРасходыПоПериодам.Выгрузить();	
	ТаблицаИтогов = упоРаботаСФормамиСервер.ПолучитьТаблицуПериодов(ТаблицаПериодов, ТаблицаСПериодами, Ложь);

	упоРаботаСФормамиСервер.РаспределениеПоПериодам(ЭтаФорма, ТаблицаПериодов, "РаспределенныеРасходы",	ТаблицаИтогов);
	Элементы.РаспределенныеРасходыСумма.ТекстПодвала = Формат(Объект.РаспределенныеРасходы.Итог("Сумма"), "ЧДЦ=2");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкиПериодовПоТаблицеРасходов()

	СоответствиеКолонок = Новый Соответствие;
	СоответствиеКолонок.Вставить("Период", "Сумма");
	СтруктураПараметров = СоздатьСтруктуруПараметров("РасходыКРаспределению", 
		"РасходыКРаспределениюПоПериодам",
		СоответствиеКолонок, 
		"ИндексСтрокРаспределения", 
		"ИндексСтрокиРасходов");
	упоРаботаСФормамиСервер.ЗаполнитьКолонкиПериодовДаннымиНаСервере(Объект, ТаблицаПериодов, СтруктураПараметров); 
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьКолонкиПериодовПоТаблицеРаспределения()

	СоответствиеКолонок = Новый Соответствие;
	СоответствиеКолонок.Вставить("Период", "Сумма");
	СтруктураПараметров = СоздатьСтруктуруПараметров("РаспределенныеРасходы", 
		"РаспределенныеРасходыПоПериодам",
		СоответствиеКолонок, 
		"ИндексСтрокиРаспределенияПоПериодам", 
		"ИндексСтрокиРаспределенныхРасходов");
	упоРаботаСФормамиСервер.ЗаполнитьКолонкиПериодовДаннымиНаСервере(Объект, ТаблицаПериодов, СтруктураПараметров); 
	ЗаполнитьНаименованияВТаблицах();

КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗаполнитьРасходыКРаспределению(Команда)
	
	ОчиститьТаблицыРаспределения();
	ТекстЗапроса = ТекстЗапросаРасходыВсе();
	ЗаполнитьРасходыКРаспределению(ТекстЗапроса);
	ЗаполнитьКолонкиПериодовПоТаблицеРасходов();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьРасходыКРаспределениюФОТ(Команда)
	
	ОчиститьТаблицыРаспределения();
	ТекстЗапроса = ТекстЗапросаРасходыФОТ();
