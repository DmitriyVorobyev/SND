	ЗаполнитьКолонкиПериодовПоТаблицеРасходов();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаспределенныеРасходы()
	
	Если Не ЗначениеЗаполнено(Объект.РасходыКРаспределению) Тогда
		ТекстСообщения = НСтр("ru = 'Нет расходов к распределению'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.РасходыКРаспределению");
		Возврат;
	КонецЕсли;
	
	МассивПроектыДляРаспределения = МассивПроектов("ПроектыДляРаспределения"); 
	
	Если Не ЗначениеЗаполнено(МассивПроектыДляРаспределения) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбраны проекты для распределения'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.ПроектыДляРаспределения");
		Возврат;	
	КонецЕсли;
	
	ТаблицаКосвенныхРасходов = СтруктураТаблицыКосвенныхРасходов();
	
	Для Каждого Строка Из Объект.РасходыКРаспределениюПоПериодам Цикл
		
		СтруктураИндекс = Новый Структура("ИндексСтрокРаспределения", Строка.ИндексСтрокиРасходов);
		НайдСтроки = Объект.РасходыКРаспределению.НайтиСтроки(СтруктураИндекс);
		
		Если НайдСтроки.Количество() > 0 Тогда
			
			Если Не ЗначениеЗаполнено(НайдСтроки[0].СпособРаспределенияРасходов) Тогда
				ТекстСообщения = НСтр("ru = 'Заполните способ распределения расходов у статей затрат'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Объект.РасходыКРаспределению");
				Возврат;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаКосвенныхРасходов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайдСтроки[0]);
			НоваяСтрока.Сумма = Строка.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРаспределение = СтруктураТаблицыРаспределение();
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("МассивПроектыДляРаспределения", МассивПроектыДляРаспределения);
	СтруктураПараметры.Вставить("ДатаНачало", Объект.НачалоПериода);
	СтруктураПараметры.Вставить("ДатаКонец", КонецДня(Объект.ОкончаниеПериода));
	
	упоРаспределениеКосвенныхРасходов.КосвенныеРасходыРаспределить(ТаблицаКосвенныхРасходов, 
		ТаблицаРаспределение, 
		СтруктураПараметры); 
		
	Если Не ЗначениеЗаполнено(ТаблицаРаспределение) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРаспределение.Сортировать("Период Возр");
	Ключ = "ПроектнаяЗадача,Подразделение,СобствСилы_Субподряд,СтатьяРасходов,ИндексСтрокиРасходов,КоэффициентПроекта,КоэффициентПодразделения"; 
	ТаблицаРаспределение.Индексы.Добавить(Ключ);
	
	КопияРаспределение = ТаблицаРаспределение.Скопировать();
	КопияРаспределение.Свернуть(Ключ);
	ИндексСтрок = 0;
	ВалютаУпр = ПараметрыСеанса.упоВалютаУправленческогоУчета;
	
	Для Каждого Строка Из КопияРаспределение Цикл
		
		ИндексСтрок = ИндексСтрок + 1;
		НоваяСтрока = Объект.РаспределенныеРасходы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);				
		НоваяСтрока.ИндексСтрокиРаспределенияПоПериодам = ИндексСтрок;
		НоваяСтрока.Валюта = ВалютаУпр;
		СтруктураПоиска = ПолучитьСтруктуруПоиска(Строка);
		НайденныеСтроки = ТаблицаРаспределение.НайтиСтроки(СтруктураПоиска);
		Сумма = 0;
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			НоваяСтрокаПериод = Объект.РаспределенныеРасходыПоПериодам.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПериод, НайденнаяСтрока);
			НоваяСтрокаПериод.ИндексСтрокиРаспределенныхРасходов = ИндексСтрок;
			Сумма = Сумма + НайденнаяСтрока.Сумма;
			
		КонецЦикла;
		
		НоваяСтрока.Сумма = Сумма;
		
	КонецЦикла;
					
	ПостроитьПериодыРаспределенныхРасходов();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьРаспределенныеРасходы(Команда)
	
	Объект.РаспределенныеРасходы.Очистить();
	Объект.РаспределенныеРасходыПоПериодам.Очистить();
	ЗаполнитьРаспределенныеРасходы();
	ЗаполнитьКолонкиПериодовПоТаблицеРаспределения();

