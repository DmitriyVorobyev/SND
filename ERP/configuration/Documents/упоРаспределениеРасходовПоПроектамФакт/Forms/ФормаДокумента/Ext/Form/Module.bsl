&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()
	
	Отображать = Истина;
	
	Если НачалоМесяца(Объект.НачалоПериода) = НачалоМесяца(Объект.ОкончаниеПериода) Тогда
		Отображать = Ложь;
	КонецЕсли;
	
	Элементы.РасходыКРаспределениюСумма.Видимость = Отображать;
	Элементы.РаспределенныеРасходыСумма.Видимость = Отображать;
		
