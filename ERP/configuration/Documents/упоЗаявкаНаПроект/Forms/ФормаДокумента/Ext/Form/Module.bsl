КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ТекущийОбъект.лмПроверитьЗаполнениеРеквизитов(Отказ);

	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоНовый", Истина);
	КонецЕсли;	
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
	Если Не ЗначениеЗаполнено(ТекущийОбъект.Проект) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("СозданиеНовогоПроекта", Истина);	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый") И ТекущийОбъект.ДополнительныеСвойства.ЭтоНовый Тогда
		ОбновитьНадписьПроект();	
		ОбновитьКартинкуПроекта();
	КонецЕсли;	
	
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("СозданиеНовогоПроекта") 
		И ТекущийОбъект.ДополнительныеСвойства.СозданиеНовогоПроекта
		И ЗначениеЗаполнено(ТекущийОбъект.Проект) Тогда
		
		ШаблонСообщения = НСтр("ru = 'По заявке ""%1"" создан новый проект ""%2"".'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекущийОбъект, ТекущийОбъект.НаименованиеПроекта);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения)
		
	КонецЕсли;

КонецПроцедуры

