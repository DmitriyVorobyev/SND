&НаКлиенте
Процедура РазвернутьСтрокиДереваПротоколы()
	
	ЭлементыДерева = ДеревоПротоколы.ПолучитьЭлементы();
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		Элементы.Протоколы.Развернуть(ЭлементДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПротоколыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Объект.Проект);
	Запрос.УстановитьПараметр("СтатусЗавершено", Перечисления.упоСтатусыЗаданий.Завершено);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПроектыФазы.НомерСтроки КАК НомерСтроки,
	               |	ПроектыФазы.Фаза КАК Фаза,
	               |	ПроектыФазы.ВехаЗеркало КАК ВехаЗеркало
	               |ПОМЕСТИТЬ втФазы
	               |ИЗ
	               |	Справочник.Проекты.Фазы КАК ПроектыФазы
	               |ГДЕ
	               |	ПроектыФазы.Ссылка = &Проект
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ВехаЗеркало
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоЗадания.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоЗадания.Ссылка КАК ПР,
	               |	упоЗадания.Исполнитель КАК Исполнитель,
	               |	упоСрокиЗаданий.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
	               |	упоЗаданияСтатусыСрезПоследних.Статус КАК Статус,
	               |	упоЗадания.ЭтоОсновноеЗаданиеПроектнойЗадачи КАК Основное,
	               |	упоЗадания.ОбъектБазы КАК ОбъектБазы
	               |ПОМЕСТИТЬ Задания
	               |ИЗ
	               |	Справочник.упоЗадания КАК упоЗадания
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоЗаданияСтатусы.СрезПоследних КАК упоЗаданияСтатусыСрезПоследних
	               |		ПО (упоЗаданияСтатусыСрезПоследних.Задание = упоЗадания.Ссылка)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
	               |		ПО упоЗадания.Ссылка = упоСрокиЗаданий.Задание
	               |ГДЕ
	               |	упоЗадания.ВидЗадания = ЗНАЧЕНИЕ(Справочник.упоВидыЗаданий.ПроектноеРешение)
	               |	И упоЗадания.ПроектнаяЗадача В
	               |			(ВЫБРАТЬ
	               |				втФазы.ВехаЗеркало КАК ВехаЗеркало
	               |			ИЗ
	               |				втФазы КАК втФазы)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Задания.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	Задания.ПР КАК ПР,
	               |	Задания.Исполнитель КАК Исполнитель,
	               |	Задания.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
	               |	Задания.Статус КАК Статус,
	               |	Задания.Основное КАК Основное,
	               |	ЕСТЬNULL(Статусы.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончанияФакт,
	               |	Задания.ОбъектБазы КАК ОбъектБазы
	               |ПОМЕСТИТЬ втПроектныеРешенияФаз
	               |ИЗ
	               |	Задания КАК Задания
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоЗаданияСтатусы.СрезПоследних(, Статус = &СтатусЗавершено) КАК Статусы
	               |		ПО Задания.ПР = Статусы.Задание
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	втФазы.Фаза КАК Фаза,
	               |	втПроектныеРешенияФаз.ПР КАК ПроектноеРешение,
	               |	втПроектныеРешенияФаз.ОбъектБазы КАК ПроектнаяЗадача,
	               |	Проекты.Ссылка КАК ПроектнаяЗадачаЗеркало,
	               |	втФазы.НомерСтроки КАК НомерСтроки,
	               |	втПроектныеРешенияФаз.Основное КАК Основное,
	               |	втПроектныеРешенияФаз.Статус КАК Статус,
	               |	втПроектныеРешенияФаз.ДатаОкончанияФакт КАК ДатаОкончанияФакт,
	               |	втПроектныеРешенияФаз.ДатаОкончанияПлан КАК ДатаОкончанияПлан
	               |ПОМЕСТИТЬ ФазыИПроектныеРешения
	               |ИЗ
	               |	втФазы КАК втФазы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втПроектныеРешенияФаз КАК втПроектныеРешенияФаз
	               |		ПО втФазы.ВехаЗеркало = втПроектныеРешенияФаз.ПроектнаяЗадача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |		ПО (втПроектныеРешенияФаз.ОбъектБазы = Проекты.СсылкаНаПроектнуюЗадачу)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ФазыИПроектныеРешения.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало
	               |ИЗ
	               |	ФазыИПроектныеРешения КАК ФазыИПроектныеРешения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ФазыИПроектныеРешения.Фаза КАК Фаза,
	               |	ФазыИПроектныеРешения.ПроектноеРешение КАК ПроектноеРешение,
	               |	ФазыИПроектныеРешения.ПроектнаяЗадача КАК ПроектнаяЗадача,
				   |	ФазыИПроектныеРешения.ПроектнаяЗадачаЗеркало КАК ПроектнаяЗадачаЗеркало
	               |ИЗ
	               |	ФазыИПроектныеРешения КАК ФазыИПроектныеРешения
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ФазыИПроектныеРешения.НомерСтроки,
	               |	ФазыИПроектныеРешения.Основное,
	               |	ФазыИПроектныеРешения.Статус,
	               |	ФазыИПроектныеРешения.ДатаОкончанияФакт,
	               |	ФазыИПроектныеРешения.ДатаОкончанияПлан
	               |ИТОГИ ПО
	               |	Фаза,
	               |	ПроектноеРешение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПоказателиПроектов.Ссылка КАК Показатель,
	               |	упоПоказателиПроектов.ПолноеНаименование КАК НаименованиеПоказателя
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	               |ГДЕ
	               |	упоПоказателиПроектов.ПоказательИнвестирования
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НаименованиеПоказателя";
			
	Результат = Запрос.ВыполнитьПакет();		
	Если Результат[Результат.ВГраница() - 1].Пустой() Тогда		
		ДеревоПротоколы.ПолучитьЭлементы().Очистить();
		Возврат;
	КонецЕсли;	
	
	ДеревоФормы = Результат[Результат.ВГраница() - 1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ДеревоФормы.Колонки.Добавить("Протокол");
	ДеревоФормы.Колонки.Добавить("ЭтоПротокол");
	ДеревоФормы.Колонки.Добавить("Значение");			
	ДеревоФормы.Колонки.Добавить("Показатель");			
	ДеревоФормы.Колонки.Добавить("НаименованиеПоказателя");			
	
	Показатели = Результат[Результат.ВГраница()].Выгрузить();
	ВехиЗеркало = Результат[Результат.ВГраница() - 2].Выгрузить().ВыгрузитьКолонку("ПроектнаяЗадачаЗеркало");
	ЗначенияПоказателейВех =
		упоПоказателиПроектовСервер.ПолучитьЗначенияПоказателей(Показатели.ВыгрузитьКолонку("Показатель"), ВехиЗеркало);
	
	ОбработатьДеревоПротоколыРекурсивно(ДеревоФормы.Строки, Показатели, ЗначенияПоказателейВех);
	
	ЗначениеВРеквизитФормы(ДеревоФормы, "ДеревоПротоколы");		
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьКартинкуПроекта()
	
	ОтображатьКартинку = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Проект) Тогда
		
		ФайлСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Проект, "упоКартинкаПроекта");
						
		Если ЗначениеЗаполнено(ФайлСсылка) Тогда			
			ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ПолучитьДанныеФайла(ФайлСсылка);				
			КартинкаПроекта = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;		
			ОтображатьКартинку = Истина;
		КонецЕсли;
		
	КонецЕсли;	
	
	Элементы.КартинкаПроекта.Видимость = ОтображатьКартинку;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ОбработатьДеревоПротоколыРекурсивно(СтрокиДерева, Показатели, ЗначенияПоказателейВех)
	
	СтрокиКУдалению = Новый Массив;
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		СтрокаКУдалению = Ложь;
		ПротоколРодитель = Неопределено;
		Если СтрокаДерева.Родитель <> Неопределено Тогда
			ПротоколРодитель = СтрокаДерева.Родитель.Протокол;
		КонецЕсли;	
		
		Если ТипЗНЧ(СтрокаДерева.Протокол) = Тип("СправочникСсылка.упоПоказателиПроектов") Тогда
			Продолжить;			
		ИначеЕсли ТипЗнч(ПротоколРодитель) = Тип("СправочникСсылка.упоФазыПроектов") Тогда	
			Если ЗначениеЗаполнено(СтрокаДерева.ПроектноеРешение) Тогда
				СтрокаДерева.Протокол = СтрокаДерева.ПроектноеРешение;		
				СтрокаДерева.ЭтоПротокол = Истина;
			Иначе
				СтрокаКУдалению = Истина;
				СтрокиКУдалению.Добавить(СтрокаДерева);
			КонецЕсли;			
		ИначеЕсли ТипЗнч(ПротоколРодитель) = Тип("СправочникСсылка.упоЗадания") Тогда
			СтрокаКУдалению = Истина;
			СтрокиКУдалению.Добавить(СтрокаДерева);
									
			Для Каждого СтрокаТаблицыПоказатели Из Показатели Цикл
				Значение = упоПоказателиПроектовСервер.ПолучитьЗначениеПоказателяПроекта(ЗначенияПоказателейВех,
					СтрокаТаблицыПоказатели.Показатель, СтрокаДерева.ПроектнаяЗадачаЗеркало);
				Если ЗначениеЗаполнено(Значение) Тогда
					СтрокаПоказатель = СтрокиДерева.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаПоказатель, СтрокаДерева, , "Родитель");
					СтрокаПоказатель.Показатель = СтрокаТаблицыПоказатели.Показатель;
					СтрокаПоказатель.Протокол = СтрокаТаблицыПоказатели.Показатель;
					СтрокаПоказатель.Значение = Значение;
					СтрокаПоказатель.НаименованиеПоказателя = СтрокаТаблицыПоказатели.НаименованиеПоказателя;
				КонецЕсли;	
			КонецЦикла;							
		Иначе
			СтрокаДерева.Протокол = СтрокаДерева.Фаза;
		КонецЕсли;
		
		Если НЕ СтрокаКУдалению Тогда
			ОбработатьДеревоПротоколыРекурсивно(СтрокаДерева.Строки, Показатели, ЗначенияПоказателейВех);		
		КонецЕсли;	
				
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		СтрокиДерева.Удалить(СтрокаКУдалению);	
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
		
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("СправочникСсылка.Проекты") Тогда
		Возврат;
	КонецЕсли;	
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Заполнить(ВыбранноеЗначение);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ЗаполнитьПротоколыНаСервере();
	
	ОбновитьКартинкуПроекта();
	
	ОбновитьНадписьПроект();
	
	ЭтаФорма.Модифицированность = Истина;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьНадписьПроект()
	
	упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "Проект");
	Элементы.НаименованиеПроекта.Видимость = НЕ ЗначениеЗаполнено(Объект.Проект);
	Элементы.НаименованиеПроекта.АвтоОтметкаНезаполненного = НЕ ЗначениеЗаполнено(Объект.Проект);
		
КонецПроцедуры	

&НаСервере
Процедура ИнициализацияФормы()
	
	ОбновитьНадписьПроект();
	
	Если ЗначениеЗаполнено(Объект.Проект) Тогда
		ЗаполнитьПротоколыНаСервере();								
	КонецЕсли;
	
	ОбновитьКартинкуПроекта();		
	
КонецПроцедуры

#КонецОбласти
