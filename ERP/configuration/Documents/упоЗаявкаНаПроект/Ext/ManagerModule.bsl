// Возвращает данные для проведения документа.
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//
// Возвращаемое значение:
//   Структура: 
//   	* Ключ - Строка - имя регистра.
//   	* Значение - ТаблицаЗначений - данные для проведения документа.
//
Функция ДанныеПроведения(ДокументСсылка) Экспорт
			
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);		
			
	Запрос.Текст = ТекстПроведение();
		
	//Результат = Запрос.ВыполнитьПакет();
	Результат = Запрос.Выполнить();
	
	//КоличествоЗапросов = Результат.ВГраница();
	
	ДанныеПроведения = Новый Структура;
	ДанныеПроведения.Вставить("упоСтатусыЗаявокНаПроект", Результат.Выгрузить());
		
	Возврат ДанныеПроведения;
		
КонецФункции

#КонецОбласти

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Проект, ПустаяСсылка КАК Истина)";

КонецПроцедуры

