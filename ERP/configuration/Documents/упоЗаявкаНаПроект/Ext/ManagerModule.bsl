#Область СлужебныеПроцедурыИФункции

#Область Проведение

Функция ТекстПроведение()
			
	ТекстЗапроса = "ВЫБРАТЬ
	               |	упоЗаявкаНаПроект.Ссылка КАК Регистратор,
	               |	упоЗаявкаНаПроект.Дата КАК Период,
	               |	упоЗаявкаНаПроект.Ссылка КАК ЗаявкаНаПроект,
	               |	упоЗаявкаНаПроект.Статус КАК Статус
	               |ИЗ
	               |	Документ.упоЗаявкаНаПроект КАК упоЗаявкаНаПроект
	               |ГДЕ
	               |	упоЗаявкаНаПроект.Ссылка = &Ссылка";
	
	Возврат ТекстЗапроса;
	
КонецФункции

