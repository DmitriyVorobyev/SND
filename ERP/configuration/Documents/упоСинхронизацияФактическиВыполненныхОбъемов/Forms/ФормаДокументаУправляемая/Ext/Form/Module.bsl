Процедура РасходныеОбъемыСтоимостьПриИзменении(Элемент)
	
	КоличествоСуммаПриИзменении(Элементы.РасходныеОбъемы.ТекущиеДанные, "Стоимость");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте	
Процедура КоличествоСуммаПриИзменении(ТекущаяСтрокаРегистрацииФакта, ИзменяемаяКолонка)
	
	Если ТекущаяСтрокаРегистрацииФакта <> Неопределено 
		И ТекущаяСтрокаРегистрацииФакта.Стоимость > 0 Тогда
		
		Если ИзменяемаяКолонка = "Количество" Или ИзменяемаяКолонка = "Стоимость" Тогда
			
			  ТекущаяСтрокаРегистрацииФакта.Сумма = ТекущаяСтрокаРегистрацииФакта.Количество * ТекущаяСтрокаРегистрацииФакта.Стоимость;
			
		ИначеЕсли ИзменяемаяКолонка = "Сумма" Тогда
			
			 ТекущаяСтрокаРегистрацииФакта.Количество = ТекущаяСтрокаРегистрацииФакта.Сумма/ТекущаяСтрокаРегистрацииФакта.Стоимость;			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ЗаполнитьСтоимостьНоменклатуры(ПроектнаяЗадача, Номенклатура)
	 
	 ЗапросСтоимости = Новый Запрос;
	 ЗапросСтоимости.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                         |	упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Цена КАК Цена,
	                         |	упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Номенклатура КАК Номенклатура
	                         |ИЗ
	                         |	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
	                         |			,
	                         |			ПроектнаяЗадача = &ПроектнаяЗадача
	                         |				И Номенклатура = &Номенклатура) КАК упоДанныеПлановВыпускаСубпродуктовСрезПоследних
	                         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	                         |		ПО (упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Версия = упоВерсииПроекта.Версия
	                         |				И упоВерсииПроекта.Текущая)
	                         |ГДЕ
	                         |	(упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Количество <> 0
	                         |			ИЛИ упоДанныеПлановВыпускаСубпродуктовСрезПоследних.Сумма <> 0
	                         |			ИЛИ упоДанныеПлановВыпускаСубпродуктовСрезПоследних.СуммаВалютная <> 0)";	 
	 ЗапросСтоимости.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	 ЗапросСтоимости.УстановитьПараметр("Номенклатура", Номенклатура);
	 Результат = ЗапросСтоимости.Выполнить();
	 
	 Если Результат.Пустой() = Ложь Тогда
		 
		 Выборка = Результат.Выбрать();
		 Выборка.Следующий();
		 
		 Возврат Выборка.Цена;
		 
	 Иначе
		 
		 Возврат 0;
		 
	 КонецЕсли;	

КонецФункции

