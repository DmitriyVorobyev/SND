// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	ПравилаНаложения = Новый Структура();
	
	// Для каждого из регистров описывается, по какой из таблиц документа
	// строится список движений, и какие реквизиты куда записать
	// Если требуется добавлять в запись реквизиты шапки, отмечаем их
	// префиксом "Шапка_". 
	
	// Правила для регистра "СоставПодразделений"
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСоставПодразделений.Метаданные().Имя, Правила);
	
	// Правила для табличной части "СоставРолей" документа
	ПравилаТаблицы = Новый Структура();	
	Правила.Вставить("СоставРолей", ПравилаТаблицы);
	
	// Делаем первое движение по ТЧ для подразделения-источник
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("СмещениеСоставаРолейПодразделения", ПравилаДвижения);
	
	// Правила связи реквизитов
	ПравилаДвижения.Вставить("Подразделение", "Шапка_ПодразделениеИсточник");
	ПравилаДвижения.Вставить("Роль"         , "Роль");
	ПравилаДвижения.Вставить("ВходитВСостав", Новый Структура("Значение", Ложь));
	
	// Делаем второе движение по ТЧ для подразделения-приемник, если оно заполнено
	Если Не ДанныеДокумента.ПодразделениеПриемник.Пустая() Тогда
		ПравилаДвижения = Новый Структура();
		ПравилаТаблицы.Вставить("ПеремещениеСоставаРолейПодразделения", ПравилаДвижения);
		
		// Правила связи реквизитов
		ПравилаДвижения.Вставить("Подразделение", "Шапка_ПодразделениеПриемник");
		ПравилаДвижения.Вставить("Роль"         , "Роль");
		ПравилаДвижения.Вставить("ВходитВСостав", Новый Структура("Значение", Истина));
	КонецЕсли;
	
	Возврат ПравилаНаложения; 

КонецФункции // ПолучитьПравилаНаложенияРеквизитовНаРегистр()
 
