// 
// Параметры: 
//  ДанныеДокумента - Тип: Структура, содержит список таблиц (ключи структуры),
//                    состоящий из шапки и всех табличных частей документа.
//                    Является полным слепком документа.
//  Условие         - Тип: Произвольный, содержит некое условие.
// 
// Возвращаемое значение: 
//  Тип: ТаблицаЗначений, сформированная таблица данных.
// 
Функция СформироватьТаблицуДанных(ДанныеДокумента, Подразделение)
	
	// Определим момент времени запроса
	МоментВремениЗапроса = упоРабочиеКалендариВызовСервера.обПолучитьМоментВремениДокумента(ЭтотОбъект);
	
	// Формируем запрос
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"         , МоментВремениЗапроса);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.Роль
		|ИЗ
		|	РегистрСведений.упоСоставПодразделений.СрезПоследних(&Дата, Подразделение = &Подразделение) КАК Рег
		|ГДЕ
		|	Рег.ВходитВСостав = ИСТИНА";
	
	// Запускаем запрос
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.';
                        |en = 'Invalid object call on the client.'");
#КонецЕсли
