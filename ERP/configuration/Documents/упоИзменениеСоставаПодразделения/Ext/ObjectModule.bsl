// Функция формирует структуру обязательных реквизитов шапки или заданной табличной части объекта.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	Если ИмяТабличнойЧасти = Неопределено Тогда
		// Формирование структуры обязательных реквизитов шапки.
		СтруктураОбязательныхПолей.Вставить("ПодразделениеИсточник");
	ИначеЕсли ИмяТабличнойЧасти = "СоставРолей" Тогда
		// Формирование структуры обязательных реквизитов табличной части СоставРолей.
		СтруктураОбязательныхПолей.Вставить("Роль");
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет все необходимые данные документа для его записи в ИБ.
// 
// Параметры:
//  Отказ - Булево - Признак отказа от выполнения операции.
// 
Процедура ПроверитьДанныеПередЗаписью(Отказ) Экспорт
	
	// Получим заголовок для сообщения об ошибках при записи объекта.
	Заголовок = обСформироватьЗаголовокОшибкиПриЗаписи(ЭтотОбъект);
	
	// Проверяем заполненность обязательных реквизитов.
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет все необходимые данные документа для его проведения.
// 
// Параметры:
//  ДанныеДокумента - Структура - содержит слепок документа.
//  Отказ           - Булево - Признак отказа от выполнения операции.
//  Заголовок       - Строка - Содержит заголовок сообщения.
// 
Процедура ПроверитьДанные(ДанныеДокумента, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРолейПодразделенияИсточник = СформироватьТаблицуДанных(ДанныеДокумента, ДанныеДокумента.ПодразделениеИсточник);
	ТаблицаРолейПодразделенияПриемник = СформироватьТаблицуДанных(ДанныеДокумента, ДанныеДокумента.ПодразделениеПриемник);
	
	Для Каждого ТекСтрока Из ДанныеДокумента.СоставРолей Цикл
		НайденнаяСтрока = ТаблицаРолейПодразделенияИсточник.Найти(ТекСтрока.Роль, "Роль");
		Если НайденнаяСтрока = Неопределено Тогда
			ПредставлениеТабличнойЧасти = ЭтотОбъект.Метаданные().ТабличныеЧасти.СоставРолей.Представление();
			ЗаголовокСтрокиСообщения = упоСервисныеФункцииВызовСервера.обСформироватьЗаголовокОшибкиВСтрокеТЧ(ПредставлениеТабличнойЧасти, ТекСтрока.НомерСтроки);
			СтрокаСообщения = ЗаголовокСтрокиСообщения +
							"Нельзя сместить роль """ + СокрЛП(ТекСтрока.Роль) + """." 
							+ " Эта роль не входит в состав подразделения """ + СокрЛП(ДанныеДокумента.ПодразделениеИсточник) + """!";
			обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
		КонецЕсли;
		
		Если Не ДанныеДокумента.ПодразделениеПриемник.Пустая() Тогда
			НайденнаяСтрока = ТаблицаРолейПодразделенияПриемник.Найти(ТекСтрока.Роль, "Роль");
			Если НайденнаяСтрока <> Неопределено Тогда
				ПредставлениеТабличнойЧасти = ЭтотОбъект.Метаданные().ТабличныеЧасти.СоставРолей.Представление();
				ЗаголовокСтрокиСообщения = упоСервисныеФункцииВызовСервера.обСформироватьЗаголовокОшибкиВСтрокеТЧ(ПредставлениеТабличнойЧасти, ТекСтрока.НомерСтроки);
				СтрокаСообщения = ЗаголовокСтрокиСообщения +
								"Нельзя переместить роль """ + СокрЛП(ТекСтрока.Роль)
								+ """ в подразделение """ + СокрЛП(ДанныеДокумента.ПодразделениеПриемник)
								+ """. Эта роль уже входит в его состав!";
				обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура проверяет заполнение обязательных реквизитов объекта.
// Если хотя бы один реквизит не заполнен, то выставляется флаг отказа от выполнения операции.
// 
// Параметры:
//   Отказ        - Тип: Булево. Признак отказа от выполнения операции.
//   Заголовок    - Тип: Строка. Содержит заголовок сообщения.
// 
Процедура лмПроверитьЗаполнениеРеквизитов(Отказ, Заголовок) Экспорт
	
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ, Заголовок);
	
КонецПроцедуры

// Функция формирует структуру обязательных реквизитов шапки для заданной табличной части документа.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизитыДляВыполненияОперацииЗаполнить(ИмяТабличнойЧасти) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	// Заполнение структуры обязательных полей шапки.
	СтруктураОбязательныхПолей.Вставить("ПодразделениеИсточник");
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Функция формирует нужную таблицу значений для загрузки в табличную часть.
// 
// Параметры:
//  ИмяТабличнойЧасти - Строка - Имя табличной части.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Готовая таблица значений.
// 
Функция СформироватьТаблицуДанныхДляОперацииЗаполнить(ИмяТабличнойЧасти) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеИсточник);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.Роль
		|ИЗ
		|	РегистрСведений.упоСоставПодразделений.СрезПоследних(, Подразделение = &Подразделение) КАК Рег
		|ГДЕ
		|	Рег.ВходитВСостав = ИСТИНА
		|УПОРЯДОЧИТЬ ПО 
		|	Рег.Роль";
		
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

