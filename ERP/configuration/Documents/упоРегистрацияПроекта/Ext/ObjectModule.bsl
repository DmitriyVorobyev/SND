//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
		
КонецПроцедуры

// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	ПравилаНаложения = Новый Структура();
	
	// Для каждого из регистров описывается, по какой из таблиц документа
	// строится список движений, и какие реквизиты куда записать
	// Если требуется добавлять в запись реквизиты шапки, отмечаем их
	// префиксом "Шапка_". 
	
	// Правила для регистра "СтатусыПроектов"
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоСтатусыПроектов.Метаданные().Имя, Правила);
	
	ПравилаТаблицы = Новый Структура();	
	Правила.Вставить("ШапкаДокумента", ПравилаТаблицы);
	
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ФиксацияСтатуса", ПравилаДвижения);
	
	ПравилаДвижения.Вставить("Проект", "Проект");
	
	// Правила для регистра "РуководителиПроектов"
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоРуководителиПроектов.Метаданные().Имя, Правила);
	
	ПравилаТаблицы = Новый Структура();	
	Правила.Вставить("ШапкаДокумента", ПравилаТаблицы);
	
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("НазначениеРуководителя", ПравилаДвижения);
	
	ПравилаДвижения.Вставить("Проект"             , "Проект");
	ПравилаДвижения.Вставить("РуководительПроекта", "РуководительПроекта");
	ПравилаДвижения.Вставить("КураторПроекта", "КураторПроекта");
	
	// Правила для регистра "КалендариПроектов"
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоКалендариПроектов.Метаданные().Имя, Правила);
	
	// Правила для шапки документа
	ПравилаТаблицы = Новый Структура();	
	Правила.Вставить("ШапкаДокумента", ПравилаТаблицы);
	
	// Делаем одно движение по шапке
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ОпределениеПараметровПроекта", ПравилаДвижения);
	
	// Правила связи
	ПравилаДвижения.Вставить("Проект" , "Проект");
	ПравилаДвижения.Вставить("КалендарьПроекта" , "КалендарьПроекта");
	ПравилаДвижения.Вставить("КалендарьБанковскихДней" , "КалендарьБанковскихДней");
	ПравилаДвижения.Вставить("МетодОперативногоПланирования", "МетодОперативногоПланирования");
	ПравилаДвижения.Вставить("ПолучатьТрудозатратыПоОтчетамИсполнителей", "ПолучатьТрудозатратыПоОтчетамИсполнителей");
	
	Возврат ПравилаНаложения; 

КонецФункции // ПолучитьПравилаНаложенияРеквизитовНаРегистр()
 
// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт
	
	// Бизнес-логика дополнительной обработки данных движений по регистрам
	ТаблицаДвижений = ДанныеДвижений.упоСтатусыПроектов;
	ТаблицаДвижений.ЗаполнитьЗначения(Перечисления.упоСостояниеСтатусаПроекта.Запланирован, "СтатусПроекта");
	
КонецПроцедуры // ПодготовитьДанныеДвижений()
 
// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный - значение, которое используется как основание для заполнения.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если ТипЗнч(Основание) = Тип("Неопределено") Тогда 
		Проект = ПараметрыСеанса.упоТекущийПроект;
		Возврат;
	ИначеЕсли ТипЗнч(Основание) = Тип("Структура") Тогда
		Основание.Свойство("Проект", Проект);
	Иначе
		Проект = Основание;
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
	упоПроектыИЗадачиСервер.ПроверитьТипПроекта(Проект);
	
	КалендарьПроекта = Константы.упоРабочийКалендарьПоУмолчанию.Получить();
	КалендарьБанковскихДней = КалендарьПроекта;
	МетодОперативногоПланирования = Константы.упоМетодОперативногоПланированияПоУмолчанию.Получить();
	ПолучатьТрудозатратыПоОтчетамИсполнителей = Истина;
	РуководительПроекта = ПараметрыСеанса.упоТекущийСотрудник;
	КураторПроекта = РуководительПроекта;

КонецПроцедуры // ОбработкаЗаполнения()

