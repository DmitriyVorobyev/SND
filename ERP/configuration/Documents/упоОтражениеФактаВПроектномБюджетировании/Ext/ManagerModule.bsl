	               |	СУММА(втДоходыРасходы.СуммаВалютная) КАК СуммаВалютная
	               |ИЗ
	               |	втДоходыРасходы КАК втДоходыРасходы
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втДоходыРасходы.ПроектнаяЗадача,
	               |	втДоходыРасходы.Статья,
	               |	втДоходыРасходы.ВидЭлемента,
	               |	втДоходыРасходы.Контрагент,
	               |	втДоходыРасходы.Договор,
	               |	втДоходыРасходы.Валюта,
	               |	втДоходыРасходы.Период,
	               |	втДоходыРасходы.Регистратор,
	               |	втДоходыРасходы.ПравилоОтражения,
	               |	втДоходыРасходы.ДокументОснование,
	               |	втДоходыРасходы.Период
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втДанныеШапки.Регистратор,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Период,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.ПроектнаяЗадача,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.СтатьяДДС,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.НаправлениеДвижения,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Контрагент,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Договор,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.ДатаДвижения,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Валюта,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.ПравилоОтражения,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Регистратор КАК ДокументОснование,
	               |	СУММА(упоОтражениеФактаВПроектномБюджетированииДДС.Сумма) КАК Сумма,
	               |	СУММА(упоОтражениеФактаВПроектномБюджетированииДДС.СуммаВалютная) КАК СуммаВалютная
	               |ИЗ
	               |	втДанныеШапки КАК втДанныеШапки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.упоОтражениеФактаВПроектномБюджетировании.ДДС КАК упоОтражениеФактаВПроектномБюджетированииДДС
	               |		ПО втДанныеШапки.Регистратор = упоОтражениеФактаВПроектномБюджетированииДДС.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.ПроектнаяЗадача,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.СтатьяДДС,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.НаправлениеДвижения,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Контрагент,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Договор,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.ДатаДвижения,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Валюта,
	               |	втДанныеШапки.Регистратор,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Период,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.ПравилоОтражения,
	               |	упоОтражениеФактаВПроектномБюджетированииДДС.Регистратор";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстПроведениеEPM()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	втДанныеШапки.Регистратор,
	               |	втДанныеШапки.Дата КАК Период,
	               |	втДанныеШапки.Дата КАК ДатаОтражения,
	               |	ЕСТЬNULL(Проекты.Организация, ЗНАЧЕНИЕ(Справочник.Организации.УправленческаяОрганизация)) КАК Организация,
	               |	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.упоФактПроектногоБюджетирования) КАК ХозяйственнаяОперация
	               |ПОМЕСТИТЬ втОтражение
	               |ИЗ
	               |	втДанныеШапки КАК втДанныеШапки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втДоходыРасходы КАК втДоходыРасходы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоПроектнаяЗадача КАК упоПроектнаяЗадача
	               |				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	               |				ПО упоПроектнаяЗадача.Проект = Проекты.Ссылка
	               |			ПО втДоходыРасходы.ПроектнаяЗадача = упоПроектнаяЗадача.Ссылка
	               |		ПО втДанныеШапки.Регистратор = втДоходыРасходы.Регистратор
	               |ГДЕ
	               |	&ИспользоватьМеждународныйФинансовыйУчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	втОтражение.Период КАК Период,
	               |	втОтражение.Организация КАК Организация,
	               |	втОтражение.ДатаОтражения КАК ДатаОтражения,
	               |	втОтражение.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	               |	втОтражение.Регистратор
	               |ПОМЕСТИТЬ ТаблицаДанные
	               |ИЗ
	               |	втОтражение КАК втОтражение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаДанные.Период КАК Период,
	               |	ТаблицаДанные.Организация,
	               |	ТаблицаДанные.ДатаОтражения КАК ДатаОтражения,
	               |	ТаблицаДанные.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	               |	МАКСИМУМ(УчетнаяПолитикаМФУ.Период) КАК Месяц,
	               |	ТаблицаДанные.Регистратор
	               |ПОМЕСТИТЬ ПериодыУчетнойПолитики
	               |ИЗ
	               |	ТаблицаДанные КАК ТаблицаДанные
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизацийДляМеждународногоУчета КАК УчетнаяПолитикаМФУ
	               |		ПО ТаблицаДанные.Организация = УчетнаяПолитикаМФУ.Организация
	               |			И ТаблицаДанные.ДатаОтражения >= УчетнаяПолитикаМФУ.Период
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаДанные.Период,
	               |	ТаблицаДанные.Организация,
	               |	ТаблицаДанные.ДатаОтражения,
	               |	ТаблицаДанные.ХозяйственнаяОперация,
	               |	ТаблицаДанные.Регистратор
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПериодыУчетнойПолитики.Период КАК Период,
	               |	ПериодыУчетнойПолитики.Организация КАК Организация,
	               |	ПериодыУчетнойПолитики.ДатаОтражения КАК ДатаОтражения,
	               |	ПериодыУчетнойПолитики.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	               |	УчетнаяПолитикаМФУ.УчетнаяПолитика КАК УчетнаяПолитика,
	               |	ПериодыУчетнойПолитики.Регистратор
	               |ПОМЕСТИТЬ ИсходнаяТаблица
	               |ИЗ
	               |	ПериодыУчетнойПолитики КАК ПериодыУчетнойПолитики
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизацийДляМеждународногоУчета КАК УчетнаяПолитикаМФУ
	               |		ПО ПериодыУчетнойПолитики.Организация = УчетнаяПолитикаМФУ.Организация
	               |			И ПериодыУчетнойПолитики.Месяц = УчетнаяПолитикаМФУ.Период
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	               |	ПравилаОтражения.УчетнаяПолитика КАК УчетнаяПолитика,
	               |	МАКСИМУМ(ШаблоныПроводок.РучноеУточнениеПроводки) КАК РучноеУточнениеПроводки
	               |ПОМЕСТИТЬ ПравилаОтражения
	               |ИЗ
	               |	Справочник.ШаблоныПроводокДляМеждународногоУчета КАК ШаблоныПроводок
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НастройкиХозяйственныхОпераций КАК НастройкиХозяйственныхОпераций
	               |		ПО ШаблоныПроводок.Операция = НастройкиХозяйственныхОпераций.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПравилаОтраженияВМеждународномУчете КАК ПравилаОтражения
	               |		ПО ШаблоныПроводок.Ссылка = ПравилаОтражения.ШаблонПроводки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	НастройкиХозяйственныхОпераций.ХозяйственнаяОперация,
	               |	ПравилаОтражения.УчетнаяПолитика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаКОтражению.Период КАК Период,
	               |	ТаблицаКОтражению.Организация КАК Организация,
	               |	ТаблицаКОтражению.ДатаОтражения КАК ДатаОтражения,
	               |	ТаблицаКОтражению.УчетнаяПолитика КАК УчетнаяПолитика,
	               |	ВЫБОР
	               |		КОГДА ТаблицаКОтражению.Статус = 1
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтатусыОтраженияВМеждународномУчете.КОтражениюВУчетеВручную)
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтатусыОтраженияВМеждународномУчете.КОтражениюВУчете)
	               |	КОНЕЦ КАК Статус,
	               |	ТаблицаКОтражению.Регистратор
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ИсходнаяТаблица.Период КАК Период,
	               |		ИсходнаяТаблица.Организация КАК Организация,
	               |		ИсходнаяТаблица.ДатаОтражения КАК ДатаОтражения,
	               |		ИсходнаяТаблица.УчетнаяПолитика КАК УчетнаяПолитика,
	               |		МИНИМУМ(ВЫБОР
	               |				КОГДА ОтражениеДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтраженияВМеждународномУчете.ОтраженоВУчетеВручную)
	               |						ИЛИ ОтражениеДокументов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОтраженияВМеждународномУчете.КОтражениюВУчетеВручную)
	               |						ИЛИ ПравилаОтражения.РучноеУточнениеПроводки
	               |					ТОГДА 1
	               |				ИНАЧЕ 2
	               |			КОНЕЦ) КАК Статус,
	               |		ИсходнаяТаблица.Регистратор КАК Регистратор
	               |	ИЗ
	               |		ИсходнаяТаблица КАК ИсходнаяТаблица
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ПравилаОтражения КАК ПравилаОтражения
	               |			ПО ИсходнаяТаблица.УчетнаяПолитика = ПравилаОтражения.УчетнаяПолитика
	               |				И ИсходнаяТаблица.ХозяйственнаяОперация = ПравилаОтражения.ХозяйственнаяОперация
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтражениеДокументовВМеждународномУчете КАК ОтражениеДокументов
	               |			ПО ИсходнаяТаблица.Организация = ОтражениеДокументов.Организация
	               |				И (ОтражениеДокументов.Регистратор = &Ссылка)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ИсходнаяТаблица.Период,
	               |		ИсходнаяТаблица.Организация,
	               |		ИсходнаяТаблица.ДатаОтражения,
	               |		ИсходнаяТаблица.УчетнаяПолитика,
	               |		ИсходнаяТаблица.Регистратор) КАК ТаблицаКОтражению";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

Функция ПараметрыЗаполненияДокументаОтражение(ДокументОснование, ДокументОтражение, ИдентификаторОчереди = Неопределено)
	
	Параметры = Новый Структура;	
	
	Если Не ЗначениеЗаполнено(ДокументОтражение) Тогда
		ДокументОтражение = ДокументОтражениеПоДокументуОснованию(ДокументОснование);
	КонецЕсли;			
	
	ЗначенияЗаполнения = Новый Структура("РучнаяКорректировка, ДокументОснование", Ложь, ДокументОснование);
	
	Если ЗначениеЗаполнено(ДокументОтражение) Тогда		    								
		Параметры.Вставить("Ключ", ДокументОтражение);
		Если НЕ ЗначениеЗаполнено(ДокументОтражение.Дата) Тогда
			ЗначенияЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());	
		КонецЕсли;	
	Иначе
		ЗначенияЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
	КонецЕсли;
								
	ЗначенияЗаполнения.Вставить("ИдентификаторОчереди", ИдентификаторОчереди);			
	ЗначенияЗаполнения.Вставить("ЗаполнитьПоПравилу");			
		
	Параметры.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
			
	Возврат Параметры;
	
КонецФункции

Функция ПравилаОтраженияПоДокументуОтражения(ДокументОтражение)
	
	ПравилаОтражения = Новый Массив;
	
	Если ЗначениеЗаполнено(ДокументОтражение.ДокументОснование) Тогда						
		ПравилаОтражения = ПравилаОтраженияПоДокументуОснованию(ДокументОтражение);						
	Иначе				
		Для Каждого СтрокаПравилоОтражения Из ДокументОтражение.ПравилаОтражения Цикл			
			Если ПравилаОтражения.Найти(СтрокаПравилоОтражения.ПравилоОтражения) = Неопределено Тогда
				ПравилаОтражения.Добавить(СтрокаПравилоОтражения.ПравилоОтражения);
			КонецЕсли;	
		КонецЦикла;			
	КонецЕсли;	
	
	Возврат ПравилаОтражения;
	
КонецФункции	

Функция ПараметрыВыполненияПравила(ДокументОбъект)
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("Период");
	Параметры.Вставить("НачалоПериода", Дата(1,1,1));
	Параметры.Вставить("КонецПериода", Дата(1,1,1));	
	Параметры.Вставить("ОтборПоРегистраторам");
	
	Параметры.Вставить("ПоРегистратору", Истина);
	
	Если ЗначениеЗаполнено(ДокументОбъект.НачалоПериода) Тогда
		Параметры.Вставить("НачалоПериода", ДокументОбъект.НачалоПериода);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.ОкончаниеПериода) Тогда
		Параметры.Вставить("КонецПериода", КонецДня(ДокументОбъект.ОкончаниеПериода));						
	КонецЕсли;	
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда									
		Параметры.Вставить("ОтборПоРегистраторам", ДокументОбъект.ДокументОснование);
	КонецЕсли;
			
	Возврат Параметры;
	
КонецФункции

Функция ПравилаОжиданияОтраженияВРеглУчете(ПравилаОтражения, ДокументОбъект)
	
	ПравилаОжиданияОтражения = Новый Массив;
		
	СтатусыОтражения = Новый Массив;
	СтатусыОтражения.Добавить(упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
		"Перечисление.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВРеглУчете"));
	СтатусыОтражения.Добавить(упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
		"Перечисление.СтатусыОтраженияДокументовВРеглУчете.ОтраженоВУчетеВручную"));
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОтражениеДокументовВРеглУчете.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ОтражениеРегл
	|ИЗ
	|	РегистрСведений.ОтражениеДокументовВРеглУчете КАК ОтражениеДокументовВРеглУчете
	|ГДЕ
	|	НЕ ОтражениеДокументовВРеглУчете.Статус В (&СтатусыОтражения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоПравилаПолученияФактаДляПроектногоБюджетирования.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Правила
	|ИЗ
	|	Справочник.упоПравилаПолученияФактаДляПроектногоБюджетирования КАК упоПравилаПолученияФактаДляПроектногоБюджетирования
	|ГДЕ
	|	упоПравилаПолученияФактаДляПроектногоБюджетирования.ОжидатьОтраженияВРеглУчете
	|	И упоПравилаПолученияФактаДляПроектногоБюджетирования.Ссылка В(&ПравилаОтражения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Правило
	|ИЗ
	|	Правила КАК Правила
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтражениеРегл КАК ОтражениеРегл
	|		ПО (ИСТИНА)";
	
	СхемаЗапроса  = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);		
			
	УсловияОтбора = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
	
	Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
		УсловияОтбора.Добавить("ОтражениеДокументовВРеглУчете.Регистратор = &Регистратор");
	Иначе
		Если ЗначениеЗаполнено(ДокументОбъект.НачалоПериода) Тогда
			УсловияОтбора.Добавить("ОтражениеДокументовВРеглУчете.ДатаОтражения >= &НачалоПериода");
		КонецЕсли;	
		Если ЗначениеЗаполнено(ДокументОбъект.ОкончаниеПериода) Тогда
			УсловияОтбора.Добавить("ОтражениеДокументовВРеглУчете.ДатаОтражения <= КонецПериода(&ОкончаниеПериода, ДЕНЬ)");	
		КонецЕсли;		
	КонецЕсли;	
	
	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПравилаОтражения", ПравилаОтражения);
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.ДокументОснование);
	Запрос.УстановитьПараметр("НачалоПериода", ДокументОбъект.НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ДокументОбъект.ОкончаниеПериода);
	Запрос.УстановитьПараметр("СтатусыОтражения", СтатусыОтражения);
	
	Результат = Запрос.Выполнить();
    	
	Если НЕ Результат.Пустой() Тогда
		ПравилаОжиданияОтражения = Результат.Выгрузить().ВыгрузитьКолонку("Правило");
	КонецЕсли;
	
	Возврат ПравилаОжиданияОтражения;
			
КонецФункции	

// Компонует сводный текст ошибок, добавленных с помощью процедуры ДобавитьОшибкуПользователю().
//
// Параметры:
//  Ошибки  - Неопределено - возврат,
//            значение, установленное при использовании процедуры ДобавитьОшибкуПользователю().
//
Функция СводныйТекстОшибокПользователя(Ошибки)
			
	СтрокиОшибок = Новый Массив;
	
	Если Ошибки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого Ошибка Из Ошибки.СписокОшибок Цикл
		
		Если Ошибка.ИндексСтроки = Неопределено Тогда
			ИндексСтроки = Ошибка.НомерСтроки;
		Иначе
			ИндексСтроки = Ошибка.ИндексСтроки;
		КонецЕсли;
		
		Если Ошибки.ГруппыОшибок[Ошибка.ГруппаОшибок] <> Истина Тогда			
			СтрокиОшибок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Ошибка.ТекстДляОднойОшибки, 
				Формат(ИндексСтроки, "ЧН=0; ЧГ=")));
		Иначе			
			СтрокиОшибок.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Ошибка.ТекстДляНесколькихОшибок, 
				Формат(Ошибка.НомерСтроки + 1, "ЧН=0; ЧГ=")));						
		КонецЕсли;
					
	КонецЦикла;
	
	СводныйТекст = СтрСоединить(СтрокиОшибок, Символы.ПС);
	
	Возврат СводныйТекст;
	
КонецФункции

Процедура ДобавитьОшибку(ОшибкиЗаполнения, Правило = Неопределено, Комментарий)
	
	НоваяОшибка = ОшибкиЗаполнения.Добавить();
	Если ЗначениеЗаполнено(Правило) Тогда
		НоваяОшибка.Правило = Правило;
	КонецЕсли;	
	НоваяОшибка.Комментарий = Комментарий;
	
КонецПроцедуры

Функция ОтражатьПоМФУ_ERP_2_4()	
	
	ОтражатьПоМФУ_ERP_2_4 = Ложь;
	
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
	Если ЭтоEPM Тогда
		ЭтоEPM_2_5 = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM_2_5(ЭтоEPM);
		ОтражатьПоМФУ_ERP_2_4 = Не ЭтоEPM_2_5;
	КонецЕсли;	
	
	Возврат ОтражатьПоМФУ_ERP_2_4;
	
КонецФункции

