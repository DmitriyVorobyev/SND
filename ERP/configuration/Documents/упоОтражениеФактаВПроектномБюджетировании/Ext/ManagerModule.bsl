
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

#Область Заполнение

// Выполняет заполнение документа отражения по правилам отражения.
//
// Параметры:
//  ДокументОбъект  - ДокументОбъект.упоОтражениеФактаВПроектномБюджетировании - документ отражение для заполнения.
//  ИдентификаторЗаписи  - УникальныйИдентификатор - Идентификатор обработки очереди документов к отражению.
// 						Заполняется при вызове процедуры из процедуры обработки очереди сообщений к отражению.
//						Используется для фильтрации очереди сообщений.
//
Процедура ЗаполнитьДокументОтражениеПоПравилуОтражения(ДокументОбъект, ИдентификаторЗаписи = Неопределено) Экспорт
	
	ДокументОбъект.РучнаяКорректировка = Ложь;
	ДокументОбъект.СтатусЗаполнения = Неопределено;	
	ДокументОбъект.ДоходыРасходы.Очистить();
	ДокументОбъект.ДДС.Очистить();
	тчОшибкиЗаполнения = ДокументОбъект.ОшибкиЗаполнения;
	тчОшибкиЗаполнения.Очистить();
			
	ПравилаОтражения = ПравилаОтраженияПоДокументуОтражения(ДокументОбъект);
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		
		ПравилаОжиданияОтражения = ПравилаОжиданияОтраженияВРеглУчете(ПравилаОтражения, ДокументОбъект);
		
		Если ПравилаОжиданияОтражения.Количество() > 0 Тогда		
			ДокументОбъект.СтатусЗаполнения = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОжиданиеОтраженияВРеглУчете;								
			Для Каждого ПравилоОжидания Из ПравилаОжиданияОтражения Цикл			
				ДобавитьОшибку(тчОшибкиЗаполнения, ПравилоОжидания, ДокументОбъект.СтатусЗаполнения);				
			КонецЦикла;	
		КонецЕсли;			
		
	КонецЕсли;
	
	// Заполнение документа.	
	ПараметрыВыполнения = ПараметрыВыполненияПравила(ДокументОбъект);						
	Для Каждого ПравилоОтражения Из ПравилаОтражения Цикл
		
		ОшибкиПользователю = Неопределено;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ВыполняетсяПравило", ПравилоОтражения);
		
		РезультатВыполненияПравила = упоПроектноеБюджетированиеСервер.ФактБюджетированияПоПравилу(ПравилоОтражения, ПараметрыВыполнения, ДокументОбъект.СтатусЗаполнения, ОшибкиПользователю);	
		
		Если ОшибкиПользователю <> Неопределено Тогда
			ДобавитьОшибку(тчОшибкиЗаполнения, ПравилоОтражения, СводныйТекстОшибокПользователя(ОшибкиПользователю));
			ДокументОбъект.СтатусЗаполнения = 
				Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОшибкаОтражения;
		КонецЕсли;
		
		Для Каждого РезультатРаздела Из РезультатВыполненияПравила Цикл
			
			ИмяТабЧасти = упоПроектноеБюджетированиеСервер.ИмяПеречисленияПоЗначению(РезультатРаздела.Ключ);
			ТабличнаяЧасть = ДокументОбъект[ИмяТабЧасти];							
			Для Каждого СтрокаРезультат Из РезультатРаздела.Значение Цикл
				НоваяСтрока = ТабличнаяЧасть.Добавить();						
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРезультат);
				НоваяСтрока.ПравилоОтражения = ПравилоОтражения;
			КонецЦикла;
			
		КонецЦикла;	
		
	КонецЦикла;	
	
	// Обработка ошибок заполнения.
	Если ЗначениеЗаполнено(ДокументОбъект.СтатусЗаполнения) Тогда 		
		Если ДокументОбъект.СтатусЗаполнения = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОтсутствуютПравилаОтражения Тогда			
			ДобавитьОшибку(тчОшибкиЗаполнения, ПравилоОтражения, СводныйТекстОшибокПользователя(ОшибкиПользователю));			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда			
			упоПроектноеБюджетированиеСервер.ИзменитьСтатусПервичногоДокументаВОчередиКОтражению(ДокументОбъект.ДокументОснование, ДокументОбъект.СтатусЗаполнения, ИдентификаторЗаписи);											
			упоПроектноеБюджетированиеСервер.ОбновитьОшибкиОтраженияДокумента(ДокументОбъект.ДокументОснование, тчОшибкиЗаполнения);
		КонецЕсли;			
	КонецЕсли;	
				
КонецПроцедуры	

// Вызывает функцию СоздатьЗаполнитьДокументОтражение() для фонового выполнения.
//
// Параметры:
//  ПараметрыВыполнения  - Структура, Неопределено - параметры отражения первичного документа.
//  АдресРезультата  - Строка - Адрес временного хранилища для помещения результата.
//
Процедура СоздатьЗаполнитьДокументОтражениеВФоне(ПараметрыВыполнения = Неопределено, АдресРезультата = Неопределено) Экспорт
		
	ДокументОтражение = Неопределено;
	ДокументОснование = Неопределено;
	ЗаписьБезПроведения = Неопределено;	
	ПараметрыВыполнения.Свойство("ДокументОтражение", ДокументОтражение);
	ПараметрыВыполнения.Свойство("ДокументОснование", ДокументОснование);
	ПараметрыВыполнения.Свойство("ЗаписьБезПроведения", ЗаписьБезПроведения);
	
	ДокументОтражение = СоздатьЗаполнитьДокументОтражение(ДокументОснование, ДокументОтражение, ЗаписьБезПроведения);
	
	ПоместитьВоВременноеХранилище(ДокументОтражение, АдресРезультата);
	
КонецПроцедуры	

// Выполняет создание и заполнение документа отражения по указанному документу основанию.
//
// Параметры:
//  ДокументОснование  - ДокументСсылка - первичный документ основание для отражения.
//  ДокументОтражение  - ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражение для заполнения.
//  ЗаписьБезПроведения  - Булево - флаг отказа от проведения. 
//						Используется для заполнения движений при ручной корректировке документа.
//  ИдентификаторОчереди  - УникальныйИдентификатор - Идентификатор обработки очереди документов к отражению.
// 						Заполняется при вызове процедуры из процедуры обработки очереди сообщений к отражению.
//						Используется для фильтрации очереди сообщений.
//
// Возвращаемое значение:
//   ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражение.
//
Функция СоздатьЗаполнитьДокументОтражение(ДокументОснование, ДокументОтражение = Неопределено, ЗаписьБезПроведения = Ложь, ИдентификаторОчереди = Неопределено) Экспорт
	
	Успешно = Ложь;
	СтатусОшибка = Перечисления.упоСтатусыОтраженияДокументовВПроектномБюджетировании.ОшибкаОтражения;
	
	Если Не Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования.ЕстьПравилоДляДокумента(ДокументОснование) Тогда
		ОшибкаЗаполнения = Новый Структура("Документ, Комментарий", 
			ДокументОснование,
			НСтр("ru = 'Нет активных правил отражения'"));
		МассивОшибок = Новый Массив;
		МассивОшибок.Добавить(ОшибкаЗаполнения);
		упоПроектноеБюджетированиеСервер.ИзменитьСтатусПервичногоДокументаВОчередиКОтражению(ДокументОснование, 
																							СтатусОшибка, 
																							ИдентификаторОчереди);											
		упоПроектноеБюджетированиеСервер.ОбновитьОшибкиОтраженияДокумента(ДокументОснование, МассивОшибок);
		Возврат Неопределено;
	КонецЕсли;	
	
	ПараметрыЗаполнения = ПараметрыЗаполненияДокументаОтражение(ДокументОснование, ДокументОтражение, ИдентификаторОчереди);	
	
	Если ЗначениеЗаполнено(ДокументОтражение) Тогда
		ДокументОтражениеОбъект = ДокументОтражение.ПолучитьОбъект();		
	Иначе
		ДокументОтражениеОбъект = Документы.упоОтражениеФактаВПроектномБюджетировании.СоздатьДокумент();
	КонецЕсли;	
	    		
	Попытка
		
		ДокументОтражениеОбъект.Заполнить(ПараметрыЗаполнения.ЗначенияЗаполнения);

		Если ЗначениеЗаполнено(ДокументОтражениеОбъект.СтатусЗаполнения) ИЛИ ЗаписьБезПроведения Тогда
			РежимЗаписи = РежимЗаписиДокумента.Запись;	
		Иначе //Нет ошибок заполнения и принудительного вызова записи без проведения.
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
		КонецЕсли;			
		
		ДокументОтражениеОбъект.ПометкаУдаления = Ложь;
		
		ДокументОтражениеОбъект.Записать(РежимЗаписи);					
		
		Успешно = Истина;

	Исключение
		
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ДокументОтражениеОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		ОписаниеОшибки = ОписаниеОшибки();
		
		ТекстОшибкиДокументВнеПериодаИспользованияКонтураЭкономики = ТекстОшибкиДокументВнеПериодаИспользованияКонтураЭкономики(ДокументОснование);
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Отражение документов в проектном бюджетировании. Ошибка отражения документа %1'"),
			ДокументОснование);
		ЗаписьЖурналаРегистрации(ТекстОшибки, УровеньЖурналаРегистрации.Ошибка, , ДокументОснование, ОписаниеОшибки);
		
		ПравилоОтражения = Неопределено;
		ДокументОтражениеОбъект.ДополнительныеСвойства.Свойство("ВыполняетсяПравило", ПравилоОтражения);
		
		тчОшибкиЗаполнения = ДокументОтражениеОбъект.ОшибкиЗаполнения;
		
		Если СтрНайти(ОписаниеОшибки, ТекстОшибкиДокументВнеПериодаИспользованияКонтураЭкономики) > 0 Тогда
			ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Иначе
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		ДобавитьОшибку(тчОшибкиЗаполнения, ПравилоОтражения, ПредставлениеОшибки);		
				
		упоПроектноеБюджетированиеСервер.ИзменитьСтатусПервичногоДокументаВОчередиКОтражению(ДокументОснование, 
																							СтатусОшибка, 
																							ИдентификаторОчереди);											
		упоПроектноеБюджетированиеСервер.ОбновитьОшибкиОтраженияДокумента(ДокументОснование, тчОшибкиЗаполнения);		
		
	КонецПопытки;	
	
	Возврат ДокументОтражениеОбъект.Ссылка;
	
КонецФункции

// Формирует текст ошибки соответствия документа основания периоду использования экономики проектов.
//
// Параметры:
//  ДокументОснование	 - ДокументСсылка	 - первичный документ основание для отражения
// 
// Возвращаемое значение:
//  Строка - текст сообщения.
//
Функция ТекстОшибкиДокументВнеПериодаИспользованияКонтураЭкономики(ДокументОснование) Экспорт

	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Документ %1 не удалось отразить в проектном бюджетировании, так как документ не относится к периоду
				|использования контура ""Отражение первичных документов в проектном бюджетировании"".'"),
				ДокументОснование);
				
	Возврат ТекстСообщения;

КонецФункции

// Возвращает правила отражения факта по документу отражения факта. 
//
// Параметры:
//  ДокументОтражение - ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//
// Возвращаемое значение:
//   Массив - СправочникСсылка.упоПравилаПолученияФактаДляПроектногоБюджетирования - правила отражения факта.
//
Функция ПравилаОтраженияПоДокументуОснованию(ДокументОтражение) Экспорт
	
	ДокументОснование = ДокументОтражение.ДокументОснование;
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		ПравилаОтражения = ДокументОтражение.ПравилаОтражения.Выгрузить().ВыгрузитьКолонку("ПравилоОтражения");
	Иначе		
		ТипДокумента = ДокументОснование.Метаданные().Имя;
		ПравилаОтражения = Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования.ПравилаОтраженияПоТипамДокументов(ТипДокумента);
	КонецЕсли;	
	
	Возврат ПравилаОтражения;
	
КонецФункции	

// Возвращает документ отражение для первичного документа отражения факта в проектном бюджетировании.
//
// Параметры:
//  ДокументОснование  - ДокументСсылка - первичный документ.
//  ПараметрыОтбора  - Структура - структура дополнительных параметров для отбора в запросе. 
//		Ключ "ТекстОтбора" обрабатывается как произвольное текстовое условие переданных параметров.
//
// Возвращаемое значение:
//   ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//
Функция ДокументОтражениеПоДокументуОснованию(ДокументОснование, ПараметрыОтбора = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	
	// Параметры отбора
	ЕстьПараметрыОтбора = ЗначениеЗаполнено(ПараметрыОтбора);
	Если ЕстьПараметрыОтбора Тогда
		
		ТекстОтбора = Неопределено;
		
		СобратьТекстОтбора = Не ПараметрыОтбора.Свойство("ТекстОтбора", ТекстОтбора);
		Если СобратьТекстОтбора Тогда
			МассивТекстовОтбора = Новый Массив;
			ШаблонТекста = " И %1 = %2";
		КонецЕсли;
		
		Для Каждого КлючЗначение Из ПараметрыОтбора Цикл
			Если КлючЗначение.Ключ = "ТекстОтбора" Тогда
				Продолжить;
			КонецЕсли;
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
			Если СобратьТекстОтбора Тогда
				МассивТекстовОтбора.Добавить(СтрШаблон(ШаблонТекста, КлючЗначение.Ключ, КлючЗначение.Значение));
			КонецЕсли;
		КонецЦикла;
		
		Если СобратьТекстОтбора Тогда
			ТекстОтбора = СтрСоединить(МассивТекстовОтбора);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ДокументОтражения.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.упоОтражениеФактаВПроектномБюджетировании КАК ДокументОтражения
	               |ГДЕ
	               |	ДокументОтражения.ДокументОснование = &ДокументОснование";
	
	Если ЕстьПараметрыОтбора Тогда
		Запрос.Текст = Запрос.Текст + ТекстОтбора;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Результат.Пустой() Тогда
		ДокументОтражение = Документы.упоОтражениеФактаВПроектномБюджетировании.ПустаяСсылка();
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ДокументОтражение = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ДокументОтражение;
	
КонецФункции

// Возвращает признак актуальности данных отражения документа в проектном бюджетировании.
//
// Параметры:
//  ДокументОснование  - ДокументСсылка - документ.
//
// Возвращаемое значение:
//   Булево - актуальность данных отражения документа. 
//
Функция ДанныеДокументаОтраженияАктуальны(ДокументОснование) Экспорт
	
	ДанныеАктуальны = Ложь;
		
	СтатусыДанныеАктуальны = упоПроектноеБюджетированиеПовтИсп.СтатусыОтражения("Отражено");
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	упоОтражениеДокументовВПроектномБюджетировании.Статус КАК Статус,
	                      |	упоОтражениеДокументовВПроектномБюджетировании.Документ КАК Документ,
	                      |	упоОтражениеДокументовВПроектномБюджетировании.Статус В (&СтатусыДанныеАктуальны) КАК ДанныеАктуальны
	                      |ИЗ
	                      |	РегистрСведений.упоОтражениеДокументовВПроектномБюджетировании КАК упоОтражениеДокументовВПроектномБюджетировании
	                      |ГДЕ
	                      |	упоОтражениеДокументовВПроектномБюджетировании.Документ = &Документ");
	Запрос.УстановитьПараметр("Документ", ДокументОснование);
	Запрос.УстановитьПараметр("СтатусыДанныеАктуальны", СтатусыДанныеАктуальны);
	
	Результат = Запрос.Выполнить();	
	Если НЕ Результат.Пустой() Тогда		
		Выборка = Результат.Выбрать();		
		Если Выборка.Следующий() Тогда			
			ДанныеАктуальны = Выборка.ДанныеАктуальны;			
		КонецЕсли;			
	КонецЕсли;	
	
	Возврат ДанныеАктуальны;
	
КонецФункции	

// Возвращает признак отражения документа в международном учете.
//
// Параметры:
//  ДокументОтражение  - ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//
// Возвращаемое значение:
//   Булево - актуальность данных отражения документа. 
//
Функция ДокументОтраженВМеждународномУчете(ДокументОтражение) Экспорт
	
	СтатусыОтражения = Новый Массив;
	СтатусыОтражения.Добавить(Перечисления.СтатусыОтраженияВМеждународномУчете.ОтраженоВУчете);	
	СтатусыОтражения.Добавить(Перечисления.СтатусыОтраженияВМеждународномУчете.ОтраженоВУчетеВручную);
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	ОтражениеДокументовВМеждународномУчете.Статус
	                      |ИЗ
	                      |	РегистрСведений.ОтражениеДокументовВМеждународномУчете КАК ОтражениеДокументовВМеждународномУчете
	                      |ГДЕ
	                      |	ОтражениеДокументовВМеждународномУчете.Регистратор = &ДокументОтражение
	                      |	И ОтражениеДокументовВМеждународномУчете.Статус В(&СтатусыОтражения)");
	Запрос.УстановитьПараметр("ДокументОтражение", ДокументОтражение);
	Запрос.УстановитьПараметр("СтатусыОтражения", СтатусыОтражения);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

// Заполняет представление проектных задач в форме.
//
// Параметры:
//  Объект  - УправляемаяФорма - форма - источник изменения.
//  ПроектнаяЗадача - ДокументСсылка.упоПроектнаяЗадача - проектная задача.
//
// Возвращаемое значение:
//  Соответствие   - соответствие проектных задач наименованиям:
//		*Ключ - ДокументСсылка.упоПроектнаяЗадача - проектная задача.
//		*Значение - Строка - наименовани проектной задачи.
//
Функция ОбновитьНаименованияПроектныхЗадач(Объект, ПроектнаяЗадача = Неопределено) Экспорт
	
	РазделыДокумента = Новый Массив;
	Если ПроектнаяЗадача = Неопределено Тогда
		РазделыДокумента.Добавить("ДДС");
		РазделыДокумента.Добавить("ДоходыРасходы");
	КонецЕсли;	
	
	НаименованияПроектныхЗадач = Новый Соответствие();
	
	ПроектныеЗадачи = Новый Массив;	
	Если ПроектнаяЗадача = Неопределено Тогда	
		Для Каждого РазделДокумента Из РазделыДокумента Цикл	
			Для Каждого СтрокаРаздела Из Объект[РазделДокумента] Цикл
				Если ЗначениеЗаполнено(СтрокаРаздела.ПроектнаяЗадача) И ПроектныеЗадачи.Найти(СтрокаРаздела.ПроектнаяЗадача) = Неопределено Тогда
					ПроектныеЗадачи.Добавить(СтрокаРаздела.ПроектнаяЗадача);
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
	Иначе
		ПроектныеЗадачи.Добавить(ПроектнаяЗадача);
	КонецЕсли;	
				
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ПроектныеЗадачи);	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК НазваниеЗадачи
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача В (&ПроектныеЗадачи)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)";
	Результат = Запрос.Выполнить();		
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл 
			НаименованияПроектныхЗадач.Вставить(Выборка.ПроектнаяЗадача, Выборка.НазваниеЗадачи);				
		КонецЦикла;	
	КонецЕсли;	
	
	Если ПроектнаяЗадача = Неопределено Тогда
		Для Каждого РазделДокумента Из РазделыДокумента Цикл
			Для Каждого СтрокаРаздела Из Объект[РазделДокумента] Цикл
				СтрокаРаздела.ПроектнаяЗадачаНаименование = НаименованияПроектныхЗадач[СтрокаРаздела.ПроектнаяЗадача];
			КонецЦикла;
		КонецЦикла;
	Иначе
		Возврат НаименованияПроектныхЗадач[ПроектнаяЗадача];
	КонецЕсли;	
				
КонецФункции

#КонецОбласти

