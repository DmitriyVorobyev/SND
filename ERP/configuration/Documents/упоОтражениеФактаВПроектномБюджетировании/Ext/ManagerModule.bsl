// Возвращает данные для проведения документа.
//
// Параметры:
//  ДокументСсылка  - ДокументСсылка.упоОтражениеФактаВПроектномБюджетировании - документ отражения факта.
//
// Возвращаемое значение:
//   Структура: 
//   	* Ключ - Строка - имя регистра.
//   	* Значение - ТаблицаЗначений - данные для проведения документа.
//
Функция ДанныеПроведения(ДокументСсылка) Экспорт
	
	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(ТекстПроведениеPM());
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	ОтражатьПоМФУ_ERP_2_4 = ОтражатьПоМФУ_ERP_2_4();
	
	Если ОтражатьПоМФУ_ERP_2_4 Тогда
		Запрос.УстановитьПараметр("ИспользоватьМеждународныйФинансовыйУчет", 
			ПолучитьФункциональнуюОпцию("ИспользоватьМеждународныйФинансовыйУчет"));
		ТекстыЗапроса.Добавить(ТекстПроведениеEPM());
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеПроведения = Новый Структура;
	ДанныеПроведения.Вставить("упоФактДоходовИРасходовОбороты", Результат[2].Выгрузить());
	ДанныеПроведения.Вставить("упоФактДоходовИРасходовПоДням", Результат[3].Выгрузить());
	ДанныеПроведения.Вставить("упоФактДвиженийДенежныхСредств", Результат[4].Выгрузить());
	Если ОтражатьПоМФУ_ERP_2_4 Тогда
		ДанныеПроведения.Вставить("ОтражениеДокументовВМеждународномУчете", Результат[Результат.ВГраница()].Выгрузить());
	КонецЕсли;
	
	Возврат ДанныеПроведения;
	
КонецФункции

#КонецОбласти

