// Заполняет объект по основанию.
//
// Параметры:
//  Объект			 - ДокументСсылка.упоРегистрацияФактическихДоходовИРасходов - заполняемый документ.
//  Основание		 - ДокументСсылка - документ-основание.
//  ЗаполнятьДоходы	 - Булево - признак необходимости заполнять доходы.
//  ЗаполнятьРасходы - Булево - признак необходимости заполнять расходы.
//
Процедура ЗаполнитьОбъектПоОснованию(Объект, Основание, ЗаполнятьДоходы = Ложь, ЗаполнятьРасходы = Ложь) Экспорт
	
	ТаблицаРезультат = Неопределено;
	
	Если ЗаполнятьДоходы Или ЗаполнятьРасходы Тогда
		СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект); 
	КонецЕсли;
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоВерсияПланаПроекта") 
		Или ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		ТаблицаРезультат = ПолучитьТаблицуОснованиеВерсии(Объект, Основание,  ЗаполнятьДоходы, ЗаполнятьРасходы);		 
		
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.упоРегистрацияФактическиВыполненногоОбъема") Тогда
		
		ТаблицаРезультат = ПолучитьВыполненныеОбъемыПоРегистратору(Объект, Основание,  ЗаполнятьДоходы, ЗаполнятьРасходы);
		
	ИначеЕсли Основание = "ПоВыполненнымОбъемам" Тогда
		
		ТаблицаРезультат =  ПолучитьОстаткиВыполненныхОбъемов(Объект,  ЗаполнятьДоходы, ЗаполнятьРасходы);	
		
	КонецЕсли;
	
	Если ЗаполнятьДоходы Тогда
		
		Объект.Доходы.Очистить();
		Объект.РаспределениеДоходов.Очистить();
		
		Если ТаблицаРезультат <> Неопределено Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ВидЭлемента",Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход);
			
			ТаблицаДоходы = ТаблицаРезультат.Скопировать(Отбор);
			ТаблицаДоходы.Свернуть("ПроектнаяЗадача, Статья, Контрагент, Договор, Валюта, Номенклатура, ЕдиницаИзмерения, ДатаНачисления",
			"Сумма,Количество");
			
			Счетчик = 0;
			
			// Кеширование
			мПроектныеЗадачи = Новый Массив;
			Для Каждого СтрокаО Из  ТаблицаДоходы Цикл
				мПроектныеЗадачи.Добавить(СтрокаО.ПроектнаяЗадача);
			КонецЦикла;
			СправочникПроектПоДокументуПЗ = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(мПроектныеЗадачи,, Истина);
			
			Для Каждого СтрокаО Из  ТаблицаДоходы Цикл
				
				НоваяСтрока = Объект.Доходы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаО);
				
				Если НоваяСтрока.Количество > 0 Тогда
					
					НоваяСтрока.Стоимость =  НоваяСтрока.Сумма /  НоваяСтрока.Количество;
					
				КонецЕсли;
				
				НоваяСтрока.ПроектнаяЗадачаПроект = СправочникПроектПоДокументуПЗ.Получить(НоваяСтрока.ПроектнаяЗадача);
				
				Если СвойстваПроекта.ДоходыПоПодразделениям Тогда
					
					ОтборРаспределения = Новый Структура;
					
					ОтборРаспределения.Вставить("ПроектнаяЗадача", СтрокаО.ПроектнаяЗадача);
					ОтборРаспределения.Вставить("Статья", СтрокаО.Статья);
					ОтборРаспределения.Вставить("Контрагент", СтрокаО.Контрагент);
					ОтборРаспределения.Вставить("Договор", СтрокаО.Договор);
					ОтборРаспределения.Вставить("Валюта", СтрокаО.Валюта);
					ОтборРаспределения.Вставить("Номенклатура", СтрокаО.Номенклатура);
					ОтборРаспределения.Вставить("ЕдиницаИзмерения", СтрокаО.ЕдиницаИзмерения);
					ОтборРаспределения.Вставить("ДатаНачисления", СтрокаО.ДатаНачисления);
					ОтборРаспределения.Вставить("ВидЭлемента", Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход);
					
					НайденныеСтроки = ТаблицаРезультат.НайтиСтроки(ОтборРаспределения); 
					
					Если НайденныеСтроки.Количество() = 0 Тогда
						
						НоваяСтрока.ИндексСтрокРаспределения = Неопределено;
						
					Иначе
						
						НоваяСтрока.ИндексСтрокРаспределения = Счетчик;
						
						Для Каждого НайденнаяСтрокаРаспределения Из НайденныеСтроки Цикл
							
							НоваяСтрокаРаспределения = Объект.РаспределениеДоходов.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, НайденнаяСтрокаРаспределения);
							НоваяСтрокаРаспределения.ИндексСтрокиВладельца = Счетчик;
							
						КонецЦикла;
						
						Счетчик = Счетчик + 1;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗаполнятьРасходы Тогда
		
		Объект.Расходы.Очистить();
		Объект.РаспределениеРасходов.Очистить();
		
		Если ТаблицаРезультат <> Неопределено Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ВидЭлемента",Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход);
			
			ТаблицаРасходы = ТаблицаРезультат.Скопировать(Отбор);
			ТаблицаРасходы.Свернуть("ПроектнаяЗадача, Статья, Контрагент, Договор, Валюта, Номенклатура, ЕдиницаИзмерения, ДатаНачисления",
			"Сумма,Количество");
			
			Счетчик = 0;
			
			// Кеширование
			мПроектныеЗадачи = Новый Массив;
			Для Каждого СтрокаО Из  ТаблицаРасходы Цикл
				мПроектныеЗадачи.Добавить(СтрокаО.ПроектнаяЗадача);
			КонецЦикла;
			СправочникПроектПоДокументуПЗ = упоПроектыИЗадачиСервер.НайтиСвязанныйЭлементПроекта(мПроектныеЗадачи,, Истина);
			
			
			Для Каждого СтрокаО Из  ТаблицаРасходы Цикл
				
				НоваяСтрока = Объект.Расходы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаО);
				
				Если НоваяСтрока.Количество > 0 Тогда
					
					НоваяСтрока.Стоимость =  НоваяСтрока.Сумма /  НоваяСтрока.Количество;
					
				КонецЕсли;
				
				НоваяСтрока.ПроектнаяЗадачаПроект = СправочникПроектПоДокументуПЗ.Получить(НоваяСтрока.ПроектнаяЗадача);
				
				Если СвойстваПроекта.РасходыПоПодразделениям Тогда
					
					ОтборРаспределения = Новый Структура;
					
					ОтборРаспределения.Вставить("ПроектнаяЗадача", СтрокаО.ПроектнаяЗадача);
					ОтборРаспределения.Вставить("Статья", СтрокаО.Статья);
					ОтборРаспределения.Вставить("Контрагент", СтрокаО.Контрагент);
					ОтборРаспределения.Вставить("Договор", СтрокаО.Договор);
					ОтборРаспределения.Вставить("Валюта", СтрокаО.Валюта);
					ОтборРаспределения.Вставить("Номенклатура", СтрокаО.Номенклатура);
					ОтборРаспределения.Вставить("ЕдиницаИзмерения", СтрокаО.ЕдиницаИзмерения);
					ОтборРаспределения.Вставить("ДатаНачисления", СтрокаО.ДатаНачисления);
					ОтборРаспределения.Вставить("ВидЭлемента", Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход);
					
					НайденныеСтроки = ТаблицаРезультат.НайтиСтроки(ОтборРаспределения); 
					
					Если НайденныеСтроки.Количество() = 0 Тогда
						
						НоваяСтрока.ИндексСтрокРаспределения = Неопределено;
						
					Иначе
						
						НоваяСтрока.ИндексСтрокРаспределения = Счетчик;
						
						Для Каждого НайденнаяСтрокаРаспределения Из НайденныеСтроки Цикл
							
							НоваяСтрокаРаспределения = Объект.РаспределениеРасходов.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрокаРаспределения, НайденнаяСтрокаРаспределения);
							НоваяСтрокаРаспределения.ИндексСтрокиВладельца = Счетчик;
							
						КонецЦикла;
						
						Счетчик = Счетчик + 1;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

