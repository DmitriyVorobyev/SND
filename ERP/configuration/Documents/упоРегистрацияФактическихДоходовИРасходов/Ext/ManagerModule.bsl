Функция ПолучитьВыполненныеОбъемыПоРегистратору(Объект, Основание,  ЗаполнятьДоходы, ЗаполнятьРасходы)
	
	ЗапросФО = Новый Запрос;
	ЗапросФО.Текст =  "ВЫБРАТЬ
	                  |	упоФактВыполненияОбъемовОбороты.Период КАК ДатаНачисления,
	                  |	упоФактВыполненияОбъемовОбороты.ПроектнаяЗадача,
	                  |	упоФактВыполненияОбъемовОбороты.Статья,
	                  |	ВЫБОР
	                  |		КОГДА упоФактВыполненияОбъемовОбороты.ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Доход)
	                  |			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход)
	                  |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
	                  |	КОНЕЦ КАК ВидЭлемента,
	                  |	упоФактВыполненияОбъемовОбороты.Контрагент,
	                  |	упоФактВыполненияОбъемовОбороты.Договор,
	                  |	упоФактВыполненияОбъемовОбороты.Валюта,
	                  |	упоФактВыполненияОбъемовОбороты.Подразделение,
	                  |	упоФактВыполненияОбъемовОбороты.Роль,
	                  |	упоФактВыполненияОбъемовОбороты.Номенклатура,
	                  |	упоФактВыполненияОбъемовОбороты.ЕдиницаИзмерения,
	                  |	упоФактВыполненияОбъемовОбороты.Сценарий,
	                  |	упоФактВыполненияОбъемовОбороты.Заказ_ДоговорПодрядчика КАК ЗаказДоговорПодрядчика,
	                  |	упоФактВыполненияОбъемовОбороты.СобствСилы_Субподряд,
	                  |	упоФактВыполненияОбъемовОбороты.КонтрагентПодрядчик,
	                  |	упоФактВыполненияОбъемовОбороты.СуммаВалютная КАК Сумма,
	                  |	упоФактВыполненияОбъемовОбороты.Количество
	                  |ИЗ
	                  |	РегистрНакопления.упоФактВыполненияОбъемовОбороты КАК упоФактВыполненияОбъемовОбороты
	                  |ГДЕ
	                  |	упоФактВыполненияОбъемовОбороты.Регистратор = &Основание";
	
	ЗапросФО.УстановитьПараметр("Основание", Основание);
	ТаблицаРезультат = ЗапросФО.Выполнить().Выгрузить();
	
	Возврат ТаблицаРезультат;	
	
КонецФункции

Функция ПолучитьТаблицуОснованиеВерсии(Объект, Основание,  ЗаполнятьДоходы = Ложь, ЗаполнятьРасходы = Ложь)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		текущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
		ТекстУсловия = ",	Версия = &ТекущаяВерсия И ПроектнаяЗадача = &Основание";
		ОтборНеОтмененых = "";
		
	Иначе
		
		текущаяВерсия = Основание;		 
		ТекстУсловия = ",Версия = &ТекущаяВерсия";
		ОтборНеОтмененых = "		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	                       |		ПО упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	                       |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)";
		
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Статья,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Контрагент,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Договор,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ВидЭлемента,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Валюта,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Подразделение,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Роль,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Номенклатура,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ЕдиницаИзмерения,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ДатаНачисления,
	 |	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная) КАК Сумма,
	 |	СУММА(упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Количество) КАК Количество,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СобствСилы_Субподряд,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.КонтрагентПодрядчик,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Заказ_ДоговорПодрядчика КАК ЗаказДоговорПодрядчика
	 |ИЗ
	 |	РегистрСведений.упоАктуальныеПланыДоходовИРасходовПодразделения.СрезПоследних(%ТекстУсловия%) КАК упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних
	 |%ОтборНеОтмененых%
	 |ГДЕ
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СуммаВалютная > 0
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ПроектнаяЗадача,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Статья,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ВидЭлемента,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Контрагент,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Договор,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Валюта,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Подразделение,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Роль,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Номенклатура,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ЕдиницаИзмерения,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.ДатаНачисления,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.СобствСилы_Субподряд,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.КонтрагентПодрядчик,
	 |	упоАктуальныеПланыДоходовИРасходовПодразделенияСрезПоследних.Заказ_ДоговорПодрядчика";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ТекстУсловия%", ТекстУсловия);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%ОтборНеОтмененых%", ОтборНеОтмененых);
	
	ЗапросОбъемов = Новый Запрос;
	ЗапросОбъемов.УстановитьПараметр("Основание", Основание);	
	ЗапросОбъемов.УстановитьПараметр("ТекущаяВерсия",  текущаяВерсия);
	
	ЗапросОбъемов.Текст = ТекстЗапроса;	
	
	ТаблицаРезультат = ЗапросОбъемов.Выполнить().Выгрузить();
	
	ТаблицаКопия = ТаблицаРезультат.СкопироватьКолонки();
	
	Если ЗаполнятьДоходы Тогда
		
		Для Каждого СтрокаТР Из ТаблицаРезультат Цикл
			
			Если СтрокаТР.ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Доход Тогда
				
				НоваяСтрока = ТаблицаКопия.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТР);
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Если ЗаполнятьРасходы Тогда
		
		Для Каждого СтрокаТР Из ТаблицаРезультат Цикл
			
			Если СтрокаТР.ВидЭлемента = Перечисления.упоВидЭлементаПланаДоходовИРасходов.Расход Тогда
				
				НоваяСтрока = ТаблицаКопия.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТР);
				
			КонецЕсли;
			
		КонецЦикла;			
		
	КонецЕсли;
	
	Возврат ТаблицаКопия;
	
КонецФункции

Функция ПолучитьОстаткиВыполненныхОбъемов(Объект,  ЗаполнятьДоходы, ЗаполнятьРасходы)
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = "ВЫБРАТЬ
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.ПроектнаяЗадача КАК ПроектнаяЗадача,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Статья КАК Статья,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.ВидОбъема КАК ВидОбъема,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Контрагент КАК Контрагент,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Договор КАК Договор,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Валюта КАК Валюта,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Подразделение КАК Подразделение,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Роль КАК Роль,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Номенклатура КАК Номенклатура,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Сценарий КАК Сценарий,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.СуммаВалютнаяРасход КАК СуммаВалютнаяРасход,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.СуммаВалютнаяПриход КАК СуммаВалютнаяПриход,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Регистратор КАК Регистратор,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.КоличествоПриход КАК КоличествоПриход,
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.КоличествоРасход КАК КоличествоРасход
	                       |ПОМЕСТИТЬ ВТ_Остатки
	                       |ИЗ
	                       |	РегистрНакопления.упоВыполненныеПринятыеОбъемы.ОстаткиИОбороты(, , Авто, , ПроектнаяЗадача.Проект = &Проект) КАК упоВыполненныеПринятыеОбъемыОстаткиИОбороты
	                       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(
	                       |				,
	                       |				Версия В
	                       |					(ВЫБРАТЬ
	                       |						упоВерсииПроекта.Версия КАК Версия
	                       |					ИЗ
	                       |						РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	                       |					ГДЕ
	                       |						упоВерсииПроекта.Проект = &Проект
	                       |						И упоВерсииПроекта.Текущая)) КАК упоСвойстваПроектныхЗадачСрезПоследних
	                       |		ПО упоВыполненныеПринятыеОбъемыОстаткиИОбороты.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	                       |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	                       |ГДЕ
	                       |	упоВыполненныеПринятыеОбъемыОстаткиИОбороты.Регистратор <> &Регистратор
	                       |;
	                       |
	                       |////////////////////////////////////////////////////////////////////////////////
	                       |ВЫБРАТЬ
	                       |	ВТ_Остатки.ПроектнаяЗадача КАК ПроектнаяЗадача,
	                       |	ВТ_Остатки.Статья КАК Статья,
	                       |	ВЫБОР
	                       |		КОГДА ВТ_Остатки.ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Доход)
	                       |			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход)
	                       |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
	                       |	КОНЕЦ КАК ВидЭлемента,
	                       |	ВТ_Остатки.Контрагент КАК Контрагент,
	                       |	ВТ_Остатки.Договор КАК Договор,
	                       |	ВТ_Остатки.Валюта КАК Валюта,
	                       |	ВТ_Остатки.Подразделение КАК Подразделение,
	                       |	ВТ_Остатки.Роль КАК Роль,
	                       |	ВТ_Остатки.Номенклатура КАК Номенклатура,
	                       |	ВТ_Остатки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	                       |	ВТ_Остатки.Сценарий КАК Сценарий,
	                       |	ВТ_Остатки.Заказ_ДоговорПодрядчика КАК Заказ_ДоговорПодрядчика,
	                       |	ВТ_Остатки.СобствСилы_Субподряд КАК СобствСилы_Субподряд,
	                       |	ВТ_Остатки.КонтрагентПодрядчик КАК КонтрагентПодрядчик,
	                       |	СУММА(ВТ_Остатки.СуммаВалютнаяПриход - ВТ_Остатки.СуммаВалютнаяРасход) КАК Сумма,
	                       |	&ТекущаяДата КАК ДатаНачисления,
	                       |	СУММА(ВТ_Остатки.КоличествоПриход - ВТ_Остатки.КоличествоРасход) КАК Количество
	                       |ИЗ
	                       |	ВТ_Остатки КАК ВТ_Остатки
	                       |
	                       |СГРУППИРОВАТЬ ПО
	                       |	ВТ_Остатки.Статья,
	                       |	ВТ_Остатки.ПроектнаяЗадача,
	                       |	ВТ_Остатки.Контрагент,
	                       |	ВТ_Остатки.Договор,
	                       |	ВТ_Остатки.Валюта,
	                       |	ВТ_Остатки.Подразделение,
	                       |	ВТ_Остатки.Роль,
	                       |	ВТ_Остатки.Номенклатура,
	                       |	ВТ_Остатки.ЕдиницаИзмерения,
	                       |	ВТ_Остатки.Сценарий,
	                       |	ВТ_Остатки.Заказ_ДоговорПодрядчика,
	                       |	ВТ_Остатки.СобствСилы_Субподряд,
	                       |	ВТ_Остатки.КонтрагентПодрядчик,
	                       |	ВЫБОР
	                       |		КОГДА ВТ_Остатки.ВидОбъема = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаОбъемов.Доход)
	                       |			ТОГДА ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход)
	                       |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)
	                       |	КОНЕЦ";
	
	ЗапросОстатков.УстановитьПараметр("Проект", Объект.Проект);
	ЗапросОстатков.УстановитьПараметр("ТекущаяДата",Объект.Дата);
	ЗапросОстатков.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	ТаблицаОстатков = ЗапросОстатков.Выполнить().Выгрузить();
	ТаблицаКопия = ТаблицаОстатков.СкопироватьКолонки();
	
	Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
		
		Если (СтрокаОстатков.Количество + СтрокаОстатков.Сумма) <> 0 Тогда
			
			НоваяСтрока = ТаблицаКопия.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаКопия;
	
КонецФункции

