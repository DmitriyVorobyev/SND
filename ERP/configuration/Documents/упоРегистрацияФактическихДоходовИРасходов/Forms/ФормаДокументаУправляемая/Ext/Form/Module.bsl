&НаКлиенте
Процедура ВопросОчисткиТаблицыЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Не Результат = КодВозвратаДиалога.Да Тогда
		Проект = Объект.Проект;
		Возврат;
	КонецЕсли;
	
	Объект.Доходы.Очистить();
	Объект.РаспределениеДоходов.Очистить();
	Объект.Расходы.Очистить();
	Объект.РаспределениеРасходов.Очистить();
	Объект.Проект = Проект;
	УправлениеВидимостьюЭлементов_АналитикаПоПодразделениям();
	
КонецПроцедуры

// Производит автоматическое заполнение табличной части.
//
// Параметры:
//  РежимЗаполнения  – Строка - указывает на источник данных.
//  ВидЭлемента  - Перечисление.ВидЭлементаПланаДоходовИРасходов
//                 указывает, какую именно табличную часть заполняем.
//
&НаКлиенте
Процедура ЗаполнитьТабличнуюЧасть(РежимЗаполнения, ВидЭлемента)
	
	// проверим, выбрана ли проектная задача
	
	Если ВидЭлемента = ПредопределенноеЗначение("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход") Тогда
		ТабЧасть = "Доходы";
		ЭлементВладелец = Элементы.Доходы;
	ИначеЕсли ВидЭлемента = ПредопределенноеЗначение("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход") Тогда
		ТабЧасть = "Расходы";
		ЭлементВладелец = Элементы.Расходы;
	КонецЕсли; 
	
	Если РежимЗаполнения = "По плану" Тогда
		ЗаполнитьТабличнуюЧастьНаСервере(ТабЧасть, РежимЗаполнения, ВидЭлемента);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьНаСервере(имяТабЧасти, РежимЗаполнения, ВидЭлемента)
	
	ТабЧасть = Объект[имяТабЧасти];
	ТабЧасть.Очистить(); 
	
	ТекВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	ПараметрыЗапроса = Новый Структура("ТекВерсия,ПроектнаяЗадача,ВидЭлемента", ТекВерсия, Объект.ПроектнаяЗадача, ВидЭлемента);
	
	// Простой режим - забираем данные из текущего плана.
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	РегПлан.Статья,
	               |	РегПлан.ДатаНачисления,
	               |	СУММА(РегПлан.СуммаВалютная) КАК Сумма,
	               |	РегПлан.Контрагент,
	               |	РегПлан.Договор,
	               |	РегПлан.Валюта
	               |ИЗ
	               |	РегистрСведений.упоАктуальныеПланыДоходовИРасходов.СрезПоследних(
	               |			,
	               |			Версия = &ТекВерсия
	               |				И ПроектнаяЗадача = &ПроектнаяЗадача
	               |				И ВидЭлемента = &ВидЭлемента) КАК РегПлан
	               |ГДЕ
	               |	РегПлан.СуммаВалютная > 0
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РегПлан.Статья,
	               |	РегПлан.ДатаНачисления,
	               |	РегПлан.Валюта,
	               |	РегПлан.Контрагент,
	               |	РегПлан.Договор";
	
	// извлекаем данные запросом
	РезультатЗапроса = упоСервисныеФункцииВызовСервера.обВыполнитьЗапрос(ТекстЗапроса, ПараметрыЗапроса);
	ТаблицаЗапроса = РезультатЗапроса.Выгрузить();
	
	// и переливаем их в табличную часть	
	Для Каждого СтрокаТЗ Из ТаблицаЗапроса Цикл
		НоваяСтрока = ТабЧасть.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьПоВерсии(текВерсия = Неопределено, ТаблицаВладелец)
			
	Если ТекВерсия = Неопределено Тогда
		текВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Проект);
	КонецЕсли;
			
	ЗаполнятьДоходы = ТаблицаВладелец = "Доходы";	
	ЗаполнятьРасходы = ТаблицаВладелец = "Расходы";
	
	Документы.упоРегистрацияФактическихДоходовИРасходов.ЗаполнитьОбъектПоОснованию(Объект, текВерсия, ЗаполнятьДоходы, ЗаполнятьРасходы); 
	
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоВыполненнымОбъемам(ТаблицаВладелец)
	
	ЗаполнятьДоходы = ТаблицаВладелец = "Доходы";
	ЗаполнятьРасходы = ТаблицаВладелец = "Расходы";
	Документы.упоРегистрацияФактическихДоходовИРасходов.ЗаполнитьОбъектПоОснованию(Объект, "ПоВыполненнымОбъемам",
		ЗаполнятьДоходы, ЗаполнятьРасходы);
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

// Подготавливает доп. параметры структуры подбора.
//
// Параметры:
//  ПараметрыПодбораСтруктура	 - 	 - 
//  ИмяТЧ						 - 	 - 
//
&НаКлиенте
Процедура ПодготовитьДопПараметрыСтруктурыПодбора(ПараметрыПодбораСтруктура, ИмяТЧ) Экспорт
	
	ПараметрыПодбораСтруктура= Новый Структура;
	
	ПараметрыПодбораСписок = Новый СписокЗначений();
	ПараметрыПодбораСписок.Добавить(ИмяТЧ, "ИмяТабличнойЧасти");
	
	СтруктураДанных =  ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТЧ); 
	
	ПараметрыПодбораСтруктура = Новый Структура;
	ПараметрыПодбораСтруктура.Вставить("ПараметрыПодбораСписок", ПараметрыПодбораСписок);
	ПараметрыПодбораСтруктура.Вставить("СтруктураСтроки", СтруктураДанных.СтруктураСтрокиТЧ);
	
	ПараметрыПодбораСтруктура.Вставить("СвойстваОбъекта", СтруктураДанных.СтруктураОбъекта);	
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТЧ)
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("СтруктураСтрокиТЧ", Новый Структура);
	ДопПараметры.Вставить("СтруктураОбъекта", Новый Структура);
	
	ПодготовитьКопиюДанныхОбъекта(ДопПараметры.СтруктураСтрокиТЧ, ИмяТЧ);
	ПодготовитьКопиюДанныхОбъекта(ДопПараметры.СтруктураОбъекта);
	
	Возврат ДопПараметры;
	
КонецФункции

&НаСервере
Процедура ПодготовитьКопиюДанныхОбъекта(СтруктураПустая, ИмяТЧ = Неопределено)
	
	// Перенести код в модуль с повторным использованием значений.
	
	СтруктураПустая = Новый Структура;
	
	Если ИмяТЧ = Неопределено Тогда 
		
		Для Каждого РеквизитМетаданных Из Метаданные.Документы.упоРегистрацияФактическихДоходовИРасходов.Реквизиты Цикл
			
			СтруктураПустая.Вставить(РеквизитМетаданных.Имя);
			
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(СтруктураПустая, Объект);
		
	Иначе 
		
		Для Каждого РеквизитМетаданных Из Метаданные.Документы.упоРегистрацияФактическихДоходовИРасходов.ТабличныеЧасти[ИмяТЧ].Реквизиты Цикл
			
			СтруктураПустая.Вставить(РеквизитМетаданных.Имя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Проекты") Тогда
		
		Объект.Проект = ВыбранноеЗначение;
		упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "Проект");
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		Объект.Проект = ВыбранноеЗначение.Проект;
		упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "Проект");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьДопПараметры(имяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	
	АдресХранилища = "";
	
	Если имяКоманды = "ДействиеПодобрать_ПланДоходов_ПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.Доходы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоСтатьиДоходов";
		ТаблицаФормы = Объект.Доходы;
		ИмяКолонки = "Статья";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ПланДоходов_ПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.Доходы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.Контрагенты";
		ТаблицаФормы = Объект.Доходы;
		ИмяКолонки = "Контрагент";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ПланРасходов_ПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.Расходы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.упоСтатьиЗатрат";
		ТаблицаФормы = Объект.Расходы;
		ИмяКолонки = "Статья";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	ИначеЕсли  имяКоманды = "ДействиеПодобрать_ПланРасходов_ПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.Расходы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = "Справочники.Контрагенты";
		ТаблицаФормы = Объект.Расходы;
		ИмяКолонки = "Контрагент";
		ПараметрыПодбора.ДопПараметры.ПовторныйВыбор = Истина;
		
	КонецЕсли;
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы, ИмяКолонки, 
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
	
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
	
	Возврат ПараметрыПодбора;
	
КонецФункции

