&НаКлиенте	
Процедура ПриИзмененииПЗСервер(ТЧОбъекта)
	
	ТекущиеДанные = Элементы[ТЧОбъекта].ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ПроектнаяЗадачаПроект) Тогда
			
			ТекущиеДанные.ПроектнаяЗадача = ПолучитьПЗПоПроекту(ТекущиеДанные.ПроектнаяЗадачаПроект);
			
		Иначе 
			
			ТекущиеДанные.ПроектнаяЗадача = ПредопределенноеЗначение("Документ.упоПроектнаяЗадача.ПустаяСсылка");
			
		КонецЕсли;
		
	КонецЕсли;	
	
