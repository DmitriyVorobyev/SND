#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборВТЧФормы(Команда)
	
	ПараметрыПодбора = ПодготовитьДопПараметры(Команда.Имя);
	
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных, ПараметрыПодбора.ЭлементВладелец,
		ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);		
	
КонецПроцедуры

&НаКлиенте	
Процедура ЗаполнитьТЧФормы(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Вначале необходимо выбрать проект.'");
		Сообщение.Поле = "Проект";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли; 
	
	Если Команда.Имя = "ЗаполнитьПоТекПлануДоходы" Тогда
		
		ЗаполнитьТабличнуюЧастьПоВерсии(, "Доходы");
		
	ИначеЕсли Команда.Имя = "ЗаполнитьПоУтвержденномуПлануДоходы" Тогда
		
		ЗаполнитьТабличнуюЧасть("По версии", ПредопределенноеЗначение("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход"));
		
	ИначеЕсли Команда.Имя = "ЗаполнитьПоТекПлануРасход" Тогда
		
		ЗаполнитьТабличнуюЧастьПоВерсии(, "Расходы");
		
	ИначеЕсли Команда.Имя = "ЗаполнитьПоУтвержденномуПлануРасход" Тогда
		
		ЗаполнитьТабличнуюЧасть("По версии", ПредопределенноеЗначение("Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход"));
		
	ИначеЕсли Команда.Имя = "ЗаполнитьПоВыполненнымОбъемамДоходы" Тогда
		
		ЗаполнитьПоВыполненнымОбъемам("Доходы");
		
	ИначеЕсли Команда.Имя = "ЗаполнитьПоВыполненнымОбъемамРасходы" Тогда
		
		ЗаполнитьПоВыполненнымОбъемам("Расходы");
		
	КонецЕсли;
	
	Если Объект.Доходы.Количество() > 0 Тогда
		
		Элементы.Доходы.ТекущаяСтрока = 0;
		
	КонецЕсли;
	
	Если Объект.Расходы.Количество() > 0 Тогда
		
		Элементы.Расходы.ТекущаяСтрока = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте	
Процедура КомандаКопироватьСтрокуВладельцаВРаспределение(Команда)
	
	Результат = НастройкиПоИмениКоманды(Команда.Имя);	
	Если Результат = Неопределено Тогда
		Возврат;  // Возврат.
	КонецЕсли;	

	ИмяОсновнойТаблицы		= Результат.ИмяОсновнойТаблицы;
	ИмяТаблицыРаспределения = Результат.ИмяТаблицыРаспределения;
	ИмяКолонкиСумма 		= Результат.ИмяКолонкиСумма;
	УчитыватьКоличество		= Результат.УчитыватьКоличество;
				
	упоАналитикаПоПодразделениямКлиент.СкопироватьСтрокуВладельцаВРаспределениеСОчисткой(ЭтаФорма, 
																						ИмяОсновнойТаблицы, 
																						ИмяТаблицыРаспределения, 
																						ИмяКолонкиСумма, 
																						УчитыватьКоличество);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыделитьНДС(Команда)
	
	Результат = НастройкиПоИмениКоманды(Команда.Имя);	
	Если Результат = Неопределено Тогда
		Возврат;  // Возврат.
	КонецЕсли;	
	
	ИмяОсновнойТаблицы		= Результат.ИмяОсновнойТаблицы;
	ИмяТаблицыРаспределения = Результат.ИмяТаблицыРаспределения;
	ИмяКолонкиСумма 		= Результат.ИмяКолонкиСумма;
	УчитыватьКоличество		= Результат.УчитыватьКоличество;		
			
	ТекущиеДанные = Элементы[ИмяОсновнойТаблицы].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;  // Возврат.
	КонецЕсли;		
	
	// Заполнение по умолчанию.
	СтрокиРаспределенияПоПодразделениям = упоПроектыИЗадачиОбщие.ПолучитьСтрокиРаспределенияПоПодразделениям(
																								ТекущиеДанные, 
																								Объект[ИмяТаблицыРаспределения], 
																								Истина);
	Если СтрокиРаспределенияПоПодразделениям.Количество() = 0 Тогда									
		упоАналитикаПоПодразделениямКлиент.СкопироватьСтрокуВладельцаВРаспределениеСОчисткой(ЭтаФорма, 
																								ИмяОсновнойТаблицы, 
																								ИмяТаблицыРаспределения, 
																								ИмяКолонкиСумма, 
																								УчитыватьКоличество);
	КонецЕсли;					
	
	// НДС.
	СтрокаВладелец = Новый Структура;
	СтрокаВладелец.Вставить("Валюта", ТекущиеДанные.Валюта); 
	СтрокаВладелец.Вставить("Договор", ТекущиеДанные.Договор);
	СтрокаВладелец.Вставить("ИндексСтрокРаспределения", ТекущиеДанные.ИндексСтрокРаспределения);
	СтрокаВладелец.Вставить("Сумма", ТекущиеДанные[ИмяКолонкиСумма]);			
						
	ВыделитьНДС(СтрокаВладелец, ИмяОсновнойТаблицы);		
	
	// Итоги.
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, 
																		ИмяОсновнойТаблицы, 
																		ИмяТаблицыРаспределения, 
																		ИмяКолонкиСумма);
			
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
