// Выполнить действия при подборе.
//
// Параметры:
//  СтрокаТабличнойЧасти - ДанныеФормыЭлементКоллекции, Структура - строка данных, над которой выполняются действия.
//  ПараметрыПодбора	 - Структура - параметры подбора.
&НаКлиенте
Процедура ВыполнитьДействияПриПодборе(СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт
	
	Если ТипЗнч(ПараметрыПодбора) = Тип("Структура") Тогда
		
		Если ПараметрыПодбора.Свойство("ПараметрыПодбораСписок") Тогда
			
			ЗаполнитьЗначенияСвойств(ПараметрыПодбора.СтруктураСтроки, СтрокаТабличнойЧасти);			
			упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодборе(ПараметрыПодбора.СтруктураСтроки,
				ПараметрыПодбора.ПараметрыПодбораСписок, ПараметрыПодбора.СвойстваОбъекта);
			ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ПараметрыПодбора.СтруктураСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеВидимостьюЭлементов_АналитикаПоПодразделениям()
	
	СтруктураСвойств = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Проект);
	ИспользоватьАналитикуКонтрагентДляСС = СтруктураСвойств.ИспользоватьАналитикуКонтрагентДляСС;
	
	ЕстьРаспределениеДоходов = СтруктураСвойств.ДоходыПоПодразделениям;
	ЕстьРаспределениеРасходов = СтруктураСвойств.РасходыПоПодразделениям;
	ДоходыПоНатуральнымПоказателям = СтруктураСвойств.ДоходыПоНатуральнымПоказателям;
	РасходыПоНатуральнымПоказателям =  СтруктураСвойств.РасходыПоНатуральнымПоказателям;

	Элементы.РаспределениеДоходов.Видимость = ЕстьРаспределениеДоходов;
	
	Элементы.ДоходыНоменклатура.Видимость = ДоходыПоНатуральнымПоказателям;
	Элементы.ДоходыЕдиницаИзмерения.Видимость = ДоходыПоНатуральнымПоказателям;
	Элементы.ДоходыКоличество.Видимость = ДоходыПоНатуральнымПоказателям;
	Элементы.ДоходыСтоимость.Видимость = ДоходыПоНатуральнымПоказателям;
	
	Элементы.РаспределениеРасходов.Видимость = ЕстьРаспределениеРасходов;
	
	Элементы.РасходыНоменклатура.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РасходыЕдиницаИзмерения.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РасходыКоличество.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РасходыСтоимость.Видимость = РасходыПоНатуральнымПоказателям;
	
	Элементы.РаспределениеРасходовКоличество.Видимость = РасходыПоНатуральнымПоказателям;
	Элементы.РаспределениеДоходовКоличество.Видимость = ДоходыПоНатуральнымПоказателям;
	
КонецПроцедуры

