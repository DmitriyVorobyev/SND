// Функция формирует таблицу данных для проверки корректности заполнения реквизитов документа.
// 
// Параметры: 
//  ДанныеДокумента - Тип: Структура, содержит список таблиц (ключи структуры),
//                    состоящий из шапки и всех табличных частей документа.
//                    Является полным слепком документа.
//  Условие         - Тип: Произвольный, содержит некое условие.
// 
// Возвращаемое значение: 
//  Тип: ТаблицаЗначений, сформированная таблица данных.
// 
Функция СформироватьТаблицуХранимыхДанных(ДанныеДокумента)
	
	// Определим момент времени запроса
	МоментВремениЗапроса = упоРабочиеКалендариВызовСервера.обПолучитьМоментВремениДокумента(ЭтотОбъект);
	
	// Формируем запрос
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", МоментВремениЗапроса);
	Запрос.УстановитьПараметр("Пользователь", ДанныеДокумента.Пользователь);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДиспетчерыСистемыСрезПоследних.Сотрудник
	               |ИЗ
	               |	РегистрСведений.упоДиспетчерыСистемы.СрезПоследних(&Дата, Пользователь = &Пользователь) КАК ДиспетчерыСистемыСрезПоследних
	               |ГДЕ
	               |	ДиспетчерыСистемыСрезПоследних.ФлагУправления = ИСТИНА";
	
	// Запускаем запрос
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СообщитьОбОшибкеПроверкиДанных(ДанныеДокумента, ИмяТабличнойЧасти, СтрокаТаблицы, Отказ, Заголовок)
	
	ПредставлениеТабличнойЧасти = ЭтотОбъект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти].Представление();
	ЗаголовокСтрокиСообщения = упоСервисныеФункцииВызовСервера.обСформироватьЗаголовокОшибкиВСтрокеТЧ(ПредставлениеТабличнойЧасти, СтрокаТаблицы.НомерСтроки);
	
	СтрокаСообщения = ЗаголовокСтрокиСообщения
		                + "Диспетчер """ + СокрЛП(ДанныеДокумента.Пользователь)
						+ """ уже управляет сотрудником """ + СокрЛП(СтрокаТаблицы.Сотрудник) + "";
						
	обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок);
	
КонецФункции

