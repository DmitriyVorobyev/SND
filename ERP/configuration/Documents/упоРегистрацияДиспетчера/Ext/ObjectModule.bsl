Процедура лмПроверитьЗаполнениеРеквизитов(Отказ) Экспорт
	
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Процедура проверяет корректность данных документа для записи в базу.
// 
// Параметры:
//	ДанныеДокумента - Структура - данные документа.
//  Отказ        	- Булево - признак отказа от выполнения операции.
//  Заголовок   	- Строка - содержит заголовок сообщения.
//
Процедура ПроверитьДанные(ДанныеДокумента, Отказ, Заголовок) Экспорт
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем хранимые данные (с чем сравнивать)
	ТаблицаХранимыхДанныхСотрудники = СформироватьТаблицуХранимыхДанных(ДанныеДокумента);
	
	// Проверяем данные
	Для Каждого СтрокаТаблицы Из ДанныеДокумента.Сотрудники Цикл
		НайденнаяСтрока = ТаблицаХранимыхДанныхСотрудники.Найти(СтрокаТаблицы.Сотрудник, "Сотрудник");
		Если Не НайденнаяСтрока = Неопределено Тогда 
			СообщитьОбОшибкеПроверкиДанных(ДанныеДокумента, "Сотрудники",
			                          СтрокаТаблицы, Отказ, Заголовок);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

