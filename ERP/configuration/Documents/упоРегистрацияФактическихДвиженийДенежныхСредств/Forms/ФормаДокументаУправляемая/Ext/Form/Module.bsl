#КонецОбласти

&НаКлиенте
Процедура ОткрытьФормуВыбораПроектнойЗадачи()
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	ПараметрыОткрытия.Вставить("ЭтоФормаВыбораПроектнойЗадачи", Истина); 
	Если ЗначениеЗаполнено(Объект.Проект) И Не ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
		// При вводе на основании проекта предзаполнен только проект.
		ПараметрыОткрытия.Вставить("ТекущаяСтрока", Объект.Проект);
	Иначе
		ПараметрыОткрытия.Вставить("ТекущаяСтрока", Объект.ПроектнаяЗадача);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Проекты.Форма.упоФормаСпискаУправляемая", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти
