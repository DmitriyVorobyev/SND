// Процедура для вызова при подборе ресурсов.
//
// Параметры:
//  СтрокаТабличнойЧасти - СтрокаТабличнойЧасти	 - строка табличной части "ДвиженияДенежныхСредств". 
//  ПараметрыПодбора	 - СписокЗначений со вспомогательными параметрами.
//
Процедура ВыполнитьДействияПриПодборе(Знач СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт
	
	Если НЕ ПараметрыПодбора = Неопределено Тогда      
		
		Для каждого ПараметрПодбора Из ПараметрыПодбора Цикл
			
			// прямое обращение к реквизитам на всякий случай оборачиваем в try
			Попытка 				
				Если ПараметрПодбора.Представление = "ИмяТабличнойЧасти" Тогда      					
					Если ПараметрПодбора.Значение = "ДвиженияДенежныхСредств" Тогда     
						
						// попробуем определить договор контрагента по умолчанию
						
						Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Контрагент) Тогда      
							СтрокаТабличнойЧасти.Договор = СтрокаТабличнойЧасти.Контрагент.упоОсновнойДоговорКонтрагента;
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Договор) Тогда      
							СтрокаТабличнойЧасти.Валюта = упоУправлениеФормамиСервер.ПолучитьВалютуДоговораКонтрагента(СтрокаТабличнойЧасти.Договор);
						Иначе
							СтрокаТабличнойЧасти.Валюта = мВалютаУправленческогоУчета;
						КонецЕсли;
					КонецЕсли; 			
					
					Продолжить;
				КонецЕсли; 
				
			// устанавливаем только те колонки, которые еще не были заполнены пользователем.
				
			Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти[ПараметрПодбора.Представление]) Тогда    
				Если ТипЗнч(ПараметрПодбора.Значение) = Тип("ПеречислениеСсылка.упоНаправлениеДвиженияДенежныхСредств") Тогда
					Попытка
						Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтатьяДДС) 
							И ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтатьяДДС.упоНаправлениеДвижения) Тогда
							
							СтрокаТабличнойЧасти.НаправлениеДвижения = СтрокаТабличнойЧасти.СтатьяДДС.упоНаправлениеДвижения;
							
						Иначе
							СтрокаТабличнойЧасти[ПараметрПодбора.Представление]	= ПараметрПодбора.Значение;	
						КонецЕсли; 
					Исключение
						// Прямое обращение к реквизитам строки вне точного контекста
						// на всякий случай заворачиваем в try.
					КонецПопытки;	
				КонецЕсли;
			КонецЕсли; 			
				
			Исключение
				// некорректное имя колонки.
			КонецПопытки;
			
		КонецЦикла; 
		
	Иначе
		упоРесурсыИНормыВызовСервера.обПриИзмененииРесурсаТабЧасти(СтрокаТабличнойЧасти, ЭтотОбъект);	
	КонецЕсли; 

КонецПроцедуры // ЗаписатьСсылку()

