// Получает таблицу правил наложения реквизитов документа на измерения, ресурсы и реквизиты регистров.
//  Правила передаются в виде иерархическая структуры.
//
// Параметры:
//  ДанныеДокумента	 - Произвольный	 - не используется
// 
// Возвращаемое значение:
//  Структура - иерархический набор пар <ИмяРеквизитаДокумента>:<ИмяРеквизитаРегистра>.
//
Функция ПолучитьПравилаНаложенияРеквизитовНаРегистр(ДанныеДокумента) Экспорт

	ПравилаНаложения = Новый Структура();
	
	// Для каждого из регистров описывается, по какой из таблиц документа
	// строится список движений, и какие реквизиты куда записать
	// Если требуется добавлять в запись реквизиты шапки, отмечаем их
	// префиксом "Шапка_". 
	
	Правила = Новый Структура();
	ПравилаНаложения.Вставить(Движения.упоФактДвиженийДенежныхСредств.Метаданные().Имя, Правила);
	
	ПравилаТаблицы = Новый Структура();
	Правила.Вставить("ДвиженияДенежныхСредств", ПравилаТаблицы);
	
	// Делаем одно движение по ТЧ
	ПравилаДвижения = Новый Структура();
	ПравилаТаблицы.Вставить("ОпределениеФактаДДС", ПравилаДвижения);
	
	// Правила связи
	ПравилаДвижения.Вставить("ПроектнаяЗадача", "Шапка_ПроектнаяЗадача");
	ПравилаДвижения.Вставить("Контрагент", "Контрагент");
	ПравилаДвижения.Вставить("Договор", "Договор");
	ПравилаДвижения.Вставить("СтатьяДДС", "СтатьяДДС");
	ПравилаДвижения.Вставить("ВидПлатежа", "ВидПлатежа");
	ПравилаДвижения.Вставить("НаправлениеДвижения", "НаправлениеДвижения");
	ПравилаДвижения.Вставить("ДатаДвижения", "ДатаДвижения");
	ПравилаДвижения.Вставить("Валюта", "Валюта");
	ПравилаДвижения.Вставить("СуммаВалютная", "Сумма");
	ПравилаДвижения.Вставить("КомментарийДвижения", "КомментарийДвижения");
	ПравилаДвижения.Вставить("ДатаПлатежногоДокумента", "ДатаПлатежногоДокумента");
	ПравилаДвижения.Вставить("НомерПлатежногоДокумента", "НомерПлатежногоДокумента");
		
	Возврат ПравилаНаложения; 

КонецФункции // ПолучитьПравилаНаложенияРеквизитовНаРегистр()
 
// Получает подготовленные данные для движений по регистрам и обрабатывает их в соответствии со своими нуждами.
//
// Параметры:
//  ДанныеДокумента	 - Структура				 - структура данных документа.
//  ДанныеДвижений	 - Структура				 - структура данных движений по регистрам.
//  Отказ			 - Булево					 - признак отказа от записи документа.
//  РежимПроведения	 - РежимПроведенияДокумента	 - в данный параметр передается текущий режим проведения.
//
Процедура ПодготовитьДанныеДляДвижений(ДанныеДокумента, ДанныеДвижений, Отказ, РежимПроведения) Экспорт

	// Здесь можно расположить бизнес-логику дополнительной обработки
	// данных движений регистров.
	
	Для каждого Движение Из Движения Цикл
		
		ИмяДвижения = Движение.Метаданные().Имя;
		
		ТаблицаДвижения = ДанныеДвижений[ИмяДвижения];
		упоМодульВалютногоУчета.ЗаполнитьСуммуУправленческогоУчета(ТаблицаДвижения);
		
		// Свертка данных по упоФактДвиженийДенежныхСредств
		Если ИмяДвижения = "упоФактДвиженийДенежныхСредств" Тогда
			
			Документы.упоРегистрацияФактическихДвиженийДенежныхСредств.ПодготовитьДанныеупоФактДвиженийДенежныхСредств(ТаблицаДвижения);			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ПодготовитьДанныеДвижений()

