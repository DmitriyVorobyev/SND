// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Основание    - Произвольный, значение, которое используется как основание для заполнения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаЗаполнения(Основание) Экспорт
	
	Если ТипЗнч(Основание)=Тип("Неопределено") Тогда 
		Возврат;
	КонецЕсли; 
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		ПроектнаяЗадача = Основание;
		Проект = Основание.Проект;
		
		Версия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект);
		Документы.упоРегистрацияФактическихДвиженийДенежныхСредств.ЗаполнитьДокументПоОснованию(ЭтотОбъект, ПроектнаяЗадача,Версия); 
	ИначеЕсли ТипЗнч(Основание) = Тип("СправочникСсылка.Проекты") Тогда
		Проект = Основание;
	КонецЕсли; 
	
КонецПроцедуры // ОбработкаЗаполнения()

