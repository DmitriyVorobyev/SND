	Документы.упоТабельУчетаРабочегоВремени.ЗаполнитьРабочимиЗаданиями(Объект.ПроектныеЗадачи, 
																		Объект.Дата, 
																		Объект.Ресурс, 
																		Истина);
		
	врКэш = Новый Соответствие;
	Для Каждого СтрокаТабеля Из Объект.ТабельДня Цикл
		ПроверитьСтрокуТабеля(СтрокаТабеля, врКэш);
