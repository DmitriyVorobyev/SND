КонецПроцедуры

&НаКлиенте
Процедура ТабельДняДлительностьВЧасахПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		ПересчитатьДатуОкончанияИСроки(ТекДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняВидОперацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	ТекЗадача = ТекДанные.Задача;
	Если НЕ ЗначениеЗаполнено(ТекЗадача) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	РазделУчета = ПолучитьРазделУчета(ТекЗадача);	
	
	ОткрытьФормуВыбораВидаОперации(Элемент, Элементы.ТабельДня, РазделУчета, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекЗадача = ТекДанные.Задача;
	
	Если НЕ ЗначениеЗаполнено(ТекЗадача) Тогда
		Возврат;
	КонецЕсли;
	
	РазделУчета = ПолучитьРазделУчета(ТекЗадача);	
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.РазделУчета", РазделУчета);
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(ПараметрВыбора);	
	МассивПараметровВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
	Элементы.ТабельДняВидОперации.ПараметрыВыбора = МассивПараметровВыбора;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняНачалоПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;	
	Если ТекДанные = Неопределено Тогда	
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.Начало > ТекДанные.Окончание Тогда 
		ТекДанные.Окончание = ТекДанные.Начало; 
		ПересчитатьСрокиСледующейЗадачи(ТекДанные, Объект);
	КонецЕсли;	
	
	ПересчитатьСрокиПредыдущейЗадачи(ТекДанные, Объект);
	ПересчитатьДлительностьВСтроке(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняОкончаниеПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда	
		Если ТекДанные.Окончание < ТекДанные.Начало Тогда 
			ТекДанные.Начало = ТекДанные.Окончание; 
			ПересчитатьСрокиПредыдущейЗадачи(ТекДанные, Объект);
		КонецЕсли;
		ПересчитатьСрокиСледующейЗадачи(ТекДанные, Объект);
		ПересчитатьДлительностьВСтроке(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ПараметрыПеретаскивания.Значение.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВходящееЗначение = ПараметрыПеретаскивания.Значение[0];
	
	ДобавитьЗадачуВТабель(ВходящееЗначение, Строка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗадачуВТабель(ДанныеЗадачиЗадача, ИдСтрокиКуда = Неопределено)
	
	Если ИдСтрокиКуда = Неопределено Тогда
		НоваяСтрока = Объект.ТабельДня.Добавить();
	Иначе
		НоваяСтрока = Объект.ТабельДня.НайтиПоИдентификатору(ИдСтрокиКуда);
	КонецЕсли;
		
	Если ТипЗнч(ДанныеЗадачиЗадача) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗадачиЗадача);
	Иначе
		НоваяСтрока.Задача = ДанныеЗадачиЗадача;
	КонецЕсли;
	
	ЗаполнитьДопДанныеСтрокиТабеля(НоваяСтрока.ПолучитьИдентификатор());
	
	Если ИдСтрокиКуда = Неопределено Тогда
		ОбработатьДобавлениеНовойСтрокиКлиент(НоваяСтрока);
	Иначе
		УстановитьВидОперацииПоТипуЗадачи(НоваяСтрока); // Перетащили в 
	КонецЕсли;
	
	Если НоваяСтрока.ПроектПометкаУдаления Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Выбран проект, помеченный на удаление!'");
		Сообщение.Сообщить();			
	КонецЕсли;
	
	Если НоваяСтрока.ПроектнаяЗадачаПометкаУдаления Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Выбрана проектная задача, помеченная на удаление!'");
		Сообщение.Сообщить();			
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТабельДняЗадачаПриИзменении(Элемент)
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ЗаполнитьДопДанныеСтрокиТабеля(ТекДанные.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекДанные.Окончание = ТекДанные.Начало;
		ПересчитатьСрокиСледующейЗадачи(ТекДанные, Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <= КонецДня(ЭтаФорма.ДатаЗапрета) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = '""Установлена дата запрета:'") + " """+ЭтаФорма.ДатаЗапрета+"""";
		Сообщение.Сообщить();
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроектныеЗадачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Объект.ПроектныеЗадачи.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(Поле.Имя, "ПроектныеЗадачи", "");
	
	Если ИмяПоля = "Наименование" Тогда
		Если ЗначениеЗаполнено(ТекСтрока.Задача) Тогда
			ИмяПоля = "Задача";
		Иначе
			ИмяПоля = "ПроектнаяЗадача";
		КонецЕсли;
	КонецЕсли;
	
	ПоказатьЗначение( , ТекСтрока[ИмяПоля]);
	
КонецПроцедуры

&НаКлиенте
Процедура ТабельДняВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Объект.ТабельДня.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ТекСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(Поле.Имя, "ТабельДня", "");
	
	Если ИмяПоля <> "Проект" И ИмяПоля <> "Задача" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ПоказатьЗначение(, ТекСтрока[ИмяПоля]);	
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПорученийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = ТаблицаПоручений.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ТекСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;	
	ПоказатьЗначение(, ТекСтрока.Задача);	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТабельДня

&НаКлиенте
Процедура ТабельДняРольПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПодразделенияРоли = ПодразделенияРоли(ТекДанные.Роль);
	
	Если Не ЗначениеЗаполнено(ТекДанные.Роль) 
		Или Не ЗначениеЗаполнено(ПодразделенияРоли) Тогда
		ТекДанные.Подразделение = Неопределено;
		Элементы.ТабельДняПодразделение.ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;
	
	НайденноеПодразделение = ПодразделенияРоли.НайтиПоЗначению(ТекДанные.Подразделение);
	Если НайденноеПодразделение = Неопределено Тогда
		НайденноеПодразделение = ПодразделенияРоли[0];
	КонецЕсли;
	
	ТекДанные.Подразделение = НайденноеПодразделение.Значение;
	Элементы.ТабельДняПодразделение.ТолькоПросмотр = Ложь;
	
	ЗаполнитьДопДанные();
	
КонецПроцедуры

