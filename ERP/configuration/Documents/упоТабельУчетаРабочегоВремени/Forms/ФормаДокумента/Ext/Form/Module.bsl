&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьТабельДня(ЭтаФорма, МассивИдентификаторовУдаляемыхСтрок)
			
	Если МассивИдентификаторовУдаляемыхСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	ТабельДня = ЭтаФорма.Объект.ТабельДня;
	
	Для Каждого СтрокаИдентификатор Из МассивИдентификаторовУдаляемыхСтрок Цикл	
		ТабельДня.Удалить(ТабельДня.НайтиПоИдентификатору(СтрокаИдентификатор));
	КонецЦикла; 
		
КонецПроцедуры
 
&НаСервере
Функция ЗаполнитьПоручения()
	
	ТаблицаПоручений.Очистить();
	
	ПолученныеПоручения = упоРаспределениеТрудозатратВызовСервера.ЗаполнитьВнепроектныеЗадачи(Объект.Ресурс, НачалоДня(Объект.Дата),
		КонецДня(Объект.Дата));
		
	ТаблицаПоручений.Загрузить(ПолученныеПоручения);
		
КонецФункции

&НаСервере
Функция ПервичноеЗаполнение() 
	
	Объект.Дата = КонецДня(ТекущаяДатаСеанса());
	
	ДатаНаФорме = Объект.Дата;
	
	МассивИдентификаторовУдаляемыхСтрок = ПолучитьИдентификаторыЗадачДляОчистки();
	
	ОчиститьТабельДня(ЭтаФорма, МассивИдентификаторовУдаляемыхСтрок);
	
	Если ЗначениеЗаполнено(Объект.Ресурс) Тогда
		РесурсВСписке = СписокТрудовыхРесурсовПользователя.НайтиПоЗначению(Объект.Ресурс);	
		Если РесурсВСписке = Неопределено Тогда
			Объект.Ресурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
			Объект.ТабельДня.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ресурс) Тогда
		УстановитьТрудовойРесурс();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ресурс) Тогда
		ЗаполнитьПроектныеЗадачи();
	Иначе
		ЗаполнитьДопДанные();
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЗаполнитьСписокТрудовыхРесурсовПользователя() 
	
	ДоступныВсеРесурсы = РольДоступна("ПолныеПрава") ИЛИ РольДоступна("упоДобавлениеИзменениеТабеляРабочегоВремениБезОграничений");	
	МассивТР = Документы.упоТабельУчетаРабочегоВремени.ПолучитьМассивТрудовыхРесурсовПользователя();		
	СписокТрудовыхРесурсовПользователя.ЗагрузитьЗначения(МассивТР);	
	
КонецФункции

&НаСервере
Функция УстановитьТрудовойРесурс()

	УстановитьПривилегированныйРежим(Истина);
	МассивРесурсов = упоРесурсыИРолиСервер.ПолучитьТрудовыеРесурсыТекущегоСотрудника();
	Если МассивРесурсов.Количество() = 1 Тогда
		Объект.Ресурс = МассивРесурсов[0];
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ресурс) И СписокТрудовыхРесурсовПользователя.Количество() = 1 Тогда
		Объект.Ресурс = СписокТрудовыхРесурсовПользователя[0].Значение;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПроверитьСоответствиеТрудовогоРесурсаПриИзменении()

	Если Не ЗначениеЗаполнено(Объект.Ресурс) Тогда
		Объект.ТабельДня.Очистить();
		Объект.ПроектныеЗадачи.Очистить();
		Возврат;
	КонецЕсли; 
	
	Если Не упоРесурсыИРолиСервер.РесурсУправляетсяТекущимПользователем(Объект.Ресурс) Тогда
		ТекстСообщения = НСтр("ru = 'Текущий пользователь не является владельцем выбранного трудового ресурса ""%1"".'");
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстСообщения, Объект.Ресурс), , "Объект.Ресурс");
		
		Объект.Ресурс = Справочники.упоТрудовыеРесурсы.ПустаяСсылка();
	КонецЕсли; 
	
КонецПроцедуры 

&НаКлиенте
Функция ОбработатьДобавлениеНовойСтрокиКлиент(ТекДанные = Неопределено, СтрокаСкопирована = Ложь) 
	
	Если ТекДанные = Неопределено Тогда
		ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	КонецЕсли;	
		
	Если ТекДанные <> Неопределено Тогда
		
		ТекДата = ОбщегоНазначенияКлиент.ДатаСеанса();

		Если УчитыватьТекВремя(ЭтаФорма, Объект) Тогда
			ТекВремя = ТекДата;
		Иначе
			Если Объект.ТабельДня.Количество() > 1 Тогда
				НомерТекСтроки = ТекДанные.НомерСтроки;
				Если НомерТекСтроки = 1 Тогда
					ТекВремя = ВремяНачалаДня;
				Иначе
					ПредСтрока = Объект.ТабельДня[НомерТекСтроки-2];
					ТекВремя = ПредСтрока.Окончание
				 КонецЕсли;
			Иначе
				ТекВремя = ВремяНачалаДня;
			КонецЕсли;
		КонецЕсли;
		
		ТекДанные.Начало = ТекВремя;
		ТекДанные.Окончание = ТекВремя;
		
		ПересчитатьСрокиПредыдущейЗадачи(ТекДанные, Объект);
		ПересчитатьСрокиСледующейЗадачи(ТекДанные, Объект);
		
		ПересчитатьДлительностьВСтроке(ТекДанные);
		
		Если НЕ СтрокаСкопирована Тогда
			
			УстановитьВидОперацииПоТипуЗадачи(ТекДанные);
			
		КонецЕсли; 			
		
	КонецЕсли;	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидОперацииДляПроектнойЗадачи(ПроектнаяЗадача)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации КАК ВидОперации,
	|	упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации.РазделУчета КАК РазделУчетаВидаОперации
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	|			И (упоВерсииПроекта.Текущая)";
	
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВидОперации = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоВидыОпераций.Явка");
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ВидОперации;		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();	
	Выборка.Следующий(); 		
	РазделУчетаПроектнаяЗадача = 
		ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача");
	Если ЗначениеЗаполнено(Выборка.РазделУчетаВидаОперации) 
		И Выборка.РазделУчетаВидаОперации = РазделУчетаПроектнаяЗадача Тогда
		ВидОперации = Выборка.ВидОперации;
	КонецЕсли;			
	
	Возврат ВидОперации;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидОперацииПоТипуЗадачи(ТекДанные)
	
	Задача = ТекДанные.Задача;
	
	Если Задача = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(Задача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		
		ВидОперации = ПолучитьВидОперацииДляПроектнойЗадачи(Задача);
		
	ИначеЕсли ТипЗнч(Задача) = Тип("СправочникСсылка.упоВнепроектныеЗадачи")
		Или ТипЗнч(Задача) = Тип("СправочникСсылка.упоПричиныПотерьРабочегоВремени") Тогда 
		
		ВидОперации = упоФункцииБСП.ПолучитьЗначениеРеквизита(Задача, "ВидОперации");
		
	Иначе	
		
		ОбъектЗадачи = упоФункцииБСП.ПолучитьЗначениеРеквизита(Задача, "ОбъектБазы");
		Если ТипЗнч(ОбъектЗадачи) = Тип("СправочникСсылка.упоВнепроектныеЗадачи") Тогда
			ВидОперации = упоФункцииБСП.ПолучитьЗначениеРеквизита(ОбъектЗадачи, "ВидОперации");
		ИначеЕсли ТипЗнч(ОбъектЗадачи) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда 
			ВидОперации = ПолучитьВидОперацииДляПроектнойЗадачи(ОбъектЗадачи);	
		Иначе
			ВидОперации = ПредопределенноеЗначение("Справочник.упоВидыОпераций.ПустаяСсылка");						
		КонецЕсли; 
		
	КонецЕсли;	
	
	ТекДанные.ВидОперации = ВидОперации;
	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСрокиПредыдущейЗадачи(ТекДанные, Объект) 
	
	ТекСтрока = ТекДанные; 
	
	Пока Истина Цикл
		
		ПредСтрока = ПолучитьПредыдущуюСтроку(ТекСтрока, Объект);
		Если ПредСтрока = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если ПредСтрока.Окончание = ТекСтрока.Начало Тогда
			Прервать;
		КонецЕсли;
		
		ПредСтрока.Окончание = ТекСтрока.Начало;	
		
		Если ПредСтрока.Окончание < ПредСтрока.Начало Тогда
			ПредСтрока.Начало = ПредСтрока.Окончание;
		КонецЕсли;
		
		ПересчитатьДлительностьВСтроке(ПредСтрока);
		
		ТекСтрока = ПредСтрока;
		
	КонецЦикла;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредыдущуюСтроку(ТекущаяСтрока, Объект) 
	
	НомерТекущейСтроки = ТекущаяСтрока.НомерСтроки;
	ИндексПредыдущейСтроки = НомерТекущейСтроки - 2;	
	
	Если ИндексПредыдущейСтроки >= 0 Тогда
		
		Возврат Объект.ТабельДня[ИндексПредыдущейСтроки];
		
	Иначе
		
		Возврат Неопределено;

	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСрокиСледующейЗадачи(ТекДанные, Объект, МенятьДлительность = Истина) 
		
	ТекСтрока = ТекДанные;
	
	Пока Истина Цикл
		
		СледСтрока = ПолучитьСледующуюСтроку(ТекСтрока, Объект);
		Если СледСтрока = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если СледСтрока.Начало = ТекСтрока.Окончание Тогда
			Прервать;
		КонецЕсли;
		
		СледСтрока.Начало = ТекСтрока.Окончание;
		
		Если МенятьДлительность Тогда			
			Если СледСтрока.Начало > СледСтрока.Окончание Тогда
				СледСтрока.Окончание = СледСтрока.Начало;
			КонецЕсли;
			ПересчитатьДлительностьВСтроке(СледСтрока);			
		Иначе
			
			ПересчитатьДатуОкончания(СледСтрока);
						
		КонецЕсли;	
				
		ТекСтрока = СледСтрока;
		
	КонецЦикла;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьДатуОкончания(ТекущаяСтрока) 
	
	ВремяОкончания = ТекущаяСтрока.Начало + ТекущаяСтрока.ДлительностьВЧасах * 3600;
	Если ВремяОкончания >= Дата("00010102000000") Тогда
		ТекущаяСтрока.Окончание = Дата("00010101235959");
		ПересчитатьДлительностьВСтроке(ТекущаяСтрока);
	Иначе
		ТекущаяСтрока.Окончание = ВремяОкончания;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьДатуОкончанияИСроки(Строка)
	
	ПересчитатьДатуОкончания(Строка);
	ПересчитатьСрокиСледующейЗадачи(Строка, Объект, Ложь);	 	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСледующуюСтроку(ТекущаяСтрока, Объект) 
	
	НомерТекущейСтроки = ТекущаяСтрока.НомерСтроки;
	ИндексСледующейСтроки = НомерТекущейСтроки;	
	
	Если ИндексСледующейСтроки < Объект.ТабельДня.Количество() Тогда
		
		Возврат Объект.ТабельДня[ИндексСледующейСтроки];
		
	Иначе
		
		Возврат Неопределено;

	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьДлительностьВСтроке(СтрокаТЧ)
	
	ДатаНачало = НачалоМинуты(СтрокаТЧ.Начало);
	ДатаОкончание = СтрокаТЧ.Окончание;
	
	Если Не ДатаОкончание = КонецДня("00010101") Тогда
		ДатаОкончание = НачалоМинуты(ДатаОкончание);
	КонецЕсли;
	
	РазностьВСекундах = ДатаОкончание - ДатаНачало;
	СтрокаТЧ.ДлительностьВЧасах = РазностьВСекундах / 3600;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьДоступностьЭлементов(ЭтаФорма, Объект)
	ЭтаФорма.Элементы.ПроектныеЗадачиГруппаДопИнформация.Видимость = ЭтаФорма.Элементы.ПроектныеЗадачиКомандаПроектныеЗадачиДопИнформация.Пометка;
	ЭтаФорма.Элементы.ПроектныеЗадачиРуководительПроекта.Видимость = ЭтаФорма.Элементы.ПроектныеЗадачиКомандаПроектныеЗадачиДопИнформация.Пометка;
	ЭтаФорма.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр Или (КонецДня(ЭтаФорма.ДатаЗапрета) >= Объект.Дата);
	ЭтаФорма.Элементы.ТабельДняКомандаЗавершитьРаботу.Видимость = Ложь;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция УчитыватьТекВремя(ЭтаФорма, Объект)
	Возврат ЭтаФорма.Элементы.ТабельДняКомандаТабельДняУчитыватьТекущееВремя.Пометка;
КонецФункции 

&НаСервере
Функция ОбновитьДатуЗапрета() 
	ДатаЗапрета = Дата(1,1,1);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРольИПодразделениеПЗнаДату(ПЗ, Ресурс, Дата) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ресурс", Ресурс);
	Запрос.УстановитьПараметр("ПЗ", ПЗ);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Дата));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоРолиТрудовыхРесурсовСрезПоследних.Роль
	               |ПОМЕСТИТЬ РолиРесурса
	               |ИЗ
	               |	РегистрСведений.упоРолиТрудовыхРесурсов.СрезПоследних(, Ресурс = &Ресурс) КАК упоРолиТрудовыхРесурсовСрезПоследних
	               |ГДЕ
	               |	упоРолиТрудовыхРесурсовСрезПоследних.РольНазначена
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Ресурс,
	               |	упоДанныеПлановТрудозатратРолейСрезПоследних.Подразделение,
	               |	ЕСТЬNULL(упоВыделенныеТрудовыеРесурсыСрезПоследних.ДоляТрудозатрат, 0) КАК ДоляТрудозатрат
	               |ПОМЕСТИТЬ РесурсыПЗ
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	               |			,
	               |			ПроектнаяЗадача = &ПЗ
	               |				И Ресурс В
	               |					(ВЫБРАТЬ
	               |						РолиРесурса.Роль
	               |					ИЗ
	               |						РолиРесурса)) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоВыделенныеТрудовыеРесурсы.СрезПоследних(, Ресурс = &Ресурс) КАК упоВыделенныеТрудовыеРесурсыСрезПоследних
	               |		ПО упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача = упоВыделенныеТрудовыеРесурсыСрезПоследних.ПроектнаяЗадача
	               |			И упоДанныеПлановТрудозатратРолейСрезПоследних.Подразделение = упоВыделенныеТрудовыеРесурсыСрезПоследних.Подразделение
	               |			И упоДанныеПлановТрудозатратРолейСрезПоследних.Ресурс = упоВыделенныеТрудовыеРесурсыСрезПоследних.РольРесурса
	               |			И упоДанныеПлановТрудозатратРолейСрезПоследних.Версия = упоВыделенныеТрудовыеРесурсыСрезПоследних.Версия
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоДанныеПлановТрудозатратРолейСрезПоследних.Версия = упоВерсииПроекта.Версия И упоВерсииПроекта.Текущая
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК упоСрокиПроектныхЗадачСрезПоследних
	               |		ПО упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И упоДанныеПлановТрудозатратРолейСрезПоследних.Версия = упоСрокиПроектныхЗадачСрезПоследних.Версия
	               |ГДЕ
	               |	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан <= &КонецДня
	               |			И упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан >= &НачалоДня
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РесурсыПЗ.Ресурс КАК Роль,
	               |	РесурсыПЗ.Подразделение,
	               |	РесурсыПЗ.ДоляТрудозатрат КАК ДоляТрудозатрат
	               |ИЗ
	               |	РесурсыПЗ КАК РесурсыПЗ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДоляТрудозатрат УБЫВ";
				   
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Результат = Новый Структура("Роль, Подразделение");
		ЗаполнитьЗначенияСвойств(Результат, РезультатЗапроса[0]);
	Иначе
		 Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗаполнитьДопДанные(Обновлять = Истина) 
	
	Если Обновлять Тогда
		Документы.упоТабельУчетаРабочегоВремени.ОбновитьДопДанные(ДанныеЗадач, ЭтаФорма);	
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.ПроектныеЗадачи Цикл
		Документы.упоТабельУчетаРабочегоВремени.ЗаполнитьСтрокуТаблицыДопДанными(СтрокаТаблицы, ДанныеЗадач, ЭтаФорма);		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.ТабельДня Цикл
		Документы.упоТабельУчетаРабочегоВремени.ЗаполнитьСтрокуТаблицыДопДанными(СтрокаТаблицы, ДанныеЗадач, ЭтаФорма);		
	КонецЦикла;
	
КонецФункции

&НаСервере
Функция ЗаполнитьДопДанныеСтрокиТабеля(пСтрокаТабеля) 
	
	СтрокаТабеля = Объект.ТабельДня.НайтиПоИдентификатору(пСтрокаТабеля);
	
	ПроверитьСтрокуТабеля(СтрокаТабеля);
	
	Документы.упоТабельУчетаРабочегоВремени.ЗаполнитьСтрокуТаблицыДопДанными(СтрокаТабеля, ДанныеЗадач, ЭтаФорма, Истина);
	
	Если упоИнтеграцияEPMСервер.ИспользоватьПодсистемуРаспределениеЗарплаты() Тогда
		МодульРаспределениеЗарплатыСервер = ОбщегоНазначения.ОбщийМодуль("упоРаспределениеЗарплатыСервер");
		МодульРаспределениеЗарплатыСервер.ЗаполнитьВидОперацииСтрокиТабеля(СтрокаТабеля);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьСтрокуТабеля(СтрокаТабеля, пКэш = Неопределено) 
	
	ОсновныеПараметры = Документы.упоТабельУчетаРабочегоВремени.ОсновныеПараметрыСтроки(); 
	
	//
	
	Если Не ЗначениеЗаполнено(СтрокаТабеля.Задача) Тогда
		ЗаполнитьЗначенияСвойств(СтрокаТабеля, Новый Структура(ОсновныеПараметры),, "Задача");
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ТипЗнч(СтрокаТабеля.Задача) = Тип("ДокументСсылка.упоПроектнаяЗадача") 
			ИЛИ ТипЗнч(СтрокаТабеля.Задача) = Тип("СправочникСсылка.упоЗадания") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	//
	
	НужноИскать = Истина;
	РольИПодразделение = Неопределено; 
	
	Если пКэш <> Неопределено Тогда
		ДанныеКэша = пКэш.Получить(СтрокаТабеля.Задача);
		Если ДанныеКэша = -1 Тогда
			НужноИскать = Ложь;
		Иначе
			РольИПодразделение = ДанныеКэша; 
		КонецЕсли;
	КонецЕсли;
	
	Если НужноИскать И РольИПодразделение = Неопределено Тогда 
		РольИПодразделение = ПолучитьРольИПодразделениеПЗнаДату(СтрокаТабеля.Задача, Объект.Ресурс, Объект.Дата);	
		Если пКэш <> Неопределено Тогда 
			Если РольИПодразделение = Неопределено Тогда
				пКэш.Вставить(СтрокаТабеля.Задача, -1);
			Иначе
				пКэш.Вставить(СтрокаТабеля.Задача, РольИПодразделение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если РольИПодразделение = Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		ТекстСообщения = НСтр("ru = 'Трудовой ресурс не имеет ни одной роли из назначенных на 
		| проектную задачу в строке ""%1"" или день документа не попадает в ее сроки.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СтрокаТабеля.НомерСтроки);
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТабеля, Новый Структура(ОсновныеПараметры));
		
	Иначе
		
		ЗаполнитьЗначенияСвойств(СтрокаТабеля, РольИПодразделение);
		
	КонецЕсли;	
	
КонецФункции

&НаСервере
Функция ЗаполнитьПоОперативнойЗагрузкеСервер() 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ресурс", Объект.Ресурс);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Объект.Дата));
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя КАК ДатаВремя,
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача,
	               |	МАКСИМУМ(упоДанныеПлановТрудозатратРолейСрезПоследних.Подразделение) КАК Подразделение,
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Роль
	               |ИЗ
	               |	РегистрСведений.упоОперативнаяЗагрузкаСпециалистов.СрезПоследних(
	               |			,
	               |			ТрудовойРесурс = &Ресурс
	               |				И ДатаВремя >= &НачалоДня
	               |				И ДатаВремя <= &КонецДня) КАК упоОперативнаяЗагрузкаСпециалистовСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоДанныеПлановТрудозатратРолейСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
	               |		ПО упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача = упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача
	               |			И упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Роль = упоДанныеПлановТрудозатратРолейСрезПоследних.Ресурс
	               |ГДЕ
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Занят
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ПроектнаяЗадача,
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.ДатаВремя,
	               |	упоОперативнаяЗагрузкаСпециалистовСрезПоследних.Роль
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаВремя";
	
	Объект.ТабельДня.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПредСтрокаТабеля = Неопределено;
	Пока Выборка.Следующий() Цикл
		
		ДобавитьНовуюСтрока = Ложь;
		ДобавитьПромежуточнуюСтроку = Ложь;
		
		ВремяЗаписи = Дата(1,1,1, Час(Выборка.ДатаВремя), Минута(Выборка.ДатаВремя), Секунда(Выборка.ДатаВремя));
				
		Если ПредСтрокаТабеля <> Неопределено И ВремяЗаписи - ПредСтрокаТабеля.Окончание > 1 Тогда
			ДобавитьПромежуточнуюСтроку = Истина;
		КонецЕсли;		
		
		Если ДобавитьПромежуточнуюСтроку ИЛИ
		 ПредСтрокаТабеля = Неопределено ИЛИ 
		 ПредСтрокаТабеля.ПроектнаяЗадача <> Выборка.ПроектнаяЗадача Тогда
		 	ДобавитьНовуюСтрока = Истина;
		КонецЕсли;
		
		Если ДобавитьПромежуточнуюСтроку Тогда
			ПромежуточнаяСтрока = Объект.ТабельДня.Добавить();
			ПромежуточнаяСтрока.Начало = ПредСтрокаТабеля.Окончание;
			ПромежуточнаяСтрока.Окончание = ВремяЗаписи;
			ПересчитатьДлительностьВСтроке(ПромежуточнаяСтрока);
		КонецЕсли;
		
		Если ДобавитьНовуюСтрока Тогда
			ПредСтрокаТабеля = Объект.ТабельДня.Добавить();
			ПредСтрокаТабеля.Задача = Выборка.ПроектнаяЗадача;
			ПредСтрокаТабеля.ПроектнаяЗадача = Выборка.ПроектнаяЗадача;
			ПредСтрокаТабеля.Роль = Выборка.Роль;
			ПредСтрокаТабеля.Подразделение = Выборка.Подразделение;
			ПредСтрокаТабеля.Начало = ВремяЗаписи;
		КонецЕсли;
		
		ПредСтрокаТабеля.Окончание = КонецЧаса(ВремяЗаписи)+1;
		ПересчитатьДлительностьВСтроке(ПредСтрокаТабеля);
		
	КонецЦикла;
	                                    
	ЗаполнитьПроектныеЗадачи();
	
КонецФункции

&НаКлиенте
Процедура ПереместитьТекущуюСтроку(Направление) 
	
	ТекДанные = Элементы.ТабельДня.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Индекс = Объект.ТабельДня.Индекс(ТекДанные);
	НовыйИндекс = Индекс + Направление;
	
	Если НовыйИндекс < 0 Или НовыйИндекс >= Объект.ТабельДня.Количество() Тогда
		Возврат;
	КонецЕсли;
		
	Объект.ТабельДня.Сдвинуть(Индекс, Направление);			
	
	ПараметрыВремени = "Начало, Окончание";
	СтруктураПараметровВремени = Новый Структура(ПараметрыВремени);
	ЗаполнитьЗначенияСвойств(СтруктураПараметровВремени, ТекДанные);
	ЗаполнитьЗначенияСвойств(Объект.ТабельДня[НовыйИндекс], Объект.ТабельДня[Индекс], ПараметрыВремени);
	ЗаполнитьЗначенияСвойств(Объект.ТабельДня[Индекс], СтруктураПараметровВремени);
	
	Если Направление > 0 Тогда
		ТекСтрока = Объект.ТабельДня[Индекс];
	Иначе
		ТекСтрока = Объект.ТабельДня[НовыйИндекс];
	КонецЕсли;
	
	ПересчитатьДатуОкончанияИСроки(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораВидаОперации(Элемент, ТаблицаФормы, РазделУчета, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура("РазделУчета", РазделУчета);	
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	
	Контекст = Новый Структура;
	Контекст.Вставить("УИстроки", ТаблицаФормы.ТекущиеДанные.ПолучитьИдентификатор());

	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуВыбораВидаОперацииОкончание", ЭтотОбъект, Контекст);
	ОткрытьФорму("Справочник.упоВидыОпераций.ФормаВыбора", ПараметрыФормы, Элемент, , , , ОписаниеОповещения); 	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИдентификаторыЗадачДляОчистки()
	
	ДатаОтбора 							= ЭтаФорма.ДатаНаФорме;
	ДанныеФормыТабельДня	 			= ЭтаФорма.Объект.ТабельДня;
	МассивИдентификаторовУдаляемыхСтрок = Новый Массив;

	Для Каждого СтрокаДанных Из ДанныеФормыТабельДня Цикл	
				
		Если НЕ ЗначениеЗаполнено(СтрокаДанных.Задача) Тогда
			Продолжить;
		КонецЕсли;   
		
		ТекущееЗадание = СтрокаДанных.Задача;
		
		Если ТипЗнч(ТекущееЗадание) = Тип("СправочникСсылка.упоЗадания") Тогда
 			СрокиПЗ = ПолучитьПлановыеСрокиЗадачи(ТекущееЗадание);
		ИначеЕсли ТипЗнч(ТекущееЗадание) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			СрокиПЗ = Документы.упоПроектнаяЗадача.ПолучитьСроки(ТекущееЗадание);	
		Иначе
			Продолжить;
		КонецЕсли; 			
		
		Если СрокиПЗ["ДатаНачала"] > ДатаОтбора ИЛИ СрокиПЗ["ДатаЗавершения"] < ДатаОтбора Тогда
			МассивИдентификаторовУдаляемыхСтрок.Добавить(СтрокаДанных.ПолучитьИдентификатор());
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат МассивИдентификаторовУдаляемыхСтрок; 
	
КонецФункции

// Получает плановые даты начала и даты окончания Задания.
//
// Параметры:
//  Задание	 - СправочникСсылка.упоЗадание - Задание.
//
// Возвращаемое значение:
//	СтруктураСроки - Структура - ключи:
//		* ДатаНачала	 - Дата - плановая дата начала.
//		* ДатаЗавершения - Дата - плановая дата окончания.
//
&НаСервереБезКонтекста
Функция ПолучитьПлановыеСрокиЗадачи(Задание)
	
	СрокиПЗ = Новый Структура;
	СрокиПЗ.Вставить("ДатаНачала", '00010101');
	СрокиПЗ.Вставить("ДатаЗавершения", '00010101');
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСрокиЗаданий.ДатаНачалаПлан КАК ДатаНачала,
	               |	упоСрокиЗаданий.ДатаОкончанияПлан КАК ДатаЗавершения
	               |ИЗ
	               |	РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
	               |ГДЕ
	               |	упоСрокиЗаданий.Задание = &Задание";
	
	Запрос.УстановитьПараметр("Задание", Задание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СрокиПЗ;
	КонецЕсли; 
	
	Выборка = РезультатЗапроса.Выбрать();	
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(СрокиПЗ, Выборка);
	
	Возврат СрокиПЗ;
	
КонецФункции

&НаКлиенте
Процедура ВопросОчисткиТабеляДня(РезультатВопроса, МассивИдентификаторовУдаляемыхСтрок) Экспорт 
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ДатаНаФорме = НачалоДня(Объект.Дата);
		Возврат;
	КонецЕсли;
	
	Объект.Дата = КонецДня(ДатаНаФорме);
			
	ОбработатьИзменениеДатыТабеляНаСервере(МассивИдентификаторовУдаляемыхСтрок);
	
КонецПРоцедуры

&НаСервере
Процедура ОбработатьИзменениеДатыТабеляНаСервере(МассивИдентификаторовУдаляемыхСтрок)
	
	ОчиститьТабельДня(ЭтаФорма, МассивИдентификаторовУдаляемыхСтрок);
	ОчиститьПоручения(ЭтаФорма);
	
	ЗаполнитьПроектныеЗадачи();
	ЗаполнитьПодразделениеРесурса();
		
КонецПроцедуры	

// Обработчик описания оповещения открытия формы вида операций - окончание.
//
// Параметры:
//  ВидОперации				 - СправочникСсылка.упоВидыОпераций	- вид операции.
//  ДополнительныеПараметры	 - Структура	 					- дополнительные параметры.
//
&НаКлиенте
Процедура ОткрытьФормуВыбораВидаОперацииОкончание(ВидОперации, ДополнительныеПараметры) Экспорт
	
	Если ВидОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Объект.ТабельДня.НайтиПоИдентификатору(ДополнительныеПараметры.УИстроки);
	
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.ВидОперации = ВидОперации;
	КонецЕсли;
	
КонецПроцедуры

