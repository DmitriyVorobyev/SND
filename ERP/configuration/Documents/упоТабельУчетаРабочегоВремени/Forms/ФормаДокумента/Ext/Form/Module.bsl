	ЭтаФорма.Элементы.ТабельДняРоль.ТолькоПросмотр = Не ЭтоПолноправныйПользователь;
	
	УстановитьУсловноеОформление();
	
	ДатаНаФорме = Объект.Дата;
	
КонецПроцедуры	

&НаКлиенте
Функция ПолучитьРазделУчета(Задача)
	
	Если ТипЗнч(Задача) = Тип("СправочникСсылка.упоЗадания") Тогда
		Задача = упоФункцииБСП.ПолучитьЗначениеРеквизита(Задача, "ОбъектБазы");
	КонецЕсли; 
	
	Если ТипЗнч(Задача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
		РазделУчета = ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача");
	ИначеЕсли ТипЗнч(Задача) = Тип("СправочникСсылка.упоВнепроектныеЗадачи")
				ИЛИ ТипЗнч(Задача) = Тип("Неопределено") Тогда
		РазделУчета = ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ВнепроектнаяЗадача");
	ИначеЕсли ТипЗнч(Задача) = Тип("СправочникСсылка.упоПричиныПотерьРабочегоВремени") Тогда
		РазделУчета = ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПотеряРабочегоВремени");
	Иначе
		РазделУчета = ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПустаяСсылка");
	КонецЕсли;
	
	Возврат РазделУчета;
	
КонецФункции

