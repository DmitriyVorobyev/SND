#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДопДанныеПроектныхЗадач(ТаблицаЗадач) 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЗадач", ТаблицаЗадач);
	Запрос.УстановитьПараметр("ПредварительныйУровеньПланирования", Перечисления.упоУровеньПланирования.Предварительный);
	Запрос.УстановитьПараметр("ОкончательныйУровеньПланирования", Перечисления.упоУровеньПланирования.Окончательный);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаЗадач.Задача КАК Задача,
	               |	ТаблицаЗадач.Роль КАК Роль,
	               |	ТаблицаЗадач.Подразделение КАК Подразделение
	               |ПОМЕСТИТЬ ТаблицаЗадачИсходная
	               |ИЗ
	               |	&ТаблицаЗадач КАК ТаблицаЗадач
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаЗадач.Задача КАК Задача,
	               |	ТаблицаЗадач.Роль КАК Роль,
	               |	ТаблицаЗадач.Подразделение КАК Подразделение,
	               |	ВЫРАЗИТЬ(ВЫБОР
	               |			КОГДА ТаблицаЗадач.Задача ССЫЛКА Справочник.упоЗадания
	               |				ТОГДА ВЫРАЗИТЬ(ТаблицаЗадач.Задача КАК Справочник.упоЗадания).ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу
	               |			КОГДА ТаблицаЗадач.Задача ССЫЛКА Документ.упоПроектнаяЗадача
	               |				ТОГДА ТаблицаЗадач.Задача
	               |			ИНАЧЕ ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка)
	               |		КОНЕЦ КАК Документ.упоПроектнаяЗадача) КАК ПроектнаяЗадача,
	               |	ВЫБОР
	               |		КОГДА ТаблицаЗадач.Задача ССЫЛКА Справочник.упоЗадания
	               |			ТОГДА ТаблицаЗадач.Задача
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.упоЗадания.ПустаяСсылка)
	               |	КОНЕЦ КАК Задание
	               |ПОМЕСТИТЬ ТаблицаЗадач
	               |ИЗ
	               |	ТаблицаЗадачИсходная КАК ТаблицаЗадач
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаЗадач.Задание КАК Задание,
	               |	ТаблицаЗадач.Задача КАК Задача,
	               |	ТаблицаЗадач.Подразделение КАК Подразделение,
	               |	ТаблицаЗадач.Роль КАК Роль,
	               |	упоСрокиЗаданий.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
	               |	упоСрокиЗаданий.ДатаНачалаПлан КАК ДатаНачалаПлан
	               |ПОМЕСТИТЬ Задания
	               |ИЗ
	               |	ТаблицаЗадач КАК ТаблицаЗадач
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиЗаданий КАК упоСрокиЗаданий
	               |		ПО ТаблицаЗадач.Задание = упоСрокиЗаданий.Задание
	               |			И (ТаблицаЗадач.Задание <> ЗНАЧЕНИЕ(Справочник.упоЗадания.ПустаяСсылка))
	               |			И (ТаблицаЗадач.Задание <> НЕОПРЕДЕЛЕНО)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаЗадач.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ТаблицаЗадач.Задача КАК Задача,
	               |	ТаблицаЗадач.Подразделение КАК Подразделение,
	               |	ТаблицаЗадач.Роль КАК Роль,
	               |	упоВерсииПроекта.Проект КАК Проект,
	               |	упоВерсииПроекта.Версия КАК Версия,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК НазваниеЗадачи
	               |ПОМЕСТИТЬ ПроектныеЗадачи
	               |ИЗ
	               |	ТаблицаЗадач КАК ТаблицаЗадач
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |			ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |				И (упоВерсииПроекта.Текущая)
	               |				И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	               |		ПО ТаблицаЗадач.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ВложенныйЗапрос.Задача КАК Задача,
	               |	ВложенныйЗапрос.Подразделение КАК Подразделение,
	               |	ВложенныйЗапрос.Роль КАК Роль,
	               |	СУММА(ВложенныйЗапрос.ДлительностьПлан) КАК ДлительностьПлан,
	               |	СУММА(ВложенныйЗапрос.ДлительностьФакт) КАК ДлительностьФакт,
	               |	СУММА(ВложенныйЗапрос.ДлительностьПланОкончательный) КАК ДлительностьПланОкончательный
	               |ПОМЕСТИТЬ втДлительность
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |		ПроектныеЗадачи.Задача КАК Задача,
	               |		ПроектныеЗадачи.Подразделение КАК Подразделение,
	               |		ПроектныеЗадачи.Роль КАК Роль,
	               |		ВЫБОР
	               |			КОГДА упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.УровеньПланирования = &ПредварительныйУровеньПланирования
	               |				ТОГДА упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.КоличествоЧасов
	               |			ИНАЧЕ 0
	               |		КОНЕЦ КАК ДлительностьПлан,
	               |		0 КАК ДлительностьФакт,
	               |		ВЫБОР
	               |			КОГДА упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.УровеньПланирования = &ОкончательныйУровеньПланирования
	               |				ТОГДА упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.КоличествоЧасов
	               |			ИНАЧЕ 0
	               |		КОНЕЦ КАК ДлительностьПланОкончательный
	               |	ИЗ
	               |		ПроектныеЗадачи КАК ПроектныеЗадачи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоАктуальныеПланыТрудозатратСводноТекущаяВерсия КАК упоАктуальныеПланыТрудозатратСводноТекущаяВерсия
	               |			ПО ПроектныеЗадачи.ПроектнаяЗадача = упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача
	               |				И ПроектныеЗадачи.Подразделение = упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Подразделение
	               |				И ПроектныеЗадачи.Роль = упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.Ресурс
	               |	ГДЕ
	               |		упоАктуальныеПланыТрудозатратСводноТекущаяВерсия.ПроектнаяЗадача В
	               |				(ВЫБРАТЬ
	               |					ПроектныеЗАдачи.ПроектнаяЗадача
	               |				ИЗ
	               |					ПроектныеЗАдачи КАК ПроектныеЗАдачи)
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ПроектныеЗадачи.ПроектнаяЗадача,
	               |		ПроектныеЗадачи.Задача,
	               |		ПроектныеЗадачи.Подразделение,
	               |		ПроектныеЗадачи.Роль,
	               |		0,
	               |		упоФактТрудозатратСводно.КоличествоЧасов,
	               |		0
	               |	ИЗ
	               |		ПроектныеЗадачи КАК ПроектныеЗадачи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоФактТрудозатратСводно КАК упоФактТрудозатратСводно
	               |			ПО ПроектныеЗадачи.ПроектнаяЗадача = упоФактТрудозатратСводно.ПроектнаяЗадача
	               |				И ПроектныеЗадачи.Подразделение = упоФактТрудозатратСводно.Подразделение
	               |				И ПроектныеЗадачи.Роль = упоФактТрудозатратСводно.Ресурс
	               |	ГДЕ
	               |		упоФактТрудозатратСводно.УровеньПланирования = &ПредварительныйУровеньПланирования) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Подразделение,
	               |	ВложенныйЗапрос.Роль,
	               |	ВложенныйЗапрос.ПроектнаяЗадача,
	               |	ВложенныйЗапрос.Задача
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	упоСрокиПроектныхЗадачСрезПоследних.ДатаНачалаПлан КАК ДатаНачалаПлан,
	               |	упоСрокиПроектныхЗадачСрезПоследних.ДатаЗавершенияПлан КАК ДатаЗавершенияПлан
	               |ПОМЕСТИТЬ втСрокиПЗ
	               |ИЗ
	               |	ПроектныеЗадачи КАК ПроектныеЗадачи
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних КАК упоСрокиПроектныхЗадачСрезПоследних
	               |		ПО ПроектныеЗадачи.ПроектнаяЗадача = упоСрокиПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И ПроектныеЗадачи.Версия = упоСрокиПроектныхЗадачСрезПоследних.Версия
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПроектныеЗадачи.Проект КАК Проект,
	               |	ЛОЖЬ КАК ПроектПометкаУдаления,
	               |	ПроектныеЗадачи.Задача КАК Задача,
	               |	ПроектныеЗадачи.ПроектнаяЗадача КАК ПроектнаяЗадача,
	               |	ЛОЖЬ КАК ПроектнаяЗадачаПометкаУдаления,
	               |	ПроектныеЗадачи.Роль КАК Роль,
	               |	ПроектныеЗадачи.Подразделение КАК Подразделение,
	               |	упоРуководителиПроектовСрезПоследних.РуководительПроекта КАК РуководительПроекта,
	               |	ЕСТЬNULL(Задания.ДатаНачалаПлан, втСрокиПЗ.ДатаНачалаПлан) КАК ДатаНачала,
	               |	ЕСТЬNULL(Задания.ДатаОкончанияПлан, втСрокиПЗ.ДатаЗавершенияПлан) КАК ДатаЗавершения,
	               |	ПроектныеЗадачи.НазваниеЗадачи КАК НазваниеПроектнойЗадачи,
	               |	втДлительность.ДлительностьПлан КАК ДлительностьПлан,
	               |	втДлительность.ДлительностьФакт КАК ДлительностьФакт,
	               |	втДлительность.ДлительностьПланОкончательный КАК ДлительностьПланОкончательный
	               |ИЗ
	               |	ПроектныеЗадачи КАК ПроектныеЗадачи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоРуководителиПроектов.СрезПоследних КАК упоРуководителиПроектовСрезПоследних
	               |		ПО ПроектныеЗадачи.Проект = упоРуководителиПроектовСрезПоследних.Проект
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втДлительность КАК втДлительность
	               |		ПО ПроектныеЗадачи.ПроектнаяЗадача = втДлительность.ПроектнаяЗадача
	               |			И ПроектныеЗадачи.Подразделение = втДлительность.Подразделение
	               |			И ПроектныеЗадачи.Роль = втДлительность.Роль
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Задания КАК Задания
	               |		ПО ПроектныеЗадачи.Задача = Задания.Задача
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втСрокиПЗ КАК втСрокиПЗ
	               |		ПО ПроектныеЗадачи.ПроектнаяЗадача = втСрокиПЗ.ПроектнаяЗадача"; 
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
КонецФункции

Функция СтруктураДопДанныхСтроки()
	Возврат Новый Структура("ДлительностьПлан, ДлительностьПланПредставление, ДлительностьФакт, ДатаНачала, ДатаЗавершения, 
											| Проект, ПроектПометкаУдаления, РуководительПроекта, ПроектнаяЗадача, ПроектнаяЗадачаПометкаУдаления, Наименование, НазваниеПроектнойЗадачи,
											| Роль, Подразделение, Задача, ДетальноеПланирование");
КонецФункции 

Процедура ЗадачиСДетальнымПланированием(Исполнитель, НачалоДня, КонецДня, ПроектныеЗадачи, 
	ЗадачиСДетальнымПланированием)
	
	// Выбираем задачи, назначенные ТР на конкретную дату обработкой ОперЗагрузка и документа ПланированиеТРЗ.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектныеЗадачи", ПроектныеЗадачи);
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня);
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДетальноеПланирование.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	(ВЫБРАТЬ
	|		упоОперативнаяЗагрузкаСпециалистов.ПроектнаяЗадача КАК ПроектнаяЗадача
	|	ИЗ
	|		РегистрСведений.упоОперативнаяЗагрузкаСпециалистов.СрезПоследних(
	|				,
	|				ПроектнаяЗадача В (&ПроектныеЗадачи)
	|					И ТрудовойРесурс = &Исполнитель
	|					И ДатаВремя >= &ДатаНачала
	|					И ДатаВремя <= &ДатаКонца) КАК упоОперативнаяЗагрузкаСпециалистов
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		упоДанныеРаспределенияПланаТрудозатратТР.ПроектнаяЗадача
	|	ИЗ
	|		РегистрСведений.упоДанныеРаспределенияПланаТрудозатратТрудовыхРесурсовПоДням.СрезПоследних(
	|				,
	|				ПроектнаяЗадача В (&ПроектныеЗадачи)
	|					И Ресурс = &Исполнитель
	|					И Дата >= &ДатаНачала
	|					И Дата <= &ДатаКонца) КАК упоДанныеРаспределенияПланаТрудозатратТР) КАК ДетальноеПланирование"; 
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗадачиСДетальнымПланированием.Вставить(Выборка.ПроектнаяЗадача, Истина);
	КонецЦикла;
	
КонецПроцедуры
	
#КонецОбласти

#КонецЕсли