// Процедура заполняет рабочими заданиями табличную часть или таблицу значений.
//
// Параметры:
//  ТЧПроектныеЗадачи - ТабличнаяЧасть, ТаблицаЗначения - Табличная часть, Таблица значения.
//  Дата 			 - Дата - День, на который получаем рабочие задания. 
//  ТрудовойРесурс 	 - СправочникСсылка.упоТрудовыеРесурсы - трудовой ресурс.
//  ЗаполнятьРоль 	 - Булево - Признак заполнения Роли в заданной ТЧ/ТЗ.
//
Процедура ЗаполнитьРабочимиЗаданиями(ТЧПроектныеЗадачи, Дата, ТрудовойРесурс, ЗаполнятьРоль) Экспорт
	
	НачалоДня = НачалоДня(Дата);
	
	РабочиеЗадания = ПолучитьРабочиеЗадания(НачалоДня, КонецДня(Дата), ТрудовойРесурс);
	
	Если Не ЗначениеЗаполнено(РабочиеЗадания) Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаЗаданий Из РабочиеЗадания Цикл
		
		Если СтрокаЗаданий.ДатаОкончанияНаМоментЗаполнения < НачалоДня Тогда
			Продолжить;	
		КонецЕсли;
		
		СтрокаТаблицы = ТЧПроектныеЗадачи.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаЗаданий);
		Если ЗначениеЗаполнено(СтрокаЗаданий.Задание) Тогда
			СтрокаТаблицы.Задача = СтрокаЗаданий.Задание;	
		Иначе
			СтрокаТаблицы.Задача = СтрокаЗаданий.РабочееЗадание;
		КонецЕсли;
		Если ЗаполнятьРоль Тогда
			СтрокаТаблицы.Роль = СтрокаЗаданий.РольРесурса;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Функция получает рабочие задания.
//
// Параметры:
//  ДатаНачала 		- Дата - дата начала.
//  ДатаОкончания 	- Дата - дата окончания. 
//  ТрудовойРесурс 	- СправочникСсылка.упоТрудовыеРесурсы - трудовой ресурс. 
//
// Возвращаемое значение:
//  ТаблицаЗначений	- найденные рабочие задания.
//
Функция ПолучитьРабочиеЗадания(ДатаНачала, ДатаОкончания, ТрудовойРесурс) Экспорт 
		
	ТаблицаРабочихЗаданий = упоРаспределениеТрудозатратВызовСервера.ПолучитьРабочиеЗадания(ТрудовойРесурс, ДатаНачала, ДатаОкончания);
	Если ТаблицаРабочихЗаданий <> Неопределено Тогда
		ТаблицаРабочихЗаданий.Колонки.ДатаНачала.Имя = "ДатаНачалаНаМоментЗаполнения";
		ТаблицаРабочихЗаданий.Колонки.ДатаОкончания.Имя = "ДатаОкончанияНаМоментЗаполнения";
	КонецЕсли;
	
	ТаблицаРабочихЗаданий.Сортировать("Проект");
	
	Возврат ТаблицаРабочихЗаданий;
	
КонецФункции

// Функция получает документ дня на дату.
//
// Параметры:
//  Дата		 		- Дата - дата.
//  ТрудовойРесурс 	- СправочникСсылка.упоТрудовыеРесурсы - трудовой ресурс. 
//
// Возвращаемое значение:
//  Ссылка 			- ссылка на документ дня. 
//
Функция ПолучитьДокументДня(ТрудовойРесурс, Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоТабельУчетаРабочегоВремени.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.упоТабельУчетаРабочегоВремени КАК упоТабельУчетаРабочегоВремени
	               |ГДЕ
	               |	упоТабельУчетаРабочегоВремени.Ресурс = &Ресурс
	               |	И НАЧАЛОПЕРИОДА(упоТабельУчетаРабочегоВремени.Дата, ДЕНЬ) = &ДатаДокумента
	               |	И упоТабельУчетаРабочегоВремени.Проведен";
	
	Запрос.УстановитьПараметр("Ресурс", ТрудовойРесурс);
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(Дата));	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий(); 
		
		Возврат Выборка.Ссылка;
		
	Иначе	
		
		Возврат Неопределено;
		
	КонецЕсли;
		
КонецФункции

// Функция получает массив трудовых ресурсов пользователя.
//
// Возвращаемое значение:
//  Массив	- массив трудовых ресурсов.
//
Функция ПолучитьМассивТрудовыхРесурсовПользователя() Экспорт
	
	МассивТР = Новый Массив;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекПользователь", Пользователи.ТекущийПользователь());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РегТР.Ресурс КАК Ресурс
	|ИЗ
	|	РегистрСведений.упоВладениеРесурсами.СрезПоследних(
	|			,
	|			Сотрудник В
	|				(ВЫБРАТЬ
	|					РегДС.Сотрудник КАК Сотрудник
	|				ИЗ
	|					РегистрСведений.упоДиспетчерыСистемы.СрезПоследних(, Пользователь = &ТекПользователь) КАК РегДС
	|				ГДЕ
	|					РегДС.ФлагУправления)) КАК РегТР
	|ГДЕ
	|	РегТР.ВладеетРесурсом";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		МассивТР = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ресурс");
	КонецЕсли;
	
	Возврат МассивТР;
	
КонецФункции

// Процедура заполняет таблицу ДанныеЗадач.
//
// Параметры:
//  ДанныеЗадач 		 - ТаблицаЗначения - 
//  Форма 			 - Форма клиентского приложения - Форма документа упоТабельУчетаРабочегоВремени 
//  СтрокаТабеля 	 - Строка ТаблицыЗначений - 
//  ИсходнаяТаблица 	 - ТаблицаЗначений - 
//
Процедура ОбновитьДопДанные(ДанныеЗадач, Форма = Неопределено, СтрокаТабеля = Неопределено, ИсходнаяТаблица = Неопределено) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОсновныеПараметры = ОсновныеПараметрыСтроки();
	
	Если ИсходнаяТаблица = Неопределено Тогда
		
		Если СтрокаТабеля = Неопределено Тогда
			ТаблицаЗадач = Форма.Объект.ПроектныеЗадачи.Выгрузить(, ОсновныеПараметры);
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Форма.Объект.ТабельДня.Выгрузить(, ОсновныеПараметры), ТаблицаЗадач);  
			ТаблицаЗадач.Свернуть(ОсновныеПараметры);		
		Иначе
			ТаблицаЗадач = Форма.Объект.ПроектныеЗадачи.Выгрузить(Новый Массив, ОсновныеПараметры);
			ЗаполнитьЗначенияСвойств(ТаблицаЗадач.Добавить(), СтрокаТабеля);
		КонецЕсли;
		
	Иначе
		
		ТаблицаЗадач = ИсходнаяТаблица.Скопировать(, ОсновныеПараметры);
		ТаблицаЗадач.Свернуть(ОсновныеПараметры);	
		
	КонецЕсли;
	
	ДопДанныеЗадач = ПолучитьДопДанныеПроектныхЗадач(ТаблицаЗадач);
		
	Если НЕ ДопДанныеЗадач = Неопределено Тогда
		
		ЗадачиСДетальнымПланированием = Новый Соответствие;
		Если Форма <> Неопределено Тогда
			ОбъектФормы = Форма.Объект;
			Дата = ОбъектФормы.Дата;
			ЗадачиСДетальнымПланированием(ОбъектФормы.Ресурс, НачалоДня(Дата), КонецДня(Дата), 
				ДопДанныеЗадач.ВыгрузитьКолонку("ПроектнаяЗадача"), ЗадачиСДетальнымПланированием);
		КонецЕсли;
		
		ДобавитьДетальноеПланирование = ЗначениеЗаполнено(ЗадачиСДетальнымПланированием);
		
		Отбор = Новый Структура(ОсновныеПараметры);		
		Для Каждого ДопДанные Из ДопДанныеЗадач Цикл
			ЗаполнитьЗначенияСвойств(Отбор, ДопДанные);
			НайденныеСтроки = ДанныеЗадач.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				СтрокаДанных = НайденныеСтроки[0];
			Иначе
				СтрокаДанных = ДанныеЗадач.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаДанных, ДопДанные);
			
			Если ДопДанные.ДлительностьПлан <> 0 И ДопДанные.ДлительностьПланОкончательный <> 0 Тогда
				СтрокаДанных.ДлительностьПланПредставление = Формат(ДопДанные.ДлительностьПлан, "ЧДЦ=2") + "/" +
					Формат(ДопДанные.ДлительностьПланОкончательный, "ЧДЦ=2");
			ИначеЕсли ДопДанные.ДлительностьПлан = 0 И ДопДанные.ДлительностьПланОкончательный <> 0 Тогда		
				СтрокаДанных.ДлительностьПланПредставление = Формат(ДопДанные.ДлительностьПланОкончательный, "ЧДЦ=2");
			Иначе
				СтрокаДанных.ДлительностьПланПредставление = Формат(ДопДанные.ДлительностьПлан, "ЧДЦ=2");
			КонецЕсли;
			
			СтрокаДанных.ДетальноеПланирование = Ложь;
			
			Если Не ДобавитьДетальноеПланирование Тогда
				Продолжить;
			КонецЕсли;
				
			ЕстьДетальноеПланирование = ЗадачиСДетальнымПланированием[СтрокаДанных.ПроектнаяЗадача];
			Если ЕстьДетальноеПланирование <> Неопределено И ЕстьДетальноеПланирование Тогда
				СтрокаДанных.ДетальноеПланирование = Истина;					
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;				
	
КонецПроцедуры

// Функция получает строку основных параметров строки.
//
// Возвращаемое значение:
//  Строка - массив трудовых ресурсов.
//
Функция ОсновныеПараметрыСтроки() Экспорт
	Возврат "Роль, Подразделение, Задача";
КонецФункции

// Процедура заполняет таблицу ДанныеЗадач.
//
// Параметры:
//  СтрокаТаблицы 		 - Строка ТаблицыЗначений - 
//  ДанныеЗадач 			 - ТаблицаЗначения - 
//  Форма 	 			 - Форма клиентского приложения - Форма документа упоТабельУчетаРабочегоВремени 
//  ОбновлятьДопДаные 	 - Булево - 
//
Процедура ЗаполнитьСтрокуТаблицыДопДанными(СтрокаТаблицы, ДанныеЗадач, Форма = Неопределено, ОбновлятьДопДаные = Ложь) Экспорт 
	
	НайтиДанные = Ложь;
	ПростоеНаименование = Истина;						
	
	ОсновныеПараметры = "Задача, Роль, Подразделение";
	ДанныеЗадачи = СтруктураДопДанныхСтроки();										
	ЗаполнитьЗначенияСвойств(ДанныеЗадачи, СтрокаТаблицы, ОсновныеПараметры);											
											
	Если ТипЗнч(СтрокаТаблицы.Задача) = Тип("СправочникСсылка.упоВнепроектныеЗадачи") Тогда													
	ИначеЕсли ТипЗнч(СтрокаТаблицы.Задача) = Тип("СправочникСсылка.упоВнепроектныеЗадачи") Тогда		
	ИначеЕсли ТипЗнч(СтрокаТаблицы.Задача) = Тип("СправочникСсылка.упоЗадания") Тогда		
		НайтиДанные = Истина;
	ИначеЕсли ТипЗнч(СтрокаТаблицы.Задача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда	
		НайтиДанные = Истина;		
	КонецЕсли;
	
	Если НайтиДанные Тогда
		
		ПростоеНаименование = Ложь;
		
		Отбор = Новый Структура(ОсновныеПараметры);
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицы);
		НайденныеСтроки = ДанныеЗадач.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() Тогда
			ЗаполнитьЗначенияСвойств(ДанныеЗадачи, НайденныеСтроки[0]);
		ИначеЕсли ОбновлятьДопДаные Тогда
			Документы.упоТабельУчетаРабочегоВремени.ОбновитьДопДанные(ДанныеЗадач, Форма, СтрокаТаблицы);	
			НайденныеСтроки = ДанныеЗадач.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() Тогда
				ЗаполнитьЗначенияСвойств(ДанныеЗадачи, НайденныеСтроки[0]);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ПростоеНаименование Тогда
		ДанныеЗадачи.Наименование = Строка(СтрокаТаблицы.Задача);	
	Иначе
		Если ЗначениеЗаполнено(СтрокаТаблицы.Задача) И СтрокаТаблицы.Задача <> ДанныеЗадачи.ПроектнаяЗадача Тогда
			ДанныеЗадачи.Наименование = 
				?(ЗначениеЗаполнено(ДанныеЗадачи.НазваниеПроектнойЗадачи), "" + ДанныеЗадачи.НазваниеПроектнойЗадачи + " \ ", "") + СтрокаТаблицы.Задача;
		Иначе
			ДанныеЗадачи.Наименование = ДанныеЗадачи.НазваниеПроектнойЗадачи;	
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеЗадачи);
	
КонецПроцедуры

