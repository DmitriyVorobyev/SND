// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Основание    - Произвольный, значение, которое используется как основание для заполнения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаЗаполнения(Основание)
	
	ТипОснование = ТипЗнч(Основание);
	
	Если ТипОснование = Тип("Неопределено") Тогда 
		Возврат;	
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
	Если ТипОснование = Тип("СправочникСсылка.Номенклатура") 
		Или ТипОснование = Тип("СправочникСсылка.упоТрудовыеРесурсы")  
		Или ТипОснование = Тип("СправочникСсылка.упоРоли") 
		Или ТипОснование = Тип("СправочникСсылка.упоПроектнаяПродукция") Тогда      
		
		Ресурс = Основание;
		
	ИначеЕсли ТипОснование = Тип("СправочникСсылка.упоНормыСтоимости") Тогда
		
		НормаСтоимости = Основание;
		
	КонецЕсли; 

	Если ТипОснование = Тип("СправочникСсылка.Номенклатура") 
		Или ТипОснование = Тип("СправочникСсылка.упоПроектнаяПродукция") Тогда
		
			ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ЕдиницаИзмерения");	
	
	КонецЕсли;

КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  ЭтотОбъект   - ДокументОбъект, содержит сам объект.
//  Отказ        - Булево, признак отказа от записи документа.
//  РежимЗаписи  - РежимЗаписиДокумента, в параметр передается текущий режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента, в данный параметр передается текущий режим проведения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	УстановитьВидНормирования();
	
	упоОбработчикиСобытийВызовСервера.обДокументОбъектПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения); 
	
	// Перед записью документа необходимо очистить "лишние" реквизиты стоимости
	// в противном случае универсальная процедура записи в регистры
	// запишет лишние данные о стоимости использования ресурса. 
	
	Если НЕ Отказ Тогда      
		Если ВидНормирования = Перечисления.упоВидНормированияСтоимостиРесурса.ПоВремени Тогда 
			ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
			Количество = 0;
		ИначеЕсли упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(Ресурс) Или 
			ВидНормирования = Перечисления.упоВидНормированияСтоимостиРесурса.ПоКоличеству Тогда
				ЕдиницаВремени = Справочники.упоЕдиницыВремени.ПустаяСсылка();
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры // ПередЗаписью()

