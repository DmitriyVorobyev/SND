	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает значение служебного реквизита ВидНормирования
// в зависимости от типа и вида выбранного ресурса. 
//
Процедура УстановитьВидНормирования() Экспорт

	Если Не ЗначениеЗаполнено(Ресурс) Тогда
		Возврат;
	КонецЕсли;
		
	Если упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(Ресурс) Тогда
		ВидНормирования = Перечисления.упоВидНормированияСтоимостиРесурса.ПоКоличеству;
		Возврат;
	КонецЕсли; 
	
	Если Ресурс.упоВидРесурса = Перечисления.упоВидРесурса.Материальный 
		И Ресурс.упоВидМатериальногоРесурса = Перечисления.упоВидМатериальногоРесурса.Материал Тогда
		ВидНормирования = Перечисления.упоВидНормированияСтоимостиРесурса.ПоКоличеству;
	Иначе
		ВидНормирования = Перечисления.упоВидНормированияСтоимостиРесурса.ПоВремени;
	КонецЕсли; 
	
КонецПроцедуры // УстановитьВидНормирования()
 
