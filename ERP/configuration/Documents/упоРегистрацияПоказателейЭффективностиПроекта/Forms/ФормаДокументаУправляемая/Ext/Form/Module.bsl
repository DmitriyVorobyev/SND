&НаКлиенте
Процедура ТаблицаИндикаторыЗаполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		Объект.Индикаторы.Очистить();
	КонецЕсли;
	
	ТаблицаИндикаторыЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИндикаторыЗаполнитьНаСервере()
	
	Результат = РезультатЗапросаПолучитьИндикаторыПроекта(Объект.Проект);
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Индикаторы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		ПривестиТипИндикатораВСтроке(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИндикаторыПересчитатьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда		
		ВызватьОтменуПроведения();
		Прочитать();
	КонецЕсли;
	
	ТаблицаИндикаторыПересчитатьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаИндикаторыПересчитатьНаСервере()
	
	РезультатПоПроекту = упоПоказателиЭффективностиПроектов.РассчитатьПоказателиЭффективностиПроекта(Объект.Проект,
			ПериодРасчета.ДатаНачала, ПериодРасчета.ДатаОкончания);
	
	Для Каждого СтрИндикатор Из Объект.Индикаторы Цикл
		Если РезультатПоПроекту = Неопределено Тогда
			ЗначениеИндикатора = 0;
		Иначе
			ЗначениеИндикатора = РезультатПоПроекту.Получить(СтрИндикатор.Индикатор);
		КонецЕсли;
		
		СтрИндикатор.ЗначениеИндикатора = ?(ЗначениеИндикатора = Неопределено, 0, ЗначениеИндикатора);
		ПривестиТипИндикатораВСтроке(СтрИндикатор);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВызватьОтменуПроведения()
	
	Если Объект.Проведен Тогда
		ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
		ДокументОбъект.ОтменитьПроведениеДокумента();
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруСвойствИндикатора(ИндикаторСсылка)
	
	СтруктураСвойств = Новый Структура;
	СтруктураСвойств.Вставить("ТипЗначенияИндикатора");
	
	СтруктураСвойств.Вставить("ВидЗаполненияИндикатора", ИндикаторСсылка.ВидЗаполнения);
	
	МассивТипов =  Новый Массив;
	КЧ = Новый КвалификаторыЧисла(15,3);
	КД = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	КС = Новый КвалификаторыСтроки(100);

	Если ИндикаторСсылка.ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
		
		МассивТипов.Добавить(Тип("Число"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов, КЧ);
		
	ИначеЕсли ИндикаторСсылка.ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
		
		МассивТипов.Добавить(Тип("Дата"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов,,,КД);
		
	ИначеЕсли ИндикаторСсылка.ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
		
		МассивТипов.Добавить(Тип("Булево"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов);
		
	ИначеЕсли ИндикаторСсылка.ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
		
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов,,КС);		
		
	Иначе
		
		МассивТипов.Добавить(Тип("Число"));
		МассивТипов.Добавить(Тип("Дата"));
		МассивТипов.Добавить(Тип("Булево"));
		МассивТипов.Добавить(Тип("Строка"));
		ОписаниеТиповИндикатор = Новый ОписаниеТипов(МассивТипов, КЧ,КС,КД);		 
		
	КонецЕсли;
	
	СтруктураСвойств.ТипЗначенияИндикатора = ОписаниеТиповИндикатор;
	
	Возврат СтруктураСвойств;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьКорректностьЗаполнения(Отказ)
		
	МассивПоказателей = ПолучитьПоказателиПроекта(Объект.Проект);
	
	МассивСтрокНесоответствующихПоказателей = Новый Массив();
	Для каждого СтрПоказатель Из Объект.Индикаторы Цикл
		Индикатор = СтрПоказатель.Индикатор;
		Если МассивПоказателей.Найти(Индикатор) = Неопределено Тогда
			МассивСтрокНесоответствующихПоказателей.Добавить(СтрПоказатель.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Ошибки = Неопределено;
	Для Инд = 0 По МассивСтрокНесоответствующихПоказателей.ВГраница() Цикл
		СтрокаОшибки = МассивСтрокНесоответствующихПоказателей[Инд];
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.Индикаторы[%1].Индикатор",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Принадлежность показателя ""%1"" не соответствует выбранному проекту/проектной задаче.'"),
				Объект.Индикаторы[СтрокаОшибки - 1].Индикатор),
			"Объект.Индикаторы",
			СтрокаОшибки - 1,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Принадлежность показателя ""%1"" не соответствует выбранному проекту/проектной задаче.'"),
				Объект.Индикаторы[СтрокаОшибки - 1].Индикатор));
	КонецЦикла;
			
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоказателиПроекта(Проект)
		
	РезультатЗапроса = РезультатЗапросаПолучитьИндикаторыПроекта(Проект);
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Индикатор");
	
КонецФункции

&НаСервереБезКонтекста
Функция РезультатЗапросаПолучитьИндикаторыПроекта(Проект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПоказателиПроектов.Ссылка КАК Индикатор
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	               |ГДЕ
	               |	упоПоказателиПроектов.ВидЗаполнения = ЗНАЧЕНИЕ(Перечисление.упоВидЗаполненияИндикатора.АвтоматическиВДокументеРасчетЭффективности)";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПривестиТипИндикатораВСтроке(СтрокаТаблицы) 
	
	СтруктураДопСвойствИндикатора = ПолучитьСтруктуруСвойствИндикатора(СтрокаТаблицы.Индикатор);
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураДопСвойствИндикатора);
	ТипЗнчИндикатора = ТипЗнч(СтрокаТаблицы.ЗначениеИндикатора);
	
	Если Не СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(ТипЗнчИндикатора) Тогда
		
		Если СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Булево")) Тогда
			
			СтрокаТаблицы.ЗначениеИндикатора = Ложь;
			
		ИначеЕсли СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Число")) Тогда 
			
			СтрокаТаблицы.ЗначениеИндикатора = 0;
			
		ИначеЕсли СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Дата")) Тогда 
			
			СтрокаТаблицы.ЗначениеИндикатора = Дата(1, 1, 1);
			
		ИначеЕсли СтрокаТаблицы.ТипЗначенияИндикатора.СодержитТип(Тип("Строка")) Тогда 	
			
			СтрокаТаблицы.ЗначениеИндикатора = "";
			
		КонецЕсли;			
		
	КонецЕсли;
	
КонецФункции

