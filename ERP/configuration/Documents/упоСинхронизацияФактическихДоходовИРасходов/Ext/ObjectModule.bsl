Функция ПредставлениеСуммыТабличнойЧасти(ИмяТЧ)
	
	ПредставлениеСуммы = "";
	Если ЭтотОбъект[ИмяТЧ].Количество() = 0 Тогда
		Возврат ПредставлениеСуммы;	
	КонецЕсли;
	
	Таб = ЭтотОбъект[ИмяТЧ].Выгрузить(, "Валюта, Сумма");
	Таб.Свернуть("Валюта", "Сумма");
			
	ТекСуммаСВалютойШаблон = "%1 %2";
	МассивСуммСВалютой = Новый Массив;
	Для Каждого ТекСтрока Из Таб Цикл
		НаименованиеВалюты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.Валюта, "Наименование");
		ТекСуммаСВалютой = СтрШаблон(ТекСуммаСВалютойШаблон, ТекСтрока.Сумма, НаименованиеВалюты);	
		МассивСуммСВалютой.Добавить(ТекСуммаСВалютой);
	КонецЦикла;	
	ПредставлениеСуммы = СтрСоединить(МассивСуммСВалютой, ", ");	
		           	
	Возврат ПредставлениеСуммы;
		
КонецФункции 

