// Процедура для вызова при подборе ресурсов.
//
// Параметры:
//  СтрокаТабличнойЧасти - СтрокаТабличнойЧасти	 - строка табличной части "ДвиженияДенежныхСредств". 
//  ПараметрыПодбора	 - СписокЗначений со вспомогательными параметрами.
//
Процедура ВыполнитьДействияПриПодборе(Знач СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт

	имяРеквизитаВалютыДоговора = упоУправлениеДоговорамиКлиентСервер.ИмяРеквизитаВалютыДоговора();
	
	Если Не ПараметрыПодбора = Неопределено Тогда      
		
		Для Каждого ПараметрПодбора Из ПараметрыПодбора Цикл
			
			// прямое обращение к реквизитам на всякий случай оборачиваем в try
			Попытка 				
				Если ПараметрПодбора.Представление = "ИмяТабличнойЧасти" Тогда      					
					Если ПараметрПодбора.Значение = "Доходы"
						Или ПараметрПодбора.Значение = "Расходы" Тогда     
						
						// Попробуем определить договор контрагента по умолчанию						
						Если Не упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаТабличнойЧасти.Контрагент) Тогда      
							СтрокаТабличнойЧасти.Договор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТабличнойЧасти.Контрагент, "упоОсновнойДоговорКонтрагента");
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Договор) Тогда							
							СтрокаТабличнойЧасти.Валюта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТабличнойЧасти.Договор, имяРеквизитаВалютыДоговора);
						Иначе
							СтрокаТабличнойЧасти.Валюта = мВалютаУправленческогоУчета;
						КонецЕсли;					 
					КонецЕсли;					 			
				КонецЕсли; 
				
			Исключение
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'При подборе возникла ошибка: неверное имя колонки!'"));
			КонецПопытки;
			
		КонецЦикла; 	
	КонецЕсли; 

КонецПроцедуры // ВыполнитьДействияПриПодборе()

