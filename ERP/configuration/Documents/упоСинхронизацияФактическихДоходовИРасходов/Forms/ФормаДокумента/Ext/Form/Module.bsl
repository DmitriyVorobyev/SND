&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаРегистраторОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ПараметрыПерехода = Новый Структура;
	ПараметрыПерехода.Вставить("СсылкаНаРегистратор", 	  		 Объект.СсылкаНаРегистратор);
	ПараметрыПерехода.Вставить("ПолеНаФормеСсылкаНаРегистратор", "Объект.СсылкаНаРегистратор");
	ПараметрыПерехода.Вставить("ИсточникДанных", 		  		 Объект.ИсточникДанных);
	ПараметрыПерехода.Вставить("ПолеНаФормеИсточникДанных", 	 "Объект.ИсточникДанных");
	упоИнтеграцияКлиент.ПерейтиПоСсылкеНаРегистратор(ПараметрыПерехода);
	
КонецПроцедуры

&НаКлиенте
Процедура НадписьНесколькоДокументовНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ЭтаФорма.Элементы.ГруппаСтраницы.ТекущаяСтраница = ЭтаФорма.Элементы.СтраницаПервичныйДокумент;
	
КонецПроцедуры

