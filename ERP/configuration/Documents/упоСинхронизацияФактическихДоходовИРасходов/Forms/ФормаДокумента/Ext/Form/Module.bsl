&НаСервере
Процедура НайтиДокументыПоПервичномуДокументу()
	
	Если Не Объект.СозданПриЗагрузкеДанных Тогда
		Возврат;	
	КонецЕсли;
	
	ДокументыПоПервичномуДокументу.Параметры.УстановитьЗначениеПараметра("ИсточникДанных", Объект.ИсточникДанных);
	ДокументыПоПервичномуДокументу.Параметры.УстановитьЗначениеПараметра("СсылкаНаРегистратор", Объект.СсылкаНаРегистратор);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	упоСинхронизацияФактическихДоходовИРасходов.Представление КАК ПредставлениеДокумента
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихДоходовИРасходов КАК упоСинхронизацияФактическихДоходовИРасходов
	               |ГДЕ
	               |	НЕ упоСинхронизацияФактическихДоходовИРасходов.ПометкаУдаления
	               |	И упоСинхронизацияФактическихДоходовИРасходов.СозданПриЗагрузкеДанных
	               |	И упоСинхронизацияФактическихДоходовИРасходов.ИсточникДанных = &ИсточникДанных
	               |	И упоСинхронизацияФактическихДоходовИРасходов.СсылкаНаРегистратор = &СсылкаНаРегистратор
	               |	И НЕ упоСинхронизацияФактическихДоходовИРасходов.Ссылка = &ЭтотДокумент";
	Запрос.УстановитьПараметр("ЭтотДокумент", 		 Объект.Ссылка);
	Запрос.УстановитьПараметр("ИсточникДанных", 	 Объект.ИсточникДанных);
	Запрос.УстановитьПараметр("СсылкаНаРегистратор", Объект.СсылкаНаРегистратор);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		ТекстНадписи = НСтр("ru = 'Внимание! Найдены документы, соответствующие одному первичному документу'");
		НадписьНесколькоДокументов = ТекстНадписи;
		
		Элементы.НадписьНесколькоДокументов.Видимость = Истина;
		Элементы.ДокументыПоПервичномуДокументу.Видимость = Истина;
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьНаименованияПроектныхЗадачВТаблицах()
		
	МассивТабЧастей = Новый Массив;
	МассивТабЧастей.Добавить(Объект.Доходы);
	МассивТабЧастей.Добавить(Объект.Расходы);
	упоРаботаСФормамиСервер.ЗаполнитьНаименованияПЗВТабличныхЧастях(МассивТабЧастей);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОсновныеПараметрыЗадачи(ПроектнаяЗадача)
	
	Результат = Новый Структура("Проект, НазваниеЗадачи");
	
	Если Не ЗначениеЗаполнено(ПроектнаяЗадача) Тогда		
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектнаяЗадача", ПроектнаяЗадача);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСвойстваПроектныхЗадачСрезПоследних.Версия.Проект КАК Проект,
	               |	упоСвойстваПроектныхЗадачСрезПоследних.НазваниеЗадачи КАК НазваниеЗадачи
	               |ИЗ
	               |	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадача) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
	               |		ПО упоСвойстваПроектныхЗадачСрезПоследних.Версия = упоВерсииПроекта.Версия
	               |			И (упоВерсииПроекта.Текущая)";	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

