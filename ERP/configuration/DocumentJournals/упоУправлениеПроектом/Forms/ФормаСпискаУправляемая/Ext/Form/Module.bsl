#Область ВспомогательныеПроцедурыИФункцииОбработчиков

&НаСервере
Функция УстановитьЗаголовокПоПроекту() 
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект Тогда
			Если ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
				Заголовок = Строка(ЭлементОтбора.ПравоеЗначение);
			ИначеЕсли ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
				Заголовок = "" + ЭлементОтбора.ВидСравнения + " " + ЭлементОтбора.ПравоеЗначение;
			ИначеЕсли Не ЭлементОтбора.Использование Тогда
				Заголовок = НСтр("ru = 'По всем проектам'");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииПанелиСтатусовПроекта

&НаКлиенте
Процедура КомандаСменаСтатуса(Команда)
	
	НажатаКнопка = ЭтаФорма.ТекущийЭлемент;
	Если ТипЗнч(НажатаКнопка) <> Тип("КнопкаФормы") Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныйСтатус = упоПроектыИЗадачиОбщие.ПолучитьСтатусПоИмениКнопки(НажатаКнопка.Имя);
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект 
			И ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
			упоПроектыИЗадачиКлиент.ИзменитьСтатус(ТекущийСтатусПроекта, ВыбранныйСтатус, РегистраторТекущегоСтатуса, ЭлементОтбора.ПравоеЗначение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьПанельСтатусов()
	
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект 
			И ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
			упоПроектыИЗадачиСервер.ОтрисоватьЭлементыФормы(Элементы, "ПанельСтатусовПроекта", , "Горизонтальная");			
			упоПроектыИЗадачиСервер.ОбработкаСменыСтатусаПроекта(ЭтаФорма, Элементы, ЭлементОтбора.ПравоеЗначение, ТекущийСтатусПроекта);
			СохранитьСостояниеКнопокСменыСтатуса();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаОповещенияСменыСтатуса(ИмяСобытия, Параметр)
	
	Если ИмяСобытия = "СменаСтатусаПроекта" Тогда
		ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
		Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект И ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) И ЭлементОтбора.ПравоеЗначение = Параметр Тогда
				упоПроектыИЗадачиСервер.ОбработкаСменыСтатусаПроекта(ЭтаФорма, Элементы, ЭлементОтбора.ПравоеЗначение, ТекущийСтатусПроекта);
			КонецЕсли;
		КонецЦикла
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если ТекущийСтатусПроекта = ПредопределенноеЗначение("Перечисление.упоСостояниеСтатусаПроекта.ПустаяСсылка") Тогда
		ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
		Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект 
				И ЭлементОтбора.Использование И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
				ПараметрыОткрытия = Новый Структура("Основание", ЭлементОтбора.ПравоеЗначение);
				ОткрытьФорму("Документ.упоРегистрацияПроекта.ФормаОбъекта", ПараметрыОткрытия);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Изменение статуса проекта выполняется при нажатии соответствующей кнопки 
                                                                |в окне ""Фазы проекта"" или в карточке проекта на закладке ""Управление"".'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектПриИзменении_Добавляемый(Элемент)
	
	// При изменении проекта надо очистить инфу о состоянии кнопок
	СостояниеКнопокИзмененияСостоянияПроекта.Очистить();
	
	ИмяСобытия = "СменаСтатусаПроекта";
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект Тогда
			ОбработкаОповещенияСменыСтатуса(ИмяСобытия, ЭлементОтбора.ПравоеЗначение);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьЗаголовокПоПроекту();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияОтбораПроектПриИзменении_Добавляемый(Элемент)
	
	УстановитьЗаголовокПоПроекту();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеОтбораПроектПриИзменении_Добавляемый(Элемент)
	
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.ЛевоеЗначение = ПолеПроект Тогда
			КнопкиДоступны = ЭлементОтбора.Использование;
			Если Не КнопкиДоступны Тогда
				ИспользованиеОтбораПроектПриИзменении_Добавляемый_НаСервере();
			КонецЕсли;
			УстановитьДоступностьКнопокСтатусов(КнопкиДоступны);
		КонецЕсли;
	КонецЦикла;
	
	УстановитьЗаголовокПоПроекту();
	
КонецПроцедуры

Процедура ИспользованиеОтбораПроектПриИзменении_Добавляемый_НаСервере()
		
	СохранитьСостояниеКнопокСменыСтатуса();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДействиеДляПоляПоПроекту(ИмяПоля, СобытиеПриИзменении, ОбработчикСобытияПриИзменении)
		
	Если Не Элементы.Найти(ИмяПоля) = Неопределено Тогда
		Элементы[ИмяПоля].УстановитьДействие(СобытиеПриИзменении, ОбработчикСобытияПриИзменении);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура УстановитьДоступностьКнопокСтатусов(КнопкиДоступны = Истина, ГруппаФормы = Неопределено)
	
	Если Не КнопкиДоступны Тогда
		
		Если ГруппаФормы = Неопределено Тогда
			ГруппаФормы = Элементы.ПанельСтатусовПроекта;
		КонецЕсли;
				
		Для Каждого ЭлементСтраницы Из ГруппаФормы.ПодчиненныеЭлементы Цикл
			Если ТипЗнч(ЭлементСтраницы) = Тип("ГруппаФормы")
				И Не ЭлементСтраницы.ПодчиненныеЭлементы.Количество() = 0 Тогда
				УстановитьДоступностьКнопокСтатусов(КнопкиДоступны, ЭлементСтраницы)
			КонецЕсли;
			
			Если ТипЗнч(ЭлементСтраницы) = Тип("КнопкаФормы") Тогда
				ЭлементСтраницы.Доступность = КнопкиДоступны;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
		Для Каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных")
				И ЭлементОтбора.ЛевоеЗначение = ПолеПроект 
				И ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
				
				ВосстановитьСостояниеКнопокСменыСтатуса();
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСостояниеКнопокСменыСтатуса(ГруппаФормы = Неопределено)
	
	Если СостояниеКнопокИзмененияСостоянияПроекта.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ГруппаФормы = Неопределено Тогда
		ГруппаФормы = Элементы.ПанельСтатусовПроекта;
	КонецЕсли;
	
	Для Каждого ЭлементСтраницы Из ГруппаФормы.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ЭлементСтраницы) = Тип("ГруппаФормы")
			И Не ЭлементСтраницы.ПодчиненныеЭлементы.Количество() = 0 Тогда
			ВосстановитьСостояниеКнопокСменыСтатуса(ЭлементСтраницы)
		КонецЕсли;
		
		Если ТипЗнч(ЭлементСтраницы) = Тип("КнопкаФормы") Тогда
			ЭлементСписка = СостояниеКнопокИзмененияСостоянияПроекта.НайтиПоЗначению(ЭлементСтраницы.Имя);
			ЭлементСтраницы.Доступность = ЭлементСписка.Пометка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСостояниеКнопокСменыСтатуса(ГруппаФормы = Неопределено)
	
	Если ГруппаФормы = Неопределено Тогда
		ГруппаФормы = Элементы.ПанельСтатусовПроекта;
	КонецЕсли;
	
	Для Каждого ЭлементСтраницы Из ГруппаФормы.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ЭлементСтраницы) = Тип("ГруппаФормы")
			И Не ЭлементСтраницы.ПодчиненныеЭлементы.Количество() = 0 Тогда
			СохранитьСостояниеКнопокСменыСтатуса(ЭлементСтраницы)
		КонецЕсли;
		
		Если ТипЗнч(ЭлементСтраницы) = Тип("КнопкаФормы") Тогда
			СостояниеКнопокИзмененияСостоянияПроекта.Добавить(ЭлементСтраницы.Имя, , ЭлементСтраницы.Доступность);
		КонецЕсли;
	КонецЦикла;
	
