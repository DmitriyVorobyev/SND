#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)       
    
    УчетВоВнешнейСистеме = упоРаспределениеЗарплатыНастройкиСервер.ЗначениеНастройкиПодсистемы("УчетВоВнешнейСистеме");    
            
    ОграничениеТипа = ПолучитьОграничениеТипаНачислений(УчетВоВнешнейСистеме);
    Элементы.ТаблицаНачисление.ОграничениеТипа = ОграничениеТипа;
    
    НачисленияБезСоответствияPM = Неопределено;
    Если Параметры.Свойство("НачисленияБезСоответствияPM", НачисленияБезСоответствияPM) 
        И НЕ НачисленияБезСоответствияPM = Неопределено Тогда
        ЗаполнитьТаблицуФормы(НачисленияБезСоответствияPM);
    КонецЕсли;
                        
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаПеренестиВДокумент(Команда)
    ПараметрыЗакрытия = Новый Структура("ЗаполнитьНачисленияPM");
    Закрыть(ПараметрыЗакрытия);
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранить(Команда)
    
    ОчиститьСообщения();
    Результат = ПроверитьЗаполнениеТаблицы();
    
    Если НЕ Результат.Ошибки = Неопределено Тогда
        
        ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Результат.Ошибки);
        
        ДополнительныеПараметры = Новый Структура("Строки", Результат.Строки);
        	
        ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередСохранениемПроверкаЗаполненияЗавершение", ЭтаФорма, ДополнительныеПараметры);
        ТекстВопроса = НСтр("ru = 'Найдены ошибки заполнения. Продолжить обработку корректно заполненых строк таблицы?'");	
        Кнопки = РежимДиалогаВопрос.ДаНет;	
        	
        ПоказатьВопрос(
            ОписаниеОповещенияОЗавершении,
        	ТекстВопроса,
        	Кнопки
        	);      	                    
            
        Возврат;
        
    КонецЕсли;  
    
    Результат = КомандаСохранитьНаСервере();
    ВывестиРезультатСохраненияПользователю(Результат);    
    
    Оповестить("Обновлено соответствие начислений РМ");
        
КонецПроцедуры

&НаКлиенте
Процедура ПередСохранениемПроверкаЗаполненияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт 
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда 
        
        Строки = ДополнительныеПараметры.Строки;        
        Для Каждого Строка Из Строки Цикл 
        	Строка.Пометка = Ложь;
        КонецЦикла;               
        
        Результат = КомандаСохранитьНаСервере();
        ВывестиРезультатСохраненияПользователю(Результат);
        Оповестить("Обновлено соответствие начислений РМ");
        
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура КомандаСохранитьИПеренести(Команда)
    
    ОчиститьСообщения();
    Результат = ПроверитьЗаполнениеТаблицы();
    
    Если НЕ Результат.Ошибки = Неопределено Тогда
        
        ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Результат.Ошибки);
        
        ДополнительныеПараметры = Новый Структура("Строки", Результат.Строки);
        	
        ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередСохранениемПроверкаЗаполненияЗавершение", ЭтаФорма, ДополнительныеПараметры);
        ТекстВопроса = НСтр("ru = 'Найдены ошибки заполнения. Продолжить обработку корректно заполненых строк таблицы?'");	
        Кнопки = РежимДиалогаВопрос.ДаНет;	
        	
        ПоказатьВопрос(
            ОписаниеОповещенияОЗавершении,
        	ТекстВопроса,
        	Кнопки
        	);      	                    
            
        Возврат;
        
    КонецЕсли;  
    
    Результат = КомандаСохранитьНаСервере();
    
