#Область ОбработчикиКомандФормы

&НаКлиенте
Функция ОткрытьОтчет(Команда) 
	
	Если Найти(Команда.Имя, "ДляПроекта") <> 0 Тогда
		ПрефиксКоманды = "КомандаДляПроекта";
		ПараметрПроект = упоТекущийПроект;
	ИначеЕсли Найти(Команда.Имя, "ДляПортфеля") <> 0 Тогда
		ПрефиксКоманды = "КомандаДляПортфеля";
		ПараметрПроект = ПолучитьПроектыПоФильтруПортфеля()
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ОткрытьОтчетПроектаПоСлужебнойКоманде(ЭтаФорма, Команда, ПрефиксКоманды, ПараметрПроект);
	
КонецФункции

&НаКлиенте
Процедура ФазыПроекта(Команда)
	
	ПараметрыФормы = Новый Структура();
	ОткрытьФорму("ЖурналДокументов.упоУправлениеПроектом.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПортфельЗаказов(Команда)
	
