#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ОбработатьИзменениеОтбораПроектовНаСервере()
	
	ХранилищеОбщихНастроек.Сохранить("упоОтборПроектов",,ОтборПроектов,"Отбор проектов");
	
КонецФункции

&НаСервере
Функция ДобавитьВызовОтчетов()
	
	МассивОтчетовПоКатегориям = упоРаботаСФормамиСервер.ПолучитьМассивИменОсновныхОтчетовДляПроектаПоКатегориям();
	
	упоРаботаСФормамиСервер.ДобавитьВызовОтчетовПроектаНаФорму(ЭтаФорма, Элементы.ОтчетыПроекта, "КомандаДляПроекта",
		"ОткрытьОтчет", МассивОтчетовПоКатегориям);
		
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("упоСравнениеВерсий");
		
	упоРаботаСФормамиСервер.ДобавитьВызовОтчетовПроектаНаФорму(ЭтаФорма, Элементы.ОтчетыПортфеля, "КомандаДляПортфеля",
		"ОткрытьОтчет", МассивОтчетовПоКатегориям, МассивИсключений);
	
КонецФункции

&НаСервере
Функция ПолучитьПроектыПоФильтруПортфеля(Портфель = Неопределено) 
	
	Если Портфель = Неопределено Тогда 
		Портфель = ОтборПроектов;
	КонецЕсли;
	
	Если Портфель = Перечисления.упоВидыСписковПроектов.ПортфельЗаказов Тогда
		ПортфельЗаказов = Константы.упоПортфельЗаказов.Получить();
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Портфель", ПортфельЗаказов);
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Проекты.Ссылка
		               |ИЗ
		               |	Справочник.Проекты КАК Проекты
		               |ГДЕ
		               |	Проекты.ПортфельПроектов = &Портфель";
		Массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");					   
	Иначе
		
		МассивСтатусов = Новый Массив;
		
		Если Портфель = Перечисления.упоВидыСписковПроектов.ПроектыВИнициации Тогда
			МассивСтатусов.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Запланирован);
			МассивСтатусов.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Утвержден);
		ИначеЕсли Портфель = Перечисления.упоВидыСписковПроектов.ПроектыВыполняемые Тогда
			МассивСтатусов.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Выполняется);
		ИначеЕсли Портфель = Перечисления.упоВидыСписковПроектов.ПроектыЗавершенные Тогда
			МассивСтатусов.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Завершен);
		ИначеЕсли Портфель = Перечисления.упоВидыСписковПроектов.ПроектыОстановленные Тогда
			МассивСтатусов.Добавить(Перечисления.упоСостояниеСтатусаПроекта.Остановлен);			
		КонецЕсли;
		
		Массив = ПолучитьПроектыНеЗаказыВСтатусах(МассивСтатусов);
		
	КонецЕсли;	
	
	Возврат Массив;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПроектыНеЗаказыВСтатусах(МассивСтатусов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Статусы", МассивСтатусов);
	Запрос.УстановитьПараметр("Портфель", Константы.упоПортфельЗаказов.Получить());
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСтатусыПроектовСрезПоследних.Проект
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектов.СрезПоследних КАК упоСтатусыПроектовСрезПоследних
	               |ГДЕ
	               |	упоСтатусыПроектовСрезПоследних.СтатусПроекта В(&Статусы)
	               |	И упоСтатусыПроектовСрезПоследних.Проект.ПортфельПроектов <> &Портфель";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Проект");
	
КонецФункции

&НаКлиенте
Процедура ОткрытьСтруктуруПрограммыПортфеля(Команда)
	
	Если НуженВыборТипаСтруктуры(упоТекущийПроект) Тогда		
		ВыборТипаСтруктуры();
	Иначе
		упоСтруктураПроектаКлиент.ОткрытьСтруктуруПрограммы(упоТекущийПроект);		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НуженВыборТипаСтруктуры(ТекущийПроект)
	
	Компонент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийПроект, "Компонент");
	
	Возврат НЕ (Компонент = Перечисления.упоКомпоненты.ПортфельПроектов 
		ИЛИ Компонент = Перечисления.упоКомпоненты.ПрограммаПроектов);
	
КонецФункции	

&НаКлиенте
Функция ВыборТипаСтруктуры() 
	
	СписокДействий = Новый СписокЗначений;	
	СписокДействий.Добавить("ОткрытьСтруктуруПрограммы", НСтр("ru = 'Структура программы'"));
	СписокДействий.Добавить("ОткрытьСтруктуруПортфеля", НСтр("ru = 'Структура портфеля'"));
							                                                	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборТипаСтруктурыЗавершение", ЭтотОбъект);		
		
	ПоказатьВыборИзМеню(ОписаниеОповещения, СписокДействий);
		
КонецФункции

&НаКлиенте
Процедура ВыборТипаСтруктурыЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры = Неопределено) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	Если ВыбранныйЭлемент.Значение = "ОткрытьСтруктуруПрограммы" Тогда
		
		упоСтруктураПроектаКлиент.ОткрытьСтруктуруПрограммы(упоТекущийПроект);
		
	ИначеЕсли ВыбранныйЭлемент.Значение = "ОткрытьСтруктуруПортфеля" Тогда
		
		упоСтруктураПроектаКлиент.ОткрытьСтруктуруПрограммы(упоТекущийПроект, Истина);
		
	КонецЕсли;	
			
КонецПроцедуры


#КонецОбласти