	ПараметрыОткрытия = Новый Структура("ВидОтбораПроекта", Портфель);
	ПараметрыОткрытия.Вставить("Проект", ПолучитьПроектыПоФильтруПортфеля(Портфель));
	ОткрытьФорму("Справочник.Проекты.ФормаСписка", ПараметрыОткрытия, ЭтаФорма, Портфель);
	
КонецПроцедуры

