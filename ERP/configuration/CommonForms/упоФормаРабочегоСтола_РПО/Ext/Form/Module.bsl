	упоТекущийПроект = ПараметрыСеанса.упоТекущийПроект;
	ДобавитьВызовОтчетов();
	
	СохрОтборПроектов = ХранилищеОбщихНастроек.Загрузить("упоОтборПроектов",,"Отбор проектов");
	Если СохрОтборПроектов = Неопределено Тогда
		ОтборПроектов = Перечисления.упоВидыСписковПроектов.ПроектыВыполняемые;
	Иначе
		ОтборПроектов = СохрОтборПроектов;
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда	
		Элементы.НадписьPM.Видимость = Ложь;
		Элементы.НадписьERP.Видимость = Истина;
	КонецЕсли; 
	
КонецПроцедуры

