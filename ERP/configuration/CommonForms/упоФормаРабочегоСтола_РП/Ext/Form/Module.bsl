&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	Элементы.ДекорацияПроекты.Видимость = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПО();
	Элементы.ДекорацияПроектУПРОФ.Видимость = Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПО();
	
	ЭтоPM_Проф = упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
		"ОбработкаупоДеревоКлючевыхПоказателейПроектаупоСхемаПоказателейПроекта", "Видимость",
		Не ЭтоPM_Проф);	
		
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Неопределено, Отказ, СтандартнаяОбработка); 	
	упоТекущийПроект = ПараметрыСеанса.упоТекущийПроект;
	упоРаботаСФормамиСервер.ДобавитьВызовОтчетовПроектаНаФорму(ЭтаФорма, Элементы.ОтчетыПроекта,
		"КомандаДляПроекта", "ОткрытьОтчет");
	
КонецПроцедуры

#КонецОбласти

