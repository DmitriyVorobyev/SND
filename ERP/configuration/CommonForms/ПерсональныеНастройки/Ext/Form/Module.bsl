&НаКлиенте
Процедура упоФорматСуммВОтчетахНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// {PM}
	ДополнительныеПараметры = Новый Структура("ИмяЭлемента", Элемент.Имя);
	
	Конструктор = Новый КонструкторФорматнойСтроки;
	Конструктор.ДоступныеТипы = Новый ОписаниеТипов("Число");
	Конструктор.Текст = ЭтаФорма[ДополнительныеПараметры.ИмяЭлемента];
	Конструктор.Показать(Новый ОписаниеОповещения("упоФорматКолонокВОтчетахНачалоВыбораЗавершение",ЭтотОбъект, ДополнительныеПараметры));
	// {/PM}
КонецПроцедуры

