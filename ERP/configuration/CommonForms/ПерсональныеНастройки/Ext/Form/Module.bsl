&НаКлиенте
Процедура упоЗаполнитьСпискиВыбора()
	// {PM}	
	СписокМакетов = упоПолучитьСписокМакетов();
	
	упоЗаполнитьСписокВыбора("МакетОформленияОтчетов", СписокМакетов);
	
	СписокМакетов.Вставить(0, "КакВОтчетах", НСтр("ru = 'Как в отчетах'"));
	СписокМакетов.Вставить(1, "ОбщийСтиль", НСтр("ru = 'В зависимости от общего стиля'"));
	упоЗаполнитьСписокВыбора("упоМакетОформленияПанелиРуководителяПодразделения", СписокМакетов);
	
	СписокВариантовЗаполненияПериодов = упоПолучитьСписокВариантовЗаполненияПериода();
	упоЗаполнитьСписокВыбора("упоСохранятьТекущийПериодПриЗагрузкеВариантаПанелиРСП", СписокВариантовЗаполненияПериодов);
	
	// {/PM}	
КонецПроцедуры

&НаСервереБезКонтекста
Функция упоПолучитьСписокМакетов()
	// {PM}
	СписокМакетов = Новый СписокЗначений();
	СписокМакетов.ТипЗначения = Новый ОписаниеТипов("Строка");
	
	СписокМакетов.Добавить(упоТиповыеОтчетыСервер.ПолучитьЗначениеМакетаОформленияБезОформления(), НСтр("ru = 'Не использовать макет'"));
	                                                
	Для Каждого МакетОформления Из БиблиотекаМакетовОформленияКомпоновкиДанных Цикл
		СписокМакетов.Добавить(МакетОформления.Имя, МакетОформления.Представление);	
	КонецЦикла;
	
	Возврат СписокМакетов;
	// {/PM}	
КонецФункции

&НаСервереБезКонтекста
Функция упоПолучитьСписокВариантовЗаполненияПериода()
	// {PM}
	мТипы = Новый Массив;
	мТипы.Добавить(Тип("Строка"));
	мТипы.Добавить(Тип("Булево"));
	
	СписокВариантовЗаполненияПериодов = Новый СписокЗначений();
	СписокВариантовЗаполненияПериодов.ТипЗначения = Новый ОписаниеТипов(мТипы);
	
	СписокВариантовЗаполненияПериодов.Добавить("КакВОтчетах", НСтр("ru = 'Как в отчетах'"));
	СписокВариантовЗаполненияПериодов.Добавить(Истина, НСтр("ru = 'Не загружать период из варианта настройки'"));
	СписокВариантовЗаполненияПериодов.Добавить(Ложь, НСтр("ru = 'Загружать период из варианта настройки'"));                                                
	
	Возврат СписокВариантовЗаполненияПериодов;
	// {/PM}	
КонецФункции

&НаКлиенте
Процедура упоЗаполнитьСписокВыбора(ИмяЭлемента, СписокЗначений)
	// {PM}	
	СписокВыбора = Элементы[ИмяЭлемента].СписокВыбора;
	СписокВыбора.Очистить();
	
	Для Каждого Значение Из СписокЗначений Цикл
		ЗаполнитьЗначенияСвойств(СписокВыбора.Добавить(), Значение);
	КонецЦикла;
	// {/PM}	
КонецПроцедуры

&НаКлиенте
Процедура упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ОбъектИмя, НастройкаИмя, Значение)
	// {PM} 
	Элемент = Новый Структура;
	Элемент.Вставить("Объект", ОбъектИмя);
	Элемент.Вставить("Настройка", НастройкаИмя);
	Элемент.Вставить("Значение", Значение);
	МассивСтруктур.Добавить(Элемент);	
	// {/PM} 
КонецПроцедуры

&НаСервере
Процедура упоИзменитьЭлементыУправления()
	// {PM}
	ЭтотОбъект.УстановитьДействие("ПриОткрытии", "упоПриОткрытии");
	
	упоПользователиВызовСервера.ДобавитьЭлементыКонтураPMНаФормуПерсональныхНастроекПользователя(ЭтотОбъект, ТекущийПользователь);
	// {/PM}
КонецПроцедуры

&НаСервере
Процедура упоЗаполнитьНачальныеЗначения(Отказ, СтандартнаяОбработка)
	// {PM}
	ЭтаФорма["РабочийКалендарьДляРасчетаШаблонов"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСШаблонами",
		"РабочийКалендарьДляРасчетаШаблонов");
	ЭтаФорма["ПоследнийОткрытыйШаблон"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСШаблонами",
		"ПоследнийОткрытыйШаблон");
	ЭтаФорма["ИсключитьИзШаблонаПомеченныеНаУдаление"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСШаблонами",
		"ИсключитьИзШаблонаПомеченныеНаУдаление");
	ЭтаФорма["ОткрыватьПоследнийШаблон"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСШаблонами",
		"ОткрыватьПоследнийШаблон");
	
	ЭтаФорма["упоСохранятьТекущийПериодПриЗагрузкеВариантаОтчета"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСОтчетами",
		"упоСохранятьТекущийПериодПриЗагрузкеВариантаОтчета");

	// Настройки диспетчера.
	ЭтаФорма["СотрудникПоУмолчанию"] = ХранилищеОбщихНастроек.Загрузить("НастройкиДиспетчераПользователя", "СотрудникПоУмолчанию");
	ЭтаФорма["СотрудникПоУмолчаниюДоИзменения"] = ЭтаФорма["СотрудникПоУмолчанию"];
	
	Если Параметры.Свойство("ЭтоВебКлиент") Тогда 
		Если Не Параметры.ЭтоВебКлиент Тогда
			Элементы.УстановитьРасширениеРаботыСФайламиНаКлиенте.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ЭтаФорма["упоТекущийПроект"] = ХранилищеОбщихНастроек.Загрузить("упоТекущийПроект"); 
	
	ЭтаФорма["упоУстанавливатьОтборПоПодразделениюВСпискеРолей"] = 
		ХранилищеОбщихНастроек.Загрузить("СписокРолей", 
		"УстанавливатьОтборПоПодразделениюВСпискеРолей"); 
	
	ЭтаФорма["КоличествоДнейДоКонцаСрокаЗадания"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСЗаданиями",
		"КоличествоДнейДоКонцаСрокаЗадания");
	Если ЭтаФорма["КоличествоДнейДоКонцаСрокаЗадания"] = Неопределено Тогда 
		ЭтаФорма["КоличествоДнейДоКонцаСрокаЗадания"] = 0;
		ХранилищеОбщихНастроек.Сохранить("НастройкиРаботыСЗаданиями", "КоличествоДнейДоКонцаСрокаЗадания",
			ЭтаФорма["КоличествоДнейДоКонцаСрокаЗадания"]);
	КонецЕсли;
	
	ЭтаФорма["КоличествоДнейДляЗакрытыхЗаданий"] = ХранилищеОбщихНастроек.Загрузить("НастройкиРаботыСЗаданиями",
		"КоличествоДнейДляЗакрытыхЗаданий");
	Если ЭтаФорма["КоличествоДнейДляЗакрытыхЗаданий"] = Неопределено Тогда 
		ЭтаФорма["КоличествоДнейДляЗакрытыхЗаданий"] = 0;
		ХранилищеОбщихНастроек.Сохранить("НастройкиРаботыСЗаданиями", "КоличествоДнейДляЗакрытыхЗаданий",
			ЭтаФорма["КоличествоДнейДляЗакрытыхЗаданий"]);
	КонецЕсли;
	
	// Настройки отчетов.
	СтруктураОформлениеОтчета = упоТиповыеОтчетыСервер.ПолучитьНастройкиОформленияОтчета();
	ЭтаФорма["ФорматСуммВОтчетах"] 							= СтруктураОформлениеОтчета.ФорматСумм;
	ЭтаФорма["ШиринаСуммовыхКолонокВОтчетах"] 				= СтруктураОформлениеОтчета.ШиринаСуммовыхКолонок;
	ЭтаФорма["ФорматКоличестваВОтчетах"] 					= СтруктураОформлениеОтчета.ФорматКоличества;
	ЭтаФорма["ШиринаКоличественныхКолонокВОтчетах"] 		= СтруктураОформлениеОтчета.ШиринаКолонокКоличества;
	ЭтаФорма["ФорматТрудозатратВОтчетах"] 					= СтруктураОформлениеОтчета.ФорматТрудозатрат;
	ЭтаФорма["ШиринаКолонокТрудозатратВОтчетах"] 			= СтруктураОформлениеОтчета.ШиринаКолонокТрудозатрат;
	ЭтаФорма["ФорматКоличествоВыделятьОтрицательные"]  		= СтруктураОформлениеОтчета.ФорматКоличествоВыделятьОтрицательные;
	ЭтаФорма["ФорматСуммаВыделятьОтрицательные"]       		= СтруктураОформлениеОтчета.ФорматСуммаВыделятьОтрицательные;
	ЭтаФорма["ФорматТрудозатратВыделятьОтрицательные"]      = СтруктураОформлениеОтчета.ФорматТрудозатратВыделятьОтрицательные;
	ЭтаФорма["МакетОформленияОтчетов"] 						= СтруктураОформлениеОтчета.МакетОформленияОтчетов;
	
	СтруктураГруппировкиОтчета = упоТиповыеОтчетыСервер.ПолучитьНастройкиГруппировокОтчета();
	ЭтаФорма["СворачиватьГруппировкиДоУровня"] 		= СтруктураГруппировкиОтчета.УровеньСворачиванияГруппировок;
	ЭтаФорма["ПрименятьДляВложенныхГрупп"] 			= СтруктураГруппировкиОтчета.ПрименятьДляВложенныхГрупп;

	ЭтаФорма["упоФорматСуммВСтруктуреПроектаКакВОтчетах"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоФорматСуммВСтруктуреПроектаКакВОтчетах");
										
	ЭтаФорма["упоФорматСуммВСтруктуреПроекта"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоФорматСуммВСтруктуреПроекта");
										
	ЭтаФорма.Элементы["упоФорматСуммВСтруктуреПроекта"].Видимость = Не ЭтаФорма["упоФорматСуммВСтруктуреПроектаКакВОтчетах"];
	
	ЭтаФорма["упоФорматКоличестваВСтруктуреПроектаКакВОтчетах"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоФорматКоличестваВСтруктуреПроектаКакВОтчетах");
										
	ЭтаФорма["упоФорматКоличестваВСтруктуреПроекта"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоФорматКоличестваВСтруктуреПроекта");
	
	ЭтаФорма.Элементы["упоФорматКоличестваВСтруктуреПроекта"].Видимость = Не ЭтаФорма["упоФорматКоличестваВСтруктуреПроектаКакВОтчетах"];
	
	// Настроки производительности.
	упоЗагрузитьНастройкиПроизводительностиСтруктурыПроекта(ЭтотОбъект);
	
	ЭтаФорма["ЗагружатьПоказателиПриОткрытииПанелиРуководителя"] = упоПользователиВызовСервера.обПолучитьНастройкуПользователя("ЗагружатьПоказателиПриОткрытииПанелиРуководителя");
	//ЭтаФорма["ЗадержкаПересчетаСроковПослеДобавленияЗадачи"] = упоПользователиВызовСервера.обПолучитьНастройкуПользователя("ЗадержкаПересчетаСроковПослеДобавленияЗадачи"); 
	
	ЭтаФорма["ЗагружатьДанныеПриОткрытииПанелиРуководителяПодразделения"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("ЗагружатьДанныеПриОткрытииПанелиРуководителяПодразделения");
	
	ЭтаФорма["упоМакетОформленияПанелиРуководителяПодразделения"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоМакетОформленияПанелиРуководителяПодразделения");
										
	ЭтаФорма["упоСохранятьТекущийПериодПриЗагрузкеВариантаПанелиРСП"] = упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоСохранятьТекущийПериодПриЗагрузкеВариантаПанелиРСП");
										
	ЭтаФорма["упоФорматКоличестваВПанелиРуководителяПодразделенияКакВОтчетах"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоФорматКоличестваВПанелиРуководителяПодразделенияКакВОтчетах");
										
	ЭтаФорма["упоФорматКоличестваВПанелиРуководителяПодразделения"] = 
										упоПользователиВызовСервера.обПолучитьНастройкуПользователя("упоФорматКоличестваВПанелиРуководителяПодразделения");
										
	ЭтаФорма.Элементы["упоФорматКоличестваВПанелиРуководителяПодразделения"].Видимость = Не ЭтаФорма["упоФорматКоличестваВПанелиРуководителяПодразделенияКакВОтчетах"];
	
	ЭтаФорма["упоОсновнойТрудовойРесурс"] = упоПользователиВызовСервера.ПолучитьОсновнойТрудовойРесурсПользователя(ТекущийПользователь);
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Неопределено, Отказ, СтандартнаяОбработка);
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура упоЗаписатьЗначенияПараметров(МассивСтруктур)
	// {PM}
	СтруктураНастройки = ОписаниеНастройки("НастройкиРаботыСШаблонами", "РабочийКалендарьДляРасчетаШаблонов",
		ЭтотОбъект["РабочийКалендарьДляРасчетаШаблонов"]);
	МассивСтруктур.Добавить(СтруктураНастройки);
	
	СтруктураНастройки = ОписаниеНастройки("НастройкиРаботыСШаблонами", "ПоследнийОткрытыйШаблон",
		ЭтотОбъект["ПоследнийОткрытыйШаблон"]);
	МассивСтруктур.Добавить(СтруктураНастройки);
	
	СтруктураНастройки = ОписаниеНастройки("НастройкиРаботыСШаблонами", "ИсключитьИзШаблонаПомеченныеНаУдаление",
		ЭтотОбъект["ИсключитьИзШаблонаПомеченныеНаУдаление"]);
	МассивСтруктур.Добавить(СтруктураНастройки);
	
	СтруктураНастройки = ОписаниеНастройки("НастройкиРаботыСШаблонами", "ОткрыватьПоследнийШаблон",
		ЭтотОбъект["ОткрыватьПоследнийШаблон"]);
	МассивСтруктур.Добавить(СтруктураНастройки);
	
	СтруктураНастройки = ОписаниеНастройки("НастройкиРаботыСОтчетами", "упоСохранятьТекущийПериодПриЗагрузкеВариантаОтчета",
		ЭтотОбъект["упоСохранятьТекущийПериодПриЗагрузкеВариантаОтчета"]);
	МассивСтруктур.Добавить(СтруктураНастройки);
	
	СтруктураНастройки = ОписаниеНастройки("НастройкиДиспетчераПользователя", "СотрудникПоУмолчанию", ЭтотОбъект["СотрудникПоУмолчанию"]);
	МассивСтруктур.Добавить(СтруктураНастройки);
	
	упоПроектыИЗадачиКлиент.УстановитьПроектТекущим(ЭтотОбъект["упоТекущийПроект"]);	
	
	ИмяОбъекта = "НастройкиРаботыСЗаданиями";  
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "КоличествоДнейДоКонцаСрокаЗадания", ЭтотОбъект["КоличествоДнейДоКонцаСрокаЗадания"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "КоличествоДнейДляЗакрытыхЗаданий", ЭтотОбъект["КоличествоДнейДляЗакрытыхЗаданий"]);
	
	ИмяОбъекта = "СписокРолей";  
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "УстанавливатьОтборПоПодразделениюВСпискеРолей", 
		ЭтотОбъект["упоУстанавливатьОтборПоПодразделениюВСпискеРолей"]);
				
	ИмяОбъекта = "НастройкиРаботыСОтчетами";  
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ФорматСумм", ЭтотОбъект["ФорматСуммВОтчетах"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ШиринаСуммовыхКолонок", ЭтотОбъект["ШиринаСуммовыхКолонокВОтчетах"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ФорматКоличества", ЭтотОбъект["ФорматКоличестваВОтчетах"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ШиринаКолонокКоличества", ЭтотОбъект["ШиринаКоличественныхКолонокВОтчетах"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ФорматТрудозатрат", ЭтотОбъект["ФорматТрудозатратВОтчетах"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ШиринаКолонокТрудозатрат", ЭтотОбъект["ШиринаКолонокТрудозатратВОтчетах"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ФорматКоличествоВыделятьОтрицательные", ЭтотОбъект["ФорматКоличествоВыделятьОтрицательные"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ФорматСуммаВыделятьОтрицательные", ЭтотОбъект["ФорматСуммаВыделятьОтрицательные"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ФорматТрудозатратВыделятьОтрицательные", ЭтотОбъект["ФорматТрудозатратВыделятьОтрицательные"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "МакетОформленияОтчетов", ЭтотОбъект["МакетОформленияОтчетов"]);	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "УровеньСворачиванияГруппировок", ЭтотОбъект["СворачиватьГруппировкиДоУровня"]);
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ПрименятьДляВложенныхГрупп", ЭтотОбъект["ПрименятьДляВложенныхГрупп"]);
	
	ИмяОбъекта = "Обработка.упоУпрощенныйВводСтруктурыПроекта";
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоФорматСуммВСтруктуреПроектаКакВОтчетах", 
										ЭтотОбъект["упоФорматСуммВСтруктуреПроектаКакВОтчетах"]); 
	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоФорматСуммВСтруктуреПроекта", 
										ЭтотОбъект["упоФорматСуммВСтруктуреПроекта"]);
										
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоФорматКоличестваВСтруктуреПроектаКакВОтчетах", 
										ЭтотОбъект["упоФорматКоличестваВСтруктуреПроектаКакВОтчетах"]); 
	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоФорматКоличестваВСтруктуреПроекта", 
										ЭтотОбъект["упоФорматКоличестваВСтруктуреПроекта"]); 
	
	упоСохранитьНастройкиПроизводительностиСтруктурыПроекта();
	
	ИмяОбъекта = "Обработка.упоПанельПоказателей";
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ЗагружатьПоказателиПриОткрытииПанелиРуководителя", 
										ЭтотОбъект["ЗагружатьПоказателиПриОткрытииПанелиРуководителя"]); 
										
	ИмяОбъекта = "Обработка.упоПанельРуководителяПодразделения";
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "ЗагружатьДанныеПриОткрытииПанелиРуководителяПодразделения", 
										ЭтотОбъект["ЗагружатьДанныеПриОткрытииПанелиРуководителяПодразделения"]); 	
	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоМакетОформленияПанелиРуководителяПодразделения", 
										ЭтотОбъект["упоМакетОформленияПанелиРуководителяПодразделения"]); 
	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоСохранятьТекущийПериодПриЗагрузкеВариантаПанелиРСП", 
										ЭтотОбъект["упоСохранятьТекущийПериодПриЗагрузкеВариантаПанелиРСП"]); 
	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоФорматКоличестваВПанелиРуководителяПодразделенияКакВОтчетах", 
										ЭтотОбъект["упоФорматКоличестваВПанелиРуководителяПодразделенияКакВОтчетах"]); 
	
	упоДобавитьЭлементНастройкиВМассив(МассивСтруктур, ИмяОбъекта, "упоФорматКоличестваВПанелиРуководителяПодразделения", 
										ЭтотОбъект["упоФорматКоличестваВПанелиРуководителяПодразделения"]); 
	
	упоПользователиВызовСервера.УстановитьОсновнойТрудовойРесурсПользователя(ТекущийПользователь, ЭтотОбъект["упоОсновнойТрудовойРесурс"]);
	
	упоСохранитьНастройкиОповещений();
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура упоСохранитьНастройкиПроизводительностиСтруктурыПроекта()
	// {PM}
	СписокНастроекПроизводительности = упоСтруктураПроектаКлиентСервер.СписокНастроекПроизводительностиСтруктурыПроекта();
	ПрефиксНастройки = упоИнтеграцияКлиентСервер.ПрефиксПодсистемыPM();
	Для каждого Настройка Из СписокНастроекПроизводительности Цикл
		ИмяНастройки = Настройка.Ключ;
		ЗначениеНастройки = ЭтотОбъект[ПрефиксНастройки + ИмяНастройки];
		
		упоСтруктураПроектаКлиент.СохранитьНастройкуПроизводительностиСтруктурыПроекта(
			ИмяНастройки, ЗначениеНастройки);
	КонецЦикла;
	// {/PM}
КонецПроцедуры

&НаСервереБезКонтекста
Процедура упоЗагрузитьНастройкиПроизводительностиСтруктурыПроекта(Форма)
	// {PM}
	ЗначенияНастроек = упоСтруктураПроекта.СохраненныеНастройкиПроизводительностиСтруктурыПроекта();
	ПрефиксНастройки = упоИнтеграцияКлиентСервер.ПрефиксПодсистемыPM();
	Для каждого Настройка Из ЗначенияНастроек Цикл
		ИмяНастройки = ПрефиксНастройки + Настройка.Ключ;
		ЗначениеНастройки = Настройка.Значение;
		
		Форма[ИмяНастройки] = ЗначениеНастройки;
	КонецЦикла;
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура упоСвернутьРазвернутьГруппу(Элемент)
	// {PM} 
	ЭтаФорма["упоИмяГруппыСвернутьРазвернуть"] = Элемент.Имя;
	ЭтаФорма["упоИмяГруппыСвернутьРазвернуть"] = СтрЗаменить(ЭтаФорма["упоИмяГруппыСвернутьРазвернуть"], "ДекорацияЗаголовок", "");
	упоИзменитьСвернутостьГруппы(ЭтаФорма["упоИмяГруппыСвернутьРазвернуть"]);
	// {/PM}
КонецПроцедуры

&НаСервере
Процедура упоИзменитьСвернутостьГруппы(ИмяГруппы, Свернуть = Неопределено)
	// {PM} 
	Элементы["СворачиваемаяГруппа" + ИмяГруппы].Видимость = ?(Свернуть = Неопределено, Не Элементы["СворачиваемаяГруппа" + ИмяГруппы].Видимость, Не Свернуть);
	// {/PM}
КонецПроцедуры

&НаСервере
Процедура упоРазвернутьСворачиваемуюГруппу(ИмяГруппы)
	// {PM} 
	ГруппаРодитель  = Элементы[ИмяГруппы].Родитель;
	Если ГруппаРодитель = ЭтаФорма Тогда
		Возврат;
	КонецЕсли;
	ИмяГруппыРодителя =ГруппаРодитель.Имя;
	
	Если СтрНайти(ИмяГруппыРодителя, "СворачиваемаяГруппа") = 0 Тогда
		упоРазвернутьСворачиваемуюГруппу(ИмяГруппыРодителя);
	Иначе
		ИмяГруппыРодителя = СтрЗаменить(ИмяГруппыРодителя, "СворачиваемаяГруппа", "");
		упоИзменитьСвернутостьГруппы(ИмяГруппыРодителя, Ложь);
	КонецЕсли;
	// {/PM}
КонецПроцедуры

&НаСервере
Процедура упоСкрытьРаскрытьВсеГруппы(Свернуть = Неопределено)
	// {PM}
	Для Каждого ЭлементИмяГруппы Из ЭтаФорма["упоИменаСворачиваемыхГрупп"] Цикл
		упоИзменитьСвернутостьГруппы(ЭлементИмяГруппы.Значение, Свернуть);
	КонецЦикла;
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура упоПриОткрытии(Отказ)
	// {PM}
	упоЗаполнитьСпискиВыбора();
	упоДопОбработкаНастроекПроизводительностиСтруктурыПроекта();
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура упоДопОбработкаНастроекПроизводительностиСтруктурыПроекта()
	// {PM}
	ПересчитыватьФоново = ЭтотОбъект["упоПересчитыватьФоново"];
	НеСчитатьРасчетныеСрокиИКритическийПуть = ЭтотОбъект["упоНеСчитатьРасчетныеСрокиИКритическийПуть"];
	
	Элементы.упоПересчитыватьФоновоВДвеОчереди.Доступность = ПересчитыватьФоново;
	Если Не ПересчитыватьФоново Тогда
		ЭтотОбъект["упоПересчитыватьФоновоВДвеОчереди"] = Ложь;
	КонецЕсли;
	
	Элементы.упоПересчитыватьТолькоИзмененныеЗадачи.Доступность = НеСчитатьРасчетныеСрокиИКритическийПуть;
	Если Не НеСчитатьРасчетныеСрокиИКритическийПуть Тогда
		ЭтотОбъект["упоПересчитыватьТолькоИзмененныеЗадачи"] = Ложь;
	КонецЕсли;
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_упоСотрудникПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	// {PM}
	СтандартнаяОбработка = Ложь;
	
	ЭтаФорма["СотрудникПоУмолчаниюДоИзменения"] = ЭтаФорма["СотрудникПоУмолчанию"];
	
	ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	упоРаботаСФормамиКлиент.ОткрытьФормуВыбораСотрудниковПользователя(ТекущийПользователь, Элемент);
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_упоСотрудникПоУмолчаниюПриИзменении(Элемент)
	// {PM}
	СотрудникУстановлен = упоПользователиВызовСервера.УстановитьСотрудникаПользователяПоУмолчанию(
		ЭтаФорма["СотрудникПоУмолчанию"], 
		ПользователиКлиентСервер.ТекущийПользователь());
	Если Не СотрудникУстановлен Тогда
		ЭтаФорма["СотрудникПоУмолчанию"] = ЭтаФорма["СотрудникПоУмолчаниюДоИзменения"];
		упоРеквизитПриИзменении(Элемент);
	КонецЕсли;
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_упоКомандаВыборСтиляОформления(Команда)
	// {PM}
	ОткрытьФорму("ОбщаяФорма.упоВыборСтиляОформления", , ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	// {/PM}
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_упоКомандаНастройкиПроизводительностиПоУмолчанию(Команда)
	// {PM}
	НастройкиПроизводительности = упоСтруктураПроектаКлиентСервер.СписокНастроекПроизводительностиСтруктурыПроекта();
	ПрефиксНастройки = упоИнтеграцияКлиентСервер.ПрефиксПодсистемыPM();
	Для каждого Настройка Из НастройкиПроизводительности Цикл
		ИмяРеквизита = ПрефиксНастройки + Настройка.Ключ;
		ЭтотОбъект[ИмяРеквизита] = Настройка.Значение.НастройкаПоУмолчанию;
	КонецЦикла;
	
	ЗаписатьИЗакрыть();
	// {/PM} 
КонецПроцедуры

#КонецОбласти

#КонецОбласти
