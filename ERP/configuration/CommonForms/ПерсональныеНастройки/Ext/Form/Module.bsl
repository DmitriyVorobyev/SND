&НаСервере
Процедура ВыключитьКонтрольОстатковРетроБонусовСервер()
	
	ПараметрыСеанса.ПроводитьБезКонтроляОстатковРетроБонусовКлиентов = Не ПараметрыСеанса.ПроводитьБезКонтроляОстатковРетроБонусовКлиентов;
	
	ОбновитьНадписьКнопкиВыключитьКонтрольОстатковРетроБонусов(ПараметрыСеанса.ПроводитьБезКонтроляОстатковРетроБонусовКлиентов);
	
	Если ПараметрыСеанса.ПроводитьБезКонтроляОстатковРетроБонусовКлиентов Тогда
		ШаблонСообщения = НСтр("ru = 'Пользователем %1 в рамках своего сеанса выключен контроль остатков ретро-бонусов.';
								|en = 'Rebate balance check is disabled by the %1 user during their session.'", ОбщегоНазначения.КодОсновногоЯзыка());
	Иначе
		ШаблонСообщения = НСтр("ru = 'Пользователем %1 возобновлен контроль остатков ретро-бонусов.';
								|en = 'Rebate balance check is resumed by the %1 user.'", ОбщегоНазначения.КодОсновногоЯзыка());
	КонецЕсли;
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		Пользователи.ТекущийПользователь());
	
	ЗаписьЖурналаРегистрации(
		РетроБонусыСервер.ИмяСобытияВыключенКонтрольОстатков(),
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

