&НаКлиенте
Процедура ОтборОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.ЛевоеЗначение) 
		И (Элемент.ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проект") ИЛИ Элемент.ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроектнаяЗадача")) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ЭлементОтбора = Отчет.КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(Элемент.ТекущаяСтрока);
		ЭлементОтбора.ПравоеЗначение = ВыбранноеЗначение;
		ЭлементОтбора.Использование = Истина;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура ОтборПравоеЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ЭтаФорма.ОтобразитьИзменениеДанных(ВыбранноеЗначение, ВидИзмененияДанных.Удаление);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоКомпонентуПроекта(НастройкиПоУмолчанию)
	
	// Процедура связана с упоТиповыеОтчетыСервер.ДобавитьДополнительныеНастройкиВКомпоновщик
	// С кодом упоФункцииОбщегоНазначенияКлиентСервер.УстановитьОтборПоПолюКомпоновки
	
	ЭлементОтбораНайден = Ложь;
	Поле = Новый ПолеКомпоновкиДанных("Проект.Компонент");	
	Для Каждого Элемент Из НастройкиПоУмолчанию.Отбор.Элементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") И Элемент.ЛевоеЗначение = Поле Тогда				
			ЭлементОтбораНайден = Истина;	
			Прервать;
		КонецЕсли;
		
	КонецЦикла;   
	
	Если ЭлементОтбораНайден Тогда			
		Возврат;
	КонецЕсли;
	
	ЭлементПН = НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементПН.ЛевоеЗначение = Поле;
	ЭлементПН.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементПН.ПравоеЗначение = ОбщегоНазначения.ПредопределенныйЭлемент("Перечисление.упоКомпоненты.Проект");
	ЭлементПН.Использование = Истина;				
	
КонецПроцедуры

// Добавляет/устанавливает параметры, программно добавленные в СКД, в параметры варианта отчета.
//
&НаСервере
Процедура ПеренестиИлиЗаполнитьПрограммныеПараметрыСКДВВарианте(НастройкиСКД, НастройкиВарианта)
	
	Если НастройкиОбъекта.Свойство("ТипПлана") Тогда
		Если НастройкиВарианта.ПараметрыДанных.Элементы.Найти("ТипПлана") = Неопределено Тогда
			ПараметрДанныхТипПлана = НастройкиСКД.ПараметрыДанных.Элементы.Найти("ТипПлана");
			Если ПараметрДанныхТипПлана <> Неопределено Тогда
				НовыйПараметр = НастройкиВарианта.ПараметрыДанных.Элементы.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйПараметр, ПараметрДанныхТипПлана);
			КонецЕсли;
		Иначе
			ЗаполнитьДобавленныйПараметрСКДВВарианте(НастройкиСКД, НастройкиВарианта, "ТипПлана");
		КонецЕсли;
	КонецЕсли;
	
	Если НастройкиОбъекта.Свойство("ВыборВерсии") Тогда
		КоличествоВерсий = НастройкиОбъекта.ВыборВерсии.КоличествоВерсий;
		Для НомерВерсии = 1 По КоличествоВерсий Цикл
			ИмяПараметраКД = "Версия" + Строка(НомерВерсии);
			Если НастройкиВарианта.ПараметрыДанных.Элементы.Найти(ИмяПараметраКД) = Неопределено Тогда
				ПараметрДанныхТипПлана = НастройкиСКД.ПараметрыДанных.Элементы.Найти(ИмяПараметраКД);
				Если ПараметрДанныхТипПлана <> Неопределено Тогда
					НовыйПараметр = НастройкиВарианта.ПараметрыДанных.Элементы.Добавить();
					ЗаполнитьЗначенияСвойств(НовыйПараметр, ПараметрДанныхТипПлана);
				КонецЕсли;
			Иначе
				ЗаполнитьДобавленныйПараметрСКДВВарианте(НастройкиСКД, НастройкиВарианта, ИмяПараметраКД);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныйПараметрСКДВВарианте(НастройкиСКД, НастройкиВарианта, ИмяПараметраКД)
	
	ПараметрКД = Новый ПараметрКомпоновкиДанных(ИмяПараметраКД);	
	
	ПараметрСКД = НастройкиСКД.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКД);
	
	ПараметрВарианта = Неопределено;
	Если НастройкиВарианта <> Неопределено Тогда
		ПараметрВарианта = НастройкиВарианта.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКД);
	КонецЕсли;
	
	Если ПараметрСКД <> Неопределено 
		И ПараметрВарианта <> Неопределено
		И Не ЗначениеЗаполнено(ПараметрВарианта.Значение) Тогда		
	   	ЗаполнитьЗначенияСвойств(ПараметрВарианта, ПараметрСКД);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъектов(МассивСсылок, ИмяРеквизита, ВыбратьРазрешенные = Ложь, КодЯзыка = Неопределено)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСсылок, ИмяРеквизита, ВыбратьРазрешенные, КодЯзыка);
	
КонецФункции

&НаКлиенте
Процедура ДополнитьДанныеПоПериоду()
	
	// Если период в отчете не используется, то скрываем соответсвующие поля.
	ПараметрыДанных = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных;
	ПараметрПериод = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
	Если ПараметрПериод = Неопределено Тогда
		Элементы.ГруппаВыборПериода.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПериодВид) Тогда
		ПериодВид = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.ПроизвольныйПериод");
	КонецЕсли;
	
	Если ПериодВид = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.ПроизвольныйПериод") Тогда
		Элементы.ВидыПериодаСтраницы.ТекущаяСтраница = Элементы.СтраницаПроизвольныйПериод;
	КонецЕсли;
	
	Если НЕ Элементы.ПериодЗначениеДатаНачала.Видимость Тогда
		Если ЭтаФорма.ПериодВид = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.ПроизвольныйПериод") Тогда
			ЭтаФорма.ПериодЗначение.ДатаНачала = Дата(1, 1, 1);
		КонецЕсли;
		// Не дадим переключить вид пеиода, т.к. оперируем одной датой.
		Элементы.ВидПериода.Доступность = Ложь;
	КонецЕсли;
	Если НЕ Элементы.ПериодЗначениеДатаОкончания.Видимость Тогда
		Если ЭтаФорма.ПериодВид = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.ПроизвольныйПериод") Тогда
			ЭтаФорма.ПериодЗначение.ДатаОкончания = Дата(3000, 1, 1);
		КонецЕсли;
		// Не дадим переключить вид пеиода, т.к. оперируем одной датой.
		Элементы.ВидПериода.Доступность = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьИзменитьНастройкиПоУмолчанию(ОтчетОбъект)
	
	СКД = ОтчетОбъект.СхемаКомпоновкиДанных;
	
	НастройкиОбъекта = Новый Структура;
	Попытка
		НастройкиОбъекта = ОтчетОбъект.ПолучитьНастройкиОтчета();
	Исключение
	КонецПопытки;
	
	НастройкиПоУмолчанию = СКД.НастройкиПоУмолчанию;
	упоТиповыеОтчетыСервер.УстановитьФорматированиеСуммовыхПолейИзНастроекПользователя(НастройкиПоУмолчанию,
		НастройкиОбъекта);
	упоТиповыеОтчетыСервер.ДобавитьФорматированиеПоказателейИОтборПоРуководителюИСтатусуПроекта(НастройкиПоУмолчанию,
		НастройкиОбъекта);
	
	Если ТипЗнч(НастройкиОбъекта) = Тип("Структура") Тогда
		Если НастройкиОбъекта.Свойство("НастройкиПериода") Тогда
			НастройкиПериодаОтчета = НастройкиОбъекта.НастройкиПериода;
		КонецЕсли;
		Если НастройкиОбъекта.Свойство("ФиксированныйВидПериода", ФиксированныйВидПериода) Тогда
			ПериодВид = ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета." + ФиксированныйВидПериода);
			Элементы.ВидПериода.Доступность = Ложь;
		КонецЕсли;
		Если НастройкиОбъекта.Свойство("ОтключитьОтборПоКомпоненту") Тогда
			Параметры.ОтключитьОтборПоКомпоненту = НастройкиОбъекта.ОтключитьОтборПоКомпоненту;
			Если Не НастройкиОбъекта.ОтключитьОтборПоКомпоненту Тогда
				УстановитьОтборПоКомпонентуПроекта(НастройкиПоУмолчанию);
			КонецЕсли;
		Иначе
			УстановитьОтборПоКомпонентуПроекта(НастройкиПоУмолчанию);
		КонецЕсли;
		Если НастройкиОбъекта.Свойство("УстановитьПараметрыПоУмолчаниюИзОтчета") Тогда
			Попытка
				ОтчетОбъект.УстановитьПараметрыПоУмолчанию(НастройкиОбъекта);
			Исключение
			КонецПопытки;
		КонецЕсли;
		НастройкиОбъекта.Свойство("РеквизитыВДопНастройки", РеквизитыВДопНастройки);
	КонецЕсли;
	
	// Загрузка настроек нужна для применения добавленных параметров СКД.
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиПоляСроковВДополнительнуюИнформацию()
	
	Если Не НастройкиОбъекта.Свойство("ВыводитьДатыПЗКакДополнительнуюИнформацию") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоПредопределенныйВариант Тогда
		Возврат;
	КонецЕсли;
	
	упоТиповыеОтчетыСервер.ПеренестиПоляСроковВДополнительнуюИнформацию(Отчет.КомпоновщикНастроек.Настройки, НастройкиОбъекта);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеФормы()

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ПолеЭлементаУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлементаУО.Поле = Новый ПолеКомпоновкиДанных("КомпоновщикНастроекПользовательскиеНастройки");
	
	ОтборЭлемента = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Настройка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = "Период отчета";
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОдновременноеИспользованиеОтбораНаПроектИПроектнуюЗадачу(НастройкиКомпоновкиДанных, ВыводитьСообщение = Ложь)
	
	ОтборыПоПроекту = Новый Массив;
	ОтборыПоПроектнойЗадаче = Новый Массив;
	
	ЭлементыОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы;
	
	НайтиУстановленныеОтборыПоПроектуИПроектнойЗадаче(ЭлементыОтбора, ОтборыПоПроекту, ОтборыПоПроектнойЗадаче);
	ИспользуетсяОтборПоПроектуИПроектнойЗадаче = ОтборыПоПроекту.Количество() И ОтборыПоПроектнойЗадаче.Количество();
	
	Если НЕ ИспользуетсяОтборПоПроектуИПроектнойЗадаче Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Отбор Из ОтборыПоПроекту Цикл
		Отбор.Использование = Ложь;
	КонецЦикла;
	
	Если ВыводитьСообщение Тогда
		ТекстСообщения = НСтр("ru = 'Обнаружен конфликт настроек отбора: отбор по проекту и проектной задаче в группе ""И"" недопустим.
				|Отбор по проекту был отключен.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиУстановленныеОтборыПоПроектуИПроектнойЗадаче(ЭлементыОтбора, ОтборыПоПроекту, ОтборыПоПроектнойЗадаче)
	
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка(ЭлементОтбора.ЛевоеЗначение) = "Проект" И ЭлементОтбора.Использование Тогда
			ОтборыПоПроекту.Добавить(ЭлементОтбора);
		КонецЕсли;
		
		Если Строка(ЭлементОтбора.ЛевоеЗначение) = "ПроектнаяЗадача" И ЭлементОтбора.Использование Тогда
			ОтборыПоПроектнойЗадаче.Добавить(ЭлементОтбора);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
