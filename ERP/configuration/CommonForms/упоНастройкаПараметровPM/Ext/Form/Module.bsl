&НаСервере
Процедура СкрытьМетодОперативногоПланирования()
	
	// Скрываем поле до проработки механики работы с подразделениями.
	Если упоИнтеграцияКлиентСервер.ИспользоватьМетодОперативногоПланированияРесурсовНаПроект() Тогда
		Возврат;
	КонецЕсли;
	
	мМетодОперативногоПланирования = НаборКонстант.упоМетодОперативногоПланированияПоУмолчанию;
	// Если явно не выбрано планирование работ по подразделениям - скрываем настройку.
	СкрытьВидимость = Не ЗначениеЗаполнено(мМетодОперативногоПланирования) 
		Или мМетодОперативногоПланирования = 
			Перечисления.упоМетодОперативногоПланирования.ПрямоеВыделениеРесурсовНаПроект;
	Если СкрытьВидимость Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
			"упоМетодОперативногоПланированияПоУмолчанию", 
			"Видимость", 
			Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьОчередьПроектовНаРасчетСроков()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	упоОчередьРасчетаСроковПроектов.Проект КАК Проект
		|ИЗ
		|	РегистрСведений.упоОчередьРасчетаСроковПроектов КАК упоОчередьРасчетаСроковПроектов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ЕстьПроектыВОчереди = Не РезультатЗапроса.Пустой();
	Если ЕстьПроектыВОчереди Тогда
		НаборЗаписей = РегистрыСведений.упоОчередьРасчетаСроковПроектов.СоздатьНаборЗаписей();
		НаборЗаписей.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДлительныеОперации

&НаКлиенте
Процедура ВыполнитьЗапускОбновленияСвязейПроектов()
	
	ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
	
	ЭтоФайловаяИнформационнаяБаза = ЭтоФайловаяИнформационнаяБаза();
	
	Если ЭтоФайловаяИнформационнаяБаза Тогда
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания); 
	КонецЕсли;
	
	РезультатВыполнения = ВыполнитьФоновоеОбновлениеСвязейПроектовНаСервере(ЭтоФайловаяИнформационнаяБаза);
	
	Если РезультатВыполнения.ЗаданиеВыполнено Тогда    
		
		РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
		
		ОбработатьРезультатОбновленияСвязей(РезультатВыполнения, ЭтоФайловаяИнформационнаяБаза);
		
	Иначе
		
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, ИдентификаторЗадания); 
		
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);	  
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина); 
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ВыполнитьФоновоеОбновлениеСвязейПроектовНаСервере(ЭтоФайловаяИнформационнаяБаза)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);    
	ИдентификаторЗадания = Неопределено;
	
	СтруктураПараметров = Новый Структура;    
	
	Если ЭтоФайловаяИнформационнаяБаза Тогда
		
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		
		РезультатВыполнения = Новый Структура("ЗаданиеВыполнено", Истина);
		
		упоСвязьПроектаСНаправлениемДеятельности.СинхронизироватьВсеПроектыСНаправлениямиДеятельности();
		
	Иначе
		
		РезультатВыполнения  = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
		"упоСвязьПроектаСНаправлениемДеятельности.СинхронизироватьВсеПроектыСНаправлениямиДеятельностиЗадание", 
		СтруктураПараметров, 
		НСтр("ru = 'Синхронизация проектов с направлениями деятельности'"));    
		
		ИдентификаторЗадания = РезультатВыполнения.ИдентификаторЗадания;
		АдресХранилища       = РезультатВыполнения.АдресХранилища;    
		
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда 								
			РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
			ОбработатьРезультатОбновленияСвязей(РезультатВыполнения);
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 
			ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
		КонецЕсли;
	Исключение
		ЗакрытьФормуИндикатор();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРезультатОбновленияСвязей(РезультатВыполнения, ЭтоФайловаяИнформационнаяБаза = Ложь)
	
	ЗакрытьФормуИндикатор();
	
	Если ЭтоФайловаяИнформационнаяБаза Тогда
		ТекстСообщения = НСтр("ru = 'Связи проектов установлены.'");
	Иначе 
		ТекстСообщения = НСтр("ru = 'Связи проектов установлены. Обработано элементов: %1.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, РезультатВыполнения.Количество);
	КонецЕсли; 
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуИндикатор()
	
	Если Не ФормаДлительнойОперации = Неопределено
		И ФормаДлительнойОперации.Открыта() 
		И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
		
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		
	КонецЕсли;		
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)    
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);    
КонецФункции

&НаКлиенте
Функция ОткрытьРасписаниеПредопределенногоЗадания(ИмяЗадания) 
	
	ПараметрыФормы = Новый Структура;
	
	Идентификатор = ПолучитьИдентификаторПредопределенногоЗадания(ИмяЗадания);
	ПараметрыФормы.Вставить("Идентификатор", Идентификатор);
	ПараметрыФормы.Вставить("Действие",      "Изменить");
	
	ФормаЗадания = ПолучитьФорму("Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание", ПараметрыФормы, ЭтотОбъект);	
	//ФормаЗадания.Элементы.Использование.Видимость = Ложь;
	ФормаЗадания.Открыть();
	
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИдентификаторПредопределенногоЗадания(ИмяЗадания) 
	
	Задание = РегламентныеЗадания.НайтиПредопределенное(
	Метаданные.РегламентныеЗадания[ИмяЗадания]);
	Возврат Задание.УникальныйИдентификатор;	
	
КонецФункции     

