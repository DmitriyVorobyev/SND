Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);	
	
КонецФункции

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);	
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3, П4,
	П5, П5, П6);
	
КонецФункции

#КонецОбласти

#Область Инициализация

&НаСервере
Процедура ЗаполнитьРеквизитыФормы()
	
	ВариантРасчетаСтоимостиТрудозатрат = ?(ПолучитьЗначениеКонстанты("упоИспользоватьСтавкуТрудовогоРесурсаПриРасчетеСтоимостиТрудозатрат"), 1, 0);
	ВариантРаспределенияПоЗаданиямИПроектнымЗадачам = Перечисления.упоВариантыРаспределенияРабочегоВремени.ПоЗаданиямИПроектнымЗадачам;
	
	упоНастройкаПоказателейДляКарточкиПроектовНастройка = Константы.упоНастройкаПоказателейДляКарточкиПроектов.Получить().Получить();
	упоПанельПоказателейКлиентСервер.СформироватьПредставлениеДляНастройкиПоказателейКарточекПроектов(ЭтаФорма);
	
	упоНастройкаПоказателейПрограммПроектовНастройка = Константы.упоНастройкаПоказателейПрограммПроектов.Получить().Получить();
	упоПанельПоказателейКлиентСервер.СформироватьПредставлениеНастройкиПоказателей(
		ЭтаФорма,
		"упоНастройкаПоказателейПрограммПроектовНастройка",
		"упоНастройкаПоказателейПрограммПроектов");
	
	СсылкаНаГруппу = ПолучитьНавигационнуюСсылку(ПредопределенноеЗначение("Справочник.ГруппыДоступа.упоИспользованиеЗащищенногоФункционала"));
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(Элементы.НадписьИспользованиеЗащищенногоФункционала.Заголовок);
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("Использование защищенного функционала", , , , СсылкаНаГруппу));
	
	Элементы.НадписьИспользованиеЗащищенногоФункционала.Заголовок = Новый ФорматированнаяСтрока(МассивСтрок); 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОграниченияВидимостиЭлементов()
	
	ЭлементыСОграниченнымДоступомПРОФ = Новый Структура;
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("ИспользоватьПодсистемуДоговоров", "СтраницаУправлениеДоговорами");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьРасчетЦеныКонтракта", "СтраницаУправлениеДоговорами");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьПодсистемуУправленияРисками", "СтраницаУправлениеРисками");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоУправлятьПрограммамиПроектов", "СтраницаУправлениеПрограммами");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьНормированиеИПроектныеРешения", 
		"СтраницаНормированиеИПроектныеРешения");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьФазыПроектов", "СтраницаФазыПроектов");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьЗаявкиНаПроекты", "СтраницаЗаявкиНаПроекты");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьПричиныОтклонений", "СтраницаСтутсОтчетыПричиныОтклонений");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьСтатусОтчетыПоПроектам", "СтраницаСтутсОтчетыПричиныОтклонений");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьПроектнуюПродукцию", "СтраницаПроектнаяПродукция");
	ЭлементыСОграниченнымДоступомПРОФ.Вставить("упоИспользоватьПодсистемуСогласованиеТрудозатрат", 
		"СтраницаСогласованиеТрудозатрат");
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		
		// В PM ПРОФ показываем кнопку доступности функционала в PM КОРП;
		// В УНФ+PM скрываем функционал, т.к. апгрейда на PM КОРП нет.
		ЭтоУПФ = упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
		ВидимостьЭлемента = Не ЭтоУПФ; 
		
		Для Каждого КлючЗначение Из ЭлементыСОграниченнымДоступомПРОФ Цикл
			ОграничитьДоступКПодсистеме(Элементы[КлючЗначение.Значение], 
				Элементы[КлючЗначение.Ключ], ВидимостьЭлемента);
		КонецЦикла;
		
		Элементы.упоНастройкаДереваКлючевыхПоказателей.Видимость = ВидимостьЭлемента;
	Иначе
		
		Для Каждого КлючЗначение Из ЭлементыСОграниченнымДоступомПРОФ Цикл
			Элементы[КлючЗначение.Ключ].ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		КонецЦикла;
		
	КонецЕсли;

	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		ОграничитьДоступКПодсистеме(Элементы.ГруппаРаспределениеЗП,
			Элементы.КомандаОткрытьФормуНастроекРаспределенияЗП, Ложь);
		
		Элементы.НадписьНастройкиЗаполненияНД.Видимость = Ложь;
		Элементы.ГруппаРазделУчетФакта.Видимость = Ложь; 
		
	КонецЕсли;
	
	Элементы.СтраницаПроектноеБюджетирование.Видимость = 
		упоИнтеграцияКлиентСервер.ФункционалПроектногоБюджетированияДоступен();
		
	Элементы.ГруппаНастройкиПрогнозаТрудозатрат.Видимость = 
		упоИнтеграцияКлиентСервер.ДоступенФункционалПрогнозТрудозатратПоРолям();
		
	УстановитьВидимостьУстаревшихОпций();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьУстаревшихОпций()
	
	// Устаревшие опции скрыты из интерфейса, если не были использованы.
	
	Элементы.упоСоздаватьДокументСохранениеДанныхПроектаОдинЗаДеньГруппа.Видимость = 
		НаборКонстант.упоСоздаватьДокументСохранениеДанныхПроектаОдинЗаДень;
		
	Если ВариантРасчетаСтоимостиТрудозатрат Тогда
		Элементы.ГруппаВариантРасчетаСтоимостиТрудозатрат.Видимость = Ложь;
	Иначе
		Элементы.ГруппаВариантРасчетаСтоимостиТрудозатратПредупреждение.Видимость = Ложь; // Служебная информация.
	КонецЕсли;
	
	СкрытьМетодОперативногоПланирования();
	
	Элементы.ГруппаНастройкиОтображенияДоходовРасходовВПЗ.Видимость = 
		Не НаборКонстант.упоПоказыватьНаЗакладкахПланДоходовПланРасходовДДСДанныеОтраженияСДругихЗакладок;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОграничитьДоступКПодсистеме(Группа, Элемент, ВидимостьГруппы)
	
	Элемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	
	Группа.Видимость = ВидимостьГруппы;
	Если ВидимостьГруппы Тогда
		Для Каждого ПодчиненныйЭлемент Из Группа.ПодчиненныеЭлементы Цикл
			ПодчиненныйЭлемент.Доступность = Ложь;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМассивРеквизитовТребующихОбновленияИнтрефейса()
	
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьРасчетЦеныКонтракта");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьФазыПроектов");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьПодсистемуДоговоров");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьПодсистемуУправленияРисками");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоУправлятьПрограммамиПроектов");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьНормированиеИПроектныеРешения");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоПроводитьОценкуИсполнителейПодрядчиков");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьЗагрузкуИзСметы");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьОповещения");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьЗаявкиНаПроекты");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьСтатусОтчетыПоПроектам");
	СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоСоздаватьДокументСохранениеДанныхПроектаОдинЗаДень");
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьПодсистемуСогласованиеТрудозатрат");
	КонецЕсли;
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		СписокРеквизитовТребующихОбновленияИнтерфейса.Добавить("упоИспользоватьПроектнуюПродукцию");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяОбновитьИнтерфейс(ПутьКДаннымЭлемента)
	
	Возврат СписокРеквизитовТребующихОбновленияИнтерфейса.НайтиПоЗначению(ПутьКДаннымЭлемента) <> Неопределено;
	
КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

&НаКлиенте
Процедура ПриИзмененииРеквизита(Элемент)
	
	КонстантаИмя = ПриИзмененииРеквизитаСервер(Элемент.Имя);
	
	ОбновлятьИнтерфейс = ТребуетсяОбновитьИнтерфейс(КонстантаИмя);
	
	Если ОбновлятьИнтерфейс Тогда
		ОбновитьИнтерфейс = Истина;
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 2, Истина);
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
		Если КонстантаИмя = "ВалютаУправленческогоУчета" Тогда
			Оповестить("Запись_НаборКонстант", Новый Структура, КонстантаИмя);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнтерфейсПрограммы()
	
	Если ОбновитьИнтерфейс = Истина Тогда
		ОбновитьИнтерфейс = Ложь;
		ОбщегоНазначенияКлиент.ОбновитьИнтерфейсПрограммы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПриИзмененииРеквизитаСервер(ИмяЭлемента)
	
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	
	КонстантаИмя = СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	
	УстановитьДоступностьВидимостьЭлементовФормы(РеквизитПутьКДанным);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Функция СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);	
	КонецЕсли; 
	
	// Сохранения значения константы.
	УстановитьЗначениеКонстанты(КонстантаИмя);
	
	Если РеквизитПутьКДанным = "упоНастройкаПоказателейДляКарточкиПроектов" Тогда 
		
		ХранилищеНастройки = Новый ХранилищеЗначения(упоНастройкаПоказателейДляКарточкиПроектовНастройка);
		Константы.упоНастройкаПоказателейДляКарточкиПроектов.Установить(ХранилищеНастройки);
		
	ИначеЕсли РеквизитПутьКДанным = "упоНастройкаПоказателейПрограммПроектов" Тогда 
		
		ХранилищеНастройки = Новый ХранилищеЗначения(упоНастройкаПоказателейПрограммПроектовНастройка);
		Константы.упоНастройкаПоказателейПрограммПроектов.Установить(ХранилищеНастройки);
		
	ИначеЕсли РеквизитПутьКДанным = "ВариантРасчетаСтоимостиТрудозатрат" Тогда
		
		Константы.упоИспользоватьСтавкуТрудовогоРесурсаПриРасчетеСтоимостиТрудозатрат.Установить(ВариантРасчетаСтоимостиТрудозатрат);
		
	КонецЕсли;
	
	Если КонстантаИмя = "ВалютаУправленческогоУчета" Тогда
		
		ПараметрыСеанса.упоВалютаУправленческогоУчета = НаборКонстант.ВалютаУправленческогоУчета;
		
		Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ() Тогда
			Константы["ВалютаУчета"].Установить(НаборКонстант.ВалютаУправленческогоУчета);
		КонецЕсли;
		
	КонецЕсли;
	
	ИзменитьЗависимыеРеквизиты(КонстантаИмя);
	
	Возврат КонстантаИмя;
	
КонецФункции

&НаСервере
Процедура УстановитьЗначениеКонстанты(КонстантаИмя)
	
	Если КонстантаИмя <> "" Тогда 
		
		КонстантаМенеджер = Константы[КонстантаИмя];
		КонстантаЗначение = НаборКонстант[КонстантаИмя];
		
		Если КонстантаИмя = "упоПоказательСложности" 
			И Не Документы.упоЗакрытиеЭтапа.ПоказательСложностьЗаполненПравильно(КонстантаЗначение) Тогда
			НаборКонстант[КонстантаИмя] = КонстантаМенеджер.Получить();
		КонецЕсли;
		
		Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(КонстантаЗначение);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЗависимыеРеквизиты(РеквизитПутьКДанным)
	
	Если РеквизитПутьКДанным = "" Тогда	
		Возврат;	
	КонецЕсли; 
	
	Если РеквизитПутьКДанным = "упоВедетсяБюджетДоходов" Тогда
		
		Если НаборКонстант.упоВедетсяБюджетДоходов = Ложь Тогда
			
			НаборКонстант.упоДоходыПоПодразделениям = Ложь;	
			НаборКонстант.упоДоходыПоОбъемам = Ложь;
			НаборКонстант.упоДоходыПоНатуральнымПоказателям = Ложь;
			
			УстановитьЗначениеКонстанты("упоДоходыПоПодразделениям");
			УстановитьЗначениеКонстанты("упоДоходыПоОбъемам");
			УстановитьЗначениеКонстанты("упоДоходыПоНатуральнымПоказателям");
			
		КонецЕсли;	
		
	ИначеЕсли РеквизитПутьКДанным = "упоДоходыПоПодразделениям" Тогда
		
		Если НаборКонстант.упоДоходыПоПодразделениям = Ложь Тогда
			
			НаборКонстант.упоДоходыПоОбъемам = Ложь;
			НаборКонстант.упоДоходыПоНатуральнымПоказателям = Ложь;
			
			УстановитьЗначениеКонстанты("упоДоходыПоОбъемам");
			УстановитьЗначениеКонстанты("упоДоходыПоНатуральнымПоказателям");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоДоходыПоОбъемам" Тогда
		
		Если НаборКонстант.упоДоходыПоОбъемам = Ложь Тогда
			
			НаборКонстант.упоДоходыПоНатуральнымПоказателям = Ложь;
			
			УстановитьЗначениеКонстанты("упоДоходыПоНатуральнымПоказателям");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоВедетсяБюджетРасходов" Тогда
		
		Если НаборКонстант.упоВедетсяБюджетРасходов = Ложь Тогда
			
			НаборКонстант.упоРасходыПоПодразделениям = Ложь;
			НаборКонстант.упоРасходыПоОбъемам = Ложь;
			НаборКонстант.упоРасходыПоНатуральнымПоказателям = Ложь;
			
			УстановитьЗначениеКонстанты("упоРасходыПоПодразделениям");
			УстановитьЗначениеКонстанты("упоРасходыПоОбъемам");
			УстановитьЗначениеКонстанты("упоРасходыПоНатуральнымПоказателям");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоРасходыПоПодразделениям" Тогда
		
		Если НаборКонстант.упоРасходыПоПодразделениям = Ложь Тогда
			
			НаборКонстант.упоРасходыПоОбъемам = Ложь;
			НаборКонстант.упоРасходыПоНатуральнымПоказателям = Ложь;
			
			УстановитьЗначениеКонстанты("упоРасходыПоОбъемам");
			УстановитьЗначениеКонстанты("упоРасходыПоНатуральнымПоказателям");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоРасходыПоОбъемам" Тогда
		
		Если НаборКонстант.упоРасходыПоОбъемам = Ложь Тогда
			
			НаборКонстант.упоРасходыПоНатуральнымПоказателям = Ложь;
			
			УстановитьЗначениеКонстанты("упоРасходыПоНатуральнымПоказателям");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоРасходыПоНатуральнымПоказателям" Тогда
		
		Если НаборКонстант.упоРасходыПоНатуральнымПоказателям = Истина Тогда
			
			НаборКонстант.упоПланироватьЗатратыНаМатериалы = Истина;
			
			УстановитьЗначениеКонстанты("упоПланироватьЗатратыНаМатериалы");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоОтражатьФактДоходовПервичнымиДокументами" Тогда
		
		Если НаборКонстант.упоОтражатьФактДоходовПервичнымиДокументами = Ложь Тогда
			
			НаборКонстант.упоВключатьНДСВФактДоходовПервичныхДокументов = Ложь;
			УстановитьЗначениеКонстанты("упоВключатьНДСВФактДоходовПервичныхДокументов");
			
		КонецЕсли;	
		
	ИначеЕсли РеквизитПутьКДанным = "упоОтражатьФактРасходовПервичнымиДокументами" Тогда
		
		Если НаборКонстант.упоОтражатьФактРасходовПервичнымиДокументами = Ложь Тогда
			
			НаборКонстант.упоВключатьНДСВФактРасходовПервичныхДокументов = Ложь;
			НаборКонстант.упоОтражатьФактРасходаПриПриобретенииТоваров = Ложь;
			
			УстановитьЗначениеКонстанты("упоВключатьНДСВФактРасходовПервичныхДокументов");
			УстановитьЗначениеКонстанты("упоОтражатьФактРасходаПриПриобретенииТоваров");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности" Тогда
		
		Если НаборКонстант.упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности Тогда
			
			НаборКонстант.упоИспДлитВместоПустТрудЗатДляРасчГотовности = Истина;
			
			УстановитьЗначениеКонстанты("упоИспДлитВместоПустТрудЗатДляРасчГотовности");
			
		КонецЕсли;
		
	ИначеЕсли РеквизитПутьКДанным = "упоНазначатьРСПОсновнойРолиКакРПЗ" Тогда
		
		Если НаборКонстант.упоНазначатьРСПОсновнойРолиКакРПЗ = Ложь 
			И НаборКонстант.упоУстанавливатьПризнакОсновнаяПриДобавленииРоли = Истина Тогда
			
			НаборКонстант.упоУстанавливатьПризнакОсновнаяПриДобавленииРоли = Ложь;
			
			УстановитьЗначениеКонстанты("упоУстанавливатьПризнакОсновнаяПриДобавленииРоли");
			
		КонецЕсли;	
	ИначеЕсли РеквизитПутьКДанным = "упоПланироватьТрудозатратыПоПроекту" Тогда
		
		Если НаборКонстант.упоПланироватьТрудозатратыПоПроекту = Ложь 
			И НаборКонстант.упоУказыватьПодразделениеРолиПриПланированииТР = Истина Тогда
			
			НаборКонстант.упоУказыватьПодразделениеРолиПриПланированииТР = Ложь;
			
			УстановитьЗначениеКонстанты("упоУказыватьПодразделениеРолиПриПланированииТР");
			
		КонецЕсли;	
		
	ИначеЕсли РеквизитПутьКДанным = "упоИспользоватьПодсистемуСогласованиеТрудозатрат" Тогда
		
		Если НаборКонстант.упоИспользоватьПодсистемуСогласованиеТрудозатрат
			И Не ЗначениеЗаполнено(НаборКонстант.упоПериодСогласованияТрудозатрат) Тогда
			
			НаборКонстант.упоПериодСогласованияТрудозатрат = Перечисления.упоПериодыСогласованияТрудозатрат.Месяц;
			УстановитьЗначениеКонстанты("упоПериодСогласованияТрудозатрат");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПроверкаДоступностиВалютыУчета()
	
	стрЗаголовка = "";
	ЕстьДокументы = Ложь;
	
	Если Не ПравоДоступа("Изменение", Метаданные.Константы.ВалютаУправленческогоУчета) Тогда
		
		// Если нет прав на изменение хотя бы одной константы - закрываем доступ на все.
		стрЗаголовка = НСтр("ru = ' Нет прав на изменение хоть одной константы валют.'");
		ЕстьДокументы = Истина;
		
	Иначе	
		
		Запрос = Новый Запрос;
		СчетчикДокументов = 0;
		Для каждого Док Из Метаданные.Документы Цикл
			Запрос.Текст = Запрос.Текст
			+ ?(Запрос.Текст = "",
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1", 
			" 
			|
			|ОБЪЕДИНИТЬ ВСЕ 
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1 ") + "
			|
			|	Документ" + Док.Имя + ".Ссылка
			|ИЗ
			|	Документ." + Док.Имя + " КАК " + "Документ" + Док.Имя + "
			|";
			
			СчетчикДокументов = СчетчикДокументов + 1;
			
			Если СчетчикДокументов > 3 Тогда
				СчетчикДокументов = 0;
				Попытка
					РезультатЗапроса = Запрос.Выполнить();
					ЕстьДокументы = НЕ РезультатЗапроса.Пустой();
				Исключение
					ЕстьДокументы = Истина;
				КонецПопытки;
				
				Если ЕстьДокументы Тогда
					Прервать;
				КонецЕсли; 
				Запрос.Текст = "";
			КонецЕсли;
		КонецЦикла;
		
		Если СчетчикДокументов > 0 Тогда
			Попытка
				РезультатЗапроса = Запрос.Выполнить();
				ЕстьДокументы = НЕ РезультатЗапроса.Пустой();
			Исключение
				ЕстьДокументы = Истина;
			КонецПопытки;
		КонецЕсли; 
		
	КонецЕсли;
	
	Элементы.ВалютаУправленческогоУчета.ТолькоПросмотр = ЕстьДокументы;
	
	Если ПустаяСтрока(стрЗаголовка) Тогда
		Если ЕстьДокументы Тогда
			Элементы.ТекстВажнойНадписи.Заголовок = НСтр("ru = ' После ввода документов валюты учета изменять нельзя.'");
		Иначе
			Элементы.ТекстВажнойНадписи.Заголовок = НСтр("ru = ' Валюты учета можно изменять пока не введены документы.'");
		КонецЕсли;
	Иначе
		Элементы.ТекстВажнойНадписи.Заголовок = стрЗаголовка;
	КонецЕсли;	
	
КонецФункции

