&НаКлиенте
Процедура КомандаДобавитьСтатью(Команда)
	ОткрытьФорму("РегистрСведений.упоСтатьиФОТ.ФормаЗаписи", ,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьСтатью(Команда)
	ТекущаяСтрока = Элементы.СтатьиФОТ.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		УдалитьСтатьюФОТ(ТекущаяСтрока);			
		Элементы.СтатьиФОТ.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИдентификаторыМетаданных(Команда)
	
	ЕстьИзменения = Ложь;
	ЕстьУдаленные = Ложь;
	
	ОбновитьДанныеСправочникаНаСервере(ЕстьИзменения, ЕстьУдаленные);
	
	Если ЕстьИзменения Тогда
		Текст = НСтр("ru = 'Обновление выполнено успешно.'");
	Иначе
		Текст = НСтр("ru = 'Обновление не требуется.'");
	КонецЕсли;
	
	Если ЕстьУдаленные Тогда
		Текст = Текст
		+ Символы.ПС
		+ Символы.ПС
		+ НСтр("ru = 'Найдены удаленные объекты метаданных
		|(см. элементы, начинающиеся с символа ""?"").'");
	КонецЕсли;
	
	ПоказатьПредупреждение(,Текст);
	
КонецПроцедуры

