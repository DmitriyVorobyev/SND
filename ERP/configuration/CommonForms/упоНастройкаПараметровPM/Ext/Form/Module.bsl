&НаСервере
Процедура ОбновитьВариантыОтчетовНаСервере()
	
	ПараметрыОбновления = Новый Структура;	
	ПараметрыОбновления.Вставить("РазделенныеОбработчики", Неопределено);
	ВариантыОтчетов.ОперативноеОбновлениеОбщихДанныхКонфигурации(ПараметрыОбновления);
	ВариантыОтчетов.ОперативноеОбновлениеРазделенныхДанныхКонфигурации();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСправочникаНаСервере(ЕстьИзменения, ЕстьУдаленные)
	
	УстановитьПривилегированныйРежим(Истина);
	Справочники.ИдентификаторыОбъектовМетаданных.ОбновитьДанныеСправочника(ЕстьИзменения, ЕстьУдаленные);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста	
Процедура ДоступностьАналитикаВРазрезеПодразделений(Форма)
	
	Форма.Элементы.упоДоходыПоПодразделениям.Доступность = Форма.НаборКонстант.упоВедетсяБюджетДоходов;
	Форма.Элементы.упоДоходыПоОбъемам.Доступность = Форма.НаборКонстант.упоДоходыПоПодразделениям;
	Форма.Элементы.упоДоходыПоНатуральнымПоказателям.Доступность = 
		(Форма.НаборКонстант.упоДоходыПоПодразделениям И Форма.НаборКонстант.упоДоходыПоОбъемам);
	
	Форма.Элементы.упоРасходыПоПодразделениям.Доступность = Форма.НаборКонстант.упоВедетсяБюджетРасходов;
	Форма.Элементы.упоРасходыПоОбъемам.Доступность = Форма.НаборКонстант.упоРасходыПоПодразделениям;
	Форма.Элементы.упоРасходыПоНатуральнымПоказателям.Доступность = 
		(Форма.НаборКонстант.упоРасходыПоПодразделениям И Форма.НаборКонстант.упоРасходыПоОбъемам);
		
	Форма.Элементы.упоПланироватьЗатратыНаМатериалы.Доступность = Не Форма.НаборКонстант.упоРасходыПоНатуральнымПоказателям;	
			
	Форма.Элементы.упоНастройкаРаспределенияБДР.Доступность = 
		Форма.НаборКонстант.упоДоходыПоПодразделениям Или Форма.НаборКонстант.упоРасходыПоПодразделениям;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДоступностьВидимостьЭлементовФормы(РеквизитПутьКДанным = "")
	
	ДоступностьАналитикаВРазрезеПодразделений(ЭтаФорма);
	
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоПроводитьОценкуИсполнителейПодрядчиков" Тогда
		Элементы.ГруппаНастройкиОценок.Доступность = НаборКонстант.упоПроводитьОценкуИсполнителейПодрядчиков;
	КонецЕсли;
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании" Тогда
		Элементы.ГруппаПараметрыЭкономики.Доступность = 
			НаборКонстант.упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании;
	КонецЕсли;
	
	//
	ДоступноОтражениеФакта = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Или упоИнтеграцияКлиентСерверПовтИсп.ЭтоУПФ();
	
	Элементы.упоВключатьНДСВФактДоходовПервичныхДокументов.Доступность = 
		ДоступноОтражениеФакта И НаборКонстант["упоОтражатьФактДоходовПервичнымиДокументами"];
	Элементы.упоВключатьНДСВФактРасходовПервичныхДокументов.Доступность = 
		ДоступноОтражениеФакта И НаборКонстант["упоОтражатьФактРасходовПервичнымиДокументами"];
	Элементы.упоОтражатьФактРасходаПриПриобретенииТоваров.Доступность = 
		ДоступноОтражениеФакта И НаборКонстант["упоОтражатьФактРасходовПервичнымиДокументами"];
	Элементы.упоСтатьяРасходовПриПриобретенииТоваров.Доступность = 
		ДоступноОтражениеФакта И НаборКонстант["упоОтражатьФактРасходаПриПриобретенииТоваров"];
	
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоВариантРаспределенияРабочегоВремени" Тогда
		ВариантРаспределенияРабочегоВремени = НаборКонстант.упоВариантРаспределенияРабочегоВремени;
		
		УстановитьДоступностьКонстантыПравилоЗаполненияПоручениямиИПроектнымиЗадачами(ЭтаФорма,
		ВариантРаспределенияРабочегоВремени, ВариантРаспределенияПоЗаданиямИПроектнымЗадачам);
		
		Если ВариантРаспределенияРабочегоВремени = ВариантРаспределенияПоЗаданиямИПроектнымЗадачам 
			И Не ЗначениеЗаполнено(НаборКонстант.упоПравилоРаспределенияРабочегоВремениНаЗаданияИПроектныеЗадачи) Тогда
			
			ПравилоЗаполнятьВсе = ПредопределенноеЗначение(
				"Перечисление.упоПравилаРаспределенияРабочегоВремениНаЗаданияИПроектныеЗадачи.ВсеПроектныеЗадачиИЗадания");
			НаборКонстант.упоПравилоРаспределенияРабочегоВремениНаЗаданияИПроектныеЗадачи = ПравилоЗаполнятьВсе;
			
		КонецЕсли;
	КонецЕсли;
	
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоИспользоватьСвязьПроектовСНаправлениямиДеятельности" Тогда
		Элементы.ГруппаНастройкиСвязи.Доступность = НаборКонстант.упоИспользоватьСвязьПроектовСНаправлениямиДеятельности;
	КонецЕсли;
	
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности" Тогда
		Элементы.упоНастройкаУровняПланированияПриРасчетеГотовностиПроектов.Доступность = 
			НаборКонстант.упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности;
		Элементы.упоИспДлитВместоПустТрудЗатДляРасчГотовности.Доступность = 
			НаборКонстант.упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности;
	КонецЕсли;
		
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоПоказательСложности" Тогда
		Элементы.упоПроводитьОценкуИсполнителейПодрядчиков.Доступность = 
			ЗначениеЗаполнено(НаборКонстант.упоПоказательСложности);
	КонецЕсли;
		
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоСоздаватьДокументСохранениеДанныхПроектаОдинЗаДень" Тогда
		Элементы.упоСоздаватьДокументСохранениеДанныхПроектаОдинЗаДень.Доступность = 
			НаборКонстант.упоСоздаватьДокументСохранениеДанныхПроектаОдинЗаДень;
	КонецЕсли;
	
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоНазначатьРСПОсновнойРолиКакРПЗ" Тогда
		Элементы.упоУстанавливатьПризнакОсновнаяПриДобавленииРоли.Доступность = 
			НаборКонстант.упоНазначатьРСПОсновнойРолиКакРПЗ;
	КонецЕсли;
		
	//
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоПланироватьТрудозатратыПоПроекту" Тогда
		Элементы.упоУказыватьПодразделениеРолиПриПланированииТР.Доступность = 
			НаборКонстант.упоПланироватьТрудозатратыПоПроекту;
	КонецЕсли;
		
	Если РеквизитПутьКДанным = "" 
		Или РеквизитПутьКДанным = "НаборКонстант.упоИспользоватьПодсистемуСогласованиеТрудозатрат"
		Или РеквизитПутьКДанным = "НаборКонстант.упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании" Тогда
		Элементы.КомандаОбновитьПравилаПБДляСогласования.Видимость = 
			НаборКонстант.упоИспользоватьПодсистемуСогласованиеТрудозатрат 
			И НаборКонстант.упоИспользоватьОтражениеПервичныхДокументовВПроектномБюджетировании;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКонстантыПравилоЗаполненияПоручениямиИПроектнымиЗадачами(Форма, 
	ВариантРаспределения, ВариантРаспределенияПоЗаданиямИПроектнымЗадачам)
	
	ЭлементДоступен = ?(ВариантРаспределения = ВариантРаспределенияПоЗаданиямИПроектнымЗадачам, Истина, Ложь);
