
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Функция ДоступныеЗначения() Экспорт

    ДанныеВыбора = Новый Массив;
    МассивИсключения = Новый Массив; 
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалПланированияНакладныхРасходовПоБюджету() Тогда
		МассивИсключения.Добавить(Перечисления.упоПринадлежностьПоказателя.Произвольный);
	КонецЕсли;      
	
    Запрос = Новый Запрос; 
    Запрос.УстановитьПараметр("МассивИсключения", МассивИсключения);
    
    Запрос.Текст = "ВЫБРАТЬ
    |    Перечисление.Ссылка КАК Ссылка
    |ИЗ
    |    Перечисление.упоПринадлежностьПоказателя КАК Перечисление
    |ГДЕ
    |    НЕ Перечисление.Ссылка В (&МассивИсключения)";
    
    РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
    	ДанныеВыбора.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат ДанныеВыбора;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;
    ДанныеВыбора = ДоступныеЗначения(); 

КонецПроцедуры

#КонецОбласти

#КонецЕсли
