#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяМодуляОтправкиСообщенийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	
	МассивМодулей = упоОповещенияВызовСервера.ПолучитьМассивМодулейТранспортов();
	
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(МассивМодулей);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмяМодуляОтправкиСообщенийПриИзменении(Элемент)
	ЗаполнитьНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыТранспортаПриАктивизацииСтроки(Элемент)
		
	ТекДанные = Элементы.ПараметрыТранспорта.ТекущиеДанные;
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ТипЗнч(ТекДанные.ЗначениеПараметра));
	Элементы.ПараметрыТранспортаЗначениеПараметра.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНастройки()
	
	ОбновитьИнформациюПоМодулю();
	
	Попытка
		ИсполняемыйМодуль = Вычислить(Объект.ИмяМодуляОтправкиСообщений);
		НастройкиТранспорта = ИсполняемыйМодуль.ПолучитьНастройкиТранспорта();
		ЗаполнитьЗначенияСвойств(Объект, НастройкиТранспорта);
		Если НастройкиТранспорта.Свойство("ПараметрыТранспорта") Тогда;
			ВремПараметры = НастройкиТранспорта.ПараметрыТранспорта;
			тзПараметры.Очистить();
			Для Каждого Эл Из ВремПараметры Цикл
				НовСтр = тзПараметры.Добавить();
				НовСтр.ИмяПараметра = Эл.Ключ;
				НовСтр.ЗначениеПараметра = Эл.Значение;
			КонецЦикла;
		КонецЕсли;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='" + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + "'");
		Сообщение.Сообщить();
	КонецПопытки;
	
	УстановитьВидимостьДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Функция ОбновитьИнформациюПоМодулю() 
	
	УдалитьДобавленныеЭлементы();
	
	Попытка
		ИсполняемыйМодуль = Вычислить(Объект.ИмяМодуляОтправкиСообщений);
		Информация = ИсполняемыйМодуль.Информация();
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Информация);
	Исключение
	КонецПопытки;
	
	Попытка
		ИсполняемыйМодуль = Вычислить(Объект.ИмяМодуляОтправкиСообщений);
		ИсполняемыйМодуль.ВыводНаФормуДополнительнойИнформации(ЭтаФорма);
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;	
	
КонецФункции

&НаСервере
Функция УдалитьДобавленныеЭлементы()
	МассивРеквизитовНаУдаление = Новый Массив;
	Для Каждого СтрокаЭлемента Из ДобавленныеЭлементы Цикл
		Тип = НРег(СтрокаЭлемента.Тип);
		Если Тип = "реквизит" Тогда	
			МассивРеквизитовНаУдаление.Добавить(СтрокаЭлемента.Имя);	
		ИначеЕсли Тип = "элемент" Тогда
			Элемент = Элементы.Найти(СтрокаЭлемента.Имя);
			Если Элемент <> Неопределено Тогда
				Элементы.Удалить(Элемент);
			КонецЕсли;
		ИначеЕсли Тип = "команда" Тогда	
			Команда = Команды.Найти(СтрокаЭлемента.Имя);
			Если Команда <> Неопределено Тогда
				Команды.Удалить(Команда);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если МассивРеквизитовНаУдаление.Количество() Тогда
		Попытка
			ИзменитьРеквизиты(, МассивРеквизитовНаУдаление);
		Исключение
		КонецПопытки;
	КонецЕсли;
	ДобавленныеЭлементы.Очистить();
КонецФункции 

&НаКлиенте
Функция Подключаемый_ОткрытьНавигационнуюСсылкуПоЗаголовкуКоманды(Команда) 
	ПерейтиПоНавигационнойСсылке(ПолучитьЗаголовокКоманды(Команда.Имя));
КонецФункции

&НаСервере
Функция ПолучитьЗаголовокКоманды(ИмяКоманды) 
	Возврат Команды.Найти(ИмяКоманды).Заголовок;	
КонецФункции

&НаСервере
Функция УстановитьВидимостьДоступностьЭлементов() 
	Элементы.ПараметрыТранспорта.Видимость = тзПараметры.Количество();
КонецФункции

&НаСервере
Функция ПрочитатьПараметры(ТекущийОбъект) 
		
	стрПараметры = ТекущийОбъект.Параметры.Получить();
	тзПараметры.Очистить();
	Если ТипЗнч(стрПараметры) = Тип("Структура") Тогда
		Для Каждого Эл Из стрПараметры Цикл
			НовСтр = тзПараметры.Добавить();
			НовСтр.ИмяПараметра = Эл.Ключ;
			НовСтр.ЗначениеПараметра = Эл.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецФункции

