	стрПараметры = Новый Структура;
	Для Каждого СтрТз Из тзПараметры Цикл
		стрПараметры.Вставить(СтрЗаменить(СтрТз.ИмяПараметра," ",""),СтрТз.ЗначениеПараметра);	
	КонецЦикла;
