&НаКлиенте
Процедура РолиТРПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущийРесурс = Элементы.РолиТР.ТекущиеДанные.РольТР;
	
	НовыйМассив = Новый Массив;
	Если ЗначениеЗаполнено(ТекущийРесурс) Тогда
		НовыйМассив.Добавить(Новый ПараметрВыбора("РесурсПодразделения", ТекущийРесурс));
	КонецЕсли;  
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элемент.ПараметрыВыбора = НовыеПараметры;

КонецПроцедуры

&НаКлиенте
Процедура РолиТРРольТРНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущееПодразделение = Элементы.РолиТР.ТекущиеДанные.Подразделение;
	СтруктураПараметров = Новый Структура();
    СтруктураПараметров.Вставить("РежимВыбора", Истина);
	
	Если ЗначениеЗаполнено(ТекущееПодразделение) Тогда
		
		СтруктураПараметров.Вставить("ПодразделениеОтбора", ТекущееПодразделение);		
		ОткрытьФорму("Справочник.упоРоли.ФормаВыбора", СтруктураПараметров, Элемент);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРРольТРАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	ТекущееДанные = Элементы.РолиТР.ТекущиеДанные;
	Подразделение = ТекущееДанные.Подразделение;
	
	Если ЗначениеЗаполнено(Подразделение) Тогда
		СтруктураОтбора = Новый Структура("ПодразделенияРолей", Подразделение);
		ПараметрыПолученияДанных.Вставить("Отбор", СтруктураОтбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРПодразделениеАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)

  	ТекущееДанные = Элементы.РолиТР.ТекущиеДанные;
	РольТР = ТекущееДанные.РольТР;
	
	НовыйМассив = Новый Массив;
	Если ЗначениеЗаполнено(РольТР) Тогда
		НовыйМассив.Добавить(Новый ПараметрВыбора("РесурсПодразделения", РольТР));
	КонецЕсли;
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элемент.ПараметрыВыбора = НовыеПараметры;

КонецПроцедуры

#КонецОбласти

