// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#Область УниверсальныеОбработчики

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
		П5 = Неопределено, П6 = Неопределено)
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);
	
КонецФункции

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
		П4 = Неопределено, П5 = Неопределено, П6 = Неопределено)
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
		П4 = Неопределено, П5 = Неопределено, П6 = Неопределено)
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3, П4,
		П5, П5, П6);
	
КонецФункции

#КонецОбласти

#Область РаспределениеЗарплатыПоПроектам

&НаСервере
Процедура РазделУчетаПриИзмененииНаСервере()
	
	УстановитьВидимостьЭлементовРаспределенияЗП();
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СлужебныйПриИзменении()
	
	Если Объект.РазделУчета = ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача")
		И Не Объект.Служебный Тогда
		Объект.СпособОтраженияЗарплаты = Неопределено;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовРаспределенияЗП();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовРаспределенияЗП()
	
	Если Объект.РазделУчета = Перечисления.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача Тогда
		ВидимостьЭлемента = Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"Служебный", "Видимость", ВидимостьЭлемента);
		
		ВидимостьЭлемента = Объект.Служебный;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СпособОтраженияЗарплаты", "Видимость", ВидимостьЭлемента);
	Иначе
		ВидимостьЭлемента = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"Служебный", "Видимость", ВидимостьЭлемента);
		
		ВидимостьЭлемента = ЗначениеЗаполнено(Объект.РазделУчета);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СпособОтраженияЗарплаты", "Видимость", ВидимостьЭлемента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СвойстваРеквизитаСлужебный()
	
	ЭтоПроектнаяЗадача = Объект.РазделУчета =
		ПредопределенноеЗначение("Перечисление.упоРазделУчетаРабочегоВремени.ПроектнаяЗадача");
	
	Если Не ЭтоПроектнаяЗадача Тогда
		Объект.Служебный = Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Служебный", "Видимость", ЭтоПроектнаяЗадача);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти