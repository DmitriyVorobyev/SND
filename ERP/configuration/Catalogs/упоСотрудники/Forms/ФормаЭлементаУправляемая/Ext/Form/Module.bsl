&НаКлиенте
Процедура ДобавитьИзображениеНаКлиенте()
	
	ПараметрыОписания = Новый Структура(
		"АдресВременногоХранилищаФайла", 
		"");
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ДобавитьИзображениеНаКлиентеЗавершение", 
		ЭтотОбъект,
		ПараметрыОписания);
		
	ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзображениеНаКлиентеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЕстьАватар Тогда
		Если Не ЕстьПравоРедактирования Тогда
			ТекстИсключения = НСтр("ru = 'Нарушение прав доступа!'");
			ВызватьИсключение ТекстИсключения;
		КонецЕсли;
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ВыборКартинкиПродолжение",
			ЭтотОбъект,
			ДополнительныеПараметры);

		ОткрытьДиалогВыбораКартинки(
			ОписаниеОповещения, , Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКартинкиПродолжение(Результат, Параметры) Экспорт 

	Если Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаПревьюАватара = Параметры.АдресВременногоХранилищаФайла;
	
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогВыбораКартинки(ОбработчикРезультата, ПоказатьПредупреждение = Истина, БольшойРазмер = Ложь)
	
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"ОткрытьДиалогВыбораКартинкиЗавершение",
		ЭтотОбъект);
	
	Если ПоказатьПредупреждение Тогда 
		ШаблонТекстаПредупреждения = НСтр("ru='Выберите файл фотографии. 
				|Для быстрой работы программы размер фотографии должен быть приблизительно %1 на %2 пикселей,
				|размером не более 200 Кб.'");
		
		Если БольшойРазмер Тогда 
			ТекстПредупреждения = СтрШаблон(ШаблонТекстаПредупреждения, "110", "130");
		Иначе 
			ТекстПредупреждения = СтрШаблон(ШаблонТекстаПредупреждения, "60", "80");
		КонецЕсли;
		ПоказатьПредупреждение(ОписаниеОповещения, ТекстПредупреждения);
	Иначе 
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогВыбораКартинкиЗавершение(Результат) Экспорт
	
	Фильтр = НСтр("ru = 'Все картинки (*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf)|*.bmp;*.gif;*.png;*.jpeg;*.dib;*.rle;*.tif;*.jpg;*.ico;*.wmf;*.emf'")
		+ НСтр("ru = '|Все файлы(*.*)|*.*'")
		+ НСтр("ru = '|Формат bmp(*.bmp*;*.dib;*.rle)|*.bmp;*.dib;*.rle'")
		+ НСтр("ru = '|Формат GIF(*.gif*)|*.gif'")
		+ НСтр("ru = '|Формат JPEG(*.jpeg;*.jpg)|*.jpeg;*.jpg'")
		+ НСтр("ru = '|Формат PNG(*.png*)|*.png'")
		+ НСтр("ru = '|Формат TIFF(*.tif)|*.tif'")
		+ НСтр("ru = '|Формат icon(*.ico)|*.ico'")
		+ НСтр("ru = '|Формат метафайл(*.wmf;*.emf)|*.wmf;*.emf'");
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Выбор файла изображения'");
	ДиалогВыбораФайла.Фильтр = Фильтр;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборКартинки", ЭтотОбъект);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = ЭтотОбъект.УникальныйИдентификатор;
	ПараметрыЗагрузки.Интерактивно = Истина;
	ПараметрыЗагрузки.Диалог = ДиалогВыбораФайла;
	ФайловаяСистемаКлиент.ЗагрузитьФайл(ОписаниеОповещения, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКартинки(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаПревьюАватара = ПомещенныйФайл.Хранение;
	
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры

#Область УниверсальныеОбработчики

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено,
	П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийКлиент.ФормаУниверсальныйОбработчикСобытийФормыНаКлиенте(ЭтаФорма, П1, П2, П3, П4, П5, П5, П6);	
	
КонецФункции

&НаКлиенте
Функция Подключаемый_УниверсальныйОбработчикСобытийКлиентСВызовомСервера(П1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);	
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3, П4,
		П5, П5, П6);
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура УстановитьПараметрыДинамическихСписков(Сотрудник, ЭтоНовый)
	
	ИменаСписков = Новый Массив;
	ИменаСписков.Добавить("ТаблицаДолжности");
	ИменаСписков.Добавить("ТаблицаРесурсы");
	ИменаСписков.Добавить("ТаблицаПроекты");
	ИменаСписков.Добавить("ТаблицаПЗ");
	ИменаСписков.Добавить("ТаблицаПодразделения");
	ИменаСписков.Добавить("ТаблицаДиспетчеры");
	
	Для Каждого ИмяСписка Из ИменаСписков Цикл
		
		ПараметрыСписка = ЭтотОбъект[ИмяСписка].Параметры;
		
		ПараметрыСписка.УстановитьЗначениеПараметра("Сотрудник", 	Сотрудник);
		ПараметрыСписка.УстановитьЗначениеПараметра("ЭтоНовый", 	ЭтоНовый);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
