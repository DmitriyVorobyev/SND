// Процедура синхронизирует реквизит формы "ТаблицаСостояний" с табличной частью "Состояния".
//
&НаСервере
Процедура ВосстановитьСостояния()
	
	Для каждого вСтрока Из Объект.Состояния Цикл
		
		НоваяСтрока = ТаблицаСостояний.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, вСтрока);
		НоваяСтрока.ВидСравнения = ПолучитьВидСравненияПоНомеру(вСтрока.ВидСравнения);
		НоваяСтрока.Картинка = вСтрока.Оформление;
		
	КонецЦикла;
		
КонецПроцедуры

// Функция получает строку по номеру с видом сравнения.
//
// Параметры:
//  НомерВидаСравнения - Число, содержит число для которого нужно вернуть строку.
//
// Возвращаемое значение:
//  Строка
//
&НаСервере
Функция ПолучитьВидСравненияПоНомеру(НомерВидаСравнения)
	
	ВозврВидСравнения = "";
	
	Если НомерВидаСравнения = 1 Тогда
		ВозврВидСравнения = "Равно";
	ИначеЕсли НомерВидаСравнения = 2 Тогда
		ВозврВидСравнения = "Не равно";
	ИначеЕсли НомерВидаСравнения = 3 Тогда
		ВозврВидСравнения = "Меньше"; 
	ИначеЕсли НомерВидаСравнения = 4 Тогда 
		ВозврВидСравнения = "Меньше или равно";
	ИначеЕсли НомерВидаСравнения = 5 Тогда 
		ВозврВидСравнения = "Больше"; 
	ИначеЕсли НомерВидаСравнения = 6 Тогда 
		ВозврВидСравнения = "Больше или равно"; 
	ИначеЕсли НомерВидаСравнения = 7 Тогда 
		ВозврВидСравнения = "Интервал (>, <)"; 
	ИначеЕсли НомерВидаСравнения = 8 Тогда
		ВозврВидСравнения = "Интервал (>=, <=)";
	ИначеЕсли НомерВидаСравнения = 9 Тогда 
		ВозврВидСравнения = "Интервал (>=, <)"; 
	ИначеЕсли НомерВидаСравнения = 10 Тогда 
		ВозврВидСравнения = "Интервал (>, <=)"; 
	КонецЕсли;
	
	Возврат ВозврВидСравнения;
	
КонецФункции

// Функция проверяет таблицу состояний на однозначность условий.
//
// Возвращаемое значение:
//   Булево - Истина - условия все однозначны Ложь: не однозначны.
//
&НаСервере
Функция СостоянияОднозначны()
	
	Для каждого строкаСостояния Из ТаблицаСостояний Цикл
		
		Если УсловиеКонфликтует(строкаСостояния) Тогда
			
			Сообщение = НСтр("ru = 'Обнаружены конфликты между условиями, наложенными на значения показателя.'");
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
						
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
 
// Функция проверяет передаваемую строку на конфликтность с другими условиями табличного поля "Состояния".
//
&НаСервере
Функция УсловиеКонфликтует(текСтрока)
	
	// Проверим текущую строку. Условия не должны совпадать.
	Отказ = Ложь;
	Если текСтрока = Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;
	
	интексТекСтроки = ТаблицаСостояний.Индекс(текСтрока);
	текВидСравнения = текСтрока.ВидСравнения;
	Для каждого вСтрока Из ТаблицаСостояний Цикл
		
		Если интексТекСтроки = ТаблицаСостояний.Индекс(вСтрока) Тогда
			Продолжить;
		КонецЕсли;
		
		Если вСтрока.ВидСравнения = "Больше" Тогда
			
			Если текВидСравнения = "Больше"
			 ИЛИ текВидСравнения = "Больше или равно"
			 ИЛИ текВидСравнения = "Не равно" Тогда
				 Отказ = Истина;
				 Прервать;
			ИначеЕсли текВидСравнения = "Интервал (>, <)"
				  ИЛИ текВидСравнения = "Интервал (>=, <)"
				  ИЛИ текВидСравнения = "Интервал (>=, <=)"
				  ИЛИ текВидСравнения = "Интервал (>, <=)" Тогда
				Если текСтрока.ЗначениеПО > вСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;		
			ИначеЕсли текВидСравнения = "Меньше"
				  ИЛИ текВидСравнения = "Меньше или равно"
				  ИЛИ текВидСравнения = "Равно" Тогда
				Если текСтрока.Значение > вСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;		
			КонецЕсли;
			
		ИначеЕсли вСтрока.ВидСравнения = "Больше или равно" Тогда
			
			Если текВидСравнения = "Больше"
			 ИЛИ текВидСравнения = "Больше или равно"
			 ИЛИ текВидСравнения = "Не равно" Тогда
				 Отказ = Истина;
				 Прервать;
			ИначеЕсли текВидСравнения = "Интервал (>=, <=)"
				  ИЛИ текВидСравнения = "Интервал (>, <=)" Тогда
				Если текСтрока.ЗначениеПО >= вСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;		
			ИначеЕсли текВидСравнения = "Интервал (>, <)"
				  ИЛИ текВидСравнения = "Интервал (>=, <)" Тогда
				Если текСтрока.ЗначениеПО > вСтрока.Значение Тогда
				 	Отказ = Истина;
				 	Прервать;
				КонецЕсли;		
			ИначеЕсли текВидСравнения = "Меньше или равно"
				  ИЛИ текВидСравнения = "Равно" Тогда
				Если текСтрока.Значение >= вСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;		
			ИначеЕсли текВидСравнения = "Меньше" Тогда
				Если текСтрока.Значение > вСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;		
			КонецЕсли;
			
		ИначеЕсли вСтрока.ВидСравнения = "Интервал (>, <)" Тогда
			
			Если текВидСравнения = "Меньше"
			 ИЛИ текВидСравнения = "Меньше или равно" Тогда
				Если вСтрока.ЗначениеС < текСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Больше"
				  ИЛИ текВидСравнения = "Больше или равно" Тогда
				Если вСтрока.ЗначениеПО > текСтрока.Значение Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Интервал (>, <)"
				  ИЛИ текВидСравнения = "Интервал (>=, <)"
				  ИЛИ текВидСравнения = "Интервал (>, <=)" Тогда
				Если (((текСтрока.ЗначениеС > вСтрока.ЗначениеС И текСтрока.ЗначениеС < вСтрока.ЗначениеПО)
					ИЛИ(текСтрока.ЗначениеПО > вСтрока.ЗначениеС И текСтрока.ЗначениеПО < вСтрока.ЗначениеПО))
					ИЛИ (текСтрока.ЗначениеС <= вСтрока.ЗначениеС И текСтрока.ЗначениеПО >= вСтрока.ЗначениеПО))
					И НЕ (текСтрока.ЗначениеС = текСтрока.ЗначениеПО ИЛИ вСтрока.ЗначениеС = вСтрока.ЗначениеПО) Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Интервал (>=, <=)" Тогда
				Если (((текСтрока.ЗначениеС > вСтрока.ЗначениеС И текСтрока.ЗначениеС < вСтрока.ЗначениеПО)
					ИЛИ (текСтрока.ЗначениеПО > вСтрока.ЗначениеС И текСтрока.ЗначениеПО < вСтрока.ЗначениеПО))
					ИЛИ (текСтрока.ЗначениеС <= вСтрока.ЗначениеС И текСтрока.ЗначениеПО >= вСтрока.ЗначениеПО))
					И НЕ (вСтрока.ЗначениеС = вСтрока.ЗначениеПО) Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Не равно" Тогда
				Отказ = Истина;
				Прервать;
			ИначеЕсли текВидСравнения = "Равно" Тогда
				Если текСтрока.Значение > вСтрока.ЗначениеС И текСтрока.Значение < вСтрока.ЗначениеПО Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;		
			КонецЕсли;
			
		ИначеЕсли вСтрока.ВидСравнения = "Интервал (>=, <=)" Тогда
			
			Если текВидСравнения = "Меньше" Тогда
				Если текСтрока.Значение > вСтрока.ЗначениеС Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Меньше или равно" Тогда
				Если текСтрока.Значение >= вСтрока.ЗначениеС Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Больше" Тогда
				Если текСтрока.Значение < вСтрока.ЗначениеПО Тогда
				 	Отказ = Истина;
					Прервать;
				КонецЕсли;
			ИначеЕсли текВидСравнения = "Больше или равно" Тогда
				Если текСтрока.Значение <= вСтрока.ЗначениеПО Тогда
				 	Отказ = Истина;
					Прервать;
