Процедура РасчетныеИндикаторыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение, "Индикатор",
		Объект.РасчетныеИндикаторы, ЭтаФорма, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура РасчетныеИндикаторыПередНачаломИзменения(Элемент, Отказ)
	
	ТекДанные = Элементы.РасчетныеИндикаторы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ПредПредставлениеПоказателя = "";
	Иначе
		ПредПредставлениеПоказателя = ТекДанные.Представление; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставлениеВФормуле(ТекДанные)
	
	НовоеПредставление = ТекДанные.Представление;
	Если Не ПустаяСтрока(НовоеПредставление) И Не ПустаяСтрока(ПредПредставлениеПоказателя)  Тогда
		Объект.строкаФормулы = СтрЗаменить(Объект.строкаФормулы,ПредПредставлениеПоказателя,НовоеПредставление);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасчетныеИндикаторыПредставлениеПриИзменении(Элемент)
	
	ТекДанные = Элементы.РасчетныеИндикаторы.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПредставлениеВФормуле(ТекДанные);
	
КонецПроцедуры

