&НаСервере
Процедура ИнициализироватьФорму()
		
	ВосстановитьСостояния();
	
	ЗаполнитьДоступнуюПринадлежностьПоказателей();
	
	ВидимостьЭУСтраницаИсточник(Объект.ВидЗаполнения, ЭтаФорма);
	
	Если Элементы.СтраницаИсточник.Видимость Тогда
		ВидимостьЭУИсточникДанныхЗначенияПоказателя(Объект.ТипЗаполнения, Объект.ПринадлежностьПоказателя, ЭтаФорма);
	КонецЕсли;
	
	ЕстьЗначениеКопирования = Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования);
	
	// Восстановим параметры
	Обж = РеквизитФормыВЗначение("Объект");
		
	Если ЕстьЗначениеКопирования Тогда
		ТаблицаИзРеквизита = Параметры.ЗначениеКопирования.ПараметрыЗапроса.Получить();
	Иначе
		ТаблицаИзРеквизита = Обж.ПараметрыЗапроса.Получить();
	КонецЕсли;
	Если НЕ ТаблицаИзРеквизита = Неопределено Тогда
		ТаблицаПараметров.Загрузить(ТаблицаИзРеквизита);
	КонецЕсли;
	
	Если ЕстьЗначениеКопирования Тогда
		ТаблицаИзРеквизита = Параметры.ЗначениеКопирования.ПараметрыЗапросаПЗ.Получить();
	Иначе
		ТаблицаИзРеквизита = Обж.ПараметрыЗапросаПЗ.Получить();
	КонецЕсли;
	Если НЕ ТаблицаИзРеквизита = Неопределено Тогда
		ТаблицаПараметровПЗ.Загрузить(ТаблицаИзРеквизита);
	КонецЕсли;
	
	Если ЕстьЗначениеКопирования 
		И Объект.ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.АвтоматическиВДокументеРасчетЭффективности Тогда
		Объект.ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.ПустаяСсылка();
	КонецЕсли;
	
	Если Объект.ПринадлежностьПоказателя.Пустая() Тогда
	    // Всем старым показателям устанавливаем "ТолькоДляПроекта", т.к. раньше
		// был "только для проекта".
		Объект.ПринадлежностьПоказателя = ?(Объект.Ссылка.Пустая(),
									Перечисления.упоПринадлежностьПоказателя.Общий,
									Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроекта);
	КонецЕсли;

	ПредыдущийТипЗначения = Объект.ТипИндикатора;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПересчитатьТипСсылки();
	КонецЕсли;
	
	ПолучитьСписокТиповИУстановитьЗначенияПоУмолчаниюДляТипСсылки();	
	
	УстановитьВидимостьНастроекДляМонитораПроекта();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьТекстЗапросаВФайлОбщий(ЭтоПЗ)
	
	Если ЭтоПЗ Тогда
		СтрокаТекста = Объект.ТекстЗапросаПЗ;
	Иначе
		СтрокаТекста = Объект.ТекстЗапроса;
	КонецЕсли;

	Если ПустаяСтрока(СтрокаТекста) Тогда
		Возврат;
	КонецЕсли;
	
	АдресДанных = ПоместитьВоВременноеХранилище(СтрокаТекста);
	
	ОписаниеОповещенияПослеРаботыСФайлом = Новый ОписаниеОповещения("СохранитьНастройкуВФайлЗавершение", ЭтотОбъект);
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.МножественныйВыбор = Ложь;
	ИмяФайлаШаблон = "%1.txt";
	ИмяФайла = СтрШаблон(ИмяФайлаШаблон, СтрШаблон(НСтр("ru = 'Текст запроса показателя %1'"), Объект.Наименование));
	ФайловаяСистемаКлиент.СохранитьФайл(ОписаниеОповещенияПослеРаботыСФайлом, АдресДанных, ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуВФайлЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПолученныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файл сохранен в выбранный каталог.'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьТекстЗапросаИзФайлаОбщий(ЭтоПЗ)
	
	Режим = РежимДиалогаВыбораФайла.Открытие;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	Фильтр = "Текст (*.txt)|*.txt";
	ДиалогОткрытияФайла.Фильтр = Фильтр; 
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.Заголовок = НСтр("ru = 'Выберите файл'");
	
	ДополнительныеПараметры = Новый Структура("ЭтоПЗ", ЭтоПЗ);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьТекстЗапросаИзФайлаЗавершение",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = ЭтотОбъект.УникальныйИдентификатор;
	ПараметрыЗагрузки.Интерактивно = Истина;
	ПараметрыЗагрузки.Диалог = ДиалогОткрытияФайла;
	ФайловаяСистемаКлиент.ЗагрузитьФайл(ОписаниеОповещения, ПараметрыЗагрузки);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьТекстЗапросаИзФайлаЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоПЗ = ДополнительныеПараметры.ЭтоПЗ;
	
	ИзвлеченныйТекст = ИзвлеченныйТекст(ПомещенныйФайл.Хранение);
	
	Если ЭтоПЗ Тогда
		Объект.ТекстЗапросаПЗ = ИзвлеченныйТекст;
	Иначе
		Объект.ТекстЗапроса = ИзвлеченныйТекст;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИзвлеченныйТекст(АдресФайла)
	
	РезультатИзвлечения = РаботаСФайламиСлужебный.ИзвлечьТекст(АдресФайла);
	Текст = РезультатИзвлечения.ТекстХранилище.Получить();
	Возврат Текст;
	
КонецФункции

#КонецОбласти
