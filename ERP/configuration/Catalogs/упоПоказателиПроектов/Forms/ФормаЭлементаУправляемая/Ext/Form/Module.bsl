#Если Не МобильныйКлиент Тогда
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ЭтоПЗ", ЭтоПЗ);
	
	Если ЭтоПЗ Тогда
		ТекстЗапроса = Объект.ТекстЗапросаПЗ;
	Иначе
		ТекстЗапроса = Объект.ТекстЗапроса;	
	КонецЕсли;
	
	КонструкторЗапроса = Новый КонструкторЗапроса;
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриЗакрытииКонструктораЗапросов", ЭтаФорма, ДопПараметры);
	Если Не ПустаяСтрока(ТекстЗапроса) Тогда
		КонструкторЗапроса.Текст = ТекстЗапроса;
	КонецЕсли;
	КонструкторЗапроса.Показать(ОписаниеОповещения);
#КонецЕсли

КонецПроцедуры

