&НаКлиентеНаСервереБезКонтекста
Процедура ЗаменитьЗарезервированныеСимволы(Строка)

	// Нужно на всякий случай удалить символы ".","/",":"
	СоответствиеСимволов = Новый Соответствие();
	СоответствиеСимволов.Вставить(".","");
	СоответствиеСимволов.Вставить("/","");
	СоответствиеСимволов.Вставить(":","");

	Для каждого сСимвол Из СоответствиеСимволов Цикл
		
		Пока СтрНайти(Строка, сСимвол.Ключ) > 0 Цикл
			Строка = СтрЗаменить(Строка, сСимвол.Ключ, сСимвол.Значение);
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

