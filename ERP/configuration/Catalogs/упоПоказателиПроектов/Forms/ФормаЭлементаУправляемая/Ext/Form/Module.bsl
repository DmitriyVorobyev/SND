&НаКлиенте
Процедура ПанельГлавнаяПриСменеСтраницы(Элемент, ТекущаяСтраница)
		
	Если Элементы.ПанельГлавная.ТекущаяСтраница = Элементы.СтраницаСостоянияИндикатора Тогда
		
		ТолькоПросмотрЭУ = Объект.ТипИндикатора.Пустая();
		
		Элементы.СтраницаСостоянияИндикатора.ТолькоПросмотр = ТолькоПросмотрЭУ;
		Для каждого ЭлементПанели Из Элементы.ТаблицаСостояний.КоманднаяПанель.ПодчиненныеЭлементы Цикл
		    ЭлементПанели.Доступность = НЕ ТолькоПросмотрЭУ;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипИндикатораПриИзменении(Элемент)
	
	УстановитьВидимостьНастроекДляМонитораПроекта();
	
	Если ТаблицаСостояний.Количество() > 0
	   И (ПредыдущийТипЗначения <> Объект.ТипИндикатора) Тогда
	   
	   ОписаниеОповещения = Новый ОписаниеОповещения("ТипИндикатораПриИзмененииЗавершение", ЭтотОбъект);
	   
	    Если Объект.ТипИндикатора.Пустая() Тогда
			ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Таблица состояний будет очищена. Продолжить?'"),
				РежимДиалогаВопрос.ДаНет, 120, КодВозвратаДиалога.Нет, "Внимание");
		Иначе
			ПоказатьВопрос(ОписаниеОповещения, НСтр("ru = 'Изменился тип значений таблицы состояний. Очистить состояния?'"),
				РежимДиалогаВопрос.ДаНет, 120, КодВозвратаДиалога.Нет, "Внимание");
		КонецЕсли;
	Иначе
		ТипИндикатораПриИзмененииЗавершение(Неопределено, Неопределено);		
	КонецЕсли;
			
КонецПроцедуры

// Обработчик события "Тип индикатора при изменении" - завершение.
//
// Параметры:
//  Ответ					 - 	 - 
//  ДополнительныеПараметры	 - 		 - 
//
&НаКлиенте
Процедура ТипИндикатораПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	ТипИзменился = Истина;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ТаблицаСостояний.Очистить();
	ИначеЕсли ПредыдущийТипЗначения <> Объект.ТипИндикатора Тогда
	Иначе
		ТипИзменился = Ложь;
	КонецЕсли;
	
	Если ТипИзменился Тогда
		ПредыдущийТипЗначения = Объект.ТипИндикатора;
		ОбработатьТипСсылкиИСчитатьСуммуПоГруппировкам(ЭтаФорма);
		СчитатьСуммуПоГруппировкамПриИзменении(Неопределено);
	Иначе
		Объект.ТипИндикатора = ПредыдущийТипЗначения;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФорматнаяСтрокаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	ФорматнаяСтрока = Новый КонструкторФорматнойСтроки;
	ФорматнаяСтрока.Текст = Объект.ФорматнаяСтрока;
	ОписаниеОповещения = Новый ОписаниеОповещения("ФорматнаяСтрокаНачалоВыбораЗавершение", ЭтотОбъект);
	
	ФорматнаяСтрока.Показать(ОписаниеОповещения);
	
КонецПроцедуры

// Обработчик события "Форматная строка начало выбора" - завершение.
//
// Параметры:
//  Текст					 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ФорматнаяСтрокаНачалоВыбораЗавершение(Текст, ДополнительныеПараметры) Экспорт
	
	Если Текст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ФорматнаяСтрока = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЗаполненияПриИзменении(Элемент)
	
	Если ИспользуетсяВРасчетныхИндикаторах() Тогда
		Объект.ТипЗаполнения = 1;
	КонецЕсли;
	
	ВидимостьЭУИсточникДанныхЗначенияПоказателя(Объект.ТипЗаполнения, Объект.ПринадлежностьПоказателя, ЭтаФорма);
	
	УстановитьВыражениеГруппировки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПринадлежностьПоказателяПриИзменении(Элемент)
	
	Если Объект.ПринадлежностьПоказателя = 
				ПредопределенноеЗначение("Перечисление.упоПринадлежностьПоказателя.Произвольный") Тогда
		
		 Объект.ВидЗаполнения = ПредопределенноеЗначение("Перечисление.упоВидЗаполненияИндикатора.Автоматически");
		 Объект.ТипИндикатора = ПредопределенноеЗначение("Перечисление.упоТипИндикатора.Число");
		 Объект.КартинкаПоУмолчанию = 0;
		 Объект.ПоказательИнвестирования = Ложь;
		 Объект.СчитатьСуммуПоГруппировкам = Ложь;
		 
		 СчитатьСуммуПоГруппировкамПриИзменении(Неопределено);
		 ВидимостьЭУСтраницаИсточник(Объект.ВидЗаполнения, ЭтаФорма);

	КонецЕсли;
	
	ВидимостьЭУИсточникДанныхЗначенияПоказателя(Объект.ТипЗаполнения, Объект.ПринадлежностьПоказателя, ЭтаФорма);
			
КонецПроцедуры

&НаКлиенте
Процедура СчитатьСуммуПоГруппировкамПриИзменении(Элемент)
	
	ВидимостьВыраженияГруппировки();	
	Если Объект.СчитатьСуммуПоГруппировкам 
		И СтрДлина(Объект.ВыражениеГруппировки) = 0 Тогда
		
		Объект.ВыражениеГруппировки = "Сумма";
		
	КонецЕсли;
	
	Если Не Объект.СчитатьСуммуПоГруппировкам Тогда
		Объект.ВыражениеГруппировки = "";	
	КонецЕсли;
	
	УстановитьВыражениеГруппировки(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСсылкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	
	ТипСсылки = ВыбранноеЗначение;
	
	// Присваиваем Объект.ТипСсылки пустую ссылку выбранного типа.
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(ВыбранноеЗначение);	
	ОписаниеТипаВыбранногоТипа = Новый ОписаниеТипов(МассивТипов);	
	Объект.ТипСсылки = ОписаниеТипаВыбранногоТипа.ПривестиЗначение(Неопределено);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
