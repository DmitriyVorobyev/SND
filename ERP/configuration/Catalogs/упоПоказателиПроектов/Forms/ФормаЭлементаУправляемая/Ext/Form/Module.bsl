&НаКлиенте
Процедура УстановитьОграничениеТиповДляЭлементаТЧ(Элемент, ИмяКолонкиТЧ, ИмяТЧ)
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда 
		
		ТипОграничение = Неопределено;
		Если Объект.ТипИндикатора = ПредопределенноеЗначение("Перечисление.упоТипИндикатора.Число") Тогда
			ТипОграничение = "Число";
		ИначеЕсли Объект.ТипИндикатора = ПредопределенноеЗначение("Перечисление.упоТипИндикатора.Дата") Тогда
			ТипОграничение = "Дата";
		ИначеЕсли Объект.ТипИндикатора = ПредопределенноеЗначение("Перечисление.упоТипИндикатора.Булево") Тогда
			ТипОграничение = "Булево";
		ИначеЕсли Объект.ТипИндикатора = ПредопределенноеЗначение("Перечисление.упоТипИндикатора.Строка") Тогда
			ТипОграничение = "Строка";
		ИначеЕсли Объект.ТипИндикатора = ПредопределенноеЗначение("Перечисление.упоТипИндикатора.Ссылка") Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ТипСсылки);
			ТипОграничение = Новый ОписаниеТипов(МассивТипов);			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипОграничение) Тогда
			Элемент.ОграничениеТипа = Новый ОписаниеТипов(ТипОграничение);
			Значение = ТекДанные[ИмяКолонкиТЧ];
			ТекДанные[ИмяКолонкиТЧ] = Элемент.ОграничениеТипа.ПривестиЗначение(Значение);
			Элемент.ВыбиратьТип = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

