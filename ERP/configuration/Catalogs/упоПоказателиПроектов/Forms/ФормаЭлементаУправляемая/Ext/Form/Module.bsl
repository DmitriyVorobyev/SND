&НаКлиенте
Процедура ПодобратьРасчетныеИндикаторы(Команда)
	
	ПараметрыПодбора = ПодготовитьДопПараметры(Команда.Имя);
	упоПодборВТабличнуюЧастьКлиент.ПодборВТабличнуюЧасть(ПараметрыПодбора.ИмяОбъектаВМетаданных,
		ПараметрыПодбора.ЭлементВладелец, ПараметрыПодбора.ДопПараметры, ЭтаФорма.УникальныйИдентификатор);		
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыИзЗапроса(Команда)
	
	ЗапросПЗ = Команда.Имя = "ЗаполнитьПараметрыИзЗапросаПЗ";
	
	ТабПараметры = ?(ЗапросПЗ, ТаблицаПараметровПЗ, ТаблицаПараметров);
	
	ДополнительныеПараметры = Новый Структура("ТабПараметры",ТабПараметры);
	ДополнительныеПараметры.Вставить("ЗапросПЗ",ЗапросПЗ);
	
	Если ТабПараметры.Количество() <> 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПараметрыИзЗапросаЗавершение",ЭтотОбъект,ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения,
						НСтр("ru = 'Таблица параметров будет очищена. Продолжить?'"), 
						РежимДиалогаВопрос.ДаНет, 
						120, 
						КодВозвратаДиалога.Нет);
	КонецЕсли;
	
	ЗаполнитьПараметрыИзЗапросаЗавершение(Неопределено,ДополнительныеПараметры);
	
КонецПроцедуры

