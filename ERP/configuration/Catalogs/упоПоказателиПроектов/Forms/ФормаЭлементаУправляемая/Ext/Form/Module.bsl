	ОписаниеОповещенияЗавершениеВыбора = Новый ОписаниеОповещения("ТипСсылкиНачалоВыбораЗавершение", ЭтотОбъект, Элемент);
	
	СписокТипов.ПоказатьВыборЭлемента(ОписаниеОповещенияЗавершениеВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСсылкиНачалоВыбораЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ТипСсылкиОбработкаВыбора(ДополнительныеПараметры, ВыбранноеЗначение.Значение, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСсылкиОчистка(Элемент, СтандартнаяОбработка)
	ТипСсылки = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ЦветовоеВыделениеПоложительныхИОтрицательныхЗначенийПриИзменении(Элемент)  
	
	УстановитьВидимостьНастроекДляМонитораПроекта();   
	
	Если Объект.ИнвертироватьЦветовоеВыделениеПоложительныхИОтрицательныхЗначений И Не Объект.ЦветовоеВыделениеПоложительныхИОтрицательныхЗначений Тогда
		Объект.ИнвертироватьЦветовоеВыделениеПоложительныхИОтрицательныхЗначений = Ложь;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаПараметров

&НаКлиенте
Процедура ТаблицаПараметровПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.ЭтоВыражение = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровЭтоВыражениеПриИзменении(Элемент)
	
	ЗапросПЗ = Элемент.Имя = "ТаблицаПараметровПЗЭтоВыражение";
	
	ТекДанные = ?(ЗапросПЗ, Элементы.ТаблицаПараметровПЗ.ТекущиеДанные, Элементы.ТаблицаПараметров.ТекущиеДанные);
	
	Если ТекДанные.ЭтоВыражение Тогда
		
		Если НЕ ТипЗнч(ТекДанные.ЗначениеПараметра) = Тип("Строка") Тогда
			ТекДанные.ЗначениеПараметра = "";
		КонецЕсли;
		
	Иначе // Значение
	
		Если ТипЗнч(ТекДанные.ЗначениеПараметра) = Тип("СписокЗначений") Тогда
			Если ТекДанные.ЗначениеПараметра.Количество() <> 0 Тогда
				Элементы.ТаблицаПараметров.ТекущиеДанные.ЗначениеПараметра = ТекДанные.ЗначениеПараметра[0].Значение;
			Иначе
				Элементы.ТаблицаПараметров.ТекущиеДанные.ЗначениеПараметра = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
		
	УправлениеКолонкамиПараметры(ЗапросПЗ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаСостояний

&НаКлиенте
Процедура ТаблицаСостоянийЗначениеСПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаСостояний.ТекущиеДанные;
	Если ТипЗнч(ТекДанные.ЗначениеС) = ТипЗнч(ТекДанные.ЗначениеПо) Тогда
		
		Если ТекДанные.ЗначениеС > ТекДанные.ЗначениеПо Тогда
			ТекДанные.ЗначениеПо = ТекДанные.ЗначениеС;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

