&НаСервере
Функция ИспользуетсяВРасчетныхИндикаторах()
	
	Если Объект.ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.Вручную Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.ТипЗаполнения = 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТЧРасчетныеИндикаторы.Ссылка КАК Индикатор
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов.РасчетныеИндикаторы КАК ТЧРасчетныеИндикаторы
	               |ГДЕ
	               |	ТЧРасчетныеИндикаторы.Индикатор = &Индикатор";
	
	Запрос.УстановитьПараметр("Индикатор", Объект.Ссылка);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() <> 0 Тогда
		
		Сообщение = НСтр("ru = 'Индикатор используется для расчета других индикаторов. Отмена установки значения.
                          |Используется в след. индикаторах:'");
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначения.СообщитьПользователю("- " + Выборка.Индикатор);
		КонецЦикла;
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

// Процедура устанавливает активным определенную панель источника для заполнения (Запрос, Формула)
// в соответствии со значением реквизата "ТипЗаполнения".
//
&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьЭУИсточникДанныхЗначенияПоказателя(ТипЗаполнения, ПринадлежностьПоказателя, Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.СтраницаСостоянияИндикатора.Видимость = Истина;
	Элементы.ВидЗаполнения.ТолькоПросмотр = Ложь;
	Элементы.ТипИндикатора.ТолькоПросмотр = Ложь;
    Элементы.ПоказательИнвестирования.Видимость = Истина;
	Элементы.ГруппаНастройкиИндикаторКартинка.Видимость = Истина;
	Элементы.ГруппаФорматнаяСтрока.Видимость = Истина;
    Элементы.ГруппаСчитатьНастройкиГруппировок.Видимость = Истина;
	
	Если ТипЗаполнения = 0 Тогда // выполнение запроса
		Элементы.СтраницаЗапрос.Заголовок = нСтр("ru='Текст запроса для проекта'", "ru");
		Элементы.ПараметрыЗапроса.Заголовок = нСтр("ru='Параметры запроса для проекта'", "ru"); 
		Элементы.СтраницаФормулаРасчета.Видимость = Ложь;
		Элементы.СтраницаЗапрос.Видимость = Истина;
		Элементы.ПараметрыЗапроса.Видимость = Истина;
		Элементы.СтраницаЗапросПЗ.Видимость = Истина;
		Элементы.ПараметрыЗапросаПЗ.Видимость = Истина;
	ИначеЕсли ТипЗаполнения = 1 Тогда // по формуле		
		Элементы.СтраницаЗапрос.Видимость = Ложь;
		Элементы.ПараметрыЗапроса.Видимость = Ложь;
		Элементы.СтраницаЗапросПЗ.Видимость = Ложь;
		Элементы.ПараметрыЗапросаПЗ.Видимость = Ложь;
		Элементы.СтраницаФормулаРасчета.Видимость = Истина;
	ИначеЕсли ТипЗаполнения = 2 Тогда // особый		
		Элементы.СтраницаИсточник.Видимость = Ложь;		
	КонецЕсли; 

	Если ПринадлежностьПоказателя = 
			ПредопределенноеЗначение("Перечисление.упоПринадлежностьПоказателя.Общий") Тогда
		Элементы.ГруппаПараметрыЗапроса.Видимость = Истина;
	ИначеЕсли ПринадлежностьПоказателя = 
			ПредопределенноеЗначение("Перечисление.упоПринадлежностьПоказателя.ТолькоДляПроекта") Тогда
		Элементы.СтраницаЗапросПЗ.Видимость = Ложь;
		Элементы.ПараметрыЗапросаПЗ.Видимость = Ложь;
		Элементы.ГруппаПараметрыЗапроса.Видимость = Истина;
	ИначеЕсли ПринадлежностьПоказателя = 
			ПредопределенноеЗначение("Перечисление.упоПринадлежностьПоказателя.ТолькоДляПроектнойЗадачи") Тогда
		Элементы.СтраницаЗапрос.Видимость = Ложь;
		Элементы.ПараметрыЗапроса.Видимость = Ложь;
	ИначеЕсли ПринадлежностьПоказателя = 
			ПредопределенноеЗначение("Перечисление.упоПринадлежностьПоказателя.Произвольный") Тогда
		Элементы.СтраницаСостоянияИндикатора.Видимость = Ложь;
		Элементы.СтраницаЗапросПЗ.Видимость = Ложь;
		Элементы.ПараметрыЗапросаПЗ.Видимость = Ложь;
		Элементы.ГруппаПараметрыЗапроса.Видимость = Ложь;
		Элементы.СтраницаЗапрос.Заголовок = нСтр("ru='Текст запроса'", "ru");
		Элементы.ПараметрыЗапроса.Заголовок = нСтр("ru='Параметры запроса'", "ru");
		Элементы.ВидЗаполнения.ТолькоПросмотр = Истина;
		Элементы.ТипИндикатора.ТолькоПросмотр = Истина;
		Элементы.ПоказательИнвестирования.Видимость = Ложь;
		Элементы.ГруппаНастройкиИндикаторКартинка.Видимость = Ложь;
		Элементы.ГруппаФорматнаяСтрока.Видимость = Ложь;
		Элементы.ГруппаСчитатьНастройкиГруппировок.Видимость = Ложь;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыражениеГруппировки()
	
	Если Объект.СчитатьСуммуПоГруппировкам
		И Объект.ТипЗаполнения = 1 Тогда
		
		Объект.ВыражениеГруппировки = "Формула";
		Элементы.ВыражениеГруппировки.Доступность = Ложь;
		
	Иначе 
		
		Элементы.ВыражениеГруппировки.Доступность = Истина;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметрыИзЗапросаНаСервере(ЗапросПЗ = Ложь)
	
	Если ЗапросПЗ Тогда
		ЗапросТекст  = Объект.ТекстЗапросаПЗ;
		ТабПараметры = ТаблицаПараметровПЗ;
	Иначе 
		ЗапросТекст  = Объект.ТекстЗапроса;
		ТабПараметры = ТаблицаПараметров;	
	КонецЕсли; 
	
	ТекстОшибки = "";
	Если НЕ упоФункцииОбщегоНазначенияСервер.ПроверитьЗапрос(ЗапросТекст, ТекстОшибки, , Истина) Тогда
		Сообщение = НСтр("ru = 'Параметры не могут быть извлечены из запроса.
                          |'");
		ОбщегоНазначения.СообщитьПользователю(Сообщение + ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросТекст;
	ПараметрыЗапроса = Запрос.НайтиПараметры();
	
	Для каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		НоваяСтрока = ТабПараметры.Добавить();
		НоваяСтрока.ИмяПараметра = ПараметрЗапроса.Имя;
		НоваяСтрока.ЭтоВыражение = Ложь;
		
		Если НЕ Модифицированность Тогда
			Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

// Устанавливает свойства колонок табличного поля "Параметры" в зависимости от различных условий,
// которые могут меняться динамически.
//
// Параметры:
//  нет.
//
&НаКлиенте
Процедура УправлениеКолонкамиПараметры(ЗапросПЗ = Ложь)
	
	Если ЗапросПЗ Тогда	
		Элементы.ТаблицаПараметровПЗ.ПодчиненныеЭлементы.ТаблицаПараметровПЗЗначениеПараметра.ВыбиратьТип =
			(Элементы.ТаблицаПараметровПЗ.ТекущиеДанные.ЭтоВыражение = Ложь);		
	Иначе 		
		Элементы.ТаблицаПараметров.ПодчиненныеЭлементы.ТаблицаПараметровЗначениеПараметра.ВыбиратьТип =
			(Элементы.ТаблицаПараметров.ТекущиеДанные.ЭтоВыражение = Ложь);		
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Процедура СформироватьСписокВыбора(ИмяПоляИсточника, ДанныеВыбора, ТекстПредупреждения = "")
	
	ЗапросПЗ = ИмяПоляИсточника = "ИмяПоляОбъектаПЗ" Или ИмяПоляИсточника = "ИмяПоляЗначенияПЗ"; 	
	
	Если ДанныеВыбора = Неопределено Тогда
		ДанныеВыбора = Новый СписокЗначений;
	КонецЕсли;
	
	ТекстЗапросаИзОбъекта = ?(ЗапросПЗ, Объект.ТекстЗапросаПЗ, Объект.ТекстЗапроса);
	Если ПустаяСтрока(ТекстЗапросаИзОбъекта) Тогда
		ДанныеВыбора.Очистить();
		Возврат;
	КонецЕсли;
	
	ВремПоле = Объект[ИмяПоляИсточника];
	
	ДанныеВыбора.Очистить();
	
	ПостроительОтчета = Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ТекстЗапросаИзОбъекта;
	ПостроительОтчета.ЗаполнитьНастройки();
	
	ТипИндикатора = Объект.ТипИндикатора;
	Для каждого Поле Из ПостроительОтчета.ДоступныеПоля Цикл
		
		Если НЕ Поле.Поле Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоЗначение = Ложь;
		ЭтоОбъект 	= Истина;
		Если ТипИндикатора = Перечисления.упоТипИндикатора.Число И Поле.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			ЭтоЗначение = Истина;
			ЭтоОбъект 	= Ложь;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Дата И Поле.ТипЗначения.СодержитТип(Тип("Дата")) Тогда
			ЭтоЗначение = Истина;
			ЭтоОбъект 	= Ложь;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Булево И Поле.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			ЭтоЗначение = Истина;
			ЭтоОбъект 	= Ложь;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Строка И Поле.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
			ЭтоЗначение = Истина;
			ЭтоОбъект 	= Ложь;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка И Поле.ТипЗначения.СодержитТип(ТипЗнч(Объект.ТипСсылки)) Тогда
			ЭтоЗначение = Истина;
			ЭтоОбъект 	= Истина;
		КонецЕсли;
		
		Если ЭтоЗначение Тогда
			Если ИмяПоляИсточника = "ИмяПоляЗначения" Или ИмяПоляИсточника = "ИмяПоляЗначенияПЗ" Тогда
				ДанныеВыбора.Добавить(Поле.Имя, Поле.Представление);
			КонецЕсли;
		КонецЕсли;
		Если ЭтоОбъект Тогда
			Если ИмяПоляИсточника = "ИмяПоляОбъекта" Или ИмяПоляИсточника = "ИмяПоляОбъектаПЗ" Тогда
				ДанныеВыбора.Добавить(Поле.Имя, Поле.Представление);
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;
	
	НайденноеПоле = ДанныеВыбора.НайтиПоЗначению(ВремПоле);
	Если НайденноеПоле = Неопределено Тогда
		Если ДанныеВыбора.Количество() > 0 Тогда
			Объект[ИмяПоляИсточника] = ДанныеВыбора[0].Значение;
		Иначе
			Если ИмяПоляИсточника = "ИмяПоляЗначения" 
				Или ИмяПоляИсточника = "ИмяПоляЗначенияПЗ" Тогда
				ТекстПредупреждения = НСтр("ru = 'Ошибка! Возможно, тип значения показателя не соответствует 
											|типу значения показателя(ей) в запросе!'");
			Иначе
				Объект[ИмяПоляИсточника] = Неопределено;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Объект[ИмяПоляИсточника] = НайденноеПоле.Значение;
	КонецЕсли;
	
КонецПроцедуры

// Функция проверяет возможность выполнения формулы.
//
// Возвращаемое значение:
//   Булево - успешность выполнения функции.
//
&НаСервере
Функция ФормулаКорректна()
	
	// Суть: сначала подставляем вместо индикатора какие-то значения,
	// потом подставляю 0. Всю эту строку надо вставить в запрос и проверить,
	// получит ли он какое-нибудь значение.
	
	ВсеКорректно = Ложь;
	
	ЧислоПоУмолчанию = "1";
	ДатаПоУмолчанию = "ДАТАВРЕМЯ(2000, 12, 16, 0, 0, 0)";
	БулевоЗначениеПоУмолчанию = "Истина";
	СтрокаЗначениеПоУмолчанию = """""";
	СсылкаЗначениеПоУмолчанию = Неопределено;
	ИмяПараметраНачальное = "Параметр";
	Итератор = 1;
	СоответствиеПараметраИПустойСсылки = Новый Структура;
	
	МассивИндикаторов = Объект.РасчетныеИндикаторы.Выгрузить(, "Индикатор").ВыгрузитьКолонку("Индикатор");
	ДанныеИндикаторовТаблицы = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивИндикаторов, "ТипИндикатора, ТипСсылки");
	
	ПолеЗапроса = Объект.СтрокаФормулы;
	Для каждого ИндикаторФормулы Из Объект.РасчетныеИндикаторы Цикл
		ДанныеИндикатора = ДанныеИндикаторовТаблицы.Получить(ИндикаторФормулы.Индикатор);
		Если ДанныеИндикатора = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ТипИндикатора = ДанныеИндикатора.ТипИндикатора;
		Если ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
			ЗначениеПоУмолчанию = ЧислоПоУмолчанию;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
			ЗначениеПоУмолчанию = ДатаПоУмолчанию;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
			ЗначениеПоУмолчанию = БулевоЗначениеПоУмолчанию;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
			ЗначениеПоУмолчанию = СтрокаЗначениеПоУмолчанию;
		ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда
			ИмяПараметра = ИмяПараметраНачальное + Строка(Итератор);
			Если ДанныеИндикатора.ТипСсылки = Неопределено Тогда
				ЗначениеПараметра = СсылкаЗначениеПоУмолчанию;
			Иначе
				ЗначениеПараметра = ДанныеИндикатора.ТипСсылки;
			КонецЕсли;
			СоответствиеПараметраИПустойСсылки.Вставить(ИмяПараметра, ЗначениеПараметра);			
			ЗначениеПоУмолчанию = "&" + ИмяПараметра;
			Итератор = Итератор + 1;			
		КонецЕсли;
		ПолеЗапроса = СтрЗаменить(ПолеЗапроса, ИндикаторФормулы.Представление, ЗначениеПоУмолчанию);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + ПолеЗапроса + " КАК Значение";
	
	Для Каждого Элемент Из СоответствиеПараметраИПустойСсылки Цикл
		Запрос.УстановитьПараметр(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Попытка
		
		Сообщение = НСтр("ru = 'Тип значения, вычисляемого по формуле, не соответствует типу значения показателя.'");
		ТипИндикатора = Объект.ТипИндикатора;
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ТипИндикатора = Перечисления.упоТипИндикатора.Число Тогда
				Если НЕ ТипЗнч(Выборка.Значение) = Тип("Число") Тогда
					ОбщегоНазначения.СообщитьПользователю(Сообщение);
					ВсеКорректно = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Дата Тогда
				Если Не ТипЗнч(Выборка.Значение) = Тип("Дата") Тогда
					ОбщегоНазначения.СообщитьПользователю(Сообщение);
					ВсеКорректно = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Булево Тогда
				Если НЕ ТипЗнч(Выборка.Значение) = Тип("Булево") Тогда
					ОбщегоНазначения.СообщитьПользователю(Сообщение);
					ВсеКорректно = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Строка Тогда
				Если НЕ ТипЗнч(Выборка.Значение) = Тип("Строка") Тогда
					ОбщегоНазначения.СообщитьПользователю(Сообщение);
					ВсеКорректно = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли ТипИндикатора = Перечисления.упоТипИндикатора.Ссылка Тогда
				Если НЕ (ТипЗнч(Выборка.Значение) = ТипСсылки Или 
					(ТипСсылки = Неопределено И ТипЗнч(Выборка.Значение) = Тип("Неопределено"))) Тогда
					ОбщегоНазначения.СообщитьПользователю(Сообщение);
					ВсеКорректно = Ложь;
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
			ВсеКорректно = Истина;
			
		КонецЦикла;
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		ПозицияСимвола = СтрНайти(ТекстОшибки, ":");
		Пока Не ПозицияСимвола = 0 Цикл
			ТекстОшибки = Сред(ТекстОшибки, ПозицияСимвола + 2);
		    ПозицияСимвола = СтрНайти(ТекстОшибки, ":");
		КонецЦикла;
		
		ШаблонТекстаОшибка = НСтр("ru = 'Обнаружена ошибка: %1'");
		Текст = СтрШаблон(ШаблонТекстаОшибка, ТекстОшибки); 
		
		ОбщегоНазначения.СообщитьПользователю(Текст);
		
		ВсеКорректно = Ложь;
		
	КонецПопытки;
	
	Возврат ВсеКорректно;
	
КонецФункции

