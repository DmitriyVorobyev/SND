&НаКлиенте
Процедура ТаблицаСостоянийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
		
	ИмяТЧ = "ТаблицаСостояний";
	
	ИмяКолонкиТЧ = "Значение";
	ЭлементЗначение = Элементы.ТаблицаСостоянийЗначение;
	УстановитьОграничениеТиповДляЭлементаТЧ(ЭлементЗначение, ИмяКолонкиТЧ, ИмяТЧ);
	
	ИмяКолонкиТЧ = "ЗначениеС";
	ЭлементЗначение = Элементы.ТаблицаСостоянийЗначениеС;
	УстановитьОграничениеТиповДляЭлементаТЧ(ЭлементЗначение, ИмяКолонкиТЧ, ИмяТЧ);
	
	ИмяКолонкиТЧ = "ЗначениеПо";
	ЭлементЗначение = Элементы.ТаблицаСостоянийЗначениеПо;
	УстановитьОграничениеТиповДляЭлементаТЧ(ЭлементЗначение, ИмяКолонкиТЧ, ИмяТЧ);
	
КонецПроцедуры

