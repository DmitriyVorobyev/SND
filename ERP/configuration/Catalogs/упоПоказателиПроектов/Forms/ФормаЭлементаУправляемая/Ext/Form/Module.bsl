&НаКлиенте
Процедура ТаблицаСостоянийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаСостоянийКартинка" Тогда
		
		ТекДанные = Элемент.ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда

			Контекст = Новый Структура;
			Контекст.Вставить("УИстроки",ТекДанные.ПолучитьИдентификатор());
	
			ОписаниеОповещения = Новый ОписаниеОповещения("ТаблицаСостоянийВыборОсновная",ЭтотОбъект,Контекст);
			ОткрытьФорму("ОбщаяФорма.упоФормаВыбораКартинкиУправляемая",,,,,,ОписаниеОповещения);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события "Таблица состояний выбор основная".
//
// Параметры:
//  ЗначениеКартинки		 - 	 - 
//  ДополнительныеПараметры	 - 	 - 
//
&НаКлиенте
Процедура ТаблицаСостоянийВыборОсновная(ЗначениеКартинки,ДополнительныеПараметры) Экспорт
	
	ТекДанные = ТаблицаСостояний.НайтиПоИдентификатору(ДополнительныеПараметры.УИстроки);
	
	Если НЕ ТекДанные = Неопределено И НЕ ЗначениеКартинки = Неопределено Тогда
		ТекДанные.Картинка = ЗначениеКартинки;
		ЭтаФорма.Модифицированность = Истина;
		СохранитьСостояния();
	КонецЕсли;
	
КонецПроцедуры

