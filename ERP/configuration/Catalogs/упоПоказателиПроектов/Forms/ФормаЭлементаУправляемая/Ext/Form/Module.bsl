// Функция получает число по строке с видом сравнения.
//
// Параметры:
//  ВидСравнения - Тип: Строка, содержит строку для которой нужно вернуть число.
//
// Возвращаемое значение:
//  Число
//
&НаКлиенте
Функция ПолучитьНомерВидаСравнения(ВидСравнения)
	
	НомерВида = 0;
	
	Если ВидСравнения = "Равно" Тогда 
		Возврат 1;
	ИначеЕсли ВидСравнения = "Не равно" Тогда 
		Возврат 2;
	ИначеЕсли ВидСравнения = "Меньше" Тогда 
		Возврат 3;
	ИначеЕсли ВидСравнения = "Меньше или равно" Тогда 
		Возврат 4;
	ИначеЕсли ВидСравнения = "Больше" Тогда 
		Возврат 5;
	ИначеЕсли ВидСравнения = "Больше или равно" Тогда 
		Возврат 6;
	ИначеЕсли ВидСравнения = "Интервал (>, <)" Тогда 
		Возврат 7; 
	ИначеЕсли ВидСравнения = "Интервал (>=, <=)" Тогда
		Возврат 8;
	ИначеЕсли ВидСравнения = "Интервал (>=, <)" Тогда
		Возврат 9; 
	ИначеЕсли ВидСравнения = "Интервал (>, <=)" Тогда
		Возврат 10; 
	КонецЕсли;
	
	Возврат НомерВида;
	
КонецФункции

// Процедура синхронизирует табличную часть "Состояния" с реквизитом формы "ТаблицаСостояний".
//
&НаКлиенте
Процедура СохранитьСостояния()
	
	Объект.Состояния.Очистить();
	
	Для каждого вСтрока Из ТаблицаСостояний Цикл
		
		НоваяСтрока = Объект.Состояния.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, вСтрока);
		НоваяСтрока.ВидСравнения = ПолучитьНомерВидаСравнения(вСтрока.ВидСравнения);
		НоваяСтрока.Оформление = вСтрока.Картинка;
		НоваяСтрока.ВыражениеЗначения = вСтрока.ВыражениеЗначения;
		
	КонецЦикла;           
	
КонецПроцедуры

