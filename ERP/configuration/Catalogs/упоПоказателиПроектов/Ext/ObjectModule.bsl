Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.Вручную
	 ИЛИ ((НЕ ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора) И (НЕ ТипЗаполнения = 0)) Тогда
		
		УдалитьЗначениеИзМассива("ИмяПоляОбъекта", ПроверяемыеРеквизиты);
		УдалитьЗначениеИзМассива("ИмяПоляЗначения", ПроверяемыеРеквизиты);
		УдалитьЗначениеИзМассива("ИмяПоляОбъектаПЗ", ПроверяемыеРеквизиты);
		УдалитьЗначениеИзМассива("ИмяПоляЗначенияПЗ", ПроверяемыеРеквизиты);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьЗначениеИзМассива(УдаляемоеЗначение, МассивЭлементов)
	
	ИндексЭлемента = МассивЭлементов.Найти(УдаляемоеЗначение);
	Если НЕ ИндексЭлемента = Неопределено Тогда
		МассивЭлементов.Удалить(ИндексЭлемента);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМаксимальныйПорядокПоказателей()
	
	Порядок = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	упоПоказателиПроектов.Порядок
	|ИЗ
	|	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	|
	|УПОРЯДОЧИТЬ ПО
	|	упоПоказателиПроектов.Порядок УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Порядок = Выборка.Порядок;
		
	КонецЕсли;
	
	Возврат Порядок;
	
КонецФункции

#КонецОбласти

