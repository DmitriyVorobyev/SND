// Функция формирует структуру обязательных реквизитов объекта.
// Для группы формируется только структура реквизитов шапки,
// для элемента формируется структура реквизитов шапки или табличной части.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	Если ЭтотОбъект.ЭтоГруппа Тогда // Для группы.
		Если ИмяТабличнойЧасти = Неопределено Тогда
			// Формирование структуры обязательных реквизитов шапки.
			СтруктураОбязательныхПолей.Вставить("Наименование");
		КонецЕсли;
	Иначе // Для элемента.
		Если ИмяТабличнойЧасти = Неопределено Тогда
			// Формирование структуры обязательных реквизитов шапки.
			СтруктураОбязательныхПолей.Вставить("Наименование");
			СтруктураОбязательныхПолей.Вставить("ТипИндикатора");
			СтруктураОбязательныхПолей.Вставить("ВидЗаполнения");
			Если ЭтотОбъект.ТипЗаполнения = 0 И ВидЗаполнения <> Перечисления.упоВидЗаполненияИндикатора.Вручную Тогда
				Если ЭтотОбъект.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.Общий Тогда
					СтруктураОбязательныхПолей.Вставить("ИмяПоляЗначения");
					СтруктураОбязательныхПолей.Вставить("ИмяПоляОбъекта");
					СтруктураОбязательныхПолей.Вставить("ИмяПоляЗначенияПЗ");
					СтруктураОбязательныхПолей.Вставить("ИмяПоляОбъектаПЗ");
				ИначеЕсли ЭтотОбъект.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроекта Тогда
					СтруктураОбязательныхПолей.Вставить("ИмяПоляЗначения");
					СтруктураОбязательныхПолей.Вставить("ИмяПоляОбъекта");
				ИначеЕсли ЭтотОбъект.ПринадлежностьПоказателя = Перечисления.упоПринадлежностьПоказателя.ТолькоДляПроектнойЗадачи Тогда
					СтруктураОбязательныхПолей.Вставить("ИмяПоляЗначенияПЗ");
					СтруктураОбязательныхПолей.Вставить("ИмяПоляОбъектаПЗ");
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ИмяТабличнойЧасти = "_ПримерТабличнойЧасти" Тогда
			// Формирование структуры обязательных реквизитов табличной части _ПримерТабличнойЧасти.
			СтруктураОбязательныхПолей.Вставить("_ПримерРеквизита");
			СтруктураОбязательныхПолей.Вставить("_ПримерРеквизитаЧисло");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет заполнение обязательных реквизитов объекта.
// Если хотя бы один реквизит не заполнен, то выставляется флаг отказа от выполнения операции.
// 
// Параметры:
//  Отказ        - Булево - признак отказа от выполнения операции.
// 
Процедура лмПроверитьЗаполнениеРеквизитов(Отказ) Экспорт
	
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Процедура выполняет действия при подборе в табличную часть.
//
// Параметры:
//  Строка			 - СтрокаТабличнойЧасти			 - строка, добавляемая в табличную часть при подборе
//  ПараметрыПодбора - СписокЗначений, Неопределено	 - не используется.
//
Процедура ВыполнитьДействияПриПодборе(Строка, ПараметрыПодбора = Неопределено) Экспорт 
	
	Отказ = Ложь;
	
	Если Строка.Индикатор = ЭтотОбъект.Ссылка Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Строка.Индикатор.ТипЗаполнения = 1 Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Строка.Индикатор.ВидЗаполнения = Перечисления.упоВидЗаполненияИндикатора.Автоматически Тогда
		// Должно быть совпадение по типам
		Если НЕ Строка.Индикатор.ТипИндикатора = ТипИндикатора Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		Сообщение = НСтр("ru = 'Нельзя использовать индикатор ""%1"" в формуле.'");
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, Строка.Индикатор);
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Возврат;
	КонецЕсли;
	
	представлениеВФормуле = "[" + Строка.Индикатор + "]";
	
	// Проверим, нет ли этого представления уже в таблице
	//НайденныеСтроки = РасчетныеИндикаторы.НайтиСтроки(Новый Структура("Представление", представлениеВФормуле));
	//колво = НайденныеСтроки.Количество();
	//Если колво > 0 Тогда
	//	Строка.Представление = "[" + Строка.Индикатор + колво + "]";
	//Иначе
	//	Строка.Представление = представлениеВФормуле;
	//КонецЕсли;
	
	Строка.Представление = представлениеВФормуле;
	
КонецПроцедуры

