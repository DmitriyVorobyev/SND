// Преобразует формулу расчета
//
// Параметры:
//  Показатель		 - СправочникСсылка.упоПоказателиПроектов 	- показатель, рассчитываемый по формуле.
//  текСтрокаФормулы - Строка	- строка формулы, которуется требуется преобразовать.
//
// Возвращаемое значение:
//	строка - формула расчета показателя.
//
Функция ПолучитьФормулуРасчетаПоказателя(Показатель, текСтрокаФормулы = "") Экспорт
	
	Рез = текСтрокаФормулы;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоПоказателиПроектовРасчетныеИндикаторы.Индикатор,
	               |	упоПоказателиПроектовРасчетныеИндикаторы.Представление,
	               |	упоПоказателиПроектовРасчетныеИндикаторы.Индикатор.Наименование КАК Имя
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов.РасчетныеИндикаторы КАК упоПоказателиПроектовРасчетныеИндикаторы
	               |ГДЕ
	               |	упоПоказателиПроектовРасчетныеИндикаторы.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоПоказателиПроектов.строкаФормулы
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	               |ГДЕ
	               |	упоПоказателиПроектов.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",Показатель);
	РезЗапроса = Запрос.ВыполнитьПакет();
		
	Если ПустаяСтрока(Рез) Тогда
		Выборка = РезЗапроса[1].Выбрать();
		Если Выборка.Следующий() Тогда
			Рез = Выборка.строкаФормулы;	
		КонецЕсли;
	КонецЕсли;
	
	Выборка = РезЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Рез = СтрЗаменить(Рез,Выборка.Представление,"["+Выборка.Имя+"]");	
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

