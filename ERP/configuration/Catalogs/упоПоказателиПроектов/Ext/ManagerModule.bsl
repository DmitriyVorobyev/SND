#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СкрытьПроизвольныйПоказатель") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДанныеВыбора = Новый СписокЗначений();
		ПоказателиПодбора = ПоказателиПодбора(Параметры.СтрокаПоиска);
		ДанныеВыбора.ЗагрузитьЗначения(ПоказателиПодбора);
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоказателиПодбора(СтрокаПоиска = "") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	упоПоказателиПроектов.Ссылка КАК Показатель
	               |ИЗ
	               |	Справочник.упоПоказателиПроектов КАК упоПоказателиПроектов
	               |ГДЕ
	               |	НЕ упоПоказателиПроектов.ПометкаУдаления
	               |	И НЕ упоПоказателиПроектов.ЭтоГруппа
	               |	И НЕ упоПоказателиПроектов.ПринадлежностьПоказателя = ЗНАЧЕНИЕ(Перечисление.упоПринадлежностьПоказателя.Произвольный)
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоСтроке
	               |				ТОГДА упоПоказателиПроектов.Наименование ПОДОБНО &СтрокаПоиска
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ";	
		
	Запрос.УстановитьПараметр("ОтборПоСтроке", ЗначениеЗаполнено(СтрокаПоиска));
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");
	
	МассивПоказателей = Новый Массив;

	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		МассивПоказателей = Результат.Выгрузить().ВыгрузитьКолонку("Показатель");
	КонецЕсли;
	
	Возврат МассивПоказателей;
	
КонецФункции

