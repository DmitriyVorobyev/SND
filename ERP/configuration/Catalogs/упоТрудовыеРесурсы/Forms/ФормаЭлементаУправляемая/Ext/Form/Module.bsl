#КонецОбласти

&НаСервере
Процедура ИнициализацияФормы()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Ресурс = Объект.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Ресурс = Параметры.ЗначениеКопирования;
	Иначе
		Ресурс = Неопределено;
	КонецЕсли;
	
	Если Ресурс <> Неопределено Тогда
		ТаблицаСтатей = СтатьиЗатрат.Выгрузить();
		обПолучитьРаспределениеСтатейЗатрат(Ресурс, ТаблицаСтатей);
		СтатьиЗатрат.Загрузить(ТаблицаСтатей);
	КонецЕсли;
	
	Элементы.ФизическоеЛицо.Видимость = упоИнтеграцияВызовСервера.ЭтоEPM();
	
	УстановитьОтборы();

	ВидимостьЗакладокФормы();
	
КонецПроцедуры	

#КонецОбласти
