&НаСервере
Функция УстановитьОтборы() 
	
	ЭтоНовый = Не ЗначениеЗаполнено(Объект.Ссылка);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокОтборРолей, 	 "ЭтоНовый", ЭтоНовый);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаСтоимость, "ЭтоНовый", ЭтоНовый);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Подразделения, "ЭтоНовый", ЭтоНовый);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокОтборРолей, 	 "Ресурс", Объект.Ссылка);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ТаблицаСтоимость, "Ресурс", Объект.Ссылка);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Подразделения, 	"Ресурс", Объект.Ссылка);

КонецФункции

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()	
	
	НадписьПоследняяМодификация = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьЗакладокФормы()
	
	// Трудовые ресурсы пользователя нужны для установки видимости закладок формы.
	МассивТрудовыхРесурсовПользователя = ПараметрыСеанса.упоСписокТрудовыхРесурсовСотрудника;
	ЕстьПолныеПрава = РольДоступна("ПолныеПрава");
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЭтоРесурсПользователя = ЕстьПолныеПрава ИЛИ (НЕ МассивТрудовыхРесурсовПользователя.Найти(Объект.Ссылка) = Неопределено);
	Иначе
		// Для новых ТР предполагаем, что текущий ресурс принадлежит пользователю или он имеет все полномочия, раз он его может создать.
		ЭтоРесурсПользователя = Истина;
	КонецЕсли;
	
	// Ограничение доступа к закладке "Компетенции".
	
	ДоступКоВсемКомпетенциям = ЕстьПолныеПрава ИЛИ РольДоступна("упоДоступКоВсемКомпетенциям");
	Если НЕ ДоступКоВсемКомпетенциям Тогда
		ЕстьДоступККомпетенцииРесурса = (НЕ МассивТрудовыхРесурсовПользователя.Найти(Объект.Ссылка) = Неопределено);
		Элементы.Показатели.Видимость = ЕстьДоступККомпетенцииРесурса;
		Элементы.СтраницаКомпетенции.Видимость = ЕстьДоступККомпетенцииРесурса;
	КонецЕсли;
	
	// Ограничение доступа к закладке "Статьи затрат".
	
	ДобавлениеИзменениеСтатейЗатратВсехТрудовыхРесурсов = ЕстьПолныеПрава ИЛИ РольДоступна("упоДобавлениеИзменениеСтатейЗатратВсехТрудовыхРесурсов");
	ДобавлениеИзменениеСтатейЗатратСвоихТрудовыхРесурсов = РольДоступна("упоДобавлениеИзменениеСтатейЗатратСвоихТрудовыхРесурсов");
	ЧтениеСтатейЗатратСвоихТрудовыхРесурсов = РольДоступна("упоЧтениеСтатейЗатратСвоихТрудовыхРесурсов");
	
	Если ДобавлениеИзменениеСтатейЗатратВсехТрудовыхРесурсов Тогда
		Элементы.СтатьиЗатрат.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
	ИначеЕсли ДобавлениеИзменениеСтатейЗатратСвоихТрудовыхРесурсов
			ИЛИ ЧтениеСтатейЗатратСвоихТрудовыхРесурсов Тогда
		Элементы.СтатьиЗатрат.Видимость = ЭтоРесурсПользователя;
		Элементы.СтраницаСтатьиЗатрат.Видимость = ЭтоРесурсПользователя;
		Элементы.СтатьиЗатрат.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр ИЛИ (НЕ ДобавлениеИзменениеСтатейЗатратСвоихТрудовыхРесурсов);
	Иначе
		Элементы.СтатьиЗатрат.Видимость = Ложь;
		Элементы.СтраницаСтатьиЗатрат.Видимость = Ложь;
	КонецЕсли;
	
	// Ограничение доступа к закладке "Роли".
	
	ЧтениеРолейВсехТрудовыхРесурсов = ЕстьПолныеПрава ИЛИ РольДоступна("упоЧтениеРолейВсехТрудовыхРесурсов");
	Если НЕ ЧтениеРолейВсехТрудовыхРесурсов Тогда
		Элементы.СписокОтборРолей.Видимость = ЭтоРесурсПользователя;
		Элементы.СтраницаРоли.Видимость = ЭтоРесурсПользователя;
	КонецЕсли;
	
	// Ограничение доступа к закладке "Стоимость".
	
	Доступ = упоРазграничениеДоступаВызовСервера.обДоступностьФинансовойИнформации();
	Если Доступ = "Отсутствует" Тогда
		Элементы.ТаблицаСтоимость.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсториюНазначенийРолей(Команда)
	
	Для каждого ЭлементОтбора Из СписокОтборРолей.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		Если ЭлементОтбора.Представление = "ПоказатьИсториюНазначенийРолей" Тогда
			ЭлементОтбора.Использование = Элементы.СписокОтборРолейПоказатьИсториюНазначенийРолей.Пометка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Элементы.СписокОтборРолейПоказатьИсториюНазначенийРолей.Пометка = Не Элементы.СписокОтборРолейПоказатьИсториюНазначенийРолей.Пометка;
	
КонецПроцедуры

// СтандартныеПодсистемы.Свойства

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
