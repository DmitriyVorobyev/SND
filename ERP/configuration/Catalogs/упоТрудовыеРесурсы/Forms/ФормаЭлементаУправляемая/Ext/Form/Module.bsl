
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
		
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка); 		
	
	ИнициализацияФормы();
	
	// Оповещения PM	
	упоОповещенияВызовСервера.ДобавитьЭлементыПодписки(ЭтаФорма, Объект, Элементы.ОсновнаяПанель);	
	// Конец Оповещения PM
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбновитьНадписьПоследняяМодификация();
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
		
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ТекущийОбъект.лмПроверитьЗаполнениеРеквизитов(Отказ);
	
	Для Каждого СтрокаТаблицы Из СтатьиЗатрат Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СтатьяЗатрат) И СтрокаТаблицы.ДоляСуммы > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексСтроки = СтатьиЗатрат.Индекс(СтрокаТаблицы);
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтатьяЗатрат) Тогда
			СтрокаСообщения = НСтр("ru = 'В строке №%1 табличной части ""Статьи затрат"": Необходимо заполнить значение реквизита ""Статья затрат""'");
			СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, СокрЛП(ИндексСтроки + 1));
			СтруктураСообщения = Новый Структура;                                                       
			СтруктураСообщения.Вставить("Поле", "СтатьиЗатрат[" + ИндексСтроки + "].СтатьяЗатрат");
			обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок, ,СтруктураСообщения);
		ИначеЕсли СтрокаТаблицы.ДоляСуммы = 0 Тогда
			СтрокаСообщения = НСтр("ru = 'В строке №%1 табличной части ""Статьи затрат"": Необходимо заполнить значение реквизита ""Доля суммы (%)""'");
			СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, СокрЛП(ИндексСтроки + 1));
			СтруктураСообщения = Новый Структура;                                                       
			СтруктураСообщения.Вставить("Поле", "СтатьиЗатрат[" + ИндексСтроки + "].ДоляСуммы");
			обСообщитьОбОшибке(СтрокаСообщения, Отказ, Заголовок, ,СтруктураСообщения);
		КонецЕсли;
		
	КонецЦикла;	
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	Если (НЕ Отказ) И (НЕ обЗаписатьРаспределениеСтатейЗатрат(ТекущийОбъект.Ссылка, СтатьиЗатрат.Выгрузить())) Тогда
		Отказ = Истина;
	КонецЕсли;
		 
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьОтборы();
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	// Оповещения PM
	упоОповещенияВызовСервера.СохранитьПодписку(ЭтаФорма, ТекущийОбъект);	
	// Конец Оповещения PM
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ОбновитьНадписьПоследняяМодификация();
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

