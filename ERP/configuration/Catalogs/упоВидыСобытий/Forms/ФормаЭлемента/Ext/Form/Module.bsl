&НаКлиенте
Процедура ТранспортОповещенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле = Элементы.ТранспортОповещенийНастройка Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ЭтаФорма.ТолькоПросмотр Тогда
			Возврат;
		КонецЕсли;
		
		ТекДанные = Объект.ТранспортОповещений.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ТекДанные.НужнаДополнительнаяНастройка Тогда
			Возврат;
		КонецЕсли;
				
		ПараметрыФормыНастроек = Новый Структура;
		ПараметрыФормыНастроек.Вставить("Транспорт", ТекДанные.Транспорт);
		ПараметрыФормыНастроек.Вставить("Источник", Объект.Источник);
		ПараметрыФормыНастроек.Вставить("Настройка", ТекДанные.НастройкаЧитаемая);
		ПараметрыФормыНастроек.Вставить("УИДСтроки", ТекДанные.ПолучитьИдентификатор());
		
		ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаНастроекТранспорта", ПараметрыФормыНастроек, 
																				ЭтаФорма,
																				,,,,
																				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
																			
КонецПроцедуры

