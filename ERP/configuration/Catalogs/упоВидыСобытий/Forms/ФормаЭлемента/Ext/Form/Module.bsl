&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
		
	упоОбработчикиСобытийСервер.ФормаПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	тз = ТекущийОбъект.УсловияРегистрацииСобытия.Выгрузить();
	Объект.УсловияРегистрацииСобытия.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = Объект.УсловияРегистрацииСобытия.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		НовСтр.ЗначениеУсловияЧитаемое = СтрТз.ЗначениеУсловия.Получить();	
		ОбновитьПредставлениеЗначенияВУсловиях(НовСтр);
	КонецЦикла;
	
	тз = ТекущийОбъект.Тэги.Выгрузить();
	Объект.Тэги.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = Объект.Тэги.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		НовСтр.УсловиеЧитаемое = СтрТз.УсловиеХЗ.Получить();	
	КонецЦикла;
	
	тз = ТекущийОбъект.ТранспортОповещений.Выгрузить();
	Объект.ТранспортОповещений.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = Объект.ТранспортОповещений.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		НовСтр.НастройкаЧитаемая = СтрТз.НастройкаХЗ.Получить();	
	КонецЦикла;
	
	РасписаниеДетектора = ТекущийОбъект.РасписаниеДетектора.Получить();
	Если РасписаниеДетектора = Неопределено Тогда
		РасписаниеДетектора = упоОповещенияВызовСервера.РасписаниеПоУмолчанию();
	КонецЕсли;
	
	ПредШаблонТекста = ТекущийОбъект.ШаблонТекста;
	ПредТекстПисьмаФорматированныйДокумент = ТекстПисьмаФорматированныйДокумент;

КонецПроцедуры

