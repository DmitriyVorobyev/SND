
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	упоОповещенияВызовСервера.ПриСозданииНаСервереФормТиповыхОповещений(ЭтаФорма, Объект);
	
	Элементы.ГруппаПодсказаПредопределенные.Видимость = Объект.Предопределенный;
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка); 			
	
	ПодсказкаДетектораТекст = НСтр("ru = '
	|// Проверка выполнения условия осуществляется регламентным заданием ""Обработка детекторов событий"".
	|// Если код детектора возвращает Истину, то еще дополнительно проверяются Условия регистрации события.
	|// Доступные переменные:	""Источник"" - любая ссылка или массив ссылок, в которую(ый) возвращается объект(ы), связанный(ые) с событием
	|//							""ПараметрыВозврата"" - структура
	|//							""ПараметрыВыполненияКода"" - структура, сгенерированная на основании таблицы ""Параметры выполняемого кода""
	|//							""Результат"" - булевая переменная. Если в ней возвращается Истина, то регистрируется событие(ия)
	|//'");		
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Используется = Истина;
	КонецЕсли;
	
	масТранспорт = Новый Массив;
	Для Каждого СтрТЧ Из Объект.ТранспортОповещений Цикл
		Если СтрТЧ.Используется Тогда
			масТранспорт.Добавить(СтрТЧ.Транспорт);
		КонецЕсли;
	КонецЦикла;
	ПарТранспорта = ПолучитьПараметрыТранспорта(масТранспорт);
	ЗаполнитьЗначенияСвойств(ЭтаФорма,ПарТранспорта);
	
	УправлениеДоступностью(ЭтаФорма);
	
	ОпределитьДоступныеТаблицыИсточника();
	ОпределитьВариантыИзмененияОбъекта();
	
	ТемаПисьмаФорматированныйДокумент.Добавить(Объект.ШаблонТемы);
	СтруктураВложений = Новый Структура;
	Если Не Объект.Ссылка.Пустая() Тогда
		Если Не ПустаяСтрока(Объект.ШаблонТекстаHTML) Тогда
			
			Объект.ШаблонТекстаHTML = упоОповещенияВызовСервера.ОбработатьТекстHTMLДляФорматированногоДокумента(Объект.Ссылка,Объект.ШаблонТекстаHTML,СтруктураВложений);
			
		КонецЕсли;
	КонецЕсли;
	ТекстПисьмаФорматированныйДокумент.УстановитьHTML(Объект.ШаблонТекстаHTML,СтруктураВложений);
	
	УстановитьОформление(ЭтаФорма);
	
	ЗаполнитьПолеНужнаДополнительнаяНастройкаДляТраспорта();
	
	ОтобразитьПредупреждениеИспользованияРегистров(Объект.ВариантИзмененияОбъекта,
		Элементы.ПредупреждениеВариантИзмененияОбъектаТекст);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ЗаполнитьСписокДоступныхРеквизитов();
	Элементы.ПоказатьПодсказкуДетектора.Пометка = НЕ ПодсказкаДетектораОтжата;
	Элементы.ГруппаПодсказкаДетоктора.Видимость = НЕ ПодсказкаДетектораОтжата;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора); 
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаТэга" Тогда
		
		СтрокиТэгов = Объект.Тэги.НайтиСтроки(Новый Структура("Представление", ВыбранноеЗначение.Представление));
		
		Если ВыбранноеЗначение.Свойство("Идентификатор") ИЛИ НЕ СтрокиТэгов.Количество() Тогда
			
			Если ВыбранноеЗначение.Свойство("Идентификатор") Тогда
				СтрокаТэгов = Объект.Тэги.НайтиПоИдентификатору(ВыбранноеЗначение.Идентификатор); 
			Иначе
				СтрокаТэгов = Объект.Тэги.Добавить();
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаТэгов, ВыбранноеЗначение);
			СтрокаТэгов.УсловиеЧитаемое = Новый Структура;
			СтрокаТэгов.УсловиеЧитаемое.Вставить("ДопРеквЗначениеУсловия", ВыбранноеЗначение.ДопРеквЗначениеУсловия);
			СтрокаТэгов.УсловиеЧитаемое.Вставить("ДопРеквИмяТаблицы", ВыбранноеЗначение.ДопРеквИмяТаблицы);
			СтрокаТэгов.УсловиеЧитаемое.Вставить("ДопРеквПолеЗначения", ВыбранноеЗначение.ДопРеквПолеЗначения);
			СтрокаТэгов.УсловиеЧитаемое.Вставить("ДопРеквПолеСвязи", ВыбранноеЗначение.ДопРеквПолеСвязи);
			СтрокаТэгов.УсловиеЧитаемое.Вставить("ДопРеквПолеУсловия", ВыбранноеЗначение.ДопРеквПолеУсловия);
			СтрокаТэгов.УсловиеЧитаемое.Вставить("ИмяТаблицыИсточника", ВыбранноеЗначение.ИмяТаблицыИсточника);
				
		Иначе	
		
			ВыбранноеЗначение.Вставить("Источник", Объект.Источник);
			
			ФормаТэга = ПолучитьФорму("Справочник.упоВидыСобытий.Форма.ФормаТэга", ВыбранноеЗначение, ЭтаФорма);		
			ФормаТэга.Открыть();
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.ИдентификаторНазначения = ФормаТэга.УникальныйИдентификатор;
			Сообщение.Текст = НСтр("ru = 'Тэг с таким представлением уже существует'");
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаВводаПериода" Тогда
		
		ТекДанные = Объект.УсловияРегистрацииСобытия.НайтиПоИдентификатору(ВыбранноеЗначение.УИстроки);
		
		Если ТекДанные <> Неопределено Тогда
			ТекДанные.ЗначениеУсловияЧитаемое = Новый СписокЗначений; 
			ТекДанные.ЗначениеУсловияЧитаемое.Добавить(ВыбранноеЗначение.НачалоПериода);
			ТекДанные.ЗначениеУсловияЧитаемое.Добавить(ВыбранноеЗначение.КонецПериода);
			ОбновитьПредставлениеЗначенияВУсловиях(ТекДанные);
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаПодбораСсылок" Тогда
		
		ТекДанные = Объект.УсловияРегистрацииСобытия.НайтиПоИдентификатору(ВыбранноеЗначение.УИстроки);
		
		Если ТекДанные <> Неопределено Тогда
			ТекДанные.ЗначениеУсловияЧитаемое = Новый СписокЗначений; 
			ТекДанные.ЗначениеУсловияЧитаемое.ЗагрузитьЗначения(ВыбранноеЗначение.ВыбЗначения);
			ОбновитьПредставлениеЗначенияВУсловиях(ТекДанные);
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаРедактированияКода" Тогда
		
		Если ВыбранноеЗначение.ИмяТабЧасти = "Получатели" Тогда
			
			ТекДанные = Объект.Получатели.НайтиПоИдентификатору(ВыбранноеЗначение.УИстроки);
			
			Если ТекДанные <> Неопределено Тогда
				ТекДанные.ДопУсловие = ВыбранноеЗначение.ВыполняемыйКод;
			КонецЕсли;
			
		ИначеЕсли ВыбранноеЗначение.ИмяТабЧасти = "КодОпределенияДопПараметра" Тогда
					
			Объект.КодОпределенияДопПараметра = ВыбранноеЗначение.ВыполняемыйКод;
			
		Иначе
			
			ТекДанные = Объект.УсловияРегистрацииСобытия.НайтиПоИдентификатору(ВыбранноеЗначение.УИстроки);
			
			Если ТекДанные <> Неопределено Тогда
				ТекДанные.ВыполняемыйКод = ВыбранноеЗначение.ВыполняемыйКод;
				ТекДанные.ПроверкаПоКоду = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаВыбораРеквизитаИсточника" Тогда
		
		ТекДанные = Объект.УсловияРегистрацииСобытия.НайтиПоИдентификатору(ВыбранноеЗначение.УИстроки);
		
		Если ТекДанные <> Неопределено Тогда     
			Если ТекДанные.РеквизитОбъекта <> ВыбранноеЗначение.ПолноеИмя Тогда
				ТекДанные.ЗначениеУсловияЧитаемое = Неопределено;	
				ОбновитьПредставлениеЗначенияВУсловиях(ТекДанные);
			КонецЕсли;
			ТекДанные.ПредставлениеРеквизита = ВыбранноеЗначение.ПолноеПредставление; 
			ТекДанные.РеквизитОбъекта = ВыбранноеЗначение.ПолноеИмя; 
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаНастроекТранспорта" Тогда
		
		ТекДанные = Объект.ТранспортОповещений.НайтиПоИдентификатору(ВыбранноеЗначение.УИДСтроки);
		
		Если ТекДанные = Неопределено Тогда     
			Возврат;
		КонецЕсли;
		
		ТекДанные.НастройкаЧитаемая = ВыбранноеЗначение.Настройка; 
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.ИспользоватьДляАнализаПредыдущиеЗначения = Объект.ИспользоватьДляАнализаПредыдущиеЗначения И
	МожноИспользоватьДляАнализаПредыдущиеЗначения(Объект);
	
	Если Не ЗначениеЗаполнено(Объект.ШаблонТекста) 
		И Не ЗначениеЗаполнено(ТекстПисьмаФорматированныйДокумент.ПолучитьТекст()) Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Задайте шаблон текста сообщения'");
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	тз = Объект.УсловияРегистрацииСобытия.Выгрузить();
	ТекущийОбъект.УсловияРегистрацииСобытия.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = ТекущийОбъект.УсловияРегистрацииСобытия.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		НовСтр.ЗначениеУсловия = Новый ХранилищеЗначения(СтрТз.ЗначениеУсловияЧитаемое);	
	КонецЦикла;
	
	тз = Объект.Тэги.Выгрузить();
	ТекущийОбъект.Тэги.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = ТекущийОбъект.Тэги.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		НовСтр.УсловиеХЗ = Новый ХранилищеЗначения(СтрТз.УсловиеЧитаемое);	
	КонецЦикла;
	
	тз = Объект.ТранспортОповещений.Выгрузить();
	ТекущийОбъект.ТранспортОповещений.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = ТекущийОбъект.ТранспортОповещений.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрТз);
		НовСтр.НастройкаХЗ = Новый ХранилищеЗначения(СтрТз.НастройкаЧитаемая);	
	КонецЦикла;
	
	ТекущийОбъект.РасписаниеДетектора = Новый ХранилищеЗначения(РасписаниеДетектора);
	
	// Подготовим документ HTML из содержимого форматированного документа.
	
	ТаблицаСоответствийИменВложенийИдентификаторам.Очистить();
	
	СтруктураВложений = Новый Структура;
	ТекстПисьмаФорматированныйДокумент.ПолучитьHTML(ТекущийОбъект.ШаблонТекстаHTML, СтруктураВложений);
	Для каждого Вложение Из СтруктураВложений Цикл
		
		НоваяСтрока = ТаблицаСоответствийИменВложенийИдентификаторам.Добавить();
		НоваяСтрока.ИмяФайла = Вложение.Ключ;
		НоваяСтрока.ИдентификаторФайлаДляHTML = Новый УникальныйИдентификатор;
		НоваяСтрока.Картинка = Вложение.Значение;
		
	КонецЦикла;
	
	Если ТаблицаСоответствийИменВложенийИдентификаторам.Количество() > 0 Тогда
		
		ДокументHTML = упоОповещенияВызовСервера.ПолучитьОбъектДокументHTMLИзТекстаHTML(ТекущийОбъект.ШаблонТекстаHTML);
		упоОповещенияВызовСервера.ЗаменитьИменаКартинокНаИдентификаторыПочтовыхВложенийВHTML( ДокументHTML, ТаблицаСоответствийИменВложенийИдентификаторам.Выгрузить());
		ТекущийОбъект.ШаблонТекстаHTML = упоОповещенияВызовСервера.ПолучитьТекстHTMLИзОбъектаДокументHTML(ДокументHTML);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	ЭтаФорма.Прочитать();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтаФорма);
	ОбновитьПовторноИспользуемыеЗначения();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗакрытием(ЭтаФорма, 
													Объект, 
													Отказ, 
													СтандартнаяОбработка, 
													ЗавершениеРаботы, 
													ТекстПредупреждения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриЗакрытии(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаОповещения(ЭтаФорма, Объект, ИмяСобытия, Параметр, Источник);
	
	Если ИмяСобытия = "упоОбновленоСостояниеВидаОповещения" И Параметр = Объект.Ссылка Тогда
		ЭтаФорма.Прочитать();		
		УстановитьОформление(ЭтаФорма);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	упоОбработчикиСобытийКлиент.ФормаВнешнееСобытие(ЭтаФорма, Объект, Источник, Событие, Данные);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПриЗагрузкеДанныхИзНастроекНаСервере(ЭтаФорма, Объект, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПриСохраненииДанныхВНастройкахНаСервере(ЭтаФорма, Объект, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
		
