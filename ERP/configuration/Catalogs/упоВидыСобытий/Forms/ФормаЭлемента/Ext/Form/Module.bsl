&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеЗначенияУсловия(Значение) 
	Представление = "";
	Если ТипЗнч(Значение) = Тип("СписокЗначений") 
		И Значение.Количество() = 2 
		И ТипЗнч(Значение[0].Значение) = Тип("Дата") 
		И ТипЗнч(Значение[1].Значение) = Тип("Дата") 
		Тогда
			Представление = ""+Значение[0].Значение + "-" + Значение[1].Значение;
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
		Представление = ""+Значение;
	Иначе
		Представление = "";
	КонецЕсли;
	Возврат Представление;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОбновитьПредставлениеЗначенияВУсловиях(СтрокаУсловий) 
	СтрокаУсловий.ЗначениеУсловияПредставление = ПолучитьПредставлениеЗначенияУсловия(СтрокаУсловий.ЗначениеУсловияЧитаемое);
КонецФункции

&НаКлиенте
Процедура ПослеВводаЗначения(ВыбЗначение,Параметры) Экспорт
	
	ТекДанные = Объект.УсловияРегистрацииСобытия.НайтиПоИдентификатору(Параметры.УИстроки);
	
	Если ТекДанные <> Неопределено И ВыбЗначение <> Неопределено Тогда
		ТекДанные.ЗначениеУсловияЧитаемое = ВыбЗначение;
		ОбновитьПредставлениеЗначенияВУсловиях(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИмяТаблицыПолучателя(ВидПолучателя)
	
	Если ЗначениеЗаполнено(ВидПолучателя) Тогда
		Возврат ВидПолучателя.ТаблицаПолучателя;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МожноИспользоватьДляАнализаПредыдущиеЗначения(Объект)
	
	Если Объект.СпособОтслеживанияСобытия <> ПредопределенноеЗначение("Перечисление.упоСпособыОтслеживанияСобытий.ПриЗаписиОбъекта") Тогда
		Возврат Ложь;
	КонецЕсли;
	                                     	
	МассивПравильных = Новый Массив;	
	МассивПравильных.Добавить(ПредопределенноеЗначение("Перечисление.упоВариантыИзмененияОбъектов.ЗаписьОбъекта"));
	МассивПравильных.Добавить(ПредопределенноеЗначение("Перечисление.упоВариантыИзмененияОбъектов.ЗаписьСуществующегоОбъекта"));
	МассивПравильных.Добавить(ПредопределенноеЗначение("Перечисление.упоВариантыИзмененияОбъектов.Перепроведение"));
	МассивПравильных.Добавить(ПредопределенноеЗначение("Перечисление.упоВариантыИзмененияОбъектов.Проведение"));
	
	Если МассивПравильных.Найти(Объект.ВариантИзмененияОбъекта) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруПараметровСтрокиТэгов(СтрокаТэгов) 
	
	Пар = Новый Структура;
	
	Пар.Вставить("Условие", СтрокаТэгов.Условие);
	Пар.Вставить("ТипТэга", СтрокаТэгов.ТипТэга);		
	Пар.Вставить("Представление", СтрокаТэгов.Представление);	
	Пар.Вставить("Значение", СтрокаТэгов.Значение);		
	Пар.Вставить("Идентификатор", СтрокаТэгов.ПолучитьИдентификатор());
	
	Если ТипЗнч(СтрокаТэгов.УсловиеЧитаемое) = Тип("Структура") Тогда
		Пар.Вставить("ДопРеквЗначениеУсловия", СтрокаТэгов.УсловиеЧитаемое.ДопРеквЗначениеУсловия);
		Пар.Вставить("ДопРеквИмяТаблицы", СтрокаТэгов.УсловиеЧитаемое.ДопРеквИмяТаблицы);
		Пар.Вставить("ДопРеквПолеЗначения", СтрокаТэгов.УсловиеЧитаемое.ДопРеквПолеЗначения);
		Пар.Вставить("ДопРеквПолеСвязи", СтрокаТэгов.УсловиеЧитаемое.ДопРеквПолеСвязи);
		Пар.Вставить("ДопРеквПолеУсловия", СтрокаТэгов.УсловиеЧитаемое.ДопРеквПолеУсловия);		
	КонецЕсли;
	
	Возврат Пар;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПолеНужнаДополнительнаяНастройкаДляТраспорта()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	упоТранспортОповещений.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.упоТранспортОповещений КАК упоТранспортОповещений
	               |ГДЕ
	               |	упоТранспортОповещений.ДоступнаНастройкаДляВидаСобытия";
	
	МассивДоступнаНастройкаДляВидаСобытия = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Для Каждого СтрокаТранспорта Из Объект.ТранспортОповещений Цикл
		СтрокаТранспорта.НужнаДополнительнаяНастройка = МассивДоступнаНастройкаДляВидаСобытия.Найти(СтрокаТранспорта.Транспорт) <> Неопределено; 
		Если СтрокаТранспорта.НужнаДополнительнаяНастройка Тогда
			СтрокаТранспорта.Настройка = НСтр("ru = 'Двойной клик'");		
		Иначе
			СтрокаТранспорта.Настройка = "";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОтобразитьПредупреждениеИспользованияРегистров(ВариантИзмененияОбъекта, Элемент)
	
	Если ВариантИзмененияОбъекта =
		ПредопределенноеЗначение("Перечисление.упоВариантыИзмененияОбъектов.ЗаписьВРегистр") Тогда
		Элемент.Видимость = Истина;
	Иначе
		Элемент.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

