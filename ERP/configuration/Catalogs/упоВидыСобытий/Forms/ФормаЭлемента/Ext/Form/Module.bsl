&НаКлиенте
Процедура НастроитьРасписаниеВыполнить()

	Если РасписаниеДетектора = Неопределено Тогда
		РасписаниеДетектора = упоОповещенияВызовСервера.РасписаниеПоУмолчанию();
	КонецЕсли;
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(РасписаниеДетектора);
	Диалог.Показать(Новый ОписаниеОповещения("ОткрытьРасписаниеЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаименование(Команда)
	Объект.Наименование = СгенерироватьНаименование();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКодДетектора(Команда)
	
	ОчиститьСообщения();
	
	ТекстУспешногоЗавершения = "";
	Если упоОповещенияВызовСервера.ПроверитьКод(Объект.ДетекторСобытия, ТекстУспешногоЗавершения) Тогда
		
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.УстановитьТекст(ТекстУспешногоЗавершения);
		ТекстовыйДокумент.Показать(НСтр("ru = 'Результат выполнения выражения на встроенном языке'"));
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПодсказкуДетектора(Команда)
	ПодсказкаДетектораОтжата = НЕ ПодсказкаДетектораОтжата;
	Элементы.ПоказатьПодсказкуДетектора.Пометка = НЕ ПодсказкаДетектораОтжата;
	Элементы.ГруппаПодсказкаДетоктора.Видимость = НЕ ПодсказкаДетектораОтжата;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьРасписаниеЗавершение(НовоеРасписание, Неопределен) Экспорт

	Если НовоеРасписание <> Неопределено Тогда
		РасписаниеДетектора = НовоеРасписание;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СгенерироватьНаименование() 
	Возврат Объект.Источник + ",  " + Объект.ВариантИзмененияОбъекта;	
КонецФункции

&НаКлиенте
Функция СформироватьНаименованиеЕслиПустое() 
	Если ЗначениеЗаполнено(Объект.Источник) И ЗначениеЗаполнено(Объект.ВариантИзмененияОбъекта) И НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = СгенерироватьНаименование();
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностью(Форма)
	
	Элементы = Форма.Элементы;
	
	Если Форма.Объект.СпособОтслеживанияСобытия = ПредопределенноеЗначение("Перечисление.упоСпособыОтслеживанияСобытий.ПриЗаписиОбъекта") Тогда
		Элементы.ВариантИзмененияОбъекта.Видимость = Истина;
		Элементы.СформироватьНаименование.Видимость = Истина;
		Элементы.СтраницаДетектор.Видимость = Ложь;
		Элементы.НастроитьРасписание.Видимость = Ложь;
	ИначеЕсли Форма.Объект.СпособОтслеживанияСобытия = ПредопределенноеЗначение("Перечисление.упоСпособыОтслеживанияСобытий.ПоРасписанию") Тогда
		Элементы.ВариантИзмененияОбъекта.Видимость = Ложь;
		Элементы.СформироватьНаименование.Видимость = Ложь;
		Элементы.СтраницаДетектор.Видимость = Истина;
		Элементы.НастроитьРасписание.Видимость = Истина;
	Иначе
		Элементы.ВариантИзмененияОбъекта.Видимость = Ложь;
		Элементы.СформироватьНаименование.Видимость = Ложь;
		Элементы.СтраницаДетектор.Видимость = Ложь;
		Элементы.НастроитьРасписание.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаТема.Видимость = Форма.ДоступнаТемаСообщения;
	
	Если Форма.ДоступенТекстСообщенияВHTML Тогда
		Элементы.ТипТекстаПисьма.Видимость = Истина;
		Если Форма.ТипТекстаПисьма = 0 Тогда
			Элементы.СтраницыТекстПисьма.ТекущаяСтраница = Элементы.СтраницаТекстПисьмаHTML;
		Иначе
			Элементы.СтраницыТекстПисьма.ТекущаяСтраница = Элементы.СтраницаТекстПисьмаОбычный;
		КонецЕсли;
	Иначе
		Элементы.ТипТекстаПисьма.Видимость = Ложь;
		Элементы.СтраницыТекстПисьма.ТекущаяСтраница = Форма.Элементы.СтраницаТекстПисьмаОбычный;
	КонецЕсли;
	
	ДоступностьЭлемента = ЗначениеЗаполнено(Форма.Объект.Источник);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
		"ГруппаУсловияИсточника", "Доступность", ДоступностьЭлемента);
	
	ВидимостьЭлемента = МожноИспользоватьДляАнализаПредыдущиеЗначения(Форма.Объект);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
		"ИспользоватьДляАнализаПредыдущиеЗначения", "Видимость", ВидимостьЭлемента);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьОформление(ЭтаФорма)    
	Если ЭтаФорма.Объект.Используется Тогда
		//ЦветФона = WebЦвета.Роса;
		ЦветФона = Новый Цвет;
	Иначе
		ЦветФона = WebЦвета.ТусклоРозовый;
	КонецЕсли;
	ЭтаФорма.Элементы.ГруппаОбщая.ЦветФона = ЦветФона; 	
КонецФункции

&НаСервере
Функция ОпределитьВариантыИзмененияОбъекта() 
	
	Элементы.ВариантИзмененияОбъекта.СписокВыбора.Очистить();
	Элементы.ВариантИзмененияОбъекта.РежимВыбораИзСписка = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Источник) Тогда
		
		ИменаТаблиц = упоОповещенияВызовСервера.РазобратьИмяТаблицы(Объект.Источник);		
		ВидТаблицы = ИменаТаблиц.ВидТаблицы;
		
		// Закомментировано отображение регистров для дальнейшей доработки.
		//Если Найти(ВидТаблицы, "Регистр") <> 0 Тогда
		//	Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьВРегистр);	
		Если Найти(ВидТаблицы, "Справочник") <> 0 ИЛИ Найти(ВидТаблицы, "План") <> 0 ИЛИ Найти(ВидТаблицы, "Задача") <> 0  ИЛИ Найти(ВидТаблицы, "БизнесПроцесс") <> 0 Тогда
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьНовогоОбъекта);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьОбъекта);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьСуществующегоОбъекта);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ПометкаОбъектаНаУдаление);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.СнятиеПометкиНаУдалениеСОбъекта);	
		ИначеЕсли Найти(ВидТаблицы, "Документ") <> 0 Тогда
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьНовогоОбъекта);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьОбъекта);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ЗаписьСуществующегоОбъекта);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ПометкаОбъектаНаУдаление);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.СнятиеПометкиНаУдалениеСОбъекта);	
			
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ПроведениеНового);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.Проведение);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.Перепроведение);	
			Элементы.ВариантИзмененияОбъекта.СписокВыбора.Добавить(Перечисления.упоВариантыИзмененияОбъектов.ОтменаПроведения);	
		КонецЕсли;		
		
	КонецЕсли;	
	
	Если Элементы.ВариантИзмененияОбъекта.СписокВыбора.Количество() Тогда
		Элементы.ВариантИзмененияОбъекта.РежимВыбораИзСписка = Истина; 
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОпределитьДоступныеТаблицыИсточника()
	
	Элементы.Источник.СписокВыбора.Очистить();
	
	масНужныеТипы = Новый Массив;
	
	Если Объект.СпособОтслеживанияСобытия = Перечисления.упоСпособыОтслеживанияСобытий.ПоРасписанию
		ИЛИ Не ЗначениеЗаполнено(Объект.ВариантИзмененияОбъекта) Тогда
		
		масНужныеТипы.Добавить("Справочники");
		масНужныеТипы.Добавить("Документы");
		масНужныеТипы.Добавить("ПланыВидовХарактеристик");
		масНужныеТипы.Добавить("Задачи");
		масНужныеТипы.Добавить("БизнесПроцессы");
		// Закомментировано отображение регистров для дальнейшей доработки.
		//масНужныеТипы.Добавить("РегистрыСведений");
		//масНужныеТипы.Добавить("РегистрыНакопления");
		//масНужныеТипы.Добавить("РегистрыБухгалтерии");
		//масНужныеТипы.Добавить("РегистрыРасчета");
		
	ИначеЕсли Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ПроведениеНового
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.Проведение
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.Перепроведение
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ОтменаПроведения Тогда
		
		масНужныеТипы.Добавить("Документы");
		
	ИначеЕсли Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ЗаписьНовогоОбъекта
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ЗаписьОбъекта
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ЗаписьСуществующегоОбъекта
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ПометкаОбъектаНаУдаление
		ИЛИ Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.СнятиеПометкиНаУдалениеСОбъекта Тогда
		
		масНужныеТипы.Добавить("Справочники");
		масНужныеТипы.Добавить("Документы");
		масНужныеТипы.Добавить("ПланыВидовХарактеристик");
		масНужныеТипы.Добавить("Задачи");
		масНужныеТипы.Добавить("БизнесПроцессы");
		
	// Закомментировано отображение регистров для дальнейшей доработки.
	//ИначеЕсли Объект.ВариантИзмененияОбъекта = Перечисления.упоВариантыИзмененияОбъектов.ЗаписьВРегистр Тогда
		//
		//	масНужныеТипы.Добавить("РегистрыСведений");
		//	масНужныеТипы.Добавить("РегистрыНакопления");
		//	масНужныеТипы.Добавить("РегистрыБухгалтерии");
		//	масНужныеТипы.Добавить("РегистрыРасчета");
		
	КонецЕсли;
	
	Пар = Новый Структура("масНужныеТипы", масНужныеТипы);
	Спис = упоОповещенияВызовСервера.ПолучитьСписокДоступныхТаблиц(Пар, Истина);
	
	Для Каждого Эл Из Спис Цикл
		Элементы.Источник.СписокВыбора.Добавить(Эл.Значение, Эл.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыТранспорта(масТранспорт)
	
	ДоступенТекстСообщенияВHTML = Ложь;
	ДоступнаТемаСообщения = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	упоТранспортОповещений.ДоступнаТемаСообщения,
					|	упоТранспортОповещений.ДоступенТекстСообщенияВHTML
					|ИЗ
					|	Справочник.упоТранспортОповещений КАК упоТранспортОповещений
					|ГДЕ
					|	упоТранспортОповещений.Ссылка В (&масТранспорт)";
	Запрос.УстановитьПараметр("масТранспорт",масТранспорт);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ДоступенТекстСообщенияВHTML Тогда
			ДоступенТекстСообщенияВHTML = Истина;
		КонецЕсли;
		Если Выборка.ДоступнаТемаСообщения Тогда
			ДоступнаТемаСообщения = Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Новый Структура("ДоступенТекстСообщенияВHTML, ДоступнаТемаСообщения",
		ДоступенТекстСообщенияВHTML, ДоступнаТемаСообщения);
	
КонецФункции

