&НаКлиенте
Процедура УсловияРегистрацииСобытияВидСравненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.УсловияРегистрацииСобытия.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокВидовСравнений = упоОповещенияВызовСервера.ПолучитьСписокДоступныхВидовСравненийДляРеквизита(ТекДанные.РеквизитОбъекта,Объект.Источник);
	ДанныеВыбора = Новый СписокЗначений;
	Для Каждого Эл Из СписокВидовСравнений Цикл
		ДанныеВыбора.Добавить(Эл.Значение,Эл.Представление);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияРегистрацииСобытияЗначениеУсловияПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.УсловияРегистрацииСобытия.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизитаИсточника(ТекДанные.РеквизитОбъекта,Объект.Источник);
	ВидСравненияИнтервал = ПредопределенноеЗначение("Перечисление.упоВидыСравнения.Интервал");
	ВидСравненияИнтервалВклГр = ПредопределенноеЗначение("Перечисление.упоВидыСравнения.ИнтервалВключаяГраницы");
	ВидСравненияВСписке = ПредопределенноеЗначение("Перечисление.упоВидыСравнения.ВСписке");
	ВидСравненияВСпискеПоИерархии = ПредопределенноеЗначение("Перечисление.упоВидыСравнения.ВСпискеПоИерархии");
	ВидСравненияНеВСписке = ПредопределенноеЗначение("Перечисление.упоВидыСравнения.НеВСписке");
	ВидСравненияНеВСпискеПоИерархии = ПредопределенноеЗначение("Перечисление.упоВидыСравнения.НеВСпискеПоИерархии");
	
	Если ТекДанные.ВидСравнения = ВидСравненияВСписке ИЛИ ТекДанные.ВидСравнения = ВидСравненияВСпискеПоИерархии
		ИЛИ ТекДанные.ВидСравнения = ВидСравненияНеВСписке ИЛИ ТекДанные.ВидСравнения = ВидСравненияНеВСпискеПоИерархии Тогда
		
		Пар = Новый Структура("УИстроки,ПолноеИмяРеквизита,ВыбЗначения",ТекДанные.ПолучитьИдентификатор(),ТекДанные.РеквизитОбъекта,Новый Массив);
		Пар.Вставить("ОписаниеТипаРеквизита",ОписаниеТипаРеквизита);
		Если ТипЗнч(ТекДанные.ЗначениеУсловияЧитаемое) = Тип("СписокЗначений") Тогда
			Пар.Вставить("ВыбЗначения",ТекДанные.ЗначениеУсловияЧитаемое.ВыгрузитьЗначения());	
		КонецЕсли;
		
		ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаПодбораСсылок",Пар,ЭтаФорма);
		
	ИначеЕсли ОписаниеТипаРеквизита.СодержитТип(Тип("Дата")) 
		И (ТекДанные.ВидСравнения = ВидСравненияИнтервал ИЛИ ТекДанные.ВидСравнения = ВидСравненияИнтервалВклГр) Тогда
		
		Пар = Новый Структура("УИстроки,НачалоПериода,КонецПериода",ТекДанные.ПолучитьИдентификатор());
		Если ТипЗнч(ТекДанные.ЗначениеУсловияЧитаемое) = Тип("СписокЗначений") И ТекДанные.ЗначениеУсловияЧитаемое.Количество() = 2 Тогда
			Пар.Вставить("НачалоПериода", ТекДанные.ЗначениеУсловияЧитаемое[0].Значение);
			Пар.Вставить("КонецПериода", ТекДанные.ЗначениеУсловияЧитаемое[1].Значение);
		КонецЕсли;
		
		ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаВводаПериода",Пар,ЭтаФорма);
		
	ИначеЕсли ОписаниеТипаРеквизита <> Неопределено Тогда
		
		Пар = Новый Структура("УИстроки",ТекДанные.ПолучитьИдентификатор());
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначения",ЭтаФорма, Пар);
		
		ПоказатьВводЗначения(Оповещение,ТекДанные.ЗначениеУсловияЧитаемое,"Введите значение условия",ОписаниеТипаРеквизита);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УсловияРегистрацииСобытияВыполняемыйКодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.УсловияРегистрацииСобытия.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Подсказка = НСтр("ru = '
	|// Доступные переменные:	""Источник"" - объект, связанный с событием
	|//							""ИсточникДопПараметр"" - дополнительный параметр источника
	|//							""ПараметрыВозврата"" - структура
	|//							""ДанныеДоИзменения"" - структура или Неопределено 	
	|//							""ПараметрыВыполненияКода"" - структура, сгенерированная на основании таблицы ""Параметры выполняемого кода"" 	
	|//							""Результат"" - булевая переменная. Если в ней возвращается Истина, то условие выполнено
	|//'");
	
	Пар = Новый Структура;
	Пар.Вставить("УИстроки", ТекДанные.ПолучитьИдентификатор());
	Пар.Вставить("ВыполняемыйКод", ТекДанные.ВыполняемыйКод);
	Пар.Вставить("Источник", Объект.Источник);
	Пар.Вставить("Подсказка", Подсказка);
	Пар.Вставить("ЗаголовокФормы", НСтр("ru = 'Выполняемый код (Условие регистрации события)'"));
	
	ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаРедактированияКода",Пар,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипТекстаПисьмаПриИзменении(Элемент)
	УправлениеДоступностью(ЭтаФорма);	
КонецПроцедуры

&НаКлиенте
Процедура ТэгиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Пар = Новый Структура;
	Пар.Вставить("Источник", Объект.Источник);
	
	Если Копирование Тогда
			
		ТекДанные = Элементы.Тэги.ТекущиеДанные;
		
		Если ТекДанные <> Неопределено Тогда
			
			ПараметрыСтроки = ПолучитьСтруктуруПараметровСтрокиТэгов(ТекДанные);
			ПараметрыСтроки.Представление = ПараметрыСтроки.Представление + НСтр("ru = '.Копия'"); 
			ПараметрыСтроки.Удалить("Идентификатор");
			
			Для Каждого КлючЗначение Из ПараметрыСтроки Цикл  
				
				Пар.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);	
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаТэга", Пар, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТэгиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Истина;	
	
	ТекДанные = Объект.Тэги.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПараметрыСтроки = ПолучитьСтруктуруПараметровСтрокиТэгов(ТекДанные);
	ПараметрыСтроки.Вставить("Источник", Объект.Источник);
		
	ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаТэга", ПараметрыСтроки, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТэгиНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Если ПараметрыПеретаскивания.Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТега = Объект.Тэги.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение[0]);
	ПараметрыПеретаскивания.Значение = "["+ СтрокаТега.Представление+"]";
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонТемыПриИзменении(Элемент)
	Объект.ШаблонТемы = СокрЛП(ТемаПисьмаФорматированныйДокумент.ПолучитьТекст());
КонецПроцедуры

&НаКлиенте
Процедура ПолучателиПолучательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Получатели.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.ВидПолучателя) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТаблицы = ПолучитьИмяТаблицыПолучателя(ТекДанные.ВидПолучателя);
	
	ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизита(ИмяТаблицы,"Ссылка");
	Если ОписаниеТипаРеквизита <> Неопределено Тогда
		Элементы.ПолучателиПолучатель.ОграничениеТипа = ОписаниеТипаРеквизита;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучателиДопУсловиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Получатели.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Подсказка = НСтр("ru = '
	|// Доступные переменные:	
	|// 						""Источник"" - объект, связанный с событием
	|// 						""ИсточникДопПараметр"" - дополнительный параметр источника	
	|// 						""МасПолучатели"" - массив получателей, можно задать новый, вместо найденного системой
	|// 						""ПараметрыВыполненияКода"" - структура, сгенерированная на основании таблицы ""Параметры выполняемого кода""	
	|// 						""Результат"" - булевая переменная. Если в ней возвращается Истина, то условие выполнено
	|//'");							
	
	Пар = Новый Структура;
	Пар.Вставить("ИмяТабЧасти", "Получатели");
	Пар.Вставить("УИстроки", ТекДанные.ПолучитьИдентификатор());
	Пар.Вставить("ВыполняемыйКод", ТекДанные.ДопУсловие);
	Пар.Вставить("Источник", Объект.Источник);
	Пар.Вставить("Подсказка", Подсказка);
	Пар.Вставить("ЗаголовокФормы", НСтр("ru = 'Выполняемый код (Доп. условие получателя)'"));
	
	ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаРедактированияКода", Пар, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КодОпределенияДопПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Подсказка = НСтр("ru = '
	|// Доп. параметр источника служит как дополнительное измерение для регистрации событий. 
	|// Т.е. по одному объекту можно зарегистрировать несколько событий в зависимости от значений этого параметра.
	|// Например, документ: ""Назначение трудовых ресурсов на проектную задачу"" и значения параметра ""Овечкин А.И."" и ""Петров З.К""
	|// Доступные переменные:	
	|//							""ИсточникДопПараметр"" - в него нужно записать ""Неопределено"", ""Любая ссылка"", ""Число"", ""Строка"", ""Дата"" 
	|//							или массив этих значений. В случае массива будет зарегистрировано столько событий, сколько элементов в массиве.
	|//							""Источник"" - объект, связанный с событием.
	|//							""ПараметрыВыполненияКода"" - структура, сгенерированная на основании таблицы ""Параметры выполняемого кода"". 	
	|//'");
	
	Пар = Новый Структура;
	
	Пар.Вставить("ИмяТабЧасти", "КодОпределенияДопПараметра");
	Пар.Вставить("ВыполняемыйКод", Объект.КодОпределенияДопПараметра);
	Пар.Вставить("Источник", Объект.Источник);
	Пар.Вставить("Подсказка", Подсказка);
	Пар.Вставить("ЗаголовокФормы", НСтр("ru = 'Выполняемый код (Определение доп. параметров источника)'"));
	
	ОткрытьФорму("Справочник.упоВидыСобытий.Форма.ФормаРедактированияКода", Пар, ЭтаФорма);

КонецПроцедуры

#КонецОбласти

