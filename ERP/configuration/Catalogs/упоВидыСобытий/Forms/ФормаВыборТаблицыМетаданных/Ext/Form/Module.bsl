#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура дзТаблицыМДВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Выбрать(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	текДанные = Элементы.дзТаблицыМД.ТекущиеДанные;
	Если текДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = текДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат;
	Иначе
		ТипТаблицы = Родитель.Представление;	
	КонецЕсли;
	
	Пар = Новый Структура("ИмяТаблицы,ПредставлениеТаблицы,УИстроки",текДанные.ИмяТаблицы,ТипТаблицы+"."+текДанные.Представление,УИстроки);
	
	ОповеститьОВыборе(Пар);
	
КонецПроцедуры

#КонецОбласти
