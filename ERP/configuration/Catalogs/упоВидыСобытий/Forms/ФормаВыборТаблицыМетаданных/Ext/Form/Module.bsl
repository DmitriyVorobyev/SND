
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
				
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, , Отказ, СтандартнаяОбработка); 		
		
	Параметры.Свойство("УИстроки", УИстроки);
	Параметры.Свойство("ИмяТаблицы", ИмяТаблицы);
	Параметры.Свойство("сРеквизитами", сРеквизитами);
	
	масНужныеТипы = Неопределено;
	Параметры.Свойство("масНужныеТипы", масНужныеТипы);
	
	масНужныеТаблицы = Неопределено;
	Параметры.Свойство("масНужныеТаблицы", масНужныеТаблицы);
	
	масТаблицыИсключения = Неопределено;
	Параметры.Свойство("масТаблицыИсключения", масТаблицыИсключения);
	
	Пар = Новый Структура;
	Пар.Вставить("масНужныеТипы", масНужныеТипы);
	Пар.Вставить("масНужныеТаблицы", масНужныеТаблицы);
	Пар.Вставить("масТаблицыИсключения", масТаблицыИсключения);
	Пар.Вставить("СокрПредставление", Истина);
	
	СписТаблиц = упоОповещенияВызовСервера.ПолучитьСписокДоступныхТаблиц(Пар);
	
	ТекущаяСтрока = Неопределено;
	ПредТип = "";
	КолТипы = дзТаблицыМД.ПолучитьЭлементы();
	счТипов = 0;
	Для Каждого Эл Из СписТаблиц Цикл
		
		ТекИмя = Эл.Значение;
		ТекПредставление = Эл.Представление;
		Поз = Найти(ТекИмя,".");
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекТип = Лев(ТекИмя,Поз-1);
		Если ТекТип <> ПредТип Тогда
			новЭл = КолТипы.Добавить();
			новЭл.ИмяТаблицы = ТекТип;
			новЭл.Представление = ТекТип;
			новЭл.КодКартинки = 0;
			КолТаблицы = новЭл.ПолучитьЭлементы();
			счТипов = счТипов + 1;
		КонецЕсли;
		
		ПредТип = ТекТип;
		
		новЭл = КолТаблицы.Добавить();
		новЭл.ИмяТаблицы = ТекИмя;
		новЭл.Представление = ТекПредставление;	
		новЭл.КодКартинки = 1;
		Если ИмяТаблицы = текИмя Тогда
			ТекущаяСтрока = новЭл.ПолучитьИдентификатор();	
		КонецЕсли;
		
		Если сРеквизитами Тогда
			КолРеквизиты = новЭл.ПолучитьЭлементы();
			НовЭл = КолРеквизиты.Добавить();
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		Элементы.дзТаблицыМД.ТекущаяСтрока = ТекущаяСтрока;	
	КонецЕсли;
	
	Если сРеквизитами Тогда
		ЭтаФорма.Заголовок = НСтр("ru = 'Выбор реквизита таблицы метаданных'");	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма);
	
	Если счТипов = 1 Тогда
		КолТипы = дзТаблицыМД.ПолучитьЭлементы();
		Для Каждого Эл Из КолТипы Цикл
			Элементы.дзТаблицыМД.Развернуть(Эл.ПолучитьИдентификатор());	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

