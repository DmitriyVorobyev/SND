
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
				
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, , Отказ, СтандартнаяОбработка); 		
	
	Параметры.Свойство("ВидСобытия",ВидСобытия);
	Параметры.Свойство("Источник",Источник);
	
	масВидыПолучателей = Неопределено;
	Параметры.Свойство("масВидыПолучателей",масВидыПолучателей);
	Если ТипЗнч(масВидыПолучателей) = Тип("Массив") Тогда
		Для Каждого Эл Из масВидыПолучателей Цикл
			Элементы.ВидПолучателя.СписокВыбора.Добавить(Эл);	
		КонецЦикла;
		Если масВидыПолучателей.Количество() = 1 Тогда
			ВидПолучателя = масВидыПолучателей[0];
			УстановитьТипПолучателя();
		КонецЕсли;
	КонецЕсли;
	
	масТранспорт = Неопределено;
	Параметры.Свойство("масТранспорт",масТранспорт);
	Если ТипЗнч(масТранспорт) = Тип("Массив") Тогда
		Для Каждого Эл Из масТранспорт Цикл
			Элементы.Транспорт.СписокВыбора.Добавить(Эл);	
		КонецЦикла;
		Если масТранспорт.Количество() = 1 Тогда
			Транспорт = масТранспорт[0];
		КонецЕсли;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Источник) Тогда
		ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизита(Источник,"Ссылка");
		Если ОписаниеТипаРеквизита <> Неопределено Тогда 
			Элементы.ИсточникСсылка.ОграничениеТипа = ОписаниеТипаРеквизита;
			упоОповещенияВызовСервера.ДобавитьПараметрыВыбораПроектныхЗадачИПроекта(Источник, Элементы.ИсточникСсылка);			
		КонецЕсли;		
	КонецЕсли;
	
	НедоступныеТранспортыПроверкаИТС =
		упоОповещенияВызовСервера.НедоступныеТранспортыОтправкиОповещенийПроверкаИТС();
	ЭтотОбъект.НедоступныеТранспортыОтправкиОповещений.ЗагрузитьЗначения(НедоступныеТранспортыПроверкаИТС);
	
	ВосстановитьПараметры();
		
КонецПроцедуры

