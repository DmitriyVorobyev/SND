#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьСообщение(Команда)
	
	НайденноеЗначение = НедоступныеТранспортыОтправкиОповещений.НайтиПоЗначению(Транспорт);
	Если НайденноеЗначение <> Неопределено Тогда
		ШаблонСообщения = НСтр("ru = 'Отправка оповещений через транспорт ""%1"" доступна только при наличии активной подписки ИТС.'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Строка(НайденноеЗначение));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("СообщениеОбОшибках, Отправить", "", Истина);
	РезОтправки = упоОповещенияВызовСервера.ДобавитьСообщение(
		ВидСобытия, ИсточникСсылка, ИсточникДопПараметр, ВидПолучателя, Получатель, Транспорт, ДопПараметры);
		
	Если Не ПустаяСтрока(ДопПараметры.СообщениеОбОшибках) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = '" + ДопПараметры.СообщениеОбОшибках + "'");
		Сообщение.Сообщить();
	КонецЕсли;
	
	Если РезОтправки <> Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Сообщение было успешно отправлено.'");
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСообщениеВОчередь(Команда)
	
	НайденноеЗначение = НедоступныеТранспортыОтправкиОповещений.НайтиПоЗначению(Транспорт);
	Если НайденноеЗначение <> Неопределено Тогда
		ШаблонСообщения = НСтр("ru = 'Отправка оповещений через транспорт ""%1"" доступна только при наличии активной подписки ИТС.'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Строка(НайденноеЗначение));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("СообщениеОбОшибках, Отправить", "", Ложь);
	РезОтправки = упоОповещенияВызовСервера.ДобавитьСообщение(
		ВидСобытия, ИсточникСсылка, ИсточникДопПараметр, ВидПолучателя, Получатель, Транспорт, ДопПараметры);
	
	Если Не ПустаяСтрока(ДопПараметры.СообщениеОбОшибках) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = '" + ДопПараметры.СообщениеОбОшибках + "'");
		Сообщение.Сообщить();
	КонецЕсли;
	
	Если РезОтправки <> Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Сообщение было успешно добавлено в очередь.'");
		Сообщение.Сообщить();		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьСтруктуруНастроек(ЭтаФорма) 
	
	Пар = Новый Структура;
	Пар.Вставить("ВидСобытия",ЭтаФорма.ВидСобытия);
	Пар.Вставить("ИсточникСсылка",ЭтаФорма.ИсточникСсылка);
	Пар.Вставить("ИсточникДопПараметр",ЭтаФорма.ИсточникДопПараметр);
	Пар.Вставить("ВидПолучателя",ЭтаФорма.ВидПолучателя);
	Пар.Вставить("Получатель",ЭтаФорма.Получатель);
	Пар.Вставить("Транспорт",ЭтаФорма.Транспорт);
	
	Возврат Пар;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СохранитьПараметры(ЭтаФорма)
	
	Настройки = ПодготовитьСтруктуруНастроек(ЭтаФорма);	
	СохранитьВХранилище(Настройки);	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СохранитьВХранилище(Настройки) 
	
	Если ЗначениеЗаполнено(Настройки.ВидСобытия) Тогда
		Ключ = ""+Настройки.ВидСобытия.УникальныйИдентификатор();
	Иначе
		Ключ = "";
	КонецЕсли;
	
	ХранилищеОбщихНастроек.Сохранить("ФормаТестаОтправкиСообщения", Ключ, Настройки);
	
КонецФункции

&НаСервере
Процедура ВосстановитьПараметры()
	
	Если ЗначениеЗаполнено(ВидСобытия) Тогда
		Ключ = ""+ВидСобытия.УникальныйИдентификатор();
	Иначе
		Ключ = "";
	КонецЕсли;
	
	Пар = ХранилищеОбщихНастроек.Загрузить("ФормаТестаОтправкиСообщения", Ключ);

	Если Пар = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсточникСсылка) И ВидСобытия = Пар.ВидСобытия Тогда
		//ИсточникСсылка = Пар.ИсточникСсылка;
		Пар.Свойство("ИсточникСсылка", ИсточникСсылка);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсточникДопПараметр) И ВидСобытия = Пар.ВидСобытия Тогда
		//ИсточникСсылка = Пар.ИсточникСсылка;
		Пар.Свойство("ИсточникДопПараметр", ИсточникДопПараметр);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидПолучателя) И ВидСобытия = Пар.ВидСобытия Тогда
		//ВидПолучателя = Пар.ВидПолучателя;
		Пар.Свойство("ВидПолучателя", ВидПолучателя);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Получатель) И ВидСобытия = Пар.ВидСобытия И ВидПолучателя = Пар.ВидПолучателя Тогда
		//Получатель = Пар.Получатель;
		Пар.Свойство("Получатель", Получатель);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Транспорт) И ВидСобытия = Пар.ВидСобытия И ВидПолучателя = Пар.ВидПолучателя Тогда
		Пар.Свойство("Транспорт", Транспорт);
		//Транспорт = Пар.Транспорт;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТипПолучателя()
	
	ИмяТаблицы = ВидПолучателя.ТаблицаПолучателя;
	ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизита(ИмяТаблицы,"Ссылка");
	Если ОписаниеТипаРеквизита <> Неопределено Тогда
		Элементы.Получатель.ОграничениеТипа = ОписаниеТипаРеквизита;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
