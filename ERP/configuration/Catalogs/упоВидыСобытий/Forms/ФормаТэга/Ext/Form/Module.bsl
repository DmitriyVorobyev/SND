КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора); 
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаВыборТаблицыМетаданных" Тогда
		
		Если ВыбранноеЗначение.УИстроки = 1 Тогда
			ДопРеквИмяТаблицы = ВыбранноеЗначение.ИмяТаблицы;
			ПредставлениеТаблицы = ВыбранноеЗначение.ПредставлениеТаблицы;
			ДопРеквПолеЗначения = "";
			ДопРеквПолеСвязи = "";
			ДопРеквПолеУсловия = "";
			ДопРеквЗначениеУсловия = Неопределено;
			ЗаполнитьСпискиВыбораДопРекв();
			СформироватьПредставление();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

