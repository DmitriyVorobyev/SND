
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, , Отказ, СтандартнаяОбработка);           
	
	ТипТэгаВыполняемыйКод = Перечисления.упоТипыТегов.ВыполняемыйКод;
	ТипТэгаКонстанта = Перечисления.упоТипыТегов.Константа;
	ТипТэгаРеквизитОбъекта = Перечисления.упоТипыТегов.РеквизитОбъекта;
	ТипТэгаВычисляемыйРеквизит = Перечисления.упоТипыТегов.ВычисляемыйРеквизит;
	ТипТэгаДопРеквизитОбъекта = Перечисления.упоТипыТегов.ДопРеквизитОбъекта;
	
	Если ЗначениеЗаполнено(Параметры.Источник) Тогда
		
		ИмяТаблицы = Параметры.Источник;
		Элементы.ИмяТаблицы.ТолькоПросмотр = Истина;
		
		Элементы.ИмяТаблицы.СписокВыбора.Очистить();
		Спис = упоОповещенияВызовСервера.ПолучитьСписокДоступныхТаблиц();
		Для Каждого Эл Из Спис Цикл
			Элементы.ИмяТаблицы.СписокВыбора.Добавить(Эл.Значение,Эл.Представление);
		КонецЦикла;
		
		ЗаполнитьСписокДоступныхРеквизитов();
		
	КонецЕсли;
	
	Параметры.Свойство("Условие", Условие);
	Параметры.Свойство("ДопРеквЗначениеУсловия", ДопРеквЗначениеУсловия);
	Параметры.Свойство("ДопРеквИмяТаблицы", ДопРеквИмяТаблицы);
	Параметры.Свойство("ДопРеквПолеЗначения", ДопРеквПолеЗначения);
	Параметры.Свойство("ДопРеквПолеСвязи", ДопРеквПолеСвязи);
	Параметры.Свойство("ДопРеквПолеУсловия", ДопРеквПолеУсловия);
	Параметры.Свойство("ТипТэга", ТипТэга);
	Параметры.Свойство("Значение", Значение);
	Параметры.Свойство("Представление", Представление);
	Параметры.Свойство("Идентификатор", Идентификатор);
	
	Если ЗначениеЗаполнено(Условие) Тогда
		Если ТипТэга = ТипТэгаРеквизитОбъекта 
			ИЛИ ТипТэга = ТипТэгаВычисляемыйРеквизит 
			ИЛИ ТипТэга = ПредопределенноеЗначение("Перечисление.упоТипыТегов.НавигационнаяСсылка") Тогда
			ИмяРеквизита = Условие;
			Поз = Найти(ИмяРеквизита,".");
			Пока Поз > 0 Цикл
				ИмяРеквизита = Сред(ИмяРеквизита,Поз+1);  		
				Поз = Найти(ИмяРеквизита,".");
			КонецЦикла;
		ИначеЕсли ТипТэга = ТипТэгаКонстанта Тогда
			ИмяРеквизита = Условие;
		ИначеЕсли ТипТэга = ТипТэгаВыполняемыйКод Тогда
			ВыполняемыйКод = Условие;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипТэга = ТипТэгаДопРеквизитОбъекта Тогда
		Если Не ПустаяСтрока(ДопРеквИмяТаблицы) Тогда
			ИмяРеквизита = ДопРеквИмяТаблицы + "." + ДопРеквПолеЗначения; 
		КонецЕсли;
		ЗаполнитьСвязанныеТаблицы(ИмяТаблицы);	
		Если ЗначениеЗаполнено(ДопРеквИмяТаблицы) Тогда
			ЗаполнитьСпискиВыбораДопРекв();
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
		
		ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизита(ИмяТаблицы,"Ссылка");
		
		Если ОписаниеТипаРеквизита <> Неопределено Тогда
			Элементы.ИсточникСсылка.ОграничениеТипа = ОписаниеТипаРеквизита;
		КонецЕсли;
		
	Иначе
		Элементы.ИсточникСсылка.Видимость = Ложь;	
	КонецЕсли;
	
	Если ПустаяСтрока(ВыполняемыйКод) Тогда
		
		ВыполняемыйКод = НСтр("ru = '// Доступные переменные:	
		|//							""Источник"" - объект, связанный с событием
		|//							""ИсточникДопПараметр"" - дополнительный параметр источника 
		|//							""ПараметрыВозврата"" - структура
		|//							""Результат"" - переменная, в которой возвращается результат вычисления тэга
		|//											так же возможно вернуть туда структуру с ключами: ""Текст"" и ""HTML""
		|// Примеры:
		|//	1. Результат = Источник.СсылкаНаПроектнуюЗадачу.КрайнийСрок
		|//	2. Результат = Новый Структура(""Текст, HTML"", Источник.СсылкаНаПроектнуюЗадачу.КрайнийСрок, 
		|//	""<a href=>""+Источник.СсылкаНаПроектнуюЗадачу.КрайнийСрок+""</a>"")
		|'");	
		
	КонецЕсли;
	
	Инициализировать();
	
КонецПроцедуры

