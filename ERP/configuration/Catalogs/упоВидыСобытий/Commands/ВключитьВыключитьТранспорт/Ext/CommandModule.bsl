
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	Транспорты = ПолучитьТранспортВидаСобытия(ПараметрКоманды);
	ОписаниеОвещения = Новый ОписаниеОповещения("ЗакрытиеВыбораТранспортов", ЭтотОбъект, ПараметрКоманды);
	Транспорты.ПоказатьОтметкуЭлементов(ОписаниеОвещения, НСтр("ru = 'Отметьте используемые транспорты'"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗакрытиеВыбораТранспортов(Список, Событие)
	Если НЕ Список = Неопределено Тогда
		ЗаписатьИзмененияТранспортаСобытия(Список, Событие);
		Оповестить("упоОбновленоСостояниеВидаОповещения", Событие);
	КонецЕсли;
КонецФункции
			
&НаСервере
Функция ЗаписатьИзмененияТранспортаСобытия(Список, Событие)
	обСобытие = Событие.ПолучитьОбъект();	
	обСобытие.ТранспортОповещений.Очистить();
	Для Каждого Элемент Из Список Цикл
		СтрокаТранспорта = обСобытие.ТранспортОповещений.Добавить();
		СтрокаТранспорта.Используется = Элемент.Пометка;
		СтрокаТранспорта.Транспорт = Элемент.Значение;
	КонецЦикла;
	обСобытие.ДополнительныеСвойства.Вставить("ОбновлениеТиповыхОповещений", Истина);
	обСобытие.Записать();	
КонецФункции

&НаСервере
Функция ПолучитьТранспортВидаСобытия(Событие)
	Результат = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоВидыСобытийТранспортОповещений.Используется КАК Используется,
	               |	упоВидыСобытийТранспортОповещений.Транспорт КАК Транспорт
	               |ПОМЕСТИТЬ ТранспортСобытия
	               |ИЗ
	               |	Справочник.упоВидыСобытий.ТранспортОповещений КАК упоВидыСобытийТранспортОповещений
	               |ГДЕ
	               |	упоВидыСобытийТранспортОповещений.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕСТЬNULL(ТранспортСобытия.Используется, ЛОЖЬ) КАК Используется,
	               |	упоТранспортОповещений.Ссылка КАК Транспорт
	               |ИЗ
	               |	Справочник.упоТранспортОповещений КАК упоТранспортОповещений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТранспортСобытия КАК ТранспортСобытия
	               |		ПО (ТранспортСобытия.Транспорт = упоТранспортОповещений.Ссылка)
	               |ГДЕ
	               |	НЕ упоТранспортОповещений.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Событие);				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Транспорт,,Выборка.Используется);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти