&НаКлиенте
Процедура ПроверитьТаблицу(ИмяТаблицы, СписокПроверяемыхКолонок) 
	
	Успешно = ПроверитьТаблицуНаСервере(ИмяТаблицы, СписокПроверяемыхКолонок);
	
	Если Успешно Тогда		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Нстр("ru = 'Ошибок не обнаружено.'");
		Сообщение.Сообщить();
	КонецЕсли;
	
