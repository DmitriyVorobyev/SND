&НаКлиенте
Процедура ПроверитьТаблицуРаспределения(Команда)
	
	СписокПроверяемыхКолонок = Новый СписокЗначений;
	СписокПроверяемыхКолонок.Добавить("Трудозатраты", "трудозатрат", Истина);
	СписокПроверяемыхКолонок.Добавить("Загрузка", "загрузки");
	
	ПроверитьТаблицу("ТаблицаРаспределения", СписокПроверяемыхКолонок);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТаблицуРаспределенияПоПериоду(Команда)
	
	СписокПроверяемыхКолонок = Новый СписокЗначений;
	СписокПроверяемыхКолонок.Добавить("Трудозатраты", "трудозатрат", Истина);
	СписокПроверяемыхКолонок.Добавить("ДоляПериода", "доли периода", Истина);
	
	ПроверитьТаблицу("ТаблицаРаспределенияПоПериоду", СписокПроверяемыхКолонок);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтраницуНастроек()
	
	Если Объект.СпособРаспределения = ПредопределенноеЗначение("Перечисление.упоСпособРаспределенияТрудозатрат.РавномерноПоДням") Тогда
		
		СтраницаНастройки = Элементы.ОсновнаяПанель.ПодчиненныеЭлементы.СтраницаЛинейныйСпособ;
		
	ИначеЕсли Объект.СпособРаспределения = ПредопределенноеЗначение("Перечисление.упоСпособРаспределенияТрудозатрат.ПоТаблицеРаспределения") Тогда

		СтраницаНастройки = Элементы.ОсновнаяПанель.ПодчиненныеЭлементы.СтраницаПоТаблице;
		
	Иначе
		
		СтраницаНастройки = Элементы.ОсновнаяПанель.ПодчиненныеЭлементы.СтраницаПоТаблицеСПериодами;
		
	КонецЕсли;
	
	Элементы.ОсновнаяПанель.ТекущаяСтраница = СтраницаНастройки;
	
КонецПроцедуры

// Проверяет корректность заполнения таблицы распределения.
//
// Параметры:
//	ИмяТаблицы - Строка.
//  СписокПроверяемыхКолонок - СписокЗначений:
//								* Пометка - если истина, итого по колонке должен быть 100, если нет, то проверяется неравенство нулю 
//								* Значение - Имя колонки
//								* Представление - Имя колонки в родительском падеже (для сообщений пользователю). 
//
// Возвращаемое значение:
//   Булево   – результат проверки.
&НаСервере
Функция ПроверитьТаблицуНаСервере(ИмяТаблицы, СписокПроверяемыхКолонок)

	Успешно = Истина;
	
	Для Каждого ПроверяемаяКолонка Из СписокПроверяемыхКолонок Цикл
	
		Для каждого СтрокаДанных Из Объект[ИмяТаблицы] Цикл 					
			Если СтрокаДанных[ПроверяемаяКолонка.Значение] > 100 Тогда
				обПредупреждение("В строке №" + СтрокаДанных.НомерСтроки + " некорректно введен процент " + ПроверяемаяКолонка.Представление + "!", 120);
				Успешно = Ложь;			
			КонецЕсли;  			
		КонецЦикла; 	
		
		Если ПроверяемаяКолонка.Пометка Тогда
			Если НЕ Объект[ИмяТаблицы].Итог(ПроверяемаяКолонка.Значение) = 100 Тогда
				обПредупреждение("Суммарный процент " + ПроверяемаяКолонка.Представление + " не равен 100!", 120);
				Успешно = Ложь;
			КонецЕсли; 
		Иначе	
			Если Объект[ИмяТаблицы].Итог(ПроверяемаяКолонка.Значение) = 0 Тогда
				обПредупреждение("Суммарный процент " + ПроверяемаяКолонка.Представление + " равен нулю!", 120);
				Успешно = Ложь;
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Успешно;

КонецФункции

