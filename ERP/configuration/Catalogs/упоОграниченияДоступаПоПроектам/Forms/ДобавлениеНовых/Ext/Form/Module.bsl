#КонецОбласти

&НаСервере
Функция ОбновитьСписокПрофилей() 
	
	Элементы.Профиль.СписокВыбора.Очистить();
	
	ТаблицаПрофилей = ПолучитьПрофилиСОграничениямиПоПроектам();
	Для Каждого СтрокаПрофиля Из ТаблицаПрофилей Цикл
		Элементы.Профиль.СписокВыбора.Добавить(СтрокаПрофиля.Профиль,
					?(СтрокаПрофиля.Предопределенный, "", "*") 
					+ СтрокаПрофиля.Наименование);	
	КонецЦикла;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПрофилиСОграничениямиПоПроектам() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	ВидДоступаПроекты = упоОграниченияДоступаПоПроектам.ПолучитьВидДоступаПроекты();
	Запрос.УстановитьПараметр("ВидДоступа", ВидДоступаПроекты);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПрофилиГруппДоступаВидыДоступа.Ссылка КАК Профиль,
	               |	ПрофилиГруппДоступаВидыДоступа.Ссылка.Наименование КАК Наименование,
	               |	ПрофилиГруппДоступаВидыДоступа.Ссылка.Предопределенный КАК Предопределенный
	               |ИЗ
	               |	Справочник.ПрофилиГруппДоступа.ВидыДоступа КАК ПрофилиГруппДоступаВидыДоступа
	               |ГДЕ
	               |	ПрофилиГруппДоступаВидыДоступа.ВидДоступа = &ВидДоступа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПрофилиГруппДоступаВидыДоступа.Ссылка.Предопределенный Убыв,
	               |	ПрофилиГруппДоступаВидыДоступа.Ссылка.Наименование";

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПользователиНаходятсяВСоставеГрупп(СписокПользователей) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокПользователей", СписокПользователей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГруппыПользователейСостав.Ссылка КАК ГруппаПользователей,
	               |	ГруппыПользователейСостав.Пользователь
	               |ПОМЕСТИТЬ ГруппыПользователей
	               |ИЗ
	               |	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
	               |ГДЕ
	               |	ГруппыПользователейСостав.Пользователь В(&СписокПользователей)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ГруппыДоступаПользователи.Пользователь,
	               |	ГруппыДоступаПользователи.Ссылка КАК ГруппаДоступа,
	               |	ЛОЖЬ КАК ИзГруппыПользователей,
	               |	ГруппыДоступаПользователи.Пользователь.Наименование КАК ПользовательНаименование
	               |ИЗ
	               |	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	               |ГДЕ
	               |	ГруппыДоступаПользователи.Пользователь В(&СписокПользователей)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ГруппыПользователей.Пользователь,
	               |	ГруппыДоступаПользователи.Ссылка,
	               |	ИСТИНА,
	               |	ГруппыДоступаПользователи.Пользователь.Наименование
	               |ИЗ
	               |	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ГруппыПользователей КАК ГруппыПользователей
	               |		ПО ГруппыДоступаПользователи.Пользователь = ГруппыПользователей.ГруппаПользователей
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПользовательНаименование";
	
	МассивПользователейВГруппах = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
	МассивПользователейВГруппах = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПользователейВГруппах);	
	
	Возврат МассивПользователейВГруппах;
	
КонецФункции

&НаСервере
Функция ВыполнитьНаСервере() 
	
	Успех = Истина;
	
	ПапкаГрупп = Константы.упоПапкаГруппДоступаАвтоматическихОграниченийПоПроектам.Получить();
	
	МассивПользователей = СписокПользователей.ВыгрузитьЗначения();
	МассивПользователей = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивПользователей);
	
	ВидДоступаПроекты = упоОграниченияДоступаПоПроектам.ПолучитьВидДоступаПроекты();
		
	НачатьТранзакцию();
	
	Для Каждого Пользователь Из МассивПользователей Цикл
		
		обГруппаДоступа = Справочники.ГруппыДоступа.СоздатьЭлемент();
		обГруппаДоступа.Родитель = ПапкаГрупп;
		обГруппаДоступа.Наименование = Пользователь;
		обГруппаДоступа.Профиль = Профиль;
		
		обГруппаДоступа.Пользователи.Добавить().Пользователь = Пользователь;
		обГруппаДоступа.Пользователь = Пользователь;
		
		СтрокаВидовДоступа = обГруппаДоступа.ВидыДоступа.Добавить();
		СтрокаВидовДоступа.ВидДоступа = ВидДоступаПроекты;
		СтрокаВидовДоступа.ВсеРазрешены = Ложь;	
				
		Попытка
			обГруппаДоступа.Записать();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ограничения доступа по проектам'"), УровеньЖурналаРегистрации.Ошибка,, ТекстОшибки);
			ТекстСообщения = НСтр("ru = 'При записи группы доступа произошла ошибка. Подробности в журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Успех = Ложь;
			Прервать;
		КонецПопытки;	
		
		обОграничениеДоступа = Справочники.упоОграниченияДоступаПоПроектам.СоздатьЭлемент();
		обОграничениеДоступа.Пользователь = Пользователь; 
		обОграничениеДоступа.ГруппаДоступа = обГруппаДоступа.Ссылка;
		
		Попытка
			обОграничениеДоступа.Записать();
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ограничения доступа по проектам'"), УровеньЖурналаРегистрации.Ошибка,, ТекстОшибки);
			ТекстСообщения = НСтр("ru = 'При записи ограничения доступа произошла ошибка. Подробности в журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Успех = Ложь;
			Прервать;
		КонецПопытки;
		
	КонецЦикла;
	
	Если Не Успех Тогда
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

&НаСервереБезКонтекста
Функция СписокПользователейСУжеЗаданнымиОграничениямиДоступа() 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
