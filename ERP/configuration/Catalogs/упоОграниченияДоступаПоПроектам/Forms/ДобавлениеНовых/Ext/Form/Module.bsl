#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаДобавить(Команда)
	
	СписокИсключаемых = СписокПользователейСУжеЗаданнымиОграничениямиДоступа();	
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("СкрываемыеПользователи", СписокИсключаемых);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
		
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыОткрытия, Элементы.СписокПользователей);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодбор(Команда)
	
	СписокИсключаемых = СписокПользователейСУжеЗаданнымиОграничениямиДоступа();	
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("СкрываемыеПользователи", СписокИсключаемых);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыОткрытия, Элементы.СписокПользователей);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	МассивПользователейВГруппах = ПользователиНаходятсяВСоставеГрупп(СписокПользователей);
	
	Если МассивПользователейВГруппах.Количество() Тогда
		
		СоставВопроса = Новый Массив;
		
		
		СоставВопроса.Добавить(НСтр("ru = 'Пользователи уже участвуют в группах доступа:'"));
		СоставВопроса.Добавить(Символы.ПС);
		Для Каждого Пользователь Из МассивПользователейВГруппах Цикл			
			СоставВопроса.Добавить(Символы.ПС);
			СоставВопроса.Добавить(Строка(Пользователь));				
		КонецЦикла;
		СоставВопроса.Добавить(Символы.ПС);
		СоставВопроса.Добавить(Символы.ПС);
		СоставВопроса.Добавить(НСтр("ru = 'Продолжить?'"));
		
		ТекстВопроса = СтрСоединить(СоставВопроса);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("КомандаВыполнитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
		
	Иначе
		
		КомандаВыполнитьЗавершение(КодВозвратаДиалога.Да,  Неопределено);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция КомандаВыполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ВыполнитьНаСервере() Тогда
		Оповестить("Запись_упоОграниченияДоступаПоПроектам");
		Закрыть();
	КонецЕсли;

КонецФункции

#КонецОбласти

