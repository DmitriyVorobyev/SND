#Область ОписаниеПеременных

&НаКлиенте
Перем КэшТиповРеквизитов;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ИнициализироватьИсточникДанныхФормы(ТекущийОбъект);
	
	упоОбработчикиСобытийСервер.ФормаПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	МодифицироватьЗаблокироватьФормуПредустановленного();
		
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ИнициализацияДанныхНовогоЭлемента(Параметры);
	
	НастроитьЭлементыФормы(Истина);
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка); 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ТипПравила = Перечисления.упоТипыПравилПроектногоБюджетирования.ПроизвольныйЗапрос Тогда
		СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
		ТекущийОбъект.СхемаКомпоновкиДанных = Новый ХранилищеЗначения(СхемаКомпоновкиДанных);
	Иначе
		ТекущийОбъект.СхемаКомпоновкиДанных = Неопределено;
	КонецЕсли;
	
	Если НЕ ТекущийОбъект.ТипПравила = Перечисления.упоТипыПравилПроектногоБюджетирования.Бюджетирование Тогда
		ТекущийОбъект.НастройкиКомпоновкиДанных = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	КонецЕсли;
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	упоОбработчикиСобытийСервер.ФормаОбработкаПроверкиЗаполненияНаСервере(ЭтаФорма, Объект, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	КэшТиповРеквизитов = ЗаполнитьКэшТиповРеквизитов();
	
	ОбновитьНадписьПоследняяМодификация();
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, Источник)
	
	Если ТипЗНЧ(Источник) = Тип("КонструкторСхемыКомпоновкиДанных") Тогда
		
		Если ЭтотОбъект.ТолькоПросмотр Тогда
			ТекстСообщения = НСтр("ru = 'Элемент находится в режиме ""Только просмотр"" и недоступен для редактирования'");
			ПоказатьПредупреждение( , ТекстСообщения);
		Иначе
		#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			ОбработатьИзменениеСхемыКомпоновкиДанныхНаФорме(ЭтаФорма, ВыбранноеЗначение);
		#КонецЕсли
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОчиститьСообщения();
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаОповещения(ЭтаФорма, Объект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	упоОбработчикиСобытийКлиент.ФормаВнешнееСобытие(ЭтаФорма, Объект, Источник, Событие, Данные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаЗаписиНового(ЭтаФорма, НовыйОбъект, Источник, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипыДокументовТипДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТипыДокументов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ТекДок = Элементы.ТипДокумента.СписокВыбора.НайтиПоЗначению(ВыбранноеЗначение);
		Если ТекДок <> Неопределено Тогда
			ТекущиеДанные.ТипДокументаСиноним = ТекДок.Представление;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазделДанныхПриИзменении(Элемент)
	
	ОчиститьСообщения();
	РазделДанныхПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПравилаПриИзменении(Элемент)
	
	ОчиститьСообщения();
	ОбработатьИзменениеНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникБюджетированияПриИзменении(Элемент)
	
	ОчиститьСообщения();
	ОбработатьИзменениеНастройкиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовПередНачаломИзменения(Элемент, Отказ)
	
	мТекущийЭлемент = Элемент.ТекущийЭлемент;
	
	Если мТекущийЭлемент <> Неопределено 
		И ТипЗНЧ(мТекущийЭлемент) = Тип("ПолеФормы") 
		И мТекущийЭлемент.Имя = "СопоставлениеРеквизитовЗначениеЗаполнения" Тогда
		УстановитьОграничениеТипаРеквизита(мТекущийЭлемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовСпособЗаполненияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СопоставлениеРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитОписаниеТипа = КэшТиповРеквизитов[Объект.Раздел][ТекущиеДанные.Реквизит];
	
	ТипЗначенияЗаполнения = ТипЗнч(ТекущиеДанные.ЗначениеЗаполнения);
	
	Если Не ТекущиеДанные.СпособЗаполнения И Не РеквизитОписаниеТипа.СодержитТип(ТипЗначенияЗаполнения)
		Или ТекущиеДанные.СпособЗаполнения И Не ТипЗначенияЗаполнения = Тип("Строка") Тогда
		ТекущиеДанные.ЗначениеЗаполнения = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СопоставлениеРеквизитовЗначениеЗаполненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.СопоставлениеРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.СпособЗаполнения Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуВыбораРеквизитаСКД(Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьНаименованиеАвтоматическиПриИзменении(Элемент)
	
	Элементы.Наименование.Доступность = Не Объект.ФормироватьНаименованиеАвтоматически;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределятьПоПлануПриИзменении(Элемент)
	
	УстановитьЗначенияЗаполненияПоУмолчанию();
	
	УстановитьВидимостьДоступностьЭлементов_РаспределятьПоПлану(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьПравилоДляПредустановленногоПриИзменении(Элемент)
	
	ПодключитьОбработчикОжидания("ЗаписатьПредустановленныйОбъектВФорме", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьСопоставлениеРеквизитовПоИсточнику(Команда)
	
	ОчиститьСообщения();
	ЗаполнитьСопоставлениеРеквизитовПоИсточникуСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрироватьДокументыКОтражению(Команда)
	
	Если Модифицированность Тогда
		
		ТекстВопроса = НСтр("ru='Для регистрации документов необходимо записать правило. Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаписатьПравилоЗавершение", ЭтаФорма);
		
	Иначе
		
		ТекстНачалоИспользования = "";	
		НачалоИспользованияКонтураЭкономики = НачалоИспользованияКонтураЭкономики();
		Если ЗначениеЗаполнено(НачалоИспользованияКонтураЭкономики) Тогда
			ТекстНачалоИспользования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru=', начиная с %1'"),
				Формат(НачалоИспользованияКонтураЭкономики, "ДФ = ""дд.ММ.гггг 'г'"""));
		КонецЕсли;
		
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Будут зарегистрированы документы указанных типов%1. Продолжить?'"), 
			ТекстНачалоИспользования);
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗарегистрироватьДокументыКОтражениюЗавершение", ЭтаФорма);
		
	КонецЕсли;
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#Область РедактированиеСхемыКомпоновкиДанных

&НаКлиенте
Процедура ОткрытьКонструкторСхемыКомпоновкиДанных(Команда)
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда						
		// Копирование исходной схемы.
		СхемаXDTO = СериализаторXDTO.ЗаписатьXDTO(ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных));
		СхемаКомпоновкиДанных = СериализаторXDTO.ПрочитатьXDTO(СхемаXDTO);
		
		// Редактирование копии схемы.
		Конструктор = Новый КонструкторСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
		Конструктор.Редактировать(ЭтаФорма);		
	#Иначе		
		ТекстПредупреждения = НСтр("ru='Для редактирования схемы получения данных необходимо запустить конфигурацию в режиме толстого клиента.'");
		ПоказатьПредупреждение(, ТекстПредупреждения);		
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСхемуКомпоновкиДанныхИзФайла(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьСхемуКомпоновкиДанныхИзXMLФайлаРасширениеПодключено", ЭтаФорма);
	
	НачатьПодключениеРасширенияРаботыСФайлами(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСхемуКомпоновкиДанныхВФайл(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыгрузитьСхемуКомпоновкиДанныхВXMLФайлРасширениеПодключено", ЭтаФорма);
	
	НачатьПодключениеРасширенияРаботыСФайлами(ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

