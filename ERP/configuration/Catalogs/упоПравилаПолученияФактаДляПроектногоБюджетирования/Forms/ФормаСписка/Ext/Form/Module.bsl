#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	НастроитьЭлементыФормы(Параметры);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОбновитьПредустановленныеПравила(Команда)
	
	ТекстВопроса = НСтр("ru = 'Будут обновлены предустановленные правила проектного бюджетирования. Продолжить?'");
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьПредустановленныеПравилаЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды		
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервере
Процедура НастроитьЭлементыФормы(Параметры)
	
	ЕстьПравоИзменения = УправлениеДоступом.ИзменениеРазрешено(
		Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования.ПустаяСсылка());

	Если Не ЕстьПравоИзменения Тогда
		Элементы.КомандаОбновитьПредустановленныеПравила.Доступность = Ложь;
	КонецЕсли;
	
	ДокументОснование = Неопределено;
	Параметры.Свойство("ДокументОснование", ДокументОснование);
	
	УстановитьОтборПоТипуДокументаОснования(ДокументОснование);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоТипуДокументаОснования(ДокументОснование)
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокумента = ДокументОснование.Метаданные().Имя;
	ПравилаОтражения = Справочники.упоПравилаПолученияФактаДляПроектногоБюджетирования.
		ПравилаОтраженияПоТипамДокументов(ТипДокумента);
	
	ЭлементОтбораДанных = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбораДанных.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбораДанных.ПравоеЗначение = ПравилаОтражения;
	ЭлементОтбораДанных.Использование = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьПредустановленныеПравилаСервер()
	
	упоПроектноеБюджетированиеСервер.ОбновитьПредопределенныеПравилаПолученияФакта();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредустановленныеПравилаЗавершение(Результат, ПараметрыЗаписи) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбновитьПредустановленныеПравилаСервер();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти