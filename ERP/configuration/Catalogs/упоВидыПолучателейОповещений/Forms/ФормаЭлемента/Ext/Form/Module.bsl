#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АдресаОтправкиПолеАдресаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.АдресаОтправки.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.ВариантХраненияПоляАдреса) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Укажите где хранится поле адреса'");
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ВариантХраненияПоляАдреса = ПредопределенноеЗначение("Перечисление.упоВариантыХраненияПоляАдреса.ВПолучателе") Тогда
		СписокРеквизитовОбъекта = упоОповещенияВызовСервера.ПолучитьСписокВозможныхРеквизитовДляХраненияАдресов(Объект.ТаблицаПолучателя);
		ДанныеВыбора = Новый СписокЗначений;
		Для Каждого Эл Из СписокРеквизитовОбъекта Цикл
			ДанныеВыбора.Добавить(Эл.Значение,Эл.Представление);	
		КонецЦикла;
	Иначе
		
		Пар = Новый Структура;
		Пар.Вставить("ТаблицаПолучателя",Объект.ТаблицаПолучателя);
		Пар.Вставить("ВариантХраненияПоляАдреса",ТекДанные.ВариантХраненияПоляАдреса);
		Пар.Вставить("УИстроки",ТекДанные.ПолучитьИдентификатор());
		Пар.Вставить("ОписаниеХраненияАдреса",ТекДанные.ОписаниеХраненияАдреса);
		
		ПолеАдресаПараметры = ТекДанные.ПолеАдресаПараметры;
		Если ТипЗнч(ПолеАдресаПараметры) = Тип("Структура") Тогда
			Для Каждого Эл Из ПолеАдресаПараметры Цикл 
				Пар.Вставить(Эл.Ключ,Эл.Значение);
			КонецЦикла;
		КонецЕсли;
		
		ОткрытьФорму("Справочник.упоВидыПолучателейОповещений.Форма.ФормаВводаПоляАдреса",Пар,ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПрочитатьПараметрыАдресаОтправки(ТекущийОбъект) 
	
	тз = ТекущийОбъект.АдресаОтправки.Выгрузить();
	Объект.АдресаОтправки.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = Объект.АдресаОтправки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТз);
		НовСтр.ПолеАдресаПараметры = СтрТз.ПолеАдресаХЗ.Получить();	
	КонецЦикла;
	
КонецФункции

