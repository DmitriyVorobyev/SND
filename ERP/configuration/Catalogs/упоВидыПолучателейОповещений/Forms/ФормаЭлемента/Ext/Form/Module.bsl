
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Объект.Предопределенный Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка);           
	
	Элементы.ТаблицаПолучателя.СписокВыбора.Очистить();
	масНужныеТипы = Новый Массив;
	масНужныеТипы.Добавить("Справочники");
	Пар = Новый Структура("масНужныеТипы",масНужныеТипы);
	Спис = упоОповещенияВызовСервера.ПолучитьСписокДоступныхТаблиц(Пар);
	Для Каждого Эл Из Спис Цикл
		Элементы.ТаблицаПолучателя.СписокВыбора.Добавить(Эл.Значение,Эл.Представление);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) И Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ПрочитатьПараметрыАдресаОтправки(Параметры.ЗначениеКопирования);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора); 
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.упоВидыПолучателейОповещений.Форма.ФормаВводаПоляАдреса" Тогда
		
		ТекДанные = Объект.АдресаОтправки.НайтиПоИдентификатору(ВыбранноеЗначение.УИстроки);
		
		Если ТекДанные <> Неопределено Тогда
			ТекДанные.ПолеАдресаПараметры = Новый Структура();
			Для Каждого Эл Из ВыбранноеЗначение Цикл
				Если НЕ Эл.Ключ = "УИстроки" И НЕ Эл.Ключ = "ПредставлениеПоляАдреса" Тогда
					ТекДанные.ПолеАдресаПараметры.Вставить(Эл.Ключ,Эл.Значение);	
				КонецЕсли;
			КонецЦикла;
			ТекДанные.ПолеАдреса = ВыбранноеЗначение.ПредставлениеПоляАдреса;
			ТекДанные.ОписаниеХраненияАдреса = ВыбранноеЗначение.ОписаниеХраненияАдреса;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	тз = Объект.АдресаОтправки.Выгрузить();
	ТекущийОбъект.АдресаОтправки.Очистить();
	Для Каждого СтрТз Из тз Цикл
		НовСтр = ТекущийОбъект.АдресаОтправки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТз);
		НовСтр.ПолеАдресаХЗ = Новый ХранилищеЗначения(СтрТз.ПолеАдресаПараметры);	
	КонецЦикла;
	
КонецПроцедуры

