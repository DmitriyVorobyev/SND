
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, , Отказ, СтандартнаяОбработка);           
	
	Параметры.Свойство("ТаблицаПолучателя",ТаблицаПолучателя);
	Параметры.Свойство("ВариантХраненияПоляАдреса",ВариантХраненияПоляАдреса);
	Параметры.Свойство("УИстроки",УИстроки);
	Параметры.Свойство("ОписаниеХраненияАдреса",ОписаниеХраненияАдреса);
	
	Параметры.Свойство("ИмяТаблицы",ИмяТаблицы);
	Параметры.Свойство("ПолеСвязи",ПолеСвязи);
	Параметры.Свойство("ПолеАдреса",ПолеАдреса);
	Параметры.Свойство("ПолеУсловия",ПолеУсловия);
	
	Параметры.Свойство("ИмяТаблицыКонтЛицо",ИмяТаблицыКонтЛицо);
	Параметры.Свойство("ПолеСвязиКонтЛицо",ПолеСвязиКонтЛицо);
	Параметры.Свойство("ПолеУсловияКонтЛицо",ПолеУсловияКонтЛицо);
	
	Если ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВКонтИнформацииКонтЛицаПолучателя Тогда
		
		Если ЗначениеЗаполнено(ПолеУсловияКонтЛицо) Тогда
			ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизита(ИмяТаблицыКонтЛицо,ПолеУсловияКонтЛицо);
			Если ОписаниеТипаРеквизита <> Неопределено Тогда
				Элементы.ЗначениеУсловияКонтЛицо.ОграничениеТипа = ОписаниеТипаРеквизита;
			КонецЕсли;
			Параметры.Свойство("ЗначениеУсловияКонтЛицо",ЗначениеУсловияКонтЛицо);
		КонецЕсли;
		
		ЗаполнитьТаблицыКонтЛицо(ТаблицаПолучателя);
		Если ЗначениеЗаполнено(ИмяТаблицыКонтЛицо) Тогда
			ЗаполнитьТаблицыКонтИнфо(ИмяТаблицыКонтЛицо);
			ЗаполнитьСпискиВыбораКонтЛицо();
			ПредставлениеТаблицыКонтЛицо = упоОповещенияВызовСервера.ПолучитьПредставлениеТаблицы(ИмяТаблицыКонтЛицо);
		КонецЕсли;
		
	ИначеЕсли ВариантХраненияПоляАдреса = Перечисления.упоВариантыХраненияПоляАдреса.ВКонтИнформацииПолучателя Тогда
		
		Элементы.ГруппаТаблКонтЛицо.Видимость = Ложь;
		ЗаполнитьТаблицыКонтИнфо(ТаблицаПолучателя);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолеУсловия) Тогда
		ОписаниеТипаРеквизита = упоОповещенияВызовСервера.ПолучитьОписаниеТипаРеквизита(ИмяТаблицы,ПолеУсловия);
		Если ОписаниеТипаРеквизита <> Неопределено Тогда
			Элементы.ЗначениеУсловия.ОграничениеТипа = ОписаниеТипаРеквизита;
		КонецЕсли;
		Параметры.Свойство("ЗначениеУсловия",ЗначениеУсловия);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
		ЗаполнитьСпискиВыбора();
		ПредставлениеТаблицы = упоОповещенияВызовСервера.ПолучитьПредставлениеТаблицы(ИмяТаблицы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Неопределено, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора); 
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.упоВидыСобытий.Форма.ФормаВыборТаблицыМетаданных" Тогда
		
		Если ВыбранноеЗначение.УИстроки = 1 Тогда
			ИмяТаблицы = ВыбранноеЗначение.ИмяТаблицы;
			ПредставлениеТаблицы = ВыбранноеЗначение.ПредставлениеТаблицы;
			ЗаполнитьСпискиВыбора();
		ИначеЕсли ВыбранноеЗначение.УИстроки = 2 Тогда
			
			ПредставлениеТаблицы = "";
			ИмяТаблицы = "";
			ПолеСвязи = "";
			ПолеУсловия = "";
			ЗначениеУсловия = Неопределено;
			ПолеАдреса = "";
			
			ИмяТаблицыКонтЛицо = ВыбранноеЗначение.ИмяТаблицы;
			ПредставлениеТаблицыКонтЛицо = ВыбранноеЗначение.ПредставлениеТаблицы;
			ЗаполнитьСпискиВыбораКонтЛицо();
			
			ЗаполнитьТаблицыКонтИнфо(ИмяТаблицыКонтЛицо);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

