&НаКлиенте
Процедура КомандаСделатьТекущим(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ТекДанные.Свойство("Проект") Тогда
		упоПроектыИЗадачиКлиент.УстановитьПроектТекущим(ТекДанные.Проект, ЭтаФорма);
	Иначе
		ВывестиПредупреждение("Команда не может быть выполнена для указанного объекта!");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкрытьЭтапыПроекта(Команда)
	
	СкрыватьЭтапы = НЕ СкрыватьЭтапы;
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНастройкиСписка(Команда)
		
	СписокОтбор = Неопределено;
	Для каждого ЭлементПользовательскихНастроек Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементПользовательскихНастроек) = Тип("ОтборКомпоновкиДанных") Тогда
			СписокОтбор = ЭлементПользовательскихНастроек;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ СписокОтбор = Неопределено Тогда
		
		Сч = СписокОтбор.Элементы.Количество() - 1;
		Пока Сч >= 0 Цикл 
			ЭлементОтбора = СписокОтбор.Элементы[Сч];
			Если НЕ (ЭлементОтбора.Представление = "БыстрыйПоиск"
				И ЭлементОтбора.РежимОтображения  = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный) Тогда
				СписокОтбор.Элементы.Удалить(ЭлементОтбора);
			КонецЕсли;
			Сч = Сч - 1;	
		КонецЦикла;
		
	КонецЕсли;
	
	Список.УсловноеОформление.Элементы.Очистить();
	Список.Порядок.Элементы.Очистить();
	Список.Группировка.Элементы.Очистить();
	
КонецПроцедуры

