&НаКлиенте
Процедура СписокЭтаповВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЭтоФормаВыбора Тогда
		СтандартнаяОбработка = Ложь;
		Если ЭтоФормаВыбораПроектнойЗадачи И НЕ ЭтоФормаВыбораПроектнойЗадачиКакПроекта Тогда
			ОповеститьОВыборе(НайтиСвязанныйЭлемент(ВыбраннаяСтрока));
		ИначеЕсли ЭтоФормаВыбораПроектнойЗадачиКакПроекта Тогда
			ТекущиеДанныеЭтапа = Элементы.СписокЭтапов.ТекущиеДанные;
			
			Если ТекущиеДанныеЭтапа = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			Если ТекущиеДанныеЭтапа.ЭтоПроектнаяЗадача Тогда 
				ОповеститьОВыборе(ВыбраннаяСтрока);
			КонецЕсли;
		Иначе
			ОповеститьОВыборе(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ЭтоФормаВыбора Тогда
		Если НЕ ЭтоФормаВыбораПроектнойЗадачи Тогда
			СтандартнаяОбработка = Ложь;
			ОповеститьОВыборе(ВыбраннаяСтрока);
		КонецЕсли;
	Иначе
		Если ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
			СтандартнаяОбработка = Ложь;
			ПоказатьЗначение(, ВыбраннаяСтрока.Ключ);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если НЕ Копирование И НЕ Группа Тогда
		Отказ = Истина;
		Основание = Новый Структура;
		Основание.Вставить("Наименование", БыстрыйПоиск);
		Основание.Вставить("Компонент", ОтборПоКомпоненту);
		ПараметрыНового = Новый Структура;
		ПараметрыНового.Вставить("Основание", Основание);
		ОткрытьФорму("Справочник.Проекты.ФормаОбъекта", ПараметрыНового, Элементы.Список);
	КонецЕсли;	
