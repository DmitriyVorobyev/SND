		упоРаботаСФормамиКлиент.ОткрытьОтчетПроектаПоСлужебнойКоманде(Этаформа, Команда, "КомандаОтчетаПроекта", ТекДанные.Проект);
	Иначе
		ВывестиПредупреждение("Команда не может быть выполнена для указанного объекта!");
	КонецЕсли;
КонецФункции

