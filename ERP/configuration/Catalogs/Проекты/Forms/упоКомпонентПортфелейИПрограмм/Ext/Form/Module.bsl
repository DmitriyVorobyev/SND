
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Параметры.Свойство("Проект", Проект);
	
	Если ЗначениеЗаполнено(Проект) Тогда
		ОбновитьДеревоСтруктурыПодчиненности();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументРезультатОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Если НЕ ЭтоАдресВременногоХранилища(АдресДанныеРасшифровки) ИЛИ НЕ ЭтоАдресВременногоХранилища(АдресСКД) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ОбработкаРасшифровки = Новый ОбработкаРасшифровкиКомпоновкиДанных(АдресДанныеРасшифровки,
										Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКД));
		
	ДоступныеДействия = Новый Массив;             
	ДоступныеДействия.Добавить(ДействиеОбработкиРасшифровкиКомпоновкиДанных.ОткрытьЗначение); 	

	Контекст = Новый Структура;
	Контекст.Вставить("Расшифровка", Расшифровка);
	ОписаниеОповещения = Новый ОписаниеОповещения("РезультатОбработкаРасшифровкиЗавершение", ЭтотОбъект, Контекст);

	ОбработкаРасшифровки.ПоказатьВыборДействия(ОписаниеОповещения, Расшифровка, ДоступныеДействия);
			
КонецПроцедуры

&НаКлиенте
Процедура РезультатОбработкаРасшифровкиЗавершение(ВыполненноеДействие, ПараметрВыполненногоДействия, ДополнительныеПараметры) Экспорт
	
	Если ПараметрВыполненногоДействия = Проект Тогда		
		ЗадачаВладелец = ЗадачаВладелецПроекта(АдресДанныеРасшифровки, ДополнительныеПараметры.Расшифровка);	
		Если ЗначениеЗаполнено(ЗадачаВладелец) Тогда
			упоСтруктураПроектаКлиент.ОткрытьСтруктуруПроекта(ЗадачаВладелец);
		КонецЕсли;	
	Иначе	
		ПоказатьЗначение(, ПараметрВыполненногоДействия);
	КонецЕсли;	
					
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	Если ЗначениеЗаполнено(Проект) Тогда
		ВывестиСтруктуруПодчиненности();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инициирует вывод в табличный документ и отображает его по окончанию формирования.
&НаКлиенте
Процедура ВывестиСтруктуруПодчиненности()

	ОбновитьДеревоСтруктурыПодчиненности();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДеревоСтруктурыПодчиненности()
	
	ДокументРезультат.Очистить();
	
	СхемаКД = Справочники.Проекты.ПолучитьМакет("упоМакетКомпонентПортфелейИПрограмм");	
						
	// Инициализация доступных полей.
	КомпоновщикНастроек = упоПроектноеБюджетированиеСервер.КомпоновщикНастроекСхемыКомпоновкиДанных(СхемаКД, СхемаКД.НастройкиПоУмолчанию);	
	
	НастройкиКД = КомпоновщикНастроек.ПолучитьНастройки();
	
	УстановитьНастройкиКД(НастройкиКД);
	
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКД, НастройкиКД, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ОбработкаТабличногоДокумента(ДокументРезультат);	
	
	АдресДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровки, УникальныйИдентификатор);
	АдресСКД = ПоместитьВоВременноеХранилище(СхемаКД, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбработкаТабличногоДокумента(ДокументРезультат)
	
	// Уменьшение отступа после заголовка.
	Область = ДокументРезультат.Область("R2");
	ДокументРезультат.УдалитьОбласть(Область, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьНастройкиКД(НастройкиКД)
	
	упоПроектноеБюджетированиеСервер.ДобавитьОтборНастройкиКомпоновщика(НастройкиКД, "ПодчиненныйПроект", Проект, ВидСравненияКомпоновкиДанных.Равно);	
	
	Для Каждого ЭлементСтруктуры Из НастройкиКД.Структура Цикл
		Если ЭлементСтруктуры.Имя = "Заголовок" Тогда
			ЭлементСтруктуры.Использование = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;		
	
	ЗаголовокОтчета = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Проект ""%1""'"), Проект);
	НастройкиКД.ПараметрыДанных.УстановитьЗначениеПараметра("ЗаголовокОтчета", ЗаголовокОтчета);
	
	ВыводитьОтбор = НастройкиКД.ПараметрыВывода.Элементы.Найти("ВыводитьОтбор");
	ВыводитьОтбор.Использование = Истина;
	ВыводитьОтбор.Значение = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЗадачаВладелецПроекта(АдресДанныеРасшифровки, Расшифровка);
	
	Результат = Неопределено;
	
	Данные = ПолучитьИзВременногоХранилища(АдресДанныеРасшифровки); 
	
	СтруктураГруппировок = Новый Структура("ПроектнаяЗадача");
	ЗаполнитьСтруктуруГруппировок(Данные.Элементы[Расшифровка], СтруктураГруппировок);
	
	Если ЗначениеЗаполнено(СтруктураГруппировок.ПроектнаяЗадача) Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураГруппировок.ПроектнаяЗадача, "СсылкаНаПроектнуюЗадачу");	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции 

&НаСервереБезКонтекста
Процедура ЗаполнитьСтруктуруГруппировок(ЭлементРасшифровки, СтруктураГруппировок)
	
	МассивРодителей = ЭлементРасшифровки.ПолучитьРодителей();
	
	Для Каждого ЭлементРодитель Из МассивРодителей Цикл
		
		Если ТипЗнч(ЭлементРодитель) = Тип("ЭлементРасшифровкиКомпоновкиДанныхГруппировка") Тогда 
			
			ЗаполнитьСтруктуруГруппировок(ЭлементРодитель, СтруктураГруппировок);
			
		ИначеЕсли ТипЗнч(ЭлементРодитель) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			
			ПоляГруппировки = ЭлементРодитель.ПолучитьПоля();
			Для Каждого ПолеГруппировки Из ПоляГруппировки Цикл
				Если СтруктураГруппировок.Свойство(ПолеГруппировки.Поле)
					И Не ЗначениеЗаполнено(СтруктураГруппировок[ПолеГруппировки.Поле]) Тогда					
					СтруктураГруппировок[ПолеГруппировки.Поле] = ПолеГруппировки.Значение;					
				КонецЕсли;
			КонецЦикла;
			
			ПродолжитьЗаполнение = Ложь;
			Для Каждого ЭлементГруппировки Из СтруктураГруппировок Цикл
				Если НЕ ЗначениеЗаполнено(ЭлементГруппировки.Значение) Тогда
					ПродолжитьЗаполнение = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;				
			Если НЕ ПродолжитьЗаполнение Тогда
				Прервать;	
			КонецЕсли;	
			
			ЗаполнитьСтруктуруГруппировок(ЭлементРодитель, СтруктураГруппировок);			
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
