Процедура ФазыПередУдалением(Элемент, Отказ)
	ТекДанные = Элементы.Фазы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если ТекДанные.НомерСтроки = 1 Тогда
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФазыВехаЗеркалоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормыВыбора = Новый Структура();
	
	ТекДанные = Элементы.Фазы.ТекущиеДанные;	
	Если ТекДанные <> Неопределено Тогда
		ПараметрыФормыВыбора.Вставить("ТекЗадача", ТекДанные.ВехаЗеркало);
	КонецЕсли;
	
	ПараметрыФормыВыбора.Вставить("ВыбиратьТолькоВехи", Истина);
	ПараметрыФормыВыбора.Вставить("ВозвращатьСсылкуНаЗеркальныйПроект", Истина);
	ПараметрыФормыВыбора.Вставить("Проект", Объект.Ссылка);
	
	ОткрытьФорму("Обработка.упоВыборПроектнойЗадачи.Форма.ОсновнаяФормаУправляемая", ПараметрыФормыВыбора, Элемент);
	
