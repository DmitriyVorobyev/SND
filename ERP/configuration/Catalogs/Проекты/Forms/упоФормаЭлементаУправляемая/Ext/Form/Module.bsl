	Основание = Новый Структура;
	Основание.Вставить("Проект", Объект.Ссылка);
	Основание.Вставить("ЭтоВеха", Истина);
	ОткрытьФорму("Документ.упоПроектнаяЗадача.ФормаОбъекта", Новый Структура("Основание, РежимВыбораЗеркала", Основание, Истина), Элемент);
