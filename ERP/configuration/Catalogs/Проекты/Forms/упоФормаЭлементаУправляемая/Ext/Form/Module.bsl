Процедура ТекущаяФазаПредставлениеНажатие(Элемент, СтандартнаяОбработка)
	СтраницаФазы = Элементы.Найти("СтраницаФазы");	
	ПанельФормы = Элементы.Найти("ПанельФормы");
	Если СтраницаФазы <> Неопределено И ПанельФормы <> Неопределено Тогда
		ПанельФормы.ТекущаяСтраница = СтраницаФазы;
