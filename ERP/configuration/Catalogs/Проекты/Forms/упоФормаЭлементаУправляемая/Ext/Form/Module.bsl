	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	Подключаемый_УниверсальныйОбработчикСобытийКлиент(П1, П2, П3, П4, П5, П6);
	Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнч(П1), П1.Имя, П2, П3, П4, П5, П6);
	
КонецФункции

&НаСервере
Функция Подключаемый_УниверсальныйОбработчикСобытийСервер(ТипЗнчП1, ИмяП1, П2 = Неопределено, П3 = Неопределено,
	П4 = Неопределено, П5 = Неопределено, П6 = Неопределено) 
	
	упоОбработчикиСобытийСервер.ФормаУниверсальныйОбработчикСобытийФормыНаСервере(ЭтаФорма, ТипЗнчП1, ИмяП1, П2, П3, П4,
		П5, П6);
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ОБЩИЕ ПРОЦЕДУРЫ И ФУНКЦИИ МОДУЛЯ ФОРМЫ

&НаСервере
Процедура ПроверкаПравДоступа(Отказ)
	
	ЕстьПраваПросмотраРедактирования = Не Справочники.Проекты.ЕстьОграничениеРолейНаПросмотрРедактированиеПроектов();
	
	Если ЕстьПраваПросмотраРедактирования Тогда
		Возврат;
	КонецЕсли;	
				
	Отказ = Истина;
	
	ПредставлениеИсключения = НСтр("ru = 'Нарушение прав доступа.'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	ЗаписьЖурналаРегистрации(
		ПредставлениеИсключения,
		УровеньЖурналаРегистрации.Предупреждение,
		?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Ссылка.Метаданные(), Метаданные.Справочники.Проекты));
	
	ВызватьИсключение ПредставлениеИсключения;
	
КонецПроцедуры	

&НаСервере
Процедура ИнициализацияФормы(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗарегистрироватьПроект = Истина;
	КонецЕсли;
	
	упоИнтеграция.ДобавитьКомандуОткрытияЗамененнойФормыПроекта(ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		// Ввод новых элементов, не являющихся корневыми, блокируется		
		Если ЗначениеЗаполнено(Объект.Родитель) Тогда
			Сообщение = НСтр("ru = 'Для создания подчиненных элементов (проектных задач)
	                          |необходимо использовать подсистему ""Управление Проектным Офисом"".'");
			ОбщегоНазначения.СообщитьПользователю(Сообщение, , , , Отказ);
		Иначе
			Объект.Автор = Пользователи.ТекущийПользователь();
		КонецЕсли;                                
		
		ЗаполнитьНастройкиУчетаПоПодразделениям();
	КонецЕсли;
	
	упоРаботаСФормамиСервер.ДобавитьВызовОтчетовПроектаНаФорму(ЭтаФорма, 
		Элементы.ПодменюОтчеты, 
		"КомандаОтчетаПроекта",
		"ОткрытьОтчет");
	
	ПроверитьИмпортИзMSP();
	ЗаполнитьПараметрыДинамическихСписков();
	
	УстановитьБазовуюВидимостьДоступностьЭлементов(ЭтаФорма, Объект);
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма, Объект);
	
	ОтрисоватьПанельСтатусов();
	
	Если ЗначениеЗаполнено(Объект.ЦветПроекта) Тогда
		КСЗ = упоФункцииОбщегоНазначенияСервер.ОписаниеЦвета(Объект.ЦветПроекта, 2);
		ЦветПроекта = Новый Цвет(КСЗ.Красный, КСЗ.Зеленый, КСЗ.Синий); 
	КонецЕсли;
	
	ПроверитьИспользованиеФаз();
	ОбновитьСтартовуюФазу();
	ИсправитьТаблицуФаз(ЭтаФорма);
	
	ОбновитьПредставлениеГородаГеографическойСхемы(ЭтаФорма);
	
	ПолучитьСохраненноеЗначениеМасштабаСхемыФаз(МасштабСхемы, Объект.Ссылка);
	
	// Проектная продукция
	НастроитьФункционалПроектнаяПродукция();
	
	// {Распределение зарплаты}
	ИзменитьЭлементы_Проекты_ФормаЭлемента_РаспределениеЗарплаты();
	// {/Распределение зарплаты}
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФункционалПроектнаяПродукция()
	
	ЕстьППВОбъекте = Объект.упоТипСубпродукта = Перечисления.упоТипСубпродукта.ПроектнаяПродукция;
	ВидимостьЭлементовПП = упоРаботаСФормамиСервер.ВидимостьЭлементовПроектнаяПродукция(ЕстьППВОбъекте);
	
	Если Не ВидимостьЭлементовПП Тогда
		УстановитьСвойствоЭлементаФормы(Элементы, "упоТипСубпродуктаПоУмолчанию", "Видимость", Ложь);
	КонецЕсли;
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() Тогда
		упоРаботаСФормамиСервер.ЗаполнитьРеквизитыТипПродукта(Объект.упоТипСубпродукта, ЭтотОбъект.ТипПродуктаЧисло);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДокументыУправленияПриИзмененииНаСервере()
	
	ОбработкаОповещенияСменыСтатуса();
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьТаблицуФазПоСтруктуреЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.Фазы.Очистить();				
		ЗаполнитьТаблицуФазПоСтруктуреКлиент();		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТаблицуФазПоСтруктуреКлиент()
	
	Объект.упоТекущаяФаза = ПредопределенноеЗначение("Справочник.упоФазыПроектов.ПустаяСсылка");
	ДанныеТаблицыФаз = ПолучитьТаблицуФазПоСтруктуре(Объект.Ссылка, ТекущаяВерсия);
	Первая = Истина;
	Для Каждого СтруктураФазы Из ДанныеТаблицыФаз Цикл
		СтрокаТаблицы = Объект.Фазы.Добавить();
		СтрокаТаблицы.ВехаЗеркало = СтруктураФазы.ВехаЗеркало;
		Если Не Первая Тогда
			СтрокаТаблицы.Фаза = СтруктураФазы.Фаза;
		КонецЕсли;
		Первая = Ложь;
	КонецЦикла;
	ОбновитьСхемуФазПроектаКлиент();
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);		
	
КонецПроцедуры

// Устанавливает настройки элементов формы по виду конфигурации и правам пользователя.
//
&НаСервереБезКонтекста
Функция УстановитьБазовуюВидимостьДоступностьЭлементов(ЭтаФорма, Объект)
	
	Элементы = ЭтаФорма.Элементы;
	
	// PM ПРОФ
	
	УстановитьНастройкиPM_Проф(ЭтаФорма);
	
	// Права доступа.
	
	ЕстьДоступПриоритет = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.упоСоответствиеСтратегическимЦелям)
		И ПравоДоступа("Просмотр", Метаданные.Документы.упоСоответствиеСтратегическимЦелям);
	Если НЕ ЕстьДоступПриоритет Тогда
		УстановитьСвойствоЭлементаФормы(Элементы, "КомандаЗаполнитьПриоритетРасчетнымиДанными", "Доступность", Ложь);
		УстановитьСвойствоЭлементаФормы(Элементы, "КомандаОткрытьДокументыПриоритета", "Доступность", Ложь);
	КонецЕсли;

КонецФункции

// Устанавливает настройки элементов формы по значениям связанных реквизитов формы.
//
&НаКлиентеНаСервереБезКонтекста
Функция УстановитьВидимостьДоступностьЭлементов(ЭтаФорма, Объект, ОбновитьНастройкиПоДаннымИзБазы = Истина)
	
	Элементы = ЭтаФорма.Элементы;
	
	// Статус проекта.
	
	СтатусПроектаЗаполнен = ЗначениеЗаполнено(ЭтаФорма.СтатусПроекта);
	
	УстановитьСвойствоЭлементаФормы(Элементы, "ФормаДокументупоРегистрацияПроектаСоздатьНаОсновании", 
		"Видимость", НЕ СтатусПроектаЗаполнен);
	УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПрогнозныеСроки", "Доступность", СтатусПроектаЗаполнен);
	
	// Фазы.
	
	УстановитьСвойствоЭлементаФормы(Элементы, "Фазы", "Видимость", Элементы.КомандаТаблицаФаз.Пометка);
	
	// Импорт.
	
	Элементы.СтраницаИмпортMSP.Видимость = ЭтаФорма.ЕстьДанныеMSP;
	
	Если ОбновитьНастройкиПоДаннымИзБазы Тогда
		
		ПараметрыИзИБ = ПараметрыДляОтображенияВидимости(Объект.Ссылка, ЭтаФорма.СтатусПроекта, ЭтаФорма.ТолькоПросмотр);
		
		УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаУровняПланированияПриРасчетеГотовностиПроектов", 
			"Видимость", ПараметрыИзИБ.НастройкаУровняПланированияПриРасчетеГотовностиПроектов);
		
		// Только просмотр.
		
		ЭтаФорма.ТолькоПросмотр = ПараметрыИзИБ.ТолькоПросмотр;
		
		УстановитьСвойствоЭлементаФормы(Элементы, "ПанельСтатусовПроекта", "Доступность", Не ЭтаФорма.ТолькоПросмотр);
		Для Каждого ПодчиненныйЭлемент Из Элементы.СтраницаОпцииПроектнойМодели.ПодчиненныеЭлементы Цикл
			ПодчиненныйЭлемент.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
		КонецЦикла;
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьНастройкиPM_Проф(ЭтаФорма)
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;
	КонецЕсли;
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("Компонент");
	МассивЭлементов.Добавить("ФормаОбработкаупоДеревоКлючевыхПоказателейПроектаупоСхемаПоказателейПроекта1");
	МассивЭлементов.Добавить("НастройкаДереваКлючевыхПоказателей");
	МассивЭлементов.Добавить("упоГородПроекта");
	МассивЭлементов.Добавить("ОткрытьСтруктуруПрограммы");
	МассивЭлементов.Добавить("ОткрытьСтруктуруПортфеля");
	МассивЭлементов.Добавить("ГруппаПрогнозныеСроки");
	
	ЭлементыФормы = ЭтаФорма.Элементы;
	Для Каждого ИмяЭлемента Из МассивЭлементов Цикл
		УстановитьСвойствоЭлементаФормы(ЭлементыФормы, ИмяЭлемента, "Видимость", Ложь);
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыДляОтображенияВидимости(Знач Ссылка, Знач СтатусПроекта, Знач ТолькоПросмотр)
	
	Результат = Новый Структура();	
	Результат.Вставить("НастройкаУровняПланированияПриРасчетеГотовностиПроектов", ЗначениеУчитыватьТрудозатратыПриРасчетеПроцентаГотовности());
	
	рТолькоПросмотр = упоРазграничениеДоступаВызовСервера.обЗапретитьРедактированиеРеквизитовПроекта(Ссылка, СтатусПроекта, ТолькоПросмотр);
	
	Результат.Вставить("ТолькоПросмотр", рТолькоПросмотр);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеУчитыватьТрудозатратыПриРасчетеПроцентаГотовности()
	Возврат Константы.упоУчитыватьТрудозатратыПриРасчетеПроцентаГотовности.Получить();	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеПроектаНаФорме(ОткрытиеЗаписьНового = Истина)
	
	ДанынеРП = упоИерархияИПолномочияСервер.ПолучитьРуководителяИКуратораПроекта(Объект.Ссылка);
	РПНаФорме = ДанынеРП.РуководительПроекта;
	КураторНаФорме = ДанынеРП.КураторПроекта;
	
	СтатусПроекта = упоПроектыИЗадачиСервер.ПолучитьСтатусПроекта(Объект.Ссылка);
	ДатаСтарта = упоПроектыИЗадачиСервер.ДатаСтартаПроекта(Объект.Ссылка);
	
	КалендариПроекта = упоПроектыИЗадачиСервер.ПолучитьКалендариПроекта(Объект.Ссылка);
	Если НЕ КалендариПроекта = Неопределено Тогда
		КалендарьНаФорме = КалендариПроекта.Рабочий;
		БанковскийКалендарьНаФорме = КалендариПроекта.Банковский;
	Иначе
		КалендарьНаФорме = Справочники.упоРабочиеКалендари.ПустаяСсылка();
		БанковскийКалендарьНаФорме = Справочники.упоРабочиеКалендари.ПустаяСсылка();
	КонецЕсли;
	
	Если ОткрытиеЗаписьНового Тогда
		ТекущаяВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Объект.Ссылка);
	КонецЕсли;
	
	ЗаполнитьПоказатьМетодОперативногоПланирования();
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоказатьМетодОперативногоПланирования()
	
	// Скрываем поле до проработки механики работы с подразделениями.
	Если Не упоИнтеграцияКлиентСервер.ИспользоватьМетодОперативногоПланированияРесурсовНаПроект() Тогда
		Возврат;
	КонецЕсли;
	
	МетодОперативногоПланирования = упоПроектыИЗадачиСервер.МетодОперативногоПланированияПроекта(Объект.Ссылка);
	// Если явно не выбрано планирование работ по подразделениям - скрываем настройку.
	СкрытьВидимость = Не ЗначениеЗаполнено(МетодОперативногоПланирования) 
		Или МетодОперативногоПланирования = 
			Перечисления.упоМетодОперативногоПланирования.ПрямоеВыделениеРесурсовНаПроект;
	Если СкрытьВидимость = Ложь Тогда
		Элементы.МетодОперативногоПланирования.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПараметрыДинамическихСписков()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Параметр = Объект.Ссылка;
	Иначе
		Параметр = Неопределено;
	КонецЕсли;
	
	ДокументыРасчета.Параметры.УстановитьЗначениеПараметра("Проект", Параметр); 
	
	ДокументыУправления.Параметры.УстановитьЗначениеПараметра("Проект", Параметр); 
	
	ИсторияИмпорта.Параметры.УстановитьЗначениеПараметра("Проект", 			Параметр); 
	ИсторияИмпорта.Параметры.УстановитьЗначениеПараметра("ЕстьДанныеMSP", 	ЕстьДанныеMSP); 
	
	Показатели.Параметры.УстановитьЗначениеПараметра("Проект", 		Параметр);
	Показатели.Параметры.УстановитьЗначениеПараметра("ТипПроекта", 	Объект.ТипПроекта);	
	
	ТрудовыеРесурсыПроекта.Параметры.УстановитьЗначениеПараметра("ТекущаяВерсия", ТекущаяВерсия);
	
КонецФункции

// Устанавливает договор основным.
//
// Параметры:
//  Контрагент	 - СправочникСсылка.Контрагенты - контрагент.
//  Договор		 - СправочникСсылка.ДоговорыКонтрагентов - договор контрагента.
&НаСервере
Процедура УстановитьОснДоговор(Контрагент, Договор)
	
	упоРаботаСФормамиСервер.служ_ПроверитьДоговор(Договор,Контрагент);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИмпортИзMSP()
	
	ЕстьДанныеMSP = Ложь;
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
						|	КОЛИЧЕСТВО(*) КАК Количество
						|ИЗ
						|	РегистрСведений.упоИсторияИмпортаПроектовИзMSP.СрезПоследних(, Проект = &Проект) КАК ИсторияИмпортаПроектовСрезПоследних
						|";
		Запрос.УстановитьПараметр("Проект", Объект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		
		ЕстьДанныеMSP = (Выборка.Количество <> 0);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиУчетаПоПодразделениямПриНеобходимости(ПоПортфелю = Ложь)
	
	ТекСтраница = Элементы.ПанельФормы.ТекущаяСтраница;
		
	ПроверитьНаОткрытойСтранице = (ТекСтраница = Элементы.СтраницаОпцииПроектнойМодели 
								Или ТекСтраница = Элементы.СтраницаДополнительно
								Или ТекСтраница = Элементы.СтраницаПоказатели);	
			
	Если Не НастройкиУчетаПоПодразделениямЗагружены И ПроверитьНаОткрытойСтранице Тогда
		ЗаполнитьНастройкиУчетаПоПодразделениям(ПоПортфелю);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкиУчетаПоПодразделениям(ПоПортфелю = Ложь)
	
	ОбъектПараметровУчета = Объект.Ссылка;
	Если ПоПортфелю Тогда				
		ОбъектПараметровУчета = Объект.ПортфельПроектов;
	КонецЕсли;
	СтруктураНастроек = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ОбъектПараметровУчета);		
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураНастроек);
	
	упоНастройкаПоказателейДляКарточкиПроектовНастройка = Неопределено;
	Если ТипЗнч(СтруктураНастроек.НастройкаПоказателейДляКарточкиПроектов) = Тип("ХранилищеЗначения") Тогда
		упоНастройкаПоказателейДляКарточкиПроектовНастройка = 
			СтруктураНастроек.НастройкаПоказателейДляКарточкиПроектов.Получить();
	КонецЕсли;
	упоПанельПоказателейКлиентСервер.СформироватьПредставлениеДляНастройкиПоказателейКарточекПроектов(ЭтаФорма);	
		
	ДоступностьЭлементовНастройкиУчетаПодразделений();
	
	НастройкиУчетаПоПодразделениямЗагружены = Истина;
	
КонецПроцедуры

&НаСервере	
Процедура ДоступностьЭлементовНастройкиУчетаПодразделений()
	
	упоАналитикаПоПодразделениямКлиентСервер.ДоступностьАналитикаВРазрезеПодразделений(ЭтаФорма, ЭтаФорма);		
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТекущиеНастройкиФОПроекта()
	
	МенеджерЗаписи = РегистрыСведений.упоНастройкаАналитикиВРазрезеПодразделений.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Объект.Ссылка;
	МенеджерЗаписи.Удалить();
	
	Если Не ИзмениласьНастройкаПоказателейДляКарточкиПроекта Тогда
		кэшНастройкаПоказателейДляКарточкиПроектовНастройка = упоНастройкаПоказателейДляКарточкиПроектовНастройка;
	КонецЕсли;
	
	ЗаполнитьНастройкиУчетаПоПодразделениям(Истина);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьНастройкиФО(Проект, ПортфельПроектов)
	
	НастройкиОтличаются = Ложь;
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);
	СвойстваПортфеля = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(ПортфельПроектов);
	
	Для Каждого СтройствоПортфеля Из СвойстваПортфеля Цикл
		
		Если СтройствоПортфеля.Значение <> СвойстваПроекта[СтройствоПортфеля.Ключ] Тогда
			
			НастройкиОтличаются = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НастройкиОтличаются;
	
КонецФункции

&НаКлиенте
Процедура ОтключитьОтборВДинамическомСписке(ИмяДинамическогоСписка)
	
	СписокОтбор = Неопределено;
	Для каждого ЭлементПользовательскихНастроек Из ЭтаФорма[ИмяДинамическогоСписка].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементПользовательскихНастроек) = Тип("ОтборКомпоновкиДанных") Тогда
			СписокОтбор = ЭлементПользовательскихНастроек;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ СписокОтбор = Неопределено Тогда
		
		Сч = СписокОтбор.Элементы.Количество() - 1;
		Пока Сч >= 0 Цикл 
			СписокОтбор.Элементы.Удалить(СписокОтбор.Элементы[Сч]);
			Сч = Сч - 1;	
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

