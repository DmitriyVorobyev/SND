	|ИЗ
	|	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(
	|			,
	|			&ПланироватьТрудозатратыПоПроекту
	|				И Версия = &ТекВерсия) КАК упоДанныеПлановТрудозатратРолейСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборПроектныхЗадач КАК ОтборПроектныхЗадач
	|		ПО упоДанныеПлановТрудозатратРолейСрезПоследних.ПроектнаяЗадача = ОтборПроектныхЗадач.ПроектнаяЗадача
	|ГДЕ
	|	(упоДанныеПлановТрудозатратРолейСрезПоследних.Количество <> 0
	|			ИЛИ упоДанныеПлановТрудозатратРолейСрезПоследних.Стоимость <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	РегистрСведений.упоАктуальныеПланыДвиженийДенежныхСредств.СрезПоследних(
	|			,
	|			&ВедетсяБюджетДвиженияДенежныхСредств
	|				И Версия = &ТекВерсия) КАК упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборПроектныхЗадач КАК ОтборПроектныхЗадач
	|		ПО упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.ПроектнаяЗадача = ОтборПроектныхЗадач.ПроектнаяЗадача
	|ГДЕ
	|	упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.Сумма <> 0
	|	И упоАктуальныеПланыДвиженийДенежныхСредствСрезПоследних.СуммаВалютная <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	упоДанныеПлановДоходовИРасходов.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	РегистрСведений.упоДанныеПлановДоходовИРасходов.СрезПоследних(
	|			,
	|			&ВедетсяБюджетДоходов
	|				И Версия = &ТекВерсия
	|				И ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Доход)) КАК упоДанныеПлановДоходовИРасходов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборПроектныхЗадач КАК ОтборПроектныхЗадач
	|		ПО упоДанныеПлановДоходовИРасходов.ПроектнаяЗадача = ОтборПроектныхЗадач.ПроектнаяЗадача
	|ГДЕ
	|	упоДанныеПлановДоходовИРасходов.Сумма <> 0
	|	И упоДанныеПлановДоходовИРасходов.СуммаВалютная <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	упоДанныеПлановДоходовИРасходов.ПроектнаяЗадача КАК ПроектнаяЗадача
	|ИЗ
	|	РегистрСведений.упоДанныеПлановДоходовИРасходов.СрезПоследних(
	|			,
	|			&ВедетсяБюджетРасходов
	|				И Версия = &ТекВерсия
	|				И ВидЭлемента = ЗНАЧЕНИЕ(Перечисление.упоВидЭлементаПланаДоходовИРасходов.Расход)) КАК упоДанныеПлановДоходовИРасходов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборПроектныхЗадач КАК ОтборПроектныхЗадач
	|		ПО упоДанныеПлановДоходовИРасходов.ПроектнаяЗадача = ОтборПроектныхЗадач.ПроектнаяЗадача
	|ГДЕ
	|	упоДанныеПлановДоходовИРасходов.Сумма <> 0
	|	И упоДанныеПлановДоходовИРасходов.СуммаВалютная <> 0";  
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОпцииМетаданые = Метаданные.РегистрыСведений.упоНастройкаАналитикиВРазрезеПодразделений.Ресурсы;
	
	ТекстыСообщения = Новый Массив;
	ТекстыСообщения.Добавить(НСтр("ru = 'В проекте есть задачи, по которым заполнены табличные части:'"));
	Шаблон = НСтр("ru = ' - ""%1"". При снятии опции ""%2"" эти данные будут очищены при сохранении задачи.
	|Данные трансляции указанных табличных частей будут очищены автоматически.'");
	Если Не Результат[1].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("Субпродукты"),
		ОпцииМетаданые.ДоходыПоНатуральнымПоказателям.Синоним)); 							
	КонецЕсли;
	Если Не Результат[2].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("МатериальныеРесурсы"),
		ОпцииМетаданые.ПланироватьЗатратыНаМатериалы.Синоним)); 							
	КонецЕсли;
	Если Не Результат[3].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("ДополнительныеЗатраты"),
		ОпцииМетаданые.ПланироватьДополнительныеЗатратыПоЗадаче.Синоним)); 							
	КонецЕсли;
	Если Не Результат[4].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("ТрудовыеРесурсы"),
		ОпцииМетаданые.ПланироватьТрудозатратыПоПроекту.Синоним)); 							
	КонецЕсли;	
	Если Не Результат[5].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("ДвиженияДенежныхСредств"),
		ОпцииМетаданые.ВедетсяБюджетДвиженияДенежныхСредств.Синоним)); 							
	КонецЕсли;
	Если Не Результат[6].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("ПланДоходов"),
		ОпцииМетаданые.ВедетсяБюджетДоходов.Синоним)); 							
	КонецЕсли;
	Если Не Результат[7].Пустой() Тогда
		ТекстыСообщения.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
		упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("ПланРасходов"),
		ОпцииМетаданые.ВедетсяБюджетРасходов.Синоним)); 							
	КонецЕсли;
	
	ЕстьДанные = ТекстыСообщения.Количество() > 1;
	
	Если ЕстьДанные Тогда
		ТекстыСообщения.Добавить("");
		ТекстыСообщения.Добавить(НСтр("ru = 'Продолжить?'")); 
		ТекстСообщения = СтрСоединить(ТекстыСообщения, Символы.ПС);
	КонецЕсли;	
	
	Возврат ЕстьДанные;
	
КонецФункции

#КонецОбласти

&НаКлиенте
Процедура ЗакэшироватьСтраницыСОбновлением()
	
	Если СтраницыСОбновлением = Неопределено Тогда
		СтраницыСОбновлением = Новый Массив;
		СтраницыСОбновлением.Добавить(Элементы.СтраницаФазы);
		СтраницыСОбновлением.Добавить(Элементы.СтраницаПоказатели);
		СтраницыСОбновлением.Добавить(Элементы.СтраницаОпцииПроектнойМодели);
		СтраницыСОбновлением.Добавить(Элементы.СтраницаДополнительно);
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ПанельФормыПриСменеСтраницыСервер()
	
	ОбновитьСхемуФазПроектаПриНеобходимости();	
		
	ЗаполнитьНастройкиУчетаПоПодразделениямПриНеобходимости();		
	
	ОбновитьПредставлениеПоказателейПроектаПриНеобходимости();
	
КонецПроцедуры

&НаКлиенте
Процедура СменитьНастройкуПериодаФаз(ИмяКоманды)
	
	Элементы.ФП_ПериодичностьГод.Пометка = Ложь;
	Элементы.ФП_ПериодичностьКвартал.Пометка = Ложь;
	Элементы.ФП_ПериодичностьМесяц.Пометка = Ложь;
	
	Если ИмяКоманды = "ФП_ПериодичностьГод" Тогда
		ФП_Периодичность = "Год";
		Элементы.ФП_ПериодичностьГод.Пометка = Истина;
	ИначеЕсли ИмяКоманды = "ФП_ПериодичностьКвартал" Тогда
		ФП_Периодичность = "Квартал";
		Элементы.ФП_ПериодичностьКвартал.Пометка = Истина;
	ИначеЕсли ИмяКоманды = "ФП_ПериодичностьМесяц" Тогда
		ФП_Периодичность = "Месяц";
		Элементы.ФП_ПериодичностьМесяц.Пометка = Истина;
	КонецЕсли;	
	
	ОбновитьСхемуФазПроектаКлиент();
	
КонецПроцедуры	

#Область РаспределениеЗарплатыПоПроектам

&НаСервере
Процедура ИзменитьЭлементы_Проекты_ФормаЭлемента_РаспределениеЗарплаты()
	
	Если Не упоИнтеграцияEPMСервер.ИспользоватьПодсистемуРаспределениеЗарплаты() Тогда
		Возврат;
	КонецЕсли;
	
	ТипГруппаФормы = Тип("ГруппаФормы");
	ТипПолеФормы = Тип("ПолеФормы");
	
	СтраницаЗначенияПоУмолчанию = Элементы.Найти("СтраницаЗначенияПоУмолчанию");
	
	Если СтраницаЗначенияПоУмолчанию <> Неопределено Тогда
		
		Группа = Элементы.Вставить("РаспределениеЗП", ТипГруппаФормы, СтраницаЗначенияПоУмолчанию);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.Заголовок = НСтр("ru = 'Распределение зарплаты'");
		Группа.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
		Группа.ОтображатьЗаголовок = Истина;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		
		Элемент = Элементы.Вставить("упоСтатьяРасходовРаспределенияЗарплаты", ТипПолеФормы, Группа);
		Элемент.ПутьКДанным = "Объект.упоСтатьяРасходовРаспределенияЗарплаты";
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.Ширина = 28;
		Элемент.Заголовок = НСтр("ru = 'Статья для отнесения заработной платы по проектам'");
		
		ДобавитьБлокЭлементовСтраховыеВзносы(Группа);
		
	КонецЕсли;
	
	УстановитьВидимостьГруппыВзносы(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьБлокЭлементовСтраховыеВзносы(ЭлементРодитель)
	
	ТипГруппаФормы = Тип("ГруппаФормы");
	ТипПолеФормы = Тип("ПолеФормы");
	ТипДекорацияФормы = Тип("ДекорацияФормы");
	
	// Страховые взносы: основной контейнер
	ГруппаСтраховыеВзносы = Элементы.Вставить("упоСтраховыеВзносы", ТипГруппаФормы, ЭлементРодитель);
	ГруппаСтраховыеВзносы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСтраховыеВзносы.Заголовок = НСтр("ru = 'Страховые взносы'");
	ГруппаСтраховыеВзносы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаСтраховыеВзносы.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаСтраховыеВзносы.ОтображатьЗаголовок = Ложь;
	
	// Переключатель
	
	// Контейнер элементов
	ГруппаПереключатель = Элементы.Вставить("упоСтраховыеВзносыПереключатель", ТипГруппаФормы, ГруппаСтраховыеВзносы);
	ГруппаПереключатель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПереключатель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	ГруппаПереключатель.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаПереключатель.ОтображатьЗаголовок = Ложь;
	
	//
	ЭлементНадпись = Элементы.Вставить("упоСтраховыеВзносыПереключательНадпись", ТипДекорацияФормы, ГруппаПереключатель);
	ЭлементНадпись.Вид = ВидДекорацииФормы.Надпись;
	ЭлементНадпись.Заголовок = НСтр("ru = 'Отражение страховых взносов:'");
	
	//
	ЭлементПереключатель = Элементы.Вставить("упоРежимУчетаВзносов", ТипПолеФормы, ГруппаПереключатель);
	ЭлементПереключатель.ПутьКДанным = "Объект.упоРежимУчетаВзносов";
	ЭлементПереключатель.Вид = ВидПоляФормы.ПолеПереключателя;
	ЭлементПереключатель.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементПереключатель.Подсказка = НСтр("ru = 'Признак различного отражения зарплаты и взносов'");
	ЭлементПереключатель.УстановитьДействие("ПриИзменении", "Подключаемый_упоРежимУчетаВзносовПриИзменении");
	
	ЭлементПереключатель.СписокВыбора.Очистить();
	ЭлементПереключатель.СписокВыбора.Добавить(0, НСтр("ru = 'по статье начислений'"));
	ЭлементПереключатель.СписокВыбора.Добавить(1, НСтр("ru = 'по единой статье для всех фондов'"));
	
	// Статья
	
	// Контейнер элементов
	ГруппаСтатья = Элементы.Вставить("упоСтраховыеВзносыСтатья", ТипГруппаФормы, ГруппаСтраховыеВзносы);
	ГруппаСтатья.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСтатья.Заголовок = НСтр("ru = 'Страховые взносы'");
	ГруппаСтатья.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаСтатья.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаСтатья.ОтображатьЗаголовок = Ложь;
	
	//
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(Новый ПараметрВыбора("ДополнитьСтатьямиРасходов", Истина));
	НовыйМассив.Добавить(Новый ПараметрВыбора("ДополнитьСтатьямиАктивовПассивов", Истина));
	мПараметрыВыбора = Новый ФиксированныйМассив(НовыйМассив);
	
	ЭлементСтатья = Элементы.Вставить("упоСтатьяРасходовВзносов", ТипПолеФормы, ГруппаСтатья);
	ЭлементСтатья.ПутьКДанным = "Объект.упоСтатьяРасходовВзносов";
	ЭлементСтатья.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементСтатья.Заголовок = НСтр("ru = 'Взносы'");
	ЭлементСтатья.Ширина = 20;
	ЭлементСтатья.КнопкаВыпадающегоСписка = Истина;
	ЭлементСтатья.КнопкаОткрытия = Истина;
	ЭлементСтатья.ВыбиратьТип = Ложь;
	ЭлементСтатья.АвтоОтметкаНезаполненного = Истина;
	ЭлементСтатья.БыстрыйВыбор = Ложь;
	ЭлементСтатья.РастягиватьПоГоризонтали = Ложь;
	ЭлементСтатья.ПараметрыВыбора = мПараметрыВыбора;
	ЭлементСтатья.УстановитьДействие("НачалоВыбора", "Подключаемый_упоСтатьяРасходовВзносовНачалоВыбора");
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_упоРежимУчетаВзносовПриИзменении(Элемент)

	Объект["упоСтатьяРасходовВзносов"] = ПредопределенноеЗначение("ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка");
	УстановитьВидимостьГруппыВзносы(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_упоСтатьяРасходовВзносовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	
	ДополнительныеПараметры = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("упоСтатьяРасходовВзносовВыборЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Статья", Объект["упоСтатьяРасходовВзносов"]);
	ПараметрыФормы.Вставить("ПараметрыВыбора", Элемент.ПараметрыВыбора);
	
	ИмяФормыВыбораСтатьи = "ОбщаяФорма.ФормаВыбораСтатьи";
	ОткрытьФорму(ИмяФормыВыбораСтатьи, ПараметрыФормы, ЭтаФорма, , , , ОписаниеОповещения);

КонецПроцедуры 

&НаКлиенте
Процедура упоСтатьяРасходовВзносовВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект["упоСтатьяРасходовВзносов"] = Результат;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыВзносы(Форма)
	
	ЕстьЭлементФормы = Форма.Элементы.Найти("упоСтраховыеВзносыПереключатель");
	
	Если НЕ ЕстьЭлементФормы = Неопределено Тогда
		Форма.Элементы["упоСтраховыеВзносыСтатья"].Видимость = Форма.Объект["упоРежимУчетаВзносов"] = 1;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаСервереБезКонтекста
Функция РасчетныйПриоритет(Проект)
	
	Приоритет = 0;
	
	Если Не ЗначениеЗаполнено(Проект) Тогда
		Возврат Приоритет;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Т.Балл КАК Балл
	               |ИЗ
	               |	РегистрСведений.упоСоответствиеСтратегическимЦелям.СрезПоследних(, Проект = &Проект) КАК Т";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Приоритет;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Приоритет = Выборка.Балл;
	
	Возврат Приоритет;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьЗначениеМасштабаСхемыФаз(МасштабСхемы, СсылкаНаОбъект)
	
	КлючОбъекта = "Справочник.Проекты";
	КлючНастроек = "МасштабСхемы" + СсылкаНаОбъект.УникальныйИдентификатор();
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, МасштабСхемы);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьСохраненноеЗначениеМасштабаСхемыФаз(МасштабСхемы, СсылкаНаОбъект)
	
	КлючОбъекта = "Справочник.Проекты";
	КлючНастроек = "МасштабСхемы" + СсылкаНаОбъект.УникальныйИдентификатор();
	
	ПолученноеЗначение = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек);
	
	Если ПолученноеЗначение <> Неопределено Тогда
		МасштабСхемы = ПолученноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьОпцииТрансляцииПроектныхЗадачПоПроектнымОпциям(Отказ)
	
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Объект.Ссылка);
	ПроверяемыеПроектныеОпции = ПроверяемыеПроектныеОпции();
	
	ОтключаемыеОпцииТрансляции = Новый Массив;
	
	Для Каждого ПроверяемаяОпция Из ПроверяемыеПроектныеОпции Цикл
		ИмяПроектнойОпции = ПроверяемаяОпция.Ключ;
		Если СвойстваПроекта[ИмяПроектнойОпции] И НЕ ПроверяемаяОпция.Значение Тогда
			ИмяСвязаннойОпцииТрансляции = ИмяСвязаннойОпцииТрансляцииПоПроектнойОпции(ПроверяемаяОпция.Ключ);;
			Если Не ЗначениеЗаполнено(ИмяСвязаннойОпцииТрансляции) Тогда
				Продолжить;
			КонецЕсли;
			ОтключаемыеОпцииТрансляции.Добавить(ИмяСвязаннойОпцииТрансляции);
		КонецЕсли;
	КонецЦикла;
	
	упоАктуализацияПроектаВызовСервера.ОтключитьОпцииТрансляцииТабличныхЧастейЗадачПроекта(Объект.Ссылка, ОтключаемыеОпцииТрансляции, Отказ);
	
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка отключения проектных опций. Не удалось отключить связанные данные трансляции.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяСвязаннойОпцииТрансляцииПоПроектнойОпции(ИмяПроектнойОпции)
	
	Если ИмяПроектнойОпции = "ДоходыПоНатуральнымПоказателям" Тогда
		ИмяОпцииТрансляции = "ВключитьСубпродуктыВПланДоходов";
	ИначеЕсли ИмяПроектнойОпции = "ПланироватьЗатратыНаМатериалы" Тогда
		ИмяОпцииТрансляции = "ВключитьМатРесурсыВПланРасходов";
	ИначеЕсли ИмяПроектнойОпции = "ПланироватьТрудозатратыПоПроекту" Тогда
		ИмяОпцииТрансляции = "ВключитьТрудРесурсыВПланРасходов";
	ИначеЕсли ИмяПроектнойОпции = "ПланироватьДополнительныеЗатратыПоЗадаче" Тогда
		ИмяОпцииТрансляции = "ВключитьДопЗатратыВПланРасходов";
	ИначеЕсли ИмяПроектнойОпции = "ВедетсяБюджетДоходов" Тогда
		ИмяОпцииТрансляции = "ВключитьПланДоходовВБДДС";
	ИначеЕсли ИмяПроектнойОпции = "ВедетсяБюджетРасходов" Тогда
		ИмяОпцииТрансляции = "ВключитьПланРасходовВБДДС";
	Иначе
		ИмяОпцииТрансляции = "";
	КонецЕсли;
	
	Возврат ИмяОпцииТрансляции;
	
КонецФункции

&НаСервере
Функция ПроверяемыеПроектныеОпции()
	
	ПроверяемыеОпции = Новый Структура;
	ПроверяемыеОпции.Вставить("ПланироватьЗатратыНаМатериалы");
	ПроверяемыеОпции.Вставить("ДоходыПоНатуральнымПоказателям");
	ПроверяемыеОпции.Вставить("ПланироватьДополнительныеЗатратыПоЗадаче");
	ПроверяемыеОпции.Вставить("ПланироватьТрудозатратыПоПроекту");
	ПроверяемыеОпции.Вставить("ВедетсяБюджетДвиженияДенежныхСредств");
	ПроверяемыеОпции.Вставить("ВедетсяБюджетДоходов");
	ПроверяемыеОпции.Вставить("ВедетсяБюджетРасходов");
	ЗаполнитьЗначенияСвойств(ПроверяемыеОпции, ЭтаФорма);
	
	Возврат ПроверяемыеОпции;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойствоЭлементаФормы(ЭлементыФормы, ИмяЭлемента, ИмяСвойства, Значение)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭлементыФормы, ИмяЭлемента, ИмяСвойства, Значение);
	
КонецПроцедуры

#КонецОбласти
