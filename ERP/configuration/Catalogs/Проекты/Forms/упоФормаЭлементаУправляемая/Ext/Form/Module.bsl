&НаКлиенте
Процедура КомандаСменаСтатуса(Команда)
	
	НажатаКнопка = ЭтаФорма.ТекущийЭлемент;
	Если ТипЗнч(НажатаКнопка) <> Тип("КнопкаФормы") Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда 
		ПараметрыЗаписи = Новый Структура();       
		ПараметрыЗаписи.Вставить("ПроектныеОпцииПроверены", Ложь);
		ПараметрыЗаписи.Вставить("НеРегистрироватьПроект", Истина);
		Записать(ПараметрыЗаписи);
	КонецЕсли;
	
	Если Модифицированность Тогда
		ТекстПредупреждения = НСтр("ru = 'Данные проекта изменены. Для продолжения необходимо записать проект.'");
		упоРаботаСДиалогамиКлиент.упоПредупреждение(ТекстПредупреждения, 120);
		Возврат;	
	КонецЕсли;	
	
	ВыбранныйСтатус = упоПроектыИЗадачиОбщие.ПолучитьСтатусПоИмениКнопки(НажатаКнопка.Имя);
	упоПроектыИЗадачиКлиент.ИзменитьСтатус(СтатусПроекта, ВыбранныйСтатус, РегистраторТекущегоСтатуса, Объект.Ссылка);		
		
КонецПроцедуры

