&НаКлиенте
Функция упоНастройкаПоказателейДляКарточкиПроектовОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(упоНастройкаПоказателейДляКарточкиПроектовНастройка) = Тип("Структура") Тогда
		ПредНастройки = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(упоНастройкаПоказателейДляКарточкиПроектовНастройка);
	Иначе
		ПредНастройки = Неопределено;
	КонецЕсли;
	
	упоПанельПоказателейКлиент.упоНастройкаПоказателейДляКарточкиПроектовОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора);
	
	НовыеНастройки = упоНастройкаПоказателейДляКарточкиПроектовНастройка;
		
	НужноОбновить = Ложь;	
	Если ТипЗнч(НовыеНастройки) <> Тип("Структура") Тогда
		Если ТипЗнч(ПредНастройки) = Тип("Структура") Тогда	
			НужноОбновить = Истина;
		КонецЕсли;
	Иначе
		Если ТипЗнч(ПредНастройки) <> Тип("Структура") Тогда	
			НужноОбновить = Истина;
		Иначе
			Для Каждого КлючЗначение Из НовыеНастройки Цикл
				Значение = КлючЗначение.Значение;
				ПредЗначение = Неопределено;
				ПредНастройки.Свойство(КлючЗначение.Ключ, ПредЗначение);
				Если ПредЗначение <> Значение Тогда
					НужноОбновить = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли; 
	КонецЕсли;
	
	Если НужноОбновить Тогда
		ОбновитьПредставлениеПоказателейПроекта();
	КонецЕсли;
	
КонецФункции

