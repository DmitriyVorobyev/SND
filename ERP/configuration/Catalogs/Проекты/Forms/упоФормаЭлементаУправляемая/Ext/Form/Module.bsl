Процедура КомандаСделатьФазуТекущей(Команда)
	
	ТекДанные = Элементы.Фазы.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		Если ТекДанные.Фаза = Объект.упоТекущаяФаза Тогда
			Объект.упоТекущаяФаза = ПредопределенноеЗначение("Справочник.упоФазыПроектов.ПустаяСсылка");
		Иначе
			Объект.упоТекущаяФаза = ТекДанные.Фаза;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьПредставлениеТекущейФазы(ЭтаФорма);
	ОбновитьСхемуФазПроектаКлиент();
	
