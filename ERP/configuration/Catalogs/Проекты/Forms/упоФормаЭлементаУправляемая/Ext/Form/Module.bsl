	ФП_УчитыватьСроки = Не ФП_УчитыватьСроки;	
	Элементы.ФП_КомандаУчитыватьСроки.Пометка = ФП_УчитыватьСроки;
	
	Элементы.ГруппаФП_Периодичность.Видимость = ФП_УчитыватьСроки;
	СменитьНастройкуПериодаФаз(?(ФП_УчитыватьСроки,"ФП_ПериодичностьГод", ""));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроектныеРешенияВехи(Команда)
	ТекДанные = Элементы.Фазы.ТекущиеДанные;
	Если ТекДанные <> Неопределено И ЗначениеЗаполнено(ТекДанные.ВехаЗеркало) Тогда
		
		ВехаПЗ = упоПроектыИЗадачиВызовСервера.НайтиСвязанныйЭлементПроекта(ТекДанные.ВехаЗеркало);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СвязаннаяСсылка", ВехаПЗ);
		ПараметрыФормы.Вставить("ВидЗадания", ПредопределенноеЗначение("Справочник.упоВидыЗаданий.ПроектноеРешение"));
		
		ОткрытьФорму("Обработка.упоРаботаСЗаданиями.Форма", ПараметрыФормы,,
			"ПроектныеРешения" + Строка(ВехаПЗ.УникальныйИдентификатор()));	
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаИндикаторПоФазе(Команда)
	СтраницаДополнительно = Элементы.Найти("СтраницаДополнительно");	
	ПанельФормы = Элементы.Найти("ПанельФормы");
	Если СтраницаДополнительно <> Неопределено И ПанельФормы <> Неопределено Тогда
		ПанельФормы.ТекущаяСтраница = СтраницаДополнительно;
		ЭлементОсновнойИндикаторПоФазе = Элементы.Найти("упоОсновнойИндикаторПоФазе");
		Если ЭлементОсновнойИндикаторПоФазе <> Неопределено Тогда
			ЭтаФорма.ТекущийЭлемент = ЭлементОсновнойИндикаторПоФазе;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьТаблицуФазПоСтруктуре(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Фазы.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьТаблицуФазПоСтруктуреЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Очистить и заполнить таблицу фаз по структуре?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьТаблицуФазПоСтруктуреКлиент();
	КонецЕсли;
	
КонецПроцедуры

