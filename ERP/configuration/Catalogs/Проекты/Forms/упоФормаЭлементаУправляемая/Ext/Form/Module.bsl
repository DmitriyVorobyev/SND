&НаСервереБезКонтекста
Функция ПолучитьТаблицуФазПоСтруктуре(Проект, ТекущаяВерсия)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;	
	Запрос.УстановитьПараметр("ТекущаяВерсия", ТекущаяВерсия);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проекты.Ссылка КАК ВехаЗеркало,
	|	упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель КАК ЗадачаРодитель,
	|	ПроектыРодители.Ссылка КАК ЗадачаРодительЗеркало,
	|	Проекты.КодСДР КАК КодСДР
	|ИЗ
	|	РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &ТекущаяВерсия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача = Проекты.СсылкаНаПроектнуюЗадачу
	|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК ПроектыРодители
	|		ПО упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = ПроектыРодители.СсылкаНаПроектнуюЗадачу
	|			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаРодитель = ЗНАЧЕНИЕ(Документ.упоПроектнаяЗадача.ПустаяСсылка))
	|ГДЕ
	|	НЕ Проекты.ПометкаУдаления
	|	И упоСвойстваПроектныхЗадачСрезПоследних.ЭтоВеха
	|	И упоСвойстваПроектныхЗадачСрезПоследних.ВидОперации.ВоротаКачества
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодСДР";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураФазы = Новый Структура;
		СтруктураФазы.Вставить("ВехаЗеркало", Выборка.ВехаЗеркало);
		НаименованиеФазы = "" + Выборка.ЗадачаРодительЗеркало;
		Фаза = Справочники.упоФазыПроектов.НайтиПоНаименованию(НаименованиеФазы, Истина, , Проект);
		Если Не ЗначениеЗаполнено(Фаза) Тогда
			ФазаОб = Справочники.упоФазыПроектов.СоздатьЭлемент();
			ФазаОб.Владелец = Проект;
			ФазаОб.Наименование = НаименованиеФазы;
			ФазаОб.ПолноеНаименование = ФазаОб.Наименование;
			ФазаОб.Записать();
			Фаза = ФазаОб.Ссылка;
		КонецЕсли;
		СтруктураФазы.Вставить("Фаза", Фаза);
		Результат.Добавить(СтруктураФазы);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбновитьПредставлениеПоказателейПроектаПриНеобходимости()
	
	Если НЕ ПоказателиСформированы И Элементы.ПанельФормы.ТекущаяСтраница = Элементы.СтраницаПоказатели Тогда
		ОбновитьПредставлениеПоказателейПроекта();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставлениеПоказателейПроекта()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ПоказателиСформированы = Истина;
	
	ТекстШаблона = Справочники.Проекты.ПолучитьМакет("упоМакетПредставленияПоказателейПроекта").ПолучитьТекст();
	упоПанельПоказателейВызовСервера.ПолучитьСписокВсехПоказателей(ЭтаФорма);
	
	Настройка = Неопределено;
	КлючНастройки = Неопределено;
	ПользовательНастройки = Неопределено;
	
	Если Не НастройкиУчетаПоПодразделениямЗагружены Тогда
		ЗаполнитьНастройкиУчетаПоПодразделениям();
	КонецЕсли;
	
	Если ТипЗнч(упоНастройкаПоказателейДляКарточкиПроектовНастройка) <> Тип("Структура") Тогда
		НастройкаПоказателейДляКарточкиПроектов = Константы.упоНастройкаПоказателейДляКарточкиПроектов.Получить(); 
		Если ТипЗнч(НастройкаПоказателейДляКарточкиПроектов) = Тип("ХранилищеЗначения") Тогда
			упоНастройкаПоказателейДляКарточкиПроектовНастройка = НастройкаПоказателейДляКарточкиПроектов.Получить();
		Иначе
			упоНастройкаПоказателейДляКарточкиПроектовНастройка = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	упоПанельПоказателейКлиентСервер.СформироватьПредставлениеДляНастройкиПоказателейКарточекПроектов(ЭтаФорма);
	
	Если упоНастройкаПоказателейДляКарточкиПроектовНастройка <> Неопределено Тогда
		КлючНастройки = упоНастройкаПоказателейДляКарточкиПроектовНастройка.КлючНастроек;
		ПользовательНастройки = упоНастройкаПоказателейДляКарточкиПроектовНастройка.Пользователь;		
	КонецЕсли; 
	
	Если КлючНастройки <> Неопределено И КлючНастройки <> "" Тогда
		УстановитьПривилегированныйРежим(Истина);
		Настройка = ХранилищеОбщихНастроек.Загрузить("Обработка.упоПанельПоказателей", КлючНастройки,, ПользовательНастройки);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;	
	
	Если Настройка = Неопределено ИЛИ НЕ Настройка.Свойство("СтруктураПоказателей") Тогда
		ПанельПоказателейПроекта = "";
		Возврат;
	КонецЕсли;
	
	Для Каждого Эл Из ТаблицаПоказателей Цикл
		Эл.Использовать = Ложь;	
	КонецЦикла;
	
	НомерПозиции = 0;
	Для Каждого ЭлементПоказателей Из Настройка.СтруктураПоказателей.ВключенныеПоказатели Цикл
		
		Если ЗначениеЗаполнено(ЭлементПоказателей.Код) Тогда
			
			РезПоиска = ТаблицаПоказателей.НайтиСтроки(Новый Структура("Показатель", ЭлементПоказателей));
			Если РезПоиска.Количество() > 0 Тогда
				РезПоиска[0].Использовать = Истина;	
				
				// Восстановим порядок вывода показателей.
				НомерПозиции = НомерПозиции + 1;
				ТекНомерПозиции = ТаблицаПоказателей.Индекс(РезПоиска[0]) + 1;
				ТаблицаПоказателей.Сдвинуть(ТекНомерПозиции - 1, -(ТекНомерПозиции - НомерПозиции));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеТаблицы = "";
	
	КоличествоСтрокВКолонкеПанелиПоказателей = 0;
	КоличествоСтрокВКолонкеПанелиПоказателей = ?(КоличествоСтрокВКолонкеПанелиПоказателей = 0, 4, КоличествоСтрокВКолонкеПанелиПоказателей);
	СчетчикСтрок = 1;
	
	СтрокиИспользуемыхПоказателей = ТаблицаПоказателей.НайтиСтроки(Новый Структура("Использовать", Истина));
		
	МасПоказатели = Новый Массив;
	Для Каждого Строка Из СтрокиИспользуемыхПоказателей Цикл
		МасПоказатели.Добавить(Строка.Показатель);
	КонецЦикла;
	
	Проекты = Новый Массив;
	Проекты.Добавить(Объект.Ссылка);
	
	ЗначенияПоказателейПроекта = упоПоказателиПроектовСервер.ПолучитьЗначенияПоказателей(МасПоказатели, Проекты);
	
	Для Каждого СтрокаПоказателя Из СтрокиИспользуемыхПоказателей Цикл
		
		Если Не СтрокаПоказателя.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		Если СчетчикСтрок = 1 Тогда			
			ДанныеТаблицы = ДанныеТаблицы + "<div><table>";			
		КонецЕсли;
		
		НаименованиеПоказателя = СтрокаПоказателя.Наименование;		
		ЗначениеПоказателя = упоПоказателиПроектовСервер.ПолучитьЗначениеПоказателяПроекта(ЗначенияПоказателейПроекта,
			СтрокаПоказателя.Показатель, Объект.Ссылка);		
		ФорматЗначениеПоказателя = Формат(ЗначениеПоказателя, СтрокаПоказателя.ФорматнаяСтрока);
		
		ДанныеТаблицы = ДанныеТаблицы + "<tr><th>" + НаименованиеПоказателя + "</th>";
		ДанныеТаблицы = ДанныеТаблицы + "<td>" + ФорматЗначениеПоказателя + "</td></tr>";
		
		СчетчикСтрок = СчетчикСтрок + 1;
		
		Если СчетчикСтрок > КоличествоСтрокВКолонкеПанелиПоказателей Тогда			
			ДанныеТаблицы = ДанныеТаблицы + "</table></div>";
			СчетчикСтрок = 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не СтрЗаканчиваетсяНа(ДанныеТаблицы, "</table></div>") Тогда
		ДанныеТаблицы = ДанныеТаблицы + "</table></div>";		
	КонецЕсли;
	
	ПанельПоказателейПроекта = СтрЗаменить(ТекстШаблона, "ДАННЫЕ_ТАБЛИЦЫ", ДанныеТаблицы);
	
КонецПроцедуры

&НаСервере
Процедура ОтрисоватьПанельСтатусов()
	
	упоПроектыИЗадачиСервер.ОтрисоватьЭлементыФормы(Элементы, "ПанельСтатусовПроекта", , "Горизонтальная");			
	упоПроектыИЗадачиСервер.ОбработкаСменыСтатусаПроекта(ЭтаФорма, Элементы, Объект.Ссылка, СтатусПроекта, "СтатусПроекта");
	
КонецПроцедуры // ОтрисоватьПанельСтатусов()

&НаСервере
Процедура ОбработкаОповещенияСменыСтатуса()
	
	упоПроектыИЗадачиСервер.ОбработкаСменыСтатусаПроекта(ЭтаФорма, Элементы, Объект.Ссылка, СтатусПроекта, "СтатусПроекта");
		
КонецПроцедуры // ОбработкаОповещенияСменыСтатуса()

&НаСервереБезКонтекста
Функция ЦветПроектаСервер(ЦветПроекта)
	
	Возврат упоФункцииОбщегоНазначенияСервер.ОписаниеЦвета(ЦветПроекта, 3);
	
КонецФункции

#Область ДопИзменяемыеДанные

&НаСервере
Процедура ЗагрузитьДопИзменяемыеДанные()
	
	ЗагрузитьПрогнозныеСроки();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПрогнозныеСроки()
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;	
	КонецЕсли;
	
	МодульупоПрогнозныеСроки = ОбщегоНазначения.ОбщийМодуль("упоПрогнозныеСроки");
	
	ДнныеСроков = МодульупоПрогнозныеСроки.ПолучитьПрогнозныеСрокиПроекта(Объект.Ссылка);

	МассивРеквизитов = МодульупоПрогнозныеСроки.ПолучитьМассивИменРеквизитовПрогнозныхСроков();
	Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл
		ЭтаФорма[ИмяРеквизита] = ДнныеСроков[ИмяРеквизита];
	КонецЦикла;	
	
	ЗаполнитьПрогнозныеСрокиДоИзменения();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьДопИзменяемыеДанные()
	
	ЗаписатьПрогнозныеСроки();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПрогнозныеСроки()
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		Возврат;	
	КонецЕсли;
	
	МодульупоПрогнозныеСроки = ОбщегоНазначения.ОбщийМодуль("упоПрогнозныеСроки");
	
	МассивРеквизитов = МодульупоПрогнозныеСроки.ПолучитьМассивИменРеквизитовПрогнозныхСроков();
	
	//
	
	СтрокаИменРеквизитов = СтрСоединить(МассивРеквизитов, ",");	
	СтруктураРеквизитовДоИзменения = Новый Структура(СтрокаИменРеквизитов);
	
	СтрокиДанныхДоИзменения = ТаблицаДанныхДоИзменения.НайтиСтроки(Новый Структура("ВидДанных", "ПрогнозныеСроки"));
	Для Каждого СтрокаДанныхДоИзменения Из СтрокиДанныхДоИзменения Цикл		
		СтруктураРеквизитовДоИзменения[СтрокаДанныхДоИзменения.ИмяРеквизита] = СтрокаДанныхДоИзменения.Значение;		
	КонецЦикла;	
	
	//
	
	СтруктураНовыхЗначений = Новый Структура(СтрокаИменРеквизитов);
	ЕстьИзменения = Ложь;
	Для Каждого КлючЗначение Из СтруктураРеквизитовДоИзменения Цикл
		ЗначениеДоЗаписи = КлючЗначение.Значение;
		НовоеЗначение = ЭтаФорма[КлючЗначение.Ключ];
		Если Не ЗначениеЗаполнено(ЗначениеДоЗаписи) И Не ЗначениеЗаполнено(НовоеЗначение) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураНовыхЗначений[КлючЗначение.Ключ] = НовоеЗначение;
		Если ЗначениеДоЗаписи <> НовоеЗначение Тогда
			ЕстьИзменения = Истина;
		КонецЕсли;
	КонецЦикла;
	
	//
	
	Если Не ЕстьИзменения Тогда
		Возврат;
	КонецЕсли;
	
	МодульупоПрогнозныеСроки.ЗаписатьПрогнозныеСрокиПроекта(Объект.Ссылка, СтруктураНовыхЗначений);	
	
	//
	
	ЗаполнитьПрогнозныеСрокиДоИзменения();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьТаблицуДанныхДоИзменения(ВидДанных = Неопределено)
	
	Если ВидДанных = Неопределено Тогда
		ТаблицаДанныхДоИзменения.Очистить();
	Иначе
		НайденныеСтроки = ТаблицаДанныхДоИзменения.НайтиСтроки(Новый Структура("ВидДанных", ВидДанных));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ТаблицаДанныхДоИзменения.Удалить(НайденнаяСтрока);	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПрогнозныеСрокиДоИзменения()
	
	МодульупоПрогнозныеСроки = ОбщегоНазначения.ОбщийМодуль("упоПрогнозныеСроки");
	
	ОчиститьТаблицуДанныхДоИзменения("ВидДанных");
	
	//
	
	МассивРеквизитов = МодульупоПрогнозныеСроки.ПолучитьМассивИменРеквизитовПрогнозныхСроков();	
	Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл
		НовыеДанныеДоИзменения = ТаблицаДанныхДоИзменения.Добавить();
		НовыеДанныеДоИзменения.ВидДанных = "ПрогнозныеСроки";
		НовыеДанныеДоИзменения.ИмяРеквизита = ИмяРеквизита;
		НовыеДанныеДоИзменения.Значение = ЭтаФорма[ИмяРеквизита];
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьДанныеПоСнятымПроектнымОпциям(Проект, ПроверяемыеОпции, ТекстСообщения)
			
	СвойстваПроекта = упоАналитикаПоПодразделениямСервер.ЗаполнитьПараметрыУчетаПоПодразделениям(Проект);	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекВерсия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(Проект));		
	Для Каждого ПроверяемаяОпция Из ПроверяемыеОпции Цикл
		Запрос.УстановитьПараметр(ПроверяемаяОпция.Ключ, СвойстваПроекта[ПроверяемаяОпция.Ключ] И Не ПроверяемаяОпция.Значение);						
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача КАК ПроектнаяЗадача
