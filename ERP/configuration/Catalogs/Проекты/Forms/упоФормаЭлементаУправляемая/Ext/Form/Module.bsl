
#Область ОписаниеПеременных

&НаКлиенте
Перем СписокГородовГеографическойСхемы;

&НаКлиенте
Перем ИзменениеЕдиницВремениПоУмолчанию;

&НаКлиенте
Перем ПроектныеОпцииПроверены;

&НаКлиенте
Перем СтраницыСОбновлением; // Страницы панели, переключение которых может потребовать обращение к серверу для обновления.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПроверкаПравДоступа(Отказ);
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	ИнициализацияФормы(Отказ, СтандартнаяОбработка);
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка);
	
	упоИнтеграция.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	Если Не Параметры.Свойство("АвтоТест") Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбновитьНадписьПоследняяМодификация();
	ОбновитьПредставлениеТекущейФазы(ЭтаФорма);
	
	упоОбработчикиСобытийКлиент.ФормаПриОткрытии(ЭтаФорма, Объект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПроектныеОпцииПроверены = Ложь;
	ИзмениласьНастройкаПоказателейДляКарточкиПроекта = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриПовторномОткрытии(ЭтаФорма, Объект, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если Не ИзмениласьНастройкаПоказателейДляКарточкиПроекта Тогда
		кэшНастройкаПоказателейДляКарточкиПроектовНастройка = упоНастройкаПоказателейДляКарточкиПроектовНастройка;
		ИзмениласьНастройкаПоказателейДляКарточкиПроекта = Истина;	
	КонецЕсли; 

	упоНастройкаПоказателейДляКарточкиПроектовОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора);
		
	упоОбработчикиСобытийКлиент.ФормаОбработкаВыбора(ЭтаФорма, ВыбранноеЗначение, ИсточникВыбора); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
		
	ДополнительныеПараметры = Новый Структура("МассивВопросов, ПараметрыЗаписи", 
										Новый Массив, ПараметрыЗаписи);
		
	// Если проектные опции не загружены, значит, пользователь не переключался на страницу опций и ничего на ней не менял. 
	// Не проверяем такую ситуацию.
	Если НастройкиУчетаПоПодразделениямЗагружены 
		И Не (ПараметрыЗаписи.Свойство("ПроектныеОпцииПроверены") И ПараметрыЗаписи.ПроектныеОпцииПроверены) Тогда
		
		ПроверяемыеОпции = ПроверяемыеПроектныеОпции();
		
		ТекстСообщения = "";
		Если ПроверитьДанныеПоСнятымПроектнымОпциям(Объект.Ссылка, ПроверяемыеОпции, ТекстСообщения) Тогда
			Отказ = Истина;
			ДобавитьВопросВОчередь(ДополнительныеПараметры.МассивВопросов, "СохранениеИзмененийПроектныхОпций", ТекстСообщения);
		Иначе
			ПараметрыЗаписи.Вставить("ПроектныеОпцииПроверены", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИзмениласьНастройкаПоказателейДляКарточкиПроекта Тогда
		Отказ = Истина;
		ДобавитьВопросВОчередь(ДополнительныеПараметры.МассивВопросов, "СохранениеИзмененийНастройкиПоказателей",
					НСтр("ru = 'Сохранить новую настройку показателей в паспорте проекта?'"));
	КонецЕсли;
	
	Если Отказ Тогда
		ЗадатьВопросПриЗаписиПроекта(ДополнительныеПараметры, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВопросВОчередь(МассивВопросов, КодВопроса, ТекстВопроса = "",
					РежимДиалога = Неопределено, Таймаут = 120, ОтветПоУмолчанию = Неопределено) 
	
	Если РежимДиалога = Неопределено Тогда
		РежимДиалога = РежимДиалогаВопрос.ДаНет;
	КонецЕсли;
	
	Если ОтветПоУмолчанию = Неопределено Тогда
		ОтветПоУмолчанию = КодВозвратаДиалога.Нет;
	КонецЕсли;		
		
	Результат = Новый Структура;
	Результат.Вставить("КодВопроса", КодВопроса); 
	Результат.Вставить("ТекстВопроса", ТекстВопроса);
	Результат.Вставить("РежимДиалога", РежимДиалога);
	Результат.Вставить("Таймаут", Таймаут);
	Результат.Вставить("ОтветПоУмолчанию", ОтветПоУмолчанию);
	
	МассивВопросов.Добавить(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросПриЗаписиПроекта(ДополнительныеПараметры, Отказ = Ложь)
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры.МассивВопросов) Тогда
		ДанныеВопроса = ДополнительныеПараметры.МассивВопросов[ДополнительныеПараметры.МассивВопросов.Количество()-1];
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОтветПриЗаписиПроекта", ЭтаФорма, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, ДанныеВопроса.ТекстВопроса, ДанныеВопроса.РежимДиалога, 
			ДанныеВопроса.Таймаут, ДанныеВопроса.ОтветПоУмолчанию);
	Иначе
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		Если Записать(ДополнительныеПараметры.ПараметрыЗаписи) 
			И ДополнительныеПараметры.ПараметрыЗаписи.Свойство("Закрыть") Тогда
			Закрыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьОтветПриЗаписиПроекта(Ответ, ДополнительныеПараметры) Экспорт
	
	ИндексПоследнегоВопроса = ДополнительныеПараметры.МассивВопросов.Количество()-1;
	ПоследнийВопрос 		= ДополнительныеПараметры.МассивВопросов[ИндексПоследнегоВопроса];

	Если ПоследнийВопрос.КодВопроса = "СохранениеИзмененийПроектныхОпций" Тогда
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ДополнительныеПараметры.ПараметрыЗаписи.Вставить("ПроектныеОпцииПроверены", Истина);
		ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
			// Запись проекта происходить не должна => Возврат.
			ДополнительныеПараметры.МассивВопросов.Удалить(ИндексПоследнегоВопроса);
			Возврат;
		КонецЕсли;
		
	ИначеЕсли ПоследнийВопрос.КодВопроса = "СохранениеИзмененийНастройкиПоказателей" Тогда
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			упоНастройкаПоказателейДляКарточкиПроектовНастройка = кэшНастройкаПоказателейДляКарточкиПроектовНастройка;
		КонецЕсли;
		кэшНастройкаПоказателейДляКарточкиПроектовНастройка = Неопределено;
		ИзмениласьНастройкаПоказателейДляКарточкиПроекта = Ложь;
		
	КонецЕсли;
	
	ДополнительныеПараметры.МассивВопросов.Удалить(ИндексПоследнегоВопроса);
	ЗадатьВопросПриЗаписиПроекта(ДополнительныеПараметры);
	 
КонецПроцедуры	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	ТекущийОбъект.лмПроверитьЗаполнениеРеквизитов(Отказ);
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ЭтоНовый", Не ЗначениеЗаполнено(Объект.Ссылка));
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьДопИзменяемыеДанные();
	
	ОтключитьОпцииТрансляцииПроектныхЗадачПоПроектнымОпциям(Отказ);
	
	упоОбработчикиСобытийСервер.ФормаПриЗаписиНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
	
	упоОбработчикиСобытийСервер.ФормаПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	ЗаполнитьПараметрыДинамическихСписков();
	
	ОткрытиеЗаписьНового = Ложь;
	ТекущийОбъект.ДополнительныеСвойства.Свойство("ЭтоНовый", ОткрытиеЗаписьНового); 
	ЗаполнитьДанныеПроектаНаФорме(ОткрытиеЗаписьНового);
	
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма, Объект);
			
	Если НастройкиУчетаПоПодразделениямЗагружены Тогда
		упоАналитикаПоПодразделениямСервер.ОбъектНастроекПослеЗаписиНаСервере(ЭтаФорма, Объект);
	КонецЕсли;
	
	ОбновитьСтартовуюФазу();
	ИсправитьТаблицуФаз(ЭтаФорма);
	
	ОбновитьПредставлениеПоказателейПроектаПриНеобходимости();
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	
	ОбновитьНадписьПоследняяМодификация();
	упоОбработчикиСобытийКлиент.ФормаПослеЗаписи(ЭтаФорма);
	
	Если ПараметрыЗаписи.Свойство("НеРегистрироватьПроект") Тогда
		ЗарегистрироватьПроект = Ложь;
	КонецЕсли;
	
	Если ЗарегистрироватьПроект Тогда
		ЗарегистрироватьПроект = Ложь; 
		ВыполнитьРегистрациюПроекта();
	КонецЕсли;
	
	Оповестить("СменаНастроекУчетаПодразделений");
	
	Если ЗначениеЗаполнено(ИзменениеЕдиницВремениПоУмолчанию) Тогда
		Если ИзменениеЕдиницВремениПоУмолчанию Тогда
			Оповестить("ИзменениеЕдиницВремениПоУмолчанию", , Объект.Ссылка);
			ИзменениеЕдиницВремениПоУмолчанию = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;	
	КонецЕсли;
	
	СохранитьЗначениеМасштабаСхемыФаз(МасштабСхемы, Объект.Ссылка);
	
	упоОбработчикиСобытийКлиент.ФормаПередЗакрытием(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка);
	
	Если Модифицированность Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
        Оповещение = Новый ОписаниеОповещения("ВопросПередЗакрытиемЗавершение", ЭтотОбъект);
        ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗакрытиемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПараметрыЗаписи = Новый Структура();
		ПараметрыЗаписи.Вставить("Закрыть", Истина);
		ПараметрыЗаписи.Вставить("ПроектныеОпцииПроверены", Ложь);
		Если Записать(ПараметрыЗаписи) Тогда
			Закрыть();
		КонецЕсли;
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	упоОбработчикиСобытийКлиент.ФормаПриЗакрытии(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаОповещения(ЭтаФорма, Объект, ИмяСобытия, Параметр, Источник);
	
	Если Параметр = Объект.Ссылка Тогда
		
		Если ИмяСобытия = "ИзменениеТекущегоПроекта" Тогда
			Возврат; // Смена текущего проекта в системе не отражается на составе элементов открытого проекта.
		ИначеЕсли ИмяСобытия = "ИзменилисьПоказателиПроекта" Тогда 
			Элементы.Показатели.Обновить();
		ИначеЕсли ИмяСобытия = "СменаСтатусаПроекта" Тогда
			ОбработкаОповещенияСменыСтатуса();
		КонецЕсли;
		
		ЗаполнитьДанныеПроектаНаФорме(Ложь);
		
	КонецЕсли;
	
	Если ИмяСобытия = "ЗаписьФазы" И ФазыИспользуются Тогда
		ОбновитьПредставлениеТекущейФазы(ЭтаФорма);
	КонецЕсли;
	
	УстановитьВидимостьДоступностьЭлементов(ЭтаФорма, Объект, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	упоОбработчикиСобытийКлиент.ФормаВнешнееСобытие(ЭтаФорма, Объект, Источник, Событие, Данные);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПередЗагрузкойДанныхИзНастроекНаСервере(ЭтаФорма, Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	упоОбработчикиСобытийСервер.ФормаПриЗагрузкеДанныхИзНастроекНаСервере(ЭтаФорма, Объект, Настройки);
	
