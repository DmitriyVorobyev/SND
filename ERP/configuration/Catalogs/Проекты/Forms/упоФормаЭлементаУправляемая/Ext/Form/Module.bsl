&НаСервереБезКонтекста
Функция ПолучитьСписокГородовГеографическойСхемыСервер()
	Результат = Новый СписокЗначений;
	МассивГородов = Константы.упоСписокВыбораГородовГеографическойСхемы.Получить().Получить();
	Результат.ЗагрузитьЗначения(МассивГородов);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ПолучитьСписокГородовГеографическойСхемыКлиент()
	Если СписокГородовГеографическойСхемы = Неопределено Тогда
		СписокГородовГеографическойСхемы = ПолучитьСписокГородовГеографическойСхемыСервер(); 	
	КонецЕсли;
	Возврат СписокГородовГеографическойСхемы;
КонецФункции
 
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеГородаГеографическойСхемы(ЭтаФорма, пГород = Неопределено)
		
	Если пГород <> Неопределено Тогда
		НужныйГород = пГород;		
	Иначе
		НужныйГород = ЭтаФорма.Объект.упоГородПроекта;		
	КонецЕсли;
	Если ЗначениеЗаполнено(НужныйГород) Тогда	
		ЭтаФорма.Элементы.упоГородПроекта.СписокВыбора.Добавить(НужныйГород, НужныйГород);	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеОповещенияОРегистрацииПроекта(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		
		ЗарегистрироватьПроект = Ложь;
		
		ПроектЗаписан = Записать();
		
		Если ПроектЗаписан Тогда
			ВыполнитьРегистрациюПроекта();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРегистрациюПроекта()
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.упоРегистрацияПроекта.ФормаОбъекта", ПараметрыЗаполнения);
	
	упоПроектыИЗадачиКлиент.УстановитьПроектТекущим(Объект.Ссылка, ЭтаФорма);
	
КонецПроцедуры	

&НаКлиенте
Функция ПроверитьСуществованиеВехиВТаблице(Веха, ТекСтрока, ТекстОшибки = Неопределено, СтандартнаяОбработка = Неопределено)
	
	Если ТекстОшибки = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Выбранная веха уже добавлена в таблицу'");
	КонецЕсли;
	
	ВехаУжеВТаблице = Ложь;
	Для Каждого СтрокаФаз Из Объект.Фазы Цикл
		Если СтрокаФаз.ВехаЗеркало = Веха И СтрокаФаз.НомерСтроки <> ТекСтрока.НомерСтроки Тогда
			ВехаУжеВТаблице = Истина;				
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ВехаУжеВТаблице Тогда
		СтандартнаяОбработка = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецФункции 

&НаКлиенте
Функция ПроверитьСуществованиеФазыВТаблице(Фаза, ТекСтрока, ТекстОшибки = Неопределено, СтандартнаяОбработка = Неопределено)
	
	Если ТекстОшибки = Неопределено Тогда
		ТекстОшибки = НСтр("ru = 'Выбранная фаза уже добавлена в таблицу'");
	КонецЕсли;
	
	ФазаУжеВТаблице = Ложь;
	Для Каждого СтрокаФаз Из Объект.Фазы Цикл
		Если СтрокаФаз.Фаза = Фаза И СтрокаФаз.НомерСтроки <> ТекСтрока.НомерСтроки Тогда
			ФазаУжеВТаблице = Истина;				
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ФазаУжеВТаблице Тогда
		СтандартнаяОбработка = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстОшибки;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецФункции 

&НаСервере
Процедура ОбновитьСхемуФазПроектаПриНеобходимости()
	
	ТекСтраница = Элементы.ПанельФормы.ТекущаяСтраница;
	
	Если Не СхемаФазСформирована И ТекСтраница = Элементы.СтраницаФазы Тогда
		ОбновитьСхемуФазПроектаСервер();
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСхемуФазПроектаСервер()
				
	СхемаФаз.Очистить();
	ФП_ТекстЗамечаний = "";
	
	//
	
	ПараметрыПостроения = Новый Структура;
	ПараметрыПостроения.Вставить("ПоказыватьИндикаторы", Истина);
	ПараметрыПостроения.Вставить("ПоказыватьПроектныеРешения", Константы.упоИспользоватьНормированиеИПроектныеРешения.Получить());
	ПараметрыПостроения.Вставить("ПоказыватьСтрелкуТекущей", Истина);
	ПараметрыПостроения.Вставить("ПропускатьПроектыБезФаз", Истина);
	ПараметрыПостроения.Вставить("ПоказыватьНадписьПроект", Ложь);
	ПараметрыПостроения.Вставить("УчитыватьСроки", ФП_УчитыватьСроки);
	ПараметрыПостроения.Вставить("Периодичность", ФП_Периодичность);
	ПараметрыПостроения.Вставить("ВыводитьВоротаКачества", ФП_ВыводитьВоротаКачества);
	ПараметрыПостроения.Вставить("ВыводитьПодписьФазы", Истина);
	ПараметрыПостроения.Вставить("ВыводитьНадписьВехи", Истина);
	ПараметрыПостроения.Вставить("ПоказатьВыполнимостьПроекта", Ложь);
	ПараметрыПостроения.Вставить("ПоказатьПоказателиПроектов", Ложь);
	ПараметрыПостроения.Вставить("ПоказыватьГруппировки", Ложь);
	ПараметрыПостроения.Вставить("ПоказыватьИсполнителейПроектныхРешений", Истина);
	ПараметрыПостроения.Вставить("ДобавочныйМасштаб", МасштабСхемы);
	
	Об = РеквизитФормыВЗначение("Объект");
	Результат = упоФазыПроектаСервер.СхемаФазПроектов(Об, ПараметрыПостроения, ФП_ТекстЗамечаний);
	Если Результат <> Неопределено Тогда
		СхемаФаз.Вывести(Результат);
	КонецЕсли;
	
	//
	
	Элементы.ФП_ТекстЗамечаний.Видимость = ЗначениеЗаполнено(ФП_ТекстЗамечаний);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеТекущейФазы(ЭтаФорма)
	Если НЕ ЭтаФорма.ФазыИспользуются Тогда
		Возврат;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.упоТекущаяФаза) Тогда
		ЭтаФорма.ТекущаяФазаПредставление = ЭтаФорма.Объект.упоТекущаяФаза;
	Иначе
		ЭтаФорма.ТекущаяФазаПредставление = упоПроектыИЗадачиОбщие.ПредставлениеПустойФазы();
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИсправитьТаблицуФаз(ЭтаФорма)
	Если НЕ ЭтаФорма.ФазыИспользуются Тогда
		Возврат;
	КонецЕсли;
	ТекМодифицированность = ЭтаФорма.Модифицированность;	
	Если ЭтаФорма.Объект.Фазы.Количество() Тогда
		ПерваяСтрока = Истина;
		Для Каждого СтрокаФазы Из ЭтаФорма.Объект.Фазы Цикл
			Если ПерваяСтрока Тогда
				Если СтрокаФазы.Фаза <> ЭтаФорма.СтартоваяФаза Тогда
					Если СтрокаФазы.Фаза = ЭтаФорма.Объект.упоТекущаяФаза Тогда
						ЭтаФорма.Объект.упоТекущаяФаза = ЭтаФорма.СтартоваяФаза;	
					КонецЕсли;
					СтрокаФазы.Фаза = ЭтаФорма.СтартоваяФаза;
				КонецЕсли;
				ПерваяСтрока = Ложь;
			Иначе
				Если СтрокаФазы.Фаза = ЭтаФорма.СтартоваяФаза Тогда
					СтрокаФазы.Фаза = ПредопределенноеЗначение("Справочник.упоФазыПроектов.ПустаяСсылка");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ЭтаФорма.Модифицированность = ТекМодифицированность;
КонецПроцедуры

&НаСервере
Функция ОбновитьСтартовуюФазу()
	Если ФазыИспользуются Тогда
		СтартоваяФаза = упоФазыПроектаСервер.ПолучитьСтартовуюФазуПроекта(Объект.Ссылка);
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПроверитьИспользованиеФаз()
	
	ФазыИспользуются = упоФазыПроектаСервер.ФазыПроектовИспользуются();
	
	Элементы.ТекущаяФазаПредставление.Видимость = ФазыИспользуются;
	Элементы.СтраницаФазы.Видимость = ФазыИспользуются;
	Элементы.упоОсновнойИндикаторПоФазе.Видимость = ФазыИспользуются;
	Если ФазыИспользуются Тогда
		ФП_ВыводитьВоротаКачества = Истина;
		Элементы.ФП_ВыводитьВоротаКачества.Пометка = Истина;
	КонецЕсли;	
	
КонецФункции

