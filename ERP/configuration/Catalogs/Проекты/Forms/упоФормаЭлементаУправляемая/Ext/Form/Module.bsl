Процедура упоКартинкаПроектаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		РасширениеФайла = упоФункцииОбщегоНазначенияВызовСервера.ПолучитьСвойствоОбъекта(ВыбранноеЗначение, "Расширение");
		
		Если СтрНайти(РасширениеФайла, "gif") = 0 
			И СтрНайти(РасширениеФайла, "jpg") = 0
			И СтрНайти(РасширениеФайла, "png") = 0
			И СтрНайти(РасширениеФайла, "bmp") = 0 Тогда
			
			СтандартнаяОбработка = Ложь;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru = 'Ошибка: выбранный формат не поддерживается'");
			Сообщение.Сообщить(); 
			
		 КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

