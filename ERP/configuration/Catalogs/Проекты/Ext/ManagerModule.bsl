// Возвращает текущий статус проекта.
//
// Параметры:
//  Проект - СправочникСсылка.Проекты - ссылка на проект.
//
// Возвращаемое значение:
//	ПеречислениеСсылка.упоСостояниеСтатусаПроекта – текущий статус проекта.
//
Функция ПолучитьСтатусПроекта(Проект) Экспорт
		
	Если Проект.Ссылка.Пустая() Тогда      
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Проект);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Рег.СтатусПроекта
	               |ИЗ
	               |	РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Статус = Результат.Выгрузить()[0].СтатусПроекта;
		Возврат Статус;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

