// Возвращает недоступность указанных ролей 
// текущего пользователя для просмотра или редактирования Проекта.
//
// Возвращаемое значение:
//  Булево - Истина, если все указанные роли недоступны.
//
Функция ЕстьОграничениеРолейНаПросмотрРедактированиеПроектов() Экспорт
	
	МассивРазрешенныхРолей = Новый Массив;
	МассивРазрешенныхРолей.Добавить("ПолныеПрава");
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоPM_Проф() Тогда
		МассивРазрешенныхРолей.Добавить("НастройкаНСИ");
	КонецЕсли;
	МассивРазрешенныхРолей.Добавить("упоЧтениеПроектов");
	МассивРазрешенныхРолей.Добавить("упоДобавлениеИзменениеПроектов");
	МассивРазрешенныхРолей.Добавить("упоТолькоПросмотр");
	
	Для каждого Элемент Из МассивРазрешенныхРолей Цикл
		Если РольДоступна(Элемент) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
	
КонецФункции

