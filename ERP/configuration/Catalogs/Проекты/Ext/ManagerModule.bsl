Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)	
		
	Если ВидФормы = "ФормаОбъекта" И Параметры.Свойство("Ключ") 
		И упоФункцииБСП.ПолучитьЗначениеРеквизита(Параметры.Ключ, "ЭтоПроектнаяЗадача") = Истина Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ВыбраннаяФорма = "Документ.упоПроектнаяЗадача.ФормаОбъекта";
		Параметры.Вставить("Ключ", Параметры.Ключ.СсылкаНаПроектнуюЗадачу);
		
	ИначеЕсли ВидФормы = "ФормаОбъекта" И Параметры.Свойство("ЗначенияЗаполнения") И 
		ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") И Параметры.ЗначенияЗаполнения.Свойство("Родитель") Тогда
				
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "Документ.упоПроектнаяЗадача.ФормаОбъекта";
		Параметры.Вставить("Основание", Параметры.ЗначенияЗаполнения.Родитель);
		Параметры.Вставить("РежимВыбораЗеркала", Истина);
		
	ИначеЕсли ВидФормы = "ФормаВыбора" ИЛИ ВидФормы = "ФормаВыбораГруппы" Тогда
		
		// Принудительная косвенная установка параметров в случаях, когда невозможна прямая установка 
		// (при использовании промежуточного списка значений, например, в СКД при сравнении "ВСписке").
		
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "Справочник.Проекты.Форма.упоФормаСпискаУправляемая";

		ЕстьПроект = Ложь;
		Если Параметры.Свойство("ТекущаяСтрока") Тогда
			Если ТипЗнч(Параметры.ТекущаяСтрока) = Тип("СправочникСсылка.Проекты") Тогда
				Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) И НЕ Параметры.ТекущаяСтрока.ЭтоПроектнаяЗадача Тогда
					ЕстьПроект = Истина;	
				КонецЕсли;
				// Открытие формы выбора из справочника ГруппыДоступа.ФормаЭлемента (список ограничений).
				Если Параметры.Свойство("ЭтоВыборЗначенияДоступа") Тогда
					ЕстьПроект = Истина;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
		ВыборГруппИЭлементов = Неопределено;
		Параметры.Свойство("ВыборГруппИЭлементов", ВыборГруппИЭлементов);
		
		Если (Параметры.Свойство("ЭтоФормаВыбораПроектнойЗадачиКакПроекта") И Параметры.ЭтоФормаВыбораПроектнойЗадачиКакПроекта) 
			ИЛИ (Параметры.Свойство("ЭтоФормаВыбораПроектнойЗадачи") И Параметры.ЭтоФормаВыбораПроектнойЗадачи) Тогда
			
			// Оставляем как есть
			
		ИначеЕсли Параметры.Свойство("ЭтоФормаВыбораПроекта") 
			И (ЗначениеЗаполнено(Параметры.ЭтоФормаВыбораПроекта) И Параметры.ЭтоФормаВыбораПроекта) Тогда
			
			// Оставляем как есть
			
		ИначеЕсли ЕстьПроект Тогда
			
			Параметры.Вставить("ЭтоФормаВыбораПроекта", Истина);						
			
		ИначеЕсли ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы Тогда  
			
			// При открытии формы выбора проекта через Показать все, если у элемента
			// ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы, то открывается форма выбора ПЗ
			// Поэтому добавили отбор "ЭтоГруппа" для предотвращения подобной ситуации. Используется в 
			// модуле менеджера документа ЭкземплярБюджета
			Если Не (Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ЭтоГруппа") И Не Параметры.Отбор.ЭтоГруппа) Тогда
				
				Параметры.Вставить("ЭтоФормаВыбораПроектнойЗадачиКакПроекта", Истина);
				
			КонецЕсли;
			
		ИначеЕсли ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы ИЛИ ВидФормы = "ФормаВыбораГруппы" Тогда
			
			Параметры.Вставить("ЭтоФормаВыбораПроекта", Истина);
			
		КонецЕсли;	
		
		// Принудительная установка возможности выбрать как элемент, так и группу посредством кнопки выбора.
		Если ВидФормы = "ФормаВыбора" 
				И Параметры.Свойство("ЭтоФормаВыбораПроекта") И Параметры.Свойство("ВыборГруппИЭлементов") Тогда
			
			ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы;
			
			Параметры.ВыборГруппИЭлементов = ВыборГруппИЭлементов;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ЭтоПроектнаяЗадача = Неопределено;
	
	ЕстьОтборЭтоПроектнаяЗадача = Параметры.Отбор.Свойство("ЭтоПроектнаяЗадача", ЭтоПроектнаяЗадача);
	Если ЭтоПроектнаяЗадача = Неопределено Тогда
		ЕстьОтборЭтоПроектнаяЗадача = Параметры.Свойство("ЭтоПроектнаяЗадача", ЭтоПроектнаяЗадача);
	КонецЕсли;
	
	Если ЕстьОтборЭтоПроектнаяЗадача Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СтруктураПараметровПодбора = Новый Структура("СтрокаПоиска, ЭтоПроектнаяЗадача, КорневойПроект, ПроектИсключение", 
			Параметры.СтрокаПоиска,
			ЭтоПроектнаяЗадача);
		Если Параметры.Отбор.Свойство("упоКорневойПроект") Тогда
			СтруктураПараметровПодбора.Вставить("КорневойПроект", Параметры.Отбор.упоКорневойПроект);
		КонецЕсли;
		Если Параметры.Свойство("Проект") И Параметры.Свойство("ИсключитьПроект") Тогда
			СтруктураПараметровПодбора.Вставить("ПроектИсключение", Параметры.Проект);
		КонецЕсли;
		
		ПроектыДляВыбора = ПолучитьСписокПроектов(СтруктураПараметровПодбора.ЭтоПроектнаяЗадача, 
			СтруктураПараметровПодбора.КорневойПроект, 
			СтруктураПараметровПодбора.ПроектИсключение,
			СтруктураПараметровПодбора.СтрокаПоиска);
		
		ДанныеВыбора = Новый СписокЗначений();
		ДанныеВыбора.ЗагрузитьЗначения(ПроектыДляВыбора);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСписокПроектов(ЭтоПроектнаяЗадача = Ложь, КорневойПроект = Неопределено, ПроектИсключение = Неопределено, СтрокаПоиска = "")
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ЭтоПроектнаяЗадача", ЭтоПроектнаяЗадача);
	Запрос.УстановитьПараметр("ОтборПоСтроке", ЗначениеЗаполнено(СтрокаПоиска));
	Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска + "%");
	Запрос.УстановитьПараметр("ОтборПоКорневомуПроекту", ЗначениеЗаполнено(КорневойПроект));
	Запрос.УстановитьПараметр("КорневойПроект", КорневойПроект);
	Запрос.УстановитьПараметр("ОтборПоПроектуИсключению", ЗначениеЗаполнено(ПроектИсключение));
	Запрос.УстановитьПараметр("ПроектИсключение", ПроектИсключение);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
	               |	Проекты.Ссылка КАК Проект
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |ГДЕ
	               |	Проекты.ЭтоПроектнаяЗадача = &ЭтоПроектнаяЗадача
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоСтроке
	               |				ТОГДА Проекты.Наименование ПОДОБНО &СтрокаПоиска
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоКорневомуПроекту
	               |				ТОГДА Проекты.упоКорневойПроект В (&КорневойПроект)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И ВЫБОР
	               |			КОГДА &ОтборПоПроектуИсключению
	               |				ТОГДА ВЫБОР
	               |						КОГДА Проекты.ЭтоПроектнаяЗадача
	               |							ТОГДА НЕ Проекты.упоКорневойПроект В (&ПроектИсключение)
	               |						ИНАЧЕ НЕ Проекты.Ссылка В (&ПроектИсключение)
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И НЕ Проекты.ПометкаУдаления
	               |	И НЕ Проекты.ЗадачаОтменена
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Проекты.Представление";
						  
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Проект");					  
	
КонецФункции

