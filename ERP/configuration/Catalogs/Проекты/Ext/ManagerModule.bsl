// Возвращает сроки проекта.
//
// Параметры:
//  пСсылкаНаПроект	 - СправочникСсылка.Проекты - проект.
//
// Возвращаемое значение:
//  Структура - структура с ключами:
//		* ДатаНачала - Дата - дата начала.
//		* ДатаЗавершения - Дата -дата завершения.
//
Функция ПолучитьСроки(пСсылкаНаПроект) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СрокиПЗ.ДатаНачалаПлан КАК Начало,
	               |	СрокиПЗ.ДатаЗавершенияПлан КАК Завершение
	               |ПОМЕСТИТЬ Сроки
	               |ИЗ
	               |	РегистрСведений.упоСрокиПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК СрокиПЗ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоСвойстваПроектныхЗадач.СрезПоследних(, Версия = &Версия) КАК упоСвойстваПроектныхЗадачСрезПоследних
	               |		ПО СрокиПЗ.ПроектнаяЗадача = упоСвойстваПроектныхЗадачСрезПоследних.ПроектнаяЗадача
	               |			И (НЕ упоСвойстваПроектныхЗадачСрезПоследних.ЗадачаОтменена)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МИНИМУМ(Сроки.Начало) КАК ДатаНачала,
	               |	МАКСИМУМ(Сроки.Завершение) КАК ДатаЗавершения
	               |ИЗ
	               |	Сроки КАК Сроки";
	
	Запрос.УстановитьПараметр("Версия", упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(пСсылкаНаПроект));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	результат = Новый Структура("ДатаНачала, ДатаЗавершения");
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(результат, Выборка);
	КонецЕсли;
	
	Возврат результат;
	
КонецФункции

