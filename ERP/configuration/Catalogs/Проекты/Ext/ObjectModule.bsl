
#Область ПрограммныйИнтерфейс
 
// Получает структуру обязательных реквизитов.
//
// Параметры:
//  ИмяТабличнойЧасти	 - Строка, Неопределено	 - имя ТЧ.
// 
// Возвращаемое значение:
//  Структура - структура реквизитов.
//
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	
	Если ЭтотОбъект.ЭтоГруппа Тогда
		Если ИмяТабличнойЧасти = Неопределено Тогда
			// Формирование структуры обязательных реквизитов шапки.
			СтруктураОбязательныхПолей.Вставить("Наименование");				
		КонецЕсли;
	Иначе
		Если ИмяТабличнойЧасти = Неопределено Тогда
			// Формирование структуры обязательных реквизитов шапки.
			СтруктураОбязательныхПолей.Вставить("Наименование");
			Если упоВключитьПланРасходовВБДДС Тогда				
				СтруктураОбязательныхПолей.Вставить("упоСхемаОплатыПоУмолчаниюРасходы");				
			КонецЕсли;
			Если упоВключитьПланДоходовВБДДС Тогда
				СтруктураОбязательныхПолей.Вставить("упоСхемаОплатыПоУмолчаниюДоходы");				
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет заполнение обязательных реквизитов объекта.
// Если хотя бы один реквизит не заполнен, то выставляется флаг отказа от выполнения операции.
// 
// Параметры:
//  Отказ        - Булево - Признак отказа от выполнения операции.
// 
Процедура лмПроверитьЗаполнениеРеквизитов(Отказ) Экспорт
	// {PM}
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ);
	// {/PM}
КонецПроцедуры

// Возвращает статус проекта (забирает из регистра)
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СостояниеСтатусаПроекта – текущий статус проекта.
//
Функция ПолучитьСтатусПроекта() Экспорт
	// {PM}
	Если ЭтоНовый() Тогда      
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Рег.СтатусПроекта
		|ИЗ
		|	РегистрСведений.упоСтатусыПроектов.СрезПоследних(, Проект = &Проект) КАК Рег";
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Статус = Результат.Выгрузить()[0].СтатусПроекта;
		Возврат Статус;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	// {/PM}
КонецФункции

// Возвращает метод планирования проекта.
//
// Возвращаемое значение:
//	ПеречислениеСсылка.упоМетодОперативногоПланирования - метод оперативного плаирования.
//
Функция ПолучитьМетодПланирования() Экспорт
	// {PM}
	Если ЭтоНовый() Тогда      
		Возврат Неопределено;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Проект", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РегПр.МетодОперативногоПланирования
		|ИЗ
		|	РегистрСведений.упоКалендариПроектов.СрезПоследних(, Проект = &Проект) КАК РегПр";
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Метод = Результат.Выгрузить()[0].МетодОперативногоПланирования;
		Возврат Метод;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	// {/PM}
КонецФункции

