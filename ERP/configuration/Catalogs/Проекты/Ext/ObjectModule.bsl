#КонецЕсли

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	// {PM}
	упоЗаполнитьКорневойПроектПроекта();
	упоЗакрытиеЭтапа.ПроверкаПередЗаписью_ПроектыПередЗаписью(ЭтотОбъект, Отказ);
	упоОбработчикиСобытийСервер.ОбъектПередЗаписью(ЭтотОбъект, Отказ);
	// {/PM}
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Завершен = Ложь;
	ПлановаяДатаНачала = ТекущаяДатаСеанса();
	ПлановаяДатаОкончания = Дата(1,1,1);
	ДатаНачала = ТекущаяДатаСеанса();
	ПлановаяДатаОкончания = Дата(1,1,1);
	
	// {PM}
	упоОбработчикиСобытийСервер.ОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	// {/PM}
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Взаимодействия.УстановитьПризнакАктивен(Ссылка, (НЕ Завершен) И (Не ПометкаУдаления));
	
	// {PM}
	упоОбработчикиСобытийСервер.ОбъектПриЗаписи(ЭтотОбъект, Отказ);
	упоОграниченияДоступаПоПроектам.упоДобавлениеВОчередьПересчетаОграниченийДоступаПоПроектамПриЗаписи(ЭтотОбъект,
		Отказ);
	// {/PM}
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// {PM}
	упоОбработчикиСобытийСервер.ОбъектОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	//{/PM}
	
	Если ЗначениеЗаполнено(ПлановаяДатаОкончания)
		И ПлановаяДатаНачала > ПлановаяДатаОкончания Тогда
		
		ТекстСообщения = НСтр("ru = 'Плановая дата окончания не должна быть меньше плановой даты начала.';
								|en = 'Planned end date cannot be less than planned start date.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
		                                                  ЭтотОбъект,
		                                                  "ПлановаяДатаОкончания",
		                                                  ,
		                                                  Отказ);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания)
		И ДатаНачала > ДатаОкончания Тогда
		
		ТекстСообщения = НСтр("ru = 'Дата окончания не должна быть меньше даты начала.';
								|en = 'End date cannot be earlier than the start date.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
		                                                  ЭтотОбъект,
		                                                  "ДатаОкончания",
		                                                  ,
		                                                  Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// См. описание в комментарии к одноименной процедуре в модуле УправлениеДоступом.
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ЭтоПроектнаяЗадача Тогда
		СтрокаТаб = Таблица.Добавить();
		СтрокаТаб.ЗначениеДоступа = Ссылка;
	Иначе
		СтрокаТаб = Таблица.Добавить();
		СтрокаТаб.ЗначениеДоступа = Перечисления.ДополнительныеЗначенияДоступа.ДоступЗапрещен;
	КонецЕсли;
		
КонецПроцедуры

// Заполнение реквизита упоКорневойПроект для проектов. Выполняется в целях сокращения ключей доступа 
// (см. Справочники.Проекты.ПриЗаполненииОграниченияДоступа).
//
Процедура упоЗаполнитьКорневойПроектПроекта()
	
	// Для задач значение заполняется в объектах задач.
	Если ЭтоПроектнаяЗадача Тогда
		Возврат;
	КонецЕсли;
	
	// Перезапись проекта.
	Если ЗначениеЗаполнено(упоКорневойПроект) 
		И упоКорневойПроект = Ссылка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		УИД = Новый УникальныйИдентификатор;
		СсылкаНаТекОбъект = Справочники.Проекты.ПолучитьСсылку(УИД);
		УстановитьСсылкуНового(СсылкаНаТекОбъект);
	Иначе
		СсылкаНаТекОбъект = Ссылка;
	КонецЕсли;
	
	упоКорневойПроект = СсылкаНаТекОбъект; 
	
КонецПроцедуры

#КонецОбласти