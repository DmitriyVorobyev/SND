
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		ИмяФормыСписка = "ФормаСписка";
	ИначеЕсли упоИнтеграцияКлиентСерверПовтИсп.ЭтоЧистыйPM() Тогда
		ИмяФормыСписка = "ФормаСпискаУправляемая";
	КонецЕсли;
	
	ПолноеИмяФормыСписка = "Справочник.ДоговорыКонтрагентов.Форма." + ИмяФормыСписка;
	ОткрытьФорму(ПолноеИмяФормыСписка);
	
КонецПроцедуры
