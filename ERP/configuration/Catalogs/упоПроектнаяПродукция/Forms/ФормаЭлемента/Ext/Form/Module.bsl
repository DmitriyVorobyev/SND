#Область ОбработчикиСобытийЭлементовТаблицыФормыРолиТР

&НаКлиенте
Процедура РолиТРПроцентРаспределенияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.РолиТР) Тогда
		Возврат;
	КонецЕсли;
	
	ИтоговыйПроцент = Объект.РолиТР.Итог("ПроцентРаспределения");
	Разница = 100 - ИтоговыйПроцент;
	Если Разница <> 0 Тогда
		ПоследняяСтрока = Объект.РолиТР[Объект.РолиТР.Количество() - 1];
		ПоследняяСтрока.ПроцентРаспределения = ПоследняяСтрока.ПроцентРаспределения + Разница;
	КонецЕсли;
	
	РассчитатьРаспределениеКоличестваНормированияТрудозатрат();
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РолиТР.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ТекущийРесурс = ТекущиеДанные.РольТР;
	
	ПараметрыВыбораПоля = Новый Массив;
	
	Если ЗначениеЗаполнено(ТекущийРесурс) Тогда
		ПараметрыВыбораПоля.Добавить(Новый ПараметрВыбора("РесурсПодразделения", ТекущийРесурс));
	КонецЕсли;
	
	НовыеПараметры = Новый ФиксированныйМассив(ПараметрыВыбораПоля);
	Элемент.ПараметрыВыбора = НовыеПараметры;
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРНормированиеПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.РолиТР.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Объект.Нормирование = Объект.РолиТР.Итог("Нормирование");
	
	Для Каждого СтрокаРоли Из Объект.РолиТР Цикл
		упоПроектнаяПродукцияКлиент.ПересчитатьДанныеСтрокиРаспределенияПриИзмененииНомирования(СтрокаРоли,
			Объект.Нормирование, Объект.Количество);
	КонецЦикла;
	
	Объект.Трудоемкость = Объект.РолиТР.Итог("Трудоемкость");
		
КонецПроцедуры

&НаКлиенте
Процедура РолиТРКоэффициентСложностиПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.РолиТР.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	РассчитатьФормулыПоСтрокеРоли(ТекущаяСтрока);
	ПересчитатьИтогКоэффициентСложности();
	
	Объект.КоэффициентСложности = ЭтотОбъект.ИтогКоэффициентСложностиРолей;

КонецПроцедуры

&НаКлиенте
Процедура РолиТРПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.РолиТР.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если НоваяСтрока И Не Копирование Тогда
		
		ТекущаяСтрока.КоэффициентСложности = Объект.КоэффициентСложности;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРТрудоемкостьПриИзменении(Элемент) 
	
	ТекущиеДанные = Элементы.РолиТР.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Объект.Трудоемкость = Объект.РолиТР.Итог("Трудоемкость");
	Если Объект.Нормирование = 0 ИЛИ ТекущиеДанные.ПроцентРаспределения = 0 Тогда
		ТекущиеДанные.КоэффициентСложности = 0;
	Иначе
		ТекущиеДанные.КоэффициентСложности = ТекущиеДанные.Трудоемкость / Объект.Нормирование / (ТекущиеДанные.ПроцентРаспределения / 100);	
	КонецЕсли;
	
	ПересчитатьИтогКоэффициентСложности();
	Объект.КоэффициентСложности = ЭтотОбъект.ИтогКоэффициентСложностиРолей;
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРРольТРПриИзменении(Элемент)
	
	СтрокаТабличнойЧасти = Элементы.РолиТР.ТекущиеДанные;
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСтрокиТабличнойЧасти = Неопределено;
	ЗаполнитьСтруктуруСтрокиТЧТрудовыеРесурсы(СтруктураСтрокиТабличнойЧасти);
	
	ЗаполнитьЗначенияСвойств(СтруктураСтрокиТабличнойЧасти, СтрокаТабличнойЧасти);
	РолиТрудовыхРесурсовРольПриИзменении(СтруктураСтрокиТабличнойЧасти);
	
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтруктураСтрокиТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.РолиТР.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;  
	
	Для Каждого Стр Из Объект.РолиТР Цикл
		Если Стр.НомерСтроки = ТекДанные.НомерСтроки Тогда
			Продолжить;
		КонецЕсли;
		Стр.ПроцентРаспределения = Стр.ПроцентРаспределения + ТекДанные.ПроцентРаспределения;   
		ТекДанные.ПроцентРаспределения = 0;
		Прервать;
	КонецЦикла;    
	
	РассчитатьРаспределениеКоличестваНормированияТрудозатрат();
	
КонецПроцедуры

&НаКлиенте
Процедура РолиТРПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;     
	
	Если Копирование Тогда  
		Отказ = Истина;
		НоваяСтрока = Объект.РолиТР.Добавить(); 
		НоваяСтрока.РольТР = ТекДанные.РольТР;
		НоваяСтрока.Подразделение = ТекДанные.Подразделение;
		НоваяСтрока.КоэффициентСложности = ТекДанные.КоэффициентСложности;
		НоваяСтрока.ПрофильТрудозатрат = ТекДанные.ПрофильТрудозатрат;
	КонецЕсли; 
	
КонецПроцедуры

