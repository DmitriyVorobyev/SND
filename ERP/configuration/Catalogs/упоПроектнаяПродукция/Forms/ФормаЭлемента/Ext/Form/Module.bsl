&НаКлиенте
Процедура ОбновитьНадписьПоследняяМодификация()
	
	НадписьПоследняяМодификация  = упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификация(Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьТрудоемкостьПроектнойПродукции()

	Объект.Трудоемкость = Объект.Количество * Объект.Нормирование;

КонецПроцедуры //

&НаКлиенте
Процедура РассчитатьКоличествоПоСтроке()
	
	Если Не ЗначениеЗаполнено(Объект.РолиТР) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из Объект.РолиТР Цикл
		Строка.Количество = Объект.Трудоемкость * Строка.ПроцентРаспределения / 100;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьФормулыПоСтрокеРоли(Строка)
	
	Строка.Трудоемкость = Объект.Нормирование * Строка.КоэффициентСложности * (Строка.ПроцентРаспределения / 100);
	
	Объект.Трудоемкость = Объект.РолиТР.Итог("Трудоемкость");
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПроектнойЗадачиНаСервере(ВыбранноеЗначение)
	
	тОбъект = упоУправлениеФормамиСервер.ПолучитьОбъектПоДаннымФормы(Объект);
	тОбъект.ОбработкаЗаполнения(ВыбранноеЗначение);
	ЗначениеВДанныеФормы(тОбъект, Объект);
	
	упоУправлениеФормамиСервер.ПроверитьДокументОснование(Объект, ЭтаФорма, "ПроектнаяЗадача");
	
	ЗаполнитьРеквизитыПоПроектнойЗадаче(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтруктуруПоШаблону(ШаблонСтруктуры)
	
	Объект.МатериалыИОборудование.Очистить();
	Объект.РолиТР.Очистить();
	Объект.ДополнительныеЗатраты.Очистить();
	ЗаполнитьТабличныеЧастиПоШаблонуНаСервере(ШаблонСтруктуры); 
	
	ПересчитатьИтогКоэффициентСложности();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныеЧастиПоШаблонуНаСервере(ШаблонСтруктуры)
	
	Реквизиты = "ТипДокумента, Количество, ЕдиницаИзмерения, Трудоемкость, ЕдиницаИзмеренияВремени, 
		|ВидОперации, МинимальнаяДлительность, СкоростьВыполнения,
		|Нормирование, КоэффициентСложности,
		|Последовательность, ПроектнаяПродукция, Спецификация";
	
	ЗаполнитьЗначенияСвойств(Объект, ШаблонСтруктуры, Реквизиты);
	Объект.ДополнительныеЗатраты.Загрузить(ШаблонСтруктуры.ДополнительныеЗатраты.Выгрузить());
	Объект.РолиТР.Загрузить(ШаблонСтруктуры.РолиТР.Выгрузить());
	Объект.МатериалыИОборудование.Загрузить(ШаблонСтруктуры.МатериалыИОборудование.Выгрузить());
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	ДоступностьШаблона 		= Истина;
	ДоступностьПоПЗ 		= Истина;
	ДоступностьПроектнаяПродукция 	= Ложь;
	ДоступностьПоШаблону 	= Не Объект.Шаблон;
	
	Если ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
		
		ДоступностьШаблона 	= Ложь;
		ДоступностьПоПЗ 	= Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ШаблонПроектнойПродукции) Тогда
		
		ДоступностьШаблона = Ложь;
		
	КонецЕсли;
	
	ПоследовательностьСовместно = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Перечисление.упоПоследовательность.СовместноС");
	
	Если ЗначениеЗаполнено(Объект.Последовательность) И Объект.Последовательность = ПоследовательностьСовместно Тогда
		
		ДоступностьПроектнаяПродукция = Истина;
		
	КонецЕсли;
	
	Элементы.СтраницаДополнительная.Видимость 	= ДоступностьПоШаблону;
	Элементы.НадписьПроектнаяЗадача.Видимость 	= ДоступностьПоШаблону;
	Элементы.Проект.Видимость					= ДоступностьПоШаблону;
	Элементы.ОбъектПП.Видимость 				= ДоступностьПоШаблону;
	Элементы.ШаблонПроектнойПродукции.Видимость = ДоступностьПоШаблону;
	Элементы.ГруппаКодПП.Видимость 				= ДоступностьПоШаблону;
	Элементы.ГруппаПравая.Видимость 			= ДоступностьПоШаблону;
	Элементы.Норма.ТолькоПросмотр 				= ДоступностьПоШаблону;
	Элементы.РолиТРНормирование.ТолькоПросмотр 	= ДоступностьПоШаблону;
	
	Элементы.ПроектнаяПродукция.Видимость 	= ДоступностьПроектнаяПродукция;	
	Элементы.Шаблон.ТолькоПросмотр 			= Не ДоступностьШаблона;
	
	УстановитьЗапретРедактированияЭлементовДляГруппыРекурсивно(Элементы.СтраницаОсновная, Не мДоступноРедактированиеПЗ);
	
	Если Не мДоступноРедактированиеПЗ Тогда	
		Элементы.ГруппаКод.ТолькоПросмотр = 				Истина;
		Элементы.ГруппаПравая.ТолькоПросмотр = 				Истина;
		Элементы.НадписьПроектнаяЗадача.ТолькоПросмотр	= 	Истина;
		Элементы.Проект.ТолькоПросмотр					= 	Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗапретРедактированияЭлементовДляГруппыРекурсивно(Элемент, ЗапрещеноИзменятьЗначение = Истина)
	
	Если ТипЗнч(Элемент) = Тип("ГруппаФормы") И Элемент.ПодчиненныеЭлементы.Количество() Тогда
		Для каждого ПодчиненныйЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
			УстановитьЗапретРедактированияЭлементовДляГруппыРекурсивно(ПодчиненныйЭлемент, ЗапрещеноИзменятьЗначение);
		КонецЦикла;
		
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Элемент) = Тип("КнопкаФормы") Тогда
		Элемент.Доступность = Не ЗапрещеноИзменятьЗначение;
	Иначе
		Элемент.ТолькоПросмотр = ЗапрещеноИзменятьЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоСпецификации()
	
	Объект.РолиТР.Очистить();
	Объект.МатериалыИОборудование.Очистить();
	Объект.ДополнительныеЗатраты.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Спецификация);
	Запрос.УстановитьПараметр("Количество", Объект.Количество);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСпецификацииРолиТР.РольТР КАК РольТР,
		|	упоСпецификацииРолиТР.Подразделение КАК Подразделение,
		|	упоСпецификацииРолиТР.ПроцентРаспределения КАК ПроцентРаспределения,
		|	упоСпецификацииРолиТР.ПрофильТрудозатрат КАК ПрофильТрудозатрат,
		|	&Количество * упоСпецификацииРолиТР.ПроцентРаспределения / 100 КАК Количество
		|ИЗ
		|	Справочник.упоСпецификации.РолиТР КАК упоСпецификацииРолиТР
		|ГДЕ
		|	упоСпецификацииРолиТР.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСпецификацииМатериалыИОборудование.Номенклатура КАК Номенклатура,
		|	упоСпецификацииМатериалыИОборудование.Количество КАК Количество,
		|	упоСпецификацииМатериалыИОборудование.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	упоСпецификацииМатериалыИОборудование.ПрофильРаспределения КАК ПрофильРаспределения
		|ИЗ
		|	Справочник.упоСпецификации.МатериалыИОборудование КАК упоСпецификацииМатериалыИОборудование
		|ГДЕ
		|	упоСпецификацииМатериалыИОборудование.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСпецификацииДополнительныеЗатраты.СтатьяЗатрат КАК СтатьяЗатрат,
		|	упоСпецификацииДополнительныеЗатраты.СпособПривязкиДопЗатрат КАК СпособПривязкиДопЗатрат,
		|	упоСпецификацииДополнительныеЗатраты.Стоимость КАК Стоимость,
		|	упоСпецификацииДополнительныеЗатраты.Валюта КАК Валюта
		|ИЗ
		|	Справочник.упоСпецификации.ДополнительныеЗатраты КАК упоСпецификацииДополнительныеЗатраты
		|ГДЕ
		|	упоСпецификацииДополнительныеЗатраты.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если Не РезультатЗапроса[0].Пустой() Тогда
		Объект.РолиТР.Загрузить(РезультатЗапроса[0].Выгрузить());
	КонецЕсли;
	Если Не РезультатЗапроса[1].Пустой() Тогда
		Объект.МатериалыИОборудование.Загрузить(РезультатЗапроса[1].Выгрузить());
	КонецЕсли;
	Если Не РезультатЗапроса[2].Пустой() Тогда
		Объект.ДополнительныеЗатраты.Загрузить(РезультатЗапроса[2].Выгрузить());
	КонецЕсли;
		
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПоСпецификацииЗавершение(Результат, ПараметрыЗаписи) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДанныеПоСпецификации();
		
		ЗаполнитьКоэффициентСложностиДляРолей(Объект.РолиТР, Объект.КоэффициентСложности);
		ЭтотОбъект.ИтогКоэффициентСложностиРолей = Объект.КоэффициентСложности;
		
		ЗаполнитьНормированиеРолей(Объект.РолиТР, Объект.Нормирование);
		
		Для Каждого СтрокаТР Из Объект.РолиТР Цикл
			РассчитатьФормулыПоСтрокеРоли(СтрокаТР);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСоответствиеЗатратЗавершение(Результат, ПараметрыЗаписи) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДанныеПоСпецификации();
	КонецЕсли;
	
	ПараметрыЗаписи.Вставить("ЗатратыПроверены", Истина);
	Записать(ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Функция СравнитьТаблицыССпецификацией()
	
	ТаблицыРазличны = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РолиТР.РольТР КАК РольТР,
		|	РолиТР.ПроцентРаспределения КАК ПроцентРаспределения,
		|	РолиТР.ПрофильТрудозатрат КАК ПрофильТрудозатрат
		|ПОМЕСТИТЬ РолиТР
		|ИЗ
		|	&РолиТР КАК РолиТР
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МатериалыИОборудование.Номенклатура КАК Номенклатура,
		|	МатериалыИОборудование.Количество КАК Количество,
		|	МатериалыИОборудование.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	МатериалыИОборудование.ПрофильРаспределения КАК ПрофильРаспределения
		|ПОМЕСТИТЬ МатериалыИОборудование
		|ИЗ
		|	&МатериалыИОборудование КАК МатериалыИОборудование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДополнительныеЗатраты.СтатьяЗатрат КАК СтатьяЗатрат,
		|	ДополнительныеЗатраты.СпособПривязкиДопЗатрат КАК СпособПривязкиДопЗатрат,
		|	ДополнительныеЗатраты.Стоимость КАК Стоимость,
		|	ДополнительныеЗатраты.Валюта КАК Валюта
		|ПОМЕСТИТЬ ДопЗатраты
		|ИЗ
		|	&ДополнительныеЗатраты КАК ДополнительныеЗатраты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИСТИНА КАК Ссылка
		|ИЗ
		|	Справочник.упоСпецификации.ДополнительныеЗатраты КАК упоСпецификацииДополнительныеЗатраты
		|		ПОЛНОЕ СОЕДИНЕНИЕ ДопЗатраты КАК ДопЗатраты
		|		ПО упоСпецификацииДополнительныеЗатраты.СтатьяЗатрат = ДопЗатраты.СтатьяЗатрат
		|			И упоСпецификацииДополнительныеЗатраты.СпособПривязкиДопЗатрат = ДопЗатраты.СпособПривязкиДопЗатрат
		|			И упоСпецификацииДополнительныеЗатраты.Стоимость = ДопЗатраты.Стоимость
		|			И упоСпецификацииДополнительныеЗатраты.Валюта = ДопЗатраты.Валюта
		|ГДЕ
		|	упоСпецификацииДополнительныеЗатраты.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА ДопЗатраты.СтатьяЗатрат ЕСТЬ NULL
		|					ИЛИ упоСпецификацииДополнительныеЗатраты.СтатьяЗатрат ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИСТИНА
		|ИЗ
		|	Справочник.упоСпецификации.РолиТР КАК упоСпецификацииРолиТР
		|		ПОЛНОЕ СОЕДИНЕНИЕ РолиТР КАК РолиТР
		|		ПО упоСпецификацииРолиТР.РольТР = РолиТР.РольТР
		|			И упоСпецификацииРолиТР.ПроцентРаспределения = РолиТР.ПроцентРаспределения
		|			И упоСпецификацииРолиТР.ПрофильТрудозатрат = РолиТР.ПрофильТрудозатрат
		|ГДЕ
		|	упоСпецификацииРолиТР.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА РолиТР.РольТР ЕСТЬ NULL
		|					ИЛИ упоСпецификацииРолиТР.РольТР ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИСТИНА
		|ИЗ
		|	Справочник.упоСпецификации.МатериалыИОборудование КАК упоСпецификацииМатериалыИОборудование
		|		ПОЛНОЕ СОЕДИНЕНИЕ МатериалыИОборудование КАК МатериалыИОборудование
		|		ПО упоСпецификацииМатериалыИОборудование.Номенклатура = МатериалыИОборудование.Номенклатура
		|			И упоСпецификацииМатериалыИОборудование.Количество = МатериалыИОборудование.Количество
		|			И упоСпецификацииМатериалыИОборудование.ЕдиницаИзмерения = МатериалыИОборудование.ЕдиницаИзмерения
		|			И упоСпецификацииМатериалыИОборудование.ПрофильРаспределения = МатериалыИОборудование.ПрофильРаспределения
		|ГДЕ
		|	упоСпецификацииМатериалыИОборудование.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА МатериалыИОборудование.Номенклатура ЕСТЬ NULL
		|					ИЛИ упоСпецификацииМатериалыИОборудование.Номенклатура ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Спецификация);
	Запрос.УстановитьПараметр("РолиТР", Объект.РолиТР.Выгрузить());
	Запрос.УстановитьПараметр("ДополнительныеЗатраты", Объект.ДополнительныеЗатраты.Выгрузить());
	Запрос.УстановитьПараметр("МатериалыИОборудование", Объект.МатериалыИОборудование.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицыРазличны = Не РезультатЗапроса.Пустой();
	
	Возврат ТаблицыРазличны;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыПоПроектнойЗадаче()
	
	ПроектнаяЗадача = Объект.ПроектнаяЗадача;
	текВерсия = упоВерсионирование.ПолучитьТекущуюВерсиюПроекта(ПроектнаяЗадача);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ПроектнаяЗадача);
	Запрос.УстановитьПараметр("ПроектнаяПродукция", Объект.Ссылка);
	Запрос.УстановитьПараметр("текВерсия", текВерсия);
	
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Субпродукты.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Субпродукты.Количество КАК Количество,
		|	СтруктурыПД.Последовательность КАК Последовательность
		|ИЗ
		|	РегистрСведений.упоДанныеПлановВыпускаСубпродуктов.СрезПоследних(
		|			,
		|			ПроектнаяЗадача = &Ссылка
		|				И Версия = &текВерсия
		|				И Номенклатура = &ПроектнаяПродукция) КАК Субпродукты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоДанныеПроектнойПродукции.СрезПоследних(
		|				,
		|				ПроектнаяЗадача = &Ссылка
		|					И Версия = &текВерсия
		|					И ПроектнаяПродукция = &ПроектнаяПродукция) КАК СтруктурыПД
		|		ПО Субпродукты.Номенклатура = СтруктурыПД.ПроектнаяПродукция
		|ГДЕ
		|	(Субпродукты.Количество <> 0
		|			ИЛИ Субпродукты.Сумма <> 0
		|			ИЛИ Субпродукты.СуммаВалютная <> 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Субпродукты.НомерСтроки";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Объект, Выборка);
	
	Если мДоступноРедактированиеПЗ Тогда
		
		Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
			Объект.Проект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "Проект");
		КонецЕсли;
		
		Объект.ОбъектПП = упоПроектыИЗадачиСервер.ПолучитьСвойствоПроектнойЗадачи(ПроектнаяЗадача, 
			"Объект",, текВерсия);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьСтатус()
	
	Элементы.НадписьСтатус.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
	Если Не ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
		НадписьСтатус = "";
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроектнаяПродукция", Объект.Ссылка);
	Запрос.УстановитьПараметр("ПроектнаяЗадача", Объект.ПроектнаяЗадача);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоОчередьРасчетаСтатусовПроектнойПродукции.ПроектнаяПродукция КАК ПроектнаяПродукция
		|ИЗ
		|	РегистрСведений.упоОчередьРасчетаСтатусовПроектнойПродукции КАК упоОчередьРасчетаСтатусовПроектнойПродукции
		|ГДЕ
		|	упоОчередьРасчетаСтатусовПроектнойПродукции.ПроектнаяПродукция = &ПроектнаяПродукция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	упоСтатусыПроектнойПродукцииСрезПоследних.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.упоСтатусыПроектнойПродукции.СрезПоследних(
		|			,
		|			ПроектнаяЗадача = &ПроектнаяЗадача
		|				И ПроектнаяПродукция = &ПроектнаяПродукция) КАК упоСтатусыПроектнойПродукцииСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК упоВерсииПроекта
		|		ПО упоСтатусыПроектнойПродукцииСрезПоследних.Версия = упоВерсииПроекта.Версия
		|			И (упоВерсииПроекта.Текущая)";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатЗапроса[0].Пустой() Тогда
		Если РезультатЗапроса[1].Пустой() Тогда
			НадписьСтатус = "";
		Иначе
			Выборка = РезультатЗапроса[1].Выбрать();
			Выборка.Следующий();
			НадписьСтатус = Выборка.Статус;
		КонецЕсли;
	Иначе
		НадписьСтатус = НСтр("ru = 'Статус не актуален: очередь расчета статуса не пустая'");
		Элементы.НадписьСтатус.ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтруктуруПоШаблонПроектнойПродукцииЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСтруктуруПоШаблону(Параметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтруктуруСтрокиТЧТрудовыеРесурсы(СтруктураСтрокиТабличнойЧасти)
			
	СтруктураСтрокиТабличнойЧасти = Новый Структура();
	СтруктураСтрокиТабличнойЧасти.Вставить("РольТР");
	СтруктураСтрокиТабличнойЧасти.Вставить("Подразделение");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура РолиТрудовыхРесурсовРольПриИзменении(СтруктураСтрокиТрудовогоРесурса)
	
	ДатаПолученияДанных = ТекущаяДатаСеанса();
	СтруктураСтрокиТрудовогоРесурса.Подразделение = 
		упоУправлениеФормамиСервер.ПолучитьПодразделениеРолиВызовСервера(СтруктураСтрокиТрудовогоРесурса.РольТР, 
			ДатаПолученияДанных);

КонецПроцедуры //

&НаКлиентеНаСервереБезКонтекста
Функция КоэффициентыРаспределенияРолей(ТаблицаРолей)
	
	Коэффициенты = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаРолей Цикл
		Коэффициенты.Добавить(СтрокаТаблицы.ПроцентРаспределения);
	КонецЦикла;
	
	Возврат Коэффициенты;
	
КонецФункции

&НаКлиенте
Функция РаспределитьСуммуПропорциональноКоэффициентамРаспределенияРолей(знач СуммаРаспределения)
	
	Коэффициенты = КоэффициентыРаспределенияРолей(Объект.РолиТР);
	
	Возврат РаспределитьСуммуПропорциональноКоэффициентам(СуммаРаспределения, Коэффициенты);
	
КонецФункции

&НаКлиенте
Процедура РассчитатьРаспределениеКоличестваНормированияТрудозатрат()
	
	РассчитатьРаспределениеКоличества();
	РассчитатьРаспределениеНормированияТрудозатрат();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьРаспределениеКоличества()
	
	МассивРаспределения = РаспределитьСуммуПропорциональноКоэффициентамРаспределенияРолей(Объект.Количество);
	Индекс = 0;
	Для Каждого Строка Из Объект.РолиТР Цикл
		Если МассивРаспределения = Неопределено Тогда
			Строка.Количество = 0;
		Иначе
			Строка.Количество = МассивРаспределения[Индекс];
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьРаспределениеНормированияТрудозатрат()
	
	МассивРаспределения = РаспределитьСуммуПропорциональноКоэффициентамРаспределенияРолей(Объект.Нормирование);
	Индекс = 0;
	Для Каждого Строка Из Объект.РолиТР Цикл
		Если МассивРаспределения = Неопределено Тогда
			Строка.Трудоемкость = 0;
			Строка.Нормирование = 0;
		Иначе
			Строка.Трудоемкость = МассивРаспределения[Индекс] * Строка.КоэффициентСложности;
			Строка.Нормирование = МассивРаспределения[Индекс];
		КонецЕсли;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Объект.Трудоемкость = Объект.РолиТР.Итог("Трудоемкость");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РаспределитьСуммуПропорциональноКоэффициентам(РаспределяемаяСумма, Коэффициенты)
	
	Возврат ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(РаспределяемаяСумма, 
		Коэффициенты);
	
КонецФункции

&НаСервере
Процедура ПроверкаПравДоступа(Отказ)
	
	ЕстьПравоПросмотра = ПравоДоступа("Просмотр", Метаданные.Справочники.упоПроектнаяПродукция)
		И ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.упоДанныеПлановВыпускаСубпродуктов)
		И ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.упоДанныеПроектнойПродукции);	
	
	Если ЕстьПравоПросмотра Тогда
		Возврат;
	КонецЕсли;	
						
	ВызватьИсключение НСтр("ru = 'Недостаточно прав для просмотра'");			
	
КонецПроцедуры

#КонецОбласти 
