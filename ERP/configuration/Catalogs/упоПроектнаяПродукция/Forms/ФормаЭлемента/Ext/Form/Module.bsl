&НаКлиенте
Процедура ТрудоемкостьПриИзменении(Элемент)
	
	Если Объект.Нормирование = 0 Тогда
		Объект.КоэффициентСложности = 0;
	Иначе
		Объект.КоэффициентСложности = Объект.Трудоемкость / Объект.Нормирование;	
	КонецЕсли;
	
	ЗаполнитьКоэффициентСложностиДляРолей(Объект.РолиТР, Объект.КоэффициентСложности);
	
	РассчитатьРаспределениеНормированияТрудозатрат();

	ПересчитатьИтогКоэффициентСложности();
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	
	РассчитатьРаспределениеКоличества();

	Если Не Объект.Шаблон И ЗначениеЗаполнено(Объект.ШаблонПроектнойПродукции) Тогда
		
		УстановитьНормированиеППНаСервере();
		НормаПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьНормированиеППНаСервере()
	
	ДанныеИзШаблона = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ШаблонПроектнойПродукции, "Количество, Нормирование");
	
	Если ДанныеИзШаблона.Количество <> 0 Тогда
		Коэффициент = Объект.Количество / ДанныеИзШаблона.Количество;
	Иначе
		Коэффициент = 1;
	КонецЕсли;
	
	Объект.Нормирование = ДанныеИзШаблона.Нормирование * Коэффициент;
		
КонецПроцедуры //

&НаКлиенте
Процедура НормаПриИзменении(Элемент)
		
	РассчитатьРаспределениеНормированияТрудозатрат();
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентСложностиПриИзменении(Элемент)
	
	ЗаполнитьКоэффициентСложностиДляРолей(Объект.РолиТР, Объект.КоэффициентСложности);
	
	РассчитатьРаспределениеНормированияТрудозатрат();
	
	ПересчитатьИтогКоэффициентСложности();
		
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогКоэффициентСложности()
	
	СуммаНормирование = Объект.РолиТР.Итог("Нормирование");
	СуммаТрудоемкость = Объект.РолиТР.Итог("Трудоемкость");	
	
	Если СуммаНормирование <> 0 Тогда
		ЭтотОбъект.ИтогКоэффициентСложностиРолей = СуммаТрудоемкость / СуммаНормирование; 
	КонецЕсли;	
	
КонецПроцедуры //

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьНормированиеРолей(ТаблицаРоли, ОбщееНормирование)
	
	Если Не ЗначениеЗаполнено(ТаблицаРоли) Тогда
		Возврат;
	КонецЕсли;
	
	Коэффициенты = КоэффициентыРаспределенияРолей(ТаблицаРоли);
	МассивРаспределения = РаспределитьСуммуПропорциональноКоэффициентам(ОбщееНормирование, Коэффициенты);
	
	Индекс = 0;
	Для Каждого Строка Из ТаблицаРоли Цикл
		Если МассивРаспределения = Неопределено Тогда
			Строка.Нормирование = 0;
		Иначе
			Строка.Нормирование = МассивРаспределения[Индекс];
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьКоэффициентСложностиДляРолей(ТаблицаРоли, ОбщийКоэффициент)
	
	Если Не ЗначениеЗаполнено(ТаблицаРоли) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаРоли Цикл
		Строка.КоэффициентСложности = ОбщийКоэффициент;
	КонецЦикла;
		
КонецПроцедуры // 

