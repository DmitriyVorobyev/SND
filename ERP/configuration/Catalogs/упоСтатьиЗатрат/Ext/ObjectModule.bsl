#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеСпособовРаспределенияРасходов(Отказ, ПроверяемыеРеквизиты)
	
	Если Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM()
		И Не упоИнтеграцияКлиентСерверПовтИсп.ЭтоDev2() Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаФормироватьНЗП 	= ПредопределенноеЗначение("Справочник.упоСпособыРаспределенияРасходовПоПроектам.ФормироватьНЗП");
	ЭтоФормироватьНЗП 		= СпособыРаспределенияРасходовПоПроектам = СсылкаФормироватьНЗП;
	ЭтоФормироватьНЗПРегл 	= СпособыРаспределенияРасходовПоПроектамРегл = СсылкаФормироватьНЗП;
	
	СтатьяРасходовERP = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Ссылка);
	
	Если ЗначениеЗаполнено(СтатьяРасходовERP) Тогда
		
		ИспользоватьСчетУчета = упоИнтеграцияКлиентСервер.ЕстьРеквизитСчетУчетаВСтатьеРасходов();
		
		мРеквизитыСтатьи = Новый Массив;
		мРеквизитыСтатьи.Добавить("ВариантРаспределенияРасходовРегл");
		мРеквизитыСтатьи.Добавить("ВариантРаспределенияРасходовУпр");
		Если ИспользоватьСчетУчета Тогда
			// Не удалять. Используется для подключаемого модуля Распределение ЗП.
			мРеквизитыСтатьи.Добавить("СчетУчета"); 
		КонецЕсли;
		РеквизитыСтатьиКакСтрока = СтрСоединить(мРеквизитыСтатьи, ",");
		
		ВариантыРаспределенияНеРаспределять = 
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
				"Перечисление.ВариантыРаспределенияРасходов.НеРаспределять");
		Реквизиты__СтатьяРасходовERP = 
			ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяРасходовERP, РеквизитыСтатьиКакСтрока);
		РаспределятьВручнуюРегл = 
			Реквизиты__СтатьяРасходовERP["ВариантРаспределенияРасходовРегл"] = ВариантыРаспределенияНеРаспределять;
		РаспределятьВручнуюУпр = 
			Реквизиты__СтатьяРасходовERP["ВариантРаспределенияРасходовУпр"] = ВариантыРаспределенияНеРаспределять;
		Если ИспользоватьСчетУчета Тогда
			// Не удалять. Используется для подключаемого модуля Распределение ЗП.
			СчетУчета = Реквизиты__СтатьяРасходовERP["СчетУчета"];
		КонецЕсли;
		
	Иначе
		РаспределятьВручнуюРегл = Ложь;
		РаспределятьВручнуюУпр = Ложь;
	КонецЕсли;
	
	Если РаспределятьВручнуюРегл Тогда
		ПроверяемыеРеквизиты.Добавить("СпособыРаспределенияРасходовПоПроектамРегл");
		
		Если НЕ ЭтоФормироватьНЗПРегл Тогда
			ПроверяемыеРеквизиты.Добавить("СтатьяРаспределенияРасходовРегл");
		КонецЕсли;
	КонецЕсли;
	
	Если РаспределятьВручнуюУпр Тогда
		ПроверяемыеРеквизиты.Добавить("СпособыРаспределенияРасходовПоПроектам");
		
		Если НЕ ЭтоФормироватьНЗП Тогда
			ПроверяемыеРеквизиты.Добавить("СтатьяРаспределенияРасходов");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

