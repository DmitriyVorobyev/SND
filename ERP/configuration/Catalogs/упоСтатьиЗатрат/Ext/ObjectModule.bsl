// Параметры: 
//  ОбъектКопирования – СправочникОбъект, исходный элемент, который является источником копирования. 
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриКопировании(ОбъектКопирования)
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
КонецПроцедуры // ПриКопировании()

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

    ПроверитьЗаполнениеСпособовРаспределенияРасходов(Отказ, ПроверяемыеРеквизиты);

КонецПроцедуры

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный, значение, которое используется как основание для заполнения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаЗаполнения(Основание)
	
	Если ТипЗнч(Основание)=Тип("Неопределено") Тогда 
		Возврат;
	КонецЕсли; 
	
	Если Не ЭтоГруппа И упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияОПРОХР() Тогда
		СпособыРаспределенияРасходовПоПроектамРегл = ПредопределенноеЗначение("Справочник.упоСпособыРаспределенияРасходовПоПроектам.ФормироватьНЗП");
	КонецЕсли;
	
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  Отказ        - Булево, признак отказа от записи элемента.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередЗаписью(Отказ)
	
	Если Не ЭтоГруппа Тогда
		Если СпособПривязкиРасходовТрудозатраты <> Перечисления.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения Тогда
			ПрофильРаспределенияРасходовТрудозатраты = Неопределено;				
		КонецЕсли;	
		Если СпособПривязкиРасходовТрудозатраты <> Перечисления.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно Тогда
			ПериодАгрегацииРасходовТрудозатраты = Неопределено;	
		КонецЕсли;
	КонецЕсли; 	
	
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектПередЗаписью(ЭтотОбъект, Отказ);
	
КонецПроцедуры // ПередЗаписью()

// Обработчик события ПриЗаписи модуля объекта.
