#Область Распределение_ОПРОХР

&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияОПРОХР()
		И Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределениеКосвенныхРасходов() Тогда
		Возврат;
	КонецЕсли;
	
	СтатьяРасходовERP = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Объект.Ссылка);
	
	Если ЗначениеЗаполнено(СтатьяРасходовERP)  Тогда
		ВариантыРаспределенияНеРаспределять = упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
			"Перечисление.ВариантыРаспределенияРасходов.НеРаспределять");            
		Реквизиты__СтатьяРасходовERP = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяРасходовERP, "ВариантРаспределенияРасходовРегл");
		РаспределятьВручнуюРегл = Реквизиты__СтатьяРасходовERP["ВариантРаспределенияРасходовРегл"] = ВариантыРаспределенияНеРаспределять;        
	Иначе        
		РаспределятьВручнуюРегл = Ложь;        
	КонецЕсли; 
	
	Если РаспределятьВручнуюРегл Тогда
		
		Если Объект.СпособыРаспределенияРасходовПоПроектамРегл = Объект.СпособыРаспределенияРасходовПоПроектам Тогда
			СпособыРаспределенияРасходовПоПроектам = ПредопределенноеЗначение("Справочник.упоСпособыРаспределенияРасходовПоПроектам.ПустаяСсылка");
		Иначе
			СпособыРаспределенияРасходовПоПроектам = Объект.СпособыРаспределенияРасходовПоПроектам;;
		КонецЕсли;
		
		Если Объект.СтатьяРаспределенияРасходовРегл = Объект.СтатьяРаспределенияРасходов Тогда
			СтатьяРаспределенияРасходов = Справочники.упоСтатьиЗатрат.ПустаяСсылка();
		Иначе
			СтатьяРаспределенияРасходов = Объект.СтатьяРаспределенияРасходов;;
		КонецЕсли;    
		
	Иначе
		
		СпособыРаспределенияРасходовПоПроектам = Объект.СпособыРаспределенияРасходовПоПроектам;;
		СтатьяРаспределенияРасходов = Объект.СтатьяРаспределенияРасходов;;
		
	КонецЕсли;      
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовРаспределенияРасходов_ОПРОХР()

	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияОПРОХР() Тогда
		
		Элементы.НастройкиРаспределениеРасходов.Видимость = Ложь;
		Возврат;
		
	КонецЕсли;
	
	ФормироватьНЗП = ПредопределенноеЗначение("Справочник.упоСпособыРаспределенияРасходовПоПроектам.ФормироватьНЗП");
	СтатьяРасходовERP = упоИнтеграцияВызовСервера.ПолучитьСвязаннуюСтатьюДР(Объект.Ссылка);
	
	Если ЗначениеЗаполнено(СтатьяРасходовERP)  Тогда
		
		ВариантыРаспределенияНеРаспределять = 
			упоФункцииОбщегоНазначенияКлиентСервер.упоПредопределенноеЗначение(
				"Перечисление.ВариантыРаспределенияРасходов.НеРаспределять");
		Реквизиты__СтатьяРасходовERP = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатьяРасходовERP, 
		"ВариантРаспределенияРасходовРегл, ВариантРаспределенияРасходовУпр");
		РаспределятьВручнуюРегл = 
		Реквизиты__СтатьяРасходовERP["ВариантРаспределенияРасходовРегл"] = ВариантыРаспределенияНеРаспределять;
		РаспределятьВручнуюУпр = 
		Реквизиты__СтатьяРасходовERP["ВариантРаспределенияРасходовУпр"] = ВариантыРаспределенияНеРаспределять;
		
	Иначе
		
		РаспределятьВручнуюРегл = Ложь;
		РаспределятьВручнуюУпр = Ложь;
		
	КонецЕсли; 
	
	Элементы.СпособыРаспределенияРасходовПоПроектамРегл.Видимость = РаспределятьВручнуюРегл;
	Элементы.СпособыРаспределенияРасходовПоПроектамРеглНадпись.Видимость = НЕ РаспределятьВручнуюРегл;
	Элементы.СтатьяРаспределенияРасходовРегл.Видимость = РаспределятьВручнуюРегл;
	Элементы.СтатьяРаспределенияРасходовРеглНадпись.Видимость = НЕ РаспределятьВручнуюРегл;
	
	Элементы.СтатьяРаспределенияРасходовРегл.Доступность = 
	НЕ Объект.СпособыРаспределенияРасходовПоПроектамРегл = ФормироватьНЗП;
	
	Элементы.СпособыРаспределенияРасходовПоПроектам.Видимость = РаспределятьВручнуюУпр;
	Элементы.СпособыРаспределенияРасходовПоПроектамНадпись.Видимость = НЕ РаспределятьВручнуюУпр;
	Элементы.СтатьяРаспределенияРасходов.Видимость = РаспределятьВручнуюУпр;
	Элементы.СтатьяРаспределенияРасходовНадпись.Видимость = НЕ РаспределятьВручнуюУпр;
	
	Если Объект.СпособыРаспределенияРасходовПоПроектамРегл = СпособыРаспределенияРасходовПоПроектам Тогда
		Элементы.СтатьяРаспределенияРасходов.Доступность = 
		НЕ Объект.СпособыРаспределенияРасходовПоПроектамРегл = ФормироватьНЗП;
	Иначе
		Элементы.СтатьяРаспределенияРасходов.Доступность = НЕ СпособыРаспределенияРасходовПоПроектам = ФормироватьНЗП;
	КонецЕсли;
	
	Если РаспределятьВручнуюРегл И РаспределятьВручнуюУпр Тогда
		ТекстПодсказка = НСтр("ru = ' так же как в регл. учете'");
		Элементы.СпособыРаспределенияРасходовПоПроектам.ПодсказкаВвода = ТекстПодсказка; 
		Элементы.СтатьяРаспределенияРасходов.ПодсказкаВвода = ТекстПодсказка; 
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьСвойстваЭлементовРаспределенияРасходов()
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияОПРОХР() Тогда
		
		УстановитьСвойстваЭлементовРаспределенияРасходов_ОПРОХР();
		Возврат;
		
	КонецЕсли;
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределениеКосвенныхРасходов() Тогда
		
		Элементы.НастройкиРаспределениеРасходов.Видимость = Ложь;
		Возврат;
		
	КонецЕсли;
	
	Элементы.НастройкиРаспределениеРасходов.Видимость = Истина;
	Элементы.НастройкиРаспределениеРасходовУпр.Видимость = Истина;
	
	Элементы.СпособыРаспределенияРасходовПоПроектамРегл.Видимость = Ложь;
	Элементы.СпособыРаспределенияРасходовПоПроектамРеглНадпись.Видимость = Ложь;
	Элементы.СтатьяРаспределенияРасходовРегл.Видимость = Ложь;
	Элементы.СтатьяРаспределенияРасходовРеглНадпись.Видимость = Ложь;
	
	Элементы.СпособыРаспределенияРасходовПоПроектамНадпись.Видимость = Ложь;
	Элементы.СтатьяРаспределенияРасходовНадпись.Видимость = Ложь;
	Элементы.СпособыРаспределенияРасходовПоПроектам.Видимость = Истина;
	Элементы.СтатьяРаспределенияРасходов.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОбъектПоДаннымФормы_ОПРОХР()
	
	Если Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределенияОПРОХР()
		И Не упоИнтеграцияКлиентСервер.ДоступенФункционалРаспределениеКосвенныхРасходов() Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СпособыРаспределенияРасходовПоПроектам = СпособыРаспределенияРасходовПоПроектам;
	
	Объект.СтатьяРаспределенияРасходов = СтатьяРаспределенияРасходов;
	
	СпособыРаспределенияРегл = Элементы.СпособыРаспределенияРасходовПоПроектамРегл.Видимость;
	СпособыРаспределения = Элементы.СпособыРаспределенияРасходовПоПроектам.Видимость;
	
	Если СпособыРаспределенияРегл И СпособыРаспределения Тогда
		Если НЕ ЗначениеЗаполнено(Объект.СпособыРаспределенияРасходовПоПроектам) Тогда
			Объект.СпособыРаспределенияРасходовПоПроектам = Объект.СпособыРаспределенияРасходовПоПроектамРегл;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.СтатьяРаспределенияРасходов) Тогда
			Объект.СтатьяРаспределенияРасходов = Объект.СтатьяРаспределенияРасходовРегл;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьУточнениеПривязкиТрудозатрат(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	Если Объект.СпособПривязкиРасходовТрудозатраты = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПериодамСводно") Тогда
		Элементы.УточнениеПривязки.ТекущаяСтраница = Элементы.СтраницаПериодАгрегации;
	ИначеЕсли Объект.СпособПривязкиРасходовТрудозатраты = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДоходаРасхода.ПоПрофилюРаспределения") Тогда
		Элементы.УточнениеПривязки.ТекущаяСтраница = Элементы.СтраницаПрофильПривязки;
	Иначе
		Элементы.УточнениеПривязки.ТекущаяСтраница = Элементы.СтраницаПусто;
	КонецЕсли;		
	
КонецПроцедуры	

#КонецОбласти
