	Если НЕ Копирование Тогда
		Отказ = Истина;
		ПодборВТЧФормы(Команды.Найти("ДопзатратыПодобрать"));
    КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределяемыеПередНачалоДобавления(ЭтаФорма,
		Объект,
		"ДополнительныеЗатраты",
		"РаспределениеДополнительныхЗатрат",
