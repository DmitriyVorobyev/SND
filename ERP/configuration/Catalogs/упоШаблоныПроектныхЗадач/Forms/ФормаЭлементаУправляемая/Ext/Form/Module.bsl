&НаКлиенте
Процедура ВыбратьЗадачуРодителя()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыбиратьТолькоЭтапы", Истина);
	
	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.Владелец);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьЗадачуРодителяОсновная",ЭтотОбъект);
	ОткрытьФорму("Справочник.упоШаблоныПроектныхЗадач.ФормаВыбора", ПараметрыФормы,,,,,ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗадачуРодителяОсновная(ВыбранныйРодитель,ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйРодитель) Тогда
		Если ВыбранныйРодитель = Объект.Ссылка Тогда
			Сообщение = НСтр("ru = 'Нельзя выбрать в качестве родителя эту же проектную задачу!'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение);
		Иначе
			Объект.Родитель = ВыбранныйРодитель;     
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьПоНормеТрудовыеРесурсыСервер()
	
	Если ЗначениеЗаполнено(Объект.НормаСтоимостиТрудовыхРесурсов) Тогда      
		
		ТрудовыеРесурсыКопия = Объект.ТрудовыеРесурсы.Выгрузить();
		
		упоРесурсыИНормыВызовСервера.обРассчитатьСтоимостьРесурсовПоНорме(ТрудовыеРесурсыКопия, Объект, Объект.НормаСтоимостиТрудовыхРесурсов);
		Объект.ТрудовыеРесурсы.Загрузить(ТрудовыеРесурсыКопия);

	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.ВнешняяНормаСтоимостиТрудовыхРесурсов) Тогда
		
		ТрудовыеРесурсы = Объект.ТрудовыеРесурсы.Выгрузить(); 
		
		КолонкаСтоимость =  ТрудовыеРесурсы.Колонки.Найти("Стоимость");
		КолонкаСтоимость.Имя =  "Стоимость1";
		
		КолонкаОбщСтоимость = ТрудовыеРесурсы.Колонки.Найти("ОбщСтоимость");
		КолонкаОбщСтоимость.Имя = "ОбщСтоимость1";
		
		КолонкаСтоимостьВн =  ТрудовыеРесурсы.Колонки.Найти("ВнешняяСтоимость");
		КолонкаСтоимостьВн.Имя = "Стоимость";
		КолонкаОбщСтоимостьВн =  ТрудовыеРесурсы.Колонки.Найти("ОбщВнешняяСтоимость");
		КолонкаОбщСтоимостьВн.Имя = "ОбщСтоимость";
		
		упоРесурсыИНормыВызовСервера.обРассчитатьСтоимостьРесурсовПоНорме(ТрудовыеРесурсы, Объект, Объект.ВнешняяНормаСтоимостиТрудовыхРесурсов);		
		
		КолонкаСтоимостьВн.Имя =  "ВнешняяСтоимость";
		КолонкаОбщСтоимостьВн.Имя = "ОбщВнешняяСтоимость";
		КолонкаСтоимость.Имя =  "Стоимость";
		КолонкаОбщСтоимость.Имя = "ОбщСтоимость";
		
		Объект.ТрудовыеРесурсы.Загрузить(ТрудовыеРесурсы);
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЧФинПланы(ИмяКоманды)

	Если ИмяКоманды.Имя = "ПланДоходовУстановитьКонтрагента" Тогда
		
		// начало.доходы
		ИмяФормыВыбора = "Справочник.упоШаблоныКонтрагентов.ФормаВыбора";
		ТабличнаяЧасть = "ПланДоходов";
		ИмяРеквизита =  "Контрагент";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоШаблоныКонтрагентов"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);

	ИначеЕсли ИмяКоманды.Имя = "ПланДоходовУстановитьПрофиль" Тогда
		
		ИмяФормыВыбора = "Справочник.упоПрофилиРаспределенияДоходовИРасходов.ФормаВыбора";
		ТабличнаяЧасть = "ПланДоходов";	
		ИмяРеквизита =  "ПрофильРаспределения";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
		// конец.доходы
	ИначеЕсли ИмяКоманды.Имя = "ПланРасходовУстановитьКонтрагента" Тогда
		
		// начало.расходы
		ИмяФормыВыбора = "Справочник.упоШаблоныКонтрагентов.ФормаВыбора";
		ТабличнаяЧасть = "ПланРасходов";
		ИмяРеквизита =  "Контрагент";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоШаблоныКонтрагентов"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
	ИначеЕсли ИмяКоманды.Имя = "ПланРасходовУстановитьПрофиль" Тогда
		
		ИмяФормыВыбора = "Справочник.упоПрофилиРаспределенияДоходовИРасходов.ФормаВыбора";
		ТабличнаяЧасть = "ПланРасходов";
		ИмяРеквизита =  "ПрофильРаспределения";

		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
		// конец.расходы
		
	ИначеЕсли ИмяКоманды.Имя = "ПланПоступленийУстановитьКонтрагента" Тогда
		
		// начало.ПланПоступлений
		ИмяФормыВыбора = "Справочник.упоШаблоныКонтрагентов.ФормаВыбора";
		ТабличнаяЧасть = "ПланПоступлений";
		ИмяРеквизита =  "Контрагент";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоШаблоныКонтрагентов"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
	ИначеЕсли ИмяКоманды.Имя = "ПланПоступленийУстановитьСпособПривязки" Тогда
		
		ИмяФормыВыбора = "Перечисление.упоСпособПривязкиДДС.ФормаВыбора";
		ТабличнаяЧасть = "ПланПоступлений";
		ИмяРеквизита =  "СпособПривязки";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("ПеречислениеСсылка.упоСпособПривязкиДДС"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
		// конец.ПланПоступлений
		
	ИначеЕсли ИмяКоманды.Имя = "ПланВыплатУстановитьКонтрагента" Тогда
		
		// начало.ПланВыплат
		ИмяФормыВыбора = "Справочник.упоШаблоныКонтрагентов.ФормаВыбора";
		ТабличнаяЧасть = "ПланВыплат";	
		ИмяРеквизита =  "Контрагент";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоШаблоныКонтрагентов"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
	ИначеЕсли ИмяКоманды.Имя = "ПланВыплатУстановитьСпособПривязки" Тогда
		
		ИмяФормыВыбора = "Перечисление.упоСпособПривязкиДДС.ФормаВыбора";
		ТабличнаяЧасть = "ПланВыплат";	
		ИмяРеквизита =  "СпособПривязки";
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("ПеречислениеСсылка.упоСпособПривязкиДДС"));	
		ОписаниеТиповЗначения = Новый ОписаниеТипов(МассивТипов);
		
		// конец.ПланВыплат

	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьТЧФинПланыЗавершение",ЭтотОбъект);
	
	упоРаботаСФормамиКлиент.ЗаполнитьЗначениеВТЧ(Объект, ТабличнаяЧасть, ИмяРеквизита,
		ОписаниеТиповЗначения,,,,,ОписаниеОповещения);
	
КонецПроцедуры
	
