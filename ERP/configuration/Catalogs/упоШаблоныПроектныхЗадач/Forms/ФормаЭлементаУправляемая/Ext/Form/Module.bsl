			мВалютаУправленческогоУчета), Неопределено, "КонтрагентДоходов", "ДоговорДоходов", СтрокаТЧ, "Субпродукты");
		ЗаполнитьЗначенияСвойств(ТекСтрока, СтрокаТЧ);
        		
		ОбновитьДатуВыпускаПланВыпуска(ТекСтрока);
