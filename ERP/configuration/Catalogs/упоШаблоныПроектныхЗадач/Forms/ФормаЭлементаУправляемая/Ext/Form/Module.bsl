&НаКлиенте
Процедура МатериальныеРесурсыПриАктивизацииСтроки(Элемент)
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма,
		"МатериальныеРесурсы", "РаспределениеПотребностей","ОбщСтоимость", Истина);
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеПотребностей",
		"МатериальныеРесурсы");
	
КонецПроцедуры

&НаКлиенте
Процедура МатериальныеРесурсыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	УстановитьОграничениеТиповМатериальныеРесурсы();
	 
	ТекСтрока = Элементы.МатериальныеРесурсы.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено И НоваяСтрока Тогда
		
		СтрокаТЧ = Неопределено;		
		ПодготовитьКопиюДанныхОбъекта(СтрокаТЧ, "МатериальныеРесурсы");
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекСтрока);
        упоФункцииОбщегоНазначенияВызовСервера.ЗаполнитьСтрокуПоУмолчанию(Новый Структура("мВалютаУправленческогоУчета",
			мВалютаУправленческогоУчета), Неопределено, "КонтрагентЗатрат", "ДоговорЗатрат", СтрокаТЧ, "МатериальныеРесурсы");
		ЗаполнитьЗначенияСвойств(ТекСтрока, СтрокаТЧ);
        		
	КонецЕсли;
	
	УстановитьТолькоПросмотрВалюте("ПланРасходов", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьКопиюДанныхОбъекта(СтруктураПустая, ИмяТЧ = Неопределено)
	
	// Перенести код в модуль с повторным использованием значений.
	
	СтруктураПустая = Новый Структура;
	
	Если ИмяТЧ = Неопределено Тогда 
		
		Для Каждого РеквизитМетаданных Из Метаданные.Справочники.упоШаблоныПроектныхЗадач.Реквизиты Цикл
			
			СтруктураПустая.Вставить(РеквизитМетаданных.Имя);
			
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(СтруктураПустая, Объект);
		
	Иначе 
		
		Для Каждого РеквизитМетаданных Из Метаданные.Справочники.упоШаблоныПроектныхЗадач.ТабличныеЧасти[ИмяТЧ].Реквизиты Цикл
			
			СтруктураПустая.Вставить(РеквизитМетаданных.Имя);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

