// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// Выполняет действия при подборе - заполняет строку дополнительными данными.
//
// Параметры:
//  СтрокаТабличнойЧасти - ДанныеФормыЭлементКоллекции, Структура  - строка данных.
//  ПараметрыПодбора	 - Структура, Неопределено - параметры подбора.
&НаКлиенте
Процедура ВыполнитьДействияПриПодборе(СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт
	
	ПараметрыПодбораФормы = Неопределено;
	
	Если ПараметрыПодбора.Свойство("ЭтоСубпродукты") И СтрокаТабличнойЧасти.Свойство("ПрофильРаспределения")
		И Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ПрофильРаспределения) Тогда 
		СтрокаТабличнойЧасти.ПрофильРаспределения = ПрофильДоходовПоУмолчанию();
	КонецЕсли;

	упоПодборВТабличнуюЧастьКлиент.ВыполнитьДействияПриПодбореВПроектнойЗадаче(СтрокаТабличнойЧасти, 
		ПараметрыПодбора, ПараметрыПодбораФормы);
		
	Если ПараметрыПодбора.Свойство("МассивРаспределенияОбъемов") И
		упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(СтрокаТабличнойЧасти.Ресурс) Тогда
		ПересчитатьИтогиПоТаблицеПП(); 
	КонецЕсли;

	Если ТипЗнч(ПараметрыПодбора) = Тип("Структура") Тогда
		Если ПараметрыПодбора.Свойство("ДобавлениеПредшественника") Тогда
			СтрокаТабличнойЧасти.ТипСвязи = ПредопределенноеЗначение("Перечисление.упоТипСвязи.ОкончаниеНачало");
			СтрокаТабличнойЧасти.ЕдиницаНормированияДлительности = ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.Час");
		ИначеЕсли ПараметрыПодбора.Свойство("ТрудовыеРесурсы") Тогда
			СтрокаТабличнойЧасти.Количество = 1;
			СтрокаТабличнойЧасти.ЕдиницаНормирования = ПредопределенноеЗначение("Справочник.упоЕдиницыВремени.Час");
			СтрокаТабличнойЧасти.Подразделение = упоУправлениеФормамиСервер.ПолучитьПодразделениеРолиВызовСервера(СтрокаТабличнойЧасти.Ресурс);
		ИначеЕсли ПараметрыПодбора.Свойство("МатериальныеРесурсы") Тогда
			СтрокаТабличнойЧасти.Количество = 1;
			ЗаполнитьЕдиницуНормированияСтрокиТабЧасти(СтрокаТабличнойЧасти);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

