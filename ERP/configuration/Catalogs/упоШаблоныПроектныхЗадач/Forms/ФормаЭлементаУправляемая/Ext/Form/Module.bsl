&НаКлиенте
Функция ПодготовитьДопПараметры(имяКоманды)
	
	Перем ПараметрыПодбора;
	
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьСтруктуруПараметровПодбора(ПараметрыПодбора);
	 		
	АдресХранилища = "";
	
	Если имяКоманды = "ПредшественницыПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПредУсловия;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоШаблоныПроектныхЗадач";
        ТаблицаФормы = Объект.ПредУсловия;
	    ИмяКолонки = "ЗадачаПредшественник";
					
				
	ИначеЕсли  имяКоманды = "РолиТрудовыхРесурсовПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ТрудовыеРесурсы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоРоли";
		ТаблицаФормы = Объект.ТрудовыеРесурсы;
		ИмяКолонки = "Ресурс";		
				
	ИначеЕсли  имяКоманды = "ДопЗатратыПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ДополнительныеЗатраты;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоСтатьиЗатрат";
		ТаблицаФормы = Объект.ДополнительныеЗатраты;
		ИмяКолонки = "СтатьяЗатрат";		
		
	ИначеЕсли  имяКоманды = "ПланДоходовПодобратьПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланДоходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоШаблоныКонтрагентов";
		ТаблицаФормы = Объект.ПланДоходов;
		ИмяКолонки = "Контрагент";		
		
	ИначеЕсли  имяКоманды = "ПланДоходовПодобратьПостатьямДохода" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланДоходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоСтатьиДоходов";
		ТаблицаФормы = Объект.ПланДоходов;
		ИмяКолонки = "Статья";		
		
	ИначеЕсли  имяКоманды = "ПланРасходовПодобратьПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланРасходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоШаблоныКонтрагентов";
		ТаблицаФормы = Объект.ПланРасходов;
		ИмяКолонки = "Контрагент";		
		
	ИначеЕсли  имяКоманды = "ПланРасходовПодобратьПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланРасходов;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоСтатьиЗатрат";
		ТаблицаФормы = Объект.ПланРасходов;
		ИмяКолонки = "Статья";		
		
	ИначеЕсли  имяКоманды = "ПланПоступленийПодобратьПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланПоступлений;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.СтатьиДвиженияДенежныхСредств";
		ТаблицаФормы = Объект.ПланПоступлений;
		ИмяКолонки = "Статья";		
		
	ИначеЕсли  имяКоманды = "ПланПоступленийПодобратьПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланПоступлений;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоШаблоныКонтрагентов";
		ТаблицаФормы = Объект.ПланПоступлений;
		ИмяКолонки = "Контрагент";				
		
	ИначеЕсли  имяКоманды = "МатериалыИДопОборудованиеПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.МатериальныеРесурсы;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.Номенклатура";
		ТаблицаФормы = Объект.МатериальныеРесурсы;
		ИмяКолонки = "Ресурс";				
		
	ИначеЕсли  имяКоманды = "ПланВыплатПодобратьПоСтатьям" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланВыплат;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.СтатьиДвиженияДенежныхСредств";
		ТаблицаФормы = Объект.ПланВыплат;
		ИмяКолонки = "Статья";				
		
	ИначеЕсли  имяКоманды = "ПланВыплатПодобратьПоКонтрагентам" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.ПланВыплат;
		ПараметрыПодбора.ИмяОбъектаВМетаданных =  "Справочники.упоШаблоныКонтрагентов";
		ТаблицаФормы = Объект.ПланВыплат;
		ИмяКолонки = "Контрагент";				
		
	ИначеЕсли  имяКоманды = "СубпродуктыПодобрать" Тогда
		
		ПараметрыПодбора.ЭлементВладелец =  Элементы.Субпродукты;
		Если Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
			ИмяОбъектаВМетаданных =  "Справочники.упоПроектнаяПродукция";
			ПараметрыПодбора.ДопПараметры.Вставить("УстановитьПользовательскиеНастройки", Истина);
		Иначе
			ИмяОбъектаВМетаданных =  "Справочники.Номенклатура";
		КонецЕсли;
		ПараметрыПодбора.ИмяОбъектаВМетаданных = ИмяОбъектаВМетаданных;
		ТаблицаФормы = Объект.Субпродукты;
		ИмяКолонки = "Ресурс";				
				
	КонецЕсли;
	
	СтруктураДоп = ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы, ИмяКолонки,
		ПараметрыПодбора.ДопПараметры.СписокВидимыхКолонок);
	
	ПараметрыПодбора.ДопПараметры.ВыбранныеЗначения = СтруктураДоп.АдресХранилищаВыбранных;
	ПараметрыПодбора.ДопПараметры.ТаблицаОтбор = СтруктураДоп.АдресХранилищаОтбора;
    ПараметрыПодбора.ДопПараметры.ДеревоОтбор = СтруктураДоп.АдресХранилищаДеревоОтбора;

	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Функция ДополнительныеПараметрыПодбора(имяКоманды, ТаблицаФормы,  ИмяКолонки, СписокВидимыхКолонок)
	
	СтруктураДоп  = Новый Структура;
	
	СтруктураДоп.Вставить("АдресХранилищаВыбранных");
	СтруктураДоп.Вставить("АдресХранилищаОтбора");
	СтруктураДоп.Вставить("АдресХранилищаДеревоОтбора");
	
	Если имяКоманды = "ПредшественницыПодобрать" Тогда
		
		СтруктураДоп.АдресХранилищаОтбора = ПодготовитьТаблицуОтбораПодбора(имяКоманды);
		
	ИначеЕсли имяКоманды = "СубпродуктыПодобрать"
				И Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
		
		СтруктураДоп.АдресХранилищаДеревоОтбора = ПодготовитьДеревоОтбораПодбора(имяКоманды);

	КонецЕсли;
		
	АдресХранилища = упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуВыбранныхЗначений(ЭтаФорма.УникальныйИдентификатор,
		ТаблицаФормы, ИмяКолонки, СписокВидимыхКолонок);
	СтруктураДоп.АдресХранилищаВыбранных = АдресХранилища;
	
	Возврат СтруктураДоп;
	
КонецФункции

&НаСервере
Функция ПодготовитьТаблицуОтбораПодбора(имяКоманды)
	
	Перем ТаблицаОтбора;
	
	упоПодборВТабличнуюЧастьСервер.ПодготовитьТаблицуОтбора(ТаблицаОтбора);	  
	
	Если имяКоманды = "ПредшественницыПодобрать" Тогда
		
		НоваяСтрока 					=  ТаблицаОтбора.Добавить();
		НоваяСтрока.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Ссылка");
		НоваяСтрока.ВидСравнения 		= ВидСравненияКомпоновкиДанных.ВСписке;
		НоваяСтрока.Применение 			= ТипПримененияОтбораКомпоновкиДанных.Элементы;
		НоваяСтрока.Использование  		= Истина;
		НоваяСтрока.РежимОтображения 	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Авто;
		
		ЗапросПЗ = Новый Запрос;
		ЗапросПЗ.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		                 |	упоШаблоныПроектныхЗадач.Ссылка КАК ПроектнаяЗадача
		                 |ИЗ
		                 |	Справочник.упоШаблоныПроектныхЗадач КАК упоШаблоныПроектныхЗадач
		                 |ГДЕ
		                 |	упоШаблоныПроектныхЗадач.Владелец = &Владелец
		                 |	И НЕ упоШаблоныПроектныхЗадач.Ссылка = &Ссылка";
		
		ЗапросПЗ.УстановитьПараметр("Владелец", Объект.Владелец);
		ЗапросПЗ.УстановитьПараметр("Ссылка", Объект.Ссылка);
		
		ТаблицаПЗ = ЗапросПЗ.Выполнить().Выгрузить();
		
		МассивПЗ = ТаблицаПЗ.ВыгрузитьКолонку("ПроектнаяЗадача");
		
		СписокЗадач = Новый СписокЗначений;
		СписокЗадач.ЗагрузитьЗначения(МассивПЗ);
		
		НоваяСтрока.ПравоеЗначение = СписокЗадач;
				
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОтбора, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ПодготовитьДеревоОтбораПодбора(имяКоманды)
	
	ДеревоОтбора = упоПодборВТабличнуюЧастьСервер.НовоеДеревоОтбора();	  
	
	Если имяКоманды = "СубпродуктыПодобрать"
				И Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция") Тогда
			
		ОтборПометкаУдаления = ДеревоОтбора.Строки.Добавить();
		ОтборПометкаУдаления.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
		ОтборПометкаУдаления.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборПометкаУдаления.Использование  = Истина;
		ОтборПометкаУдаления.ПравоеЗначение = Ложь;
		ОтборПометкаУдаления.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		НоваяСтрокаШаблон = ДеревоОтбора.Строки.Добавить();
		НоваяСтрокаШаблон.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Шаблон");
		НоваяСтрокаШаблон.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НоваяСтрокаШаблон.Использование = Истина;
		НоваяСтрокаШаблон.ПравоеЗначение = Истина;
		НоваяСтрокаШаблон.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		НоваяСтрокаШаблон.ИмяПоля = "Шаблон";
							
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ДеревоОтбора, ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура УстановитьВидимость()

	ЭтоПР = Объект.ЭтоПакетРабот;
	ЭтоМПР = Объект.ЭтоМодельПакетаРабот;
	ЭтоВеха = (Не ЭтоПР) И (Не ЭтоМПР) И Объект.ЭтоВеха;
	
	Элементы.ДлительностьМоделиПакетаРабот.Видимость = ЭтоМПР;
	Элементы.ЕдиницаНормированияДлительности.Видимость = ЭтоМПР;
	Элементы.ДлительностьБезУчетаКалендаряПроекта.Видимость = ЭтоМПР;
	Элементы.ГруппаЗаполнитьДлительность.Видимость = ЭтоМПР;
				
КонецПроцедуры

&НаКлиенте
Процедура НадписьЗадачаРодительНажатие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		
		ПоказатьЗначение(,Объект.Родитель);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьСроков() 
	
	Элементы.ДатаНачалаПлан.ТолькоПросмотр = Объект.ЭтоВеха ИЛИ НЕ Объект.РучнойВводСроков;	
	Элементы.ДатаНачалаПлан.АвтоОтметкаНезаполненного = НЕ Элементы.ДатаНачалаПлан.ТолькоПросмотр;
	Если Элементы.ДатаНачалаПлан.ТолькоПросмотр Тогда
		Элементы.ДатаНачалаПлан.ОтметкаНезаполненного = Ложь;
	КонецЕсли;	
	
	Элементы.ДатаЗавершенияПлан.ТолькоПросмотр = НЕ Объект.РучнойВводСроков;
	Элементы.ДатаЗавершенияПлан.АвтоОтметкаНезаполненного = НЕ Элементы.ДатаНачалаПлан.ТолькоПросмотр;
	Если Элементы.ДатаЗавершенияПлан.ТолькоПросмотр Тогда
		Элементы.ДатаЗавершенияПлан.ОтметкаНезаполненного = Ложь;
	КонецЕсли;	

	
КонецПроцедуры

