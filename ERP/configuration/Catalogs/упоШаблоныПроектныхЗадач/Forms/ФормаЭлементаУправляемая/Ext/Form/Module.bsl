&НаКлиенте
Процедура ЗаполнитьЗначениевТЧ(Команда)
	
	ЗаполнитьЗначениевТЧОбщая(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениевТЧОбщая(ИмяКоманды)
	
	ДозаполнитьДоговор = Ложь;
	
	Если ИмяКоманды = "МатериалыИОборудование_СпособПривязки" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("ПеречислениеСсылка.упоСпособПривязкиПоставокИСубпродуктов"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "МатериальныеРесурсы";
		ИмяКолонки = "СпособПривязкиПотребности";
		
	ИначеЕсли ИмяКоманды = "МатериалыИОборудование_ЗадержкаЗаказа" Тогда
		
		ОписаниеТиповП= Новый КвалификаторыЧисла(10,0, ДопустимыйЗнак.Любой);
		ИмяТЧ = "МатериальныеРесурсы";
		ИмяКолонки = "ЗадержкаЗаказа";
		
	ИначеЕсли ИмяКоманды = "МатериалыИОборудование_СтатьяЗатрат" Тогда
		
		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("СправочникСсылка.упоСтатьиЗатрат"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		ИмяТЧ = "МатериальныеРесурсы";
		ИмяКолонки = "СтатьяЗатрат";
		
	ИначеЕсли ИмяКоманды = "МатериалыИОборудование_ПрофильРаспределения" Тогда
		
		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		ИмяТЧ = "МатериальныеРесурсы";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "МатериалыИОборудование_Контрагент" Тогда
		
		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("СправочникСсылка.Контрагенты"));
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		ИмяТЧ = "МатериальныеРесурсы";
		ИмяКолонки = "Контрагент";
		ДозаполнитьДоговор = Истина;
		
	ИначеЕсли ИмяКоманды = "Субпродукты_СпособПривязки" Тогда

		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("ПеречислениеСсылка.упоСпособПривязкиПоставокИСубпродуктов"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "СпособПривязкиВыпуска";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_ЗадержкаЗаказа" Тогда
		
		ОписаниеТиповП= Новый КвалификаторыЧисла(10,0, ДопустимыйЗнак.Любой);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "ЗадержкаЗаказа";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_СтатьяДоходов" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.упоСтатьиДоходов"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "СтатьяДоходов";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_ПрофильРаспределения" Тогда
		
		МассивТиповПеречисление = Новый Массив;
		МассивТиповПеречисление.Добавить(Тип("СправочникСсылка.упоПрофилиРаспределенияДоходовИРасходов"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТиповПеречисление);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "ПрофильРаспределения";
		
	ИначеЕсли ИмяКоманды = "Субпродукты_Контрагент" Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("СправочникСсылка.Контрагенты"));	
		ОписаниеТиповП = Новый ОписаниеТипов(МассивТипов);
		ИмяТЧ = "Субпродукты";
		ИмяКолонки = "Контрагент";
		ДозаполнитьДоговор = Истина;
		
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("ИмяТЧ",ИмяТЧ);
	Контекст.Вставить("ИмяКолонки",ИмяКолонки);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьЗначениевТЧОбщаяЗавершение",ЭтотОбъект,Контекст);
	
	упоРаботаСФормамиКлиент.ЗаполнитьЗначениеВТЧ(Объект, ИмяТЧ, ИмяКолонки, ОписаниеТиповП,
		ДозаполнитьДоговор,,,,ОписаниеОповещения);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ЗаполнитьЗначениевТЧОбщаяЗавершение(Результат,ДополнительныеПараметры) Экспорт
	
	ВведенноеЗначение = Результат;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НадписьПоследняяМодификацияНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	упоУправлениеФормамиКлиент.ФормаНадписьПоследняяМодификацияНажатие(Объект, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ТипПроектнойЗадачиПриИзменении(Элемент)
	
	упоПроектыИЗадачиОбщие.ЗаписатьТипЗадачи(Объект);	
	УстановитьВидимость();  	
	УстановитьДоступностьСроков();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборРежимаВводаСроковПриИзменении(Элемент)
	
	Если ВыборРежимаВводаСроков = 1 Тогда
		Объект.РучнойВводСроков = Истина;
	Иначе
		Объект.РучнойВводСроков = Ложь;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
	УстановитьОтметкуНезаполненного(Не Объект.РучнойВводСроков);
	
	УстановитьДоступностьСроков();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПланПриИзменении(Элемент)
	
	ПриИзмененииСроков();
		
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗавершенияПланПриИзменении(Элемент)
	
	ПриИзмененииСроков();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительностьМоделиПакетаРаботПриИзменении(Элемент)
	
	Новый_ПриИзмененииДлительности_Клиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаНормированияДлительностиПриИзменении(Элемент)
		
	Если Не ЗначениеЗаполнено(Объект.ЕдиницаНормированияДлительности) Тогда
		Возврат;
	КонецЕсли;
	
	Новый_ПодсчитатьДлительность();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПредусловия

&НаКлиенте
