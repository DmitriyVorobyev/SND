	ИмяТабличнойЧасти = "Субпродукты";
	ПараметрыПодбораСтруктура = Неопределено;
	упоПодборВТабличнуюЧастьКлиент.ПодготовитьДопПараметрыСтруктурыПодбора(ЭтаФорма, ПараметрыПодбораСтруктура, ИмяТабличнойЧасти, 
		ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТабличнойЧасти));
		
	ПараметрыПодбораСтруктура.Вставить("ЭтоСубпродукты", Истина);	
	Если ВключенПереключательПроектнаяПродукция() Тогда
		ПараметрыПодбораСтруктура.Вставить("РаспределениеОбъемов", Объект.РаспределениеОбъемов);
		ПараметрыПодбораСтруктура.Вставить("Субпродукты", Объект.Субпродукты);  
	КонецЕсли;		
	
			
	упоПодборВТабличнуюЧастьКлиент.ТабличнаяЧастьОбработкаВыбора(ВыбранноеЗначение,
																 "Ресурс",
																 Объект.Субпродукты,
																 ЭтаФорма,
																 Истина,
																 ПараметрыПодбораСтруктура);
																 
	упоРаботаСФормамиКлиент.ПроверитьНоменклатуруСтрокиНаЗаполнениеЕдИзмВТаблице(Объект, ИмяТабличнойЧасти);

