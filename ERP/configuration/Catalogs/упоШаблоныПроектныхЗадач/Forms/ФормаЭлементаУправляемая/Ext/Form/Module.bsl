// ПРОЦЕДУРЫ И ФУНКЦИИ МОДУЛЯ ФОРМЫ ПРОЕКТНОЙ ЗАДАЧИ


&НаСервере
Процедура СоздатьДопЭлементыРаспределенияДоходов(ПроверятьОбъемы, ПроверятьДоходы, ПроверятьПотребности,
	ПроверятьРасходы, ПроверятьРолиТрудовыхРесурсов, ПроверятьДопЗатраты, СоздатьДопКолонки = Неопределено)
	
	Перем ПараметрыРаспределения;
	
	Если ПроверятьОбъемы Тогда
		
		Если СоздатьДопКолонки = Неопределено Тогда
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);
			НеобходимоСоздатьДопКолонки = Объект.РаспределениеОбъемов.НайтиСтроки(ОтборСтрок).Количество() > 0;
		Иначе
			НеобходимоСоздатьДопКолонки = СоздатьДопКолонки;
		КонецЕсли;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			Элементы.РаспределениеОбъемовГруппаКоличествоСуммаРаспределение.Видимость = Истина;
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеОбъемов",
				"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределениеПоРолям", Истина);
		Иначе
			Элементы.РаспределениеОбъемовГруппаКоличествоСуммаРаспределение.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеОбъемов", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьРолиТрудовыхРесурсов Тогда
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.ТрудовыеРесурсы.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			Элементы.ТрудовыеРесурсыГруппаКоличествоРаспределение.Видимость = Истина;
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "ТрудовыеРесурсы",
				"ТрудовыеРесурсыПоПериодам", "ИндексСтрокиРаспределениеПоРолям", Истина);
		Иначе
			Элементы.ТрудовыеРесурсыГруппаКоличествоРаспределение.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "ТрудовыеРесурсы", НеобходимоСоздатьДопКолонки);
		
	КонецЕсли;
	
	Если ПроверятьДоходы Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.РаспределениеДоходов.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеДоходов",
				"РаспределениеДоходовПоПериодам", "ИндексСтрокиРаспределенияДоходов", Ложь);
			Элементы.РаспределениеДоходовГруппаСуммаКоличествоРаспределено.Видимость = Истина;
		Иначе
			Элементы.РаспределениеДоходовГруппаСуммаКоличествоРаспределено.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеДоходов", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьПотребности Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		Если СоздатьДопКолонки = Неопределено Тогда
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
			НеобходимоСоздатьДопКолонки = Объект.РаспределениеПотребностей.НайтиСтроки(ОтборСтрок).Количество() > 0;
		Иначе
			НеобходимоСоздатьДопКолонки = СоздатьДопКолонки;
		КонецЕсли;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеПотребностей", 
				"РаспределениеРасходовПоПериодам","ИндексСтрокиРаспределениеПоРолям", Истина, Истина);
			Элементы.РаспределениеПотребностейГруппаКоличествоСуммаРаспределение.Видимость = Истина;
		Иначе
			Элементы.РаспределениеПотребностейГруппаКоличествоСуммаРаспределение.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеПотребностей", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
	Если ПроверятьРасходы Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		ОтборСтрок = Новый Структура;
		ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
		НеобходимоСоздатьДопКолонки = Объект.РаспределениеРасходов.НайтиСтроки(ОтборСтрок).Количество() > 0;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеРасходов", 
				"РаспределениеРасходовПоПериодам","ИндексСтрокиРаспределенияРасходов", Ложь, Истина);
			Элементы.РаспределениеРасходовГруппаСуммаКоличествоРаспределено.Видимость = Истина;
		Иначе
			Элементы.РаспределениеРасходовГруппаСуммаКоличествоРаспределено.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеРасходов", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;

	Если ПроверятьДопЗатраты Тогда
		
		ПараметрыРаспределения = Неопределено;
		
		Если СоздатьДопКолонки = Неопределено Тогда
			ОтборСтрок = Новый Структура;
			ОтборСтрок.Вставить("СпособПривязки", Перечисления.упоСпособПривязкиРаспределения.Вручную);	
			НеобходимоСоздатьДопКолонки = Объект.РаспределениеДополнительныхЗатрат.НайтиСтроки(ОтборСтрок).Количество() > 0;
		Иначе
			НеобходимоСоздатьДопКолонки = СоздатьДопКолонки;
		КонецЕсли;
		
		Если НеобходимоСоздатьДопКолонки Тогда
			ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, "РаспределениеДополнительныхЗатрат", 
				"РаспределениеРасходовПоПериодам","ИндексСтрокиРаспределениеПоРолям", Ложь, Истина);
			Элементы.РаспределениеДополнительныхЗатратГруппаКоличествоСуммаРаспределение.Видимость = Истина;
		Иначе
			Элементы.РаспределениеДополнительныхЗатратГруппаКоличествоСуммаРаспределение.Видимость = Ложь;
		КонецЕсли;
		
		ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, "РаспределениеДополнительныхЗатрат", НеобходимоСоздатьДопКолонки);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьПараметрыРаспределенияПоПериодам(ПараметрыРаспределения, ТаблицаРаспределения, ТаблицаПериоды,
	КолонкаИндекса, РаспределятьКоличество, ПроверятьИсточникПлана = Ложь)
	
	ПараметрыРаспределения = Новый Структура;
	
	МассивСтрок = Новый Массив;
	СписокКолонокПрограммно = Новый СписокЗначений;
	СписокКолонокИтогов = Новый СписокЗначений;
	
	Для каждого СтрокаРаспределения Из Объект[ТаблицаРаспределения] Цикл 
		
		Если СтрокаРаспределения.СпособПривязки = Перечисления.упоСпособПривязкиРаспределения.Вручную Тогда
			
			МассивСтрок.Добавить(СтрокаРаспределения);
			
		КонецЕсли;
		
	КонецЦикла;
	                     
	ТаблицаДляРаспределения = Объект[ТаблицаРаспределения].Выгрузить(МассивСтрок);	 
	
	Если ПроверятьИсточникПлана Тогда
		ИсточникПлана = упоРаботаСФормамиКлиентСервер.ИсточникПланаПоТаблице(ТаблицаРаспределения);
	КонецЕсли;

	МассивСтрокРаспределенияПоПериодам = Новый Массив;
	
	Для каждого СтрокаРаспределеннаяПоМесяцам Из Объект[ТаблицаПериоды] Цикл
		
		Если СтрокаРаспределеннаяПоМесяцам[КолонкаИндекса] <> Неопределено Тогда
			
			Если ПроверятьИсточникПлана И СтрокаРаспределеннаяПоМесяцам.ИсточникПлана <> ИсточникПлана Тогда
				Продолжить;
			КонецЕсли;
			МассивСтрокРаспределенияПоПериодам.Добавить(СтрокаРаспределеннаяПоМесяцам);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	СрокиЗадачи = Новый Структура;
	
	СрокиЗадачи.Вставить("ДатаНачала", Объект.ДатаНачалаПлан);
	СрокиЗадачи.Вставить("ДатаОкончания", Объект.ДатаЗавершенияПлан);
	
	ТаблицаРаспределениеПоПериодам = Объект[ТаблицаПериоды].Выгрузить(МассивСтрокРаспределенияПоПериодам);
	
	Если ТаблицаРаспределениеПоПериодам.Количество() > 0 Тогда
		
		ТаблицаРаспределениеПоПериодам.Сортировать("Период убыв");
		КрайнийСрокКонец = ТаблицаРаспределениеПоПериодам.Получить(0).Период;
		ТаблицаРаспределениеПоПериодам.Сортировать("Период возр");
		КрайнийСрокНачало = ТаблицаРаспределениеПоПериодам.Получить(0).Период;
		
		Если КрайнийСрокКонец > Объект.ДатаЗавершенияПлан Тогда
			
			СрокиЗадачи.Вставить("ДатаОкончания", КрайнийСрокКонец);
			
		КонецЕсли;
		
		Если КрайнийСрокНачало < Объект.ДатаНачалаПлан Тогда
			
			СрокиЗадачи.Вставить("ДатаНачала", КрайнийСрокНачало);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	Если Не ЗначениеЗаполнено(СрокиЗадачи.ДатаНачала) Тогда
		СрокиЗадачи.ДатаНачала = ТекДата;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СрокиЗадачи.ДатаОкончания) Тогда
		СрокиЗадачи.ДатаОкончания = ТекДата;
	КонецЕсли;
	
	КонецМесяцаНачало = КонецМесяца(СрокиЗадачи.ДатаНачала);
	КонецМесяцаКонец = КонецМесяца(СрокиЗадачи.ДатаОкончания);
	
	СписокПериодов = Новый СписокЗначений;
	
	СчетчикПериодов = КонецМесяцаНачало;
	
	Пока СчетчикПериодов <= КонецМесяцаКонец Цикл
		
		СписокПериодов.Добавить(СчетчикПериодов);
		СчетчикПериодов = КонецМесяца(СчетчикПериодов + 1);
		
	КонецЦикла;
	
	МассивТиповКолво = Новый Массив;
	МассивТиповКолво.Добавить(Тип("Число"));
	
	Если ТаблицаРаспределения <> "ТрудовыеРесурсы" Тогда 
		Точность = 3;
	Иначе
		Точность = 2;
	КонецЕсли;
	КЧКоличество = Новый КвалификаторыЧисла(15, Точность, ДопустимыйЗнак.Неотрицательный);
	ОписаниеТиповКоличество = Новый ОписаниеТипов(МассивТиповКолво, , , КЧКоличество);
	
	КЧСумма = Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой);
	ОписаниеТиповСумма = Новый ОписаниеТипов(МассивТиповКолво, , , КЧСумма);
				
	Для каждого СтрокаСпискаПериодов Из СписокПериодов Цикл
		
		Если РаспределятьКоличество Тогда
			
			ИмяКолонкиКоличество = "Количество_" + ТаблицаРаспределения + "_" 
				+ Формат(СтрокаСпискаПериодов.Значение, "ДФ=MM_yyyy");
			Если ТаблицаДляРаспределения.Колонки.Найти(ИмяКолонкиКоличество) = Неопределено Тогда
				НоваяКолонка = ТаблицаДляРаспределения.Колонки.Добавить(ИмяКолонкиКоличество, ОписаниеТиповКоличество,
					Формат(СтрокаСпискаПериодов.Значение,"ДФ='MMMM yyyy'") + "(кол.)");
			КонецЕсли;
			
			СписокКолонокИтогов.Добавить("Всего_" + ИмяКолонкиКоличество);		
			СписокКолонокПрограммно.Добавить(СтрокаСпискаПериодов.Значение, ИмяКолонкиКоличество);
			
		КонецЕсли;
		
		Если ТаблицаРаспределения <> "ТрудовыеРесурсы" Тогда

			ИмяКолонкиСумма = "Сумма_" + ТаблицаРаспределения + "_" + Формат(СтрокаСпискаПериодов.Значение, "ДФ=MM_yyyy");		
			Если ТаблицаДляРаспределения.Колонки.Найти(ИмяКолонкиСумма) = Неопределено Тогда
				НоваяКолонка = ТаблицаДляРаспределения.Колонки.Добавить(ИмяКолонкиСумма, ОписаниеТиповСумма,
					Формат(СтрокаСпискаПериодов.Значение, "ДФ='MMMM yyyy'"));
			КонецЕсли;
			
			СписокКолонокПрограммно.Добавить(СтрокаСпискаПериодов.Значение, ИмяКолонкиСумма);
			
			СписокКолонокИтогов.Добавить("Всего_" + ИмяКолонкиСумма);
				
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаРаспределеннаяПоПериодам Из ТаблицаРаспределениеПоПериодам Цикл
		
		НайденнаяСтрока = ТаблицаДляРаспределения.Найти(СтрокаРаспределеннаяПоПериодам[КолонкаИндекса],
			"ИндексСтрокРаспределенияПоПериодам");
		
		Если НайденнаяСтрока <> Неопределено Тогда
			Если РаспределятьКоличество Тогда
				ИмяКолонки = "Количество_" + ТаблицаРаспределения + "_" 
					+ Формат(СтрокаРаспределеннаяПоПериодам.Период, "ДФ=MM_yyyy");
				НайденнаяСтрока[ИмяКолонки]  =  СтрокаРаспределеннаяПоПериодам.Количество;
			КонецЕсли;
			Если ТаблицаРаспределения <> "ТрудовыеРесурсы" Тогда
				ИмяКолонки = "Сумма_" + ТаблицаРаспределения + "_" + Формат(СтрокаРаспределеннаяПоПериодам.Период, "ДФ=MM_yyyy");
				НайденнаяСтрока[ИмяКолонки] = СтрокаРаспределеннаяПоПериодам.Сумма;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыРаспределения.Вставить("СрокиЗадачи", СрокиЗадачи);
	ПараметрыРаспределения.Вставить("АдресТР", ТаблицаДляРаспределения);
	ПараметрыРаспределения.Вставить("РаспределятьКоличество", РаспределятьКоличество);
	ПараметрыРаспределения.Вставить("СписокКолонокПрограммно", СписокКолонокПрограммно);
	ПараметрыРаспределения.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыРаспределения.Вставить("СписокПериодов", СписокПериодов);
	ПараметрыРаспределения.Вставить("КолонкаИндекса", КолонкаИндекса);
	ПараметрыРаспределения.Вставить("РаспределятьКоличество", РаспределятьКоличество);
	ПараметрыРаспределения.Вставить("СписокКолонокИтогов", СписокКолонокИтогов);
	
	Если ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам = Неопределено Тогда	
		ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам = Новый Структура;
	КонецЕсли;

	Если Не ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам.Свойство(ТаблицаРаспределения) Тогда
		ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам.Вставить(ТаблицаРаспределения);
	КонецЕсли;
	ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам[ТаблицаРаспределения] = СписокКолонокПрограммно;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУдалитьДопЭлементыФормы(ПараметрыРаспределения, ИмяТаблицыРаспределения,
	НеобходимоСоздатьДопКолонки = Истина)
	
	Если НеобходимоСоздатьДопКолонки Тогда
		
		ТаблицаРаспределения  = ПараметрыРаспределения.АдресТР;
		
	КонецЕсли;
	
	СписокЭлементовДляДобавления = Новый СписокЗначений;
	МассивРеквизитов = Новый Массив;
	
	МассивРеквизитовНаУдаление = Новый Массив;
	СписокЭлементовДляУдаления = Новый СписокЗначений;
	
	ПрограммноСозданныеЭлементы = упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(ЭтаФорма, ИмяТаблицыРаспределения);
	Для Каждого ЭлементПрограммно Из ПрограммноСозданныеЭлементы Цикл
		
		СписокЭлементовДляУдаления.Добавить(ЭлементПрограммно);		
		
		Если ЭлементПрограммно.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
			
			Для Каждого ЭлементПодчиненный Из ЭлементПрограммно.ПодчиненныеЭлементы Цикл
				
				МассивРеквизитовНаУдаление.Добавить(ЭлементПодчиненный.ПутьКДанным);
				
				Если СтрДлина(ЭлементПодчиненный.ПутьКДаннымПодвала) > 0 Тогда
					
					МассивРеквизитовНаУдаление.Добавить(ЭлементПодчиненный.ПутьКДаннымПодвала);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			МассивРеквизитовНаУдаление.Добавить(ЭлементПрограммно.ПутьКДанным);
			
			Если СтрДлина(ЭлементПрограммно.ПутьКДаннымПодвала) > 0 Тогда
				
				МассивРеквизитовНаУдаление.Добавить(ЭлементПрограммно.ПутьКДаннымПодвала);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НеобходимоСоздатьДопКолонки Тогда
		Для Каждого КолонкаПрограммно Из ПараметрыРаспределения.СписокКолонокПрограммно Цикл
			
			КолонкаТаблицы = ТаблицаРаспределения.Колонки.Найти(КолонкаПрограммно.Представление);	 
			НоваяКолонка = Новый РеквизитФормы(КолонкаТаблицы.Имя, КолонкаТаблицы.ТипЗначения, "Объект." 
				+ ИмяТаблицыРаспределения, КолонкаТаблицы.Заголовок, Истина);
			МассивРеквизитов.Добавить(НоваяКолонка);
			СписокЭлементовДляДобавления.Добавить(КолонкаТаблицы.Имя, КолонкаТаблицы.Заголовок);
			
		КонецЦикла;
		
		МассивТиповЧисло = Новый Массив;
		МассивТиповЧисло.Добавить(Тип("Число"));
		
		Если ТаблицаРаспределения <> "ТрудовыеРесурсы" Тогда 
			Точность = 3;
		Иначе
			Точность = 2;
		КонецЕсли;
		
		КЧ = Новый КвалификаторыЧисла(15, Точность);
		ОписаниеТиповКоличество = Новый ОписаниеТипов(МассивТиповЧисло, , , КЧ);
		
		КЧ = Новый КвалификаторыЧисла(15, 2);
		ОписаниеТиповСумма = Новый ОписаниеТипов(МассивТиповЧисло, , , КЧ);
		
		Для Каждого КолонкаИтогов Из ПараметрыРаспределения.СписокКолонокИтогов Цикл
			
			Если ИмяТаблицыРаспределения <> "ТрудовыеРесурсы" И СтрНайти(КолонкаИтогов.Значение, "Количество") > 0 Тогда
				ОписаниеТиповЧ = ОписаниеТиповКоличество;
			Иначе
				ОписаниеТиповЧ = ОписаниеТиповСумма;
			КонецЕсли;
			
			НоваяКолонкаИтогов = Новый РеквизитФормы(КолонкаИтогов.Значение, ОписаниеТиповЧ, , Истина);
			МассивРеквизитов.Добавить(НоваяКолонкаИтогов);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов,МассивРеквизитовНаУдаление);	
	
	Для Каждого ЭлементНаУдаление Из СписокЭлементовДляУдаления Цикл
		
		Элементы.Удалить(ЭлементНаУдаление.Значение);
		
	КонецЦикла;
	
	Если НеобходимоСоздатьДопКолонки Тогда
		Если ПараметрыРаспределения.РаспределятьКоличество Тогда
			
			Если  ИмяТаблицыРаспределения = "РаспределениеОбъемов" Тогда
				ЭлементВладелец = Элементы.РаспределениеОбъемов;
			ИначеЕсли ИмяТаблицыРаспределения = "ТрудовыеРесурсы" Тогда
				ЭлементВладелец = Элементы.ТрудовыеРесурсы;
			Иначе
				ЭлементВладелец = Элементы.РаспределениеПотребностей;
			КонецЕсли;
			
			Для Каждого ЭлементСпискаПериодов Из ПараметрыРаспределения.СписокПериодов Цикл
				
				НоваяГруппа = Элементы.Добавить("Группа_" + ИмяТаблицыРаспределения + "_" 
					+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy"), Тип("ГруппаФормы"), ЭлементВладелец);
				НоваяГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
				НоваяГруппа.Группировка =  ГруппировкаКолонок.Горизонтальная;
				НоваяГруппа.ОтображатьВШапке = Истина;
				НоваяГруппа.Заголовок=Формат(ЭлементСпискаПериодов.Значение, "ДФ='MMMM yyyy'");
				
				ИмяКолонкиКоличество = "Количество_" + ИмяТаблицыРаспределения + "_"
					+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
				
				НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиКоличество, Тип("ПолеФормы"), НоваяГруппа);			
				НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиКоличество;
				НоваяКолонкаЭлемент.Доступность = Истина;
				НоваяКолонкаЭлемент.Заголовок = "Количество";
				НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
				НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиКоличество;
				НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
				
				Если ИмяТаблицыРаспределения = "РаспределениеОбъемов" Тогда
					
					ИмяОбработчика1 = "Подключаемый_РаспределениеДоходовПоМесяцамКоличествоПриИзменении";
					ИмяОбработчика2 = "Подключаемый_РаспределениеДоходовПоМесяцамСуммаПриИзменении";
					
				ИначеЕсли ИмяТаблицыРаспределения = "ТрудовыеРесурсы" Тогда
					
					ИмяОбработчика1 = "Подключаемый_РаспределениеТрудовыхРесурсовПоМесяцамКоличествоПриИзменении";
					
				Иначе
					
					ИмяОбработчика1 = "Подключаемый_РаспределениеРасходовПоМесяцамКоличествоПриИзменении";
					ИмяОбработчика2 = "Подключаемый_РаспределениеРасходовПоМесяцамСуммаПриИзменении";      
					
				КонецЕсли;
			
				НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", ИмяОбработчика1);
				
				Если ИмяТаблицыРаспределения <> "ТрудовыеРесурсы" Тогда

					ИмяКолонкиСумма = "Сумма_" + ИмяТаблицыРаспределения + "_"
						+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
					
					НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиСумма, Тип("ПолеФормы"), НоваяГруппа);			
					НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиСумма;
					НоваяКолонкаЭлемент.Доступность = Истина;
					НоваяКолонкаЭлемент.Заголовок = "Сумма";
					НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
					НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
					НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиСумма;
					НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
									
					НоваяКолонкаЭлемент.УстановитьДействие("ПриИзменении", ИмяОбработчика2);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе	 		 
			
			Если ИмяТаблицыРаспределения = "РаспределениеДоходов" Тогда
				ЭлементВладелец = Элементы.РаспределениеДоходов;
			ИначеЕсли ИмяТаблицыРаспределения = "ТрудовыеРесурсы" Тогда
				ЭлементВладелец = Элементы.СтраницаТрудовыеРесурсы;
			ИначеЕсли ИмяТаблицыРаспределения = "РаспределениеДополнительныхЗатрат" Тогда
				ЭлементВладелец = Элементы.РаспределениеДополнительныхЗатрат;	
			Иначе
				ЭлементВладелец = Элементы.РаспределениеРасходов;			
			КонецЕсли;
			
			Для Каждого ЭлементСпискаПериодов Из ПараметрыРаспределения.СписокПериодов Цикл
				
				ИмяКолонкиСумма = "Сумма_" + ИмяТаблицыРаспределения + "_"
					+ Формат(ЭлементСпискаПериодов.Значение, "ДФ=MM_yyyy");
				
				НоваяКолонкаЭлемент = ЭтаФорма.Элементы.Добавить(ИмяКолонкиСумма, Тип("ПолеФормы"), ЭлементВладелец);			
				НоваяКолонкаЭлемент.ПутьКДанным = "Объект." + ИмяТаблицыРаспределения + "." + ИмяКолонкиСумма;
				НоваяКолонкаЭлемент.Доступность = Истина;
				НоваяКолонкаЭлемент.Заголовок = Формат(ЭлементСпискаПериодов.Значение, "ДФ='MMMM yyyy'");
				НоваяКолонкаЭлемент.Вид = ВидПоляФормы.ПолеВвода;
				НоваяКолонкаЭлемент.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;		 
				
				НоваяКолонкаЭлемент.ПутьКДаннымПодвала = "Всего_" + ИмяКолонкиСумма;
				НоваяКолонкаЭлемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
			
			КонецЦикла;
			
		КонецЕсли;
		
		Для Каждого СтрокаРаспределения Из Объект[ИмяТаблицыРаспределения] Цикл
			
			НайденнаяСтрока = ТаблицаРаспределения.Найти(СтрокаРаспределения.ИндексСтрокРаспределенияПоПериодам,
				"ИндексСтрокРаспределенияПоПериодам");
			
			Если НайденнаяСтрока <> Неопределено Тогда 
				
				ЗаполнитьЗначенияСвойств(СтрокаРаспределения, НайденнаяСтрока);
				
			КонецЕсли;		 
			
		КонецЦикла;
		
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", истина);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ВыделятьОтрицательные", Истина);
		
		НовыйЭлементУООтбор = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		НовыйЭлементУООтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТаблицыРаспределения 
			+ ".СпособПривязки");
		НовыйЭлементУООтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
		НовыйЭлементУООтбор.ПравоеЗначение = Перечисления.упоСпособПривязкиРаспределения.Вручную;
		
		Для Каждого НоваяКолонка Из СписокЭлементовДляДобавления Цикл
			
			НовоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			НовоеПоле.Поле = Новый ПолеКомпоновкиДанных(НоваяКолонка.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборРаспределения(ВыбранноеЗначение, КолонкаИндекса)
	
	ТаблицаРаспределенная = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТР);
	
	МассивСтрокНаУдаление = Новый Массив;
	
	Для Каждого СтрокаТР Из Объект.РаспределениеДоходовПоПериодам Цикл
		
		Если СтрокаТР[КолонкаИндекса] <> Неопределено Тогда
			
			МассивСтрокНаУдаление.Добавить(СтрокаТР);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаНаУдаление Из МассивСтрокНаУдаление Цикл
		
		Объект.РаспределениеДоходовПоПериодам.Удалить(Объект.РаспределениеДоходовПоПериодам.Индекс(СтрокаНаУдаление));
		
	КонецЦикла;
	
	Для Каждого ВыбраннаяСтрока Из ТаблицаРаспределенная Цикл
		
		НоваяСтрока =  Объект.РаспределениеДоходовПоПериодам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыбраннаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РаспределениеОбъемовЗаполнитьКоличествоСуммуСервер()
	
	Для Каждого СтрокаОбъемы Из Объект.Субпродукты Цикл
		
		СуммаОбщая = СтрокаОбъемы.ОбщСтоимость;
		КоличествоОбщее = СтрокаОбъемы.Количество;
		
		ОтборСтрокРаспределения = Новый Структура;
		ОтборСтрокРаспределения.Вставить("ИндексСтрокиВладельца", СтрокаОбъемы.ИндексСтрокРаспределения);
		
		НайденныеСтроки = Объект.РаспределениеОбъемов.НайтиСтроки(ОтборСтрокРаспределения);
		КоличествоНайденных = НайденныеСтроки.Количество();
		
		Счетчик = 1;
		
		РаспределенноеКолво = 0;
		РаспределеннаяСумма = 0;
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			
			Если Счетчик = КоличествоНайденных Тогда
				
				НайденнаяСтрока.Количество =  КоличествоОбщее - РаспределенноеКолво;
				НайденнаяСтрока.Сумма =  СуммаОбщая - РаспределеннаяСумма;
				
			Иначе
				
				НайденнаяСтрока.Количество =  КоличествоОбщее/КоличествоНайденных;
				НайденнаяСтрока.Сумма =  СуммаОбщая/КоличествоНайденных;
				РаспределенноеКолво = РаспределенноеКолво +  НайденнаяСтрока.Количество;
				РаспределеннаяСумма = РаспределеннаяСумма +  НайденнаяСтрока.Сумма;
				
			КонецЕсли;
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаспределениеОбъемовПоРолямСервер()
	
	Объект.РаспределениеОбъемов.Очистить();
	ЗначенияПроектаПоУмолчанию = упоАналитикаПоПодразделениямСервер.ПолучитьЗначенияДляПодстановкиПоУмолчанию(Проект);
	
	КопияРолей = Объект.ТрудовыеРесурсы.Выгрузить();
	Счетчик = 0;
	
	Если КопияРолей.Количество() > 0 Тогда
		
		Для Каждого СтрокаОбъемов Из Объект.Субпродукты Цикл
			
			СтрокаОбъемов.ИндексСтрокРаспределения = Счетчик;
			
			Для Каждого СтрокаРоли Из КопияРолей Цикл
				
				НоваяСтрока = Объект.РаспределениеОбъемов.Добавить();
				НоваяСтрока.ИндексСтрокиВладельца = Счетчик;
				НоваяСтрока.Роль =  СтрокаРоли.Ресурс;
				НоваяСтрока.Подразделение =  СтрокаРоли.Подразделение;
				НоваяСтрока.СобствСилы_Субподряд =  СтрокаРоли.Ресурс.СобствСилы_Субподряд;
				НоваяСтрока.Количество = СтрокаРоли.Количество;
				НоваяСтрока.Сумма =  СтрокаРоли.ОбщВнешняяСтоимость;
				
			КонецЦикла;
			
			Счетчик = Счетчик + 1;
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура КопироватьСтрокуВладельцаВРаспределение(Команда)
			
	ИмяКоманды = Команда.Имя;
	
	ДополнительныеПараметрыОбработкиФормы = 
		упоАналитикаПоПодразделениямКлиентСервер.ПараметрыОбработкиДанныхРаспределения(Ложь);
	ДополнительныеПараметрыОбработкиФормы.Вставить("ИспользоватьАналитикуКонтрагентДляСС", 
													ИспользоватьАналитикуКонтрагентДляСС);
	ПараметрыКопирования = упоРаботаСФормамиКлиент.КопироватьСтрокуВладельцаВРаспределение(Объект, 
																		ЭтаФорма, 
																		ИмяКоманды, 
																		ДополнительныеПараметрыОбработкиФормы);
		
	ПроверятьИсточникПлана = Истина;	
	Если ПараметрыКопирования.ТаблицаВладелец = "Субпродукты" Или ПараметрыКопирования.ТаблицаВладелец = "ТрудовыеРесурсы" Тогда
		ПроверятьИсточникПлана = Ложь;
	КонецЕсли;	
		
	упоРаботаСФормамиКлиент.ПерезаполнитьРаспределениеОбъемовПоПериодам(Объект, 
																		ЭтаФорма, 
																		ПараметрыКопирования.ТаблицаПодчиненная, 
																		, 
																		ПараметрыКопирования.КопироватьКоличество, 
																		ПроверятьИсточникПлана);
			
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьПоРолям(Команда)
	
	Если Объект.РаспределениеОбъемов.Количество() > 0 Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("РаспределениеОбъемовЗаполнитьПоРолямЗавершение",ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения,"Табличная часть 'Распределение объемов' уже содержит данные. Очистить?",
			РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);		
		
	Иначе
		
		РаспределениеОбъемовЗаполнитьПоРолямЗавершение("БезОтвета",Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьСССП(Команда)
	
	ЗаполнитьЗначениевТЧОбщая(Команда.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьКоличествоСумму(Команда)
	
	РаспределениеОбъемовЗаполнитьКоличествоСуммуСервер();
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, "Субпродукты",
		"РаспределениеОбъемов", "ОбщСтоимость", Истина);		
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОбъемовЗаполнитьПоРолямЗавершение(ОтветПользователя,ДополнительныеПараметры) Экспорт
	
	Если ОтветПользователя = КодВозвратаДиалога.Да
		Или ОтветПользователя = "БезОтвета" Тогда
		ЗаполнитьРаспределениеОбъемовПоРолямСервер();
	КонецЕсли;
	
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма, "Субпродукты",
	"РаспределениеОбъемов", "ОбщСтоимость", Истина);			
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
	"РаспределениеОбъемов", "ОбщСтоимость");
	
КонецПроцедуры

&НаКлиенте	
Процедура УстановитьОграничениеТиповМатериальныеРесурсы()
	
	МассивТипов = Новый Массив;
	
	МассивТипов.Добавить(Тип("СправочникСсылка.Номенклатура"));
	
	ОписаниеТиповМатериальныеРесурсы = Новый ОписаниеТипов(МассивТипов);
	
	Элементы.МатериальныеРесурсыРесурс.ОграничениеТипа  = ОписаниеТиповМатериальныеРесурсы;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТолькоПросмотрВалюте(имяТаблицы, естьДоговор = Неопределено)
	
	текДанные = Элементы[имяТаблицы].ТекущиеДанные;
	Если текДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если естьДоговор = Неопределено Тогда
		естьДоговор = ЗначениеЗаполнено(текДанные.Договор);
	КонецЕсли;
	
	Элементы[имяТаблицы+"Валюта"].ТолькоПросмотр = естьДоговор;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормыСервер(ПервыйЗапуск = Истина)
	
	мВалютаУправленческогоУчета = ПараметрыСеанса.упоВалютаУправленческогоУчета;	
	
	КалендарьДляСверки = Константы.упоРабочийКалендарьПоУмолчанию.Получить();	
	
	ИнициализацияФормыСерверEPM();
	
	// Проектная продукция.
	
	ДоступенФункционалПроектнаяПродукция = упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция();
	
	упоРаботаСФормамиСервер.ЗаполнитьРеквизитыТипПродукта(Объект.ТипСубпродукта, ЭтотОбъект.ТипПродуктаЧисло);
	упоРаботаСФормамиКлиентСервер.НастроитьСубпродуктыНаФормеПоТипуСубпродукта(Элементы, 
		Объект.ТипСубпродукта);

КонецПроцедуры

&НаСервере
Процедура ИнициализацияФормыСерверEPM()
	
	Если НЕ упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM() Тогда
		Возврат;
	КонецЕсли;			
	
	Элементы.МатериальныеРесурсыСвязьСЗаказом.Видимость = Истина;
	Элементы.СубпродуктыСвязьСЗаказом.Видимость = Истина;	
		
КонецПроцедуры

&НаКлиенте
Процедура ИнициализацияФормыКлиент(ПриОткрытии = Ложь)
	
	Если ДоступенФункционалПроектнаяПродукция Тогда
		ДозаполнитьТЧСубпродукты();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатуВыпускаПланВыпуска(ТекСтрока = Неопределено)
	
	СтруктураСроки  = упоПроектыИЗадачиОбщие.СтруктураСроки(Объект.ДатаНачалаПлан, Объект.ДатаЗавершенияПлан);
	
	Если ТекСтрока = Неопределено Тогда
		Для каждого лСтрока Из Объект.Субпродукты Цикл
			упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаПланаВыпускаВСтроке(СтруктураСроки, Проект, лСтрока);
		КонецЦикла;
	Иначе
		упоУправлениеФормамиКлиент.ОбновитьДатуВыпускаПланаВыпускаВСтроке(СтруктураСроки, Проект, ТекСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИтогПоФинПланам(ЭтаФорма)
	
	ЭтаФорма.ИтогоДоходы = ЭтаФорма.Объект.ПланДоходов.Итог("Сумма");
	ЭтаФорма.ИтогоРасходы = ЭтаФорма.Объект.ПланРасходов.Итог("Сумма");
	
	Если ЭтаФорма.Объект.ВключитьСубпродуктыВПланДоходов Тогда
		ЭтаФорма.ИтогоДоходы = ЭтаФорма.ИтогоДоходы + ЭтаФорма.Объект.Субпродукты.Итог("ОбщСтоимость");
	КонецЕсли;
	Если ЭтаФорма.Объект.ВключитьМатРесурсыВПланРасходов Тогда
		ЭтаФорма.ИтогоРасходы = ЭтаФорма.ИтогоРасходы + ЭтаФорма.Объект.МатериальныеРесурсы.Итог("ОбщСтоимость");
	КонецЕсли;
	Если Ложь И ЭтаФорма.Объект.ВключитьТрудРесурсыВПланРасходов Тогда // Пока что данный функционал не запущен 
		ЭтаФорма.ИтогоРасходы = ЭтаФорма.ИтогоРасходы + ЭтаФорма.Объект.ТрудовыеРесурсы.Итог("ОбщСтоимость");
	КонецЕсли;
	
	ИтогоВыплаты = 0;
	ИтогоПоступления = 0;
	
	Для каждого СтрокаДДС Из ЭтаФорма.Объект.ДвиженияДенежныхСредств Цикл
		Если СтрокаДДС.НаправлениеДвижения = ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата") Тогда
			ЭтаФорма.ИтогоВыплаты = ЭтаФорма.ИтогоВыплаты + СтрокаДДС.Сумма;
		ИначеЕсли СтрокаДДС.НаправлениеДвижения = 
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление") Тогда
			ЭтаФорма.ИтогоПоступления = ЭтаФорма.ИтогоПоступления + СтрокаДДС.Сумма;
		КонецЕсли; 
	КонецЦикла; 
	
	ЭтаФорма.ИтогоРасходы = ЭтаФорма.ИтогоРасходы * - 1;
	ЭтаФорма.ИтогоВыплаты = ЭтаФорма.ИтогоВыплаты * - 1;
	
	ЭтаФорма.ИтогоБДР = ЭтаФорма.ИтогоДоходы + ЭтаФорма.ИтогоРасходы;
	ЭтаФорма.ИтогоБДДС = ЭтаФорма.ИтогоПоступления + ЭтаФорма.ИтогоВыплаты;
	
	ЭтаФорма.ИтогоРазностьДоходы = ЭтаФорма.ИтогоДоходы - ЭтаФорма.ИтогоПоступления;
	ЭтаФорма.ИтогоРазностьРасходы = ЭтаФорма.ИтогоРасходы - ЭтаФорма.ИтогоВыплаты;
	ЭтаФорма.ИтогоРазностьБДР = ЭтаФорма.ИтогоБДР - ЭтаФорма.ИтогоБДДС;
	
	ЭтаФорма.ИтогоРазностьПоступления = ЭтаФорма.ИтогоПоступления - ЭтаФорма.ИтогоДоходы;
	ЭтаФорма.ИтогоРазностьВыплаты = ЭтаФорма.ИтогоВыплаты - ЭтаФорма.ИтогоРасходы;
	ЭтаФорма.ИтогоРазностьБДДС = ЭтаФорма.ИтогоБДДС - ЭтаФорма.ИтогоБДР;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьДопПараметрыСтруктурыПодбора(ПараметрыПодбораСтруктура, ИмяТЧ)
	
	ПараметрыПодбораСтруктура= Новый Структура;
	
	ПараметрыПодбораСписок = Новый СписокЗначений();
	ПараметрыПодбораСписок.Добавить(ИмяТЧ, "ИмяТабличнойЧасти");
	
	СтруктураДанных = ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТЧ); 
	
	ПараметрыПодбораСтруктура = Новый Структура;
	ПараметрыПодбораСтруктура.Вставить("ПараметрыПодбораСписок", ПараметрыПодбораСписок);
	ПараметрыПодбораСтруктура.Вставить("СтруктураСтроки", СтруктураДанных.СтруктураСтрокиТЧ);
	
	ПараметрыПодбораСтруктура.Вставить("СвойстваОбъекта", СтруктураДанных.СтруктураОбъекта);	
	ПараметрыПодбораСтруктура.СвойстваОбъекта.Вставить("Проект", Проект);
	
	Если ИмяТЧ = "ДвиженияДенежныхСредств" Тогда
		
		Если Элементы.ДДС_ПараметрыПодбора_НаправлениеПоступление.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Поступление"),"НаправлениеДвижения");
			
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_НаправлениеВыплата.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоНаправлениеДвиженияДенежныхСредств.Выплата"), "НаправлениеДвижения");
			
		КонецЕсли;
		
		Если Элементы.ДДС_ПараметрыПодбора_ПривязкаКНачалу.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.НачалоЗадачи"),"СпособПривязки");
			
		ИначеЕсли Элементы.ДДС_ПараметрыПодбора_ПривязкаКЗавершению.Пометка Тогда
			
			ПараметрыПодбораСтруктура.ПараметрыПодбораСписок.Добавить(
				ПредопределенноеЗначение("Перечисление.упоСпособПривязкиДДС.ЗавершениеЗадачи"), "СпособПривязки");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДопПараметрыСтруктурыПодбораСервер(ИмяТЧ)
	
	ДопПараметры = Новый Структура;
	
	ДопПараметры.Вставить("СтруктураСтрокиТЧ", Новый Структура);
	ДопПараметры.Вставить("СтруктураОбъекта", Новый Структура);
	
	ПодготовитьКопиюДанныхОбъекта(ДопПараметры.СтруктураСтрокиТЧ, ИмяТЧ);
	ПодготовитьКопиюДанныхОбъекта(ДопПараметры.СтруктураОбъекта);
	
	ДопПараметры.СтруктураОбъекта.Вставить("ЭтоШаблон", Истина);
	
	Возврат ДопПараметры;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииСроков()
	
	Новый_ПриИзмененииДаты_Клиент("ДатаЗавершенияПлан");
	УстановитьДоступностьСроков();
	
КонецПроцедуры

&НаКлиенте
Функция Новый_ПриИзмененииДаты_Клиент(ИзмениласьДата) 
	
	Если НЕ Объект.РучнойВводСроков Тогда
		ВызватьИсключение НСтр("ru = 'Изменение сроков вручную возможно только в режиме ручного ввода сроков.'");
	КонецЕсли;
	
	Новый_ПриИзмененииДаты(ИзмениласьДата);
	
	Если ИзмениласьДата = "ДатаНачалаПлан" Тогда
		
		Новый_ОбновитьДатуЗавершения();
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура Новый_ПриИзмененииДаты(ИзмениласьДата)
	
	Если ИзмениласьДата <> "ДатаЗавершенияПлан" И ИзмениласьДата <> "ДатаНачалаПлан" Тогда
		Возврат;
	КонецЕсли;
	
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи();
	
	Если ИзмениласьДата = "ДатаНачалаПлан" Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ДатаНачалаПлан) Тогда
			Объект.ДатаНачалаПлан = ТекущаяДата();
		КонецЕсли;
		Объект.ДатаНачалаПлан = НачалоДня(Объект.ДатаНачалаПлан);	
		
		Если Объект.ЭтоВеха Тогда
			Объект.ДатаЗавершенияПлан = Объект.ДатаНачалаПлан;	
			Возврат;
		КонецЕсли;	
		
		ДлительностьДляПересчета = ПолучитьДлительностьВЧасах();
		
		Объект.ДатаЗавершенияПлан = ДобавитьЧасыКДате(Объект.ДатаНачалаПлан, ДлительностьДляПересчета, 
												КалендарьДляПересчета, Объект.ДлительностьБезУчетаКалендаряПроекта); 
					
	Иначе
			
		Если Не ЗначениеЗаполнено(Объект.ДатаЗавершенияПлан) Тогда
			Объект.ДатаЗавершенияПлан = Объект.ДатаНачалаПлан;
		КонецЕсли;	
		
		Если Объект.ДатаНачалаПлан > Объект.ДатаЗавершенияПлан Тогда
			Объект.ДатаНачалаПлан = Объект.ДатаЗавершенияПлан;	
		КонецЕсли;
		
		Если Объект.ЭтоВеха Тогда
			Объект.ДатаНачалаПлан = Объект.ДатаЗавершенияПлан;	
			Возврат;
		КонецЕсли;
			
		Объект.ДатаНачалаПлан = НачалоДня(Объект.ДатаНачалаПлан);
		
		Объект.ДатаЗавершенияПлан = КалендарныйКонецДня(НачалоДня(Объект.ДатаЗавершенияПлан), 
												КалендарьДляПересчета, Объект.ДлительностьБезУчетаКалендаряПроекта);
										
		Новый_ПодсчитатьДлительность();								
			
	КонецЕсли;
					
КонецПроцедуры

&НаКлиенте
Процедура Новый_ПодсчитатьДлительность()
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаПлан) И НЕ ЗначениеЗаполнено(Объект.ДатаЗавершенияПлан) Тогда
		Объект.ДлительностьМоделиПакетаРабот = 0;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаПлан) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДатаЗавершенияПлан) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Ошибка расчета длительности задачи.'"));
		Возврат;	
	КонецЕсли;
		
	Если Объект.ДлительностьБезУчетаКалендаряПроекта Тогда
		Объект.ДлительностьМоделиПакетаРабот = ПересчитатьЕдВремениИзЧасов(
			(КонецДня(Объект.ДатаЗавершенияПлан) - НачалоДня(Объект.ДатаНачалаПлан)) / 3600, 
			Объект.ЕдиницаНормированияДлительности); 
	Иначе
		КалендарьДляПересчета = ПолучитьКалендарьЗадачи();
		Ответ = КоличествоРабочихДнейИЧасовВПериоде(КалендарьДляПересчета, Объект.ДатаНачалаПлан, Объект.ДатаЗавершенияПлан);
		Объект.ДлительностьМоделиПакетаРабот = ПересчитатьЕдВремениИзЧасов(Ответ.КоличествоЧасов,
																			Объект.ЕдиницаНормированияДлительности);
	КонецЕсли;
																		
КонецПроцедуры

&НаКлиенте
Процедура Новый_ОбновитьДатуЗавершения()
	
	ДлительностьДляПересчета = ПолучитьДлительностьВЧасах();	
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи();
			
	Если Объект.ДлительностьБезУчетаКалендаряПроекта Тогда
		ДатаЗавершения = Объект.ДатаНачалаПлан + ДлительностьДляПересчета * 3600;;
	Иначе
		ДатаЗавершения = ДобавитьЧасыКДате(Объект.ДатаНачалаПлан, ДлительностьДляПересчета, 
														КалендарьДляПересчета, Объект.ДлительностьБезУчетаКалендаряПроекта); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция Новый_ПриИзмененииДлительности_Клиент() 
	
	Новый_ПриИзмененииДлительности();
	Новый_ОбновитьДатуЗавершения();
	
КонецФункции

&НаКлиенте
Процедура Новый_ПриИзмененииДлительности()
	
	Если Объект.ЭтоВеха Тогда
		Объект.ДлительностьМоделиПакетаРабот = 0;
		Объект.ДатаЗавершенияПлан = Объект.ДатаНачалаПлан;
		Возврат;
	КонецЕсли;
	
	Если Объект.ДлительностьМоделиПакетаРабот <= 0 Тогда
		Объект.ДлительностьМоделиПакетаРабот = 1;
	КонецЕсли;
		
	ДлительностьВЧасах = ПолучитьДлительностьВЧасах();
	КалендарьДляПересчета = ПолучитьКалендарьЗадачи();
							
	ДатаОшибки = Неопределено;
	ОшибкиИПредупреждения = Неопределено;
	
	Объект.ДатаЗавершенияПлан = ДобавитьЧасыКДате(Объект.ДатаНачалаПлан, 
						ДлительностьВЧасах, КалендарьДляПересчета, Объект.ДлительностьБезУчетаКалендаряПроекта);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКалендарьЗадачи() 
	
	Если ЗначениеЗаполнено(Объект.КалендарьЗадачи) Тогда
		КалендарьЗадачи = Объект.КалендарьЗадачи;	
	Иначе		
		КалендарьЗадачи = КалендарьДляСверки;
	КонецЕсли;
	
	Возврат КалендарьЗадачи;
	
КонецФункции

&НаКлиенте
Функция ПолучитьДлительностьВЧасах() 

	Возврат ПересчитьЕдВремениВЧасы(Объект.ДлительностьМоделиПакетаРабот,
						?(Не ЗначениеЗаполнено(Объект.ЕдиницаНормированияДлительности),
						упоПроектыИЗадачиОбщие.ЕдИзмеренияПоУмолчанию(ЭтаФорма, Истина),
						Объект.ЕдиницаНормированияДлительности));	
	
КонецФункции
					
&НаСервереБезКонтекста
Функция ПересчитьЕдВремениВЧасы(Знач Значение, Знач ЕдВремени) 
	
	Возврат упоРабочиеКалендариВызовСервера.обПересчитатьЕдВремениВЧасы(Значение, ЕдВремени);	
	
КонецФункции

&НаСервереБезКонтекста
Функция ДобавитьЧасыКДате(Знач Дата, Знач Длительность, Знач КалендарьДляПересчета, Знач ДлительностьБезУчетаКалендаряПроекта) 
	
	ДатаОшибки = Неопределено;
	ОшибкиИПредупреждения = Неопределено;
	
	НоваяДата = упоРасчетКалендарныхСроковРедакция3Сервер.ДобавитьЧасыКДате(Дата, Длительность,
			, КалендарьДляПересчета, ДатаОшибки, Истина, ДлительностьБезУчетаКалендаряПроекта, ОшибкиИПредупреждения);

	 Если ОшибкиИПредупреждения <> Неопределено Тогда
		Для Каждого СтрокаОшибки Из ОшибкиИПредупреждения Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки.ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НоваяДата;
	
КонецФункции

&НаСервереБезКонтекста
Функция КалендарныйКонецДня(Знач Дата, Знач КалендарьДляПересчета, Знач ДлительностьБезУчетаКалендаряПроекта) 
	
	ДатаОшибки = Неопределено;
	ОшибкиИПредупреждения = Неопределено;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		
		НоваяДата = Дата;
		
	ИначеЕсли ДлительностьБезУчетаКалендаряПроекта Тогда
		
		НоваяДата = КонецДня(Дата);
		
	Иначе
	
	 	НоваяДата = упоРасчетКалендарныхСроковРедакция3Сервер.КалендарныйКонецДня(
								НачалоДня(Дата), , КалендарьДляПересчета, ДатаОшибки, ОшибкиИПредупреждения);
								
	КонецЕсли;

	 Если ОшибкиИПредупреждения <> Неопределено Тогда
		Для Каждого СтрокаОшибки Из ОшибкиИПредупреждения Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки.ТекстОшибки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат НоваяДата;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПересчитатьЕдВремениИзЧасов(Знач Часы, Знач ЕдиницаНормированияДлительности) 
	
	Возврат упоРабочиеКалендариВызовСервера.обПересчитатьЕдВремениИзЧасов(
			Часы, 
			ЕдиницаНормированияДлительности); 
	
КонецФункции

&НаСервереБезКонтекста
Функция КоличествоРабочихДнейИЧасовВПериоде(Знач КалендарьДляПересчета, Знач ДатаНачала, Знач ДатаЗавершения) 
	
	Возврат упоРабочиеКалендариВызовСервера.обКоличествоРабочихДнейИЧасовВПериоде(КалендарьДляПересчета, ДатаНачала, ДатаЗавершения);	
	
КонецФункции

&НаКлиенте
Процедура Новый_ЗаполнитьДлительностьПоПлануРолей()
	
	Если Объект.ЭтоВеха Тогда
		Возврат;
	КонецЕсли;
	
	КоэффициентыЕдИзмеренияВремени = ПолучитьКоэффициентыЕдИзмеренияВремени();
	
	МаксимальнаяДлительность = 0;
	
	Для Каждого СтрокаТЧ Из Объект.ТрудовыеРесурсы Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаНормирования) Тогда
			Продолжить;
		КонецЕсли;
		
		Коэффициент = КоэффициентыЕдИзмеренияВремени.Получить(СтрокаТЧ.ЕдиницаНормирования);
		
		ДлительностьСтроки = СтрокаТЧ.Количество * Коэффициент;
		
		Если ДлительностьСтроки > МаксимальнаяДлительность Тогда
			МаксимальнаяДлительность = ДлительностьСтроки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(МаксимальнаяДлительность) Тогда
		
		Если Не ЗначениеЗаполнено(Объект.ЕдиницаНормированияДлительности) Тогда
			Объект.ЕдиницаНормированияДлительности = упоПроектыИЗадачиОбщие.ЕдИзмеренияПоУмолчанию(ЭтаФорма, Истина);		
		КонецЕсли;
		
		Объект.ДлительностьМоделиПакетаРабот = ПересчитатьЕдВремениИзЧасов(МаксимальнаяДлительность, Объект.ЕдиницаНормированияДлительности); 
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Ошибка расчета длительности по плану трудозатрат.'");
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЕдиницуНормированияСтрокиТабЧасти(СтрокаТабличнойЧасти)

	ЕдиницаНормирования  = упоУправлениеФормамиСервер.ПолучитьЕдиницуИзмТЧ(СтрокаТабличнойЧасти.Ресурс);
	
	Если ТипЗнч(СтрокаТабличнойЧасти.ЕдиницаНормирования) <> ТипЗнч(ЕдиницаНормирования) Тогда
		СтрокаТабличнойЧасти.ЕдиницаНормирования =  ЕдиницаНормирования;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоэффициентыЕдИзмеренияВремени()
	
	Результат = Новый Соответствие;
	
	Выборка = Справочники.упоЕдиницыВремени.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.Коэффициент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

