	Элементы.СтраницаФинПланы.Видимость = Ложь;
	Элементы.СтраницаСубпродукты.Видимость = Ложь;
	Элементы.ДопЗатраты.Видимость = Ложь;
	Элементы.ГруппаРаспределениеПотребностей.Видимость = Ложь;
	
	Элементы.НормаСтоимостиНастройка.Видимость = Ложь;
		
	Элементы.ГруппаНастройкаМатРесурсов.Видимость = Ложь;
	
	Элементы.МатериалыИОборудование_Заполнить.Доступность = Ложь;
			
	//
	
	КолонкиСОграничениемДоступа = Новый Массив;
	
	ИмяТЧ = "ТрудовыеРесурсы"; 
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Стоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ОбщСтоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ВнешняяСтоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ОбщВнешняяСтоимость");
	
	ИмяТЧ = "МатериальныеРесурсы";
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "СпособПривязкиПотребности");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Стоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ОбщСтоимость");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ЗадержкаЗаказа");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Валюта");	
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Контрагент");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "Договор");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "СпособПривязки");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "СтатьяЗатрат");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ПрофильРаспределения");
	КолонкиСОграничениемДоступа.Добавить(ИмяТЧ + "ДатаПривязки");
			
	упоРазграничениеДоступаВызовСервера.УстановитьДоступККолонкамТабличнойЧасти(Элементы, 
																				КолонкиСОграничениемДоступа, 
																				"Отсутствует");
	
КонецФункции

