	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПриИзмененииТрудоемкостиПроектногоПродукта(ТекущиеДанные);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииТрудоемкостиПроектногоПродукта(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти.Нормирование = 0 Тогда
		СтрокаТабличнойЧасти.КоэффициентСложности = 0;
	Иначе
		СтрокаТабличнойЧасти.КоэффициентСложности = СтрокаТабличнойЧасти.Трудоемкость / СтрокаТабличнойЧасти.Нормирование;
	КонецЕсли;
	
	ЗаполнитьКоэффициентСложностиДляРолей(ЭтотОбъект.Объект["РаспределениеОбъемов"], СтрокаТабличнойЧасти, СтрокаТабличнойЧасти.КоэффициентСложности); 
	
	Для Каждого СтрокаРоли Из ЭтотОбъект.Объект["РаспределениеОбъемов"] Цикл	
		Если СтрокаРоли.ИндексСтрокиВладельца <> СтрокаТабличнойЧасти.ИндексСтрокРаспределения Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРоли.Трудоемкость = СтрокаТабличнойЧасти.Трудоемкость * (СтрокаРоли.ПроцентРаспределения / 100);	
	КонецЦикла;
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "КоэффициентСложности");
		
КонецПроцедуры //

&НаКлиенте
Процедура СубпродуктыКоэффициентСложностиПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтотОбъект.Элементы.Субпродукты.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПриИзмененииКоэффициентаСложностиПроектногоПродукта(ТекущиеДанные);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииКоэффициентаСложностиПроектногоПродукта(СтрокаТабличнойЧасти);
	
	ЗаполнитьКоэффициентСложностиДляРолей(ЭтотОбъект.Объект["РаспределениеОбъемов"], СтрокаТабличнойЧасти, СтрокаТабличнойЧасти.КоэффициентСложности);
	
	Для Каждого СтрокаРоли Из ЭтотОбъект.Объект["РаспределениеОбъемов"] Цикл
		Если СтрокаРоли.ИндексСтрокиВладельца <> СтрокаТабличнойЧасти.ИндексСтрокРаспределения Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРоли.Трудоемкость = СтрокаТабличнойЧасти.Нормирование * СтрокаРоли.КоэффициентСложности * (СтрокаРоли.ПроцентРаспределения/100);
	КонецЦикла; 

	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	СтрокаТабличнойЧасти.Трудоемкость = ИтогРаспределенияПП_Трудоемкость;
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "КоэффициентСложности");
	
КонецПроцедуры //

&НаКлиенте
Процедура СубпродуктыРесурсПриИзменении(Элемент)
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
		
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	СтруктураСтрокиСубпродукты = Новый Структура;
	СтруктураСтрокиСубпродукты.Вставить("Ресурс", 				ТекДанные.Ресурс);
	СтруктураСтрокиСубпродукты.Вставить("Количество", 			ТекДанные.Количество);
	СтруктураСтрокиСубпродукты.Вставить("Стоимость", 			ТекДанные.Стоимость);
	СтруктураСтрокиСубпродукты.Вставить("ОбщСтоимость", 		ТекДанные.ОбщСтоимость);
	СтруктураСтрокиСубпродукты.Вставить("ЕдиницаНормирования", 	ТекДанные.ЕдиницаНормирования);
	СтруктураСтрокиСубпродукты.Вставить("ЭтоПП", ТекДанные.ЭтоПП);
	Если ДоступенФункционалПроектнаяПродукция Тогда
		СтруктураСтрокиСубпродукты.Вставить("СкоростьВыполнения", ТекДанные.СкоростьВыполнения);
		СтруктураСтрокиСубпродукты.Вставить("Трудоемкость", ТекДанные.Трудоемкость);
		СтруктураСтрокиСубпродукты.Вставить("Нормирование", ТекДанные.Нормирование);
		СтруктураСтрокиСубпродукты.Вставить("КоэффициентСложности", ТекДанные.КоэффициентСложности);
	КонецЕсли;
	
	МассивРаспределенияОбъемов = Новый Массив;
	СубпродуктыРесурсПриИзмененииНаСервере(СтруктураСтрокиСубпродукты, МассивРаспределенияОбъемов);
	
	упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(СтруктураСтрокиСубпродукты);	

	ЗаполнитьЗначенияСвойств(ТекДанные, СтруктураСтрокиСубпродукты);
	
	Если ТекДанные.ЭтоПП Тогда
		упоПодборВТабличнуюЧастьКлиент.СубпродуктыЗаполнитьРаспределениеОбъемовПП(ТекДанные,
			МассивРаспределенияОбъемов,	Объект.РаспределениеОбъемов, Объект.Субпродукты);

		ПересчитатьИтогиПоТаблицеПП();
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ПроверитьНоменклатуруСтрокиНаЗаполнениеЕдИзмВТаблице(Объект, "Субпродукты", ТекДанные);
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
			"РаспределениеОбъемов","ОбщСтоимость", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы.Субпродукты.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаИсточник = "Субпродукты";
	
	СтрокиНайдены = Ложь;

	Если НоваяСтрока Или Не СтрокиНайдены Тогда
		
		упоАналитикаПоПодразделениямКлиент.УстановитьИндексСтрокРаспределенияВСтрокеТаблицы(Объект, ТекДанные, ТаблицаИсточник);
		
		упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
			"РаспределениеОбъемов","ОбщСтоимость", Истина);
				
	КонецЕсли;

КонецПроцедуры

