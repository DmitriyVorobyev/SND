&НаКлиенте
Процедура ТаблицаТрудовыеРесурсыСпособПривязкиПриИзменении(Элемент)
	
	ТекущиеДанныеТР = Элементы.ТрудовыеРесурсы.ТекущиеДанные;
	
	Если ТекущиеДанныеТР = Неопределено Тогда 
		Возврат;
	КонецЕсли;
			
	ИндексСтрокРаспределенияПоПериодамДляУдаления = Неопределено;
	
	СпособПривязкиРаспределенияВручную = ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную");
	Если ТекущиеДанныеТР.СпособПривязки = СпособПривязкиРаспределенияВручную
		И ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам = Неопределено Тогда
		
		ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам =
			упоАналитикаПоПодразделениямКлиентСервер.ПолучитьИндексСтрокРаспределенияНовойСтроки(
					Объект.ТрудовыеРесурсы, "ИндексСтрокРаспределенияПоПериодам");
		
	ИначеЕсли ТекущиеДанныеТР.СпособПривязки <> СпособПривязкиРаспределенияВручную Тогда
		
		ИндексСтрокРаспределенияПоПериодамДляУдаления = ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам;
		
		ТекущиеДанныеТР.ИндексСтрокРаспределенияПоПериодам = Неопределено;
		
		ОбнулитьКоличествоИСуммуРучногоРаспределенияТрудовыхРесурсовЗаПериод(ТекущиеДанныеТР);
		
	КонецЕсли;
			
	Если ИндексСтрокРаспределенияПоПериодамДляУдаления <> Неопределено Тогда
		СтруктураОтбора = Новый Структура("ИндексСтрокиРаспределениеПоРолям", ИндексСтрокРаспределенияПоПериодамДляУдаления);
		ИскомыеСтроки = Объект.ТрудовыеРесурсыПоПериодам.НайтиСтроки(СтруктураОтбора);
		Для каждого НайденнаяСтрока Из ИскомыеСтроки Цикл
			Объект.ТрудовыеРесурсыПоПериодам.Удалить(НайденнаяСтрока);
		КонецЦикла;
	КонецЕсли;			
	
	СоздатьДопЭлементыРаспределенияДоходов(Ложь, Ложь, Ложь, Ложь, Истина, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьКоличествоИСуммуРучногоРаспределенияТрудовыхРесурсовЗаПериод(ТекСтрока)
	
	ТаблицаРаспределения = "ТрудовыеРесурсы";
	
	ПрограммноСозданныеЭлементы = 
		упоРаботаСФормамиКлиентСервер.ПолучитьЭлементыРаспределенияПоПериодам(ЭтаФорма, ТаблицаРаспределения);		
	Для каждого ЭлементСпискаПрограммно Из ПрограммноСозданныеЭлементы Цикл
		
		ПериодЗашифрованный = упоРаботаСФормамиКлиентСервер.ПолучитьЗашифрованныйПериод(ЭлементСпискаПрограммно.Имя);			 
		
		ИмяКолонкиКоличество = "Количество_" + ТаблицаРаспределения + "_" + Формат(ПериодЗашифрованный, "ДФ=MM_yyyy");				
		ТекСтрока[ИмяКолонкиКоличество] = 0;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Таблица_ПриИзмененииОбщСтоимости(СтрокаТабличнойЧасти, ИмяКолонкиСтоимость)
	
	ИмяКолонкиОбщСтоимость = "Общ" + ИмяКолонкиСтоимость;
	упоРаботаСФормамиКлиент.ПриИзмененииОбщейСтоимостиТабЧасти(СтрокаТабличнойЧасти, ИмяКолонкиСтоимость, ИмяКолонкиОбщСтоимость);
	
	ПроверитьИсправитьОбщСтоимость(СтрокаТабличнойЧасти, ИмяКолонкиСтоимость);
		      	
КонецПроцедуры
  
// Корректировка общей стоимости для устранения погрешности округления.
&НаКлиенте
Процедура ПроверитьИсправитьОбщСтоимость(СтрокаТабличнойЧасти, ИмяКолонкиСтоимость = "Стоимость") 
	
	ИмяКолонкиОбщСтоимость = "Общ" + ИмяКолонкиСтоимость;
	
	ИсходнаяСтоимость = СтрокаТабличнойЧасти[ИмяКолонкиОбщСтоимость];
	упоРаботаСФормамиКлиент.ПриИзмененииКоличестваТабЧасти(СтрокаТабличнойЧасти, 
														, 
														ИмяКолонкиСтоимость, 
														ИмяКолонкиОбщСтоимость);	
	
	Если Не ИсходнаяСтоимость = СтрокаТабличнойЧасти[ИмяКолонкиОбщСтоимость] Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'В строке %1 скорректирована общая %2стоимость ресурсов с %3 до %4.'"),
		СтрокаТабличнойЧасти.НомерСтроки, 
		?(ИмяКолонкиСтоимость = "Стоимость", "", НСтр("ru = 'внешняя '")),
		ИсходнаяСтоимость, 
		СтрокаТабличнойЧасти[ИмяКолонкиОбщСтоимость]);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);					
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СубпродуктыРесурсНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОпцииВыбора = упоРаботаСФормамиКлиент.КонструкторОпцииВыборПроектнойПродукции(, , Истина);

	упоРаботаСФормамиКлиент.УстановитьПараметрыВыбораРесурсаСубпродуктов(Элемент, 
		Объект.ТипСубпродукта, ОпцииВыбора);

КонецПроцедуры

#КонецОбласти

#Область ПроектнаяПродукция

&НаКлиенте
Процедура ЗаполнитьКоэффициентСложностиДляРолей(ТаблицаРоли, СтрокаВладелец, ОбщийКоэффициент)
	
	Если Не ЗначениеЗаполнено(ТаблицаРоли) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаРоли Цикл
		Если Строка.ИндексСтрокиВладельца <> СтрокаВладелец.ИндексСтрокРаспределения Тогда
			Продолжить;
		КонецЕсли;
		Строка.КоэффициентСложности = ОбщийКоэффициент;
	КонецЦикла;
		
КонецПроцедуры //

&НаКлиенте
Процедура РассчитатьТрудоемкостьРаспределенияОбъемов(ДанныеРаспределения)
	
	ДанныеРаспределения.Трудоемкость = ДанныеРаспределения.Нормирование * ДанныеРаспределения.КоэффициентСложности 
		* (ДанныеРаспределения.ПроцентРаспределения / 100);
	
КонецПроцедуры // 

&НаКлиенте
Процедура ПересчитатьИтогКолонкиРаспределения(Форма,
										   ЭлементВладелец,
										   ЭлементПодчиненный, 
										   ИмяКолонкиСумма)
	Если ИмяКолонкиСумма = "" Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяКолонкиСумма = "КоэффициентСложности" Тогда
		ПересчитатьИтогКоэффициентСложности();
		Возврат;
	КонецЕсли;
										   
	ИтоговаяСумма = 0;
	РаспределенноеКоличество = 0;
	
	ТекущиеДанныеВладельца = Форма.Элементы[ЭлементВладелец].ТекущиеДанные;
	
	Если ТекущиеДанныеВладельца <> Неопределено Тогда
			
		ТаблицаПодчиненная = Форма.Объект[ЭлементПодчиненный];
		
		Для Каждого ЭлементРаспределения Из ТаблицаПодчиненная Цикл
			
			Если ЭлементРаспределения.ИндексСтрокиВладельца = ТекущиеДанныеВладельца.ИндексСтрокРаспределения Тогда
				ИтоговаяСумма = ИтоговаяСумма + ЭлементРаспределения[ИмяКолонкиСумма];
			КонецЕсли;

		КонецЦикла;
		
	КонецЕсли;
	
	ЭтотОбъект["ИтогРаспределенияПП_" + ИмяКолонкиСумма] =  Формат(ИтоговаяСумма, "ЧДЦ=2");

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогКоэффициентСложности()
	
	СуммаНормирование = ЭтотОбъект.ИтогРаспределенияПП_Нормирование;
	СуммаТрудоемкость = ЭтотОбъект.ИтогРаспределенияПП_Трудоемкость;	
	
	Если СуммаНормирование <> 0 Тогда
		ЭтотОбъект.ИтогРаспределенияПП_КоэффициентСложности = СуммаТрудоемкость / СуммаНормирование;
	Иначе
		ЭтотОбъект.ИтогРаспределенияПП_КоэффициентСложности = 0;
	КонецЕсли;

КонецПроцедуры //

&НаКлиенте
Процедура ПриИзмененииРаспределениеОбъемовКоэффициентСложности()
	
	ТекущиеДанныеРаспределения = ЭтотОбъект.Элементы["РаспределениеОбъемов"].ТекущиеДанные;
	Если ТекущиеДанныеРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеВладельца = ЭтотОбъект.Элементы["Субпродукты"].ТекущиеДанные;
	Если ТекущиеДанныеВладельца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеРаспределения.Трудоемкость = ТекущиеДанныеВладельца.Нормирование * ТекущиеДанныеРаспределения.КоэффициентСложности * (ТекущиеДанныеРаспределения.ПроцентРаспределения/100);
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	ТекущиеДанныеВладельца.Трудоемкость = ЭтотОбъект.ИтогРаспределенияПП_Трудоемкость;
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "КоэффициентСложности");
	ТекущиеДанныеВладельца.КоэффициентСложности = ЭтотОбъект.ИтогРаспределенияПП_КоэффициентСложности;
	
КонецПроцедуры //

&НаКлиенте
Процедура ПриИзмененииРаспределениеОбъемовТрудоемкость()
	
	Если Не ДоступенФункционалПроектнаяПродукция Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеРаспределения = ЭтотОбъект.Элементы["РаспределениеОбъемов"].ТекущиеДанные;
	Если ТекущиеДанныеРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеВладельца = ЭтотОбъект.Элементы["Субпродукты"].ТекущиеДанные;
	Если ТекущиеДанныеВладельца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	ТекущиеДанныеВладельца.Трудоемкость = ИтогРаспределенияПП_Трудоемкость;
	Если ТекущиеДанныеРаспределения.ПроцентРаспределения = 0 Или ТекущиеДанныеВладельца.Нормирование = 0 Тогда
		ТекущиеДанныеРаспределения.КоэффициентСложности = 1;
	Иначе
		ТекущиеДанныеРаспределения.КоэффициентСложности = 
			ТекущиеДанныеРаспределения.Трудоемкость / ТекущиеДанныеВладельца.Нормирование / 
				(ТекущиеДанныеРаспределения.ПроцентРаспределения/100);
	КонецЕсли;			
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "КоэффициентСложности");
	ТекущиеДанныеВладельца.КоэффициентСложности = ИтогРаспределенияПП_КоэффициентСложности;
	
КонецПроцедуры //

&НаКлиенте
Процедура ПриИзмененииРаспределениеОбъемовПроцентТрудоемкости()
	 
	ТекущиеДанныеРаспределения = ЭтотОбъект.Элементы["РаспределениеОбъемов"].ТекущиеДанные;
	Если ТекущиеДанныеРаспределения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеВладельца = ЭтотОбъект.Элементы["Субпродукты"].ТекущиеДанные;
	Если ТекущиеДанныеВладельца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеРаспределения.Количество = ТекущиеДанныеВладельца.Количество * (ТекущиеДанныеРаспределения.ПроцентРаспределения / 100);
	ТекущиеДанныеРаспределения.Нормирование = ТекущиеДанныеВладельца.Нормирование * (ТекущиеДанныеРаспределения.ПроцентРаспределения / 100);
	ТекущиеДанныеРаспределения.Трудоемкость = ТекущиеДанныеВладельца.Нормирование * ТекущиеДанныеРаспределения.КоэффициентСложности * (ТекущиеДанныеРаспределения.ПроцентРаспределения/100);
	ТекущиеДанныеРаспределения.Сумма = ТекущиеДанныеРаспределения.Количество * ТекущиеДанныеВладельца.Стоимость;
	
	
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "ПроцентРаспределения");
	Разница = 100 - ЭтотОбъект.ИтогРаспределенияПП_ПроцентРаспределения;
	
	Если Разница <> 0 Тогда
		
		ПараметрыОтбора = Новый Структура("ИндексСтрокиВладельца", ТекущиеДанныеВладельца.ИндексСтрокРаспределения); 
		ЗаписиРаспределения = ЭтотОбъект.Объект["РаспределениеОбъемов"].НайтиСтроки(ПараметрыОтбора);
		КоличествоЗаписей = ЗаписиРаспределения.Количество();
		ПоследняяСтрока = ЗаписиРаспределения[КоличествоЗаписей - 1];
		ПоследняяСтрока.ПроцентРаспределения = ПоследняяСтрока.ПроцентРаспределения + Разница;
		
		ПоследняяСтрока.Количество = ТекущиеДанныеВладельца.Количество * (ПоследняяСтрока.ПроцентРаспределения / 100);
		ПоследняяСтрока.Нормирование = ТекущиеДанныеВладельца.Нормирование * (ПоследняяСтрока.ПроцентРаспределения / 100);
		ПоследняяСтрока.Трудоемкость = ТекущиеДанныеВладельца.Нормирование * ПоследняяСтрока.КоэффициентСложности * (ПоследняяСтрока.ПроцентРаспределения/100);
		ПоследняяСтрока.Сумма = ПоследняяСтрока.Количество * ТекущиеДанныеВладельца.Стоимость;
		
	КонецЕсли; 
	
	ПересчитатьИтогиКолонокПП();
	ТекущиеДанныеВладельца.Трудоемкость = ИтогРаспределенияПП_Трудоемкость;
	ТекущиеДанныеВладельца.КоэффициентСложности = ИтогРаспределенияПП_КоэффициентСложности;
		
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиКолонокПП()
	
	Если Не ДоступенФункционалПроектнаяПродукция Тогда
		Возврат;
	КонецЕсли;
	
	СписокКолонкоПП = Новый Массив;
	СписокКолонкоПП.Добавить("Нормирование");
	СписокКолонкоПП.Добавить("Трудоемкость");
	СписокКолонкоПП.Добавить("ПроцентРаспределения");
	СписокКолонкоПП.Добавить("КоэффициентСложности");
	
	Для Каждого КолонкаПП Из СписокКолонкоПП Цикл
		ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", КолонкаПП);
	КонецЦикла;

КонецПроцедуры //

&НаКлиенте
Функция ВключенПереключательПроектнаяПродукция()
	
	Возврат ТипПродуктаЧисло = 1;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииКоличестваПроектногоПродукта(СтрокаТабличнойЧасти)

	ИмяПодчиненнойТаблицы = "РаспределениеОбъемов"; 
	КоличествоВладелец = СтрокаТабличнойЧасти.Количество;
	
	ТаблицаПодчиненная = ЭтотОбъект.Объект[ИмяПодчиненнойТаблицы];
	
	Для Каждого ПодчиненнаяСтрока Из ТаблицаПодчиненная Цикл
		
		Если ПодчиненнаяСтрока.ИндексСтрокиВладельца = СтрокаТабличнойЧасти.ИндексСтрокРаспределения Тогда
			ПодчиненнаяСтрока.Количество = КоличествоВладелец * (ПодчиненнаяСтрока.ПроцентРаспределения / 100);
		КонецЕсли;

	КонецЦикла;
	
	ДанныеДляЗаполнения = Новый Структура("Ресурс, Количество, Нормирование");
	ЗаполнитьЗначенияСвойств(ДанныеДляЗаполнения, СтрокаТабличнойЧасти);
	РассчитатьНормированиеППНаСервере(ДанныеДляЗаполнения); 
	ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, ДанныеДляЗаполнения, "Нормирование"); 
	ПриИзмененииНормированияПроектногоПродукта(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНормированиеППНаСервере(СтрокаТабличнойЧасти)
	
	Если ДоступенФункционалПроектнаяПродукция Тогда
		МодульупоПроектнаяПродукция = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукция");
		МодульупоПроектнаяПродукция.РассчитатьНормированиеПоСтрокеПроектнойПродукции(СтрокаТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНормированияПроектногоПродукта(СтрокаТабличнойЧасти)
		
	ЗаполнитьНормированиеПодчиненныхРолей(ЭтотОбъект.Объект["РаспределениеОбъемов"], СтрокаТабличнойЧасти, СтрокаТабличнойЧасти.Нормирование);
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Нормирование");
	
	Для Каждого СтрокаРоли Из ЭтотОбъект.Объект["РаспределениеОбъемов"] Цикл
		Если СтрокаРоли.ИндексСтрокиВладельца <> СтрокаТабличнойЧасти.ИндексСтрокРаспределения Тогда
			Продолжить;
		КонецЕсли;	
		СтрокаРоли.Трудоемкость = СтрокаТабличнойЧасти.Нормирование * СтрокаРоли.КоэффициентСложности * (СтрокаРоли.ПроцентРаспределения/100);
	КонецЦикла;
		
	ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	СтрокаТабличнойЧасти.Трудоемкость = ЭтотОбъект.ИтогРаспределенияПП_Трудоемкость;
		
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиПоТаблицеПП() 
	
	упоАналитикаПоПодразделениямКлиент.СтрокиРаспределенияВладелецПриАктивизацииСтроки(ЭтаФорма, "Субпродукты",
		"РаспределениеОбъемов", "ОбщСтоимость", Истина, Ложь);
	
	ПересчитатьИтогиКолонокПП();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДозаполнитьТЧСубпродукты()
	
	Для каждого Строка Из Объект.Субпродукты Цикл
		
		Если упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(Строка.Ресурс) Тогда
			
			Строка.ЭтоПП = Истина;
			Строка.Длительность = Строка.Количество * Строка.СкоростьВыполнения;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНормированиеПодчиненныхРолей(ТаблицаРоли, СтрокаВладелец, ОбщееНормирование)
	
	Если Не ЗначениеЗаполнено(ТаблицаРоли) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Строка Из ТаблицаРоли Цикл
		Если Строка.ИндексСтрокиВладельца <> СтрокаВладелец.ИндексСтрокРаспределения Тогда
			Продолжить;
		КонецЕсли;
		
		Строка.Нормирование = ОбщееНормирование * (Строка.ПроцентРаспределения / 100);
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура СубпродуктыРесурсПриИзмененииНаСервере(СтруктураСтрокиСубпродукты, МассивРаспределенияОбъемов)
	
	СтруктураСтрокиСубпродукты.ЭтоПП = 
		упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(СтруктураСтрокиСубпродукты.Ресурс);
	
	Если СтруктураСтрокиСубпродукты.ЭтоПП Тогда
		
		ПустаяПроектнаяЗадача = ПредопределенноеЗначение("Документ.упоПроектнаяЗадача.ПустаяСсылка");
		
		РеквизитыРесурса = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураСтрокиСубпродукты.Ресурс, 
			"Шаблон, ПроектнаяЗадача");
		
		Если РеквизитыРесурса.Шаблон = Ложь И Не (РеквизитыРесурса.ПроектнаяЗадача = Объект.Ссылка Или  
			РеквизитыРесурса.ПроектнаяЗадача = ПустаяПроектнаяЗадача) Тогда
			
			СтруктураСтрокиСубпродукты.Ресурс = ПредопределенноеЗначение("Справочник.упоПроектнаяПродукция.ПустаяСсылка");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураСтрокиСубпродукты.Ресурс) Тогда 

			МодульПроектнаяПродукцияВызовСервера = ОбщегоНазначения.ОбщийМодуль("упоПроектнаяПродукцияВызовСервера");
			МодульПроектнаяПродукцияВызовСервера.ЗаполнитьПланВыпускаПоПроектнойПродукции(СтруктураСтрокиСубпродукты,
				МассивРаспределенияОбъемов);
								
		КонецЕсли;
		
	Иначе   
		
		упоРесурсыИНормыВызовСервера.обПриИзмененииРесурсаТабЧасти(СтруктураСтрокиСубпродукты,
			Неопределено, Объект.НормаСтоимостиОбъемы);
		
		Если Не ЗначениеЗаполнено(СтруктураСтрокиСубпродукты.ЕдиницаНормирования) Тогда
			ЗаполнитьЕдИзмеренияСубпродуктов(СтруктураСтрокиСубпродукты);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьЕдИзмеренияСубпродуктов(СтруктураСтрокиСубпродукты) 
	
	СтруктураСтрокиСубпродукты.ЕдиницаНормирования = 
		упоЗаполнениеИПодборСервер.ПолучитьЕдиницуИзмеренияНоменклатуры(СтруктураСтрокиСубпродукты.Ресурс);
		
КонецФункции

&НаСервереБезКонтекста
Функция ПрофильДоходовПоУмолчанию()
	
	Возврат Константы.упоПрофильДоходовПоУмолчанию.Получить(); 
		
КонецФункции

&НаКлиенте
Процедура РаспределениеСтоимостиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ПересчитатьТаблицуРаспределенияЗавершение(ДополнительныеПараметры);	
	
	ИмяТаблицыРаспределения = ДополнительныеПараметры.ИмяТаблицыРаспределения;
	
	ПересчитатьИтогиВПодчиненнойТаблице(ДополнительныеПараметры.ИмяТаблицыВладельца, 
		ИмяТаблицыРаспределения, 
		ДополнительныеПараметры.ИмяКолонкиОбщСтоимость, 
		"ИндексСтрокиРаспределениеПоРолям",
		ДополнительныеПараметры.ПересчитыватьКоличество);
		
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТаблицыРаспределения);
	ТекстСообщения = "";
	Для Каждого СтрокаРаспределения Из ДополнительныеПараметры.ТаблицаРаспределения Цикл
		
		Если СтрокаРаспределения.СпособПривязки = 
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
			ТекстСообщения = НСтр(
				"ru = 'Изменилась стоимость, необходимо пересчитать распределение по периодам в табличной части ""%1"".'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ПредставлениеТаблицы);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиВПодчиненнойТаблице(ИмяТаблицыВладельца, 
	ИмяТаблицыРаспределения, 
	ИмяКолонкиСумма = "Сумма", 
	ИмяКолонкиИндекса = "ИндексСтрокиРаспределениеПоРолям",
	ПересчитыватьКоличество = Истина)
	
	упоАналитикаПоПодразделениямКлиент.ПересчитатьОстатокКРаспределению(ЭтаФорма,
		ИмяТаблицыВладельца,
		ИмяТаблицыРаспределения, 
		ИмяКолонкиСумма,
		ПересчитыватьКоличество);
	
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, 
		ЭтаФорма, 
		ИмяТаблицыРаспределения, 
		ИмяТаблицыВладельца,
		ИмяКолонкиИндекса, 
		ПересчитыватьКоличество);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРаспределение(Отказ)
	
	 //1. Проверка дублей в таблицах распределения.	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ГруппыРазделов", ПодготовитьСоответствиеЭлементовФормыРазделамПроверки());	
	ДопПараметры.Вставить("ГруппыРазделовКолонкиПоПериодам", ЭтаФорма.СоответствиеРазделовКолонкиПоПериодам);
	ДопПараметры.Вставить("ПредставлениеДляДокумента", Истина);		
	ДопПараметры.Вставить("КолонкаСуммыДДС", "Сумма");
	ДопПараметры.Вставить("ЭтоШаблон", Истина);
	
	упоРаботаСФормамиКлиент.ПроверитьТаблицыНаДубли(Объект, ЭтаФорма, ДопПараметры, Отказ);	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// 2. Проверка сумм и количества в таблицах распределения и родительских таблицах.				
	КлючиТаблиц = "ТаблицаВладелец, ТаблицаПодчиненная, ИмяКолонкиВладелец,
		|ИмяКолонкиПодчиненная, ЕстьКоличество, ЕстьИсточникПлана, ПредставлениеТаблицыРаспределения";
	ПараметрыТаблиц = Новый Массив;	
	
	ИмяТЧ = "Субпродукты";
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
	ПараметрыТаблиц.Добавить(
		Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеОбъемов", "ОбщСтоимость", "Сумма", Истина, Ложь, 
			ПредставлениеТаблицы));
	
	ИмяТЧ = "МатериальныеРесурсы";
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
	ПараметрыТаблиц.Добавить(
		Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеПотребностей", "ОбщСтоимость", "Сумма", Истина, Ложь, 
			ПредставлениеТаблицы));
	
	ИмяТЧ = "ДополнительныеЗатраты";
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
	ПараметрыТаблиц.Добавить(
		Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеДополнительныхЗатрат", "Стоимость", "Сумма", Ложь, Ложь, 
			ПредставлениеТаблицы));
	
	ИмяТЧ = "ПланДоходов";
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
	ПараметрыТаблиц.Добавить(
		Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеДоходов", "Сумма", "Сумма", Ложь, Истина, 
			ПредставлениеТаблицы));
	
	ИмяТЧ = "ПланРасходов";
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи(ИмяТЧ);
	ПараметрыТаблиц.Добавить(
		Новый Структура(КлючиТаблиц, ИмяТЧ, "РаспределениеРасходов", "Сумма", "Сумма", Ложь, Истина, 
			ПредставлениеТаблицы));
	
	упоАналитикаПоПодразделениямКлиент.ПроверитьРаспределениеПередЗаписью(Объект, ПараметрыТаблиц, Отказ);	

КонецПроцедуры

&НаКлиенте 
Функция ПодготовитьСоответствиеЭлементовФормыРазделамПроверки()
	
	ГруппыРазделов = Новый Структура;
	ГруппыРазделов.Вставить("ГруппаРаспределениеОбъемовПоПодразделениям", "РаспределениеОбъемов");
	ГруппыРазделов.Вставить("ГруппаРаспределениеПотребностей", "РаспределениеПотребностей");
	ГруппыРазделов.Вставить("ГруппаРаспределениеДополнительныхЗатрат", "РаспределениеДополнительныхЗатрат");
	ГруппыРазделов.Вставить("ГруппаДополнительныеЗатратыПоПроектнойЗадаче", "ДополнительныеЗатраты");
	ГруппыРазделов.Вставить("ГруппаРаспределениеПланДоходов", "РаспределениеДоходов");
	ГруппыРазделов.Вставить("ГруппаРаспределениеРасходов", "РаспределениеРасходов");
	ГруппыРазделов.Вставить("МатериальныеРесурсы", "МатериальныеРесурсы");
	ГруппыРазделов.Вставить("Субпродукты", "Субпродукты");
	ГруппыРазделов.Вставить("СтраницаПоступления", "ПланПоступлений");
	ГруппыРазделов.Вставить("СтраницаВыплаты", "ПланВыплат");


	Возврат ГруппыРазделов;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьЗаполнениеТаблиц(Отказ)
		
	ПроверитьЗаполнение_МатериальныеРесурсы(Отказ);
	ПроверитьЗаполнение_Субпродукты(Отказ);
	ПроверитьЗаполнение_ПланРасходов(Отказ);
	ПроверитьЗаполнение_ПланДоходов(Отказ);
	ПроверитьЗаполнение_ДопЗатраты(Отказ);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнение_ПланДоходов(Отказ)
	
	ИмяТаблицы 			= "ПланДоходов";                                                
		
	ЕстьТаблицаРаспределения 			= Элементы.РамкаГруппыРаспределениеПоПодразделениям.Видимость;
	ЕстьОбъемыВРаспределенииРасходов 	= Ложь;
	Если ЕстьТаблицаРаспределения Тогда
		ЕстьОбъемыВРаспределенииДоходов	= Элементы.РаспределениеДоходовГруппаОбъемыПоПодразделениям.Видимость;	                                             
	Иначе
		ЕстьОбъемыВРаспределенииДоходов = Ложь;
	КонецЕсли;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект, 
						                                                ИмяТаблицы, 
																		ЕстьТаблицаРаспределения, 
																		Отказ,
																		Истина,
																		ЕстьОбъемыВРаспределенииДоходов, 
																		ЕстьОбъемыВРаспределенииРасходов);
						
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьЗаполнение_МатериальныеРесурсы(Отказ)
	
	ИмяТаблицы 			= "МатериальныеРесурсы";
	
	ЕстьТаблицаРаспределения 			= Элементы.ГруппаРаспределениеПотребностей.Видимость;
	ЕстьОбъемыВРаспределенииРасходов 	= Ложь;
	ЕстьОбъемыВРаспределенииДоходов		= Ложь;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект, 
		ИмяТаблицы, 
		ЕстьТаблицаРаспределения, 
		Отказ,
		Истина,
		ЕстьОбъемыВРаспределенииДоходов, 
		ЕстьОбъемыВРаспределенииРасходов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнение_Субпродукты(Отказ)
	
	ИмяТаблицы = "Субпродукты";
	
	ЕстьТаблицаРаспределения = Элементы.ГруппаРаспределениеОбъемовПоПодразделениям.Видимость;
	ЕстьОбъемыВРаспределенииРасходов = Ложь;
	ЕстьОбъемыВРаспределенииДоходов = Ложь;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект,
		ИмяТаблицы,
		ЕстьТаблицаРаспределения,
		Отказ,
		Истина,
		ЕстьОбъемыВРаспределенииДоходов,
		ЕстьОбъемыВРаспределенииРасходов);
	
	Если упоИнтеграцияКлиентСервер.ДоступенФункционалПроектнаяПродукция() И Объект.ТранслироватьЗатратыПоСубпродуктам Тогда
		МодульПроектнаяПродукцияВызовСервера = ОбщегоНазначенияКлиент.ОбщийМодуль("упоПроектнаяПродукцияВызовСервера");
		МодульПроектнаяПродукцияВызовСервера.ПроверитьЗаполнениеРаспределенияПроектнойПродукцииПередТрансляцией(Объект.Субпродукты,
			Объект.РаспределениеОбъемов, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнение_ДопЗатраты(Отказ)
	
	ИмяТаблицы 			= "ДополнительныеЗатраты";
	
	ЕстьТаблицаРаспределения 			= Элементы.ГруппаРаспределениеДополнительныхЗатрат.Видимость;
	ЕстьОбъемыВРаспределенииРасходов 	= Ложь;
	ЕстьОбъемыВРаспределенииДоходов		= Ложь;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект, 
		ИмяТаблицы, 
		ЕстьТаблицаРаспределения, 
		Отказ,
		Истина,
		ЕстьОбъемыВРаспределенииДоходов, 
		ЕстьОбъемыВРаспределенииРасходов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнение_ПланРасходов(Отказ)
	
	ИмяТаблицы 			= "ПланРасходов";
	
	ЕстьТаблицаРаспределения 			= Элементы.ГруппаРаспределениеРасходов.Видимость;		
	Если ЕстьТаблицаРаспределения Тогда
		ЕстьОбъемыВРаспределенииРасходов = Элементы.РаспределениеРасходовГруппаОбъемыПоПодразделениям.Видимость;
	Иначе	
		ЕстьОбъемыВРаспределенииРасходов = Ложь;
    КонецЕсли;                                            
	ЕстьОбъемыВРаспределенииДоходов		= Ложь;
	
	упоРаботаСФормамиКлиент.ПроверитьЗаполнениеОсновнойИСвязаннойТаблиц(ЭтотОбъект, 
						                                                ИмяТаблицы, 
																		ЕстьТаблицаРаспределения, 
																		Отказ,
																		Истина,
																		ЕстьОбъемыВРаспределенииДоходов, 
																		ЕстьОбъемыВРаспределенииРасходов);
																		
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция НастройкиПоИмениКоманды(ИмяКоманды)
	
	УчитыватьКоличество = Ложь;
	Если ИмяКоманды = "РаспределитьПоПериодамПланДоходов" Тогда
		ИмяОсновнойТаблицы = "ПланДоходов"; 
		ИмяТаблицыРаспределения = "РаспределениеДоходов";
	ИначеЕсли ИмяКоманды = "РаспределитьПоПериодамПланРасходов" Тогда
		ИмяОсновнойТаблицы = "ПланРасходов";
		ИмяТаблицыРаспределения = "РаспределениеРасходов";
	ИначеЕсли ИмяКоманды = "РаспределитьПоПериодамСубпродукты" Тогда
		ИмяОсновнойТаблицы = "Субпродукты";
		ИмяТаблицыРаспределения = "РаспределениеОбъемов";
		УчитыватьКоличество = Истина;
	ИначеЕсли ИмяКоманды = "РаспределитьПоПериодамМатРесурсы" Тогда
		ИмяОсновнойТаблицы = "МатериальныеРесурсы";
		ИмяТаблицыРаспределения = "РаспределениеПотребностей";
		УчитыватьКоличество = Истина;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяОсновнойТаблицы", 		ИмяОсновнойТаблицы);
	Результат.Вставить("ИмяТаблицыРаспределения", 	ИмяТаблицыРаспределения);	
	Результат.Вставить("УчитыватьКоличество", 		УчитыватьКоличество);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура РаспределениеСтоимостиПП_Завершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	СуммаКРаспределению = ДополнительныеПараметры.СуммаКРаспределению;
	ТекущиеДанныеПП = ДополнительныеПараметры.ТекущиеДанныеПП;
	ТаблицаРаспределения = Объект.РаспределениеОбъемов;
	
	упоРаботаСФормамиКлиент.ПересчитатьДлительностьПоПроектнойПродукции(ТекущиеДанныеПП);
	ПриИзмененииКоличестваПроектногоПродукта(ТекущиеДанныеПП);

	РаспределенныеСуммы = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СуммаКРаспределению, 
																ДополнительныеПараметры.КоэффициентыКРаспределению);
																
	Счетчик = 0;
	
	Для Каждого ПодчиненнаяСтрока Из ТаблицаРаспределения Цикл
		Если ПодчиненнаяСтрока.ИндексСтрокиВладельца = ТекущиеДанныеПП.ИндексСтрокРаспределения Тогда
			
			Если СуммаКРаспределению = 0 Тогда
				ПодчиненнаяСтрока.Сумма = 0;
			Иначе
				ПодчиненнаяСтрока.Сумма = РаспределенныеСуммы[Счетчик];	
			КонецЕсли;
			Счетчик = Счетчик + 1;
			
		КонецЕсли;
	КонецЦикла;
											
	упоРаботаСФормамиКлиент.ПересчитатьИтогиВРаспределенииПоПериодам(Объект, ЭтаФорма, "РаспределениеОбъемов", 
		"Субпродукты", "ИндексСтрокиРаспределениеПоРолям", Истина);
	
	ПересчитатьИтогиВПодчиненнойТаблице("Субпродукты", 
		"РаспределениеОбъемов", 
		"ОбщСтоимость", 
		"ИндексСтрокиРаспределениеПоРолям",
		Истина);
		
	ПредставлениеТаблицы = упоПроектыИЗадачиОбщие.ПредставлениеТабличнойЧастиЗадачи("РаспределениеОбъемов");
	ТекстСообщения = "";
	Для Каждого СтрокаРаспределения Из ТаблицаРаспределения Цикл
		
		Если СтрокаРаспределения.СпособПривязки = 
			ПредопределенноеЗначение("Перечисление.упоСпособПривязкиРаспределения.Вручную") Тогда
			ТекстСообщения = НСтр(
				"ru = 'Изменилась стоимость, необходимо пересчитать распределение по периодам в табличной части ""%1"".'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ПредставлениеТаблицы);
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновлениеИтоговРаспределенияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Свойство("ИтогиПересчитаны") И ДополнительныеПараметры.ИтогиПересчитаны Тогда
		Возврат;
	КонецЕсли;	
	
	ПараметрыТаблицы = ДополнительныеПараметры.ПараметрыТекТаблицы;
	
	ИмяТаблицыВладельца = упоПроектыИЗадачиОбщие.ИмяТаблицыВладельцаПоИмениПодчиненной(
		ПараметрыТаблицы.ТаблицаРаспределения);
			
	Если Не ЗначениеЗаполнено(ИмяТаблицыВладельца) Или ИмяТаблицыВладельца = "ДополнительныеЗатраты" 		
		Или ИмяТаблицыВладельца = "ПланДоходов" Или ИмяТаблицыВладельца = "ПланРасходов" Тогда
		Возврат;
	КонецЕсли;	

	ПересчитатьИтогиВПодчиненнойТаблице(ИмяТаблицыВладельца, 
		ПараметрыТаблицы.ТаблицаРаспределения, 
		"ОбщСтоимость", 
		"ИндексСтрокиРаспределениеПоРолям",
		Истина);
	
	ЭтоПП = Объект.ТипСубпродукта = ПредопределенноеЗначение("Перечисление.упоТипСубпродукта.ПроектнаяПродукция");
	Если ИмяТаблицыВладельца = "Субпродукты" И ЭтоПП Тогда		
		ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Нормирование");
	    ПересчитатьИтогКолонкиРаспределения(ЭтаФорма, "Субпродукты", "РаспределениеОбъемов", "Трудоемкость");
	КонецЕсли;
			
	ДополнительныеПараметры.Вставить("ИтогиПересчитаны", Истина);

КонецПроцедуры

#КонецОбласти
