&НаКлиенте
Процедура УстановитьОбщийПрофильКлиент(ИмяТаблицы)
	
	ТабличнаяЧасть = Неопределено;
	
	Если ИмяТаблицы = "ТрудовыеРесурсы" Тогда
		ТабличнаяЧасть = Объект.ТрудовыеРесурсы;
	Иначе
		Возврат;
	КонецЕсли; 
	
	Если ТабличнаяЧасть.Количество() = 0 Тогда      
		Возврат;
	КонецЕсли; 
	
	 // Выбираем профиль распределения.
	 
	 Контекст = Новый Структура;
	 Контекст.Вставить("ИмяТаблицы",ИмяТаблицы);
	 ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьОбщийПрофильКлиентОсновная",ЭтотОбъект,Контекст);
	 ОткрытьФорму("Справочник.упоПрофилиРаспределенияТрудозатрат.ФормаВыбора",,,,,,ОписаниеОповещения);
	 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОбщийПрофильКлиентОсновная(ОбщийПрофиль,ДополнительныеПараметры) Экспорт
	
	Если ОбщийПрофиль <> Неопределено Тогда
		
		ТабличнаяЧасть = Неопределено;
		
		Если ДополнительныеПараметры.ИмяТаблицы = "ТрудовыеРесурсы" Тогда
			ТабличнаяЧасть = Объект.ТрудовыеРесурсы;
		Иначе
			Возврат;
		КонецЕсли; 
		
		Если ТабличнаяЧасть.Количество() = 0 Тогда      
			Возврат;
		КонецЕсли; 
		
		
		Для каждого СтрокаДанных Из ТабличнаяЧасть Цикл
			СтрокаДанных.ПрофильРаспределения = ОбщийПрофиль;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

