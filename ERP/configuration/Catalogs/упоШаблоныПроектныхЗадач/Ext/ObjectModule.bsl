// Процедура для вызова при подборе ресурсов.
//
// Параметры:
//  СтрокаТабличнойЧасти - ДанныеФормыЭлементКоллекции, Структура 	- данные строки.
//  ПараметрыПодбора	 - СписокЗначений 							- список параметров подбора.
//
Процедура ВыполнитьДействияПриПодборе(Знач СтрокаТабличнойЧасти, ПараметрыПодбора = Неопределено) Экспорт

	Если НЕ ПараметрыПодбора = Неопределено И НЕ ПараметрыПодбора.Количество() = 0 Тогда      
		Для каждого ПараметрПодбора Из ПараметрыПодбора Цикл
			
			// прямое обращение к реквизитам на всякий случай оборачиваем в try
			Попытка 				
				Если ПараметрПодбора.Представление = "ИмяТабличнойЧасти" Тогда      					
					Если ПараметрПодбора.Значение = "ПланПоступлений" ИЛИ ПараметрПодбора.Значение = "ПланВыплат"
						ИЛИ ПараметрПодбора.Значение = "ПланДоходов" ИЛИ ПараметрПодбора.Значение = "ПланРасходов" Тогда     
						
						// попробуем определить договор контрагента по умолчанию
						
						Если НЕ упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаТабличнойЧасти.Контрагент) Тогда      
							СтрокаТабличнойЧасти.Договор = СтрокаТабличнойЧасти.Контрагент.упоОсновнойДоговорКонтрагента;
						КонецЕсли; 							
					ИначеЕсли ПараметрПодбора.Значение = "ТрудовыеРесурсы" Тогда
						
						упоРесурсыИНормыВызовСервера.обПриИзмененииРесурсаТабЧасти(СтрокаТабличнойЧасти, ЭтотОбъект, НормаСтоимостиТрудовыхРесурсов);				
						
					КонецЕсли; 			
					
					Продолжить;				
				КонецЕсли; 
				
			// устанавливаем только те колонки, которые еще не были заполнены пользователем
				
			Если упоПроверкаЗаполненияВызовСервера.обЗначениеНеЗаполнено(СтрокаТабличнойЧасти[ПараметрПодбора.Представление]) Тогда      
				СтрокаТабличнойЧасти[ПараметрПодбора.Представление]	= ПараметрПодбора.Значение;	
			КонецЕсли; 			
				
			Исключение
				// некорректное имя колонки
			КонецПопытки;
			
		КонецЦикла; 

	Иначе
	     упоРесурсыИНормыВызовСервера.обПриИзмененииРесурсаТабЧасти(СтрокаТабличнойЧасти, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры // ЗаписатьСсылку()

