// Обработчик события ПриКопировании модуля объекта.
// 
// Параметры: 
//  ОбъектКопирования – СправочникОбъект, исходный элемент, который является источником копирования. 
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПриКопировании(ОбъектКопирования)
	
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектПриКопировании(ЭтотОбъект, ОбъектКопирования);
	упоПроектыИЗадачиОбщие.ЗаписатьТипЗадачи(ЭтотОбъект);
	
КонецПроцедуры // ПриКопировании()

// Обработчик события ОбработкаЗаполнения модуля объекта.
// 
// Параметры: 
//  Основание    - Произвольный, значение, которое используется как основание для заполнения.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ОбработкаЗаполнения(Основание)
	
	ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Этап;
	
	Если ТипЗнч(Основание)=Тип("Неопределено") Тогда 
		Возврат;	
	КонецЕсли; 
	
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектОбработкаЗаполнения(ЭтотОбъект, Основание);
	
	// Примечание: в веб-клиенте принудительно заполняется поле "Родитель" при ручном создании элемента,
	// поэтому его необходимо очищать.
	Если ТипЗнч(Основание) = Тип("Структура") Тогда
		ПоляИсключения = ?(ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент(), "Родитель", "");		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Основание, , ПоляИсключения);
	КонецЕсли;
	
	упоПроектыИЗадачиОбщие.ЗаписатьТипЗадачи(ЭтотОбъект);
	
КонецПроцедуры // ОбработкаЗаполнения()

// Обработчик события ПередЗаписью модуля объекта.
// 
// Параметры: 
//  Отказ        - Булево, признак отказа от записи элемента.
// 
// Возвращаемое значение: 
//  Нет.
// 
Процедура ПередЗаписью(Отказ)
	
	упоОбработчикиСобытийВызовСервера.обСправочникОбъектПередЗаписью(ЭтотОбъект, Отказ);
	
	ПроверитьДанныеПередЗаписью(Отказ);

	Если НЕ Отказ Тогда
		
		Наименование 		   	= ПолноеНаименование;
		НазваниеПроектнойЗадачи = ПолноеНаименование;
		
		упоПроектыИЗадачиОбщие.ЗаписатьТипЗадачи(ЭтотОбъект);
		ДлительностьМоделиПакетаРаботВЧасах = ДлительностьМоделиПакетаРабот * ЕдиницаНормированияДлительности.Коэффициент;
		
		Для каждого предусловие Из ПредУсловия Цикл
		    Если НЕ ЗначениеЗаполнено(предусловие.ТипСвязи) Тогда
				предусловие.ТипСвязи = Перечисления.упоТипСвязи.ОкончаниеНачало;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(предусловие.ЕдиницаНормированияДлительности) Тогда
				предусловие.ЕдиницаНормированияДлительности = Справочники.упоЕдиницыВремени.Час;
			КонецЕсли;
			
			предусловие.ЗадержкаВЧасах = предусловие.Задержка * предусловие.ЕдиницаНормированияДлительности.Коэффициент;
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры // ПередЗаписью()

