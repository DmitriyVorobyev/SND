// Устанавливает значение устаревших реквизитов
// (требуются для совместимости с функционалом редакции 1)
// по значению реквизита ТипПроектнойЗадачи.
//
Процедура ЗаписатьТипЗадачи() Экспорт
	
	Если ЭтоМодельПакетаРабот = Ложь
		И ЭтоПакетРабот = Ложь
		И ЭтоВеха = Ложь Тогда
		
		ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Этап;	
		
	ИначеЕсли ЭтоМодельПакетаРабот = Ложь
		И ЭтоПакетРабот = Истина
		И ЭтоВеха = Ложь Тогда
		
		ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.ПакетРабот;
		
	ИначеЕсли ЭтоМодельПакетаРабот = Истина
		И ЭтоПакетРабот = Истина
		И ЭтоВеха = Ложь Тогда
		
		ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.МодельПакетаРабот;
		
	ИначеЕсли ЭтоМодельПакетаРабот = Ложь
		И ЭтоПакетРабот = Ложь
		И ЭтоВеха = Истина Тогда
		
		ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.Веха;
		
	КонецЕсли;

КонецПроцедуры // ЗаписатьТипЗадачи()

// Функция формирует структуру обязательных реквизитов объекта.
// Для группы формируется только структура реквизитов шапки,
// для элемента формируется структура реквизитов шапки или табличной части.
// 
// Параметры: 
//  ИмяТабличнойЧасти - Строка - содержит имя табличной части объекта,
//                      если параметр не указан, то структура формируется по шапке объекта.
// 
// Возвращаемое значение: 
//  Структура         - содержит поля обязательных реквизитов,
//                      Ключ поля структуры - реквизит,
//                      Значение поля структуры = Неопределено.
// 
Функция ПолучитьОбязательныеРеквизиты(ИмяТабличнойЧасти = Неопределено) Экспорт
	
	СтруктураОбязательныхПолей = Новый Структура;
	ЭтоEPM = упоИнтеграцияКлиентСерверПовтИсп.ЭтоEPM();
	
	// Формирование структуры обязательных реквизитов шапки
	Если ИмяТабличнойЧасти = Неопределено Тогда
		
		Если Не РучнойВводСроков И ТипПроектнойЗадачи = Перечисления.упоТипПроектнойЗадачи.МодельПакетаРабот Тогда 
			СтруктураОбязательныхПолей.Вставить("ДлительностьМоделиПакетаРабот");
			СтруктураОбязательныхПолей.Вставить("ЕдиницаНормированияДлительности");
		КонецЕсли;
		
	ИначеЕсли ЭтоВеха И (Не ИмяТабличнойЧасти = Неопределено) Тогда
				 
	// Формирование структуры обязательных реквизитов табличных частей
	ИначеЕсли ИмяТабличнойЧасти = "ПредУсловия" Тогда
		СтруктураОбязательныхПолей.Вставить("ЗадачаПредшественник");
	ИначеЕсли ИмяТабличнойЧасти = "МатериальныеРесурсы" Тогда
		СтруктураОбязательныхПолей.Вставить("Ресурс");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		СтруктураОбязательныхПолей.Вставить("Количество");
		СтруктураОбязательныхПолей.Вставить("ЕдиницаНормирования");
		Если ЭтоEPM Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязкиПотребности");
		КонецЕсли;	
		Если ВключитьМатРесурсыВПланРасходов Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязки");
			СтруктураОбязательныхПолей.Вставить("СтатьяЗатрат");
		КонецЕсли;		
	ИначеЕсли ИмяТабличнойЧасти = "ДополнительныеЗатраты" Тогда
		СтруктураОбязательныхПолей.Вставить("СтатьяЗатрат");
		СтруктураОбязательныхПолей.Вставить("Стоимость");
	ИначеЕсли ИмяТабличнойЧасти = "ПланДоходов" Или ИмяТабличнойЧасти = "ПланРасходов" Тогда
		СтруктураОбязательныхПолей.Вставить("Статья");
		СтруктураОбязательныхПолей.Вставить("Сумма");
		СтруктураОбязательныхПолей.Вставить("СпособПривязки");
	ИначеЕсли ИмяТабличнойЧасти = "ПланПоступлений" Или ИмяТабличнойЧасти = "ПланВыплат" Тогда
		СтруктураОбязательныхПолей.Вставить("Статья");
		СтруктураОбязательныхПолей.Вставить("Сумма");
		СтруктураОбязательныхПолей.Вставить("СпособПривязки");
	ИначеЕсли ИмяТабличнойЧасти = "Субпродукты" Тогда
		СтруктураОбязательныхПолей.Вставить("Ресурс");
		СтруктураОбязательныхПолей.Вставить("Валюта");
		Если ЭтоEPM Тогда
			СтруктураОбязательныхПолей.Вставить("СпособПривязкиВыпуска");
		КонецЕсли;
		Если ВключитьСубпродуктыВПланДоходов Тогда
			СтруктураОбязательныхПолей.Вставить("СтатьяДоходов");
			СтруктураОбязательныхПолей.Вставить("СпособПривязки");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураОбязательныхПолей;
	
КонецФункции

// Процедура проверяет заполнение обязательных реквизитов объекта.
// Если хотя бы один реквизит не заполнен, то выставляется флаг отказа от выполнения операции.
// 
// Параметры:
//  Отказ        - Тип: Булево. Признак отказа от выполнения операции.
// 
Процедура лмПроверитьЗаполнениеРеквизитов(Отказ) Экспорт
	
	// Наименование заполняется для целей корректного формирования заголовка сообщения при отказе записи.
	Наименование = ПолноеНаименование;
	
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ);
	
КонецПроцедуры

// Процедура проверяет все необходимые данные документа для его записи в ИБ.
// 
// Параметры:
//  Отказ        - Тип: Булево. Признак отказа от выполнения операции.
// 
// Возвращаемое значение:
//  Нет.
// 
Процедура ПроверитьДанныеПередЗаписью(Отказ) Экспорт
	
	// Получим заголовок для сообщения об ошибках при записи объекта.
	Заголовок = обСформироватьЗаголовокОшибкиПриЗаписи(ЭтотОбъект);
	
	// Проверяем заполненность обязательных реквизитов.
	упоПроверкаЗаполненияВызовСервера.обПроверитьЗаполнениеРеквизитов(ЭтотОбъект, Отказ, Заголовок);
	
	упоПроектыИЗадачиВызовСервера.обПроверитьДопустимостьЗаписиШаблонаЗадачи(ЭтотОбъект, Отказ, Заголовок);
	упоПроектыИЗадачиВызовСервера.обПроверитьПредусловияШаблонаЗадачи(ЭтотОбъект, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьДанныеПередЗаписью()

