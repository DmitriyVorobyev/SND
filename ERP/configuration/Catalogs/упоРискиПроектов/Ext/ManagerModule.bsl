// Получает текущие приоритеты риска.
//
// Параметры:
//  Ссылка	 - СправочникСсылка.упоРискиПроектов - риск.
//
// Возвращаемое значение:
//  Структура - текущие приоритеты риска.
//
Функция ПолучитьТекущиеПриоритетыРиска(Ссылка) Экспорт
	
	СтруктураПриоритета = Новый Структура;
	СтруктураПриоритета.Вставить("Риск", Ссылка);
	СтруктураПриоритета.Вставить("Приоритет", 0);
	
	ЗапросРиска = Новый Запрос;
	ЗапросРиска.Текст ="ВЫБРАТЬ
	|	упоПриоритетыРисковПроектов.Риск,
	|	упоПриоритетыРисковПроектов.Приоритет
	|ИЗ
	|	РегистрСведений.упоПриоритетыРисковПроектов КАК упоПриоритетыРисковПроектов
	|ГДЕ
	|	упоПриоритетыРисковПроектов.Риск = &Риск"; 

	ЗапросРиска.УстановитьПараметр("Риск", Ссылка);
	Результат = ЗапросРиска.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		СтруктураПриоритета.Приоритет = Выборка.Приоритет;
		
	КонецЕсли;
	
	Возврат СтруктураПриоритета;
				   
КонецФункции 

