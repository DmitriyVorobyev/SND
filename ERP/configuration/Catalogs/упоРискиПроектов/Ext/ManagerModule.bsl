// Изменяет приоритет риска.
//
// Параметры:
//  РискСсылка	 - СправочникСсылка.упоРискиПроектов - риск.
//  Смещение	 - Число - число, на которое менятеся приоритет.
//
// Возвращаемое значение:
//	Булево - результат выполнения функции.
//
Функция УдалитьИзменитьПриоритет(РискСсылка, Смещение) Экспорт
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(РискСсылка) Тогда			
		
		ТекущийПриоритет = Справочники.упоРискиПроектов.ПолучитьТекущиеПриоритетыРиска(РискСсылка);
		
		Документ = Документы.упоРегистрацияИзмененийРисковПроектов.СоздатьДокумент();
		Документ.Дата = ТекущаяДатаСеанса();
		СтрокаДанных = Документ.Приоритеты.Добавить();
		СтрокаДанных.Риск = РискСсылка;
		СтрокаДанных.Приоритет = ТекущийПриоритет.Приоритет;
		СтрокаДанных.Приоритет = СтрокаДанных.Приоритет + Смещение;
		
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Проведение);		
			Результат = Истина;
		Исключение
			Сообщение = НСтр("ru = 'Не удалось измененить приоритет риска проекта. Подробности см. в журнале регистрации.'");
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			ЗаписьЖурналаРегистрации("Ошибка записи", УровеньЖурналаРегистрации.Ошибка, 
				Метаданные.Документы.упоРегистрацияИзмененийРисковПроектов, РискСсылка, 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;		
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Изменяет приоритет риска проектов.
//
// Параметры:
//  РискСсылка	 - СправочникСсылка.упоРискиПроектов	- риск.
//  Смещение	 - Число	 							- смещение риска.
// 
// Возвращаемое значение:
//  Неопределено - не возвращает значение.
//
Функция ИзменитьПриоритет(РискСсылка, Смещение) Экспорт
	
	ТекущийПриоритет = Справочники.упоРискиПроектов.ПолучитьТекущиеПриоритетыРиска(РискСсылка);
	
	ЗапросРисков = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	упоСвойстваРисковПроектовПланСрезПоследних.Риск,
	               |	упоСвойстваРисковПроектовПланСрезПоследних.ТипРиска,
	               |	упоСвойстваРисковПроектовПланСрезПоследних.Риск.Владелец КАК Проект
	               |ПОМЕСТИТЬ ВТ_СвойстваРиска
	               |ИЗ
	               |	РегистрСведений.упоСвойстваРисковПроектовПлан.СрезПоследних(, Риск = &Риск) КАК упоСвойстваРисковПроектовПланСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	упоСвойстваРисковПроектовПланСрезПоследних.Риск
	               |ПОМЕСТИТЬ ВТ_ВсеРискиПоТипу
	               |ИЗ
	               |	РегистрСведений.упоСвойстваРисковПроектовПлан.СрезПоследних(, ) КАК упоСвойстваРисковПроектовПланСрезПоследних
	               |ГДЕ
	               |	(упоСвойстваРисковПроектовПланСрезПоследних.Риск.Владелец, упоСвойстваРисковПроектовПланСрезПоследних.ТипРиска) В
	               |			(ВЫБРАТЬ
	               |				ВТ_СвойстваРиска.Проект,
	               |				ВТ_СвойстваРиска.ТипРиска
	               |			ИЗ
	               |				ВТ_СвойстваРиска КАК ВТ_СвойстваРиска)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	упоПриоритетыРисковПроектов.Приоритет КАК Приоритет,
	               |	ВТ_ВсеРискиПоТипу.Риск
	               |ИЗ
	               |	ВТ_ВсеРискиПоТипу КАК ВТ_ВсеРискиПоТипу
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.упоПриоритетыРисковПроектов КАК упоПриоритетыРисковПроектов
	               |		ПО ВТ_ВсеРискиПоТипу.Риск = упоПриоритетыРисковПроектов.Риск
	               |ГДЕ
	               |	упоПриоритетыРисковПроектов.Приоритет < &ТекущийПриоритет
	               |	И упоПриоритетыРисковПроектов.Риск В
	               |			(ВЫБРАТЬ
	               |				ВТ_ВсеРискиПоТипу.Риск
	               |			ИЗ
	               |				ВТ_ВсеРискиПоТипу КАК ВТ_ВсеРискиПоТипу)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приоритет";
	
	
	Если Смещение = 1 Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "упоПриоритетыРисковПроектов.Приоритет < &ТекущийПриоритет", "упоПриоритетыРисковПроектов.Приоритет > &ТекущийПриоритет");
		ТекстЗапроса = ТекстЗапроса + " УБЫВ";		
		
	КонецЕсли;
	
	ЗапросРисков.Текст = ТекстЗапроса;
	
	ЗапросРисков.УстановитьПараметр("Риск", РискСсылка);
	ЗапросРисков.УстановитьПараметр("ТекущийПриоритет", ТекущийПриоритет.Приоритет);
	
	РезультатРисков = ЗапросРисков.Выполнить();
	
	Если РезультатРисков.Пустой() Тогда
		
		НовыйПриоритет = ТекущийПриоритет.Приоритет + Смещение;
		НижнийРиск = Неопределено;
		
	Иначе
		
		ВыборкаРисков = РезультатРисков.Выбрать();
		ВыборкаРисков.Следующий();
		
		НижнийРиск =  ВыборкаРисков.Риск;
		НовоеЗначениеНижнего = ВыборкаРисков.Приоритет - Смещение;
		НовыйПриоритет = ТекущийПриоритет.Приоритет + Смещение;
		
	КонецЕсли;
	
	РегистрПриоритетов = РегистрыСведений.упоПриоритетыРисковПроектов.СоздатьНаборЗаписей();
	РегистрПриоритетов.Отбор.Риск.Установить(РискСсылка);
	
	РегистрПриоритетов.Прочитать();
	РегистрПриоритетов.Очистить();
	
	НоваяСтрока = РегистрПриоритетов.Добавить();
	НоваяСтрока.Риск = РискСсылка;
	НоваяСтрока.Приоритет = НовыйПриоритет;
	
	РегистрПриоритетов.Записать(Истина);
	
	Если НижнийРиск <> Неопределено Тогда
		
		РегистрПриоритетов = РегистрыСведений.упоПриоритетыРисковПроектов.СоздатьНаборЗаписей();
		РегистрПриоритетов.Отбор.Риск.Установить(НижнийРиск);
		
		РегистрПриоритетов.Прочитать();
		РегистрПриоритетов.Очистить();
		
		НоваяСтрока = РегистрПриоритетов.Добавить();
		НоваяСтрока.Риск = НижнийРиск;
		НоваяСтрока.Приоритет = НовоеЗначениеНижнего;
		
		РегистрПриоритетов.Записать(Истина);
		
	КонецЕсли;
	
КонецФункции

