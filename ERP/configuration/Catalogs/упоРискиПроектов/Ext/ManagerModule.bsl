Функция ПолучитьРесурсыСрезаПоследнихПоРегистру(ИмяРегистра, Ссылка)
	
	СтруктураРеквизитов = ПолучитьСтруктуруРесурсовРегистра(ИмяРегистра);
		
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		СтрокаПолейДляЗапроса = "";
		Для Каждого КлючЗначенеи Из СтруктураРеквизитов Цикл			
			СтрокаПолейДляЗапроса = СтрокаПолейДляЗапроса + ?(ЗначениеЗаполнено(СтрокаПолейДляЗапроса), ", ", "") 
				+ "ТаблицаДанных." + КлючЗначенеи.Ключ;
		КонецЦикла;
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	#Поля#
			|ИЗ
			|	РегистрСведений." + ИмяРегистра + ".СрезПоследних(, Риск = &Ссылка) КАК ТаблицаДанных";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#Поля#", СтрокаПолейДляЗапроса);				   
		
		Запрос = Новый Запрос;				   
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Выборка);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции 

Функция ПолучитьСтруктуруРесурсовРегистра(ИмяРегистра)
	
	Реквизиты = Метаданные.РегистрыСведений[ИмяРегистра].Ресурсы;
	
	СтруктураРеквизитов = Новый Структура;
	
	Для Каждого Реквизит Из Реквизиты Цикл
