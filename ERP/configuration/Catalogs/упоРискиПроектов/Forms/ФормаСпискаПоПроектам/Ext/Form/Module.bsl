#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Список, Отказ, СтандартнаяОбработка); 		
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Проект") Тогда
		Если ТипЗнч(Параметры.Отбор.Проект) = Тип("СправочникСсылка.Проекты") Тогда
			ОтборПроект = Параметры.Отбор.Проект;
		КонецЕсли;	
	КонецЕсли;
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ТипРиска") Тогда
		Если ТипЗнч(Параметры.Отбор.ТипРиска) = Тип("ПеречислениеСсылка.упоТипыРисковПроектов") Тогда
			ОтборТипРиска = Параметры.Отбор.ТипРиска;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ПроектнаяЗадача") Тогда
		Если ТипЗнч(Параметры.Отбор.ПроектнаяЗадача) = Тип("ДокументСсылка.упоПроектнаяЗадача") Тогда
			ОтборПроектнаяЗадача = упоПроектыИЗадачиВызовСервера.обНайтиСвязанныйЭлементПроекта(Параметры.Отбор.ПроектнаяЗадача);
			Параметры.Отбор.Вставить("ПроектнаяЗадача", ОтборПроектнаяЗадача);
		ИначеЕсли ТипЗнч(Параметры.Отбор.ПроектнаяЗадача) = Тип("СправочникСсылка.Проекты") Тогда
			ОтборПроектнаяЗадача = Параметры.Отбор.ПроектнаяЗадача;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

