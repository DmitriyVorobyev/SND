&НаКлиентеНаСервереБезКонтекста
Функция ОбновитьЗаголовокФормы(ЭтаФорма) 
	
	ПолеТипРиска = Новый ПолеКомпоновкиДанных("ТипРиска");
	ПолеПроект = Новый ПолеКомпоновкиДанных("Проект");
	
	ОтборПоРиску = Неопределено;
	ОтборПоПроекту = Неопределено;
	
	Для Каждого ЭлементОтбора Из ЭтаФорма.Список.Отбор.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Тогда 
			Продолжить; 
		КонецЕсли;
		
		Если ЭлементОтбора.ЛевоеЗначение = ПолеТипРиска И ТипЗнч(ЭлементОтбора.ПравоеЗначение) = 
			Тип("ПеречислениеСсылка.упоТипыРисковПроектов") Тогда
			
			ОтборПоРиску = ЭлементОтбора.ПравоеЗначение;
			
		КонецЕсли;
		
		Если ЭлементОтбора.ЛевоеЗначение = ПолеПроект 
			И ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СправочникСсылка.Проекты") Тогда
			
			ОтборПоПроекту = ЭлементОтбора.ПравоеЗначение;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Заголовок = "";
		
	Если ОтборПоРиску = ПредопределенноеЗначение("Перечисление.упоТипыРисковПроектов.Возможность") Тогда
		Заголовок = НСтр("ru = 'Возможности проектов'");
	ИначеЕсли ОтборПоРиску = ПредопределенноеЗначение("Перечисление.упоТипыРисковПроектов.Угроза") Тогда
		Заголовок = НСтр("ru = 'Угрозы проектов'");
	ИначеЕсли Не ЗначениеЗаполнено(ОтборПоРиску) Тогда
		Заголовок = НСтр("ru = 'Риски проектов'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПоПроекту) Тогда
		Заголовок = Заголовок + ": " + ОтборПоПроекту;
	КонецЕсли;
	
	ЭтаФорма.Заголовок = Заголовок;
	
КонецФункции

