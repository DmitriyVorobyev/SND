&НаКлиентеНаСервереБезКонтекста
Функция СформироватьЗаголовок(ВидЗадания, ЭтоНовый, СтрокаНаименование = "", Статус = "")
	
	СтрокаВидЗадания = ?(ЗначениеЗаполнено(ВидЗадания), Строка(ВидЗадания), "Задание");
	
	Если ЭтоНовый Тогда
		
		ЗаголовокФормы = СтрокаВидЗадания + " (создание)";
		
	Иначе	
		ЗаголовокФормы =  СтрокаНаименование
						+ " (" 
						+ СтрокаВидЗадания
						+ ") | Статус: " + Статус; 	
		
	КонецЕсли;
					
	Возврат ЗаголовокФормы;					
	
КонецФункции

&НаКлиенте
Процедура ПроектПриИзменении(Элемент)
	
	Объект.ПортфельПроекта = ПолучитьПортфельПроектаНаСервере(Объект.Проект);
	
	РезультатПроверки = ПроверитьСоответствиеПроектнойЗадачиПроекту(Объект.Проект, Объект.ПроектнаяЗадача);	
	Если РезультатПроверки.ОчиститьПроект Тогда
	    Объект.Проект = ПредопределенноеЗначение("Справочник.Проекты.ПустаяСсылка");
		Объект.ПроектнаяЗадача = ПредопределенноеЗначение("Справочник.Проекты.ПустаяСсылка");
		ПроверитьКорректностьПризнакаОсновноеЗадание();
		ОбновитьДоступныеСтатусы();
	ИначеЕсли РезультатПроверки.ОчиститьПроектнуюЗадачу Тогда
		Объект.ПроектнаяЗадача = ПредопределенноеЗначение("Справочник.Проекты.ПустаяСсылка");
		ПроверитьКорректностьПризнакаОсновноеЗадание();
		ОбновитьДоступныеСтатусы();		
	КонецЕсли;
	
	УстановитьОтметкуНезаполненного(ЭтаФорма);
	УстановитьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

