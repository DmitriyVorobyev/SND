&НаСервере
Функция СформироватьСписокИсполнителейПоСПД(ПроектнаяЗадача, ПроектнаяПродукция)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоПроектнаяПродукцияРолиТР.Ссылка КАК Ссылка,
	               |	упоПроектнаяПродукцияРолиТР.РольТР КАК РольТР
	               |ПОМЕСТИТЬ РолиСПД
	               |ИЗ
	               |	Справочник.упоПроектнаяПродукция.РолиТР КАК упоПроектнаяПродукцияРолиТР
	               |ГДЕ
	               |	упоПроектнаяПродукцияРолиТР.Ссылка = &ПроектнаяПродукция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	Рег.Ресурс КАК Ресурс,
	               |	Рег.Подразделение КАК Подразделение,
	               |	Рег.УровеньПланирования КАК УровеньПланирования,
	               |	упоРолиТрудовыхРесурсовСрезПоследних.Ресурс КАК ТрудовойРесурс
	               |ИЗ
	               |	РегистрСведений.упоДанныеПлановТрудозатратРолей.СрезПоследних(, ПроектнаяЗадача = &ПроектнаяЗадача) КАК Рег
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоРолиТрудовыхРесурсов.СрезПоследних КАК упоРолиТрудовыхРесурсовСрезПоследних
	               |		ПО Рег.Ресурс = упоРолиТрудовыхРесурсовСрезПоследних.Роль
	               |			И (упоРолиТрудовыхРесурсовСрезПоследних.РольНазначена)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.упоВерсииПроекта КАК Версии
	               |		ПО Рег.Версия = Версии.Версия
	               |			И (Версии.Текущая),
	               |	РолиСПД КАК РолиСПД
	               |ГДЕ
	               |	(Рег.Количество <> 0
	               |			ИЛИ Рег.Стоимость <> 0
	               |			ИЛИ Рег.ВнешняяСтоимость <> 0)
	               |	И Рег.Ресурс В
	               |			(ВЫБРАТЬ
	               |				РолиСПД.РольТР КАК РольТР
	               |			ИЗ
	               |				РолиСПД КАК РолиСПД)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Рег.Ресурс";
	
	Запрос.Параметры.Вставить("ПроектнаяЗадача", ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу);
	Запрос.Параметры.Вставить("ПроектнаяПродукция", ПроектнаяПродукция);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	
		Возврат Новый Массив();		
	
	КонецЕсли; 
		
	МассивТрудовойРесурс = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ТрудовойРесурс");
	
	Возврат МассивТрудовойРесурс;

КонецФункции

&НаСервере
Процедура ОграничитьВыборПроектнойПродукции()
	
	ПроектнаяПродукцияДоступна = упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПроектнаяПродукция();
		
	Если ПроектнаяПродукцияДоступна Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОбъектБазы = Элементы.Найти("ОбъектБазы");
	
	Если ЭлементОбъектБазы = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Справочник_упоПроектнаяПродукция = ОбщегоНазначения.ОбъектМетаданныхПоПолномуИмени("Справочник.упоПроектнаяПродукция");
		
	Если Справочник_упоПроектнаяПродукция = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИсходноеОграничениеТипа = ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(Элементы, "ОбъектБазы", "ОграничениеТипа");
	
	Если ИсходноеОграничениеТипа = Неопределено Тогда
		Возврат;
	КонецЕсли;	
		
	ВычитаемыеТипы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Тип("СправочникСсылка.упоПроектнаяПродукция"));
	
	ОграничениеТипа = Новый ОписаниеТипов(ИсходноеОграничениеТипа, ,ВычитаемыеТипы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ОбъектБазы", "ОграничениеТипа", ОграничениеТипа);

КонецПроцедуры

&НаКлиенте
Процедура ОграничитьВыборТрудовыхРесурсовПоСПД()
	
	Если Не упоИнтеграцияКлиентСервер.ИспользуетсяФункционалПроектнаяПродукция() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не упоИнтеграцияКлиентСервер.ЭтоПроектнаяПродукция(Объект.ОбъектБазы) Тогда
		Возврат;
	КонецЕсли;
	
	ТрудовыеРесурсы = СформироватьСписокИсполнителейПоСПД(Объект.ПроектнаяЗадача, Объект.ОбъектБазы);
	
	ОтборРесурсов = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ТрудовыеРесурсы));
	СписокПараметровВыбора = Новый Массив;
	СписокПараметровВыбора.Добавить(ОтборРесурсов);
	
	Элементы.Исполнитель.ПараметрыВыбора = Новый ФиксированныйМассив(СписокПараметровВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьВыбораРолиПодразделения()
	
	Если ЗначениеЗаполнено(Объект.Роль) Тогда
		Элементы.Подразделение.ТолькоПросмотр = Ложь;
	Иначе
		Объект.Подразделение = Неопределено;
		Элементы.Подразделение.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсполнительПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРолей = ЯИсполнительЯАвторЯКонтролер(Объект.Ссылка, ТекущийСотрудник, Объект.ПроектнаяЗадача, Объект.Исполнитель);
	СтруктураРолей.Вставить("Статус", ТекущийСтатус);
	упоЗаданияКлиент.ОбновитьДоступныеСтатусы(ЭтаФорма, СтруктураРолей);
	УстановитьДоступностьРезультатаВыполнения(ЭтаФорма);
	Если Элементы.ГруппаРольИПодразделение.Видимость Тогда
		ЗаполнитьРольПодразделениеПоУмолчанию(Объект.Исполнитель, Объект.ПроектнаяЗадача, ДатаНачалаПлан, Объект.Роль, Объект.Подразделение);
		
		УстановитьДоступностьВыбораРолиПодразделения();
		ПодразделенияРоли = упоРесурсыИРолиВызовСервера.обПолучитьМассивПодразделенийРоли(Объект.Роль,
				?(ЗначениеЗаполнено(ДатаНачалаПлан), ДатаНачалаПлан, ОбщегоНазначенияКлиент.ДатаСеанса()));
		УстановитьПараметрыВыбораПодразделения(ПодразделенияРоли);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПодразделениеПоУмолчанию()
	
	ПодразделенияРоли = упоРесурсыИРолиВызовСервера.обПолучитьМассивПодразделенийРоли(Объект.Роль,
		?(ЗначениеЗаполнено(ДатаНачалаПлан), ДатаНачалаПлан, ОбщегоНазначенияКлиент.ДатаСеанса()));
	Если ПодразделенияРоли.Количество() Тогда
		Объект.Подразделение = ПодразделенияРоли[0];
	КонецЕсли;
	
	// Заодно установим параметры выбора подразделения.
	УстановитьПараметрыВыбораПодразделения(ПодразделенияРоли);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьРольПодразделениеПоУмолчанию(Исполнитель, ПроектнаяЗадача, Знач ДатаНачалаПлан, Роль, Подразделение)
	
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачалаПлан) Тогда
		ДатаНачалаПлан = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		РольИПодразделениеИсполнителя = упоРесурсыИРолиСервер.ПодразделениеИРольТрудовогоРесурсаНаЗаданнуюДату(Исполнитель, 
			ТекущаяДатаСеанса());
	Иначе
		РольИПодразделениеИсполнителя = упоРесурсыИРолиСервер.РольПодразделениеТрудовогоРесурсаПоЗадаче(Исполнитель,
			ПроектнаяЗадача.СсылкаНаПроектнуюЗадачу);
		Если Не ЗначениеЗаполнено(РольИПодразделениеИсполнителя.Роль) Тогда
			РольИПодразделениеИсполнителя = упоРесурсыИРолиСервер.ПодразделениеИРольТрудовогоРесурсаНаЗаданнуюДату(Исполнитель,
				ДатаНачалаПлан);
		КонецЕсли;
	КонецЕсли;
	
	Роль = РольИПодразделениеИсполнителя.Роль;
	Подразделение = РольИПодразделениеИсполнителя.Подразделение;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыВыбораПодразделения(ПодразделенияРоли)

	СписокВыбора = Новый ФиксированныйМассив(ПодразделенияРоли);
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Ссылка", СписокВыбора);
	
	СписокПараметровВыбора = Новый Массив;
	СписокПараметровВыбора.Добавить(ПараметрВыбора);
	
	Элементы.Подразделение.ПараметрыВыбора = Новый ФиксированныйМассив(СписокПараметровВыбора);

КонецПроцедуры

&НаСервере
Процедура СформироватьСписокВыбораВидыЗаданий()
	
	ИспользоватьНормированиеИПроектныеРешения = ПолучитьФункциональнуюОпцию("упоИспользоватьНормированиеИПроектныеРешения");
	
	СписокВыбора = ЭтаФорма.Элементы.ВидЗадания.СписокВыбора; 
		
	СписокВыбора.Очистить();
	
	СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Обсуждение"));
	СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Поручение"));
	Если ИспользоватьНормированиеИПроектныеРешения Тогда
		СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.упоВидыЗаданий.ПроектноеРешение"));
	КонецЕсли;
	СписокВыбора.Добавить(ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование"));

КонецПроцедуры

