&НаСервереБезКонтекста
Функция ПроверитьСоответствиеПроектнойЗадачиПроекту(Проект, ПроектнаяЗадача)
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("ОчиститьПроект", ЗначениеЗаполнено(Проект) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проект, "ЭтоПроектнаяЗадача"));
	РезультатПроверки.Вставить("ОчиститьПроектнуюЗадачу", НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача, "упоКорневойПроект") = Проект);
	
	Возврат РезультатПроверки;

КонецФункции

&НаСервере
Процедура СоздатьПодчиненныеСогласования()

	ПодчиненныеСписокИсполнителей = Новый СписокЗначений;
	
	Если Объект.ВидСогласования = ПредопределенноеЗначение("Перечисление.упоВидыСогласований.Параллельное") Тогда
		// Создаем подчиненные согласования для всех
		ПодчиненныеСписокИсполнителей.ЗагрузитьЗначения(Объект.СогласующиеЛица.Выгрузить().ВыгрузитьКолонку("СогласующееЛицо"));
		
	ИначеЕсли Объект.ВидСогласования = ПредопределенноеЗначение("Перечисление.упоВидыСогласований.Последовательное") Тогда  
		// Создаем подчиненные согласования для следующего согласующего
		Для Каждого СтрокаСогласующееЛицо Из Объект.СогласующиеЛица Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаСогласующееЛицо.Статус) Тогда
				ПодчиненныеСписокИсполнителей.Добавить(СтрокаСогласующееЛицо.СогласующееЛицо);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СоздатьКопированиемТекущегоНаСервере(ПодчиненныеСписокИсполнителей);
 
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФорму()
	
	СписокСтатусовСПредупреждением.ЗагрузитьЗначения(упоЗаданияСервер.ПолучитьМассивСтатусовСПредупреждением());
	
	// Таблица доступных статусов
	ТЗДоступныеСтатусы = упоЗаданияСервер.ДобавитьКнопкиИзмененияСтатуса(ЭтаФорма, Истина);	
	ЗначениеВРеквизитФормы(ТЗДоступныеСтатусы, "ТаблицаДоступныеСтатусы");
	
	// Статус задания и заголовок
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ТекущийСтатус = упоЗаданияСервер.ПолучитьСтатусЗадания(Объект.Ссылка);
		Заголовок = СформироватьЗаголовок(Объект.ВидЗадания, Ложь, Объект.Наименование, ТекущийСтатус);
	Иначе
		Заголовок = СформироватьЗаголовок(Объект.ВидЗадания, Истина);
	КонецЕсли;
	
	// Текущий сотрудник
	ТекущийСотрудник = ПараметрыСеанса.упоТекущийСотрудник;
	
	Если Не ЗначениеЗаполнено(ТекущийСотрудник) Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить текущего сотрудника!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	// Сроки
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		СтруктураСроки = упоЗаданияСервер.ПолучитьСрокиЗадания(Объект.Ссылка);
		Если СтруктураСроки <> Неопределено Тогда
			ДатаНачалаПлан = СтруктураСроки.ДатаНачалаПлан;
			ДатаОкончанияПлан = СтруктураСроки.ДатаОкончанияПлан;
			ДатаНачалаФакт = СтруктураСроки.ДатаНачалаФакт;
			ДатаОкончанияФакт = СтруктураСроки.ДатаОкончанияФакт;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		
		СтруктураСроки = упоЗаданияСервер.ПолучитьСрокиЗадания(Параметры.ЗначениеКопирования);
		ДатаНачалаПлан = СтруктураСроки.ДатаНачалаПлан;
		ДатаОкончанияПлан = СтруктураСроки.ДатаОкончанияПлан;
		
	ИначеЕсли ЗначениеЗаполнено(Объект.ПроектнаяЗадача) Тогда
		
		УстановитьСрокиПоПроектнойЗадаче();
		
	КонецЕсли;
	
	// Флаг "ЭтоСогласованиеРодитель"
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) 
		И Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование") Тогда
		
		Объект.ЭтоСогласованиеРодитель = Истина;
		
	КонецЕсли;
	
	// Роли
	СтруктураРолей = ЯИсполнительЯАвторЯКонтролер(Объект.Ссылка, 
		ТекущийСотрудник, 
		Объект.ПроектнаяЗадача, 
		Объект.Исполнитель);
	СтруктураРолей.Вставить("Статус", ТекущийСтатус);
	СтруктураРолей.Вставить("ВидЗадания", Объект.ВидЗадания);
	
	// Согласующие лица
	СогласующийРуководитель = Неопределено;
	Если Параметры.ЗначенияЗаполнения.Свойство("СогласующийРуководитель", СогласующийРуководитель) 
		И ЗначениеЗаполнено(СогласующийРуководитель) Тогда
		
		СтрокаСогласующий = Объект.СогласующиеЛица.Добавить();
		СтрокаСогласующий.СогласующееЛицо = СогласующийРуководитель;
		
	КонецЕсли;
	
	// Ограничение типа объекта
	ИспользуемыеТипы = упоФункцииОбщегоНазначенияСервер.ТипыМетаданных_УбратьНеиспользуемые();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, 
		"ОбъектБазы", "ОграничениеТипа", Новый ОписаниеТипов(ИспользуемыеТипы));

	СформироватьСписокВыбораВидыЗаданий();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтметкуНезаполненного(Форма)

	Если Форма.Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Обсуждение") Тогда
		Форма.Элементы.Проект.АвтоОтметкаНезаполненного = Истина;
		Форма.Элементы.Проект.ОтметкаНезаполненного = Истина;
		НужноУказатьЗадачу = упоЗаданияСерверПовтИсп.ПроверитьОбязательностьУказанияПроектнойЗадачиВОбсуждении(Форма.Объект.Проект); 
		Форма.Элементы.ПроектнаяЗадача.АвтоОтметкаНезаполненного = НужноУказатьЗадачу;
		Форма.Элементы.ПроектнаяЗадача.ОтметкаНезаполненного = НужноУказатьЗадачу;
	Иначе
		Форма.Элементы.Проект.АвтоОтметкаНезаполненного = Ложь;
		Форма.Элементы.Проект.ОтметкаНезаполненного = Ложь;
		Форма.Элементы.ПроектнаяЗадача.АвтоОтметкаНезаполненного = Ложь;
		Форма.Элементы.ПроектнаяЗадача.ОтметкаНезаполненного = Ложь;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Функция УстановитьСрокиПоПроектнойЗадаче()
	
	СсылкаНаПроектнуюЗадачу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПроектнаяЗадача, "СсылкаНаПроектнуюЗадачу");
	СтруктураСроки = Документы.упоПроектнаяЗадача.ПолучитьСроки(СсылкаНаПроектнуюЗадачу);
	Если СтруктураСроки <> Неопределено Тогда
		ДатаНачалаПлан = СтруктураСроки.ДатаНачала;
		ДатаОкончанияПлан = СтруктураСроки.ДатаЗавершения;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗаголовокСтраницыПодчиненныхОтложенно() 
	
	ПодключитьОбработчикОжидания("УстановитьЗаголовокСтраницыПодчиненныхКлиент", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокСтраницыПодчиненныхКлиент() 
	
	УстановитьЗаголовокСтраницыПодчиненных(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокСтраницыПодчиненных(ЭтаФорма)
	
	ЭтаФорма.ИдетУстановкаЗаголовкаСтраницыПодчиненных = Истина;
	
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.Ссылка) Тогда
		КоличествоПодчиненных = ПолучитьКоличествоПодчиненных(ЭтаФорма.Объект.Ссылка);
	Иначе
		КоличествоПодчиненных = 0;
	КонецЕсли;
	
	НовыйЗаголовок = НСтр("ru = 'Подчиненные задания'");
	Если КоличествоПодчиненных <> 0 Тогда
		НовыйЗаголовок = НовыйЗаголовок + " (" + Формат(КоличествоПодчиненных, "ЧДЦ=; ЧН=; ЧГ=") + ")";
	КонецЕсли;
	
	Если ЭтаФорма.Элементы.СтраницаПодчиненныеЗадания.Заголовок <> НовыйЗаголовок Тогда
		ЭтаФорма.Элементы.СтраницаПодчиненныеЗадания.Заголовок = НовыйЗаголовок; 
	КонецЕсли;
	
	ИдетУстановкаЗаголовкаСтраницыПодчиненных = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоПодчиненных(Ссылка) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ упоЗадания.Ссылка) КАК Количество
	               |ИЗ
	               |	Справочник.упоЗадания КАК упоЗадания
	               |ГДЕ
	               |	НЕ упоЗадания.ПометкаУдаления
	               |	И упоЗадания.Родитель = &Родитель";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат 0;
	Иначе
		Возврат РезультатЗапроса.Выгрузить()[0].Количество;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ЭтоЗаданиеИсполнителяПроектнойЗадачиПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт 
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи = Ложь;
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов(ЭтаФорма);
	Если Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи Тогда
		УстановитьСрокиПоПроектнойЗадаче();
		Если Объект.ЗавершеноЗакрытоВручную Тогда
			Объект.ЗавершеноЗакрытоВручную = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

