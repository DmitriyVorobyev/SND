&НаКлиенте
Процедура СменитьСтатусЗадания(НовыйСтатус, ЗакрытьПослеСменыСтатуса)
		
	ДополнительныеПараметры = Новый Структура("НовыйСтатус, ЗакрытьПослеСменыСтатуса", НовыйСтатус, ЗакрытьПослеСменыСтатуса);
	ОписаниеОповещения = Новый ОписаниеОповещения("СменитьСтатусЗаданияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если СписокСтатусовСПредупреждением.НайтиПоЗначению(НовыйСтатус) <> Неопределено Тогда	
		ТекстВопроса = НСтр("ru = 'Статус задания будет изменен на ""%1"". Продолжить?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, НовыйСтатус);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура СменитьСтатусЗаданияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи 
		И (ДополнительныеПараметры.НовыйСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Закрыто")
		   Или ДополнительныеПараметры.НовыйСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Завершено")) Тогда
		   
		Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи = Ложь;
		Объект.ЗавершеноЗакрытоВручную = Истина;
		Модифицированность = Истина;
		
	ИначеЕсли Не Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи И Объект.ЗавершеноЗакрытоВручную
		И (ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Завершено") 
		   И ДополнительныеПараметры.НовыйСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Выполняется") 
			Или ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Закрыто") 
				И ДополнительныеПараметры.НовыйСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Выдано")) Тогда
		
		Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи = Истина;
		Объект.ЗавершеноЗакрытоВручную = Ложь;
		Модифицированность = Истина;		
		
	КонецЕсли;
		
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	КомментарийЗадания = СтрЗаменить(ПолеКомментария, Символы.ПС, "<br>");
	ПолеКомментария = "";
	
	Успешно = упоЗаданияСервер.УстановитьСтатусЗадания(Объект.Ссылка, ДополнительныеПараметры.НовыйСтатус, КомментарийЗадания,, Ложь);
	
	клОбновитьОписание();
	
	Если Успешно Тогда
		ПараметрыОповещения = Новый Структура ("Проект, ЭтоЗаданиеПодразделению,Статус, Закрытие, Задание", 
		                            Объект.Проект,
									Объект.ЭтоЗаданиеПодразделению,
									ДополнительныеПараметры.НовыйСтатус,
									ДополнительныеПараметры.ЗакрытьПослеСменыСтатуса,
									Объект.Ссылка);
		Оповестить("Задания_СтатусЗаданияИзменен", ПараметрыОповещения, ЭтаФорма); 
							
		Если ДополнительныеПараметры.ЗакрытьПослеСменыСтатуса Тогда							
			Закрыть();
		КонецЕсли;
		
	КонецЕсли;	
	    
КонецПроцедуры

