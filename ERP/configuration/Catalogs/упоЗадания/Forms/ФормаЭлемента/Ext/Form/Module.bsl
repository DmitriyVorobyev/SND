#Область ОписаниеПеременных

&НаКлиенте
Перем РежимРедактирования;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьФорму();
	
	УстановитьДоступностьЭлементов(ЭтаФорма);
	
	ИзменитьОтображениеЭлементовПоВидуЗадания(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();  
	ПараметрыРазмещения.КоманднаяПанель = Элементы.КоманднаяПанельФормы;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("ИмяЭлементаКоманднойПанели", "КоманднаяПанельФормы");
	ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	УстановитьОтборВДинамическомСписке();
	
	упоИнтеграция.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	упоОбработчикиСобытийСервер.ФормаПриСозданииНаСервере(ЭтаФорма, Объект, Отказ, СтандартнаяОбработка);	
		
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КоманднаяПанельФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
	Если Не Параметры.Свойство("АвтоТест") Тогда
		ОбрабатыватьНовыйКакЗаписанный = Параметры.Свойство("ЗапретРедактированияРеквизитов_НовыйКакЗаписанный") 
			И Параметры.ЗапретРедактированияРеквизитов_НовыйКакЗаписанный;
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект, 
			Элементы.КоманднаяПанельФормы, , Объект, ОбрабатыватьНовыйКакЗаписанный);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
	КонецЕсли;
	
	ОграничитьВыборПроектнойПродукции();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоЗаданияКлиент.ОбновитьДоступныеСтатусы(ЭтаФорма, СтруктураРолей);
	
	Если УстановитьМодифицированность Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
	УстановитьЗаголовокСтраницыПодчиненныхОтложенно();
	
	ОграничитьВыборТрудовыхРесурсовПоСПД();
	
	УстановитьДоступностьВыбораРолиПодразделения();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.ПустаяСсылка") Тогда
		Оповестить("ЗаписьНовогоЗадания", , Объект.Ссылка);
	КонецЕсли;
	Если ПараметрыЗаписи.Свойство("НовыеСогласующиеЛица") Тогда
		СписокСогласующиеЛица = Новый СписокЗначений;
		СписокСогласующиеЛица.ЗагрузитьЗначения(ПараметрыЗаписи.НовыеСогласующиеЛица);
		Оповестить("ЗаписьЗадания_НовыеСогласующиеЛица", Новый Структура("СогласующиеЛица", СписокСогласующиеЛица), Объект.Ссылка);
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("ЭтоЗаданиеПодразделению, Проект, Исполнитель", 
		Объект.ЭтоЗаданиеПодразделению, Объект.Проект, Объект.Исполнитель);
	Оповестить("ЗаписьЗадания", ПараметрыОповещения, Объект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	Элементы.ПодчиненныеЗадания.Обновить();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПолеИстории = ПолучитьОписание(Объект.Ссылка);
	КонецЕсли;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПроверитьКорректностьПризнакаОсновноеЗадание();
	
	упоОбработчикиСобытийКлиент.ФормаПередЗаписью(ЭтаФорма, Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("НовыеСогласующиеЛица") Тогда
		ПараметрыЗаписи.Вставить("НовыеСогласующиеЛица", ТекущийОбъект.ДополнительныеСвойства.НовыеСогласующиеЛица);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
		
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийКлиент.ФормаОбработкаОповещения(ЭтаФорма, Объект, ИмяСобытия, Параметр, Источник);
	
	ЭтоОткрытоеЗадание = Источник = Объект.Ссылка;
	
	Если ИмяСобытия = "Задания_СтатусЗаданияИзменен" Тогда
				
		Если НЕ Параметр.Закрытие И Параметр.Задание = Объект.Ссылка Тогда
		
			ЭтотОбъект.ТекущийСтатус = Параметр.Статус;
			ОбновитьДоступныеСтатусы();
			СтруктураСрокиФакт = упоЗаданияСервер.ПолучитьФактическиеСрокиЗадания(Объект.Ссылка);
			ДатаНачалаФакт = СтруктураСрокиФакт.ДатаНачалаФакт;
			ДатаОкончанияФакт = СтруктураСрокиФакт.ДатаОкончанияФакт;
			
			УстановитьДоступностьЭлементов(ЭтаФорма);
			
			УстановитьЗаголовокСтраницыПодчиненныхОтложенно();
			Элементы.ПодчиненныеЗадания.Обновить();
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзменениеТекущегоСотрудника" Тогда
		
		ТекущийСотрудник = ПолучитьТекущегоСотрудника();
		ОбновитьДоступныеСтатусы(); 
		
	ИначеЕсли ИмяСобытия = "ЗаписьНовогоЗадания" Тогда
		
		Если ЭтоОткрытоеЗадание Тогда
			
			Если Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Обсуждение") Тогда
				ЭтотОбъект.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Открыто");
			ИначеЕсли Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование") Тогда	
				ЭтотОбъект.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.НаСогласовании");
				СоздатьПодчиненныеСогласования();
			Иначе
				ЭтотОбъект.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Выдано");
			КонецЕсли;
			упоЗаданияСервер.ЗаписатьВРегистрСтатусЗадания(Объект.Ссылка, ТекущийСтатус);
			
			//ТекущийСтатус = упоЗаданияСервер.ПолучитьСтатусЗадания(Объект.Ссылка);
			ОбновитьДоступныеСтатусы();
			клОбновитьОписание();
			
		КонецЕсли;
		
		УстановитьЗаголовокСтраницыПодчиненныхОтложенно();
		
	ИначеЕсли ИмяСобытия = "ЗаписьЗадания_НовыеСогласующиеЛица" Тогда
		
		Если ЭтоОткрытоеЗадание Тогда
			СоздатьКопированиемТекущегоНаСервере(Параметр.СогласующиеЛица);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоОткрытоеЗадание Тогда
		Заголовок = СформироватьЗаголовок(Объект.ВидЗадания, Ложь, Объект.Наименование, ЭтотОбъект.ТекущийСтатус);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
	упоОбработчикиСобытийСервер.ФормаОбработкаПроверкиЗаполненияНаСервере(ЭтаФорма, Объект, Отказ, ПроверяемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Если ВыбранноеЗначение.Свойство("СписокИсполнителей") Тогда
			СоздатьКопированиемТекущегоНаСервере(ВыбранноеЗначение.СписокИсполнителей);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект, Элементы.КоманднаяПанельФормы);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитов
	
	упоЗаданияСервер.ДобавитьИзменитьЗаписьВРегистреСрокиЗаданий(Объект.Ссылка, ДатаНачалаПлан, ДатаОкончанияПлан);
	
	УстановитьОтборВДинамическомСписке();
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтоЗаданиеИсполнителяПроектнойЗадачиПриИзменении(Элемент)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЭтоЗаданиеИсполнителяПроектнойЗадачиПриИзмененииЗавершение",
		ЭтотОбъект);
	
	Если Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи Тогда	
		ТекстВопроса = НСтр("ru = 'При ручной установке опции проверьте, что исполнитель задания входит в число трудовых '")
			+ НСтр("ru = 'ресурсов связанной проектной задачи, иначе при изменениях в этой задаче задание будет отменено. '")
			+ НСтр("ru = 'Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, КодВозвратаДиалога.Да);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СкрытьИсторию(Команда)
	
	КнопкаСкрытьИсторию = ЭтаФорма.Элементы.СкрытьИсторию;
	КнопкаСкрытьИсторию.Пометка = НЕ КнопкаСкрытьИсторию.Пометка;
		
	Элемент = ЭтаФорма.Элементы.ИсторияСобытий;
	Элемент.Видимость = Не Элемент.Видимость;

КонецПроцедуры

&НаКлиенте
Процедура ЭтоОсновноеЗаданиеПроектнойЗадачиПриИзменении(Элемент)
	
	ПроверитьКорректностьПризнакаОсновноеЗадание();
	ИзменитьОтображениеЭлементовПоВидуЗадания(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКорректностьПризнакаОсновноеЗадание() 
	
	Если ЗначениеЗаполнено(Объект.ПроектнаяЗадача) ИЛИ НЕ Объект.ЭтоОсновноеЗаданиеПроектнойЗадачи Тогда
		Возврат;
	КонецЕсли;
	
	СообщениеТекст = НСтр("ru = 'Нельзя установить признак ""Основное"" на задание без указания проектной задачи.'");
	ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст);
	Объект.ЭтоОсновноеЗаданиеПроектнойЗадачи = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПолеКомментарияПриИзменении(Элемент)
	
	РежимРедактирования = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеКомментарияАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	РежимРедактирования = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненныеЗаданияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	СсылкаПустая = НЕ ЗначениеЗаполнено(Объект.Ссылка);
	ДополнительныеПараметры = Новый Структура("СсылкаПустая",СсылкаПустая);
	
	Если СсылкаПустая Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодчиненныеЗаданияПередНачаломДобавленияЗавершение",ЭтотОбъект,ДополнительныеПараметры);
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Текст = "ru = ""Создание подчиненных заданий возможно только после записи текущего задания. Записать?""";
		ПоказатьВопрос(ОписаниеОповещения,НСтр(Текст), Режим, 0);
		Возврат;
				
	КонецЕсли;
	
	ПодчиненныеЗаданияПередНачаломДобавленияЗавершение(Неопределено,ДополнительныеПараметры)
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненныеЗаданияПередНачаломДобавленияЗавершение(Ответ,ДополнительныеПараметры)  Экспорт
	
	Если ДополнительныеПараметры.СсылкаПустая Тогда    		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли; 		
		Записать(); 		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;

	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("АвторСотрудник", 		ТекущийСотрудник);
	ЗначенияЗаполнения.Вставить("Родитель", 			Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("ДатаНачалаПлан", 		ДатаНачалаПлан);
	ЗначенияЗаполнения.Вставить("ДатаОкончанияПлан", 	ДатаОкончанияПлан);
	ЗначенияЗаполнения.Вставить("Основание", 			Объект.Ссылка); 

	ПараметрыФормы.Вставить("Основание", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.упоЗадания.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектнаяЗадачаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Проект) Тогда
		СтандартнаяОбработка = Ложь;	
		ОткрытьФорму("Обработка.упоВыборПроектнойЗадачи.Форма.ОсновнаяФормаУправляемая",
			Новый Структура("Проект, ВозвращатьСсылкуНаЗеркальныйПроект", Объект.Проект, Истина), Элемент);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВидЗаданияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Заголовок = СформироватьЗаголовок(Объект.ВидЗадания, Ложь, Объект.Наименование, ТекущийСтатус);
	Иначе
		Заголовок = СформироватьЗаголовок(Объект.ВидЗадания, Истина);
	КонецЕсли;
	
	Если Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование") Тогда 		
		Объект.ЭтоСогласованиеРодитель = Истина;
		Объект.ВидСогласования = ПредопределенноеЗначение("Перечисление.упоВидыСогласований.Параллельное");
	Иначе
		Объект.ЭтоСогласованиеРодитель = Ложь;
		Объект.ВидСогласования = ПредопределенноеЗначение("Перечисление.упоВидыСогласований.ПустаяСсылка");
	КонецЕсли;
	
	ИзменитьОтображениеЭлементовПоВидуЗадания(ЭтаФорма);
	Если Не Элементы.ГруппаРольИПодразделение.Видимость Тогда
		Объект.Роль = Неопределено;
		Объект.Подразделение = Неопределено;
	КонецЕсли;
	
	ОбновитьДоступныеСтатусы();
	УстановитьДоступностьЭлементов(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗадание(Команда)
	
	текущееЗадание = Элементы.ПодчиненныеЗадания.ТекущиеДанные;	
	Если текущееЗадание <> Неопределено Тогда 
		ОткрытьФорму("Справочник.упоЗадания.ФормаОбъекта", Новый Структура("Ключ", текущееЗадание.Ссылка)); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Комментировать(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Объект не записан!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Если ПолеКомментария = "" Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Введите комментарий!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	КомментарийЗадания = СтрЗаменить(ПолеКомментария, Символы.ПС, "<br>");
	ПолеКомментария = "";

	упоЗаданияСервер.ЗаписатьКомментарийЗадания(Объект.Ссылка, КомментарийЗадания);
	
	клОбновитьОписание();
			
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКопированиемТекущего(Команда)
	
	СсылкаПустая = НЕ ЗначениеЗаполнено(Объект.Ссылка); 
	ДополнительныеПараметры = Новый Структура("СсылкаПустая", СсылкаПустая);
	
	Если СсылкаПустая Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьКопированиемТекущегоЗавершение", 
														ЭтотОбъект, ДополнительныеПараметры);
		
		Режим = РежимДиалогаВопрос.ДаНет;
		Текст = НСтр("ru = ""Создание подчиненных заданий возможно только после записи текущего задания. Записать?""");
		
		ПоказатьВопрос(ОписаниеОповещения, Текст, Режим, 0);
		Возврат;
				
	КонецЕсли;
	
	СоздатьКопированиемТекущегоЗавершение(Неопределено, ДополнительныеПараметры);
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКопированиемТекущегоЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.СсылкаПустая Тогда
		
		Если Ответ = КодВозвратаДиалога.Нет Тогда
		    Возврат;
		КонецЕсли; 
		
		Записать();
		
	КонецЕсли;
	
	ОткрытьФорму("Справочник.упоЗадания.Форма.ФормаИсполнители", , ЭтаФорма);
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатус(Команда)
	
	НовыйСтатусЗадания = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий." + Команда.Имя);
	ОбработатьКомандуИзмененияСтатуса(НовыйСтатусЗадания, Ложь);
		
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатусИЗакрыть(Команда)
	
	НовыйСтатусЗадания = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий." + СтрЗаменить(Команда.Имя, "ИЗакрыть", ""));
	ОбработатьКомандуИзмененияСтатуса(НовыйСтатусЗадания, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуИзмененияСтатуса(НовыйСтатусЗадания, ЗакрытьПослеСменыСтатуса) 
	
	Если Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи 
		И НовыйСтатусЗадания = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Отменено") Тогда
		Сообщение = 
			НСтр("ru = 'Текущее Задание не может быть отменено, так как синхронизируется с Задачей (реквизит ""Синхронизировать с задачей"").'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Сообщение);
		Возврат;
	КонецЕсли;
	СменитьСтатусЗадания(НовыйСтатусЗадания, ЗакрытьПослеСменыСтатуса);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненныеЗаданияПриАктивизацииСтроки(Элемент)
	
	Если ИдетУстановкаЗаголовкаСтраницыПодчиненных Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗаголовокСтраницыПодчиненныхОтложенно();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчиненныеЗаданияПриИзменении(Элемент)
	
	УстановитьЗаголовокСтраницыПодчиненныхОтложенно();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьОтображениеЭлементовПоВидуЗадания(Форма)
	
	Форма.Элементы.РешениеОПереходеВСледующуюФазу.Видимость = Ложь;
	
	Если Форма.Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Поручение") Тогда
		Форма.Элементы.СтраницаОписание.Заголовок = "Описание и сроки";
		Форма.Элементы.СтраницаКонтролеры.Видимость = Истина;
		Форма.Элементы.ЭтоОсновноеЗаданиеПроектнойЗадачи.Видимость = Истина;
		Форма.Элементы.Декорация5.Видимость = Ложь;
		Форма.Элементы.ОписаниеРезультата.Заголовок = "Результат выполнения";
		Форма.Элементы.ГруппаСрокиПлан.Видимость = Истина;
		Форма.Элементы.ГруппаСрокиПрогноз.Видимость = Истина;
		Форма.Элементы.ГруппаСрокиФакт.Видимость = Истина;
		Форма.Элементы.СтраницаСогласующие.Видимость = Ложь;
		Форма.Элементы.Исполнитель.Видимость = Истина;
		Форма.Элементы.ВидСогласования.Видимость = Ложь;
		Форма.Элементы.ЭтоЗаданиеПодразделению.Видимость = Истина;
		Форма.Элементы.ГруппаРольИПодразделение.Видимость = Истина;
		
	ИначеЕсли Форма.Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Обсуждение") Тогда
		Форма.Элементы.СтраницаОписание.Заголовок = "Тема";
		Форма.Элементы.ОписаниеРезультата.Заголовок = "Итог";
		Форма.Элементы.ЭтоОсновноеЗаданиеПроектнойЗадачи.Видимость = Ложь;
		Форма.Элементы.Декорация5.Видимость = Истина;
		Форма.Элементы.СтраницаКонтролеры.Видимость = Ложь;
		Форма.Элементы.ГруппаСрокиПлан.Видимость = Ложь;
		Форма.Элементы.ГруппаСрокиПрогноз.Видимость = Ложь;
		Форма.Элементы.ГруппаСрокиФакт.Видимость = Ложь;
		Форма.Элементы.СтраницаСогласующие.Видимость = Ложь;
		Форма.Элементы.Исполнитель.Видимость = Истина;
		Форма.Элементы.ВидСогласования.Видимость = Ложь;
	    Форма.Элементы.ЭтоЗаданиеПодразделению.Видимость = Ложь;		
		Форма.Объект.ЭтоЗаданиеПодразделению = Ложь;
		Форма.Элементы.ГруппаРольИПодразделение.Видимость = Ложь;
		
	ИначеЕсли Форма.Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.ПроектноеРешение") Тогда
		Форма.Элементы.СтраницаОписание.Заголовок = "Описание и сроки";
		Форма.Элементы.СтраницаКонтролеры.Видимость = Истина;
		Форма.Элементы.ЭтоОсновноеЗаданиеПроектнойЗадачи.Видимость = Истина;
		Форма.Элементы.Декорация5.Видимость = Истина;
		Форма.Элементы.ОписаниеРезультата.Заголовок = "Проектное решение";
		Форма.Элементы.ГруппаСрокиПлан.Видимость = Истина;
		Форма.Элементы.ГруппаСрокиПрогноз.Видимость = Истина;
		Форма.Элементы.ГруппаСрокиФакт.Видимость = Истина;
		Форма.Элементы.СтраницаСогласующие.Видимость = Ложь;
		Форма.Элементы.Исполнитель.Видимость = Истина;
		Форма.Элементы.ВидСогласования.Видимость = Ложь;
		Форма.Элементы.ЭтоЗаданиеПодразделению.Видимость = Ложь;
		Форма.Объект.ЭтоЗаданиеПодразделению = Ложь;
		Форма.Элементы.ГруппаРольИПодразделение.Видимость = Ложь;
		
		Если Форма.Объект.ЭтоОсновноеЗаданиеПроектнойЗадачи Тогда
			Форма.Элементы.РешениеОПереходеВСледующуюФазу.Видимость = Истина;
		КонецЕсли;
		
	ИначеЕсли Форма.Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Согласование") Тогда
		Форма.Элементы.СтраницаОписание.Заголовок = "Описание и сроки";
		Форма.Элементы.СтраницаКонтролеры.Видимость = Истина;
		Форма.Элементы.ЭтоОсновноеЗаданиеПроектнойЗадачи.Видимость = Истина;
		Форма.Элементы.Декорация5.Видимость = Ложь;
		Форма.Элементы.ОписаниеРезультата.Заголовок = "Результат выполнения";
		Форма.Элементы.ГруппаСрокиПлан.Видимость = Истина;
		Форма.Элементы.ГруппаСрокиПрогноз.Видимость = Истина;
		Форма.Элементы.ГруппаСрокиФакт.Видимость = Истина;
		Если Форма.Объект.ЭтоСогласованиеРодитель Тогда
			Форма.Элементы.СтраницаСогласующие.Видимость = Истина;
			Форма.Элементы.Исполнитель.Видимость = Ложь; 
			Форма.Элементы.ВидСогласования.Видимость = Истина;
		Иначе
			Форма.Элементы.СтраницаСогласующие.Видимость = Ложь;
			Форма.Элементы.Исполнитель.Видимость = Истина; 
			Форма.Элементы.ВидСогласования.Видимость = Ложь;
		КонецЕсли;	
		Форма.Элементы.ЭтоЗаданиеПодразделению.Видимость = Ложь;
		Форма.Объект.ЭтоЗаданиеПодразделению = Ложь;
		Форма.Элементы.ГруппаРольИПодразделение.Видимость = Истина;
		
	КонецЕсли; 	
	
	Форма.Элементы.ВидЗаданияПодразделению.Видимость = Форма.Элементы.ЭтоЗаданиеПодразделению.Видимость;
	Форма.Элементы.ВидЗаданияПодразделению.Доступность = Форма.Объект.ЭтоЗаданиеПодразделению;
	
	УстановитьОтметкуНезаполненного(Форма);
	
КонецПроцедуры

&НаСервере
Функция УстановитьОтборВДинамическомСписке()
	
	Если Объект.Ссылка.Пустая() Тогда
		ПодчиненныеЗадания.Параметры.УстановитьЗначениеПараметра("Родитель", Неопределено);
	Иначе
		// Используем однократную установку отбора.
		Если Не ОтборДинамическогоСпискаУстановлен Тогда
			ПодчиненныеЗадания.Параметры.УстановитьЗначениеПараметра("Родитель", Объект.Ссылка);
			ОтборДинамическогоСпискаУстановлен = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

