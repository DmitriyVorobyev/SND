&НаСервере
Процедура СоздатьКопированиемТекущегоНаСервере(Знач ПодчиненныеСписокИсполнителей)
	
	ЗаданиеОбъект = РеквизитФормыВЗначение("Объект");
	
	СтруктураРеквизитов = Новый Структура();
	СтруктураРеквизитов.Вставить("ДатаНачалаПлан", ДатаНачалаПлан);
	СтруктураРеквизитов.Вставить("ДатаОкончанияПлан", ДатаОкончанияПлан);

	упоЗаданияСервер.СоздатьПодчиненныеЗаданияКопированиемТекущего(ЗаданиеОбъект, СтруктураРеквизитов, ПодчиненныеСписокИсполнителей);	
	
	Элементы.ПодчиненныеЗадания.Обновить();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементов(Форма)
	
	Если НЕ ЗначениеЗаполнено(Форма.Объект.Родитель) Тогда 
		Форма.Элементы.Родитель.Видимость = Ложь; 
	КонецЕсли;
	
	Если Форма.ТекущийСтатус = ПредопределенноеЗначение("Перечисление.упоСтатусыЗаданий.Закрыто") Тогда
		Форма.ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ Форма.СтруктураРолей.ЯАвтор Тогда
		Форма.Элементы.Группа6.ТолькоПросмотр = Истина;
		Форма.Элементы.Группа5.ТолькоПросмотр = Истина;
		Форма.Элементы.ОписаниеЗадания.ТолькоПросмотр = Истина;
		Форма.Элементы.ГруппаСрокиПлан.ТолькоПросмотр = Истина;
		Форма.Элементы.СтраницаКонтролеры.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	УстановитьДоступностьРезультатаВыполнения(Форма);
	
	ВидимостьЭтоЗаданиеИсполнителяПроектнойЗадачи = Ложь;
	Если Форма.Объект.ВидЗадания = ПредопределенноеЗначение("Справочник.упоВидыЗаданий.Поручение") Тогда
		ВидимостьЭтоЗаданиеИсполнителяПроектнойЗадачи = ЗначениеЗаполнено(Форма.Объект.ПроектнаяЗадача);
	КонецЕсли;
	Форма.Элементы.ЭтоЗаданиеИсполнителяПроектнойЗадачи.Видимость = ВидимостьЭтоЗаданиеИсполнителяПроектнойЗадачи;
	Форма.Элементы.ЭтоЗаданиеИсполнителяПроектнойЗадачи.Доступность = 
		ВидимостьЭтоЗаданиеИсполнителяПроектнойЗадачи И НЕ(Форма.Объект.ЭтоЗаданиеПодразделению);
		
	Если Форма.Элементы.ЭтоЗаданиеИсполнителяПроектнойЗадачи.Видимость И Форма.Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи Тогда
		Форма.Элементы.ГруппаСрокиПланДаты.ТолькоПросмотр = Истина;
	Иначе
		Форма.Элементы.ГруппаСрокиПланДаты.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРезультатаВыполнения(Форма)
	
	Форма.Элементы.ГруппаРезультатВыполнения.ТолькоПросмотр = НЕ Форма.СтруктураРолей.ЯИсполнитель;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроектнаяЗадачаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.Проект) ИЛИ НЕ ЗначениеЗаполнено(Объект.ПортфельПроекта) Тогда
		СтруктураСвойств = ПолучитьПроектИПортфельПроектнойЗадачи(Объект.ПроектнаяЗадача);
		Если СтруктураСвойств <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(Объект.Проект) Тогда
				Объект.Проект = СтруктураСвойств.Проект;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Объект.ПортфельПроекта) Тогда 
				Объект.ПортфельПроекта = СтруктураСвойств.ПортфельПроекта;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьДоступныеСтатусы();
	УстановитьДоступностьЭлементов(ЭтаФорма);
	Если Объект.ЭтоЗаданиеИсполнителяПроектнойЗадачи Тогда
		УстановитьСрокиПоПроектнойЗадаче();
	КонецЕсли;
	
	ПроверитьКорректностьПризнакаОсновноеЗадание();
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроектИПортфельПроектнойЗадачи(ПроектнаяЗадача)
	
	Перем СтруктураСвойств;
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Проекты.упоКорневойПроект КАК Проект,
	               |	Проекты.упоКорневойПроект.ПортфельПроектов КАК ПортфельПроекта
	               |ИЗ
	               |	Справочник.Проекты КАК Проекты
	               |ГДЕ
	               |	Проекты.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПроектнаяЗадача);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураСвойств = Новый Структура;
		СтруктураСвойств.Вставить("Проект", Выборка.Проект);
		СтруктураСвойств.Вставить("ПортфельПроекта", Выборка.ПортфельПроекта);
	КонецЕсли;
	
	Возврат СтруктураСвойств;
	
КонецФункции

