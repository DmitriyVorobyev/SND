Функция НайтиДокументыупоСинхронизацияФактическихДоходовИРасходовЗаПериод(ПараметрыПоиска)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСинхронизацияФактическихДоходовИРасходов.Ссылка КАК Документ,
	               |	упоСинхронизацияФактическихДоходовИРасходов.Проверено КАК Проверено,
	               |	упоСинхронизацияФактическихДоходовИРасходов.СсылкаНаРегистратор КАК СсылкаНаРегистратор,
	               |	ВЫБОР
	               |		КОГДА упоСинхронизацияФактическихДоходовИРасходов.Проверено
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПорядокСортировки,
	               |	упоСинхронизацияФактическихДоходовИРасходов.ДатаМодификации КАК ДатаМодификации
	               |ПОМЕСТИТЬ ВТ_Документы
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихДоходовИРасходов КАК упоСинхронизацияФактическихДоходовИРасходов
	               |ГДЕ
	               |	упоСинхронизацияФактическихДоходовИРасходов.СозданПриЗагрузкеДанных
	               |	И НЕ упоСинхронизацияФактическихДоходовИРасходов.ПометкаУдаления
	               |	И упоСинхронизацияФактическихДоходовИРасходов.ИсточникДанных = &ИсточникДанных
	               |	И упоСинхронизацияФактическихДоходовИРасходов.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТ_Документы.Документ КАК Документ,
	               |	СУММА(ЕСТЬNULL(упоСинхронизацияФактическихДоходовИРасходовДоходы.Сумма, 0)) КАК СуммаДоходы
	               |ПОМЕСТИТЬ ВТ_Доходы
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоСинхронизацияФактическихДоходовИРасходов.Доходы КАК упоСинхронизацияФактическихДоходовИРасходовДоходы
	               |		ПО (упоСинхронизацияФактическихДоходовИРасходовДоходы.Ссылка = ВТ_Документы.Документ)
	               |ГДЕ
	               |	упоСинхронизацияФактическихДоходовИРасходовДоходы.Валюта = &Валюта
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Документы.Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТ_Документы.Документ КАК Документ,
	               |	СУММА(ЕСТЬNULL(упоСинхронизацияФактическихДоходовИРасходовРасходы.Сумма, 0)) КАК СуммаРасходы
	               |ПОМЕСТИТЬ ВТ_Расходы
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.упоСинхронизацияФактическихДоходовИРасходов.Расходы КАК упоСинхронизацияФактическихДоходовИРасходовРасходы
	               |		ПО ВТ_Документы.Документ = упоСинхронизацияФактическихДоходовИРасходовРасходы.Ссылка
	               |ГДЕ
	               |	упоСинхронизацияФактическихДоходовИРасходовРасходы.Валюта = &Валюта
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_Документы.Документ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Документы.Документ КАК Документ,
	               |	ВТ_Документы.Проверено КАК Проверено,
	               |	ВТ_Документы.СсылкаНаРегистратор КАК СсылкаНаРегистратор,
	               |	ЕСТЬNULL(ВТ_Доходы.СуммаДоходы, 0) КАК СуммаДоходы,
	               |	ЕСТЬNULL(ВТ_Расходы.СуммаРасходы, 0) КАК СуммаРасходы
	               |ИЗ
	               |	ВТ_Документы КАК ВТ_Документы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Доходы КАК ВТ_Доходы
	               |		ПО ВТ_Документы.Документ = ВТ_Доходы.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Расходы КАК ВТ_Расходы
	               |		ПО ВТ_Документы.Документ = ВТ_Расходы.Документ
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ОтборДоходы
	               |				ТОГДА ЕСТЬNULL(ВТ_Доходы.СуммаДоходы, 0) > 0
	               |			КОГДА &ОтборРасходы
	               |				ТОГДА ЕСТЬNULL(ВТ_Расходы.СуммаРасходы, 0) > 0
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТ_Документы.ПорядокСортировки,
	               |	ВТ_Документы.ДатаМодификации УБЫВ";	
	Запрос.УстановитьПараметр("НачалоПериода", 	ПараметрыПоиска.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 	ПараметрыПоиска.КонецПериода);
	Запрос.УстановитьПараметр("ИсточникДанных", ПараметрыПоиска.ИсточникДанных);
	Запрос.УстановитьПараметр("Валюта", 		ПараметрыПоиска.Валюта);
	Запрос.УстановитьПараметр("ОтборДоходы", 	ПараметрыПоиска.ОтборДоходы);
	Запрос.УстановитьПараметр("ОтборРасходы", 	ПараметрыПоиска.ОтборРасходы);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		ТабДокументов = Результат.Выгрузить();		
	Иначе
		ТабДокументов = Новый ТаблицаЗначений;
		ТабДокументов.Колонки.Добавить("Документ");
		ТабДокументов.Колонки.Добавить("Проверено");		
		ТабДокументов.Колонки.Добавить("СсылкаНаРегистратор");
		ТабДокументов.Колонки.Добавить("СуммаДоходы");
		ТабДокументов.Колонки.Добавить("СуммаРасходы");
	КонецЕсли;
	ТабДокументов.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	
	Возврат ТабДокументов;
				
КонецФункции

Функция НайтиПодразделениеПоПодразделениюОрганизации(ПодразделениеОрганизации)
	
	Подразделение = Неопределено;
	
	Если Не ЗначениеЗаполнено(ПодразделениеОрганизации) Тогда
		Возврат Подразделение;		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСоответствиеПодразделенийИПодразделенийОрганизаций.Подразделение КАК Подразделение
	               |ИЗ
	               |	РегистрСведений.упоСоответствиеПодразделенийИПодразделенийОрганизаций КАК упоСоответствиеПодразделенийИПодразделенийОрганизаций
	               |ГДЕ
	               |	упоСоответствиеПодразделенийИПодразделенийОрганизаций.ПодразделениеОрганизации = &ПодразделениеОрганизации";
	Запрос.УстановитьПараметр("ПодразделениеОрганизации", ПодразделениеОрганизации);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Подразделение = Выборка.Подразделение;
	КонецЕсли;
	
	Возврат Подразделение;
	
КонецФункции

Функция ПроектнаяЗадачаПоУмолчанию()
	
	ПЗ = Константы.упоПроектнаяЗадачаПоУмолчаниюДляБДР.Получить();
	Если ЗначениеЗаполнено(ПЗ) Тогда
		Возврат ПЗ.СсылкаНаПроектнуюЗадачу;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
			
КонецФункции 

Функция ПолучитьСсылкуПоПубличномуИдентификатору(Идентификатор, МенеджерОбъекта, УзелИБ, КэшЗначений)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Идентификатор", Идентификатор);
	СтруктураПоиска.Вставить("МенеджерОбъекта", МенеджерОбъекта);
	НайденныеСтроки = КэшЗначений.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат НайденныеСтроки[0].СсылкаНаОбъект;	
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Ссылка КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПубличныеИдентификаторыСинхронизируемыхОбъектов
	               |ГДЕ
	               |	ПубличныеИдентификаторыСинхронизируемыхОбъектов.Идентификатор = &ИдентификаторСтрокой
	               |	И ПубличныеИдентификаторыСинхронизируемыхОбъектов.УзелИнформационнойБазы = &УзелИнформационнойБазы";
	Запрос.УстановитьПараметр("ИдентификаторСтрокой", Строка(Идентификатор));
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", УзелИБ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СсылкаНаОбъект =  Выборка.Ссылка;
	Иначе
		СсылкаНаОбъект = МенеджерОбъекта.ПолучитьСсылку(Идентификатор);	
	КонецЕсли;
	
	НоваяСтрока = КэшЗначений.Добавить();
	НоваяСтрока.Идентификатор = Идентификатор;
	НоваяСтрока.МенеджерОбъекта = МенеджерОбъекта;
	НоваяСтрока.СсылкаНаОбъект = СсылкаНаОбъект;
	
	Возврат СсылкаНаОбъект;
		
КонецФункции

Функция КэшЗначений()
	
	КэшЗначений = Новый ТаблицаЗначений;
	КэшЗначений.Колонки.Добавить("Идентификатор");
	КэшЗначений.Колонки.Добавить("МенеджерОбъекта");
	КэшЗначений.Колонки.Добавить("СсылкаНаОбъект");
	
	Возврат КэшЗначений;
		
КонецФункции 

Функция УзелСинхронизации(КодУзла)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	СинхронизацияДанныхЧерезУниверсальныйФормат.Ссылка КАК Узел
	               |ИЗ
	               |	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК СинхронизацияДанныхЧерезУниверсальныйФормат
	               |ГДЕ
	               |	СинхронизацияДанныхЧерезУниверсальныйФормат.Код = &КодУзла";
	Запрос.УстановитьПараметр("КодУзла", КодУзла);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Узел;
	Иначе
		Возврат ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.ПустаяСсылка();	
	КонецЕсли; 
		
КонецФункции 

#КонецОбласти

#Область ДДС

Функция PostMoney(Items, Source, Link = Неопределено, Replace = Ложь, Node)
	
	УзелИБ = УзелСинхронизации(Node);
	
	ТаблицаДДС = Десериализовать(Items);	
	
	МассивПолей = Новый Массив;
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "ArticleGUID", "СтатьяДДС", Справочники.СтатьиДвиженияДенежныхСредств));
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "PartnerGUID", "Контрагент", Справочники.Контрагенты));
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "ContractGUID", "Договор", Справочники.ДоговорыКонтрагентов));
	
	ПорядокПоискаЗадачи = Новый Массив;	
	ПорядокПоискаЗадачи.Добавить("Договор");
	ПорядокПоискаЗадачи.Добавить("Контрагент");		
	ПорядокПоискаЗадачи.Добавить("СтатьяДДС");
	
	КэшЗначений = КэшЗначений();
	
	ИсточникДанных = Справочники.упоИсточникиДанных.ИсточникДанныхПоИдентификатору(Source, Link, УзелИБ.Наименование);
	
	НачатьТранзакцию();
	
	МассивОшибок = Новый Массив;	
	
	Для Каждого Строка Из ТаблицаДДС.Строки Цикл
		
		Объект = Неопределено;
		
		Если Replace Тогда
			ОбъектСсылка = НайтиДокументЗаДень(Строка.EndOfDay, ИсточникДанных);
			Если ОбъектСсылка <> Неопределено Тогда
				Объект = ОбъектСсылка.ПолучитьОбъект();
				Если Объект.Проведен Тогда
					Объект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", 
									НСтр("ru = 'Автоматическая загрузка данных ДДС. Отмена проведения.'"));					
					Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Объект = Неопределено Тогда
			Объект = Документы.упоСинхронизацияФактическихДвиженийДенежныхСредств.СоздатьДокумент();	
		КонецЕсли;	
		
		Комментарий = НСтр("ru = 'Загружено автоматически из базы ""%1"" в ""%2""'");
		Комментарий = СтрШаблон(Комментарий, Link, ТекущаяДатаСеанса());
		Объект.Комментарий = Комментарий;
		
		НужноЗаписать = Объект.ДвиженияДенежныхСредств.Количество();
		Объект.ДвиженияДенежныхСредств.Очистить();
		
		Если Строка.Строки.Количество() = 0 Тогда
			Если НужноЗаписать Тогда
				Объект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", 
									НСтр("ru = 'Автоматическая загрузка данных ДДС. Очистка данных за день.'"));
				Объект.Записать(РежимЗаписиДокумента.Запись);	
			КонецЕсли;
			Продолжить;
		КонецЕсли;	
		
		Объект.Дата = Строка.EndOfDay;
				
		Объект.ИсточникДанных = ИсточникДанных;
		
		Для Каждого СтрокаПодч Из Строка.Строки Цикл
						
			СтрокаДвижения = Объект.ДвиженияДенежныхСредств.Добавить();
			СтрокаДвижения.СсылкаНаРегистратор = СтрокаПодч.RecorderRef;
			СтрокаДвижения.Сумма = СтрокаПодч.Value;
			СтрокаДвижения.ВалютнаяСумма = СтрокаПодч.CurrencyValue;
			Если СтрокаПодч.Direction = -1 Тогда
				СтрокаДвижения.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Выплата;	
			Иначе
				СтрокаДвижения.НаправлениеДвижения = Перечисления.упоНаправлениеДвиженияДенежныхСредств.Поступление;
			КонецЕсли;
			СтрокаДвижения.ДатаПлатежногоДокумента = СтрокаПодч.RecorderDate;
			СтрокаДвижения.НомерПлатежногоДокумента = СтрокаПодч.RecorderNumber;
			СтрокаДвижения.КомментарийДвижения = СтрокаПодч.Content;
			СтрокаДвижения.ДатаДвижения = СтрокаПодч.Date;
			
			Валюта = Справочники.Валюты.НайтиПоКоду(СтрокаПодч.CurrencyGUID);			
			Если Не ЗначениеЗаполнено(Валюта) Тогда
				ОписаниеОшибки = НСтр("ru = 'Не найдена валюта с кодом ""%1"".'");
				ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, СтрокаПодч.CurrencyGUID);
				МассивОшибок.Добавить(ОписаниеОшибки);
			Иначе
				СтрокаДвижения.Валюта = Валюта;	
			КонецЕсли;
			
			Для Каждого СтруктураПоля Из МассивПолей Цикл
				Если Не ЗначениеЗаполнено(СтрокаПодч[СтруктураПоля.Вх]) Тогда
					Продолжить;
				КонецЕсли;
				СсылкаНаОбъект = ПолучитьСсылкуПоПубличномуИдентификатору(СтрокаПодч[СтруктураПоля.Вх], СтруктураПоля.Таблица, УзелИБ, КэшЗначений);
				Если ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
					СтрокаДвижения[СтруктураПоля.Поле] = СсылкаНаОбъект; 	
				Иначе
					ОписаниеОшибки = НСтр("ru = 'Не найден объект ""%1"".'");
					ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
					МассивОшибок.Добавить(ОписаниеОшибки);
				КонецЕсли;		
			КонецЦикла;
			
			Для Каждого ПолеПоиска Из ПорядокПоискаЗадачи Цикл
				Если ЗначениеЗаполнено(СтрокаДвижения[ПолеПоиска]) Тогда
					Задача = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаДвижения[ПолеПоиска], "упоПроектнаяЗадачаПоУмолчаниюДДС");
					Если ЗначениеЗаполнено(Задача) Тогда
						СтрокаДвижения.ПроектнаяЗадача = Задача;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(СтрокаДвижения.ПроектнаяЗадача) И ЗначениеЗаполнено(СтрокаПодч.TaskGUID) Тогда
				СсылкаНаОбъект = ПолучитьСсылкуПоПубличномуИдентификатору(СтрокаПодч.TaskGUID, Справочники.НаправленияДеятельности, УзелИБ, КэшЗначений);
				Если ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
					СсылкаНаЭлемент = упоСвязьПроектаСНаправлениемДеятельности.ПолучитьПроектнуюЗадачуПоНаправлениюДеятельности(СсылкаНаОбъект);	
					Если Не ЗначениеЗаполнено(СсылкаНаЭлемент) Тогда
						ОписаниеОшибки = НСтр("ru = 'Не найдена связь направления деятельности и задачи ""%1"".'");
						ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
						МассивОшибок.Добавить(ОписаниеОшибки);
					Иначе
						СтрокаДвижения.ПроектнаяЗадача = СсылкаНаЭлемент;
					КонецЕсли;
				Иначе
					ОписаниеОшибки = НСтр("ru = 'Не найдено направление деятельности ""%1"".'");
					ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
					МассивОшибок.Добавить(ОписаниеОшибки);
				КонецЕсли;			
			КонецЕсли;		
			
		КонецЦикла;
		
		Если МассивОшибок.Количество() = 0 Тогда
			Объект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", Комментарий);
			Объект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивОшибок.Количество() = 0 Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
		МассивОшибок = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивОшибок);
		Рекомендация = НСтр("ru = 'При получении данных произошли ошибки. 
                             |Возможно, необходимо синхронизировать НСИ.'");
		МассивОшибок.Вставить(0, Рекомендация + Символы.ПС);
		ВызватьИсключение СтрСоединить(МассивОшибок, Символы.ПС); 
	КонецЕсли;
	
КонецФункции

Функция НайтиДокументЗаДень(КонецДня, ИсточникДанных)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонецДня", КонецДня);
	Запрос.УстановитьПараметр("ИсточникДанных", ИсточникДанных);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	упоСинхронизацияФактическихДвиженийДенежныхСредств.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.упоСинхронизацияФактическихДвиженийДенежныхСредств КАК упоСинхронизацияФактическихДвиженийДенежныхСредств
	               |ГДЕ
	               |	НЕ упоСинхронизацияФактическихДвиженийДенежныхСредств.ПометкаУдаления
	               |	И упоСинхронизацияФактическихДвиженийДенежныхСредств.Дата = &КонецДня
				   |	И упоСинхронизацияФактическихДвиженийДенежныхСредств.ИсточникДанных = &ИсточникДанных";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
				
КонецФункции

#КонецОбласти

#Область Выручка

Функция СтатьяДоходовПоУмолчанию(ПроектнаяЗадача)
	
	Если ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		СтатьяИзПроекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача.Проект, "СтатьяДоходовПоУмолчанию");
	Иначе
		СтатьяИзПроекта = Неопределено;	
	КонецЕсли;	
	Если ЗначениеЗаполнено(СтатьяИзПроекта) Тогда
		Возврат СтатьяИзПроекта;
	Иначе
		Возврат Константы.упоСтатьяДоходовПоУмолчанию.Получить();	
	КонецЕсли; 
		
КонецФункции

Функция PostReceipts(Items, Source, Link, Replace, Options, Node)
	 	
	ВалютаРоссийскийРубль = ВалютаРоссийскийРубль();
	
	УзелИБ = УзелСинхронизации(Node);
	 
	ТипРаботСобственныеСилы = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");
	ТипРаботНДС = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоСобственныеСилыСубподряд.НДС");
	
	МассивПолей = Новый Массив;	
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "PartnerGUID", "Контрагент", Справочники.Контрагенты));
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "ContractGUID", "Договор", Справочники.ДоговорыКонтрагентов));
	
	Настройки = Десериализовать(Options);
	НеПриниматьДанныеВPMПриСовпаденииСуммыДокументаВыручки = Настройки.НеПриниматьДанныеВPMПриСовпаденииСуммыДокументаВыручки;
	ОтборДокументов = Настройки.ОтборДокументов; 
	
	ТабВыручки = Десериализовать(Items);
	
	КэшЗначений = КэшЗначений();
	
	ИсточникДанных = Справочники.упоИсточникиДанных.ИсточникДанныхПоИдентификатору(Source, Link, УзелИБ.Наименование);
	
	НачатьТранзакцию();
	
	МассивОшибок = Новый Массив;	
	
	Для Каждого ТекПериод Из ТабВыручки.Строки Цикл		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("НачалоПериода",  ТекПериод.StartDate);
		ПараметрыПоиска.Вставить("КонецПериода",   ТекПериод.EndDate);
		ПараметрыПоиска.Вставить("ИсточникДанных", ИсточникДанных);
		ПараметрыПоиска.Вставить("ОтборДоходы",    Истина);
		ПараметрыПоиска.Вставить("ОтборРасходы",   Ложь);
		ПараметрыПоиска.Вставить("Валюта",   	   ВалютаРоссийскийРубль);
		ДокументыЗаПериод = НайтиДокументыупоСинхронизацияФактическихДоходовИРасходовЗаПериод(ПараметрыПоиска);
		
		Для Каждого ТекСтрокаРегистратор Из ТекПериод.Строки Цикл				
			ДокОбъект = Неопределено;
			
			НеПерегружатьДокумент = Ложь;
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("СсылкаНаРегистратор", ТекСтрокаРегистратор.RecorderRef);
			НайденныеСтроки = ДокументыЗаПериод.НайтиСтроки(СтруктураПоиска);		
			Если НайденныеСтроки.Количество() > 0 Тогда
				Для Каждого ТекНайденнаяСтрока Из НайденныеСтроки Цикл					 
					ТекНайденнаяСтрока.Пометка = Истина;
					
					Если НеПриниматьДанныеВPMПриСовпаденииСуммыДокументаВыручки Тогда					
						Если ТекНайденнаяСтрока.СуммаДоходы = ТекСтрокаРегистратор.RecorderValue Тогда
							НеПерегружатьДокумент = Истина;					
							Прервать;
						КонецЕсли;							
					КонецЕсли;
					
					Если Не ТекНайденнаяСтрока.Проверено Тогда				
						ДокОбъект = ТекНайденнаяСтрока.Документ.ПолучитьОбъект();
						Если ДокОбъект.Проведен Тогда
							ДокОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", 
							НСтр("ru = 'Автоматическая загрузка данных по выручке. Отмена проведения.'"));					
							ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						КонецЕсли;
					КонецЕсли;					
				КонецЦикла;
				
				Если НеПерегружатьДокумент Тогда
					Продолжить;	
				КонецЕсли;								
			КонецЕсли;
			
			Если ДокОбъект = Неопределено Тогда
				ДокОбъект = Документы.упоСинхронизацияФактическихДоходовИРасходов.СоздатьДокумент();	
			КонецЕсли;		
			
			ТекИндексСтрокРаспределения = 0;
			
			Комментарий = НСтр("ru = 'Загружено автоматически из первичного документа %1 из базы ""%2"" %3'");
			Комментарий = СтрШаблон(Комментарий, ТекСтрокаРегистратор.Recorder, Link, ТекущаяДатаСеанса());
			ДокОбъект.Комментарий = Комментарий;
			
			НужноЗаписать = ДокОбъект.Доходы.Количество() Или ДокОбъект.РаспределениеДоходов.Количество();
			ДокОбъект.Доходы.Очистить();
			ДокОбъект.РаспределениеДоходов.Очистить();
			
			Если ТекСтрокаРегистратор.Строки.Количество() = 0 Тогда
				Если НужноЗаписать Тогда
					ДокОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", 
										НСтр("ru = 'Автоматическая загрузка данных по выручке. Очистка данных за день.'"));
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);	
				КонецЕсли;
				Продолжить;
			КонецЕсли;	
			
			ДокОбъект.СсылкаНаРегистратор = ТекСтрокаРегистратор.RecorderRef;			      			
			ДокОбъект.ИсточникДанных = ИсточникДанных;
			
			ДокОбъект.ДатаДокумента = ТекСтрокаРегистратор.RecorderDate;
			ДокОбъект.НомерДокумента = ТекСтрокаРегистратор.RecorderNumber;
			ДокОбъект.СозданПриЗагрузкеДанных = Истина;
			    		
			Для Каждого ТекСтрокаНоменклатурнаяГруппа Из ТекСтрокаРегистратор.Строки Цикл			        						
				ТекИндексСтрокРаспределения = ТекИндексСтрокРаспределения + 1;
				
				СтрокаДвижения = ДокОбъект.Доходы.Добавить();
				СтрокаДвижения.Валюта = ВалютаРоссийскийРубль;
				СтрокаДвижения.Номенклатура = Неопределено;
				СтрокаДвижения.ЕдиницаИзмерения = Неопределено;
				СтрокаДвижения.Количество = 0;
				СтрокаДвижения.ИндексСтрокРаспределения = ТекИндексСтрокРаспределения;		
				
				Для Каждого ТекСтрокаКонтрагент Из ТекСтрокаНоменклатурнаяГруппа.Строки Цикл
					
					Для Каждого ТекСтрокаДоговор Из ТекСтрокаКонтрагент.Строки Цикл				
						
						// ПроектнаяЗадача
						Если ЗначениеЗаполнено(ТекСтрокаДоговор.TaskGUID) Тогда							
							СсылкаНаОбъект = ПолучитьСсылкуПоПубличномуИдентификатору(ТекСтрокаДоговор.TaskGUID, Справочники.НаправленияДеятельности, УзелИБ, КэшЗначений);
							Если ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
								СсылкаНаЭлемент = упоСвязьПроектаСНаправлениемДеятельности.ПолучитьПроектнуюЗадачуПоНаправлениюДеятельности(СсылкаНаОбъект);	
								Если Не ЗначениеЗаполнено(СсылкаНаЭлемент) Тогда
									ОписаниеОшибки = НСтр("ru = 'Не найдена связь направления деятельности и задачи ""%1"".'");
									ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
									МассивОшибок.Добавить(ОписаниеОшибки);
								Иначе
									СтрокаДвижения.ПроектнаяЗадача = СсылкаНаЭлемент;
									СтрокаДвижения.Проект = СсылкаНаЭлемент.Проект;
								КонецЕсли;
							Иначе
								ОписаниеОшибки = НСтр("ru = 'Не найдено направление деятельности ""%1"".'");
								ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
								МассивОшибок.Добавить(ОписаниеОшибки);
							КонецЕсли;
						Иначе
							СтрокаДвижения.ПроектнаяЗадача = ПроектнаяЗадачаПоУмолчанию();										
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрокаДвижения.ПроектнаяЗадача) Тогда
							СтрокаДвижения.Проект = СтрокаДвижения.ПроектнаяЗадача.Проект;	
						КонецЕсли;
												
						// Контрагент, Договор
						Для Каждого СтруктураПоля Из МассивПолей Цикл
							Если Не ЗначениеЗаполнено(ТекСтрокаДоговор[СтруктураПоля.Вх]) Тогда
								Продолжить;
							КонецЕсли;
							СсылкаНаОбъект = ПолучитьСсылкуПоПубличномуИдентификатору(ТекСтрокаДоговор[СтруктураПоля.Вх], СтруктураПоля.Таблица, УзелИБ, КэшЗначений);
							Если ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
								СтрокаДвижения[СтруктураПоля.Поле] = СсылкаНаОбъект; 	
							Иначе
								ОписаниеОшибки = НСтр("ru = 'Не найден объект ""%1"".'");
								ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
								МассивОшибок.Добавить(ОписаниеОшибки);
							КонецЕсли;		
						КонецЦикла;
										
						СтрокаДвижения.Статья = СтатьяДоходовПоУмолчанию(СтрокаДвижения.ПроектнаяЗадача);				
						
						Если ТекСтрокаДоговор.Строки.Количество() > 0 Тогда
							ДокОбъект.Дата = ТекСтрокаДоговор.Строки[0].Date;
							СтрокаДвижения.ДатаНачисления = ТекСтрокаДоговор.Строки[0].Date;	
						КонецЕсли;					
						
						СтрокаДвижения.Сумма = ТекСтрокаДоговор.Value;
						
						Для Каждого ТекСтрокаПодразделение Из ТекСтрокаДоговор.Строки Цикл	
							СтрокаРаспределенияСобственныеСилы = ДокОбъект.РаспределениеДоходов.Добавить();
							СтрокаРаспределенияСобственныеСилы.ИндексСтрокиВладельца = СтрокаДвижения.ИндексСтрокРаспределения;
							
							Если ЗначениеЗаполнено(ТекСтрокаПодразделение.DepartmentGUID) Тогда								
								ПодразделениеОрганизации = ПолучитьСсылкуПоПубличномуИдентификатору(ТекСтрокаПодразделение.DepartmentGUID, Справочники.ПодразделенияОрганизаций, УзелИБ, КэшЗначений);
								Если ОбщегоНазначения.СсылкаСуществует(ПодразделениеОрганизации) Тогда
									СтрокаРаспределенияСобственныеСилы.Подразделение = НайтиПодразделениеПоПодразделениюОрганизации(ПодразделениеОрганизации);	
								Иначе
									ОписаниеОшибки = НСтр("ru = 'Не найдено подразделение организации ""%1"".'");
									ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(ПодразделениеОрганизации));
									МассивОшибок.Добавить(ОписаниеОшибки);
								КонецЕсли;
							КонецЕсли; 
							
							СтрокаРаспределенияСобственныеСилы.Роль = Неопределено;							
							СтрокаРаспределенияСобственныеСилы.СобствСилы_Субподряд = ТипРаботСобственныеСилы;							
							СтрокаРаспределенияСобственныеСилы.Сумма = ТекСтрокаПодразделение.Value - ТекСтрокаПодразделение.VAT;
							СтрокаРаспределенияСобственныеСилы.КонтрагентПодрядчик = Неопределено;
							СтрокаРаспределенияСобственныеСилы.ЗаказДоговорПодрядчика = Неопределено;
							СтрокаРаспределенияСобственныеСилы.Количество = 0;
							
							Если ЗначениеЗаполнено(ТекСтрокаПодразделение.VAT) Тогда
								СтрокаРаспределенияНДС = ДокОбъект.РаспределениеДоходов.Добавить();
								ЗаполнитьЗначенияСвойств(СтрокаРаспределенияНДС, СтрокаРаспределенияСобственныеСилы, , "Подразделение, СобствСилы_Субподряд, Сумма");
								СтрокаРаспределенияНДС.Подразделение = Неопределено; // Для НДС - пустое подразделение.
								СтрокаРаспределенияНДС.СобствСилы_Субподряд = ТипРаботНДС;
								СтрокаРаспределенияНДС.Сумма = ТекСтрокаПодразделение.VAT;	
							КонецЕсли;						                                 							
														
						КонецЦикла;	//Для Каждого ТекСтрокаПодразделение Из ТекСтрокаДоговор.Строки Цикл											
						
					КонецЦикла; //Для Каждого ТекСтрокаДоговор Из ТекСтрокаКонтрагент.Строки Цикл				
					
				КонецЦикла; //Для Каждого ТекСтрокаКонтрагент Из ТекСтрокаНоменклатурнаяГруппа.Строки Цикл        
				
			КонецЦикла; //Для Каждого ТекСтрокаНоменклатурнаяГруппа Из ТекСтрокаРегистратор.Строки Цикл
			
			Если МассивОшибок.Количество() = 0 Тогда
				ДокОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", Комментарий);
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
		КонецЦикла; //Для Каждого ТекСтрокаРегистратор Из ТекПериод.Строки Цикл
		
	КонецЦикла; //Для Каждого ТекПериод Из ТабВыручки.Строки Цикл
	
	// Непроверенные документы за период обмена, по которым не было данных, помечаем на удаление. 
	Если Не ОтборДокументов Тогда
		СтруктураПоиска = Новый Структура("Пометка, Проверено", Ложь, Ложь);		
		НайденныеСтроки = ДокументыЗаПериод.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
			ДокОбъект = ТекСтрока.Документ.ПолучитьОбъект();
			ДокОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;	
	КонецЕсли;	 
	
	Если МассивОшибок.Количество() = 0 Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
		МассивОшибок = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивОшибок);
		Рекомендация = НСтр("ru = 'При получении данных произошли ошибки. 
                             |Возможно, необходимо синхронизировать НСИ.'");
		МассивОшибок.Вставить(0, Рекомендация + Символы.ПС);
		ВызватьИсключение СтрСоединить(МассивОшибок, Символы.ПС); 
	КонецЕсли;
	
КонецФункции

#Область Затраты

Функция ПодразделениеРасходовПоУмолчанию(ПроектнаяЗадача)
	
	Если ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		ПодразделениеИзПроекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача.Проект, "ПодразделениеРасходовПоУмолчанию");
	Иначе
		ПодразделениеИзПроекта = Неопределено;	
	КонецЕсли;
	Если ЗначениеЗаполнено(ПодразделениеИзПроекта) Тогда
		Возврат ПодразделениеИзПроекта;
	Иначе
		Возврат Константы.упоПодразделениеРасходовПоУмолчанию.Получить();	
	КонецЕсли;	
		
КонецФункции 

Функция СтатьяЗатратПоУмолчанию(ПроектнаяЗадача)
	
	Если ЗначениеЗаполнено(ПроектнаяЗадача) Тогда
		СтатьяИзПроекта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроектнаяЗадача.Проект, "СтатьяЗатратПоУмолчанию");
	Иначе
		СтатьяИзПроекта = Неопределено;	
	КонецЕсли;
	Если ЗначениеЗаполнено(СтатьяИзПроекта) Тогда
		Возврат СтатьяИзПроекта;
	Иначе
		Возврат Константы.упоСтатьяЗатратПоУмолчанию.Получить();	
	КонецЕсли; 
		
КонецФункции

Функция PostCosts(Items, Source, Link, Replace, Options, Node)
	
	ВалютаРоссийскийРубль = ВалютаРоссийскийРубль();
	
	УзелИБ = УзелСинхронизации(Node);
	 
	ТипРаботСобственныеСилы = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоСобственныеСилыСубподряд.СобственныеСилы");
	ТипРаботНДС = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.упоСобственныеСилыСубподряд.НДС");
	
	МассивПолей = Новый Массив;	
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "PartnerGUID", "Контрагент", Справочники.Контрагенты));
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "ContractGUID", "Договор", Справочники.ДоговорыКонтрагентов));
	МассивПолей.Добавить(Новый Структура("Вх, Поле, Таблица", "CostItemGUID", "Статья", Справочники.упоСтатьиЗатрат));
	
	Настройки = Десериализовать(Options);
	НеПриниматьДанныеВPMПриСовпаденииСуммыДокументаЗатрат = Настройки.НеПриниматьДанныеВPMПриСовпаденииСуммыДокументаЗатрат;
	ОтборДокументов = Настройки.ОтборДокументов; 
	
	Данные = Десериализовать(Items);
	ТабЗатрат = Данные.Documents;
	ТабНДС = Данные.VAT;
	
	КэшЗначений = КэшЗначений();
	
	ИсточникДанных = Справочники.упоИсточникиДанных.ИсточникДанныхПоИдентификатору(Source, Link, УзелИБ.Наименование);
	
	НачатьТранзакцию();
	
	МассивОшибок = Новый Массив;	
	
	Для Каждого ТекПериод Из ТабЗатрат.Строки Цикл		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("НачалоПериода",  ТекПериод.StartDate);
		ПараметрыПоиска.Вставить("КонецПериода",   ТекПериод.EndDate);
		ПараметрыПоиска.Вставить("ИсточникДанных", ИсточникДанных);
		ПараметрыПоиска.Вставить("ОтборДоходы",    Ложь);
		ПараметрыПоиска.Вставить("ОтборРасходы",   Истина);
		ПараметрыПоиска.Вставить("Валюта",   	   ВалютаРоссийскийРубль);
		ДокументыЗаПериод = НайтиДокументыупоСинхронизацияФактическихДоходовИРасходовЗаПериод(ПараметрыПоиска);
		
		Для Каждого ТекСтрокаРегистратор Из ТекПериод.Строки Цикл				
			ДокОбъект = Неопределено;
			
			НеПерегружатьДокумент = Ложь;
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("СсылкаНаРегистратор", ТекСтрокаРегистратор.RecorderRef);
			НайденныеСтроки = ДокументыЗаПериод.НайтиСтроки(СтруктураПоиска);		
			Если НайденныеСтроки.Количество() > 0 Тогда
				Для Каждого ТекНайденнаяСтрока Из НайденныеСтроки Цикл					 
					ТекНайденнаяСтрока.Пометка = Истина;
					
					Если НеПриниматьДанныеВPMПриСовпаденииСуммыДокументаЗатрат Тогда					
						НайденныеСтрокиНДС = ТабНДС.НайтиСтроки(Новый Структура("Recorder", ТекСтрокаРегистратор.Recorder));
						СуммаНДС = 0;
						Для Каждого ТекСтрока Из НайденныеСтрокиНДС Цикл
							СуммаНДС = СуммаНДС + ТекСтрока.VAT;
						КонецЦикла;						
						
						Если ТекНайденнаяСтрока.СуммаРасходы = (ТекСтрокаРегистратор.RecorderValue + СуммаНДС + ТекСтрокаРегистратор.RecorderVAT) Тогда
							НеПерегружатьДокумент = Истина;					
							Прервать;
						КонецЕсли;							
					КонецЕсли;
					
					Если Не ТекНайденнаяСтрока.Проверено Тогда				
						ДокОбъект = ТекНайденнаяСтрока.Документ.ПолучитьОбъект();
						Если ДокОбъект.Проведен Тогда
							ДокОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", 
							НСтр("ru = 'Автоматическая загрузка данных по затратам. Отмена проведения.'"));					
							ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
						КонецЕсли;
					КонецЕсли;				
				КонецЦикла;
				
				Если НеПерегружатьДокумент Тогда
					Продолжить;	
				КонецЕсли;								
			КонецЕсли;
			
			Если ДокОбъект = Неопределено Тогда
				ДокОбъект = Документы.упоСинхронизацияФактическихДоходовИРасходов.СоздатьДокумент();	
			КонецЕсли;		
			
			ТекИндексСтрокРаспределения = 0;
			
			Комментарий = НСтр("ru = 'Загружено автоматически из первичного документа %1 из базы ""%2"" %3'");
			Комментарий = СтрШаблон(Комментарий, ТекСтрокаРегистратор.Recorder, Link, ТекущаяДатаСеанса());
			ДокОбъект.Комментарий = Комментарий;
			
			НужноЗаписать = ДокОбъект.Расходы.Количество() Или ДокОбъект.РаспределениеРасходов.Количество();
			ДокОбъект.Расходы.Очистить();
			ДокОбъект.РаспределениеРасходов.Очистить();
			
			Если ТекСтрокаРегистратор.Строки.Количество() = 0 Тогда
				Если НужноЗаписать Тогда
					ДокОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", 
										НСтр("ru = 'Автоматическая загрузка данных по затратам. Очистка данных за день.'"));
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);	
				КонецЕсли;
				Продолжить;
			КонецЕсли;	
			
			ДокОбъект.СсылкаНаРегистратор = ТекСтрокаРегистратор.RecorderRef;						
			ДокОбъект.ИсточникДанных = ИсточникДанных; 
			
			ДокОбъект.ДатаДокумента = ТекСтрокаРегистратор.RecorderDate;
			ДокОбъект.НомерДокумента = ТекСтрокаРегистратор.RecorderNumber;
			ДокОбъект.СозданПриЗагрузкеДанных = Истина;
			    		
			Для Каждого ТекСтрокаНоменклатурнаяГруппа Из ТекСтрокаРегистратор.Строки Цикл								
				
				Для Каждого ТекСтрокаКонтрагент Из ТекСтрокаНоменклатурнаяГруппа.Строки Цикл
					
					Для Каждого ТекСтрокаДоговор Из ТекСтрокаКонтрагент.Строки Цикл
						
						Для Каждого ТекСтрокаСтатьяЗатрат Из ТекСтрокаДоговор.Строки Цикл
							
							Для Каждого ТекСтрокаСодержание Из ТекСтрокаСтатьяЗатрат.Строки Цикл
								ТекИндексСтрокРаспределения = ТекИндексСтрокРаспределения + 1;
								
								СтрокаДвижения = ДокОбъект.Расходы.Добавить();
								СтрокаДвижения.Валюта = ВалютаРоссийскийРубль;
								СтрокаДвижения.Номенклатура = Неопределено;
								СтрокаДвижения.ЕдиницаИзмерения = Неопределено;
								СтрокаДвижения.Количество = 0;
								СтрокаДвижения.ИндексСтрокРаспределения = ТекИндексСтрокРаспределения;
						
								// ПроектнаяЗадача
								Если ЗначениеЗаполнено(ТекСтрокаСодержание.TaskGUID) Тогда									 	
									СсылкаНаОбъект = ПолучитьСсылкуПоПубличномуИдентификатору(ТекСтрокаСодержание.TaskGUID, Справочники.НаправленияДеятельности, УзелИБ, КэшЗначений);
									Если ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
										СсылкаНаЭлемент = упоСвязьПроектаСНаправлениемДеятельности.ПолучитьПроектнуюЗадачуПоНаправлениюДеятельности(СсылкаНаОбъект);	
										Если Не ЗначениеЗаполнено(СсылкаНаЭлемент) Тогда
											ОписаниеОшибки = НСтр("ru = 'Не найдена связь направления деятельности и задачи ""%1"".'");
											ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
											МассивОшибок.Добавить(ОписаниеОшибки);
										Иначе
											СтрокаДвижения.ПроектнаяЗадача = СсылкаНаЭлемент;											
										КонецЕсли;
									Иначе
										ОписаниеОшибки = НСтр("ru = 'Не найдено направление деятельности ""%1"".'");
										ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
										МассивОшибок.Добавить(ОписаниеОшибки);
									КонецЕсли;
								Иначе
									СтрокаДвижения.ПроектнаяЗадача = ПроектнаяЗадачаПоУмолчанию();										
								КонецЕсли;
								
								Если ЗначениеЗаполнено(СтрокаДвижения.ПроектнаяЗадача) Тогда
									СтрокаДвижения.Проект = СтрокаДвижения.ПроектнаяЗадача.Проект;	
								КонецЕсли; 
								
								// Контрагент, Договор, Статья
								Для Каждого СтруктураПоля Из МассивПолей Цикл
									Если Не ЗначениеЗаполнено(ТекСтрокаСодержание[СтруктураПоля.Вх]) Тогда
										Продолжить;
									КонецЕсли;															
									СсылкаНаОбъект = ПолучитьСсылкуПоПубличномуИдентификатору(ТекСтрокаСодержание[СтруктураПоля.Вх], СтруктураПоля.Таблица, УзелИБ, КэшЗначений);
									Если ОбщегоНазначения.СсылкаСуществует(СсылкаНаОбъект) Тогда
										СтрокаДвижения[СтруктураПоля.Поле] = СсылкаНаОбъект; 	
									Иначе
										ОписаниеОшибки = НСтр("ru = 'Не найден объект ""%1"".'");
										ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(СсылкаНаОбъект));
										МассивОшибок.Добавить(ОписаниеОшибки);
									КонецЕсли;		
								КонецЦикла;
								
								Если Не ЗначениеЗаполнено(СтрокаДвижения.Статья) Тогда
									СтрокаДвижения.Статья = СтатьяЗатратПоУмолчанию(СтрокаДвижения.ПроектнаяЗадача);
								КонецЕсли;
								 							
								Если ТекСтрокаСодержание.Строки.Количество() > 0 Тогда
									ДокОбъект.Дата = ТекСтрокаСодержание.Строки[0].Date;
									СтрокаДвижения.ДатаНачисления = ТекСтрокаСодержание.Строки[0].Date;	
								КонецЕсли;					
								
								СтрокаДвижения.Сумма = ТекСтрокаСодержание.Value + ?(ЗначениеЗаполнено(ТекСтрокаСодержание.VAT), ТекСтрокаСодержание.VAT, 0);
								СтрокаДвижения.Содержание = ТекСтрокаСодержание.Content;
								
								Если ЗначениеЗаполнено(СтрокаДвижения.Содержание) Тогда
									СтрокаДвижения.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаДвижения.Содержание, Истина);	
								КонецЕсли; 
								
								Для Каждого ТекСтрокаПодразделение Из ТекСтрокаСодержание.Строки Цикл	
									СтрокаРаспределенияСобственныеСилы = ДокОбъект.РаспределениеРасходов.Добавить();
									СтрокаРаспределенияСобственныеСилы.ИндексСтрокиВладельца = СтрокаДвижения.ИндексСтрокРаспределения;
									
									Если ЗначениеЗаполнено(ТекСтрокаПодразделение.DepartmentGUID) Тогда									 	
										ПодразделениеОрганизации = ПолучитьСсылкуПоПубличномуИдентификатору(ТекСтрокаПодразделение.DepartmentGUID, Справочники.ПодразделенияОрганизаций, УзелИБ, КэшЗначений);
										Если ОбщегоНазначения.СсылкаСуществует(ПодразделениеОрганизации) Тогда
											СтрокаРаспределенияСобственныеСилы.Подразделение = НайтиПодразделениеПоПодразделениюОрганизации(ПодразделениеОрганизации);	
										Иначе
											ОписаниеОшибки = НСтр("ru = 'Не найдено подразделение организации ""%1"".'");
											ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, ПолучитьНавигационнуюСсылку(ПодразделениеОрганизации));
											МассивОшибок.Добавить(ОписаниеОшибки);
										КонецЕсли;
									Иначе
										СтрокаРаспределенияСобственныеСилы.Подразделение = ПодразделениеРасходовПоУмолчанию(СтрокаДвижения.ПроектнаяЗадача);	
									КонецЕсли; 
									
									СтрокаРаспределенияСобственныеСилы.Роль = Неопределено;							
									СтрокаРаспределенияСобственныеСилы.СобствСилы_Субподряд = ТипРаботСобственныеСилы;							
									СтрокаРаспределенияСобственныеСилы.Сумма = ТекСтрокаПодразделение.Value;							
									СтрокаРаспределенияСобственныеСилы.Количество = 0;
									
									Если ЗначениеЗаполнено(ТекСтрокаПодразделение.VAT) Тогда
										СтрокаРаспределенияНДС = ДокОбъект.РаспределениеРасходов.Добавить();
										ЗаполнитьЗначенияСвойств(СтрокаРаспределенияНДС, СтрокаРаспределенияСобственныеСилы, , "Подразделение, СобствСилы_Субподряд, Сумма");
										СтрокаРаспределенияНДС.Подразделение = Неопределено; // Для НДС - пустое подразделение.
										СтрокаРаспределенияНДС.СобствСилы_Субподряд = ТипРаботНДС;
										СтрокаРаспределенияНДС.Сумма = ТекСтрокаПодразделение.VAT;	
									КонецЕсли;
									
								КонецЦикла;	//Для Каждого ТекСтрокаПодразделение Из ТекСтрокаСодержание.Строки Цикл
								
							КонецЦикла;	//Для Каждого ТекСтрокаСодержание Из ТекСтрокаСтатьяЗатрат.Строки Цикл
														
						КонецЦикла;	//Для Каждого ТекСтрокаСтатьяЗатрат Из ТекСтрокаДоговор.Строки Цикл											
						
					КонецЦикла; //Для Каждого ТекСтрокаДоговор Из ТекСтрокаКонтрагент.Строки Цикл				
					
				КонецЦикла; //Для Каждого ТекСтрокаКонтрагент Из ТекСтрокаНоменклатурнаяГруппа.Строки Цикл        
				
			КонецЦикла; //Для Каждого ТекСтрокаНоменклатурнаяГруппа Из ТекСтрокаРегистратор.Строки Цикл
			
			НайденныеСтроки = ТабНДС.НайтиСтроки(Новый Структура("Recorder", ТекСтрокаРегистратор.Recorder));
			Для Каждого ТекСтрока Из НайденныеСтроки Цикл
				Если ТекСтрока.Distribute Тогда										
					РаспределеноНДС = 0;
					// Если не выгружается ТЧ документа, то мы не знаем точно к какой строке относится НДС, 
					// т.к. он разнесён по документам. Распределение будет выполняться пропорционально суммам в строках регистратора.
					// Если в данных выгружаемого документа есть строки с разными ставками НДС, то распределение всё равно 
					// произойдёт пропорционально суммам в строках.
					Для Каждого ТекСтрокаРасходы Из ДокОбъект.Расходы Цикл
						СтрокаРаспределения = ДокОбъект.РаспределениеРасходов.Добавить();						
						СтрокаРаспределения.ИндексСтрокиВладельца = ТекСтрокаРасходы.ИндексСтрокРаспределения;
						СтрокаРаспределения.СобствСилы_Субподряд = ТипРаботНДС;
						СтрокаРаспределения.Сумма = (ТекСтрокаРасходы.Сумма / ТекСтрокаРегистратор.RecorderValue) * ТекСтрока.VAT;
						СтрокаРаспределения.Подразделение = Неопределено; // Для НДС - пустое подразделение.
											
						ТекСтрокаРасходы.Сумма = ТекСтрокаРасходы.Сумма + СтрокаРаспределения.Сумма;
						
						РаспределеноНДС = РаспределеноНДС + СтрокаРаспределения.Сумма;
					КонецЦикла; 
					
					Нераспределено = ТекСтрока.VAT - РаспределеноНДС;
					Если Не Нераспределено = 0 Тогда
						СтрокаРаспределения.Сумма = СтрокаРаспределения.Сумма + Нераспределено;
						ТекСтрокаРасходы.Сумма = ТекСтрокаРасходы.Сумма + Нераспределено;
					КонецЕсли;									
				Иначе
					ТекИндексСтрокРаспределения = ТекИндексСтрокРаспределения + 1;
					
					СтрокаДвижения = ДокОбъект.Расходы.Добавить();
					СтрокаДвижения.ПроектнаяЗадача = ПроектнаяЗадачаПоУмолчанию();
					СтрокаДвижения.Проект = СтрокаДвижения.ПроектнаяЗадача.Проект;
					СтрокаДвижения.Валюта = ВалютаРоссийскийРубль;					
					СтрокаДвижения.ИндексСтрокРаспределения = ТекИндексСтрокРаспределения;			
					СтрокаДвижения.Сумма = ТекСтрока.VAT;
					СтрокаДвижения.Статья = СтатьяЗатратПоУмолчанию(СтрокаДвижения.ПроектнаяЗадача);
					СтрокаДвижения.ДатаНачисления = ТекСтрока.Date;
					
					СтрокаРаспределения = ДокОбъект.РаспределениеРасходов.Добавить();
					СтрокаРаспределения.ИндексСтрокиВладельца = СтрокаДвижения.ИндексСтрокРаспределения;
					СтрокаРаспределения.СобствСилы_Субподряд = ТипРаботНДС;
					СтрокаРаспределения.Сумма = ТекСтрока.VAT;
					СтрокаРаспределения.Подразделение = Неопределено; // Для НДС - пустое подразделение.
				КонецЕсли; 	
			КонецЦикла;
			
			Если МассивОшибок.Количество() = 0 Тогда
				ДокОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии", Комментарий);
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
		КонецЦикла; //Для Каждого ТекСтрокаРегистратор Из ТекПериод.Строки Цикл
		
	КонецЦикла; //Для Каждого ТекПериод Из ТабЗатрат.Строки Цикл
	
	// Непроверенные документы за период обмена, по которым не было данных, помечаем на удаление. 
	Если Не ОтборДокументов Тогда
		СтруктураПоиска = Новый Структура("Пометка, Проверено", Ложь, Ложь);		
		НайденныеСтроки = ДокументыЗаПериод.НайтиСтроки(СтруктураПоиска);
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
			ДокОбъект = ТекСтрока.Документ.ПолучитьОбъект();
			ДокОбъект.УстановитьПометкуУдаления(Истина);
		КонецЦикла;	
	КонецЕсли;	 
	
	Если МассивОшибок.Количество() = 0 Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		ОтменитьТранзакцию();
		МассивОшибок = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивОшибок);
		Рекомендация = НСтр("ru = 'При получении данных произошли ошибки. 
                             |Возможно, необходимо синхронизировать НСИ.'");
		МассивОшибок.Вставить(0, Рекомендация + Символы.ПС);
		ВызватьИсключение СтрСоединить(МассивОшибок, Символы.ПС); 
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецОбласти
