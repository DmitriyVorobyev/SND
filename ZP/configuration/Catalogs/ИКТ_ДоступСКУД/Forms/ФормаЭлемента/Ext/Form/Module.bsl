
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.Элементы.ЗаключениеМедицинскогоОсмотра.Видимость = Константы.ИКТ_ИспользоватьЗаключениеМедицинскогоОсмотраСКУД.Получить();
	ЭтаФорма.Элементы.Увольнение.Видимость = Константы.ИКТ_ИспользоватьБлокировкуПоДопускамСКУД.Получить();
	ЭтаФорма.Элементы.ОграничениеДоступа.Видимость = ?(ЗначениеЗаполнено(Объект.ОграничениеДоступа),Истина,Ложь);
	ОформлениеСтрокТЗ(Объект.СтатусыДоступа, "СтатусыДоступа");
КонецПроцедуры

&НаСервере
Процедура ОформлениеСтрокТЗ(ТЧ, ИмяТЧ)
		
	Для Каждого Строка Из ТЧ Цикл
		
		ЦвФона = WebЦвета.Белый;
		Если Строка.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.Действует Тогда
			ЦвФона = WebЦвета.СветлоЗеленый;
		ИначеЕсли Строка.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.Уволен Тогда
			ЦвФона = WebЦвета.Красный;	
		ИначеЕсли Строка.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.НеДействует Тогда
			ЦвФона = WebЦвета.Желтый;	
		КонецЕсли;
		
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦвФона);
		ЭлементОформления.Использование = Истина;
		
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение     = Новый ПолеКомпоновкиДанных("Объект" + "." + ИмяТЧ + "." + "Статус");
		ЭлементОтбора.ВидСравнения      = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение    = Строка.Статус;
		ЭлементОтбора.Использование     = Истина;
		
		ТЗ = ТЧ.Выгрузить();
		
		Для Каждого Колонка Из ТЗ.Колонки Цикл
			
			ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
			ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ  + Колонка.Имя);
			ПолеОформления.Использование = Истина; 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

