
&НаСервере
Процедура ЗаполнитьПоУмолчаниюНаСервере()  
	
	ТипыСобытий = ИКТ_RequestСерверПривилегированный.ПолучитьТаблицуСобытийОбъектов();
	
	ТаблицаСобытийРС = Новый ТаблицаЗначений;
	ТаблицаСобытийРС.Колонки.Добавить("ТипОбъекта",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)));
	ТаблицаСобытийРС.Колонки.Добавить("ТипСобытия", Новый ОписаниеТипов("ПеречислениеСсылка.ИКТ_RequestТипыСобытий"));
	
	Для каждого Стр из ТипыСобытий Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаСобытийРС.Добавить(), Стр); 
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСобытийРС", ТаблицаСобытийРС);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСобытийРС.ТипОбъекта КАК ТипОбъекта,
	|	ТаблицаСобытийРС.ТипСобытия КАК ТипСобытия
	|ПОМЕСТИТЬ ВТ_ЗаписиПоУмолчанию
	|ИЗ
	|	&ТаблицаСобытийРС КАК ТаблицаСобытийРС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаписиПоУмолчанию.ТипОбъекта КАК ТипОбъекта,
	|	ВТ_ЗаписиПоУмолчанию.ТипСобытия КАК ТипСобытия,
	|	ИСТИНА КАК ВыгружатьДанные
	|ИЗ
	|	ВТ_ЗаписиПоУмолчанию КАК ВТ_ЗаписиПоУмолчанию
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИКТ_УправлениеОбменомRequest КАК ИКТ_УправлениеОбменомRequest
	|		ПО ВТ_ЗаписиПоУмолчанию.ТипОбъекта = ИКТ_УправлениеОбменомRequest.ТипОбъекта
	|			И ВТ_ЗаписиПоУмолчанию.ТипСобытия = ИКТ_УправлениеОбменомRequest.ТипСобытия
	|ГДЕ
	|	ИКТ_УправлениеОбменомRequest.ТипОбъекта ЕСТЬ NULL";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.ИКТ_УправлениеОбменомRequest.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		Запись.Записать();
		
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУмолчанию(Команда)
	ЗаполнитьПоУмолчаниюНаСервере();
КонецПроцедуры
