Процедура ДобавитьЗаписьСвязейДокументов(ДокументОснование, ДокументУчетаУОС, ДокументУчетаЮОС);
	
	Запись = РегистрыСведений.ИКТ_РаботаНеПоГрафику_ДокументыУчета.СоздатьМенеджерЗаписи();
	Запись.ДокументОснование = ДокументОснование;
	Запись.ДокументУчетаУОС = ДокументУчетаУОС;
	Запись.ДокументУчетаЮОС = ДокументУчетаЮОС;
	Запись.Записать(Истина);
	
КонецПроцедуры  

Процедура СформироватьДокументДанныеДляРасчетаЗарплатыЗаДень(ШаблонВводаДокумента, Показатель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_РаботаНеПоГрафику_ДокументыУчета.ДокументУчетаУОС КАК ДокументУчетаУОС,
		|	ИКТ_РаботаНеПоГрафику_ДокументыУчета.ДокументУчетаЮОС КАК ДокументУчетаЮОС
		|ИЗ
		|	РегистрСведений.ИКТ_РаботаНеПоГрафику_ДокументыУчета КАК ИКТ_РаботаНеПоГрафику_ДокументыУчета
		|ГДЕ
		|	ИКТ_РаботаНеПоГрафику_ДокументыУчета.ДокументОснование = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДокУчетаУОС = Выборка.ДокументУчетаУОС.ПолучитьОбъект();
	Иначе
		ДокУчетаУОС = Документы.ДанныеДляРасчетаЗарплаты.СоздатьДокумент();
	КонецЕсли;

	ДокУчетаУОС.Дата = ДатаИнцидента;
	ДокУчетаУОС.Период = ДатаИнцидента; 
	ДокУчетаУОС.ПериодОкончания = ДатаИнцидента;
	
	ДокУчетаУОС.ВидДокумента = ШаблонВводаДокумента;
	ДокУчетаУОС.Организация = Организация;
		
	ДокУчетаУОС.ЗначенияПоказателей.Очистить();
	
	Нстр = ДокУчетаУОС.ЗначенияПоказателей.Добавить();
	Нстр.Объект = Сотрудник;
	НСтр.Показатель = Показатель;
	НСтр.Значение = 1;
	НСтр.Период = ДатаИнцидента; 
	НСтр.ПериодОкончания = ДатаИнцидента;
	
	ДокУчетаУОС.Записать(РежимЗаписиДокумента.Проведение);
	
	ДобавитьЗаписьСвязейДокументов(Ссылка, ДокУчетаУОС.Ссылка, Документы.ДанныеДляРасчетаЗарплаты.ПустаяСсылка());

КонецПроцедуры 

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыИнцидентов", ВидыИнцидентов.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыИнцидентов.ВидИнцидента КАК ВидИнцидента
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВидыИнцидентов КАК ВидыИнцидентов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПРЕДСТАВЛЕНИЕ(ВТ.ВидИнцидента) КАК ВидИнцидента
	|ИЗ
	|	ВТ КАК ВТ";
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивИнцидентов = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("ВидИнцидента");
	
	ВидыИнцидентовСтрокой = СтрСоединить(МассивИнцидентов, "; ");
	
КонецПроцедуры


