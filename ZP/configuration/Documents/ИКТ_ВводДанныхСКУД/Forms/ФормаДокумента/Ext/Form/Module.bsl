Функция СоздатьТаблицуПроходов()
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка");
	ОписаниеТиповДата = Новый ОписаниеТипов("Дата");
	ОписаниеТиповБулево = Новый ОписаниеТипов("Булево");

	ТаблицаПроходов = Новый ТаблицаЗначений;
	
	ТаблицаПроходов.Колонки.Добавить("ФИО", ОписаниеТиповСтрока);		
	ТаблицаПроходов.Колонки.Добавить("ТабельныйНомер", ОписаниеТиповСтрока);		
	ТаблицаПроходов.Колонки.Добавить("ДатаВремя", ОписаниеТиповДата);		
	ТаблицаПроходов.Колонки.Добавить("Вход", ОписаниеТиповБулево);

	Возврат ТаблицаПроходов;
	
КонецФункции