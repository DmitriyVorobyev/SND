Функция ПолучитьJWTTokenSigur(СерверSigur)
	
	//Устарело
	//АдресРесурса = "api/v1/application-keys/auth";
	//СтруктураТела = Новый Структура;
	//СтруктураТела.Вставить("system","1C:Предприятие ЗУП КОРП 3.1");
	//СтруктураТела.Вставить("password",Константы.ИКТ_ПарольREST_API.Получить());
	
	АдресРесурса = "/api/v1/users/auth";
	СтруктураТела = Новый Структура;
	СтруктураТела.Вставить("username",Константы.ИКТ_ЛогинREST_API.Получить());
	СтруктураТела.Вставить("password",Константы.ИКТ_ПарольREST_API.Получить());
	ТелоЗапроса = ЗаписатьJSONСтроку(СтруктураТела);
	
	Соединение = Новый HTTPСоединение(СерверSigur,9500,,,,10);
	Запрос = Новый HTTPЗапрос(АдресРесурса);
	Запрос.Заголовки.Вставить("Content-Type", "application/json"); 
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;	
		
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	//Устарело
	//Возврат ?(Ответ.КодСостояния = 200, СтрСоединить(СтрРазделить(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),""""),""), Ответ.КодСостояния);
	Возврат ?(Ответ.КодСостояния = 200, ПрочитатьJSONСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8)), Ответ.КодСостояния);
КонецФункции

// Функция - Соединиться
//
// Параметры:
//  Метод			Методы http - Строка - методы для отправки запросов
//  ИмяМетода		Имя метода СКУД - Строка - для подключения к нужному методу СКУД, 
//	может содержать путь (PathParametr)
//  QueryParameters	Параметры запроса - Строка - Для отбора конкретных данных
//  ТелоЗапроса		Тело запроса - Строка JSON - Набор данных отправляемых с запросом
//  Таймаут			Время ответа - Число - Время ответа от СКУД
// 
// Возвращаемое значение:
//  Ответ от СКУД - Структура или Число
//
Функция Соединиться(Метод, ИмяМетода,QueryParameters="", ТелоЗапроса = Неопределено, Знач Таймаут = 0) Экспорт
	АдресРесурса = "api/v1/"+ИмяМетода+QueryParameters;
	
	СерверSigur = Константы.ИКТ_СерверSigur.Получить();
	Соединение = Новый HTTPСоединение(СерверSigur,9500,,,,10);	
	
	//Устарело
	//JWTTokenSigur = ПолучитьJWTTokenSigur(СерверSigur);
	JWTTokenSigur = ПолучитьJWTTokenSigur(СерверSigur).token;
	
	Запрос = Новый HTTPЗапрос(АдресРесурса);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("Authorization", "Bearer"+" "+JWTTokenSigur);
	Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
		ТелоЗапроса = ЗаписатьJSONСтроку(ТелоЗапроса);	
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;	
		
	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Возврат ?(Ответ.КодСостояния = 200, ПрочитатьJSONСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8)), Ответ.КодСостояния); 	
КонецФункции

Функция Получить(ИмяМетода, PathParametr="", QueryParameters="", ТелоЗапроса = Неопределено, Таймаут) Экспорт
	СтрМетод = ?(ЗначениеЗаполнено(PathParametr),ИмяМетода+"/"+PathParametr,ИмяМетода);
	Возврат Соединиться("GET", СтрМетод, QueryParameters, ТелоЗапроса, Таймаут);	
КонецФункции

Функция Отправить(ИмяМетода,QueryParameters="", ТелоЗапроса = Неопределено) Экспорт
	Возврат Соединиться("POST", ИмяМетода,QueryParameters, ТелоЗапроса);
КонецФункции

// Функция - Изменить
//
// Параметры:
//  ИмяМетода	Имя метода СКУД - Строка - для подключения к нужному методу СКУД 
//  PathParametr Путь метода - Строка - Содержит конкретное число (id) которое указывает на id
//	объекта данные которого мы запрашиваем
//  ТелоЗапроса	Тело запроса - Строка JSON - Набор данных отправляемых с запросом
// 
// Возвращаемое значение:
//  Ответ от СКУД - Структура или Число 
//
Функция Изменить(ИмяМетода,PathParametr="",ТелоЗапроса = Неопределено) Экспорт
	Возврат Соединиться("PUT", ИмяМетода+"/"+PathParametr,,ТелоЗапроса,10);
КонецФункции

// Функция - Разрешить проход
//
// Параметры:
//  keyHex		Значение карты - Строка - Hex значение карты
//  direction	Вид входа - Строка - Вид входа: выход = 1, вход = 2, неизвестно = 3
//  accessPoint	Точка доступа - Строка - Номер точки доступа
// 
// Возвращаемое значение:
//  Булево 
//
Функция РазрешитьПроход(keyHex, direction, accessPoint) Экспорт
	
	Если direction = 1 Тогда
		Возврат Истина
	ИначеЕсли direction = 3 Тогда
		Возврат Ложь
	Иначе
		Возврат ИКТ_СКУД.ПроверитьНаличиеДоступа(keyHex,accessPoint)
	КонецЕсли;
	
КонецФункции

