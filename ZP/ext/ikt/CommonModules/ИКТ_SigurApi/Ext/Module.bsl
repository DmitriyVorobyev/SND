Функция ЗаписатьJSONСтроку(Строка) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись,Строка);
	Возврат Запись.Закрыть(); 
КонецФункции

Функция ПрочитатьJSONСтроку(СтрокаJSON) Экспорт
	Попытка
		Если ТипЗнч(СтрокаJSON) = Тип("Число") Тогда
			Возврат СтрокаJSON; //Код ошибочного ответа
		КонецЕсли;
		
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		ОбъектJSON = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Возврат ОбъектJSON;
	Исключение
		ЗаписьЖурналаРегистрации("Делегация СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
	КонецПопытки;

КонецФункции

Функция ЗадатьQueryParameters(Параметры) Экспорт
	
	ВсеПараметры="";
	Для Каждого Набор Из Параметры Цикл
		
		Для Каждого Строка Из Набор Цикл
			
			ЗначенияПараметра=""; 
			Для Каждого Стр Из Строка.Значение Цикл
				
				//23.05.24 исправление бага с группировкой чисел
				Стр = ?(ТипЗнч(Стр) = Тип("Число"),Формат(Стр,"ЧГ=0"),Стр);
				
				ЗначенияПараметра = ?(Не ЗначениеЗаполнено(ЗначенияПараметра),Стр,ЗначенияПараметра+","+Стр);
				
			КонецЦикла;
			ВсеПараметры = ?(Не ЗначениеЗаполнено(ВсеПараметры),СтрШаблон("%1=%2",Строка.Ключ,ЗначенияПараметра),
			ВсеПараметры+"&"+СтрШаблон("%1=%2",Строка.Ключ,ЗначенияПараметра));
		КонецЦикла;
	КонецЦикла;
	
	Возврат "?"+ВсеПараметры
КонецФункции

#КонецОбласти