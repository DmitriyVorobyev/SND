//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
Процедура ДобавитьПКО_ИКТ_СобытияПроходаСКУД_Отправка(ПравилаКонвертации)
	
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО            = "ИКТ_СобытияПроходаСКУД_Отправка";
	//ПравилоКонвертации.ОбъектДанных      = Метаданные.РегистрыСведений.ИКТ_СобытияПроходаСКУД; 
	ПравилоКонвертации.ОбъектДанных 	 = Метаданные.РегистрыСведений.ИКТ_СобытияПроходаСКУД;
	ПравилоКонвертации.ОбъектФормата     = "Справочник.ИКТ_СобытияПроходаСКУД"; 
	//ПравилоКонвертации.ОбъектФормата     = "Справочник.ДокументыФизическихЛиц";

	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_ИКТ_СобытияПроходаСКУД_Отправка_ПриОтправкеДанных";   
	ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, ИКТ_ПространствоИмен());
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "", "ID_ПроходаОтбор", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "", "Записи", ИКТ_ПространствоИмен());
	
	ДобавитьПКС(СвойстваТЧ, "", "ID_Прохода", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ID_ТочкиДоступа", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ТипПрохода", 1, "ТипПрохода" , ИКТ_ПространствоИмен());
	ДобавитьПКС(СвойстваТЧ, "", "internalEmpId", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ВремяПрохода", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ЗначениеПропуска", 1);
	ДобавитьПКС(СвойстваТЧ, "", "Сотрудник","Справочник_Сотрудники_Отправка");
	ДобавитьПКС(СвойстваТЧ, "", "accessObjectId", 1);
	ДобавитьПКС(СвойстваТЧ, "", "ТипСобытия", 1);
	ДобавитьПКС(СвойстваТЧ, "", "zoneId", 1);

КонецПроцедуры //[+]} ИКТ №16316

//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
Процедура ПКО_ИКТ_СобытияПроходаСКУД_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	
