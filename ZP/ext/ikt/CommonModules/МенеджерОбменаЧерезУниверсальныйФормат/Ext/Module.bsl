//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура ИКТ_ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации)
	Если НаправлениеОбмена = "Отправка" Тогда
		ДобавитьПКО_ИКТ_СобытияПроходаСКУД_Отправка(ПравилаКонвертации); 
		ДобавитьПКО_ГрафикРаботыСотрудников_Отправка(ПравилаКонвертации);
	ИначеЕсли НаправлениеОбмена = "Получение" Тогда 
		ДобавитьПКО_Документ_ДанныеДляРасчетаЗарплаты_Получение(ПравилаКонвертации)
	КонецЕсли;        
	ДобавитьПКО_Справочник_ГрафикиРаботыСотрудников(ПравилаКонвертации);
	ДобавитьПКО_Справочник_ПоказателиРасчетаЗарплаты(ПравилаКонвертации);
	ДобавитьПКО_Справочник_ВидыДокументовВводДанныхДляРасчетаЗарплаты(ПравилаКонвертации);
КонецПроцедуры //[+]} ИКТ №16316

