Процедура ГрафикРаботыСотрудников_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Регистратор = ДанныеИБ.Отбор.Регистратор.Значение;
	РеквизитыРегистратора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Регистратор, "Номер,Дата");
	ДанныеXDTO.КлючевыеСвойства.Вставить("Номер", РеквизитыРегистратора.Номер);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Дата", РеквизитыРегистратора.Дата);
	ДанныеXDTO.КлючевыеСвойства.Вставить("Ссылка", Регистратор);
	
	ТаблицаЗаписей = Новый ТаблицаЗначений;
	ТаблицаЗаписей.Колонки.Добавить("ГрафикРаботы");
	ТаблицаЗаписей.Колонки.Добавить("ДействуетДо");
	ТаблицаЗаписей.Колонки.Добавить("ГоловнаяОрганизация");
	ТаблицаЗаписей.Колонки.Добавить("Сотрудник");
	ТаблицаЗаписей.Колонки.Добавить("ДатаСобытия");
	
	Для каждого Запись Из ДанныеИБ Цикл
		НоваяСтрока = ТаблицаЗаписей.Добавить();
		НоваяСтрока.ГрафикРаботы 		= Запись.ГрафикРаботы;
		НоваяСтрока.ДействуетДо 		= Запись.ДействуетДо;
		НоваяСтрока.ГоловнаяОрганизация = Запись.ГоловнаяОрганизация;
		НоваяСтрока.Сотрудник 			= Запись.Сотрудник; 
		НоваяСтрока.ДатаСобытия 		= Запись.Период;
	КонецЦикла;
	
	ДанныеXDTO.Вставить("Записи", ТаблицаЗаписей);
КонецПроцедуры

