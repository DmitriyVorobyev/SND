//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
&После("ВыполнитьПроцедуруМодуляМенеджера")
Процедура ИКТ_ВыполнитьПроцедуруМодуляМенеджера(ИмяПроцедуры, Параметры)
	Если ИмяПроцедуры = "ПКО_ИКТ_СобытияПроходаСКУД_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_ИКТ_СобытияПроходаСКУД_Отправка_ПриОтправкеДанных(
		Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "ПОД_РегистрСведенийЗапись_ИКТ_СобытияПроходаСКУД_Отправка_ПриОбработке" Тогда 
		ПОД_РегистрСведенийЗапись_ИКТ_СобытияПроходаСКУД_Отправка_ПриОбработке(
		Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);  
	ИначеЕсли ИмяПроцедуры = "ПОД_РегистрСведенийЗапись_ГрафикРаботыСотрудников_Отправка_ПриОбработке" Тогда 
		ПОД_РегистрСведенийЗапись_ГрафикРаботыСотрудников_Отправка_ПриОбработке(
			Параметры.ОбъектОбработки, Параметры.ИспользованиеПКО, Параметры.КомпонентыОбмена);  
	ИначеЕсли ИмяПроцедуры = "ПКО_ГрафикРаботыСотрудников_Отправка_ПриОтправкеДанных" Тогда 
		ПКО_ГрафикРаботыСотрудников_Отправка_ПриОтправкеДанных(
			Параметры.ДанныеИБ, Параметры.ДанныеXDTO, Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	КонецЕсли;
КонецПроцедуры //[+]} ИКТ №16316

//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
&После("ЗаполнитьПравилаКонвертацииПредопределенныхДанных")
Процедура ИКТ_ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации)
		
		ПравилоКонвертации           = ПравилаКонвертации.Добавить();
		ПравилоКонвертации.ИмяПКПД   = "ТипПрохода";
		ПравилоКонвертации.ТипДанных = Метаданные.Перечисления.ИКТ_ТипПроходаТочекДоступа;
		ПравилоКонвертации.ТипXDTO   = "ТипПрохода";
		
		ЗначенияДляОтправки = Новый Соответствие;
		ЗначенияДляОтправки.Вставить(Перечисления.ИКТ_ТипПроходаТочекДоступа.Вход, "Вход");
		ЗначенияДляОтправки.Вставить(Перечисления.ИКТ_ТипПроходаТочекДоступа.Выход, "Выход");
		ПравилоКонвертации.КонвертацииЗначенийПриОтправке = ЗначенияДляОтправки;
		ЗначенияДляПолучения = Новый Соответствие;
		ЗначенияДляПолучения.Вставить("Вход", Перечисления.ИКТ_ТипПроходаТочекДоступа.Вход);
		ЗначенияДляПолучения.Вставить("Выход", Перечисления.ИКТ_ТипПроходаТочекДоступа.Выход);
		ПравилоКонвертации.КонвертацииЗначенийПриПолучении = ЗначенияДляПолучения; 
		
КонецПроцедуры //[+]} ИКТ №16316

//{[+] ИКТ №16316 (фрагмент ДОБАВЛЕН), Воробьев, 28.03.2026)
&ИзменениеИКонтроль("ВедомостьНаВыплатуЗарплаты_ПриОтправкеДанных")
Процедура ИКТ_ВедомостьНаВыплатуЗарплаты_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;

	ВерсияНиже110 = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.10") < 0);
	ВерсияНиже1_11 = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.11") < 0);
	ИспользоватьФормат1_15 = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.15") >= 0);
	ИспользуетсяВерсия_1_17 = ИспользуетсяВерсия_1_17(КомпонентыОбмена);

	Если ВерсияНиже110 Тогда
		ВзысканныеСуммы = Новый ТаблицаЗначений;
		ВзысканныеСуммы.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		ВзысканныеСуммы.Колонки.Добавить("ВзысканнаяСумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Иначе
		ДанныеXDTO.Вставить("Комментарий", ДанныеИБ.Комментарий);
	КонецЕсли;

	Зарплата = ДанныеИБ.Состав.Выгрузить();
	Зарплата.Колонки.ИдентификаторСтроки.Имя = "ИдентификаторСтрокиУИ";
	Зарплата.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
	Зарплата.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	КВыплате = ДанныеИБ.Зарплата.Выгрузить();

	УдалятьНулевыеСуммы = Не ИспользуетсяВерсия_1_17;
	ДополнитьТаблицуЗарплатаВедомости(Зарплата, КВыплате, УдалятьНулевыеСуммы);
	#Вставка
	ДанныеXDTO.Вставить("Проведен", ДанныеИБ.Проведен);
	Зарплата.Колонки.Добавить("Сотрудник");
	Для Каждого СтрокаТЧ Из Зарплата Цикл 
		НайденнаяСтрока = ДанныеИБ.Зарплата.Найти(СтрокаТЧ.ФизическоеЛицо);	
		Если НайденнаяСтрока <> Неопределено Тогда 
			СтрокаТЧ.Сотрудник = НайденнаяСтрока.Сотрудник;			
		КонецЕсли;
	КонецЦикла;    
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
		Иначе
			ДополнительныеДанные = Новый Структура;
		КонецЕсли;
		ДополнительныеДанные.Вставить("ЭтоУУ", ДанныеИБ.Организация.ИКТ_УУ); 
		ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
	#КонецВставки
	ДанныеXDTO.Вставить("Зарплата", Зарплата);

	Если ВерсияНиже110 Тогда
		Для каждого СтрокаТЗ Из Зарплата Цикл
			ЗаполнитьЗначенияСвойств(ВзысканныеСуммы.Добавить(), СтрокаТЗ);
		КонецЦикла;
	КонецЕсли;

	ПередаватьВзысканныеСуммы = Ложь;
	Если ТипЗнч(ДанныеИБ.Ссылка) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыПеречислением") Тогда
		ДанныеXDTO.Вставить("СпособВыплаты", "ПеречислениемНаСчета");
		ПередаватьВзысканныеСуммы = Истина;
	ИначеЕсли ТипЗнч(ДанныеИБ.Ссылка) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыВБанк") Тогда
		ДанныеXDTO.Вставить("СпособВыплаты", "ЧерезБанк");
		ПередаватьВзысканныеСуммы = Истина;
	ИначеЕсли ТипЗнч(ДанныеИБ.Ссылка) = Тип("ДокументСсылка.ВедомостьНаВыплатуЗарплатыРаздатчиком") Тогда
		ДанныеXDTO.Вставить("СпособВыплаты", "ЧерезРаздатчика");
	Иначе
		ДанныеXDTO.Вставить("СпособВыплаты", "ЧерезКассу");
	КонецЕсли;

	Если ВерсияНиже110 И ПередаватьВзысканныеСуммы Тогда
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
			ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
		Иначе
			ДополнительныеДанные = Новый Структура;
		КонецЕсли;
		ДополнительныеДанные.Вставить("ВзысканныеСуммы", ВзысканныеСуммы); 
		ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);
	КонецЕсли;

	НДФЛ = ДанныеИБ.НДФЛ.Выгрузить();
	Если ВерсияНиже1_11 Тогда
		Для каждого СтрокаТЗ Из НДФЛ Цикл
			СтрокаТЗ.Сумма = СтрокаТЗ.Сумма + СтрокаТЗ.СуммаСПревышения;
		КонецЦикла;
		НДФЛ.Свернуть("ФизическоеЛицо","Сумма");
	Иначе
		Для каждого СтрокаТЗ Из НДФЛ Цикл
			СтрокаТЗ.СуммаСПревышения = СтрокаТЗ.СуммаСПревышения + СтрокаТЗ.СуммаСПревышенияПоСтавке18 + СтрокаТЗ.СуммаСПревышенияПоСтавке20 + СтрокаТЗ.СуммаСПревышенияПоСтавке22;
		КонецЦикла;
		НДФЛ.Свернуть("ФизическоеЛицо","Сумма,СуммаСПревышения");
	КонецЕсли;
	ДанныеXDTO.Вставить("НДФЛ", НДФЛ);

	Если ЗначениеЗаполнено(ДанныеИБ.СтатьяРасходов) Тогда
		СпособРасчетовСФизическимиЛицами = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеИБ.СтатьяРасходов, "СпособРасчетовСФизическимиЛицами");
		Если ЗначениеЗаполнено(СпособРасчетовСФизическимиЛицами) Тогда
			СпособРасчетов = ОбщегоНазначения.ИмяЗначенияПеречисления(СпособРасчетовСФизическимиЛицами);
		Иначе
			СпособРасчетов = "";
		КонецЕсли;
	Иначе
		СпособРасчетов = "";
	КонецЕсли;
	ДанныеXDTO.Вставить("СпособРасчетов", СпособРасчетов);
	
	ВидДоходаИсполнительногоПроизводства = "";
	Если ПередаватьВзысканныеСуммы И ЗначениеЗаполнено(ДанныеИБ.ВидДоходаИсполнительногоПроизводства) Тогда
		Если ИспользоватьФормат1_15 Тогда
			ВидДоходаИсполнительногоПроизводства = ДанныеИБ.ВидДоходаИсполнительногоПроизводства;
		Иначе
			Если ДанныеИБ.ВидДоходаИсполнительногоПроизводства = Перечисления.ВидыДоходовИсполнительногоПроизводства.КомпенсацииНеоблагаемыеЕдиновременные
				Или ДанныеИБ.ВидДоходаИсполнительногоПроизводства = Перечисления.ВидыДоходовИсполнительногоПроизводства.КомпенсацииНеоблагаемыеПериодические
				Или ДанныеИБ.ВидДоходаИсполнительногоПроизводства = Перечисления.ВидыДоходовИсполнительногоПроизводства.КомпенсацииОблагаемыеЕдиновременные
				Или ДанныеИБ.ВидДоходаИсполнительногоПроизводства = Перечисления.ВидыДоходовИсполнительногоПроизводства.КомпенсацииОблагаемыеПериодические Тогда

				ВидДоходаИсполнительногоПроизводстваСтрока = ОбщегоНазначения.ИмяЗначенияПеречисления(ДанныеИБ.ВидДоходаИсполнительногоПроизводства);
				Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
					ДополнительныеДанные = ДанныеXDTO.AdditionalInfo;
				Иначе
					ДополнительныеДанные = Новый Структура;
				КонецЕсли;
				ДополнительныеДанные.Вставить("ВидДоходаИсполнительногоПроизводства", ВидДоходаИсполнительногоПроизводстваСтрока);
				ДанныеXDTO.Вставить("AdditionalInfo", ДополнительныеДанные);

			Иначе
				ВидДоходаИсполнительногоПроизводства = ДанныеИБ.ВидДоходаИсполнительногоПроизводства;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ДанныеXDTO.Вставить("ВидДоходаИсполнительногоПроизводства", ВидДоходаИсполнительногоПроизводства);
КонецПроцедуры //[+]} ИКТ №16316

#КонецОбласти    
 
