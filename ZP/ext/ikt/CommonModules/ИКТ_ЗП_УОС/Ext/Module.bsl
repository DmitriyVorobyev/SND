Функция НайтиСоздатьСотрудника(СотрудникИсточник) Экспорт
	
	НайденныйСотрудник = ПолучитьСвязанныйОбъект(СотрудникИсточник.ГоловнаяОрганизация, СотрудникИсточник);
	
	Если НайденныйСотрудник <> Неопределено Тогда
		
		Возврат НайденныйСотрудник;
	
	Иначе
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Сотрудники.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.ФизическоеЛицо = &ФизическоеЛицо
			|	И Сотрудники.ГоловнаяОрганизация = &ГоловнаяОрганизация";
		
		Запрос.УстановитьПараметр("ГоловнаяОрганизация", ПолучитьСвязанныйОбъект(СотрудникИсточник.ГоловнаяОрганизация, СотрудникИсточник.ГоловнаяОрганизация));
		Запрос.УстановитьПараметр("ФизическоеЛицо", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СотрудникИсточник, "ФизическоеЛицо"));
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл    
			ВыполнитьЗаписьВСоответствиеОбъектов(СотрудникИсточник, ВыборкаДетальныеЗаписи.Ссылка);
			Возврат ВыборкаДетальныеЗаписи.Ссылка;
		КонецЦикла;
		
		СотрудникНазначение = Справочники.Сотрудники.СоздатьЭлемент();  
		ОрганизацияНазначение = ПолучитьСвязанныйОбъект(СотрудникИсточник.ГоловнаяОрганизация, СотрудникИсточник.ГоловнаяОрганизация);
		СотрудникНазначение.ГоловнаяОрганизация = ОрганизацияНазначение;   
		СотрудникНазначение.Наименование = СотрудникИсточник.Наименование;
		СотрудникНазначение.ФизическоеЛицо = СотрудникИсточник.ФизическоеЛицо;
		СотрудникНазначение.ТекущийПроцентСевернойНадбавки = СотрудникИсточник.ТекущийПроцентСевернойНадбавки;
		СотрудникНазначение.УточнениеНаименования = СотрудникИсточник.УточнениеНаименования;
		СотрудникНазначение.ВАрхиве = Ложь;
		СотрудникНазначение.Записать();  
		
		ВыполнитьЗаписьВСоответствиеОбъектов(СотрудникИсточник, СотрудникНазначение);
		
		Возврат СотрудникНазначение.Ссылка;
	
	КонецЕсли;

КонецФункции

Функция НайтиСоздатьПодразделение(ПодразделениеИсточник) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПодразделениеИсточник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденноеПодразделение = ПолучитьСвязанныйОбъект(ПодразделениеИсточник.ГоловнаяОрганизация, ПодразделениеИсточник);
	
	Если НайденноеПодразделение <> Неопределено Тогда
		
		Возврат НайденноеПодразделение;
	
	Иначе           
		
		ПодразделениеНазначение = ПодразделениеИсточник.Скопировать();     
		
		ОрганизацияНазначение = ПолучитьСвязанныйОбъект(ПодразделениеНазначение.ГоловнаяОрганизация, ПодразделениеНазначение.ГоловнаяОрганизация);	
		ПодразделениеНазначение.ГоловнаяОрганизация = ОрганизацияНазначение;  
		ПодразделениеНазначение.Владелец = ОрганизацияНазначение;  
		ПодразделениеНазначение.Родитель = Неопределено;  
		ПодразделениеНазначение.Записать();  
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ПодразделениеИсточник, ПодразделениеНазначение);
		
		Возврат ПодразделениеНазначение.Ссылка;
	
	КонецЕсли;

КонецФункции

Процедура ИКТ_ПриЗаписиДокументаПриЗаписи(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;      
	
	Если Источник.ОбменДанными.Загрузка = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоБухгалтерскаяОрганизация(Источник.Организация) Тогда
	
		Если НЕ Источник.ПометкаУдаления Тогда  
				
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
				|	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУУ,
				|	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУУ
				|ИЗ
				|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
				|ГДЕ
				|	ИКТ_СоответствиеДокументов.ДокументБУ = &ДокументБУ";
			
			Запрос.УстановитьПараметр("ДокументБУ", Источник.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();    
			
			Если Выборка.Количество() = 0 Тогда   
				
				ЗаписьВСоответвиеДокументов(Источник.Ссылка);
				
			Иначе
				
				Выборка.Следующий();
				ОчиститьСоответвиеДокументов(Выборка.ДокументБУ, Выборка.ДокументУУ);
				ЗаписьВСоответвиеДокументов(Выборка.ДокументБУ, Выборка.ДокументУУ, Выборка.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент);
				
			КонецЕсли;
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
				|	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУУ,
				|	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУУ
				|ИЗ
				|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
				|ГДЕ
				|	ИКТ_СоответствиеДокументов.ДокументБУ = &ДокументБУ";
			
			Запрос.УстановитьПараметр("ДокументБУ", Источник.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить(); 
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОчиститьСоответвиеДокументов(Выборка.ДокументБУ, Выборка.ДокументУУ);
				
				Если ЗначениеЗаполнено(Выборка.ДокументУУ) Тогда
					
					ЗаписьВСоответвиеДокументов(,Выборка.ДокументУУ, Выборка.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент);
				
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;         
	
	Если ЭтоУОС(Источник.Организация) Тогда    
		
		Если ЗначениеЗаполнено(Источник.ИКТ_ДокументИсточник) И НЕ Источник.ПометкаУдаления Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
				|	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУУ,
				|	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУУ
				|ИЗ
				|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
				|ГДЕ
				|	ИКТ_СоответствиеДокументов.ДокументБУ = &ДокументБУ";
			
			Запрос.УстановитьПараметр("ДокументБУ", Источник.ИКТ_ДокументИсточник);
			
			РезультатЗапроса = Запрос.Выполнить();   
			
			Если НЕ РезультатЗапроса.Пустой() Тогда 
				ЕстьЗаписьБУ = Истина;	
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				ИгнорироватьДокумент = Выборка.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент;	
			Иначе
				ЕстьЗаписьБУ = Ложь;   
				ИгнорироватьДокумент = Ложь;	
			КонецЕсли;
			
			Если ЕстьЗаписьБУ Тогда
			
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
					|	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУУ,
					|	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУУ
					|ИЗ
					|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
					|ГДЕ
					|	ИКТ_СоответствиеДокументов.ДокументУУ = &ДокументУУ";
				
				Запрос.УстановитьПараметр("ДокументУУ", Источник.Ссылка);
				
				Выборка = Запрос.Выполнить().Выбрать();   
				
				Если Выборка.Количество() = 0 Тогда      
					
					НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.ДокументБУ.Установить(Источник.ИКТ_ДокументИсточник);
					НаборЗаписей.Записать(); 
					
					ЗаписьВСоответвиеДокументов(Источник.ИКТ_ДокументИсточник, Источник.Ссылка, ИгнорироватьДокумент);
					
				Иначе       
					
					Выборка.Следующий();
					
					ОчиститьСоответвиеДокументов(Источник.ИКТ_ДокументИсточник, Источник.Ссылка);
					ЗаписьВСоответвиеДокументов(Источник.ИКТ_ДокументИсточник, Источник.Ссылка, ИгнорироватьДокумент);
					
				КонецЕсли;  
			
			Иначе
			
				ЗаписьВСоответвиеДокументов(, Источник.Ссылка);
			
			КонецЕсли;
			
		КонецЕсли;
			
		Если НЕ Источник.ПометкаУдаления Тогда  
				
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
				|	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУУ,
				|	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУУ
				|ИЗ
				|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
				|ГДЕ
				|	ИКТ_СоответствиеДокументов.ДокументУУ = &ДокументУУ";
			
			Запрос.УстановитьПараметр("ДокументУУ", Источник.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Количество() = 0 Тогда
				
				ЗаписьВСоответвиеДокументов(, Источник.Ссылка);
				
			Иначе                   
				
				Выборка.Следующий();
				
				Если ЗначениеЗаполнено(Выборка.ДокументБУ) Тогда
				
					ОчиститьСоответвиеДокументов(Выборка.ДокументБУ, Источник.Ссылка);
					ЗаписьВСоответвиеДокументов(Выборка.ДокументБУ, Источник.Ссылка, Выборка.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент);
				
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
				|	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУУ,
				|	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУУ
				|ИЗ
				|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
				|ГДЕ
				|	ИКТ_СоответствиеДокументов.ДокументУУ = &ДокументУУ";
			
			Запрос.УстановитьПараметр("ДокументУУ", Источник.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить(); 
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОчиститьСоответвиеДокументов(Выборка.ДокументБУ, Выборка.ДокументУУ);
				
				Если ЗначениеЗаполнено(Выборка.ДокументБУ) Тогда
					
					ЗаписьВСоответвиеДокументов(Выборка.ДокументБУ,, Выборка.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент);
					
				КонецЕсли;
					
			КонецЦикла;
			
		КонецЕсли;
			
	КонецЕсли;  
	
	Источник.ИКТ_ДокументИсточник = Неопределено;

КонецПроцедуры     

Процедура ЗаписьВСоответвиеДокументов(ДокументБУ = Неопределено, ДокументУУ = Неопределено, ИгнорироватьДокумент = Ложь) Экспорт
		
	Если ДокументБУ = Неопределено И ДокументУУ = Неопределено Тогда
	
	ИначеЕсли ДокументБУ = Неопределено Тогда 
		
		ПустойДокумент = Документы[ТипДокумента(ДокументУУ)].ПустаяСсылка();
		
		НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументУУ.Установить(ДокументУУ);
		НаборЗаписей.Отбор.ДокументБУ.Установить(ПустойДокумент);
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.ДокументУУ = ДокументУУ;
		НоваяЗапись.ДокументБУ = ПустойДокумент;  
		Если ИгнорироватьДокумент Тогда
			НоваяЗапись.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент;
		КонецЕсли;
		НаборЗаписей.Записать();   
		
	ИначеЕсли ДокументУУ = Неопределено Тогда   
		
		ПустойДокумент = Документы[ТипДокумента(ДокументБУ)].ПустаяСсылка();
		
		НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументБУ.Установить(ДокументБУ);
		НаборЗаписей.Отбор.ДокументУУ.Установить(ПустойДокумент);
		НоваяЗапись = НаборЗаписей.Добавить(); 
		НоваяЗапись.ДокументБУ = ДокументБУ;
		НоваяЗапись.ДокументУУ = ПустойДокумент;   
		Если ИгнорироватьДокумент Тогда
			НоваяЗапись.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент;
		КонецЕсли;
		НаборЗаписей.Записать();    
		
	Иначе
		
		НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументБУ.Установить(ДокументБУ);   
		Наборзаписей.Отбор.ДокументУУ.Установить(ДокументУУ);
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДокументБУ = ДокументБУ;
		НоваяЗапись.ДокументУУ = ДокументУУ;  
		Если ИгнорироватьДокумент Тогда
			НоваяЗапись.СостояниеДокументаУУ = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент;
		КонецЕсли;
		НаборЗаписей.Записать();   
		
	КонецЕсли;
	
КонецПроцедуры    

Процедура ОчиститьСоответвиеДокументов(ДокументБУ = Неопределено, ДокументУУ = Неопределено) Экспорт
	
	НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДокументБУ.Установить(ДокументБУ);
	НаборЗаписей.Отбор.ДокументУУ.Установить(ДокументУУ); 
	НаборЗаписей.Записать();       
	
КонецПроцедуры

Функция ТипДокумента(Документ) 
	
	Возврат Документ.Метаданные().Имя;

КонецФункции  

Процедура УстановитьСоответствиеПриЗаменеДокумента(ДокументБУ, ДокументУУ) Экспорт
	
	Если ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.ПриемНаРаботу") Тогда
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Подразделение, ДокументУУ.Подразделение);
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Сотрудник, ДокументУУ.Сотрудник);
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.Увольнение") Тогда
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Сотрудник, ДокументУУ.Сотрудник);
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.КадровыйПеревод") Тогда
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Подразделение, ДокументУУ.Подразделение);
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Сотрудник, ДокументУУ.Сотрудник);
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
		
		Для каждого СтрокаТЧ Из ДокументБУ.Сотрудники  Цикл  
			
			СтрокаУУ = ДокументУУ.Сотрудники[СтрокаТЧ.НомерСтроки - 1];
			ПодразделениеУУ = СтрокаУУ.Подразделение;
			СотрудникУУ = СтрокаУУ.Сотрудник;
			
			ВыполнитьЗаписьВСоответствиеОбъектов(СтрокаТЧ.Подразделение, ПодразделениеУУ);
			ВыполнитьЗаписьВСоответствиеОбъектов(СтрокаТЧ.Сотрудник, СотрудникУУ); 
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.Отпуск") Тогда
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Сотрудник, ДокументУУ.Сотрудник);
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.БольничныйЛист") Тогда
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Сотрудник, ДокументУУ.Сотрудник);
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.Командировка") Тогда
		
		ВыполнитьЗаписьВСоответствиеОбъектов(ДокументБУ.Сотрудник, ДокументУУ.Сотрудник);
		
	ИначеЕсли ТипЗнч(ДокументБУ) = Тип("ДокументСсылка.ИзменениеГрафикаРаботыСписком") Тогда
		
		Для каждого СтрокаТЧ Из ДокументБУ.Сотрудники  Цикл  
			
			СтрокаУУ = ДокументУУ.Сотрудники[СтрокаТЧ.НомерСтроки - 1];
			СотрудникУУ = СтрокаУУ.Сотрудник;
			
			ВыполнитьЗаписьВСоответствиеОбъектов(СтрокаТЧ.Сотрудник, СотрудникУУ); 
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИКТ_ЗаполнитьПоказательНачисленоЮОС(Источник, Отказ, Замещение) Экспорт
	
	
	Период = Неопределено;
