Процедура ИКТ_ТранслироватьДокументДанныеДляРасчетаЗарплатыВУОСОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если НЕ ЭтоБухгалтерскаяОрганизация(Источник.Организация) Тогда
	
		Возврат;	
	КонецЕсли; 
	
	Транслировать = УправлениеСвойствами.ЗначениеСвойства(Источник.ВидДокумента,ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ТранслироватьВУОС_98ba2ccfa2264f0881cbb99cb0c2bf19"));
	
	Если НЕ Транслировать = Неопределено Тогда
		
		
		Если  НЕ Транслировать Тогда
			
			Возврат;
			
		КонецЕсли; 
	Иначе
		
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеДляРасчетаЗарплаты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ДанныеДляРасчетаЗарплаты КАК ДанныеДляРасчетаЗарплаты
		|ГДЕ
		|	ДанныеДляРасчетаЗарплаты.ДокументИсточник = &ДокументИсточник
		|	И ДанныеДляРасчетаЗарплаты.Проведен";
	
	Запрос.УстановитьПараметр("ДокументИсточник", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ДокументНазначение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();  
	Иначе 
		ДокументНазначение = Источник.Скопировать();  

	КонецЕсли;
	
	 
	ДокументНазначение.Дата  = Источник.Дата;     
	ДокументНазначение.Организация = ПолучитьОбъектУУ(Источник.Организация); 
	ДокументНазначение.ДокументИсточник = Источник.Ссылка;
	ДокументНазначение.ЗначенияПоказателей.Очистить();

	ВидУУ  = ПолучитьОбъектУУ(Источник.ВидДокумента);  
	Если ЗначениеЗаполнено(ВидУУ) Тогда
	
		ДокументНазначение.ВидДокумента = ВидУУ;
	
	КонецЕсли;
	Для каждого Строка Из Источник.ЗначенияПоказателей Цикл
		ОбъектУУ = ПолучитьОбъектУУ(Строка.Объект); 
		ПоказательУУ = ПолучитьОбъектУУ(Строка.Показатель);
		
		Если ЗначениеЗаполнено(ОбъектУУ) Тогда
			
			Нстр = ДокументНазначение.ЗначенияПоказателей.Добавить();
			ЗаполнитьЗначенияСвойств(НСтр,Строка);
			Нстр.Объект = ПолучитьОбъектУУ(Строка.Объект);
			
			Если ЗначениеЗаполнено(ПоказательУУ) Тогда
				
				Нстр.Показатель = ПоказательУУ;
				
			КонецЕсли;
			
		Иначе
			Сообщить("Не найдено соответствие для объекта " + Строка(Строка.Объект));
			
		КонецЕсли;
		
		
	КонецЦикла; 
	
	ДокументНазначение.ФизическиеЛица.Очистить();	
	
	
	
	ПрефиксОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНазначение.Организация, "Префикс");
	ДокументНазначение.УстановитьНовыйНомер(ПрефиксОрганизации);    

	ДокументНазначение.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ИКТ_УдалитьДокументДанныеДляРасчетаЗарплатыВУОС1ОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	Если НЕ ЭтоБухгалтерскаяОрганизация(Источник.Организация) Тогда
		
		Возврат;	
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДляРасчетаЗарплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДанныеДляРасчетаЗарплаты КАК ДанныеДляРасчетаЗарплаты
	|ГДЕ
	|	ДанныеДляРасчетаЗарплаты.ДокументИсточник = &ДокументИсточник
	|	И ДанныеДляРасчетаЗарплаты.Проведен";
	
	Запрос.УстановитьПараметр("ДокументИсточник", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		ДокументНазначение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект(); 
		ДокументНазначение.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	
КонецПроцедуры

