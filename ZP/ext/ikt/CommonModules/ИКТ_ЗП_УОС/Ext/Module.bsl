	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Док.ЗначенияПоказателей.Очистить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		 
		//Нстр.Объект = ВыборкаДетальныеЗаписи.Сотрудник;
		СотрудникУУ = ИКТ_ЗП_УОС.ПолучитьОбъектУУ(ВыборкаДетальныеЗаписи.Сотрудник);
		
