	|	ДанныеДляРасчетаЗарплаты.Проведен
	|	И ДанныеДляРасчетаЗарплаты.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ДанныеДляРасчетаЗарплаты.Организация = &Организация
	|	И ДанныеДляРасчетаЗарплаты.ВидДокумента = &ВидДокумента
	|	И ДанныеДляРасчетаЗарплаты.Сотрудник = &Сотрудник";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(Период));
	Запрос.УстановитьПараметр("Организация", ОргУУ); 
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник); 
	
	ВидЗПЮОС = Справочники.ВидыДокументовВводДанныхДляРасчетаЗарплаты.ПолучитьСсылку(Новый УникальныйИдентификатор("72fc2878-6228-11f0-8135-00155d008708")); 
	Запрос.УстановитьПараметр("ВидДокумента", ВидЗПЮОС);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Док = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	Иначе
		Док = Документы.ДанныеДляРасчетаЗарплаты.СоздатьДокумент();
		Док.Дата = НачалоМесяца(Период);
		Док.Период = НачалоМесяца(Период); 
		Док.ПериодОкончания = НачалоМесяца(Период);
		
		Док.ВидДокумента = ВидЗПЮОС;
		//Начисленная з/п по ЮОС
		Док.Организация = ОргУУ;
		Док.Сотрудник = Сотрудник;
		
	КонецЕсли;
	
	
	
	
	Док.ЗначенияПоказателей.Очистить();	
	Нстр = Док.ЗначенияПоказателей.Добавить();
	Нстр.Объект = Сотрудник;
	НСтр.Показатель = Справочники.ПоказателиРасчетаЗарплаты.НайтиПоРеквизиту("Идентификатор","БольничныйОплаченныйФСС");
	НСтр.Значение = СуммаВсего;
	НСтр.Период = НачалоМесяца(Период); 
	НСтр.ПериодОкончания = НачалоМесяца(Период);
	
	
	Док.Записать(РежимЗаписиДокумента.Проведение);
		
	
КонецПроцедуры

