	// ИКТ Воробьев Д.В, 19.11.2025
	//ВидЗПЮОС = Справочники.ВидыДокументовВводДанныхДляРасчетаЗарплаты.ПолучитьСсылку(Новый УникальныйИдентификатор("9c26f8ff-55da-11f0-8131-00155d008708")); 
	
	// найдем шаблон по показателю	   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыДокументовВводДанныхДляРасчетаЗарплатыПоказатели.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыДокументовВводДанныхДляРасчетаЗарплаты.Показатели КАК ВидыДокументовВводДанныхДляРасчетаЗарплатыПоказатели
	|ГДЕ
	|	ВидыДокументовВводДанныхДляРасчетаЗарплатыПоказатели.Показатель = &Показатель
	|
	|СГРУППИРОВАТЬ ПО
	|	ВидыДокументовВводДанныхДляРасчетаЗарплатыПоказатели.Ссылка";
	
	Запрос.УстановитьПараметр("Показатель", Справочники.ПоказателиРасчетаЗарплаты.НайтиПоРеквизиту("Идентификатор","НачисленнаяЗППоЮОС"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ВидЗПЮОС = Выборка.Ссылка;	
	КонецЦикла;
	// ИКТ Воробьев Д.В, 19.11.2025
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеДляРасчетаЗарплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДанныеДляРасчетаЗарплаты КАК ДанныеДляРасчетаЗарплаты
	|ГДЕ
	|	ДанныеДляРасчетаЗарплаты.Проведен
	|	И ДанныеДляРасчетаЗарплаты.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ДанныеДляРасчетаЗарплаты.Организация = &Организация
