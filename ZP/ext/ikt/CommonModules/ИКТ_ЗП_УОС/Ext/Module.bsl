		Нстр.Объект = ИКТ_ЗП_УОС.ПолучитьОбъектУУ(ВыборкаДетальныеЗаписи.Сотрудник);
		
		НСтр.Показатель = Справочники.ПоказателиРасчетаЗарплаты.НайтиПоРеквизиту("Идентификатор","НачисленнаяЗППоЮОС");
