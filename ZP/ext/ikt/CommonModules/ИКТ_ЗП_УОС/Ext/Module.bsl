Функция ВыполнитьЗаписьВСоответствиеДокументов(ДокументБУ, ДокументУУ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ
		|ИЗ
		|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
		|ГДЕ
		|	ИКТ_СоответствиеДокументов.ДокументБУ = &ДокументБУ
		|	И ИКТ_СоответствиеДокументов.ДокументУУ = &ДокументУУ";
	
	Запрос.УстановитьПараметр("ДокументБУ", ДокументБУ.Ссылка);
	Запрос.УстановитьПараметр("ДокументУУ", ДокументУУ.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументБУ.Установить(ДокументБУ.Ссылка);
		НаборЗаписей.Отбор.ДокументУУ.Установить(ДокументУУ.Ссылка);
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ДокументБУ = ДокументБУ.Ссылка;
		НоваяЗапись.ДокументУУ = ДокументУУ.Ссылка;
		НаборЗаписей.Записать();  
		
	Иначе     
		
		НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДокументБУ.Установить(ДокументБУ.Ссылка);   
		НаборЗаписей.Отбор.ДокументУУ.Установить(ДокументУУ.Ссылка);   
		НаборЗаписей.Прочитать();
		
		Для каждого Запись Из НаборЗаписей Цикл
		
			Запись.ДокументБУ = ДокументБУ.Ссылка;
			Запись.ДокументУУ = ДокументУУ.Ссылка;
		
		КонецЦикла;
		
		НаборЗаписей.Записать();  
	
	КонецЕсли;

КонецФункции

Функция ВыполнитьЗаписьВСоответствиеОбъектов(ОбъектБУ, ОбъектУУ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_СоответствиеОбъектов.ОбъектБУ КАК ОбъектБУ,
		|	ИКТ_СоответствиеОбъектов.ОбъектУУ КАК ОбъектУУ
		|ИЗ
		|	РегистрСведений.ИКТ_СоответствиеОбъектов КАК ИКТ_СоответствиеОбъектов
		|ГДЕ
		|	ИКТ_СоответствиеОбъектов.ОбъектБУ = &ОбъектБУ
		|	И ИКТ_СоответствиеОбъектов.ОбъектУУ = &ОбъектУУ";
	
	Запрос.УстановитьПараметр("ОбъектБУ", ОбъектБУ.Ссылка);
	Запрос.УстановитьПараметр("ОбъектУУ", ОбъектУУ.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		НаборЗаписей = РегистрыСведений.ИКТ_СоответствиеОбъектов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ОбъектБУ.Установить(ОбъектБУ.Ссылка);  
		НаборЗаписей.Очистить();
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ОбъектБУ = ОбъектБУ.Ссылка;
		НоваяЗапись.ОбъектУУ = ОбъектУУ.Ссылка;
		НаборЗаписей.Записать();  
		
	КонецЕсли;

КонецФункции

Функция ПолучитьСостояниеДокументаУУ(ДокументБУ, ДокументУУ) Экспорт   
	
	Если НЕ ЗначениеЗаполнено(ДокументУУ) Тогда
		
		Возврат Перечисления.ИКТ_СостояниеДокументовУОС.ДокументОтсутствует; 
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументБУ) Тогда
		
		Возврат Перечисления.ИКТ_СостояниеДокументовУОС.ДокументОтсутствует;
	
	ИначеЕсли НЕ ПроверкаДокументовПройдена(ДокументБУ, ДокументУУ) Тогда
		
		Возврат Перечисления.ИКТ_СостояниеДокументовУОС.ДокументНеПрошелПроверку;   
		
	Иначе
		
		Возврат Перечисления.ИКТ_СостояниеДокументовУОС.ДокументСозданИПроверен;
	
	КонецЕсли;

КонецФункции         

Функция ПроверкаДокументовПройдена(ДокументБУ, ДокументУУ) Экспорт
	
	Отказ = Ложь;          
	
	Если ТипЗнч(ДокументБУ) <> ТипЗнч(ДокументУУ) Тогда
		Возврат Ложь;
	КонецЕсли;     
	
	Макет = ПолучитьОбщийМакет("ИКТ_РеквизитыДляПроверкиУОС");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Вывести(Макет);
	
	ПроверяемыеРеквизиты = "";
	
	Для Инд = 2 по ТабличныйДокумент.ВысотаТаблицы Цикл 
		
		ТипДокумента = ТабличныйДокумент.Область(Инд, 1).Текст;  
		
		Если Строка(ТипЗнч(ДокументБУ)) = ТипДокумента Тогда
			
			ПроверяемыеРеквизиты = ТабличныйДокумент.Область(Инд, 2).Текст;	
		    Прервать;
			
		КонецЕсли;
		
	КонецЦикла;   
	
	Если ПроверяемыеРеквизиты = "" Тогда
			
		Возврат Ложь;
	
	КонецЕсли;                                                                                                              
	
	МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПроверяемыеРеквизиты, ",", Истина, Истина);  
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если ИмяРеквизита = "Организация" ИЛИ ИмяРеквизита = "Сотрудник" ИЛИ ИмяРеквизита = "Подразделение" Тогда
			
			РеквизитБУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБУ, ИмяРеквизита);
			РеквизитУУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументУУ, ИмяРеквизита);
			РеквизитУУРасчетный = ПолучитьОбъектУУ(РеквизитБУ);
			
			Если РеквизитУУ <> РеквизитУУРасчетный Тогда
				
				Отказ = Истина;	
				
			КонецЕсли;
			
		ИначеЕсли ИмяРеквизита = "Сотрудники.Сотрудник" Тогда  
			
			Если ДокументБУ.Сотрудники.Количество() <> ДокументУУ.Сотрудники.Количество() Тогда
			
				Отказ = Истина;	
			
			Иначе             
					
				ОрганизацияДокументБУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБУ, "Организация");	
			
				Для каждого СтрокаБУ Из ДокументБУ.Сотрудники Цикл 
					
					СотрудникБУ = СтрокаБУ.Сотрудник;
					
					СтрокаУУ = ДокументУУ.Сотрудники[СтрокаБУ.НомерСтроки - 1];
					СотрудникУУ = СтрокаУУ.Сотрудник; 
					СотрудникУУРасчетный = ПолучитьСвязанныйОбъект(ОрганизацияДокументБУ, СотрудникБУ);
				
					Если СотрудникУУРасчетный <> СотрудникУУ Тогда
						
						Отказ = Истина;	
						
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЕсли;       
			
		ИначеЕсли ИмяРеквизита = "Сотрудники.ДатаНачала" Тогда  
			
			Если ДокументБУ.Сотрудники.Количество() <> ДокументУУ.Сотрудники.Количество() Тогда
			
				Отказ = Истина;	
			
			Иначе             
					
				Для каждого СтрокаБУ Из ДокументБУ.Сотрудники Цикл 
					
					ДатаНачалаБУ = СтрокаБУ.ДатаНачала;
					
					СтрокаУУ = ДокументУУ.Сотрудники[СтрокаБУ.НомерСтроки - 1];
					ДатаНачалаУУ = СтрокаУУ.ДатаНачала; 
				
					Если ДатаНачалаБУ <> ДатаНачалаУУ Тогда
						
						Отказ = Истина;	
						
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЕсли;
			
		Иначе    
			
			РеквизитБУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБУ, ИмяРеквизита);
			РеквизитУУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументУУ, ИмяРеквизита);
			
			Если РеквизитБУ <> РеквизитУУ Тогда
				
				Отказ = Истина;	
				
			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;         
	
	Если ДокументБУ.ПометкаУдаления Тогда
		Отказ = Истина;	
	Иначе
		Если НЕ ДокументБУ.Проведен Тогда
			Отказ = Истина;	
		КонецЕсли;
	КонецЕсли;
		
	Если ДокументУУ.ПометкаУдаления Тогда
		Отказ = Истина;	
	Иначе
		Если НЕ ДокументУУ.Проведен Тогда
			Отказ = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции 

Функция ВывестиСообщенияОПроверке(ДокументБУ, ДокументУУ, Статус) Экспорт
	
	Ошибки = Новый Массив;     
	Отказ = Ложь;
	
	Макет = ПолучитьОбщийМакет("ИКТ_РеквизитыДляПроверкиУОС");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Вывести(Макет);
	
	ПроверяемыеРеквизиты = "";
	
	Для Инд = 2 по ТабличныйДокумент.ВысотаТаблицы Цикл 
		
		ТипДокумента = ТабличныйДокумент.Область(Инд, 1).Текст;  
		
		Если Строка(ТипЗнч(ДокументБУ)) = ТипДокумента Тогда
			
			ПроверяемыеРеквизиты = ТабличныйДокумент.Область(Инд, 2).Текст;	
		    Прервать;
			
		КонецЕсли;
		
	КонецЦикла;  
	
	Если Статус = Перечисления.ИКТ_СостояниеДокументовУОС.ИгнорироватьДокумент Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИКТ_СоответствиеДокументов.ДатаИзменения КАК ДатаИзменения,
			|	ИКТ_СоответствиеДокументов.Пользователь КАК Пользователь
			|ИЗ
			|	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов
			|ГДЕ
			|	ИКТ_СоответствиеДокументов.ДокументБУ = &ДокументБУ
			|	И ИКТ_СоответствиеДокументов.ДокументУУ = &ДокументУУ
			|	И ИКТ_СоответствиеДокументов.СостояниеДокументаУУ = &СостояниеДокументаУУ";
		
		Запрос.УстановитьПараметр("ДокументБУ", ДокументБУ);
		Запрос.УстановитьПараметр("ДокументУУ", ДокументУУ);
		Запрос.УстановитьПараметр("СостояниеДокументаУУ", Статус);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ДатаИзменения = Неопределено;
		Пользователь = Неопределено;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДатаИзменения = ВыборкаДетальныеЗаписи.ДатаИзменения;
			Пользователь = ВыборкаДетальныеЗаписи.Пользователь;
		КонецЦикла;
		
		Ошибки.Добавить(СтрШаблон("Игнорировать запись с документом БУ %1 и УОС %2. Установлено %3 пользователем %4", 
			ДокументБУ, ДокументУУ, ДатаИзменения, Пользователь));
		
	КонецЕсли;          
	
	Если НЕ ЗначениеЗаполнено(ДокументБУ) Тогда
		
		Ошибки.Добавить("Отсутствует документ БУ.");
		Возврат Ошибки;
	
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(ДокументУУ) Тогда
		
		Ошибки.Добавить("Отсутствует документ УОС.");
		Возврат Ошибки;
	
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты = "" Тогда
		
		Ошибки.Добавить(СтрШаблон("Не найден список проверяемых реквизитов для документа %1", ТипЗнч(ДокументБУ)));
		
		Возврат Ошибки;
	
	КонецЕсли;                                                                                                              
	
	МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПроверяемыеРеквизиты, ",", Истина, Истина);  
	
	ШаблонСообщения = "Не совпадает реквизит %1 у документов %2 и %3";
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если ИмяРеквизита = "Организация" ИЛИ ИмяРеквизита = "Сотрудник" ИЛИ ИмяРеквизита = "Подразделение" Тогда
			
			РеквизитБУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБУ, ИмяРеквизита);
			РеквизитУУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументУУ, ИмяРеквизита);
			РеквизитУУРасчетный = ПолучитьОбъектУУ(РеквизитБУ);
			
			Если РеквизитУУ <> РеквизитУУРасчетный Тогда
				
				Ошибки.Добавить(СтрШаблон(ШаблонСообщения, ИмяРеквизита, ДокументБУ, ДокументУУ));
				
			КонецЕсли;
			
		ИначеЕсли ИмяРеквизита = "Сотрудники.Сотрудник" Тогда  
			
			Если ДокументБУ.Сотрудники.Количество() <> ДокументУУ.Сотрудники.Количество() Тогда
				
				Ошибки.Добавить(СтрШаблон("Не совпадает количество строк в табличной части Сотрудники в документах %1 и %2", ДокументБУ, ДокументУУ));
			
			Иначе             
					
				ОрганизацияДокументБУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБУ, "Организация");	
			
				Для каждого СтрокаБУ Из ДокументБУ.Сотрудники Цикл 
					
					СотрудникБУ = СтрокаБУ.Сотрудник;
					
					СтрокаУУ = ДокументУУ.Сотрудники[СтрокаБУ.НомерСтроки - 1];
					СотрудникУУ = СтрокаУУ.Сотрудник; 
					СотрудникУУРасчетный = ПолучитьСвязанныйОбъект(ОрганизацияДокументБУ, СотрудникБУ);
				
					Если СотрудникУУРасчетный <> СотрудникУУ Тогда
						
						Ошибки.Добавить(СтрШаблон("Не совпадает реквизит Сотрудник в строке %1 табличной части Сотркдники у документов %2 и %3", СтрокаБУ.НомерСтроки, ДокументБУ, ДокументУУ));
						
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЕсли;       
			
		ИначеЕсли ИмяРеквизита = "Сотрудники.ДатаНачала" Тогда  
			
			Если ДокументБУ.Сотрудники.Количество() <> ДокументУУ.Сотрудники.Количество() Тогда
				
				Ошибки.Добавить(СтрШаблон("не совпадает количество строк в табличной части Сотрудники в документах %1 и %2", ДокументБУ, ДокументУУ));
			
			Иначе             
					
				Для каждого СтрокаБУ Из ДокументБУ.Сотрудники Цикл 
					
					ДатаНачалаБУ = СтрокаБУ.ДатаНачала;
					
					СтрокаУУ = ДокументУУ.Сотрудники[СтрокаБУ.НомерСтроки - 1];
					ДатаНачалаУУ = СтрокаУУ.ДатаНачала; 
				
					Если ДатаНачалаБУ <> ДатаНачалаУУ Тогда
						
						Ошибки.Добавить(СтрШаблон("Не совпадает реквизит Дата начала в строке %1 табличной части Сотркдники у документов %2 и %3", СтрокаБУ.НомерСтроки, ДокументБУ, ДокументУУ));
						
					КонецЕсли;
				
				КонецЦикла;
			
			КонецЕсли;
			
		Иначе    
			
			РеквизитБУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументБУ, ИмяРеквизита);
			РеквизитУУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументУУ, ИмяРеквизита);
			
			Если РеквизитБУ <> РеквизитУУ Тогда
				
				Ошибки.Добавить(СтрШаблон(ШаблонСообщения, ИмяРеквизита, ДокументБУ, ДокументУУ));

			КонецЕсли;
		
		КонецЕсли;
	
	КонецЦикла;         

	Если ДокументБУ.ПометкаУдаления Тогда   
		Ошибки.Добавить(СтрШаблон("Документ %1 помечен на удаление.", ДокументБУ));
	Иначе
		Если НЕ ДокументБУ.Проведен Тогда  
			Ошибки.Добавить(СтрШаблон("Не проведен документ %1", ДокументБУ));
		КонецЕсли;
	КонецЕсли;
		
	Если ДокументУУ.ПометкаУдаления Тогда
		Ошибки.Добавить(СтрШаблон("Документ %1 помечен на удаление.", ДокументУУ));
	Иначе
		Если НЕ ДокументУУ.Проведен Тогда
			Ошибки.Добавить(СтрШаблон("Не проведен документ %1", ДокументУУ));
		КонецЕсли;
	КонецЕсли;
	
	Если Ошибки.Количество() = 0 Тогда
	
		Ошибки.Добавить("Ошибок при проверке не обнаружено.");
	
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции 

Функция СоздатьСвязанныйДокумент(ДокументИсточник) Экспорт
	
	ДокументНазначение = Неопределено;
	
	Если ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.ПриемНаРаботу") Тогда
		
		ДокументНазначение = СоздатьПриемНаРаботу(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.Увольнение") Тогда
	
		ДокументНазначение = СоздатьУвольнение(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.КадровыйПеревод") Тогда
	
		ДокументНазначение = СоздатьКадровыйПеревод(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
	
		ДокументНазначение = СоздатьКадровыйПереводСписком(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.Отпуск") Тогда
	
		ДокументНазначение = СоздатьОтпуск(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.БольничныйЛист") Тогда
	
		ДокументНазначение = СоздатьБольничныйЛист(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.Командировка") Тогда
	
		ДокументНазначение = СоздатьКомандировка(ДокументИсточник);
	
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.ИзменениеГрафикаРаботыСписком") Тогда
	
		ДокументНазначение = СоздатьИзменениеГрафикаРаботыСписком(ДокументИсточник); 
		
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.НачислениеЗарплаты") Тогда
		
		ДокументНазначение = СоздатьНачислениеЗарплаты(ДокументИсточник); 
		
	ИначеЕсли ТипЗнч(ДокументИсточник) = Тип("ДокументСсылка.ТабельУчетаРабочегоВремени") Тогда
		
		ДокументНазначение = СоздатьТабельУчетаРабочегоВремени(ДокументИсточник);
		
	КонецЕсли;
	
	Возврат ДокументНазначение;

КонецФункции   

Функция СоздатьНачислениеЗарплаты(ДокументИсточник)

	ДокументНазначение = ДокументИсточник.Скопировать();   
	ДокументНазначение.Дата  = ДокументИсточник.Дата;     
	ДокументНазначение.Организация = ПолучитьСвязанныйОбъект(ДокументИсточник.Организация, ДокументИсточник.Организация); 
	
	Для каждого Строка Из ДокументНазначение.Начисления Цикл
		
		Строка.Сотрудник = НайтиСоздатьСотрудника(Строка.Сотрудник);  
		
	КонецЦикла; 
	
	ДокументНазначение.ФизическиеЛица.Очистить();	
			
	ПрефиксОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНазначение.Организация, "Префикс");
	ДокументНазначение.УстановитьНовыйНомер(ПрефиксОрганизации);    
	
	Возврат ДокументНазначение;
	
КонецФункции 

Функция СоздатьТабельУчетаРабочегоВремени(ДокументИсточник)

	ДокументНазначение = ДокументИсточник.Скопировать();   
	ДокументНазначение.Дата  = ДокументИсточник.Дата;     
	ДокументНазначение.Организация = ПолучитьСвязанныйОбъект(ДокументИсточник.Организация, ДокументИсточник.Организация); 
	
	Для каждого Строка Из ДокументНазначение.ДанныеОВремени Цикл
		
		Строка.Сотрудник = НайтиСоздатьСотрудника(Строка.Сотрудник);  
		
		Для й = 1 По 31 Цикл
			
			Если ЗначениеЗаполнено(Строка["ВидВремени"+й]) Тогда
				ВидВремени = ПолучитьОбъектУУ(Строка["ВидВремени"+й]);
				Если ЗначениеЗаполнено(ВидВремени) Тогда
				
					 Строка["ВидВремени"+й] = ВидВремени;
				
				КонецЕсли;
				
			КонецЕсли;			
		КонецЦикла;
	КонецЦикла; 
	
	ДокументНазначение.ФизическиеЛица.Очистить();	
	
		    
		
	ПрефиксОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументНазначение.Организация, "Префикс");
	ДокументНазначение.УстановитьНовыйНомер(ПрефиксОрганизации);    
	
	Возврат ДокументНазначение;
	
КонецФункции 

