	
//Односторонний обмен РИБ
&Перед("ПриОтправкеДанныхГлавному")
Процедура СНСПриОтправкеДанныхГлавному(ЭлементДанных, ОтправкаЭлемента, Знач Получатель)
	
	Если ТипЗнч(Получатель) = Тип("ПланОбменаОбъект.ОбменВРаспределеннойИнформационнойБазе") Тогда
		ОтправкаЭлемента = ОтправкаЭлементаДанных.Игнорировать;
	КонецЕсли;
	
КонецПроцедуры
