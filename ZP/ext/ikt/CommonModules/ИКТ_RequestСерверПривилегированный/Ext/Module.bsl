
#Область ПодпискиНаСобытие

Процедура ИКТ_RequestПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт 
	
	Источник.ДополнительныеСвойства.Вставить("ИКТ_РежимЗаписи", РежимЗаписи); 
	Источник.ДополнительныеСвойства.Вставить("ИКТ_Модифицированность", Источник.Модифицированность()); 
	Источник.ДополнительныеСвойства.Вставить("ИКТ_ЭтоУдаление", Ложь); 
	
КонецПроцедуры   

Процедура ИКТ_RequestПередЗаписьюСправочника(Источник, Отказ) Экспорт
	
	Источник.ДополнительныеСвойства.Вставить("ИКТ_Модифицированность", Источник.Модифицированность()); 
	Источник.ДополнительныеСвойства.Вставить("ИКТ_ЭтоУдаление", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка, "ПометкаУдаления") = Ложь И Источник.ПометкаУдаления = Истина);
	
КонецПроцедуры  

Процедура ИКТ_RequestПриЗаписиСвязанногоСправочника(Источник, Отказ) Экспорт
	
	Если Источник.ДополнительныеСвойства.Свойство("ИКТ_Модифицированность") И Источник.ДополнительныеСвойства.ИКТ_Модифицированность Тогда 
		
		Если ТипЗнч(Источник) = Тип("СправочникОбъект.ФизическиеЛица") Тогда
			ОбработкаЗаписиФизическогоЛица(Источник.Ссылка); 
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры 

