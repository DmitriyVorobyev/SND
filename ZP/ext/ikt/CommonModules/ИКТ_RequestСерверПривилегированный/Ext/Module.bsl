Процедура ИКТ_RequestОбменДанными() Экспорт
	
	ПараметрыСоединения = Обработки.ИКТ_RequestПараметрыСоединения.ПолучитьПараметрыСоединенияСRequest();
	
	Если ПараметрыСоединения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие КАК Событие,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие.ТипСобытия КАК ТипСобытия,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие.ОснованиеСобытия КАК ОснованиеСобытия,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Действие КАК Действие,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.СообщениеОбмена КАК СообщениеОбмена,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.ИнформацияОбОшибке КАК ИнформацияОбОшибке,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.КоличествоПопыток КАК КоличествоПопыток,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Период КАК Период,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие.ДопАналитика КАК СобытиеДопАналитика,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.ИмяСобытия КАК ИмяСобытия
		|ПОМЕСТИТЬ ВТ_СобытияВОчереди
		|ИЗ
		|	РегистрСведений.ИКТ_RequestЖурналОбменаСобытиями.СрезПоследних КАК ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних
		|ГДЕ
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Выгружен = ЛОЖЬ
		|	И ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Ошибка = ЛОЖЬ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие.ТипСобытия,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие.ОснованиеСобытия,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Действие,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.СообщениеОбмена,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.ИнформацияОбОшибке,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.КоличествоПопыток,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Период,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Событие.ДопАналитика,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.ИмяСобытия
		|ИЗ
		|	РегистрСведений.ИКТ_RequestЖурналОбменаСобытиями.СрезПоследних КАК ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних
		|ГДЕ
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Выгружен = ЛОЖЬ
		|	И ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Ошибка = ИСТИНА
		|	И ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.КоличествоПопыток < 3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СобытияВОчереди.Событие КАК Событие,
		|	ВТ_СобытияВОчереди.ТипСобытия КАК ТипСобытия,
		|	ВТ_СобытияВОчереди.ОснованиеСобытия КАК ОснованиеСобытия,
		|	ВТ_СобытияВОчереди.Действие КАК Действие,
		|	ВТ_СобытияВОчереди.СообщениеОбмена КАК СообщениеОбмена,
		|	ВТ_СобытияВОчереди.ИнформацияОбОшибке КАК ИнформацияОбОшибке,
		|	ВТ_СобытияВОчереди.КоличествоПопыток КАК КоличествоПопыток,
		|	ВТ_СобытияВОчереди.СобытиеДопАналитика КАК ДопАналитика,
		|	ВТ_СобытияВОчереди.ИмяСобытия КАК ИмяСобытия
		|ИЗ
		|	ВТ_СобытияВОчереди КАК ВТ_СобытияВОчереди
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_СобытияВОчереди.Период";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТокенАвторизации = ПолучитьТокенАвторизации(ПараметрыСоединения, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаСобытий = РезультатЗапроса.Выбрать();  
	
	Пока ВыборкаСобытий.Следующий() Цикл
		
		ВыполнитьОтправкуСобытия(ПараметрыСоединения, ТокенАвторизации, ВыборкаСобытий);
		
	КонецЦикла;
	
КонецПроцедуры  

