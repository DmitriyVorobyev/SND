Процедура ВыполнитьРассылкуSMSУведомленийИзмененийГрафика(ТаблицаФизЛиц)  
	
	Если НЕ Константы.ИКТ_ВыполнятьОтправкуСМССотрудникам.Получить() Тогда 
		Возврат;	
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ОтправкаSMS.ДоступнаОтправкаSMS() = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаФизЛиц", ТаблицаФизЛиц);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаФизЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ТаблицаФизЛиц.ГрафикРаботы КАК ГрафикРаботы,
		|	НАЧАЛОПЕРИОДА(ТаблицаФизЛиц.Период, ДЕНЬ) КАК Период
		|ПОМЕСТИТЬ ВТ_ТаблицаФизЛиц
		|ИЗ
		|	&ТаблицаФизЛиц КАК ТаблицаФизЛиц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФизическиеЛицаКонтактнаяИнформация.Ссылка КАК ИсточникКонтактнойИнформации,
		|	ФизическиеЛицаКонтактнаяИнформация.Представление КАК НомерТелефона,
		|	ПРЕДСТАВЛЕНИЕ(ФизическиеЛицаКонтактнаяИнформация.Ссылка) КАК Представление
		|ПОМЕСТИТЬ ВТ_ТелефоныФизЛиц
		|ИЗ
		|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
		|ГДЕ
		|	(ФизическиеЛицаКонтактнаяИнформация.Ссылка, ФизическиеЛицаКонтактнаяИнформация.Вид) В
		|			(ВЫБРАТЬ
		|				ВТ_ТаблицаФизЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
		|				ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица)
		|			ИЗ
		|				ВТ_ТаблицаФизЛиц КАК ВТ_ТаблицаФизЛиц)
		|	И ФизическиеЛицаКонтактнаяИнформация.Представление <> """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТаблицаФизЛиц.Период КАК Период,
		|	ВТ_ТелефоныФизЛиц.ИсточникКонтактнойИнформации КАК ИсточникКонтактнойИнформации,
		|	ВТ_ТелефоныФизЛиц.НомерТелефона КАК НомерТелефона,
		|	ВТ_ТелефоныФизЛиц.Представление КАК Представление,
		|	ВТ_ТаблицаФизЛиц.ГрафикРаботы КАК ГрафикРаботы
		|ИЗ
		|	ВТ_ТаблицаФизЛиц КАК ВТ_ТаблицаФизЛиц
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТелефоныФизЛиц КАК ВТ_ТелефоныФизЛиц
		|		ПО ВТ_ТаблицаФизЛиц.ФизическоеЛицо = ВТ_ТелефоныФизЛиц.ИсточникКонтактнойИнформации
		|ИТОГИ ПО
		|	ГрафикРаботы,
		|	Период";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаГрафикРаботы = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГрафикРаботы.Следующий() Цикл
		
		ВыборкаПериод = ВыборкаГрафикРаботы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаПериод.Следующий() Цикл
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Вам установлен новый график работы ""%1"" начиная с даты %2'; en = 'You have a new work schedule set for ""%1"" starting from date %2'"),
				ВыборкаПериод.ГрафикРаботы,
				Формат(ВыборкаПериод.Период, "ДФ=dd.MM.yyyy"));
				
			Сообщение = Новый Структура;
			Сообщение.Вставить("Текст", ТекстСообщения);
			Сообщение.Вставить("ДополнительныеПараметры", Новый Структура);
			Сообщение.ДополнительныеПараметры.Вставить("Наименование", ""); 
			Сообщение.ДополнительныеПараметры.Вставить("ПеревестиВТранслит", Ложь); 
			Сообщение.Вставить("Получатель", Новый Массив);
			
			Выборка = ВыборкаПериод.Выбрать();
			
			Пока Выборка.Следующий() Цикл  
				
				АдресатSMS = Новый Структура("ИсточникКонтактнойИнформации,Представление,НомерТелефона");
				
				ЗаполнитьЗначенияСвойств(АдресатSMS, Выборка);
				
				Сообщение.Получатель.Добавить(АдресатSMS);  
				
			КонецЦикла; 
			
			Если Сообщение.Получатель.Количество() <> 0 Тогда  
				
				Взаимодействия.СоздатьИОтправитьСообщениеSMS(Сообщение);
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаписиФизическогоЛица(ФизическоеЛицо)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_СоответствиеОбъектов.ОбъектУУ КАК ОбъектУУ
		|ПОМЕСТИТЬ ВТ_ОрганизацииУОС
		|ИЗ
		|	РегистрСведений.ИКТ_СоответствиеОбъектов КАК ИКТ_СоответствиеОбъектов
		|ГДЕ
		|	ИКТ_СоответствиеОбъектов.ОбъектБУ ССЫЛКА Справочник.Организации
		|	И ИКТ_СоответствиеОбъектов.ОбъектУУ ССЫЛКА Справочник.Организации
		|	И ИКТ_СоответствиеОбъектов.ОбъектУУ <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.ФизическоеЛицо В(&ФизическоеЛицо)
		|	И Сотрудники.ГоловнаяОрганизация В
		|			(ВЫБРАТЬ
		|				ВТ_ОрганизацииУОС.ОбъектУУ КАК ОбъектУУ
		|			ИЗ
		|				ВТ_ОрганизацииУОС КАК ВТ_ОрганизацииУОС)";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		
		СотрудникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		СотрудникОбъект.ДополнительныеСвойства.Вставить("ИКТ_Модифицированность", Истина); 
		СотрудникОбъект.ДополнительныеСвойства.Вставить("ИКТ_ЭтоУдаление", Ложь); 
		
		Отказ = Ложь; 
		
		ИКТ_RequestПриЗаписиСправочника(СотрудникОбъект, Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ИКТ_RequestПриЗаписиСправочника(Источник, Отказ) Экспорт
	
	Если Источник.ДополнительныеСвойства.Свойство("ИКТ_ЗагрузкаДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Если ИКТ_RequestСерверСлужебный.ИспользоватьОбменСРексвест() = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	МассивТиповСобытий = ПолучитьМассивСобытийДляОбъекта(ТипЗнч(Источник));
	
	Если МассивТиповСобытий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	Если Не ОтправлятьСобытиеВРеквест(Источник) Тогда
		
		Возврат;
		
	КонецЕсли;

	Организация = Неопределено;

	МассивТиповБезКонтроляУОС = ПолучитьМассивТиповБезКонтроляУОС();
	
	Если МассивТиповБезКонтроляУОС.Найти(ТипЗнч(Источник)) = Неопределено Тогда
		
		ЭтоСобытиеУОС = СобытиеПоОрганизацииУОС(Источник, Организация);
		
		Если Не ЭтоСобытиеУОС Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;   
	
	Если Не ЭтоСобытиеУОС Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТипСобытия из МассивТиповСобытий Цикл
		
		Если Источник.Метаданные().Реквизиты.Найти("Сотрудник") <> Неопределено Тогда  
			
			РезультатСобытияОбмена = ПолучитьСобытияПоОбъектуИАналитике(Источник.Ссылка, ТипСобытия, Источник.Сотрудник); 
			
			СоздатьОбновитьСобытиеРеквестПриНеобходимости(РезультатСобытияОбмена, Источник, ТипСобытия, Организация, ТекущаяДатаСеанса(), Источник.Сотрудник); 
			
		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ШтатноеРасписание") Тогда  
			
			РезультатСобытияОбмена = ПолучитьСобытияПоОбъектуИАналитике(Источник.Ссылка, ТипСобытия, Источник.Ссылка); 
			
			СоздатьОбновитьСобытиеРеквестПриНеобходимости(РезультатСобытияОбмена, Источник, ТипСобытия, Организация, ТекущаяДатаСеанса(), Источник.Ссылка); 
						
		Иначе
			
			РезультатСобытияОбмена = ПолучитьСобытияПоОбъектуИАналитике(Источник.Ссылка, ТипСобытия); 
			
			СоздатьОбновитьСобытиеРеквестПриНеобходимости(РезультатСобытияОбмена, Источник, ТипСобытия, Организация, ТекущаяДатаСеанса()); 
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры   

Процедура ИКТ_RequestОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Источник.ДополнительныеСвойства.Свойство("ИКТ_ЗагрузкаДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Если ИКТ_RequestСерверСлужебный.ИспользоватьОбменСРексвест() = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	МассивТиповСобытий = ПолучитьМассивСобытийДляОбъекта(ТипЗнч(Источник));
	
	Если МассивТиповСобытий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
	
	Если Не ОтправлятьСобытиеВРеквест(Источник) Тогда
		
		Возврат;
		
	КонецЕсли;
		
	Организация = Неопределено;  

	МассивТиповБезКонтроляУОС = ПолучитьМассивТиповБезКонтроляУОС();
	
	Если МассивТиповБезКонтроляУОС.Найти(ТипЗнч(Источник)) = Неопределено Тогда
		
		ЭтоСобытиеУОС = СобытиеПоОрганизацииУОС(Источник, Организация);
		
		Если Не ЭтоСобытиеУОС Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;   
	
	МассивДопАналитик = ПолучитьМассивДопАналитикПоДокументу(Источник); 
	
	Для каждого ТипСобытия из МассивТиповСобытий Цикл
	
		Для каждого ДопАналитика Из МассивДопАналитик Цикл
			
			РезультатСобытияОбмена = ПолучитьСобытияПоОбъектуИАналитике(Источник.Ссылка, ТипСобытия, ДопАналитика);
				
			СоздатьОбновитьСобытиеРеквестПриНеобходимости(РезультатСобытияОбмена, Источник, ТипСобытия, Организация, Источник.Дата, ДопАналитика);
		
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ИКТ_RequestОбработкаУдаленияПроведения(Источник, Отказ) Экспорт
	
	Если ИКТ_RequestСерверСлужебный.ИспользоватьОбменСРексвест() = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	МассивТиповСобытий = ПолучитьМассивСобытийДляОбъекта(ТипЗнч(Источник));
	
	Если МассивТиповСобытий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли; 
		
	Организация = Неопределено;
	ЭтоСобытиеУОС = СобытиеПоОрганизацииУОС(Источник, Организация);
	
	Если Не ЭтоСобытиеУОС Тогда
		Возврат;
	КонецЕсли;  
	
	УдаляемыеСобытия = Новый Массив;
	УдаляемыеСобытия.Добавить(Перечисления.ИКТ_RequestТипыСобытий.РаботаНеПоГрафику);
	УдаляемыеСобытия.Добавить(Перечисления.ИКТ_RequestТипыСобытий.KPI);
	
	МассивДопАналитик = ПолучитьМассивДопАналитикПоДокументу(Источник); 
	
	Для каждого ТипСобытия из МассивТиповСобытий Цикл 
		
		Если УдаляемыеСобытия.Найти(ТипСобытия) <> Неопределено Тогда
			Источник.ДополнительныеСвойства.ИКТ_ЭтоУдаление = Истина; 
		КонецЕсли;
	
		Для каждого ДопАналитика Из МассивДопАналитик Цикл
			
			РезультатСобытияОбмена = ПолучитьСобытияПоОбъектуИАналитике(Источник.Ссылка, ТипСобытия, ДопАналитика);
				
			СоздатьОбновитьСобытиеРеквестПриНеобходимости(РезультатСобытияОбмена, Источник, ТипСобытия, Организация, Источник.Дата, ДопАналитика);
		
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

Функция ПолучитьМассивДопАналитикПоДокументу(Источник) 
	
	ДокументыСДопАналиткойСотрудник = Новый Массив;
	ДокументыСДопАналиткойСотрудник.Добавить(Тип("ДокументОбъект.ПриемНаРаботу"));
	ДокументыСДопАналиткойСотрудник.Добавить(Тип("ДокументОбъект.КадровыйПеревод"));
	ДокументыСДопАналиткойСотрудник.Добавить(Тип("ДокументОбъект.Увольнение"));
	ДокументыСДопАналиткойСотрудник.Добавить(Тип("ДокументОбъект.ИКТ_RequestРаботаНеПоГрафику"));
	
	ДокументыСДопАналиткойСотрудники = Новый Массив;
	ДокументыСДопАналиткойСотрудники.Добавить(Тип("ДокументОбъект.ПриемНаРаботуСписком"));
	ДокументыСДопАналиткойСотрудники.Добавить(Тип("ДокументОбъект.КадровыйПереводСписком"));
	ДокументыСДопАналиткойСотрудники.Добавить(Тип("ДокументОбъект.УвольнениеСписком"));   
	
	ДокументыСДопАналиткойПозицияШР = Новый Массив;
	ДокументыСДопАналиткойПозицияШР.Добавить(Тип("ДокументОбъект.УтверждениеШтатногоРасписания"));
	ДокументыСДопАналиткойПозицияШР.Добавить(Тип("ДокументОбъект.ИзменениеШтатногоРасписания"));
	
	ДокументыСДопАналиткойСостав = Новый Массив;
	
	ОбъектыБезДопАналитики = Новый Массив;
	Результат = Новый Массив;
	
	Если ДокументыСДопАналиткойСотрудник.Найти(ТипЗнч(Источник)) <> Неопределено Тогда
		Результат.Добавить(Источник.Сотрудник);
	ИначеЕсли ДокументыСДопАналиткойСотрудники.Найти(ТипЗнч(Источник)) <> Неопределено Тогда
		Результат = Источник.Сотрудники.ВыгрузитьКолонку("Сотрудник");
	ИначеЕсли ДокументыСДопАналиткойСостав.Найти(ТипЗнч(Источник)) <> Неопределено Тогда 
		Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЛC_ВводПланаKPI") Тогда 
			ТЗСостав = Источник.Состав.Выгрузить(); 
			ТЗСостав.Свернуть("Сотрудник");
			Результат = ТЗСостав.ВыгрузитьКолонку("Сотрудник");
		КонецЕсли;
	ИначеЕсли ДокументыСДопАналиткойПозицияШР.Найти(ТипЗнч(Источник)) <> Неопределено Тогда
		Результат = Источник.Позиции.ВыгрузитьКолонку("Позиция");  
	ИначеЕсли ОбъектыБезДопАналитики.Найти(ТипЗнч(Источник)) <> Неопределено Тогда
		Результат.Добавить(Неопределено);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивСобытийДляОбъекта(ТипОбъекта) Экспорт
	
	Результат = Новый Массив;  
	
	ТаблицаСобытий = ПолучитьТаблицуСобытийОбъектов();    
	
    СтрокиСобытийДляТипа = ТаблицаСобытий.НайтиСтроки(Новый Структура("ТипОбъекта",ТипОбъекта));
	
	МассивВыгружаемыхСобытий = РегистрыСведений.ИКТ_УправлениеОбменомRequest.ПолучитьМассивВыгружаемыхСобытийПоТипуОбъекту(ТипОбъекта);
	
	Для каждого СтрокаСобытия из СтрокиСобытийДляТипа Цикл
		
		Если МассивВыгружаемыхСобытий.Найти(СтрокаСобытия.ТипСобытия) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(СтрокаСобытия.ТипСобытия);
		
	КонецЦикла;
		
	Возврат Результат;
	
КонецФункции 

Функция ПолучитьТаблицуСобытийОбъектов() Экспорт
	
	ТаблицаСобытий = Новый ТаблицаЗначений;
	ТаблицаСобытий.Колонки.Добавить("ТипОбъекта");
	ТаблицаСобытий.Колонки.Добавить("ТипСобытия");
	
	//Сотрудники
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.ПриемНаРаботу"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.ПриемНаРаботуСписком"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.КадровыйПеревод"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.КадровыйПереводСписком"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.Увольнение"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.УвольнениеСписком"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники)); 
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("СправочникОбъект.Сотрудники"),Перечисления.ИКТ_RequestТипыСобытий.Сотрудники));  	
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("СправочникОбъект.ИКТ_Руководители"),Перечисления.ИКТ_RequestТипыСобытий.ЭскалацияСвязей));
	
	//Штатное расписания
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("СправочникОбъект.ШтатноеРасписание"),Перечисления.ИКТ_RequestТипыСобытий.ШтатноеРасписание));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.УтверждениеШтатногоРасписания"),Перечисления.ИКТ_RequestТипыСобытий.ШтатноеРасписание));
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.ИзменениеШтатногоРасписания"),Перечисления.ИКТ_RequestТипыСобытий.ШтатноеРасписание));
	
	//Должности
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("СправочникОбъект.ИКТ_ДолжностиС"),Перечисления.ИКТ_RequestТипыСобытий.Должности));
	
	//Работа не по графику
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("ДокументОбъект.ИКТ_RequestРаботаНеПоГрафику"),Перечисления.ИКТ_RequestТипыСобытий.РаботаНеПоГрафику));
		
	ЗаполнитьЗначенияСвойств(ТаблицаСобытий.Добавить(), Новый Структура("ТипОбъекта,ТипСобытия",Тип("СправочникОбъект.ИКТ_СобытияТехСбойСКУД"),Перечисления.ИКТ_RequestТипыСобытий.ТехСбойСКУД));
	
	Возврат ТаблицаСобытий;
	
КонецФункции

Функция ПолучитьСобытияПоОбъектуИАналитике(ОснованиеСобытия, ТипСобытия, ДопАналитика = Неопределено) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_СобытияОбменаRequestПоОбъекту.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИКТ_СобытияОбменаRequest КАК ИКТ_СобытияОбменаRequestПоОбъекту
		|ГДЕ
		|	ИКТ_СобытияОбменаRequestПоОбъекту.ОснованиеСобытия = &ОснованиеСобытия
		|	И ИКТ_СобытияОбменаRequestПоОбъекту.ТипСобытия = &ТипСобытия
		|	И ИКТ_СобытияОбменаRequestПоОбъекту.ПометкаУдаления = ЛОЖЬ
		|	И ИКТ_СобытияОбменаRequestПоОбъекту.ДопАналитика = &ДопАналитика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИКТ_СобытияОбменаRequest.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ИКТ_СобытияОбменаRequest КАК ИКТ_СобытияОбменаRequest
		|ГДЕ
		|	ИКТ_СобытияОбменаRequest.ТипСобытия = &ТипСобытия
		|	И ИКТ_СобытияОбменаRequest.ПометкаУдаления = ЛОЖЬ
		|	И ИКТ_СобытияОбменаRequest.ДопАналитика = &ДопАналитика
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИКТ_СобытияОбменаRequest.Ссылка
		|ИЗ
		|	Справочник.ИКТ_СобытияОбменаRequest КАК ИКТ_СобытияОбменаRequest
		|ГДЕ
		|	ИКТ_СобытияОбменаRequest.ТипСобытия = &ТипСобытия
		|	И ИКТ_СобытияОбменаRequest.ПометкаУдаления = ЛОЖЬ
		|	И ИКТ_СобытияОбменаRequest.ДопАналитика = &ОснованиеСобытия";
	
	Запрос.УстановитьПараметр("ОснованиеСобытия", ОснованиеСобытия);
	Запрос.УстановитьПараметр("ТипСобытия", ТипСобытия);
	Запрос.УстановитьПараметр("ДопАналитика", ДопАналитика);
	
	Если Не ЗначениеЗаполнено(Запрос.Параметры.ДопАналитика) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИКТ_СобытияОбменаRequestПоОбъекту.ДопАналитика = &ДопАналитика", "Истина");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИКТ_СобытияОбменаRequest.ДопАналитика = &ДопАналитика", "Ложь");
	КонецЕсли;
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаПоСобытию = ПакетыЗапроса[0].Выбрать();
	ВыборкаПоАналитике = ПакетыЗапроса[1].Выбрать();
	
	Результат = Новый Структура("СобытиеПоОбъекту,СобытиеПоАналитике", Справочники.ИКТ_СобытияОбменаRequest.ПустаяСсылка(), Справочники.ИКТ_СобытияОбменаRequest.ПустаяСсылка());
	
	Пока ВыборкаПоСобытию.Следующий() Цикл
		Результат.СобытиеПоОбъекту = ВыборкаПоСобытию.Ссылка;
	КонецЦикла;
	Пока ВыборкаПоАналитике.Следующий() Цикл
		Результат.СобытиеПоАналитике = ВыборкаПоАналитике.Ссылка; //не важно какая ссылка, важно наличие записи по доп. аналитике
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

Процедура СоздатьОбновитьСобытиеРеквестПриНеобходимости(РезультатСобытияОбмена, ОснованиеСобытияОбъект, ТипСобытия, Организация, ДатаСобытия, ДопАналитика = Неопределено, ИмяСобытия = "")
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отказ = Ложь;
	
	СтатусОбмена = Неопределено;    
	
	ТипыДопАналитик = Метаданные.Справочники.ИКТ_СобытияОбменаRequest.Реквизиты.ДопАналитика.Тип; 
	
	СобытиеСсылка = РезультатСобытияОбмена.СобытиеПоОбъекту;
	
	Если Не ЗначениеЗаполнено(РезультатСобытияОбмена.СобытиеПоОбъекту) Тогда  
		
		Если ТипыДопАналитик.СодержитТип(ТипЗнч(ОснованиеСобытияОбъект.Ссылка))
			И Не ЗначениеЗаполнено(РезультатСобытияОбмена.СобытиеПоАналитике) Тогда
			
			//Записывается тип, который создается при проведении документа. При этом изменяться или добавляться может и самостоятельно
			Возврат;
			
		КонецЕсли;
		
		СобытиеОбъект = Справочники.ИКТ_СобытияОбменаRequest.СоздатьЭлемент();
		СобытиеОбъект.ТипСобытия = ТипСобытия;
		СобытиеОбъект.ОснованиеСобытия = ОснованиеСобытияОбъект.Ссылка; 
		СобытиеОбъект.ДопАналитика = ДопАналитика;
		СобытиеОбъект.ДатаСобытия = ДатаСобытия;
		СобытиеОбъект.Записать(); 
		
		СобытиеСсылка = СобытиеОбъект.Ссылка;
		
		Если Не ЗначениеЗаполнено(РезультатСобытияОбмена.СобытиеПоАналитике) Тогда
			
			//нет события по объекту записи и по его аналитике. Идет добавление
			ДействиеОбмена = Перечисления.ИКТ_ДействияОбмена.Добавление; 
			
		Иначе
			
			//Запись доп. аналитики уже была. Идет изменение
			ДействиеОбмена = Перечисления.ИКТ_ДействияОбмена.Изменение;
			
		КонецЕсли;
		
	ИначеЕсли ОснованиеСобытияОбъект.ДополнительныеСвойства.ИКТ_ЭтоУдаление = Истина Тогда
		
		ДействиеОбмена = Перечисления.ИКТ_ДействияОбмена.Удаление;       
		
	ИначеЕсли ОснованиеСобытияОбъект.ДополнительныеСвойства.ИКТ_Модифицированность Тогда
		
		ДействиеОбмена = Перечисления.ИКТ_ДействияОбмена.Изменение;
		
	КонецЕсли; 
	
	Если ДействиеОбмена = Неопределено Тогда
		Возврат;
	КонецЕсли;   
	
	Если ДействиеОбмена = Перечисления.ИКТ_ДействияОбмена.Изменение Тогда
		
		//При неправильном формировании данных могло не быть сообщения, а событие добавилось. Необходимо проверить дополнительно журнал
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИКТ_RequestЖурналОбменаСобытиями.Событие КАК Событие
			|ИЗ
			|	РегистрСведений.ИКТ_RequestЖурналОбменаСобытиями КАК ИКТ_RequestЖурналОбменаСобытиями
			|ГДЕ
			|	ИКТ_RequestЖурналОбменаСобытиями.Событие = &Событие";
		
		Запрос.УстановитьПараметр("Событие", СобытиеСсылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Если НЕ ТипЗнч(СобытиеСсылка.ОснованиеСобытия) = Тип("СправочникСсылка.ШтатноеРасписание") Тогда
				ДействиеОбмена = Перечисления.ИКТ_ДействияОбмена.Добавление;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыСообщения = ИКТ_RequestСерверСлужебный.ПодготовитьПараметрыСообщения();
	ПараметрыСообщения.ДействиеОбмена         = ДействиеОбмена;
	ПараметрыСообщения.ОснованиеСобытияОбъект = ОснованиеСобытияОбъект;
	ПараметрыСообщения.ДопАналитика           = ДопАналитика;
	ПараметрыСообщения.ИмяСобытия             = ИмяСобытия;
	ПараметрыСообщения.СобытиеСсылка          = СобытиеСсылка;
	
	СообщениеОбмена = ИКТ_RequestСерверСлужебный.ПодготовитьСообщениеОбменаПоОснованиюСобытия(ПараметрыСообщения, Отказ);

	Если Не ЗначениеЗаполнено(СообщениеОбмена) Тогда  
		
		Отказ = Истина;  
		
	КонецЕсли;
	
	Если Отказ = Ложь Тогда
		
		РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(ТекущаяДатаСеанса(), СобытиеСсылка, ДействиеОбмена, СообщениеОбмена,,,,,ИмяСобытия);
		
	КонецЕсли; 
	
КонецПроцедуры  

Процедура ПроверитьВозможностьПроведенияУвольнения(Источник, Отказ)
	
	МассивСотрудников = Новый Массив;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Увольнение") Тогда
		
		МассивСотрудников.Добавить(Источник.Сотрудник);
		
	Иначе
		
		МассивСотрудников = Источник.Сотрудники.ВыгрузитьКолонку("Сотрудник");
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТ_УвольняемыеФизЛица
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|ГДЕ
		|	Сотрудники.Ссылка В(&МассивСотрудников)
		|
		|СГРУППИРОВАТЬ ПО
		|	Сотрудники.ФизическоеЛицо
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Представление(ВТ_УвольняемыеФизЛица.ФизическоеЛицо) КАК ФизическоеЛицо
		|ИЗ
		|	ВТ_УвольняемыеФизЛица КАК ВТ_УвольняемыеФизЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИКТ_RequestСобытияУвольнения КАК ИКТ_RequestСобытияУвольнения
		|		ПО ВТ_УвольняемыеФизЛица.ФизическоеЛицо = ИКТ_RequestСобытияУвольнения.ФизическоеЛицо
		|			И (ИКТ_RequestСобытияУвольнения.ПометкаУдаления = ЛОЖЬ)
		|ГДЕ
		|	ИКТ_RequestСобытияУвольнения.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		//Отказ = Истина; //Временно
		
		ШаблонСообщения = НСтр("ru = 'Для сотрудника %1 не найден процесс увольнения в Request'");
	
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Выборка.ФизическоеЛицо));
		КонецЦикла;
	
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьСоостояниеОбменаСРеквестПоОбъекту(ОбъектСсылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.ИнформацияОбОшибке КАК ИнформацияОбОшибке,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Выгружен КАК Выгружен,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Ошибка КАК Ошибка,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Период КАК Период,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Действие КАК Действие
		|ПОМЕСТИТЬ ВТ_ЖурналСобытий
		|ИЗ
		|	РегистрСведений.ИКТ_RequestЖурналОбменаСобытиями.СрезПоследних(
		|			,
		|			Событие.ОснованиеСобытия = &ОбъектСсылка
		|				И Событие.ПометкаУдаления = ЛОЖЬ) КАК ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.ИнформацияОбОшибке,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Выгружен,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Ошибка,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Период,
		|	ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних.Действие
		|ИЗ
		|	РегистрСведений.ИКТ_RequestЖурналОбменаСобытиями.СрезПоследних(
		|			,
		|			Событие.ДопАналитика = &ОбъектСсылка
		|				И Событие.ПометкаУдаления = ЛОЖЬ) КАК ИКТ_RequestЖурналОбменаСобытиямиСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_ЖурналСобытий.ИнформацияОбОшибке КАК ИнформацияОбОшибке,
		|	ВТ_ЖурналСобытий.Выгружен КАК Выгружен,
		|	ВТ_ЖурналСобытий.Ошибка КАК Ошибка,
		|	ВТ_ЖурналСобытий.Период КАК Период,
		|	ВТ_ЖурналСобытий.Действие КАК Действие
		|ИЗ
		|	ВТ_ЖурналСобытий КАК ВТ_ЖурналСобытий
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
	
	Результат = Новый Структура("Период,Действие,Выгружен,Ошибка,ИнформацияОбОшибке",
		'00010101',
		Перечисления.ИКТ_ДействияОбмена.ПустаяСсылка(),
		Ложь,
		Ложь,
		"");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;;
	
	Возврат Результат;
	
КонецФункции

Процедура ИКТ_ДобавитьЭлементыСостоянияРеквестНаФорму(Форма, ЭлементДляСвязи = Неопределено, Родитель = Неопределено) Экспорт 
	
	Если Форма.Элементы.найти("ИКТ_СостояниеОбменаRequest") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИКТ_СостояниеОбменаRequest", Новый ОписаниеТипов("Строка"),,"Обмен с Request"));
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Если ЭлементДляСвязи = Неопределено И Родитель = Неопределено Тогда
		НовыйЭлемент = Форма.Элементы.Добавить("ИКТ_СостояниеОбменаRequest", Тип("ПолеФормы"), Форма);
	ИначеЕсли ЭлементДляСвязи = Неопределено И Родитель <> Неопределено Тогда
		НовыйЭлемент = Форма.Элементы.Добавить("ИКТ_СостояниеОбменаRequest", Тип("ПолеФормы"), Родитель);
	Иначе 
		НовыйЭлемент = Форма.Элементы.Вставить("ИКТ_СостояниеОбменаRequest", Тип("ПолеФормы"), ЭлементДляСвязи.Родитель, ЭлементДляСвязи);
	КонецЕсли;       
	
	НовыйЭлемент.ПутьКДанным = "ИКТ_СостояниеОбменаRequest";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.Гиперссылка = Истина;
	
