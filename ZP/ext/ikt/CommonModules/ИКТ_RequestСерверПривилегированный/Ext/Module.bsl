	Если Не ЗначениеЗаполнено(СообщениеОбмена) Тогда		
		Отказ = Истина;     	
	КонецЕсли;
	
	Если Отказ = Ложь Тогда 	
		РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(ТекущаяДатаСеанса(), СобытиеСсылка, ДействиеОбмена, СообщениеОбмена,,,,,ИмяСобытия); 	
	КонецЕсли; 
	
	//Замещения.
	
	ДействиеОбмена   = Перечисления.ИКТ_ДействияОбмена.Добавление;
	СобытиеСсылка    = Справочники.ИКТ_СобытияОбменаRequest.НайтиПоКоду("00000000002"); 
	ОснованиеСобытия = СобытиеСсылка;
	ИмяСобытия       = "Замещения";
	
	ПараметрыСообщения = ИКТ_RequestСерверСлужебный.ПодготовитьПараметрыСообщения();
	ПараметрыСообщения.ДействиеОбмена         = ДействиеОбмена;
	ПараметрыСообщения.ОснованиеСобытияОбъект = ОснованиеСобытия;
	ПараметрыСообщения.ИмяСобытия             = ИмяСобытия;
	ПараметрыСообщения.СобытиеСсылка          = СобытиеСсылка;
	
	СообщениеОбмена = ИКТ_RequestСерверСлужебный.ПодготовитьСообщениеОбменаПоОснованиюСобытия(ПараметрыСообщения, Отказ);
	
	Если Не ЗначениеЗаполнено(СообщениеОбмена) Тогда		
		Отказ = Истина;     	
	КонецЕсли;
	
	Если Отказ = Ложь Тогда 	
		РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(ТекущаяДатаСеанса(), СобытиеСсылка, ДействиеОбмена, СообщениеОбмена,,,,,ИмяСобытия); 	
	КонецЕсли;  
	
КонецПроцедуры    

Процедура ВыполнитьОтправкуСобытия(ПараметрыСоединения, ТокенАвторизации, ДанныеСобытия)
	
	Соединение = Новый HTTPСоединение(ПараметрыСоединения.АдресСервера);  
	
	ПараметрыСообщения                        = ИКТ_RequestСерверСлужебный.ПодготовитьПараметрыСообщения();
	ПараметрыСообщения.ДействиеОбмена         = ДанныеСобытия.Действие;
	ПараметрыСообщения.ОснованиеСобытияОбъект = ДанныеСобытия.ОснованиеСобытия;
	ПараметрыСообщения.ДопАналитика           = ДанныеСобытия.ДопАналитика;
	ПараметрыСообщения.ИмяСобытия             = ДанныеСобытия.ИмяСобытия;
	ПараметрыСообщения.СобытиеСсылка          = ДанныеСобытия.Событие;
	
	Отказ = Ложь;
	
	СообщениеОбмена = ИКТ_RequestСерверСлужебный.ПодготовитьСообщениеОбменаПоОснованиюСобытия(ПараметрыСообщения, Отказ);
	
	Если Отказ ИЛИ Не ЗначениеЗаполнено(СообщениеОбмена) Тогда 
		
		РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(
			ТекущаяДатаСеанса(),
			ДанныеСобытия.Событие,
			ДанныеСобытия.Действие,
			СообщениеОбмена,
			"Не удалось сформировать сообщение обмена в базе 1С",
			ДанныеСобытия.КоличествоПопыток + 1,
			,
			Истина,
			ДанныеСобытия.ИмяСобытия); 
			
		Возврат; 
		
	КонецЕсли;
	
	Запрос = ПолучитьHTTPЗапросПоТипуСобытия(ДанныеСобытия.ТипСобытия, СообщениеОбмена, ТокенАвторизации); 
	
	Если Запрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	
	Если Ответ.КодСостояния = 200 Тогда
		
		СообщениеОтвет = Ответ.ПолучитьТелоКакСтроку(); 
		ДанныеСообщения = ИКТ_RequestСерверСлужебный.ПрочитатьТекстJSON(, СообщениеОтвет);
		КлючСообщения = ДанныеСообщения.Получить("key");
			
		Если Не ЗначениеЗаполнено(КлючСообщения) И ДанныеСообщения.Получить("value") <> Неопределено Тогда
			
			ИнформацияОбОшибке = "Код состояния: " + Ответ.КодСостояния;
			ИнформацияОбОшибке = ИнформацияОбОшибке + символы.ПС + ДанныеСообщения.Получить("value");
			
			РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(
				ТекущаяДатаСеанса(),
				ДанныеСобытия.Событие,
				ДанныеСобытия.Действие,
				СообщениеОбмена,
				ИнформацияОбОшибке,
				ДанныеСобытия.КоличествоПопыток + 1,
				,
				Истина,
				ДанныеСобытия.ИмяСобытия,
				СообщениеОтвет); 

		Иначе				
							
			РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(
				ТекущаяДатаСеанса(),
				ДанныеСобытия.Событие,
				ДанныеСобытия.Действие,
				СообщениеОбмена,
				,
				ДанныеСобытия.КоличествоПопыток + 1,
				Истина,
				,
				ДанныеСобытия.ИмяСобытия,
				СообщениеОтвет); 
				
		КонецЕсли;			
			
	Иначе  
			
		ИнформацияОбОшибке = "Код состояния: " + Ответ.КодСостояния;
		ИнформацияОбОшибке = ИнформацияОбОшибке + символы.ПС + Ответ.ПолучитьТелоКакСтроку();
		
		РегистрыСведений.ИКТ_RequestЖурналОбменаСобытиями.ДобавитьЗаписьВЖурналОбмена(
			ТекущаяДатаСеанса(),
			ДанныеСобытия.Событие,
			ДанныеСобытия.Действие,
			СообщениеОбмена,
			ИнформацияОбОшибке,
			ДанныеСобытия.КоличествоПопыток + 1,
			,
			Истина,
			ДанныеСобытия.ИмяСобытия);
			
	КонецЕсли;
			
	
КонецПроцедуры

Функция ПолучитьHTTPЗапросПоТипуСобытия(ТипСобытия, ТелоЗапроса, ТокенАвторизации)
	
	Результат = Неопределено;
	
	Если ТипСобытия = Перечисления.ИКТ_RequestТипыСобытий.Должности Тогда  
		
		Результат = Новый HTTPЗапрос("api/v1/Dictionary/Positions");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		
	ИначеЕсли ТипСобытия = Перечисления.ИКТ_RequestТипыСобытий.ШтатноеРасписание Тогда 
		
		Результат = Новый HTTPЗапрос("api/v1/Dictionary/StaffStructure");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		
	ИначеЕсли ТипСобытия = Перечисления.ИКТ_RequestТипыСобытий.Сотрудники Тогда
		
		Результат = Новый HTTPЗапрос("api/v1/Dictionary/Users");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		
	ИначеЕсли ТипСобытия = Перечисления.ИКТ_RequestТипыСобытий.ЭскалацияСвязей Тогда
		
		Результат = Новый HTTPЗапрос("api/v1/Dictionary/PositionsRel");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);  
			
	ИначеЕсли ТипСобытия = Перечисления.ИКТ_RequestТипыСобытий.Замещения Тогда
		
		Результат = Новый HTTPЗапрос("api/v1/Dictionary/Deputies");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		
	ИначеЕсли ТипСобытия = Перечисления.ИКТ_RequestТипыСобытий.СозданиеИзменениеДоговора Тогда
		
		Результат = Новый HTTPЗапрос("api/v1/Process/EventWithFilesAsync");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		
	Иначе
		
		//Событие формата Event
		
		Результат = Новый HTTPЗапрос("api/v1/Process/Event");
		Результат.Заголовки.Вставить("accept","text/plain");
		Результат.Заголовки.Вставить("Content-Type","application/json-patch+json"); 
		Результат.Заголовки.Вставить("Authorization", СтрШаблон("Bearer %1", ТокенАвторизации)); 
		
		Результат.УстановитьТелоИзСтроки(ТелоЗапроса);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТокенАвторизации(ПараметрыСоединения, Отказ)
	
	Результат = "";
	
	Соединение = Новый HTTPСоединение(ПараметрыСоединения.АдресСервера);
	
	АдресЗапроса = СтрШаблон("api/v1/Users/Authenticate?username=%1&password=%2", ПараметрыСоединения.Логин, ПараметрыСоединения.Пароль);
	
	Запрос = Новый HTTPЗапрос(АдресЗапроса);
	Запрос.Заголовки.Вставить("accept", "text/plain");
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		
	Если Ответ.КодСостояния = 200 Тогда
		
		ДанныеАвторизаци = ИКТ_RequestСерверСлужебный.ПрочитатьТекстJSON(,Ответ.ПолучитьТелоКакСтроку());
		
		Результат = ДанныеАвторизаци["token"];
		
	Иначе
		
		Отказ = Истина;
		ЗаписьЖурналаРегистрации("ОбменДаннымиRequest", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка авторизации. Код состовния: " + Ответ.КодСостояния);
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции 

#КонецОбласти  

Функция ЭтоТипСобытияСОжиданиемРешения(ТипСобытия) 
	
	МассивТиповСобытийСОжиданиемРешения = Новый Массив;
	МассивТиповСобытийСОжиданиемРешения.Добавить(Перечисления.ИКТ_RequestТипыСобытий.СозданиеИзменениеДоговора);
	МассивТиповСобытийСОжиданиемРешения.Добавить(Перечисления.ИКТ_RequestТипыСобытий.РаботаНеПоГрафику);
	
	Возврат МассивТиповСобытийСОжиданиемРешения.Найти(ТипСобытия) <> Неопределено
	
КонецФункции

Функция СобытиеПоОрганизацииУОС(Источник, Организация)
	
	Результат = Истина;
	
	Организация = Неопределено;
	
	Если Источник.Метаданные().Реквизиты.Найти("Организация") <> Неопределено Тогда
		
		Если Не ИКТ_ЗП_УОС.ЭтоУОС(Источник.Организация) Тогда
			Результат = Ложь;
		КонецЕсли; 
		
		Организация = Источник.Организация;
		
	ИначеЕсли Источник.Метаданные().Реквизиты.Найти("ГоловнаяОрганизация") <> Неопределено Тогда
		
		Если Не ИКТ_ЗП_УОС.ЭтоУОС(Источник.ГоловнаяОрганизация) Тогда
			Результат = Ложь;
		КонецЕсли; 
		
		Организация = Источник.ГоловнаяОрганизация;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Процедура ИКТ_RequestОбработкаПроверкиЗаполнения(Источник, Отказ, ПроверяемыеРеквизиты) Экспорт
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.Увольнение") 
		Или ТипЗнч(Источник) = Тип("ДокументОбъект.УвольнениеСписком") Тогда 
		
		Если ИКТ_ЗП_УОС.ЭтоУОС(Источник.Организация) Тогда

			ПроверитьВозможностьПроведенияУвольнения(Источник, Отказ);
			
		КонецЕсли
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ИКТ_RequestПроверкаВремениРаботыСотрудников() Экспорт
	
	ДатаОкончания = НачалоДня(ТекущаяДатаСеанса()) - 1;
	ДатаНачала = НачалоДня(ДатаОкончания - 3600 * 24 * 6);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Сотрудник", Неопределено);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИКТ_СоответствиеОбъектов.ОбъектУУ КАК ОбъектУУ
	               |ПОМЕСТИТЬ ВТ_ОрганизацииУОС
	               |ИЗ
	               |	РегистрСведений.ИКТ_СоответствиеОбъектов КАК ИКТ_СоответствиеОбъектов
	               |ГДЕ
	               |	ИКТ_СоответствиеОбъектов.ОбъектБУ ССЫЛКА Справочник.Организации
	               |	И ИКТ_СоответствиеОбъектов.ОбъектУУ ССЫЛКА Справочник.Организации
	               |	И ИКТ_СоответствиеОбъектов.ОбъектУУ <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СостоянияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	               |	МАКСИМУМ(СостоянияСотрудниковСрезПоследних.Период) КАК Период
	               |ПОМЕСТИТЬ ВТ_ДатаПоследнегоСостояния
	               |ИЗ
	               |	РегистрСведений.СостоянияСотрудников.СрезПоследних(
	               |			&ДатаОкончания,
	               |			Сотрудник.ГоловнаяОрганизация В
	               |					(ВЫБРАТЬ
	               |						ВТ_ОрганизацииУОС.ОбъектУУ
	               |					ИЗ
	               |						ВТ_ОрганизацииУОС)
	               |				И Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Работа), ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Увольнение))) КАК СостоянияСотрудниковСрезПоследних
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СостоянияСотрудниковСрезПоследних.Сотрудник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СостоянияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	               |	&ДатаНачала КАК ДатаНачала,
	               |	&ДатаОкончания КАК ДатаОкончания 
	               |ПОМЕСТИТЬ ВТСотрудники
	               |ИЗ
	               |	РегистрСведений.СостоянияСотрудников.СрезПоследних(
	               |			&ДатаОкончания,
	               |			Сотрудник.ГоловнаяОрганизация В
	               |					(ВЫБРАТЬ
	               |						ВТ_ОрганизацииУОС.ОбъектУУ
	               |					ИЗ
	               |						ВТ_ОрганизацииУОС)
	               |				И Состояние В (ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Работа), ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Увольнение))) КАК СостоянияСотрудниковСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатаПоследнегоСостояния КАК ВТ_ДатаПоследнегоСостояния
	               |		ПО (ВТ_ДатаПоследнегоСостояния.Период = СостоянияСотрудниковСрезПоследних.Период)
	               |			И (ВТ_ДатаПоследнегоСостояния.Сотрудник = СостоянияСотрудниковСрезПоследних.Сотрудник)
	               |ГДЕ
	               |	СостоянияСотрудниковСрезПоследних.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияСотрудника.Работа)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СостоянияСотрудниковСрезПоследних.Сотрудник";
	
	Запрос.Выполнить();
	
	ПараметрыЗаполнения = УчетРабочегоВремениРасширенный.ПараметрыДляЗапросВТДанныеУчетаВремениИСостоянийСотрудников();
	ПараметрыЗаполнения.ИмяВТСотрудники = "ВТСотрудники";
	ПараметрыЗаполнения.ИмяВТРезультат = "ВТДанныеУчетаВремени";
	ПараметрыЗаполнения.РассчитыватьПлановоеВремя = Ложь;
	ПараметрыЗаполнения.ДатаАктуальности  = ДатаОкончания;
	ПараметрыЗаполнения.ДатаНачала = ДатаНачала;
	ПараметрыЗаполнения.ДатаОкончания = ДатаОкончания;
	ПараметрыЗаполнения.МесяцДатаНачала = НачалоМесяца(ПараметрыЗаполнения.ДатаНачала);
	ПараметрыЗаполнения.МесяцДатаОкончания = КонецМесяца(ПараметрыЗаполнения.ДатаОкончания);
	ПараметрыЗаполнения.ВыделятьВыходныеВПериодыОтклонений = Ложь;
	ПараметрыЗаполнения.ПолучатьУсловияТрудаИТерритории = Истина;
	УчетРабочегоВремениРасширенный.СоздатьВТДанныеУчетаВремениИСостоянийСотрудников(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыЗаполнения);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТДанныеУчетаВремениПоСостояниям.ВидУчетаВремени КАК ВидУчетаВремени,
	|	ВТДанныеУчетаВремениПоСостояниям.Дата КАК Дата,
	|	ВТДанныеУчетаВремениПоСостояниям.Дни КАК Дни,
	|	ВТДанныеУчетаВремениПоСостояниям.НормаЧасов КАК НормаЧасов,
	|	ВТДанныеУчетаВремениПоСостояниям.Отклонение КАК Отклонение,
	|	ВТДанныеУчетаВремениПоСостояниям.ПереходящаяЧастьПредыдущейСмены КАК ПереходящаяЧастьПредыдущейСмены,
	|	ВТДанныеУчетаВремениПоСостояниям.ПереходящаяЧастьТекущейСмены КАК ПереходящаяЧастьТекущейСмены,
	|	ВТДанныеУчетаВремениПоСостояниям.Смена КАК Смена,
	|	ВЫРАЗИТЬ(ВТДанныеУчетаВремениПоСостояниям.Сотрудник КАК Справочник.Сотрудники) КАК Сотрудник,
	|	ВТДанныеУчетаВремениПоСостояниям.Территория КАК Территория,
	|	ВТДанныеУчетаВремениПоСостояниям.УсловияТруда КАК УсловияТруда,
	|	ВТДанныеУчетаВремениПоСостояниям.Часы КАК Часы
	|ПОМЕСТИТЬ ВТ_ДниРаботыСотрудникаБезГруппировки
	|ИЗ
	|	ВТДанныеУчетаВремениПоСостояниям КАК ВТДанныеУчетаВремениПоСостояниям
	|ГДЕ
	|	ВТДанныеУчетаВремениПоСостояниям.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДниРаботыСотрудникаБезГруппировки.Дата КАК Дата,
	|	ВЫРАЗИТЬ(ВТ_ДниРаботыСотрудникаБезГруппировки.Сотрудник КАК Справочник.Сотрудники) КАК Сотрудник
	|ПОМЕСТИТЬ ВТ_ДниРаботыСотрудника
	|ИЗ
	|	ВТ_ДниРаботыСотрудникаБезГруппировки КАК ВТ_ДниРаботыСотрудникаБезГруппировки
	|ГДЕ
	|	ВТ_ДниРаботыСотрудникаБезГруппировки.ВидУчетаВремени В(&ВидУчетаВремениРаботаВОфисе)
	|	И ВТ_ДниРаботыСотрудникаБезГруппировки.Сотрудник.ИКТ_НеСоздаватьИнцидентыКРВ = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ВТ_ДниРаботыСотрудникаБезГруппировки.Сотрудник КАК Справочник.Сотрудники),
	|	ВТ_ДниРаботыСотрудникаБезГруппировки.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДниРаботыСотрудникаБезГруппировки.Дата КАК Дата,
	|	ВЫРАЗИТЬ(ВТ_ДниРаботыСотрудникаБезГруппировки.Сотрудник КАК Справочник.Сотрудники) КАК Сотрудник
	|ПОМЕСТИТЬ ВТ_ДниОтсутсвияСотрудника
	|ИЗ
	|	ВТ_ДниРаботыСотрудникаБезГруппировки КАК ВТ_ДниРаботыСотрудникаБезГруппировки
	|ГДЕ
	|	НЕ ВТ_ДниРаботыСотрудникаБезГруппировки.ВидУчетаВремени В (&ВидУчетаВремениРаботаВОфисе)
	|	И ВТ_ДниРаботыСотрудникаБезГруппировки.Сотрудник.ИКТ_НеСоздаватьИнцидентыКРВ = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ВТ_ДниРаботыСотрудникаБезГруппировки.Сотрудник КАК Справочник.Сотрудники),
	|	ВТ_ДниРаботыСотрудникаБезГруппировки.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИТК_ВводДанныхСКУДВходыВыходы.Ссылка.Организация КАК Организация,
	|	ИТК_ВводДанныхСКУДВходыВыходы.Сотрудник КАК Сотрудник,
	|	ИТК_ВводДанныхСКУДВходыВыходы.Дата КАК Дата,
	|	ИТК_ВводДанныхСКУДВходыВыходы.ПервыйВход КАК ПервыйВход,
	|	ИТК_ВводДанныхСКУДВходыВыходы.ПоследнийВыход КАК ПоследнийВыход,
	|	КОНЕЦПЕРИОДА(ИТК_ВводДанныхСКУДВходыВыходы.Дата, ДЕНЬ) КАК КонецДня,
	|	ИТК_ВводДанныхСКУДВходыВыходы.ОтработаноЧасов + ИТК_ВводДанныхСКУДВходыВыходы.ЧасыВнеОфиса КАК ОтработаноЧасов,
	|	ИТК_ВводДанныхСКУДВходыВыходы.ЧасыВнеОфиса КАК ЧасыВнеОфиса,
	|	ИТК_ВводДанныхСКУДВходыВыходы.ОтработаноВремени КАК ОтработаноВремени
	|ПОМЕСТИТЬ ВТ_ДанныеСКУД
	|ИЗ
	|	Документ.ИТК_ВводДанныхСКУД.ВходыВыходы КАК ИТК_ВводДанныхСКУДВходыВыходы
	|ГДЕ
	|	ИТК_ВводДанныхСКУДВходыВыходы.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ИТК_ВводДанныхСКУДВходыВыходы.Ссылка.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГрафикРаботыСотрудников.Сотрудник КАК Сотрудник,
	|	ГрафикРаботыСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	ГрафикРаботыСотрудников.Период КАК Период,
	|	ГрафикРаботыСотрудников.ГрафикРаботы КАК ГрафикРаботы
	|ПОМЕСТИТЬ ВТ_ГрафикиРаботы
	|ИЗ
	|	РегистрСведений.ГрафикРаботыСотрудников КАК ГрафикРаботыСотрудников
	|ГДЕ
	|	(ГрафикРаботыСотрудников.Сотрудник, ГрафикРаботыСотрудников.ГоловнаяОрганизация) В
	|			(ВЫБРАТЬ
	|				ВТ_ДанныеСКУД.Сотрудник,
	|				ВТ_ДанныеСКУД.Организация
	|			ИЗ
	|				ВТ_ДанныеСКУД)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСКУД.Организация КАК Организация,
	|	ВТ_ДанныеСКУД.Сотрудник КАК Сотрудник,
	|	ВТ_ДанныеСКУД.Дата КАК Дата,
	|	ВТ_ДанныеСКУД.ПервыйВход КАК ПервыйВход,
	|	ВТ_ДанныеСКУД.ПоследнийВыход КАК ПоследнийВыход,
	|	ВТ_ДанныеСКУД.КонецДня КАК КонецДня,
	|	МАКСИМУМ(ВТ_ГрафикиРаботы.Период) КАК Период,
	|	ВТ_ДанныеСКУД.ОтработаноЧасов КАК ОтработаноЧасов,
	|	ВТ_ДанныеСКУД.ЧасыВнеОфиса КАК ЧасыВнеОфиса,
	|	ВТ_ДанныеСКУД.ОтработаноВремени КАК ОтработаноВремени
	|ПОМЕСТИТЬ ВТ_ДанныеСКУД_ДатаГрафика
	|ИЗ
	|	ВТ_ДанныеСКУД КАК ВТ_ДанныеСКУД
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГрафикиРаботы КАК ВТ_ГрафикиРаботы
	|		ПО (ВТ_ГрафикиРаботы.Сотрудник = ВТ_ДанныеСКУД.Сотрудник)
	|			И (ВТ_ГрафикиРаботы.ГоловнаяОрганизация = ВТ_ДанныеСКУД.Организация)
	|			И (ВТ_ГрафикиРаботы.Период < ВТ_ДанныеСКУД.КонецДня)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеСКУД.Организация,
	|	ВТ_ДанныеСКУД.Сотрудник,
	|	ВТ_ДанныеСКУД.Дата,
	|	ВТ_ДанныеСКУД.ПервыйВход,
	|	ВТ_ДанныеСКУД.ПоследнийВыход,
	|	ВТ_ДанныеСКУД.КонецДня,
	|	ВТ_ДанныеСКУД.ОтработаноЧасов,
	|	ВТ_ДанныеСКУД.ЧасыВнеОфиса,
	|	ВТ_ДанныеСКУД.ОтработаноВремени
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСКУД_ДатаГрафика.Организация КАК Организация,
	|	ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник КАК Сотрудник,
	|	ВТ_ДанныеСКУД_ДатаГрафика.Дата КАК Дата,
	|	ВТ_ДанныеСКУД_ДатаГрафика.ПервыйВход КАК ПервыйВход,
	|	ВТ_ДанныеСКУД_ДатаГрафика.ПоследнийВыход КАК ПоследнийВыход,
	|	ВТ_ДанныеСКУД_ДатаГрафика.КонецДня КАК КонецДня,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ВремяНачалаРаботы = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА &ИКТ_ВремяНачалаРаботы
	|		ИНАЧЕ ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ВремяНачалаРаботы
	|	КОНЕЦ КАК ИКТ_ВремяНачалаРаботы,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ВремяОкончанияРаботы = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА &ИКТ_ВремяОкончанияРаботы
	|		ИНАЧЕ ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ВремяОкончанияРаботы
	|	КОНЕЦ КАК ИКТ_ВремяОкончанияРаботы,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ОбщаяДлительностьПерерывов = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА &ИКТ_ОбщаяДлительностьПерерывов
	|		ИНАЧЕ ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ОбщаяДлительностьПерерывов
	|	КОНЕЦ КАК ИКТ_ОбщаяДлительностьПерерывов,
	|	ВЫБОР
	|		КОГДА ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ДопустимоеОтклонение = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА &ИКТ_ДопустимоеОтклонение
	|		ИНАЧЕ ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник.ИКТ_ДопустимоеОтклонение
	|	КОНЕЦ КАК ИКТ_ДопустимоеОтклонение,
	|	ВТ_ДанныеСКУД_ДатаГрафика.ОтработаноЧасов КАК ОтработаноЧасов,
	|	ВТ_ДанныеСКУД_ДатаГрафика.ЧасыВнеОфиса КАК ЧасыВнеОфиса,
	|	ВТ_ГрафикиРаботы.ГрафикРаботы КАК ГрафикРаботы,
	|	ВТ_ДанныеСКУД_ДатаГрафика.ОтработаноВремени КАК ОтработаноВремени
	|ПОМЕСТИТЬ ВТ_ДанныеСКУД_ДанныеГрафика
	|ИЗ
	|	ВТ_ДанныеСКУД_ДатаГрафика КАК ВТ_ДанныеСКУД_ДатаГрафика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ГрафикиРаботы КАК ВТ_ГрафикиРаботы
	|		ПО (ВТ_ГрафикиРаботы.Сотрудник = ВТ_ДанныеСКУД_ДатаГрафика.Сотрудник)
	|			И (ВТ_ГрафикиРаботы.ГоловнаяОрганизация = ВТ_ДанныеСКУД_ДатаГрафика.Организация)
	|			И (ВТ_ГрафикиРаботы.Период = ВТ_ДанныеСКУД_ДатаГрафика.Период)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Организация КАК Организация,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник КАК Сотрудник,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Дата КАК ДатаИнцидента,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПервыйВход КАК ПервыйВход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПоследнийВыход КАК ПоследнийВыход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноЧасов КАК ОтработаноЧасов,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ГрафикРаботы КАК ГрафикРаботы,
	|	ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Опоздание) КАК ВидИнцидента,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноВремени КАК ОтработаноВремени
	|ПОМЕСТИТЬ ВТ_ДанныеИнцидентов
	|ИЗ
	|	ВТ_ДанныеСКУД_ДанныеГрафика КАК ВТ_ДанныеСКУД_ДанныеГрафика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДниРаботыСотрудника КАК ВТ_ДниРаботыСотрудника
	|		ПО ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник = ВТ_ДниРаботыСотрудника.Сотрудник
	|			И ВТ_ДанныеСКУД_ДанныеГрафика.Дата = ВТ_ДниРаботыСотрудника.Дата
	|ГДЕ
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВТ_ДанныеСКУД_ДанныеГрафика.ПервыйВход, ДЕНЬ), ВТ_ДанныеСКУД_ДанныеГрафика.ПервыйВход, СЕКУНДА) > РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ВремяНачалаРаботы, СЕКУНДА) + РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ДопустимоеОтклонение, СЕКУНДА)
	|	И ВТ_ДанныеСКУД_ДанныеГрафика.ЧасыВнеОфиса = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Организация,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Дата,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПервыйВход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПоследнийВыход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноЧасов,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ГрафикРаботы,
	|	ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.УходРаньше),
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноВремени
	|ИЗ
	|	ВТ_ДанныеСКУД_ДанныеГрафика КАК ВТ_ДанныеСКУД_ДанныеГрафика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДниРаботыСотрудника КАК ВТ_ДниРаботыСотрудника
	|		ПО ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник = ВТ_ДниРаботыСотрудника.Сотрудник
	|			И ВТ_ДанныеСКУД_ДанныеГрафика.Дата = ВТ_ДниРаботыСотрудника.Дата
	|ГДЕ
	|	РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВТ_ДанныеСКУД_ДанныеГрафика.ПоследнийВыход, ДЕНЬ), ВТ_ДанныеСКУД_ДанныеГрафика.ПоследнийВыход, СЕКУНДА) < РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ВремяОкончанияРаботы, СЕКУНДА) - РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ДопустимоеОтклонение, СЕКУНДА)
	|	И ВТ_ДанныеСКУД_ДанныеГрафика.ЧасыВнеОфиса = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Организация,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Дата,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПервыйВход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПоследнийВыход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноЧасов,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ГрафикРаботы,
	|	ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Недоработка),
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноВремени
	|ИЗ
	|	ВТ_ДанныеСКУД_ДанныеГрафика КАК ВТ_ДанныеСКУД_ДанныеГрафика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДниРаботыСотрудника КАК ВТ_ДниРаботыСотрудника
	|		ПО ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник = ВТ_ДниРаботыСотрудника.Сотрудник
	|			И ВТ_ДанныеСКУД_ДанныеГрафика.Дата = ВТ_ДниРаботыСотрудника.Дата
	|ГДЕ
	|	РАЗНОСТЬДАТ(ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ВремяНачалаРаботы, ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ВремяОкончанияРаботы, СЕКУНДА) / 3600 > ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноЧасов + РАЗНОСТЬДАТ(ДАТАВРЕМЯ(1, 1, 1), ВТ_ДанныеСКУД_ДанныеГрафика.ИКТ_ОбщаяДлительностьПерерывов, СЕКУНДА) / 3600
	|	И ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДниРаботыСотрудника.Сотрудник.ГоловнаяОрганизация,
	|	ВТ_ДниРаботыСотрудника.Сотрудник,
	|	ВТ_ДниРаботыСотрудника.Дата,
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	ДАТАВРЕМЯ(1, 1, 1),
	|	0,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Отсутствие),
	|	ДАТАВРЕМЯ(1, 1, 1)
	|ИЗ
	|	ВТ_ДниРаботыСотрудника КАК ВТ_ДниРаботыСотрудника
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДанныеСКУД_ДанныеГрафика КАК ВТ_ДанныеСКУД_ДанныеГрафика
	|		ПО ВТ_ДниРаботыСотрудника.Дата = ВТ_ДанныеСКУД_ДанныеГрафика.Дата
	|			И ВТ_ДниРаботыСотрудника.Сотрудник = ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник
	|ГДЕ
	|	ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ДниОтсутсвияСотрудника.Сотрудник.ГоловнаяОрганизация,
	|	ВТ_ДниОтсутсвияСотрудника.Сотрудник,
	|	ВТ_ДниОтсутсвияСотрудника.Дата,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПервыйВход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ПоследнийВыход,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноЧасов,
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ГрафикРаботы,
	|	ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.ПриходСОтсутствием),
	|	ВТ_ДанныеСКУД_ДанныеГрафика.ОтработаноВремени
	|ИЗ
	|	ВТ_ДниОтсутсвияСотрудника КАК ВТ_ДниОтсутсвияСотрудника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДанныеСКУД_ДанныеГрафика КАК ВТ_ДанныеСКУД_ДанныеГрафика
	|		ПО ВТ_ДниОтсутсвияСотрудника.Дата = ВТ_ДанныеСКУД_ДанныеГрафика.Дата
	|			И ВТ_ДниОтсутсвияСотрудника.Сотрудник = ВТ_ДанныеСКУД_ДанныеГрафика.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КоличествоСотрудниковСВыходомПоГрафику.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
	|	КоличествоСотрудниковСВыходомПоГрафику.Дата КАК Дата
	|ПОМЕСТИТЬ ВТ_ПроверкаТехСбояСКУД
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_ДниРаботыСотрудника.Дата КАК Дата,
	|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ДниРаботыСотрудника.Сотрудник) КАК КоличествоСотрудников,
	|		ВТ_ДниРаботыСотрудника.Сотрудник.ГоловнаяОрганизация КАК ГоловнаяОрганизация
	|	ИЗ
	|		ВТ_ДниРаботыСотрудника КАК ВТ_ДниРаботыСотрудника
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_ДниРаботыСотрудника.Дата,
	|		ВТ_ДниРаботыСотрудника.Сотрудник.ГоловнаяОрганизация) КАК КоличествоСотрудниковСВыходомПоГрафику
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_ДанныеИнцидентов.Организация КАК Организация,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ДанныеИнцидентов.Сотрудник) КАК КоличествоСотрудников,
	|			ВТ_ДанныеИнцидентов.ДатаИнцидента КАК ДатаИнцидента
	|		ИЗ
	|			ВТ_ДанныеИнцидентов КАК ВТ_ДанныеИнцидентов
	|		ГДЕ
	|			ВТ_ДанныеИнцидентов.ВидИнцидента В (ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Опоздание), ЗНАЧЕНИЕ(Перечисление.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Отсутствие))
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_ДанныеИнцидентов.ДатаИнцидента,
	|			ВТ_ДанныеИнцидентов.Организация) КАК ВЗ_КоличествоСотрудниковСИнцидентами
	|		ПО (НАЧАЛОПЕРИОДА(КоличествоСотрудниковСВыходомПоГрафику.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ВЗ_КоличествоСотрудниковСИнцидентами.ДатаИнцидента, ДЕНЬ))
	|			И КоличествоСотрудниковСВыходомПоГрафику.ГоловнаяОрганизация = ВЗ_КоличествоСотрудниковСИнцидентами.Организация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИКТ_СобытияТехСбойСКУД КАК ИКТ_СобытияТехСбойСКУД
	|		ПО КоличествоСотрудниковСВыходомПоГрафику.Дата = ИКТ_СобытияТехСбойСКУД.ДатаСобытия
	|			И КоличествоСотрудниковСВыходомПоГрафику.ГоловнаяОрганизация = ИКТ_СобытияТехСбойСКУД.Организация
	|			И (ИКТ_СобытияТехСбойСКУД.ПодтвержденоДБ)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА КоличествоСотрудниковСВыходомПоГрафику.КоличествоСотрудников = 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(ВЗ_КоличествоСотрудниковСИнцидентами.КоличествоСотрудников, 0) / КоличествоСотрудниковСВыходомПоГрафику.КоличествоСотрудников
	|		КОНЕЦ * 100 >= &ПроцентИцидентов
	|
	|СГРУППИРОВАТЬ ПО
	|	КоличествоСотрудниковСВыходомПоГрафику.ГоловнаяОрганизация,
	|	КоличествоСотрудниковСВыходомПоГрафику.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеИнцидентов.Организация КАК Организация,
	|	ВТ_ДанныеИнцидентов.Сотрудник КАК Сотрудник,
	|	&ТекущаяДатаСеанса КАК Дата,
	|	ВТ_ДанныеИнцидентов.ДатаИнцидента КАК ДатаИнцидента,
	|	ВТ_ДанныеИнцидентов.ПервыйВход КАК ПервыйВход,
	|	ВТ_ДанныеИнцидентов.ПоследнийВыход КАК ПоследнийВыход,
	|	ВТ_ДанныеИнцидентов.ОтработаноЧасов КАК ОтработаноЧасов,
	|	ВТ_ДанныеИнцидентов.ГрафикРаботы КАК ГрафикРаботы,
	|	ВТ_ДанныеИнцидентов.ВидИнцидента КАК ВидИнцидента,
	|	ВТ_ДанныеИнцидентов.ОтработаноВремени КАК ОтработаноВремени
	|ИЗ
	|	ВТ_ДанныеИнцидентов КАК ВТ_ДанныеИнцидентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИКТ_RequestРаботаНеПоГрафику КАК ИКТ_RequestРаботаНеПоГрафику
	|		ПО ВТ_ДанныеИнцидентов.Организация = ИКТ_RequestРаботаНеПоГрафику.Организация
	|			И ВТ_ДанныеИнцидентов.Сотрудник = ИКТ_RequestРаботаНеПоГрафику.Сотрудник
	|			И ВТ_ДанныеИнцидентов.ДатаИнцидента = ИКТ_RequestРаботаНеПоГрафику.ДатаИнцидента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроверкаТехСбояСКУД КАК ВТ_ПроверкаТехСбояСКУД
	|		ПО ВТ_ДанныеИнцидентов.ДатаИнцидента = ВТ_ПроверкаТехСбояСКУД.Дата
	|			И ВТ_ДанныеИнцидентов.Организация = ВТ_ПроверкаТехСбояСКУД.ГоловнаяОрганизация
	|ГДЕ
	|	ИКТ_RequestРаботаНеПоГрафику.Ссылка ЕСТЬ NULL
	|	И ВТ_ПроверкаТехСбояСКУД.ГоловнаяОрганизация ЕСТЬ NULL
	|ИТОГИ
	|	МАКСИМУМ(Дата),
	|	МАКСИМУМ(ПервыйВход),
	|	МАКСИМУМ(ПоследнийВыход),
	|	МАКСИМУМ(ОтработаноЧасов),
	|	МАКСИМУМ(ГрафикРаботы),
	|	МАКСИМУМ(ОтработаноВремени)
	|ПО
	|	Организация,
	|	Сотрудник,
	|	ДатаИнцидента"; 
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("ТекущаяДатаСеанса", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ПроцентИцидентов", Константы.ИКТ_ПроцентИнцидентовТехСбойСКУД.Получить());
	
	Запрос.УстановитьПараметр("ИКТ_ВремяНачалаРаботы", Константы.ИКТ_ВремяНачалаРаботы.Получить());
	Запрос.УстановитьПараметр("ИКТ_ВремяОкончанияРаботы", Константы.ИКТ_ВремяОкончанияРаботы.Получить());
	Запрос.УстановитьПараметр("ИКТ_ОбщаяДлительностьПерерывов", Константы.ИКТ_ОбщаяДлительностьПерерывов.Получить());
	Запрос.УстановитьПараметр("ИКТ_ДопустимоеОтклонение", Константы.ИКТ_ДопустимоеОтклонение.Получить());
	
	ВидУчетаВремениРаботаВОфисе = Новый Массив;
	ВидУчетаВремениРаботаВОфисе.Добавить(Справочники.ВидыИспользованияРабочегоВремени.Явка);
	ВидУчетаВремениРаботаВОфисе.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РабочееВремя);
	ВидУчетаВремениРаботаВОфисе.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РаботаВРежимеНеполногоВремени);
	ВидУчетаВремениРаботаВОфисе.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РаботаВечерниеЧасы);
	ВидУчетаВремениРаботаВОфисе.Добавить(Справочники.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы);
	
	Запрос.УстановитьПараметр("ВидУчетаВремениРаботаВОфисе", ВидУчетаВремениРаботаВОфисе);
	 
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		ВыборкаСотрудник = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСотрудник.Следующий() Цикл
			
			ВыборкаДата = ВыборкаСотрудник.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДата.Следующий() Цикл
				
				ДокИнцидента = Документы.ИКТ_RequestРаботаНеПоГрафику.СоздатьДокумент();
				ЗаполнитьЗначенияСвойств(ДокИнцидента, ВыборкаДата);   
				
				Выборка = ВыборкаДата.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ДокИнцидента.ВидыИнцидентов.Добавить().ВидИнцидента = Выборка.ВидИнцидента;
					
				КонецЦикла; 
				
				ДокИнцидента.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры