Функция ПроверитьДопуск(Сотрудник, ГруппаДопускаЗоныДоступа)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИКТ_ДопускиКРаботеСрезПоследних.Удостоверение КАК Удостоверение
	|ИЗ
	|	РегистрСведений.ИКТ_ДопускиКРаботе.СрезПоследних(
	|			&ТекущаяДата,
	|			Сотрудник.Ссылка = &Сотрудник
	|				И ГруппаДопуска.ЧисловоеПредставление >= &ЧисловоеПредставлениеГруппыДопускаЗоны
	|				И (СрокДействия >= &ТекущаяДата
	|					И Период <= &ТекущаяДата)
	|				И Удостоверение.ВидУдостоверения.ТипДопуска.Ссылка = &ТипДопускаУдостоверение) КАК ИКТ_ДопускиКРаботеСрезПоследних";
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Запрос.УстановитьПараметр("ЧисловоеПредставлениеГруппыДопускаЗоны",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаДопускаЗоныДоступа,"ЧисловоеПредставление"));
	Запрос.УстановитьПараметр("ТипДопускаУдостоверение",Справочники.ИКТ_ТипыДопуска.Удостоверение.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь
	Иначе
		Возврат Истина
	КонецЕсли;
КонецФункции

Функция ТекущееВремяСовпадаетСоСменой(ГрафикРаботы)
	
	ТекущееВремя = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ГрафикиРаботыПоВидамВремени.Смена КАК Смена
	|ПОМЕСТИТЬ ДниРаботы
	|ИЗ
	|	РегистрСведений.ГрафикиРаботыПоВидамВремени КАК ГрафикиРаботыПоВидамВремени
	|ГДЕ
	|	ГрафикиРаботыПоВидамВремени.ГрафикРаботы.Ссылка = &ГрафикРаботы
	|	И ГрафикиРаботыПоВидамВремени.Дата = &Дата
	|	И ГрафикиРаботыПоВидамВремени.ВидУчетаВремени.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СменыРаботыСотрудниковРасписание.ВремяНачала КАК ВремяНачала,
	|	СменыРаботыСотрудниковРасписание.ВремяОкончания КАК ВремяОкончания,
	|	СменыРаботыСотрудниковРасписание.ПереходящиеЧасы КАК ПереходящиеЧасы
	|ИЗ
	|	ДниРаботы КАК ДниРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СменыРаботыСотрудников.Расписание КАК СменыРаботыСотрудниковРасписание
	|		ПО ДниРаботы.Смена.Ссылка = СменыРаботыСотрудниковРасписание.Ссылка";
	Запрос.УстановитьПараметр("ГрафикРаботы",ГрафикРаботы);
	Запрос.УстановитьПараметр("Дата",НачалоДня(ТекущееВремя));
	Запрос.УстановитьПараметр("Ссылка",Справочники.ВидыИспользованияРабочегоВремени.НайтиПоНаименованию("Явка"));
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь
	Иначе
		ДопустимоеОтклонение = Константы.ИКТ_ВремяОтклоненияОтГрафикаСотрудникаВМин.Получить()*60;
		
		//Обед = 25 час, далее в коде подменяется временем из 24 формата времени
		Обед = 25;
		Доступ = Ложь;
		НачалоТекущегоДня = НачалоДня(ТекущееВремя); 
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПереходящиеЧасы = 0 Тогда
				
				Если (НачалоТекущегоДня + (Час(Выборка.ВремяНачала)*3600)) - ДопустимоеОтклонение <= ТекущееВремя И ТекущееВремя <= (НачалоТекущегоДня + (Час(Выборка.ВремяОкончания)*3600)) + ДопустимоеОтклонение Тогда
					Доступ = Истина;
					Прервать;
				//Время обеда	
				ИначеЕсли ТипЗнч(Обед) = Тип("Число") И Час(ТекущееВремя) >= Обед И (НачалоТекущегоДня + (Час(Выборка.ВремяНачала)*3600)) >= ТекущееВремя Тогда
						Доступ = Истина;
						Прервать;
				ИначеЕсли ТипЗнч(Обед) = Тип("Дата") И ТекущееВремя >= Обед И (НачалоТекущегоДня + (Час(Выборка.ВремяНачала)*3600)) >= ТекущееВремя Тогда
					Доступ = Истина;
					Прервать;
				Иначе
					Обед = НачалоТекущегоДня + (Час(Выборка.ВремяОкончания)*3600);
					Выборка.Следующий();
					//Время обеда
					Если ТекущееВремя >= Обед И НачалоТекущегоДня + (Час(Выборка.ВремяОкончания)*3600) >= ТекущееВремя Тогда
						Доступ = Истина;
					Прервать;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				СледующийДень = КонецДня(ТекущееВремя) + 1;
				
				Если НачалоТекущегоДня + (Час(Выборка.ВремяНачала)*3600) - ДопустимоеОтклонение <= ТекущееВремя Тогда
					Доступ = Истина;
					Прервать;
				ИначеЕсли ТекущееВремя <= СледующийДень + (Час(Выборка.ВремяОкончания)*3600) + ДопустимоеОтклонение Тогда
					Доступ = Истина;
					Прервать;
				ИначеЕсли Выборка.Количество() > 1 Тогда
					Если ТипЗнч(Обед) = Тип("Число") И Обед = Час(Выборка.ВремяОкончания) Тогда 
						Выборка.Следующий();
						//Время обеда
						Если Час(ТекущееВремя) >= Обед И СледующийДень + (Час(Выборка.ВремяНачала)*3600) <= ТекущееВремя Тогда
							Доступ = Истина;
						Прервать;
						КонецЕсли;
					Иначе  
						Обед = СледующийДень + (Час(Выборка.ВремяОкончания)*3600); 
						Выборка.Следующий();
						//Время обеда
						Если ТекущееВремя >= Обед И СледующийДень + (Час(Выборка.ВремяНачала)*3600) <= ТекущееВремя Тогда
							Доступ = Истина;
						Прервать;	
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;		
		КонецЦикла;
		
		Возврат Доступ
	КонецЕсли;
	
КонецФункции	

Функция ТекущаяДатаСовпадаетСРаботойВВыходной(РаботаВВыходныеИПраздничныеДни,Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	РаботаВВыходныеИПраздничныеДниСотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РаботаВВыходныеИПраздничныеДни.Сотрудники КАК РаботаВВыходныеИПраздничныеДниСотрудники
	|ГДЕ
	|	РаботаВВыходныеИПраздничныеДниСотрудники.Дата = &Дата
	|	И РаботаВВыходныеИПраздничныеДниСотрудники.НеРаботал = ЛОЖЬ
	|	И РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Ссылка = &СсылкаСотрудник
	|	И РаботаВВыходныеИПраздничныеДниСотрудники.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Дата",НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("СсылкаСотрудник",Сотрудник);
	Запрос.УстановитьПараметр("Ссылка",РаботаВВыходныеИПраздничныеДни);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь
	Иначе 
		Возврат Истина
	КонецЕсли;	
		
КонецФункции

Функция ЭтоТочкаВходаПредприятия(accessPoint)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИКТ_ЗонаВходаНаПредприятие.Значение.ТочкиДоступа.(
	|		Точка.Код КАК Код
	|	) КАК Значение
	|ИЗ
	|	Константа.ИКТ_ЗонаВходаНаПредприятие КАК ИКТ_ЗонаВходаНаПредприятие";
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Доступ = Ложь;
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ВыборкаЗначениеКонстанты = Выборка.Значение.Выбрать();
		Пока ВыборкаЗначениеКонстанты.Следующий() Цикл	
			Если ВыборкаЗначениеКонстанты.Код = accessPoint Тогда 
				Доступ = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат Доступ;
	КонецЕсли;
	
КонецФункции

