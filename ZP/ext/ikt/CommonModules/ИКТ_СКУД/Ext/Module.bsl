Процедура ЗаписатьТипыСобытий(ОтветТипыСобытий) Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("id",ОбщегоНазначения.ОписаниеТипаЧисло(3));
	ТЗ.Колонки.Добавить("name",ОбщегоНазначения.ОписаниеТипаСтрока(100));
