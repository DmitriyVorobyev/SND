Процедура ОбработатьРС_ИКТ_ДанныеКадровыхДокументовДляСКУД() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Сотрудник КАК Сотрудник,
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Должность КАК Должность,
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Подразделение КАК Подразделение,
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.ГрафикРаботы КАК ГрафикРаботы,
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.КадровыйДокумент КАК КадровыйДокумент,
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД КАК ИКТ_ДанныеКадровыхДокументовДляСКУД
	|ГДЕ
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Дата = &Дата";
	Запрос.УстановитьПараметр("Дата",НачалоДня(ТекущаяДатаСеанса()));
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();	
		Пока Выборка.Следующий() Цикл
			ЗаписьСКУД = НайтиЗаписьСправочникаСКУД(Выборка.Сотрудник);
			Если Не ЗначениеЗаполнено(ЗаписьСКУД) Тогда
				Продолжить
			КонецЕсли;
			НоваяЗаписьСКУД = ЗаписьСКУД.ПолучитьОбъект();
			
			//Отправка в СКУД
			Если ТипЗнч(Выборка.КадровыйДокумент) = Тип("ДокументСсылка.КадровыйПеревод")
				Или	ТипЗнч(Выборка.КадровыйДокумент) = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда 
				Если ЗначениеЗаполнено(Выборка.Должность) Тогда 
					IdПодразделения = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Выборка.Подразделение,Неопределено);
					IdДолжности = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Неопределено,Выборка.Должность);
					IDСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьСКУД,"IDСотрудника"); 
					ОтветСКУД = ИзменитьПодразделениеИДолжностьСотрудникаВСКУД(IDСотрудника,IDПодразделения,IDДолжности);
					Если ОтветСКУД.Выполнено Тогда
						//Запись в Справочник ИКТ_ДоступСКУД
						НоваяЗаписьСКУД.Должность = ?(ЗначениеЗаполнено(Выборка.Должность),Выборка.Должность,НоваяЗаписьСКУД.Должность);
						НоваяЗаписьСКУД.Подразделение = ?(ЗначениеЗаполнено(Выборка.Подразделение),Выборка.Подразделение,НоваяЗаписьСКУД.Подразделение); 
						//Изменение зон и точек доступа
						Если ЗначениеЗаполнено(Выборка.Должность) Тогда	
							СвязанныеЗоныИТочки = ПолучитьСвязанныеЗоныИТочки(Выборка.Должность, Выборка.Подразделение);
							Если СвязанныеЗоныИТочки <> Неопределено Тогда
								НоваяЗаписьСКУД.ЗоныИТочкиДоступа.Загрузить(СвязанныеЗоныИТочки);
							КонецЕсли;
						КонецЕсли;
						
						//Запись в РС ИКТ_ДанныеКадровыхДокументовДляСКУД
						НаборЗаписей = РегистрыСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
						НоваяЗапись = НаборЗаписей.Добавить();
						НоваяЗапись.Сотрудник = Выборка.Сотрудник;
						НоваяЗапись.КадровыйДокумент = Выборка.КадровыйПеревод;
						НоваяЗапись.Дата = Выборка.Дата;
						НоваяЗапись.Обработано = Истина;
						НоваяЗапись.ПричинаОшибки = "";
						НоваяЗапись.Должность = ?(ЗначениеЗаполнено(Выборка.Должность),Выборка.Должность,Справочники.Должности.ПустаяСсылка());
						НоваяЗапись.Подразделение = ?(ЗначениеЗаполнено(Выборка.Подразделение),Выборка.Подразделение,Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
						НоваяЗапись.ГрафикРаботы = ?(ЗначениеЗаполнено(Выборка.ГрафикРаботы),Выборка.ГрафикРаботы,Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка());
						НаборЗаписей.Записать();
					Иначе
						//Запись в РС необработанных записей
						НаборЗаписей = РегистрыСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
						НоваяЗапись = НаборЗаписей.Добавить();
						НоваяЗапись.Сотрудник = Выборка.Сотрудник;
						НоваяЗапись.КадровыйДокумент = Выборка.КадровыйПеревод;
						НоваяЗапись.Дата = Выборка.Дата;
						НоваяЗапись.Обработано = Ложь;
						НоваяЗапись.ПричинаОшибки = ОтветСКУД.ПричинаОшибки;
						НоваяЗапись.Должность = ?(ЗначениеЗаполнено(Выборка.Должность),Выборка.Должность,Справочники.Должности.ПустаяСсылка());
						НоваяЗапись.Подразделение = ?(ЗначениеЗаполнено(Выборка.Подразделение),Выборка.Подразделение,Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
						НоваяЗапись.ГрафикРаботы = ?(ЗначениеЗаполнено(Выборка.ГрафикРаботы),Выборка.ГрафикРаботы,Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка());
						НаборЗаписей.Записать();
					КонецЕсли;
				КонецЕсли;
				НоваяЗаписьСКУД.ГрафикРаботы = ?(ЗначениеЗаполнено(Выборка.ГрафикРаботы),Выборка.ГрафикРаботы,НоваяЗаписьСКУД.ГрафикРаботы);
				
			ИначеЕсли ТипЗнч(Выборка.КадровыйДокумент) = Тип("ДокументСсылка.Увольнение")
				Или	ТипЗнч(Выборка.КадровыйДокумент) = Тип("ДокументСсылка.УвольнениеСписком") Тогда
				НоваяЗаписьСКУД.Увольнение = Выборка.КадровыйДокумент;
				//Запись в РС ИКТ_ДанныеКадровыхДокументовДляСКУД
				НаборЗаписей = РегистрыСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Сотрудник = Выборка.Сотрудник;
				НоваяЗапись.КадровыйДокумент = Выборка.КадровыйПеревод;
				НоваяЗапись.Дата = Выборка.Дата;
				НоваяЗапись.Обработано = Истина;
				НоваяЗапись.ПричинаОшибки = "";
				НоваяЗапись.Должность = ?(ЗначениеЗаполнено(Выборка.Должность),Выборка.Должность,Справочники.Должности.ПустаяСсылка());
				НоваяЗапись.Подразделение = ?(ЗначениеЗаполнено(Выборка.Подразделение),Выборка.Подразделение,Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
				НоваяЗапись.ГрафикРаботы = ?(ЗначениеЗаполнено(Выборка.ГрафикРаботы),Выборка.ГрафикРаботы,Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка());
				НаборЗаписей.Записать();	
			КонецЕсли;
			НоваяЗаписьСКУД.Записать();
		КонецЦикла;
	КонецЕсли;
	
	//Очистка старых записей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД КАК ИКТ_ДанныеКадровыхДокументовДляСКУД
	|ГДЕ
	|	ИКТ_ДанныеКадровыхДокументовДляСКУД.Дата <= &Дата";
	Запрос.УстановитьПараметр("Дата",ТекущаяДатаСеанса()-1209600);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
		НаборЗаписей.Записать();
	КонецЦикла;
	
