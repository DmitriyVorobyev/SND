// Процедура - Получить новые пропуска
// Получает список пропусков из файла формата xls
Процедура ПолучитьНовыеПропуска() Экспорт
	
	//{ИКТ 21.04.2024
	// Примечание: для подчиненного узла не нужно выполнять процедуру
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда 
		Возврат
	КонецЕсли;
	//}ИКТ
	
	ТЗПропуска = ПолучитьСписокПропусковИзФайла();
	Если ТЗПропуска.Количество() Тогда 
		
		ЗапросРСПропуска = Новый Запрос;
		МенеджерВТ = Новый МенеджерВременныхТаблиц;
		ЗапросРСПропуска.МенеджерВременныхТаблиц = МенеджерВТ;
		ЗапросРСПропуска.Текст =
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ТзПропуска.ИдентификаторКарты КАК СТРОКА(10)) КАК ИдентификаторКарты
		|ПОМЕСТИТЬ ВТПропуска
		|ИЗ
		|	&ТзПропуска КАК ТзПропуска
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТПропуска.ИдентификаторКарты КАК ИдентификаторКарты
		|ИЗ
		|	ВТПропуска КАК ВТПропуска
		|ГДЕ
		|	ВТПропуска.ИдентификаторКарты Не В
		|				(ВЫБРАТЬ
		|					ИКТ_Пропуска.ЗначениеКарты КАК ЗначениеКарты
		|				ИЗ
		|					РегистрСведений.ИКТ_Пропуска КАК ИКТ_Пропуска)";
		ЗапросРСПропуска.УстановитьПараметр("ТзПропуска",ТЗПропуска);
		РезультатЗапроса = ЗапросРСПропуска.Выполнить(); 	
		Если РезультатЗапроса.Пустой() Тогда
			Возврат
		КонецЕсли;
		
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ИдентификаторКарты = СокрП(Выборка.ИдентификаторКарты);
			НаборЗаписей = РегистрыСведений.ИКТ_Пропуска.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗначениеКарты.Установить(ИдентификаторКарты);
			
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ЗначениеКарты = ИдентификаторКарты;
			НаборЗаписей.Записать();
		КонецЦикла;
		
	КонецЕсли;	
		
КонецПроцедуры                             

