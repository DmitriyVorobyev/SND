				НоваяЗаписьСпр = Справочники.ИКТ_ТипыСобытийСКУД.СоздатьЭлемент();
				НоваяЗаписьСпр.id = СтрТЗ.id;
				НоваяЗаписьСпр.Наименование = СтрТЗ.name;
				НоваяЗаписьСпр.ОписаниеСобытия = СтрТЗ.description;
				НоваяЗаписьСпр.Записать();
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрТЗ Из ТЗ Цикл
			НоваяЗаписьСпр = Справочники.ИКТ_ТипыСобытийСКУД.СоздатьЭлемент();
			НоваяЗаписьСпр.id = СтрТЗ.id;
			НоваяЗаписьСпр.Наименование = СтрТЗ.name;
			НоваяЗаписьСпр.ОписаниеСобытия = СтрТЗ.description;
			НоваяЗаписьСпр.Записать();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция TimestampВДату(ДатаТС)
	Попытка
		Если ДатаТС = Неопределено Тогда
			ВызватьИсключение("Нет даты");
		КонецЕсли;
		МассДата = СтрРазделить(ДатаТС,"T");
		ВсяДата = МассДата[0];
		МассВремя = СтрРазделить(МассДата[1],"+");
		СтроковаяДата = ВсяДата+" "+МассВремя[0];
		СтроковаяДата = СтрЗаменить(СтроковаяДата , "-","");
		СтроковаяДата = СтрЗаменить(СтроковаяДата , ":","");
		СтроковаяДата = СтрЗаменить(СтроковаяДата , " ","");
		Возврат Дата(СтроковаяДата);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции
