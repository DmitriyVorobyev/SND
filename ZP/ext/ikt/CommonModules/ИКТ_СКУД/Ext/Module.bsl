	//Для запроса данных о событиях прохода из 1С по запросу /api/v1/events
	Попытка
		КолВоСобытий = СобытияПрохода.Количество();
		Если КолВоСобытий = 0 Тогда
			Возврат
		КонецЕсли;
		
		ЗапросТипыСобытий = Новый Запрос;
		ЗапросТипыСобытий.Текст=
		"ВЫБРАТЬ
		|	ИКТ_ТипыСобытийСКУД.id КАК id,
		|	ИКТ_ТипыСобытийСКУД.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ИКТ_ТипыСобытийСКУД КАК ИКТ_ТипыСобытийСКУД";
