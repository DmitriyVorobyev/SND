// Процедура - Создать пропуск для сотрудника
// Создаёт пропуск в ЗУП и СКУД
// Параметры:
//  ПропускаСотрудника	Пропуска - Массив - массив пропусков сотрудника из файла с пропусками
//  Сотрудник			Сотрудник - СправочникСсылка.Сотрудники - Ссылка на сотрудника из справочника Сотрудники
//  IDСотрудника		Id сотрудника - Строка - Id сотрудника из СКУД
//
Процедура СоздатьПропускДляСотрудника(ЗначениеПропуска,Сотрудник,IDСотрудника) Экспорт
	
	СтрукПропуска = Новый Структура;
	//Формат карты шестнадцатеричный
	СтрукПропуска.Вставить("value",ЗначениеПропуска);
	//Формат карты - идентификатор W26
	//СтрукПропуска.Вставить("format","W34");
	СтрукПропуска.Вставить("format","W26");
	
	Попытка
		Ответ = ИКТ_SigurApi.Отправить("cards",,СтрукПропуска);
		Если ТипЗнч(Ответ) = Тип("Число") Тогда
			ФИО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник,"Наименование");
			ВызватьИсключение("СКУД вернул код ошибки: "+Ответ+". Пропуск по сотруднику "+ФИО+" в СКУД не создан!");
		Иначе
			IDКарты = Ответ.id;
		КонецЕсли;
		
		СтрукПривязки = Новый Структура;
		СтрукПривязки.Вставить("employeeId",IDСотрудника);
		СтрукПривязки.Вставить("cardId",IDКарты);
		//Формат карты - идентификатор W26
		//СтрукПривязки.Вставить("format","W34");
		СтрукПривязки.Вставить("format","W26");
		МассивПривязки = Новый Массив;
		МассивПривязки.Добавить(СтрукПривязки);
		
		ОтветПривязка = ИКТ_SigurApi.Отправить("bindings/employees-cards",,МассивПривязки);
		Если ОтветПривязка = 204 Тогда
			НаборЗаписей = РегистрыСведений.ИКТ_Пропуска.СоздатьНаборЗаписей();
			//НаборЗаписей.Отбор.IDПропуска.Установить(IDКарты);
			НаборЗаписей.Отбор.ЗначениеКарты.Установить(ЗначениеПропуска);
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.IDПропуска = IDКарты;
			НоваяЗапись.ЗначениеКарты = ЗначениеПропуска;
			НоваяЗапись.Сотрудник = Сотрудник;
			НоваяЗапись.Действует = Истина;
			НаборЗаписей.Записать();
			ОбщегоНазначения.СообщитьПользователю("Пропуск выдан сотруднику.");
		ИначеЕсли Ответ = 422 Тогда
			ЗаписьЖурналаРегистрации("Регистрация пропуска СКУД",УровеньЖурналаРегистрации.Информация,,"Привязка карты к сотруднику уже была создана");
			ОбщегоНазначения.СообщитьПользователю("Привязка карты к сотруднику уже была создана");
		Иначе
			ВызватьИсключение("СКУД вернул код ошибки: "+Ответ+". Привязка пропуска по сотруднику "+ФИО+" в СКУД не создана!");	
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("Регистрация пропуска СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Процедура - Отвязать пропуск от сотрудника
// Отвязываем пропуск от сотрудника в СКУД
// Параметры:
//  ЗначениеПропуска - Строка - Идентификатор физического пропуска
//  Сотрудник		 - СправочникСсылка.Сотрудники - Ссылка на сотрудника
//  IDСотрудника	 - Число - ID сотрудника в Сигур
//
Процедура ОтвязатьПропускОтСотрудника(ЗначениеПропуска,IDПропуска,Сотрудник,IDСотрудника) Экспорт
	СтрукПривязки = Новый Структура;
	СтрукПривязки.Вставить("employeeId",IDСотрудника);
	СтрукПривязки.Вставить("cardId",IDПропуска);
	//Формат карты - идентификатор W26
	//СтрукПривязки.Вставить("format","W34");
	СтрукПривязки.Вставить("format","W26");
	МассивПривязки = Новый Массив;
	МассивПривязки.Добавить(СтрукПривязки);
	
	Ответ = ИКТ_SigurApi.Отправить("bindings/employees-cards/delete",,МассивПривязки);
	Если Ответ = 204 Тогда
		НаборЗаписей = РегистрыСведений.ИКТ_Пропуска.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЗначениеКарты.Установить(ЗначениеПропуска);
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ЗначениеКарты = ЗначениеПропуска;
		НоваяЗапись.Сотрудник = Сотрудник;
		НоваяЗапись.IDПропуска = IDПропуска;
		НоваяЗапись.Действует = Ложь;
		НаборЗаписей.Записать();
		ОбщегоНазначения.СообщитьПользователю("Пропуск для сотрудника заблокирован");
	ИначеЕсли Ответ = 422 Тогда
		ЗаписьЖурналаРегистрации("Регистрация пропуска СКУД",УровеньЖурналаРегистрации.Информация,,"Привязка карты к сотруднику уже была создана");
		ОбщегоНазначения.СообщитьПользователю("Привязка карты к сотруднику уже была создана");
	Иначе
		ЗаписьЖурналаРегистрации("Регистрация пропуска СКУД",УровеньЖурналаРегистрации.Ошибка,,"СКУД вернул код ошибки: "+Ответ+". Привязка пропуска по сотруднику в СКУД не создана!");
		ОбщегоНазначения.СообщитьПользователю("СКУД вернул код ошибки: "+Ответ+". Привязка пропуска по сотруднику в СКУД не создана!");	
	КонецЕсли;
КонецПроцедуры

// Функция - Проверить актуальность данных
// Проверяет является ли самым последним по времени регистрации Кадровый документ
// Параметры:
//  Сотрудник				Сотрудник - СправочникСсылка.Сотрудники - Сотрудник документа
//  ДатаДокументаИсточника	Дата документа - Дата - Дата документа по которому получаем данные
//  ВидСобытия				Вид события - Перечисления.ВидыКадровыхСобытий - Прием, Перемещение, Увольнение
// 
// Возвращаемое значение:
//   Булево 
//
Функция ПроверитьАктуальностьДанных(Сотрудник, ДатаДокументаИсточника,ВидСобытия)
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеДляПодбораСотрудников.Начало КАК Начало,
	|	ДанныеДляПодбораСотрудников.ВидСобытия КАК ВидСобытия
	|ИЗ
	|	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбораСотрудников
	|ГДЕ
	|	ДанныеДляПодбораСотрудников.Сотрудник.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Начало УБЫВ";
	Запрос.УстановитьПараметр("Ссылка",Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если Выборка.ВидСобытия = ВидСобытия И НачалоДня(Выборка.Начало) = НачалоДня(ДатаДокументаИсточника) Тогда	
		Возврат Истина;
	ИначеЕсли Выборка.Начало <= ДатаДокументаИсточника Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция НайтиСотрудникаПоФизЛицу(ФизЛицо)

	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДанныеДляПодбораСотрудников.Сотрудник.Ссылка КАК СотрудникСсылка
	|ИЗ
	|	РегистрСведений.ДанныеДляПодбораСотрудников КАК ДанныеДляПодбораСотрудников
	|ГДЕ
	|	ДанныеДляПодбораСотрудников.ФизическоеЛицо.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",ФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.СотрудникСсылка; 
	
КонецФункции

// Функция - Получить связанные зоны и точки
// Получает все зоны и точки доступа по набору должность - зоны, подразделение - зоны
// Параметры:
//  Должность		Должность - СправочникСсылка.Должности - Должность сотрудника
//  Подразделение	Подразделение - СправочникСсылка.ПодразделенияОрганизаций - Подразделение сотрудника
// 
// Возвращаемое значение:
//  Таблица с набором зон и точек доступа - Таблица значений Или Неопределено 
//
Функция ПолучитьСвязанныеЗоныИТочки(Должность, Подразделение)

	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ИКТ_ЗоныДолжностей.Зона.Ссылка КАК Зона
	|ПОМЕСТИТЬ ЗоныДолжностейИПодразделений
	|ИЗ
	|	Справочник.ИКТ_ЗоныДолжностей КАК ИКТ_ЗоныДолжностей
	|ГДЕ
	|	ИКТ_ЗоныДолжностей.Должность.Ссылка = &СсылкаД
	|	И ИКТ_ЗоныДолжностей.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ИКТ_ЗоныДолжностей.Зона.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ИКТ_ЗоныДолжностей.Зона.ТочкиДоступа.Ссылка) > 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИКТ_ЗоныПодразделений.Зона.Ссылка
	|ИЗ
	|	Справочник.ИКТ_ЗоныПодразделений КАК ИКТ_ЗоныПодразделений
	|ГДЕ
	|	ИКТ_ЗоныПодразделений.Подразделение.Ссылка = &СсылкаП
	|	И ИКТ_ЗоныПодразделений.ПометкаУдаления = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ИКТ_ЗоныПодразделений.Зона.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ИКТ_ЗоныПодразделений.Зона.ТочкиДоступа.Ссылка) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИКТ_ЗоныДоступаТочкиДоступа.Ссылка КАК ЗонаДоступа,
	|	ИКТ_ЗоныДоступаТочкиДоступа.Точка КАК ТочкаДоступа
	|ИЗ
	|	ЗоныДолжностейИПодразделений КАК ЗоныДолжностейИПодразделений
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИКТ_ЗоныДоступа.ТочкиДоступа КАК ИКТ_ЗоныДоступаТочкиДоступа
	|		ПО ЗоныДолжностейИПодразделений.Зона.Ссылка = ИКТ_ЗоныДоступаТочкиДоступа.Ссылка";
	Запрос.УстановитьПараметр("СсылкаД",Должность);
	Запрос.УстановитьПараметр("СсылкаП",Подразделение);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаТЧ = РезультатЗапроса.Выгрузить();
		ВыборкаТЧ.Свернуть("ЗонаДоступа,ТочкаДоступа");
		Возврат ВыборкаТЧ;
	Иначе
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Нет зон и точек доступа по подразделению и должности!";
	    Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

Функция НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Подразделение,Должность)

	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ИКТ_IDОбъектовСКУД.ID КАК ID
	|ИЗ
	|	РегистрСведений.ИКТ_IDОбъектовСКУД КАК ИКТ_IDОбъектовСКУД";
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Запрос.Текст = Запрос.Текст+"
	|ГДЕ
	|	ИКТ_IDОбъектовСКУД.Подразделение.Ссылка = &Подразделение";
		Запрос.УстановитьПараметр("Подразделение",Подразделение);
	Иначе
		Запрос.Текст = Запрос.Текст+"
	|ГДЕ
	|	ИКТ_IDОбъектовСКУД.Должность.Ссылка = &Должность";
		Запрос.УстановитьПараметр("Должность",Должность);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ID
	Иначе
		Возврат Неопределено
	КонецЕсли;
	
КонецФункции	

// Функция - Создать должность ВСКУД
// Создаёт должность в СКУД путём http запроса
// Параметры:
//  Должность	Должность - СправочникСсылка.Должности - Должность
// 
// Возвращаемое значение:
//   Ссылка на запись в справочнике ИКТ_IDОбъектовСКУД Или Неопределено 
//
Функция СоздатьДолжностьВСКУД(Должность)

	//Должность грузится из САП в СКУД
	Возврат Неопределено;
	
	НаименованиеДолжности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Должность,"Наименование");
	ДолжностьСтрук = Новый Структура;
	ДолжностьСтрук.Вставить("name",НаименованиеДолжности);
	
	Попытка
		ОтветДолжность = ИКТ_SigurApi.Отправить("positions",,ДолжностьСтрук);
		Если ТипЗнч(ОтветДолжность) = Тип("Число") Тогда
			ВызватьИсключение("Ошибка при отправке данных должности "+НаименованиеДолжности+". Должность в СКУД не создана! Код ошибки: "+ОтветДолжность);
		Иначе	
			НаборЗаписей = РегистрыСведений.ИКТ_IDОбъектовСКУД.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Должность.Установить(Должность);
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ID = ОтветДолжность.id;
			НоваяЗапись.Должность = Должность;
			НаборЗаписей.Записать();
			Возврат НоваяЗапись.ID;
		КонецЕсли;
	Исключение 
		ЗаписьЖурналаРегистрации("Регистрация должность СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
		Возврат Неопределено
	КонецПопытки;
	
КонецФункции

// Функция - Создать подразделение ВСКУД
//
// Параметры:
//  Подразделение	Подразделение - СправочникСсылка.ПодразделенияОрганизаций - Подразделение
// 
// Возвращаемое значение:
//   Ссылка на запись в справочнике ИКТ_IDОбъектовСКУД Или Неопределено 
//
Функция СоздатьПодразделениеВСКУД(Подразделение)

	//Подразделение грузится из САП в СКУД
	Возврат Неопределено;
	
	НаименованиеПодразделения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение,"Наименование");
	ПодразделениеСтрук = Новый Структура;
	Родитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение,"Родитель");
	Если ЗначениеЗаполнено(Родитель) Тогда
		parentId = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Родитель,Неопределено);
		parentId = ?(ЗначениеЗаполнено(parentId),parentId,СоздатьПодразделениеВСКУД(Подразделение));
		ПодразделениеСтрук.Вставить("parentId",parentId);
	Иначе //22.05.24 В Сигур есть подразделение ГН с ID = 7276. Под него грузим все подразделения без родителя
		ПодразделениеСтрук.Вставить("parentId",7276);
	КонецЕсли;
	ПодразделениеСтрук.Вставить("name",НаименованиеПодразделения);
	
	Попытка
		ОтветПодразделение = ИКТ_SigurApi.Отправить("departments",,ПодразделениеСтрук);
		Если ТипЗнч(ОтветПодразделение) = Тип("Число") Тогда
			ВызватьИсключение("Ошибка при отправке данных подразделения "+НаименованиеПодразделения+". Подразделение в СКУД не создано! Код ошибки: "+ОтветПодразделение);
		Иначе	
			НаборЗаписей = РегистрыСведений.ИКТ_IDОбъектовСКУД.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Подразделение.Установить(Подразделение);
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ID = ОтветПодразделение.id;
			НоваяЗапись.Подразделение = Подразделение;
			НаборЗаписей.Записать();
			Возврат НоваяЗапись.ID; 
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Регистрация подразделения СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
		Возврат Неопределено
	КонецПопытки;	
		
КонецФункции

// Процедура - Изменить подразделение или должность ВСКУД
// Меняет информацию о подразделении или должности в СКУД
// Параметры:
//  IDПодразделения	Id подразделения - Строка - Id подразделение СКУД
//  IDДолжности		Id должности - Строка - Id должности СКУД 
//
Процедура ИзменитьПодразделениеИлиДолжностьВСКУД(IDПодразделения=Неопределено,IDДолжности=Неопределено)

	//Меняется из САП в СКУД
	Возврат;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИКТ_IDОбъектовСКУД.Подразделение КАК Подразделение,
	|	ИКТ_IDОбъектовСКУД.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.ИКТ_IDОбъектовСКУД КАК ИКТ_IDОбъектовСКУД
	|ГДЕ
	|	ИКТ_IDОбъектовСКУД.ID = &ID";
	ID = ?(ЗначениеЗаполнено(IDПодразделения),IDПодразделения,IDДолжности);
	Запрос.УстановитьПараметр("ID",ID);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(IDПодразделения) И Не ЗначениеЗаполнено(Выборка.Должность) Тогда
			Продолжить	
		ИначеЕсли Не ЗначениеЗаполнено(IDПодразделения) И ЗначениеЗаполнено(Выборка.Должность) Тогда
			ТелоЗапроса = Новый Структура;
			ТелоЗапроса.Вставить("name",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Должность,"Наименование"));
			ИКТ_SigurApi.Изменить("positions",IDДолжности,ТелоЗапроса);	
		ИначеЕсли ЗначениеЗаполнено(Выборка.Подразделение) Тогда
			ТелоЗапроса = Новый Структура;
			ТелоЗапроса.Вставить("name",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Подразделение,"Наименование"));
			ИКТ_SigurApi.Изменить("departments",IDПодразделения,ТелоЗапроса);	
		Иначе
			Продолжить
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция - Найти пропуск
// Ищет существующий пропуск в РС ИКТ_Пропуска
// Параметры:
//  CardValue	Значение пропуска - Строка - Значение пропуска в hex данных 
// 
// Возвращаемое значение:
//   ID пропуска - Строка или Неопределено 
//
Функция НайтиПропуск(CardValue)
	
	Запрос = Новый Запрос;
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ИКТ_Пропуска.IDПропуска КАК IDПропуска
	|ИЗ
	|	РегистрСведений.ИКТ_Пропуска КАК ИКТ_Пропуска
	|ГДЕ
	|	ИКТ_Пропуска.ЗначениеКарты = &ЗначениеКарты";
	Запрос.УстановитьПараметр("ЗначениеКарты",CardValue);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.IDПропуска 
	КонецЕсли;
	
КонецФункции

// Функция - Изменить подразделение и должность сотрудника ВСКУД
// При записи кадрового перевода меняет подразделение и должность сотрудника в СКУД путём http запроса
// Параметры:
//  IDСотрудника	ID сотрудника - Строка - ID сотрудника СКУД
//  IDПодразделения	ID подразделения - Строка - ID подразделения СКУД
//  IDДолжности		ID Должности -	Строка - ID Должности СКУД 
// 
// Возвращаемое значение:
//   Булево 
//
Функция ИзменитьПодразделениеИДолжностьСотрудникаВСКУД(IDСотрудника,IDПодразделения,IDДолжности)
	
	//Меняется из САП в СКУД
	СтрукОтвета = Новый Структура;
	СтрукОтвета.Вставить("Выполнено",Истина);
	СтрукОтвета.Вставить("ПричинаОшибки","Меняется из САП в СКУД");
	Возврат СтрукОтвета;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("departmentId",IDПодразделения);
	СтруктураЗапроса.Вставить("positionId",IDДолжности);
	
	СтрукОтвета = Новый Структура;
	Попытка
		Ответ = ИКТ_SigurApi.Изменить("employees",IDСотрудника,СтруктураЗапроса);
		Если ТипЗнч(Ответ) = Тип("Число") Тогда
			ВызватьИсключение("Ошибка изменения должности подразделения сотрудника ID: "+IDСотрудника+". Код ошибки: "+Ответ);
		КонецЕсли;
		СтрукОтвета.Вставить("Выполнено",Истина);
		Возврат СтрукОтвета
	Исключение
		ЗаписьЖурналаРегистрации("Изменение подразделения и должности СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
		СтрукОтвета.Вставить("Выполнено",Ложь);
		СтрукОтвета.Вставить("ПричинаОшибки",ОписаниеОшибки());
		Возврат СтрукОтвета 
	КонецПопытки;
	
КонецФункции

// Функция - Изменить статусы записи справочника доступ СКУД
// Изменение в таблице Статусы доступов
// Параметры:
//  НоваяЗаписьСправочникаСКУД	Элемент справочника ИКТ_ДоступСКУД - СправочникОбъект.ИКТ_ДоступСКУД - Элемент справочника полученный как объект
//  ВидДокументаСтрокой			Вид документа - Строка - вид документа строкой нижнего регистра, например "кадровый перевод" 
//  Источник					Документ источник - ДокументОбъект - Документ вызываемы в ИКТ_ПриЗаписиДанныхДляСКУДПриЗаписи 
// 
// Возвращаемое значение:
//  НоваяЗаписьСправочникаСКУД - СправочникОбъект.ИКТ_ДоступСКУД 
//
Функция ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Сотрудник) Экспорт

	ЗаключениеМедицинскогоОсмотра = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяЗаписьСправочникаСКУД.Ссылка,"ЗаключениеМедицинскогоОсмотра");
	Если Константы.ИКТ_ИспользоватьЗаключениеМедицинскогоОсмотраСКУД.Получить() И ЗначениеЗаполнено(ЗаключениеМедицинскогоОсмотра) Тогда
		
		СтрокиТЧСтатусыМед = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.НайтиСтроки(Новый Структура("ДокументОснование",ЗаключениеМедицинскогоОсмотра));
		Если СтрокиТЧСтатусыМед.Количество() = 0 Тогда
			НоваяСтрокаСтатусы = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Добавить();
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаключениеМедицинскогоОсмотра,"РезультатОсмотра") =
				Перечисления.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания Тогда
				НоваяСтрокаСтатусы.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.НеДействует;
				НоваяСтрокаСтатусы.Комментарий = "Сотрудник имеет противопоказания";
				НоваяСтрокаСтатусы.ДокументОснование = ЗаключениеМедицинскогоОсмотра;
				АктуализироватьТЧСтатусыДоступа("Доступ сотруднику разрешен",НоваяЗаписьСправочникаСКУД);
			Иначе
				НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Очистить();
			КонецЕсли;
		Иначе
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаключениеМедицинскогоОсмотра,"РезультатОсмотра") =
				Перечисления.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания Тогда
				Если Не СтрокиТЧСтатусыМед[0].Комментарий = "Сотрудник имеет противопоказания" Тогда
					СтрокиТЧСтатусыМед[0].Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.НеДействует;
					СтрокиТЧСтатусыМед[0].Комментарий = "Сотрудник имеет противопоказания";
					СтрокиТЧСтатусыМед[0].ДокументОснование = ЗаключениеМедицинскогоОсмотра;
					АктуализироватьТЧСтатусыДоступа("Доступ сотруднику разрешен",НоваяЗаписьСправочникаСКУД);
				КонецЕсли;
			Иначе
				НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Очистить();	
			КонецЕсли;
		КонецЕсли;
		НоваяЗаписьСправочникаСКУД = АктуализироватьТЧСтатусыДоступа("Нет документа медицинского заключения",НоваяЗаписьСправочникаСКУД);
	ИначеЕсли Константы.ИКТ_ИспользоватьЗаключениеМедицинскогоОсмотраСКУД.Получить() Тогда
		СтрокиТЧ = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.НайтиСтроки(Новый Структура("Комментарий","Нет документа медицинского заключения"));
		Если СтрокиТЧ.Количество() = 0 Тогда
			НоваяСтрокаСтатусы = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Добавить();
			НоваяСтрокаСтатусы.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.НеДействует;
			НоваяСтрокаСтатусы.Комментарий = "Нет документа медицинского заключения";
			НоваяСтрокаСтатусы.ДокументОснование = Неопределено;
			АктуализироватьТЧСтатусыДоступа("Доступ сотруднику разрешен",НоваяЗаписьСправочникаСКУД);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.Увольнение") Или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.УвольнениеСписком") Тогда
		СтрокиТЧСтатусы = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.НайтиСтроки(Новый Структура("ДокументОснование",Источник.Ссылка));	
		Если СтрокиТЧСтатусы.Количество() = 0 Тогда
			НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Очистить();
			НоваяСтрокаСтатусы = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Добавить();
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Проведен") Тогда
				НоваяСтрокаСтатусы.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.Уволен;
				НоваяСтрокаСтатусы.Комментарий = "Имеется увольнение";
				НоваяСтрокаСтатусы.ДокументОснование = Источник.Ссылка;
			Иначе
				НоваяСтрокаСтатусы.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.Действует;
				НоваяСтрокаСтатусы.Комментарий = "Доступ сотруднику разрешен";
				СтрукКадровыхДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяЗаписьСправочникаСКУД.Ссылка,"ПриемНаРаботу,КадровыйПеревод",Истина);
				НоваяСтрокаСтатусы.ДокументОснование = ?(ЗначениеЗаполнено(СтрукКадровыхДокументов.КадровыйПеревод),
				СтрукКадровыхДокументов.КадровыйПеревод,
				СтрукКадровыхДокументов.ПриемНаРаботу);
			КонецЕсли;
		КонецЕсли;
	//Если есть все необходимые документы для доступа - определяем допуск по последнему документы приема/перевода
	ИначеЕсли НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Количество() = 0 Тогда
		НоваяСтрокаСтатусы = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Добавить();
		НоваяСтрокаСтатусы.Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.Действует;
		НоваяСтрокаСтатусы.Комментарий = "Доступ сотруднику разрешен";
		Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.КадровыйПеревод") 
		Или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.КадровыйПереводСписком")
		Или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПриемНаРаботу")
		Или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПриемНаРаботуСписком") Тогда
			ВидСобытия = ?(ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаПриема",Источник.Метаданные()),Перечисления.ВидыКадровыхСобытий.Прием,
			Перечисления.ВидыКадровыхСобытий.Перемещение); 
			Если ПроверитьАктуальностьДанных(Сотрудник,Источник.Дата,ВидСобытия) Тогда
				НоваяСтрокаСтатусы.ДокументОснование = Источник.Ссылка;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(НоваяЗаписьСправочникаСКУД.КадровыйПеревод) Тогда
			НоваяСтрокаСтатусы.ДокументОснование = НоваяЗаписьСправочникаСКУД.КадровыйПеревод;
		ИначеЕсли ЗначениеЗаполнено(НоваяЗаписьСправочникаСКУД.ПриемНаРаботу) Тогда
			НоваяСтрокаСтатусы.ДокументОснование = НоваяЗаписьСправочникаСКУД.ПриемНаРаботу;
		КонецЕсли;
	ИначеЕсли НоваяЗаписьСправочникаСКУД.СтатусыДоступа[0].Статус = Перечисления.ИКТ_СтатусыДоступаСКУД.Действует Тогда
		ВидСобытия = ?(ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаПриема",Источник.Метаданные()),Перечисления.ВидыКадровыхСобытий.Прием,
		Перечисления.ВидыКадровыхСобытий.Перемещение);
		Если ПроверитьАктуальностьДанных(Сотрудник,Источник.Дата,ВидСобытия) Тогда
			 НоваяЗаписьСправочникаСКУД.СтатусыДоступа[0].ДокументОснование = Источник.Ссылка;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат НоваяЗаписьСправочникаСКУД
	
КонецФункции

Функция АктуализироватьТЧСтатусыДоступа(Комментарий,НоваяЗаписьСправочникаСКУД)

	СтрокиТЧ = НоваяЗаписьСправочникаСКУД.СтатусыДоступа.НайтиСтроки(Новый Структура("Комментарий",Комментарий));	
	Если СтрокиТЧ.Количество() > 0 Тогда
		НоваяЗаписьСправочникаСКУД.СтатусыДоступа.Удалить(СтрокиТЧ[0]);		
	КонецЕсли;
	Возврат НоваяЗаписьСправочникаСКУД
	
КонецФункции

// Функция - Получить актуальное удостоверение сотрудника
// Возвращает ссылку на акутальное удостоверение сотрудника по ссылке сотрудника
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники - Ссылка на сотрудника
// 
// Возвращаемое значение:
//  Удостоверение - СправочникСсылка.ИКТ_Удостоверение Или Неопределено
//
Функция ПолучитьАктуальноеУдостоверениеСотрудника(Сотрудник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИКТ_ДопускиКРаботеСрезПоследних.Удостоверение КАК Удостоверение
	|ИЗ
	|	РегистрСведений.ИКТ_ДопускиКРаботе.СрезПоследних(
	|			&ТекущаяДата,
	|			Сотрудник.Ссылка = &Сотрудник
	|				И (СрокДействия >= &ТекущаяДата
	|					И Период <= &ТекущаяДата)
	|				И Удостоверение.ВидУдостоверения.ТипДопуска.Ссылка = &ТипДопускаУдостоверение) КАК ИКТ_ДопускиКРаботеСрезПоследних";
	Запрос.УстановитьПараметр("ТекущаяДата",ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Сотрудник",Сотрудник);
	Запрос.УстановитьПараметр("ТипДопускаУдостоверение",Справочники.ИКТ_ТипыДопуска.Удостоверение.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Удостоверение	
	КонецЕсли;
	
КонецФункции

// Процедура - Заблокировать сотрудника ВСКУД
//
// Параметры:
//  IDСотрудника - Число - ID сотрудника в СКУД
//
Процедура ЗаблокироватьСотрудникаВСКУД(IDСотрудника)
	Если Не ЗначениеЗаполнено(IDСотрудника) Или IDСотрудника = 0 Тогда
		Возврат
	КонецЕсли;
	
	Попытка
		ОтветБлокировкаДоступа = ИКТ_SigurApi.Соединиться("PUT","employees/"+Формат(IDСотрудника,"ЧГ=0")+"/block");
		Если ТипЗнч(ОтветБлокировкаДоступа) = Тип("Число") Тогда
			ВызватьИсключение("Ошибка блокировки сотрудника ID: "+IDСотрудника+". Код ошибки: "+ОтветБлокировкаДоступа);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Блокировка сотрудника в СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

