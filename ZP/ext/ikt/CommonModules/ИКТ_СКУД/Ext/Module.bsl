Процедура ЗаписатьДанныеВ_РС_ИКТ_ДанныеКадровыхДокументовДляСКУД(КадровыйДокумент)
	
	Если ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.КадровыйПеревод")
	Или ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.Увольнение") Тогда
	
		Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"Сотрудник");
		Если ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.КадровыйПеревод") Тогда 
		   	Должность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"Должность");
			Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"Подразделение");
			ГрафикРаботы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"ГрафикРаботы");
			ДатаНачалаДействия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"ДатаНачала");
		ИначеЕсли ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.Увольнение") Тогда 
			Должность = Справочники.Должности.ПустаяСсылка();
			Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
			ГрафикРаботы = Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка();
			ДатаНачалаДействия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"ДатаУвольнения");
		КонецЕсли;	
		
		НаборЗаписей = РегистрыСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Сотрудник.Установить(Сотрудник);
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"Проведен") Тогда 
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Сотрудник = Сотрудник;
			НоваяЗапись.КадровыйДокумент = КадровыйДокумент;
			НоваяЗапись.Дата = ДатаНачалаДействия;
			НоваяЗапись.Обработано = Ложь;
			НоваяЗапись.Должность = ?(ЗначениеЗаполнено(Должность),Должность,Справочники.Должности.ПустаяСсылка());
			НоваяЗапись.Подразделение = ?(ЗначениеЗаполнено(Подразделение),Подразделение,Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
			НоваяЗапись.ГрафикРаботы = ?(ЗначениеЗаполнено(ГрафикРаботы),ГрафикРаботы,Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка());
		КонецЕсли;
		НаборЗаписей.Записать();
			
	ИначеЕсли ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.КадровыйПереводСписком") 
	Или ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.УвольнениеСписком") Тогда 	
		Для Каждого Строка Из КадровыйДокумент.Сотрудники Цикл
			Если ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.УвольнениеСписком")
				И Строка.ДатаУвольнения <= ТекущаяДатаСеанса() Тогда
				Продолжить
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.ИКТ_ДанныеКадровыхДокументовДляСКУД.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Сотрудник.Установить(Строка.Сотрудник);
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КадровыйДокумент,"Проведен") Тогда 
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Сотрудник = Строка.Сотрудник;
				НоваяЗапись.КадровыйДокумент = КадровыйДокумент;
				НоваяЗапись.Обработано = Ложь;
				Если ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда 
					НоваяЗапись.Должность = ?(ЗначениеЗаполнено(Строка.Должность),Строка.Должность,Справочники.Должности.ПустаяСсылка());
					НоваяЗапись.Подразделение = ?(ЗначениеЗаполнено(Строка.Подразделение),Строка.Подразделение,Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
					НоваяЗапись.ГрафикРаботы = ?(ЗначениеЗаполнено(Строка.ГрафикРаботы),Строка.ГрафикРаботы,Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка());
					НоваяЗапись.Дата = Строка.ДатаУвольнения;
				ИначеЕсли ТипЗнч(КадровыйДокумент) = Тип("ДокументСсылка.УвольнениеСписком") Тогда
					НоваяЗапись.Должность = Справочники.Должности.ПустаяСсылка();
					НоваяЗапись.Подразделение = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
					НоваяЗапись.ГрафикРаботы = Справочники.ГрафикиРаботыСотрудников.ПустаяСсылка();
					НоваяЗапись.Дата = Строка.ДатаУвольнения;
				КонецЕсли;
			КонецЕсли;
			НаборЗаписей.Записать();
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СобытияПроходаСлужебныеПроцедурыИФункции

Функция ПолучитьСотрудникаПоID(IDСотрудника)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИКТ_ДоступСКУД.Сотрудник КАК Сотрудник
	|ИЗ
	|	Справочник.ИКТ_ДоступСКУД КАК ИКТ_ДоступСКУД
	|ГДЕ
	|	ИКТ_ДоступСКУД.IDСотрудника = &IDСотрудника";
	Запрос.УстановитьПараметр("IDСотрудника",IDСотрудника);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка()
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Сотрудник 
	КонецЕсли;		
КонецФункции
#КонецОбласти