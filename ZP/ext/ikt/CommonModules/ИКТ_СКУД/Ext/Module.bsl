
Процедура ИКТ_ПриЗаписиДанныхДляСКУДПриЗаписи(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Не Константы.ИКТ_ИспользоватьОбменСоСКУД.Получить() Тогда	
		Возврат;
	КонецЕсли;	
		
	//Справочники
	Если ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Должности") Тогда
		
		IDДолжности = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Неопределено,Источник.Ссылка);
		Если IDДолжности = Неопределено Тогда	
			Если Не Источник.ПометкаУдаления Тогда
				СоздатьДолжностьВСКУД(Источник.Ссылка);
			КонецЕсли;
		Иначе
			ИзменитьПодразделениеИлиДолжностьВСКУД(,IDДолжности);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		
		IDПодразделения = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Источник.Ссылка,Неопределено);
		Если IDПодразделения = Неопределено Тогда		
			СоздатьПодразделениеВСКУД(Источник.Ссылка);
		Иначе
			ИзменитьПодразделениеИлиДолжностьВСКУД(IDПодразделения,);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Сотрудники") Тогда	
		ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Источник.Ссылка);
		Если ЗаписьСправочникаСКУД = Неопределено Тогда		
			ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Источник.Ссылка)	
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.ИКТ_ЗоныДолжностей") Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст=
		"ВЫБРАТЬ
		|	ИКТ_ДоступСКУД.Ссылка КАК Ссылка,
		|	ИКТ_ДоступСКУД.Подразделение КАК Подразделение
		|ИЗ
		|	Справочник.ИКТ_ДоступСКУД КАК ИКТ_ДоступСКУД
		|ГДЕ
		|	ИКТ_ДоступСКУД.Должность.Ссылка = &Ссылка";
		Должность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Должность"); 
		Запрос.УстановитьПараметр("Ссылка",Должность);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл	
			ЗаписьДоступСКУД = Выборка.Ссылка.ПолучитьОбъект();
			ЗаписьДоступСКУД.ЗоныИТочкиДоступа.Загрузить(ПолучитьСвязанныеЗоныИТочки(Должность, Выборка.Подразделение));
			ЗаписьДоступСКУД.Записать();
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.ИКТ_ЗоныПодразделений") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст=
		"ВЫБРАТЬ
		|	ИКТ_ДоступСКУД.Ссылка КАК Ссылка,
		|	ИКТ_ДоступСКУД.Должность КАК Должность
		|ИЗ
		|	Справочник.ИКТ_ДоступСКУД КАК ИКТ_ДоступСКУД
		|ГДЕ
		|	ИКТ_ДоступСКУД.Подразделение.Ссылка = &Ссылка";
		Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Подразделение"); 
		Запрос.УстановитьПараметр("Ссылка",Подразделение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаписьДоступСКУД = Выборка.Ссылка.ПолучитьОбъект();
			ЗаписьДоступСКУД.ЗоныИТочкиДоступа.Загрузить(ПолучитьСвязанныеЗоныИТочки(Выборка.Должность,Подразделение));
			ЗаписьДоступСКУД.Записать();
		КонецЦикла;		
	//Справочники
	
	//Документы
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПриемНаРаботу") Тогда	
		
		ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Источник.Сотрудник);
		Если ЗаписьСправочникаСКУД = Неопределено Тогда		
			ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Источник.Сотрудник);
		КонецЕсли;
		
		//Создание подразделения, должности, сотрудника в СКУД (
		IDСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьСправочникаСКУД,"IDСотрудника");
		Должность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Должность");
		Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Подразделение");
		Если Не ЗначениеЗаполнено(IDСотрудника) Тогда
			IdПодразделения = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Подразделение,Неопределено);
			IdДолжности = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Неопределено,Должность);
			Если Не ЗначениеЗаполнено(IdПодразделения) Тогда
				СоздатьПодразделениеВСКУД(Подразделение);	
			КонецЕсли;
			Если Не ЗначениеЗаполнено(IdДолжности) Тогда
				СоздатьДолжностьВСКУД(Должность);	
			КонецЕсли;
			Если ЗначениеЗаполнено(IdДолжности) И ЗначениеЗаполнено(IdПодразделения) Тогда 
				СоздатьСотрудникаВСКУД(ЗаписьСправочникаСКУД, IdПодразделения,IdДолжности)
			КонецЕсли;
		КонецЕсли;
		//Создание подразделения, должности, сотрудника в СКУД )
		
		ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Источник.Сотрудник); 
		НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
		Если ПроверитьАктуальностьДанных(Источник.Сотрудник, Источник.Дата, Перечисления.ВидыКадровыхСобытий.Прием) Тогда
			ГрафикРаботы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"ГрафикРаботы");
			
			//Зоны и точки доступа (
			СвязанныеЗоныИТочки = ПолучитьСвязанныеЗоныИТочки(Должность, Подразделение);
			Если СвязанныеЗоныИТочки <> Неопределено Тогда
				НоваяЗаписьСправочникаСКУД.ЗоныИТочкиДоступа.Загрузить(СвязанныеЗоныИТочки);
			КонецЕсли;
			//Зоны и точки доступа )
			
			НоваяЗаписьСправочникаСКУД.Должность = Должность;
			НоваяЗаписьСправочникаСКУД.Подразделение = Подразделение;
			НоваяЗаписьСправочникаСКУД.ГрафикРаботы = ГрафикРаботы;
		КонецЕсли;
		НоваяЗаписьСправочникаСКУД.ПриемНаРаботу = Источник.Ссылка;
		
		//Статусы
		НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Источник.Сотрудник);
		
		НоваяЗаписьСправочникаСКУД.Записать();
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПриемНаРаботуСписком") Тогда
		
		Для Каждого Строка Из Источник.Сотрудники Цикл
		
			ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Строка.Сотрудник);
			Если ЗаписьСправочникаСКУД = Неопределено Тогда		
				ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Строка.Сотрудник);
			КонецЕсли;
			
			//Создание подразделения, должности, сотрудника в СКУД (
			IDСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьСправочникаСКУД,"IDСотрудника");
			Должность = Строка.Должность;
			Подразделение = Строка.Подразделение;
			Если Не ЗначениеЗаполнено(IDСотрудника) Тогда
				IdПодразделения = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Подразделение,Неопределено);
				IdДолжности = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Неопределено,Должность);
				Если Не ЗначениеЗаполнено(IdПодразделения) Тогда
					СоздатьПодразделениеВСКУД(Подразделение);	
				КонецЕсли;
				Если Не ЗначениеЗаполнено(IdДолжности) Тогда
					СоздатьДолжностьВСКУД(Должность);	
				КонецЕсли;
				Если ЗначениеЗаполнено(IdДолжности) И ЗначениеЗаполнено(IdПодразделения) Тогда 
					СоздатьСотрудникаВСКУД(ЗаписьСправочникаСКУД, IdПодразделения,IdДолжности)
				КонецЕсли;
			КонецЕсли;
			//Создание подразделения, должности, сотрудника в СКУД )
			
			ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Строка.Сотрудник);
			НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();	
			Если ПроверитьАктуальностьДанных(Строка.Сотрудник, Источник.Дата, Перечисления.ВидыКадровыхСобытий.Прием) Тогда
				
				//Зоны и точки доступа (
				СвязанныеЗоныИТочки = ПолучитьСвязанныеЗоныИТочки(Строка.Должность, Строка.Подразделение);
				Если СвязанныеЗоныИТочки <> Неопределено Тогда
					НоваяЗаписьСправочникаСКУД.ЗоныИТочкиДоступа.Загрузить(СвязанныеЗоныИТочки);
				КонецЕсли;
				//Зоны и точки доступа )
				
				НоваяЗаписьСправочникаСКУД.Должность = Строка.Должность;
				НоваяЗаписьСправочникаСКУД.Подразделение = Строка.Подразделение;
				НоваяЗаписьСправочникаСКУД.ГрафикРаботы = Строка.ГрафикРаботы;;
			КонецЕсли;
			НоваяЗаписьСправочникаСКУД.ПриемНаРаботу = Источник.Ссылка;
			
			//Статусы
			НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Строка.Сотрудник);

			НоваяЗаписьСправочникаСКУД.Записать();
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.КадровыйПеревод") Тогда	
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"ДатаНачала") > НачалоДня(ТекущаяДатаСеанса()) Тогда
			ЗаписатьДанныеВ_РС_ИКТ_ДанныеКадровыхДокументовДляСКУД(Источник.Ссылка);
			Возврат;
		КонецЕсли;
		
		ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Источник.Сотрудник);
		Если ЗаписьСправочникаСКУД = Неопределено Тогда		
			ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Источник.Сотрудник);
		КонецЕсли;
		
		//Создание подразделения, должности, сотрудника в СКУД (
		IDСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьСправочникаСКУД,"IDСотрудника");
		Должность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Должность");
		Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Подразделение");
		IdПодразделения = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Подразделение,Неопределено);
		IdДолжности = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Неопределено,Должность);
		
		Если Не ЗначениеЗаполнено(IDСотрудника) Тогда
			Если Не ЗначениеЗаполнено(IdПодразделения) Тогда
				СоздатьПодразделениеВСКУД(Подразделение);	
			КонецЕсли;
			Если Не ЗначениеЗаполнено(IdДолжности) Тогда
				СоздатьДолжностьВСКУД(Должность);	
			КонецЕсли;
			Если ЗначениеЗаполнено(IdДолжности) И ЗначениеЗаполнено(IdПодразделения) Тогда 
				СоздатьСотрудникаВСКУД(ЗаписьСправочникаСКУД, IdПодразделения,IdДолжности)
			КонецЕсли;
		КонецЕсли;
		//Создание подразделения, должности, сотрудника в СКУД )
		
		НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
		Если ПроверитьАктуальностьДанных(Источник.Сотрудник, Источник.Дата, Перечисления.ВидыКадровыхСобытий.Перемещение) Тогда	
			Если Источник.ИзменитьПодразделениеИДолжность Тогда
				
				ОтветСКУД = ИзменитьПодразделениеИДолжностьСотрудникаВСКУД(IDСотрудника,IDПодразделения,IDДолжности);
				Если Не ОтветСКУД.Выполнено Тогда
					Возврат
				КонецЕсли;
				
				//Зоны и точки доступа (	
				СвязанныеЗоныИТочки = ПолучитьСвязанныеЗоныИТочки(Должность, Подразделение);
				Если СвязанныеЗоныИТочки <> Неопределено Тогда
					НоваяЗаписьСправочникаСКУД.ЗоныИТочкиДоступа.Загрузить(СвязанныеЗоныИТочки);
				КонецЕсли;
				//Зоны и точки доступа )
				
				НоваяЗаписьСправочникаСКУД.Должность = Должность;
				НоваяЗаписьСправочникаСКУД.Подразделение = Подразделение;		
			КонецЕсли;
			ГрафикРаботы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"ГрафикРаботы");
			Если ЗначениеЗаполнено(ГрафикРаботы) Тогда
				ГрафикРаботы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"ГрафикРаботы");	
				НоваяЗаписьСправочникаСКУД.ГрафикРаботы = ГрафикРаботы;		
			КонецЕсли;
		КонецЕсли;
		НоваяЗаписьСправочникаСКУД.КадровыйПеревод = Источник.Ссылка;
		
		//Статусы
		НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Источник.Сотрудник);
		
		НоваяЗаписьСправочникаСКУД.Записать();
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.КадровыйПереводСписком") Тогда
				
		Для Каждого Строка Из Источник.Сотрудники Цикл
			
			Если Строка.ДатаНачала > НачалоДня(ТекущаяДатаСеанса()) Тогда
				ЗаписатьДанныеВ_РС_ИКТ_ДанныеКадровыхДокументовДляСКУД(Источник.Ссылка);
				Продолжить;
			КонецЕсли;
			
			ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Строка.Сотрудник);
			Если ЗаписьСправочникаСКУД = Неопределено Тогда		
				ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Строка.Сотрудник);
			КонецЕсли;
			
			//Создание подразделения, должности, сотрудника в СКУД (
			IDСотрудника = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаписьСправочникаСКУД,"IDСотрудника");
			Должность = Строка.Должность;
			Подразделение = Строка.Подразделение;
			IdПодразделения = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Подразделение,Неопределено);
			IdДолжности = НайтиПодразделениеИлиДолжностьВ_РС_ИКТ_IDОбъектовСКУД(Неопределено,Должность);
			
			Если Не ЗначениеЗаполнено(IDСотрудника) Тогда
				Если Не ЗначениеЗаполнено(IdПодразделения) Тогда
					СоздатьПодразделениеВСКУД(Подразделение);	
				КонецЕсли;
				Если Не ЗначениеЗаполнено(IdДолжности) Тогда
					СоздатьДолжностьВСКУД(Должность);	
				КонецЕсли;
				Если ЗначениеЗаполнено(IdДолжности) И ЗначениеЗаполнено(IdПодразделения) Тогда 
					СоздатьСотрудникаВСКУД(ЗаписьСправочникаСКУД, IdПодразделения,IdДолжности)
				КонецЕсли;
			КонецЕсли;
			//Создание подразделения, должности, сотрудника в СКУД )
			
			НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
			Если ПроверитьАктуальностьДанных(Строка.Сотрудник, Источник.Дата, Перечисления.ВидыКадровыхСобытий.Перемещение) Тогда
				Если Строка.ИзменитьПодразделениеИДолжность Тогда
						
					ОтветСКУД = ИзменитьПодразделениеИДолжностьСотрудникаВСКУД(IDСотрудника,IDПодразделения,IDДолжности);
					Если Не ОтветСКУД.Выполнено Тогда
						Возврат
					КонецЕсли;
					
					//Зоны и точки доступа (	
					СвязанныеЗоныИТочки = ПолучитьСвязанныеЗоныИТочки(Должность, Подразделение);
					Если СвязанныеЗоныИТочки <> Неопределено Тогда
						НоваяЗаписьСправочникаСКУД.ЗоныИТочкиДоступа.Загрузить(СвязанныеЗоныИТочки);
					КонецЕсли;
					//Зоны и точки доступа )
					
					НоваяЗаписьСправочникаСКУД.Должность = Должность;
					НоваяЗаписьСправочникаСКУД.Подразделение = Подразделение;		
				КонецЕсли;
				Если ЗначениеЗаполнено(Строка.ГрафикРаботы) Тогда	
					НоваяЗаписьСправочникаСКУД.ГрафикРаботы = Строка.ГрафикРаботы;		
				КонецЕсли;
			КонецЕсли;
			НоваяЗаписьСправочникаСКУД.КадровыйПеревод = Источник.Ссылка;
			
			//Статусы
			НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Строка.Сотрудник);
			
			НоваяЗаписьСправочникаСКУД.Записать();
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.РаботаВВыходныеИПраздничныеДни") Тогда
		
		Если (Источник.Проведен И Не Источник.ИКТ_ВыгруженоИзЕРП) Или (Не Источник.Проведен И Источник.ИКТ_ВыгруженоИзЕРП) Тогда
		
			Для Каждого Строка Из Источник.Сотрудники Цикл
				
				ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Строка.Сотрудник);
				Если ЗаписьСправочникаСКУД = Неопределено Тогда		
					Возврат;
				КонецЕсли;
				
				НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
				Если Источник.ПометкаУдаления = Ложь Тогда 
					НоваяЗаписьСправочникаСКУД.РаботаВВыходныеИПраздничныеДни = Источник.Ссылка;
				Иначе
					НоваяЗаписьСправочникаСКУД.РаботаВВыходныеИПраздничныеДни = Документы.РаботаВВыходныеИПраздничныеДни.ПустаяСсылка();
				КонецЕсли;
				НоваяЗаписьСправочникаСКУД.Записать();
				
			КонецЦикла;
		
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.Увольнение") Тогда
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"ДатаУвольнения") > НачалоДня(ТекущаяДатаСеанса()) Тогда
			ЗаписатьДанныеВ_РС_ИКТ_ДанныеКадровыхДокументовДляСКУД(Источник.Ссылка);
			Возврат;
		КонецЕсли;
		
		ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Источник.Сотрудник);
		Если ЗаписьСправочникаСКУД = Неопределено Тогда		
			ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Источник.Сотрудник);
		КонецЕсли;
		
		НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Проведен") Тогда
			НоваяЗаписьСправочникаСКУД.Увольнение = Источник.Ссылка;
		Иначе
			НоваяЗаписьСправочникаСКУД.Увольнение = Документы.Увольнение.ПустаяСсылка();	
		КонецЕсли;
		НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Источник.Сотрудник);
		НоваяЗаписьСправочникаСКУД.Записать();
		
		//23.05.24 Без делегации проходов - сотрудник блокируется в СИГУР (
		ЗаблокироватьСотрудникаВСКУД(НоваяЗаписьСправочникаСКУД.IDСотрудника);
		//23.05.24 Без делегации проходов - сотрудник блокируется в СИГУР )
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.УвольнениеСписком") Тогда
		
		Для Каждого Строка Из Источник.Сотрудники Цикл 
			
			Если Строка.ДатаУвольнения > НачалоДня(ТекущаяДатаСеанса()) Тогда
				ЗаписатьДанныеВ_РС_ИКТ_ДанныеКадровыхДокументовДляСКУД(Источник.Ссылка);
				Продолжить;
			КонецЕсли;
			
			ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Строка.Сотрудник);
			Если ЗаписьСправочникаСКУД = Неопределено Тогда		
				ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Строка.Сотрудник);
			КонецЕсли;
			
			НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Проведен") Тогда
				НоваяЗаписьСправочникаСКУД.Увольнение = Источник.Ссылка;
			Иначе
				НоваяЗаписьСправочникаСКУД.Увольнение = Документы.УвольнениеСписком.ПустаяСсылка();	
			КонецЕсли;
			НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Строка.Сотрудник);
			НоваяЗаписьСправочникаСКУД.Записать();
			
			//23.05.24 Без делегации проходов - сотрудник блокируется в СИГУР (
			ЗаблокироватьСотрудникаВСКУД(НоваяЗаписьСправочникаСКУД.IDСотрудника);
			//23.05.24 Без делегации проходов - сотрудник блокируется в СИГУР )
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаключениеМедицинскогоОсмотра") Тогда
		
		Если Константы.ИКТ_ИспользоватьЗаключениеМедицинскогоОсмотраСКУД.Получить() Тогда 
			Сотрудник = НайтиСотрудникаПоФизЛицу(Источник.ФизическоеЛицо);
			ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Сотрудник);
			Если ЗаписьСправочникаСКУД = Неопределено Тогда		
				ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Сотрудник);
			КонецЕсли;
			
			НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
			НоваяЗаписьСправочникаСКУД.ЗаключениеМедицинскогоОсмотра = Источник.Ссылка;
			НоваяЗаписьСправочникаСКУД.Записать();
			
			//Статусы
			НоваяЗаписьСправочникаСКУД = ИзменитьСтатусыЗаписиСправочникаДоступСКУД(НоваяЗаписьСправочникаСКУД, Источник, Сотрудник);
			НоваяЗаписьСправочникаСКУД.Записать();
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ИКТ_ДопускКРаботе") Тогда
		
		Для Каждого Строка Из Источник.Сотрудники Цикл	
			ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Строка.Сотрудник);
			Если ЗаписьСправочникаСКУД = Неопределено Тогда		
				ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Строка.Сотрудник)	
			КонецЕсли;
			НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
			
			АктуальноеУдостоверение = ПолучитьАктуальноеУдостоверениеСотрудника(Строка.Сотрудник);
			НоваяЗаписьСправочникаСКУД.Удостоверение = ?(ЗначениеЗаполнено(АктуальноеУдостоверение),
			АктуальноеУдостоверение,
			Строка.Удостоверение);	                                       
			НоваяЗаписьСправочникаСКУД.Записать();
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ИКТ_ОграничениеВЗоныДоступа") Тогда
		
		Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Сотрудник");
		ЗаписьСправочникаСКУД = НайтиЗаписьСправочникаСКУД(Сотрудник);	
		Действует = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник.Ссылка,"Действует");
		
		Если ЗаписьСправочникаСКУД = Неопределено Тогда		
			ЗаписьСправочникаСКУД = ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Сотрудник)	
		КонецЕсли;
		
		НоваяЗаписьСправочникаСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
		НоваяЗаписьСправочникаСКУД.ОграничениеДоступа = ?(Действует,Источник.Ссылка,Документы.ИКТ_ОграничениеВЗоныДоступа.ПустаяСсылка());
		НоваяЗаписьСправочникаСКУД.Записать();
	КонецЕсли;
	//Документы
	
КонецПроцедуры

Функция ИдентификаторСотрудникаИзСКУД(ФИО)
	
	//Параметры запроса
	QueryParameters = Новый Массив;
	
	//name
	nameМассив = Новый Массив;
	nameМассив.Добавить(ФИО);
	QueryParameters.Добавить(Новый Структура("name",nameМассив));
	
	//sortBy
	sortByМассив = Новый Массив;
	sortByМассив.Добавить("id");
	QueryParameters.Добавить(Новый Структура("sortBy",sortByМассив));
	
	//sortOrder
	sortOrderМассив = Новый Массив;
	sortOrderМассив.Добавить("DESC");
	QueryParameters.Добавить(Новый Структура("sortOrder",sortOrderМассив));
	
	QueryParameters = ИКТ_SigurApi.ЗадатьQueryParameters(QueryParameters);
	
	Ответ = ИКТ_SigurApi.Получить("employees",,QueryParameters,,10);
	Если ТипЗнч(Ответ) = Тип("Число") Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось получить идентификатор сотрудника СКУД. Код ошибки:"+Ответ);
		Возврат 0;
	Иначе
		Если Ответ.Количество() Тогда
			Возврат Ответ[0].id;
		Иначе
			Возврат 0;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// Функция - Проверить наличие доступа
// Проверяет в справочнике ИКТ_ДоступСКУД может ли сотрудник с таким значением карты пройти в такую точку
// Параметры:
//  keyHex		Значение карты - Строка - Hex значение карты доступа 
//  accessPoint	Точка доступа - Строка - Номер точки доступа
// 
// Возвращаемое значение:
//  Булево 
//
Функция ПроверитьНаличиеДоступа(keyHex,accessPoint) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст=
		"ВЫБРАТЬ
		|	ИКТ_Пропуска.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ Пропуск
		|ИЗ
		|	РегистрСведений.ИКТ_Пропуска КАК ИКТ_Пропуска
		|ГДЕ
		|	ИКТ_Пропуска.ЗначениеКарты = &ЗначениеКарты
		|	И ИКТ_Пропуска.Действует = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИКТ_ДоступСКУД.IDСотрудника КАК IDСотрудника,
		|	ИКТ_ДоступСКУД.Должность КАК Должность,
		|	ИКТ_ДоступСКУД.Подразделение КАК Подразделение,
		|	ИКТ_ДоступСКУД.ПриемНаРаботу КАК ПриемНаРаботу,
		|	ИКТ_ДоступСКУД.ЗаключениеМедицинскогоОсмотра КАК ЗаключениеМедицинскогоОсмотра,
		|	ИКТ_ДоступСКУД.ГрафикРаботы КАК ГрафикРаботы,
		|	ИКТ_ДоступСКУД.РаботаВВыходныеИПраздничныеДни КАК РаботаВВыходныеИПраздничныеДни,
		|	ИКТ_ДоступСКУД.Увольнение КАК Увольнение,
		|	ИКТ_ДоступСКУД.ЗоныИТочкиДоступа.(
		|		ЗонаДоступа.ТребуетсяДопуск КАК ЗонаДоступаТребуетсяДопуск,
		|		ЗонаДоступа.ГруппаДопуска КАК ЗонаДоступаГруппаДопуска,
		|		ЗонаДоступа.НуженМедосмотр КАК ЗонаДоступаНуженМедосмотр,
		|		ЗонаДоступа.Ссылка КАК ЗонаДоступаСсылка
		|	) КАК ЗоныИТочкиДоступа,
		|	ИКТ_ДоступСКУД.Сотрудник КАК Сотрудник,
		|	ИКТ_ДоступСКУД.СтатусыДоступа.(
		|		Статус КАК Статус
		|	) КАК СтатусыДоступа,
		|	ИКТ_ДоступСКУД.ОграничениеДоступа КАК ОграничениеДоступа
		|ИЗ
		|	Пропуск КАК Пропуск
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИКТ_ДоступСКУД КАК ИКТ_ДоступСКУД
		|		ПО Пропуск.Сотрудник.Ссылка = ИКТ_ДоступСКУД.Сотрудник.Ссылка";
		Запрос.УстановитьПараметр("ЗначениеКарты",keyHex);	
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Ложь
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			
			Если Не ЗначениеЗаполнено(Выборка.IDСотрудника)
				Или Не ЗначениеЗаполнено(Выборка.Должность)
				Или Не ЗначениеЗаполнено(Выборка.Подразделение)
				Или Не ЗначениеЗаполнено(Выборка.ПриемНаРаботу)
				Или Не ЗначениеЗаполнено(Выборка.ГрафикРаботы)
				Или Не ЗначениеЗаполнено(Выборка.ЗоныИТочкиДоступа) Тогда
				Возврат Ложь
			Иначе
				
				//Пропуск на вход предприятия, если сотрудник не уволен (
				Если Не ЗначениеЗаполнено(Выборка.Увольнение)
				И ЗначениеЗаполнено(Выборка.ГрафикРаботы) Тогда	
					Если ЭтоТочкаВходаПредприятия(accessPoint) Тогда			
						Если Не ТекущееВремяСовпадаетСоСменой(Выборка.ГрафикРаботы) Тогда				
							Если ЗначениеЗаполнено(Выборка.РаботаВВыходныеИПраздничныеДни) Тогда
								Если ТекущаяДатаСовпадаетСРаботойВВыходной(Выборка.РаботаВВыходныеИПраздничныеДни, Выборка.Сотрудник) Тогда
									Возврат Истина;
								Иначе
									Возврат Ложь;
								КонецЕсли;
							Иначе
								Возврат Ложь;
							КонецЕсли;
						Иначе
							Возврат Истина;	
						КонецЕсли;
					КонецЕсли;
				Иначе
					Возврат Ложь;
				КонецЕсли;
				//Пропуск на вход предприятия, если сотрудник не уволен )
	
				Если Выборка.СтатусыДоступа.Пустой() Тогда
					Возврат Ложь
				КонецЕсли;
				
				СотрудникИмеетДоступКТочке = Ложь;
				ВыборкаЗоныТочки = Выборка.ЗоныИТочкиДоступа.Выбрать();
				Пока ВыборкаЗоныТочки.Следующий() Цикл
					
					ТЧТочкиДоступа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаЗоныТочки.ЗонаДоступаСсылка,"ТочкиДоступа");
					ТЗТочкиДоступа = ТЧТочкиДоступа.Выгрузить();
					////Изменил 18.12 (
					//МассТочек = ТЗТочкиДоступа.НайтиСтроки(Новый Структура("Код,ТипПрохода",accessPoint,Перечисления.ИКТ_ТипПроходаТочекДоступа.Выход));
					МассТочек = ТЗТочкиДоступа.НайтиСтроки(Новый Структура("Код,ТипПрохода",accessPoint,Перечисления.ИКТ_ТипПроходаТочекДоступа.Вход));
					////Изменил 18.12 )
					
					Если МассТочек.Количество() Тогда
						//Если нужен допуск на точку 05.12.23 (
						Если Константы.ИКТ_ИспользоватьБлокировкуПоДопускамСКУД.Получить() И ВыборкаЗоныТочки.ЗонаДоступаТребуетсяДопуск Тогда
							Если Не ПроверитьДопуск(Выборка.Сотрудник, ВыборкаЗоныТочки.ЗонаДоступаГруппаДопуска) Тогда
								Возврат Ложь;
							КонецЕсли;
						КонецЕсли;
						//Если нужен допуск на точку 05.12.23 )
						
						//Если нужен меодсмотр (
						Если Константы.ИКТ_ИспользоватьЗаключениеМедицинскогоОсмотраСКУД.Получить()
							И ВыборкаЗоныТочки.ЗонаДоступаНуженМедосмотр Тогда
							Если Не ЗначениеЗаполнено(Выборка.ЗаключениеМедицинскогоОсмотра) Тогда
								Возврат Ложь
							ИначеЕсли ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ЗаключениеМедицинскогоОсмотра,"РезультатОсмотра") =
								Перечисления.РезультатыМедицинскогоОсмотра.ИмеетПротивопоказания Тогда
								Возврат Ложь
							КонецЕсли;
						КонецЕсли;
						//Если нужен меодсмотр )
						
						//Ограничение доступа (
						Если ЗначениеЗаполнено(Выборка.ОграничениеДоступа) Тогда
							ТЧОграниченныеЗоны = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ОграничениеДоступа,"ЗоныДоступа").Выгрузить();
						    МассивОграниченныхЗон = ТЧОграниченныеЗоны.НайтиСтроки(Новый Структура("Зона",ВыборкаЗоныТочки.ЗонаДоступаСсылка));
							Если МассивОграниченныхЗон.Количество() Тогда
								Возврат Ложь		
							КонецЕсли;
						КонецЕсли;
						//Ограничение доступа )
						
						СотрудникИмеетДоступКТочке = Истина;
						Прервать;	
					КонецЕсли;
				КонецЦикла;
				
				Если Не СотрудникИмеетДоступКТочке Тогда
					Возврат Ложь
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.Увольнение) Тогда
					Если ТипЗнч(Выборка.Увольнение) = Тип("ДокументСсылка.Увольнение") Тогда
						Если ТекущаяДатаСеанса() > КонецДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.Увольнение,"ДатаУвольнения")) Тогда
							Возврат Ложь
						КонецЕсли;
					Иначе
						СтрСотрудник = Выборка.Увольнение.Сотрудники.НайтиСтроки(Новый Структура("Сотрудник",Выборка.Сотрудник));
						Если ТекущаяДатаСеанса() > КонецДня(СтрСотрудник[0].ДатаУвольнения) Тогда
							Возврат Ложь
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если Не ТекущееВремяСовпадаетСоСменой(Выборка.ГрафикРаботы) Тогда
					Если ЗначениеЗаполнено(Выборка.РаботаВВыходныеИПраздничныеДни)
					И ТекущаяДатаСовпадаетСРаботойВВыходной(Выборка.РаботаВВыходныеИПраздничныеДни, Выборка.Сотрудник) Тогда
						Возврат Истина;
					Иначе
						Возврат Ложь;	
					КонецЕсли;
				Иначе
					Возврат Истина;
				КонецЕсли;
								
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("Проверка доступа",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Процедура - Записать события прохода
// Делает записи в РС ИКТ_СобытияПроходаСКУД о фактических проходах зарегистрированных в СКУД
