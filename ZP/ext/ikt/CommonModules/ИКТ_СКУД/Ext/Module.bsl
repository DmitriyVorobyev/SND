	//Для "Wiegand 34 НомерКолонкиПропуска = 9 
	НомерКолонкиПропуска = 9;
	//НомерКолонкиФамилия = 14;
	//НомерКолонкиИмя = 15;
	Для Сч = 8 по КолСтр Цикл
		Попытка
			ТБ = ТЗ.Добавить();
			//Обращаемся к ячейки и забираем данные
			ТБ.ИдентификаторКарты = Строка(ТабДок.ПолучитьОбласть("R" + Формат(Сч, "ЧГ=0") + "C" + НомерКолонкиПропуска).ТекущаяОбласть.Текст);		
			//Фамилия = Строка(ТабДок.ПолучитьОбласть("R" + Формат(Сч, "ЧГ=0") + "C" + НомерКолонкиФамилия).ТекущаяОбласть.Текст);
			//Имя = Строка(ТабДок.ПолучитьОбласть("R" + Формат(Сч, "ЧГ=0") + "C" + НомерКолонкиИмя).ТекущаяОбласть.Текст);	
			//ТБ.ФИ = Фамилия+" "+Имя; 
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось загрузить строку "+Строка(Сч);
			Сообщение.Сообщить();
		КонецПопытки;
	КонецЦикла;
	Возврат ТЗ 
		
