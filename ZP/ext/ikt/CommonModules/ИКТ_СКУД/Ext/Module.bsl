Процедура ИзменитьЗоныДоступа(ОтветЗоныДоступа) Экспорт
	
	//Пометка на удаление недействительных зон (
	ЗапросЗоны = Новый Запрос;
	ЗапросЗоны.Текст =
	"ВЫБРАТЬ
	|	ИКТ_ЗоныДоступа.Ссылка КАК Ссылка,
	|	ИКТ_ЗоныДоступа.Код КАК Код
	|ИЗ
	|	Справочник.ИКТ_ЗоныДоступа КАК ИКТ_ЗоныДоступа
	|ГДЕ
	|	ИКТ_ЗоныДоступа.ПометкаУдаления = ЛОЖЬ";
	ВыборкаЗоны = ЗапросЗоны.Выполнить().Выбрать();	
	Пока ВыборкаЗоны.Следующий() Цикл
		ЗонаСуществует = Ложь;
		Для Каждого СтрокаМассива Из ОтветЗоныДоступа Цикл
			Если СтрокаМассива.id = ВыборкаЗоны.Код Тогда
				ЗонаСуществует = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗонаСуществует Тогда
			ЗонаНаУдаление = ВыборкаЗоны.Ссылка.ПолучитьОбъект();
			ЗонаНаУдаление.ПометкаУдаления = Истина;
			ЗонаНаУдаление.Записать();
		КонецЕсли;
	КонецЦикла;
	//Пометка на удаление недействительных зон )
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИКТ_ЗоныДоступа.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИКТ_ЗоныДоступа КАК ИКТ_ЗоныДоступа
	|ГДЕ
	|	ИКТ_ЗоныДоступа.Код = &Код";
	Для Каждого Строка Из ОтветЗоныДоступа Цикл
		Запрос.УстановитьПараметр("Код", Строка.id);
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			НоваяЗапись = Справочники.ИКТ_ЗоныДоступа.СоздатьЭлемент();
			НоваяЗапись.Код = Строка.id;
			НоваяЗапись.Наименование = Строка.name;
			Для Каждого Стр Из Строка.accessPoints Цикл
				МассивСтрок = НоваяЗапись.ТочкиДоступа.НайтиСтроки(Новый Структура("Код",Стр.id));
				Если МассивСтрок.Количество() = 0 Тогда
					ТочкаДоступа = НоваяЗапись.ТочкиДоступа.Добавить();
					ТочкаДоступа.Точка = НайтиСсылкуНаТочкуДоступа(Стр.id);
					ТочкаДоступа.Код = Стр.id;	
					ТочкаДоступа.ТипПрохода = ?(Стр.direction="IN",Перечисления.ИКТ_ТипПроходаТочекДоступа.Вход,Перечисления.ИКТ_ТипПроходаТочекДоступа.Выход);
				КонецЕсли;
			КонецЦикла;
			НоваяЗапись.Записать();
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ЗД = Выборка.Ссылка.ПолучитьОбъект();
			ЗД.Наименование = Строка.name;
			ЗД.ПометкаУдаления = Ложь;
			
			ЗД.ТочкиДоступа.Очистить();
			Для Каждого Стр Из Строка.accessPoints Цикл
				ТочкаДоступа = ЗД.ТочкиДоступа.Добавить();
				ТочкаДоступа.Точка = НайтиСсылкуНаТочкуДоступа(Стр.id);
				ТочкаДоступа.Код = Стр.id;	
				ТочкаДоступа.ТипПрохода = ?(Стр.direction="IN",Перечисления.ИКТ_ТипПроходаТочекДоступа.Вход,Перечисления.ИКТ_ТипПроходаТочекДоступа.Выход);
			КонецЦикла;	
			ЗД.Записать();
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ИзменитьТочкиДоступа(ОтветТочкиДоступа) Экспорт
	
	//Пометка на удаление недействительных точек (
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИКТ_ТочкиДоступа.Ссылка КАК Ссылка,
	|	ИКТ_ТочкиДоступа.Код КАК Код
	|ИЗ
	|	Справочник.ИКТ_ТочкиДоступа КАК ИКТ_ТочкиДоступа
	|ГДЕ
	|	ИКТ_ТочкиДоступа.ПометкаУдаления = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТочкаСуществует = Ложь;
		Для Каждого СтрокаМассива Из ОтветТочкиДоступа Цикл
			Если СтрокаМассива.id = Выборка.Код Тогда
				ТочкаСуществует = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ТочкаСуществует Тогда
			ТочкаНаУдаление = Выборка.Ссылка.ПолучитьОбъект();
			ТочкаНаУдаление.ПометкаУдаления = Истина;
			ТочкаНаУдаление.Записать();	
		КонецЕсли;
	КонецЦикла;
	//Пометка на удаление недействительных точек )
	
	Для Каждого Строка Из ОтветТочкиДоступа Цикл
		ТочкаДоступаСсылка = НайтиСсылкуНаТочкуДоступа(Строка.id);
		Если ТочкаДоступаСсылка = Неопределено Тогда
			НоваяЗапись = Справочники.ИКТ_ТочкиДоступа.СоздатьЭлемент();
			НоваяЗапись.Код = Строка.id;
			НоваяЗапись.Наименование = Строка.name;
			НоваяЗапись.Записать();
		Иначе
			ТД = ТочкаДоступаСсылка.ПолучитьОбъект();
			ТД.Наименование = Строка.name;
			ТД.ПометкаУдаления = Ложь;
			ТД.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиСсылкуНаТочкуДоступа(id)
	Запрос = Новый Запрос;
