// Возвращаемое значение:
// СтрукСтрок - Структура 
//
Функция ПолучитьСписокПропусковИзФайла()
	
	//Обработка через Excel
	//Читаем excel документ
	ТабДок = Новый ТабличныйДокумент;
	Попытка
