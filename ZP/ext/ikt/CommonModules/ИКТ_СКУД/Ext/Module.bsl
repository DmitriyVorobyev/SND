Функция НайтиЗаписьСправочникаСКУД(Сотрудник) Экспорт
	
	ЗапросСотрудник = Новый Запрос;
	ЗапросСотрудник.Текст=
	"ВЫБРАТЬ
	|	ИКТ_ДоступСКУД.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИКТ_ДоступСКУД КАК ИКТ_ДоступСКУД
	|ГДЕ
	|	ИКТ_ДоступСКУД.Сотрудник.Ссылка = &Ссылка";
	ЗапросСотрудник.УстановитьПараметр("Ссылка",Сотрудник);
	РезультатЗапроса = ЗапросСотрудник.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции

Функция ЗаписатьСотрудникаВСправочникИКТ_ДоступСКУД(Сотрудник) Экспорт
	
	НоваяЗапись = Справочники.ИКТ_ДоступСКУД.СоздатьЭлемент();
	НоваяЗапись.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник,"Наименование");
	НоваяЗапись.Сотрудник = Сотрудник;
	НоваяЗапись.IDСотрудника = ИдентификаторСотрудникаИзСКУД(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник,"Наименование"));
	НоваяЗапись.Записать();
	Возврат НоваяЗапись.Ссылка;
	
КонецФункции

// Процедура - Создать сотрудника ВСКУД
// При записи нового сотрудника создаёт его в СКУД путём http запроса
// Параметры:
//  ЗаписьСправочникаСКУД	Ссылка на элемент - СправочникСсылка.ИКТ_ДоступСКУД - Ссылка на элемент справочника ИКТ_ДоступСКУД
//  IdПодразделения			ID Подразделения - Строка - ID Подразделения 1С под которым числится объект в СКУД
//  IdДолжности				ID Должности - Строка - ID Должности 1С под которым числится объект в СКУД
//
Процедура СоздатьСотрудникаВСКУД(ЗаписьСправочникаСКУД, IdПодразделения=Неопределено,IdДолжности=Неопределено)

	//Сотрудники грузятся из САП в СКУД
	ЗаписьСКУД = ЗаписьСправочникаСКУД.ПолучитьОбъект();
	Id = ИдентификаторСотрудникаИзСКУД(ЗаписьСКУД.Наименование);
	ЗаписьСКУД.IDСотрудника = Id;
	ЗаписьСКУД.Записать();
	Возврат;
	
	Если ЗначениеЗаполнено(IdПодразделения) Тогда 
		
		НоваяЗапись = ЗаписьСправочникаСКУД.ПолучитьОбъект();
		СтрукСотрудника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяЗапись.Сотрудник,"Наименование,Код,ФизическоеЛицо");
		ФИО = СтрукСотрудника.Наименование;
		ТабНомер = СтрукСотрудника.Код;
		ФизическоеЛицо = СтрукСотрудника.ФизическоеЛицо;
		
		СотрудникСКУДСтрук = Новый Структура;
		СотрудникСКУДСтрук.Вставить("name",ФИО);
		СотрудникСКУДСтрук.Вставить("departmentId",IdПодразделения);
		Если ЗначениеЗаполнено(IdДолжности) Тогда
			СотрудникСКУДСтрук.Вставить("positionId",IdДолжности);
		КонецЕсли;
		//22.05.24 (
		//Фото
		ЗапросФото = Новый Запрос;
		ЗапросФото.Текст = 
		"ВЫБРАТЬ
		|	ФотографииФизическихЛиц.Фотография КАК Фотография
		|ИЗ
		|	РегистрСведений.ФотографииФизическихЛиц КАК ФотографииФизическихЛиц
		|ГДЕ
		|	ФотографииФизическихЛиц.ФизическоеЛицо.Ссылка = &Ссылка";
		ЗапросФото.УстановитьПараметр("Ссылка",ФизическоеЛицо);
		РезЗапросаФото = ЗапросФото.Выполнить();
		Если Не РезЗапросаФото.Пустой() Тогда
			ВыборкаФото = РезЗапросаФото.Выбрать();
			ВыборкаФото.Следующий();
			Попытка
				СотрудникСКУДСтрук.Вставить("photo",Base64Строка(ВыборкаФото.Фотография));
			Исключение
				ЗаписьЖурналаРегистрации("Регистрация сотрудника СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		//Контактные данные
		МассивТиповКИ = Новый Массив;
		МассивТиповКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);
		МассивТиповКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		МассивВидовКИ = Новый Массив;
		МассивВидовКИ.Добавить(Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
		МассивВидовКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица);
		МассивВидовКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);
		КИСотрудника = КонтактнаяИнформацияБЗК.КонтактнаяИнформацияОбъектов(ФизическоеЛицо,МассивТиповКИ,МассивВидовКИ,ТекущаяДатаСеанса());
		
		Если КИСотрудника.Количество() Тогда
			КИСотрудника.Сортировать("Дата Убыв");
			contactDetails = Новый Массив;
			//Телефон
			СтрукОтбораТелефон = Новый Структура;
			СтрукОтбораТелефон.Вставить("Вид",МассивВидовКИ[1]);
			СтрукОтбораТелефон.Вставить("Тип",МассивТиповКИ[0]);
			МассТелефонРабочий = КИСотрудника.НайтиСтроки(СтрукОтбораТелефон);
			Если МассТелефонРабочий.Количество() Тогда
				СтрукТелефон = Новый Структура;
				СтрукТелефон.Вставить("type","SMS");
				СтрукТелефон.Вставить("value",МассТелефонРабочий[0].Представление);
				contactDetails.Добавить(СтрукТелефон);
			Иначе
				СтрукОтбораТелефон.Вставить("Вид",МассивВидовКИ[2]);
				МассТелефонМобильный = КИСотрудника.НайтиСтроки(СтрукОтбораТелефон);
				Если МассТелефонМобильный.Количество() Тогда
					СтрукТелефон = Новый Структура;
					СтрукТелефон.Вставить("type","SMS");
					СтрукТелефон.Вставить("value",МассТелефонМобильный[0].Представление);
					contactDetails.Добавить(СтрукТелефон);	
				КонецЕсли;
			КонецЕсли;
			
			//EMAIL
			СтрукОтбораEMAIL = Новый Структура;
			СтрукОтбораEMAIL.Вставить("Вид",МассивВидовКИ[0]);
			СтрукОтбораEMAIL.Вставить("Тип",МассивТиповКИ[1]);
			МассEMAIL = КИСотрудника.НайтиСтроки(СтрукОтбораEMAIL);
			Если МассEMAIL.Количество() Тогда
				СтрукEMAIL = Новый Структура;
				СтрукEMAIL.Вставить("type","EMAIL");
				СтрукEMAIL.Вставить("value",МассEMAIL[0].Представление);
				contactDetails.Добавить(СтрукEMAIL);
			КонецЕсли;
		КонецЕсли;
		
		//Табельный номер
		Если ЗначениеЗаполнено(ТабНомер) Тогда
			СотрудникСКУДСтрук.Вставить("tabId",ТабНомер);
		КонецЕсли;
		//22.05.24 )
		
		Попытка
			
			ОтветСотрудник = ИКТ_SigurApi.Отправить("employees",,СотрудникСКУДСтрук);
			Если ТипЗнч(ОтветСотрудник) = Тип("Число") Тогда
				ВызватьИсключение("Ошибка при отправке данных сотрудника "+ФИО+". Сотрудник в СКУД не создан! Код ошибки: "+ОтветСотрудник);
			Иначе
				НоваяЗапись.IDСотрудника = ОтветСотрудник.id;
				НоваяЗапись.Записать();
			КонецЕсли;
			
		Исключение
			ЗаписьЖурналаРегистрации("Регистрация сотрудника СКУД",УровеньЖурналаРегистрации.Ошибка,,ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ЗаписьЖурналаРегистрации("Регистрация сотрудника СКУД",УровеньЖурналаРегистрации.Ошибка,,"Нет кода подразделения сотрудника "+ФИО+". Сотрудник в СКУД не создан!");
	КонецЕсли;
	
КонецПроцедуры

// Функция - Получить список пропусков из файла
