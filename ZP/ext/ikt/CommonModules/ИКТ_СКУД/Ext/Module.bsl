		КонецЕсли;
		
		Для Каждого Событие из СобытияПрохода Цикл

			//Если проход неопределен accessObjectId = 0
			Если Событие.accessObjectId = 0 Тогда
				//Чтобы события двигались дальше, а не застревали на lastId
				ИндЭл = СобытияПрохода.Найти(Событие);
				Если ИндЭл = КолВоСобытий - 1 Тогда
					НаборЗаписей = РегистрыСведений.ИКТ_СобытияПроходаСКУД.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.ID_Прохода.Установить(Событие.id);
					НоваяЗапись = НаборЗаписей.Добавить();
					НоваяЗапись.ID_Прохода = Событие.id;
					НаборЗаписей.Записать();
