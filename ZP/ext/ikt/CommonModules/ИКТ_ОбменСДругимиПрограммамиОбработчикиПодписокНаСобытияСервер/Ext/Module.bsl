// Обработчик подписки на событие ИКТ_ОбменСЕРПУАТРегистрацияНабора
// 
// Параметры:
//  Источник 	- СправочникОбъект.Сотрудники, СправочникОбъект.ФизическиеЛица 	- Источник
//  Отказ 		- Булево 														- Признак отказа от действия
//
Процедура ИКТ_ОбменСЕРПУАТРегистрацияНабораПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//Если Не СтрокаСоединенияИнформационнойБазы() = "Srvr=""SND-1C"";Ref=""w_SND_HRM"";" Тогда
	//	Возврат;
	//КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ФИОФизическихЛиц") Тогда   
		// При изменении регистра ФИОФизическихЛиц зарегистрируем физлицо к обмену 
		ФизическиеЛицаИзНабора = Новый Массив;
		Для Каждого Запись Из Источник Цикл 
			ОбменДаннымиСобытия.ВыполнитьПравилаРегистрацииДляОбъекта(Запись.ФизическоеЛицо, "ИКТ_ОбменЗУПЕРП"); 
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.КадроваяИсторияСотрудниковИнтервальный") Тогда 
		// Зарегистрируем физлиц к обмену при приеме на работу, т.к. необходимо передавать с сотрудником дату приема 
		ОбработанныеСотрудники = Новый Массив; // Исключим формирование дублей сообщений по одиним и тем же сотрудникам из набора
		Для Каждого Запись Из Источник Цикл   
			Если ОбработанныеСотрудники.Найти(Запись.ФизическоеЛицо) = Неопределено Тогда
				ОбменДаннымиСобытия.ВыполнитьПравилаРегистрацииДляОбъекта(Запись.ФизическоеЛицо, "ИКТ_ОбменЗУПЕРП"); 
				ОбработанныеСотрудники.Добавить(Запись.ФизическоеЛицо);
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ГрафикРаботыСотрудниковИнтервальный") Тогда 
		// Зарегистрируем сотрудников к обмену при изменении графика работы, т.к. необходимо по графику пересчитывать тарифную ставку в оклад
		ОбработанныеСотрудники = Новый Массив; // Исключим формирование дублей сообщений по одиним и тем же сотрудникам из набора
		Для Каждого Запись Из Источник Цикл   
			Если ОбработанныеСотрудники.Найти(Запись.Сотрудник.ФизическоеЛицо) = Неопределено Тогда
				ОбменДаннымиСобытия.ВыполнитьПравилаРегистрацииДляОбъекта(Запись.Сотрудник.ФизическоеЛицо, "ИКТ_ОбменЗУПЕРП"); 
				ОбработанныеСотрудники.Добавить(Запись.Сотрудник.ФизическоеЛицо);
			КонецЕсли;
		КонецЦикла;			
	КонецЕсли;
КонецПроцедуры

// Обработчик подписки на событие ИКТ_ОбменЕРПУАТРегистрацияПриЗаписи
// 
// Параметры:
//  Источник 	- СправочникОбъект.ФизическиеЛица 	- Источник
//  Отказ 		- Булево 							- Признак отказа от действия
//
Процедура ИКТ_ОбменЕРПУАТРегистрацияПриЗаписи(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Если Не СтрокаСоединенияИнформационнойБазы() = "Srvr=""SND-1C"";Ref=""w_SND_HRM"";" Тогда
	//	Возврат;
	//КонецЕсли;  
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "ГоловнаяОрганизация") Тогда 
		Организация = Источник.ГоловнаяОрганизация;
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, "Организация") Тогда 
		Организация = Источник.ГоловнаяОрганизация;
	Иначе 
		Организация = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И Организация.ИКТ_УУ Тогда 
		Возврат
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Или Источник.ДополнительныеСвойства.Свойство("ОтложеннаяЗапись") Тогда
		Возврат;
	КонецЕсли;
	
	ОбменДаннымиСобытия.ВыполнитьПравилаРегистрацииДляОбъекта(Источник.Ссылка, "ИКТ_ОбменЗУПЕРП"); 
	
КонецПроцедуры

