Процедура ИКТ_РегистрацияНабора_ИКТ_ОбменЗУПЕРППередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник.Отбор, "Сотрудник") Тогда 
		Организация = Источник.Отбор.Сотрудник.Значение.ГоловнаяОрганизация;
	Иначе 
		Организация = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И Организация.ИКТ_УУ Тогда 
		Возврат
	КонецЕсли; 
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник.Отбор, "Регистратор") Тогда 
		Организация = Источник.Отбор.Регистратор.Значение.Организация;
	Иначе 
		Организация = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И Организация.ИКТ_УУ Тогда 
		Возврат
	КонецЕсли;
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	//Если Не СтрокаСоединенияИнформационнойБазы() = "Srvr=""SND-1C"";Ref=""w_SND_HRM"";" Тогда
	//	Возврат;
	//КонецЕсли;
	
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписьюРегистра("ИКТ_ОбменЗУПЕРП", Источник, Отказ, Замещение);
	
КонецПроцедуры
