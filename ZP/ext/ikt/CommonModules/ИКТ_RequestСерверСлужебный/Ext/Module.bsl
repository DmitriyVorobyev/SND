Функция ПолучитьСотрудниковУОС()
	
	Сотрудники = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗанятостьПозицийШтатногоРасписанияСрезПоследних.Сотрудник КАК Сотрудник
		|ИЗ
		|	РегистрСведений.ЗанятостьПозицийШтатногоРасписания.СрезПоследних(&ДатаСреза, ГоловнаяОрганизация.ИКТ_УУ = ИСТИНА) КАК ЗанятостьПозицийШтатногоРасписанияСрезПоследних
		|ГДЕ
		|	ЗанятостьПозицийШтатногоРасписанияСрезПоследних.ВидЗанятостиПозиции = &ВидЗанятостиПозиции
		|	И ЗанятостьПозицийШтатногоРасписанияСрезПоследних.Сотрудник.ВАрхиве = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДата());
	Запрос.УстановитьПараметр("ВидЗанятостиПозиции", Перечисления.ВидыЗанятостиПозицийШтатногоРасписания.Занята);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл   
		
		Сотрудники.Добавить(Выборка.Сотрудник);
				
	КонецЦикла; 
	
	Возврат Сотрудники;
	
КонецФункции

