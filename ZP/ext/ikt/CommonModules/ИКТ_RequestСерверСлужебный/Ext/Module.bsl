
//100 - Сотрудники (пользователи) - обновляется 1 раз в час.
//101 - Должности С (типовые должности) - обновляется 1 раз в час.
//119 - Связи подчиненности (Руководители) - обновляется 1 раз в час, полное замещение справочника в Request.
//134 - Штатное расписание (Должности S) - обновляется 1 раз в час.
//137 - Опоздания (Нарушения КРВ) - обновляется 1 раз в час, полное замещение справочника в Request.
//173 - Замещения - обновляется 1 раз в час.
			  
			  
Функция ПодготовитьПараметрыСообщения() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ДействиеОбмена");
	Результат.Вставить("ОснованиеСобытияОбъект"); 
	Результат.Вставить("ДопАналитика");
	Результат.Вставить("ИмяСобытия"); 
	Результат.Вставить("СобытиеСсылка");
	Результат.Вставить("ДополнительныеПараметры");
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьСообщениеОбменаПоОснованиюСобытия(ПараметрыСообщения, Отказ) Экспорт   
	
	Результат = "";  
	
	Если Не ЗначениеЗаполнено(ПараметрыСообщения.ИмяСобытия) Тогда
		ОбработчикОбъекта = ПараметрыСообщения.ОснованиеСобытияОбъект.Метаданные().Имя; 
	Иначе
	    ОбработчикОбъекта = ПараметрыСообщения.ИмяСобытия; 
	Конецесли;
	
	Попытка
		
		Выполнить(СтрШаблон("Результат = СформироватьДанныеДляОтправкиВRequest%1(ПараметрыСообщения, Отказ)", ОбработчикОбъекта));
		
	Исключение 
		
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не удалось подготовить данные для отправки в Request по причине: %1", ОписаниеОшибки())); 
				
	КонецПопытки; 
	
	Возврат Результат;
	
КонецФункции 

Функция СформироватьДанныеДляОтправкиВRequestСотрудники(ПараметрыСообщения, Отказ)//100 
	
	Если ПараметрыСообщения.ОснованиеСобытияОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПодготовитьСообщениеДляСотрудника(ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка, ПараметрыСообщения, Отказ);

КонецФункции

Функция СформироватьДанныеДляОтправкиВRequestУтверждениеШтатногоРасписания(ПараметрыСообщения, Отказ) 
	
	Если ПараметрыСообщения.ОснованиеСобытияОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СформироватьДанныеДляОтправкиВRequestШтатноеРасписание(ПараметрыСообщения, Отказ)
	
КонецФункции

Функция СформироватьДанныеДляОтправкиВRequestШтатноеРасписание(ПараметрыСообщения, Отказ)//134 (УтверждениеШтатногоРасписания)
	
	ТаблицаВФормате = ПодготовитьТаблицуДляЗагрузкиВRequest("ШтатноеРасписание"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УтверждениеШтатногоРасписанияПозиции.Позиция КАК Позиция
		|ПОМЕСТИТЬ ВТ_ПозицияШР
		|ИЗ
		|	Документ.УтверждениеШтатногоРасписания.Позиции КАК УтверждениеШтатногоРасписанияПозиции
		|ГДЕ
		|	УтверждениеШтатногоРасписанияПозиции.Ссылка = &ДокСсылка
		|	И УтверждениеШтатногоРасписанияПозиции.Действие <> ЗНАЧЕНИЕ(Перечисление.ДействияСПозициямиШтатногоРасписания.ЗакрытьПозицию)
		|	И УтверждениеШтатногоРасписанияПозиции.Позиция В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Пользователи.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ СотрудникПользователя
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Ссылка = &ТекущийПользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
		|	СУММА(ЗанятостьПозицийШтатногоРасписанияИнтервальный.КоличествоСтавок) КАК КоличествоСтавок
		|ПОМЕСТИТЬ ВТ_ЗанятостьСтавок
		|ИЗ
		|	РегистрСведений.ЗанятостьПозицийШтатногоРасписанияИнтервальный КАК ЗанятостьПозицийШтатногоРасписанияИнтервальный
		|ГДЕ
		|	НЕ ЗанятостьПозицийШтатногоРасписанияИнтервальный.ВидЗанятостиПозиции В (ЗНАЧЕНИЕ(Перечисление.ВидыЗанятостиПозицийШтатногоРасписания.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.ВидыЗанятостиПозицийШтатногоРасписания.Свободна))
		|	И &ДатаОстатков МЕЖДУ ЗанятостьПозицийШтатногоРасписанияИнтервальный.ДатаНачала И ЗанятостьПозицийШтатногоРасписанияИнтервальный.ДатаОкончания
		|	И ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания В(&Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ШтатноеРасписание.Наименование КАК НаименованиеШтатнойДолжности,
		|	ШтатноеРасписание.ID_ДолжностьS КАК IDШтатнойДолжности,
		|	ШтатноеРасписание.ИКТ_ДолжностьС.IDДолжностьС КАК IDДолжностиС,
		|	ПРЕДСТАВЛЕНИЕ(ШтатноеРасписание.ИКТ_ДолжностьС) КАК НаименованиеДолжностиС,
		|	ПРЕДСТАВЛЕНИЕ(ШтатноеРасписание.ИКТ_ДолжностьС) КАК ТекстДолжностиС,
		|	ШтатноеРасписание.ИКТ_Грейд КАК КатегорияСотрудника,
		|	ШтатноеРасписание.ДатаУтверждения КАК ДатаУтверждения,
		//|	ЕСТЬNULL(МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение.ИКТ_IDСП, """") КАК IDСтруктурыПредприятие,
		//|	ЕСТЬNULL(МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение.Наименование, """") КАК НаименованиеСтруктурыПредприятия, 
		//|	ВЫБОР
		//|		КОГДА ЕСТЬNULL(МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение.ИКТ_НаименованиеПолное, """") = """"
		//|			ТОГДА ЕСТЬNULL(МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение.Наименование, """")
		//|		ИНАЧЕ ЕСТЬNULL(МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение.ИКТ_НаименованиеПолное, """")
		//|	КОНЕЦ КАК НаименованиеПолноеСтруктурыПредприятия,  
		|	""50185764"" КАК IDОрганизационнойЕдиницы,
		|	""СНД"" КАК НаименованиеОрганизационнойЕдиницы,
       	|	СТРОКА(ШтатноеРасписание.Подразделение.ГоловнаяОрганизация.ИКТ_ОсновнаяОрганизация.НаименованиеСокращенное) КАК НаименованиеПолноеОрганизационнойЕдиницы,
		//|	ШтатноеРасписание.ИКТ_СозданиеПремийШтраф КАК ИКТ_СозданиеПремийШтраф,  
		|	ВЫБОР
		|		КОГДА ШтатноеРасписание.ИКТ_ДолжностьС.СозданиеПремийШтраф = Истина
		|			ТОГДА ""X""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ИКТ_СозданиеПремийШтраф,
		|	ШтатноеРасписание.ИКТ_ТребуетсяМедОсмотр КАК ИКТ_ТребуетсяМедОсмотр,
		//|	ШтатноеРасписание.ИКТ_НомерГруппы КАК ИКТ_Группа,
		|	ШтатноеРасписание.ИКТ_НомерГруппыПодбора КАК ИКТ_ГруппаПодбора,
		|	ШтатноеРасписание.ИКТ_БизнесЕдиница.ID КАК BE,
		|	ШтатноеРасписание.ИКТ_СрокДействияСтатусаВакансии КАК ИКТ_СрокДействияСтатусаВакансии,
		|	ВЫБОР
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Удаление)
		|			ТОГДА 3
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Изменение)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СтатусШЕ,
		//|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ШтатноеРасписание.Ссылка) КАК ГУИД_1С,
		|	СТРОКА(ШтатноеРасписание.ID_ДолжностьS) + ""/001"" КАК ID_Должность_S,
		|	&ИмяВнешнейСистемы КАК ИмяВнешнейСистемы,
		|	МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение КАК Подразделение,
		|	ВЫБОР
		|		КОГДА ШтатноеРасписание.КоличествоСтавок - ЕСТЬNULL(ВТ_ЗанятостьСтавок.КоличествоСтавок, 0) > 0
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК СтатусВакансии
		|ИЗ
		|	Справочник.ШтатноеРасписание КАК ШтатноеРасписание
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
		|		ПО (МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Позиция = ШтатноеРасписание.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ СотрудникПользователя КАК СотрудникПользователя
		|		ПО (ИСТИНА)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗанятостьСтавок КАК ВТ_ЗанятостьСтавок
		|		ПО (ВТ_ЗанятостьСтавок.ПозицияШтатногоРасписания = ШтатноеРасписание.Ссылка)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтборСправочнику = ИСТИНА
		|				ТОГДА ШтатноеРасписание.Ссылка В (&Ссылка)
		|			ИНАЧЕ ШтатноеРасписание.Ссылка В
		|					(ВЫБРАТЬ
		|						ВТ_ПозицияШР.Позиция КАК Позиция
		|					ИЗ
		|						ВТ_ПозицияШР КАК ВТ_ПозицияШР)
		|		КОНЕЦ";
	
	Если ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект) = Тип("СправочникОбъект.ШтатноеРасписание")
		ИЛИ ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект) = Тип("СправочникСсылка.ШтатноеРасписание") Тогда
		
		Если ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект) = Тип("СправочникОбъект.ШтатноеРасписание") Тогда
			Запрос.УстановитьПараметр("Ссылка", ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка);
		Иначе
			Запрос.УстановитьПараметр("Ссылка", ПараметрыСообщения.ОснованиеСобытияОбъект);  
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ОтборСправочнику", Истина); 
		Запрос.УстановитьПараметр("ДокСсылка", Документы.УтверждениеШтатногоРасписания.ПустаяСсылка());
		
	Иначе
		Запрос.УстановитьПараметр("Ссылка", ПараметрыСообщения.ДопАналитика);
		Запрос.УстановитьПараметр("ДокСсылка", ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка);  
		Запрос.УстановитьПараметр("ОтборСправочнику", ЛОЖЬ);  
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C");
	Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());   
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);  
	
	ТаблицаДанных1С = Запрос.Выполнить().Выгрузить();
	
	ЗаполнитьТаблицуДанныхПоРезультатуЗапроса(ТаблицаВФормате, ТаблицаДанных1С);		
					
	МассивДанных = ТаблицуЗначенийВМассивСтруктур(ТаблицаВФормате, "Заголовок");
	
	Если МассивДанных.Количество() = 0 Тогда 
		Отказ = Истина;
		Возврат "";
	КонецЕсли;   
		
	Возврат СформироватьТекстJSON(МассивДанных);
	
КонецФункции 

Функция СформироватьДанныеДляОтправкиВRequestИзменениеШтатногоРасписания(ПараметрыСообщения, Отказ) 
	
	Если ПараметрыСообщения.ОснованиеСобытияОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СформироватьДанныеДляОтправкиВRequestШтатноеРасписаниеИзменение(ПараметрыСообщения, Отказ)
	
КонецФункции

Функция СформироватьДанныеДляОтправкиВRequestШтатноеРасписаниеИзменение(ПараметрыСообщения, Отказ)//134 (ИзменениеШтатногоРасписания)
	
	ТаблицаВФормате = ПодготовитьТаблицуДляЗагрузкиВRequest("ШтатноеРасписание"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИзменениеШтатногоРасписанияПозиции.Позиция КАК Позиция
		|ПОМЕСТИТЬ ВТ_ПозицияШР
		|ИЗ
		|	Документ.ИзменениеШтатногоРасписания.Позиции КАК ИзменениеШтатногоРасписанияПозиции
		|ГДЕ
		|	ИзменениеШтатногоРасписанияПозиции.Ссылка = &ДокСсылка
		|	И ИзменениеШтатногоРасписанияПозиции.Действие <> ЗНАЧЕНИЕ(Перечисление.ДействияСПозициямиШтатногоРасписания.ЗакрытьПозицию)
		|	И ИзменениеШтатногоРасписанияПозиции.Позиция В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Пользователи.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ СотрудникПользователя
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Ссылка = &ТекущийПользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания КАК ПозицияШтатногоРасписания,
		|	СУММА(ЗанятостьПозицийШтатногоРасписанияИнтервальный.КоличествоСтавок) КАК КоличествоСтавок
		|ПОМЕСТИТЬ ВТ_ЗанятостьСтавок
		|ИЗ
		|	РегистрСведений.ЗанятостьПозицийШтатногоРасписанияИнтервальный КАК ЗанятостьПозицийШтатногоРасписанияИнтервальный
		|ГДЕ
		|	НЕ ЗанятостьПозицийШтатногоРасписанияИнтервальный.ВидЗанятостиПозиции В (ЗНАЧЕНИЕ(Перечисление.ВидыЗанятостиПозицийШтатногоРасписания.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.ВидыЗанятостиПозицийШтатногоРасписания.Свободна))
		|	И &ДатаОстатков МЕЖДУ ЗанятостьПозицийШтатногоРасписанияИнтервальный.ДатаНачала И ЗанятостьПозицийШтатногоРасписанияИнтервальный.ДатаОкончания
		|	И ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания В(&Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗанятостьПозицийШтатногоРасписанияИнтервальный.ПозицияШтатногоРасписания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ШтатноеРасписание.Наименование КАК НаименованиеШтатнойДолжности,
		|	ШтатноеРасписание.ID_ДолжностьS КАК IDШтатнойДолжности,
		|	ШтатноеРасписание.ИКТ_ДолжностьС.IDДолжностьС КАК IDДолжностиС,
		|	ПРЕДСТАВЛЕНИЕ(ШтатноеРасписание.ИКТ_ДолжностьС) КАК НаименованиеДолжностиС,
		|	ПРЕДСТАВЛЕНИЕ(ШтатноеРасписание.ИКТ_ДолжностьС) КАК ТекстДолжностиС,
		|	ШтатноеРасписание.ИКТ_Грейд КАК КатегорияСотрудника,
		|	ШтатноеРасписание.ДатаУтверждения КАК ДатаУтверждения,
