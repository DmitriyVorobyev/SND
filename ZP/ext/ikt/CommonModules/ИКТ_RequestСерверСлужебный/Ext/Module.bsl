	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("ExchangeSysName", "SND_1C");
	СтруктураДанных.Вставить("ExchangeRoute", "ИКТ_176");//176 - Тех. сбой СКУД
	СтруктураДанных.Вставить("OperationStatus", Выборка.СтатусСобытия);
	СтруктураДанных.Вставить("Key", Строка(ПараметрыСообщения.СобытиеСсылка.УникальныйИдентификатор()));
	СтруктураДанных.Вставить("Variables", Новый Массив);
	СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "DAT", Формат(Выборка.ДатаСобытия,"ДФ=yyyyMMdd; ДП=99991231")));
	СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "ORGEH", Выборка.ИКТ_IDЮрЛица));  
	СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SOTR_TOTAL", Выборка.КоличествоСотрудников));  
	СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "BEZ_OTMETOK", Выборка.КоличествоСотрудниковСИнцидентами));  
	СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "PROTSUT", Выборка.ПроцентИнцидентов));  
	СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "WERKS", Выборка.БизнесЕдиницаID));  
	
	Возврат СформироватьТекстJSON(СтруктураДанных);

КонецФункции  

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьТаблицуДанныхПоРезультатуЗапроса(ТаблицаВФормате, ТаблицаДанных1С);
		
	Для каждого СтрРезультат Из ТаблицаДанных1С Цикл   
		
		СтрТЗ = ТаблицаВФормате.Добавить();
		
		Для каждого Колонка из ТаблицаВФормате.Колонки Цикл 
			
			Если ТаблицаДанных1С.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(СтрРезультат[Колонка.Имя]) = Тип("Дата") Тогда
				СтрТЗ[Колонка.Имя] = Формат(СтрРезультат[Колонка.Имя],"ДФ=yyyyMMdd; ДП=99991231");
			ИначеЕсли ТипЗнч(СтрРезультат[Колонка.Имя]) = Тип("Булево") Тогда
				СтрТЗ[Колонка.Имя] = Формат(СтрРезультат[Колонка.Имя],"БЛ=; БИ=X");
			ИначеЕсли ТипЗнч(СтрРезультат[Колонка.Имя]) = Тип("Число") Тогда
				СтрТЗ[Колонка.Имя] = Формат(СтрРезультат[Колонка.Имя],"ЧН=0; ЧГ=0");
			Иначе
				СтрТЗ[Колонка.Имя] = СтрРезультат[Колонка.Имя];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПодготовитьТаблицуДляЗагрузкиВRequest(ИмяМетода)
	
	ОписаниеТаблицы = ПолучитьОписаниеТаблицыПоМетоду(ИмяМетода);
	
	Если ОписаниеТаблицы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТЗ = Новый ТаблицаЗначений;
	
	Для каждого ОписаниеКолонки из ОписаниеТаблицы Цикл  
		
		ТипЗначенияКолонки = ПолучитьТипЗначенияКолонки(ОписаниеКолонки);
		
		Если ТипЗначенияКолонки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТЗ.Колонки.Добавить(ОписаниеКолонки.ИмяКолонки1С, ТипЗначенияКолонки, ОписаниеКолонки.ИмяКолонкиRequest);
		
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции 

Функция ПолучитьОписаниеТаблицыПоМетоду(ИмяМетода)
	
	ОписаниеТаблицы = Новый ТаблицаЗначений;
	
	Попытка
		
		Макет = ПолучитьОбщийМакет("ИКТ_RequestОписаниеТаблиц");
		
		Построитель = Новый ПостроительЗапроса;
		Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область(ИмяМетода));
		Построитель.Выполнить();
		
		ОписаниеТаблицы = Построитель.Результат.Выгрузить();
		
	Исключение  
		
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат ОписаниеТаблицы;
	
КонецФункции
		
Функция ПолучитьТипЗначенияКолонки(ОписаниеКолонки) 
	
	Если ВРег(ОписаниеКолонки.ТипЗначения) = "СТРОКА" Тогда
		
		Если ЗначениеЗаполнено(ОписаниеКолонки.ДлинаСтроки) Тогда
			
			Возврат Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(Число(ОписаниеКолонки.ДлинаСтроки)));
			
		Иначе
			
			Возврат Новый ОписаниеТипов("Строка");
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ОписаниеКолонки.ТипЗначения) = "ЧИСЛО" Тогда
		
		ДлинаЧисла = ?(ЗначениеЗаполнено(ОписаниеКолонки.ДлинаЧисла), Число(ОписаниеКолонки.ДлинаЧисла), 10);
		ТочностьЧисла = ?(ЗначениеЗаполнено(ОписаниеКолонки.ТочностьЧисла), Число(ОписаниеКолонки.ТочностьЧисла), 0);
		
		Возврат Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(ДлинаЧисла, ТочностьЧисла));
		
	ИначеЕсли ВРег(ОписаниеКолонки.ТипЗначения) = "ДАТА" Тогда
		
		Если ЗначениеЗаполнено(ОписаниеКолонки.ЧастиДаты) Тогда
			
			Возврат Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты[ОписаниеКолонки.ЧастиДаты]));
			
		Иначе
			
			Возврат Новый ОписаниеТипов("Дата");
			
		КонецЕсли;
		
	ИначеЕсли ВРег(ОписаниеКолонки.ТипЗначения) = "БУЛЕВО" Тогда	
		
		Возврат Новый ОписаниеТипов("Булево");  
			
	КонецЕсли;  
				
КонецФункции

Функция ТаблицуЗначенийВМассивСтруктур(ТаблицаЗначений, КлючКолонки = "Имя")
	
	МассивДанных = Новый Массив;
	
	Для каждого стр из ТаблицаЗначений Цикл
		
		ДанныеСтроки = Новый Структура;
		
		Для каждого Колонка из ТаблицаЗначений.Колонки Цикл
			
			ДанныеСтроки.Вставить(Колонка[КлючКолонки], стр[Колонка.Имя]);
			
		КонецЦикла;
		
		МассивДанных.Добавить(ДанныеСтроки);
		
	КонецЦикла; 
	
	Возврат МассивДанных;
	
КонецФункции

Функция СформироватьТекстJSON(ДанныеБазы) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(); 
	
	ЗаписатьJSON(ЗаписьJSON, ДанныеБазы);
		
	ТекстJSON = ЗаписьJSON.Закрыть();
		
	Возврат ТекстJSON;
	
КонецФункции

Функция ПрочитатьТекстJSON(ИмяФайла = "", ТекстЗапроса = "") Экспорт
	
	Попытка 
		
		ЧтениеJSON = Новый ЧтениеJSON;
		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			ЧтениеJSON.ОткрытьФайл(ИмяФайла);
		ИначеЕсли ЗначениеЗаполнено(ТекстЗапроса) Тогда 
			ЧтениеJSON.УстановитьСтроку(ТекстЗапроса);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
			
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		
		Возврат ДанныеЗапроса;
		
	Исключение
		
		ЗаписьЖурналаРегистрации("ОбменДаннымиRequest", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки() + Символы.ПС + ?(ЗначениеЗаполнено(ТекстЗапроса), ТекстЗапроса, ИмяФайла)); 
		
	КонецПопытки;
	
КонецФункции

Функция ИмяБазы1С()
	
	ЗаголовокСистемы = Константы.ЗаголовокСистемы.Получить();
	
	Если Не ЗначениеЗаполнено(ЗаголовокСистемы) Тогда
		
		ЗаголовокСистемы = "1С SNGM";
		
	КонецЕсли;
	
	Возврат ЗаголовокСистемы;
	
КонецФункции

Функция ИспользоватьОбменСРексвест() Экспорт
	
	Если Не ПравоДоступа("Просмотр", Метаданные.Константы.ИКТ_RequestПараметрыСоединения) Тогда 
		Возврат Ложь;		
	КонецЕсли;
	
	Результат = Истина;
		
	НастройкиОбмена = Обработки.ИКТ_RequestПараметрыСоединения.ПолучитьПараметрыСоединенияСRequest();
	
	Если НастройкиОбмена = Неопределено Тогда
		Результат = Ложь;
	ИначеЕсли НастройкиОбмена.Свойство("ИспользоватьОбменСRequest") = Ложь Тогда
		Результат = Ложь;
	ИначеЕсли НастройкиОбмена.ИспользоватьОбменСRequest = Ложь Тогда
		Результат = Ложь;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

