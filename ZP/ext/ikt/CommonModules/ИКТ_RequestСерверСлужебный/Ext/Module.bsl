		|		ПО Сотрудники.ФизическоеЛицо = ДокументыФизическихЛицЗагранПаспорт.Физлицо
		|			И (ДокументыФизическихЛицЗагранПаспорт.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ЗагранпаспортРФ))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицВУ
		|		ПО Сотрудники.ФизическоеЛицо = ДокументыФизическихЛицВУ.Физлицо
		|			И (ДокументыФизическихЛицВУ.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НакопленныеСтажиФизическихЛиц КАК НакопленныеСтажиФизическихЛиц
		|		ПО Сотрудники.ФизическоеЛицо = НакопленныеСтажиФизическихЛиц.ФизическоеЛицо
		|			И (НакопленныеСтажиФизическихЛиц.ВидСтажа.Код = ""000000003"")
		|ГДЕ
		|	Сотрудники.Ссылка В(&Ссылка)
		|	И Сотрудники.ИКТ_НеСоздаватьИнцидентыКРВ = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Ссылка", Сотрудники); 
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C");
	Запрос.УстановитьПараметр("EmailФизЛица", Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
	Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ДатаОстатков", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);  
	
	ТаблицаДанных1С = Запрос.Выполнить().Выгрузить(); 
	
	ТаблицаДанных1С.Колонки.Добавить("СтажГод", Новый ОписаниеТипов("Число"));
	ТаблицаДанных1С.Колонки.Добавить("СтажМесяц", Новый ОписаниеТипов("Число")); 
	
	Для каждого стр из ТаблицаДанных1С Цикл
		
		Стр.СтажГод           = Цел(Стр.СтажРазмерМесяцев / 12);
		Стр.СтажМесяц         = Стр.СтажРазмерМесяцев - Стр.СтажГод * 12; 
		Стр.IDДолжностиС      = СтрЗаменить(Стр.IDДолжностиС," ","");
		Стр.ТабельныйНомерЮОС = Прав(Стр.ТабельныйНомерЮОС,6);
		
		Если ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка) = Тип("ДокументСсылка.ПриемНаРаботу") ИЛИ ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка) = Тип("ДокументСсылка.ПриемНаРаботуСписком") Тогда 
			Стр.СтатусЗанятости = 3;
			Стр.СтатусТабельногоНомераЮОС = 3;
		ИначеЕсли ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка) = Тип("ДокументСсылка.Увольнение") ИЛИ ТипЗнч(ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка) = Тип("ДокументСсылка.УвольнениеСписком") Тогда 	
			Стр.СтатусЗанятости = 0;
			Стр.СтатусТабельногоНомераЮОС = 0;
		Иначе	
			Стр.СтатусЗанятости = 3;
			Стр.СтатусТабельногоНомераЮОС = 3;
		КонецЕсли;
			
	КонецЦикла;
		
	ЗаполнитьТаблицуДанныхПоРезультатуЗапроса(ТаблицаВФормате, ТаблицаДанных1С);
	
	МассивДанных = ТаблицуЗначенийВМассивСтруктур(ТаблицаВФормате, "Заголовок");
	
	Если МассивДанных.Количество() = 0 Тогда
		Отказ = Истина;
		Возврат "";
	КонецЕсли;
	
	Возврат СформироватьТекстJSON(МассивДанных);
	
КонецФункции

Функция ПодготовитьИнформациюПоЭскалацииСвязей(Сотрудники, ПараметрыСообщения, Отказ)//119
	
	ТаблицаВФормате = ПодготовитьТаблицуДляЗагрузкиВRequest("ЭскалацияСвязей"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию КАК ДолжностьПоШтатномуРасписанию,
		|	ВЫБОР
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Удаление)
		|			ТОГДА 3
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Изменение)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СтатусЗаписи, 
		|	""1234567890123456789012345"" КАК КлючЗаписи,
		|	&ИмяВнешнейСистемы КАК ИмяВнешнейСистемы,
		|	МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Подразделение КАК Подразделение,
		|	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию.ИКТ_АдминистративныйРуководительАР КАК АдминистративныйРуководительАР,
		|	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию.ИКТ_ФункциональныйРуководительФР КАК ФункциональныйРуководительФР,
		|	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию.ИКТ_ВышестоящийРуководительВР КАК ВышестоящийРуководительВР
		|ПОМЕСТИТЬ ВТ_ДанныеСотрудника
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&ДатаСобытия, Сотрудник В (&Ссылка)) КАК КадроваяИсторияСотрудниковСрезПоследних
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МестоПозицииШтатногоРасписанияВСтруктуреПредприятия КАК МестоПозицииШтатногоРасписанияВСтруктуреПредприятия
		|			ПО КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию = МестоПозицииШтатногоРасписанияВСтруктуреПредприятия.Позиция
		|		ПО (КадроваяИсторияСотрудниковСрезПоследних.Сотрудник = Сотрудники.Ссылка)
		|			И (КадроваяИсторияСотрудниковСрезПоследних.ГоловнаяОрганизация = Сотрудники.ГоловнаяОрганизация)
		|			И (КадроваяИсторияСотрудниковСрезПоследних.ФизическоеЛицо = Сотрудники.ФизическоеЛицо)
		|ГДЕ
		|	Сотрудники.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДанныеСотрудника.ДолжностьПоШтатномуРасписанию.ID_ДолжностьS КАК IDШтатнойДолжности,
		|	ВТ_ДанныеСотрудника.АдминистративныйРуководительАР.Код КАК КодРуководителя,
		|	""004"" КАК ТипСвязи,
		|	ВТ_ДанныеСотрудника.Сотрудник.ФизическоеЛицо.ИКТ_ТабельныйНомер КАК ТабельныйНомер,
		|	ВТ_ДанныеСотрудника.АдминистративныйРуководительАР.ФизическоеЛицо.ИКТ_ТабельныйНомер КАК ТабельныйНомерРуководителя,
		|	""подчиняется в дисц. отн."" КАК НаименованиеСвязи,
		|	ВТ_ДанныеСотрудника.СтатусЗаписи КАК СтатусЗаписи,
		|	ВТ_ДанныеСотрудника.КлючЗаписи КАК КлючЗаписи,
		|	ВТ_ДанныеСотрудника.ИмяВнешнейСистемы КАК ИмяВнешнейСистемы
		|ИЗ
		|	ВТ_ДанныеСотрудника КАК ВТ_ДанныеСотрудника
		|ГДЕ
		|	ЕСТЬNULL(ВТ_ДанныеСотрудника.АдминистративныйРуководительАР.ФизическоеЛицо.ИКТ_ТабельныйНомер, """") <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеСотрудника.ДолжностьПоШтатномуРасписанию.ID_ДолжностьS,
		|	ВТ_ДанныеСотрудника.ФункциональныйРуководительФР.Код,
		|	""005"",
		|	ВТ_ДанныеСотрудника.Сотрудник.ФизическоеЛицо.ИКТ_ТабельныйНомер,
		|	ВТ_ДанныеСотрудника.ФункциональныйРуководительФР.ФизическоеЛицо.ИКТ_ТабельныйНомер,
		|	""подчиняется в функц. отн."",
		|	ВТ_ДанныеСотрудника.СтатусЗаписи,
		|	ВТ_ДанныеСотрудника.КлючЗаписи,
		|	ВТ_ДанныеСотрудника.ИмяВнешнейСистемы
		|ИЗ
		|	ВТ_ДанныеСотрудника КАК ВТ_ДанныеСотрудника
		|ГДЕ
		|	ЕСТЬNULL(ВТ_ДанныеСотрудника.ФункциональныйРуководительФР.ФизическоеЛицо.ИКТ_ТабельныйНомер, """") <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_ДанныеСотрудника.ДолжностьПоШтатномуРасписанию.ID_ДолжностьS,
		|	ВТ_ДанныеСотрудника.ВышестоящийРуководительВР.Код,
		|	""Z06"",
		|	ВТ_ДанныеСотрудника.Сотрудник.ФизическоеЛицо.ИКТ_ТабельныйНомер,
		|	ВТ_ДанныеСотрудника.ВышестоящийРуководительВР.ФизическоеЛицо.ИКТ_ТабельныйНомер,
		|	""подчиняется вышест. рук."",
		|	ВТ_ДанныеСотрудника.СтатусЗаписи,
		|	ВТ_ДанныеСотрудника.КлючЗаписи,
		|	ВТ_ДанныеСотрудника.ИмяВнешнейСистемы
		|ИЗ
		|	ВТ_ДанныеСотрудника КАК ВТ_ДанныеСотрудника
		|ГДЕ
		|	ЕСТЬNULL(ВТ_ДанныеСотрудника.ВышестоящийРуководительВР.ФизическоеЛицо.ИКТ_ТабельныйНомер, """") <> """"";
	
	Запрос.УстановитьПараметр("Ссылка", Сотрудники);
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C"); 
	Запрос.УстановитьПараметр("ДатаСобытия", Новый Граница(ТекущаяДата(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);
	
	ТаблицаДанных1С = Запрос.Выполнить().Выгрузить();  
	
	Для каждого стр из ТаблицаДанных1С Цикл
		
		Стр.КодРуководителя = Прав(стр.КодРуководителя, 8);
		
		Стр.КлючЗаписи = Строка(СокрЛП(стр.IDШтатнойДолжности) + "/" + СокрЛП(стр.КодРуководителя) + "/" + СокрЛП(стр.ТипСвязи) + "/" + "001");
		
	КонецЦикла;
	
	ЗаполнитьТаблицуДанныхПоРезультатуЗапроса(ТаблицаВФормате, ТаблицаДанных1С);		
					
	МассивДанных = ТаблицуЗначенийВМассивСтруктур(ТаблицаВФормате, "Заголовок");
	
	Если МассивДанных.Количество() = 0 Тогда 
		Отказ = Истина;
		Возврат "";
	Иначе
		Отказ = Ложь;
	КонецЕсли;   
	
	Возврат СформироватьТекстJSON(МассивДанных);
	
КонецФункции 

Функция ПодготовитьИнформациюПоЗамещения(ПараметрыСообщения, Отказ)//173
	
	ТаблицаВФормате = ПодготовитьТаблицуДляЗагрузкиВRequest("Замещения"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИКТ_ЗаместителиRequest.ЗамещаемыйПользователь КАК ЗамещаемыйПользователь,
	               |	ИКТ_ЗаместителиRequest.ЗаместительПользователь КАК ЗаместительПользователь,
	               |	ИКТ_ЗаместителиRequest.ДатаНачала КАК ДатаНачала,
	               |	ИКТ_ЗаместителиRequest.ДатаОкончания КАК ДатаОкончания,
	               |	ИКТ_ЗаместителиRequest.ДатаЗаписи КАК ДатаЗаписи,
	               |	ИКТ_ЗаместителиRequest.ЗамещаемыйID КАК ЗамещаемыйID,
	               |	ИКТ_ЗаместителиRequest.ЗаместительID КАК IDЗаместителя,
	               |	""12345678"" КАК IDШтатнойДолжностиЗамещаемого,
	               |	ИКТ_ЗаместителиRequest.ЗамещаемыйФизЛицо КАК ЗамещаемыйФизЛицо,
	               |	ИКТ_ЗаместителиRequest.ЗаместительФизЛицо КАК ЗаместительФизЛицо,
	               |	""001"" КАК COUNT,
	               |	""001"" КАК CUR_FLTID,
	               |	""001"" КАК CUR_FLTNM,
	               |	""1234567890123456789012345"" КАК КлючЗаписи,
	               |	""1"" КАК СтатусЗаписи,
	               |	&ИмяВнешнейСистемы КАК ИмяВнешнейСистемы
	               |ИЗ
	               |	РегистрСведений.ИКТ_ЗаместителиRequest КАК ИКТ_ЗаместителиRequest";
	
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C"); 
	Запрос.УстановитьПараметр("ДатаСобытия", Новый Граница(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыСообщения.СобытиеСсылка, "ДатаСобытия"), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);
	
	ТаблицаДанных1С = Запрос.Выполнить().Выгрузить();  
	
	Для каждого стр из ТаблицаДанных1С Цикл
				
		IDШтатнойДолжностиЗамещаемого = "";
		
		Если ЗначениеЗаполнено(Стр.ЗамещаемыйФизЛицо) Тогда
			
			IDШтатнойДолжностиЗамещаемого =  ПолучитьIDДолжности(Стр.ЗамещаемыйФизЛицо); 	
			
			Если НЕ ЗначениеЗаполнено(IDШтатнойДолжностиЗамещаемого) Тогда
				IDШтатнойДолжностиЗамещаемого = ПолучитьIDДолжностиПоСпрРуководители(Стр.ЗамещаемыйФизЛицо);
			КонецЕсли;
			
		КонецЕсли;
			
		Если IDШтатнойДолжностиЗамещаемого = "0" Тогда 
			IDШтатнойДолжностиЗамещаемого = "";
		КонецЕсли;	
		
		Стр.IDШтатнойДолжностиЗамещаемого = IDШтатнойДолжностиЗамещаемого;
		
		Стр.КлючЗаписи = Строка(стр.IDШтатнойДолжностиЗамещаемого + "/" + "001");		
		
	КонецЦикла;
	
	КолВо = ТаблицаДанных1С.Количество();
	
	Инд = 0;
	
	Пока Инд < КолВо Цикл
		
		Строка  = ТаблицаДанных1С[Инд];
		
		НеНужноУдалять = ЗначениеЗаполнено(Строка.ЗамещаемыйФизЛицо) И ЗначениеЗаполнено(Строка.IDШтатнойДолжностиЗамещаемого);
			
		Если Не НеНужноУдалять Тогда
			
			ТаблицаДанных1С.Удалить(Строка);			
			
			КолВо = КолВо - 1;
		Иначе
			Инд = Инд + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьТаблицуДанныхПоРезультатуЗапроса(ТаблицаВФормате, ТаблицаДанных1С);

	МассивДанных = ТаблицуЗначенийВМассивСтруктур(ТаблицаВФормате, "Заголовок");
	
	Если МассивДанных.Количество() = 0 Тогда 
		Отказ = Истина;
		Возврат "";
	Иначе
		Отказ = Ложь;	
	КонецЕсли;   
	
	Возврат СформироватьТекстJSON(МассивДанных);
	
КонецФункции

Функция ПолучитьIDДолжности(ЗамещаемыйФизЛицо) 
	
	ID = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию.ID_ДолжностьS КАК Должность_ID
	               |ИЗ
	               |	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(
	               |			&ДатаСобытия,
	               |			Организация.ИКТ_УУ = ИСТИНА
	               |				И ГоловнаяОрганизация.ИКТ_УУ = ИСТИНА
	               |				И ФизическоеЛицо = &ФизическоеЛицо) КАК КадроваяИсторияСотрудниковСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаСобытия",ТекущаяДата());
	Запрос.УстановитьПараметр("ФизическоеЛицо",ЗамещаемыйФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ID = СокрЛП(Выборка.Должность_ID);		
	КонецЦикла;
	
	Возврат ID;
	
КонецФункции	   

Функция ПолучитьIDДолжностиПоСпрРуководители(ЗамещаемыйФизЛицо) 
	
	ID = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИКТ_Руководители.Код КАК Должность_ID
	               |ИЗ
	               |	Справочник.ИКТ_Руководители КАК ИКТ_Руководители
	               |ГДЕ
	               |	ИКТ_Руководители.ФизическоеЛицо = &ФизическоеЛицо";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо",ЗамещаемыйФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ID = СокрЛП(Выборка.Должность_ID);		
	КонецЦикла;
	
	Возврат ID;
	
КонецФункции	
	
Функция СформироватьДанныеДляОтправкиВRequestИзменениеГрафикаРаботы(ПараметрыСообщения, Отказ)
	
	Если ПараметрыСообщения.ОснованиеСобытияОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_СобытияОбменаRequest.ОснованиеСобытия КАК ОснованиеСобытия,
		|	ИКТ_СобытияОбменаRequest.ДопАналитика КАК ДопАналитика,
		|	ИКТ_СобытияОбменаRequest.ДатаСобытия КАК ДатаСобытия
		|ПОМЕСТИТЬ ВТ_ДАнныеСобытия
		|ИЗ
		|	Справочник.ИКТ_СобытияОбменаRequest КАК ИКТ_СобытияОбменаRequest
		|ГДЕ
		|	ИКТ_СобытияОбменаRequest.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГрафикРаботыСотрудников.ДействуетДо КАК ДействуетДо,
		|	ГрафикРаботыСотрудников.Сотрудник.ФизическоеЛицо.ИКТ_ТабельныйНомер КАК ИКТ_ТабельныйНомер,
		|	ГрафикРаботыСотрудников.ГрафикРаботы.Наименование КАК ГрафикРаботыНаименование,
		|	ПРЕДСТАВЛЕНИЕ(УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ГрафикРаботыСотрудников.ГрафикРаботы)) КАК ГрафикРаботыГУИД,
		|	ВЫБОР
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Удаление)
		|			ТОГДА 3
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Изменение)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СтатусСобытия,
		|	&ИмяВнешнейСистемы КАК ИмяВнешнейСистемы
		|ИЗ
		|	РегистрСведений.ГрафикРаботыСотрудников КАК ГрафикРаботыСотрудников
		|ГДЕ
		|	(ГрафикРаботыСотрудников.Период, ГрафикРаботыСотрудников.Сотрудник, ГрафикРаботыСотрудников.ГрафикРаботы) В
		|			(ВЫБРАТЬ
		|				ВТ_ДАнныеСобытия.ДатаСобытия КАК ДатаСобытия,
		|				ВТ_ДАнныеСобытия.ДопАналитика КАК ДопАналитика,
		|				ВТ_ДАнныеСобытия.ОснованиеСобытия
		|			ИЗ
		|				ВТ_ДАнныеСобытия КАК ВТ_ДАнныеСобытия)";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыСообщения.СобытиеСсылка);
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C"); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураДанных = Новый Структура();

	Если Выборка.Следующий() Тогда   
		
		СтруктураДанных.Вставить("ExchangeSysName", "SND_1C");
		СтруктураДанных.Вставить("ExchangeRoute", "ИКТ_10");
		СтруктураДанных.Вставить("OperationStatus", Выборка.СтатусСобытия);
		СтруктураДанных.Вставить("Key", Строка(ПараметрыСообщения.СобытиеСсылка.УникальныйИдентификатор()));
		СтруктураДанных.Вставить("Variables", Новый Массив);
		
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "PERNR", Выборка.ИКТ_ТабельныйНомер));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ВРег("ENDDATE"), Формат(Выборка.ДействуетДо,"ДФ=yyyyMMdd; ДП=99991231")));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ВРег("WorkScheduleName"), Выборка.ГрафикРаботыНаименование));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ВРег("WorkScheduleXX__CUR_KEY"), Выборка.ГрафикРаботыГУИД));
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат СформироватьТекстJSON(СтруктураДанных);
			
КонецФункции

Функция СформироватьДанныеДляОтправкиВRequestИКТ_RequestРаботаНеПоГрафику(ПараметрыСообщения, Отказ)//128 КРВ
	
	Если ПараметрыСообщения.ОснованиеСобытияОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Удаление)
		|			ТОГДА 3
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Изменение)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СтатусСобытия,
		|	&ИмяВнешнейСистемы КАК ИмяВнешнейСистемы,
		|	ИКТ_RequestРаботаНеПоГрафику.ПервыйВход КАК ПервыйВход,
		|	ИКТ_RequestРаботаНеПоГрафику.ПоследнийВыход КАК ПоследнийВыход,
		|	ИКТ_RequestРаботаНеПоГрафику.ОтработаноЧасов КАК ОтработаноЧасов,
		|	ИКТ_RequestРаботаНеПоГрафику.Сотрудник.ФизическоеЛицо.ИКТ_ТабельныйНомер КАК ИКТ_ТабельныйНомер,
		|	ИКТ_RequestРаботаНеПоГрафику.Организация.ИКТ_IDЮрЛица КАК ИКТ_IDЮрЛица,
		|	ИКТ_RequestРаботаНеПоГрафику.ДатаИнцидента КАК ДатаИнцидента,
		|	ИКТ_RequestРаботаНеПоГрафику.Сотрудник.Наименование КАК СотрудникНаименование,
		|	КадроваяИсторияСотрудниковСрезПоследних.ДолжностьПоШтатномуРасписанию.ИКТ_БизнесЕдиница.ID КАК BE,
		|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ИКТ_ВремяНачалаРаботы КАК ВремяНачалаРаботыПоГрафику,
		|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ИКТ_ВремяОкончанияРаботы КАК ВремяОкончанияРаботыПоГрафику,
		|	РАЗНОСТЬДАТ(КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ИКТ_ВремяНачалаРаботы, КадроваяИсторияСотрудниковСрезПоследних.Сотрудник.ИКТ_ВремяОкончанияРаботы, ЧАС) - 1 КАК НормаВремениВДень,
		|	ИКТ_RequestРаботаНеПоГрафику.ОтработаноВремени КАК ОтработаноВремени
		|ИЗ
		|	Документ.ИКТ_RequestРаботаНеПоГрафику КАК ИКТ_RequestРаботаНеПоГрафику
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
		|		ПО ИКТ_RequestРаботаНеПоГрафику.Сотрудник = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
		|ГДЕ
		|	ИКТ_RequestРаботаНеПоГрафику.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИКТ_RequestРаботаНеПоГрафикуВидыИнцидентов.ВидИнцидента КАК ВидИнцидента
		|ИЗ
		|	Документ.ИКТ_RequestРаботаНеПоГрафику.ВидыИнцидентов КАК ИКТ_RequestРаботаНеПоГрафикуВидыИнцидентов
		|ГДЕ
		|	ИКТ_RequestРаботаНеПоГрафикуВидыИнцидентов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка);
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C"); 
	
	ПакетыЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатШапка = ПакетыЗапроса[0];
	РезультатВидыИнцидентов = ПакетыЗапроса[1];
	
	ВыборкаВидыИнцидентов = РезультатВидыИнцидентов.Выбрать();
	
	ВозможныеИнциденты = Новый Структура; // Ключ - тэг инцидент, значение - тег значения инцидента
	ВозможныеИнциденты.Вставить("XX__CUR_FLTNM_002", "SS__LATE_TIME_002");
	ВозможныеИнциденты.Вставить("XX__CUR_FLTNM_003", "SS__LATE_TIME_003");
	ВозможныеИнциденты.Вставить("XX__CUR_FLTNM_004", "SS__LATE_TIME_004");
	ВозможныеИнциденты.Вставить("XX__CUR_FLTNM_005", "SS__LATE_TIME_005");
	ВозможныеИнциденты.Вставить("XX__CUR_FLTNM_006", "SS__LATE_TIME_006");
	
	Выборка = РезультатШапка.Выбрать();
	
	СтруктураДанных = Новый Структура();

	Если Выборка.Следующий() Тогда   
		
		СтруктураДанных.Вставить("ExchangeSysName", "SND_1C");
		СтруктураДанных.Вставить("ExchangeRoute", "ИКТ_128");//128 - Контроль рабочего времени.
		СтруктураДанных.Вставить("OperationStatus", Выборка.СтатусСобытия);
		СтруктураДанных.Вставить("Key", Строка(ПараметрыСообщения.СобытиеСсылка.УникальныйИдентификатор()));
		СтруктураДанных.Вставить("Variables", Новый Массив);
		
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "PERNR", Выборка.ИКТ_ТабельныйНомер));
		
		ВремяНачалаРаботыПоГрафику    = ?(ЗначениеЗаполнено(Выборка.ВремяНачалаРаботыПоГрафику),Выборка.ВремяНачалаРаботыПоГрафику,Константы.ИКТ_ВремяНачалаРаботы.Получить());
		ВремяОкончанияРаботыПоГрафику = ?(ЗначениеЗаполнено(Выборка.ВремяОкончанияРаботыПоГрафику),Выборка.ВремяОкончанияРаботыПоГрафику,Константы.ИКТ_ВремяОкончанияРаботы.Получить());
		
		// + Здесь нужно переделать всё.
		Если ЗначениеЗаполнено(Выборка.НормаВремениВДень) Тогда 
			НормаВремениВДень = ?(Число(Выборка.НормаВремениВДень)>0,Выборка.НормаВремениВДень,"8");
		Иначе
			НормаВремениВДень = "8";
		КонецЕсли;		
        // - Здесь нужно переделать всё.
		
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "DATA", Формат(Выборка.ДатаИнцидента,"ДФ=yyyyMMdd; ДП=99991231")));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "ENAME", Выборка.СотрудникНаименование));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "BUKRS", Выборка.BE)); 
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SOBEG", Формат(ВремяНачалаРаботыПоГрафику,"ДЛФ=T")));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SOEND", Формат(ВремяОкончанияРаботыПоГрафику,"ДЛФ=T")));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SOLLZ", НормаВремениВДень)); 
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "GJAHR", Формат(Выборка.ДатаИнцидента,"ДФ=yyyy; ДП=9999")));//Финансовый год
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "IS_FLEXIBLE_SCHEDULE", ""));//Гибкий график
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "MAINVACATION", ""));//Дней отпуска
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "BIRTHVACATION", "0"));//Отпуск за Д.Р. 1 или 0
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "H3VACATION", ""));
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SS__LATE_TIME", ""));//Время опоздания или время раннего ухода в минутах 
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "XX__CUR_FLTID", "001"));

		Пока ВыборкаВидыИнцидентов.Следующий() Цикл
			
			Если ВыборкаВидыИнцидентов.ВидИнцидента = Перечисления.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Недоработка Тогда
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "XX__CUR_FLTNM_002", "Менее 7,5 на работе")); 
				ОтработаноСекунд = ?(ЗначениеЗаполнено(Выборка.ОтработаноВремени), Выборка.ОтработаноВремени - '00010101', Выборка.ОтработаноЧасов * 3600);
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SS__LATE_TIME_002", Формат(ОтработаноСекунд, "ЧЦ=6; ЧВН=; ЧГ=0"))); 
				ВозможныеИнциденты.Удалить("XX__CUR_FLTNM_002");
			КонецЕсли;
			  
			Если ВыборкаВидыИнцидентов.ВидИнцидента = Перечисления.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Опоздание Тогда
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "XX__CUR_FLTNM_003", "Опоздание 30 мин")); 
				ОпозданиеСекунд = (Выборка.ПервыйВход - НачалоДня(Выборка.ПервыйВход)) - (ВремяНачалаРаботыПоГрафику - '00010101');
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SS__LATE_TIME_003", Формат(ОпозданиеСекунд, "ЧЦ=6; ЧВН=; ЧГ=0"))); 
				ВозможныеИнциденты.Удалить("XX__CUR_FLTNM_003");
			КонецЕсли;
		
			Если ВыборкаВидыИнцидентов.ВидИнцидента = Перечисления.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.УходРаньше Тогда
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "XX__CUR_FLTNM_004", "Ранний уход 30 мин")); 
				РаннийУходСекунд = (ВремяОкончанияРаботыПоГрафику - '00010101') - (Выборка.ПоследнийВыход - НачалоДня(Выборка.ПоследнийВыход));
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SS__LATE_TIME_004", Формат(РаннийУходСекунд, "ЧЦ=6; ЧВН=; ЧГ=0"))); 
				ВозможныеИнциденты.Удалить("XX__CUR_FLTNM_004");
			КонецЕсли;
		
			Если ВыборкаВидыИнцидентов.ВидИнцидента = Перечисления.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.Отсутствие Тогда
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "XX__CUR_FLTNM_005", "Не вышел на работу")); 
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SS__LATE_TIME_005", "000000")); 
				ВозможныеИнциденты.Удалить("XX__CUR_FLTNM_005");
			КонецЕсли;
		
			Если ВыборкаВидыИнцидентов.ВидИнцидента = Перечисления.ИКТ_RequestВидыИнцидентовРаботыНеПоГрафику.ПриходСОтсутствием Тогда
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "XX__CUR_FLTNM_006", "Приход с отсутствием")); 
				СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SS__LATE_TIME_006", "000000")); 
				ВозможныеИнциденты.Удалить("XX__CUR_FLTNM_006");
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого ДанныеИнцидента из ВозможныеИнциденты Цикл //Добавляем переменные всех возможных инцидентов, которые остались
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ДанныеИнцидента.Ключ, "")); 
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ДанныеИнцидента.Значение, ""));
		КонецЦикла;
		
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "JUPER", Выборка.ИКТ_IDЮрЛица));  
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ВРег("FirstEntry"), Формат(Выборка.ПервыйВход,"ДФ=yyyyMMddHHmmss; ДП=99991231246060")));//Передаем дату и время
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ВРег("LastExit"), Формат(Выборка.ПоследнийВыход,"ДФ=yyyyMMddHHmmss; ДП=99991231246060")));//Передаем дату и время		
		СтруктураДанных.Variables.Добавить(Новый Структура("name,value", ВРег("HoursWorkedOut"), Выборка.ОтработаноЧасов));
		
	Иначе
		
		Возврат "";
		
	КонецЕсли;
	
	Возврат СформироватьТекстJSON(СтруктураДанных);
			
КонецФункции

Функция СформироватьДанныеДляОтправкиВRequestЛC_ВводПланаKPI(ПараметрыСообщения, Отказ)
	
	Если ПараметрыСообщения.ОснованиеСобытияОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Удаление)
		|			ТОГДА 3
		|		КОГДА &ДействиеОбмена = ЗНАЧЕНИЕ(Перечисление.ИКТ_ДействияОбмена.Изменение)
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК СтатусСобытия,
		|	&ИмяВнешнейСистемы КАК ИмяВнешнейСистемы,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.Сотрудник.ФизическоеЛицо.ИКТ_ТабельныйНомер, """") КАК ИКТ_ТабельныйНомер,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.Ссылка.Организация.ИКТ_IDЮрЛица, """") КАК ИКТ_IDЮрЛица,
		|	ЛC_ВводПланаKPIСостав.Месяц КАК Месяц,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.ЦелевойПоказатель.Код, """") КАК ЦелевойПоказательКод,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.ЦелевойПоказатель.Наименование, """") КАК ЦелевойПоказательНаименование,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.Ссылка.Руководитель.ФизическоеЛицо.ИКТ_ТабельныйНомер, """") КАК РуководительИКТ_ТабельныйНомер,
		|	ВЫБОР
		|		КОГДА ЛC_ВводПланаKPIСостав.Ссылка.Утвержден
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Утвержден,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.Ссылка.Утвердил.ФизическоеЛицо.ИКТ_ТабельныйНомер, """") КАК УтвердилИКТ_ТабельныйНомер,
		|	ЛC_ВводПланаKPIСостав.Ссылка.ДатаУтверждения КАК ДатаУтверждения,
		|	ЕСТЬNULL(ЛC_ВводПланаKPIСостав.ДолжностьПоШтатномуРасписанию.ID_ДолжностьS, """") КАК IDШтатнойДолжности,
		|	ЛC_ВводПланаKPIСостав.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЛC_ВводПланаKPI.Состав КАК ЛC_ВводПланаKPIСостав
		|ГДЕ
		|	ЛC_ВводПланаKPIСостав.Ссылка = &Ссылка
		|ИТОГИ
		|	МАКСИМУМ(СтатусСобытия),
		|	МАКСИМУМ(ИмяВнешнейСистемы),
		|	МАКСИМУМ(ИКТ_IDЮрЛица),
		|	МАКСИМУМ(РуководительИКТ_ТабельныйНомер),
		|	МАКСИМУМ(Утвержден),
		|	МАКСИМУМ(УтвердилИКТ_ТабельныйНомер),
		|	МАКСИМУМ(ДатаУтверждения)
		|ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыСообщения.ОснованиеСобытияОбъект.Ссылка);
	Запрос.УстановитьПараметр("ДействиеОбмена", ПараметрыСообщения.ДействиеОбмена);
	Запрос.УстановитьПараметр("ИмяВнешнейСистемы", "SND_1C"); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтруктураДанных = Новый Структура(); 
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		Выборка = ВыборкаСсылка.Выбрать(); 
		
		СтруктураДанных.Вставить("ExchangeSysName", "SND_1C");
		СтруктураДанных.Вставить("ExchangeRoute", "ИКТ_30");
		СтруктураДанных.Вставить("OperationStatus", ВыборкаСсылка.СтатусСобытия);
		СтруктураДанных.Вставить("Key", Строка(ПараметрыСообщения.СобытиеСсылка.УникальныйИдентификатор()));
		СтруктураДанных.Вставить("Variables", Новый Массив);

		Пока Выборка.Следующий() Цикл   
						
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "PERNR", Выборка.ИКТ_ТабельныйНомер));
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "JUPER", Выборка.ИКТ_IDЮрЛица));  
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "APPROVED_PERNR", Выборка.УтвердилИКТ_ТабельныйНомер)); 
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "APPROVED", Выборка.Утвержден)); 
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "APPROVED_DATE", Формат(Выборка.ДатаУтверждения,"ДФ=yyyyMMdd; ДП=99991231"))); 
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "HEAD_PERNR", Выборка.РуководительИКТ_ТабельныйНомер));  
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "HEAD_PERNR", Выборка.РуководительИКТ_ТабельныйНомер));  
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "INDICATOR_CODE", Выборка.ЦелевойПоказательКод));  
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "INDICATOR_NAME", Выборка.ЦелевойПоказательНаименование)); 
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "SJOB_ID", Выборка.IDШтатнойДолжности)); 
			СтруктураДанных.Variables.Добавить(Новый Структура("name,value", "MONTH", Формат(Выборка.Месяц,"ДФ=yyyyMMdd; ДП=99991231"))); 
			
		КонецЦикла;
	
	КонецЦикла;
	
	Если СтруктураДанных.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СформироватьТекстJSON(СтруктураДанных);
			
КонецФункции

Функция ПолучитьМассивФайловПоДоговору(ДоговорСсылка)
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентовПрисоединенныеФайлы.Ссылка КАК Ссылка,
		|	ДоговорыКонтрагентовПрисоединенныеФайлы.Наименование КАК Наименование,
		|	ДоговорыКонтрагентовПрисоединенныеФайлы.Расширение КАК Расширение
		|ИЗ
		|	Справочник.ДоговорыКонтрагентовПрисоединенныеФайлы КАК ДоговорыКонтрагентовПрисоединенныеФайлы
		|ГДЕ
		|	ДоговорыКонтрагентовПрисоединенныеФайлы.ВладелецФайла = &ДоговорСсылка
		|	И ДоговорыКонтрагентовПрисоединенныеФайлы.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДоговорСсылка", ДоговорСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			ДДФайла = РаботаСФайлами.ДвоичныеДанныеФайла(Выборка.Ссылка);
		Исключение 
			Продолжить;
		КонецПопытки; 
		
		Результат.Добавить(
			Новый Структура("File,FileName,FileExtension",
			Base64Строка(ДДФайла),
			Выборка.Наименование,
			Выборка.Расширение));
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

Функция СформироватьДанныеДляОтправкиВRequestИКТ_СобытияТехСбойСКУД(ПараметрыСообщения, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_СобытияТехСбойСКУД.Организация.ИКТ_IDЮрЛица КАК ИКТ_IDЮрЛица,
		|	ИКТ_СобытияТехСбойСКУД.ДатаСобытия КАК ДатаСобытия,
		|	ВЫБОР
