&ИзменениеИКонтроль("АдресДанныхПозицииВХранилище")
Функция ИКТ_АдресДанныхПозицииВХранилище()

	РеквизитыВДанные(Объект);

	ОписаниеПозиции = УправлениеШтатнымРасписанием.ОписаниеПозицииШтатногоРасписания();
	ЗаполнитьЗначенияСвойств(ОписаниеПозиции, Объект);
	ОписаниеПозиции.Вставить("Действие", Действие);
	ОписаниеПозиции.Вставить("ТекущееКоличествоСтавок", ТекущееКоличествоСтавок);
	ОписаниеПозиции.Вставить("ТекущийФОТ", ТекущийФОТ);

	ОписаниеПозиции.ПозицияШтатногоРасписания = РедактируемаяПозиция;

	// Класс условий труда
	ОписаниеПозиции.Вставить("КлассУсловийТруда", КлассыУсловийТрудаПоДолжностям.КлассУсловийТруда);
	ОписаниеПозиции.Вставить("КлассУсловийТрудаДатаРегистрацииИзменений", КлассыУсловийТрудаПоДолжностям.ДатаРегистрацииИзменений);

	// Начисления с показателями
	ОписаниеПозиции.Начисления = Объект.Начисления.Выгрузить();

	// Показатели и коэффициенты.
	ПоказателиПозиции =  Объект.Показатели.Выгрузить();
	ОписаниеПозиции.Вставить("Показатели",	ПоказателиПозиции);

	ОписаниеПозиции.ЕжегодныеОтпуска = Объект.ЕжегодныеОтпуска.Выгрузить();

	ОписаниеПозиции.Специальности = Объект.Специальности.Выгрузить();

	СтатистикаПерсоналаРасширенный.ПоместитьКатегориюПерсоналаВОписаниеПозиции(ЭтотОбъект, ОписаниеПозиции);

	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.Медицина.ТарификационнаяОтчетностьУчрежденийФМБА") Тогда
		МодульТарификационнаяОтчетностьУчрежденийФМБА = ОбщегоНазначения.ОбщийМодуль("ТарификационнаяОтчетностьУчрежденийФМБА");
		МодульТарификационнаяОтчетностьУчрежденийФМБА.ПоместитьТарификационнуюГруппуВОписаниеПозиции(ЭтотОбъект, ОписаниеПозиции);
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПриложения.ОрганизационнаяСтруктура") Тогда
		МодульОрганизационнаяСтруктура = ОбщегоНазначения.ОбщийМодуль("ОрганизационнаяСтруктура");
		МодульОрганизационнаяСтруктура.ЗаполнитьМестоВСтруктуреПредприятияПоДаннымФормы(ЭтотОбъект, ОписаниеПозиции);
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.УправленческаяЗарплата") Тогда
		МодульУправленческаяЗарплатаФормы = ОбщегоНазначения.ОбщийМодуль("УправленческаяЗарплатаФормы");
		МодульУправленческаяЗарплатаФормы.ПоместитьДанныеОНачисленияхВОписаниеПозиции(ЭтотОбъект, Объект, ОписаниеПозиции);
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ХарактеристикиПерсонала") Тогда
		МодульХарактеристикиПерсоналаФормы = ОбщегоНазначения.ОбщийМодуль("ХарактеристикиПерсоналаФормы");
		МодульХарактеристикиПерсоналаФормы.ПоместитьХарактеристикиПерсоналаВОписаниеПозиции(ЭтотОбъект, ОписаниеПозиции);
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ЛьготыСотрудников") Тогда
		МодульЛьготыСотрудников = ОбщегоНазначения.ОбщийМодуль("ЛьготыСотрудников");
		МодульЛьготыСотрудников.ПоместитьЛьготыВОписаниеПозиции(ЭтотОбъект, ОписаниеПозиции);
	КонецЕсли;

	Если ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыКорпоративнаяПодсистемы.ОбучениеРазвитие") Тогда
		МодульОбучениеРазвитие = ОбщегоНазначения.ОбщийМодуль("ОбучениеРазвитиеФормы");
		МодульОбучениеРазвитие.ПоместитьОбучениеВОписаниеПозиции(ЭтотОбъект, ОписаниеПозиции);
	КонецЕсли;
	#Вставка
	ОписаниеПозиции.Вставить("ИКТ_ДолжностьС", Объект.ИКТ_ДолжностьС);
	ОписаниеПозиции.Вставить("ИКТ_IDДолжностьС", Объект.ИКТ_IDДолжностьС);
	ОписаниеПозиции.Вставить("ИКТ_НомерГруппыПодбора", Объект.ИКТ_НомерГруппыПодбора);
	ОписаниеПозиции.Вставить("ИКТ_ТипПроверкиКандидатовДБ", Объект.ИКТ_ТипПроверкиКандидатовДБ);
	ОписаниеПозиции.Вставить("ИКТ_ВидИнцидентаПоКРВ", Объект.ИКТ_ВидИнцидентаПоКРВ);
	ОписаниеПозиции.Вставить("ИКТ_УровеньДоступа", Объект.ИКТ_УровеньДоступа);
	ОписаниеПозиции.Вставить("ИКТ_Должность", Объект.ИКТ_Должность);
	ОписаниеПозиции.Вставить("ИКТ_Группа", Объект.ИКТ_Группа);
	ОписаниеПозиции.Вставить("ИКТ_Грейд", Объект.ИКТ_Грейд);	
	ОписаниеПозиции.Вставить("ИКТ_НазваниеРазделаПерсонала", Объект.ИКТ_НазваниеРазделаПерсонала);
	ОписаниеПозиции.Вставить("ИКТ_ПроцентЗанятости", Объект.ИКТ_ПроцентЗанятости);
	ОписаниеПозиции.Вставить("ID_ДолжностьS", Объект.ID_ДолжностьS);
	ОписаниеПозиции.Вставить("ИКТ_АдминистративныйРуководительАР", Объект.ИКТ_АдминистративныйРуководительАР);
	ОписаниеПозиции.Вставить("ИКТ_БизнесЕдиница", Объект.ИКТ_БизнесЕдиница);
	ОписаниеПозиции.Вставить("ИКТ_ВышестоящийРуководительВР", Объект.ИКТ_ВышестоящийРуководительВР);
	ОписаниеПозиции.Вставить("ИКТ_Департамент", Объект.ИКТ_Департамент);
	ОписаниеПозиции.Вставить("ИКТ_ДоступКНД", Объект.ИКТ_ДоступКНД);
	ОписаниеПозиции.Вставить("ИКТ_НеУчитываетсяВKPI", Объект.ИКТ_НеУчитываетсяВKPI);
	ОписаниеПозиции.Вставить("ИКТ_СозданиеПремийШтраф", Объект.ИКТ_СозданиеПремийШтраф);
	ОписаниеПозиции.Вставить("ИКТ_СрокДействияСтатусаВакансии", Объект.ИКТ_СрокДействияСтатусаВакансии);
	ОписаниеПозиции.Вставить("ИКТ_ТрВодитУдостоверение", Объект.ИКТ_ТрВодитУдостоверение);
	ОписаниеПозиции.Вставить("ИКТ_ТребуетсяМедОсмотр", Объект.ИКТ_ТребуетсяМедОсмотр);
	ОписаниеПозиции.Вставить("ИКТ_ФункциональныйРуководительФР", Объект.ИКТ_ФункциональныйРуководительФР);
	#КонецВставки

	Возврат ПоместитьВоВременноеХранилище(ОписаниеПозиции, УникальныйИдентификатор);

КонецФункции

&НаСервере
Процедура ДобавитьРеквизитыНаФорму()  
	
	ЭтоУОС = ИКТ_ЗП_УОС.ЭтоУОС(ОрганизацияФормы);
	
	Если ЭтоУОС Тогда
		
		//Все реквезиты вместо 5 групп УОС поделены на 2 "лево" и "право"
		СтраницаУОС = Элементы.Добавить("СтраницаУОС", Тип("ГруппаФормы"), Элементы.СтраницыФормы);
		СтраницаУОС.Заголовок = "УОС";
		СтраницаУОС.Вид = ВидГруппыФормы.Страница;  
		
		ГруппаУОСОбщая = Элементы.Добавить("ГруппаУОСОбщая", Тип("ГруппаФормы"), Элементы.СтраницаУОС);
		ГруппаУОСОбщая.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаУОСОбщая.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаУОСОбщая.ОтображатьЗаголовок = Ложь;
		
		ГруппаУОСЛево = Элементы.Добавить("ГруппаУОСЛево", Тип("ГруппаФормы"), Элементы.ГруппаУОСОбщая);
		ГруппаУОСЛево.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаУОСЛево.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаУОСЛево.ОтображатьЗаголовок = Ложь;
		
		ГруппаУОСПраво = Элементы.Добавить("ГруппаУОСПраво", Тип("ГруппаФормы"), Элементы.ГруппаУОСОбщая);
		ГруппаУОСПраво.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаУОСПраво.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаУОСПраво.ОтображатьЗаголовок = Ложь;
		
		Элементы.ГруппаГрейд.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
				
		Элемент = Элементы.Найти("ИКТ_ДолжностьС"); 
		Если Элемент = Неопределено Тогда
			НовыйЭлемент = ЭтаФорма.Элементы.Добавить("ИКТ_ДолжностьС", Тип("ПолеФормы"), ГруппаУОСЛево);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "Объект.ИКТ_ДолжностьС";  
			НовыйЭлемент.АвтоОтметкаНезаполненного = Истина;    
			НовыйЭлемент.Ширина = 20;
			НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
			НовыйЭлемент.УстановитьДействие("ПриИзменении", "ПриИзмененииДолжностиС")
		Иначе                     
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы,
			"ИКТ_ДолжностьС",
			"Видимость",
			Истина);
		КонецЕсли;
		
		Элемент = Элементы.Найти("ИКТ_IDДолжностьС"); 
		Если Элемент = Неопределено Тогда
			НовыйЭлемент = ЭтаФорма.Элементы.Добавить("ИКТ_IDДолжностьС", Тип("ПолеФормы"), ГруппаУОСЛево);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "Объект.ИКТ_IDДолжностьС";   
			НовыйЭлемент.АвтоОтметкаНезаполненного = Истина;  
			НовыйЭлемент.ТолькоПросмотр = Истина; 
			НовыйЭлемент.Ширина = 10;
			НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы,
			"ИКТ_IDДолжностьС",
