		КонецЕсли;
		
		Элемент = Элементы.Найти("ИКТ_УровеньДоступа"); 
		Если Элемент = Неопределено Тогда
			НовыйЭлемент = ЭтаФорма.Элементы.Добавить("ИКТ_УровеньДоступа", Тип("ПолеФормы"), ГруппаУОСЛево); 
