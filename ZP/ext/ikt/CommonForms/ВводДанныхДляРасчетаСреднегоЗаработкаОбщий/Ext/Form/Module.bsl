
&НаСервере
Процедура ИКТ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Команда = Команды.Добавить("ЗаполнитьПоОкладуУОС");
	Команда.Заголовок = "Заполнить по окладу УОС";
	Команда.Действие  = "ИКТ_ЗаполнитьПоОкладуУОС"; 
	
	КнопкаФормы = Элементы.Добавить("ЗаполнитьПоОкладуУОС", Тип("КнопкаФормы"), Элементы.СреднийЗаработокКоманднаяПанель);                      
	КнопкаФормы.ИмяКоманды = "ЗаполнитьПоОкладуУОС";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка; 

КонецПроцедуры

&НаКлиенте
Процедура ИКТ_ЗаполнитьПоОкладуУОС(Команда)
	
	ЗаполнитьПоОкладуУОСНаСервере();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОкладуУОСНаСервере()

	// "Общий заработок"           = полный оклад УОС (взвешенный по норме при смене оклада);
	// "Отработано дней (календ.)" = календарные дни полного месяца.
	// Месяцы до приёма и до старта УОС обнуляются.
	// Строка времени создаётся ВСЕГДА — иначе месяц не попадёт в очистку
	// внутри ЗаполнитьФорму и в ячейках останутся ранее прочитанные данные.

	ОкладПоМесяцам = ОкладУОСПоМесяцам();
	ДатаПриема     = ДатаПриемаСотрудника();

	ДанныеОНачислениях = УчетСреднегоЗаработка.ПустаяТаблицаНачисленийСреднийЗаработокОбщий();
	ДанныеОВремени     = УчетСреднегоЗаработка.ПустаяТаблицаОтработанноеВремяСреднийЗаработокОбщий();
	
	ДатаНачалаЭксплуатацииУОС = ДатаНачалаЭксплуатацииУОС();
	
	Для Каждого КлючИЗначениеМесяцев Из МесяцыРасчета Цикл
		Месяц = КлючИЗначениеМесяцев.Ключ;
		
		Если Месяц < ДатаНачалаЭксплуатацииУОС Тогда
			Продолжить;
		КонецЕсли;

		СтрокаВр = ДанныеОВремени.Добавить();
		СтрокаВр.Период = Месяц;
		Если ИсточникиРедактирование.Количество() > 0 Тогда
			СтрокаВр.Источник = ИсточникиРедактирование[0];
		КонецЕсли;

		// Месяцы целиком до приёма сотрудника — обнуляем
		Если ЗначениеЗаполнено(ДатаПриема) И ДатаПриема > КонецМесяца(Месяц) Тогда
			СтрокаВр.ОтработаноДнейКалендарных = 0;
			Продолжить;
		КонецЕсли;

		// Месяцы до начала эксплуатации УОС — обнуляем
		Если Месяц < ДатаНачалаЭксплуатацииУОС Тогда
			СтрокаВр.ОтработаноДнейКалендарных = 0;
			Продолжить;
		КонецЕсли;

		// --- Отработано дней (календ.) = полный месяц, включая месяц приёма ---
		СтрокаВр.ОтработаноДнейКалендарных = День(КонецМесяца(Месяц));

		// --- Общий заработок = оклад УОС ---
		Сумма = ОкладПоМесяцам.Получить(Месяц);
		Если ЗначениеЗаполнено(Сумма) Тогда
			СтрокаНач = ДанныеОНачислениях.Добавить();
			СтрокаНач.СоставнаяЧасть = Перечисления.УчетНачисленийВСреднемЗаработкеОбщий.ОбщийЗаработок;
			СтрокаНач.Период        = Месяц;
			СтрокаНач.Сумма         = Окр(Сумма);
			СтрокаНач.Индексируется = Истина;
			СтрокаНач.ИсключеннаяЧасть = Ложь;
			СтрокаНач.СтатьяФинансирования             = СтатьяФинансированияПоУмолчанию;
			СтрокаНач.СпособОтраженияЗарплатыВБухучете = СпособОтраженияЗарплатыВБухучетеПоУмолчанию;
			СтрокаНач.СтатьяРасходов                   = СтатьяРасходовПоУмолчанию;
			СтрокаНач.ОблагаетсяЕНВД                   = ОблагаетсяЕНВДПоУмолчанию;
			Если ИсточникиРедактирование.Количество() > 0 Тогда
				СтрокаНач.Источник = ИсточникиРедактирование[0];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьФорму(ДанныеОНачислениях, ДанныеОВремени);

КонецПроцедуры

&НаСервере
Функция ДатаПриемаСотрудника()

	// Дата приёма сотрудника (для ограничения заполнения времени).
	КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(
		Истина,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник),
		"ДатаПриема",
		КонецМесяца(ОкончаниеПериодаРасчета));

	Если КадровыеДанные.Количество() > 0 Тогда
		Возврат НачалоДня(КадровыеДанные[0].ДатаПриема);
	КонецЕсли;

	Возврат Дата(1, 1, 1);

КонецФункции
 
&НаСервере
Функция ОкладУОСПоМесяцам()

	Результат = Новый Соответствие;

	Показатель = ПоказательОкладУОС();
	ИзмененияОклада = ИзмененияОкладаУОС(Показатель);
	Если ИзмененияОклада.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Месяц = НачалоМесяца(НачалоПериодаРасчета);
	Пока Месяц <= ОкончаниеПериодаРасчета Цикл
		НачМес = НачалоМесяца(Месяц);
		КонМес = КонецМесяца(Месяц);

		// Границы отрезков = начало месяца + ДНИ изменений внутри месяца,
		// без дублей (сравниваем начало дня, а не время записи).
		Границы = Новый Массив;
		Границы.Добавить(НачМес);
		Для Каждого Изм Из ИзмененияОклада Цикл
			ДеньИзменения = НачалоДня(Изм.Период);
			Если ДеньИзменения > НачМес
				И ДеньИзменения <= КонМес
				И Границы[Границы.ВГраница()] <> ДеньИзменения Тогда
				Границы.Добавить(ДеньИзменения);
			КонецЕсли;
		КонецЦикла;

		СуммаВзвешенная = 0;
		СуммаНормы      = 0;
		Для Сч = 0 По Границы.ВГраница() Цикл
			НачалоОтрезка    = Границы[Сч];
			ОкончаниеОтрезка = ?(Сч = Границы.ВГраница(), КонМес, КонецДня(Границы[Сч + 1] - 1));
			Если ОкончаниеОтрезка < НачалоОтрезка Тогда
				Продолжить;
			КонецЕсли;
			Размер = РазмерОкладаНаДату(ИзмененияОклада, НачалоОтрезка);
			Если Размер = 0 Тогда
				Продолжить;
			КонецЕсли;
			Норма = НормаДнейПоГрафику(НачалоОтрезка, ОкончаниеОтрезка);
			СуммаВзвешенная = СуммаВзвешенная + Размер * Норма;
			СуммаНормы      = СуммаНормы + Норма;
		КонецЦикла;

		Если СуммаНормы > 0 Тогда
			Результат.Вставить(НачМес, СуммаВзвешенная / СуммаНормы);
		КонецЕсли;

		Месяц = ДобавитьМесяц(Месяц, 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции
 
&НаСервере
Функция НормаДнейПоГрафику(ДатаНачала, ДатаОкончания)
 
    // Норма рабочих дней по графику сотрудника за произвольный интервал
    // (число дней явки в графике). Источник — регистр сведений
    // ГрафикиРаботыПоВидамВремени.
 
    ГрафикРаботы = ГрафикРаботыСотрудникаНаДату(ДатаНачала);
    Если Не ЗначениеЗаполнено(ГрафикРаботы) Тогда
        Возврат 0;
    КонецЕсли;
 
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("График",        ГрафикРаботы);
    Запрос.УстановитьПараметр("ДатаНачала",    НачалоДня(ДатаНачала));
    Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
    Запрос.УстановитьПараметр("Явка",          Справочники.ВидыИспользованияРабочегоВремени.РабочееВремя);
 
    Запрос.Текст =
        "ВЫБРАТЬ
        |    СУММА(ЕСТЬNULL(Графики.ОсновноеЗначение, 0)) КАК Дней
        |ИЗ
        |    РегистрСведений.ГрафикиРаботыПоВидамВремени КАК Графики
        |ГДЕ
        |    Графики.ГрафикРаботы = &График
        |    И Графики.ВидУчетаВремени = &Явка
        |    И Графики.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
        |    И Графики.ОсновноеЗначение > 0";
 
    Выборка = Запрос.Выполнить().Выбрать();
    Возврат ?(Выборка.Следующий(), ?(Выборка.Дней = NULL, 0, Выборка.Дней), 0);
 
КонецФункции

&НаСервере
Функция ГрафикРаботыСотрудникаНаДату(Дата)
 
    // График работы сотрудника, действующий на дату. 
    КадровыеДанные = КадровыйУчет.КадровыеДанныеСотрудников(
        Истина,
        ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник),
        "ГрафикРаботы",
        Дата);
 
    Если КадровыеДанные.Количество() > 0 Тогда
        Возврат КадровыеДанные[0].ГрафикРаботы;
    КонецЕсли;
 
    Возврат Неопределено;
 
КонецФункции

&НаСервере
Функция ИзмененияОкладаУОС(Показатель)
 
    // Значение оклада на начало расчётного периода (срез последних)
    // плюс все изменения показателя внутри периода. Упорядочено по периоду.
    // Источник — регистр сведений
    // ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудников.
 
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    Запрос.УстановитьПараметр("Показатель", Показатель);
    Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(НачалоПериодаРасчета));
    Запрос.УстановитьПараметр("ОкончаниеПериода", КонецМесяца(ОкончаниеПериодаРасчета));
 
    Запрос.Текст =
        "ВЫБРАТЬ
        |    СрезПоследних.Период КАК Период,
        |    СУММА(СрезПоследних.Значение) КАК Размер
        |ИЗ
        |    РегистрСведений.ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудников.СрезПоследних(
        |            &НачалоПериода,
        |            Сотрудник = &Сотрудник
        |                И Показатель = &Показатель) КАК СрезПоследних
        |СГРУППИРОВАТЬ ПО
        |    СрезПоследних.Период
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |    Показатели.Период,
        |    СУММА(Показатели.Значение)
        |ИЗ
        |    РегистрСведений.ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудников КАК Показатели
        |ГДЕ
        |    Показатели.Сотрудник = &Сотрудник
        |    И Показатели.Показатель = &Показатель
        |    И Показатели.Период > &НачалоПериода
        |    И Показатели.Период <= &ОкончаниеПериода
        |СГРУППИРОВАТЬ ПО
        |    Показатели.Период
        |
        |УПОРЯДОЧИТЬ ПО
        |    Период";
 
    Возврат Запрос.Выполнить().Выгрузить();
 
КонецФункции
 
&НаСервереБезКонтекста
Функция РазмерОкладаНаДату(ИзмененияОклада, Дата)
 
    // Действующий размер оклада на указанную дату
    // (последняя запись с периодом <= конца дня).
 
    Размер = 0;
    Для Каждого Стр Из ИзмененияОклада Цикл
        Если Стр.Период <= КонецДня(Дата) Тогда
            Размер = Стр.Размер;
        Иначе
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Возврат Размер;
 
КонецФункции

&НаСервереБезКонтекста
Функция ПоказательОкладУОС()
 
    // показатель расчёта зарплаты "Оклад" ======
    // Идентификатор показателя оклада УОС
    Возврат Справочники.ПоказателиРасчетаЗарплаты.НайтиПоРеквизиту("Идентификатор", "Оклад");
 
КонецФункции

&НаСервере
Функция ДатаНачалаЭксплуатацииУОС()
 	
	Возврат ИКТ_ДополнительныеНастройкиСистемы.ПолучитьЗначение("ДатаНачалаЭксплуатацииУОС"); 
 
КонецФункции

