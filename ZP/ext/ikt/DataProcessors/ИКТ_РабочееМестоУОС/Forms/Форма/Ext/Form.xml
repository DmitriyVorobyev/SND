		<Attribute name="СписокДокументов" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список документов</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ВЫБОР
		КОГДА ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.ПриемНаРаботу.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.Увольнение.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.КадровыйПеревод.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.КадровыйПереводСписком.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.Командировка.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.Отпуск.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.БольничныйЛист.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.ИзменениеГрафикаРаботыСписком.ПустаяСсылка)
			ТОГДА ИКТ_СоответствиеДокументов.ДокументУУ.Дата
		ИНАЧЕ ИКТ_СоответствиеДокументов.ДокументБУ.Дата
	КОНЕЦ КАК Дата,
	ИКТ_СоответствиеДокументов.ДокументБУ КАК ДокументБУ,
	ИКТ_СоответствиеДокументов.ДокументУУ КАК ДокументУОС,
	ИКТ_СоответствиеДокументов.СостояниеДокументаУУ КАК СостояниеДокументаУОС,
	ВЫБОР
		КОГДА ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.ПриемНаРаботу.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.Увольнение.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.КадровыйПеревод.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.КадровыйПереводСписком.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.Командировка.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.Отпуск.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.БольничныйЛист.ПустаяСсылка)
				ИЛИ ИКТ_СоответствиеДокументов.ДокументБУ = ЗНАЧЕНИЕ(Документ.ИзменениеГрафикаРаботыСписком.ПустаяСсылка)
			ТОГДА ТИПЗНАЧЕНИЯ(ИКТ_СоответствиеДокументов.ДокументУУ)
		ИНАЧЕ ТИПЗНАЧЕНИЯ(ИКТ_СоответствиеДокументов.ДокументБУ)
	КОНЕЦ КАК ТипЗначения
ИЗ
	РегистрСведений.ИКТ_СоответствиеДокументов КАК ИКТ_СоответствиеДокументов</QueryText>
