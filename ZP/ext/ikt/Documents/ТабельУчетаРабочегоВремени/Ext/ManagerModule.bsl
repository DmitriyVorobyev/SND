#Область ПроцедурыЗаполнения

// Корректирует выборку с уточнением данных об отработанном времени на основании данных произвольных кадровых приказов
//
// Параметры:
//	см. описание параметров переопределяемой процедуры 
//
&Вместо("ВыборкаДанныхОВремени")
Функция ИКТ_ВыборкаДанныхОВремени(ДанныеТабеля, СписокСотрудников, ЗаполнятьТерриторииУсловияТруда)
	
	// Получаем выборку 
	ВыборкаДанныхОВремени = ПродолжитьВызов(ДанныеТабеля, СписокСотрудников, ЗаполнятьТерриторииУсловияТруда);
	
	// Преобразуем в таблицу значений
	ТаблицаДанныхОВремени = ВыборкаДанныхОВремени.Владелец().Выгрузить();
					
	МассивСотрудников = ТаблицаДанныхОВремени.ВыгрузитьКолонку("Сотрудник");
	ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСотрудников);
	
	// Выборка видов времени, назначенных по приказу	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПериодРегистрации", НачалоМесяца(ДанныеТабеля.ДатаНачалаПериода));
	Запрос.УстановитьПараметр("Сотрудники", МассивСотрудников);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник КАК Сотрудник,
		|	ИКТ_ВидыВремениПоПриказу.ВидВремени КАК ВидВремени,
		|	ИКТ_ВидыВремениПоПриказу.ДатаВыхода КАК ДатаВыхода,
		|	ИКТ_ВидыВремениПоПриказу.ВидКорректировки КАК ВидКорректировки,
		|	СУММА(ИКТ_ВидыВремениПоПриказу.Часы) КАК Часы
		|ИЗ
		|	РегистрСведений.ИКТ_ВидыВремениПоПриказу КАК ИКТ_ВидыВремениПоПриказу
		|ГДЕ
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник В(&Сотрудники)
		|	И НАЧАЛОПЕРИОДА(ИКТ_ВидыВремениПоПриказу.ДатаВыхода, МЕСЯЦ) = &ПериодРегистрации
		|
		|СГРУППИРОВАТЬ ПО
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник,
		|	ИКТ_ВидыВремениПоПриказу.ДатаВыхода,
		|	ИКТ_ВидыВремениПоПриказу.ВидКорректировки,
		|	ИКТ_ВидыВремениПоПриказу.ВидВремени";
	
	ВыборкаПриказныхВидовВремени = Запрос.Выполнить().Выбрать();	
	Для Индекс = 0 По ТаблицаДанныхОВремени.Количество() - 1 Цикл 
		
		СтрокаТаблицы = ТаблицаДанныхОВремени[Индекс]; 
		
		// Доп. изменения в связи с приказами
		ВыборкаПриказныхВидовВремени.Сбросить();
		Пока ВыборкаПриказныхВидовВремени.НайтиСледующий(Новый Структура("Сотрудник, ДатаВыхода", СтрокаТаблицы.Сотрудник, СтрокаТаблицы.Дата)) Цикл
			Если ВыборкаПриказныхВидовВремени.ВидКорректировки = Перечисления.ИКТ_ВидКорректировкиТабеляПоПриказу.Замена Тогда
				
				СтрокаТаблицы.ВидУчетаВремени 					= ВыборкаПриказныхВидовВремени.ВидВремени;
				// {[+] ИКТ №16816 - Изменен
				//СтрокаТаблицы.Часы 								= ВыборкаПриказныхВидовВремени.Часы;
				Если ВыборкаПриказныхВидовВремени.Часы <> 0 Тогда 
					СтрокаТаблицы.Часы 								= ВыборкаПриказныхВидовВремени.Часы;
				КонецЕсли;
				//[+]} ИКТ №16816
				СтрокаТаблицы.ПереходящаяЧастьПредыдущейСмены 	= Ложь;
				СтрокаТаблицы.ПереходящаяЧастьСмены             = Ложь;
				СтрокаТаблицы.ПереходящаяЧастьТекущейСмены 		= Ложь;
				СтрокаТаблицы.Смена 							= Справочники.СменыРаботыСотрудников.ПустаяСсылка();
				
			ИначеЕсли ВыборкаПриказныхВидовВремени.ВидКорректировки = Перечисления.ИКТ_ВидКорректировкиТабеляПоПриказу.Вытеснение Тогда
				Если СтрокаТаблицы.ВидУчетаВремени = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Явка") Или
					СтрокаТаблицы.ВидУчетаВремени = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Праздники") Или
					СтрокаТаблицы.ВидУчетаВремени = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.ПраздникиБезПовышеннойОплаты") Тогда
					
					СтрокаТаблицы.Часы = Макс(СтрокаТаблицы.Часы - ВыборкаПриказныхВидовВремени.Часы, 0);
					
					Если СтрокаТаблицы.Часы = 0 Тогда
						СтрокаТаблицы.ВидУчетаВремени 	= ВыборкаПриказныхВидовВремени.ВидВремени;
						СтрокаТаблицы.Часы 			= ВыборкаПриказныхВидовВремени.Часы;
					Иначе
						НоваяСтрокаТаблицы = ТаблицаДанныхОВремени.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаТаблицы);
						НоваяСтрокаТаблицы.ВидУчетаВремени 	= ВыборкаПриказныхВидовВремени.ВидВремени;
						НоваяСтрокаТаблицы.Часы 			= ВыборкаПриказныхВидовВремени.Часы;
					КонецЕсли;
					
				КонецЕсли;
			ИначеЕсли ВыборкаПриказныхВидовВремени.ВидКорректировки = Перечисления.ИКТ_ВидКорректировкиТабеляПоПриказу.Добавление Тогда
				
				НоваяСтрокаТаблицы = ТаблицаДанныхОВремени.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, СтрокаТаблицы);
				НоваяСтрокаТаблицы.ВидУчетаВремени 	= ВыборкаПриказныхВидовВремени.ВидВремени;
				НоваяСтрокаТаблицы.Часы 			= ВыборкаПриказныхВидовВремени.Часы;
				НоваяСтрокаТаблицы.ПриоритетВидаВремени = 9;
				
			КонецЕсли;
		КонецЦикла;
			
	КонецЦикла;  
  
	
	ТаблицаДанныхОВремени.Свернуть("ВидУчетаВремени,Дата,ПереходящаяЧастьПредыдущейСмены,ПереходящаяЧастьСмены,ПереходящаяЧастьТекущейСмены,
	|ПолеПорядка0,ПриоритетВидаВремени,Смена,Сотрудник,Территория,УсловияТруда,Дни,Часы,НормаЧасов");
	
	// {[+] ИКТ №16816 - ДОБАВЛЕНЫ функции для работы с периодом дат
	// Дополнительная обработка для поддержки расширенной функциональности периодов
	ИКТ_ОбработатьДанныеПериодовДат(ТаблицаДанныхОВремени, ДанныеТабеля);
	//[+]} ИКТ №16816
	
	// Преобразуем обратно в выборку
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таблица.ВидУчетаВремени КАК ВидУчетаВремени,
	               |	Таблица.Дата КАК Дата,
	               |	Таблица.Дни КАК Дни,
	               |	Таблица.НормаЧасов КАК НормаЧасов,
	               |	Таблица.ПереходящаяЧастьПредыдущейСмены КАК ПереходящаяЧастьПредыдущейСмены,
	               |	Таблица.ПереходящаяЧастьСмены КАК ПереходящаяЧастьСмены,
	               |	Таблица.ПереходящаяЧастьТекущейСмены КАК ПереходящаяЧастьТекущейСмены,
	               |	Таблица.ПолеПорядка0 КАК ПолеПорядка0,
	               |	Таблица.ПриоритетВидаВремени КАК ПриоритетВидаВремени,
	               |	Таблица.Смена КАК Смена,
	               |	Таблица.Сотрудник КАК Сотрудник,
	               |	Таблица.Территория КАК Территория,
	               |	Таблица.УсловияТруда КАК УсловияТруда,
	               |	Таблица.Часы КАК Часы
	               |ПОМЕСТИТЬ ВТДанныеОВремени
	               |ИЗ
	               |	&ТаблицаДанныхОВремени КАК Таблица
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ПолеПорядка0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТДанныеОВремени.ВидУчетаВремени КАК ВидУчетаВремени,
	               |	ВТДанныеОВремени.Дата КАК Дата,
	               |	ВТДанныеОВремени.Дни КАК Дни,
	               |	ВТДанныеОВремени.НормаЧасов КАК НормаЧасов,
	               |	ВТДанныеОВремени.ПереходящаяЧастьПредыдущейСмены КАК ПереходящаяЧастьПредыдущейСмены,
	               |	ВТДанныеОВремени.ПереходящаяЧастьСмены КАК ПереходящаяЧастьСмены,
	               |	ВТДанныеОВремени.ПереходящаяЧастьТекущейСмены КАК ПереходящаяЧастьТекущейСмены,
	               |	ВТДанныеОВремени.ПолеПорядка0 КАК ПолеПорядка0,
	               |	ВТДанныеОВремени.ПриоритетВидаВремени КАК ПриоритетВидаВремени,
	               |	ВТДанныеОВремени.Смена КАК Смена,
	               |	ВТДанныеОВремени.Сотрудник КАК Сотрудник,
	               |	ВТДанныеОВремени.Территория КАК Территория,
	               |	ВТДанныеОВремени.УсловияТруда КАК УсловияТруда,
	               |	ВТДанныеОВремени.Часы КАК Часы
	               |ИЗ
	               |	ВТДанныеОВремени КАК ВТДанныеОВремени
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыИспользованияРабочегоВремени КАК ОписаниеВидовВремени
	               |		ПО ВТДанныеОВремени.ВидУчетаВремени = ОписаниеВидовВремени.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПолеПорядка0,
	               |	Сотрудник,
	               |	Дата,
	               |	ПриоритетВидаВремени,
	               |	ОписаниеВидовВремени.Наименование,
	               |	ВидУчетаВремени,
	               |	Территория,
	               |	УсловияТруда";
	
	Запрос.УстановитьПараметр("ТаблицаДанныхОВремени", ТаблицаДанныхОВремени);
	
	ВыборкаДанныхОВремениСУчетомПриказов = Запрос.Выполнить().Выбрать();			
	
	Возврат ВыборкаДанныхОВремениСУчетомПриказов;
	
КонецФункции  

// {[+] ИКТ №16816 - ДОБАВЛЕНА новая функция для обработки данных периодов
//
// Обрабатывает данные табеля с учетом периодов дат из произвольных приказов
//
// Параметры:
//  ТаблицаДанных - ТаблицаЗначений - исходные данные табеля
//  ДанныеТабеля - Структура - параметры табеля
//
Процедура ИКТ_ОбработатьДанныеПериодовДат(ТаблицаДанных, ДанныеТабеля) Экспорт
	
	// Дополнительный запрос для получения информации о периодах
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", ДанныеТабеля.ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", ДанныеТабеля.ДатаОкончанияПериода);
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИКТ_ВидыВремениПоПриказу.Регистратор КАК Приказ,
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник КАК Сотрудник,
		|	МИНИМУМ(ИКТ_ВидыВремениПоПриказу.ДатаВыхода) КАК ДатаНачала,
		|	МАКСИМУМ(ИКТ_ВидыВремениПоПриказу.ДатаВыхода) КАК ДатаОкончания,
		|	ИКТ_ВидыВремениПоПриказу.ВидВремени КАК ВидВремени,
		|	КОЛИЧЕСТВО(*) КАК КоличествоДней
		|ИЗ
		|	РегистрСведений.ИКТ_ВидыВремениПоПриказу КАК ИКТ_ВидыВремениПоПриказу
		|ГДЕ
		|	ИКТ_ВидыВремениПоПриказу.ДатаВыхода МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ИКТ_ВидыВремениПоПриказу.Регистратор.Проведен = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ИКТ_ВидыВремениПоПриказу.Регистратор,
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник,
		|	ИКТ_ВидыВремениПоПриказу.ВидВремени
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) > 1
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник,
		|	ДатаНачала";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		// Добавляем информацию о периодах в таблицу (для отображения в отчетах)
		ВыборкаПериодов = РезультатЗапроса.Выбрать();
		Пока ВыборкаПериодов.Следующий() Цикл
			
			// Можно добавить дополнительную логику для группировки 
			// или отображения информации о периодах
			// Например, добавить служебные строки в табель
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //[+]} ИКТ №16816

// {[+] ИКТ №16816 - ДОБАВЛЕНА функция получения периодов по приказам
//
// Возвращает информацию о периодах дат из произвольных приказов для указанных сотрудников
//
// Параметры:
//  СписокСотрудников - Массив - список сотрудников для анализа
//  Период - Структура - период анализа с полями ДатаНачала и ДатаОкончания
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с информацией о периодах
//
Функция ИКТ_ПолучитьИнформациюОПериодахПоПриказам(СписокСотрудников, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСотрудников", СписокСотрудников);
	Запрос.УстановитьПараметр("ДатаНачала", Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Период.ДатаОкончания);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИКТ_ВидыВремениПоПриказу.Регистратор КАК Приказ,
		|	ИКТ_ВидыВремениПоПриказу.Регистратор.Номер КАК НомерПриказа,
		|	ИКТ_ВидыВремениПоПриказу.Регистратор.Дата КАК ДатаПриказа,
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник КАК Сотрудник,
		|	МИНИМУМ(ИКТ_ВидыВремениПоПриказу.ДатаВыхода) КАК ДатаНачалаПериода,
		|	МАКСИМУМ(ИКТ_ВидыВремениПоПриказу.ДатаВыхода) КАК ДатаОкончанияПериода,
		|	ИКТ_ВидыВремениПоПриказу.ВидВремени КАК ВидВремени,
		|	ИКТ_ВидыВремениПоПриказу.ВидКорректировки КАК ВидКорректировки,
		|	КОЛИЧЕСТВО(*) КАК КоличествоДнейПериода,
		|	СРЕДНЕЕ(ИКТ_ВидыВремениПоПриказу.Часы) КАК СреднееЧасовВДень,
		|	СУММА(ИКТ_ВидыВремениПоПриказу.Часы) КАК ВсегоЧасов
		|ИЗ
		|	РегистрСведений.ИКТ_ВидыВремениПоПриказу КАК ИКТ_ВидыВремениПоПриказу
		|ГДЕ
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник В(&СписокСотрудников)
		|	И ИКТ_ВидыВремениПоПриказу.ДатаВыхода МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ИКТ_ВидыВремениПоПриказу.Регистратор.Проведен = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ИКТ_ВидыВремениПоПриказу.Регистратор,
		|	ИКТ_ВидыВремениПоПриказу.Регистратор.Номер,
		|	ИКТ_ВидыВремениПоПриказу.Регистратор.Дата,
		|	ИКТ_ВидыВремениПоПриказу.Сотрудник,
		|	ИКТ_ВидыВремениПоПриказу.ВидВремени,
		|	ИКТ_ВидыВремениПоПриказу.ВидКорректировки
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПриказа,
		|	НомерПриказа,
		|	Сотрудник,
		|	ДатаНачалаПериода";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //[+]} ИКТ №16816

#КонецОбласти 
//[+]} ИКТ №15434