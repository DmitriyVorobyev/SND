
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

//{[+] ИКТ №15434 (фрагмент ДОБАВЛЕН), Воробьев Дмитрий, 08.02.2026
&Вместо("ОбработкаПроведения")
Процедура ИКТ_ОбработкаПроведения(Отказ, РежимПроведения)
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект); 
	ДанныеДляПроведения = ДанныеДляПроведения();
	СформироватьДвиженияВидовВремениПоПриказам(Движения, ДанныеДляПроведения.СтрокиВидовВремени); 
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает структуру данных для проведения документа
//
Функция ДанныеДляПроведения()

	ДанныеДляПроведения = Новый Структура;
		
	Запрос = Новый Запрос;
	запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПроизвольныйКадровыйПриказЗначенияРеквизитов.ИдентификаторСтроки КАК ИдентификаторСтроки,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Реквизит.Наименование = ""Дата выхода""
		|				ТОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Значение
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК ДатаВыхода,
		// {+} ИКТ №16816 - Доработка для поддержки периода дат
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Реквизит.Наименование = ""Дата выхода с""
		|			ТОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Значение
		|		ИНАЧЕ NULL
		|	КОНЕЦ) КАК ДатаВыходаС,
		|	МАКСИМУМ(ВЫБОР
		|		КОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Реквизит.Наименование = ""Дата выхода по""
		|			ТОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Значение
		|		ИНАЧЕ NULL
		|	КОНЕЦ) КАК ДатаВыходаПо,
		// [+]} ИКТ №16816
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Реквизит.Наименование = ""Отработано часов""
		|				ТОГДА ПроизвольныйКадровыйПриказЗначенияРеквизитов.Значение
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК Часы,
		|	ПроизвольныйКадровыйПриказСотрудники.Сотрудник КАК Сотрудник,
		|	ПроизвольныйКадровыйПриказСотрудники.Ссылка.Шаблон.ИКТ_ВидВремени КАК ВидВремени,
		|	ПроизвольныйКадровыйПриказСотрудники.Ссылка.Шаблон.ИКТ_ВидКорректировки КАК ВидКорректировки
		|ИЗ
		|	Документ.ПроизвольныйКадровыйПриказ.ЗначенияРеквизитов КАК ПроизвольныйКадровыйПриказЗначенияРеквизитов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПроизвольныйКадровыйПриказ.Сотрудники КАК ПроизвольныйКадровыйПриказСотрудники
		|		ПО (ПроизвольныйКадровыйПриказЗначенияРеквизитов.Ссылка = ПроизвольныйКадровыйПриказСотрудники.Ссылка
		|				И ПроизвольныйКадровыйПриказЗначенияРеквизитов.ИдентификаторСтроки = ПроизвольныйКадровыйПриказСотрудники.ИдентификаторСтроки)
		|ГДЕ
		|	ПроизвольныйКадровыйПриказЗначенияРеквизитов.Ссылка = &Ссылка
		|	И НЕ ПроизвольныйКадровыйПриказЗначенияРеквизитов.Ссылка.Шаблон.ИКТ_ВидВремени = ЗНАЧЕНИЕ(Справочник.ВидыИспользованияРабочегоВремени.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПроизвольныйКадровыйПриказЗначенияРеквизитов.ИдентификаторСтроки,
		|	ПроизвольныйКадровыйПриказСотрудники.Сотрудник,
		|	ПроизвольныйКадровыйПриказСотрудники.Ссылка.Шаблон.ИКТ_ВидВремени,
		|	ПроизвольныйКадровыйПриказСотрудники.Ссылка.Шаблон.ИКТ_ВидКорректировки";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеДляПроведения.Вставить("СтрокиВидовВремени", РезультатЗапроса.Выгрузить());

	Возврат ДанныеДляПроведения;
	
КонецФункции   

// Заполняет движения в регистре ИКТ_ВидыВремениПоПриказу.
//
// Параметры:
//	Движения - коллекция движений, в которой необходимо заполнить движения.
//	Строки - таблица значений с полями:
//		Сотрудник
//		ДатаВыхода
//		ДатаВыходаС (новое поле)
//		ДатаВыходаПо (новое поле) 
//		Часы
//		ВидВремени
//		ВидКорректировки
//
Процедура СформироватьДвиженияВидовВремениПоПриказам(Движения, Строки) Экспорт
	
	Для Каждого СтрокаДанных Из Строки Цикл
		
		// {+} ИКТ №16816 - Обработка периода дат
		// Определяем способ обработки дат
		Если ЗначениеЗаполнено(СтрокаДанных.ДатаВыходаС) И ЗначениеЗаполнено(СтрокаДанных.ДатаВыходаПо) Тогда
			// Обрабатываем период дат
			ДатаНачала = СтрокаДанных.ДатаВыходаС;
			ДатаОкончания = СтрокаДанных.ДатаВыходаПо;
			
			// Цикл по дням в периоде
			ТекущаяДата = ДатаНачала;
			Пока ТекущаяДата <= ДатаОкончания Цикл
				
				ЗаполнитьЗначенияСвойств(Движения.ИКТ_ВидыВремениПоПриказу.Добавить(), СтрокаДанных);
				НовоеДвижение = Движения.ИКТ_ВидыВремениПоПриказу[Движения.ИКТ_ВидыВремениПоПриказу.Количество() - 1];
				НовоеДвижение.Сотрудник = СтрокаДанных.Сотрудник;
				НовоеДвижение.ДатаВыхода = ТекущаяДата;
				НовоеДвижение.ВидВремени = СтрокаДанных.ВидВремени;
				НовоеДвижение.Часы = СтрокаДанных.Часы;
				
				ТекущаяДата = ТекущаяДата + 86400; // Добавляем 1 день (в секундах)
				
			КонецЦикла;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ДатаВыходаС) Тогда
			// Используем только дату начала
			ЗаполнитьЗначенияСвойств(Движения.ИКТ_ВидыВремениПоПриказу.Добавить(), СтрокаДанных);
			НовоеДвижение = Движения.ИКТ_ВидыВремениПоПриказу[Движения.ИКТ_ВидыВремениПоПриказу.Количество() - 1];
			НовоеДвижение.ДатаВыхода = СтрокаДанных.ДатаВыходаС;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ДатаВыходаПо) Тогда
			// Используем только дату окончания
			ЗаполнитьЗначенияСвойств(Движения.ИКТ_ВидыВремениПоПриказу.Добавить(), СтрокаДанных);
			НовоеДвижение = Движения.ИКТ_ВидыВремениПоПриказу[Движения.ИКТ_ВидыВремениПоПриказу.Количество() - 1];
			НовоеДвижение.ДатаВыхода = СтрокаДанных.ДатаВыходаПо;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаДанных.ДатаВыхода) Тогда
			// Используем старый способ - одну дату выхода (обратная совместимость)
			ЗаполнитьЗначенияСвойств(Движения.ИКТ_ВидыВремениПоПриказу.Добавить(), СтрокаДанных);
			
		КонецЕсли;
		//ЗаполнитьЗначенияСвойств(Движения.ИКТ_ВидыВремениПоПриказу.Добавить(), СтрокаДанных);
		// [+]} ИКТ №16816
		
	КонецЦикла;
	
	Движения.ИКТ_ВидыВремениПоПриказу.Записать();
	Движения.ИКТ_ВидыВремениПоПриказу.Записывать = Ложь;
	
КонецПроцедуры
//[+]} ИКТ №15434

#КонецОбласти  

