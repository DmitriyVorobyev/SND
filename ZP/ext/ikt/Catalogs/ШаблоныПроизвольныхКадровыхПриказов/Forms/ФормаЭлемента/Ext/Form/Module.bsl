#Область ОбработчикиСобытийФормы

// ПриСозданииНаСервере (после)
//
// Параметры:
//	см. описание параметров переопределяемой процедуры
&НаСервере
Процедура ИКТ_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)  
	
	ДобавитьДопЭлементыУправления();  
	
КонецПроцедуры

#КонецОбласти

#Область  ОбработчикиСобытийЭлементовФормы

// Обработка выбора вида времени для шаблона
//
&НаКлиенте
Процедура ИКТ_ВидВремениОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)

	ЗаполнитьНеобходимымиРеквизитами();
	
КонецПроцедуры   

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавить дополнительные элементы управления
//
// Примечание: Добавляет реквизиты, команды, элементы формы
&НаСервере
Процедура ДобавитьДопЭлементыУправления()
	
	Группа = Элементы.Добавить("ИКТ_НастройкаВидовВремени", Тип("ГруппаФормы"));
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
	Группа.ОтображатьЗаголовок = ЛОЖЬ; 
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	Элемент = Элементы.Добавить("ИКТ_ВидВремени", Тип("ПолеФормы"), Группа);
	Элемент.Заголовок = "Вид времени по приказу";
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = "Объект.ИКТ_ВидВремени";
	Элемент.Подсказка = "Если вид времени указан, то в табеле будет проставлен этот вид времени.";
	Элемент.УстановитьДействие("ОбработкаВыбора", "ИКТ_ВидВремениОбработкаВыбора"); 
	
	Элемент = Элементы.Добавить("ИКТ_ВидКорректировки", Тип("ПолеФормы"), Группа);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.ПутьКДанным = "Объект.ИКТ_ВидКорректировки";
	Элемент.Подсказка = "Указанный вид времени вытесняет явку, заменяет вид времени или добавляется";
		
	Элементы.Переместить(Группа, Элемент.Родитель, Элементы.ГруппаРеквизиты);
	
КонецПроцедуры

// Заполняет необходимыми реквизитами для движений произвольных кадровых приказов с корректровкой по времени
//
&НаСервере
Процедура ЗаполнитьНеобходимымиРеквизитами()
	
	МассивРеквизитов = НайтиСоздатьРеквизитыШаблонаДляКорректировкиВремени();

	Для Каждого Реквизит Из МассивРеквизитов Цикл
		Если РеквизитыСпискаСотрудников.НайтиСтроки(новый Структура("Ссылка", Реквизит)).Количество() = 0 Тогда 
			НовыйРеквизит = РеквизитыСпискаСотрудников.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйРеквизит, Реквизит); 
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры  

// Находит или создает необходимые реквизиты
//
&НаСервере
Функция НайтиСоздатьРеквизитыШаблонаДляКорректировкиВремени()
	
	МассивРеквизитов = Новый Массив;
	КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);
	КвалификаторыЧисла = Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Любой);
	РеквизитДатаВыхода = НайтиЭлементПланаСОтбором(новый Структура("Наименование, Шаблон", "Дата выхода", Объект.Ссылка));
	РеквизитЧасы = НайтиЭлементПланаСОтбором(новый Структура("Наименование, Шаблон", "Часы", Объект.Ссылка));
	
	Если РеквизитДатаВыхода = Неопределено Тогда 
		РеквизитДатаВыхода = ПланыВидовХарактеристик.РеквизитыПроизвольныхКадровыхПриказов.СоздатьЭлемент();
		РеквизитДатаВыхода.Наименование = "Дата выхода"; 
		РеквизитДатаВыхода.ТипЗначения = новый ОписаниеТипов("Дата", , ,КвалификаторыДаты);
		РеквизитДатаВыхода.ОбязательноДляЗаполнения = Истина;
		РеквизитДатаВыхода.ИспользуетсяВТабличнойЧасти = Истина;
		РеквизитДатаВыхода.Записать();
	КонецЕсли;
	МассивРеквизитов.Добавить(РеквизитДатаВыхода.Ссылка); 
	
	Если РеквизитЧасы = Неопределено Тогда 
		РеквизитЧасы = ПланыВидовХарактеристик.РеквизитыПроизвольныхКадровыхПриказов.СоздатьЭлемент();
		РеквизитЧасы.Наименование = "Часы"; 
		РеквизитЧасы.ТипЗначения = новый ОписаниеТипов("Число", , ,КвалификаторыЧисла);
		РеквизитЧасы.ИспользуетсяВТабличнойЧасти = Истина;
		РеквизитЧасы.Записать();
	КонецЕсли;
	МассивРеквизитов.Добавить(РеквизитЧасы.Ссылка);
	
	Возврат МассивРеквизитов;
	
КонецФункции

// Находит элемент плана видов характеристик РеквизитыПроизвольныхКадровыхПриказов по отбору
//
// Параметры:
//  СтруктураОтбора	 - Структура 
// 
// Возвращаемое значение:
//  Ссылка - ПланВидовХарактеристик.РеквизитыПроизвольныхКадровыхПриказов
//
&НаСервереБезКонтекста
Функция НайтиЭлементПланаСОтбором(СтруктураОтбора)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВАрхиве", Ложь);	
	ТекстЗапроса = "ВЫБРАТЬ
					|	РеквизитыПроизвольныхКадровыхПриказов.Ссылка КАК Ссылка
					|ИЗ
					|	ПланВидовХарактеристик.РеквизитыПроизвольныхКадровыхПриказов КАК РеквизитыПроизвольныхКадровыхПриказов
					|ГДЕ
					|	РеквизитыПроизвольныхКадровыхПриказов.ВАрхиве = ЛОЖЬ"; 
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	Если СтруктураОтбора.Количество() > 0 Тогда
		ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
		Для Каждого ЭлементОтбора Из СтруктураОтбора Цикл
			ТекстУсловия = УведомленияСервер.ПредставлениеУсловияДляЗапроса(
				ВидСравнения.Равно,
				ЭлементОтбора.Ключ,
				"РеквизитыПроизвольныхКадровыхПриказов." + ЭлементОтбора.Ключ);
			ОтборЗапроса.Добавить(ТекстУсловия);
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
		КонецЦикла;
	КонецЕсли;
		
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда 	
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

#КонецОбласти
