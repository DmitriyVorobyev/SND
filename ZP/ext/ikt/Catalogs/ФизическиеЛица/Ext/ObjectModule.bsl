
&После("ПередЗаписью")
Процедура ИКТ_ПередЗаписью(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Ссылка) Тогда  
		Если Не ЗначениеЗаполнено(ИКТ_ТабельныйНомер) Тогда
			ИКТ_ТабельныйНомер = ИКТ_ОбщийМодульСервер.ПолучитьНовыйНомер("SD000000", "SD999999", "ФизическиеЛица", "ИКТ_ТабельныйНомер"); 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&После("ПриКопировании")
Процедура ИКТ_ПриКопировании(ОбъектКопирования)
	
	ИКТ_ТабельныйНомер = "";

КонецПроцедуры
