&НаСервере
Процедура ДобавитьРеквизитыНаФорму()
	
	НоваяКолонка = Элементы.Добавить("ИКТ_ДолжностьС", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_ДолжностьС";
	НоваяКолонка = Элементы.Добавить("ИКТ_IDДолжностьС", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_IDДолжностьС";
	НоваяКолонка = Элементы.Добавить("ИКТ_НомерГруппыПодбора", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_НомерГруппыПодбора";
	НоваяКолонка = Элементы.Добавить("ИКТ_ТипПроверкиКандидатовДБ", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_ТипПроверкиКандидатовДБ";
	НоваяКолонка = Элементы.Добавить("ИКТ_ВидИнцидентаПоКРВ", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_ВидИнцидентаПоКРВ";
	НоваяКолонка = Элементы.Добавить("ИКТ_УровеньДоступа", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_УровеньДоступа";
	НоваяКолонка = Элементы.Добавить("ИКТ_Должность", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_Должность";
	НоваяКолонка = Элементы.Добавить("ИКТ_Группа", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_Группа";
	НоваяКолонка = Элементы.Добавить("ИКТ_Грейд", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_Грейд";

	НоваяКолонка = Элементы.Добавить("ИКТ_НазваниеРазделаПерсонала", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_НазваниеРазделаПерсонала";
	НоваяКолонка = Элементы.Добавить("ИКТ_ПроцентЗанятости", Тип("ПолеФормы"), Элементы.Список);
	НоваяКолонка.ПутьКДанным = "Список.ИКТ_ПроцентЗанятости";
	
КонецПроцедуры
	