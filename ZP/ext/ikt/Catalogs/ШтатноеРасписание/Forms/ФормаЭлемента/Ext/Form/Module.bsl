		СтраницаУОС = Элементы.Добавить("СтраницаУОС", Тип("ГруппаФормы"), Элементы.СтраницыФормы);
		СтраницаУОС.Заголовок = "УОС";
		СтраницаУОС.Вид = ВидГруппыФормы.Страница;  
		
		ГруппаУОСОбщая = Элементы.Добавить("ГруппаУОСОбщая", Тип("ГруппаФормы"), Элементы.СтраницаУОС);
		ГруппаУОСОбщая.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаУОСОбщая.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
