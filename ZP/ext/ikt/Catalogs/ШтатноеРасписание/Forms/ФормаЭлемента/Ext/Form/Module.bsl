&НаСервере
Процедура ПриИзмененииДолжностиСНаСервере()  
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ИКТ_ДолжностьС, 
		"IDДолжностьС,НомерГруппыПодбора,ТипПроверкиКандидатовДБ,ВидИнцидентаПоКРВ,УровеньДоступа,Должность"); 
	
	Объект.ИКТ_IDДолжностьС = ЗначенияРеквизитов.IDДолжностьС;
	Объект.ИКТ_НомерГруппыПодбора = ЗначенияРеквизитов.НомерГруппыПодбора;
	Объект.ИКТ_ТипПроверкиКандидатовДБ = ЗначенияРеквизитов.ТипПроверкиКандидатовДБ;
	Объект.ИКТ_ВидИнцидентаПоКРВ = ЗначенияРеквизитов.ВидИнцидентаПоКРВ;
	Объект.ИКТ_УровеньДоступа = ЗначенияРеквизитов.УровеньДоступа;
	Объект.ИКТ_Должность = ЗначенияРеквизитов.Должность;
	
КонецПроцедуры     
  
&НаСервере
Процедура ДобавитьПроверяемыеРеквизиты(ПроверяемыеРеквизиты)
	
	Если ИКТ_ЗП_УОС.ЭтоУОС(Объект.Владелец) Тогда
		Возврат;
	КонецЕсли;              
	
	ПроверяемыеРеквизиты.Добавить("ИКТ_ДолжностьС");
	ПроверяемыеРеквизиты.Добавить("ИКТ_IDДолжностьС");
	ПроверяемыеРеквизиты.Добавить("ИКТ_НомерГруппыПодбора");
	ПроверяемыеРеквизиты.Добавить("ИКТ_ТипПроверкиКандидатовДБ");
	ПроверяемыеРеквизиты.Добавить("ИКТ_ВидИнцидентаПоКРВ");
	ПроверяемыеРеквизиты.Добавить("ИКТ_УровеньДоступа");
	ПроверяемыеРеквизиты.Добавить("ИКТ_Должность");
	ПроверяемыеРеквизиты.Добавить("ИКТ_Группа");
	ПроверяемыеРеквизиты.Добавить("ИКТ_Грейд");
	
КонецПроцедуры
	
&НаКлиенте
Процедура ИКТ_ОбновитьСостояниеОбменаСРеквест()
	
	ИКТ_ОбновитьСостояниеОбменаСРеквестНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ИКТ_ОбновитьСостояниеОбменаСРеквестНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда  
		
		Если Объект.Владелец.ИКТ_УУ Тогда 	
			
			Результат = ИКТ_RequestСерверПривилегированный.ПолучитьСоостояниеОбменаСРеквестПоОбъекту(Объект.Ссылка);
			
			Если Не ЗначениеЗаполнено(Результат.Период) Тогда
				
				ЭтотОбъект.ИКТ_СостояниеОбменаRequest = "Не выполнялся";
				
			ИначеЕсли Результат.Ошибка = Ложь и Результат.Выгружен = Ложь Тогда
				
				ЭтотОбъект.ИКТ_СостояниеОбменаRequest = "Объект в очереди на выгрузку";  
				
			ИначеЕсли Результат.Ошибка = Истина Тогда
				
				ЭтотОбъект.ИКТ_СостояниеОбменаRequest = СтрШаблон("Ошибка обмена. Дата выгрузки %1", Результат.Период);
				
			Иначе 
				
				ЭтотОбъект.ИКТ_СостояниеОбменаRequest = "Обмен выполнен";
				
			КонецЕсли;			
			
		КонецЕсли; 
		
	Иначе
		
		ЭтотОбъект.ИКТ_СостояниеОбменаRequest = "Обмен будет выполнен после записи объекта";
		
	КонецЕсли;
	
КонецПроцедуры
